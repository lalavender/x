module main;

// c_scalar：声明由独立 C 桥实现的固定参数标量函数，覆盖整数、布尔、指针和浮点。
@[extern]
fn c_scalar(enabled bool, signed8 i8, unsigned8 u8, signed16 i16,
    unsigned16 u16, signed32 i32, wide i64, data *u8, single f32, wide_float f64) i64;

// c_apply：由 C 桥调用传入的 C ABI 函数指针，验证间接回调签名。
@[extern]
fn c_apply(callback @[extern] fn(i32) i32, value i32) i32;

// c_test：由 YH main 转入独立 C 驱动，集中执行跨语言 ABI 运行断言。
@[extern]
fn c_test() int;

// yh_scalar：导出完整标量参数形状，供 C 侧核对双向 Apple C ABI。
@[extern]
pub fn yh_scalar(enabled bool, signed8 i8, unsigned8 u8, signed16 i16,
    unsigned16 u16, signed32 i32, wide i64, data *u8, single f32, wide_float f64) i64 {
    return enabled.to_type(i64) + signed8.to_type(i64) + unsigned8.to_type(i64) +
        signed16.to_type(i64) + unsigned16.to_type(i64) + signed32.to_type(i64) +
        wide + single.to_type(i64) + wide_float.to_type(i64);
}

// yh_call_c_scalar：由 YH 调用独立 C 实现，验证窄型属性、浮点与指针方向一致。
@[extern]
pub fn yh_call_c_scalar(enabled bool, signed8 i8, unsigned8 u8, signed16 i16,
    unsigned16 u16, signed32 i32, wide i64, data *u8, single f32, wide_float f64) i64 {
    return c_scalar(enabled, signed8, unsigned8, signed16, unsigned16,
        signed32, wide, data, single, wide_float);
}

// yh_narrow10：导出十个窄整数参数，检查第九、第十参数从 Darwin 栈位置读取。
@[extern]
pub fn yh_narrow10(a i8, b i8, c i8, d i8, e i8, f i8, g i8, h i8, i i8, j i8) i8 {
    return j;
}

// yh_fp9：导出九个浮点参数与尾随整数，检查浮点寄存器耗尽后的栈参数映射。
@[extern]
pub fn yh_fp9(a f64, b f64, c f64, d f64, e f64, f f64, g f64, h f64,
    i f64, tail i64) f64 {
    return i + tail.to_type(f64);
}

// yh_apply：接受 C 函数指针并作间接调用，供 C 测试驱动传入回调。
@[extern]
pub fn yh_apply(callback @[extern] fn(i32) i32, value i32) i32 {
    return callback(value);
}

// yh_increment：作为可由 C ABI 函数指针调用的 YH 回调。
@[extern]
pub fn yh_increment(value i32) i32 {
    return value + 7;
}

// yh_call_c_callback：YH 把 C ABI 函数指针交给 C，再由 C 反向调用 YH 回调。
@[extern]
pub fn yh_call_c_callback(value i32) i32 {
    return c_apply(yh_increment, value);
}

// yh_pointer：单独导出指针往返，确保指针参数不受窄整型 ABI 属性影响。
@[extern]
pub fn yh_pointer(value *u8) *u8 {
    return value;
}

// main：以 YH 入口调用 C 测试驱动，保留单文件对象发射所需入口。
fn main() int {
    return c_test();
}
