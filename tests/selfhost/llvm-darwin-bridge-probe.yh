// Darwin 桥 C ABI 探针由 llvm-darwin-bridge.py 编译并显式链接失败桩。
@[extern] fn yh_llvm_version() *char
@[extern] fn yh_llvm_emit_v2(text *char, length u64, triple *char, min_os *char,
    opt_level int, kind int, output *char, diagnostic *char, capacity u64) int
@[extern] fn yh_lld_link(argv **char, argc int, diagnostic *char, capacity u64) int

fn main() int {
    if (yh_llvm_version() == 0) { return 1 }

    let reason [4]u8
    reason[0] = 88
    let status int = yh_llvm_emit_v2("x", 1, "aarch64-apple-darwin", "14.0.0",
        0, 0, "tmp/llvm-migration/darwin-bridge-probe/retained.o",
        (&reason[0]).to_type(*char), 4.to_type(u64))
    if (status == 0 || reason[0] == 0 || reason[3] != 0) { return 2 }

    reason[0] = 88
    status = yh_llvm_emit_v2("x", 1, "aarch64-apple-darwin", "14.0.0",
        0, 0, "tmp/llvm-migration/darwin-bridge-probe/retained.o",
        (&reason[0]).to_type(*char), 4.to_type(u64))
    if (status == 0 || reason[0] == 0 || reason[3] != 0) { return 3 }

    let args [1]*char
    args[0] = "ld64.lld"
    reason[0] = 0
    status = yh_lld_link(&args[0], 1, (&reason[0]).to_type(*char), 4.to_type(u64))
    if (status == 0 || reason[0] == 0 || reason[3] != 0) { return 4 }
    return 0
}
