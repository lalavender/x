// expect: arm64-runtime:42 A A
// expect-more: XXXXXXX
// expect-more: len=7
// exit: 0
// Linux/AArch64 运行时片段：分配、复制、清零、字符串与格式化输出。

// memset：本项目未在 prelude 提供，按运行时弱定义声明为外部接口。
@[extern]
fn memset(dst *void, value int, count u64) *void;

// main：不依赖 libc，只用编译器自带分配器和 syscall 输出。
fn main() int {
    let raw *u8 = malloc(8).to_type(*u8);
    if (raw == 0 || (raw.to_type(u64) & 15) != 0) { return 1; }
    let i int = 0;
    for i < 8 {
        raw[i] = 'X';
        i += 1;
    }
    raw[7] = 0;
    let dst *u8 = malloc(8).to_type(*u8);
    if (dst == 0) { free(raw.to_type(*void)); return 2; }
    memset(dst.to_type(*void), 0, 8);
    if (memcpy(dst.to_type(*void), raw.to_type(*void), 8) != dst.to_type(*void)) {
        return 3;
    }
    if (dst[0] != 'X' || dst[6] != 'X' || dst[7] != 0) { return 4; }
    printf("arm64-runtime:%d %s %c\n", 42, "A", 65);
    printf("%s\n", dst.to_type(*char));
    printf("len=%llu\n", strlen(dst.to_type(*char)).to_type(u64));
    free(raw.to_type(*void));
    free(dst.to_type(*void));
    return 0;
}
