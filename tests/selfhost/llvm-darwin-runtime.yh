module main

// memset：声明目标模块需提供的字节填充 helper，确认后端不导入系统 libc 实现。
@[extern]
fn memset(dst *void, value int, count u64) *void

// main：验证 Darwin LLVM 的自有分配器、内存 helper、变参格式化与标准输出。
fn main() int {
    let allocated *u8 = malloc(33).to_type(*u8)
    if (allocated == 0 || (allocated.to_type(u64) & 15) != 0) { return 1 }
    allocated[0] = 'h'.to_type(u8)
    allocated[1] = 'i'.to_type(u8)
    allocated[2] = 0
    let copied [8]char
    if (memcpy(copied, allocated, 3) != (&copied[0]).to_type(*void)
        || strlen(&copied[0]) != 2 || copied[0] != 'h' || copied[1] != 'i') { return 2 }
    let filled [4]char
    if (memset((&filled[0]).to_type(*void), 'z'.to_type(int), 4)
        != (&filled[0]).to_type(*void)
        || filled[0] != 'z' || filled[3] != 'z') { return 8 }
    if (printf("darwin-runtime:%d %u %lld %llu %s %c %%\n", -7,
        8.to_type(u32), (-9).to_type(i64), 10.to_type(u64), &copied[0], 'A') != 33) {
        return 3
    }
    if (printf("many:%d%d%d%d%d%d%d%d\n", 1, 2, 3, 4, 5, 6, 7, 8) != 14) {
        return 4
    }
    let large [300]char
    let index int = 0
    for index < 299 { large[index] = 'x'; index += 1 }
    large[299] = 0
    if (strlen(&large[0]) != 299 || printf("%s\n", &large[0]) != 300) { return 5 }
    let zero *void = malloc(0)
    if (zero == 0 || (zero.to_type(u64) & 15) != 0) { return 6 }
    free(zero)
    free(allocated.to_type(*void))
    free(0.to_type(*void))
    let huge *void = malloc((-1).to_type(u64))
    if (huge != 0) { free(huge); return 7 }
    if (close(1) != 0 || printf("closed-output") != -1) { return 9 }
    return 0
}
