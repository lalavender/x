module main;

// ARM64 启动桥源级调用：八个标量实参遵循 C ABI，由固定 ARM SDK 在最终链接时解析。
@[extern] fn yh_llvm_emit(text *char, length u64, triple *char,
    opt_level int, kind int, output *char, diagnostic *char, capacity u64) int;

// main：用 yh 自身运行时驱动静态 LLVM，发射可在 WSL 原生执行的 x64 最小对象。
fn main() int {
    $if (arm64 && linux) { } $else { $compile_error("ARM64 启动桥探针须以 Linux ARM64 构建"); }
    let text *char = "define i32 @main() { ret i32 0 }\n";
    let diagnostic [4096]char;
    return yh_llvm_emit(text, strlen(text), "x86_64-unknown-linux-gnu", 2, 0,
        "tmp/llvm-migration/arm-sdk/yh-probe.o", &diagnostic[0], 4096);
}
