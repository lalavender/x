// LL7 首片探针：通过 C ABI 验证窄整数扩展、浮点/指针与多寄存器实参。
// C 侧实现 c_* 并调用 yh_*；本文件提供对应声明、定义及 yh→C 调用入口。
// c_i8：声明 C 侧的有符号 8 位恒等函数，用来检查入参与返回的 signext。
@[extern]
fn c_i8(value i8) i8;
// c_u8：声明 C 侧的无符号 8 位恒等函数，用来检查入参与返回的 zeroext。
@[extern]
fn c_u8(value u8) u8;
// c_i16：声明 C 侧的有符号 16 位恒等函数，用来检查入参与返回的 signext。
@[extern]
fn c_i16(value i16) i16;
// c_u16：声明 C 侧的无符号 16 位恒等函数，用来检查入参与返回的 zeroext。
@[extern]
fn c_u16(value u16) u16;
// c_bool：C _Bool 的窄整数寄存器形式为 i1 zeroext，YH bool 仍保存完整字节。
@[extern]
fn c_bool(value bool) bool;
// c_f32：声明 C float 恒等函数，确认单精度值走 SSE 浮点参数位置。
@[extern]
fn c_f32(value f32) f32;
// c_f64：声明 C double 恒等函数，确认双精度返回和参数类型。
@[extern]
fn c_f64(value f64) f64;
// c_ptr：声明 C 指针恒等函数，确认 opaque ptr 作为标量参数和返回值。
@[extern]
fn c_ptr(value *u8) *u8;
// c_mixed：声明交错整浮函数，以独立加权结果检查多寄存器类别和参数顺序。
@[extern]
fn c_mixed(a i32, b f64, c i64, d f32, e u64, f i32, g f64, h u32) i64;
// c_many：声明 8 整数参数函数，核对超出 SysV GPR 数量后的栈参数位置。
@[extern]
fn c_many(a i64, b i64, c i64, d i64, e i64, f i64, g i64, h i64) i64;

// yh_i8：向 C 调用方导出有符号窄参数/返回值，验证两个 ABI 扩展位置。
@[extern]
fn yh_i8(value i8) i8 { return value; }

// yh_u8：向 C 调用方导出无符号窄参数/返回值，验证零扩展属性。
@[extern]
fn yh_u8(value u8) u8 { return value; }

// yh_i16：向 C 调用方导出有符号 16 位参数/返回值。
@[extern]
fn yh_i16(value i16) i16 { return value; }

// yh_u16：向 C 调用方导出无符号 16 位参数/返回值。
@[extern]
fn yh_u16(value u16) u16 { return value; }

// yh_bool：从 C 接收 i1 zeroext，并向 C 返回归一化后的 _Bool。
@[extern]
fn yh_bool(value bool) bool { return value; }

// yh_bool_noncanonical：返回非零但最低位为零的 YH bool，确认 C 边界按非零归一。
@[extern]
fn yh_bool_noncanonical() bool { return 2.to_type(bool); }

// yh_f32：向 C 调用方导出单精度标量，签名保持 float 而非整数位型。
@[extern]
fn yh_f32(value f32) f32 { return value; }

// yh_f64：向 C 调用方导出双精度标量。
@[extern]
fn yh_f64(value f64) f64 { return value; }

// yh_ptr：向 C 调用方导出不透明机器指针并原样返回。
@[extern]
fn yh_ptr(value *u8) *u8 { return value; }

// yh_mixed：交错整数/浮点且超过常用参数寄存器数，返回加权和供 C 独立核对。
@[extern]
fn yh_mixed(a i32, b f64, c i64, d f32, e u64, f i32, g f64, h u32) i64 {
    return a.to_type(i64) + (b * 10.0).to_type(i64) + c
        + (d * 100.0.to_type(f32)).to_type(i64) + e.to_type(i64)
        + f.to_type(i64) + (g * 1000.0).to_type(i64) + h.to_type(i64);
}

// yh_many：八个整数参数超过 SysV GPR 参数寄存器数量，验证栈上传递位置。
@[extern]
fn yh_many(a i64, b i64, c i64, d i64, e i64, f i64, g i64, h i64) i64 {
    return a + b + c + d + e + f + g + h;
}

// yh_run_probe：从 yh 发起跨 ABI 调用，并用边界值验证参数、返回和地址保持。
@[extern]
fn yh_run_probe() int {
    if (c_i8(-123) != -123 || c_u8(250) != 250
        || c_i16(-30001) != -30001 || c_u16(60001) != 60001) { return 1; }
    // C _Bool 入参应把非零的 YH bool 字节按 C 语义归一成 1。
    if (c_bool(2.to_type(bool)) != true || c_bool(false) != false) { return 6; }
    let single f32 = 1.5.to_type(f32);
    let precision64 f64 = -9.25;
    if (c_f32(single) != single || c_f64(precision64) != precision64) { return 2; }
    let byte u8 = 37;
    let address *u8 = &byte;
    if (c_ptr(address) != address) { return 3; }
    if (c_mixed(1, 2.0, 3, 4.0.to_type(f32), 5, 6, 7.0, 8) != 7443) { return 4; }
    if (c_many(1, 2, 3, 4, 5, 6, 7, 8) != 36) { return 5; }
    return 0;
}
