// LLVM 固定点探针：覆盖全局深指针存储、聚合传值与短路循环控制流。
let saved_environment **char = 0

struct LLVMFixedPointRecord {
    whole int
    fraction f64
}

// llvm_fixedpoint_sum：读取按值传入的聚合，确保各候选代保持同一 ABI。
fn llvm_fixedpoint_sum(record LLVMFixedPointRecord) int {
    return record.whole + record.fraction.to_type(int)
}

// main：保存入口环境指针并运行聚合/循环探针；成功返回零。
fn main(argc int, argv **char, envp **char) int {
    saved_environment = envp
    let record LLVMFixedPointRecord = LLVMFixedPointRecord {
        whole: argc, fraction: 2.0,
    }
    let count int = 0
    for count < 3 && saved_environment == envp {
        count += 1
    }
    if (llvm_fixedpoint_sum(record) != argc + 2 || count != 3) { return 1 }
    return 0
}
