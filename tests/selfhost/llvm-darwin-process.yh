module main;

// main：通过 libSystem fork/execvp/waitpid 验证 Darwin LLVM 进程 API 互操作。
fn main() int {
    let child int = fork();
    if (child < 0) { return 1; }
    if (child == 0) {
        let args [2]*char;
        args[0] = "/usr/bin/true";
        args[1] = 0.to_type(*char);
        execvp(args[0], &args[0]);
        exit(127);
    }
    let status int = -1;
    if (waitpid(child, &status, 0) != child || status != 0) { return 2; }
    return 0;
}
