module main;

// AppleByte：一字节 C 聚合，参数占一个 X 寄存器而结果保留 i8。
@[extern]
pub struct AppleByte { value u8; }

// AppleTriple：三个连续字节的非 HFA 聚合，验证 i24 返回和 i64 参数。
@[extern]
pub struct AppleTriple { first u8; second u8; third u8; }

// AppleWord：一个 64 位整数成员，边界大小聚合仍按值往返。
@[extern]
pub struct AppleWord { value u64; }

// ApplePair16：16 字节聚合，两个 X 寄存器合成单个 LLVM 数组参数与返回值。
@[extern]
pub struct ApplePair16 { first u64; second u64; }

// AppleNine：9 字节聚合，验证第二个 X 寄存器只携带一个有效字节。
@[extern]
pub struct AppleNine {
    first u8; second u8; third u8; fourth u8; fifth u8;
    sixth u8; seventh u8; eighth u8; ninth u8;
}

// AppleUnion：整数与浮点成员共用八字节存储，按 Apple 非 HFA 整数聚合传递。
@[extern]
pub union AppleUnion { integer u64; floating f64; }

// AppleFloatUnion：全部成员都是同一浮点基型的 16 字节联合体。Apple 规则
// 下它是 2×double HFA（成员内存重叠，元素数取最宽成员），必须走 v0/v1；
// 曾漏掉 union 分类而被当成整数聚合，C↔YH 双向都会读到错误字段。
@[extern]
pub union AppleFloatUnion { scalar f64; values [2]f64; }

// AppleFloat2：双精度 HFA 成员，验证浮点寄存器参数和聚合结果。
@[extern]
pub struct AppleFloat2 { left f64; right f64; }

// AppleFloatPair：HFA3 内层结构，提供两个连续的单精度成员。
@[extern]
pub struct AppleFloatPair { left f32; right f32; }

// AppleHfa3：嵌套三元素单精度 HFA，递归字段仍归为同一种浮点基型。
@[extern]
pub struct AppleHfa3 { inner AppleFloatPair; tail f32; }

// AppleWide：24 字节聚合，Darwin ABI 通过间接参数和 sret 返回。
@[extern]
pub struct AppleWide { first u64; second u64; third u64; }

// c_round_*：由 C 桥实现，供 YH 发起 Apple 聚合 ABI 调用。
@[extern]
fn c_round_byte(value AppleByte) AppleByte;
@[extern]
fn c_round_triple(value AppleTriple) AppleTriple;
@[extern]
fn c_round_word(value AppleWord) AppleWord;
@[extern]
fn c_round_pair16(value ApplePair16) ApplePair16;
@[extern]
fn c_round_nine(value AppleNine) AppleNine;
@[extern]
fn c_round_union(value AppleUnion) AppleUnion;
@[extern]
fn c_round_float_union(value AppleFloatUnion) AppleFloatUnion;
@[extern]
fn c_round_float2(value AppleFloat2) AppleFloat2;
@[extern]
fn c_round_hfa3(value AppleHfa3) AppleHfa3;
@[extern]
fn c_apply_hfa_callback(callback @[extern] fn(AppleFloat2) AppleFloat2,
    value AppleFloat2) AppleFloat2;
@[extern]
fn c_choose_hfa_callback() @[extern] fn(AppleFloat2) AppleFloat2;
@[extern]
fn c_adjust_hfa(value AppleFloat2) AppleFloat2;
@[extern]
fn c_sum_hfa_overflow(a f64, b f64, c f64, d f64, e f64, f f64, g f64,
    value AppleFloat2, tail f64) int;
@[extern]
fn c_round_wide(value AppleWide) AppleWide;

// c_test：由 C 桥执行 C→YH 与 YH→C 的聚合 ABI 双向运行检查。
@[extern]
fn c_test() int;

// yh_round_*：由 C 调用，验证 YH 定义的聚合参数和返回 ABI。
@[extern]
pub fn yh_round_byte(value AppleByte) AppleByte { return value; }
@[extern]
pub fn yh_round_triple(value AppleTriple) AppleTriple { return value; }
@[extern]
pub fn yh_round_word(value AppleWord) AppleWord { return value; }
@[extern]
pub fn yh_round_pair16(value ApplePair16) ApplePair16 { return value; }
@[extern]
pub fn yh_round_nine(value AppleNine) AppleNine { return value; }
@[extern]
pub fn yh_round_union(value AppleUnion) AppleUnion { return value; }
@[extern]
pub fn yh_round_float_union(value AppleFloatUnion) AppleFloatUnion {
    value.values[1] += 2.0;
    return value;
}
@[extern]
pub fn yh_round_float2(value AppleFloat2) AppleFloat2 { return value; }
@[extern]
pub fn yh_round_hfa3(value AppleHfa3) AppleHfa3 { return value; }
// yh_adjust_hfa：供 C 间接调用的 HFA 回调，变更两项以检查寄存器值顺序。
@[extern]
pub fn yh_adjust_hfa(value AppleFloat2) AppleFloat2 {
    return AppleFloat2{value.left + 1.0, value.right + 2.0};
}
// yh_nested_hfa：接收 C callback 后再调 C 函数，覆盖 C→YH→C 的 HFA 嵌套边界。
@[extern]
pub fn yh_nested_hfa(value AppleFloat2) AppleFloat2 {
    let adjusted AppleFloat2 = c_adjust_hfa(value);
    return AppleFloat2{adjusted.left + 1.0, adjusted.right + 2.0};
}
// yh_call_hfa_callback：把 YH HFA 函数值交给 C，再由 C 反向调用。
@[extern]
pub fn yh_call_hfa_callback(value AppleFloat2) AppleFloat2 {
    return c_apply_hfa_callback(yh_nested_hfa, value);
}
// yh_call_returned_hfa_callback：从 C 获取 HFA 函数指针并执行间接聚合调用。
@[extern]
pub fn yh_call_returned_hfa_callback(value AppleFloat2) AppleFloat2 {
    let callback @[extern] fn(AppleFloat2) AppleFloat2 = c_choose_hfa_callback();
    return callback(value);
}
@[extern]
pub fn yh_sum_hfa_overflow(a f64, b f64, c f64, d f64, e f64, f f64, g f64,
    value AppleFloat2, tail f64) int {
    return a.to_type(int) + b.to_type(int) + c.to_type(int) + d.to_type(int)
        + e.to_type(int) + f.to_type(int) + g.to_type(int)
        + value.left.to_type(int) + value.right.to_type(int) + tail.to_type(int);
}
@[extern]
pub fn yh_round_wide(value AppleWide) AppleWide {
    value.third = value.third + 5;
    return value;
}

// yh_call_*：YH 转调 C 函数并返回聚合结果，覆盖反向调用边界。
@[extern]
pub fn yh_call_byte(value AppleByte) AppleByte { return c_round_byte(value); }
@[extern]
pub fn yh_call_triple(value AppleTriple) AppleTriple { return c_round_triple(value); }
@[extern]
pub fn yh_call_word(value AppleWord) AppleWord { return c_round_word(value); }
@[extern]
pub fn yh_call_pair16(value ApplePair16) ApplePair16 { return c_round_pair16(value); }
@[extern]
pub fn yh_call_nine(value AppleNine) AppleNine { return c_round_nine(value); }
@[extern]
pub fn yh_call_union(value AppleUnion) AppleUnion { return c_round_union(value); }
@[extern]
pub fn yh_call_float_union(value AppleFloatUnion) AppleFloatUnion {
    return c_round_float_union(value);
}
@[extern]
pub fn yh_call_float2(value AppleFloat2) AppleFloat2 { return c_round_float2(value); }
@[extern]
pub fn yh_call_hfa3(value AppleHfa3) AppleHfa3 { return c_round_hfa3(value); }
@[extern]
pub fn yh_call_hfa_overflow(a f64, b f64, c f64, d f64, e f64, f f64, g f64,
    value AppleFloat2, tail f64) int {
    return c_sum_hfa_overflow(a, b, c, d, e, f, g, value, tail);
}
@[extern]
pub fn yh_call_wide(value AppleWide) AppleWide { return c_round_wide(value); }

// main：进入 C 桥的跨语言验收驱动。
fn main() int { return c_test(); }
