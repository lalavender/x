// 内嵌桥源级调用契约：本片只校验旧种子能解析声明，LL3 接入后运行调用。
module main;

@[extern] fn yh_llvm_version() *char;
@[extern] fn yh_llvm_emit(text *char, length u64, triple *char, opt_level int,
    kind int, output *char, diagnostic *char, capacity u64) int;

// main：后续原生 yh 编译此探针并链接内嵌桥，成功生成对象须返回 0。
fn main() int {
    let text *char = "define i32 @main() { ret i32 0 }\n";
    let diagnostic [4096]char;
    return yh_llvm_emit(text, strlen(text), "x86_64-unknown-linux-gnu", 0,
        0, "tmp/llvm-migration/embedded/yh-probe.o", &diagnostic[0], 4096);
}
