// 固定点探针覆盖前向调用、浮点结构体传参和控制流。
pub struct FixedPointProbe {
    x f64
    y f64
}

fn main() int {
    let value FixedPointProbe = FixedPointProbe { x: 1.0, y: 2.0 }
    let total int = calculate(value, 3)
    let index int = 0
loop:
    index += 1
    if (index < 3) {
        goto loop
    }
    if (total + index != 9) {
        return 1
    }
    return 0
}

fn calculate(value FixedPointProbe, extra int) int {
    return value.x.to_type(int) + value.y.to_type(int) + extra
}
