// Darwin LLVM 连续自举固定点探针：聚合传值、环境指针与自有运行时输出。
//
// 各候选代（B/C/D × O0/O2）都编译并运行同一份探针，确保 Apple ABI 与
// yh 自有用运行时在代际间保持同一行为；成功返回 0。

let saved_environment **char = 0;

struct DarwinFixedPointRecord {
    whole int;
    fraction f64;
}

// darwin_fixedpoint_sum：按值读取聚合，固定各候选代的 Apple ABI。
fn darwin_fixedpoint_sum(record DarwinFixedPointRecord) int {
    return record.whole + record.fraction.to_type(int);
}

// main：验证聚合、短路循环与 printf 输出；成功返回零。
fn main(argc int, argv **char, envp **char) int {
    saved_environment = envp;
    let record DarwinFixedPointRecord = DarwinFixedPointRecord {
        whole: argc, fraction: 2.0,
    };
    let count int = 0;
    for count < 3 && saved_environment == envp {
        count += 1;
    }
    printf("llvm-darwin %d\n", darwin_fixedpoint_sum(record));
    if (darwin_fixedpoint_sum(record) != argc + 2) { return 1; }
    if (count != 3) { return 2; }
    return 0;
}
