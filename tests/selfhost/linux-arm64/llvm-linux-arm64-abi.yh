module abi

// LLVM Linux/AArch64 C ABI 探针：标量、HFA、小聚合、大聚合与双向回调。
// C 侧实现 c_*，本文件提供对应 @[extern] 声明、YH 导出函数和运行入口。

// H2：两个 double 的 HFA，按 AAPCS64 走 v0/v1 而非整数寄存器。
@[extern]
pub struct H2 { a f64; b f64 }

// H3：三个 double 的 HFA，验证 HFA 元素计数与寄存器顺序。
@[extern]
pub struct H3 { a f64; b f64; c f64 }

// P16：两个整数八字节的 16 字节聚合，参数/返回各占两个 X 寄存器。
@[extern]
pub struct P16 { a u64; b u64 }

// W24：24 字节聚合，超过 16 字节，按间接参数和 sret 返回。
@[extern]
pub struct W24 { a u64; b u64; c u64 }

// c_i8：C 有符号 8 位标量，核对 signext。
@[extern]
fn c_i8(value i8) i8

// c_u16：C 无符号 16 位标量，核对 zeroext。
@[extern]
fn c_u16(value u16) u16

// c_bool：C _Bool，核对 i1 边界。
@[extern]
fn c_bool(value bool) bool

// c_mixed：交错整数/浮点参数，核对 GPR 与 v 寄存器各自计数。
@[extern]
fn c_mixed(a i32, b f64, c i64, d f32, e u64, f i32, g f64, h u32) i64

// c_h2：HFA2 直接按值往返。
@[extern]
fn c_h2(value H2) H2

// c_h3：HFA3 直接按值往返。
@[extern]
fn c_h3(value H3) H3

// c_p16：16 字节整数聚合直接按值往返。
@[extern]
fn c_p16(value P16) P16

// c_w24：24 字节聚合经间接参数和 sret 往返。
@[extern]
fn c_w24(value W24) W24

// c_adjust_hfa：C 侧修改 HFA 成员，供 YH→C 与 C→YH 双向核对。
@[extern]
fn c_adjust_hfa(value H2) H2

// c_apply_hfa：C 侧接收 YH 函数值并回调，核对 HFA 函数指针 ABI。
@[extern]
fn c_apply_hfa(callback @[extern] fn(H2) H2, value H2) H2

// c_choose_hfa：C 侧返回函数值，核对 HFA 函数指针返回值。
@[extern]
fn c_choose_hfa() @[extern] fn(H2) H2

// c_test：C 侧调用全部 YH 导出函数，完成 C→YH 方向检查。
@[extern]
fn c_test() int

// yh_h2：YH 侧 HFA2 恒等函数，供 C 调用。
@[extern]
pub fn yh_h2(value H2) H2 { return value }

// yh_h3：YH 侧 HFA3 恒等函数，供 C 调用。
@[extern]
pub fn yh_h3(value H3) H3 { return value }

// yh_p16：YH 侧 16 字节整数聚合恒等函数。
@[extern]
pub fn yh_p16(value P16) P16 { return value }

// yh_w24：YH 侧 24 字节聚合修改中间成员，供 C 核对 sret 内容。
@[extern]
pub fn yh_w24(value W24) W24 {
    value.b += 3
    return value
}

// yh_adjust_hfa：YH HFA 回调，返回调整后的两个成员。
@[extern]
pub fn yh_adjust_hfa(value H2) H2 {
    return H2{value.a + 10.0, value.b + 20.0}
}

// yh_apply_hfa：把 YH 函数值交给 C，再由 C 反向调用。
@[extern]
pub fn yh_apply_hfa(callback @[extern] fn(H2) H2, value H2) H2 {
    return c_apply_hfa(callback, value)
}

// yh_call_returned_hfa：取回 C 返回的函数值并执行 HFA 间接调用。
@[extern]
pub fn yh_call_returned_hfa(value H2) H2 {
    let callback @[extern] fn(H2) H2 = c_choose_hfa()
    return callback(value)
}

// main：先做 YH→C，再通过 c_test 做 C→YH，最后覆盖 C→YH→C 的回调链。
fn main() int {
    if (c_i8(-123) != -123 || c_u16(60001) != 60001) { return 1 }
    if (c_bool(2.to_type(bool)) != true || c_bool(false) != false) { return 2 }
    if (c_mixed(1, 2.0, 3, 4.0.to_type(f32), 5, 6, 7.0, 8) != 7443) { return 3 }

    let h H2 = H2{1.5, 2.5}
    let rh H2 = c_h2(h)
    if (rh.a != 1.5 || rh.b != 2.5) { return 4 }
    let h3 H3 = H3{1.0, 2.0, 3.0}
    let rh3 H3 = c_h3(h3)
    if (rh3.a != 1.0 || rh3.b != 2.0 || rh3.c != 3.0) { return 5 }

    let p P16 = P16{11, 22}
    let rp P16 = c_p16(p)
    if (rp.a != 11 || rp.b != 22) { return 6 }
    let w W24 = W24{1, 2, 3}
    let rw W24 = c_w24(w)
    if (rw.a != 1 || rw.b != 5 || rw.c != 3) { return 7 }

    let adjusted H2 = c_adjust_hfa(h)
    if (adjusted.a != 11.5 || adjusted.b != 22.5) { return 8 }
    let applied H2 = yh_apply_hfa(yh_adjust_hfa, h)
    if (applied.a != 11.5 || applied.b != 22.5) { return 9 }
    let returned H2 = yh_call_returned_hfa(h)
    if (returned.a != 11.5 || returned.b != 22.5) { return 10 }

    if (c_test() != 0) { return 11 }
    return 0
}
