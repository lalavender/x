module main;
import gen;
import lex;
import parse;

// ============================================================================
// module_build.yh —— 项目构建管线（MOD-U4/U5）
//
// 命令（设计 §11）：
//   yh build [-o out] [module]   构建项目（有 entry 构建程序，否则库模块）
//   yh run                       构建并运行清单 entry
//   yh list [--resolve name]     列出模块/解释导入绑定（project.yh）
//   yh --emit-module M ROOT -o S （内部）把模块 M 编译为独立汇编 S
//
// 构建流程：装载项目与依赖 → 绑定导入 → topo 排序（环报完整链）→
// 依赖序逐模块编译。每个模块一次独立子进程（--emit-module，自身
// argv[0] 再入）：加载其导入的接口 → 两遍编译模块全部文件 → 产出
// 独立 .s 与接口 .s.i（pub 符号 GLOBAL、私有 LOCAL、符号带
// __proj__mod 后缀）→ 最后 gcc/clang 一次链接全部 .s。
//
// 缓存（U5）：解析不缓存（每轮重解析——重绑定由构造保证）；对象缓存
// 按 manifest 内容哈希：后缀+entry+各源文件内容+各依赖接口内容+版本
// 标记，命中且 .s/.i 存在则跳过重编译；发射确定性（G3 已证）保证
// 冷热构建一致。接口加载时校验头行（版本/架构），损坏或不兼容的
// 接口干净拒绝，不回退低层。
//
// ponytail: 经 system+ls/printenv 访问目录与环境（stage0 prelude 冻结，
// 无 opendir/getenv）；路径含空格/引号不受支持，fixture 路径保持简单。
// ============================================================================

// c_argv0：自身可执行路径（argv[0] 借用，不复制）——子进程再入用。
pub let c_argv0 *char = 0;

// mb_fnv：FNV-1a 32 位增量哈希（用 u64 运算，每步掩码到 32 位——
// 自编子集没有 u32）。
pub fn mb_fnv(h *u64, b u8) void {
    h[0] = h[0] ^ b.to_type(u64);
    h[0] = (h[0] * 16777619) & 0xFFFFFFFF;
}

// mb_hash_file：把文件内容混入哈希（read_source 读入；失败 -1）。
pub fn mb_hash_file(h *u64, path *char) int {
    if (gen.read_source(path) != 0) {
        return -1;
    }
    let i int = 0;
    for i < gen.c_src_len {
        mb_fnv(h, gen.c_src[i]);
        i += 1;
    }
    return 0;
}

// mb_build_dir：构建目录 = <root>/.build（返回池内偏移；用户规划）。
pub fn mb_build_dir(root_off int, root_len int) int {
    if (pj_canon(root_off, root_len, ".build") != 0) {
        return -1;
    }
    return pj_canon_off;
}

// mb_sub_dir：.build 下子目录路径（asm/obj/iface/manifest），intern 后返回。
pub fn mb_sub_dir(build_off int, build_len int, sub *char) int {
    if (pj_canon(build_off, build_len, sub) != 0) {
        return -1;
    }
    return pj_canon_off;
}

// mb_mkdir：确保构建目录存在。
pub fn mb_mkdir(dir *char) int {
    // 建 .build 四子目录（asm/obj/iface/manifest）
    let subs [4]*char;
    subs[0] = "asm";
    subs[1] = "obj";
    subs[2] = "iface";
    subs[3] = "manifest";
    let k int = 0;
    for k < 4 {
        let cmd [1100]u8;
        let n int = 0;
        n = gen.append_str(cmd, n, "/bin/mkdir -p ");
        n = pj_shell_quote(cmd, n, dir);
        n = gen.append_byte(cmd, n, '/');
        n = gen.append_str(cmd, n, subs[k]);
        cmd[n] = 0;
        if (system(gen.arr_cstr(cmd)) != 0) {
            return gen.fail_path("无法创建构建目录: ", dir);
        }
        k += 1;
    }
    return 0;
}

// mb_dep_*：模块导入的去重清单（按解析结果模块下标去重）。
// bind/bindlen = 绑定名（诊断用）；ifoff = 接口路径；mod = 解析模块下标；
// mi = 该模块接口加载后的 ModInfo 下标（mb_emit_module 填写）。
pub let mb_dep_bind *int = 0;
pub let mb_dep_bindlen *int = 0;
pub let mb_dep_ifoff *int = 0;
pub let mb_dep_mod *int = 0;
pub let mb_dep_mi *int = 0;
pub let mb_dep_n int = 0;
pub let mb_dep_cap int = 0;
pub let mb_dep_base int = 0;    // 本模块接口加载前 c_mod_n 基线

// mb_mod_tag：模块产物的唯一文件名标签 <sanitize(proj)>-<module>。
// 同名模块可能来自不同项目（KEY.MOD 导入），文件名必须含项目。
pub fn mb_mod_tag(m int, off *int, olen *int) int {
    let tmp [512]u8;
    let n int = 0;
    let i int = 0;
    for i < gen.p_projs[gen.p_mods[m].proj].name_len {
        let b u8 = gen.np_data[gen.p_projs[gen.p_mods[m].proj].name_off + i];
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_')) {
            b = '_';
        }
        tmp[n] = b;
        n += 1;
        i += 1;
    }
    tmp[n] = '-';
    n += 1;
    i = 0;
    for i < gen.p_mods[m].name_len {
        let b2 u8 = gen.np_data[gen.p_mods[m].name_off + i];
        if (!((b2 >= 'a' && b2 <= 'z') || (b2 >= 'A' && b2 <= 'Z')
            || (b2 >= '0' && b2 <= '9') || b2 == '_')) {
            b2 = '_';
        }
        tmp[n] = b2;
        n += 1;
        i += 1;
    }
    tmp[n] = 0;
    off[0] = gen.tml_intern_str(tmp, 0, n);
    olen[0] = n;
    if (off[0] < 0) {
        return -1;
    }
    return 0;
}

// mb_module_iface_deps：收集模块 M 的全部导入（按解析结果模块下标去重），
// 接口路径 = <build>/iface/<tag>.s.i。
pub fn mb_module_iface_deps(m int, build_off int, build_len int) int {
    mb_dep_n = 0;
    let fi int = 0;
    for fi < gen.p_mods[m].file_n {
        let f int = gen.p_mods[m].files[fi];
        let ii int = 0;
        for ii < gen.p_imp_n {
            if (gen.p_imp_file[ii] != f || gen.p_imp_mod[ii] < 0) {
                ii += 1;
                continue;
            }
            let target int = gen.p_imp_mod[ii];
            // 去重：同一解析结果模块只收集一次
            let dup int = 0;
            let k int = 0;
            for k < mb_dep_n {
                if (mb_dep_mod[k] == target) {
                    dup = 1;
                    break;
                }
                k += 1;
            }
            if (dup == 0) {
                if (mb_dep_n == mb_dep_cap) {
                    let ncap int = mb_dep_cap * 2;
                    if (ncap == 0) {
                        ncap = 8;
                    }
                    let na *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (na == 0) {
                        return gen.fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(na, mb_dep_bind, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_bind);
                    mb_dep_bind = na;
                    let nb *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (nb == 0) {
                        return gen.fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(nb, mb_dep_bindlen, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_bindlen);
                    mb_dep_bindlen = nb;
                    let nc *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (nc == 0) {
                        return gen.fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(nc, mb_dep_ifoff, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_ifoff);
                    mb_dep_ifoff = nc;
                    let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (ndm == 0) {
                        return gen.fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(ndm, mb_dep_mod, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_mod);
                    mb_dep_mod = ndm;
                    let ndi *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (ndi == 0) {
                        return gen.fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(ndi, mb_dep_mi, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_mi);
                    mb_dep_mi = ndi;
                    mb_dep_cap = ncap;
                }
                mb_dep_bind[mb_dep_n] = gen.p_imp_off[ii];
                mb_dep_bindlen[mb_dep_n] = gen.p_imp_len[ii];
                mb_dep_mod[mb_dep_n] = target;
                mb_dep_mi[mb_dep_n] = -1;
                // 接口路径 = <build>/iface/<tag>.s.i
                if (mb_mod_tag(target, &pj_canon_off, &pj_canon_len) != 0) {
                    return -1;
                }
                let pbuf [600]u8;
                let pn int = 0;
                pn = gen.append_str(pbuf, pn, pj_pool_str(build_off));
                pn = gen.append_str(pbuf, pn, "/iface/");
                pn = gen.append_str(pbuf, pn, pj_pool_str(pj_canon_off));
                pn = gen.append_str(pbuf, pn, ".s.i");
                let po int = gen.tml_intern_str(pbuf, 0, pn);
                if (po < 0) {
                    return -1;
                }
                mb_dep_ifoff[mb_dep_n] = po;
                mb_dep_n += 1;
            }
            ii += 1;
        }
        fi += 1;
    }
    return mb_dep_n;
}

// mb_open_out：以平台正确的旗标打开输出文件（覆盖写）。
pub fn mb_open_out(path *char) int {
    let flg int = 0x241;
    if (gen.tg_darwin() != 0) {
        flg = 0x601;
    }
    return open(path, flg, 0x1a4);
}

// mb_compile_one：编译单个模块（含 U5 对象缓存判断）。返回 0 成功。
// root_off/len：项目根（调用方捕获的池偏移；函数内部 canon 会改写全局
// 游标，故由调用方先取好）。
pub fn mb_compile_one(m int, root_off int, root_len int, build_off int, build_len int) int {
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (pj_mod_suffix(gen.p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    let is_entry int = gen.p_mods[m].is_entry;
    // 产物路径 = .build/{asm,iface,manifest}/<tag>（tag 含项目，防同名冲突）
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1;
    }
    let tag_off int = pj_canon_off;
    let tag_len int = pj_canon_len;
    if (pj_canon(build_off, build_len, "asm") != 0) {
        return -1;
    }
    let spath [600]u8;
    let sn int = 0;
    sn = gen.append_str(spath, sn, pj_pool_str(pj_canon_off));
    sn = gen.append_byte(spath, sn, '/');
    sn = gen.append_str(spath, sn, pj_pool_str(tag_off));
    sn = gen.append_str(spath, sn, ".s");
    spath[sn] = 0;
    if (pj_canon(build_off, build_len, "iface") != 0) {
        return -1;
    }
    let ipath [600]u8;
    let in2 int = 0;
    in2 = gen.append_str(ipath, in2, pj_pool_str(pj_canon_off));
    in2 = gen.append_byte(ipath, in2, '/');
    in2 = gen.append_str(ipath, in2, pj_pool_str(tag_off));
    in2 = gen.append_str(ipath, in2, ".s.i");
    ipath[in2] = 0;
    if (pj_canon(build_off, build_len, "manifest") != 0) {
        return -1;
    }
    let mpath [600]u8;
    let mn int = 0;
    mn = gen.append_str(mpath, mn, pj_pool_str(pj_canon_off));
    mn = gen.append_byte(mpath, mn, '/');
    mn = gen.append_str(mpath, mn, pj_pool_str(tag_off));
    mn = gen.append_str(mpath, mn, ".manifest");
    mpath[mn] = 0;
    // —— manifest 哈希（U5）——
    let h u64 = 2166136261;
    let hi int = 0;
    for hi < sfx_len {
        mb_fnv(&h, gen.np_data[sfx_off + hi]);
        hi += 1;
    }
    mb_fnv(&h, ('0' + is_entry).to_type(u8));
    mb_fnv(&h, '\n');
    let fi int = 0;
    for fi < gen.p_mods[m].file_n {
        if (mb_hash_file(&h, pj_pool_str(gen.p_files[gen.p_mods[m].files[fi]].path_off)) != 0) {
            return -1;
        }
        fi += 1;
    }
    // 依赖接口内容（解析结果变化 → 接口路径变化 → 哈希变化）
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1;
    }
    let di int = 0;
    for di < mb_dep_n {
        if (pj_file_exists(pj_pool_str(mb_dep_ifoff[di])) == 0) {
            // 依赖接口缺失：视为需要重编译
            di = mb_dep_n + 1;
            break;
        }
        if (mb_hash_file(&h, pj_pool_str(mb_dep_ifoff[di])) != 0) {
            return -1;
        }
        di += 1;
    }
    let deps_ok int = 1;
    if (di == mb_dep_n + 1) {
        deps_ok = 0;
    }
    // 编译器身份：对自身二进制 FNV（滚动代次下热缓存必需）
    if (mb_hash_file(&h, c_argv0) != 0) {
        return -1;
    }
    // 版本标记
    let tag *char = "yh-iface-cache-1";
    let ti int = 0;
    for tag[ti] != 0 {
        mb_fnv(&h, tag[ti].to_type(u8));
        ti += 1;
    }
    // 期望 manifest（十六进制串）
    let want [16]u8;
    let wn int = 0;
    let digits *char = "0123456789abcdef";
    let shift int = 28;
    for shift >= 0 {
        want[wn] = digits[((h >> shift) & 15).to_type(int)].to_type(u8);
        wn += 1;
        shift -= 4;
    }
    // 缓存命中：三个产物齐全且 manifest 字节一致
    if (deps_ok != 0 && pj_file_exists(gen.arr_cstr(spath)) != 0
        && pj_file_exists(gen.arr_cstr(ipath)) != 0
        && pj_file_exists(gen.arr_cstr(mpath)) != 0) {
        if (gen.read_source(gen.arr_cstr(mpath)) == 0 && gen.c_src_len == wn) {
            let same int = 1;
            let ci int = 0;
            for ci < wn {
                if (gen.c_src[ci] != want[ci]) {
                    same = 0;
                    break;
                }
                ci += 1;
            }
            if (same != 0) {
                pj_out_s("  [缓存] ");
                pj_out_np(gen.p_mods[m].name_off, gen.p_mods[m].name_len);
                pj_out_s("\n");
                return 0;
            }
        }
    }
    // —— 子进程编译（提供方项目根 + 主项目根） ——
    let prov int = gen.p_mods[m].proj;
    let cmd [2200]u8;
    let cn int = 0;
    cn = mb_self_cmd(cmd, cn);
    cn = gen.append_str(cmd, cn, " --emit-module ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(gen.p_mods[m].name_off));
    cn = gen.append_str(cmd, cn, " ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(gen.p_projs[prov].root_off));
    cn = gen.append_str(cmd, cn, " ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(root_off));
    cn = gen.append_str(cmd, cn, " -o ");
    cn = pj_shell_quote(cmd, cn, gen.arr_cstr(spath));
    cmd[cn] = 0;
    if (system(gen.arr_cstr(cmd)) != 0) {
        let buf [128]u8;
        let bn int = 0;
        bn = gen.append_str(buf, bn, "模块编译失败: ");
        bn = append_bytes_np(buf, bn, gen.p_mods[m].name_off, gen.p_mods[m].name_len);
        let mo int = gen.tml_intern_str(buf, 0, bn);
        if (mo < 0) {
            return -1;
        }
        return gen.fail(gen.np_cstr(mo));
    }
    // 写 manifest
    let fd int = mb_open_out(gen.arr_cstr(mpath));
    if (fd < 0) {
        return gen.fail_path("无法写 manifest: ", gen.arr_cstr(mpath));
    }
    gen.write_all(fd, want, wn);
    close(fd);
    pj_out_s("  [编译] ");
    pj_out_np(gen.p_mods[m].name_off, gen.p_mods[m].name_len);
    pj_out_s("\n");
    return 0;
}

// —— 子进程：--emit-module M ROOT -o out.s ——

// mb_file_head_bind：解析当前文件头并绑定导入（编译前每文件调用）。
// 先重置文件级导入表——pass 2 会对同一文件再次解析文件头。
pub fn mb_file_head_bind(fi int) int {
    // 绑定不再按名匹配：cmd 侧持有扫描期的解析结果（p_imp），按声明位置
    // （line/col）对应后把 ModInfo 下标直接写入 mod_import_mod。
    // 支持别名与跨项目 KEY.MOD 导入（解析结果与名字解耦）。
    parse.mod_reset_file();
    if (parse.mod_parse_head() != 0) {
        return -1;
    }
    let i int = 0;
    for i < gen.mod_import_n {
        let found int = -1;
        let ii int = 0;
        for ii < gen.p_imp_n {
            if (gen.p_imp_file[ii] == fi
                && gen.p_imp_line[ii] == gen.mod_imports[i].line
                && gen.p_imp_col[ii] == gen.mod_imports[i].col) {
                found = ii;
                break;
            }
            ii += 1;
        }
        if (found < 0) {
            return gen.err_lc(gen.mod_imports[i].line, gen.mod_imports[i].col,
                "内部错误：导入与扫描记录不对应");
        }
        let target int = gen.p_imp_mod[found];
        let mi int = -1;
        let di int = 0;
        for di < mb_dep_n {
            if (mb_dep_mod[di] == target) {
                mi = mb_dep_base + di;
                break;
            }
            di += 1;
        }
        if (mi < 0) {
            return gen.err_lc(gen.mod_imports[i].line, gen.mod_imports[i].col,
                "内部错误：导入的接口未加载");
        }
        gen.mod_import_mod[i] = mi;
        gen.mod_import_used[i] = 0;
        i += 1;
    }
    return 0;
}

// mb_pass1_file：pass 1 读入并登记一个源文件（含头解析与绑定）。
pub fn mb_pass1_file(path *char, fi int) int {
    if (gen.read_source(path) != 0) {
        return -1;
    }
    gen.c_tok_n = 0;
    gen.c_pos = 0;
    gen.c_path = path;
    if (lex.lex_all() != 0) {
        return -1;
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1;
    }
    for parse.p_cur() != gen.TOK_EOF {
        if (parse.parse_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

// mb_globals_or_fns：pass 2a/2b 复用现有子遍（头已消费，头解析在先）。
// is_globals=1 走 parse_source_globals，否则 parse_source_fns。
pub fn mb_pass2_file(path *char, fi int, is_globals int) int {
    if (gen.read_source(path) != 0) {
        return -1;
    }
    gen.c_tok_n = 0;
    gen.c_pos = 0;
    gen.c_path = path;
    if (lex.lex_all() != 0) {
        return -1;
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1;
    }
    if (is_globals != 0) {
        if (parse.parse_source_globals() != 0) {
            return -1;
        }
    } else {
        if (parse.parse_source_fns() != 0) {
            return -1;
        }
        // 未使用导入检查（U3）：本文件编译完后仍为零使用的导入报错
        let i int = 0;
        for i < gen.mod_import_n {
            if (gen.mod_import_used[i] == 0) {
                return gen.err_lc(gen.mod_imports[i].line, gen.mod_imports[i].col,
                    "导入未使用（同文件没有任何限定名引用）");
            }
            i += 1;
        }
    }
    return 0;
}

// mb_check_binding_clash：导入名与本模块顶层声明重名检查（pass1 后）。
// 遍历模块全部文件的导入，逐个查全局符号表。
pub fn mb_check_binding_clash(m int) int {
    let fi int = 0;
    for fi < gen.p_mods[m].file_n {
        let f int = gen.p_mods[m].files[fi];
        let ii int = 0;
        for ii < gen.p_imp_n {
            if (gen.p_imp_file[ii] != f) {
                ii += 1;
                continue;
            }
            let idx int = gen.sym_lookup_off(gen.p_imp_off[ii], gen.p_imp_len[ii]);
            if (idx >= 0 && (gen.c_syms[idx].flags & gen.F_GLOBAL) != 0
                && (gen.c_syms[idx].flags & gen.F_EXTERN) == 0) {
                let buf [192]u8;
                let n int = 0;
                n = gen.append_int(buf, n, gen.c_syms[idx].def_line);
                n = gen.append_byte(buf, n, ':');
                n = gen.append_int(buf, n, gen.c_syms[idx].def_col);
                n = gen.append_str(buf, n, ": 顶层声明与导入名冲突（导入名 ");
                n = append_bytes_np(buf, n, gen.p_imp_off[ii], gen.p_imp_len[ii]);
                n = gen.append_str(buf, n, "）");
                let mo int = gen.tml_intern_str(buf, 0, n);
                if (mo < 0) {
                    return -1;
                }
                gen.c_errors += 1;
                let out [256]u8;
                let on int = 0;
                on = gen.append_str(out, on, pj_pool_str(gen.p_files[f].path_off));
                on = gen.append_byte(out, on, ':');
                on = append_bytes_np(out, on, mo, n);
                on = gen.append_byte(out, on, '\n');
                gen.write_all(2, out, on);
                return -1;
            }
            ii += 1;
        }
        fi += 1;
    }
    return 0;
}

// mb_emit_module：子进程入口——编译一个模块为独立汇编 + 接口。
// prov_root：模块提供方项目根（在其中查找模块）；main_root：主项目根
// （构建目录基准，接口路径与父进程一致）。
pub fn mb_emit_module(mod_off int, mod_len int, prov_off int, prov_len int, main_off int, main_len int, out_s *char) int {
    if (mb_load_stdlib() != 0) {
        return -1;
    }
    let proj int = pj_load_project(prov_off, prov_len);
    if (proj < 0) {
        return -1;
    }
    if (pj_bind_imports() != 0) {
        return -1;
    }
    let m int = pj_mod_in_proj(proj, mod_off, mod_len);
    if (m < 0) {
        return gen.fail("内部错误：模块不在索引中");
    }
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (pj_mod_suffix(gen.p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    gen.c_module_mode = 1;
    gen.c_is_entry_mod = gen.p_mods[m].is_entry;
    gen.c_sym_sfx_off = sfx_off;
    gen.c_sym_sfx_len = sfx_len;
    if (gen.sem_init_tables() != 0) {
        return -1;
    }
    gen.ty_register_builtins();
    gen.scope_push();
    if (gen.sem_register_prelude() != 0) {
        return -1;
    }
    // 加载导入接口（确定序；构建目录以主项目根为基准）
    let build_off int = mb_build_dir(main_off, main_len);
    if (build_off < 0) {
        return -1;
    }
    let build_len int = pj_canon_len;
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1;
    }
    let di int = 0;
    for di < mb_dep_n {
            if (parse.iface_load(pj_pool_str(mb_dep_ifoff[di]), mb_dep_bind[di], mb_dep_bindlen[di]) < 0) {
            return -1;
        }
        di += 1;
    }
    // 登记基线（接口之后、本模块声明之前）
    let sym_base int = gen.c_sym_n;
    let tname_base int = gen.t_name_n;
    // pass 1：全部源文件（接口加载把 c_pass 留在了 2，必须复位）
    gen.c_compile = 1;
    gen.c_pass = 1;
    let fi int = 0;
    for fi < gen.p_mods[m].file_n {
        if (mb_pass1_file(pj_pool_str(gen.p_files[gen.p_mods[m].files[fi]].path_off), gen.p_mods[m].files[fi]) != 0) {
            return -1;
        }
        fi += 1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    if (mb_check_binding_clash(m) != 0) {
        return -1;
    }
    // 入口模块才要求 main
    if (gen.c_is_entry_mod != 0 && gen.sem_check_main() != 0) {
        return -1;
    }
    // pass 2a/2b：函数体与全局初始化（c_pass=2）
    gen.c_pass = 2;
    let fi2 int = 0;
    for fi2 < gen.p_mods[m].file_n {
        if (mb_pass2_file(pj_pool_str(gen.p_files[gen.p_mods[m].files[fi2]].path_off), gen.p_mods[m].files[fi2], 1) != 0) {
            return -1;
        }
        fi2 += 1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    // 接口发射到 .build/iface/<tag>.s.i（与 mb_module_iface_deps 的
    // 查找路径一致；tag 由提供方项目 + 模块名构成）
    let build_off2 int = mb_build_dir(main_off, main_len);
    if (build_off2 < 0) {
        return -1;
    }
    let build_len2 int = pj_canon_len;
    if (pj_canon(build_off2, build_len2, "iface") != 0) {
        return -1;
    }
    let iface_dir_off int = pj_canon_off;
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1;
    }
    let ipath [620]u8;
    let in2 int = 0;
    in2 = gen.append_str(ipath, in2, pj_pool_str(iface_dir_off));
    in2 = gen.append_byte(ipath, in2, '/');
    in2 = gen.append_str(ipath, in2, pj_pool_str(pj_canon_off));
    in2 = gen.append_str(ipath, in2, ".s.i");
    ipath[in2] = 0;
    if (parse.iface_emit(gen.arr_cstr(ipath), sym_base, tname_base) != 0) {
        return -1;
    }
    // pass 2b：函数体
    let fi3 int = 0;
    for fi3 < gen.p_mods[m].file_n {
        if (mb_pass2_file(pj_pool_str(gen.p_files[gen.p_mods[m].files[fi3]].path_off), gen.p_mods[m].files[fi3], 0) != 0) {
            return -1;
        }
        fi3 += 1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    // .bss
    let bi int = 0;
    for bi < gen.c_bss_n {
        let bidx int = gen.c_bss_syms[bi];
        if (gen.em_bss_symbol(bidx, gen.t_types[gen.c_syms[bidx].type_id].size, gen.t_types[gen.c_syms[bidx].type_id].align) != 0) {
            return -1;
        }
        bi += 1;
    }
    // 写汇编
    if (drv_write_asm(out_s) != 0) {
        return -1;
    }
    return 0;
}

// —— 父进程：build / run ——

// mb_self_cmd：把自身路径以引号写入命令缓冲。
pub fn mb_self_cmd(buf *u8, n int) int {
    return pj_shell_quote(buf, n, c_argv0);
}

// mb_intern_arg：命令行参数字符串入名字池，返回偏移（长度出参）。
pub fn mb_intern_arg(s *char, olen *int) int {
    let sl int = 0;
    for s[sl] != 0 {
        sl += 1;
    }
    olen[0] = sl;
    return gen.tml_intern_str(s.to_type(*u8), 0, sl);
}

// mb_load_stdlib：装载 YH_STDLIB 指定的标准库项目（未设置则无标准库层）。
pub fn mb_load_stdlib() int {
    if (gen.p_stdlib >= 0) {
        return 0;
    }
    let off int = -1;
    let olen int = 0;
    if (pj_env_fetch("YH_STDLIB", &off, &olen) < 0) {
        return -1;
    }
    if (olen == 0) {
        gen.p_stdlib = -1;
        return 0;
    }
    if (pj_canon(0, 0, pj_pool_str(off)) != 0) {
        return -1;
    }
    let s int = pj_load_project(pj_canon_off, pj_canon_len);
    if (s < 0) {
        return -1;
    }
    gen.p_stdlib = s;
    return 0;
}

// pj_topo_multi：库模式——从项目每个模块出发收集依赖序。
pub fn pj_topo_multi(proj int) int {
    if (pj_topo(gen.p_projs[proj].mods[0]) < 0) {
        return -1;
    }
    let i int = 1;
    for i < gen.p_projs[proj].mod_n {
        if (pj_mark[gen.p_projs[proj].mods[i]] != 2) {
            if (pj_dfs(gen.p_projs[proj].mods[i]) != 0) {
                return -1;
            }
        }
        i += 1;
    }
    return pj_order_n;
}

// mb_link：把全部模块 .s 链接为可执行（GNU: gcc -no-pie；Darwin: clang）。
pub fn mb_link(out_path *char, build_off int, build_len int, count int) int {
    // 两步链接（用户规划：.build/asm → .build/obj → 链接）
    let cc *char = "gcc";
    if (gen.tg_darwin() != 0) {
        cc = "clang";
    }
    // 步骤 1：逐模块汇编为 .o
    let i int = 0;
    for i < count {
        let m int = pj_order[i];
        if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
            return -1;
        }
        let spath [600]u8;
        let sn int = 0;
        sn = gen.append_str(spath, sn, pj_pool_str(build_off));
        sn = gen.append_str(spath, sn, "/asm/");
        sn = gen.append_str(spath, sn, pj_pool_str(pj_canon_off));
        sn = gen.append_str(spath, sn, ".s");
        spath[sn] = 0;
        let opath [600]u8;
        let on2 int = 0;
        on2 = gen.append_str(opath, on2, pj_pool_str(build_off));
        on2 = gen.append_str(opath, on2, "/obj/");
        on2 = gen.append_str(opath, on2, pj_pool_str(pj_canon_off));
        on2 = gen.append_str(opath, on2, ".o");
        opath[on2] = 0;
        let cmd [2200]u8;
        let cn int = 0;
        cn = gen.append_str(cmd, cn, cc);
        cn = gen.append_str(cmd, cn, " -c ");
        cn = pj_shell_quote(cmd, cn, gen.arr_cstr(spath));
        cn = gen.append_str(cmd, cn, " -o ");
        cn = pj_shell_quote(cmd, cn, gen.arr_cstr(opath));
        cmd[cn] = 0;
        if (system(gen.arr_cstr(cmd)) != 0) {
            return gen.fail_path("汇编失败: ", gen.arr_cstr(spath));
        }
        i += 1;
    }
    // 步骤 2：链接全部 .o
    let cmd2 [4096]u8;
    let n int = 0;
    if (gen.tg_darwin() != 0) {
        n = gen.append_str(cmd2, n, "clang -o ");
    } else {
        n = gen.append_str(cmd2, n, "gcc -no-pie -o ");
    }
    n = pj_shell_quote(cmd2, n, out_path);
    i = 0;
    for i < count {
        let m int = pj_order[i];
        if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
            return -1;
        }
        n = gen.append_str(cmd2, n, " ");
        n = gen.append_str(cmd2, n, pj_pool_str(build_off));
        n = gen.append_str(cmd2, n, "/obj/");
        n = gen.append_str(cmd2, n, pj_pool_str(pj_canon_off));
        n = gen.append_str(cmd2, n, ".o");
        i += 1;
    }
    cmd2[n] = 0;
    if (system(gen.arr_cstr(cmd2)) != 0) {
        return gen.fail_path("链接失败: ", out_path);
    }
    return 0;
}

// mb_cmd_build：yh build [-o out] [module]。
// argc/argv 已剥离程序名；av[0]=="build"。
pub fn mb_cmd_build(av **char, an int) int {
    let out_arg *char = 0;
    let mod_arg_off int = -1;
    let mod_arg_len int = 0;
    let i int = 1;
    for i < an {
        if (gen.cstr_eq(av[i], "-o") != 0 && i + 1 < an) {
            out_arg = av[i + 1];
            i += 2;
            continue;
        }
        // 模块参数
        let sl int = 0;
        for av[i][sl] != 0 {
            sl += 1;
        }
        let mo int = gen.tml_intern_str(av[i].to_type(*u8), 0, sl);
        if (mo < 0) {
            return -1;
        }
        mod_arg_off = mo;
        mod_arg_len = sl;
        i += 1;
    }
    gen.c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root(0);
    if (root < 0) {
        return 1;
    }
    // 捕获根路径（后续 canon 调用会改写全局游标）
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    // 构建根：显式模块参数 > 名为 main 的入口模块 > 库模式
    let rootmod int = -1;
    if (mod_arg_off >= 0) {
        rootmod = pj_mod_in_proj(proj, mod_arg_off, mod_arg_len);
        if (rootmod < 0) {
            let buf [128]u8;
            let n int = 0;
            n = gen.append_str(buf, n, "本项目没有模块: ");
            n = append_bytes_np(buf, n, mod_arg_off, mod_arg_len);
            let mo4 int = gen.tml_intern_str(buf, 0, n);
            if (mo4 < 0) {
                return -1;
            }
            return gen.fail(gen.np_cstr(mo4));
        }
    } else {
        rootmod = pj_entry_mod(proj);
    }
    // topo（依赖序）
    let count int = 0;
    if (rootmod >= 0) {
        count = pj_topo(rootmod);
        if (count < 0) {
            return 1;
        }
    } else {
        count = pj_topo_multi(proj);
        if (count < 0) {
            return 1;
        }
    }
    // 构建目录
    let build_off int = mb_build_dir(root_off, root_len);
    if (build_off < 0) {
        return 1;
    }
    let build_len int = pj_canon_len;
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1;
    }
    // 逐模块编译（依赖序）
    let ci int = 0;
    for ci < count {
        if (mb_compile_one(pj_order[ci], root_off, root_len, build_off, build_len) != 0) {
            return 1;
        }
        ci += 1;
    }
    // 链接（有入口时）
    if (rootmod >= 0) {
        let outbuf [620]u8;
        let on int = 0;
        if (out_arg != 0) {
            on = gen.append_str(outbuf, on, out_arg);
        } else {
            // 无 -o：产物名取清单 project.name
            on = gen.append_str(outbuf, on, pj_pool_str(build_off));
            on = gen.append_str(outbuf, on, "/");
            on = append_bytes_np(outbuf, on, gen.p_projs[proj].name_off,
                gen.p_projs[proj].name_len);
        }
        outbuf[on] = 0;
        if (mb_link(gen.arr_cstr(outbuf), build_off, build_len, count) != 0) {
            return 1;
        }
        pj_out_s("构建完成: ");
        pj_out_s(gen.arr_cstr(outbuf));
        pj_out_s("\n");
        return 0;
    }
    pj_out_s("库构建完成（模块对象与接口在 ");
    pj_out_np(build_off, build_len);
    pj_out_s("）\n");
    return 0;
}

// mb_cmd_run：yh run——构建清单 entry 并运行，返回程序退出码。
pub fn mb_cmd_run() int {
    gen.c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root(0);
    if (root < 0) {
        return 1;
    }
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (pj_entry_mod(proj) < 0) {
        return gen.fail("库项目没有入口，无法 run（需要一个 module main;）");
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    let rootmod int = pj_entry_mod(proj);
    let count int = pj_topo(rootmod);
    if (count < 0) {
        return 1;
    }
    let build_off int = mb_build_dir(root_off, root_len);
    if (build_off < 0) {
        return 1;
    }
    let build_len int = pj_canon_len;
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1;
    }
    let ci int = 0;
    for ci < count {
        if (mb_compile_one(pj_order[ci], root_off, root_len, build_off, build_len) != 0) {
            return 1;
        }
        ci += 1;
    }
    let binbuf [620]u8;
    let bn int = 0;
    bn = gen.append_str(binbuf, bn, pj_pool_str(build_off));
    bn = gen.append_str(binbuf, bn, "/");
    bn = append_bytes_np(binbuf, bn, gen.p_projs[proj].name_off, gen.p_projs[proj].name_len);
    binbuf[bn] = 0;
    if (mb_link(gen.arr_cstr(binbuf), build_off, build_len, count) != 0) {
        return 1;
    }
    // 运行（继承 stdout/stderr；退出码 = 程序退出码）
    let rcmd [700]u8;
    let rn int = 0;
    rn = pj_shell_quote(rcmd, rn, gen.arr_cstr(binbuf));
    rcmd[rn] = 0;
    let rc int = system(gen.arr_cstr(rcmd));
    if (rc == 0) {
        return 0;
    }
    // wait 状态：正常退出在高 8 位；信号退出按 128+sig 近似报告
    let code int = ((rc >> 8) & 255);
    if (code == 0) {
        code = 130;
    }
    return code;
}

// mb_print_version：打印当前项目的 name 与 version（清单 project.version
// 缺省时标注未声明）。quiet=1 时找不到项目静默返回（usage 顺手显示）。
pub fn mb_print_version(quiet int) int {
    let root int = pj_find_root(quiet);
    if (root < 0) {
        return 1;
    }
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    pj_out_np(gen.p_projs[proj].name_off, gen.p_projs[proj].name_len);
    if (gen.p_projs[proj].ver_off >= 0) {
        pj_out_s(" ");
        pj_out_np(gen.p_projs[proj].ver_off, gen.p_projs[proj].ver_len);
    } else {
        pj_out_s(" (未声明 version)");
    }
    pj_out_s("\n");
    return 0;
}

// mb_cmd_list：yh list [--resolve name]。
pub fn mb_cmd_list(av **char, an int) int {
    let resolve_off int = -1;
    let resolve_len int = 0;
    let has_resolve int = 0;
    let i int = 1;
    for i < an {
        if (gen.cstr_eq(av[i], "--resolve") != 0 && i + 1 < an) {
            let sl int = 0;
            for av[i + 1][sl] != 0 {
                sl += 1;
            }
            let mo int = gen.tml_intern_str(av[i + 1].to_type(*u8), 0, sl);
            if (mo < 0) {
                return -1;
            }
            resolve_off = mo;
            resolve_len = sl;
            has_resolve = 1;
            i += 2;
            continue;
        }
        usage();
        return 2;
    }
    gen.c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root(0);
    if (root < 0) {
        return 1;
    }
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    return pj_cmd_list(proj, resolve_off, resolve_len, has_resolve);
}
