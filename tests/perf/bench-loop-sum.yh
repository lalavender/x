// 整数循环基准：n 次「乘法 + 取模 + 累加」，规模由 argv[1] 决定。
// 输入运行期传入（防常量折叠/死代码消除把负载消掉），输出一行 checksum=<值>。
// 注意：int 是 32 位，累加器与大常数一律显式 i64，中间量 < 2^63。
// 期望值由 tools/perf-product.py 用同公式的 Python 参照独立算出。

const MOD i64 = 1000000007

// parse_count：十进制文本转 int；非法字符视为整体非法，回退 fallback。
fn parse_count(text *char, fallback int) int {
    let value int = 0
    let i int = 0
    if (text == 0 || text[0] == 0) {
        return fallback
    }
    for text[i] != 0 {
        // char → u8 → int 显式逐级转换；48/57 是 '0'/'9' 的码位。
        let c int = text[i].to_type(u8).to_type(int)
        if (c < 48 || c > 57) {
            return fallback
        }
        value = value * 10 + (c - 48)
        i += 1
    }
    return value
}

// mix：一次 64 位混合乘加；i * 2654435761 在 i <= 3.4e9 时不会溢出。
fn mix(acc i64, i i64) i64 {
    return (acc + (i * 2654435761) % 1000003) % MOD
}

fn main(argc int, argv **char) int {
    let n int = 50000000
    if (argc > 1) {
        let parsed int = parse_count(argv[1], 0)
        if (parsed > 0) {
            n = parsed
        }
    }
    let acc i64 = 0
    let i i64 = 0
    let last i64 = n.to_type(i64)
    for i < last {
        acc = mix(acc, i)
        i += 1
    }
    // 自检：取模后必须落在 [0, MOD)，否则公式或整数语义已坏。
    if (acc < 0 || acc >= MOD) {
        printf("自检失败：acc 越界\n")
        return 3
    }
    // 自检：缺省规模下 checksum 必须等于参照实现（tools/perf-product.py）冻结的值。
    if (n == 50000000 && acc != 51634071) {
        printf("自检失败：checksum 与期望值不一致\n")
        return 5
    }
    printf("checksum=%lld\n", acc)
    return 0
}
