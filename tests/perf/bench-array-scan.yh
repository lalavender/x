// 数组扫描基准：1024 槽整型数组，按轮次重复「读、累加取模、求最大」。
// 规模 = 扫描轮数 argv[1]（缺省 400），输出一行 checksum=<累加值>。
// int 是 32 位：随机种子与累加器用 i64，元素本身保持 int 以贴近常见数组布局。

const LANES int = 1024
const MOD i64 = 1000000007

// parse_count：十进制文本转 int；非法字符视为整体非法，回退 fallback。
fn parse_count(text *char, fallback int) int {
    let value int = 0
    let i int = 0
    if (text == 0 || text[0] == 0) {
        return fallback
    }
    for text[i] != 0 {
        // char → u8 → int 显式逐级转换；48/57 是 '0'/'9' 的码位。
        let c int = text[i].to_type(u8).to_type(int)
        if (c < 48 || c > 57) {
            return fallback
        }
        value = value * 10 + (c - 48)
        i += 1
    }
    return value
}

// lcg_next：64 位线性同余发生器，中间量 < 2^63，恒为正。
fn lcg_next(seed i64) i64 {
    return (seed * 1103515245 + 12345) % 2147483648
}

fn main(argc int, argv **char) int {
    let rounds int = 20000
    if (argc > 1) {
        let parsed int = parse_count(argv[1], 0)
        if (parsed > 0) {
            rounds = parsed
        }
    }
    let a [LANES]int
    let seed i64 = 12345
    let j int = 0
    for j < LANES {
        seed = lcg_next(seed)
        a[j] = (seed % 1000).to_type(int)
        j += 1
    }
    let sum i64 = 0
    let max int = 0
    let r int = 0
    for r < rounds {
        j = 0
        for j < LANES {
            let v int = a[j]
            if (v < 0 || v >= 1000) {
                printf("自检失败：元素越界\n")
                return 3
            }
            sum = (sum + v.to_type(i64)) % MOD
            if (v > max) {
                max = v
            }
            j += 1
        }
        r += 1
    }
    // 自检：独立再扫一遍求最大，两趟必须给出同一个值。
    let again int = 0
    j = 0
    for j < LANES {
        if (a[j] > again) {
            again = a[j]
        }
        j += 1
    }
    if (again != max) {
        printf("自检失败：两趟最大值不一致\n")
        return 4
    }
    // 自检：缺省规模下 checksum 必须等于参照实现（tools/perf-product.py）冻结的值。
    if (rounds == 20000 && sum != 140959930) {
        printf("自检失败：checksum 与期望值不一致\n")
        return 5
    }
    printf("checksum=%lld\n", sum)
    return 0
}
