// 函数调用基准：递归 fib（argv[1] 缺省 34），衡量调用/返回与分支的开销。
// 输出 checksum=<fib(n) 取模>；int 是 32 位，fib(45) 仍在范围内，上限 45。

const MOD int = 1000000007

// fib：朴素双递归，调用次数指数增长，是纯调用开销负载。
fn fib(n int) int {
    if (n < 2) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// parse_count：十进制文本转 int；非法字符视为整体非法，回退 fallback。
fn parse_count(text *char, fallback int) int {
    let value int = 0
    let i int = 0
    if (text == 0 || text[0] == 0) {
        return fallback
    }
    for text[i] != 0 {
        // char → u8 → int 显式逐级转换；48/57 是 '0'/'9' 的码位。
        let c int = text[i].to_type(u8).to_type(int)
        if (c < 48 || c > 57) {
            return fallback
        }
        value = value * 10 + (c - 48)
        i += 1
    }
    return value
}

fn main(argc int, argv **char) int {
    let n int = 39
    if (argc > 1) {
        let parsed int = parse_count(argv[1], 0)
        if (parsed > 0) {
            n = parsed
        }
    }
    if (n > 45) {
        printf("规模过大（n 上限 45）\n")
        return 2
    }
    // 自检：已知值 fib(10) = 55，先确认递归基线正确。
    if (fib(10) != 55) {
        printf("自检失败：fib(10) 不等于 55\n")
        return 3
    }
    let checksum int = fib(n) % MOD
    // 自检：缺省规模下 checksum 必须等于参照实现（tools/perf-product.py）冻结的值。
    if (n == 39 && checksum != 63245986) {
        printf("自检失败：checksum 与期望值不一致\n")
        return 5
    }
    printf("checksum=%d\n", checksum)
    return 0
}
