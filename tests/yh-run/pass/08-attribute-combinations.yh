// 验证 extern+inline、extern+inline+noreturn 组合可以定义并通过检查。
@[extern, inline]
fn c_inline(value int) int {
    return value + 1
}

@[noreturn, extern, inline]
fn c_spin() void {
    for {}
}

@[noreturn]
fn spin() void {
    for {}
}

@[inline]
fn plus_one(value int) int {
    return value + 1
}

// main 引用全部声明：未使用的私有函数现在是编译错误（UF1），pass 用例不运行。
fn main() int {
    c_spin()
    spin()
    return c_inline(0) + plus_one(0) - 2
}
