// Windows/x64：W1-3b 起由 Windows 运行时提供（read→ReadFile、_Exit→ExitProcess）。
@[extern, noreturn]
fn _Exit(status int) void

@[noreturn]
fn stop(flag int) void {
    if (flag != 0) {
        _Exit(1)
    } else {
        for {}
    }
}

// main 引用 stop：未使用的私有函数现在是编译错误（UF1），pass 用例不运行。
fn main() int {
    stop(0)
    return 0
}
