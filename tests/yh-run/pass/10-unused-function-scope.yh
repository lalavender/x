// UF1：未使用函数检查只针对「本文件里既没 pub 也没 extern 的函数定义」。
// 下面三种情况都不算未使用：
//   * pub 函数是导出面（可能被别的模块用）；
//   * 通过函数值（函数指针）引用的私有函数；
//   * 只在 test 正文里出现的私有辅助函数 —— 生产构建不解析 test 正文，
//     但名字扫描按整个文件的 token 计入，避免把测试辅助判死。
// 本用例只要求编译成功：pass/ 不运行。
pub fn exported_later() int {
    return 1
}

fn via_fn_value() int {
    return 3
}

fn test_only_helper() int {
    return 2
}

fn main() int {
    let pick fn() int = via_fn_value
    if (pick() != 3) {
        return 1
    }
    return 0
}

test "测试专用辅助函数" {
    $assert(test_only_helper() == 2)
}
