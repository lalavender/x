// YT0：生产构建只检查 test 声明与测试体的语法，不检查测试体语义、不发射测试代码。
// 测试体里的未定义名字与动态断言在 yh test 实现前不会影响普通编译。
fn add(a int, b int) int {
    return a + b
}

test "生产构建跳过测试体语义" {
    let x int = undefined_in_test_body
    $assert(add(1, 1) == 3)
}

test add {
    $assert(add(41, 1) == 42)
}

fn main() int {
    return add(1, 2) - 3
}
