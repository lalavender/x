// fail-contains: 编译期结构体字段只支持整数
// 编译期结构体数组字段暂不接纳指针叶元素。

pub struct PointerGrid {
    rows [2][2]*int;
}

// invalid_pointer_grid：触发编译期结构体字段的数组叶类型限制。
@[comptime]
fn invalid_pointer_grid() int {
    let grid PointerGrid = PointerGrid{ rows: [[0, 0], [0, 0]] };
    return 0;
}

const RESULT int = $invalid_pointer_grid();

fn main() int {
    return RESULT;
}
