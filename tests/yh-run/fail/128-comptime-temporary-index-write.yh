// fail: 编译期下标写入不能修改函数返回的临时数组。
// fail-contains: 编译期数组/切片下标写入必须来自可写局部变量

@[comptime]
fn make_values() [2]int {
    let values [2]int = [3, 4]
    return values
}

@[comptime]
fn invalid_write() int {
    $make_values()[0] = 8
    return 0
}

const VALUE int = $invalid_write()

fn main() int {
    return VALUE
}
