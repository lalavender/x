// fail: 编译期取址拒绝临时数组元素
// fail-contains: 局部变量

@[comptime]
fn make_values() [2]int {
    let values [2]int = [1, 2]
    return values
}

@[comptime]
fn address_temporary() int {
    let cell *int = &$make_values()[0]
    return *cell
}

const BAD int = $address_temporary()

fn main() int {
    return 0
}
