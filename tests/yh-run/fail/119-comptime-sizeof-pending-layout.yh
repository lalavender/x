// fail: sizeof 与字段长度互相依赖必须报告布局环
// fail-contains: ITEM_COUNT -> PendingLayoutPacket -> 数组长度(ITEM_COUNT) -> ITEM_COUNT
// CT 函数保留 pending sizeof 查询；求值阶段应发现值与结构体布局之间的环。

@[comptime]
fn pending_packet_size_inner() int {
    return sizeof(PendingLayoutPacket);
}

@[comptime]
fn pending_packet_size() int {
    return $pending_packet_size_inner();
}

const ITEM_COUNT int = $pending_packet_size();

pub struct PendingLayoutPacket {
    items [ITEM_COUNT]int;
}

fn main() int {
    return 0;
}
