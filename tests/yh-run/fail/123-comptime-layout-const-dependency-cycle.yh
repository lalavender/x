// fail: typed 布局常量依赖环应报告完整常量链
// fail-contains: ALPHA_LAYOUT_COUNT -> BETA_LAYOUT_COUNT -> ALPHA_LAYOUT_COUNT
// 循环依赖必须指出组成环的常量，不能退化为泛化的布局未就绪错误。

@[comptime]
fn increment_layout_value(value int) int {
    return value + 1
}

const ALPHA_LAYOUT_COUNT int = $increment_layout_value(BETA_LAYOUT_COUNT)
const BETA_LAYOUT_COUNT int = $increment_layout_value(ALPHA_LAYOUT_COUNT)

pub struct CyclicLayoutPacket {
    values [ALPHA_LAYOUT_COUNT]int
}

fn main() int {
    return 0
}
