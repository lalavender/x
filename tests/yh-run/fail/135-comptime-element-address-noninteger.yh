// fail: 编译期取址拒绝非标量聚合元素
// fail-contains: 标量局部变量或标量聚合元素

pub struct Point {
    x int;
    y int;
}

@[comptime]
fn address_struct_element() int {
    let points [2]Point = [Point{ x: 1, y: 2 }, Point{ x: 3, y: 4 }];
    let element *Point = &points[0];
    return element.x;
}

const BAD int = $address_struct_element();

fn main() int {
    return 0;
}
