// fail: 编译期经指针写入全局聚合常量（模型只读）
// fail-contains: 编译期不能写入全局聚合常量
// 说明：模型元素槽的取址/解引用**读取**可用（run/164），写入统一按只读拒绝，
// 与字符串字面量只读池同一策略（赋值语句按地址命中模型区间拦截）。
const TABLE [3]int = [7, 8, 9];

// bad_write：经取址指针写回全局常量元素。
@[comptime]
fn bad_write() int {
    let p *int = &TABLE[0];
    *p = 5;
    return *p;
}

const R int = $bad_write();

fn main() int {
    return R;
}