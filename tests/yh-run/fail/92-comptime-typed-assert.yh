// fail: typed IR 应执行依赖局部值的失败断言
// fail-contains: typed IR 断言局部值不匹配
@[comptime]
fn sum_to(limit int) int {
    let index int = 0;
    let total int = 0;
    for index < limit {
        total += index;
        index += 1;
    }
    $assert(total == 16, "typed IR 断言局部值不匹配");
    return total;
}

const BAD int = $sum_to(6);

fn main() int {
    return BAD;
}
