// fail: 编译期函数表达式语句必须执行被调用函数
// fail-contains: 独立调用应触发编译期断言
@[comptime]
// require_positive：断言编译期实参满足正数约束。
fn require_positive(value int) int {
    $assert(value > 0, "独立调用应触发编译期断言");
    return value;
}

@[comptime]
// discard_result：丢弃调用结果，但仍执行被调函数的编译期行为。
fn discard_result(value int) int {
    $require_positive(value);
    return 0;
}

const BAD int = $discard_result(0);

// main：提供负例所需的运行期入口。
fn main() int {
    return BAD;
}
