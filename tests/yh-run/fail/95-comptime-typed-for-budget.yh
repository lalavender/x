// fail: 编译期函数内 `$for` 执行超过 1024 次
// fail-contains: 单个编译期 typed $for 区间超过 1024 次
// sum：请求执行超过单个编译期区间允许次数的累加。
@[comptime]
fn sum(end int) int {
    let total int = 0
    $for index in (0..end) {
        total += index
    }
    return total
}

const TOO_MANY int = $sum(1025)

// main：提供负例所需的运行期入口。
fn main() int {
    return TOO_MANY
}
