// fail: 编译期函数调用深度超过 64 层
// fail-contains: 编译期函数调用深度超过 64 层
// typed 布局请求按实际调用路径执行递归，并由统一调用深度预算拒绝不终止调用。

@[comptime]
fn length_left() int {
    return $length_right()
}

@[comptime]
fn length_right() int {
    return $length_left()
}

const ITEM_COUNT int = $length_left()
let ITEMS [ITEM_COUNT]u8

fn main() int {
    return 0
}
