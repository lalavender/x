// exit: 12
// 全局聚合初始化：命名式/位置式/嵌套字面量/字符串字段。
// 曾在自举编译器被显式拒绝（"全局结构体将在 B7 支持"）。
struct P { x int; y int; }
struct Q { p P; tag int; s *char; }

let g P = P { x: 3, y: 4 };
let gp P = P { 30, 40 };
let gq Q = Q { p: P { x: 5, y: 6 }, tag: 1, s: "ok" };

fn main() int {
    if (g.x != 3 || g.y != 4) { return 1; }
    if (gp.x != 30 || gp.y != 40) { return 2; }
    if (gq.p.x != 5 || gq.p.y != 6) { return 3; }
    if (gq.tag != 1) { return 4; }
    if (gq.s[0] != 'o') { return 5; }
    return 12;
}
