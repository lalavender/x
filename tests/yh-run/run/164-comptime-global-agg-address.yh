// exit: 0
// run/164：编译期正文可对全局聚合常量取元素/字段**地址**并只读解引用
// （原 fail/152 的「一律拒绝」随模型取址语义交付收窄：读取放行、写入拒绝，
// 写入见 fail/153）。覆盖取址+解引用、指针下标、指针算术与指针形参转发。

pub struct Point {
    x int;
    y int;
}

const TABLE [4]int = [10, 20, 30, 40];
const P Point = Point{ x: 3, y: 4 };

// read_head：取址 + 解引用读首元素。
@[comptime]
fn read_head() int {
    let p *int = &TABLE[0];
    return *p;
}

// read_indexed：指针下标与指针算术的只读访问。
@[comptime]
fn read_indexed() int {
    let p *int = &TABLE[1];
    return p[1] + *(p + 1);
}

// read_field：结构体成员取址后解引用读字段。
@[comptime]
fn read_field() int {
    let q *int = &P.x;
    return *q;
}

// inc_local：只读使用指针形参（解引用读取）。
@[comptime]
fn inc_local(v *int) int {
    return *v + 1;
}

// forward：把模型元素指针作为指针形参转发（实参在正文内求值取址）。
@[comptime]
fn forward() int {
    return $inc_local(&TABLE[3]);
}

// A = 10；B = 30 + 30 = 60；C = 3；D = 40 + 1 = 41。
const A int = $read_head();
const B int = $read_indexed();
const C int = $read_field();
const D int = $forward();

fn main() int {
    return A - 10 + B - 60 + C - 3 + D - 41
        + TABLE[0] - 10 + P.y - 4;
}