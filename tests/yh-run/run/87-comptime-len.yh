// expect: comptime-len=322
// exit: 0
// 编译期执行 len 时，应读取数组长度和当前切片视图长度。

pub struct LenPoint {
    x int;
}

// measure_lengths：结合整型数组、空切片和结构体数组验证 len 的 typed 求值。
@[comptime]
fn measure_lengths() int {
    let numbers [3]int = [1, 2, 3];
    let view []int = numbers[1..3];
    let empty []int = [];
    let points [2]LenPoint = [LenPoint{ x: 4 }, LenPoint{ x: 5 }];
    return len(numbers) * 100 + len(view) * 10 + len(empty) + len(points);
}

const RESULT int = $measure_lengths();

fn main() int {
    printf("comptime-len=%d\n", RESULT);
    return 0;
}
