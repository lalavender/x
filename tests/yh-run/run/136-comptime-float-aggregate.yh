// expect: float-aggregate=2610
// exit: 0
// 编译期浮点聚合元素：定长数组、切片视图、结构体字段、for-in 迭代与顶层物化。

pub struct Reading {
    value f64;
    tag int;
}

// make_values：供顶层浮点数组物化使用。
@[comptime]
fn make_values() [2]f64 {
    let values [2]f64 = [0.5, 1.25];
    return values;
}

// make_small：供顶层单精度数组物化使用。
@[comptime]
fn make_small() [2]f32 {
    let values [2]f32 = [0.25.to_type(f32), 1.5.to_type(f32)];
    return values;
}

// make_reading：供顶层含浮点字段的结构体物化使用。
@[comptime]
fn make_reading() Reading {
    let reading Reading = Reading{ value: 2.5, tag: 7 };
    return reading;
}

// sum_floats：数组元素写入、切片视图别名写回与浮点 for-in 累加。
@[comptime]
fn sum_floats() f64 {
    let values [3]f64 = [1.5, 2.5, 3.5];
    values[1] += 0.5;
    let view []f64 = values[1..3];
    view[0] += 1.0;
    let total f64 = 0.0;
    for value in values {
        total += value;
    }
    return total;
}

// struct_float：结构体浮点字段的复合赋值。
@[comptime]
fn struct_float() f64 {
    let reading Reading = Reading{ value: 1.25, tag: 3 };
    reading.value *= 4.0;
    return reading.value;
}

// drive：把两条浮点聚合结果折算成整数常量。
@[comptime]
fn drive() int {
    let total f64 = $sum_floats() + $struct_float();
    return (total * 100.0).to_type(int);
}

const RESULT int = $drive();
let TOP_VALUES [2]f64 = $make_values();
let TOP_SMALL [2]f32 = $make_small();
let TOP_READING Reading = $make_reading();

fn main() int {
    let parts int = RESULT + (TOP_VALUES[0] + TOP_VALUES[1]).to_type(int) * 10 +
        TOP_READING.value.to_type(int) * 100 +
        (TOP_SMALL[0] + TOP_SMALL[1]).to_type(int) * 1000;
    printf("float-aggregate=%d\n", parts);
    return 0;
}
