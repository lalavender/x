// exit: 42
// 整数转换矩阵回归（不带 printf）：各宽度/符号性组合的 to_type 必须按
// 目标类型重新扩展 x0。覆盖 i8/u8/i32/u32/i64 之间的加宽、窄化、
// 符号翻转，以及窄化结果参与算术的场景。
fn main() i32 {
    // i8 -> 各宽度
    let a i8 = -1
    if (a.to_type(int) != -1) { return 1 }
    if (a.to_type(i64) != -1) { return 2 }
    if (a.to_type(u8).to_type(i64) != 255) { return 3 }
    // u8 -> 各宽度
    let b u8 = 255
    if (b.to_type(int) != 255) { return 4 }
    if (b.to_type(i64) != 255) { return 5 }
    // i32 -> u32 -> i64
    let c int = -1
    if (c.to_type(u32).to_type(i64) != 4294967295) { return 6 }
    // u32 -> i32 (reinterpret)
    let d u32 = 4294967295
    if (d.to_type(int) != -1) { return 7 }
    // i64 -> u8
    let e i64 = -1
    if (e.to_type(u8).to_type(i64) != 255) { return 8 }
    // 短路与算术中的窄化
    let f i64 = 0x100000001
    if (f.to_type(int) + 1 != 2) { return 9 }
    return 42
}
