// expect: opens=200 dir=ok
// run/208：fd 表必须复用已关闭的槽位（W2-2c）。
// Windows 运行时原来的 fd 表只增不减，超过 64 次 open 后必然失败；本用例连续
// 开关同一个文件 200 次，并额外 open(".") 验证 POSIX 的「目录也可 open」语义
// （Windows 侧靠 FILE_FLAG_BACKUP_SEMANTICS）。Linux/Darwin 同样可跑。
fn main() int {
    let i int = 0
    let opened int = 0
    for i < 200 {
        let fd int = open("tmp-fd-reuse.bin", 0x241, 0x1a4)
        if (fd < 0) { return 1 }
        let one [1]u8
        one[0] = 65
        if (write(fd, &one[0], 1) != 1) { return 2 }
        if (close(fd) != 0) { return 3 }
        opened += 1
        i += 1
    }
    unlink("tmp-fd-reuse.bin")
    let dir_fd int = open(".", 0)
    if (dir_fd < 0) { return 4 }
    if (close(dir_fd) != 0) { return 5 }
    printf("opens=%d dir=ok\n", opened)
    return 0
}
