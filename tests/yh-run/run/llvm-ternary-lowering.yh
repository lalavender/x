// exit: 0
// 三元表达式在 SSA 中按条件分支求值，并在合流点传递选中值。
// 两条分支都修改局部变量，用于检查变量状态与表达式结果一起合流。
fn set(value *int, next int) int {
    *value = next;
    return next;
}

fn choose(flag bool, value *int) int {
    return flag ? set(value, 17) : set(value, 29);
}

fn main() int {
    let value int = 0;
    let selected int = choose(true, &value);
    if (selected != 17 || value != 17) { return 1; }
    selected = choose(false, &value);
    if (selected != 29 || value != 29) { return 2; }
    return 0;
}
