// exit: 0
// 函数体编译期分支选择与半开整数区间静态展开。
@[comptime] fn odd(value int) int {
    return value % 2
}

fn main() int {
    let total int = 0
    $if ($odd(3) != 0) {
        total += 1
    } $else $if (true) {
        return 1
    } $else {
        undefined_call()
    }
    $for i in (0..3) {
        let copy int = i
        total += copy
    }
    $for empty in (3..3) {
        undefined_but_unselected()
    }
    return total - 4
}
