// expect: struct=ok
// LL5 结构体切片语义锁：字段读写/复合赋值、嵌套字段、结构体字面量、按值复制、
// 结构体指针、字段取址、结构体数组、联合体共享存储与未初始化 let。
pub union Val {
    i int
    b u8
}

struct Pair {
    x int
    y int
}

struct Box {
    inner Pair
    tag int
}

fn main() int {
    let p Pair = Pair{ x: 1, y: 2 }
    if (p.x != 1 || p.y != 2) { return 1 }
    p.x = 10
    p.y += 5
    if (p.x != 10 || p.y != 7) { return 2 }

    let q Pair = p
    q.x = 99
    if (p.x != 10 || q.x != 99) { return 3 }

    let pp *Pair = &p
    (*pp).y = 42
    if (p.y != 42) { return 4 }

    let b Box = Box{ inner: Pair{ x: 5, y: 6 }, tag: 7 }
    if (b.inner.x != 5 || b.inner.y != 6 || b.tag != 7) { return 5 }
    b.inner.x = 8
    if (b.inner.x != 8 || b.inner.y != 6) { return 6 }

    let ep *int = &p.x
    *ep = 21
    if (p.x != 21) { return 7 }

    let arr [2]Pair = [Pair{ x: 1, y: 2 }, Pair{ x: 3, y: 4 }]
    if (arr[1].x != 3 || arr[0].y != 2) { return 8 }
    arr[0].x = 11
    if (arr[0].x != 11 || arr[1].x != 3) { return 9 }

    let v Val
    v.i = 258
    if (v.b != 2) { return 10 }

    let uninit Pair
    uninit.x = 4
    if (uninit.x != 4) { return 11 }

    printf("struct=ok\n")
    return 0
}
