// expect: point=21 positional=12 copy=19
// exit: 0
// 编译期本地结构体应能初始化、读取并写入整型字段。

pub struct Point {
    x int
    y int
}

@[comptime]
fn mark(value int) int {
    return value
}

@[comptime]
fn update_point() int {
    let point Point = Point{ y: 6, x: 4 }
    point.x += 3
    point.y = point.x * 2
    return point.x + point.y
}

@[comptime]
fn positional_fields() int {
    let point Point = Point{ $mark(1), $mark(2) }
    return point.x * 10 + point.y
}

@[comptime]
fn struct_copy() int {
    let original Point = Point{ x: 1, y: 2 }
    let duplicate Point = original
    duplicate.x = 9
    return original.x * 10 + duplicate.x
}

const POINT int = $update_point()
const POSITIONAL int = $positional_fields()
const COPY int = $struct_copy()

fn main() int {
    printf("point=%d positional=%d copy=%d\n", POINT, POSITIONAL, COPY)
    return 0
}
