// expect: llvm-unary=ok
// exit: 0
// 常量与动态一元运算保持相同结果类型；bool 的一元运算按既有规则升为 int。
const MAXIMUM i64 = 9223372036854775807
const MINIMUM i64 = -MAXIMUM - 1
const SMALL i8 = 3
const ZERO_UNSIGNED u64 = 0
const ALL_BITS u64 = ~ZERO_UNSIGNED
const TWO bool = 2.to_type(bool)

// negate_constant：函数内的常量折叠仍保留 i64，与动态形参负号一致。
fn negate_constant() i64 { return -MAXIMUM - 1 }
// negate：动态窄整数一元结果在扩大之前截断到源宽度。
fn negate(value i8) i64 { return (-value).to_type(i64) }
// boolean_negate：bool 原字节升为 int 后取负，不先按 u8 溢出拒绝。
fn boolean_negate(value bool) int { return -value }
// invert：SSA 比较先产生 bool，扩大回源级 i64 一元结果。
fn invert(value i64) i64 { return !value }
// ct_boolean_negate：typed CT 的求值类型必须使用已检查的一元结果 int。
@[comptime] fn ct_boolean_negate(value bool) int { return -value }
const CT_BOOLEAN int = $ct_boolean_negate(TWO)

// main：值、sizeof、常量/动态与 typed CT 共同验收。
fn main() int {
    if (MINIMUM != 0x8000000000000000.to_type(i64) || negate_constant() != MINIMUM) { return 1 }
    if (sizeof(-MAXIMUM) != 8 || sizeof(+MAXIMUM) != 8 || sizeof(!MAXIMUM) != 8) { return 2 }
    if (sizeof(-SMALL) != 1 || sizeof(~SMALL) != 1 || sizeof(+SMALL) != 1) { return 3 }
    if (sizeof(~ZERO_UNSIGNED) != 8 || ALL_BITS != 0xffffffffffffffff) { return 4 }
    if (sizeof(-TWO) != 4 || (-TWO) != -2 || CT_BOOLEAN != -2 || boolean_negate(TWO) != -2) { return 5 }
    if (negate(-128) != -128 || negate(3) != -3) { return 6 }
    if (invert(0) != 1 || invert(MAXIMUM) != 0) { return 7 }
    printf("llvm-unary=ok\n")
    return 0
}
