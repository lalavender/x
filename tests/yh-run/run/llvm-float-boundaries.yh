// expect: llvm-floats=ok
// exit: 0
// IEEE 位型、正负零、无穷、f32 最近偶数舍入和逐步单精度运算边界。
const NEGATIVE_ZERO f64 = -0.0
const HALF_STEP f64 = 1.0 / 16777216.0
const TIE f64 = 1.0 + HALF_STEP
const ODD_TIE f64 = 1.0 + 3.0 * HALF_STEP

// bits64 / bits32：已初始化的浮点对象按同宽整数读取，只检查定义好的 IEEE 位型。
fn bits64(value f64) u64 { return (&value).to_type(*u64)[0] }
fn bits32(value f32) u32 { return (&value).to_type(*u32)[0] }
// from_bits：精确构造最小单精度非正规数的 f64 输入，避免十进制解析近似。
fn from_bits(value u64) f64 { return (&value).to_type(*f64)[0] }
// narrow / negate：参数阻止常量折叠，验证动态宽度转换及负零。
fn narrow(value f64) f32 { return value.to_type(f32) }
fn negate(value f64) f64 { return -value }
// twice_half：每次 f32 运算各自舍入，不能扩宽并把两次加法合并。
fn twice_half(value f32, half f32) f32 { return (value + half) + half }
// ct_narrow / ct_twice_half：typed CT 与动态使用同样的 f32 舍入点。
@[comptime] fn ct_narrow(value f64) f32 { return value.to_type(f32) }
@[comptime] fn ct_twice_half(value f32, half f32) f32 { return (value + half) + half }
const FOLDED_TIE f32 = TIE.to_type(f32)
const CT_TIE f32 = $ct_narrow(TIE)
const CT_TWICE f32 = $ct_twice_half(1.0.to_type(f32), HALF_STEP.to_type(f32))

// main：常量、typed CT、动态和原始存储的位型相同，不约束 NaN payload。
fn main() int {
    if (bits64(0.0) != 0 || bits64(NEGATIVE_ZERO) != 0x8000000000000000
        || bits64(negate(0.0)) != 0x8000000000000000 || NEGATIVE_ZERO != 0.0) { return 1 }
    if (bits64(1.0 / 0.0) != 0x7ff0000000000000
        || bits64(1.0 / NEGATIVE_ZERO) != 0xfff0000000000000) { return 2 }
    if (bits32(narrow(TIE)) != 0x3f800000 || bits32(FOLDED_TIE) != 0x3f800000
        || bits32(CT_TIE) != 0x3f800000 || bits32(narrow(ODD_TIE)) != 0x3f800002) { return 3 }
    if (bits32(twice_half(1.0.to_type(f32), HALF_STEP.to_type(f32))) != 0x3f800000
        || bits32(CT_TWICE) != 0x3f800000) { return 4 }
    if (bits32(narrow(from_bits(0x36a0000000000000))) != 1
        || bits32(narrow(NEGATIVE_ZERO)) != 0x80000000) { return 5 }
    printf("llvm-floats=ok\n")
    return 0
}
