// expect: 9097811302482466869
// expect-more: 4591870180066957722
// expect-more: 9218868437227405311
// expect-more: 1
// expect-more: 9223372036854775808
// expect-more: 9218868437227405312
// expect-more: 4652011706887700480
// expect-more: 4503599627370496
// expect-more: 5042042089369253694
// expect-more: 4517329193108106637
// expect-more: 0
// expect-more: 4845873199050653696
// expect-more: 4756540486875873280
// 浮点字面量必须按正确舍入转换成 binary64（回归：1.5e300 曾多 1 ULP）。
// 期望值是 Python float()/struct 的位模式；最后一行验证下划线分隔符。
union U {
    f f64
    u u64
}

fn bits(v f64) u64 {
    let x U
    x.f = v
    return x.u
}

fn main() int {
    printf("%llu\n", bits(1.5e300))
    printf("%llu\n", bits(0.1))
    printf("%llu\n", bits(1.7976931348623157e308))
    printf("%llu\n", bits(5e-324))
    printf("%llu\n", bits(-0.0))
    printf("%llu\n", bits(1e309))
    printf("%llu\n", bits(1_000.5))
    printf("%llu\n", bits(2.2250738585072014e-308))
    printf("%llu\n", bits(123456789012345678901234567890.0))
    printf("%llu\n", bits(0.000001))
    printf("%llu\n", bits(1e-400))
    printf("%llu\n", bits(9007199254740993.0))
    printf("%llu\n", bits(1e1_0))
    return 0
}
