// exit: 0
// expect: pair-a,
// postfix 层统一 eval 入口（S4-4 第三片）：下标（数组/指针/切片）、切片、
// `.to_type`、成员访问（值基底与指针基底）、字段元信息投影（`f.name`）。
struct Pair {
    a int
    b u8
}

fn main() int {
    let arr [4]int = [10, 20, 30, 40]
    // 下标（数组）
    if (arr[2] != 30) { return 1 }
    // 切片：数组 → 切片，元素读写与长度
    let s []int = arr[1..3]
    if (len(s) != 2) { return 2 }
    if (s[0] != 20 || s[1] != 30) { return 3 }
    // 指针基底的下标
    let q *int = &arr[0]
    if (q[2] != 30) { return 4 }
    // 类型转换（窄→宽、常量折叠）
    let b u8 = 200
    if (b.to_type(int) != 200) { return 5 }
    // 成员：值基底 + 指针基底（写回验证地址语义）
    let p Pair = Pair{a: 5, b: 7}
    if (p.a != 5) { return 6 }
    if (p.b.to_type(int) != 7) { return 7 }
    let pp *Pair = &p
    if (pp.a != 5) { return 8 }
    pp.a = 11
    if (p.a != 11) { return 9 }
    // 字段元信息投影（`$for f in Pair.fields` 的 `f.name` 静态 C 字符串）
    printf("%s,", first_field_name())
    return 0
}

// first_field_name：取 Pair 第一个字段的名字常量（编译期投影，运行期 printf）。
fn first_field_name() *char {
    let names [2]*char = ["pair-a", "pair-b"]
    $for f in Pair.fields {
        if (f.name[0] == 'a') {
            return names[0]
        }
    }
    return names[1]
}
