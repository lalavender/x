// expect: slice=ok
// LL5 切片语义锁：数组切片、切片字面量、下标读写共享、切片副本与运行期 len。
fn main() int {
    let a [5]int = [1, 2, 3, 4, 5]
    let s []int = a[1..4]
    if (len(s) != 3) { return 1 }
    if (s[0] != 2 || s[2] != 4) { return 2 }

    s[1] = 30
    if (a[2] != 30) { return 3 }

    let t []int = s
    if (len(t) != 3 || t[1] != 30) { return 4 }
    t[0] = 99
    if (a[1] != 99) { return 5 }

    let u []int = [7, 8, 9]
    if (len(u) != 3 || u[2] != 9) { return 6 }

    let v []int = u[1..3]
    if (len(v) != 2 || v[0] != 8 || v[1] != 9) { return 7 }

    let dyn int = 1
    let w []int = a[dyn..4]
    if (len(w) != 3 || w[0] != 99) { return 8 }

    printf("slice=ok\n")
    return 0
}
