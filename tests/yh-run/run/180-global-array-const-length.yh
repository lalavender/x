// expect: 8
// 全局类型布局可使用**声明在前**的普通整数 const 作为数组长度：
// 这类常量原本只在全局子遍才求值，而全局/字段/形参/返回位置的定长数组
// 在布局子遍就要定长，于是误报「编译期常量尚未就绪」。
// 前向引用（常量声明在使用之后）仍按声明顺序拒绝，见
// fail/118-comptime-typed-layout-forward-const.yh。
const SIZE int = 8;
let data [SIZE]u8;

fn main() int {
    printf("%d\n", len(data));
    return 0;
}
