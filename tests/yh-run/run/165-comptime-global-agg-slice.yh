// exit: 0
// run/165：切片常量在编译期建模——下标、len、for-in 与切片视图读取
// （切片元素个数只有解析字面量后才知道，模型在 parse_global_array_init 内
// 按 count 创建；空切片与浮点元素一并覆盖）。
const SLICE []int = [10, 20, 30, 40]
const EMPTY []int = []
const FLOATS []f64 = [1.5, 2.25]

// ct_slice_ops：遍历求和 + 下标 + len（含空切片）。
@[comptime]
fn ct_slice_ops() int {
    let s int = 0
    for v in SLICE { s += v }
    return s + SLICE[0] + SLICE[3] + len(SLICE) + len(EMPTY)
}

// ct_slice_view：对模型做切片视图表达式后只读访问视图。
@[comptime]
fn ct_slice_view() int {
    let view []int = SLICE[1..3]
    return view[0] + view[1] + len(view)
}

// ct_slice_float：浮点元素切片的编译期读取与算术。
@[comptime]
fn ct_slice_float() f64 {
    return FLOATS[0] + FLOATS[1]
}

// A = 100 + 10 + 40 + 4 + 0 = 154；B = 20 + 30 + 2 = 52；C = 3.75。
const A int = $ct_slice_ops()
const B int = $ct_slice_view()
const C f64 = $ct_slice_float()

fn main() int {
    if (A != 154) { return 1 }
    if (B != 52) { return 2 }
    if (C != 3.75) { return 3 }
    // 运行期同一批常量仍按键值语义读取：10 + 40 - 50 + 0 = 0。
    return SLICE[0] + SLICE[3] - 50 + len(EMPTY)
}