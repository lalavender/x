// expect: recursive-layout-count=4
// exit: 0
// 用返回基例的递归 typed CT 调用计算后续结构体字段与全局数组布局。

@[comptime]
fn recursive_count(value int) int {
    if (value <= 0) {
        return 1;
    }
    return $recursive_count(value - 1) + 1;
}

const ITEM_COUNT int = $recursive_count(3);

pub struct RecursiveLayoutPacket {
    items [ITEM_COUNT]int;
}

let recursive_layout_values [ITEM_COUNT]int;

fn main() int {
    if (len(recursive_layout_values) == 4
        && sizeof(RecursiveLayoutPacket) == 16) {
        printf("recursive-layout-count=%d\n", len(recursive_layout_values));
        return 0;
    }
    return 1;
}
