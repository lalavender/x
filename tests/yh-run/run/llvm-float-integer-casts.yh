// expect: llvm-fp-casts=ok
// exit: 0
// 精确整数转浮点构造高位边界，不把长十进制字面量的解析近似混入转换验收。
const HIGH f64 = (1.to_type(u64) << 63).to_type(f64)
const HIGH_BITS u64 = 1.to_type(u64) << 63
const BELOW_LIMIT f64 = HIGH * 2.0 - 2048.0
const INFINITY f64 = 1.0 / 0.0
const NAN f64 = 0.0 / 0.0
const MAX_UNSIGNED u64 = 0xffffffffffffffff
const MAX_SIGNED i64 = 9223372036854775807
const MIN_SIGNED i64 = HIGH_BITS.to_type(i64)

// ct_unsigned：typed CT 的目标无符号转换必须走完整 u64 值域。
@[comptime] fn ct_unsigned(value f64) u64 { return value.to_type(u64) }
// ct_narrow：typed CT 的窄目标按目标宽度截断并符号扩展。
@[comptime] fn ct_narrow(value f64) i64 { return value.to_type(i8).to_type(i64) }

const CT_HIGH u64 = $ct_unsigned(HIGH)
const FOLD_HIGH u64 = HIGH.to_type(u64)
const CT_NEGATIVE u64 = $ct_unsigned(-3.0)
const FOLD_NEGATIVE u64 = (-3.0).to_type(u64)
const CT_SMALL i64 = $ct_narrow(130.0)
const FOLD_SMALL i8 = 130.0.to_type(i8)
const CT_INFINITY u64 = $ct_unsigned(INFINITY)
const CT_NAN u64 = $ct_unsigned(NAN)

// unsigned64：参数阻止常量折叠，独立验证动态 u64 目标。
fn unsigned64(value f64) u64 { return value.to_type(u64) }
// unsigned8 / signed8：转换结果继续参与表达式，不靠写入窄内存槽掩盖漏截断。
fn unsigned8(value f64) i64 { return value.to_type(u8).to_type(i64) }
fn signed8(value f64) i64 { return value.to_type(i8).to_type(i64) }
// signed16 / signed32 / unsigned32：各目标宽度独立规范化。
fn signed16(value f64) i64 { return value.to_type(i16).to_type(i64) }
fn signed32(value f64) i64 { return value.to_type(i32).to_type(i64) }
fn unsigned32(value f64) u64 { return value.to_type(u32).to_type(u64) }
// signed64：64 位边界先饱和，不依赖窄目标的存储截断。
fn signed64(value f64) i64 { return value.to_type(i64) }
// single8 / single32：f32 输入也必须按目标符号性和宽度处理。
fn single8(value f32) i64 { return value.to_type(i8).to_type(i64) }
fn single32(value f32) u64 { return value.to_type(u32).to_type(u64) }
// boolean_byte：浮点到 bool 保留低字节，后续条件才取非零真值。
fn boolean_byte(value f64) int { return value.to_type(bool).to_type(int) }

// main：常量折叠、typed CT 和动态转换在符号/高位/窄化边界相同。
fn main() int {
    if (CT_HIGH != HIGH_BITS || FOLD_HIGH != HIGH_BITS || unsigned64(HIGH) != HIGH_BITS) { return 1 }
    if (CT_NEGATIVE != 0 || FOLD_NEGATIVE != 0 || unsigned64(-3.0) != 0) { return 2 }
    if (unsigned64(BELOW_LIMIT) != 0xfffffffffffff800) { return 3 }
    if (CT_SMALL != -126 || FOLD_SMALL.to_type(i64) != -126 || signed8(130.0) != -126) { return 4 }
    if (unsigned8(300.0) != 44 || unsigned8(256.0) != 0 || unsigned8(-1.0) != 0) { return 5 }
    if (signed8(-129.0) != 127 || signed16(65535.0) != -1) { return 6 }
    if (signed32(4294967297.0) != 1 || unsigned32(4294967297.0) != 1) { return 7 }
    if (unsigned64(INFINITY) != MAX_UNSIGNED || unsigned64(HIGH * 2.0) != MAX_UNSIGNED
        || CT_INFINITY != MAX_UNSIGNED || CT_NAN != 0 || unsigned64(NAN) != 0) { return 8 }
    if (signed64(HIGH) != MAX_SIGNED || signed64(-INFINITY) != MIN_SIGNED
        || signed64(-HIGH) != MIN_SIGNED || signed64(NAN) != 0) { return 9 }
    if (unsigned8(INFINITY) != 255 || signed8(INFINITY) != -1
        || unsigned8(NAN) != 0 || signed8(-INFINITY) != 0) { return 10 }
    if (single8(130.0.to_type(f32)) != -126 || single32(4294967296.0.to_type(f32)) != 0
        || signed64(-3.75) != -3 || unsigned64(3.75) != 3) { return 11 }
    if (boolean_byte(2.0) != 2 || boolean_byte(258.0) != 2 || boolean_byte(-2.0) != 0) { return 12 }
    printf("llvm-fp-casts=ok\n")
    return 0
}
