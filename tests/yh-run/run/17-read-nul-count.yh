// expect: n=9 z=3
// stdin-hex: 616200636400006566
// 二进制零字节经 read 原样进入缓冲（0.0.2 B1-1）：
// 9 字节输入含 3 个 NUL，逐字节统计总数与零字节数。
// Windows/x64：W1-3b 起由 Windows 运行时提供（read→ReadFile、_Exit→ExitProcess）。
fn main() int {
    let buf [64]u8
    let total i64 = 0
    let zeros i64 = 0
    for {
        let n i64 = read(0, buf, 64)
        if (n <= 0) {
            break
        }
        total += n
        let i i64 = 0
        for i < n {
            if (buf[i] == 0) {
                zeros += 1
            }
            i += 1
        }
    }
    printf("n=%d z=%d\n", total, zeros)
    return 0
}
