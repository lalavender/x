// expect: array=6 slice=9
// exit: 0
// 编译期函数可按已检查的整数下标读取本地数组与切片元素。

@[comptime]
fn array_middle() int {
    let values [3]int = [2, 6, 10]
    return values[1]
}

@[comptime]
fn slice_last() int {
    let values []int = [4, 7, 9]
    let index int = 1 + 1
    return values[index]
}

const ARRAY int = $array_middle()
const SLICE int = $slice_last()

fn main() int {
    printf("array=%d slice=%d\n", ARRAY, SLICE)
    return 0
}
