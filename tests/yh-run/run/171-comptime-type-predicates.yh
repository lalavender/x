// exit: 0
// run/171：编译期类型分派谓词（CT6 P1a）。
// `$is_type(x, T)`（第二实参是类型引用）、`$is_int(x)`、`$is_float(x)`：
// 只看静态类型、不求值实参；结果恒为编译期布尔常量，可用于普通路径
// （let/printf 实参/$if 表达式条件）与 typed 正文（$if 语句条件、普通
// if 条件、结构体字段类型分派）。

pub struct Point {
    x int;
}

pub struct Pair {
    x int;
    y f64;
}

fn pick(v f64) int {
    let t int = $if ($is_float(v)) 1 $else 2;
    return t;
}

@[comptime]
fn ct_field_dispatch(p Pair) int {
    // 按字段静态类型分派：$is_int(p.x) 真、$is_type(p.y, f64) 真、
    // $is_type(p.x, f64) 假（不执行）。
    let r int = 0;
    if ($is_int(p.x)) { r += 1; }
    if ($is_type(p.y, f64)) { r += 2; }
    if ($is_type(p.x, f64)) { r += 100; }
    return r;
}

@[comptime]
fn ct_isint(x int) int {
    if ($is_int(x)) { return 7; }
    return 8;
}

@[comptime]
fn ct_is_float_arg(v f64) int {
    $if ($is_float(v)) {
        return 1;
    } $else {
        return 2;
    }
}

const D int = $ct_field_dispatch(Pair{ x: 1, y: 2.0 });
const C int = $ct_isint(3);
const F int = $ct_is_float_arg(1.5);
const Q int = $ct_is_type_of(Point{ x: 1 });

@[comptime]
fn ct_is_type_of(p Point) int {
    if ($is_type(p, Point)) { return 30; }
    return 40;
}

fn main() int {
    let a int = 5;
    let b f64 = 1.5;
    let ok1 int = $is_int(a).to_type(int);
    let ok2 int = $is_float(b).to_type(int);
    let ok3 int = $is_type(b, f64).to_type(int);
    let no1 int = $is_type(a, f64).to_type(int);
    let h int = $if ($is_int(a)) 11 $else 22;
    // ok1=1 ok2=1 ok3=1 no1=0 h=11 pick=1 D=3 C=7 F=1 Q=30
    return ok1 - 1 + ok2 - 1 + ok3 - 1 + no1 + h - 11 + pick(b) - 1 +
        D - 3 + C - 7 + F - 1 + Q - 30;
}