// expect: comptime-array-length-const=15
// exit: 0
// 先声明的全局整数常量可由编译期调用初始化并参与后续类型布局。

@[comptime]
fn array_length(value int) int {
    return value;
}

const ITEM_COUNT int = $array_length(3);

pub struct ConstLengthPacket {
    items [ITEM_COUNT]int;
}

let ITEMS [ITEM_COUNT]int = [1, 2, 3];

fn main() int {
    let result int = len(ITEMS) + sizeof(ConstLengthPacket);
    printf("comptime-array-length-const=%d\n", result);
    return 0;
}
