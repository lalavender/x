// expect: local-memory=ok
// LL5 第一切片语义锁：局部标量取址、参数指针、解引用读写、复合赋值与指针合流。
fn inc_by(p *int, delta int) int {
    *p += delta
    return *p
}

fn clear(p *int) void {
    *p = 0
}

fn main() int {
    let x int = 41
    let p *int = &x
    if (inc_by(p, 1) != 42) { return 1 }
    if (x != 42) { return 2 }
    *p = 7
    if (*p != 7 || x != 7) { return 3 }
    let y int = 5
    let q *int = &y
    *q = *p + 1
    if (y != 8) { return 4 }
    let i int = 0
    for i < 3 {
        *q += 1
        i += 1
    }
    if (y != 11) { return 5 }
    clear(q)
    if (y != 0 || *q != 0) { return 6 }
    let sel *int = p
    if (x == 7) { sel = q }
    *sel = 9
    if (x != 7 || y != 9) { return 7 }
    printf("local-memory=ok\n")
    return 0
}
