// expect: fnptr-null=ok
// 函数指针字段经 *void 空指针检查：LLVM lowering 必须把 fn 值与普通指针
// 一样参与显式 cast，而不是把整个函数判为“首片不支持”。
module main;

struct Holder {
    callback fn(int) int;
}

// twice 是用于非空函数指针字段的普通函数。
fn twice(value int) int {
    return value * 2;
}

// is_null 只通过 fn -> *void 显式转换判断字段是否为空。
fn is_null(holder Holder) int {
    if (holder.callback.to_type(*void) == 0) {
        return 1;
    }
    return 0;
}

// main 验证零值函数指针字段、赋值后的非空判断与间接调用。
fn main() int {
    let empty Holder;
    if (is_null(empty) != 1) {
        return 1;
    }
    empty.callback = twice;
    if (is_null(empty) != 0) {
        return 2;
    }
    if (empty.callback(21) != 42) {
        return 3;
    }
    printf("fnptr-null=ok\n");
    return 0;
}
