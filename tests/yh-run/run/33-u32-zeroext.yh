// exit: 42
// 无符号窄化必须零扩展（不带 printf）：u32 视图只保留低 32 位，
// 高位的残留值必须被清零，否则与 i64 比较/相加会带上脏高位。
fn main() i32 {
    let a i64 = 0xffffffffff       // 低 40 位全 1
    let u u32 = a.to_type(u32)     // 应为 0xffffffff
    if (u.to_type(i64) != 0xffffffff) { return 1 }
    // u32 参与 64 位算术不得带上高 32 位
    if (u.to_type(i64) + 1 != 0x100000000) { return 2 }
    // u16 / u8 零扩展
    let b i64 = 0x12345678
    if (b.to_type(u16).to_type(i64) != 0x5678) { return 3 }
    if (b.to_type(u8).to_type(i64) != 0x78) { return 4 }
    return 42
}
