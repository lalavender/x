// platform: darwin-arm64
// exit: 0
// Darwin/ARM64 首个 LLVM 对象只使用整数、分支、局部内存和内部调用。
fn adjust(value i64) i64 {
    let local i64 = value;
    let cell *i64 = &local;
    if (cell[0] > 3) {
        cell[0] = cell[0] + 5;
    } else {
        cell[0] = cell[0] + 7;
    }
    return cell[0];
}

fn main() int {
    let result i64 = adjust(1);
    if (result == 8) { return 0; }
    return 1;
}
