// expect: comptime-struct-array-values=1422
// exit: 0
// 编译期定长数组应支持结构体元素，并在参数、返回和结构体字段复制时保持隔离。

pub struct Point {
    x int;
    y int;
}

pub struct Shelf {
    points [2]Point;
}

// make_points：构造定长结构体数组，验证数组初始化与嵌套聚合返回。
@[comptime]
fn make_points(seed int) [2]Point {
    let points [2]Point = [
        Point{ x: seed, y: seed + 1 },
        Point{ x: seed + 2, y: seed + 3 },
    ];
    return points;
}

// edit_points：修改数组形参副本，验证结构体元素和数组均按值传递。
@[comptime]
fn edit_points(points [2]Point) [2]Point {
    points[1].x += 20;
    return points;
}

// struct_array_values：检查数组字段克隆、嵌套调用形参/返回和元素成员写入。
@[comptime]
fn struct_array_values() int {
    let original [2]Point = $make_points(1);
    let shelf Shelf = Shelf{ points: original };
    let duplicate Shelf = shelf;
    let changed [2]Point = $edit_points(duplicate.points);
    changed[0].x = 99;
    return original[0].x * 1000 + shelf.points[1].x * 100 +
        changed[0].x + changed[1].x;
}

const RESULT int = $struct_array_values();

fn main() int {
    printf("comptime-struct-array-values=%d\n", RESULT);
    return 0;
}
