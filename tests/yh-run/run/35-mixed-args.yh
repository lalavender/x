// exit: 42
// 混合整型/浮点参数寄存器分配回归（不带 printf，可在任意平台运行）：
// AAPCS64 的整型参数寄存器 x0..x7 与浮点参数寄存器 d0..d7 各自独立计数，
// 形参定位必须用「它在本类型中的序号」而非形参表位置。
// 曾因 `scale(v f64, k int)` 的 k 是第 2 个形参而被错读到 x1（应为 x0），
// 使浮点+整型混用的调用算出垃圾值。
fn scale(v f64, k int) f64 {
    return v * k.to_type(f64);
}

// 反向顺序：整型在前、浮点在后。
fn mix2(k int, v f64) f64 {
    return k.to_type(f64) + v;
}

// 多个浮点与多个整型交错：f0 i0 f1 i1
fn interleave(a f64, b int, c f64, d int) f64 {
    return a + b.to_type(f64) + c + d.to_type(f64);
}

fn main() i32 {
    // 1 浮点 + 1 整型
    if (scale(2.0, 3).to_type(int) != 6) { return 1; }
    if (scale(4.0, 3).to_type(int) != 12) { return 2; }
    if (scale(3.5, 2).to_type(int) != 7) { return 3; }
    // 整数在前
    if (mix2(3, 2.0).to_type(int) != 5) { return 4; }
    // 交错：1.5 + 2 + 3.5 + 4 = 11
    if (interleave(1.5, 2, 3.5, 4).to_type(int) != 11) { return 5; }
    return 42;
}
