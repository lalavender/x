// exit: 42
// 浮点实参位型回归（不带 printf，可在任意平台运行）：
// 1.0 的 IEEE754 位型必须精确为 0x3FF0000000000000。曾因实参压栈时
// 浮点值走 x0 路径（而非 d0）而被 callee 地址污染，导致常量高 16 位
// 被放到错误的移位处。本用例同时覆盖：浮点字面量作实参、浮点返回、
// 浮点与整型混用实参、f32/f64 转换。
fn bits(v f64) i64 {
    let holder *f64 = malloc(8).to_type(*f64)
    holder[0] = v
    let pb *i64 = holder.to_type(*i64)
    let r i64 = pb[0]
    free(holder.to_type(*void))
    return r
}

fn hyp(a f64, b f64) f64 {
    return a * a + b * b
}

fn main() i32 {
    // 1.0 的位型：低 32 位为 0，高 32 位为 0x3FF00000
    let b i64 = bits(1.0)
    if (b.to_type(int) != 0) { return 1 }
    if ((b >> 32).to_type(int) != 0x3ff00000) { return 2 }
    // 2.5 的位型：0x4004000000000000
    let c i64 = bits(2.5)
    if (c.to_type(int) != 0) { return 3 }
    if ((c >> 32).to_type(int) != 0x40040000) { return 4 }
    // 0.0 必须为全 0
    if (bits(0.0) != 0) { return 5 }
    // 浮点返回 + 浮点字面量实参
    if (hyp(3.0, 4.0).to_type(int) != 25) { return 6 }
    // 整型与浮点混用实参：4.0 * 3 = 12
    let k int = 3
    if ((4.0 * k.to_type(f64)).to_type(int) != 12) { return 7 }
    return 42
}
