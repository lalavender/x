// exit: 0
// 覆盖 LLVM lowering 的位复合赋值，以及 f32/f64 的算术复合赋值。
fn main() int {
    let bits int = 12;
    bits &= 10;
    bits |= 19;
    bits ^= 5;
    bits <<= 2;
    bits >>= 3;
    if (bits != 15) { return 1; }
    let wide f64 = 1.5;
    wide += 2.5;
    wide *= 2.0;
    wide -= 1.0;
    wide /= 2.0;
    if (wide != 3.5) { return 2; }
    let narrow f32 = 1.0.to_type(f32);
    narrow += 2.0.to_type(f32);
    narrow *= 2.0.to_type(f32);
    if (narrow != 6.0.to_type(f32)) { return 3; }
    return 0;
}
