// expect: one
// expect-more: two
// expect-more: other
// expect-more: two
// switch 多值 case 与 default；case 之间无 fallthrough，执行完块即离开。
fn classify(v int) int {
    switch v {
        case 1 {
            printf("one\n")
        }
        case 2, 3 {
            printf("two\n")
        }
        default {
            printf("other\n")
        }
    }
    return 0
}
fn main() int {
    classify(1)
    classify(2)
    classify(9)
    classify(3)
    return 0
}
