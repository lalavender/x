// expect: enum-qualified=22
// exit: 0
// 枚举成员的限定引用 `EnumName.member`：枚举类型名不是值，直接解析到成员常量。
// 覆盖顶层常量初始化、普通函数体内与编译期函数体内三处。
// 折算：TOP=blue=8 + local=green=7 + $green_value()=7 → 22。

pub enum Palette {
    red;
    green = 7;
    blue;
}

// green_value：编译期函数体内引用限定成员。
@[comptime]
fn green_value() int {
    return Palette.green.to_type(int);
}

const TOP int = Palette.blue;

fn main() int {
    let local int = Palette.green;
    printf("enum-qualified=%d\n", TOP + local + $green_value());
    return 0;
}
