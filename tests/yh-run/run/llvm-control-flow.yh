// expect: control-flow=ok
// LL4 控制流语义锁：嵌套循环、break/continue、无限循环与循环携带值。
// 与 tests/selfhost/llvm-control.py 使用同一组断言；本用例经旧后端运行。
fn main() int {
    // 嵌套循环 + 内层 break：每轮外层累计内层 0..1 两个值再加 10。
    let total int = 0;
    let i int = 0;
    for i < 3 {
        let j int = 0;
        for j < 10 {
            if (j == 2) { break; }
            total += 1;
            j += 1;
        }
        total += 10;
        i += 1;
    }
    if (total != 36) { return 1; }

    // 无限循环 + continue + break。
    let n int = 0;
    let k int = 0;
    for {
        k += 1;
        if (k % 2 == 0) { continue; }
        n += 1;
        if (k >= 7) { break; }
    }
    if (n != 4 || k != 7) { return 2; }

    // 嵌套 continue 只作用于内层循环。
    let m int = 0;
    let a int = 0;
    for a < 2 {
        let b int = 0;
        for b < 4 {
            b += 1;
            if (b == 2) { continue; }
            m += 1;
        }
        a += 1;
    }
    if (m != 6) { return 3; }

    // 外层 break 位于嵌套内层之后，只能结束外层。
    let s int = 0;
    let t int = 0;
    for t < 10 {
        let u int = 0;
        for u < 2 { s += 1; u += 1; }
        if (t == 1) { break; }
        t += 1;
    }
    if (s != 4) { return 4; }

    // 循环体内声明的绑定不参与外层携带 phi。
    let w int = 0;
    let q int = 0;
    for q < 2 {
        let z int = 10;
        z += 1;
        w += z;
        q += 1;
    }
    if (w != 22) { return 5; }

    printf("control-flow=ok\n");
    return 0;
}
