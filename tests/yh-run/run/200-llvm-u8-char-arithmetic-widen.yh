// LL10 回归：u8 与字符字面量算术的结果可按语义规则隐式加宽到 int。
// exit: 0

// mb_parse_hex：解析恰好 16 位十六进制文本，覆盖条件分支中的字符运算与赋值加宽。
fn mb_parse_hex(text *char, value *u64) int {
    let result u64 = 0
    let i int = 0
    for i < 16 {
        let c u8 = text[i].to_type(u8)
        let digit int = -1
        if (c >= '0' && c <= '9') { digit = c - '0' }
        if (c >= 'a' && c <= 'f') { digit = c - 'a' + 10 }
        if (c >= 'A' && c <= 'F') { digit = c - 'A' + 10 }
        if (digit < 0) { return -1 }
        result = (result << 4) | digit.to_type(u64)
        i += 1
    }
    if (text[16] != 0) { return -1 }
    *value = result
    return 0
}

// main：验证有效大小写十六进制输入，并拒绝非法字符。
fn main() int {
    let value u64 = 0
    if (mb_parse_hex("0123456789abcdef", &value) != 0) { return 1 }
    if (value != 81985529216486895) { return 2 }
    if (mb_parse_hex("000000000000000g", &value) == 0) { return 3 }
    return 0
}
