// expect: 1 2 5 6 7
// 聚合解引用赋值的整块复制（缺陷回归）：`*dst = *src` 两侧都是结构体
// 解引用时，右值是**对象地址**而不是对象头 8 字节的内容。
// 旧发射器把 `*src` 按标量装入（取 x/y 两个 int 当指针），随后整块拷贝
// 到该野地址，运行时段错误。同时覆盖 12 字节（非 2 的幂、跨 8 字节边界）
// 结构体：只写前 8 字节的旧行为会在这里露馅。
struct P {
    x int
    y int
}

struct T {
    a int
    b int
    c int
}

fn copy_p(dst *P, src *P) int {
    *dst = *src
    return dst.x
}

fn copy_t(dst *T, src *T) int {
    *dst = *src
    return dst.a
}

fn main() int {
    let a P = P{ x: 1, y: 2 }
    let b P = P{ x: 0, y: 0 }
    printf("%d %d ", copy_p(&b, &a), b.y)
    let c T = T{ a: 5, b: 6, c: 7 }
    let d T = T{ a: 0, b: 0, c: 0 }
    printf("%d %d %d\n", copy_t(&d, &c), d.b, d.c)
    return 0
}
