// exit: 0
// 聚合字面量与三元分支里的合法字面量窄化（S4-2f：fill 侧 can_assign 镜像的覆盖）
struct P {
    big u8;
    small i64;
}

fn take(x u8) int {
    return x.to_type(int)
}

fn main() int {
    let p P = P{big: 200, small: 5}
    let a [4]u8 = [1, 200, 3, 254]
    let c int = 1
    let t u8 = c != 0 ? 200 : 100
    let x int = take(200) + p.big.to_type(int) + a[1].to_type(int) + t.to_type(int)
    if (x != 200 + 200 + 200 + 200) { return 1 }
    return 0
}
