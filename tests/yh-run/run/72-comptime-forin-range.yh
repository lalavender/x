// expect: range=12 indexed=42 empty=0 flow=5
// exit: 0
// 区间 for-in：验证值/下标绑定、空区间与循环跳转在编译期函数中的执行。

// range_sum：按普通 for-in 区间语法累加每个元素值。
@[comptime]
fn range_sum(start int, end int) int {
    let total int = 0
    for value in start..end {
        total += value
    }
    return total
}

// indexed_sum：验证两绑定形式中的下标从零开始、元素值按区间起点递增。
@[comptime]
fn indexed_sum(start int, end int) int {
    let total int = 0
    for index, value in start..end {
        total += index * 10 + value
    }
    return total
}

// range_flow：验证编译期 for-in 的 continue 与 break 只影响当前循环。
@[comptime]
fn range_flow(start int, end int) int {
    let total int = 0
    for value in start..end {
        if (value == 1) { continue }
        if (value == 4) { break }
        total += value
    }
    return total
}

const RANGE int = $range_sum(3, 6)
const INDEXED int = $indexed_sum(3, 6)
const EMPTY int = $range_sum(5, 3)
const FLOW int = $range_flow(0, 8)

// main：打印多种区间 for-in 求值结果供端到端比较。
fn main() int {
    printf("range=%d indexed=%d empty=%d flow=%d\n", RANGE, INDEXED, EMPTY, FLOW)
    return 0
}
