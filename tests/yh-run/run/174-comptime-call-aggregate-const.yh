// expect: tbl=15 sum=15
// exit: 0
// run/174：`$` 调用初始化的聚合常量（单文件路径）。
// 顶层聚合常量由编译期函数调用物化：编译期读（下标/遍历/字段）与运行期读
// 都走与字面量形态相同的模型/数据路径。跨模块导出形态见
// tests/modules/projects/comptimecross 的 `CT_TBL`。

pub struct Box {
    lo int
    hi int
}

@[comptime]
fn mk_arr() [3]int {
    return [4, 5, 6]
}

@[comptime]
fn mk_box() Box {
    return Box{ lo: 7, hi: 8 }
}

const TBL [3]int = $mk_arr()
const B Box = $mk_box()

@[comptime]
fn sum_tbl() int {
    let s int = 0
    for v in TBL { s += v }
    return s
}

const SUM int = $sum_tbl()

fn main() int {
    printf("tbl=%d sum=%d\n", TBL[0] + TBL[1] + TBL[2], SUM + B.lo + B.hi - 15)
    return TBL[0] + TBL[2] - 10 + B.hi - 8 + SUM - 15
}