// expect: array=9 slice=7
// exit: 0
// 编译期函数可写入本地整型数组/切片元素并将修改反映到后续读取。

@[comptime]
fn update_array() int {
    let values [3]int = [2, 4, 6];
    values[1] = 9;
    return values[1];
}

@[comptime]
fn update_slice() int {
    let values []int = [1, 3, 5];
    let index int = 1;
    values[index] += 4;
    return values[index];
}

const ARRAY int = $update_array();
const SLICE int = $update_slice();

fn main() int {
    printf("array=%d slice=%d\n", ARRAY, SLICE);
    return 0;
}
