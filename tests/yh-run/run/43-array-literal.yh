// exit: 30
// 数组/切片字面量：let 初始化、同型赋值与实参上下文。
// 全局数组字面量为常量数据；切片字面量为 {n, data} 视图。
let garr [3]int = [10, 20, 30]

fn sum(s []int) int {
    let t int = 0
    for x in s { t = t + x }
    return t
}

fn main() int {
    let a [2]int = [1, 2]
    if (a[0] != 1 || a[1] != 2) { return 1 }
    let s []int = [7, 8, 9]
    if (len(s) != 3) { return 2 }
    if (sum([4, 5]) != 9) { return 3 }
    if (garr[2] != 30) { return 4 }
    let f [2]f64 = [1.5, 2.5]
    if (f[0] != 1.5) { return 5 }
    return 30
}
