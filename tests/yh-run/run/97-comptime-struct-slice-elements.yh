// expect: comptime-struct-slice-elements=1638 global=2048 local=1028
// exit: 0
// 结构体元素切片应共享字段写入、按值遍历，并在返回和静态物化时复制完整值。

pub struct SlicePoint {
    x int
    y int
    samples []int
}

// make_points：从被调函数的局部数组返回结构体切片视图。
@[comptime]
fn make_points(seed int) []SlicePoint {
    let left [2]int = [seed + 4, seed + 5]
    let right [2]int = [seed + 6, seed + 7]
    let points [2]SlicePoint = [
        SlicePoint{ x: seed, y: seed + 1, samples: left[0..2] },
        SlicePoint{ x: seed + 2, y: seed + 3, samples: right[0..2] },
    ]
    return points[0..2]
}

// edit_points：修改切片底层字段，并验证 for-in 元素仍按值复制。
@[comptime]
fn edit_points(points []SlicePoint) int {
    let view []SlicePoint = points[0..2]
    view[0].x += 10
    view[1].y += 20
    view[0].samples[0] += 10
    let sum int = 0
    for point in view {
        point.x = 100
        sum += point.x + point.y + point.samples[0]
    }
    return view[0].x * 100 + view[1].y * 10 + sum
}

// exercise_points：跨 typed 调用帧消费并检查返回切片副本。
@[comptime]
fn exercise_points(seed int) int {
    let points []SlicePoint = $make_points(seed)
    let changed int = $edit_points(points)
    return changed + points[0].x + points[1].y + points[0].samples[0]
}

const RESULT int = $exercise_points(1)
let GLOBAL_POINTS []SlicePoint = $make_points(20)

fn main() int {
    let local_points []SlicePoint = $make_points(10)
    printf("comptime-struct-slice-elements=%d global=%d local=%d\n", RESULT,
        GLOBAL_POINTS[0].x * 100 + GLOBAL_POINTS[1].y
            + GLOBAL_POINTS[0].samples[1],
        local_points[0].x * 100 + local_points[1].y
            + local_points[0].samples[1])
    return 0
}
