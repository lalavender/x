// expect: typed-layout-request=40
// exit: 0
// 带局部可变值和循环的 typed CT 函数结果决定后续字段及全局数组长度。

@[comptime]
fn computed_length(value int) int {
    let index int = 0;
    let total int = 1;
    for index < value {
        total += 1;
        index += 1;
    }
    return total;
}

const ITEM_COUNT int = $computed_length(3);

pub struct TypedLayoutPacket {
    items [ITEM_COUNT]int;
}

// TypedLayoutEnvelope：嵌套 pending 结构体，验证布局按字段依赖完成。
pub struct TypedLayoutEnvelope {
    packet TypedLayoutPacket;
}

let values [ITEM_COUNT]int;

fn main() int {
    let local [ITEM_COUNT]int;
    let result int = len(values) + len(local) + sizeof(TypedLayoutPacket)
        + sizeof(TypedLayoutEnvelope);
    printf("typed-layout-request=%d\n", result);
    return 0;
}
