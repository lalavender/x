// expect: array=18 slice=45 empty=0
// exit: 0
// 编译期局部整型数组和切片字面量应可按普通 for-in 语义读取。

// sum_array：在编译期函数中创建固定数组并累加其元素。
@[comptime]
fn sum_array() int {
    let values [3]int = [4, 6, 8];
    let total int = 0;
    for value in values {
        total += value;
    }
    return total;
}

// sum_slice：创建切片字面量并用下标绑定验证元素顺序。
@[comptime]
fn sum_slice() int {
    let values []int = [3, 5, 7];
    let total int = 0;
    for index, value in values {
        total += index * 10 + value;
    }
    return total;
}

// sum_empty：空切片的 for-in 不执行循环体。
@[comptime]
fn sum_empty() int {
    let values []int = [];
    let total int = 0;
    for value in values {
        total += value;
    }
    return total;
}

const ARRAY int = $sum_array();
const SLICE int = $sum_slice();
const EMPTY int = $sum_empty();

// main：打印数组和切片的编译期迭代结果。
fn main() int {
    printf("array=%d slice=%d empty=%d\n", ARRAY, SLICE, EMPTY);
    return 0;
}
