// expect: 20 10 30 7
// 嵌套三元表达式（缺陷回归）：内层三元在 else 分支里求值时，外层尚未
// 发射的 else/end 标签必须保存下来。旧发射器共用一对全局标签，内层
// 覆盖外层后发射**重复 .L 标签**，汇编器直接拒绝（`symbol .L4 is
// already defined`），编译链接失败。
fn main() int {
    let a int = 0
    let b int = 1
    printf("%d ", a ? 10 : (b ? 20 : 30))
    printf("%d ", b ? (a ? 40 : 10) : 50)
    printf("%d ", a ? 1 : (a ? 2 : (b ? 30 : 4)))
    printf("%d\n", (b ? (a ? 1 : 2) : 3) + (a ? 4 : (b ? 5 : 6)))
    return 0
}
