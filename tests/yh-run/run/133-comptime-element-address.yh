// expect: comptime-element-address=10235
// exit: 0
// 编译期整数数组元素、切片视图元素与结构体整数字段的取址都别名当前帧存储。

@[comptime]
fn bump(cell *int, delta int) int {
    *cell += delta
    return *cell
}

pub struct Counter {
    value int
    tag int
}

@[comptime]
fn drive() int {
    let cells [3]int = [1, 2, 3]
    $bump(&cells[1], 10)
    let view []int = cells[1..3]
    $bump(&view[1], 5)
    let counter Counter = Counter{ value: 4, tag: 7 }
    $bump(&counter.value, 6)
    return cells[0] * 100 + cells[1] * 10 + cells[2] +
        counter.value * 1000 + counter.tag
}

const RESULT int = $drive()

fn main() int {
    printf("comptime-element-address=%d\n", RESULT)
    return 0
}
