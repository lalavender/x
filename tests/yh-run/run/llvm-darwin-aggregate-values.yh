// platform: darwin-arm64
// exit: 0
// 验证 Darwin 目标上的结构体值复制和返回语义，C ABI 由 selfhost 专项独立验收。
struct ByteValue { value u8 }
struct TripleValue { first u8; second u8; third u8 }
struct WordValue { value u64 }
struct Pair16Value { first u64; second u64 }
struct WideValue { first u64; second u64; third u64 }

// mutate_wide：返回参数副本并改写其中一个字段，不应改动调用方的原值。
fn mutate_wide(value WideValue) WideValue {
    value.third = value.third + 5
    return value
}

// main：检查小型与大于 16 字节的 YH 聚合参数、字段与返回结果。
fn main() int {
    let byte ByteValue = ByteValue{0xa5}
    let triple TripleValue = TripleValue{0x12, 0x34, 0x56}
    let word WordValue = WordValue{0x123456789abcdef0}
    let pair Pair16Value = Pair16Value{11, 22}
    let wide WideValue = WideValue{11, 22, 33}
    let result WideValue = mutate_wide(wide)
    if (byte.value != 0xa5 || triple.third != 0x56 || word.value != 0x123456789abcdef0) {
        return 1
    }
    if (pair.first != 11 || pair.second != 22) { return 2 }
    if (result.first != 11 || result.second != 22 || result.third != 38) { return 3 }
    if (wide.third != 33) { return 4 }
    return 0
}
