// exit: 20
// 切片表达式 arr[start..end]：左闭右开视图，不拷贝元素、无边界检查。
// len = max(0, end-start)，data = 基址 + start*元素大小。
fn sum(s []int) int {
    let t int = 0;
    for x in s { t = t + x; }
    return t;
}

fn main() int {
    let a [6]int;
    let i int = 0;
    for i < 6 {
        a[i] = i * 2;
        i = i + 1;
    }
    let s1 []int = a[1..4];
    if (len(s1) != 3) { return 1; }
    if (s1[0] != 2 || s1[2] != 6) { return 2; }
    if (sum(a[0..6]) != 30) { return 3; }
    let s2 []int = a[3..5];
    if (sum(s2) != 14) { return 4; }
    if (len(a[4..4]) != 0) { return 5; }
    return 20;
}
