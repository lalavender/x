// expect: ct-branch-layout=100
// exit: 0
// CT5A 安全探测应按实参执行 if/else，并在后续类型布局前就绪全局常量。

@[comptime]
fn choose_length(value int) int {
    if (value > 3) {
        return value + 1;
    } else {
        return value * 2;
    }
}

@[comptime]
fn choose_default(value int) int {
    if (value == 1) {
        return value + 4;
    }
    return value + 5;
}

const HIGH_LENGTH int = $choose_length(4);
const LOW_LENGTH int = $choose_length(2);
const MATCH_LENGTH int = $choose_default(1);
const DEFAULT_LENGTH int = $choose_default(2);

pub struct ConditionalLayout {
    high [HIGH_LENGTH]int;
    low [LOW_LENGTH]int;
    matched [MATCH_LENGTH]int;
    fallback [DEFAULT_LENGTH]int;
}

let values [HIGH_LENGTH + LOW_LENGTH]int;

fn main() int {
    let local [DEFAULT_LENGTH]int;
    printf("ct-branch-layout=%d\n", len(values) + len(local) + sizeof(ConditionalLayout));
    return 0;
}
