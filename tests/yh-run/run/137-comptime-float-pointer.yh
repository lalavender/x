// expect: float-pointer=37
// exit: 0
// 编译期浮点指针：标量取址、解引用读写、浮点聚合元素取址与浮点指针形参跨帧别名。
// 结果折算：value 1.5 → 2.5 →（bump +0.5、forward +1.0）4.0；元素 0.25 → 2.25；
// 单精度槽 2.0 → 3.0；合计 9.25，乘 4 后截断为 37。

// forward：二次转发同一个浮点指针，别名链仍指回原槽。
@[comptime]
fn forward(pointer *f64) int {
    *pointer += 1.0;
    return 0;
}

// bump：通过 *f64 形参写回调用方帧的浮点槽，并转发给另一个编译期函数。
@[comptime]
fn bump(pointer *f64) f64 {
    *pointer += 0.5;
    $forward(pointer);
    return *pointer;
}

// pointer_math：浮点局部取址、解引用写、浮点数组元素取址与单精度槽。
@[comptime]
fn pointer_math() f64 {
    let value f64 = 1.5;
    let ptr *f64 = &value;
    *ptr = *ptr + 1.0;
    let bumped f64 = $bump(&value);
    let values [2]f64 = [0.25, 0.75];
    let first *f64 = &values[0];
    *first += 2.0;
    let small f32 = 2.0.to_type(f32);
    let small_ptr *f32 = &small;
    *small_ptr += 1.0.to_type(f32);
    return bumped + values[0] + small.to_type(f64);
}

// drive：把浮点指针运算结果折算成整数常量。
@[comptime]
fn drive() int {
    return ($pointer_math() * 4.0).to_type(int);
}

const RESULT int = $drive();

fn main() int {
    printf("float-pointer=%d\n", RESULT);
    return 0;
}
