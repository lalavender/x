// expect: 720
// factorial：通过普通 if 的条件递归验证编译期返回值和调用帧隔离。
@[comptime] fn factorial(n int) int {
    if (n < 0) {
        $compile_error("未选中的负数路径")
    }
    if (n <= 1) {
        return 1
    } else {
        return n * $factorial(n - 1)
    }
}

const RESULT int = $factorial(6)

fn main() int {
    printf("%d\n", RESULT)
    return 0
}
