// exit: 0
// LL4 for-in 语义锁：数组、切片、区间、值绑定、嵌套循环、break 与聚合值复制。
struct ForInPoint { x int; y int; }

fn main() int {
    let values [4]int = [3, 5, 8, 11];
    let sum int = 0;
    for value in values { sum += value; }
    if (sum != 27) { return 1; }

    let view []int = values[1..4];
    let weighted int = 0;
    for index, value in view {
        if (index != 1) { weighted += index * value; }
    }
    if (weighted != 22) { return 2; }

    let prefix int = 0;
    for value in values {
        prefix += value;
        if (value == 8) { break; }
    }
    if (prefix != 16) { return 3; }

    let product int = 0;
    for left in values[0..2] {
        for right in values[2..4] { product += left * right; }
    }
    if (product != 152) { return 4; }

    let points [2]ForInPoint = [ForInPoint{ x: 1, y: 2 }, ForInPoint{ x: 3, y: 4 }];
    let point_sum int = 0;
    for point in points {
        point_sum += point.x;
        point.x = 99;
    }
    if (point_sum != 4 || points[0].x != 1 || points[1].x != 3) { return 5; }

    let range_sum int = 0;
    for value in 2..5 { range_sum += value; }
    if (range_sum != 9) { return 6; }

    let empty []int = values[4..4];
    let empty_sum int = 0;
    for value in empty { empty_sum += value; }
    if (empty_sum != 0) { return 7; }

    return 0;
}
