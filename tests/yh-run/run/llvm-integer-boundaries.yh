// expect: llvm-integers=ok
// exit: 0
// 源类型保留定宽位型，运行时以 64 位计算/掩码移位，结果先截断后才能扩大转换。

// left8：窄有符号结果在同一表达式中扩大，必须先截到 i8。
fn left8(value i8, amount i8) i64 { return (value << amount).to_type(i64); }
// left32 / left_u32：32 位移位量 32 仍按 64 位计算，但最终结果为源位宽。
fn left32(value int, amount int) i64 { return (value << amount).to_type(i64); }
fn left_u32(value u32, amount u32) u64 { return (value << amount).to_type(u64); }
// right32 / right_u32：有符号算术右移与无符号逻辑右移区分。
fn right32(value int, amount int) int { return value >> amount; }
fn right_u32(value u32, amount u32) u32 { return value >> amount; }
// left64：原 64 位结果无需窄化，移位量统一 &63。
fn left64(value u64, amount u64) u64 { return value << amount; }

// quotient / remainder：除零和 min/-1 的动态规则不使用 LLVM UB。
fn quotient32(left int, right int) int { return left / right; }
fn remainder32(left int, right int) int { return left % right; }
fn quotient64(left i64, right i64) i64 { return left / right; }
fn remainder64(left i64, right i64) i64 { return left % right; }
// add_wide / negate8：算术及一元运算的源结果截断早于随后显式扩大。
fn add_wide(left int, right int) i64 { return (left + right).to_type(i64); }
fn negate8(value i8) i64 { return (-value).to_type(i64); }

// main：掩码边界、符号、截断、溢出位型和动态除模自校验。
fn main() int {
    if (left8(1, 7) != -128 || left8(1, 32) != 0 || left8(1, 64) != 1) { return 1; }
    if (left32(1, -1) != 0 || left32(1, 0) != 1 || left32(1, 31) != -2147483648
        || left32(1, 32) != 0 || left32(1, 63) != 0 || left32(1, 64) != 1
        || left32(1, 65) != 2) { return 2; }
    if (left_u32(1, 31) != 2147483648 || left_u32(1, 32) != 0) { return 3; }
    if (right32(-8, 32) != -1 || right32(-8, 64) != -8 || right32(-8, 65) != -4) { return 4; }
    if (right_u32(2147483648, 32) != 0 || right_u32(2147483648, 64) != 2147483648) { return 5; }
    if (left64(1, 63) != 0x8000000000000000 || left64(1, 64) != 1 || left64(1, 65) != 2) { return 6; }
    if (quotient32(-21, 4) != -5 || remainder32(-21, 4) != -1
        || quotient32(5, 0) != 0 || remainder32(5, 0) != 5
        || quotient32(-2147483648, -1) != -2147483648) { return 7; }
    let minimum i64 = 0x8000000000000000.to_type(i64);
    if (quotient64(minimum, -1) != minimum || remainder64(minimum, -1) != 0
        || quotient64(minimum, 0) != 0 || remainder64(minimum, 0) != minimum) { return 8; }
    if (add_wide(2147483647, 1) != -2147483648 || negate8(-128) != -128) { return 9; }
    printf("llvm-integers=ok\n");
    return 0;
}
