// expect: newline-terminator=15
// exit: 0
// 行尾分号可省略；`}` 前与文件尾可省略；括号内自由换行。

fn add(a int, b int) int {
    return a + b
}

fn main() int {
    let total int = 0
    let i int = 0
    for i < 5 {
        total += add(i,
            1)
        i += 1
    }
    printf("newline-terminator=%d\n", total)
    return 0
}
