// expect: 12 7 8 9 12 10 20 99 40
// 指针算术按元素大小缩放（缺陷回归）：T 是 12 字节（3×int），
// `p + i` 必须按 sizeof(T)=12 缩放；旧发射器把 2 的幂以外的元素一律
// 按 8 缩放，指针指到错误元素（读到相邻元素的字段）。
// 后半段锁定 `&局部数组[变量]` 的读/写缩放（int=4 字节）。
struct T {
    a int
    b int
    c int
}

fn main() int {
    let arr [4]T = [T{ a: 1, b: 2, c: 3 }, T{ a: 4, b: 5, c: 6 },
                    T{ a: 7, b: 8, c: 9 }, T{ a: 10, b: 11, c: 12 }]
    let idx int = 2
    let q *T = &arr[0] + idx
    printf("%d %d %d %d %d ", sizeof(T), q.a, q.b, q.c, (q + 1).c)
    let v [4]int = [10, 20, 30, 40]
    let i int = 2
    let p *int = &v[i]
    *p = 99
    printf("%d %d %d %d\n", v[0], v[1], v[2], v[3])
    return 0
}
