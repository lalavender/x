// expect: pointer-arith=20
// exit: 0
// 编译期指针算术与指针下标：p + i、i + p、p - i、p[i] 读写与指针比较。
// 折算：数组和 2.5，指针下标写回后 7.5，合计乘 2 截断为 20。

// sum_via_pointer：用指针算术遍历调用方帧的数组元素。
@[comptime]
fn sum_via_pointer(base *f64, count int) f64 {
    let total f64 = 0.0;
    let cursor *f64 = base;
    let i int = 0;
    for i < count {
        total += *cursor;
        cursor = cursor + 1;
        i += 1;
    }
    return total;
}

// write_via_index：用指针下标与算术写回元素再读回。
@[comptime]
fn write_via_index(base *f64) f64 {
    base[0] = 1.5;
    base[1] = base[0] + 0.5;
    *(base + 2) = 4.0;
    let head *f64 = 1 + base;
    let tail *f64 = base + 2;
    if (head != base + 1) { return -1.0; }
    return base[0] + base[1] + *tail;
}

// pointer_arith：驱动指针算术函数并折算成整数常量。
@[comptime]
fn pointer_arith() int {
    let values [4]f64 = [0.25, 0.5, 0.75, 1.0];
    let total f64 = $sum_via_pointer(&values[0], 4);
    let written f64 = $write_via_index(&values[0]);
    return ((total + written) * 2.0).to_type(int);
}

const RESULT int = $pointer_arith();

fn main() int {
    printf("pointer-arith=%d\n", RESULT);
    return 0;
}
