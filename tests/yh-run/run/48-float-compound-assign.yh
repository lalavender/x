// expect: 3
// expect-more: 2
// expect-more: 6
// 浮点复合赋值与类型化浮点变参打包。
// 回归背景一：浮点复合赋值分支的 x10 保护压/弹不成对（弹空栈），d1 从
// 垃圾地址装入，程序段错误或结果错乱。
// 回归背景二：类型化变参的浮点元素误从 x 栈弹出（值在 FP 栈）。
fn sum(all ...f64) int {
    let s f64 = 0.0
    let i int = 0
    for i < len(all) {
        s += all[i]
        i += 1
    }
    return s.to_type(int)
}

fn main() int {
    let s f64 = 1.0
    s += 2.0
    printf("%d\n", s.to_type(int))
    let t f64 = 1.5
    t *= 2.0
    t -= 0.5
    t /= 1.25
    printf("%d\n", t.to_type(int))
    printf("%d\n", sum(1.5, 2.5, 2.0))
    return 0
}
