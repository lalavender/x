// exit: 5
// 自举编译器 `-o` 模式的端到端用例（不带 printf）：
// 该用例本身只做简单计算与退出码，供 `yh -o <out> <src>` 直接编译运行，
// 验证兼容层（发射汇编 → 调用外部工具链 → 产出可执行）在三种模式下一致。
// 用于 tests/selfhost/g3-acceptance.py 的 -o 冒烟检查。
fn add3(a int, b int, c int) int {
    return a + b + c
}

fn main() i32 {
    let x int = 1
    let y int = 2
    let z int = 2
    return add3(x, y, z)
}
