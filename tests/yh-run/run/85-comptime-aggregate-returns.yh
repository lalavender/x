// expect: comptime-aggregate-returns=408
// exit: 0
// 编译期嵌套调用返回数组/结构体时复制到调用方帧并保持值隔离。

pub struct Packet {
    rows [2][2]int;
}

// make_packet：构造并返回含多维数组字段的编译期结构体。
@[comptime]
fn make_packet(seed int) Packet {
    let packet Packet = Packet{ rows: [[seed, seed + 1], [seed + 2, seed + 3]] };
    return packet;
}

// copy_packet：以聚合形参初始化并按值返回结构体。
@[comptime]
fn copy_packet(packet Packet) Packet {
    return packet;
}

// make_values：返回定长整数数组，供另一编译期函数接收。
@[comptime]
fn make_values(seed int) [2]int {
    let values [2]int = [seed, seed + 1];
    return values;
}

// aggregate_returns：修改嵌套调用结果，确认其所有权属于调用方帧。
@[comptime]
fn aggregate_returns() int {
    let original Packet = $make_packet(1);
    let duplicate Packet = $copy_packet(original);
    duplicate.rows[1][0] = 9;
    let values [2]int = $make_values(7);
    values[1] += 10;
    return original.rows[1][0] * 100 +
        duplicate.rows[1][0] * 10 + values[1];
}

const RESULT int = $aggregate_returns();

fn main() int {
    printf("comptime-aggregate-returns=%d\n", RESULT);
    return 0;
}
