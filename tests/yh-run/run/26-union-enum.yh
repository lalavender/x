// expect: b=2 i=258
// expect-more: r1=12 r2=2
// expect-more: code=404
// union 共享存储与 enum（0.0.2 B2-2）：写 i 读 b 得低位字节；
// enum 常量作 switch 匹配值与显式转 int；显式值枚举。
pub union Val {
    i int
    b u8
}

pub enum Op {
    add
    sub
}

pub enum HttpStatus {
    ok = 200
    not_found = 404
}

fn apply(o Op, a int, b int) int {
    switch o {
        case add {
            return a + b
        }
        case sub {
            return a - b
        }
    }
    return 0
}

fn code(s HttpStatus) int {
    return s.to_type(int)
}

fn main() int {
    let v Val
    v.i = 258
    printf("b=%d i=%d\n", v.b, v.i)
    printf("r1=%d r2=%d\n", apply(add, 7, 5), apply(sub, 7, 5))
    printf("code=%d\n", code(not_found))
    return 0
}
