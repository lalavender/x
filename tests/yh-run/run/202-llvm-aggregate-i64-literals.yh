// LL10 回归：聚合字面量字段和数组元素须保留完整 i64 正负字面量。
// exit: 0

pub struct LargeValues {
    first i64;
    second i64;
}

// main：检查结构体字段和数组元素不会先截断到 32 位再扩宽。
fn main() int {
    const offset int = 3;
    let base int = 7, next int = base + 1;
    let pair LargeValues = LargeValues{10000000001, -20000000002};
    let values [2]i64 = [10000000001, -20000000002], total i64 = values[0] + values[1];
    if (base != 7) { return 3; }
    if (next != 8) { return 4; }
    if (offset != 3) { return 9; }
    if (values[0] != 10000000001) { return 6; }
    if (values[1] != -20000000002) { return 7; }
    if (values[0] + values[1] != -10000000001) { return 8; }
    if (total != -10000000001) { return 5; }
    if (pair.first != 10000000001 || pair.second != -20000000002) { return 1; }
    if (values[0] != 10000000001 || values[1] != -20000000002) { return 2; }
    return 0;
}
