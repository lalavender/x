// expect: 7
// 模块私有类型（struct/union/enum 缺省 pub）在单文件模式下正常构造与访问；
// ADR-0013：pub 只影响可见性，不改变布局与 ABI。
struct Pair {
    a int;
    b int;
}

union Bits {
    i int;
    u u32;
}

enum Mode {
    off;
    on;
}

fn main() int {
    let p Pair;
    p.a = 2;
    p.b = 3;
    let x Bits;
    x.i = 4;
    // 2 + 3 + 4 - 3 + Mode.on(1) = 7
    printf("%d\n", p.a + p.b + x.i - 3 + Mode.on);
    return 0;
}
