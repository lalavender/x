// exit: 0
// 整数 to_type 转换在 SSA 与旧发射器两条路径上都保持目标宽度和符号扩展语义。
fn main() int {
    let signed_value i8 = -1;
    let unsigned_value u8 = 255;
    let unsigned32 u32 = 4294967295;
    let value i64 = -1;
    if (signed_value.to_type(i64) != -1) { return 1; }
    if (unsigned_value.to_type(i64) != 255) { return 2; }
    if (unsigned32.to_type(i64) != 4294967295) { return 3; }
    if (value.to_type(u8).to_type(i64) != 255) { return 4; }
    if (value.to_type(u32).to_type(i64) != 4294967295) { return 5; }
    return 0;
}
