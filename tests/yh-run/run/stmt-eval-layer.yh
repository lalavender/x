// exit: 0
// 语句层 eval 入口（S4-2 语句侧）：`break`/`continue`、`goto` 与标签定义、
// 简单赋值与全部复合赋值、`return` 的收尾——都经 `check.sem_eval_*` 入口。
fn sum_skip(limit int) int {
    let acc int = 0
    let i int = 0
    for i < limit {
        i += 1
        if (i == 2) { continue }
        if (i > 4) { break }
        acc += i
    }
    return acc
}

// via_goto：标签定义与前向/后向跳转（`goto` 需先登记、标签再定义）。
fn via_goto(n int) int {
    let x int = n
    if (x < 0) { goto neg }
    goto out
neg:
    x = 0 - x
out:
    return x
}

fn main() int {
    // continue 跳过 2、break 于 5 之前 → 1 + 3 + 4 = 8
    if (sum_skip(10) != 8) { return 1 }
    // 复合赋值全谱
    let v int = 20
    v += 5
    v -= 3
    v *= 2
    v /= 4
    v %= 5
    v |= 6
    v &= 3
    v ^= 1
    v <<= 3
    v >>= 2
    if (v != 4) { return 2 }
    // goto 与标签：负值取反、正值原样
    if (via_goto(-7) != 7) { return 3 }
    if (via_goto(9) != 9) { return 4 }
    // return 值传回（i = 1、3 → 4）
    if (sum_skip(3) != 4) { return 5 }
    return 0
}
