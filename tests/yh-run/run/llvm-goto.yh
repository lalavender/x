// expect: goto=ok
// LL4 goto/label 语义锁：向后跳转成环、前向跳过不可达代码、多前驱合流、
// 跳出循环与块内标签。与 tests/selfhost/llvm-goto.py 使用同一组断言。
fn main() int {
    let i int = 0;
loop:
    i += 1;
    if (i < 3) { goto loop; }
    goto end;
    i += 100;
end:
    if (i != 3) { return 1; }

    let x int = 0;
    let c int = 1;
    if (c == 1) { x = 5; goto join; }
    x = 7;
join:
    if (x != 5) { return 2; }

    let k int = 0;
    for k < 10 {
        k += 1;
        if (k == 3) { goto done; }
    }
done:
    if (k != 3) { return 3; }

    let n int = 0;
    {
        n = 1;
        goto final;
    }
    n = 99;
final:
    if (n != 1) { return 4; }

    printf("goto=ok\n");
    return 0;
}
