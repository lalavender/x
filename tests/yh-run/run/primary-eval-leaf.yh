// exit: 0
// 字面量 / 名字 / sizeof 层统一 eval 入口（S4-4 第五片）：数字（十进制/十六进制/
// 宽字面量）、字符、字符串、const 名字、`sizeof`（类型引用形态与表达式形态）、
// 聚合字面量字段兼容（`sem_eval_struct_field`）。
const K int = 3
const NAME *char = "leaf"

struct Box {
    v int
    w int
}

fn main() int {
    // 数字字面量
    let a int = 1234
    let h int = 0x1F
    let w u64 = 4294967296
    if (a != 1234) { return 1 }
    if (h != 31) { return 2 }
    if (w != 4294967296) { return 3 }
    // 字符字面量
    let c char = 'Z'
    if (c.to_type(int) != 90) { return 4 }
    // 字符串字面量（类型退化为 *char）与 const 名字
    let s *char = "leaf"
    if (strlen(s) != 4) { return 5 }
    if (s[2] != 'a') { return 6 }
    if (K != 3) { return 7 }
    if (NAME[0] != 'l') { return 8 }
    // sizeof：类型引用形态 / 表达式形态（聚合按两字段对齐）
    if (sizeof(u8) != 1) { return 9 }
    let b1 Box = Box{v: 1, w: 2}
    if (sizeof(Box) != sizeof(b1)) { return 10 }
    if (sizeof(b1) != sizeof(int) * 2) { return 11 }
    // 聚合字面量字段兼容（含窄化字面量）
    let n u8 = 200
    let b2 Box = Box{v: 5, w: 6}
    if (b2.v != 5) { return 12 }
    if (b2.w != 6) { return 13 }
    if (n != 200) { return 14 }
    return 0
}
