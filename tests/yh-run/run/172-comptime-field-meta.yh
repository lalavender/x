// expect: names=a,b,c,
// exit: 0
// run/172：`$for f in T.fields` 字段元信息（CT6 P1b）。
// 按字段声明顺序展开；绑定携带字段下标、字段类型（可直接用类型谓词分派）
// 与宿主类型（.name 投影字段名字符串常量）。typed 正文逐字段块执行，
// 普通路径逐轮解析发码（与 `$for E.values` 同构）。

pub struct Mixed {
    a int;
    b f64;
    c int;
}

@[comptime]
fn count_int_fields() int {
    let n int = 0;
    $for f in Mixed.fields {
        $if ($is_int(f)) { n += 1; }
    }
    return n;
}

@[comptime]
fn count_float_fields() int {
    let n int = 0;
    $for f in Mixed.fields {
        $if ($is_float(f)) { n += 1; }
    }
    return n;
}

@[comptime]
fn count_struct_fields() int {
    // 声明顺序遍历：字段总数与逐字段类型分派组合。
    let n int = 0;
    $for f in Mixed.fields {
        $if ($is_type(f, f64)) { n += 10; } $else { n += 1; }
    }
    return n;
}

@[comptime]
fn count_fields() int {
    let n int = 0;
    $for f in Mixed.fields { n += 1; }
    return n;
}

const INT_N int = $count_int_fields();
const FLOAT_N int = $count_float_fields();
const MIX_N int = $count_struct_fields();
const ALL_N int = $count_fields();

fn main() int {
    printf("names=");
    $for f in Mixed.fields {
        printf("%s,", f.name);
    }
    printf("\n");
    // INT_N=2 FLOAT_N=1 MIX_N=12（1 + 10 + 1）ALL_N=3
    return INT_N - 2 + FLOAT_N - 1 + MIX_N - 12 + ALL_N - 3;
}