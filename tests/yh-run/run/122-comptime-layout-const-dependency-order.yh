// expect: layout-dependency-order=5
// exit: 0
// typed 布局常量按依赖顺序求值，即使依赖项在源码中较晚声明。

@[comptime]
fn increment_layout_value(value int) int {
    return value + 1
}

@[comptime]
fn count_layout_values(limit int) int {
    let index int = 0
    let total int = 0
    for index < limit {
        total += 1
        index += 1
    }
    return total
}

const FIRST_LAYOUT_COUNT int = $increment_layout_value(SECOND_LAYOUT_COUNT)
const SECOND_LAYOUT_COUNT int = $increment_layout_value(THIRD_LAYOUT_COUNT)
const THIRD_LAYOUT_COUNT int = $count_layout_values(3)

pub struct OrderedLayoutPacket {
    values [FIRST_LAYOUT_COUNT]int
}

fn main() int {
    let packet OrderedLayoutPacket
    if (len(packet.values) == 5 && sizeof(OrderedLayoutPacket) == 20) {
        printf("layout-dependency-order=%d\n", len(packet.values))
        return 0
    }
    return 1
}
