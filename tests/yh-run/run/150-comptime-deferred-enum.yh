// expect: a=3 b=4 c=20 d=21 v=21
// exit: 0
// 枚举判别值里的编译期调用：pass1 只登记成员符号（值待定），pass2 捕获正文后由
// 调度阶段重解析表达式回填；隐式成员取前一成员值 + 1，混合显式/隐式也按序回填。
// 折算：a=$two()+1=3，b=a+1=4，c=$two()*10=20，d=c+1=21。

// two：判别值依赖的编译期函数。
@[comptime]
fn two() int {
    return 2;
}

pub enum E {
    a = $two() + 1;
    b;
    c = $two() * 10;
    d;
}

const V int = E.d;

fn main() int {
    printf("a=%d b=%d c=%d d=%d v=%d\n", E.a, E.b, E.c, E.d, V);
    return 0;
}
