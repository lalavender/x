// expect: 1 2
// expect-more: 2 1
// expect-more: 3 6
// expect-more: 59
// 浮点字段聚合：命名字面量初始化、成员读写、聚合按值传参/返回。
// 回归背景：em_store_sized/em_load_sized 对 f64/f32 字段误用 x0（值在
// d0/s0），导致命名字面量字段写坏与成员读取错值（stage0 一直正确）。
pub struct V2 {
    x f64;
    y f64;
}

fn mirror(a V2) V2 {
    let r V2;
    r.x = a.y;
    r.y = a.x;
    return r;
}

fn scale(a V2, k f64) V2 {
    let r V2;
    r.x = a.x * k;
    r.y = a.y * k;
    return r;
}

fn show(v V2) void {
    printf("%d %d\n", v.x.to_type(int), v.y.to_type(int));
}

fn main() int {
    let a V2 = V2 { x: 1.0, y: 2.0 };
    show(a);
    show(mirror(a));
    show(scale(a, 3.0));
    let xi int = a.x.to_type(int) + mirror(a).x.to_type(int) * 2 + scale(a, 3.0).x.to_type(int) * 6;
    let yi int = a.y.to_type(int) + mirror(a).y.to_type(int) * 4 + scale(a, 3.0).y.to_type(int) * 5;
    printf("%d\n", xi + yi);
    return 0;
}
