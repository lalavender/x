// expect: comptime-array-length=18
// exit: 0
// 全局类型布局可使用已声明编译期函数的整数返回值作为数组长度。

@[comptime]
fn array_length() int {
    return 3;
}

pub struct LengthPacket {
    items [$array_length()]int;
}

let ITEMS [$array_length()]int = [2, 3, 4];

fn main() int {
    let local [$array_length()]int = [1, 2, 3];
    let result int = len(ITEMS) + len(local) + sizeof(LengthPacket);
    printf("comptime-array-length=%d\n", result);
    return 0;
}
