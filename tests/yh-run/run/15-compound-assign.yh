// expect: 7
// expect-more: 21
// expect-more: 14
// expect-more: 3
// expect-more: 1
// expect-more: 8
// expect-more: 27
// expect-more: 30
// expect-more: 120
// expect-more: 15
// 复合赋值运算符：算术 += -= *= /= %= 与位 &= |= ^= <<= >>=。
fn main() int {
    let x int = 5;
    x += 2;
    printf("%d\n", x);
    x *= 3;
    printf("%d\n", x);
    x -= 7;
    printf("%d\n", x);
    x /= 4;
    printf("%d\n", x);
    x %= 2;
    printf("%d\n", x);
    let b int = 12;
    b &= 10;
    printf("%d\n", b);
    b |= 19;
    printf("%d\n", b);
    b ^= 5;
    printf("%d\n", b);
    b <<= 2;
    printf("%d\n", b);
    b >>= 3;
    printf("%d\n", b);
    return 0;
}
