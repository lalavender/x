// expect: 6
// expect-more: 6
// expect-more: 20
// 调用 ABI 三条特殊路径的运行语义：数组实参按指针形参退化、类型化变参打包成
// 切片、yh 聚合形参按值传入。S4-4 的 eval 侧以 `sem_call_begin → sem_push_arg
// → sem_call` 本体重放这三条路径（方案 §4e 实施序第 2 步），本用例同时是
// 影子门（just front-shadow）在语料里的形状覆盖。
fn take_ptr(p *int) int {
    return *p
}

fn sum_pack(base int, rest ... int) int {
    let total int = base
    for value in rest {
        total += value
    }
    return total
}

struct Pair {
    left int;
    right int;
}

fn pair_sum(value Pair) int {
    return value.left + value.right
}

fn main() int {
    let arr [4]int = [1, 2, 3, 4]
    printf("%d\n", take_ptr(arr) + arr[1] + arr[2])
    printf("%d\n", sum_pack(0, 1, 2, 3))
    printf("%d\n", pair_sum(Pair{left: 9, right: 11}))
    return 0
}
