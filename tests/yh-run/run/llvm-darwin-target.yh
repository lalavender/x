// platform: darwin-arm64
// exit: 0
// Darwin/ARM64 目标契约：目标条件与 LP64 布局必须由输出目标决定。
fn main() int {
    $if (darwin) { } $else { $compile_error("期望 Darwin 目标"); }
    $if (arm64) { } $else { $compile_error("期望 ARM64 目标"); }
    $assert(sizeof(*void) == 8);
    $assert(sizeof(int) == 4);
    $assert(sizeof(i64) == 8);
    let value i64 = 0x100000000;
    let address *i64 = &value;
    if (address[0] != 4294967296) { return 1; }
    return 0;
}
