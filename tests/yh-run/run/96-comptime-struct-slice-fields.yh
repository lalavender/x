// expect: comptime-struct-slice-fields=448 global=32
// exit: 0
// 编译期结构体整数切片字段应保留共享视图，并安全跨越函数返回边界。

pub struct SliceHolder {
    items []int
    tag int
}

// make_holder：从局部数组构造切片字段，返回后切片元素仍需有效。
@[comptime]
fn make_holder(seed int) SliceHolder {
    let values [3]int = [seed, seed + 1, seed + 2]
    return SliceHolder{ items: values[1..3], tag: 5 }
}

// mutate_holder：通过结构体形参写入切片，调用者应观察到共享存储变化。
@[comptime]
fn mutate_holder(holder SliceHolder) int {
    holder.items[0] += 10
    return len(holder.items) * 100 + holder.items[0]
}

// exercise_holder：检查结构体副本共享视图及嵌套返回帧的生命周期。
@[comptime]
fn exercise_holder() int {
    let holder SliceHolder = $make_holder(10)
    let copy SliceHolder = holder
    let observed int = $mutate_holder(copy)
    return observed + holder.items[0] * 10 + holder.items[1] + holder.tag
}

const RESULT int = $exercise_holder()
let GLOBAL SliceHolder = $make_holder(30)

fn main() int {
    printf("comptime-struct-slice-fields=%d global=%d\n", RESULT,
        GLOBAL.items[1])
    return 0
}
