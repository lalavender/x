// expect: global=ok
// exit: 0
// 全局常量物化、可变对象读写/取址、聚合副本与字符串逐字节语义锁。

// Mode：显式非零枚举值同时用于全局常量初始化与运行期比较。
enum Mode { off; go = 7; }

// Point：供导出聚合常量使用的结构体，字段按声明顺序布局。
pub struct Point { x int; y int; }

// Padded：整数与指针间有对齐填充；初始化后所有填充字节应为零。
pub struct Padded { tag u8; word i64; flag bool; ptr *int; }

// Box：嵌套结构体字面量，检验递归物化时的字段偏移。
struct Box { tag u8; point Point; tail i16; }

// Cell：零初始化联合体，写入宽成员后通过窄成员读低字节。
union Cell { word i64; byte u8; }

let zero_int int;
let zero_i8 i8;
let zero_u8 u8;
let zero_i16 i16;
let zero_u16 u16;
let zero_i32 i32;
let zero_u32 u32;
let zero_i64 i64;
let zero_u64 u64;
let zero_bool bool;
let zero_char char;
let zero_mode Mode;
let zero_ptr *int;
let zero_array [3]int;
let zero_point Point;
let zero_box Box;
let zero_cell Cell;

const ANSWER int = (3 + 4) * 6;
const YES bool = true;
const LETTER char = 'Z';
const MODE Mode = Mode.go;
const RAW_TRUTH bool = 2.to_type(bool);
let mutable_i32 i32 = ANSWER - 1;
let signed_byte i8 = 130.to_type(i8);
let unsigned_byte u8 = 250;
let signed_half i16 = 65535.to_type(i16);
let unsigned_half u16 = 60000;
let unsigned_word u32 = 0xfedcba98;
let signed_wide i64 = -4294967297.to_type(i64);
let unsigned_wide u64 = 0xfedcba9876543210;
let truth bool = true;
let raw_truth bool = 2.to_type(bool);
let letter char = 'Q';
let mode Mode = Mode.go;
let null_ptr *int = 0;
let values [3]i16 = [-2, 3, 260];
let nulls [2]*int = [0, 0];
let padded Padded = Padded{ tag: 5, word: -9, flag: true, ptr: 0 };
let nested Box = Box{ tag: 2, point: Point{ x: 11, y: 13 }, tail: -4 };
pub const PUBLIC_TABLE [3]int = [7, 8, 9];
const PRIVATE_TABLE [2]int = [17, 19];
pub const PUBLIC_POINT Point = Point{ x: 23, y: 29 };
const PRIVATE_POINT Point = Point{ x: 31, y: 37 };
const WRITABLE_CONST [2]int = [41, 43];
const TEXT *char = "alias";
const ALIAS *char = TEXT;
const CHAIN *char = ALIAS;

// global_value：给 C 驱动观察全局标量初值与后续共享写入。
pub fn global_value() i32 { return mutable_i32; }

// global_address：对象地址跨调用稳定，并与全局读写共享存储。
pub fn global_address() *i32 { return &mutable_i32; }

// global_padded：C 驱动通过对象地址检查填充字节，不要求指针重解释转换。
pub fn global_padded() *Padded { return &padded; }

// global_const_bool：bool 是保留低字节的值，返回 2 不得被错误归一为 1。
pub fn global_const_bool() bool { return RAW_TRUTH; }

// global_const_address：const 限制直接左值，取出的普通指针仍可写后备对象。
pub fn global_const_address() *int { return &WRITABLE_CONST[0]; }

// global_positive_wide：默认整数文字在显式 i64 转换之前不能先截去高 32 位。
pub fn global_positive_wide() i64 { return 4294967297.to_type(i64); }

// global_string：含全部既有转义、嵌入 NUL 与十六进制转义，末尾自动补 NUL。
pub fn global_string() *char { return "A\n\r\t\a\b\f\v\'\"\\\x42\0C"; }

// global_empty_string：空字符串仍占一个终止 NUL 字节。
pub fn global_empty_string() *char { return ""; }

// global_utf8_string：非 ASCII token 必须按原始 UTF-8 字节保留。
pub fn global_utf8_string() *char { return "雪"; }

// global_writable_string：旧语义允许经 *char 写字符串，多次调用共享同一后备对象。
pub fn global_writable_string() *char { return "writable"; }

// global_string_alias：两级 const 别名保留原始字符串地址，不把标签号当整数。
pub fn global_string_alias() *char { return CHAIN; }

// global_case：逐项检查全局类型、布局、读写、独立聚合副本与字符串。
pub fn global_case() int {
    if (zero_int != 0 || zero_i8 != 0 || zero_u8 != 0 || zero_i16 != 0
        || zero_u16 != 0 || zero_i32 != 0 || zero_u32 != 0 || zero_i64 != 0
        || zero_u64 != 0 || zero_bool || zero_char != 0 || zero_mode != 0
        || zero_ptr != 0) { return 1; }
    if (zero_array[0] != 0 || zero_array[2] != 0 || zero_point.x != 0
        || zero_point.y != 0 || zero_box.tag != 0 || zero_box.point.y != 0
        || zero_box.tail != 0 || zero_cell.word != 0) { return 2; }
    if (mutable_i32 != 41 || signed_byte != -126 || unsigned_byte != 250
        || signed_half != -1 || unsigned_half != 60000
        || unsigned_word != 0xfedcba98 || signed_wide != -4294967297.to_type(i64)
        || unsigned_wide != 0xfedcba9876543210) { return 3; }
    if (!truth || letter != 'Q' || mode != Mode.go || null_ptr != 0
        || !YES || LETTER != 'Z' || MODE != 7 || ANSWER != 42) { return 4; }
    if (raw_truth.to_type(int) != 2 || global_const_bool().to_type(int) != 2) { return 18; }
    if (255.to_type(i8).to_type(int) != -1 || 256.to_type(u8).to_type(int) != 0
        || (255.to_type(i8)).to_type(i16).to_type(int) != -1
        || ((256.to_type(u8))).to_type(int) != 0) { return 21; }
    let positive_wide i64 = 1.to_type(i64) << 32;
    positive_wide += 1;
    if (global_positive_wide() != positive_wide) { return 22; }
    if (len(values) != 3 || values[0] != -2 || values[1] != 3 || values[2] != 260
        || nulls[0] != 0 || nulls[1] != 0) { return 5; }
    if (padded.tag != 5 || padded.word != -9 || !padded.flag || padded.ptr != 0
        || nested.tag != 2 || nested.point.x != 11 || nested.point.y != 13
        || nested.tail != -4) { return 6; }
    let same_padded bool = global_padded() == &padded;
    let present_padded bool = global_padded() != 0;
    if (same_padded == false || present_padded == false) { return 23; }
    let scalar *i32 = &mutable_i32;
    *scalar += 5;
    mutable_i32 += 6;
    if (global_value() != 52 || *scalar != 52) { return 9; }
    let element *i16 = &values[1];
    *element = 20;
    values[0] = 8;
    nested.point.x += 4;
    let field *int = &nested.point.y;
    *field = 21;
    zero_cell.word = 258;
    if (values[0] != 8 || values[1] != 20 || values[2] != 260
        || nested.point.x != 15 || nested.point.y != 21 || zero_cell.byte != 2) { return 10; }
    // 指针对象、指针字段和指针数组元素的运行期写入不需要静态重定位。
    null_ptr = &zero_int;
    nulls[0] = &zero_int;
    padded.ptr = &zero_int;
    *null_ptr = 12;
    *nulls[0] += 3;
    *padded.ptr += 4;
    if (zero_int != 19 || *null_ptr != 19 || *nulls[0] != 19) { return 17; }
    let copy [3]i16 = values;
    copy[0] = 99;
    let box Box = nested;
    box.point.x = 88;
    if (values[0] != 8 || copy[0] != 99 || nested.point.x != 15
        || box.point.x != 88 || box.point.y != 21) { return 11; }
    zero_array = PUBLIC_TABLE;
    zero_array[0] = 70;
    zero_point = PRIVATE_POINT;
    zero_point.y = 99;
    let pub_copy Point = PUBLIC_POINT;
    pub_copy.x = 100;
    let private_copy [2]int = PRIVATE_TABLE;
    private_copy[1] = 200;
    let const_element *int = &PUBLIC_TABLE[1];
    if (PUBLIC_TABLE[0] != 7 || *const_element != 8 || PUBLIC_TABLE[2] != 9
        || zero_array[0] != 70 || zero_array[2] != 9 || PRIVATE_POINT.y != 37
        || zero_point.x != 31 || zero_point.y != 99 || PUBLIC_POINT.x != 23
        || PUBLIC_POINT.y != 29 || pub_copy.x != 100 || PRIVATE_TABLE[1] != 19
        || private_copy[1] != 200) { return 12; }
    let view []i16 = values[1..3];
    view[1] = 300;
    if (len(view) != 2 || values[2] != 300) { return 13; }
    let text *char = global_string();
    if (text[0] != 65 || text[1] != 10 || text[2] != 13 || text[3] != 9
        || text[4] != 7 || text[5] != 8 || text[6] != 12 || text[7] != 11
        || text[8] != 39 || text[9] != 34 || text[10] != 92 || text[11] != 66
        || text[12] != 0 || text[13] != 67 || text[14] != 0) { return 14; }
    // 同一循环正文会经历 lowering 的多趟扫描，同一标签只能登记一次。
    let i int = 0;
    for i < 3 {
        let repeated *char = "loop";
        if (repeated[0] != 108 || repeated[4] != 0) { return 15; }
        i += 1;
    }
    if (global_empty_string()[0] != 0 || global_string() != text) { return 16; }
    let writable *char = global_writable_string();
    writable[0] = 'W';
    if (global_writable_string() != writable || global_writable_string()[0] != 'W') { return 19; }
    let writable_const *int = global_const_address();
    *writable_const = 47;
    if (*global_const_address() != 47) { return 20; }
    let alias *char = global_string_alias();
    if (alias[0] != 97 || alias[4] != 115 || alias[5] != 0) { return 24; }
    if (alias != TEXT || alias != ALIAS || alias != CHAIN) { return 25; }
    alias[0] = 'A';
    if (TEXT[0] != 'A' || ALIAS[0] != 'A' || global_string_alias()[0] != 'A') { return 26; }
    return 0;
}

// main：旧后端与 LLVM 专项门共享 global_case 的手工期望值。
fn main() int {
    let result int = global_case();
    if (result != 0) { return result; }
    printf("global=ok\n");
    return 0;
}
