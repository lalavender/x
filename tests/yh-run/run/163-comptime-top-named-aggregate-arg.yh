// exit: 0
// run/163：顶层编译期调用直接把**命名全局聚合常量**当实参（数组/结构体/混排），
// 与字面量聚合实参走同一条 ct_call 协议；标量实参与聚合实参可混排。
pub struct Point {
    x int
    y int
}

const TABLE [3]int = [1, 2, 3]
const P Point = Point{ x: 4, y: 5 }

// sum3：数组聚合形参。
@[comptime]
fn sum3(t [3]int) int {
    let s int = 0
    for v in t { s += v }
    return s
}

// weigh：结构体聚合形参。
@[comptime]
fn weigh(p Point) int {
    return p.x * 10 + p.y
}

// mix：标量与两种聚合形参混排，并在正文里继续把形参转给别的编译期函数。
@[comptime]
fn mix(k int, t [3]int, p Point) int {
    return k + $sum3(t) + $weigh(p)
}

// A = 1 + 2 + 3 = 6
const A int = $sum3(TABLE)
// B = 4 * 10 + 5 = 45
const B int = $weigh(P)
// C = 2 + 6 + 45 = 53
const C int = $mix(2, TABLE, P)

fn main() int {
    return A - 6 + B - 45 + C - 53
}
