// exit: 0
// run/168：编译期表达式选择 `$if (cond) e1 $else e2`（CT6 P0，普通路径）。
// cond 必须是编译期常量：选中分支正常发码，未选分支静默发射但保留完整
// 语义检查（合流需要两侧类型）。覆盖 let 初始化/实参/return 位置、
// 嵌套（$else 就近匹配）、两分支同型变量与顶层 const 折叠。
// 注：`$if` 表达式位于表达式链最上层，作二元操作数需加括号
// （如 `v + ($if ...)`），与设计稿 g4 一致。

const A int = $if (1 < 2) 3 $else 4;
const B int = $if (2 > 3) 5 $else 6;

fn add10(v int) int {
    // return/实参位置（括号内）+ 实参位置：20
    return v + ($if (2 > 1) 10 $else 20);
}

fn main() int {
    // let 初始化：条件真取 then、假取 else
    let a int = $if (1 < 2) 30 $else 40;
    let b int = $if (1 > 2) 50 $else 60;
    // 嵌套：$else 就近匹配 → 70
    let c int = $if (1 < 2) $if (3 < 4) 70 $else 80 $else 90;
    // 结果作为 i64 目标（值保持）
    let d i64 = $if (0 > 1) 1 $else 2;
    // 两分支都是普通变量（类型相等）
    let e int = 7;
    let f int = $if (1 < 2) e $else 3;
    // 未选分支也做语义检查：名字可解析、类型合流通过
    let g int = $if (9 > 8) e $else e;
    return a - 30 + b - 60 + c - 70 + d.to_type(int) - 2 + f - 7 + g - 7 +
        add10(5) - 15 + A - 3 + B - 6;
}