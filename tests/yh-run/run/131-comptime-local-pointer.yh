// expect: comptime-local-pointer=77
// exit: 0
// 编译期局部指针只别名当前帧整数槽，间接写入必须更新原局部值。

const RESULT int = $mutate_local()

@[comptime]
fn mutate_local() int {
    let value int = 3
    let ptr *int = &value
    *ptr += 4
    return value * 10 + *ptr
}

fn main() int {
    printf("comptime-local-pointer=%d\n", RESULT)
    return 0
}
