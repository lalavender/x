// expect: 3 16 3 8
// const 长度数组在全局/结构体字段/形参/返回位置都要能定长（回归）：
// 这些位置的类型在布局子遍解析，而普通 const 的值原本只在全局子遍才就绪，
// 曾一律误报「编译期常量尚未就绪」；局部变量位置一直可用（对照）。
const N int = 3

type Row = [N]int

struct Packet {
    items [N]int
    tag int
}

fn make_row() [N]int {
    let v [N]int = [1, 2, 3]
    return v
}

fn sum_row(r [N]int) int {
    return r[0] + r[1] + r[2]
}

fn main() int {
    let g [N]int = make_row()
    let p Packet
    p.tag = 4
    p.items[0] = 5
    let r Row = g
    // sum_row 让形参位置的 [N]int 真正参与编译与运行（未被引用的私有函数
    // 现在是编译错误，UF1）；g = [1,2,3] 时它返回 6，期望输出保持不变。
    let total int = sum_row(g) - 6
    printf("%d %d %d %d\n", len(g), sizeof(Packet), len(r),
        p.tag + p.items[0] - 1 + total)
    return 0
}
