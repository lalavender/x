// expect: types=ok
// 类型引用语法专项：指针、定长数组、切片、函数类型、嵌套函数类型、
// `@[extern] fn` 类型与 sizeof(类型)/sizeof(表达式) 判定。
// 覆盖 parse 只产 AstType、check.type_resolve 建类型表的完整链路。
struct Pair {
    a int;
    b int;
}

fn inc(x int) int {
    return x + 1;
}

fn twice(f fn(int) int, x int) int {
    return f(f(x));
}

fn main() int {
    let p Pair
    p.a = 40
    p.b = 2
    let ptr *Pair = &p
    let arr [2]int = [10, 20]
    let sl []int = [1, 2, 3]
    let f fn(int) int = inc
    let nested fn(fn(int) int, int) int = twice
    let cfn @[extern] fn(*char) int
    if (ptr.a + ptr.b + arr[0] + arr[1] + sl[0] + f(0) != 74) {
        return 1
    }
    if (nested(f, 40) != 42) {
        return 2
    }
    if (cfn.to_type(*void) != 0) {
        return 3
    }
    if (sizeof(*Pair) != sizeof(*void) || sizeof([2]int) != sizeof(int) * 2) {
        return 4
    }
    if (sizeof(ptr) != sizeof(*void) || sizeof(*ptr) != sizeof(Pair)
        || sizeof(f) != sizeof(*void)) {
        return 6
    }
    let n int = 7
    if (sizeof(n) != sizeof(int) || sizeof(Pair) != sizeof(int) * 2) {
        return 5
    }
    printf("types=ok\n")
    return 0
}
