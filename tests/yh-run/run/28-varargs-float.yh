// expect: t=6
// expect-more: z=0
// expect-more: one=42
// expect-more: n=1
// expect-more: h=25
// expect-more: acc=10 half=5
// 类型化变参与浮点（0.0.2 B2-2）：末尾唯一类型化变参打包为切片、
// 零变参、f64 参数/返回（v0）、f32/f64 混合提升、浮点累加。
fn total(vals ...int) int {
    let t int = 0
    for x in vals {
        t += x
    }
    return t
}

fn show(fmt *char, vals ...int) int {
    if (len(vals) > 0) {
        printf(fmt, vals[0])
    }
    return len(vals)
}

fn hyp(a f64, b f64) f64 {
    return a * a + b * b
}

fn main() int {
    printf("t=%d\n", total(1, 2, 3))
    printf("z=%d\n", total())
    let n int = show("one=%d\n", 42)
    printf("n=%d\n", n)
    printf("h=%d\n", hyp(3.0, 4.0).to_type(int))
    let d f64 = 2.5
    let acc f64 = 0.0
    let i int = 0
    for i < 4 {
        acc += d
        i += 1
    }
    printf("acc=%d half=%d\n", acc.to_type(int),
           (acc / 2.0).to_type(int))
    return 0
}
