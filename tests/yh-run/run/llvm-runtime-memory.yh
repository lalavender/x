// expect: runtime-memory=ok
// LL8a 自有内存运行时语义锁：memcpy 返回指针/内容/越界保护与 strlen 边界。
// 尺寸矩阵 0、1、7、8、16、31、32、4096 与 LL8a LLVM helper 门使用同一组契约；
// 本用例经旧后端运行，锁定「逐字节、未知对齐、非重叠复制」的语义基线。
fn main() int {
    let src [4096]u8;
    let dst [4096]u8;
    let sizes [8]int;
    sizes[0] = 0;
    sizes[1] = 1;
    sizes[2] = 7;
    sizes[3] = 8;
    sizes[4] = 16;
    sizes[5] = 31;
    sizes[6] = 32;
    sizes[7] = 4096;

    let i int = 0;
    for i < 8 {
        let n int = sizes[i];
        let k int = 0;
        for k < 4096 {
            src[k] = ((k * 31 + 7) & 255).to_type(u8);
            dst[k] = 170;
            k += 1;
        }
        let got *void = memcpy(dst, src, n.to_type(u64));
        if (got != (&dst[0]).to_type(*void)) { return 1; }
        k = 0;
        for k < n {
            if (dst[k] != src[k]) { return 2; }
            k += 1;
        }
        if (n < 4096 && dst[n] != 170) { return 3; }
        i += 1;
    }

    if (strlen("") != 0) { return 4; }
    if (strlen("a") != 1) { return 5; }
    if (strlen("1234567") != 7) { return 6; }
    if (strlen("12345678") != 8) { return 7; }
    if (strlen("123456789012345") != 15) { return 8; }
    if (strlen("1234567890123456") != 16) { return 9; }
    if (strlen("12345678901234567890123456789012") != 32) { return 10; }
    if (strlen("雪") != 3) { return 11; }
    let text [33]char;
    let j int = 0;
    for j < 32 { text[j] = 'q'; j += 1; }
    text[32] = 0;
    if (strlen(text) != 32) { return 12; }

    printf("runtime-memory=ok\n");
    return 0;
}
