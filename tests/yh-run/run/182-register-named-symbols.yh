// expect: 5 1 7 3
// 用户符号与 AArch64 寄存器同名时，发射的汇编名必须避让：clang 的集成汇编器
// 直接拒绝 `bl w12`（GNU as 容忍但不可移植），因此编译器给「最终汇编名恰好是
// 寄存器名」的符号追加 __yhreg 后缀——函数（.text）、全局变量（.data/.bss）
// 与所有引用位置共用同一判据。运行结果本身看不出这个缺陷。
let lr int = 3

fn w12(a int) int {
    return a + 1
}

fn x0(a int) int {
    return a - 1
}

fn d8(a int) int {
    return a + 7
}

fn main() int {
    printf("%d %d %d %d\n", w12(4), x0(2), d8(0), lr)
    return 0
}
