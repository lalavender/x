// exit: 18
// 函数内嵌套类型声明：struct/enum/type 与顶层登记一致，
// 类型表全局可见；配合结构体字面量与枚举常量。
enum Color { red; green; blue; }

fn main() int {
    struct Inner { v int; }
    struct Outer { i Inner; tag int; }
    enum Op { add; sub = 5; mul; }
    let o Outer = Outer { i: Inner { v: 8 }, tag: blue };
    let m int = mul;
    if (o.i.v != 8) { return 1; }
    if (o.tag != 2) { return 2; }
    if (m != 6) { return 3; }
    type MyInt = int;
    let x MyInt = 4;
    if (x != 4) { return 4; }
    return 18;
}
