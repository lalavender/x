// expect: llvm-calls=ok
// exit: 0
// 合流块可以先分配、后写指令；调用表顺序由指令数组定义，不能按块编号推断。
let history int = 0

// record：用全局状态留下真实副作用顺序，不能由纯常量调用替代。
fn record(value int) int {
    history = history * 10 + value
    return value
}

// sequence：if 合流块早于内部短路块分配，合流之后的调用仍在最后发生。
fn sequence(enabled bool) int {
    let result int = 0
    if (enabled) {
        result = (record(1) > 0 && record(2) > 0).to_type(int)
    }
    record(3)
    return result
}

// scoped：只在 if 内声明的局部值不出现在合流后，不能给不存在的另一臂值建 phi。
fn scoped(enabled bool) int {
    let total int = 7
    if (enabled) {
        let local int = record(4)
        total += local
    }
    record(5)
    return total
}

// main：分别覆盖走入/绕过 if，并验证块内局部和外层变量的合流。
fn main() int {
    if (sequence(true) != 1 || history != 123) { return 1 }
    history = 0
    if (sequence(false) != 0 || history != 3) { return 2 }
    history = 0
    if (scoped(true) != 11 || history != 45) { return 3 }
    history = 0
    if (scoped(false) != 7 || history != 5) { return 4 }
    printf("llvm-calls=ok\n")
    return 0
}
