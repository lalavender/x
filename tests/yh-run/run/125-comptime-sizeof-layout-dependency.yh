// expect: sizeof-layout-dependency=3
// exit: 0
// 先完成 Inner 布局，再执行查询其 sizeof 的 typed CT 函数并完成 Outer。

@[comptime]
fn inner_layout_count() int {
    let index int = 0
    let total int = 0
    for index < 3 {
        total += 1
        index += 1
    }
    return total
}

const INNER_LAYOUT_COUNT int = $inner_layout_count()

pub struct InnerLayoutPacket {
    values [INNER_LAYOUT_COUNT]int
}

@[comptime]
fn inner_layout_size() int {
    return sizeof(InnerLayoutPacket)
}

@[comptime]
fn outer_layout_count() int {
    return $inner_layout_size() / 4
}

const OUTER_LAYOUT_COUNT int = $outer_layout_count()

pub struct OuterLayoutPacket {
    values [OUTER_LAYOUT_COUNT]int
}

fn main() int {
    let inner InnerLayoutPacket
    let outer OuterLayoutPacket
    if (len(inner.values) == 3 && len(outer.values) == 3
        && sizeof(OuterLayoutPacket) == 12) {
        printf("sizeof-layout-dependency=%d\n", len(outer.values))
        return 0
    }
    return 1
}
