// expect: selected-return-layout=4
// exit: 0
// 非穷尽 CT 函数的实际调用路径有返回值时，typed 执行器可以完成该常量请求。

@[comptime]
fn maybe_length(value int) int {
    if (value > 0) {
        return value
    }
}

const ITEM_COUNT int = $maybe_length(4)
let ITEMS [ITEM_COUNT]int

fn main() int {
    printf("selected-return-layout=%d\n", len(ITEMS))
    return 0
}
