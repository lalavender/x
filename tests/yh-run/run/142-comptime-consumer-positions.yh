// expect: consumer-positions=29
// exit: 0
// 编译期调用作为常量的各消费者位置：切片范围上界、类型别名长度、结构体字段长度、
// 函数返回数组长度、全局数组长度、结构体字面量字段值。
// 折算：s[1]=2 + p[0]=7 + q[1]=8 + h.a[1]=6 + h.b=2 + GLOBAL[3]=4 → 29。

@[comptime]
fn two() int {
    return 2
}

@[comptime]
fn four() int {
    return $two() * 2
}

type Pair = [$two()]int

pub struct Holder {
    a [$two()]int
    b int
}

let GLOBAL [$four()]int = [1, 2, 3, 4]

// make_pair：返回类型长度由编译期调用给出的别名给出。
fn make_pair() Pair {
    let v [2]int = [7, 8]
    return v
}

fn main() int {
    let arr [4]int = [1, 2, 3, 4]
    let s []int = arr[0..$two()]
    let p Pair = [7, 8]
    let q [2]int = make_pair()
    let h Holder = Holder{ a: [5, 6], b: $two() }
    printf("consumer-positions=%d\n", s[1] + p[0] + q[1] + h.a[1] + h.b + GLOBAL[3])
    return 0
}
