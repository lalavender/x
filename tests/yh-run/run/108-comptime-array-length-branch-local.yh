// expect: branch-local-layout=3
// exit: 0
// typed 布局求值按实参执行分支，并允许分支内局部变量参与返回值。

@[comptime]
fn array_length() int {
    if (true) {
        let value int = 3
        return value
    }
    return 4
}

const ITEM_COUNT int = $array_length()
let ITEMS [ITEM_COUNT]int

fn main() int {
    printf("branch-local-layout=%d\n", len(ITEMS))
    return 0
}
