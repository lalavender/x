// exit: 0
// run/162：编译期正文里下标读全局 const 数组（原 fail/151 的诊断已随
// 「全局聚合常量在编译期有值」交付而消失，按惯例升级为运行用例）。
// 说明：此前全局 const 聚合的 cval 是数据段标签，不是 CtAggregate 对象指针。
pub const TABLE [3]int = [7, 8, 9];

// head：正文里下标读全局 const 数组。
@[comptime]
fn head() int {
    return TABLE[0];
}

// tail：正文里下标读末位元素并与首元素相减。
@[comptime]
fn tail() int {
    return TABLE[2] - TABLE[1];
}

const R int = $head();
const D int = $tail();

fn main() int {
    // R = 7、D = 9 - 8 = 1；运行期再读一次首元素确认数据段未被改动。
    return R - 7 + D - 1 + TABLE[0] - 7;
}
