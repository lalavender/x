// expect: comptime-slice-returns=1197
// exit: 0
// 编译期函数返回切片时复制其元素到调用方帧，调用方可安全读写。

// make_view：返回局部定长数组的一段视图，验证返回值不引用已释放帧。
@[comptime]
fn make_view(seed int) []int {
    let values [3]int = [seed, seed + 1, seed + 2]
    return values[1..3]
}

// mutate_view：通过切片形参写入调用方收到的返回视图并读取内容。
@[comptime]
fn mutate_view(view []int) int {
    view[0] = 99
    return len(view) * 100 + view[0] * 10 + view[1]
}

// use_view：在后续分配和嵌套调用后读取返回视图，验证其已由调用方拥有。
@[comptime]
fn use_view(seed int) int {
    let view []int = $make_view(seed)
    let later [2]int = [800, 900]
    return $mutate_view(view) + later[0] - 800
}

const RESULT int = $use_view(5)

fn main() int {
    printf("comptime-slice-returns=%d\n", RESULT)
    return 0
}
