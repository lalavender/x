// expect: even=12 empty=0 nested=20 limit=523776
// exit: 0
// 编译期函数中的 `$for` 读取本次调用边界，并允许循环体嵌套 typed `$if`。
// sum_even：对给定半开区间求偶数和，并用局部值作为下界。
@[comptime]
fn sum_even(start int, end int) int {
    let lower int = start
    let total int = 0
    $for index in (lower..end) {
        $if (index % 2 == 0) {
            total += index
        }
        $if (index < 0) {
            $compile_error("未执行的循环分支不能报错")
        }
    }
    return total
}

// sum_triangle：用内外两层编译期区间循环验证嵌套绑定和边界读取。
@[comptime]
fn sum_triangle(limit int) int {
    let total int = 0
    $for row in (0..limit) {
        $for column in (row..limit) {
            total += column
        }
    }
    return total
}

// sum_all：累加从零开始的区间，用于验证 1024 次迭代上限的合法边界。
@[comptime]
fn sum_all(end int) int {
    let total int = 0
    $for index in (0..end) {
        total += index
    }
    return total
}

const EVEN int = $sum_even(2, 7)
const EMPTY int = $sum_even(4, 4)
const NESTED int = $sum_triangle(4)
const LIMIT int = $sum_all(1024)

// main：打印编译期计算的区间和、空范围、嵌套和与上限结果。
fn main() int {
    printf("even=%d empty=%d nested=%d limit=%d\n", EVEN, EMPTY, NESTED, LIMIT)
    return 0
}
