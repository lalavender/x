// exit: 0
// run/169：编译期表达式选择在 @[comptime] 函数正文（typed IR 执行，CT6 P0）。
// typed 路径的 cond 可用参数/局部值（不要求常量），执行器按编译期值选支；
// 两分支都捕获 AST 并接受语义检查；顶层 const 调用消费结果。

@[comptime]
fn ct_pick(c int) int {
    let x int = $if (c != 0) 10 $else 20;
    return x;
}

@[comptime]
fn ct_mix(a int) i64 {
    // 两分支类型不同：int 字面量可向 i64 提升（is_lit 路径合流）
    return $if (a > 100) 1000 $else 7;
}

@[comptime]
fn ct_nested(a int) int {
    // 嵌套：$else 就近匹配；cond 用参数
    return $if (a > 10) $if (a > 20) 1 $else 2 $else 3;
}

@[comptime]
fn ct_unselected_checked(b int, c int) int {
    // 未选分支仍做语义检查：两分支都是形参引用、类型相等
    return $if (b > c) b $else c;
}

const R int = $ct_pick(0) + $ct_pick(3);
const M i64 = $ct_mix(7);
const M2 i64 = $ct_mix(200);
const N int = $ct_nested(5) + $ct_nested(15) + $ct_nested(25);
const U int = $ct_unselected_checked(3, 9);

fn main() int {
    // R=20+10=30，M=7，M2=1000，N=3+2+1=6，U=9
    return R - 30 + M.to_type(int) - 7 + M2.to_type(int) - 1000 + N - 6 + U - 9;
}