// expect: float-const-fold=711
// exit: 0
// 前端浮点常量折叠：算术、比较、显式转换、f32 窄化与一元负号都能在常量声明里求值。

const BASE f64 = 1.5 + 2.25
const SCALED f64 = BASE * 2.0 - 0.5
const WHOLE int = SCALED.to_type(int)
const THIRD f64 = 1.0 / 3.0
const SINGLE f32 = THIRD.to_type(f32)
const PROMOTED f64 = SINGLE.to_type(f64)
const NARROWED bool = PROMOTED != THIRD && PROMOTED > 0.3333 && PROMOTED < 0.3334
const NEGATED f64 = -BASE
const SIGN bool = NEGATED < 0.0

fn main() int {
    let parts int = WHOLE * 100 + (NARROWED ? 10 : 0) + (SIGN ? 1 : 0) +
        NEGATED.to_type(int) + 3
    printf("float-const-fold=%d\n", parts)
    return 0
}
