// expect: comptime-struct-array-fields=102
// exit: 0
// 编译期结构体内的定长整型数组应支持初始化、复制和下标读写。

pub struct Table {
    values [2]int;
}

@[comptime]
fn update_table() int {
    let values [2]int = [4, 9];
    let values_copy [2]int = values;
    values[1] = 100;
    let original Table = Table{ values: values_copy };
    values_copy[1] = 99;
    let duplicate Table = original;
    duplicate.values[1] = 12;
    return original.values[1] * 10 + duplicate.values[1];
}

const RESULT int = $update_table();

fn main() int {
    printf("comptime-struct-array-fields=%d\n", RESULT);
    return 0;
}
