// exit: 6
// sizeof(expr)：对表达式只求型不求值，返回其类型大小。
// 两侧此前均只支持 sizeof(T)。
pub struct P { x int; y int; }

let garr [4]int;

fn main() int {
    let x int = 1;
    let a [3]int;
    let p *int = &x;
    let s []int = a.to_type([]int);
    if (sizeof(x) != 4) { return 1; }
    if (sizeof(a) != 12) { return 2; }
    if (sizeof(garr) != 16) { return 3; }
    if (sizeof(*p) != 4) { return 4; }
    if (sizeof(s) != 16) { return 5; }
    if (sizeof(P) != 8 || sizeof(x + 1) != 4) { return 7; }
    return 6;
}
