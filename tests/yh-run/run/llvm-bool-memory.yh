// expect: llvm-bool=ok
// exit: 0
// bool 使用无符号字节值；显式转换保留低 8 位，条件按非零取真。
const TWO bool = 2.to_type(bool);

// identity：SSA 参数与返回值不能将 2、254、255 错误截为一位。
fn identity(value bool) bool { return value; }

// constant_value：简化器传播 bool 常量时保留字节位型。
fn constant_value() bool { return TWO; }

// select_value：赋值产生的 phi 仍表示原字节值，选择条件独立取真。
fn select_value(value bool, pick bool) bool {
    let result bool = false;
    if (pick) { result = value; } else { result = true; }
    return result;
}

// as_condition：条件消费者按非零为真，不改变源 bool 的字节值。
fn as_condition(value bool) int {
    if (value) { return 1; } else { return 0; }
}

// logic_and / logic_or：逻辑运算结果是规范 0/1，不能把原字节直接传入合流。
fn logic_and(left bool, right bool) bool { return left && right; }
fn logic_or(left bool, right bool) bool { return left || right; }

// as_integer / invert：显式转换保留字节，逻辑非按源级 int 返回规范 0/1。
fn as_integer(value bool) int { return value.to_type(int); }
fn invert(value bool) int { return !value; }

// main：单文件和项目 SSA 入口共同验收转换、参数、常量、phi、条件与字节存储。
fn main() int {
    let value bool = 2.to_type(bool);
    if (identity(value) != TWO || constant_value() != TWO) { return 1; }
    if (select_value(value, true) != TWO || as_condition(value) != 1) { return 2; }
    if (identity((-2).to_type(bool)).to_type(int) != 254
        || identity(255.to_type(bool)).to_type(int) != 255) { return 3; }
    if (logic_and(true, value) != true || logic_or(false, value) != true) { return 4; }
    if (logic_and(false, value) != false || logic_or(value, false) != true) { return 5; }
    if (as_integer(value) != 2 || invert(value) != 0 || invert(false) != 1) { return 8; }
    let values [3]bool = [false, true, TWO];
    if (sizeof(bool) != 1 || values[0].to_type(int) != 0
        || values[1].to_type(int) != 1 || values[2].to_type(int) != 2) { return 6; }
    let bytes *u8 = (&values[0]).to_type(*u8);
    if (bytes[0] != 0 || bytes[1] != 1 || bytes[2] != 2) { return 7; }
    printf("llvm-bool=ok\n");
    return 0;
}
