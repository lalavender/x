// exit: 0
// 全局初始化在函数体语义遍历前调用编译期函数；函数体使用局部绑定、赋值和条件循环。
const SUM int = $sum_to(6)

@[comptime]
fn sum_to(limit int) int {
    let index int = 0
    let total int = 0
    for index < limit {
        total += index
        index += 1
    }
    return total
}

fn main() int {
    return SUM == 15 ? 0 : 1
}
