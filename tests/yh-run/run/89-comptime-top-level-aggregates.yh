// expect: comptime-top-level-aggregates=108
// exit: 0
// 顶层编译期结果可物化为静态数据，并按聚合地址语义使用。

pub struct TopPacket {
    head int;
    values [2]int;
}

// make_packet：返回含嵌套数组字段的结构体供运行期代码接收。
@[comptime]
fn make_packet(seed int) TopPacket {
    return TopPacket{ head: seed, values: [seed + 1, seed + 2] };
}

// make_values：返回定长数组供局部初始化与外层编译期实参使用。
@[comptime]
fn make_values(seed int) [2]int {
    let values [2]int = [seed, seed + 1];
    return values;
}

// sum_values：求值由另一顶层编译期调用返回的数组实参。
@[comptime]
fn sum_values(values [2]int) int {
    return values[0] + values[1];
}

// make_view：从局部数组返回视图，顶层结果应物化为独立静态切片。
@[comptime]
fn make_view(seed int) []int {
    let values [3]int = [seed, seed + 1, seed + 2];
    return values[1..3];
}

fn main() int {
    let packet TopPacket = $make_packet(10);
    let values [2]int = $make_values(4);
    let view []int = $make_view(20);
    let direct int = $make_packet(2).values[1];
    packet.values[0] += 1;
    values[1] += 3;
    view[0] += 2;
    let nested int = $sum_values($make_values(6));
    let result int = packet.head + packet.values[0] + packet.values[1]
        + values[0] + values[1] + view[0] + view[1] + direct + nested;
    printf("comptime-top-level-aggregates=%d\n", result);
    return 0;
}
