// expect: sizeof-pointer-type=8 8
// exit: 0
// sizeof(*Type) 与 sizeof(**Type) 必须按类型解析连续指针前缀。
pub struct SizeofPointerTypeTarget {
    value int;
}

fn main() int {
    let one int = sizeof(*SizeofPointerTypeTarget);
    let two int = sizeof(**SizeofPointerTypeTarget);
    printf("sizeof-pointer-type=%d %d\n", one, two);
    if (one == 8 && two == 8) { return 0; }
    return 1;
}
