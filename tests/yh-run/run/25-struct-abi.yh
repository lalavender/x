// expect: p=7 q=104
// expect-more: diag=5
// expect-more: big=150
// expect-more: mixed=46
// struct 按值语义与 ABI（0.0.2 B2-2，ADR-0001/0002）：
// 赋值与实参均为拷贝（改副本不动源）；嵌套 struct；大 struct（>16 字节，
// 走 x8 间接返回）；struct 与标量混合实参。
pub struct Point {
    x int;
    y int;
}

pub struct Line {
    a Point;
    b Point;
}

pub struct Big {
    a int;
    b int;
    c int;
    d int;
    e int;
    f int;
}

fn sum(p Point) int {
    return p.x + p.y;
}

fn mk(x int, y int) Point {
    return Point{x, y};
}

fn diag(l Line) int {
    return l.a.x + l.b.y;
}

fn bigsum(b Big) int {
    return b.a + b.b + b.c + b.d + b.e + b.f;
}

fn mkbig() Big {
    let t Big = Big{10, 20, 30, 40, 25, 25};
    return t;
}

/* struct 与标量混合实参（>8 寄存器时部分走栈） */
fn mixed(a int, p Point, b int) int {
    return a + p.x + p.y + b;
}

fn main() int {
    let p Point = mk(3, 4);
    let q Point = p;
    q.x = 100;
    printf("p=%d q=%d\n", sum(p), sum(q));
    let l Line = Line{Point{1, 2}, Point{3, 4}};
    printf("diag=%d\n", diag(l));
    let b Big = mkbig();
    printf("big=%d\n", bigsum(b));
    printf("mixed=%d\n", mixed(10, Point{20, 10}, 6));
    return 0;
}
