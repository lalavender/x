// exit: 0
// run/207：目标标记 `$if` 条件的互斥性（W0-2a 追加 windows 后）。
// 目标平台必然命中「三个 OS 标记之一」与「两个架构标记之一」，且各自恰好一个：
// 这样用例在 linux/darwin/windows × arm64/x64 上都能跑，不需要平台头指令，
// 同时把「新增标记被识别、且不会同时为真」钉住。
fn main() int {
    let os_hits int = 0
    let arch_hits int = 0
    $if (linux) { os_hits += 1 }
    $if (darwin) { os_hits += 1 }
    $if (windows) { os_hits += 1 }
    $if (arm64) { arch_hits += 1 }
    $if (x64) { arch_hits += 1 }
    if (os_hits != 1) { return 1 }
    if (arch_hits != 1) { return 2 }
    return 0
}
