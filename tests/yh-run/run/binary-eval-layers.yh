// exit: 0
// 二元层的统一 eval 入口（S4-4 第一片）：8 个优先级层在运行期与折叠上下文各跑一遍
// ——parse 只挂「待求值」节点，语义由 `check.sem_eval_bin` 从子节点注解（或模板
// 轮次的现场算子）求值并回填；这里同时覆盖指针 ± 整数（可寻址性事实由内核设置）。
const K int = 2 + 3 * 4 - 6 / 3
const L int = (1 << 2) | (3 & 1) ^ 0

fn main() int {
    let a int = 7
    let b int = 3
    // 乘法层 + 除法/取模层 + 加法层
    let m int = a * b + (a / b) % 2
    if (m != 21) { return 1 }
    // 移位层
    let sh int = (a << b) >> 1
    if (sh != 28) { return 2 }
    // 关系层 + 相等层：两个比较结果转整型核对（a = 7 > b = 3）
    if ((a < b).to_type(int) != 0) { return 3 }
    if ((a >= b).to_type(int) != 1) { return 4 }
    // 按位与 / 异或 / 或三层
    let bits int = (a & b) | (a ^ b)
    if (bits != 7) { return 5 }
    // 折叠上下文（c_fold）与运行期同内核：K = 12、L = 5
    if (K != 12) { return 6 }
    if (L != 5) { return 7 }
    // 指针 + 整数结果可再解引用；指针比较保持 == / != 语义
    let arr [4]int = [11, 22, 33, 44]
    let q *int = &arr[0]
    if (q != &arr[0]) { return 8 }
    if (*(q + 2) != 33) { return 9 }
    return 0
}
