// expect: ct-local-layout=42
// exit: 0
// 顶层局部整数值可被条件和返回使用，并供后续全局布局读取。

@[comptime]
fn double_value(value int) int {
    let doubled int = value * 2
    return doubled
}

@[comptime]
fn computed_length(value int) int {
    let doubled int = $double_value(value)
    let adjusted int = doubled + 1
    if (adjusted > 5) {
        return adjusted
    }
    return adjusted + 2
}

const ITEM_COUNT int = $computed_length(3)

pub struct LocalValueLayout {
    items [ITEM_COUNT]int
}

let values [ITEM_COUNT]int

fn main() int {
    let local [ITEM_COUNT]int
    printf("ct-local-layout=%d\n", len(values) + len(local) + sizeof(LocalValueLayout))
    return 0
}
