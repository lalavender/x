// expect: const-typed-schedule=37
// exit: 0
// 顶层整数常量中的编译期调用统一由 typed 布局常量依赖调度求值：
// 目标函数体含早期 token 探测不支持的局部数组，只有 typed 执行器能求值。
// 折算：table[2]=13（取 $table_pick(2)） + table[0]=7 + table[SIZE-1]=17 → 37。

// table_pick：局部数组字面量 + 元素读取（token 探测路径不支持数组局部值）。
@[comptime]
fn table_pick(k int) int {
    let table [4]int = [7, 11, 13, 17];
    return table[k];
}

const SIZE int = 4;
const PICKED int = $table_pick(2) + $table_pick(0) + $table_pick(SIZE - 1);

fn main() int {
    printf("const-typed-schedule=%d\n", PICKED);
    return 0;
}
