// expect: mutable-local-layout=4
// exit: 0
// typed 布局执行支持局部赋值，并把结果用于后续全局数组长度。

@[comptime]
fn mutable_length(value int) int {
    let result int = value;
    result += 1;
    return result;
}

const ITEM_COUNT int = $mutable_length(3);
let ITEMS [ITEM_COUNT]int;

fn main() int {
    printf("mutable-local-layout=%d\n", len(ITEMS));
    return 0;
}
