// 编译期 typed switch：覆盖多值 case、default、无 default、return 和循环跳转传播。
// exit: 0

@[comptime]
// choose：按多值整数 case 选择返回值，未匹配时使用 default。
fn choose(value int) int {
    switch value {
        case 1, 2 {
            return 10
        }
        case 3 {
            return 20
        }
        default {
            return 30
        }
    }
    return -1
}

@[comptime]
// loop_switch：检查 continue 与 break 从 switch 分支传播到外层循环。
fn loop_switch() int {
    let total int = 0
    for i in 0..6 {
        switch i {
            case 0, 2 {
                total += 1
            }
            case 3 {
                continue
            }
            case 4 {
                break
            }
            default {
                total += i
            }
        }
        total += 10
    }
    return total
}

@[comptime]
// keep_default：没有匹配 case 且没有 default 时保留既有局部值。
fn keep_default(value int) int {
    let result int = 5
    switch value {
        case 1 {
            result = 10
        }
    }
    return result
}

const selected int = $choose(1) + $choose(2)
const fallback int = $choose(9)
const untouched int = $keep_default(9)
const looped int = $loop_switch()

fn main() int {
    return selected + fallback + untouched + looped - 88
}
