// expect: 1 258
// exit: 0
// 枚举成员名被形参遮蔽时仍应解析到枚举成员（CLI0 探针暴露的名称解析缺陷：
// 此前 sym_lookup 命中形参后不再回退枚举成员表，报「引用了未声明的名字」）。

pub enum Kind {
    none;
    text;
    integer;
}

pub union Payload {
    text *char;
    integer i64;
}

pub struct Value {
    kind Kind;
    data Payload;
}

// make_text：形参名 text 与枚举成员 Kind.text 同名，成员引用必须仍可用。
fn make_text(text *char) Value {
    let v Value;
    v.kind = Kind.text;
    v.data.text = text;
    return v;
}

fn main() int {
    let v Value = make_text("x");
    let u Value;
    u.kind = Kind.integer;
    u.data.integer = 258;
    printf("%d %d\n", v.kind.to_type(int), u.data.integer);
    return 0;
}
