// exit: 0
// 编译期函数中的 &&/|| 必须短路，且遵守 && 高于 || 的优先级。
@[comptime]
fn explode() int {
    $compile_error("短路仍执行了右侧调用");
    return 1;
}

@[comptime]
fn check_and(value int) int {
    $assert(value == 0 || value > 0, "逻辑诊断条件应为真");
    if (value > 0 && 10 / value > 1) {
        return 1;
    }
    if (value < 0 && $explode() > 0) {
        return 2;
    }
    return 0;
}

@[comptime]
fn check_or(value int) int {
    if ((value == 0) || (value > 0 && 10 / value > 1)) {
        return 1;
    }
    return 0;
}

@[comptime]
fn precedence() int {
    if (true || false && false) {
        return 1;
    }
    return 0;
}

fn main() int {
    return $check_and(0) + $check_and(4) + $check_or(0) + $check_or(4)
        + $precedence() - 4;
}
