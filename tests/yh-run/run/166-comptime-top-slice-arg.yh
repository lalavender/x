// exit: 0
// run/166：顶层编译期调用用**切片**实参——切片常量与切片字面量都可用
// （原 fail/148 的「切片实参无折叠路径」随切片字面量折叠交付而升级删除；
// 切片常量实参在上轮切片常量建模后已可用）。
const SL []int = [2, 4, 6];

// sum_slice：按视图遍历求和。
@[comptime]
fn sum_slice(s []int) int {
    let t int = 0;
    for v in s { t += v; }
    return t;
}

// take_head：下标读 + len。
@[comptime]
fn take_head(s []int) int {
    return s[0] + len(s);
}

// forward：把切片实参继续转发给另一个编译期函数（视图别名语义不变）。
@[comptime]
fn forward(s []int) int {
    return $sum_slice(s);
}

// A = 2+4+6 = 12（切片常量实参）。
const A int = $sum_slice(SL);
// B = 1+2+3 = 6（切片字面量实参，backing 折进临时构造区）。
const B int = $sum_slice([1, 2, 3]);
// C = 5 + 3 = 8（字面量 + 下标/len）。
const C int = $take_head([5, 6, 7]);
// D = 1+2+3+4 = 10（正文内转发切片实参）。
const D int = $forward([1, 2, 3, 4]);
// E = 0（空切片字面量）。
const E int = $sum_slice([]);

fn main() int {
    return A - 12 + B - 6 + C - 8 + D - 10 + E;
}