// expect: comptime-aggregate-params=394
// exit: 0
// 编译期函数数组/结构体形参按值复制，切片形参共享底层视图。

pub struct Grid {
    cells [2][2]int;
}

// edit_grid：修改结构体形参中的嵌套数组，验证调用方值不被改写。
@[comptime]
fn edit_grid(grid Grid) int {
    grid.cells[0][1] += 8;
    return grid.cells[0][1] + grid.cells[1][0];
}

// edit_array：修改数组形参副本并返回其结果。
@[comptime]
fn edit_array(values [2]int) int {
    values[0] = 20;
    return values[0] + values[1];
}

// edit_slice：经按值传入的切片描述修改调用方共享的数组存储。
@[comptime]
fn edit_slice(values []int) int {
    values[0] = 60;
    return values[0] + values[1];
}

// aggregate_params：从同一编译期调用帧嵌套调用三类聚合形参。
@[comptime]
fn aggregate_params() int {
    let grid Grid = Grid{ cells: [[1, 2], [3, 4]] };
    let grid_result int = $edit_grid(grid) + grid.cells[0][1] * 100;
    let array [2]int = [3, 4];
    let array_result int = $edit_array(array) + array[0] * 10;
    let data [3]int = [5, 6, 7];
    let view []int = data[1..3];
    let slice_result int = $edit_slice(view) + data[1];
    return grid_result + array_result + slice_result;
}

const RESULT int = $aggregate_params();

fn main() int {
    printf("comptime-aggregate-params=%d\n", RESULT);
    return 0;
}
