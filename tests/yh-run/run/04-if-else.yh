// expect: pos
// expect-more: zero
// expect-more: neg
// expect-more: and
// expect-more: or-ok
// if / else-if / else 分支与比较、逻辑运算符组合。
fn check(x int) int {
    if (x > 0) {
        printf("pos\n")
    } else if (x == 0) {
        printf("zero\n")
    } else {
        printf("neg\n")
    }
    return 0
}
fn main() int {
    check(5)
    check(0)
    check(-3)
    if (1 < 2 && 2 <= 2) {
        printf("and\n")
    }
    if (1 > 2 || 3 != 3) {
        printf("or-bad\n")
    } else {
        printf("or-ok\n")
    }
    return 0
}
