// expect: 0
// expect-more: taken
// expect-more: 0
// expect-more: taken
// expect-more: 1
// && 与 || 的短路求值：右侧副作用（计数器自增）只在左侧未定值时执行。
// false && f() 不调用 f；true || f() 不调用 f；true && f() 调用 f。
fn bump(c *int) int {
    *c += 1
    return true
}
fn main() int {
    let c int = 0
    if (false && bump(&c)) {
        printf("taken\n")
    }
    printf("%d\n", c)
    if (true || bump(&c)) {
        printf("taken\n")
    }
    printf("%d\n", c)
    if (true && bump(&c)) {
        printf("taken\n")
    }
    printf("%d\n", c)
    return 0
}
