// expect: copy=12 9
// expect-more: ret=7 9
// expect-more: rec=36
// expect-more: slice=100
// expect-more: range=10
// 数组按值与遍历（0.0.2 B2-2，ADR-0001/0002 + for-in）：
// 实参拷贝（改形参不动实参）、数组按值返回、递归传递大数组、
// [N]T.to_type([]T) 视图、for-in 数组/切片/区间。
fn fill(a [4]int) int {
    a[0] = 99
    return a[1] + a[2] + a[3]
}

fn mkpair() [3]int {
    let a [3]int
    a[0] = 7
    a[2] = 9
    return a
}

/* 递归：每层持有自己的数组副本 */
fn recsum(a [4]int, n int) int {
    if (n == 0) {
        return 0
    }
    a[0] += 1
    return a[0] + recsum(a, n - 1)
}

fn total(s []int) int {
    let t int = 0
    for x in s {
        t += x
    }
    return t
}

fn main() int {
    let a [4]int
    a[0] = 9
    a[1] = 2
    a[2] = 4
    a[3] = 6
    /* fill 只改自己那份副本：main 的 a[0] 保持 9（按值语义） */
    printf("copy=%d %d\n", fill(a), a[0])
    let p [3]int = mkpair()
    printf("ret=%d %d\n", p[0], p[2])
    let big [4]int
    big[0] = 10
    big[1] = 20
    big[2] = 30
    big[3] = 40
    printf("rec=%d\n", recsum(big, 3))
    let v []int = big.to_type([]int)
    printf("slice=%d\n", total(v))
    let range_sum int = 0
    for i in 1..5 {
        range_sum += i
    }
    printf("range=%d\n", range_sum)
    return 0
}
