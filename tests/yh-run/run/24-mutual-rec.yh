// expect: e10=1 o7=1 e7=0 o10=0
// expect-more: sum=15 head=7
// expect-more: newhead=100
// 编译器工作负载探针（0.0.2 B2-1）：互递归（先使用后定义）、
// malloc 结点的链表、全局指针读写、递归遍历聚合。
pub struct Node {
    v int;
    next *Node;
}

let g_head *Node = 0;

/* 互递归：is_even 调用在其后定义的 is_odd（两遍扫描的前向调用） */
fn is_even(n int) int {
    if (n == 0) {
        return 1;
    }
    return is_odd(n - 1);
}

fn is_odd(n int) int {
    if (n == 0) {
        return 0;
    }
    return is_even(n - 1);
}

/* 头插法建链：malloc 结点、经全局指针挂链 */
fn push_node(v int) void {
    let nd *Node = malloc(sizeof(Node)).to_type(*Node);
    nd.v = v;
    nd.next = g_head;
    g_head = nd;
}

/* 递归遍历：空链以 0 值判断 */
fn sum_list(p *Node) int {
    if (p == 0) {
        return 0;
    }
    return p.v + sum_list(p.next);
}

fn main() int {
    printf("e10=%d o7=%d e7=%d o10=%d\n", is_even(10), is_odd(7),
           is_even(7), is_odd(10));
    push_node(3);
    push_node(5);
    push_node(7);
    printf("sum=%d head=%d\n", sum_list(g_head), g_head.v);
    g_head.v = 100;
    printf("newhead=%d\n", g_head.v);
    free(g_head);
    return 0;
}
