// expect: memory-values=ok
// LL5 内存/聚合值语义锁：嵌套数组寻址、按值副本、共享切片和联合体重叠字段。
struct MemoryCell { tag u8; values [3]int; }
union MemoryBits { wide u64; byte u8; }

// main：从嵌套聚合取址并检查复制隔离和切片共享。
fn main() int {
    let source MemoryCell = MemoryCell{ tag: 5, values: [10, 20, 30] };
    let copy MemoryCell = source;
    let element *int = &source.values[1];
    *element = 21;
    copy.values[0] = 99;
    if (sizeof(MemoryCell) != 16 || source.tag != 5 || source.values[1] != 21
        || copy.tag != 5 || copy.values[0] != 99 || source.values[0] != 10) { return 1; }

    let shared []int = source.values[1..3];
    let alias []int = shared;
    alias[1] = 31;
    if (len(shared) != 2 || len(alias) != 2 || shared[1] != 31
        || source.values[2] != 31) { return 2; }

    let bits MemoryBits;
    bits.wide = 258;
    if (bits.byte != 2) { return 3; }
    printf("memory-values=ok\n");
    return 0;
}
