// exit: 0
// run/153：顶层编译期调用的结构体聚合实参（字段全是标量的字面量）。
pub struct Point {
    x int;
    y int;
}

// take：单聚合形参。
@[comptime]
fn take(p Point) int {
    return p.x * 10 + p.y;
}

// mix：标量在前、聚合在后，验证混合实参顺序。
@[comptime]
fn mix(k int, p Point) int {
    return k + p.x * 10 + p.y;
}

// BASE：字段值里的常量表达式来源。
const BASE int = 4;

// 基本字面量 → 3*10 + 4 = 34
const R1 int = $take(Point{ x: 3, y: 4 });
// 字段乱序 → 2*10 + 5 = 25
const R2 int = $take(Point{ y: 5, x: 2 });
// 标量与聚合混排 → 7 + 1*10 + 2 = 19
const R3 int = $mix(7, Point{ x: 1, y: 2 });
// 字段值是常量表达式 → 5*10 + 4 = 54
const R4 int = $take(Point{ x: BASE + 1, y: BASE });

fn main() int {
    return R1 - 34 + R2 - 25 + R3 - 19 + R4 - 54;
}
