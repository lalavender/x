// expect: 41
// expect-more: 42
// expect-more: 42
// expect-more: null
// 指针：& 取地址、*p 解引用读写、空指针与 0 比较。
fn main() int {
    let x int = 41
    let p *int = &x
    printf("%d\n", *p)
    *p = 42
    printf("%d\n", x)
    printf("%d\n", *p)
    let q *void = 0
    if (q != 0) {
        printf("nonnull\n")
    } else {
        printf("null\n")
    }
    return 0
}
