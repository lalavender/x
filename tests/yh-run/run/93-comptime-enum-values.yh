// expect: total=22 values=red:0,green:7,blue:8,green_again:7,
// exit: 0
// `$for item in Enum.values` 应按声明顺序展开，并暴露成员名与判别值。

pub enum Palette {
    red
    green = 7
    blue
    green_again = 7
}

pub enum Empty {}

// sum_values：编译期函数对枚举值执行编译期展开并求和。
@[comptime]
fn sum_values() int {
    let total int = 0
    $for item in Palette.values {
        let member_name *char = item.name
        total += item.value
    }
    return total
}

const TOTAL int = $sum_values()

// main：验证运行期展开保留枚举成员名称、值及声明顺序。
fn main() int {
    printf("total=%d values=", TOTAL)
    $for item in Palette.values {
        printf("%s:%d,", item.name, item.value)
    }
    $for item in Empty.values {
        printf("unexpected")
    }
    printf("\n")
    return 0
}
