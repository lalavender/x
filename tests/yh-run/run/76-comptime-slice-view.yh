// expect: alias=46 empty=0
// exit: 0
// 编译期切片表达式应保留底层别名并支持反向空范围。

@[comptime]
fn slice_alias() int {
    let values [5]int = [1, 2, 3, 4, 5];
    let window []int = values[1..4];
    let inner []int = window[1..3];
    inner[0] = 30;
    window[0] += 10;
    let total int = 0;
    for value in window {
        total += value;
    }
    return total;
}

@[comptime]
fn reverse_empty() int {
    let values [3]int = [7, 8, 9];
    let empty []int = values[3..1];
    let total int = 0;
    for value in empty {
        total += value;
    }
    return total;
}

const ALIAS int = $slice_alias();
const EMPTY int = $reverse_empty();

fn main() int {
    printf("alias=%d empty=%d\n", ALIAS, EMPTY);
    return 0;
}
