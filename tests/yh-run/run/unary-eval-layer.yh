// exit: 0
// 一元层的统一 eval 入口（S4-4 第二片）：`- + ! ~`、`*`（解引用）、`&`（取地址）
// 都改为从**操作数子节点注解**求值；可寻址性仍由 parse 现场事实承担（`&x` 左值校验）。
// 运行期一元 `+x` 受后端首片限制不受支持，因此 `+` 只在折叠上下文覆盖。
const NEG int = -100
const NOT0 int = !0
const TILDE int = ~41
const PLUS int = +7

fn main() int {
    let x int = 41
    let nx int = -x
    if (nx != -41) { return 1 }
    let b bool = (x != 0).to_type(bool)
    if (!b) { return 2 }
    if ((~x) != -42) { return 3 }
    // 折叠上下文：一元负字面量、逻辑非、按位取反、一元正号
    if (NEG != -100) { return 4 }
    if (NOT0 != 1) { return 5 }
    if (TILDE != -42) { return 6 }
    if (PLUS != 7) { return 7 }
    // 负字面量向 i8 窄化（折叠分支的类型提升与字面量性）
    let n i8 = -100
    if (n.to_type(int) != -100) { return 8 }
    // 取地址 / 解引用：左值校验 + 写入后回读
    let p *int = &x
    if (*p != 41) { return 9 }
    *p = 42
    if (x != 42) { return 10 }
    return 0
}
