// exit: 0
// 编译期函数中的错误诊断仅在实际执行到的路径触发；断言与警告使用当前实参值。
@[comptime]
fn check_value(value int) int {
    if (value < 0) {
        $compile_error("编译期函数拒绝负数")
    }
    $assert(value >= 0, "值必须非负")
    if (value == 7) {
        $compile_warn("编译期函数警告路径")
    }
    return value
}

fn main() int {
    return $check_value(7) - 7
}
