// expect: f=7
// expect-more: apply=42
// expect-more: picked=30
// 函数指针（0.0.2 B2-1）：函数名取值为同签名 fn 类型、fn 变量调用、
// 经参数回调、经返回值选择函数。签名不同必须拒绝（fail 同步覆盖）。
fn add(a int, b int) int {
    return a + b;
}

fn mul(a int, b int) int {
    return a * b;
}

fn apply(cb fn(int, int) int, a int, b int) int {
    return cb(a, b);
}

fn pick(which int) fn(int, int) int {
    if (which == 0) {
        return add;
    }
    return mul;
}

fn main() int {
    let f fn(int, int) int = add;
    printf("f=%d\n", f(3, 4));
    printf("apply=%d\n", apply(mul, 6, 7));
    let g fn(int, int) int = pick(1);
    printf("picked=%d\n", g(5, 6));
    return 0;
}
