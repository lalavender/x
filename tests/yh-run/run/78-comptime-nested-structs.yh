// expect: nested=87 copy=29
// exit: 0
// 编译期嵌套结构体应能按值复制并链式读写整数字段。

pub struct Point {
    x int
    y int
}

pub struct TaggedPoint {
    point Point
    tag int
}

@[comptime]
fn nested_value() int {
    let origin Point = Point{ x: 1, y: 2 }
    let item TaggedPoint = TaggedPoint{
        tag: 7,
        point: Point{ x: origin.x + 2, y: origin.y + 3 },
    }
    item.point.x += item.point.y
    return item.point.x * 10 + item.tag
}

@[comptime]
fn nested_copy() int {
    let original TaggedPoint = TaggedPoint{
        point: Point{ x: 2, y: 4 },
        tag: 1,
    }
    let duplicate TaggedPoint = original
    duplicate.point.x = 9
    return original.point.x * 10 + duplicate.point.x
}

const NESTED int = $nested_value()
const COPY int = $nested_copy()

fn main() int {
    printf("nested=%d copy=%d\n", NESTED, COPY)
    return 0
}
