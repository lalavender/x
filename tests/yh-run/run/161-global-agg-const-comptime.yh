// exit: 0
// run/161：全局聚合常量在编译期有值——编译期正文读下标、字段、嵌套字段、len
// 与 for-in 迭代，并可把常量按值转发给另一个编译期函数（此前只报「其存储
// 尚未在编译期建模」）。运行期同一批常量仍按键值语义读取。
pub struct Point {
    x int
    y int
}

pub struct Box {
    lo Point
    hi Point
}

// 编译期要读的全局聚合常量：同时也是运行期只读数据段常量。
const TABLE [4]int = [10, 20, 30, 40]
const P Point = Point{ x: 3, y: 4 }
const BX Box = Box{ lo: Point{ x: 1, y: 2 }, hi: Point{ x: 5, y: 6 } }
const SCALE [2]f64 = [1.5, 2.25]

// ct_table_sum：按值接收聚合实参并遍历求和（模型必须能复制进调用帧）。
@[comptime]
fn ct_table_sum(t [4]int) int {
    let s int = 0
    for v in t { s += v }
    return s
}

// ct_direct：正文里直接读全局常量的迭代值、下标、字段、嵌套字段与长度。
@[comptime]
fn ct_direct() int {
    let s int = 0
    for v in TABLE { s += v }
    return s + TABLE[0] + TABLE[3] + P.x + BX.hi.y + len(TABLE)
}

// ct_forward：把全局常量作为聚合实参转发给另一个编译期函数。
@[comptime]
fn ct_forward() int {
    return $ct_table_sum(TABLE) + $ct_table_sum(TABLE) / 10
}

// ct_float：读全局浮点数组常量并做编译期浮点算术。
@[comptime]
fn ct_float() f64 {
    return SCALE[0] + SCALE[1]
}

// DIRECT = (10+20+30+40) + 10 + 40 + 3 + 6 + 4 = 163
const DIRECT int = $ct_direct()
// FORWARD = 100 + 100/10 = 110
const FORWARD int = $ct_forward()
// FLOAT = 1.5 + 2.25 = 3.75
const FLOAT f64 = $ct_float()

fn main() int {
    if (DIRECT != 163) { return 1 }
    if (FORWARD != 110) { return 2 }
    if (FLOAT != 3.75) { return 3 }
    // 运行期读取同一批常量：10 + 40 + 3 + 4 + 1 = 58。
    return TABLE[0] + TABLE[3] + P.x + P.y + BX.lo.x - 58
}
