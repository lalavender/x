// exit: 42
// 整数窄化转换回归（不带 printf，可在任意平台运行）：
// i64/u64 → int/短类型的 to_type 必须按目标宽度与符号性重新扩展 x0，
// 否则比较/运算会读到高位的残留值。曾因 sem_cast 缺少「整数→整数」
// 分支而把 i64 的 int 视图当成 64 位整体比较。
fn main() i32 {
    // 正数：i64 高位置 1 后取 int 视图，必须只剩低 32 位
    let a i64 = 0x3ff0000000000000
    if (a.to_type(int) != 0) { return 1 }
    // 低 32 位为负值时，int 视图必须为负
    let b i64 = 0x1ffffffff
    if (b.to_type(int) != -1) { return 2 }
    // u32 → i64：无符号零扩展
    let u u32 = 0xffffffff
    let v i64 = u.to_type(i64)
    if (v != 0xffffffff) { return 3 }
    // i32 → i64：符号扩展
    let m int = -5
    if (m.to_type(i64) != -5) { return 4 }
    // i64 → u32：截断后零扩展
    let w i64 = 0x100000007
    if (w.to_type(u32).to_type(i64) != 7) { return 5 }
    // u8/i8 往返
    let x i64 = 300
    if (x.to_type(u8).to_type(i64) != 44) { return 6 }
    if (x.to_type(i8).to_type(i64) != 44) { return 7 }
    let y i64 = 200
    if (y.to_type(i8).to_type(i64) != -56) { return 8 }
    return 42
}
