// expect: alias-length-array=18
// exit: 0
// 类型别名长度来自编译期调用时，同文件里同长度的定长数组（返回类型、局部变量、
// 形参）必须与别名互相兼容：编译期延迟布局会为长度表达式建立独立类型项，
// 它与同元素类型、同长度的既有数组项等价，按内容放行。
// 折算：q[1]=8 + sum_pair(r)=7 + s[0]=3 → 18。

@[comptime]
fn two() int {
    return 2
}

type Pair = [$two()]int

// make_pair：返回类型写成同长度的定长数组字面量形式。
fn make_pair() [2]int {
    let v [2]int = [7, 8]
    return v
}

// sum_pair：形参用别名类型接收，调用方传别名值。
fn sum_pair(p Pair) int {
    return p[0] + p[1]
}

fn main() int {
    let q [2]int = make_pair()
    let r Pair = [3, 4]
    let s [2]int = r
    printf("alias-length-array=%d\n", q[1] + sum_pair(r) + s[0])
    return 0
}
