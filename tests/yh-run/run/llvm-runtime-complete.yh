// expect: runtime-complete:fmt:-7 8 -9 10 雪 A %
// expect-more: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
// exit: 0
// LL8b 运行时契约：分配边界、格式输出、直接/间接入口和输出错误。

// allocation_ok：验证分配大小边界、16 字节对齐、首尾可写与释放。
fn allocation_ok(size int) int {
    let data *u8 = malloc(size.to_type(u64)).to_type(*u8);
    if (data == 0 || (data.to_type(u64) & 15) != 0) { return 1; }
    let last int = 0;
    if (size > 0) { last = size - 1; }
    data[0] = 65;
    data[last] = 90;
    if (data[last] != 90) { return 2; }
    free(data.to_type(*void));
    return 0;
}

// main：执行 LLVM 和旧后端共用的运行时语义语料。
fn main() int {
    if (allocation_ok(1) != 0 || allocation_ok(15) != 0
        || allocation_ok(16) != 0 || allocation_ok(17) != 0
        || allocation_ok(4096) != 0) { return 1; }

    let alloc fn(u64) *void = malloc;
    let release fn(*void) void = free;
    let copied fn(*void, *void, u64) *void = memcpy;
    let length fn(*char) u64 = strlen;
    let zero *void = alloc(0);
    if (zero == 0 || (zero.to_type(u64) & 15) != 0) { return 2; }
    release(zero);
    release(0.to_type(*void));

    let dst [17]char;
    if (copied((&dst[0]).to_type(*void), "0123456789abcdef", 17)
        != (&dst[0]).to_type(*void)
        || length((&dst[0]).to_type(*char)) != 16
        || dst[15] != 'f' || dst[16] != 0) { return 3; }
    if (printf("runtime-complete:fmt:%d %u %lld %llu %s %c %%\n", -7,
        8.to_type(u32), (-9).to_type(i64), 10.to_type(u64), "雪", 'A') != 40) {
        return 4;
    }

    let large [300]char;
    let i int = 0;
    for i < 299 { large[i] = 'x'; i += 1; }
    large[299] = 0;
    if (printf("%s\n", &large[0]) != 300) { return 6; }

    let huge *void = malloc((-1).to_type(u64));
    if (huge != 0) { free(huge); return 7; }
    if (close(1) != 0 || printf("closed-output") != -1) { return 8; }
    return 0;
}
