// expect: 1 2 4 6 7 8 9
// 聚合元素字面量的运行期初始化（缺陷回归）：元素类型是数组/结构体时，
// 暂存区里放的是**元素对象的地址**，写入目标槽必须整块拷贝。
// 旧发射器按元素 size 走标量分支退化成 `strb`（只写 1 字节），
// 于是 `let a [2][3]int = [[1, 2, 3], [4, 5, 6]];` 读出垃圾值。
struct P {
    x int;
    y int;
}

fn main() int {
    let a [2][3]int = [[1, 2, 3], [4, 5, 6]];
    printf("%d %d %d %d ", a[0][0], a[0][1], a[1][0], a[1][2]);
    let s [3]P = [P{ x: 7, y: 0 }, P{ x: 8, y: 0 }, P{ x: 9, y: 0 }];
    printf("%d %d %d\n", s[0].x, s[1].x, s[2].x);
    return 0;
}
