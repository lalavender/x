// expect: bits=4607182418800017408
// expect-more: sum=25 prod=6 ratio=5
// expect-more: mixed=12 f=7
// 浮点实参传值回归（0.0.2 B7-5）：浮点实参的值在 d0，压栈必须走浮点路径。
// 该用例源自自举差分暴露的缺陷——stage2 曾把 x0（此时恰为 callee 地址）
// 当作浮点实参压栈，导致浮点常量被编码成函数地址。
//
// 覆盖点：
//   1) 浮点字面量作为实参（值在 d0，不可被 x0 覆盖）；
//   2) 与整型实参混用（调用点搬运需按类型分别选 x/d 寄存器）；
//   3) 浮点返回与复合赋值。
fn bits(v f64) i64 {
    // 借内存别名把 f64 的位型读出（1.0 == 0x3FF0000000000000）
    let holder *f64 = malloc(8).to_type(*f64)
    holder[0] = v
    let pb *i64 = holder.to_type(*i64)
    let r i64 = pb[0]
    free(holder.to_type(*void))
    return r
}

fn hyp(a f64, b f64) f64 {
    return a * a + b * b
}

fn scale(v f64, k int) f64 {
    return v * k.to_type(f64)
}

fn main() int {
    // 浮点字面量作实参：位型必须精确等于 1.0 的 IEEE754 编码
    printf("bits=%lld\n", bits(1.0))
    // 浮点实参 + 浮点返回
    printf("sum=%d prod=%d ratio=%d\n", hyp(3.0, 4.0).to_type(int),
           scale(2.0, 3).to_type(int), scale(5.0, 1).to_type(int))
    // 整型与浮点实参混用（先整后浮、先浮后整各一）
    printf("mixed=%d f=%d\n", scale(4.0, 3).to_type(int),
           scale(3.5, 2).to_type(int))
    return 0
}
