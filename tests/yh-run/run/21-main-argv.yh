// expect: argc=4
// expect-more: a1=a a2=b a3=c
// expect-more: argv0-ok
// argv: a b c
// main 带命令行参数（0.0.2 B1-3）：(argc int, argv **char) 签名，
// argv[0] 是程序路径（长度必然非零），argv[1..3] 是注入的三个参数。
fn main(argc int, argv **char) int {
    printf("argc=%d\n", argc)
    printf("a1=%s a2=%s a3=%s\n", argv[1], argv[2], argv[3])
    if (strlen(argv[0]) > 0) {
        printf("argv0-ok\n")
    }
    return 0
}
