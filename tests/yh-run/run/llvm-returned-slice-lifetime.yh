// expect: llvm-returned-slice-lifetime=83
// exit: 0
// 返回切片字面量必须引用堆存储，不能依赖已经退出的函数栈帧。

// make_values：构造运行期值并以切片返回，验证调用者可安全读取后备数组。
fn make_values(seed int) []int {
    return [seed, seed + 1];
}

fn main() int {
    let values []int = make_values(41);
    printf("llvm-returned-slice-lifetime=%d\n", values[0] + values[1]);
    return 0;
}
