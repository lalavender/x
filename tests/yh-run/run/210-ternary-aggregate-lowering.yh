// expect: ternary-aggregate=ok
// NP3-G2 回归：聚合条件表达式的 lowering。
// 聚合没有 SSA 值，两条分支各自写入同一目标存储、不建 phi；覆盖 let 初始化、
// 同型赋值、聚合返回、结构体/数组元素初始化、切片视图，以及嵌在循环体、
// if 分支与嵌套三目里的形态。
struct Pair {
    x int
    y int
}

// pick：聚合返回位置上的三目。
fn pick(c bool, a Pair, b Pair) Pair {
    return c ? a : b
}

// make：供三目分支使用的聚合调用来源。
fn make(v int) Pair {
    return Pair{ x: v, y: v * 2 }
}

fn main() int {
    let yes bool = 1 == 1
    let no bool = 1 == 0
    let a Pair = Pair{ x: 1, y: 10 }
    let b Pair = Pair{ x: 2, y: 20 }

    // let 初始化与同型赋值。
    let p Pair = yes ? a : b
    if (p.x != 1 || p.y != 10) { return 1 }
    let q Pair
    q = yes ? b : a
    if (q.x != 2 || q.y != 20) { return 2 }
    q = no ? b : a
    if (q.x != 1) { return 3 }

    // 聚合返回位置与聚合调用来源。
    if (pick(yes, a, b).y != 10 || pick(no, a, b).y != 20) { return 4 }
    let made Pair = yes ? make(3) : a
    if (made.y != 6) { return 5 }

    // 数组元素与结构体字段里的三目。
    let table [2]Pair = [yes ? a : b, b]
    if (table[0].x != 1 || table[1].x != 2) { return 6 }

    // 切片视图三目（两条分支各自写视图头）。
    let left [2]int = [7, 8]
    let right [2]int = [9, 10]
    let view []int = yes ? left[0..1] : right[0..2]
    if (len(view) != 1 || view[0] != 7) { return 7 }
    let other []int = no ? left[0..1] : right[0..2]
    if (len(other) != 2 || other[1] != 10) { return 8 }

    // 三目结果直接做字段/下标访问：先把聚合物化到临时槽再取址。
    if ((yes ? a : b).y != 10 || (no ? a : b).x != 2) { return 12 }
    let matrix [2][2]int = [[1, 2], [3, 4]]
    if ((yes ? matrix[0] : matrix[1])[1] != 2) { return 13 }

    // 循环体内的三目：每次迭代重写同一槽，不破坏 continue/break 的块记账。
    let acc int = 0
    let i int = 0
    for i < 4 {
        let item Pair = i == 2 ? a : b
        acc += item.y
        i += 1
    }
    if (acc != 70) { return 9 }

    // if 分支内的三目与嵌套三目。
    let nested Pair = yes ? (i == 4 ? a : b) : b
    if (nested.x != 1) { return 10 }
    let r int = 0
    if (yes) {
        let inner Pair = yes ? make(4) : a
        r = inner.y
    } else {
        r = 99
    }
    if (r != 8) { return 11 }

    printf("ternary-aggregate=ok\n")
    return 0
}
