// exit: 0
// run/160：多级引用链的指针常量（追链逐跳跟进，16 跳上限兼作环与超深链兜底）。
pub const C1 *char = "hi";

// C2、C3：逐级引用，最终指向 C1 的字面式。
const C2 *char = C1;
const C3 *char = C2;

// first：读取单字节指针实参的首字节。
@[comptime]
fn first(p *char) int {
    return (*p).to_type(int);
}

// 一级（C1 直接是常量）、二级（C2）、三级（C3）都应得到 'h' = 104
const R1 int = $first(C1);
const R2 int = $first(C2);
const R3 int = $first(C3);

fn main() int {
    return R1 - 104 + R2 - 104 + R3 - 104;
}
