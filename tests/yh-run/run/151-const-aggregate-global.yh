// exit: 0
// run/151：顶层 const 结构体聚合常量（走全局初始化路径，运行期只读读取）。
pub struct Point {
    x int
    y int
}

// ORIGIN：const 聚合常量（标量字段）。
const ORIGIN Point = Point{ x: 3, y: 4 }

// Rect：含嵌套结构体字段的聚合类型。
pub struct Rect {
    lo Point
    hi Point
}

// BOX：嵌套结构体的 const 聚合常量。
const BOX Rect = Rect{ lo: Point{ x: 1, y: 2 }, hi: Point{ x: 5, y: 6 } }

// MUT：同形状的全局变量（对照，确认变量路径未被改动）。
let MUT Point = Point{ x: 1, y: 1 }

fn main() int {
    // ORIGIN=3+4、BOX=1+2+5+6、MUT=1+1 → 合计 23，减 23 应得 0。
    let mutable int = MUT.x + MUT.y
    return ORIGIN.x + ORIGIN.y +
        BOX.lo.x + BOX.lo.y + BOX.hi.x + BOX.hi.y +
        mutable - 23
}
