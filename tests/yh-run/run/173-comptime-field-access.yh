// exit: 0
// run/173：`$field(x, "name")` 编译期按常量字段名取字段（CT6 P1c 首片，只读）。
// 语义等价于 `x.name`（含指针基底自动解引用），名字来自字符串字面量；
// typed 路径捕获为 CTFIELD 节点（parse 期解析出的字段下标），普通路径与
// typed 路径共用成员访问语义。写入不识别该节点，因此赋值按只读拒绝。

pub struct Pair {
    x int;
    y f64;
}

fn read_plain(p Pair) int {
    return $field(p, "x");
}

fn read_ptr(p *Pair) int {
    return $field(p, "x") + 1;
}

@[comptime]
fn ct_read(p Pair) int {
    let a int = $field(p, "x");
    let b f64 = $field(p, "y");
    return a * 10 + b.to_type(int);
}

@[comptime]
fn ct_sum(p Pair) int {
    return $field(p, "x") + $field(p, "y").to_type(int);
}

const R int = $ct_read(Pair{ x: 3, y: 4.0 });
const S int = $ct_sum(Pair{ x: 5, y: 6.0 });

fn main() int {
    let p Pair;
    p.x = 7;
    p.y = 1.5;
    // read_plain(p)=7，read_ptr(&p)=8，R=34，S=11
    return read_plain(p) - 7 + read_ptr(&p) - 8 + R - 34 + S - 11;
}