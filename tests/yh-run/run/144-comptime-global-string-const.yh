// expect: global-string-const=388
// exit: 0
// 全局字符串字面量指针常量在编译期函数内解引用、作为实参跨帧传递，
// 并在 $for 循环里重复引用（只读池按来源键复用，不会耗尽池段）。
// 折算：first_of(TEXT)='a'=97 + 循环三次 97×3=291 → 388。

const TEXT *char = "abc";

// first_of：全局字符串指针常量作为实参传入后解引用。
@[comptime]
fn first_of(p *char) int {
    return (*p).to_type(int);
}

// loop_sum：循环里反复引用同一常量，验证池段复用。
@[comptime]
fn loop_sum() int {
    let sum int = 0;
    $for i in (0..3) {
        sum += (*TEXT).to_type(int);
    }
    return sum;
}

const A int = $first_of(TEXT);
const B int = $loop_sum();

fn main() int {
    printf("global-string-const=%d\n", A + B);
    return 0;
}
