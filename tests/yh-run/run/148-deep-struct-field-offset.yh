// expect: deep-field=5678
// exit: 0
// 深结构体的字段偏移超出 AArch64 单条 add 的 12 位无符号立即数范围（4095）时，
// 字段地址必须借寄存器装载偏移，否则汇编直接失败。
// 覆盖偏移 4096 起的数组字段、4112 的结构体字段、8192 起的数组字段与 8208 的标量字段。
// 折算：m.arr[1]=5 → 5000，m.inner.v=6 → 600，b.arr[2]=7 → 70，b.tail=8 → 5678。

pub struct Inner {
    v int
}
pub struct Mid {
    pad [1024]int
    arr [4]int
    inner Inner
}
pub struct Big {
    pad [2048]int
    arr [4]int
    tail int
}

// touch：通过结构体指针写各深度字段并读回。
fn touch(m *Mid, b *Big, v int) int {
    m.arr[1] = v
    m.inner.v = v + 1
    b.arr[2] = v + 2
    b.tail = v + 3
    return m.arr[1] * 1000 + m.inner.v * 100 + b.arr[2] * 10 + b.tail
}

fn main() int {
    let m Mid
    let b Big
    printf("deep-field=%d\n", touch(&m, &b, 5))
    return 0
}
