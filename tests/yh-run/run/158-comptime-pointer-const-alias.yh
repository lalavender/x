// exit: 0
// run/158：引用式指针常量作编译期实参（`const ALIAS *char = BASE;`）。
// 单文件本来就可用；跨模块一侧由接口追链重放最终字面式（见 comptimecross 的 ALIAS_ARG）。
pub const BASE *char = "hi"

// ALIAS：指向另一个指针常量（引用式，不是字面式初始化）。
const ALIAS *char = BASE

// first：读取单字节指针实参的首字节。
@[comptime]
fn first(p *char) int {
    return (*p).to_type(int)
}

// 直接字面量 → 'Z' = 90；引用式常量 → 'h' = 104
const R1 int = $first("Z")
const R2 int = $first(ALIAS)

fn main() int {
    return R1 - 90 + R2 - 104
}
