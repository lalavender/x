// expect: comptime-union=716
// exit: 0
// 编译期联合体：整数叶字段共享存储（写 int 读 u8 取低位、写 u8 读 int 零扩展）、
// 字面量构造、形参按值传入与返回值复制。
// 折算：写 i=258 后读 b 得 2，改 b=7 后读 i 得 7 → 702；形参 5 + 返回 9 → 14；合计 716。

pub union Val {
    i int;
    b u8;
}

// union_round：字面量构造、共享存储双向重解释与字段写入。
@[comptime]
fn union_round() int {
    let v Val = Val{ i: 258 };
    let low u8 = v.b;
    v.b = 7;
    let wide int = v.i;
    return wide * 100 + low.to_type(int);
}

// union_param：联合体形参按值传入。
@[comptime]
fn union_param(v Val) int {
    return v.i;
}

// union_return：联合体返回值按值复制到调用方帧。
@[comptime]
fn union_return() Val {
    let v Val = Val{ i: 9 };
    return v;
}

// union_call：在编译期函数内构造实参并消费返回的联合体。
@[comptime]
fn union_call() int {
    let arg Val = Val{ i: 5 };
    let got Val = $union_return();
    return $union_param(arg) + got.i;
}

const RESULT int = $union_round() + $union_call();

fn main() int {
    printf("comptime-union=%d\n", RESULT);
    return 0;
}
