// expect: sum=42 name=yh c=Z
// expect-more: AB
// expect-more: a	b
// expect-more: back\slash
// expect-more: q"q"
// expect-more: len=4
// 字符串字面量与 printf：%d/%s/%c 混用、\n \t \\ \" \xNN 转义、strlen。
// 注：字符串字面量类型退化为 *char，可直接传给 printf/strlen。
fn main() int {
    printf("sum=%d name=%s c=%c\n", 42, "yh", 90);
    printf("\x41\x42\n");
    printf("a\tb\n");
    printf("back\\slash\n");
    printf("q\"q\"\n");
    printf("len=%d\n", strlen("yhcc"));
    return 0;
}
