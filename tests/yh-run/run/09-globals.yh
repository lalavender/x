// expect: 13 7
// expect-more: seven
// expect-more: g=20 k=7
// 全局变量读写与编译期 const：const 可作 case 值参与 switch 匹配。
let counter int = 10
const K int = 7
fn main() int {
    counter += 3
    printf("%d %d\n", counter, K)
    switch K {
        case 7 {
            printf("seven\n")
        }
        default {
            printf("no\n")
        }
    }
    counter = 20
    printf("g=%d k=%d\n", counter, K)
    return 0
}
