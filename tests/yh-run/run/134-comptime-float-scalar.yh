// expect: comptime-float=5
// exit: 0
// 编译期浮点标量：字面量、局部变量、算术、比较、转换、形参与返回。

@[comptime]
fn scale(value f64, factor f64) f64 {
    return value * factor;
}

// describe：用浮点比较与三元选择验证编译期浮点条件求值。
@[comptime]
fn describe(value f64) int {
    return (value > 0.0 ? 1 : 0);
}

@[comptime]
fn drive() f64 {
    let base f64 = 1.5;
    let sum f64 = base + 2.25;
    let scaled f64 = $scale(sum, 4.0);
    let half f64 = scaled / 6.0;
    let whole int = half.to_type(int);
    let back f64 = whole.to_type(f64);
    let tiny f64 = 0.5.to_type(f32).to_type(f64);
    let third f64 = 1.0 / 3.0;
    let single f32 = third.to_type(f32);
    let restored f64 = single.to_type(f64);
    $assert(restored != third && restored > 0.3333 && restored < 0.3334,
        "编译期 f32 窄化");
    let sign int = $describe(half - 2.5);
    $assert(sign == 0 && -half < 0.0, "编译期浮点比较");
    return half + back + tiny;
}

const RESULT f64 = $drive();

fn main() int {
    let shown int = RESULT.to_type(int);
    printf("comptime-float=%d\n", shown);
    return 0;
}
