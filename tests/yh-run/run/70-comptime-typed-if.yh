// expect: positive=11 negative=22 guarded=5 local=31 default=4
// exit: 0
// `$if` 在编译期函数中按每次调用的形参值选支。
@[comptime]
fn choose(value int) int {
    $if (value > 0) {
        return 11;
    } $else {
        return 22;
    }
}

@[comptime]
fn guard_unselected(value int) int {
    $if (value > 0) {
        return value;
    } $else {
        $compile_error("未选中的 typed 分支不应触发");
        return 0;
    }
}

@[comptime]
fn choose_local(value int) int {
    let positive int = value > 0 ? 1 : 0;
    $if (positive) {
        return 31;
    } $else {
        return 32;
    }
}

@[comptime]
fn default_without_else(value int) int {
    let result int = 4;
    $if (value > 0) {
        result = 8;
    }
    return result;
}

const POSITIVE int = $choose(1);
const ZERO int = $choose(0);
const GUARDED int = $guard_unselected(5);
const LOCAL int = $choose_local(1);
const DEFAULT int = $default_without_else(0);

fn main() int {
    printf("positive=%d negative=%d guarded=%d local=%d default=%d\n",
        POSITIVE, ZERO, GUARDED, LOCAL, DEFAULT);
    return 0;
}
