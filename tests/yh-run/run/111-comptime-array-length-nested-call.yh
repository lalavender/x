// expect: comptime-array-length-nested-call=21
// exit: 0
// 无环的简单单 return CT 函数可嵌套计算全局数组和字段长度。

@[comptime]
fn mul_two(value int) int {
    return value * 2;
}

@[comptime]
fn array_length(value int) int {
    return $mul_two(value) + 1;
}

const ITEM_COUNT int = $array_length(3);

pub struct NestedLengthPacket {
    items [ITEM_COUNT]u8;
}

let ITEMS [ITEM_COUNT]int = [1, 2, 3, 4, 5, 6, 7];

fn main() int {
    let local [ITEM_COUNT]u8;
    let result int = len(ITEMS) + len(local) + sizeof(NestedLengthPacket);
    printf("comptime-array-length-nested-call=%d\n", result);
    return 0;
}
