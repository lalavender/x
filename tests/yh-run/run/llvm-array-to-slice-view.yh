// expect: views=21
// exit: 0
// 定长数组显式转切片只创建 {len, ptr} 视图，不得把数组内容误作切片头复制。
let global_values [3]int;

// sum：读取切片的三个元素，确保 descriptor 的长度和指针各自有效。
fn sum(values []int) int {
    return values[0] + values[1] + values[2];
}

// main：分别从全局数组和局部数组建立视图，并核对共享的底层元素。
fn main() int {
    global_values[0] = 1;
    global_values[1] = 2;
    global_values[2] = 3;
    let local_values [3]int = [4, 5, 6];
    let global_view []int = global_values.to_type([]int);
    let local_view []int = local_values.to_type([]int);
    printf("views=%d\n", sum(global_view) + sum(local_view));
    return 0;
}
