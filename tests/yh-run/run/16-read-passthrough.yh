// expect: yh-read passthrough: 0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789 !@# end
// stdin-hex: 79682d7265616420706173737468726f7567683a2030313233343536373839204142434445464748494a4b4c4d4e4f505152535455565758595a206162636465666768696a6b6c6d6e6f707172737475767778797a20303132333435363738392021402320656e64
// 标准输入分块读、标准输出写回（0.0.2 B1-1）：
// 104 字节输入 > 64 字节缓冲，第二次 read 天然短读；i64 返回值转 u64 计数。
// Windows/x64：W1-3b 起由 Windows 运行时提供（read→ReadFile、_Exit→ExitProcess）。
fn main() int {
    let buf [64]u8
    for {
        let n i64 = read(0, buf, 64)
        if (n <= 0) {
            break
        }
        write(1, buf, n.to_type(u64))
    }
    return 0
}
