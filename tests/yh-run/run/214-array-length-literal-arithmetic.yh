// expect: 88 4 4 8 4 2 3 5
// 字面量常量算术作为数组长度：由 check 侧求值窄口立即折叠，parse 只拿立即值。
// 覆盖 + - * / 与括号、十六进制/二进制字面量、移位、修饰名 const、比较结果。
const N int = 3

struct Box {
    a [3 + 4]int          // 7
    b [(2 + 3)]int        // 5
    c [(1 + 1) * 5]int    // 10
}

let HEX [0x10 / 4]int = [1, 2, 3, 4]      // 4
let BIN [0b1000 >> 1]int = [1, 2, 3, 4]    // 4

fn main() int {
    let shift [1 << 3]int = [1, 2, 3, 4, 5, 6, 7, 8]        // 8
    let prepared [N + 1]int = [1, 2, 3, 4]                   // 4
    let neg [0 - (-2)]int = [1, 2]                           // 2
    let cmp [(3 > 2) + 2]int = [1, 2, 3]                     // 3
    let modlen [13 % 8]int = [1, 2, 3, 4, 5]                 // 5
    printf("%d %d %d %d %d %d %d %d\n", sizeof(Box),
        len(HEX), len(BIN), len(shift), len(prepared), len(neg), len(cmp), len(modlen))
    return 0
}
