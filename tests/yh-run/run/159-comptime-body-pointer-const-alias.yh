// exit: 0
// run/159：编译期正文里引用「引用式」指针常量（单文件与跨模块两侧同一条追链路径）。
pub const BASE *char = "hi";

// ALIAS：引用式（初始化式是标识符，不是字面量）。
const ALIAS *char = BASE;

// head_of_alias：正文里通过引用式常量读首字节。
@[comptime]
fn head_of_alias() int {
    return (*ALIAS).to_type(int);
}

const R int = $head_of_alias();

fn main() int {
    return R - 104;
}
