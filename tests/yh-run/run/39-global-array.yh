// exit: 17
// 全局数组/切片变量（零初始化）：落地 .bss，len 编译期折叠、下标读写。
// 曾在自举编译器被显式拒绝（"全局数组/切片将在 B7 支持"）。
let arr [3]int;
let mat [2][2]int;
let sl []int;

fn main() int {
    arr[0] = 3;
    arr[2] = 9;
    mat[1][1] = 5;
    sl = arr.to_type([]int);
    let s int = arr[0] + arr[2] + mat[1][1];
    if (s != 17) { return 1; }
    if (len(arr) != 3) { return 2; }
    if (len(mat) != 2) { return 3; }
    if (sl[2] != 9) { return 4; }
    return s;
}
