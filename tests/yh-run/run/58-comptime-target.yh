// exit: 0
// $if 的目标标记描述输出目标，普通同名局部变量仍可在条件外使用。
fn main() int {
    let linux int = 10;
    let darwin int = 20;
    let arm64 int = 12;
    let selected int = 0;
    $if (linux && darwin) {
        selected = 1;
    } $else $if ((linux || darwin) && arm64) {
        selected = 42;
    }
    return selected - linux - darwin - arm64;
}
