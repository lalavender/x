// platform: darwin-arm64
// exit: 0
// macOS/ARM64 默认后端（不带 --backend）的聚合传值与运行冒烟。

module main

struct DefaultPair {
    left int
    right int
}

// default_sum：按值读取聚合，验证默认 LLVM 的 Apple ABI 路径。
fn default_sum(pair DefaultPair) int {
    return pair.left + pair.right
}

fn main() int {
    let pair DefaultPair = DefaultPair{left: 20, right: 22}
    if (default_sum(pair) != 42) { return 1 }
    return 0
}
