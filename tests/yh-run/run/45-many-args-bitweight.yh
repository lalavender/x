// exit: 42
// 超 8 参调用（9 参 = 8 寄存器 + 1 个栈实参）的非交换性校验：位权之和，
// 参数顺序一错值就变（加法求和会掩盖错位，故不用求和）。
// 同时覆盖间接调用（函数指针）路径：目标地址必须在开调用点栈区之前弹出，
// 否则弹出的会变成栈区槽。
// 注：函数名避开 w0..w30 / x0..x30 等 ARM64 寄存器名，否则 Mach-O 侧
// 汇编（w9@PAGEOFF）无法解析。
fn weigh9(a int, b int, c int, d int, e int, f int, g int, h int, i int) int {
    return a + b * 2 + c * 4 + d * 8 + e * 16 + f * 32 + g * 64 + h * 128 + i * 256;
}

fn main() int {
    let v int = weigh9(1, 0, 1, 0, 1, 0, 1, 0, 1);
    if (v != 341) { return 1; }
    let u int = weigh9(0, 1, 0, 1, 0, 1, 0, 1, 0);
    if (u != 170) { return 2; }
    let fp fn(int, int, int, int, int, int, int, int, int) int = weigh9;
    let x int = fp(1, 0, 1, 0, 1, 0, 1, 0, 1);
    if (x != 341) { return 3; }
    return 42;
}
