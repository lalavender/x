// 递归：阶乘与斐波那契；同时覆盖顶层前向调用（先使用后定义）。
fn fact(n int) int {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}
fn fib(n int) int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
fn main() int {
    printf("%d %d\n", fact(5), fib(10));
    printf("fwd=%d\n", later(3));
    return 0;
}
fn later(x int) int {
    return x * 2;
}
