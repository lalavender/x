// expect: comptime-forin-values=14613 rows=1404
// exit: 0
// 编译期结构体和嵌套数组 for-in 应向循环变量提供独立的按值副本。

pub struct VisitPoint {
    x int
    y int
}

@[comptime]
fn iterate_points() int {
    let points [2]VisitPoint = [
        VisitPoint{ x: 1, y: 2 },
        VisitPoint{ x: 3, y: 4 },
    ]
    let total int = 0
    for index, point in points {
        total += index * 100 + point.x * 10 + point.y
        point.x += 10
    }
    return total * 100 + points[0].x * 10 + points[1].x
}

@[comptime]
fn iterate_rows() int {
    let rows [2][2]int = [[1, 2], [3, 4]]
    let total int = 0
    for index, row in rows {
        total += index * 10 + row[0]
        row[0] += 10
    }
    return total * 100 + rows[0][0] + rows[1][0]
}

const RESULT int = $iterate_points()
const ROW_RESULT int = $iterate_rows()

fn main() int {
    printf("comptime-forin-values=%d rows=%d\n", RESULT, ROW_RESULT)
    return 0
}
