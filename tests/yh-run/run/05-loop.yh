// expect: 0
// expect-more: 1
// expect-more: 2
// expect-more: 3
// expect-more: 4
// expect-more: n=3
// expect-more: sum=25
// 循环：`for cond {}` 条件循环、`for {}` 无限循环配 break、continue 跳过本轮。
fn main() int {
    let i int = 0;
    for i < 5 {
        printf("%d\n", i);
        i += 1;
    }
    let n int = 0;
    for {
        n += 1;
        if (n >= 3) {
            break;
        }
    }
    printf("n=%d\n", n);
    let j int = 0;
    let sum int = 0;
    for j < 10 {
        j += 1;
        if (j % 2 == 0) {
            continue;
        }
        sum += j;
    }
    printf("sum=%d\n", sum);
    return 0;
}
