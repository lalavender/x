// exit: 0
// LL10：通过结构体指针参数动态索引后按值复制，必须在 LLVM 与旧后端一致。
// 编译期 IR 表以此方式读取可变长度节点，连续 LLVM 自编依赖它。
struct CtRow {
    code int;
    value int;
}

// CtTable：把连续结构体数组指针嵌入结构体，模拟 IRFunction 的块表字段。
struct CtTable {
    rows *CtRow;
}

// row_value：将指针参数所指数组的一项按值复制到局部结构体后读取字段。
fn row_value(rows *CtRow, index int) int {
    let row CtRow = rows[index];
    return row.code * 100 + row.value;
}

// table_value：从结构体指针字段取得数组指针，再按动态索引复制聚合元素。
fn table_value(table *CtTable, index int) int {
    let row CtRow = table.rows[index];
    return row.code * 100 + row.value;
}

// table_field：直接读取指针字段数组中结构体元素的标量成员。
fn table_field(table *CtTable, index int) int {
    return table.rows[index].value;
}

// clear_table：通过结构体指针把数组指针字段清为合法空指针。
fn clear_table(table *CtTable) void {
    table.rows = 0;
}

// mixed_width_equal：i64 与 int 的非字面量比较按现有整数提升规则求值。
fn mixed_width_equal(wide i64, narrow int) int {
    if (wide == narrow) { return 1; }
    return 0;
}

// bitwise_not_value：运行期按源整数宽度执行逐位取反，结果保留 i64 类型。
fn bitwise_not_value(value i64) i64 {
    return ~value;
}

// fill_metadata：通过两个指针输出标量，模拟跨模块调用中常见的 out 参数接口。
fn fill_metadata(seed int, offset *int, length *int) int {
    offset[0] = seed;
    length[0] = seed + 2;
    return 0;
}

// check_metadata：验证调用、取局部变量地址与指针输出参数的组合 lowering。
fn check_metadata() int {
    let offset int = 0;
    let length int = 0;
    if (fill_metadata(1, &offset, &length) == 0 && length >= 2 && offset >= 0) {
        return offset + length - 4;
    }
    return 1;
}

// main：写入两项并分别读取，确认索引计算与聚合副本没有互相覆盖。
fn main() int {
    let rows [2]CtRow = [CtRow{ code: 3, value: 17 }, CtRow{ code: 8, value: 29 }];
    let base *CtRow = &rows[0];
    let table CtTable = CtTable{ rows: base };
    if (bitwise_not_value(5.to_type(i64)) != (-6).to_type(i64)) { return 2; }
    let result int = row_value(base, 0) + row_value(base, 1)
        + table_value(&table, 1) + table_field(&table, 1)
        - 2004 + check_metadata()
        + (mixed_width_equal(9.to_type(i64), 9) - 1)
        + mixed_width_equal(9.to_type(i64), 8);
    if (result != 0) { return result; }
    clear_table(&table);
    if (table.rows != 0) { return 3; }
    return 0;
}
