// expect: 7
// `len` 只在后接 `(` 时是内置函数关键字；其余位置可作普通标识符。
// 本用例同时覆盖：形参名 len、局部变量 len、内置 len(xs)。
fn total(len int) int {
    let xs [3]int
    xs[0] = len
    xs[1] = 2
    xs[2] = 3
    let n int = len(xs)
    return n + len
}

fn main() int {
    let len int = 4
    printf("%d\n", total(len))
    return 0
}
