// expect: fnptr-addr=ok
// NP3-G1 回归：函数指针绑定的取址与二级解引用。
// 修复前 `&f`（f 是函数指针绑定）走 ADDR 时按元素类型发 `alloca void`，
// LLVM 报 `void type only allowed for function results`；同一缺陷也是 todo D1
// （goto 函数里的函数指针绑定）的根因。
fn add(a int, b int) int { return a + b }

// apply：经解引用后的函数指针回调。
fn apply(cb *fn(int, int) int, a int, b int) int { return (*cb)(a, b) }

// via_goto：D1 形态——goto 与其他语句并存时函数指针绑定仍按内存驻留处理。
fn via_goto(v int) int {
    let r int = 0
    goto body
    r = 99
body:
    let f fn(int) int = inc
    r = f(v)
    return r
}

// inc：供 via_goto 使用的单参函数。
fn inc(v int) int { return v + 1 }

fn main() int {
    let f fn(int, int) int = add
    let p *fn(int, int) int = &f
    if ((*p)(2, 3) != 5) { return 1 }
    if (apply(&f, 4, 5) != 9) { return 2 }
    if (via_goto(41) != 42) { return 3 }
    // 取址后再写回：槽里存的是函数指针值本身，不是代码地址。
    let g fn(int, int) int = add
    let q *fn(int, int) int = &g
    if ((*q)(1, 1) != 2) { return 4 }
    // &函数名：函数值本身已是不透明指针，取址会物化一个 8 字节槽再返回槽地址。
    let named *fn(int, int) int = &add
    if ((*named)(5, 6) != 11) { return 5 }
    if (apply(&add, 7, 8) != 15) { return 6 }
    let assigned *fn(int, int) int
    assigned = &add
    if ((*assigned)(9, 9) != 18) { return 7 }
    printf("fnptr-addr=ok\n")
    return 0
}
