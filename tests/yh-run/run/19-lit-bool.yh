// expect: b=1 c=0
// expect-more: x=200 n=-100 s=60000
// expect-more: y=-2
// 字面量窄化与 bool 字面量（0.0.2 B1 修复回归）：
// true/false 类型为 bool；可表示的整数字面量隐式窄化（u8/i8/u16）；
// i8/u8/u16 经裸变参按 C 默认提升后 printf 结果正确（符号扩展）。
fn main() int {
    let b bool = true;
    let c bool = false;
    printf("b=%d c=%d\n", b, c);
    let x u8 = 200;
    let n i8 = -100;
    let s u16 = 60000;
    printf("x=%d n=%d s=%d\n", x, n, s);
    printf("y=%d\n", (-2).to_type(i8));
    return 0;
}
