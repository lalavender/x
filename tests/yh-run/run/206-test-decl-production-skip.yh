// expect: 42
// YT0：普通 build/run 不执行也不发射 test 块；test 体语义错误不影响生产程序。
struct Box {
    test int
}

fn add(a int, b int) int {
    return a + b
}

test "不会被普通运行执行" {
    $assert(add(1, 1) == 99)
}

test add {
    $assert(add(41, 1) == 42)
}

fn main() int {
    let box Box
    box.test = add(40, 0)
    printf("%d\n", box.test + 2)
    return 0
}
