// expect: total=15
// exit: 0
// 综合回归：typed 局部循环与诊断共享调用帧；只有选中路径发出诊断。
@[comptime]
fn sum_and_validate(limit int) int {
    let total int = 0
    let index int = 0
    for index < limit {
        total += index
        index += 1
    }
    $assert(total == 15, "typed IR 局部值应可用于断言")
    if (total != 15) {
        $compile_error("不可达的 typed IR 编译错误")
    }
    $compile_warn("typed IR 编译期警告")
    return total
}

const RESULT int = $sum_and_validate(6)

fn main() int {
    printf("total=%d\n", RESULT)
    return 0
}
