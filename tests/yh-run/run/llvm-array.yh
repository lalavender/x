// expect: array=ok
// LL5 聚合首片语义锁：定长数组字面量、下标读写、取元素地址、按值复制与嵌套数组。
// 与 tests/selfhost/llvm-array.py 使用同一组断言；本用例经旧后端运行。
fn main() int {
    let a [3]int = [1, 2, 3];
    let sum int = 0;
    let i int = 0;
    for i < 3 {
        sum += a[i];
        i += 1;
    }
    if (sum != 6) { return 1; }

    a[1] = 20;
    if (a[1] != 20) { return 2; }
    let p *int = &a[0];
    *p = 5;
    if (a[0] != 5) { return 3; }

    let b [3]int = a;
    if (b[0] != 5 || b[2] != 3) { return 4; }
    b[2] = 7;
    if (a[2] != 3) { return 5; }

    let c [2][3]int = [[1, 2, 3], [4, 5, 6]];
    if (c[1][2] != 6) { return 6; }
    c[0][1] = 9;
    if (c[0][1] != 9 || c[1][0] != 4) { return 7; }

    let d [3]int = [0, 0, 0];
    d = a;
    d[0] = 11;
    if (a[0] != 5 || d[0] != 11) { return 8; }

    let k int = 0;
    for k < 2 {
        a = [k + 5, k + 6, k + 7];
        k += 1;
    }
    if (a[0] != 6 || a[2] != 8) { return 9; }

    printf("array=ok\n");
    return 0;
}
