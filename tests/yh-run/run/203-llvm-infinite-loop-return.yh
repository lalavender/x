// exit: 0
// LLVM 回归：无限循环的分支可直接返回，未返回路径继续携带局部变量。

// cstr_eq：逐字节比较两个 NUL 结尾字符串，并在循环分支中提前返回。
fn cstr_eq(a *char, b *char) int {
    let i int = 0
    for {
        let x u8 = a[i].to_type(u8)
        let y u8 = b[i].to_type(u8)
        if (x != y) { return 0 }
        if (x == 0) { return 1 }
        i += 1
    }
}

// main：覆盖相等、前缀不等和首字节不等的退出分支。
fn main() int {
    if (cstr_eq("same", "same") != 1) { return 1 }
    if (cstr_eq("same", "sam") != 0) { return 2 }
    if (cstr_eq("first", "other") != 0) { return 3 }
    return 0
}
