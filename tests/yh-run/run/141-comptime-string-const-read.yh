// expect: string-const-read=304
// exit: 0
// 编译期字符串字面量指针常量：解引用、下标、指针算术、NUL 结尾与转义解码只读访问。
// 折算：'a'=97 + p[1]='b'=98 + p[3]=0 + (p+2) 首字节 'c'=99 + "x\ny"[1]=\n=10 → 304。

// read_bytes：解引用、下标、NUL 结尾、指针算术与转义解码。
@[comptime]
fn read_bytes() int {
    let p *char = "abc"
    let a int = (*p).to_type(int)
    let b int = p[1].to_type(int)
    let z int = p[3].to_type(int)
    let q *char = p + 2
    let c int = (*q).to_type(int)
    let e *char = "x\ny"
    let n int = e[1].to_type(int)
    return a + b + z + c + n
}

// first_of：字符串字面量指针常量作为形参跨帧传入后读取。
@[comptime]
fn first_of(text *char) int {
    return (*text).to_type(int)
}

// via_param：在编译期函数体内构造字面量指针常量并按形参传递（顶层调用实参暂不支持）。
@[comptime]
fn via_param() int {
    return $first_of("!")
}

const RESULT int = $read_bytes() + $via_param() - 33

fn main() int {
    printf("string-const-read=%d\n", RESULT)
    return 0
}
