// exit: 0
// run/157：const 聚合常量的取地址（只读引用）合法 —— 此前与赋值一起被误拒。
pub struct Point {
    x int
    y int
}

// TABLE：const 数组聚合常量。
const TABLE [3]int = [7, 8, 9]

// ORIGIN：const 结构体聚合常量。
const ORIGIN Point = Point{ x: 4, y: 6 }

fn main() int {
    let p *int = &TABLE[0]
    let q *int = &TABLE[2]
    let f *int = &ORIGIN.y
    // 7 + 9 + 6 = 22
    return *p + *q + *f - 22
}
