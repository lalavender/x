// expect: expr-matrix=815
// exit: 0
// 编译期表达式的覆盖矩阵：算术、位运算、比较、逻辑、一元、三元、成员访问、
// 下标、取址与解引用写回、sizeof、显式转换、len、切片视图与浮点算术。
// 字段名故意使用被语言用作关键字的文本 `in`：字段匹配按源文本进行。
// 折算：h.in+h.arr[2]=8 → 800 + x=8 + len(a)=4 + len(s)=2 + f=3 + t=7 + u=-11 + v=2 = 815。

pub struct Holder {
    in int
    arr [3]int
}

@[comptime]
fn matrix() int {
    let h Holder = Holder{ in: 5, arr: [1, 2, 3] }
    let x int = 7
    let p *int = &x
    *p += 1
    let f f64 = 1.5 + 2.25
    let a [4]int = [1, 2, 3, 4]
    let s []int = a[1..3]
    let t int = (6 & 3) | ((6 ^ 3) << 1 >> 1)
    let u int = -5 + ~5
    let v int = 3 > 1 ? 2 : 9
    let w int = (h.in + h.arr[2]) * 100 + x + len(a) + len(s) +
        f.to_type(int) + t + u + v
    return w
}

const R int = $matrix()

fn main() int {
    printf("expr-matrix=%d\n", R)
    return 0
}
