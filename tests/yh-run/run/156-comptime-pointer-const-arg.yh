// exit: 0
// run/156：编译期调用的单字节指针实参（直接字面量与字面量初始化的指针常量）。
pub const TEXT *char = "AB";
const MINE *char = "CD";

// first：读取单字节指针实参的首字节。
@[comptime]
fn first(p *char) int {
    return (*p).to_type(int);
}

// 直接字面量 → 'Z' = 90
const R1 int = $first("Z");
// 公开的字面量初始化指针常量 → 'A' = 65
const R2 int = $first(TEXT);
// 私有同上 → 'C' = 67
const R3 int = $first(MINE);

fn main() int {
    return R1 - 90 + R2 - 65 + R3 - 67;
}
