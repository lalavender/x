// expect: 30 224
// expect-more: 1
// expect-more: 229 1
// 十六进制字面量含 e/E 数字：按整数处理（修复前被误判为 f64 拒绝编译）。
// 大于 2^31 的值经 u64/i64 恒等比较断言（printf 的 %d 只打印 32 位域）。
fn main() int {
    printf("%d %d\n", 0x1E, 0xE0);
    let big u64 = 0xAA0103E0;
    printf("%d\n", big == 2852193248 ? 1 : 0);
    printf("%d %d\n", 0x0e5, -0x5555555555555556 == -6148914691236517206 ? 1 : 0);
    return 0;
}
