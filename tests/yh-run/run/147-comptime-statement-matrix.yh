// expect: stmt-matrix=47
// exit: 0
// 编译期语句的覆盖矩阵：if/else if/else、区间 for-in、条件 for 与 break、
// continue/break 混合、switch case/default、for-in 双绑定（下标在前）与嵌套块。
// 折算：if=1 + 区间 for=6 + 条件 for=3 + 跳转循环=5 + switch case=20
//       + for-in 双绑定=10 + 块=2 → 47。

@[comptime]
fn stmts(a int) int {
    let s int = 0;
    if (a > 0) {
        s += 1;
    } else if (a == 0) {
        s += 2;
    } else {
        s += 3;
    }
    for i in 0..4 {
        s += i;
    }
    let k int = 0;
    for 1 {
        if (k >= 3) { break; }
        k += 1;
    }
    s += k;
    for i in 0..6 {
        if (i == 1) { continue; }
        if (i == 4) { break; }
        s += i;
    }
    switch (a) {
        case 0 { s += 10; }
        case 7 { s += 20; }
        default { s += 30; }
    }
    let arr [2]int = [4, 5];
    for idx, val in arr {
        s += idx + val;
    }
    {
        let t int = 2;
        s += t;
    }
    return s;
}

const R int = $stmts(7);

fn main() int {
    printf("stmt-matrix=%d\n", R);
    return 0;
}
