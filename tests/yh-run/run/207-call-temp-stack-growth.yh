// exit: 0
// 调用期临时存储不得随循环迭代增长（缺陷回归）：
// 结构体返回值作「聚合字面量元素」或「按值聚合实参」时，旧 lowering 在
// 调用点就地发 alloca，循环每次迭代泄漏 56 字节以上，8 MB 栈在十几万次
// 迭代后溢出（表现为段错误，且与 -O0/-O2 无关）。本用例 60 万次迭代后
// 仍须正常返回。
struct Big {
    a int
    b int
    c int
    d int
    e int
    f int
    g int
}

// make_big 构造 56 字节结构体返回值，强制走调用期临时槽。
fn make_big(i int) Big {
    return Big{ a: i, b: i, c: i, d: i, e: i, f: i, g: i }
}

// take 取元素个数；切片字面量的元素来自结构体返回值。
fn take(items []Big) int {
    return len(items)
}

// take_one 按值接收单个 56 字节聚合实参。
fn take_one(value Big) int {
    return value.a
}

// main 循环内反复构造调用期聚合临时，验证栈不随迭代增长。
fn main() int {
    let i int = 0
    for i < 600000 {
        let n int = take([make_big(i), make_big(i)])
        if (n != 2) {
            return 1
        }
        if (take_one(make_big(i)) != i) {
            return 2
        }
        i += 1
    }
    return 0
}
