// expect: eof-ok
// expect-more: badfd-ok
// expect-more: closebad-ok
// expect-more: file-ok
// stdin-hex:
// read/close 边界（0.0.2 B1-1）：空输入立即 EOF（返回 0）；
// 非法 fd 的 read/close 返回负值且程序正常继续；
// open 打开的真实 fd close 返回 0。
// platform: linux darwin
// Windows/x64：POSIX fd 读（read）与 errno 语义在 Windows 零 CRT 下未提供（W1-3b）。
fn main() int {
    let buf [16]u8
    let n i64 = read(0, buf, 16)
    if (n == 0) {
        printf("eof-ok\n")
    }
    let r i64 = read(999, buf, 16)
    if (r < 0) {
        printf("badfd-ok\n")
    }
    let c int = close(999)
    if (c < 0) {
        printf("closebad-ok\n")
    }
    let fd int = open("/dev/null", 0)
    if (fd >= 0) {
        let c2 int = close(fd)
        if (c2 == 0) {
            printf("file-ok\n")
        }
    }
    return 0
}
