// expect: comptime-global-aggregates=125
// exit: 0
// 顶层编译期聚合值可作为全局可变聚合的初始化器。

pub struct GlobalPacket {
    head int
    values [2]int
}

// make_global_packet：返回用于全局数据初始化的结构体。
@[comptime]
fn make_global_packet(seed int) GlobalPacket {
    return GlobalPacket{ head: seed, values: [seed + 1, seed + 2] }
}

// make_global_values：返回用于全局数组初始化的定长数组。
@[comptime]
fn make_global_values(seed int) [2]int {
    let values [2]int = [seed, seed + 1]
    return values
}

// make_global_view：从编译期局部数组返回切片供全局数据初始化。
@[comptime]
fn make_global_view(seed int) []int {
    let values [3]int = [seed, seed + 1, seed + 2]
    return values[1..3]
}

let PACKET GlobalPacket = $make_global_packet(30)
let VALUES [2]int = $make_global_values(5)
let VIEW []int = $make_global_view(7)

fn main() int {
    PACKET.values[0] += 1
    VALUES[1] += 2
    VIEW[0] += 1
    let result int = PACKET.head + PACKET.values[0] +
        PACKET.values[1] + VALUES[0] + VALUES[1] + VIEW[0] + VIEW[1]
    printf("comptime-global-aggregates=%d\n", result)
    return 0
}
