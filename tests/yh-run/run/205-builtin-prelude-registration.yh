// expect: builtin=ok abc 3
// 回归：内置（prelude）函数登记表迁到 compiler/builtin 模块后，printf/malloc/
// memcpy/strlen/free 仍由默认 prelude 提供，签名与运行时标志不变。
fn main() int {
    let src *char = "abc"
    let buf *char = malloc(8).to_type(*char)
    if (buf == 0) { return 1 }
    memcpy(buf, src, 4)
    let n int = strlen(buf).to_type(int)
    printf("builtin=ok %s %d\n", buf, n)
    free(buf.to_type(*void))
    return 0
}
