// exit: 0
// run/167：return 表达式里的聚合字面量（此前「数组/切片字面量需要目标类型上下文」
// 缺失 return 位置；2026-10-09 修复：return 目标类型 = 函数返回类型）。同时覆盖
// 编译期正文里对调用结果直接求值的下标/成员/切片视图/嵌套下标/for-in 形态。

pub struct Point {
    x int
    y int
}

// —— 编译期函数：直接返回数组/嵌套数组/切片字面量 ——
@[comptime]
fn mk_arr() [4]int {
    return [1, 2, 3, 4]
}

@[comptime]
fn mk_nested() [2][3]int {
    return [[1, 2, 3], [4, 5, 6]]
}

@[comptime]
fn mk_slice() []int {
    return [5, 6, 7]
}

@[comptime]
fn mk_point() Point {
    return Point{ x: 7, y: 8 }
}

// —— 编译期正文：直接对调用结果求值 ——
@[comptime]
fn idx_call() int {
    return $mk_arr()[0] + $mk_arr()[3]
}

@[comptime]
fn member_call() int {
    return $mk_point().x + $mk_point().y
}

@[comptime]
fn slice_view_call() int {
    return $mk_slice()[1..3][0] + len($mk_slice())
}

@[comptime]
fn nested_call() int {
    return $mk_nested()[1][2]
}

@[comptime]
fn loop_call() int {
    let s int = 0
    for i, v in $mk_arr() { s += v + i }
    return s
}

// —— 普通函数：同样支持直接返回字面量 ——
fn rt_arr() [3]int {
    return [7, 8, 9]
}

fn rt_slice() []int {
    return [10, 11]
}

// A = 1+4 = 5；B = 15；C = 6 + 3 = 9；D = 6；F = 16。
const A int = $idx_call()
const B int = $member_call()
const C int = $slice_view_call()
const D int = $nested_call()
const F int = $loop_call()

fn main() int {
    let ra [3]int = rt_arr()
    let rs []int = rt_slice()
    // ra = 24；rs = 21。
    return A - 5 + B - 15 + C - 9 + D - 6 + F - 16 +
        ra[0] + ra[1] + ra[2] - 24 + rs[0] + rs[1] - 21
}