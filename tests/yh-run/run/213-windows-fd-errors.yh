// expect: bad-close=-1 bad-read=-1 bad-write=-1 roundtrip=ok
// platform: windows
// run/213：Windows 运行时的负 fd 必须按 POSIX 语义失败（W2-7）。
// 旧实现把 fd < 3 全当成“标准描述符”，于是 close(-1)/read(-1)/write(-1) 静默成功，
// os.close_fd(-1) 之类的调用会返回 0 而不是 -1。同时验证前向斜杠路径的
// 创建/重命名/删除往返（yh 内部到处用 '/'）。
// rmdir 不在 prelude 里（os.yh 以 @[extern] 声明）：零 CRT 用户程序由 SDK
// 支撑对象的 /alternatename:rmdir=__yh_rmdir 提供实现。
@[extern] fn rmdir(path *char) int

fn main() int {
    let bad_close int = close(-1)
    let buf [8]u8
    let bad_read i64 = read(-1, &buf[0], 8)
    let bad_write i64 = write(-1, &buf[0], 8)
    printf("bad-close=%d bad-read=%d bad-write=%d ",
        bad_close, bad_read.to_type(int), bad_write.to_type(int))

    let path *char = "tmp-win-fd-check/file.txt"
    let dir *char = "tmp-win-fd-check"
    if (mkdir(dir, 493) != 0) { return 1 }
    let fd int = open(path, 0x241, 420)
    if (fd < 0) { return 2 }
    let text [5]u8
    text[0] = 104
    text[1] = 101
    text[2] = 108
    text[3] = 108
    text[4] = 111
    if (write(fd, &text[0], 5) != 5) { return 3 }
    if (close(fd) != 0) { return 4 }
    let moved *char = "tmp-win-fd-check/moved.txt"
    if (rename(path, moved) != 0) { return 5 }
    if (unlink(moved) != 0) { return 6 }
    if (rmdir(dir) != 0) { return 7 }
    printf("roundtrip=ok\n")
    return 0
}
