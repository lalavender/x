// expect: comptime-pointer-param=136
// exit: 0
// 编译期指针形参别名调用方帧整数槽：写回、二次转发与空指针形参都只在调用帧内生效。

@[comptime]
fn add_into(target *int, delta int) int {
    *target += delta;
    return *target;
}

// combine：把两个形参指针继续向下转发，验证跨帧别名仍指向调用方槽。
@[comptime]
fn combine(left *int, right *int) int {
    $add_into(left, 4);
    $add_into(right, 10);
    return *left * 10 + *right;
}

// sum_or_zero：空指针形参不做解引用，按 0 判定返回兜底值。
@[comptime]
fn sum_or_zero(target *int, fallback int) int {
    if (target == 0) {
        return fallback;
    }
    return *target;
}

@[comptime]
fn drive() int {
    let acc int = 3;
    let other int = 2;
    let packed int = $combine(&acc, &other);
    let fallback int = $sum_or_zero(0, 5);
    return packed + acc * 7 + fallback;
}

const RESULT int = $drive();

fn main() int {
    printf("comptime-pointer-param=%d\n", RESULT);
    return 0;
}
