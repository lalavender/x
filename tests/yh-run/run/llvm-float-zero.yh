// exit: 0
// 精确定位 LLVM 负零常量、运行期取负和 IEEE 比较边界。
const NEGATIVE_ZERO f64 = -0.0

fn bits64(value f64) u64 { return (&value).to_type(*u64)[0] }
fn bits32(value f32) u32 { return (&value).to_type(*u32)[0] }
fn negate(value f64) f64 { return -value }

fn main() int {
    if (bits64(0.0) != 0) { return 1 }
    if (bits64(NEGATIVE_ZERO) != 0x8000000000000000) { return 2 }
    if (bits64(negate(0.0)) != 0x8000000000000000) { return 3 }
    if (NEGATIVE_ZERO != 0.0) { return 4 }
    if (bits32(negate(0.0).to_type(f32)) != 0x80000000) { return 5 }
    return 0
}
