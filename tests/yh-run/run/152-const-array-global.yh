// exit: 0
// run/152：顶层 const 数组聚合常量（走全局初始化路径，运行期只读索引读取）。
const TABLE [4]int = [10, 20, 30, 40];

// NUMS：对照的全局变量数组，确认变量路径未受影响。
let NUMS [3]int = [1, 2, 3];

fn main() int {
    // TABLE 合计 100，NUMS 合计 6 → 减 106 应得 0。
    let acc int = 0;
    let i int = 0;
    for i < 4 {
        acc += TABLE[i];
        i += 1;
    }
    let j int = 0;
    for j < 3 {
        acc += NUMS[j];
        j += 1;
    }
    return acc - 106;
}
