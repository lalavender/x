// expect: sh32=2147483648
// expect-more: sh40=1099511627776
// expect-more: hi=1
// expect-more: ar=-4
// expect-more: zx=254
// expect-more: sx=-2
// expect-more: wrap=18446744073709551615
// expect-more: wrap32=4294967295
// u32/u64 位移与符号扩展（0.0.2 B2-1）：u32 第 31 位、u64 第 40/63 位、
// i64 算术右移、i8→i64 符号扩展、u8→u64 零扩展、无符号 0-1 环绕。
fn main() int {
    let u u32 = 1
    u = u << 31
    printf("sh32=%u\n", u)
    let big u64 = 1
    big = big << 40
    printf("sh40=%lld\n", big)
    let h u64 = 1
    h = h << 63
    printf("hi=%llu\n", h >> 63)
    let nn i64 = -8
    printf("ar=%lld\n", nn >> 1)
    let m u8 = 254
    printf("zx=%llu\n", m.to_type(u64))
    let n8 i8 = (-2).to_type(i8)
    printf("sx=%lld\n", n8.to_type(i64))
    let w u64 = 0
    w = w - 1
    printf("wrap=%llu\n", w)
    let w2 u32 = 0
    w2 = w2 - 1
    printf("wrap32=%u\n", w2)
    return 0
}
