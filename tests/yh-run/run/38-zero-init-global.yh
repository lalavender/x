// exit: 7
// 零初始化全局变量：`let g int;` 落地为 .bss，初值读取为 0。
// 曾在 stage0 `-o` 模式误报 redeclaration（pass 1 提前登记全局符号、
// pass 2 重复登记），本用例钉住；自举侧零初始化全局本就支持。
let g int;
let z int = 7;

fn bump(x int) int {
    g = g + x;
    return g;
}

fn main() int {
    bump(z);
    bump(z);
    if (g != 14) { return 1; }
    return g - 7;
}
