// exit: 0
// run/154：顶层编译期调用的嵌套结构体聚合实参（字段递归折叠）。
pub struct Point {
    x int;
    y int;
}

// Box：含两个嵌套结构体字段与一个标量字段。
pub struct Box {
    lo Point;
    hi Point;
    tag int;
}

// area：读取嵌套字段。
@[comptime]
fn area(b Box) int {
    return (b.hi.x - b.lo.x) * (b.hi.y - b.lo.y) + b.tag;
}

// 嵌套字面量 + 字段乱序 → (5-1)*(6-2) + 7 = 23
const A int = $area(Box{ tag: 7, hi: Point{ x: 5, y: 6 }, lo: Point{ x: 1, y: 2 } });

// 单个标量形参与嵌套聚合混排 → 100 + 21 = 121
@[comptime]
fn mix(k int, b Box) int {
    return k + b.lo.x * 10 + b.lo.y * 10 + b.tag;
}

const B int = $mix(100, Box{ lo: Point{ x: 1, y: 1 }, hi: Point{ x: 0, y: 0 }, tag: 1 });

fn main() int {
    return A - 23 + B - 121;
}
