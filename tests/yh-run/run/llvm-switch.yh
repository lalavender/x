// expect: switch=ok
// LL4 switch 语义锁：多值 case、default、无 fallthrough、嵌套 switch 与循环内 break。
// 与 tests/selfhost/llvm-switch.py 使用同一组断言；本用例经旧后端运行。
fn pick(v int) int {
    switch v {
        case 1 { return 10 }
        case 2, 3 { return 20 }
        default { return 30 }
    }
    return 99
}

fn main() int {
    if (pick(1) != 10) { return 1 }
    if (pick(2) != 20) { return 2 }
    if (pick(3) != 20) { return 3 }
    if (pick(9) != 30) { return 4 }

    let x int = 2
    let r int = 0
    switch x {
        case 2 { r = 5 }
        default { r = 7 }
    }
    if (r != 5) { return 5 }

    let total int = 0
    let i int = 0
    for i < 5 {
        switch i {
            case 0 { total += 1 }
            case 1, 2 { total += 10 }
            default { total += 100 }
        }
        i += 1
    }
    if (total != 221) { return 6 }

    let k int = 0
    let seen int = 0
    for k < 10 {
        switch k {
            case 3 { break }
            default { seen += 1 }
        }
        k += 1
    }
    if (seen != 3 || k != 3) { return 7 }

    let n int = 0
    let j int = 0
    for j < 3 {
        switch j {
            case 0 {
                switch j + 5 {
                    case 5 { n += 5 }
                    default { n += 50 }
                }
            }
            default { n += 100 }
        }
        j += 1
    }
    if (n != 205) { return 8 }

    printf("switch=ok\n")
    return 0
}
