// expect: comptime-index-aggregate-expression=29
// exit: 0
// 编译期数组下标应能读取函数返回的数组及结构体数组字段。

pub struct MatrixPacket {
    cells [2][2]int;
}

@[comptime]
fn make_matrix(seed int) [2][2]int {
    let matrix [2][2]int = [[seed, seed + 1], [seed + 2, seed + 3]];
    return matrix;
}

@[comptime]
fn make_packet(seed int) MatrixPacket {
    return MatrixPacket{ cells: [[seed, seed + 1], [seed + 2, seed + 3]] };
}

@[comptime]
fn read_returned_aggregates() int {
    return $make_matrix(4)[1][0] + $make_packet(20).cells[1][1];
}

const RESULT int = $read_returned_aggregates();

fn main() int {
    printf("comptime-index-aggregate-expression=%d\n", RESULT);
    return 0;
}
