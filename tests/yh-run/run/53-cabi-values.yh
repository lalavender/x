// exit: 0
// C ABI 聚合与间接调用边界的语义回归，独立 C 交叉验证在 autoabi 项目。
@[extern]
pub struct CPair { quot int; rem int; }
@[extern]
pub struct CFloat3 { x f64; y f64; z f64; }
@[extern]
pub struct CWide { a i64; b i64; c i64; }

// 返回八字节聚合，调用方从 x0 还原字段。
@[extern]
fn pair(a int, b int) CPair { return CPair{a / b, a % b}; }
// 三个 f64 的 HFA 超过十六字节，仍以浮点寄存器传递。
@[extern]
fn floats(v CFloat3) CFloat3 { v.y += 10.0; return v; }
// 普通大聚合按值传递，不允许形参写入影响原对象。
@[extern]
fn wide(v CWide) CWide { v.b += 20; return v; }
// 返回 C 函数指针，其调用约定随返回类型保留。
@[extern]
fn choose() fn(int, int) CPair { return pair; }

fn main() int {
    let callback @[extern] fn(int, int) CPair = choose();
    let p CPair = callback(17, 5);
    if (p.quot != 3 || p.rem != 2) { return 1; }
    let v CFloat3 = CFloat3{1.0, 2.0, 3.0};
    let r CFloat3 = floats(v);
    if (v.y != 2.0 || r.x != 1.0 || r.y != 12.0 || r.z != 3.0) { return 2; }
    let w CWide = CWide{1, 2, 3};
    let q CWide = wide(w);
    if (w.b != 2 || q.a != 1 || q.b != 22 || q.c != 3) { return 3; }
    return 0;
}
