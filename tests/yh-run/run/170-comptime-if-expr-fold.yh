// exit: 0
// run/170：$if 表达式在顶层 const 折叠与全局数组初始化里的消费（CT6 P0）。
// 折叠路径选中分支结果为常量，可参与后续常量运算与聚合初始化元素。

const A int = $if (1 < 2) 3 $else 4;
const B i64 = $if (2 > 3) 5 $else 6;
const C i64 = A.to_type(i64) + B;
const TBL [3]i64 = [A.to_type(i64), ($if (1 > 2) 10 $else 11).to_type(i64), C];

fn main() int {
    // A=3，B=6，C=9，TBL=[3, 11, 9]
    return A - 3 + B.to_type(int) - 6 + C.to_type(int) - 9
        + TBL[0].to_type(int) - 3 + TBL[1].to_type(int) - 11
        + TBL[2].to_type(int) - 9;
}