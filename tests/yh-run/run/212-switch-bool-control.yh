// expect: switch-bool=ok
// NP3-G4 回归：bool 控制表达式的 switch。
// 控制值用 EQ 比较，bool 走 i8 的相等比较，与整数同构；case 值允许 bool 常量。
fn pick(flag bool) int {
    switch flag {
        case true { return 1 }
        case false { return 2 }
    }
    return 3
}

// classify：bool switch 带 default，验证未命中路径的行进。
fn classify(flag bool) int {
    switch flag {
        case true { return 7 }
        default { return 9 }
    }
}

fn main() int {
    if (pick(true) != 1 || pick(false) != 2) { return 1 }
    if (classify(true) != 7 || classify(false) != 9) { return 2 }
    // 循环体内 + 表达式控制（`i < 2` 直接作为控制）。
    let i int = 0
    let acc int = 0
    for i < 4 {
        switch i < 2 {
            case true { acc += 1 }
            default { acc += 10 }
        }
        i += 1
    }
    if (acc != 22) { return 3 }
    printf("switch-bool=ok\n")
    return 0
}
