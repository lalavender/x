// expect: llvm-linux-x64-host=ok
// exit: 0
// platform: linux
// LL8b 宿主桥探针：syscall ABI、嵌套目录/中文空格路径、单调时钟和子进程退出。
// 文件名保留历史上的 x64 标记；正文对 arm64/x64 都有 syscall 号分支，因此按
// OS 级 tag 声明（Linux 两个架构都跑，Darwin 上 SKIP）。

// HostTimespec：clock_gettime 返回的秒与纳秒字段。
struct HostTimespec {
    sec i64
    nsec i64
}

// host_mkdir：按当前 Linux ISA 调用 mkdir syscall。
fn host_mkdir(path *char) i64 {
    $if (arm64) {
        return linux_syscall6(34.to_type(u64), (-100).to_type(u64),
            path.to_type(u64), 493.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(83.to_type(u64), path.to_type(u64),
            493.to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// host_open_file：在目标目录创建并截断探针文件。
fn host_open_file(path *char) i64 {
    $if (arm64) {
        return linux_syscall6(56.to_type(u64), (-100).to_type(u64),
            path.to_type(u64), 577.to_type(u64), 420.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(257.to_type(u64), (-100).to_type(u64),
            path.to_type(u64), 577.to_type(u64), 420.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// host_getdents：读取 Linux getdents64 目录项缓冲。
fn host_getdents(fd int, buf *u8, cap int) i64 {
    $if (arm64) {
        return linux_syscall6(61.to_type(u64), fd.to_type(u64),
            buf.to_type(u64), cap.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(217.to_type(u64), fd.to_type(u64),
            buf.to_type(u64), cap.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// host_close：关闭 Linux 文件描述符。
fn host_close(fd int) i64 {
    $if (arm64) {
        return linux_syscall6(57.to_type(u64), fd.to_type(u64),
            0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(3.to_type(u64), fd.to_type(u64),
            0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// host_write：直接通过 Linux write syscall 写入探针内容。
fn host_write(fd int, data *char, size int) i64 {
    $if (arm64) {
        return linux_syscall6(64.to_type(u64), fd.to_type(u64),
            data.to_type(u64), size.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(1.to_type(u64), fd.to_type(u64),
            data.to_type(u64), size.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// host_clock：读取 Linux CLOCK_MONOTONIC 单调时钟。
fn host_clock(stamp *HostTimespec) i64 {
    $if (arm64) {
        return linux_syscall6(113.to_type(u64), 1.to_type(u64),
            stamp.to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        return linux_syscall6(228.to_type(u64), 1.to_type(u64),
            stamp.to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
}

// main：核对路径字节、getdents64 记录、时钟和 waitpid 状态。
fn main() int {
    // 干净检出/CI 没有 tmp/llvm-migration；先建父目录，避免用例依赖
    // 本机构建残留（mkdir 返回 -17 = 已存在）。
    let tmp_result i64 = host_mkdir("tmp")
    if (tmp_result != 0 && tmp_result != -17) { return 16 }
    let migration_result i64 = host_mkdir("tmp/llvm-migration")
    if (migration_result != 0 && migration_result != -17) { return 17 }
    let root *char = "tmp/llvm-migration/host-probe-目录"
    let nested *char = "tmp/llvm-migration/host-probe-目录/space dir"
    let child *char = "tmp/llvm-migration/host-probe-目录/space dir/child"
    let root_result i64 = host_mkdir(root)
    if (root_result != 0 && root_result != -17) { return 1 }
    let parent_result i64 = host_mkdir(nested)
    if (parent_result != 0 && parent_result != -17) { return 2 }
    let child_result i64 = host_mkdir(child)
    if (child_result != 0 && child_result != -17) { return 3 }
    let file *char = "tmp/llvm-migration/host-probe-目录/space dir/child/probe.txt"
    let fd i64 = host_open_file(file)
    if (fd < 0 || host_write(fd.to_type(int), "ok", 2) != 2
        || host_close(fd.to_type(int)) != 0) { return 4 }
    let libc_fd int = open(file, 577, 420)
    if (libc_fd < 0 || close(libc_fd) != 0) { return 13 }

    let dir i64 = 0
    $if (arm64) {
        dir = linux_syscall6(56.to_type(u64), (-100).to_type(u64),
            child.to_type(u64), 0x4000.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    } $else {
        dir = linux_syscall6(257.to_type(u64), (-100).to_type(u64),
            child.to_type(u64), 0x10000.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
    }
    if (dir < 0) { return 5 }
    let entries [4096]u8
    let count i64 = host_getdents(dir.to_type(int), &entries[0], 4096)
    if (count <= 0) { return 6 }
    let found int = 0
    let pos int = 0
    for pos < count.to_type(int) {
        if (count.to_type(int) - pos < 20) { return 7 }
        let record int = entries[pos + 16].to_type(int) |
            (entries[pos + 17].to_type(int) << 8)
        if (record < 20 || record > count.to_type(int) - pos) { return 8 }
        let name *char = (&entries[pos + 19]).to_type(*char)
        if (name[0] == 'p' && name[1] == 'r' && name[2] == 'o'
            && name[3] == 'b' && name[4] == 'e' && name[5] == '.'
            && name[6] == 't' && name[7] == 'x' && name[8] == 't'
            && name[9] == 0) { found = 1 }
        pos += record
    }
    if (found == 0 || host_close(dir.to_type(int)) != 0) { return 9 }

    let before HostTimespec
    let after HostTimespec
    if (host_clock(&before) != 0 || host_clock(&after) != 0
        || after.sec < before.sec
        || after.sec == before.sec && after.nsec < before.nsec) { return 10 }
    let pid int = fork()
    if (pid < 0) { return 11 }
    if (pid == 0) { exit(37) }
    let status int = 0
    if (waitpid(pid, &status, 0) != pid || (status >> 8) != 37) { return 12 }
    let exec_args [2]*char
    exec_args[0] = "/bin/true"
    exec_args[1] = 0.to_type(*char)
    let exec_pid int = fork()
    if (exec_pid < 0) { return 14 }
    if (exec_pid == 0) {
        execvp(exec_args[0], &exec_args[0])
        exit(127)
    }
    status = 0
    if (waitpid(exec_pid, &status, 0) != exec_pid || status != 0) { return 15 }
    printf("llvm-linux-x64-host=ok\n")
    return 0
}
