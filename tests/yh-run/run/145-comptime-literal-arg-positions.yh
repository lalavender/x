// expect: literal-arg=713
// exit: 0
// 直接写在编译期调用实参里的字符串字面量：顶层 const、全局变量初始化与普通函数体
// 三处的实参都由前端直接求值成数据标签号，编译期过程按标签号查前端登记的
// 原样字节映射后登记只读池。多实参混合标量也一并覆盖。
// 折算：A='x'+'y'+3=244 + G='z'+'w'+0=241 + normal()='q'+'r'+1=228 → 713。

// sum_head：两个字符串指针实参加一个标量实参。
@[comptime]
fn sum_head(a *char, b *char, n int) int {
    return (*a).to_type(int) + (*b).to_type(int) + n;
}

const A int = $sum_head("x", "y", 3);
let G int = $sum_head("z", "w", 0);

// normal：普通（非编译期）函数体里的编译期调用。
fn normal() int {
    return $sum_head("q", "r", 1);
}

fn main() int {
    printf("literal-arg=%d\n", A + G + normal());
    return 0;
}
