// exit: 0
// 不同函数的浮点复合赋值临时槽必须独立登记在各自静态帧中。
fn first(v f64) f64 {
    let padding [4]int;
    padding[0] = 1;
    v += 2.0;
    return v + padding[0].to_type(f64);
}
fn second(v f32) f32 { v += 3.0.to_type(f32); return v; }
fn main() int {
    if (first(1.0) != 4.0) { return 1; }
    if (second(2.0.to_type(f32)) != 5.0.to_type(f32)) { return 2; }
    return 0;
}
