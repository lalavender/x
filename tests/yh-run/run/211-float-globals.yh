// expect: float-globals=ok
// NP3-G3 回归：浮点全局。
// 修复前 backend/llvm_module.yh 的 llvm_preflight 直接拒绝 f32/f64 全局
// （「尚不支持浮点全局」）；放开后发现 f32 初始化字节按双精度位模式写进 4 字节，
// 读回 0——常量浮点在所有折叠路径都以 f64 位模式保存，写静态标量前必须按目标
// 类型窄化（parse/parse_global_static.yh，共用 gen.fp32_bits）。
let SCALE f64 = 1.5
let HALF f32 = 2.5.to_type(f32)
let COUNTER f64 = 0.25
let ZERO_F64 f64
let ZERO_F32 f32
let TABLE [3]f32 = [1.5.to_type(f32), 2.5.to_type(f32), 3.5.to_type(f32)]

fn main() int {
    // 初始化值与位模式（f32 必须写单精度 32 位，不能只截 f64 低 4 字节）。
    if (SCALE != 1.5) { return 1 }
    if (HALF != 2.5.to_type(f32)) { return 2 }
    let half_bits *u32 = (&HALF).to_type(*u32)
    if (half_bits[0] != 0x40200000) { return 3 }
    if (ZERO_F64 != 0.0 || ZERO_F32 != 0.0.to_type(f32)) { return 4 }

    // 运行期写回与复合赋值。
    COUNTER += SCALE
    if (COUNTER != 1.75) { return 5 }
    ZERO_F64 = 3.25
    if (ZERO_F64 != 3.25) { return 6 }
    ZERO_F32 = 0.5.to_type(f32)
    if (ZERO_F32 != 0.5.to_type(f32)) { return 7 }

    // 读取参与运算与显式转换。
    if (SCALE * 2.0 != 3.0) { return 8 }
    if (SCALE.to_type(int) != 1) { return 9 }
    if (!(COUNTER > SCALE)) { return 10 }

    // 浮点元素数组全局。
    if (TABLE[0] != 1.5.to_type(f32) || TABLE[2] != 3.5.to_type(f32)) { return 11 }
    let last_bits *u32 = (&TABLE[2]).to_type(*u32)
    if (last_bits[0] != 0x40600000) { return 12 }

    printf("float-globals=ok\n")
    return 0
}
