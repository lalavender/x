// expect: type-length-expression=6
// exit: 0
// pass1 保存完整长度表达式，等 typed CT 依赖就绪后执行显式调用和算术。

@[comptime]
fn bump_type_length(value int) int {
    return value + 1;
}

@[comptime]
fn base_type_length() int {
    let index int = 0;
    let total int = 0;
    for index < 2 {
        total += 1;
        index += 1;
    }
    return total;
}

const BASE_TYPE_LENGTH int = $base_type_length();

pub struct TypeLengthExpressionPacket {
    values [$bump_type_length(BASE_TYPE_LENGTH) * 2]int;
}

fn main() int {
    let packet TypeLengthExpressionPacket;
    if (len(packet.values) == 6 && sizeof(TypeLengthExpressionPacket) == 24) {
        printf("type-length-expression=%d\n", len(packet.values));
        return 0;
    }
    return 1;
}
