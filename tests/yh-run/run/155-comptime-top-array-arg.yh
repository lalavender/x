// exit: 0
// run/155：顶层编译期调用的数组聚合实参（含数组字段与嵌套数组，递归折叠）。
// Row：含数组字段的结构体。
pub struct Row {
    cells [3]int
    tag int
}

// sum3：单数组形参。
@[comptime]
fn sum3(a [3]int) int {
    return a[0] + a[1] + a[2]
}

// rowsum：数组字段所在的结构体形参。
@[comptime]
fn rowsum(r Row) int {
    return r.cells[0] + r.cells[1] + r.cells[2] + r.tag
}

// gsum：嵌套数组形参（取对角两个元素）。
@[comptime]
fn gsum(g [2][2]int) int {
    return g[0][0] + g[1][0]
}

// 顶层数组字面量实参 → 10+20+30 = 60
const R1 int = $sum3([10, 20, 30])
// 结构体里的数组字段 → 1+2+3+4 = 10
const R2 int = $rowsum(Row{ tag: 4, cells: [1, 2, 3] })
// 嵌套数组字面量 → 1+3 = 4
const R3 int = $gsum([[1, 2], [3, 4]])

fn main() int {
    return R1 - 60 + R2 - 10 + R3 - 4
}
