// expect: comptime-nested-array-fields=403
// exit: 0
// 编译期结构体的多维定长整型数组字段应递归初始化、复制并支持深层下标写入。

pub struct Grid {
    rows [2][2]int;
}

// nested_array_copy：验证多维局部数组与结构体副本的深层值隔离。
@[comptime]
fn nested_array_copy() int {
    let rows [2][2]int = [[1, 2], [3, 4]];
    let rows_copy [2][2]int = rows;
    rows[1][0] = 6;
    let original Grid = Grid{ rows: rows_copy };
    let duplicate Grid = original;
    duplicate.rows[1][0] = 9;
    duplicate.rows[0][1] += 5;
    return original.rows[1][0] * 100 +
        duplicate.rows[1][0] * 10 + duplicate.rows[0][1] +
        rows[1][0];
}

const RESULT int = $nested_array_copy();

fn main() int {
    printf("comptime-nested-array-fields=%d\n", RESULT);
    return 0;
}
