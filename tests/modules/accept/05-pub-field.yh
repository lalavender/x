// pub struct 一等化：字段一律公开（不再书写字段级 pub 前缀），
// pub fn 与 pub struct 同文件共存。
module geom;

pub struct Point {
    x int;
    y int;
    tag int;
}

pub fn make(x int, y int) Point {
    let p Point;
    p.x = x;
    p.y = y;
    p.tag = 0;
    return p;
}

fn helper(p Point) int {
    return p.x + p.y + p.tag;
}
