// 限定类型 m.T 与限定值 m.f 的纯语法接受（模块语义在 MOD-U3）。
module main;

import math;

struct Pair {
    a int;
    b int;
}

fn scale(p Pair, k int) math.Vec {
    let v math.Vec = math.make(k, k + 1);
    return v;
}

fn main() int {
    let p Pair;
    p.a = 1;
    p.b = 2;
    let w math.Vec = scale(p, 3);
    return p.a + p.b + w.x;
}
