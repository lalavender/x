module main;

import io;
import os;

// 跨平台验证 io.write_all_result 的完整写入、零长度、非法长度、坏 fd 与
// 旧 write_all 契约。成功输出由 write_all_result 自身写出，避免重复打印。
pub fn main() int {
    let full os.IoResult = io.write_all_result(1, "os io ok\n", 9);
    if (full.count != 9 || full.error.kind != os.error_none) {
        return 1;
    }
    let empty os.IoResult = io.write_all_result(1, "", 0);
    if (empty.count != 0 || empty.error.kind != os.error_none) {
        return 2;
    }
    let bad os.IoResult = io.write_all_result(-1, "x", 1);
    if (bad.count != 0 || bad.error.kind != os.error_other) {
        return 3;
    }
    let negative os.IoResult = io.write_all_result(1, "x", -1);
    if (negative.count != 0
        || negative.error.kind != os.error_invalid_argument
        || negative.error.native_code != 0) {
        return 4;
    }
    if (io.write_all(-1, "x", 1) != -1
        || io.write_all(1, "", 0) != 0
        || io.write_all(1, "x", -1) != -1) {
        return 5;
    }
    return 0;
}
