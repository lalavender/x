module main;

import io;
import math;
import memory;
import os;
import string;
import time;

// main 覆盖基础标准库模块的导入、内存/字符串、OS 文件和进程、数学及单调时钟。
fn main() int {
    if (string.length("hé") != 3 || string.equals("yh", "yh") != 1
        || string.equals("yh", "YH") != 0
        || string.compare("a", "b") != -1
        || string.compare("b", "a") != 1
        || string.compare("yh", "yh") != 0) {
        return 1;
    }

    let buffer *char = memory.alloc(5).to_type(*char);
    if (buffer == 0) {
        return 2;
    }
    memory.copy(buffer.to_type(*void), "copy", 5);
    if (string.equals(buffer, "copy") != 1) {
        memory.release(buffer.to_type(*void));
        return 3;
    }
    memory.release(buffer.to_type(*void));
    memory.release(0);
    let error_buffer *void = memory.alloc(1);
    if (error_buffer == 0) {
        return 16;
    }
    if (os.open_file(".yh-stdlib-missing", 0) != -1
        || os.read_fd(-1, error_buffer, 1) != -1
        || os.write_fd(-1, error_buffer, 1) != -1
        || os.close_fd(-1) != -1
        || os.sleep_us(-1) != -1) {
        memory.release(error_buffer);
        return 16;
    }
    memory.release(error_buffer);

    if (math.sqrt_f64(81.0) != 9.0 || math.sin_f64(0.0) != 0.0
        || math.cos_f64(0.0) != 1.0 || math.pow_f64(2.0, 3.0) != 8.0) {
        return 4;
    }

    // 宿主平台的文件创建标志：Darwin 的 O_WRONLY|O_CREAT|O_TRUNC = 0x601，
    // Linux 同一组合是 0x241（O_CREAT 位值不同）——按编译期目标常量选（CT0）。
    let wflags int = 0x241;
    $if (darwin) {
        wflags = 0x601;
    }
    let first_fd int = os.open_file_mode(".yh-stdlib-a", wflags, 420);
    if (first_fd < 0) {
        return 5;
    }
    if (os.write_fd(first_fd, "x", 1) != 1 || os.close_fd(first_fd) != 0) {
        return 6;
    }
    if (os.rename_file(".yh-stdlib-a", ".yh-stdlib-b") != 0) {
        return 7;
    }
    let second_fd int = os.open_file(".yh-stdlib-b", 0);
    if (second_fd < 0) {
        return 8;
    }
    let read_buffer *char = memory.alloc(1).to_type(*char);
    if (read_buffer == 0) {
        os.close_fd(second_fd);
        return 9;
    }
    if (os.read_fd(second_fd, read_buffer.to_type(*void), 1) != 1
        || read_buffer[0] != 'x') {
        memory.release(read_buffer.to_type(*void));
        os.close_fd(second_fd);
        return 10;
    }
    memory.release(read_buffer.to_type(*void));
    if (os.close_fd(second_fd) != 0 || os.remove_file(".yh-stdlib-b") != 0) {
        return 11;
    }
    if (os.create_dir(".yh-stdlib-dir", 493) != 0) {
        return 12;
    }
    if (os.create_dir(".yh-stdlib-dir", 493) != -1
        || os.remove_dir(".yh-stdlib-dir") != 0
        || os.rename_file(".yh-stdlib-missing", ".yh-stdlib-other") != -1
        || os.remove_file(".yh-stdlib-missing") != -1) {
        return 17;
    }
    if (os.process_id() <= 0 || os.sleep_us(0) != 0) {
        return 13;
    }

    let before i64 = time.monotonic_ns();
    let after i64 = time.monotonic_ns();
    if (before <= 0 || after < before) {
        return 14;
    }
    if (io.println("yh libs base ok") != 0) {
        return 15;
    }
    os.terminate(0);
    return 16;
}
