module main;

import sys;

// sysresult 验证 sys 的结果模型与 Timespec 布局；不发起系统调用，
// 因此可以在 Linux 与 Darwin 宿主共同运行。
fn main() int {
    // Timespec 必须是 16 字节，字段偏移依次为 0/8。
    let stamp sys.Timespec;
    stamp.sec = 7;
    stamp.nsec = 8;
    if (sizeof(sys.Timespec) != 16) {
        return 1;
    }
    let base u64 = (&stamp).to_type(u64);
    let nsec_at u64 = (&stamp.nsec).to_type(u64);
    if (nsec_at - base != 8 || stamp.sec != 7 || stamp.nsec != 8) {
        return 2;
    }

    // 错误区间只包含 [-4095, -1]；0、正数与 -4096 都不是错误。
    if (sys.is_error(0) != 0 || sys.is_error(1) != 0
        || sys.is_error(-1) != 1 || sys.is_error(-4095) != 1
        || sys.is_error(-4096) != 0) {
        return 3;
    }

    // error_code 提取正错误号，成功归零；普通负数不产生错误号。
    if (sys.error_code(-1) != 1 || sys.error_code(-4095) != 4095
        || sys.error_code(0) != 0 || sys.error_code(7) != 0
        || sys.error_code(-4096) != 0) {
        return 4;
    }

    printf("sys result ok\n");
    return 0;
}
