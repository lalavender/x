module main;
import support
import gen;
import proj;

// main：真实跨模块消费目标身份，未知 triple 不修改出参；输出目标不能改变编译器宿主身份。
fn main() int {
    proj.init();
    support.bind_cfg(proj.cfg());
    let target gen.TargetInfo;
    if (support.target_resolve("x86_64-unknown-linux-gnu", &target) != 0
        || target.os != gen.TARGET_OS_LINUX || target.arch != gen.TARGET_ARCH_X64
        || target.pointer_bits != 64 || target.little_endian != 1
        || target.layout_version != 1 || support.cstr_eq(target.abi, "sysv-amd64") == 0
        || target.data_layout[0] != 'e') { return 1; }
    if (support.target_resolve("unsupported-unknown-linux-gnu", &target) == 0
        || support.cstr_eq(target.triple, "x86_64-unknown-linux-gnu") == 0) { return 2; }
    if (support.target_resolve("aarch64-unknown-linux-gnu", &target) != 0
        || target.arch != gen.TARGET_ARCH_ARM64 || support.cstr_eq(target.abi, "aapcs64") == 0) { return 3; }
    if (support.target_resolve("x86_64-apple-darwin", &target) != 0
        || target.os != gen.TARGET_OS_DARWIN || target.arch != gen.TARGET_ARCH_X64) { return 4; }
    if (support.target_resolve("aarch64-apple-darwin", &target) != 0
        || target.os != gen.TARGET_OS_DARWIN || target.arch != gen.TARGET_ARCH_ARM64) { return 5; }
    let host gen.TargetInfo;
    let after gen.TargetInfo;
    if (support.target_host_info(&host) != 0
        || support.target_select("x86_64-unknown-linux-gnu") != 0
        || support.target_host_info(&after) != 0
        || host.arch != after.arch || host.os != after.os
        || support.cstr_eq(host.triple, after.triple) == 0) { return 6; }
    printf("target-model=ok\n");
    return 0;
}
