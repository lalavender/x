module main;

// expanded_sum：检查普通函数 `$for` 的每轮只读绑定和嵌套 `$if` AST 展开。
fn expanded_sum() int {
    let total int = 0;
    $for i in (0..4) {
        $if (i % 2 == 0) {
            total += i + 1;
        } $else {
            total += i * 2;
        }
    }
    return total;
}

fn expanded_template_sum() int {
    let total int = 0;
    $for i in (0..4) {
        let twice int = i * 2;
        if (i % 2 == 0) {
            total += twice + 1;
        } else {
            total += twice;
        }
    }
    return total;
}

fn main() int {
    return expanded_sum() + expanded_template_sum() - 26;
}
