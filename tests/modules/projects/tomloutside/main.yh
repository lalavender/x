module main

// TOML T5.1 安装验收：从仓库外、无 YH_STDLIB 环境变量，使用安装后的
// yh 与 share/yh/libs 默认发现运行，并读取同目录配置文件。

import io
import toml

pub fn main() int {
    let result toml.ParseResult = toml.read_file("config.toml")
    if (result.status != toml.parse_ok) {
        io.print("read failed: ")
        io.println(result.error.message)
        return 1
    }
    let root toml.Value = toml.root(&result.document)
    let server toml.LookupResult = toml.get(root, "server")
    let port toml.LookupResult = toml.get(server.value, "port")
    let number i64 = 0
    if (toml.as_i64(port.value, &number) != toml.query_ok || number != 9000) {
        toml.release(&result.document)
        return 2
    }
    let title toml.LookupResult = toml.get(root, "title")
    let text toml.Text
    if (toml.as_text(title.value, &text) != toml.query_ok || text.count != 9) {
        toml.release(&result.document)
        return 3
    }
    toml.release(&result.document)
    io.println("toml outside ok")
    return 0
}
