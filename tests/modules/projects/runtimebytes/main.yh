module main;

// 分配、释放、复制和字符串长度入口由自有运行时提供，不应成为 libc 导入。
// first：为被复制的十七字节数据提供固定目标缓冲区。
let first [17]char;
// second：接收不同长度复制结果并验证返回指针与尾部字节。
let second [17]char;

// main：验证自有分配器、格式化输出与字节/字符串运行时边界。
fn main() int {
    // 自有分配器结果须保留 16 字节对齐，并支持释放与边界读写。
    let allocated *u8 = malloc(33).to_type(*u8);
    if (allocated == 0) {
        return 13;
    }
    if ((allocated.to_type(u64) & 15) != 0) {
        return 14;
    }
    allocated[0] = 65;
    allocated[32] = 90;
    if (allocated[0] != 65 || allocated[32] != 90) {
        return 15;
    }
    free(allocated.to_type(*void));
    let alloc fn(u64) *void = malloc;
    let release fn(*void) void = free;
    let zero *void = alloc(0);
    if (zero == 0) {
        return 16;
    }
    release(zero);
    let null *void = 0.to_type(*void);
    free(null);
    release(alloc(48));

    let copy fn(*void, *void, u64) *void = memcpy;
    let length fn(*char) u64 = strlen;
    let first_address *void = memcpy(first, "0123456789abcdef", 17);
    if (first_address != (&first[0]).to_type(*void)) {
        return 4;
    }
    if (strlen("") != 0) {
        return 5;
    }
    if (strlen("雪") != 3) {
        return 7;
    }
    memcpy(second, first, 0);
    if (second[0] != 0) {
        return 8;
    }
    memcpy(second, first, 8);
    if (second[7] != '7' || second[8] != 0) {
        return 9;
    }
    memcpy(second, first, 9);
    if (second[8] != '8' || second[9] != 0) {
        return 10;
    }
    memcpy(second, first, 16);
    if (second[15] != 'f' || second[16] != 0) {
        return 11;
    }
    if (strlen(first) != 16) {
        return 1;
    }
    if (strlen(&first[1]) != 15) {
        return 12;
    }
    let second_address *void = copy(second, first, 17);
    if (second_address != (&second[0]).to_type(*void)) {
        return 6;
    }
    if (length(second) != 16) {
        return 2;
    }
    if (second[0] != '0' || second[7] != '7' || second[8] != '8'
        || second[15] != 'f' || second[16] != 0) {
        return 3;
    }
    let formatted int = printf("fmt:%d %u %lld %llu %s %c %%\n", -7,
        8.to_type(u32), (-9).to_type(i64), 10.to_type(u64), "str", 'A');
    if (formatted != 23) {
        return 17;
    }
    let many int = printf("args:%d%d%d%d%d%d%d%d\n", 1, 2, 3, 4, 5, 6, 7, 8);
    if (many != 14) {
        return 18;
    }
    let large [300]char;
    let pos int = 0;
    for pos < 299 {
        large[pos] = 'x';
        pos += 1;
    }
    large[299] = 0;
    if (printf("%s", &large[0]) != 299) {
        return 19;
    }
    return 0;
}
