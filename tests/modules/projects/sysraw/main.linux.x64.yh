module main;

import sys;

// indirect 通过函数值间接调用 sys.raw6，验证跨模块函数值仍走本地入口。
fn indirect(callback fn(u64, u64, u64, u64, u64, u64, u64) i64,
    number u64) i64 {
    return callback(number, 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// main 验证 Linux/x86_64 raw6：getpid、函数值调用、坏 fd 与未知调用号。
pub fn main() int {
    let pid i64 = sys.raw6(39.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64));
    if (pid <= 0) {
        return 1;
    }
    let callback fn(u64, u64, u64, u64, u64, u64, u64) i64 = sys.raw6;
    if (indirect(callback, 39.to_type(u64)) <= 0) {
        return 2;
    }
    // write(-1, NULL, 0) 仍必须由内核判定为 EBADF，不能因为长度为零提前成功。
    let bad i64 = sys.raw6(1.to_type(u64), (-1).to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64));
    if (sys.is_error(bad) != 1 || sys.error_code(bad) != sys.EBADF) {
        return 3;
    }
    let missing i64 = sys.raw6(99999.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64));
    if (sys.is_error(missing) != 1 || sys.error_code(missing) != sys.ENOSYS) {
        return 4;
    }
    printf("sys raw ok\n");
    return 0;
}
