module main

// TOML T2 标量验收：i64 边界/进制、binary64 位模式、布尔与四种时间类型。

import io
import toml

let failed int = 0

// ok 记录一条断言结果。
fn ok(condition int, name *char) void {
    if (condition == 0) {
        failed += 1
        io.print("FAIL ")
        io.println(name)
    }
}

// f64_bits 读取 f64 的 IEEE754 位模式。
fn f64_bits(value f64) i64 {
    let holder *f64 = malloc(8).to_type(*f64)
    holder[0] = value
    let view *i64 = holder.to_type(*i64)
    let bits i64 = view[0]
    free(holder.to_type(*void))
    return bits
}

// main 跑标量断言；每个用例单独解析，避免释放后使用。
pub fn main() int {
    // i64 边界与进制。
    let ints toml.ParseResult = toml.parse_text(
        "max = 9223372036854775807\nmin = -9223372036854775808\nhex = 0x7f_ff\n\noct = 0o777\nbin = 0b1010\nplus = +42\n")
    ok((ints.status == toml.parse_ok).to_type(int), "ints parse")
    let ints_root toml.Value = toml.root(&ints.document)
    let max i64 = 0
    let min i64 = 0
    toml.as_i64(toml.get(ints_root, "max").value, &max)
    toml.as_i64(toml.get(ints_root, "min").value, &min)
    ok((max == 9223372036854775807).to_type(int), "i64 max")
    ok((min == -9223372036854775807 - 1).to_type(int), "i64 min")
    let hex i64 = 0
    let oct i64 = 0
    let bin i64 = 0
    let plus i64 = 0
    toml.as_i64(toml.get(ints_root, "hex").value, &hex)
    toml.as_i64(toml.get(ints_root, "oct").value, &oct)
    toml.as_i64(toml.get(ints_root, "bin").value, &bin)
    toml.as_i64(toml.get(ints_root, "plus").value, &plus)
    ok((hex == 32767 && oct == 511 && bin == 10 && plus == 42).to_type(int),
        "integer bases")
    toml.release(&ints.document)

    // 整数越界与非法写法。
    let over toml.ParseResult = toml.parse_text("x = 9223372036854775808")
    ok((over.status == toml.parse_syntax_error
        && over.error.code == toml.error_integer_range).to_type(int),
        "integer overflow")
    toml.release(&over.document)
    let hex_over toml.ParseResult = toml.parse_text("x = 0x8000000000000000")
    ok((hex_over.status == toml.parse_syntax_error
        && hex_over.error.code == toml.error_integer_range).to_type(int),
        "hex overflow")
    toml.release(&hex_over.document)
    let signed_hex toml.ParseResult = toml.parse_text("x = +0x1")
    ok((signed_hex.status == toml.parse_syntax_error).to_type(int),
        "signed hex")
    toml.release(&signed_hex.document)
    let leading_zero toml.ParseResult = toml.parse_text("x = 01")
    ok((leading_zero.status == toml.parse_syntax_error).to_type(int),
        "leading zero")
    toml.release(&leading_zero.document)
    let bad_underscore toml.ParseResult = toml.parse_text("x = 1__2")
    ok((bad_underscore.status == toml.parse_syntax_error).to_type(int),
        "double underscore")
    toml.release(&bad_underscore.document)

    // binary64 特殊值与位模式。
    let floats toml.ParseResult = toml.parse_text(
        "half = 1.5\nnegzero = -0.0\ntenth = 0.1\nsub = 5e-324\npinf = inf\nninf = -inf\nnanv = nan\nexp = 3e2\n")
    ok((floats.status == toml.parse_ok).to_type(int), "floats parse")
    let floats_root toml.Value = toml.root(&floats.document)
    let half f64 = 0.0
    let negzero f64 = 0.0
    let tenth f64 = 0.0
    let sub f64 = 0.0
    let pinf f64 = 0.0
    let ninf f64 = 0.0
    let nanv f64 = 0.0
    let exp f64 = 0.0
    toml.as_f64(toml.get(floats_root, "half").value, &half)
    toml.as_f64(toml.get(floats_root, "negzero").value, &negzero)
    toml.as_f64(toml.get(floats_root, "tenth").value, &tenth)
    toml.as_f64(toml.get(floats_root, "sub").value, &sub)
    toml.as_f64(toml.get(floats_root, "pinf").value, &pinf)
    toml.as_f64(toml.get(floats_root, "ninf").value, &ninf)
    toml.as_f64(toml.get(floats_root, "nanv").value, &nanv)
    toml.as_f64(toml.get(floats_root, "exp").value, &exp)
    ok((f64_bits(half) == 4609434218613702656).to_type(int), "1.5 bits")
    ok((f64_bits(negzero) == -9223372036854775807 - 1).to_type(int),
        "negative zero bits")
    ok((f64_bits(tenth) == 4591870180066957722).to_type(int), "0.1 bits")
    ok((f64_bits(sub) == 1).to_type(int), "min subnormal bits")
    ok((f64_bits(pinf) == 9218868437227405312).to_type(int), "inf bits")
    ok((f64_bits(ninf) == -4503599627370496).to_type(int), "negative inf bits")
    ok(((f64_bits(nanv) & 9218868437227405312)
        == 9218868437227405312).to_type(int), "nan exponent")
    ok(((f64_bits(nanv) & 4503599627370495) != 0).to_type(int), "nan payload")
    ok((f64_bits(exp) == 4643985272004935680).to_type(int), "3e2 bits")
    toml.release(&floats.document)

    // 有限字面量上溢必须报错，不能静默变成 inf。
    let over_float toml.ParseResult = toml.parse_text("x = 1e309")
    ok((over_float.status == toml.parse_syntax_error
        && over_float.error.code == toml.error_float_range).to_type(int),
        "float overflow")
    toml.release(&over_float.document)
    let under_float toml.ParseResult = toml.parse_text("x = -1e-999999")
    ok((under_float.status == toml.parse_ok).to_type(int), "float underflow parse")
    let under_root toml.Value = toml.root(&under_float.document)
    let under f64 = 1.0
    toml.as_f64(toml.get(under_root, "x").value, &under)
    ok((f64_bits(under) == -9223372036854775807 - 1).to_type(int),
        "negative underflow zero")
    toml.release(&under_float.document)

    // 布尔必须完整匹配。
    let bools toml.ParseResult = toml.parse_text("a = true\nb = false\n")
    let bools_root toml.Value = toml.root(&bools.document)
    let yes bool = false
    let no bool = true
    ok((toml.as_bool(toml.get(bools_root, "a").value, &yes) == toml.query_ok
        && yes == true).to_type(int), "true")
    ok((toml.as_bool(toml.get(bools_root, "b").value, &no) == toml.query_ok
        && no == false).to_type(int), "false")
    toml.release(&bools.document)
    let bad_bool toml.ParseResult = toml.parse_text("a = true1")
    ok((bad_bool.status == toml.parse_syntax_error).to_type(int), "true1")
    toml.release(&bad_bool.document)
    let upper_bool toml.ParseResult = toml.parse_text("a = TRUE")
    ok((upper_bool.status == toml.parse_syntax_error).to_type(int), "TRUE")
    toml.release(&upper_bool.document)

    // 四种时间类型与 1.1 省略秒；as_temporal 返回原文。
    let times toml.ParseResult = toml.parse_text(
        "odt = 1979-05-27T07:32:00.123Z\nldt = 1979-05-27 07:32\nd = 1979-05-27\nt = 13:37\n")
    ok((times.status == toml.parse_ok).to_type(int), "times parse")
    let times_root toml.Value = toml.root(&times.document)
    let odt toml.LookupResult = toml.get(times_root, "odt")
    let ldt toml.LookupResult = toml.get(times_root, "ldt")
    let d toml.LookupResult = toml.get(times_root, "d")
    let t toml.LookupResult = toml.get(times_root, "t")
    ok((toml.kind(odt.value) == toml.kind_offset_datetime).to_type(int),
        "offset datetime")
    ok((toml.kind(ldt.value) == toml.kind_local_datetime).to_type(int),
        "local datetime")
    ok((toml.kind(d.value) == toml.kind_local_date).to_type(int), "local date")
    ok((toml.kind(t.value) == toml.kind_local_time).to_type(int), "local time")
    let raw toml.Text
    toml.as_temporal(t.value, &raw)
    ok((raw.count == 5 && raw.data[0] == '1' && raw.data[1] == '3').to_type(int),
        "local time raw text")
    let string_query toml.Text
    ok((toml.as_text(t.value, &string_query) == toml.query_type_error).to_type(int),
        "temporal is not string")
    toml.release(&times.document)

    // 失败不修改 out 参数。
    let keep toml.ParseResult = toml.parse_text("s = \"x\"\ni = 7\n")
    let keep_root toml.Value = toml.root(&keep.document)
    let number i64 = 42
    let status toml.QueryStatus = toml.as_i64(
        toml.get(keep_root, "s").value, &number)
    ok((status == toml.query_type_error && number == 42).to_type(int),
        "as_i64 leaves out")
    let real f64 = 2.5
    ok((toml.as_f64(toml.get(keep_root, "i").value, &real)
        == toml.query_type_error && real == 2.5).to_type(int),
        "as_f64 leaves out")
    let scalar_count u64 = 9
    ok((toml.count(toml.get(keep_root, "i").value, &scalar_count)
        == toml.query_type_error && scalar_count == 9).to_type(int),
        "count scalar")
    toml.release(&keep.document)

    if (failed != 0) {
        return 1
    }
    io.println("toml scalars ok")
    return 0
}
