module gen;

pub struct Tok {
    pub kind int;
    pub start int;
    secret int;
}

pub let counter int = 0;

pub fn bump() int {
    counter += 1;
    return counter;
}

pub fn with_tok() int {
    let t Tok;
    t.kind = 5;
    t.secret = 1;
    return t.kind + t.secret;
}

fn hidden() int {
    return 100;
}

pub fn via_hidden() int {
    return hidden() + 1;
}
