module gen;

pub struct Tok {
    kind int;
    start int;
    secret int;
}

// 2026-10-02「let 不导出」：可变全局私有，经 pub fn 读写（替代原 pub let counter）。
let counter int = 0;

pub fn counter_value() int {
    return counter;
}

pub fn set_counter(v int) void {
    counter = v;
}

pub fn bump() int {
    counter += 1;
    return counter;
}

pub fn with_tok() int {
    let t Tok;
    t.kind = 5;
    t.secret = 1;
    return t.kind + t.secret;
}

fn hidden() int {
    return 100;
}

pub fn via_hidden() int {
    return hidden() + 1;
}
