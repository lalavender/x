module main;

// 加法常量表达式应构造一条可简化的 SSA 函数。
fn sum() int {
    return 19 + 23;
}

// 减法常量表达式覆盖第二种整数运算。
fn difference() int {
    return 50 - 8;
}

// 乘法常量表达式覆盖第三种整数运算。
fn product() int {
    return 6 * 7;
}

// 布尔相等比较验证 SSA 比较结果类型。
fn equal() bool {
    return 42 == 42;
}

// 参数值作为局部初值并由 return 读取，验证参数与局部 SSA 编号连续。
fn from_param(value int) int {
    let result int = value + 1;
    value = result;
    return value;
}

// 条件比较与两个返回块形成最小三块 CFG，覆盖 true 分支。
fn choose_true() int {
    if (19 + 23 == 42) {
        return 19 + 23;
    } else {
        return 0;
    }
}

// 常量 false 条件覆盖条件分支的另一条可执行边。
fn choose_false() int {
    if (false) {
        return 99;
    } else {
        return 8;
    }
}

// 不同函数可从零编号自己的局部绑定，验证函数上下文不会串用 arena 行。
fn local_left() int {
    let item int = 13;
    item += 1;
    item *= 2;
    item -= 1;
    return item;
}

// 重复局部名与绑定编号只在当前函数上下文内解释。
fn local_right() int {
    let first int = 29;
    let item int = first + 1;
    return item;
}

// 两侧分别更新参数后在合流点返回，验证控制流赋值产生 phi。
fn branch_update(value int, condition bool) int {
    if (condition) {
        value += 5;
    } else {
    }
    return value;
}

// 合流 phi 也可合并 if 之前初始化的局部变量版本。
fn branch_local(condition bool) int {
    let value int = 40;
    if (condition) {
        value -= 3;
    } else {
        value += 2;
    }
    return value;
}

// 双参数函数由 SSA 后端读取入口寄存器并计算结果。
fn backend_add_params(left int, right int) int {
    return left + right;
}

// 相同操作数应进入 true 分支，不同操作数应进入 false 分支。
fn compare_eq(left int, right int) int {
    if (left == right) { return 1; } else { return 0; }
}

// 不同操作数应进入 true 分支，相同操作数应进入 false 分支。
fn compare_ne(left int, right int) int {
    if (left != right) { return 1; } else { return 0; }
}

// 左值小于右值时返回 1，否则返回 0。
fn compare_lt(left int, right int) int {
    if (left < right) { return 1; } else { return 0; }
}

// 左值小于或等于右值时返回 1，否则返回 0。
fn compare_le(left int, right int) int {
    if (left <= right) { return 1; } else { return 0; }
}

// 左值大于右值时返回 1，否则返回 0。
fn compare_gt(left int, right int) int {
    if (left > right) { return 1; } else { return 0; }
}

// 左值大于或等于右值时返回 1，否则返回 0。
fn compare_ge(left int, right int) int {
    if (left >= right) { return 1; } else { return 0; }
}

// u32 最大值与 1 的比较验证后端使用无符号条件码。
fn compare_unsigned_lt(left u32, right u32) int {
    if (left < right) { return 1; } else { return 0; }
}

// 同类型有符号参数的商应向零截断，除零保持当前 arm64 运行行为。
fn divide_signed(left int, right int) int {
    return left / right;
}

// 有符号取模的余数保留被除数符号，除零时返回被除数。
fn remainder_signed(left int, right int) int {
    return left % right;
}

// 无符号商须把 u32 最大值按正数处理。
fn divide_unsigned(left u32, right u32) u32 {
    return left / right;
}

// 无符号余数使用与除法相同的 u32 位型。
fn remainder_unsigned(left u32, right u32) u32 {
    return left % right;
}

// 位与保留两个参数共有的位。
fn bit_and(left u32, right u32) u32 {
    return left & right;
}

// 位或保留任一参数设置的位。
fn bit_or(left u32, right u32) u32 {
    return left | right;
}

// 位异或仅保留两个参数不同的位。
fn bit_xor(left u32, right u32) u32 {
    return left ^ right;
}

// 左移量由运行时参数传入，不能被默认常量折叠。
fn shift_left(left u32, right u32) u32 {
    return left << right;
}

// u32 右移采用逻辑移位，不扩展最高位。
fn shift_right_unsigned(left u32, right u32) u32 {
    return left >> right;
}

// 有符号右移采用算术移位，保留负值符号。
fn shift_right_signed(left int, right int) int {
    return left >> right;
}

// 常量左移应在 SSA 简化阶段折叠为整数常量。
fn folded_shift() int {
    return 7 << 2;
}

// 常量位与和位或应连续折叠，验证传播顺序。
fn folded_bits() int {
    return (6 & 3) | 4;
}

// 常量除法应折叠，但运行时零除保留给后端执行。
fn folded_div() int {
    return 21 / 3;
}

// 零除常量不在 SSA 简化时执行，交给目标指令保持运行时行为。
fn zero_divisor() int {
    return 5 / 0;
}

// 零模常量同样保持可执行 IR，结果来自目标指令的商与余数计算。
fn zero_remainder() int {
    return 5 % 0;
}

// 无参直接调用经 SSA 保留目标符号和返回值。
fn call_empty() int {
    return sum();
}

// 嵌套调用按源码顺序求值，外层实参表保持连续。
fn call_nested(value int) int {
    return backend_add_params(backend_add_params(value, 1), 2);
}

// 第九个整数参数走调用点栈区，被调方从帧指针上方读取。
fn call_nine(a int, b int, c int, d int, e int,
    f int, g int, h int, i int) int {
    return a + b + c + d + e + f + g + h + i;
}

// 直接调用后端同时装载寄存器和栈实参。
fn call_many() int {
    return call_nine(1, 2, 3, 4, 5, 6, 7, 8, 9);
}

let call_counter int = 0;

// 被调函数的全局写入必须保持两次且按顺序执行。
fn call_tick() int {
    call_counter += 1;
    return call_counter;
}

// void 函数由裸 return 结束，本身进入 SSA 并由新后端发射。
fn log_unit(weight int) void {
    let scaled int = weight * 2;
    scaled += 1;
    return;
}

// 隐式结束的空 void 函数覆盖零指令 CFG 的调用约定框架。
fn log_noop() void {
}

// 标量返回值可被语句级调用丢弃，结果值不进入任何使用链。
fn discarded_result(value int) int {
    return value - 1;
}

// 顺序调用语句保留副作用求值顺序，随后继续正常返回。
fn call_and_discard(base int) int {
    log_unit(base);
    discarded_result(base);
    return base + 1;
}

// 分支块内的调用语句与赋值混合时，仍按源码顺序发射并产生 phi 合流。
fn branch_calls(value int, flag bool) int {
    if (flag) {
        log_unit(value);
        value += 1;
    } else {
        log_noop();
        value -= 1;
    }
    return value;
}

// 条件循环：计数器与累加值经循环头 phi 携带，循环后读取合流结果。
fn loop_count(times int) int {
    let total int = 0;
    let step int = 1;
    for step <= times {
        total += step;
        step += 1;
    }
    return total;
}

// 循环体内的 let 每次迭代重新定义，不参与循环携带。
fn loop_local_body(times int) int {
    let acc int = 0;
    let k int = 0;
    for k < times {
        let doubled int = k * 2;
        acc += doubled;
        k += 1;
    }
    return acc;
}

// 循环后的尾随语句继续使用循环携带的合流值。
fn loop_tail_use(start int) int {
    let value int = start;
    let rounds int = 0;
    for rounds < 3 {
        value += rounds;
        rounds += 1;
    }
    value += 100;
    return value;
}

// void 函数的循环体可在顺序语句中发起调用语句。
fn loop_with_calls(times int) void {
    let k int = 0;
    for k < times {
        log_unit(k);
        k += 1;
    }
    return;
}

// 语句级调用循环函数后继续正常返回，验证循环与调用共存。
fn loop_call_driver(times int) int {
    loop_with_calls(times);
    return times + 1;
}

// 循环体内 if 守卫的 break：break 站点的携带值与条件假边在退出块合流。
fn loop_break_guard(n int) int {
    let i int = 0;
    let total int = 0;
    for i < n {
        if (total > 2) {
            break;
        }
        total += i;
        i += 1;
    }
    return total;
}

// continue 跳过本次迭代剩余语句，continue 站点回填循环头 phi 输入。
fn loop_skip_odd(n int) int {
    let i int = 0;
    let total int = 0;
    for i < n {
        i += 1;
        if (i == 2) {
            continue;
        }
        total += i;
    }
    return total;
}

// 短路求值：|| 右侧在左侧为真时不执行，&& 右侧在左侧为假时不执行；
// 混合优先级与逻辑非都进入 SSA 条件块与合流 phi。
fn logic_guard(a int, b int, c int) int {
    let hits int = 0;
    if (a > 0 || b > 0 && c > 0) {
        hits += 1;
    }
    let flag bool = a > 0 && b > 0;
    if (flag) {
        hits += 10;
    }
    if (!(a > 100) || c == 3) {
        hits += 100;
    }
    return hits;
}

// SSA 调用不能因实参和返回类型相同而被当作纯函数折叠。
fn call_effects() int {
    let first int = call_tick();
    let second int = call_tick();
    return first * 10 + second;
}

// 同时验证 u32 最大值小于 1 为假，1 小于最大值为真。
fn unsigned_score() int {
    let large u32 = 4294967295;
    let one u32 = 1;
    if (divide_signed(-21, 4) != -5 || remainder_signed(-21, 4) != -1
        || divide_signed(5, 0) != 0 || remainder_signed(5, 0) != 5) { return 100; }
    if (divide_unsigned(large, 3) != 1431655765
        || remainder_unsigned(large, 7) != 3) { return 101; }
    if (bit_and(13, 10) != 8 || bit_or(13, 10) != 15
        || bit_xor(13, 10) != 7) { return 102; }
    if (shift_left(3, 2) != 12 || shift_right_unsigned(2147483648, 2) != 536870912
        || shift_right_signed(-16, 2) != -4) { return 103; }
    if (folded_shift() != 28 || folded_bits() != 6 || folded_div() != 7
        || zero_divisor() != 0 || zero_remainder() != 5) { return 104; }
    if (call_empty() != 42 || call_nested(5) != 8
        || call_many() != 45 || call_effects() != 12) { return 105; }
    if (call_and_discard(7) != 8 || branch_calls(10, true) != 11
        || branch_calls(10, false) != 9) { return 106; }
    if (loop_count(4) != 10 || loop_local_body(3) != 6
        || loop_tail_use(5) != 108 || loop_call_driver(2) != 3) { return 107; }
    if (loop_break_guard(10) != 3 || loop_break_guard(2) != 1
        || loop_skip_odd(5) != 13 || loop_skip_odd(2) != 1) { return 108; }
    if (logic_guard(1, 0, 3) != 101 || logic_guard(0, 1, 0) != 100
        || logic_guard(1, 1, 0) != 111 || logic_guard(0, 0, 3) != 100) { return 109; }
    return compare_unsigned_lt(large, one) + compare_unsigned_lt(one, large);
}

// 编译期常量的小于比较应由 SSA 简化为真值。
fn folded_signed_lt() int {
    if (2 < 3) { return 1; } else { return 0; }
}

// 入口暂由旧后端运行，通过调用同时检查新后端函数与原路径的链接互操作。
fn main() int {
    return choose_true() + choose_false() + from_param(7) + local_left() + local_right()
        + branch_update(10, true) + branch_update(10, false) + backend_add_params(1, 2)
        + branch_local(true) + branch_local(false)
        + compare_eq(2, 3) + compare_eq(3, 3)
        + compare_ne(2, 3) + compare_ne(3, 3)
        + compare_lt(2, 3) + compare_lt(3, 2)
        + compare_le(2, 3) + compare_le(3, 2)
        + compare_gt(3, 2) + compare_gt(2, 3)
        + compare_ge(3, 3) + compare_ge(2, 3) + unsigned_score()
        + folded_signed_lt();
}
