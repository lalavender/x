module main;

// typed_layout_count：用 typed 局部循环计算后续字段布局所需的数组长度。
@[comptime]
fn typed_layout_count(value int) int {
    let index int = 0;
    let total int = 1;
    for index < value {
        total += 1;
        index += 1;
    }
    return total;
}

const TYPED_LAYOUT_COUNT int = $typed_layout_count(3);

pub struct TypedLayoutPacket {
    items [TYPED_LAYOUT_COUNT]int;
}

// TypedLayoutEnvelope：跨源文件复用 pending 布局并验证嵌套结构体大小。
pub struct TypedLayoutEnvelope {
    packet TypedLayoutPacket;
}

let typed_layout_values [TYPED_LAYOUT_COUNT]int;
