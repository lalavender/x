module main;

@[comptime] fn adjust(value int) int {
    return $increment($increment(value));
}

const RESULT int = $combine($combine(10, 0), 2);
const CHAIN int = $adjust(40);
const LOOP int = $sum_to(6);
const EVEN int = $sum_even(2, 7);
const EMPTY int = $sum_even(4, 4);
const RANGE int = $sum_range_forin(3, 6);
const ARRAY int = $sum_array_forin();
const INDEX int = $array_middle();
const UPDATED_INDEX int = $update_array_middle();
const SLICE_VIEW int = $slice_middle();
const SLICE_RETURN int = $nested_return_slice();
const STRUCT_FIELD int = $struct_middle();
const STRUCT_NESTED int = $nested_struct_middle();
const STRUCT_ARRAY int = $struct_array_copy();
const STRUCT_NESTED_ARRAY int = $nested_struct_array_copy();
const AGGREGATE_PARAMS int = $aggregate_params();
const AGGREGATE_RETURNS int = $aggregate_returns();
const ARRAY_STRUCTS int = $ct_array_of_structs();
const POINT_SLICE int = $point_slice_roundtrip(1);
const LENGTHS int = $comptime_lengths();
const ENUM_TOTAL int = $sum_enum_values();
const POSITIVE int = $select_by_sign(2);
const ZERO int = $select_by_sign(0);
const POINTER_PARAM int = $pointer_param();
const FLOAT_TOTAL f64 = $float_total();
const FLOAT_CHECK int = $float_check();
const FOLDED_FLOAT f64 = 1.25 + 0.75;
const FLOAT_ARRAY_TOTAL f64 = $float_array_call();
const FLOAT_SLICE_VIEW f64 = $float_slice_pick(1.0);
const FLOAT_POINTER f64 = $float_pointer_drive();
const FLOAT_POINTER_ARITH f64 = $float_pointer_arith();
const UNION_ROUND int = $union_round();

let TOP_PACKET ReturnPacket = $make_return_packet(10);
let TOP_ARRAY [2]int = $make_return_array(4);
let TOP_VIEW []int = $make_return_slice(7);
let TOP_POINTS []Point = $make_point_slice(30);
let TOP_FLOAT_VIEW []f64 = $float_slice_view(2.0);

// enum_runtime_sum：普通函数在项目 AST 模式展开枚举 values 并读取判别值。
fn enum_runtime_sum() int {
    let total int = 0;
    $for item in CtMode.values {
        total += item.value;
    }
    return total;
}

fn main() int {
    (($assert(RESULT == 42, "模块编译期断言")));
    $assert(CHAIN == 42, "跨文件编译期函数调用");
    $assert(LOOP == 15, "跨文件 typed IR 局部循环");
    $assert(EVEN == 12 && EMPTY == 0, "跨文件 typed `$for` 循环");
    $assert(RANGE == 12, "跨文件 typed 区间 for-in");
    $assert(ARRAY == 18, "跨文件 typed 整型数组 for-in");
    $assert(INDEX == 6, "跨文件 typed 整型数组下标读取");
    $assert(UPDATED_INDEX == 9, "跨文件 typed 整型数组下标写入");
    $assert(SLICE_VIEW == 23, "跨文件 typed 切片视图写入");
    $assert(SLICE_RETURN == 606, "跨源文件 typed 整数切片返回与复制");
    $assert(STRUCT_FIELD == 15, "跨文件 typed 结构体字段写入");
    $assert(STRUCT_NESTED == 57, "跨源文件 typed 嵌套结构体字段");
    $assert(STRUCT_ARRAY == 102, "跨源文件 typed 结构体定长数组字段");
    $assert(STRUCT_NESTED_ARRAY == 39, "跨源文件 typed 结构体多维数组字段");
    $assert(AGGREGATE_PARAMS == 394, "跨源文件 typed 聚合形参值语义");
    $assert(AGGREGATE_RETURNS == 408, "跨源文件 typed 聚合返回生命周期");
    $assert(ARRAY_STRUCTS == 1422, "跨源文件 typed 结构体数组按值复制");
    $assert(POINT_SLICE == 1601, "跨源文件 typed 结构体元素切片值语义");
    $assert(LENGTHS == 320, "跨源文件 typed 数组和切片 len");
    $assert(TYPED_LAYOUT_COUNT == 4 && sizeof(TypedLayoutPacket) == 16
        && sizeof(TypedLayoutEnvelope) == 16,
        "跨源文件 typed 编译期布局请求");
    $assert(ENUM_TOTAL == 5, "模块 typed `$for item in Enum.values`");
    $assert(POSITIVE == 1 && ZERO == 0, "跨文件 typed `$if` 选支");
    $assert(POINTER_PARAM == 121, "跨源文件 typed 指针形参写回");
    $assert(FLOAT_CHECK == 400, "跨源文件 typed 浮点编译期求值");
    $assert(FLOAT_TOTAL == 4.0, "跨源文件 typed 浮点常量物化");
    $assert(FOLDED_FLOAT == 2.0, "模块内浮点常量折叠");
    $assert(FLOAT_ARRAY_TOTAL == 3.75, "跨源文件 typed 浮点数组形参");
    $assert(FLOAT_SLICE_VIEW == 1.5, "跨源文件 typed 浮点切片返回");
    $assert(FLOAT_POINTER == 2.0, "跨源文件 typed 浮点指针形参");
    $assert(FLOAT_POINTER_ARITH == 11.0, "跨源文件 typed 指针算术与下标");
    $assert(UNION_ROUND == 544, "跨源文件 typed 联合体共享存储");
    $compile_warn("模块编译期警告");
    $if (false) {
        $compile_error("未选中的编译错误");
        $compile_warn("未选中的编译警告");
    }
    let value int = 0;
    $if (RESULT == 42) {
        value = RESULT;
    } $else {
        value = 0;
    }
    $for i in (0..1) {
        value += i;
    }
    value += enum_runtime_sum() - 5;
    let float_part int = FLOAT_TOTAL.to_type(int);
    TOP_PACKET.rows[1][0] += 8;
    TOP_ARRAY[1] += 3;
    TOP_VIEW[0] += 1;
    let local_return [2]int = $make_return_array(20);
    return value - 42 + TOP_PACKET.rows[1][0] + TOP_PACKET.rows[1][1]
        + TOP_ARRAY[0] + TOP_ARRAY[1] + TOP_VIEW[0] + TOP_VIEW[1]
        + local_return[0] + local_return[1] + TOP_POINTS[0].x
        + TOP_POINTS[1].y + len(typed_layout_values) + float_part
        + TOP_FLOAT_VIEW[1].to_type(int) - 177;
}
