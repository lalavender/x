module main;

pub struct CtArrayPoint {
    x int;
    y int;
}

pub struct CtPointShelf {
    points [2]CtArrayPoint;
}

// make_ct_points：从不同源文件可见的编译期函数返回结构体定长数组。
@[comptime] fn make_ct_points(seed int) [2]CtArrayPoint {
    let points [2]CtArrayPoint = [
        CtArrayPoint{ x: seed, y: seed + 1 },
        CtArrayPoint{ x: seed + 2, y: seed + 3 },
    ];
    return points;
}

// edit_ct_points：跨源文件接收数组形参，在副本上修改结构体成员并返回。
@[comptime] fn edit_ct_points(points [2]CtArrayPoint) [2]CtArrayPoint {
    points[1].x += 20;
    return points;
}

// ct_array_of_structs：检查跨源文件调用中的聚合字段复制和返回隔离。
@[comptime] fn ct_array_of_structs() int {
    let original [2]CtArrayPoint = $make_ct_points(1);
    let shelf CtPointShelf = CtPointShelf{ points: original };
    let duplicate CtPointShelf = shelf;
    let changed [2]CtArrayPoint = $edit_ct_points(duplicate.points);
    changed[0].x = 99;
    return original[0].x * 1000 + shelf.points[1].x * 100
        + changed[0].x + changed[1].x;
}
