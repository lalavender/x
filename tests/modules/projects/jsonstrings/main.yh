module main

// JSON 字符串验收：转义解码、代理对、NUL、写出转义与非 ASCII 模式。

import io
import json
import string

let failed int = 0

// ok 记录一条断言结果。
fn ok(condition int, name *char) void {
    if (condition == 0) {
        failed += 1
        io.print("FAIL ")
        io.println(name)
    }
}

// text_equals_c 比较 Text 与给定字节串。
fn text_equals_c(text json.Text, expected *char, count u64) int {
    if (text.count != count) {
        return 0
    }
    let i u64 = 0
    for i < count {
        if (text.data[i] != expected[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    return 1
}

// encode_root 把根值紧凑写出；失败返回零句柄。
fn encode_root(root json.Value, escape_non_ascii int) string.String {
    let options json.WriteOptions
    options.indent = 0
    options.escape_non_ascii = escape_non_ascii
    options.sort_keys = 0
    let encoded json.EncodeResult = json.encode_owned(root, options)
    if (encoded.status != json.write_ok) {
        let empty string.String = string.make()
        return empty
    }
    return encoded.text
}

// check_escapes 断言短转义与 \uXXXX 解码。
fn check_escapes() void {
    let result json.ParseResult = json.parse_text("\"a\\nb\\t\\\"c\\\\d\\/e\"")
    ok((result.status == json.parse_ok).to_type(int), "escape parse")
    let root json.Value = json.root(&result.document)
    let out json.Text
    json.as_text(root, &out)
    ok(text_equals_c(out, "a\nb\t\"c\\d/e", 10), "escape bytes")
    json.release(&result.document)

    let unicode json.ParseResult = json.parse_text("\"\\u0041\\u00e9\"")
    ok((unicode.status == json.parse_ok).to_type(int), "unicode parse")
    let utext json.Text
    json.as_text(json.root(&unicode.document), &utext)
    ok((utext.count == 3).to_type(int), "unicode count")
    ok((utext.data[0] == 65).to_type(int), "unicode A")
    ok((utext.data[1] == 195 && utext.data[2] == 169).to_type(int), "unicode e9")
    json.release(&unicode.document)
}

// check_surrogate 断言代理对解码为四字节 UTF-8。
fn check_surrogate() void {
    let result json.ParseResult = json.parse_text("\"\\uD83D\\uDE00\"")
    ok((result.status == json.parse_ok).to_type(int), "surrogate parse")
    let out json.Text
    json.as_text(json.root(&result.document), &out)
    ok((out.count == 4).to_type(int), "surrogate count")
    ok((out.data[0] == 240 && out.data[1] == 159).to_type(int), "surrogate head")
    ok((out.data[2] == 152 && out.data[3] == 128).to_type(int), "surrogate tail")
    json.release(&result.document)
}

// check_nul 断言解码后的 NUL 可以出现在键里。
fn check_nul() void {
    let result json.ParseResult = json.parse_text("{\"a\\u0000b\": 1}")
    ok((result.status == json.parse_ok).to_type(int), "nul key parse")
    let bytes [3]u8
    bytes[0] = 97
    bytes[1] = 0
    bytes[2] = 98
    let key json.Text
    key.data = &bytes[0]
    key.count = 3
    let found json.LookupResult = json.object_get(json.root(&result.document), key)
    ok((found.status == json.query_ok).to_type(int), "nul key found")
    let value i64 = 0
    json.as_i64(found.value, &value)
    ok((value == 1).to_type(int), "nul key value")
    json.release(&result.document)
}

// check_write_escapes 断言写出端的转义口径。
fn check_write_escapes() void {
    let result json.ParseResult = json.parse_text("\"a\\nb/c\"")
    let text string.String = encode_root(json.root(&result.document), 0)
    let view string.View = string.as_view(&text)
    let out json.Text
    out.data = view.data
    out.count = view.count
    ok(text_equals_c(out, "\"a\\nb/c\"", 8), "write escapes")
    string.release(&text)
    json.release(&result.document)

    let unicode json.ParseResult = json.parse_text("\"é\"")
    let escaped string.String = encode_root(json.root(&unicode.document), 1)
    let eview string.View = string.as_view(&escaped)
    let etext json.Text
    etext.data = eview.data
    etext.count = eview.count
    ok(text_equals_c(etext, "\"\\u00e9\"", 8), "escape non ascii")
    string.release(&escaped)
    json.release(&unicode.document)
}

// check_invalid_utf8 断言写出端拒绝非法 UTF-8 内容。
fn check_invalid_utf8() void {
    let bad [2]u8
    bad[0] = 255
    bad[1] = 65
    let none *string.String = 0
    let options json.WriteOptions
    options.indent = 0
    options.escape_non_ascii = 0
    options.sort_keys = 0
    let b json.Builder = json.builder_make(none, options)
    ok((json.builder_status(&b) == json.write_argument_error).to_type(int),
        "builder null out")
    let text string.String = string.make()
    let builder json.Builder = json.builder_make(&text, options)
    let payload json.Text
    payload.data = &bad[0]
    payload.count = 2
    let status json.WriteStatus = json.write_string(&builder, payload)
    ok((status == json.write_invalid_utf8).to_type(int), "invalid utf8 status")
    ok((string.byte_length(&text) == 0).to_type(int), "invalid utf8 rollback")
    string.release(&text)
}

// main 跑字符串断言。
fn main() int {
    check_escapes()
    check_surrogate()
    check_nul()
    check_write_escapes()
    check_invalid_utf8()
    if (failed == 0) {
        io.println("json strings ok")
        return 0
    }
    return 1
}
