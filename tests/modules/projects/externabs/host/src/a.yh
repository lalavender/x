module main;

import lib;

fn main() int {
    if (lib.abs(-9) != 9) { return 1; }
    let handle *lib.CHandle;
    if (lib.pass_handle(handle) != 0) { return 2; }
    let status lib.CStatus = lib.ready;
    if (lib.status_code(status) != 4) { return 3; }
    if (lib.plus_two(40) != 42) { return 4; }
    lib.stop(0);
    return 5;
}
