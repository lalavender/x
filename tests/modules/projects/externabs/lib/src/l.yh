module lib;

@[extern]
pub fn abs(value int) int;

@[noreturn, extern]
pub fn _Exit(status int) void;

@[extern]
pub struct CHandle {
}

@[extern]
pub enum CStatus {
    ready = 4;
    failed = 5;
}

pub fn pass_handle(value *CHandle) *CHandle {
    return value;
}

pub fn status_code(value CStatus) int {
    return value;
}

@[inline]
pub fn plus_two(value int) int {
    return value + 2;
}

@[noreturn]
pub fn stop(status int) void {
    _Exit(status);
}
