module lib;

// 2026-10-02 pub struct 一等化：字段一律公开，Box 不再有私有字段；
// 本 fixture 验证跨模块字段访问与位置式构造（build-check u3 用例），
// 以及非 pub 函数（hidden）仍不对导出。
pub struct Box {
    open int;
    secret int;
}

pub fn mk() Box {
    let b Box;
    b.open = 1;
    b.secret = 2;
    return b;
}

fn hidden() int {
    return 9;
}

pub fn via() int {
    return hidden();
}
