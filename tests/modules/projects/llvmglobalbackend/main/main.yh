module main;
import support
import backend;
import gen;
import ir;

// add_types：手建整数、字节、指针和聚合布局；编号固定，预期字节不由发射器计算。
fn add_types(unit *ir.IRModule) int {
    let ty ir.IRModuleType;
    ty.kind = ir.IR_TY_I32; ty.bits = 32; ty.size = 4; ty.align = 4; ty.elem = -1;
    if (ir.ir_module_add_type(unit, "i32", &ty, 0, 0) != 0) { return -1; }
    ty.kind = ir.IR_TY_U8; ty.bits = 8; ty.size = 1; ty.align = 1;
    if (ir.ir_module_add_type(unit, "u8", &ty, 0, 0) != 1) { return -1; }
    ty.kind = ir.IR_TY_PTR; ty.bits = 64; ty.size = 8; ty.align = 8; ty.elem = 0;
    if (ir.ir_module_add_type(unit, "ptr", &ty, 0, 0) != 2) { return -1; }
    ty.kind = ir.IR_MODULE_TY_ARRAY; ty.bits = 0; ty.size = 4; ty.align = 1;
    ty.elem = 1; ty.count = 4;
    if (ir.ir_module_add_type(unit, "bytes", &ty, 0, 0) != 3) { return -1; }
    let fields [2]ir.IRModuleField;
    fields[0].type_id = 0; fields[1].type_id = 2; fields[1].offset = 8;
    ty.kind = ir.IR_MODULE_TY_STRUCT; ty.size = 16; ty.align = 8; ty.elem = -1; ty.count = 0;
    if (ir.ir_module_add_type(unit, "pair", &ty, &fields[0], 2) != 4) { return -1; }
    fields[1].offset = 0;
    ty.kind = ir.IR_MODULE_TY_UNION; ty.size = 8;
    if (ir.ir_module_add_type(unit, "union", &ty, &fields[0], 2) != 5) { return -1; }
    ty.kind = ir.IR_MODULE_TY_ARRAY; ty.size = 16; ty.align = 1; ty.elem = 1; ty.count = 16;
    if (ir.ir_module_add_type(unit, "wide", &ty, 0, 0) != 6) { return -1; }
    return 0;
}

// add_global：给测试模块添加有来源的定义，并深拷贝调用方提供的初始化字节。
fn add_global(unit *ir.IRModule, name *char, type_id int, mutable int, linkage int,
    data *u8, size int, align int) int {
    let symbol ir.IRModuleSymbol;
    symbol.kind = ir.IR_MODULE_SYMBOL_GLOBAL; symbol.type_id = type_id;
    symbol.mutable = mutable; symbol.linkage = linkage; symbol.defined = 1; symbol.offset = 8;
    let id int = ir.ir_module_add_symbol(unit, name, &symbol, 0, 0);
    if (id < 0 || ir.ir_module_add_global(unit, id, data, size, align, 0, 0) < 0) { return -1; }
    return id;
}

// instruction：未使用操作数明确填 -1，避免零初始化掩盖 GLOB_ADDR 的编码约束。
fn instruction(inst *ir.IRInst, op int, result int, type_id int, a int, b int, imm i64) void {
    inst.op = op; inst.result_id = result; inst.result_type = type_id;
    inst.a = a; inst.b = b; inst.imm = imm; inst.aux = -1;
}

// add_function：构造全局取址后的标量读取、写回或指针返回，供独立 C oracle 实际调用。
// write 为 1 时写入 57，address 为 1 时直接返回字节全局地址；其余路径返回标量值。
fn add_function(unit *ir.IRModule, name *char, global int, write int, address int) int {
    let result_type int = address != 0 ? 2 : 0;
    let symbol ir.IRModuleSymbol;
    symbol.kind = ir.IR_MODULE_SYMBOL_FUNCTION; symbol.type_id = result_type;
    symbol.linkage = ir.IR_MODULE_LINK_EXTERNAL; symbol.defined = 1; symbol.offset = 8;
    let id int = ir.ir_module_add_symbol(unit, name, &symbol, 0, 0);
    if (id < 0) { return -1; }
    let types [3]ir.IRType;
    let mapping [3]int;
    let i int = 0;
    for i < 3 {
        types[i].kind = unit.types[i].kind; types[i].bits = unit.types[i].bits;
        types[i].elem = unit.types[i].elem; mapping[i] = i; i += 1;
    }
    let insts [4]ir.IRInst;
    instruction(&insts[0], ir.IR_OP_GLOB_ADDR, 0, 2, -1, -1, global.to_type(i64));
    let count int = 1; let value int = 0;
    if (address == 0) {
        if (write != 0) {
            instruction(&insts[1], ir.IR_OP_CONST, 1, 0, -1, -1, 57);
            instruction(&insts[2], ir.IR_OP_STORE, -1, -1, 0, 1, 0);
            instruction(&insts[3], ir.IR_OP_LOAD, 2, 0, 0, -1, 0);
            count = 4; value = 2;
        } else {
            instruction(&insts[1], ir.IR_OP_LOAD, 1, 0, 0, -1, 0);
            count = 2; value = 1;
        }
    }
    let block ir.IRBlock;
    block.inst_count = count; block.term = ir.IR_TERM_RET; block.term_value = value;
    block.succ0 = -1; block.succ1 = -1;
    let body ir.IRFunction;
    body.target_id = unit.target.key; body.ret_type = result_type;
    body.types = &types[0]; body.type_count = 3; body.insts = &insts[0]; body.inst_count = count;
    body.value_count = value + 1; body.blocks = &block; body.block_count = 1;
    return ir.ir_module_add_function(unit, id, &body, &mapping[0], 0);
}

// main：成功路径输出真实 LLVM 文本；随后验证非法重定位与未定义全局拒绝且不破坏旧输出。
fn main() int {
    let target gen.TargetInfo;
    if (support.target_resolve("x86_64-unknown-linux-gnu", &target) != 0) { return 1; }
    let module_target ir.IRModuleTarget;
    module_target.triple = target.triple; module_target.data_layout = target.data_layout;
    module_target.abi = target.abi; module_target.pointer_bits = target.pointer_bits;
    module_target.little_endian = target.little_endian; module_target.layout_version = target.layout_version;
    let unit ir.IRModule;
    let source *char = "fixture\nglobals\n";
    if (ir.ir_module_init(&unit, &module_target) != 0
        || ir.ir_module_add_source(&unit, "global-backend.yh", source.to_type(*u8), 16) != 0
        || add_types(&unit) != 0) { return 2; }
    let data [16]u8;
    if (add_global(&unit, "zero_pair", 4, 1, ir.IR_MODULE_LINK_PRIVATE, &data[0], 16, 16) != 0) { return 3; }
    data[0] = '"'; data[1] = '\\'; data[2] = 255;
    if (add_global(&unit, ".LD7", 3, 0, ir.IR_MODULE_LINK_PRIVATE, &data[0], 4, 1) != 1) { return 4; }
    data[0] = 42; data[1] = 0; data[2] = 0;
    if (add_global(&unit, "scalar", 0, 1, ir.IR_MODULE_LINK_EXTERNAL, &data[0], 4, 4) != 2) { return 5; }
    data[0] = 0;
    if (add_global(&unit, "null_ptr", 2, 1, ir.IR_MODULE_LINK_PRIVATE, &data[0], 8, 8) != 3
        || add_global(&unit, "zero_union", 5, 1, ir.IR_MODULE_LINK_PRIVATE, &data[0], 8, 8) != 4
        || add_global(&unit, "public_const", 0, 0, ir.IR_MODULE_LINK_EXTERNAL, &data[0], 4, 4) != 5) { return 6; }
    data[0] = 1; data[8] = 128; data[15] = 'A';
    if (add_global(&unit, "wide_bytes", 6, 0, ir.IR_MODULE_LINK_EXTERNAL, &data[0], 16, 1) != 6) { return 11; }
    if (add_function(&unit, "read_scalar", 2, 0, 0) < 0
        || add_function(&unit, "write_scalar", 2, 1, 0) < 0
        || add_function(&unit, "string_addr", 1, 0, 1) < 0) { return 7; }
    let out backend.LLVMOutput;
    if (ir.ir_module_verify(&unit) != 0 || backend.llvm_emit_module(&unit, &target, &out) != 0) { return 8; }
    let original *u8 = out.text; let length int = out.length;
    let relocation ir.IRModuleReloc;
    relocation.offset = 1; relocation.width = 8; relocation.symbol = 2;
    unit.globals[3].relocs = &relocation; unit.globals[3].reloc_count = 1;
    if (ir.ir_module_verify(&unit) == 0 || backend.llvm_emit_module(&unit, &target, &out) == 0
        || out.text != original || out.length != length) { return 9; }
    unit.globals[3].relocs = 0; unit.globals[3].reloc_count = 0;
    let external ir.IRModuleSymbol;
    external.kind = ir.IR_MODULE_SYMBOL_GLOBAL; external.type_id = 0;
    external.linkage = ir.IR_MODULE_LINK_EXTERNAL; external.offset = 8;
    if (ir.ir_module_add_symbol(&unit, "undefined", &external, 0, 0) < 0
        || ir.ir_module_verify(&unit) != 0 || backend.llvm_emit_module(&unit, &target, &out) == 0
        || out.text != original || out.length != length) { return 10; }
    support.write_all(1, out.text, out.length);
    backend.llvm_output_release(&out); ir.ir_module_release(&unit);
    return 0;
}
