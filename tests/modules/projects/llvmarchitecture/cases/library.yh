module main;

// LA0 库文件正例：没有 main，但含运行期函数、编译期函数与布局常量。
@[comptime]
fn layout_count() int {
    return 2;
}

const LIB_VALUES int = $layout_count();

pub struct LibraryPacket {
    values [LIB_VALUES]int;
}

fn product(left int, right int) int {
    return left * right;
}

fn layout_bytes() int {
    return sizeof(LibraryPacket);
}
