module main;

// LA0 库文件正例：没有 main，但含运行期函数、编译期函数与布局常量。
@[comptime]
fn layout_count() int {
    return 2;
}

const LIB_VALUES int = $layout_count();

pub struct LibraryPacket {
    values [LIB_VALUES]int;
}

// 库文件的两个导出函数：单文件库用例只验证 check 形态，没有调用方，
// 因此按 pub 登记为模块导出面（UF1：私有且无引用的函数会报错）。
pub fn product(left int, right int) int {
    return left * right;
}

pub fn layout_bytes() int {
    return sizeof(LibraryPacket);
}
