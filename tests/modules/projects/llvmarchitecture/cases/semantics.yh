module main;

// LA2b 语义对照 fixture：窄整数、bool 字节、移位、转换与聚合/切片别名。
// 同一源码在 O0/O2 下都必须返回 0，用于对照 CT/运行期共享的布局与操作规则。
struct Pair {
    left int;
    right int;
}

struct Flags {
    on bool;
    pad u8;
}

// 编译期执行同一组窄整数/移位/转换/聚合副本规则；运行期结果必须一致。
@[comptime]
fn ct_semantics() int {
    let narrow i8 = 100;
    narrow = narrow + 1;
    if (narrow != 101) { return 1; }
    let shifted int = 1 << 5;
    if (shifted != 32) { return 2; }
    let from_i64 i64 = 7;
    let narrowed i32 = from_i64.to_type(i32);
    if (narrowed != 7) { return 3; }
    let f32v f32 = 1.5.to_type(f32);
    let f64v f64 = f32v.to_type(f64);
    if (f64v != 1.5) { return 4; }
    let p Pair = Pair{ left: 1, right: 2 };
    let q Pair = p;
    q.left = 9;
    if (p.left != 1 || q.left != 9) { return 5; }
    return 0;
}

const CT_SEMANTICS int = $ct_semantics();

fn main() int {
    if (CT_SEMANTICS != 0) { return 10; }
    let narrow i8 = 100;
    narrow = narrow + 1;
    if (narrow != 101) { return 1; }

    let wide u8 = 200;
    wide = wide + 55;
    if (wide != 255) { return 2; }

    let shifted int = 1 << 5;
    if (shifted != 32) { return 3; }
    if ((shifted >> 2) != 8) { return 4; }

    let from_i64 i64 = 7;
    let narrowed i32 = from_i64.to_type(i32);
    if (narrowed != 7) { return 5; }

    let f32v f32 = 1.5.to_type(f32);
    let f64v f64 = f32v.to_type(f64);
    if (f64v != 1.5) { return 6; }

    let p Pair = Pair{ left: 1, right: 2 };
    let q Pair = p;
    q.left = 9;
    if (p.left != 1 || q.left != 9) { return 7; }

    let values [3]int = [1, 2, 3];
    let view []int = values.to_type([]int);
    view[1] = 8;
    if (values[1] != 8) { return 8; }

    let flags Flags = Flags{ on: true, pad: 7 };
    if (flags.on != true || flags.pad != 7) { return 9; }
    return 0;
}
