module main;

// LA0 lowering fixture：嵌套循环与 continue/break、多分支 switch、goto 跨块、
// 聚合副本、取址、函数指针与编译期展开来源。经单文件编译运行必须返回 0，
// 并经 --emit-llvm 产出可对照的模块文本。
//
// goto 与函数指针分别放在独立函数：当前 lowering 在含 goto 的函数里把 fn
// 绑定按内存驻留处理时会生成 alloca void（见 docs/todo.md 缺陷项），
// 本 fixture 不把两个独立特性叠在同一函数里掩盖该问题。
struct Pair {
    left int;
    right int;
}

@[comptime]
fn layout_count() int {
    return 2;
}

const LAYOUT_COUNT int = $layout_count();

struct Packet {
    values [LAYOUT_COUNT]int;
}

fn add_one(value int) int {
    return value + 1;
}

fn apply(cb fn(int) int, value int) int {
    return cb(value);
}

fn flow_goto(seed int) int {
    let jumped int = seed;
    jumped = 1;
    goto joined;
    jumped = 99;
joined:
    return jumped;
}

fn nested_loops() int {
    let total int = 0;
    let i int = 0;
    for i < 4 {
        i += 1;
        let j int = 0;
        for j < 4 {
            j += 1;
            if (j == 2) {
                continue;
            }
            if (i == 3 && j == 3) {
                break;
            }
            total += 1;
        }
    }
    return total;
}

fn switch_branches(start int) int {
    let total int = start;
    let branch int = 0;
    for branch < 4 {
        switch branch {
            case 0 {
                total += 1;
            }
            case 1 {
                total += 2;
            }
            case 2 {
                total += 3;
            }
            default {
                total += 4;
            }
        }
        branch += 1;
    }
    return total;
}

fn aggregate_copy() int {
    let p Pair = Pair{ left: 2, right: 3 };
    let q Pair = p;
    q.left = 9;
    if (p.left != 2 || q.left != 9) {
        return 1;
    }
    let pp *Pair = &p;
    (*pp).right = 4;
    if (p.right != 4) {
        return 2;
    }
    return 0;
}

fn call_pointer() int {
    let f fn(int) int = add_one;
    if (apply(f, 41) != 42) {
        return 1;
    }
    return 0;
}

fn main() int {
    if (flow_goto(7) != 1) {
        return 1;
    }
    if (nested_loops() != 10) {
        return 2;
    }
    if (switch_branches(10) != 20) {
        return 3;
    }
    if (aggregate_copy() != 0) {
        return 4;
    }
    if (call_pointer() != 0) {
        return 5;
    }
    let packet Packet;
    if (len(packet.values) != 2 || sizeof(Packet) != 8) {
        return 6;
    }
    return 0;
}
