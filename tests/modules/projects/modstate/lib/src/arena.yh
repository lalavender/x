module arena;

// 跨模块可变全局不导出（2026-10-02「let 不导出」）：模块私有 arena 只能经
// pub 访问函数读写。compiler/ast 模块拆分正是按这一模式与 parse/cmd 共享
// AST 状态（compiler/ast/ast_expr.yh、ast_stmt.yh 的跨模块访问函数），
// 本 fixture 锁定该约定（build-check u3 用例）。

let slots [8]int;
let slots_n int = 0;

// push：写入一个槽，返回写入后的元素个数。
pub fn push(v int) int {
    slots[slots_n] = v;
    slots_n += 1;
    return slots_n;
}

// count_now：当前元素个数（私有 let 的只读出口）。
pub fn count_now() int {
    return slots_n;
}

// at：读取指定槽（私有 let 的下标出口）。
pub fn at(i int) int {
    return slots[i];
}
