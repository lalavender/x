module main
import core.lex
import support
import core.check
import core.gen
import core.token

// main：验证 CT 执行器的零拷贝镜像与 gen 类型表逐行一致（F4-0 的形状守卫）。
// 镜像读的是同一份内存，因此任何字段顺序/宽度/常量漂移都会在这里露出来。
fn main() int {
    gen.state_init()
    lex.reset()
    if (gen.sem_init_tables() != 0 || gen.ty_register_builtins() != 0) { return 1 }
    if (check.ct_type_layout_ok() == 0) { return 2 }
    check.ct_facts_sync()
    let n int = comptime_bound()
    if (n <= 0 || n != support.ms().type_n) { return 3 }
    let i int = 0
    for i < n {
        let row gen.CType = support.ms().types[i]
        if (check.ct_kind(i) != row.kind || check.ct_size(i) != row.size
            || check.ct_align(i) != row.align || check.ct_elem(i) != row.elem
            || check.ct_len(i) != row.len || check.ct_sub(i) != row.sub) { return 4 }
        if (check.ct_is_integer(i) != support.ty_is_integer(i)
            || check.ct_is_float(i) != support.ty_is_float(i)
            || check.ct_is_signed(i) != support.ty_is_signed(i)) { return 5 }
        i += 1
    }
    // 新增一行的场景：绑定的是「槽」而不是表内容，因此表扩容（可能搬走
    // 缓冲区）后**不重新 sync** 也必须读到新行——这是 F4-1 安全替换的前提。
    let before int = n
    if (gen.ty_ptr(gen.TY_I32) < 0) { return 6 }
    if (comptime_bound() != before + 1) { return 7 }
    if (check.ct_elem(before) != gen.TY_I32) { return 8 }
    let grown int = 0
    for grown < 64 {
        // 每个不同长度的数组类型都是新行，必然触发若干次扩容/搬迁。
        if (gen.ty_array(gen.TY_I32, grown + 1) < 0) { return 9 }
        grown += 1
    }
    if (comptime_bound() != before + 65) { return 10 }
    let last gen.CType = support.ms().types[comptime_bound() - 1]
    if (check.ct_kind(comptime_bound() - 1) != last.kind) { return 11 }
    // 符号表镜像：与类型表同一套「槽」语义（表增长后自动跟随）。
    if (gen.scope_push() != 0) { return 14 }
    support.src_ctx().data = "abc".to_type(*u8)
    support.src_ctx().length = 3
    // sym_push 会读「当前 token」的行列做声明位置：给一个最小 token 表。
    let toks [1]token.Tok
    toks[0].line = 1
    toks[0].col = 1
    token.ctx().tokens = &toks[0]
    token.ctx().count = 1
    token.ctx().cap = 1
    token.ctx().pos = 0
    if (gen.sym_push(0, 3, gen.SYM_VAR, gen.TY_I32, gen.F_GLOBAL) < 0) { return 15 }
    let sn int = support.ms().sym_n
    if (sn <= 0) { return 16 }
    if (check.ct_syms_bound() != sn) { return 12 }
    let si int = 0
    for si < sn {
        let sym gen.CSym = support.ms().syms[si]
        if (check.ct_sym_kind(si) != sym.kind || check.ct_sym_type(si) != sym.type_id
            || check.ct_sym_flags(si) != sym.flags
            || check.ct_sym_ready(si) != sym.const_ready) { return 13 }
        si += 1
    }
    // F4：`sym_declared_before` 已搬进镜像侧（ct_sym_declared_before）。
    // 用小范围网格做差分：顺序判据必须与 gen 版逐点一致。
    let dl int = 0
    for dl < 4 {
        let dc int = 0
        for dc < 4 {
            if (check.ct_sym_declared_before(0, dl, dc) != gen.sym_declared_before(0, dl, dc)) {
                return 17
            }
            if (check.ct_sym_declared_before(-1, dl, dc) != gen.sym_declared_before(-1, dl, dc)) {
                return 18
            }
            dc += 1
        }
        dl += 1
    }
    // F4：导入表镜像 + 两个前端模式位槽（都不再经 support.FrontCtx 直接读）。
    if (check.ct_import_count() != support.fs().import_n) { return 21 }
    if (support.fs().import_n > 0
        && check.ct_import_module(0) != support.fs().import_mod[0]) { return 22 }
    support.fc().c_fold = 7
    if (check.ct_fold_mode() != 7) { return 23 }
    support.fc().c_fold = 0
    if (check.ct_fold_mode() != 0) { return 24 }
    check.ct_res_is_addr_set(1)
    if (support.fc().c_res_is_addr != 1) { return 25 }
    check.ct_res_is_addr_set(0)
    if (support.fc().c_res_is_addr != 0) { return 26 }
    printf("ct-facts=ok rows=%d syms=%d\n", before, sn)
    return 0
}

// comptime_bound / ct_*：跨模块转发，避免 main 直接依赖 comptime 模块名。
fn comptime_bound() int {
    return check.ct_types_bound()
}
