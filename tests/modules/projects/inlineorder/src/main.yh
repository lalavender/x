module main;

// plain：非 inline，带循环让 SSA 文本长度变化明显。
fn plain(n int) int {
    let total int = 0;
    let i int = 0;
    for i < n {
        total += i;
        i += 1;
    }
    return total;
}

// plus_two：inline，声明在非 inline 函数之后。
@[inline]
fn plus_two(value int) int {
    return value + 2;
}

fn main() int {
    let a int = plain(5);
    let b int = plus_two(40);
    if (a != 10) { return 1; }
    if (b != 42) { return 2; }
    return 0;
}
