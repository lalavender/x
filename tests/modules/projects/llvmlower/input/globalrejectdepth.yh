module badglobal;

// Links：五级指针字段的零值可静态物化，但其字段地址超出 canonical 指针类型范围。
pub struct Links { pp *****int; }
let links Links = Links{ pp: 0 };

// rejected_pointer_depth：超出 canonical 指针层级时应拒绝，不能构造越界 IR 类型。
fn rejected_pointer_depth() int {
    if (links.pp != 0) { return 1; }
    return 0;
}

// main：提供入口，保证必须由 lowering 而非缺失 main 的链接阶段拒绝。
fn main() int { return 0; }
