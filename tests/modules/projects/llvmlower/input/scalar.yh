module sample;

// inc：普通直接调用目标。
fn inc(x int) int { return x + 1; }

// noop：void 直接调用必须保留副作用指令并使用无结果 CALL。
fn noop(x int) void { let y int = x + 1; return; }

// arithmetic：顺序绑定、赋值、条件分支和短路合流。
fn arithmetic(x int) int {
    let y int = x;
    if (x > 2 && x < 20) { y += 3; } else { y = 9; }
    noop(y);
    return inc(y);
}

// loop：条件循环的携带变量和两个分支出口。
fn loop(x int) int {
    let y int = 0;
    for y < x { y += 1; }
    return y;
}

// checked_only：编译期函数不是运行期 lowering 覆盖项。
@[comptime] fn checked_only(x int) int { return x + 1; }

// main：合法入口，fixture 只转换其受检快照。
fn main() int { return arithmetic(5) + loop(4); }
