module checkcache;

// LA3 函数级 IR 缓存 fixture：4 个运行期函数，其中一个产生字符串全局贡献。
fn add_one(value int) int {
    return value + 1;
}

fn twice(value int) int {
    return value * 2;
}

fn text_marker() int {
    let text *char = "cache-marker";
    if (text[0] == 'c') {
        return 1;
    }
    return 0;
}

fn main() int {
    return add_one(0) + twice(2) + text_marker() == 6 ? 0 : 1;
}
