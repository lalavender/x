module sample;

struct Pair {
    x int;
    y int;
}

struct Box {
    inner Pair;
    tag int;
}

// struct_body：结构体字面量、嵌套字段、按值复制与字段复合赋值；
// LL5 结构体切片起必须降低成功（ALLOCA/GEP/LOAD/STORE/MEMCPY）。
fn struct_body(x int) int {
    let p Pair = Pair{ x: x, y: 2 };
    let q Pair = p;
    q.x += 1;
    let b Box = Box{ inner: Pair{ x: 3, y: 4 }, tag: 5 };
    return p.x + q.x + b.inner.y + b.tag;
}

// main：入口函数。
fn main() int { return 0; }
