module badglobal;

// TEXT：常量保存的是字符串地址，标签号只是编译器元数据。
const TEXT *char = "abc";

// numeric：字符串地址不能折叠成标签号整数，本片尚不支持指针转整数。
fn numeric() u64 { return TEXT.to_type(u64); }

// text：指针读取与整数转换共享同一常量，禁止用数值碰撞判断来源。
fn text() *char { return TEXT; }

// main：保证错误放行时也不能借缺失入口的链接失败伪装 lowering 拒绝。
fn main() int { return 0; }
