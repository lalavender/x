module mutual;

fn is_even(n int) int {
    if (n == 0) { return 1; }
    return is_odd(n - 1);
}

fn is_odd(n int) int {
    if (n == 0) { return 0; }
    return is_even(n - 1);
}

fn text() int {
    let s *char = "static-text";
    if (s[0] == 's') { return 1; }
    return 0;
}

fn main() int {
    return is_even(4) + text() == 2 ? 0 : 1;
}
