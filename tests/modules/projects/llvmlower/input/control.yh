module sample;

// control_body：嵌套循环、无限循环、break/continue 与循环携带；
// LL4 首片起必须降低成功并产生 phi。循环体内声明的绑定不进入外层携带。
fn control_body(x int) int {
    let total int = 0;
    let i int = 0;
    for i < x {
        let j int = 0;
        for j < 3 {
            j += 1;
            if (j == 2) { continue; }
            total += 1;
        }
        i += 1;
    }
    let k int = 0;
    for {
        k += 1;
        if (k >= x) { break; }
    }
    switch x {
        case 0 { total += 1; }
        case 1, 2 { total += 2; }
        default { total += 3; }
    }
    return total + k;
}

// main：入口函数。
fn main() int { return 0; }
