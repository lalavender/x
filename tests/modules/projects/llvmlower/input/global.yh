module sample;

// Point：快照须保留字段布局，且导出常量只能使用导出类型。
pub struct Point { x int; y int; }
// Box：递归字面量物化时，内部字段必须相对本层对象偏移。
struct Box { tag u8; point Point; ptr *int; }
// Cell：未初始化的 union 按完整对象大小清零。
union Cell { word i64; byte u8; }
// Mode：枚举属于整数标量全局初始化的支持面。
enum Mode { off; ready = 7; }

const STEP int = 6 * 7;
let global_body int = STEP;
let global_zero i64;
let global_bool bool = true;
let global_char char = 'Z';
let global_enum Mode = Mode.ready;
let global_values [3]int = [1, 2, 3];
let global_nulls [2]*int = [0, 0];
let global_box Box = Box{ tag: 2, point: Point{ x: 4, y: 5 }, ptr: 0 };
let global_cell Cell;
pub const PUBLIC_VALUES [2]int = [7, 8];
const PRIVATE_POINT Point = Point{ x: 9, y: 10 };

// global_string：字符串表达式必须进入匿名全局，包含嵌入 NUL 与转义。
fn global_string() *char { return "A\n\x42\0C"; }

// main：全局对象与常量引用必须在源 arena 销毁后仍能独立降低。
fn main() int {
    let p *int = &global_body;
    *p += 1;
    let a [2]int = PUBLIC_VALUES;
    let point Point = PRIVATE_POINT;
    let box Box = global_box;
    let view []int = global_values[1..3];
    view[0] = 20;
    global_box.point.x = 40;
    let text *char = global_string();
    return global_body + STEP + global_zero.to_type(int) + global_bool.to_type(int) +
        global_char.to_type(int) + global_enum.to_type(int) + len(global_values) + global_values[1] +
        a[0] + point.y + box.point.x + text[0].to_type(int) + global_cell.byte.to_type(int);
}
