module sample;

// array_body：局部定长数组的字面量、下标复合赋值与按值复制；
// LL5 聚合首片起必须降低成功（ALLOCA/GEP/LOAD/STORE/MEMCPY）。
fn array_body(x int) int {
    let a [3]int = [x, 2, 3];
    let b [3]int = a;
    b[1] += 1;
    let i int = 0;
    for i < 3 {
        a[i] += b[i];
        i += 1;
    }
    let c [2][3]int = [[1, 2, 3], [4, 5, 6]];
    return a[0] + b[2] + c[1][2];
}

// main：入口函数。
fn main() int { return 0; }
