module main;
import core.ast;
import core.ir;

// main：由测试专用前端装载真实 .yh、捕获再销毁源 arena，随后执行纯快照降低。
fn main(argc int, argv **char) int {
    if (argc != 3) { return 90; }
    let checked ast.CheckedModule;
    if (lower_fixture_capture(argv[1], &checked) != 0) { return 91; }
    let unit ir.IRModule;
    let result int = ast.lower_module(&checked, &unit);
    ast.checked_module_release(&checked);
    if (argv[2][0] == '1') {
        if (result != 1 || unit.version != 0 || unit.functions != 0 || unit.types != 0) { return 92; }
        ir.ir_module_release(&unit);
        printf("lower-rejected=ok\n");
        return 0;
    }
    if (result != 0 || ir.ir_module_verify(&unit) != 0) { return 93; }
    let phis int = 0;
    let calls int = 0;
    let i int = 0;
    for i < unit.function_count {
        phis += unit.functions[i].body.phi_count;
        calls += unit.functions[i].body.call_count;
        i += 1;
    }
    printf("lower-snapshot=ok functions=%d phis=%d calls=%d\n", unit.function_count, phis, calls);
    ir.ir_module_release(&unit);
    ir.ir_module_release(&unit);
    return 0;
}
