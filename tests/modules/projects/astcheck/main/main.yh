module main;
import lex;
import token;
import support

import table
import ast;
import check;
import proj;
import libs.list;

// astcheck：以手工构造的最小合法 AST 视图和受控损坏项验证独立检查模块。
pub fn main() int {
    support.session_reset();
    proj.fscope_reset();
    lex.reset();
    proj.init();
    support.bind_cfg(proj.cfg());
    let gs *support.FrontCtx = support.fc();
    let files [1]proj.PFile;
    let pdecls [1]token.PDecl;
    let tokens [2]token.Tok;
    let symbols [1]table.CSym;
    let exprs [1]ast.AstExpr;
    let stmts [1]ast.AstStmt;
    let decls [1]ast.AstDecl;
    let functions [1]ast.AstFunctionContext;

    files[0].decls = &pdecls[0];
    files[0].decl_n = 1;
    files[0].tokens = &tokens[0];
    files[0].token_n = 2;
    pdecls[0].start = 0;
    pdecls[0].end = 2;
    pdecls[0].kind = token.TK_FN;
    tokens[0].kind = token.TOK_IDENT;
    tokens[1].kind = token.TOK_EOF;
    symbols[0].kind = table.SYM_FN;
    symbols[0].type_id = 0;

    proj.ctx().files = list.make(sizeof(proj.PFile).to_type(u64));
    if (list.push(&proj.ctx().files, (&files[0]).to_type(*void)) != list.status_ok) { return 12; }
    // B1-1 窄口：文件表搬到 proj 后，前端只经 file()/file_count() 读。
    if (proj.file_count() != 1 || proj.file(0).decls != &pdecls[0]
        || proj.file(0).decl_n != 1) { return 12; }
    table.ms().type_n = 1;
    table.ms().syms = &symbols[0];
    table.ms().sym_n = 1;
    support.session().ast_capture = 1;

    exprs[0].kind = ast.AST_EXPR_PRIMARY;
    exprs[0].first = 0;
    exprs[0].after = 1;
    exprs[0].token_count = 2;
    exprs[0].file_id = 0;
    exprs[0].type_id = 0;
    exprs[0].owner_decl = 0;
    exprs[0].sym_id = -1;
    exprs[0].binding_row = -1;
    exprs[0].sym_type_id = -1;
    exprs[0].sym_kind = -1;
    exprs[0].layout_type_id = -1;
    exprs[0].child0 = -1;
    exprs[0].child1 = -1;
    exprs[0].child2 = -1;

    stmts[0].kind = ast.AST_STMT_BLOCK;
    stmts[0].first = 0;
    stmts[0].after = 1;
    stmts[0].token_count = 2;
    stmts[0].file_id = 0;
    stmts[0].parent = -1;
    stmts[0].first_child = -1;
    stmts[0].last_child = -1;
    stmts[0].next_sibling = -1;
    stmts[0].root_next = -1;
    stmts[0].first_expr = -1;
    stmts[0].last_expr = -1;
    stmts[0].first_binding = -1;
    stmts[0].last_binding = -1;

    decls[0].kind = token.TK_FN;
    decls[0].first = 0;
    decls[0].after = 2;
    decls[0].token_count = 2;
    decls[0].file_id = 0;
    decls[0].decl_index = 0;
    decls[0].name_token = 0;
    decls[0].body_stmt = 0;
    decls[0].sym_id = 0;
    decls[0].type_id = 0;
    decls[0].init_expr = -1;

    functions[0].file_id = 0;
    functions[0].owner_decl = 0;
    functions[0].decl_row = 0;
    functions[0].token_first = 0;
    functions[0].token_after = 2;
    functions[0].expr_first = 0;
    functions[0].expr_after = 1;
    functions[0].stmt_first = 0;
    functions[0].stmt_after = 1;
    functions[0].edge_first = 0;
    functions[0].edge_after = 0;
    functions[0].binding_first = 0;
    functions[0].binding_after = 0;
    functions[0].body_stmt = 0;
    functions[0].asm_first = 0;
    functions[0].asm_after = 0;

    let view ast.AstView;
    view.expr_nodes = &exprs[0];
    view.expr_count = 1;
    view.expr_parse_depth = 0;
    view.stmt_nodes = &stmts[0];
    view.stmt_count = 1;
    view.stmt_exprs = 0;
    view.stmt_expr_count = 0;
    view.stmt_current = -1;
    view.stmt_root_first = 0;
    view.stmt_root_last = 0;
    view.bindings = 0;
    view.binding_count = 0;
    view.comptime_fors = 0;
    view.comptime_for_count = 0;
    view.decl_nodes = &decls[0];
    view.decl_count = 1;
    view.function_nodes = &functions[0];
    view.function_count = 1;
    view.function_cap = 1;
    view.function_active = 0;
    if (check.verify_module(&view) != 0) { return 1; }
    if (view.expr_count != 1 || view.expr_nodes[0].kind != ast.AST_EXPR_PRIMARY
        || view.stmt_nodes != &stmts[0] || view.stmt_count != 1
        || view.stmt_root_first != 0 || view.stmt_root_last != 0
        || view.decl_nodes != &decls[0] || view.decl_count != 1
        || view.function_nodes != &functions[0] || view.function_count != 1
        || view.function_active != 0) {
        return 2;
    }

    exprs[0].child0 = 1;
    if (check.verify_module(&view) == 0 || exprs[0].child0 != 1
        || view.expr_nodes != &exprs[0]) { return 3; }
    exprs[0].child0 = -1;

    stmts[0].root_next = 0;
    if (check.verify_module(&view) == 0 || stmts[0].root_next != 0) { return 4; }
    stmts[0].root_next = -1;

    decls[0].body_stmt = -1;
    if (check.verify_module(&view) == 0 || decls[0].body_stmt != -1) { return 5; }
    decls[0].body_stmt = 0;

    functions[0].expr_after = 2;
    if (check.verify_module(&view) == 0 || functions[0].expr_after != 2) { return 6; }
    functions[0].expr_after = 1;

    let bad_bindings [1]ast.AstBinding;
    bad_bindings[0].id = -1;
    view.bindings = &bad_bindings[0];
    view.binding_count = 1;
    if (check.verify_module(&view) == 0 || bad_bindings[0].id != -1) { return 7; }

    let for_stmts [2]ast.AstStmt;
    let for_bindings [1]ast.AstBinding;
    let for_templates [1]ast.AstComptimeFor;
    for_stmts[0].kind = ast.AST_STMT_COMPTIME;
    for_stmts[0].op = token.TK_FOR;
    for_stmts[0].first = 0;
    for_stmts[0].after = 2;
    for_stmts[0].token_count = 2;
    for_stmts[0].file_id = 0;
    for_stmts[0].parent = -1;
    for_stmts[0].first_child = 1;
    for_stmts[0].last_child = 1;
    for_stmts[0].next_sibling = -1;
    for_stmts[0].root_next = -1;
    for_stmts[0].first_expr = -1;
    for_stmts[0].last_expr = -1;
    for_stmts[0].first_binding = 0;
    for_stmts[0].last_binding = 0;
    for_stmts[1].kind = ast.AST_STMT_BLOCK;
    for_stmts[1].first = 1;
    for_stmts[1].after = 2;
    for_stmts[1].token_count = 2;
    for_stmts[1].file_id = 0;
    for_stmts[1].parent = 0;
    for_stmts[1].first_child = -1;
    for_stmts[1].last_child = -1;
    for_stmts[1].next_sibling = -1;
    for_stmts[1].root_next = -1;
    for_stmts[1].first_expr = -1;
    for_stmts[1].last_expr = -1;
    for_stmts[1].first_binding = -1;
    for_stmts[1].last_binding = -1;
    for_bindings[0].id = 0;
    for_bindings[0].sym_id = 0;
    for_bindings[0].sym_type_id = 0;
    for_bindings[0].sym_kind = table.SYM_VAR;
    for_bindings[0].file_id = 0;
    for_bindings[0].owner_decl = 0;
    for_bindings[0].stmt_id = 0;
    for_bindings[0].name_token = 0;
    for_bindings[0].is_param = 0;
    for_bindings[0].next = -1;
    for_templates[0].stmt_id = 0;
    for_templates[0].binding_row = 0;
    for_templates[0].binding_after = 1;
    for_templates[0].body_stmt = 1;
    for_templates[0].low = 0;
    for_templates[0].high = 1;
    for_templates[0].node_cost = 1;
    view.stmt_nodes = &for_stmts[0];
    view.stmt_count = 2;
    view.bindings = &for_bindings[0];
    view.binding_count = 1;
    view.comptime_fors = &for_templates[0];
    view.comptime_for_count = 1;
    if (check.verify_module(&view) == 0
        || for_bindings[0].sym_kind != table.SYM_VAR) { return 8; }

    let bad_exprs [1]ast.AstExpr;
    bad_exprs[0].kind = 0;
    view.expr_nodes = &bad_exprs[0];
    view.expr_count = 1;
    support.session().ast_capture = 0;
    if (check.verify_module(&view) != 0 || bad_exprs[0].kind != 0) { return 9; }

    support.session().ast_capture = 1;
    ast.ast_expr_reset();
    ast.ast_stmt_reset();
    ast.ast_decl_reset();
    ast.ast_function_reset();
    support.session().active_file = 0;
    ast.store().file_decl_i = 0;
    token.ctx().count = 2;
    if (ast.ast_expr_add(ast.AST_EXPR_PRIMARY, 0, 0, 1, 0, -1, -1, -1) < 0) {
        return 10;
    }
    let borrowed ast.AstView;
    ast.ast_view(&borrowed);
    if (borrowed.expr_count != 1 || borrowed.expr_nodes[0].kind != ast.AST_EXPR_PRIMARY
        || check.verify_module(&borrowed) != 0) { return 11; }
    return 0;
}
