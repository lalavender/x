module main

import hash

// hs_eq：比较 64 位十六进制摘要与期望文本。
fn hs_eq(digest *u8, expected *char) int {
    let hex [65]u8
    hash.sha256_hex(digest, &hex[0])
    let i int = 0
    for i < 64 {
        if (hex[i] != expected[i].to_type(u8)) { return 0 }
        i += 1
    }
    return 1
}

// hs_text：一次性哈希 NUL 结尾文本。
fn hs_text(text *char, out *u8) int {
    return hash.sha256_digest(text.to_type(*u8), strlen(text), out)
}

// main：SHA-256 库的跨模块公开面与 NIST 向量 smoke。
fn main() int {
    let digest [32]u8
    if (hs_text("", &digest[0]) != 0 || hs_eq(&digest[0],
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") == 0) {
        return 1
    }
    if (hs_text("abc", &digest[0]) != 0 || hs_eq(&digest[0],
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 0) {
        return 2
    }
    printf("hash sha256 ok\n")
    return 0
}
