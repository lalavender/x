module main;
import check
import lex;
import types
import support
import table
import token;
import proj;

// main：受检前端边界——进入/校验/退出可重复，不依赖任何旧输出缓冲。
// LL12：旧汇编缓冲与发射 API 已删除，本用例只验证受检前端的进入与退出。
fn main() int {
    support.session_reset();
    proj.fscope_reset();
    lex.reset();
    proj.init();
    support.bind_cfg(proj.cfg());
    let gs *support.FrontCtx = support.fc();
    if (check.front_checked_begin() != 0 || support.session().check_only != 0) { return 2; }
    if (check.sem_init_tables() != 0) { return 5; }
    check.ty_register_builtins();
    table.scope_push();
    support.src_ctx().data = "zero".to_type(*u8);
    support.src_ctx().length = 4;
    let tokens [1]token.Tok;
    tokens[0].line = 1;
    tokens[0].col = 1;
    token.ctx().tokens = &tokens[0];
    token.ctx().count = 1;
    token.ctx().pos = 0;
    let symbol int = check.sym_push(0, 4, table.SYM_VAR, types.TY_I32, table.F_GLOBAL);
    if (symbol < 0) { return 6; }
    if (check.front_checked_verify() != 0) { return 7; }
    if (check.front_checked_end() != 0) { return 9; }
    // 退出后可以再次进入：边界没有残留输出。
    if (check.front_checked_begin() != 0) { return 10; }
    if (check.front_checked_end() != 0) { return 11; }
    printf("front-boundary=ok\n");
    return 0;
}
