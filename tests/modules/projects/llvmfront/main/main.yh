module main;
import gen;

// main：受检前端独立于 check 开关，禁止所有旧汇编缓冲分配和写入，结束后恢复旧路径。
fn main() int {
    gen.state_init();
    let gs *gen.GenState = gen.G();
    if (gen.front_checked_begin() != 0 || gs.task.c_check_only != 0) { return 2; }
    if (gen.em_puts("old text") != 0 || gen.dat_puts("old data") != 0) { return 3; }
    gs.task.c_in_body = 1;
    if (gen.em_puts("old body") != 0) { return 4; }
    gs.task.c_in_body = 0;
    if (gen.sem_init_tables() != 0) { return 5; }
    gen.ty_register_builtins();
    gen.scope_push();
    gs.task.c_src = "zero".to_type(*u8);
    let tokens [1]gen.Tok;
    tokens[0].line = 1;
    tokens[0].col = 1;
    gs.task.c_toks = &tokens[0];
    gs.task.c_tok_n = 1;
    let symbol int = gen.sym_push(0, 4, gen.SYM_VAR, gen.TY_I32, gen.F_GLOBAL);
    if (symbol < 0 || gen.em_bss_symbol(symbol, 4, 4) != 0) { return 6; }
    if (gen.front_checked_verify() != 0 || gs.task.o_out != 0 || gs.task.o_dat != 0
        || gs.task.o_bss != 0 || gs.task.o_body != 0) { return 7; }
    // 校验不会清除非法输出来伪造成功；任何绕过入口写出的字节都必须被拒绝。
    gs.task.c_spec = 1;
    gs.task.o_len = 1;
    if (gen.front_checked_verify() == 0) { return 8; }
    gs.task.o_len = 0;
    if (gen.front_checked_end() != 0 || gen.em_put('x') != 0 || gs.task.o_len != 1) { return 9; }
    if (gen.front_checked_begin() == 0 || gs.task.o_len != 1) { return 10; }
    gs.task.c_spec = 0;
    printf("front-boundary=ok\n");
    return 0;
}
