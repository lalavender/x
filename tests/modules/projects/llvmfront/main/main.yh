module main;
import gen;
import proj;

// main：受检前端边界——进入/校验/退出可重复，不依赖任何旧输出缓冲。
// LL12：旧汇编缓冲与发射 API 已删除，本用例只验证受检前端的进入与退出。
fn main() int {
    gen.state_init();
    proj.init();
    gen.bind_cfg(proj.cfg());
    let gs *gen.GenState = gen.G();
    if (gen.front_checked_begin() != 0 || gs.task.c_check_only != 0) { return 2; }
    if (gen.sem_init_tables() != 0) { return 5; }
    gen.ty_register_builtins();
    gen.scope_push();
    gs.task.c_src = "zero".to_type(*u8);
    let tokens [1]gen.Tok;
    tokens[0].line = 1;
    tokens[0].col = 1;
    gs.task.c_toks = &tokens[0];
    gs.task.c_tok_n = 1;
    let symbol int = gen.sym_push(0, 4, gen.SYM_VAR, gen.TY_I32, gen.F_GLOBAL);
    if (symbol < 0) { return 6; }
    if (gen.front_checked_verify() != 0) { return 7; }
    if (gen.front_checked_end() != 0) { return 9; }
    // 退出后可以再次进入：边界没有残留输出。
    if (gen.front_checked_begin() != 0) { return 10; }
    if (gen.front_checked_end() != 0) { return 11; }
    printf("front-boundary=ok\n");
    return 0;
}
