module main;

import math;
import json;

pub struct Pt {
    x int;
    y int;
}

fn apply(h fn(int) int, v int) int {
    return h(v);
}

fn inc(v int) int {
    return v + 1;
}

fn main() int {
    let p Pt;
    p.x = math.add(1, 2);
    p.y = json.bump(json.Score { v: math.mul(2, 3), tag: json.scale(4, 2.5) });
    let f f64 = json.scale(2, 1.5);
    return p.x + p.y + apply(inc, 0) + f.to_type(int);
}
