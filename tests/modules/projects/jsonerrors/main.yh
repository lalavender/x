module main

// JSON 错误验收：严格 profile 的拒绝路径、错误码与重复键关联位置。

import io
import json

let failed int = 0

// ok 记录一条断言结果。
fn ok(condition int, name *char) void {
    if (condition == 0) {
        failed += 1
        io.print("FAIL ")
        io.println(name)
    }
}

// expect_error 断言 NUL 结尾输入被拒绝且错误码匹配。
fn expect_error(text *char, code json.ErrorCode, name *char) void {
    let result json.ParseResult = json.parse_text(text)
    if (result.status == json.parse_ok) {
        ok(0, name)
        json.release(&result.document)
        return
    }
    ok((result.document.handle == 0).to_type(int), name)
    ok((result.error.code == code).to_type(int), name)
}

// expect_error_bytes 断言显式长度输入被拒绝且错误码匹配。
fn expect_error_bytes(data *u8, count u64, code json.ErrorCode,
    name *char) void {
    let result json.ParseResult = json.parse(data, count)
    if (result.status == json.parse_ok) {
        ok(0, name)
        json.release(&result.document)
        return
    }
    ok((result.error.code == code).to_type(int), name)
}

// check_encoding 断言 BOM 与非法 UTF-8 被拒绝。
fn check_encoding() void {
    let bom [8]u8
    bom[0] = 239
    bom[1] = 187
    bom[2] = 191
    bom[3] = 123
    bom[4] = 125
    expect_error_bytes(&bom[0], 5, json.error_bom, "bom")

    let invalid [3]u8
    invalid[0] = 123
    invalid[1] = 255
    invalid[2] = 125
    expect_error_bytes(&invalid[0], 3, json.error_utf8, "invalid utf8")

    let overlong [4]u8
    overlong[0] = 34
    overlong[1] = 192
    overlong[2] = 175
    overlong[3] = 34
    expect_error_bytes(&overlong[0], 4, json.error_utf8, "overlong utf8")
}

// check_strings 断言字符串层拒绝。
fn check_strings() void {
    expect_error("\"\\q\"", json.error_syntax, "bad escape")
    expect_error("\"\\u12\"", json.error_syntax, "short unicode escape")
    expect_error("\"\\uD800\"", json.error_surrogate, "lone high surrogate")
    expect_error("\"\\uDC00\"", json.error_surrogate, "lone low surrogate")
    expect_error("\"abc", json.error_syntax, "unterminated string")

    let control [4]u8
    control[0] = 34
    control[1] = 9
    control[2] = 34
    control[3] = 0
    expect_error_bytes(&control[0], 3, json.error_syntax, "raw control char")
}

// check_numbers 断言数字 grammar 拒绝。
fn check_numbers() void {
    expect_error("+1", json.error_syntax, "plus sign")
    expect_error("01", json.error_syntax, "leading zero")
    expect_error("1.", json.error_syntax, "trailing dot")
    expect_error(".1", json.error_syntax, "leading dot")
    expect_error("1e", json.error_syntax, "empty exponent")
    expect_error("-", json.error_syntax, "lone minus")
    expect_error("1e+", json.error_syntax, "empty signed exponent")
}

// check_structure 断言结构层拒绝。
fn check_structure() void {
    expect_error("[1,]", json.error_syntax, "trailing comma")
    expect_error("{\"a\":1,}", json.error_syntax, "object trailing comma")
    expect_error("truex", json.error_syntax, "literal suffix")
    expect_error("1 2", json.error_syntax, "trailing content")
    expect_error("{a:1}", json.error_syntax, "bare key")
    expect_error("[1 2]", json.error_syntax, "missing comma")
    expect_error("{\"a\" 1}", json.error_syntax, "missing colon")
    expect_error("[", json.error_syntax, "unclosed array")
    expect_error("{", json.error_syntax, "unclosed object")
}

// check_duplicate 断言重复键被拒绝并关联第一次出现。
fn check_duplicate() void {
    let result json.ParseResult = json.parse_text("{\"k\":1,\"k\":2}")
    ok((result.status == json.parse_syntax_error).to_type(int), "duplicate status")
    ok((result.error.code == json.error_duplicate_key).to_type(int),
        "duplicate code")
    ok((result.error.has_related == 1).to_type(int), "duplicate related")
    ok((result.error.related.column == 2).to_type(int), "duplicate first column")
    ok((result.error.span.column == 8).to_type(int), "duplicate second column")
    ok((result.document.handle == 0).to_type(int), "duplicate no doc")
}

// check_depth 断言超过嵌套上限报资源错误。
fn check_depth() void {
    let text [601]u8
    let i int = 0
    for i < 300 {
        text[i] = 91
        i += 1
    }
    for i < 600 {
        text[i] = 93
        i += 1
    }
    text[600] = 0
    let result json.ParseResult = json.parse(&text[0], 600)
    ok((result.status == json.parse_resource_error).to_type(int), "depth status")
    ok((result.error.code == json.error_resource_limit).to_type(int), "depth code")
}

// check_argument 断言参数错误分类。
fn check_argument() void {
    let result json.ParseResult = json.parse(0, 5)
    ok((result.status == json.parse_argument_error).to_type(int), "null input")
    let empty json.ParseResult = json.parse_text(0)
    ok((empty.status == json.parse_argument_error).to_type(int), "null text")
}

// main 跑错误断言。
fn main() int {
    check_encoding()
    check_strings()
    check_numbers()
    check_structure()
    check_duplicate()
    check_depth()
    check_argument()
    if (failed == 0) {
        io.println("json errors ok")
        return 0
    }
    return 1
}
