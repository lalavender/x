module main
import support

// main：跨模块消费 support 的纯字节工具与十六进制转换，验证 GEN1 迁出的
// append_*/hexval/cstr_eq 在真实项目依赖下仍按公开接口可用。
fn main() int {
    if (support.hexval('0') != 0 || support.hexval('9') != 9
        || support.hexval('a') != 10 || support.hexval('F') != 15) { return 1 }
    let buf [16]u8
    let n int = support.append_int(buf, 0, -42)
    if (n != 3 || buf[0] != '-' || buf[1] != '4' || buf[2] != '2') { return 2 }
    n = support.append_str(buf, 0, "ok")
    buf[n] = 0
    if (n != 2 || support.cstr_eq(support.arr_cstr(buf), "ok") == 0) { return 3 }
    let sized [8]u8
    n = support.append_str_cap(sized, 8, 0, "abcdefghij")
    if (n != 7 || sized[7] != 0) { return 4 }
    printf("support-buffer=ok\n")
    return 0
}
