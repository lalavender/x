module main
import support

// main：跨模块消费 support 的纯字节工具与十六进制转换，验证 GEN1 迁出的
// append_*/hexval/cstr_eq 在真实项目依赖下仍按公开接口可用。
fn main() int {
    if (support.hexval('0') != 0 || support.hexval('9') != 9
        || support.hexval('a') != 10 || support.hexval('F') != 15) { return 1 }
    let buf [16]u8
    let n int = support.append_int(buf, 0, -42)
    if (n != 3 || buf[0] != '-' || buf[1] != '4' || buf[2] != '2') { return 2 }
    n = support.append_str(buf, 0, "ok")
    buf[n] = 0
    if (n != 2 || support.cstr_eq(support.arr_cstr(buf), "ok") == 0) { return 3 }
    let sized [8]u8
    n = support.append_str_cap(sized, 8, 0, "abcdefghij")
    if (n != 7 || sized[7] != 0) { return 4 }
    // 静态数据目录（F4：从 gen 下沉到 support）：增/写/重定位/替换/复位全链。
    support.static_data_reset()
    // 第 0 行：4 字节匿名 backing（elem_type=u8、count=4），按小端写标量。
    let row int = support.static_data_add(-1, 7, -1, 7, 4, 4, 1)
    if (row < 0 || support.static_data_count() != 1) { return 5 }
    if (support.static_data_scalar(row, 0, 1, 0x41) != 0
        || support.static_data_scalar(row, 1, 1, 0x42) != 0) { return 6 }
    // 第 1 行：8 字节指针槽，重定位指向标签 7（上面那一行）。
    let prow int = support.static_data_add(-1, 8, -1, 7, 8, 8, 8)
    if (prow < 0 || support.static_data_count() != 2) { return 7 }
    if (support.static_data_reloc(prow, 0, -1, 7, 3) != 0) { return 8 }
    let obj support.StaticDataObject
    if (support.static_data_at(row, &obj) != 0 || obj.size != 4 || obj.data[0] != 0x41) { return 9 }
    if (support.static_data_at(prow, &obj) != 0 || obj.reloc_n != 1
        || obj.relocs[0].target_label != 7 || obj.relocs[0].addend != 3) { return 10 }
    // 越界写入必须报错（诊断为 0 返回，不静默截断）。
    if (support.static_data_scalar(row, 3, 4, 1) == 0) { return 11 }
    // 同标签重复登记替换原行，行数不变。
    if (support.static_data_add(-1, 7, -1, 7, 2, 2, 1) != row) { return 12 }
    if (support.static_data_count() != 2) { return 13 }
    support.static_data_reset()
    if (support.static_data_count() != 0) { return 14 }
    // 受检前端阶段位（F4：从 gen.TaskCtx 下沉到 support.session）。
    // 未进入时要判失败；进入后退出一致；重复进入必须报错且不改状态。
    if (support.front_checked_verify() == 0) { return 15 }
    if (support.front_checked_begin() != 0) { return 16 }
    if (support.front_checked_begin() == 0) { return 17 }
    if (support.front_checked_verify() != 0) { return 18 }
    if (support.front_checked_end() != 0) { return 19 }
    if (support.front_checked_verify() == 0) { return 20 }
    // 编译期值规则（F4：从 gen 下沉）——整数归一化/浮点位模式/谓词/布局。
    support.mstore_reset()
    if (support.model_type_push(support.TY_I32, 4, 4, -1, -1, -1) != 0) { return 21 }
    if (support.model_type_push(support.TY_U8, 1, 1, -1, -1, -1) != 1) { return 22 }
    if (support.model_type_push(support.TY_F32, 4, 4, -1, -1, -1) != 2) { return 23 }
    if (support.ty_is_integer(0) == 0 || support.ty_is_signed(0) == 0) { return 24 }
    if (support.ty_is_signed(1) != 0 || support.ty_is_float(0) != 0) { return 25 }
    if (support.ty_is_float(2) == 0 || support.ty_is_integer(2) != 0) { return 26 }
    // u8 截断不做符号扩展；i32 截断保留符号。
    if (support.sem_fold_norm(1, 0x1ff) != 0xff) { return 27 }
    if (support.sem_fold_norm(1, -1) != 255) { return 28 }
    if (support.sem_fold_norm(0, 4294967297) != 1) { return 29 }
    if (support.sem_fold_norm(0, 4294967295) != -1) { return 30 }
    // 浮点位模式往返：f64 位模式 → f32 窄化 → 回收。
    let dbl i64 = support.fp64_bits(1.5)
    if (support.fp64_from_bits(dbl) != 1.5) { return 31 }
    if (support.fp32_bits(dbl) != 0x3fc00000) { return 32 }
    // sem_res_const 必须把整个描述符复位（含编译期诊断字段）。
    let res support.Res
    res.ct_diag = 9
    support.sem_res_const(&res, 0, 7)
    if (res.type_id != 0 || res.is_const != 1 || res.ival != 7) { return 33 }
    if (res.sym != -1 || res.ct_diag != 0 || res.ct_diag_msg_start != -1) { return 34 }
    // 布局：{i32, u8} → 偏移 0/4、大小 8、对齐 4；union → 偏移 0、大小 4。
    let fields [2]support.SField
    fields[0].type_id = 0
    fields[1].type_id = 1
    support.ms().fields = &fields[0]
    support.ms().field_n = 2
    if (support.model_type_push(support.TY_STRUCT, -1, -1, -1, 2, 0) != 3) { return 35 }
    if (support.sem_struct_finish(3, 0) != 0) { return 36 }
    if (support.ms().fields[0].offset != 0 || support.ms().fields[1].offset != 4) { return 37 }
    if (support.ms().types[3].size != 8 || support.ms().types[3].align != 4) { return 38 }
    if (support.sem_struct_finish(3, 1) != 0) { return 39 }
    if (support.ms().fields[1].offset != 0 || support.ms().types[3].size != 4) { return 40 }
    printf("support-buffer=ok\n")
    return 0
}
