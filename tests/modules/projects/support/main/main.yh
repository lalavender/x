module main
import types
import support

import table
// main：跨模块消费 support 的纯字节工具与十六进制转换，验证 GEN1 迁出的
// append_*/hexval/cstr_eq 在真实项目依赖下仍按公开接口可用。
fn main() int {
    if (support.hexval('0') != 0 || support.hexval('9') != 9
        || support.hexval('a') != 10 || support.hexval('F') != 15) { return 1 }
    let buf [16]u8
    let n int = support.append_int(buf, 0, -42)
    if (n != 3 || buf[0] != '-' || buf[1] != '4' || buf[2] != '2') { return 2 }
    n = support.append_str(buf, 0, "ok")
    buf[n] = 0
    if (n != 2 || support.cstr_eq(support.arr_cstr(buf), "ok") == 0) { return 3 }
    let sized [8]u8
    n = support.append_str_cap(sized, 8, 0, "abcdefghij")
    if (n != 7 || sized[7] != 0) { return 4 }
    // 静态数据目录（F4：从 gen 下沉到 support）：增/写/重定位/替换/复位全链。
    table.static_data_reset()
    // 第 0 行：4 字节匿名 backing（elem_type=u8、count=4），按小端写标量。
    let row int = table.static_data_add(-1, 7, -1, 7, 4, 4, 1)
    if (row < 0 || table.static_data_count() != 1) { return 5 }
    if (table.static_data_scalar(row, 0, 1, 0x41) != 0
        || table.static_data_scalar(row, 1, 1, 0x42) != 0) { return 6 }
    // 第 1 行：8 字节指针槽，重定位指向标签 7（上面那一行）。
    let prow int = table.static_data_add(-1, 8, -1, 7, 8, 8, 8)
    if (prow < 0 || table.static_data_count() != 2) { return 7 }
    if (table.static_data_reloc(prow, 0, -1, 7, 3) != 0) { return 8 }
    let obj table.StaticDataObject
    if (table.static_data_at(row, &obj) != 0 || obj.size != 4 || obj.data[0] != 0x41) { return 9 }
    if (table.static_data_at(prow, &obj) != 0 || obj.reloc_n != 1
        || obj.relocs[0].target_label != 7 || obj.relocs[0].addend != 3) { return 10 }
    // 越界写入必须报错（诊断为 0 返回，不静默截断）。
    if (table.static_data_scalar(row, 3, 4, 1) == 0) { return 11 }
    // 同标签重复登记替换原行，行数不变。
    if (table.static_data_add(-1, 7, -1, 7, 2, 2, 1) != row) { return 12 }
    if (table.static_data_count() != 2) { return 13 }
    table.static_data_reset()
    if (table.static_data_count() != 0) { return 14 }
    // 受检前端阶段守卫（front_checked_*）已随 ADR-0024 迁到 check，
    // 行为由 llvmfront / llvmlower 两个 fixture 覆盖。
    // 编译期值规则（F4：从 gen 下沉）——整数归一化/浮点位模式/谓词/布局。
    table.mstore_reset()
    if (table.model_type_push(types.TY_I32, 4, 4, -1, -1, -1) != 0) { return 21 }
    if (table.model_type_push(types.TY_U8, 1, 1, -1, -1, -1) != 1) { return 22 }
    if (table.model_type_push(types.TY_F32, 4, 4, -1, -1, -1) != 2) { return 23 }
    if (table.ty_is_integer(0) == 0 || table.ty_is_signed(0) == 0) { return 24 }
    if (table.ty_is_signed(1) != 0 || table.ty_is_float(0) != 0) { return 25 }
    if (table.ty_is_float(2) == 0 || table.ty_is_integer(2) != 0) { return 26 }
    // u8 截断不做符号扩展；i32 截断保留符号。
    if (table.sem_fold_norm(1, 0x1ff) != 0xff) { return 27 }
    if (table.sem_fold_norm(1, -1) != 255) { return 28 }
    if (table.sem_fold_norm(0, 4294967297) != 1) { return 29 }
    if (table.sem_fold_norm(0, 4294967295) != -1) { return 30 }
    // 浮点位模式往返：f64 位模式 → f32 窄化 → 回收。
    let dbl i64 = support.fp64_bits(1.5)
    if (support.fp64_from_bits(dbl) != 1.5) { return 31 }
    if (support.fp32_bits(dbl) != 0x3fc00000) { return 32 }
    // sem_res_const 必须把整个描述符复位（含编译期诊断字段）。
    let res support.Res
    res.ct_diag = 9
    support.sem_res_const(&res, 0, 7)
    if (res.type_id != 0 || res.is_const != 1 || res.ival != 7) { return 33 }
    if (res.sym != -1 || res.ct_diag != 0 || res.ct_diag_msg_start != -1) { return 34 }
    // 布局：{i32, u8} → 偏移 0/4、大小 8、对齐 4；union → 偏移 0、大小 4。
    let fields [2]types.SField
    fields[0].type_id = 0
    fields[1].type_id = 1
    table.ms().fields = &fields[0]
    table.ms().field_n = 2
    if (table.model_type_push(types.TY_STRUCT, -1, -1, -1, 2, 0) != 3) { return 35 }
    if (table.sem_struct_finish(3, 0) != 0) { return 36 }
    if (table.ms().fields[0].offset != 0 || table.ms().fields[1].offset != 4) { return 37 }
    if (table.ms().types[3].size != 8 || table.ms().types[3].align != 4) { return 38 }
    if (table.sem_struct_finish(3, 1) != 0) { return 39 }
    if (table.ms().fields[1].offset != 0 || table.ms().types[3].size != 4) { return 40 }
    // 值内核（F4：从 gen 迁入）——只返回错误码，文案由 vk_msg 统一提供。
    let kres i64 = 0
    if (table.vk_fold_binop(support.TK_SLASH, 0, 1, 0, &kres) != table.VK_DIV_ZERO) { return 41 }
    if (table.vk_fold_unary(support.TK_BANG, 2, 0, 0, &kres) != table.VK_UNARY_FP_OP) { return 42 }
    if (table.vk_can_assign(0, 2, 0, 0, 0) != table.VK_FP_NEEDS_CAST) { return 43 }
    if (table.vk_can_assign(0, 0, 0, 0, 0) != 0) { return 44 }
    if (table.vk_can_assign(1, 0, 1, 300, 0) != table.VK_LIT_OUT_OF_RANGE) { return 45 }
    if (support.cstr_eq(table.vk_msg(table.VK_DIV_ZERO), "编译期除数不能为零") == 0) { return 46 }
    if (support.cstr_eq(table.vk_msg(0), "编译期值运算失败") == 0) { return 47 }
    if (table.vk_fold_binop(support.TK_PLUS, 0, 1, 2, &kres) != 0 || kres != 3) { return 48 }
    printf("support-buffer=ok\n")
    return 0
}
