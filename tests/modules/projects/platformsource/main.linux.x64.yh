module main;

// TimeSpec：Linux x86_64 clock_gettime syscall 使用的时间结构。
pub struct TimeSpec {
    sec i64;
    nsec i64;
}

// main 用 x86_64 syscall 验证架构专属源码已选中。
pub fn main() int {
    let stamp TimeSpec;
    if (linux_syscall6(228.to_type(u64), 1.to_type(u64),
            (&stamp).to_type(u64), 0.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64)) != 0
        || stamp.sec <= 0 || stamp.nsec < 0 || stamp.nsec >= 1000000000) {
        return 1;
    }
    return 32;
}
