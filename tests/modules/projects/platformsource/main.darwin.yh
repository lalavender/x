module main;

// TimeSpec：Darwin clock_gettime 接收的时间结构。
pub struct TimeSpec {
    sec i64;
    nsec i64;
}

pub fn main() int {
    let stamp TimeSpec;
    if (clock_gettime(6, &stamp) != 0 || stamp.sec <= 0
        || stamp.nsec < 0 || stamp.nsec >= 1000000000) {
        return 1;
    }
    return 31;
}
