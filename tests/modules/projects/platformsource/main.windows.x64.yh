module main;

// Windows x86_64 的目标专属源：与 main.linux.x64.yh / main.darwin.yh 对应，
// 验证「按目标选择 main.<os>.<arch>.yh」这条规则在 Windows 上也成立。
// 这里真的调用一次 kernel32（零 CRT 下由 SDK 导入库解析），确认选中的源不仅
// 通过语义检查，还能链接出可运行程序；返回 32 与其它平台变体一致。
@[extern] fn GetCurrentProcessId() i32

pub fn main() int {
    let pid int = GetCurrentProcessId().to_type(int);
    if (pid <= 0) {
        return 31;
    }
    return 32;
}
