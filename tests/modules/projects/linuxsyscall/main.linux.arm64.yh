module main;

fn invoke(callback fn(u64, u64, u64, u64, u64, u64, u64) i64) i64 {
    return callback(172.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

pub fn main() int {
    let pid i64 = linux_syscall6(172.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64));
    let callback fn(u64, u64, u64, u64, u64, u64, u64) i64 = linux_syscall6;
    let indirect i64 = invoke(callback);
    if (pid > 0 && indirect > 0) {
        return 0;
    }
    return 1;
}
