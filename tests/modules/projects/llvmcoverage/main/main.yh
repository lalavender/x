module main;

let observed int = 0;

// scalar：整数参数与返回值可被当前 SSA 和 ARM64 后端完整消费。
fn scalar(value int) int {
    return value + 1;
}

// mutate：全局写入暂不在 SSA 子集中，用它区分受检与实际发射覆盖。
fn mutate(value int) int {
    observed = value;
    return value;
}

// constant：编译期函数不应被计入运行期后端覆盖分母。
@[comptime] fn constant() int {
    return 41;
}

// main：同时运行 SSA 函数与旧路径，结果用退出码自校验。
fn main() int {
    let value int = $constant();
    if (scalar(value) != 42 || mutate(value) != 41) { return 1; }
    return 0;
}
