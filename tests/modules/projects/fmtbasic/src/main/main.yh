module main

import fmt
import string

// view_of 把已知有效的 NUL 结尾文本转成视图。
fn view_of(text *char) string.View {
    let result string.ViewResult = string.view_cstr(text)
    return result.value
}

// expect 比较 String 与期望文本；不同返回 false。
fn expect(value *string.String, expected *char) bool {
    let wanted string.ViewResult = string.view_cstr(expected)
    return string.view_equal(string.as_view(value), wanted.value)
}

// main 覆盖 fmt 的公开 API；输出由安装测试逐字节比对。
fn main() int {
    let values []fmt.Value = [fmt.of_int(1), fmt.of_str(view_of("2"))]
    let joined fmt.TextResult = fmt.sprint(values)
    if (joined.status != fmt.status_ok || !expect(&joined.value, "12")) {
        return 1
    }
    string.release(&joined.value)
    let lines fmt.TextResult = fmt.sprintln(values)
    if (lines.status != fmt.status_ok || !expect(&lines.value, "12\n")) {
        return 2
    }
    string.release(&lines.value)
    let spec string.ViewResult = string.view_cstr(".2f")
    let formatted fmt.TextResult = fmt.render(fmt.of_f64(1.5), spec.value)
    if (formatted.status != fmt.status_ok
        || !expect(&formatted.value, "1.50")) {
        return 3
    }
    string.release(&formatted.value)
    let source string.String = string.make()
    if (fmt.append_text(&source, view_of("hi")) != fmt.status_ok) {
        return 4
    }
    if (fmt.append_value(&source, fmt.of_int(7), view_of("02d"))
        != fmt.status_ok) {
        return 5
    }
    if (!expect(&source, "hi07")) {
        return 6
    }
    fmt.print(values)
    fmt.println(values)
    fmt.fprint(1, values)
    fmt.fprintln(1, values)
    let borrowed []fmt.Value = [fmt.of_string(&source)]
    fmt.println(borrowed)
    string.release(&source)
    return 0
}
