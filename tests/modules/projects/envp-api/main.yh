module main;

// main：通过入口 envp 查找测试环境，验证进程环境能直接传给 yh 程序。
pub fn main(argc int, argv **char, envp **char) int {
    if (argc < 0 || argv == 0 || envp == 0) {
        return 2;
    }
    let expected *char = "YH_ENV_TEST=present";
    let i int = 0;
    for envp[i] != 0 {
        let j int = 0;
        for expected[j] != 0 && envp[i][j] == expected[j] {
            j += 1;
        }
        if (expected[j] == 0 && envp[i][j] == 0) {
            return 0;
        }
        i += 1;
    }
    return 1;
}
