module bridge;

// Pair：跨模块传递和返回的 yh 按值聚合探针。
pub struct Pair {
    left int;
    right int;
}

// CPair：SysV 两个 INTEGER 八字节类别的 C 聚合探针。
@[extern]
pub struct CPair { left int; right int; }

// CMixed：首个八字节为 SSE、第二个为 INTEGER 的 C 聚合探针。
@[extern]
pub struct CMixed { value f64; tag int; }

// CWide：超过两个八字节，必须经 SysV MEMORY/byval/sret 传递。
@[extern]
pub struct CWide { first i64; second i64; third i64; }

// c_i8：声明 C 有符号 8 位标量函数，覆盖 C 签名跨模块接口导出。
@[extern]
pub fn c_i8(value i8) i8;
// c_u8：声明 C 无符号 8 位标量函数。
@[extern]
pub fn c_u8(value u8) u8;
// c_i16：声明 C 有符号 16 位标量函数。
@[extern]
pub fn c_i16(value i16) i16;
// c_u16：声明 C 无符号 16 位标量函数。
@[extern]
pub fn c_u16(value u16) u16;
// c_f32：声明 C 单精度标量函数。
@[extern]
pub fn c_f32(value f32) f32;
// c_f64：声明 C 双精度标量函数。
@[extern]
pub fn c_f64(value f64) f64;
// c_ptr：声明 C opaque 指针标量函数。
@[extern]
pub fn c_ptr(value *u8) *u8;
// c_mixed：声明交错整数/浮点与八参数 C 函数，验证跨模块调用元数据。
@[extern]
pub fn c_mixed(a i32, b f64, c i64, d f32, e u64, f i32, g f64, h u32) i64;
// c_many：声明八个整数参数的 C 函数，覆盖 SysV GPR 耗尽后的栈传参。
@[extern]
pub fn c_many(a i64, b i64, c i64, d i64, e i64, f i64, g i64, h i64) i64;
// c_check_yh：请求 C 侧反向调用本模块导出的 C ABI 函数并返回检查状态。
@[extern]
fn c_check_yh() int;
// c_pair：按 SysV INTEGER 聚合签名声明 C 函数。
@[extern]
pub fn c_pair(value CPair) CPair;
// c_mixed_struct：按 SysV SSE+INTEGER 聚合签名声明 C 函数。
@[extern]
pub fn c_mixed_struct(value CMixed) CMixed;
// c_wide_struct：按 SysV MEMORY 聚合签名声明 C 函数。
@[extern]
pub fn c_wide_struct(value CWide) CWide;
// c_apply_callback：C 持有并调用传入的 C ABI 函数值，验证 yh→C callback。
@[extern]
pub fn c_apply_callback(callback @[extern] fn(int) int, value int) int;
// c_choose_callback：返回 C 函数地址，供 YH 通过间接 C ABI 调用。
@[extern]
pub fn c_choose_callback() @[extern] fn(int) int;

// c_apply_pair_callback：通过 C ABI 函数指针传递和返回 CPair 聚合。
@[extern]
pub fn c_apply_pair_callback(callback @[extern] fn(CPair) CPair, value CPair) CPair;

// c_choose_pair_callback：返回具有聚合参数和返回值的 C 函数指针。
@[extern]
pub fn c_choose_pair_callback() @[extern] fn(CPair) CPair;

// c_returns：模拟违反 noreturn 声明的 C 实现，专供 LLVM 跨模块 trap 门调用。
@[extern, noreturn]
pub fn c_returns() void;

// yh_i8：向 C 导出有符号窄整数函数，供 C 对照调用约定和返回扩展。
@[extern]
pub fn yh_i8(value i8) i8 { return value; }
// yh_u8：向 C 导出无符号窄整数函数。
@[extern]
pub fn yh_u8(value u8) u8 { return value; }
// yh_i16：向 C 导出有符号 16 位函数。
@[extern]
pub fn yh_i16(value i16) i16 { return value; }
// yh_u16：向 C 导出无符号 16 位函数。
@[extern]
pub fn yh_u16(value u16) u16 { return value; }
// yh_f32：向 C 导出单精度函数，保留 float 参数类别。
@[extern]
pub fn yh_f32(value f32) f32 { return value; }
// yh_f64：向 C 导出双精度函数，保留 double 参数类别。
@[extern]
pub fn yh_f64(value f64) f64 { return value; }
// yh_ptr：向 C 导出 opaque 指针身份往返函数。
@[extern]
pub fn yh_ptr(value *u8) *u8 { return value; }
// yh_mixed：向 C 导出八参数交错签名并返回独立加权结果。
@[extern]
pub fn yh_mixed(a i32, b f64, c i64, d f32, e u64, f i32, g f64, h u32) i64 {
    return a.to_type(i64) + (b * 10.0).to_type(i64) + c +
        (d * 100.0.to_type(f32)).to_type(i64) + e.to_type(i64) +
        f.to_type(i64) + (g * 1000.0).to_type(i64) + h.to_type(i64);
}
// yh_many：向 C 导出八个整数参数函数，验证末尾参数从栈中正确读取。
@[extern]
pub fn yh_many(a i64, b i64, c i64, d i64, e i64, f i64, g i64, h i64) i64 {
    return a + b + c + d + e + f + g + h;
}

// yh_cpair：供 C 侧调用，验证 C ABI 小聚合参数与返回 coercion。
@[extern]
pub fn yh_cpair(value CPair) CPair { value.right += 3; return value; }

// yh_cmixed：供 C 侧调用，验证 C ABI 混合 SSE/INTEGER 聚合 coercion。
@[extern]
pub fn yh_cmixed(value CMixed) CMixed {
    return value;
}

// yh_cwide：供 C 侧调用，验证 C ABI MEMORY/byval/sret 边界。
@[extern]
pub fn yh_cwide(value CWide) CWide { value.third += 5; return value; }

// yh_triple：作为 C ABI callback 交给 C 执行。
@[extern]
pub fn yh_triple(value int) int { return value * 3; }

// yh_add：为 YH ABI 函数指针局部值提供直接目标。
fn yh_add(left int, right int) int { return left + right; }

// yh_apply：经跨模块接口接收 YH 函数值并间接调用。
pub fn yh_apply(callback fn(int, int) int, left int, right int) int {
    return callback(left, right);
}

// yh_sum_pack：验证 YH 类型化变参以切片参数保存并可打包零个或多个实参。
fn yh_sum_pack(base int, rest ... int) int {
    let sum int = base;
    for value in rest { sum += value; }
    return sum;
}

// yh_pair_sum：验证 yh-llvm-v1 聚合参数按调用点副本传入。
pub fn yh_pair_sum(value Pair) int {
    return value.left + value.right;
}

// yh_pair_make：验证 yh-llvm-v1 聚合返回通过隐藏结果缓冲传递。
pub fn yh_pair_make(left int, right int) Pair {
    return Pair{ left: left, right: right };
}

// yh_pair_forward：验证聚合参数和聚合返回在同一函数中连续传递。
pub fn yh_pair_forward(value Pair) Pair {
    return value;
}

// yh_array_sum：验证定长数组参数以独立副本传入。
pub fn yh_array_sum(value [2]int) int {
    return value[0] + value[1];
}

// yh_array_make：验证定长数组返回使用布局大小匹配的隐藏结果缓冲。
pub fn yh_array_make(left int, right int) [2]int {
    let value [2]int = [left, right];
    return value;
}

// yh_slice_forward：验证切片按值只复制描述符并通过结果缓冲返回。
pub fn yh_slice_forward(value []int) []int {
    return value;
}

// yh_slice_sum：通过返回的切片确认元素地址仍指向调用方原数组。
pub fn yh_slice_sum(value []int) int {
    return value[0] + value[1];
}

// check：从模块接口调用 C 标量函数，并交给 C 侧反向检查 yh 导出函数。
pub fn check() int {
    if (c_i8(-123) != -123 || c_u8(250) != 250
        || c_i16(-30001) != -30001 || c_u16(60001) != 60001) { return 1; }
    if (c_f32(1.5.to_type(f32)) != 1.5.to_type(f32) || c_f64(-9.25) != -9.25) { return 2; }
    let byte u8 = 37;
    let address *u8 = &byte;
    if (c_ptr(address) != address) { return 3; }
    if (c_mixed(1, 2.0, 3, 4.0.to_type(f32), 5, 6, 7.0, 8) != 7443) { return 4; }
    if (c_many(1, 2, 3, 4, 5, 6, 7, 8) != 36) { return 5; }
    let pair Pair = yh_pair_make(17, 25);
    if (yh_pair_sum(pair) != 42) { return 6; }
    let forwarded Pair = yh_pair_forward(pair);
    if (forwarded.left != 17 || forwarded.right != 25) { return 7; }
    let cpair CPair = c_pair(CPair{17, -4});
    if (cpair.left != 17 || cpair.right != 1) { return 10; }
    let cmixed CMixed = c_mixed_struct(CMixed{2.5, 7});
    if (cmixed.value != 4.5 || cmixed.tag != 7) { return 11; }
    let cwide CWide = c_wide_struct(CWide{11, 22, 33});
    if (cwide.first != 11 || cwide.second != 22 || cwide.third != 38) { return 12; }
    let yh_callback fn(int, int) int = yh_add;
    if (yh_callback(19, 23) != 42 || yh_apply(yh_callback, 20, 22) != 42) { return 13; }
    if (yh_sum_pack(42) != 42 || yh_sum_pack(10, 12, 20) != 42) { return 16; }
    if (c_apply_callback(yh_triple, 14) != 42) { return 14; }
    let c_callback @[extern] fn(int) int = c_choose_callback();
    if (c_callback(21) != 42) { return 15; }
    let applied_pair CPair = c_apply_pair_callback(yh_cpair, CPair{17, -4});
    if (applied_pair.left != 17 || applied_pair.right != -1) { return 17; }
    let pair_callback @[extern] fn(CPair) CPair = c_choose_pair_callback();
    let chosen_pair CPair = pair_callback(CPair{10, 20});
    if (chosen_pair.left != 14 || chosen_pair.right != 17) { return 18; }
    let array [2]int = yh_array_make(19, 23);
    if (yh_array_sum(array) != 42) { return 8; }
    let data [2]int = [19, 23];
    let view []int = data[0..2];
    let forwarded_view []int = yh_slice_forward(view);
    if (yh_slice_sum(forwarded_view) != 42 || data[1] != 23) { return 9; }
    return c_check_yh();
}
