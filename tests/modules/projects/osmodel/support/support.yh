module support;

import os;

// error_from 构造跨模块返回的 os.Error：0 表示成功，其余为 not_found 分类。
// 该函数让 Error 结构真实跨越模块边界返回，而不是只在 os 模块内部使用。
pub fn error_from(flag int) os.Error {
    if (flag == 0) {
        return os.no_error();
    }
    return os.make_error(os.error_not_found, flag);
}

// options 返回 os 的只读/只写打开选项，验证 OpenOptions 跨模块返回。
pub fn options(write bool) os.OpenOptions {
    if (write != false) {
        return os.write_options();
    }
    return os.read_options();
}

// fill 把调用方切片的每个字节写成 value，返回写入字节数。
// 切片按借用语义传入，修改对调用方可见；函数不保存指针。
pub fn fill(data []u8, value u8) u64 {
    let index int = 0;
    for index < len(data) {
        data[index] = value;
        index += 1;
    }
    return len(data);
}

// sum 返回调用方切片的字节和，用于验证跨模块 []u8 形参与只读访问。
pub fn sum(data []u8) u64 {
    let total u64 = 0;
    let index int = 0;
    for index < len(data) {
        total += data[index].to_type(u64);
        index += 1;
    }
    return total;
}
