module main;

import os;
import support;

// osmodel 验证 OS0 的结果模型、打开选项与目录条目候选布局。
// 所有结果结构都从 os 模块返回，切片与借用缓冲经 support 模块往返。
fn main() int {
    // Error/FdResult/IoResult 跨模块返回与字段访问。
    let none os.Error = support.error_from(0);
    if (none.kind != os.error_none || none.native_code != 0) {
        return 1;
    }
    let missing os.Error = support.error_from(2);
    if (missing.kind != os.error_not_found || missing.native_code != 2) {
        return 2;
    }
    let opened os.FdResult = os.fd_ok(7);
    if (opened.fd != 7 || opened.error.kind != os.error_none) {
        return 3;
    }
    let denied os.FdResult = os.fd_error(os.error_permission_denied, 13);
    if (denied.fd != -1 || denied.error.kind != os.error_permission_denied
        || denied.error.native_code != 13) {
        return 4;
    }
    let written os.IoResult = os.io_ok(5);
    if (written.count != 5 || written.error.kind != os.error_none) {
        return 5;
    }
    let failed os.IoResult = os.io_error(os.error_interrupted, 4);
    if (failed.count != 0 || failed.error.kind != os.error_interrupted) {
        return 6;
    }

    // OpenOptions 的初始化函数必须给出明确默认值，不依赖零值猜测。
    let read os.OpenOptions = support.options(false);
    if (read.access != os.access_read_only || read.create != false
        || read.truncate != false || read.exclusive != false
        || read.append != false || read.mode != 420) {
        return 7;
    }
    let write os.OpenOptions = support.options(true);
    if (write.access != os.access_write_only || write.create != true
        || write.truncate != false || write.exclusive != false
        || write.append != false || write.mode != 420) {
        return 8;
    }
    write.truncate = true;
    write.access = os.access_read_write;
    if (write.truncate != true || write.access != os.access_read_write) {
        return 9;
    }

    // []u8 形参与借用缓冲：support.fill 的修改必须在 main 可见。
    let bytes [4]u8 = [1, 2, 3, 4];
    let view []u8 = bytes[0..4];
    if (support.sum(view) != 10 || support.fill(view, 9) != 4
        || bytes[0] != 9 || bytes[3] != 9 || support.sum(view) != 36) {
        return 10;
    }
    let empty [1]u8 = [0];
    if (support.sum(empty[0..0]) != 0) {
        return 11;
    }

    // 目录条目候选布局：name 借用调用方缓冲，kind 保留稳定分类。
    let name_bytes [3]u8 = [65, 66, 67];
    let entry os.DirEntry = os.make_dir_entry(name_bytes[0..3], os.dir_file);
    if (entry.kind != os.dir_file || entry.name_len != 3
        || entry.name[0] != 65 || entry.name[2] != 67) {
        return 12;
    }
    name_bytes[1] = 90;
    if (entry.name[1] != 90) {
        return 13;
    }

    printf("os model ok\n");
    return 0;
}
