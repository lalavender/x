module main;

import cl.consts as c;

fn main() int {
    // 每个分支一个非零退出码，便于定位失败项
    if (c.MAGIC != 0xfeedfacf) { return 1; }
    if (c.BIG != 0x80000000) { return 2; }
    if ((c.BIG >> 32) != 0) { return 3; }
    if (c.NEG != 0.to_type(i64) - 1) { return 4; }
    if (c.SMALL != 200) { return 5; }
    if (c.FLAG == false) { return 6; }
    if (c.magic() != 0xfeedfacf) { return 7; }
    if (c.big() != 0x80000000) { return 8; }
    if (c.neg() != 0.to_type(i64) - 1) { return 9; }
    if (c.flag() == false) { return 10; }
    // 高位常量不得被符号扩展：位移后必须只剩 0x80000000
    if ((c.BIG >> 31) != 1.to_type(u64)) { return 11; }
    // SSA 降低路径：函数内的宽字面量比较与加法
    if (c.is_big(0x80000000) == false) { return 12; }
    if (c.is_big(1) != false) { return 13; }
    if (c.add_big(1) != 0x80000001) { return 14; }
    return 0;
}
