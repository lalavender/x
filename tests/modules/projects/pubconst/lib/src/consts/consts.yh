module consts;

// 接口（.s.i）必须按声明宽度写出这些值：窄化到宿主 int 会把
// 0xfeedfacf 打成 -17958193（u32 拒绝）、把 0x80000000 打成空的负号。
pub const MAGIC u32 = 0xfeedfacf;
pub const BIG u64 = 0x80000000;
pub const NEG i64 = -1;
pub const SMALL u8 = 200;
pub const FLAG bool = true;

pub fn magic() u32 {
    return MAGIC;
}

pub fn big() u64 {
    return BIG;
}

pub fn neg() i64 {
    return NEG;
}

pub fn flag() bool {
    return FLAG;
}

// SSA 降低路径上的字面量适配：0x80000000 必须按 u64 取值（按 i32 装入后
// 符号扩展会得到 0xFFFFFFFF80000000，比较静默判不等）。
pub fn is_big(v u64) bool {
    return v == 0x80000000;
}

pub fn add_big(v u64) u64 {
    return v + 0x80000000;
}
