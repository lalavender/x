module app;

// 并行执行语料：每个用例都有短暂延时并打印一行，验证并发下结果顺序稳定、
// 每例日志互不串写。延时同时让默认并行度下的用例真正重叠。
fn pause(us int) void {
    usleep(us)
}

test "用例一" {
    pause(30000)
    printf("case-1\n")
    $assert(1 == 1)
}

test "用例二" {
    pause(20000)
    printf("case-2\n")
    $assert(2 == 2)
}

test "用例三" {
    pause(10000)
    printf("case-3\n")
    $assert(3 == 3)
}

test "用例四" {
    pause(25000)
    printf("case-4\n")
    $assert(4 == 4)
}

test "用例五" {
    pause(15000)
    printf("case-5\n")
    $assert(5 == 5)
}
