module main;

// 与 C shim 共享布局的公开具名结构体。
@[extern]
pub struct CPoint {
    x int;
    y int;
}

@[extern]
fn c_roundtrip() int;

@[extern]
fn c_apply(callback fn(int) int, value int) int;

@[extern]
fn c_sum9(a int, b int, c int, d int, e int, f int, g int, h int, i int) int;

@[extern]
fn c_float_mix(a f32, b f64, c f32) f64;

@[extern]
fn c_narrow(a u8, b i16, c bool) int;

@[extern]
fn c_call_yh_narrow() int;

@[extern]
fn c_call_yh_sum9() int;

@[extern]
fn c_fill_point(point *CPoint) void;

@[extern]
fn c_point_size() int;

@[extern]
fn c_point_y_offset() int;

@[extern]
fn c_prebuilt_answer() int;

// 提供 C ABI 回调目标，并验证 int 参数与返回值。
@[extern]
fn yh_double(value int) int {
    return value * 2;
}

// 提供 C 侧验证的 bool 与窄整数回调目标。
@[extern]
fn yh_narrow(a u8, b i16, c bool) int {
    return a.to_type(int) + b.to_type(int) + (c ? 1 : 0);
}

// 提供九参数 C ABI 函数，覆盖寄存器与调用方栈槽。
@[extern]
fn yh_sum9(a int, b int, c int, d int, e int, f int, g int, h int, i int) int {
    return a + b + c + d + e + f + g + h + i;
}

// 向 C 导出加法函数，供依赖项目中的 C shim 反向调用。
@[extern]
pub fn yh_add(x int, y int) int {
    return x + y;
}

// 按返回码逐项验证 C/yh 之间的 ABI、布局与链接输入。
fn main() int {
    if (c_roundtrip() != 42) { return 1; }
    let point CPoint;
    c_fill_point(&point);
    if (point.x != 20 || point.y != 22) { return 2; }
    if (sizeof(CPoint) != c_point_size() || c_point_y_offset() != 4) { return 10; }
    if (c_prebuilt_answer() != 42) { return 3; }
    if (c_apply(yh_double, 21) != 42) { return 4; }
    if (c_sum9(1, 2, 3, 4, 5, 6, 7, 8, 9) != 45) { return 5; }
    if (c_float_mix(1.5.to_type(f32), 2.0, 3.5.to_type(f32)) != 7.0) { return 6; }
    if (c_narrow(250.to_type(u8), (-3).to_type(i16), true) != 248) { return 7; }
    if (c_call_yh_narrow() != 248) { return 8; }
    if (c_call_yh_sum9() != 45) { return 9; }
    if (sizeof(CPoint) != c_point_size() || c_point_y_offset() != 4) { return 10; }
    let mixed int = yh_check_mixed_args();
    if (mixed != 0) { return mixed; }
    return 0;
}
