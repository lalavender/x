module main
import token

// main：跨模块消费 token 的词汇、游标与扩容入口；验证 TokenCtx 已独立于 gen。
fn main() int {
    if (token.is_assign_op(token.TK_ASSIGN) != 1
        || token.is_assign_op(token.TK_RANGE) != 0) { return 1 }
    if (token.push(token.TK_INT, 0, 1, 1, 1) != 0
        || token.push(token.TOK_EOF, 1, 0, 1, 2) != 0) { return 2 }
    let ctx *token.TokenCtx = token.ctx()
    if (ctx.count != 2 || ctx.tokens[0].kind != token.TK_INT
        || ctx.tokens[1].kind != token.TOK_EOF || ctx.pos != 0) { return 3 }
    ctx.pos = 1
    if (ctx.tokens[ctx.pos].col != 2) { return 4 }
    printf("token-state=ok\n")
    return 0
}
