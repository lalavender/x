module fmt

// toml-test 测试桥专用数值格式化：f64 -> 17 位有效数字十进制。
//
// 17 位有效数字保证十进制 -> binary64 往返一致；使用私有大整数完成一次
// 正确舍入，不依赖宿主 printf/strtod。该模块只存在于测试 fixture，不属于
// 标准库导出面。

import io

const BIG_LIMBS int = 96

// big 是小端 32 位 limb 的无符号大整数。
struct big {
    limbs [96]u32
    count int
}

// big_zero 清零。
fn big_zero(b *big) void {
    b.count = 0
}

// big_set_u64 写入一个 64 位无符号值。
fn big_set_u64(b *big, value u64) void {
    big_zero(b)
    if (value == 0) {
        return
    }
    b.limbs[0] = (value & 4294967295).to_type(u32)
    b.limbs[1] = (value >> 32).to_type(u32)
    b.count = 2
    big_trim(b)
}

// big_trim 去掉高位零 limb。
fn big_trim(b *big) void {
    for b.count > 0 {
        if (b.limbs[b.count - 1] != 0) {
            return
        }
        b.count -= 1
    }
}

// big_copy 复制。
fn big_copy(dst *big, src *big) void {
    let i int = 0
    for i < src.count {
        dst.limbs[i] = src.limbs[i]
        i += 1
    }
    dst.count = src.count
}

// big_mul_small 乘 32 位因子；容量不足返回 -1。
fn big_mul_small(b *big, factor u32) int {
    if (factor == 0) {
        b.count = 0
        return 0
    }
    if (b.count == 0) {
        return 0
    }
    if (b.count + 2 > BIG_LIMBS) {
        return -1
    }
    let carry u64 = 0
    let i int = 0
    for i < b.count {
        let product u64 = b.limbs[i].to_type(u64) * factor.to_type(u64) + carry
        b.limbs[i] = (product & 4294967295).to_type(u32)
        carry = product >> 32
        i += 1
    }
    if (carry != 0) {
        b.limbs[b.count] = carry.to_type(u32)
        b.count += 1
    }
    return 0
}

// big_mul_pow10 乘 10^k。
fn big_mul_pow10(b *big, k int) int {
    let left int = k
    for left >= 9 {
        if (big_mul_small(b, 1000000000) != 0) {
            return -1
        }
        left -= 9
    }
    let factor u32 = 1
    let i int = 0
    for i < left {
        factor *= 10
        i += 1
    }
    return big_mul_small(b, factor)
}

// big_bitlen 返回最高有效位位数。
fn big_bitlen(b *big) int {
    if (b.count == 0) {
        return 0
    }
    let top u32 = b.limbs[b.count - 1]
    let bits int = 0
    for top != 0 {
        top = top >> 1
        bits += 1
    }
    return (b.count - 1) * 32 + bits
}

// big_cmp 比较，返回 -1/0/1。
fn big_cmp(a *big, b *big) int {
    if (a.count != b.count) {
        if (a.count < b.count) {
            return -1
        }
        return 1
    }
    let i int = a.count - 1
    for i >= 0 {
        if (a.limbs[i] < b.limbs[i]) {
            return -1
        }
        if (a.limbs[i] > b.limbs[i]) {
            return 1
        }
        i -= 1
    }
    return 0
}

// big_sub 计算 a -= b，要求 a >= b。
fn big_sub(a *big, b *big) void {
    let borrow u64 = 0
    let i int = 0
    for i < a.count {
        let left u64 = a.limbs[i].to_type(u64)
        let right u64 = 0
        if (i < b.count) {
            right = b.limbs[i].to_type(u64)
        }
        let sub u64 = right + borrow
        if (left >= sub) {
            a.limbs[i] = (left - sub).to_type(u32)
            borrow = 0
        } else {
            a.limbs[i] = (left + 4294967296 - sub).to_type(u32)
            borrow = 1
        }
        i += 1
    }
    big_trim(a)
}

// big_shl_one 左移一位。
fn big_shl_one(b *big) int {
    if (b.count == 0) {
        return 0
    }
    if (b.count + 1 > BIG_LIMBS) {
        return -1
    }
    let carry u32 = 0
    let i int = 0
    for i < b.count {
        let value u32 = b.limbs[i]
        b.limbs[i] = (value << 1) | carry
        carry = value >> 31
        i += 1
    }
    if (carry != 0) {
        b.limbs[b.count] = carry
        b.count += 1
    }
    return 0
}

// big_shl 左移 bits 位。
fn big_shl(b *big, bits u64) int {
    if (bits == 0 || b.count == 0) {
        return 0
    }
    let limb_shift int = (bits / 32).to_type(int)
    let bit_shift u32 = (bits % 32).to_type(u32)
    let extra int = 0
    if (bit_shift != 0) {
        extra = 1
    }
    if (b.count + limb_shift + extra > BIG_LIMBS) {
        return -1
    }
    let out big
    big_zero(&out)
    out.count = b.count + limb_shift + extra
    let i int = 0
    for i < out.count {
        out.limbs[i] = 0
        i += 1
    }
    i = 0
    for i < b.count {
        let value u64 = b.limbs[i].to_type(u64)
        let target int = i + limb_shift
        out.limbs[target] = (out.limbs[target].to_type(u64)
            | ((value << bit_shift) & 4294967295)).to_type(u32)
        if (bit_shift != 0) {
            out.limbs[target + 1] = (out.limbs[target + 1].to_type(u64)
                | (value >> (32 - bit_shift))).to_type(u32)
        }
        i += 1
    }
    big_trim(&out)
    big_copy(b, &out)
    return 0
}

// big_divmod 长除法，商必须是 64 位内整数。
fn big_divmod(n *big, d *big, quotient *u64, rem *big) int {
    if (d.count == 0) {
        return -1
    }
    big_zero(rem)
    let q u64 = 0
    let bits int = big_bitlen(n)
    if (bits == 0) {
        quotient[0] = 0
        return 0
    }
    let i i64 = bits.to_type(i64) - 1
    for i >= 0 {
        if (big_shl_one(rem) != 0) {
            return -1
        }
        let limb_index int = (i.to_type(u64) / 32).to_type(int)
        let bit_index u32 = (i.to_type(u64) % 32).to_type(u32)
        if (((n.limbs[limb_index] >> bit_index) & 1) != 0) {
            if (rem.count == 0) {
                rem.limbs[0] = 1
                rem.count = 1
            } else {
                rem.limbs[0] = rem.limbs[0] | 1
            }
        }
        if (big_cmp(rem, d) >= 0) {
            big_sub(rem, d)
            q = q * 2 + 1
        } else {
            q = q * 2
        }
        i -= 1
    }
    quotient[0] = q
    return 0
}

// f64_bits 读取 IEEE754 位模式。
fn f64_bits(value f64) u64 {
    let holder *f64 = malloc(8).to_type(*f64)
    holder[0] = value
    let view *u64 = holder.to_type(*u64)
    let bits u64 = view[0]
    free(holder.to_type(*void))
    return bits
}

// cmp_value_pow10 比较 m * 2^exp2 与 10^k，返回 -1/0/1。
fn cmp_value_pow10(m u64, exp2 i64, k i64) int {
    let left big
    let right big
    big_set_u64(&left, m)
    big_set_u64(&right, 1)
    if (k >= 0) {
        if (big_mul_pow10(&right, k.to_type(int)) != 0) {
            return 0
        }
        if (exp2 >= 0) {
            if (big_shl(&left, exp2.to_type(u64)) != 0) {
                return 0
            }
        } else {
            if (big_shl(&right, (-exp2).to_type(u64)) != 0) {
                return 0
            }
        }
    } else {
        if (big_mul_pow10(&left, (-k).to_type(int)) != 0) {
            return 0
        }
        if (exp2 >= 0) {
            if (big_shl(&left, exp2.to_type(u64)) != 0) {
                return 0
            }
        } else {
            if (big_shl(&right, (-exp2).to_type(u64)) != 0) {
                return 0
            }
        }
    }
    return big_cmp(&left, &right)
}

// scaled_quotient 计算 round(m * 2^exp2 / 10^(k-16))。
fn scaled_quotient(m u64, exp2 i64, k i64, digits *u64) int {
    let numerator big
    let denominator big
    big_set_u64(&numerator, m)
    big_set_u64(&denominator, 1)
    if (exp2 >= 0) {
        if (big_shl(&numerator, exp2.to_type(u64)) != 0) {
            return -1
        }
    } else {
        if (big_shl(&denominator, (-exp2).to_type(u64)) != 0) {
            return -1
        }
    }
    let shift10 i64 = k - 16
    if (shift10 >= 0) {
        if (big_mul_pow10(&denominator, shift10.to_type(int)) != 0) {
            return -1
        }
    } else {
        if (big_mul_pow10(&numerator, (-shift10).to_type(int)) != 0) {
            return -1
        }
    }
    let rem big
    let q u64 = 0
    if (big_divmod(&numerator, &denominator, &q, &rem) != 0) {
        return -1
    }
    let twice big
    big_copy(&twice, &rem)
    if (big_shl_one(&twice) != 0) {
        return -1
    }
    let cmp int = big_cmp(&twice, &denominator)
    if (cmp > 0 || (cmp == 0 && (q & 1) != 0)) {
        q += 1
    }
    digits[0] = q
    return 0
}

// print_u64 输出无符号十进制。
pub fn print_u64(value u64) void {
    let buf [32]char
    let at int = 31
    buf[at] = 0
    if (value == 0) {
        at -= 1
        buf[at] = '0'
    } else {
        let left u64 = value
        for left > 0 {
            at -= 1
            buf[at] = ('0'.to_type(int) + (left % 10).to_type(int)).to_type(char)
            left = left / 10
        }
    }
    io.print(&buf[at])
}

// print_i64 输出有符号十进制。
pub fn print_i64(value i64) void {
    if (value < 0) {
        io.print("-")
        let magnitude u64 = (0 - value).to_type(u64)
        if (value == -9223372036854775807 - 1) {
            magnitude = 9223372036854775808
        }
        print_u64(magnitude)
        return
    }
    print_u64(value.to_type(u64))
}

// print_float 输出 17 位有效数字的科学计数法（nan/inf 单独处理）。
pub fn print_float(value f64) void {
    let bits u64 = f64_bits(value)
    let negative int = 0
    if ((bits >> 63) != 0) {
        negative = 1
    }
    let exp_field u64 = (bits >> 52) & 2047
    let fraction u64 = bits & 4503599627370495
    if (exp_field == 2047) {
        if (fraction != 0) {
            io.print("nan")
            return
        }
        if (negative != 0) {
            io.print("-inf")
        } else {
            io.print("inf")
        }
        return
    }
    if (exp_field == 0 && fraction == 0) {
        if (negative != 0) {
            io.print("-0.0")
        } else {
            io.print("0.0")
        }
        return
    }
    let m u64 = fraction
    let exp2 i64 = -1074
    if (exp_field != 0) {
        m = fraction | 4503599627370496
        exp2 = exp_field.to_type(i64) - 1075
    }
    // 估计十进制指数，再用精确大整数比较修正。
    let top u64 = m
    let mbits int = 0
    let scan u64 = top
    for scan != 0 {
        scan = scan >> 1
        mbits += 1
    }
    let l2 i64 = (mbits - 1).to_type(i64) + exp2
    let prod i64 = l2 * 30103
    let k_est i64 = 0
    if (prod >= 0) {
        k_est = prod / 100000
    } else {
        k_est = -((-prod + 99999) / 100000)
    }
    let k i64 = k_est
    let guard int = 0
    for (cmp_value_pow10(m, exp2, k) < 0) && guard < 400 {
        k -= 1
        guard += 1
    }
    guard = 0
    for (cmp_value_pow10(m, exp2, k + 1) >= 0) && guard < 400 {
        k += 1
        guard += 1
    }
    let digits u64 = 0
    if (scaled_quotient(m, exp2, k, &digits) != 0) {
        io.print("0.0")
        return
    }
    if (digits >= 100000000000000000) {
        digits = 10000000000000000
        k += 1
    }
    let text [40]char
    let at int = 0
    if (negative != 0) {
        text[at] = '-'
        at += 1
    }
    let powers [17]u64
    powers[0] = 10000000000000000
    powers[1] = 1000000000000000
    powers[2] = 100000000000000
    powers[3] = 10000000000000
    powers[4] = 1000000000000
    powers[5] = 100000000000
    powers[6] = 10000000000
    powers[7] = 1000000000
    powers[8] = 100000000
    powers[9] = 10000000
    powers[10] = 1000000
    powers[11] = 100000
    powers[12] = 10000
    powers[13] = 1000
    powers[14] = 100
    powers[15] = 10
    powers[16] = 1
    let i int = 0
    for i < 17 {
        let digit u64 = (digits / powers[i]) % 10
        text[at] = ('0'.to_type(int) + digit.to_type(int)).to_type(char)
        at += 1
        if (i == 0) {
            text[at] = '.'
            at += 1
        }
        i += 1
    }
    text[at] = 'e'
    at += 1
    if (k < 0) {
        text[at] = '-'
        at += 1
        let magnitude u64 = (0 - k).to_type(u64)
        let digits_buf [8]char
        let dat int = 7
        digits_buf[dat] = 0
        let left u64 = magnitude
        if (left == 0) {
            dat -= 1
            digits_buf[dat] = '0'
        } else {
            for left > 0 {
                dat -= 1
                digits_buf[dat] = ('0'.to_type(int)
                    + (left % 10).to_type(int)).to_type(char)
                left = left / 10
            }
        }
        let j int = dat
        for j < 8 {
            text[at] = digits_buf[j]
            at += 1
            j += 1
        }
    } else {
        text[at] = '+'
        at += 1
        let magnitude u64 = k.to_type(u64)
        let digits_buf [8]char
        let dat int = 7
        digits_buf[dat] = 0
        let left u64 = magnitude
        if (left == 0) {
            dat -= 1
            digits_buf[dat] = '0'
        } else {
            for left > 0 {
                dat -= 1
                digits_buf[dat] = ('0'.to_type(int)
                    + (left % 10).to_type(int)).to_type(char)
                left = left / 10
            }
        }
        let j int = dat
        for j < 8 {
            text[at] = digits_buf[j]
            at += 1
            j += 1
        }
    }
    text[at] = 0
    io.print(&text[0])
}
