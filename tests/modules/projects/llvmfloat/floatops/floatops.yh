module floatops;

// add64：导出双精度加法，供项目入口验证跨模块浮点传参与返回。
pub fn add64(left f64, right f64) f64 { return left + right; }

// multiply32：单精度乘法保留 f32 结果类型与舍入宽度。
pub fn multiply32(left f32, right f32) f32 { return left * right; }

// u64_to_f64 / i64_to_f64：分别覆盖有符号和无符号整数到双精度转换。
pub fn u64_to_f64(value u64) f64 { return value.to_type(f64); }
pub fn i64_to_f64(value i64) f64 { return value.to_type(f64); }
