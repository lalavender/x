module main;
import floatops;

// main：跨模块验证 f32/f64 参数与返回值，并比较有符号/无符号转换边界。
fn main() int {
    if (floatops.add64(1.25, 2.5) != 3.75) { return 1; }
    if (floatops.multiply32(1.5.to_type(f32), 2.0.to_type(f32)) != 3.0.to_type(f32)) {
        return 2;
    }
    let high u64 = 0x8000000000000000.to_type(u64);
    let signed_edge i64 = 9223372036854775807.to_type(i64);
    if (floatops.u64_to_f64(high) != floatops.i64_to_f64(signed_edge)) { return 3; }
    return 0;
}
