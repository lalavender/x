module main

// TOML T4.1 累计分配预算验收：测试构建把 TOML_MAX_BYTES 调低，解析一个
// 正常文档并确认在预算内失败时返回 parse_resource_error + error_resource_limit，
// 没有半成品文档，重复解析仍失败。本 fixture 只对低预算测试副本构建。

import io
import toml

// source_document 返回需要超过测试预算的键值文档。
fn source_document() *char {
    return "key000 = 0\nkey001 = 1\nkey002 = 2\nkey003 = 3\nkey004 = 4\nkey005 = 5\nkey006 = 6\nkey007 = 7\nkey008 = 8\nkey009 = 9\nkey010 = 10\nkey011 = 11\nkey012 = 12\nkey013 = 13\nkey014 = 14\nkey015 = 15\nkey016 = 16\nkey017 = 17\nkey018 = 18\nkey019 = 19\nkey020 = 20\nkey021 = 21\nkey022 = 22\nkey023 = 23\nkey024 = 24\nkey025 = 25\nkey026 = 26\nkey027 = 27\nkey028 = 28\nkey029 = 29\nkey030 = 30\nkey031 = 31\nkey032 = 32\nkey033 = 33\nkey034 = 34\nkey035 = 35\nkey036 = 36\nkey037 = 37\nkey038 = 38\nkey039 = 39\nkey040 = 40\nkey041 = 41\nkey042 = 42\nkey043 = 43\nkey044 = 44\nkey045 = 45\nkey046 = 46\nkey047 = 47\nkey048 = 48\nkey049 = 49\nkey050 = 50\nkey051 = 51\nkey052 = 52\nkey053 = 53\nkey054 = 54\nkey055 = 55\nkey056 = 56\nkey057 = 57\nkey058 = 58\nkey059 = 59\n"
}

// failed_clean 判断预算失败是否符合契约。
fn failed_clean(result toml.ParseResult) int {
    if (result.status != toml.parse_resource_error) {
        return 0
    }
    if (result.error.code != toml.error_resource_limit) {
        return 0
    }
    if (result.document.handle != 0) {
        return 0
    }
    return 1
}

// main 断言预算失败与重复解析。
pub fn main() int {
    let source *char = source_document()
    let result toml.ParseResult = toml.parse_text(source)
    if (failed_clean(result) == 0) {
        io.print("BAD_BUDGET ")
        io.println(result.error.message)
        toml.release(&result.document)
        return 1
    }
    toml.release(&result.document)
    let again toml.ParseResult = toml.parse_text(source)
    if (failed_clean(again) == 0) {
        io.println("BAD_REPEAT")
        toml.release(&again.document)
        return 1
    }
    toml.release(&again.document)
    io.println("BUDGET_OK")
    return 0
}
