module check;
import token;
import ast;
import support
import proj;
import gen;
import lex;
import comptime;

// checked_fixture_prepare：用现有词法、绑定和 arena 构造入口生成一个完整受检函数。
// 文件 token 与符号都是实际可变堆存储，后面的测试会覆盖并释放它们。
fn checked_fixture_prepare() int {
    gen.state_init();
    lex.reset();
    proj.init();
    support.bind_cfg(proj.cfg());
    let gs *gen.TaskCtx = gen.task();
    if (gen.sem_init_tables() != 0 || gen.ty_register_builtins() != 0) { return 1; }
    ct_facts_sync();
    let text *char = "fn f(x int) int { return x; }";
    let length int = 0;
    for text[length] != 0 { length += 1; }
    support.src_ctx().data = malloc((length + 1).to_type(u64)).to_type(*u8);
    if (support.src_ctx().data == 0) { return 2; }
    memcpy(support.src_ctx().data, text, (length + 1).to_type(u64));
    support.src_ctx().length = length;
    // 13 个显式 token，外加换行归一化在文件尾（fn 体 '}' 之后）补的 1 个隐式终结符。
    if (lex.lex_all() != 0 || token.ctx().count != 14) { return 3; }
    let path *char = "ownership.yh";
    let path_off int = support.tml_intern_str(path.to_type(*u8), 0, 12);
    if (path_off < 0) { return 4; }
    proj.ctx().files = malloc(sizeof(proj.PFile).to_type(u64)).to_type(*proj.PFile);
    ast.store().file_decls = malloc(sizeof(token.PDecl).to_type(u64)).to_type(*token.PDecl);
    if (proj.ctx().files == 0 || ast.store().file_decls == 0) { return 5; }
    let file proj.PFile;
    file.path_off = path_off;
    file.path_len = 12;
    file.source = support.src_ctx().data;
    file.source_len = length;
    file.tokens = token.ctx().tokens;
    file.token_n = token.ctx().count;
    file.decls = ast.store().file_decls;
    file.decl_n = 1;
    proj.ctx().files[0] = file;
    proj.ctx().file_n = 1;
    let declaration token.PDecl;
    declaration.start = 0;
    declaration.end = 12;
    declaration.kind = token.TK_FN;
    declaration.keyword = 0;
    declaration.line = 1;
    declaration.col = 1;
    ast.store().file_decls[0] = declaration;
    ast.store().file_decl_n = 1;
    ast.store().file_decl_i = 0;
    support.session().active_file = 0;
    support.session().ast_capture = 1;
    ast.ast_expr_reset();
    ast.ast_stmt_reset();
    ast.ast_decl_reset();
    ast.ast_function_reset();
    if (ast.ast_decl_add_file(0) != 0 || gen.ty_sig_param(gen.TY_I32) != 0) { return 6; }
    let fn_type int = gen.ty_fn(gen.TY_I32, 0, 1, 0);
    token.ctx().pos = 1;
    let fn_sym int = gen.sym_push(token.ctx().tokens[1].start, 1, gen.SYM_FN, fn_type, gen.F_GLOBAL);
    if (fn_sym != 0 || ast.ast_decl_bind_file(0) != 0 || ast.ast_function_begin(0, 0) != 0) { return 7; }
    ast.ast_binding_begin_function();
    if (gen.scope_push() != 0) { return 8; }
    token.ctx().pos = 3;
    let param int = gen.sym_push(token.ctx().tokens[3].start, 1, gen.SYM_VAR, gen.TY_I32, gen.F_PARAM);
    if (param < 0 || ast.ast_binding_add(param, 3, 1) != 0) { return 9; }
    let body int = ast.ast_stmt_begin(ast.AST_STMT_BLOCK, token.TK_LBRACE, 7);
    let ret int = ast.ast_stmt_begin(ast.AST_STMT_RETURN, token.TK_RETURN, 8);
    let expression int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, token.TOK_IDENT, 9, 10,
        gen.TY_I32, -1, -1, -1);
    let semantic gen.Res;
    semantic.type_id = gen.TY_I32;
    semantic.sym = param;
    if (expression < 0 || ast.ast_expr_set_semantics(expression, &semantic) != 0
        || ast.ast_stmt_add_expr(expression) != 0 || ast.ast_stmt_end(ret, 11) != 0
        || ast.ast_stmt_end(body, 12) != 0 || ast.ast_decl_attach_body(0, 0, body) != 0
        || ast.ast_function_end() != 0) { return 10; }
    gen.scope_pop();
    // 额外保存结构体/数组/指针闭包，证明不仅内建整数类型能够脱离原表存活。
    gs.t_fields = malloc(sizeof(gen.SField).to_type(u64)).to_type(*gen.SField);
    gs.t_names = malloc(sizeof(gen.TName).to_type(u64)).to_type(*gen.TName);
    if (gs.t_fields == 0 || gs.t_names == 0) { return 11; }
    let field gen.SField;
    field.name_off = support.tml_intern_str("value".to_type(*u8), 0, 5);
    field.name_len = 5;
    field.type_id = gen.TY_I32;
    field.is_pub = 1;
    gs.t_fields[0] = field;
    gs.t_field_n = 1;
    let structure int = gen.ty_push(gen.TY_STRUCT, 4, 4, -1, 1, 0);
    let type_name gen.TName;
    type_name.name_off = support.tml_intern_str("Saved".to_type(*u8), 0, 5);
    type_name.name_len = 5;
    type_name.type_id = structure;
    type_name.form = 1;
    gs.t_names[0] = type_name;
    gs.t_name_n = 1;
    if (structure < 0 || gen.ty_array(structure, 3) < 0 || gen.ty_ptr(structure) < 0) { return 12; }
    return 0;
}

// checked_fixture_destroy_front：真实重置全部旧 AST arena，并破坏/释放语义和来源表。
// 快照后续若仍借用其中任一表，就会校验失败或读取错误值。
fn checked_fixture_destroy_front() void {
    let gs *gen.TaskCtx = gen.task();
    ast.ast_expr_reset();
    ast.ast_stmt_reset();
    ast.ast_decl_reset();
    ast.ast_function_reset();
    let i int = 0;
    for i < support.pool_ctx().length { support.pool_ctx().data[i] = 'z'; i += 1; }
    gs.t_types[gen.TY_I32].size = 99;
    token.ctx().tokens[9].kind = token.TOK_EOF;
    free(support.pool_ctx().data.to_type(*void));
    free(gs.t_types.to_type(*void));
    free(gs.t_fields.to_type(*void));
    free(gs.t_names.to_type(*void));
    free(gs.t_home.to_type(*void));
    free(gs.t_sig_abi.to_type(*void));
    free(gs.t_sig_ret.to_type(*void));
    free(gs.t_sig_np.to_type(*void));
    free(gs.t_sig_vararg.to_type(*void));
    free(gs.t_sig_first.to_type(*void));
    free(gs.t_sig_params.to_type(*void));
    free(gs.c_syms.to_type(*void));
    free(support.src_ctx().data.to_type(*void));
    free(token.ctx().tokens.to_type(*void));
    free(ast.store().file_decls.to_type(*void));
    free(proj.ctx().files.to_type(*void));
    support.pool_ctx().data = 0;
    support.pool_ctx().length = 0;
    gs.t_types = 0;
    gs.t_fields = 0;
    gs.t_names = 0;
    gs.t_type_n = 0;
    gs.t_home = 0;
    gs.c_syms = 0;
    gs.c_sym_n = 0;
    support.src_ctx().data = 0;
    token.ctx().tokens = 0;
    ast.store().file_decls = 0;
    proj.ctx().files = 0;
    proj.ctx().file_n = 0;
    support.target_select("x86_64-unknown-linux-gnu");
}

// checked_snapshot_fixture：构造并返回独立快照，供 check 模块跨边界验证与拒绝损坏项。
pub fn checked_snapshot_fixture(first_out *CheckedModule, second_out *CheckedModule) int {
    if (first_out == 0 || second_out == 0
        || first_out.storage != 0 || second_out.storage != 0) { return 1; }
    let prepared int = checked_fixture_prepare();
    if (prepared != 0) { printf("prepare=%d\n", prepared); return 2; }
    let gs *gen.TaskCtx = gen.task();
    let original_target *char = proj.cfg().target.triple;
    // 旧汇编范围故意无效：快照只取 checked 语义，不借它们携带函数信息。
    let view ast.AstView;
    ast.ast_view(&view);
    view.function_nodes[0].asm_first = -77;
    view.function_nodes[0].asm_after = -78;
    let first CheckedModule;
    let second CheckedModule;
    if (checked_module_capture(&first) != 0 || checked_module_capture(&second) != 0) { return 3; }
    if (first.storage == second.storage) { return 4; }
    let stored *CheckedStorage = first.storage.to_type(*CheckedStorage);
    if (stored.expressions == view.expr_nodes || stored.names == support.pool_ctx().data
        || stored.types == gs.t_types || stored.files[0].source == support.src_ctx().data
        || stored.files[0].tokens == token.ctx().tokens || stored.files[0].decls == ast.store().file_decls) { return 5; }
    checked_fixture_destroy_front();
    if (support.cstr_eq(first.target.triple, original_target) == 0) { return 6; }
    let function CheckedFunction;
    let declaration ast.AstDecl;
    let expression comptime.CtExpr;
    let statement comptime.CtStmt;
    let edge ast.AstStmtExpr;
    let binding ast.AstBinding;
    let type_row gen.CType;
    if (checked_module_function(&first, 0, &function) != 0
        || function.body_stmt != 0 || function.expr_after != 1
        || checked_module_function(&first, 1, &function) == 0
        || checked_module_declaration(&first, 0, &declaration) != 0
        || declaration.kind != token.TK_FN || declaration.body_stmt != 0
        || checked_module_type(&first, gen.TY_I32, &type_row) != 0 || type_row.size != 4
        || checked_module_type(&first, -1, &type_row) == 0
        || checked_module_expression(&first, 0, &expression) != 0
        || expression.binding_row != 0 || expression.sym_type_id != gen.TY_I32
        || checked_module_statement(&first, 1, &statement) != 0
        || statement.kind != ast.AST_STMT_RETURN
        || checked_module_edge(&first, statement.first_expr, &edge) != 0 || edge.expr_id != 0
        || checked_module_binding(&first, expression.binding_row, &binding) != 0
        || binding.id != 0 || binding.is_param != 1
        || support.cstr_eq(checked_module_name(&first, expression.sym_name_off, expression.sym_name_len), "x") == 0) {
        return 7;
    }
    let length int = 0;
    let source *u8 = checked_module_source(&first, 0, &length);
    if (length != 29 || source == 0 || source[0] != 'f' || source[9] != 't'
        || checked_module_name(&first, stored.name_n, 0) != 0) { return 8; }
    let aggregate gen.CType;
    let array gen.CType;
    let pointer gen.CType;
    let structure int = stored.type_names[0].type_id;
    if (checked_module_type(&first, structure, &aggregate) != 0
        || aggregate.kind != gen.TY_STRUCT || aggregate.size != 4 || aggregate.align != 4
        || aggregate.len != 1 || stored.fields[aggregate.sub].type_id != gen.TY_I32
        || checked_module_type(&first, structure + 1, &array) != 0
        || array.kind != gen.TY_ARRAY || array.size != 12 || array.len != 3 || array.elem != structure
        || checked_module_type(&first, structure + 2, &pointer) != 0
        || pointer.kind != gen.TY_PTR || pointer.elem != structure
        || support.cstr_eq(checked_module_name(&first, stored.fields[0].name_off, 5), "value") == 0
        || support.cstr_eq(checked_module_name(&first, stored.type_names[0].name_off, 5), "Saved") == 0) {
        return 9;
    }
    first_out[0] = first;
    second_out[0] = second;
    return 0;
}
