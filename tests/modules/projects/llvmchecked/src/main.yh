module main;
import core.ast;
import core.check;

// main：跨模块消费公开快照合同，并执行复制、释放和保留类型的回归。
fn main() int {
    let unit ast.CheckedModule;
    if (check.verify_checked_module(&unit) == 0) { return 1; }
    ast.checked_module_release(&unit);
    ast.checked_module_release(&unit);
    if (unit.storage != 0) { return 2; }
    let first ast.CheckedModule;
    let second ast.CheckedModule;
    let fixture int = ast.checked_snapshot_fixture(&first, &second);
    if (fixture != 0) { printf("fixture=%d\n", fixture); return 3; }
    if (check.verify_checked_module(&first) != 0
        || check.verify_checked_module(&second) != 0) { return 4; }
    let view ast.CheckedModuleView;
    if (ast.checked_module_view(&first, &view) != 0) { return 5; }
    let fn_type int = view.declarations[0].type_id;
    let saved int = view.types[fn_type].elem;
    view.types[fn_type].elem = view.type_n;
    if (check.verify_checked_module(&first) == 0) { return 6; }
    view.types[fn_type].elem = saved;
    if (check.verify_checked_module(&first) != 0) { return 7; }
    ast.checked_module_release(&first);
    ast.checked_module_release(&first);
    let function ast.CheckedFunction;
    if (first.storage != 0 || first.target.triple != 0
        || check.verify_checked_module(&first) == 0
        || ast.checked_module_function(&first, 0, &function) == 0
        || check.verify_checked_module(&second) != 0) { return 8; }
    ast.checked_module_release(&second);
    ast.checked_module_release(&second);
    printf("checked-snapshot=ok\n");
    return 0;
}
