module main;

import ir;

// 检查分支合流的 phi 覆盖所有 CFG 前驱，并拒绝重复前驱输入。
fn check_phi() int {
    let types [2]ir.IRType;
    types[0].kind = ir.IR_TY_BOOL;
    types[0].elem = -1;
    types[0].bits = 8;
    types[1].kind = ir.IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;

    let insts [4]ir.IRInst;
    insts[0].op = ir.IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].aux = -1;
    insts[1].op = ir.IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].aux = -1;
    insts[1].imm = 11;
    insts[2].op = ir.IR_OP_CONST;
    insts[2].result_id = 2;
    insts[2].result_type = 1;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].aux = -1;
    insts[2].imm = 22;
    insts[3].op = ir.IR_OP_PHI;
    insts[3].result_id = 3;
    insts[3].result_type = 1;
    insts[3].a = -1;
    insts[3].b = -1;
    insts[3].aux = 0;

    let phis [1]ir.IRPhi;
    phis[0].first = 0;
    phis[0].count = 2;
    let inputs [2]ir.IRPhiInput;
    inputs[0].pred = 1;
    inputs[0].value = 1;
    inputs[1].pred = 2;
    inputs[1].value = 2;

    let blocks [4]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 1;
    blocks[0].term = ir.IR_TERM_COND_BR;
    blocks[0].term_value = 0;
    blocks[0].succ0 = 1;
    blocks[0].succ1 = 2;
    blocks[1].id = 1;
    blocks[1].first_inst = 1;
    blocks[1].inst_count = 1;
    blocks[1].term = ir.IR_TERM_BR;
    blocks[1].term_value = -1;
    blocks[1].succ0 = 3;
    blocks[1].succ1 = -1;
    blocks[2].id = 2;
    blocks[2].first_inst = 2;
    blocks[2].inst_count = 1;
    blocks[2].term = ir.IR_TERM_BR;
    blocks[2].term_value = -1;
    blocks[2].succ0 = 3;
    blocks[2].succ1 = -1;
    blocks[3].id = 3;
    blocks[3].first_inst = 3;
    blocks[3].inst_count = 1;
    blocks[3].term = ir.IR_TERM_RET;
    blocks[3].term_value = 3;
    blocks[3].succ0 = -1;
    blocks[3].succ1 = -1;

    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 4;
    f.phis = &phis[0];
    f.phi_count = 1;
    f.phi_inputs = &inputs[0];
    f.phi_input_count = 2;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 4;
    f.value_count = 4;

    if (ir.ir_verify(&f) != 0) {
        return 1;
    }
    // 一位 bool 属于旧语义模型；新 verifier 必须拒绝，不能误读旧缓存。
    types[0].bits = 1;
    if (ir.ir_verify(&f) == 0) { return 8; }
    types[0].bits = 8;
    inputs[1].pred = 1;
    if (ir.ir_verify(&f) == 0) {
        return 2;
    }
    inputs[1].pred = 2;
    inputs[1].value = 0;
    if (ir.ir_verify(&f) == 0) {
        return 3;
    }
    inputs[1].value = 2;
    insts[0].result_type = 99;
    if (ir.ir_verify(&f) == 0) {
        return 4;
    }
    insts[0].result_type = 0;
    inputs[1].value = 1;
    if (ir.ir_verify(&f) == 0) {
        return 5;
    }
    inputs[1].value = 2;
    insts[1].a = 0;
    if (ir.ir_verify(&f) == 0) { return 6; }
    insts[1].a = -1;
    insts[3].imm = 1;
    if (ir.ir_verify(&f) == 0) { return 7; }
    return 0;
}

// check_simplify：确认常量算术与相同输入 phi 会被低成本规范化。
fn check_simplify() int {
    let types [2]ir.IRType;
    types[0].kind = ir.IR_TY_BOOL;
    types[0].elem = -1;
    types[0].bits = 8;
    types[1].kind = ir.IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;

    let insts [5]ir.IRInst;
    insts[0].op = ir.IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].aux = -1;
    insts[0].imm = 1;
    insts[1].op = ir.IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].aux = -1;
    insts[1].imm = -10;
    insts[2].op = ir.IR_OP_CONST;
    insts[2].result_id = 2;
    insts[2].result_type = 1;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].aux = -1;
    insts[2].imm = 40;
    insts[3].op = ir.IR_OP_ADD;
    insts[3].result_id = 3;
    insts[3].result_type = 1;
    insts[3].a = 1;
    insts[3].b = 2;
    insts[3].aux = -1;
    insts[4].op = ir.IR_OP_PHI;
    insts[4].result_id = 4;
    insts[4].result_type = 1;
    insts[4].a = -1;
    insts[4].b = -1;
    insts[4].aux = 0;

    let phis [1]ir.IRPhi;
    phis[0].first = 0;
    phis[0].count = 2;
    let inputs [2]ir.IRPhiInput;
    inputs[0].pred = 1;
    inputs[0].value = 3;
    inputs[1].pred = 2;
    inputs[1].value = 3;

    let blocks [4]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 4;
    blocks[0].term = ir.IR_TERM_COND_BR;
    blocks[0].term_value = 0;
    blocks[0].succ0 = 1;
    blocks[0].succ1 = 2;
    blocks[1].id = 1;
    blocks[1].first_inst = 4;
    blocks[1].inst_count = 0;
    blocks[1].term = ir.IR_TERM_BR;
    blocks[1].term_value = -1;
    blocks[1].succ0 = 3;
    blocks[1].succ1 = -1;
    blocks[2].id = 2;
    blocks[2].first_inst = 4;
    blocks[2].inst_count = 0;
    blocks[2].term = ir.IR_TERM_BR;
    blocks[2].term_value = -1;
    blocks[2].succ0 = 3;
    blocks[2].succ1 = -1;
    blocks[3].id = 3;
    blocks[3].first_inst = 4;
    blocks[3].inst_count = 1;
    blocks[3].term = ir.IR_TERM_RET;
    blocks[3].term_value = 4;
    blocks[3].succ0 = -1;
    blocks[3].succ1 = -1;

    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 5;
    f.phis = &phis[0];
    f.phi_count = 1;
    f.phi_inputs = &inputs[0];
    f.phi_input_count = 2;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 4;
    f.value_count = 5;

    if (ir.ir_verify(&f) != 0) { return 1; }
    insts[3].aux = 0;
    if (ir.ir_verify(&f) == 0) { return 23; }
    insts[3].aux = -1;
    if (ir.ir_simplify(&f) != 0 || ir.ir_verify(&f) != 0) {
        return 1;
    }
    if (insts[3].op != ir.IR_OP_CONST) { return 2; }
    if (insts[3].imm != 30) { return 3; }
    if (insts[4].op == ir.IR_OP_PHI) { return 4; }
    if (insts[4].op != ir.IR_OP_COPY && insts[4].op != ir.IR_OP_CONST) { return 5; }
    if (insts[4].op == ir.IR_OP_COPY && insts[4].a != 3) { return 6; }
    if (insts[4].op == ir.IR_OP_CONST && insts[4].imm != 30) { return 7; }
    if (blocks[3].term_value != 3) { return 8; }

    let size int = ir.ir_serialized_size(&f);
    if (size <= 0) { return 9; }
    let bytes *u8 = malloc(size.to_type(u64)).to_type(*u8);
    let copy *u8 = malloc(size.to_type(u64)).to_type(*u8);
    if (bytes == 0 || copy == 0) {
        if (bytes != 0) { free(bytes); }
        if (copy != 0) { free(copy); }
        return 10;
    }
    if (ir.ir_serialize(&f, bytes, size) != size) { return 11; }
    if (ir.ir_serialize(&f, bytes, size - 1) != -1) { return 22; }

    let decoded ir.IRFunction;
    decoded.types = 0;
    decoded.insts = 0;
    decoded.phis = 0;
    decoded.phi_inputs = 0;
    decoded.calls = 0;
    decoded.call_args = 0;
    decoded.call_symbols = 0;
    decoded.blocks = 0;
    if (ir.ir_deserialize(&decoded, bytes, size, f.target_id) != 0) { return 12; }
    if (ir.ir_verify(&decoded) != 0 || decoded.target_id != f.target_id
        || decoded.ret_type != f.ret_type || decoded.value_count != f.value_count
        || decoded.inst_count != f.inst_count || decoded.block_count != f.block_count) {
        return 13;
    }
    if (decoded.insts[1].imm != -10 || decoded.insts[3].op != ir.IR_OP_CONST || decoded.insts[3].imm != 30
        || decoded.blocks[3].term_value != 3 || decoded.phi_inputs[1].value != 3) {
        return 14;
    }
    if (ir.ir_serialize(&decoded, copy, size) != size) { return 15; }
    let i int = 0;
    for i < size {
        if (bytes[i] != copy[i]) { return 16; }
        i += 1;
    }

    let bad_target ir.IRFunction;
    bad_target.types = 0;
    bad_target.insts = 0;
    bad_target.phis = 0;
    bad_target.phi_inputs = 0;
    bad_target.calls = 0;
    bad_target.call_args = 0;
    bad_target.call_symbols = 0;
    bad_target.blocks = 0;
    if (ir.ir_deserialize(&bad_target, bytes, size, f.target_id + 1) == 0) { return 17; }
    let bad_version ir.IRFunction;
    bad_version.types = 0;
    bad_version.insts = 0;
    bad_version.phis = 0;
    bad_version.phi_inputs = 0;
    bad_version.calls = 0;
    bad_version.call_args = 0;
    bad_version.call_symbols = 0;
    bad_version.blocks = 0;
    bytes[8] = (ir.IR_SERIAL_VERSION + 1).to_type(u8);
    if (ir.ir_deserialize(&bad_version, bytes, size, f.target_id) == 0) { return 18; }
    bytes[8] = ir.IR_SERIAL_VERSION.to_type(u8);
    let bad_length ir.IRFunction;
    bad_length.types = 0;
    bad_length.insts = 0;
    bad_length.phis = 0;
    bad_length.phi_inputs = 0;
    bad_length.calls = 0;
    bad_length.call_args = 0;
    bad_length.call_symbols = 0;
    bad_length.blocks = 0;
    if (ir.ir_deserialize(&bad_length, bytes, size - 1, f.target_id) == 0) { return 19; }

    let bad_ir ir.IRFunction;
    bad_ir.types = 0;
    bad_ir.insts = 0;
    bad_ir.phis = 0;
    bad_ir.phi_inputs = 0;
    bad_ir.calls = 0;
    bad_ir.call_args = 0;
    bad_ir.call_symbols = 0;
    bad_ir.blocks = 0;
    let term_byte u8 = bytes[512];
    bytes[512] = 255;
    if (ir.ir_deserialize(&bad_ir, bytes, size, f.target_id) == 0) { return 20; }
    if (bad_ir.types != 0 || bad_ir.insts != 0 || bad_ir.blocks != 0) { return 21; }
    bytes[512] = term_byte;

    ir.ir_function_release(&decoded);
    free(bytes);
    free(copy);
    return 0;
}

// check_memory_fields：确认 load/store 只能使用各自声明的操作数字段。
fn check_memory_fields() int {
    let types [3]ir.IRType;
    types[0].kind = ir.IR_TY_VOID;
    types[0].elem = -1;
    types[0].bits = 0;
    types[1].kind = ir.IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;
    types[2].kind = ir.IR_TY_PTR;
    types[2].elem = 1;
    types[2].bits = 64;

    let insts [4]ir.IRInst;
    insts[0].op = ir.IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 2;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 4096;
    insts[0].aux = -1;
    insts[1].op = ir.IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 7;
    insts[1].aux = -1;
    insts[2].op = ir.IR_OP_STORE;
    insts[2].result_id = -1;
    insts[2].result_type = -1;
    insts[2].a = 0;
    insts[2].b = 1;
    insts[2].aux = -1;
    insts[3].op = ir.IR_OP_LOAD;
    insts[3].result_id = 2;
    insts[3].result_type = 1;
    insts[3].a = 0;
    insts[3].b = -1;
    insts[3].aux = -1;

    let blocks [1]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 4;
    blocks[0].term = ir.IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;

    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 3;
    f.insts = &insts[0];
    f.inst_count = 4;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    if (ir.ir_verify(&f) != 0) { return 1; }

    insts[3].b = 1;
    if (ir.ir_verify(&f) == 0) { return 2; }
    insts[3].b = -1;
    insts[3].aux = 0;
    if (ir.ir_verify(&f) == 0) { return 3; }
    insts[3].aux = -1;
    insts[2].aux = 0;
    if (ir.ir_verify(&f) == 0) { return 5; }
    insts[2].aux = -1;
    insts[2].imm = 1;
    if (ir.ir_verify(&f) == 0) { return 4; }
    return 0;
}

// check_param_prologue：参数编号必须从零连续，且只能出现在入口块前导区。
fn check_param_prologue() int {
    let types [1]ir.IRType;
    types[0].kind = ir.IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    let insts [1]ir.IRInst;
    insts[0].op = ir.IR_OP_PARAM;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 0;
    insts[0].aux = -1;
    let blocks [1]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 1;
    blocks[0].term = ir.IR_TERM_RET;
    blocks[0].term_value = 0;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 1;
    f.insts = &insts[0];
    f.inst_count = 1;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 1;
    if (ir.ir_verify(&f) != 0) { return 1; }
    insts[0].imm = 1;
    if (ir.ir_verify(&f) == 0) { return 2; }
    insts[0].imm = 0;
    insts[0].a = 0;
    if (ir.ir_verify(&f) == 0) { return 3; }
    return 0;
}

// check_integer_op_types：新的整数运算允许同型值，拒绝混合宽度与浮点操作数。
fn check_integer_op_types() int {
    let types [3]ir.IRType;
    types[0].kind = ir.IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    types[1].kind = ir.IR_TY_U32;
    types[1].elem = -1;
    types[1].bits = 32;
    types[2].kind = ir.IR_TY_F64;
    types[2].elem = -1;
    types[2].bits = 64;
    let insts [3]ir.IRInst;
    insts[0].op = ir.IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 21;
    insts[0].aux = -1;
    insts[1].op = ir.IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 0;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 3;
    insts[1].aux = -1;
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    insts[2].a = 0;
    insts[2].b = 1;
    insts[2].aux = -1;
    let blocks [1]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 3;
    blocks[0].term = ir.IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 3;
    f.insts = &insts[0];
    f.inst_count = 3;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    let ops [7]int;
    ops[0] = ir.IR_OP_DIV;
    ops[1] = ir.IR_OP_REM;
    ops[2] = ir.IR_OP_BAND;
    ops[3] = ir.IR_OP_BOR;
    ops[4] = ir.IR_OP_BXOR;
    ops[5] = ir.IR_OP_SHL;
    ops[6] = ir.IR_OP_SHR;
    let i int = 0;
    for i < 7 {
        insts[2].op = ops[i];
        if (ir.ir_verify(&f) != 0) { return 1; }
        insts[1].result_type = 1;
        if (ir.ir_verify(&f) == 0) { return 2; }
        insts[1].result_type = 0;
        insts[0].result_type = 2;
        insts[1].result_type = 2;
        insts[2].result_type = 2;
        f.ret_type = 2;
        if (ir.ir_verify(&f) == 0) { return 3; }
        insts[0].result_type = 0;
        insts[1].result_type = 0;
        insts[2].result_type = 0;
        f.ret_type = 0;
        i += 1;
    }
    return 0;
}

// check_direct_call_ir：验证带稳定符号和变长实参的直接调用编码与 SSA 使用点。
fn check_direct_call_ir() int {
    let types [2]ir.IRType;
    types[0].kind = ir.IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    types[1].kind = ir.IR_TY_U32;
    types[1].elem = -1;
    types[1].bits = 32;
    let insts [4]ir.IRInst;
    insts[0].op = ir.IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 4;
    insts[0].aux = -1;
    insts[1].op = ir.IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 0;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 5;
    insts[1].aux = -1;
    insts[2].op = ir.IR_OP_CALL;
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].imm = 0;
    insts[2].aux = 0;
    let calls [2]ir.IRCall;
    calls[0].abi = 1;
    calls[0].symbol_first = 0;
    calls[0].symbol_len = 4;
    calls[0].arg_first = 0;
    calls[0].arg_count = 2;
    let args [2]ir.IRCallArg;
    args[0].value = 0;
    args[0].type_id = 0;
    args[1].value = 1;
    args[1].type_id = 0;
    let symbols [5]u8;
    symbols[0] = '_';
    symbols[1] = 's';
    symbols[2] = 'u';
    symbols[3] = 'm';
    symbols[4] = 'x';
    let blocks [1]ir.IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 3;
    blocks[0].term = ir.IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f ir.IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 3;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = &calls[0];
    f.call_count = 1;
    f.call_args = &args[0];
    f.call_arg_count = 2;
    f.call_symbols = &symbols[0];
    f.call_symbol_size = 4;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    // CALL 编号仍必须线性唯一；改变块枚举检查位置不能放过重复或无引用的调用记录。
    insts[3] = insts[2];
    insts[3].result_id = 3;
    f.inst_count = 4;
    f.value_count = 4;
    blocks[0].inst_count = 4;
    blocks[0].term_value = 3;
    if (ir.ir_verify(&f) == 0) { return 10; }
    f.inst_count = 3;
    f.value_count = 3;
    blocks[0].inst_count = 3;
    blocks[0].term_value = 2;
    calls[1].abi = 1;
    calls[1].symbol_first = 4;
    calls[1].symbol_len = 1;
    calls[1].arg_first = 2;
    calls[1].arg_count = 0;
    f.call_count = 2;
    f.call_symbol_size = 5;
    if (ir.ir_verify(&f) == 0) { return 11; }
    f.call_count = 1;
    f.call_symbol_size = 4;
    if (ir.ir_verify(&f) != 0) { return 1; }
    f.abi = 9;
    if (ir.ir_verify(&f) == 0) { return 11; }
    f.abi = 0;
    calls[0].abi = 9;
    if (ir.ir_verify(&f) == 0) { return 12; }
    calls[0].abi = 1;
    args[1].type_id = 1;
    if (ir.ir_verify(&f) == 0) { return 2; }
    args[1].type_id = 0;
    args[1].value = 2;
    if (ir.ir_verify(&f) == 0) { return 3; }
    args[1].value = 1;
    symbols[0] = ';';
    if (ir.ir_verify(&f) == 0) { return 4; }
    symbols[0] = '_';
    calls[0].arg_count = 1;
    if (ir.ir_verify(&f) == 0) { return 5; }
    calls[0].arg_count = 2;
    insts[2].result_id = -1;
    insts[2].result_type = -1;
    blocks[0].term_value = 0;
    f.value_count = 2;
    if (ir.ir_verify(&f) != 0) { return 10; }
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    blocks[0].term_value = 2;
    f.value_count = 3;
    let bytes [512]u8;
    let size int = ir.ir_serialized_size(&f);
    if (size <= 0 || size > 512 || ir.ir_serialize(&f, &bytes[0], 512) != size) { return 6; }
    let decoded ir.IRFunction;
    decoded.types = 0;
    decoded.insts = 0;
    decoded.phis = 0;
    decoded.phi_inputs = 0;
    decoded.calls = 0;
    decoded.call_args = 0;
    decoded.call_symbols = 0;
    decoded.blocks = 0;
    if (ir.ir_deserialize(&decoded, &bytes[0], size, 1) != 0) { return 7; }
    let valid int = decoded.abi == 0 && decoded.calls[0].abi == 1 && decoded.call_count == 1 && decoded.call_arg_count == 2
        && decoded.call_symbol_size == 4 && decoded.call_symbols[0] == '_'
        && decoded.call_args[1].value == 1 && ir.ir_simplify(&decoded) == 0
        && decoded.insts[2].op == ir.IR_OP_CALL;
    ir.ir_function_release(&decoded);
    if (valid == 0) { return 8; }
    bytes[404] = 1;
    if (ir.ir_deserialize(&decoded, &bytes[0], size, 1) == 0) { return 9; }
    return 0;
}

fn main() int {
    let phi int = check_phi();
    if (phi != 0) {
        return 10 + phi;
    }
    let param int = check_param_prologue();
    if (param != 0) { return 20 + param; }
    let memory int = check_memory_fields();
    if (memory != 0) { return 30 + memory; }
    let integer_ops int = check_integer_op_types();
    if (integer_ops != 0) { return 40 + integer_ops; }
    let direct_call int = check_direct_call_ir();
    if (direct_call != 0) { return 50 + direct_call; }
    return check_simplify();
}
