module main;

import geom;

fn sum(all ...int) int {
    let s int = 0;
    let i int = 0;
    for i < len(all) {
        s += all[i];
        i += 1;
    }
    return s;
}

fn fib(n int) int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() int {
    let a geom.V2 = geom.V2 { x: 1.0, y: 2.0 };
    let b geom.V2 = geom.V2 { x: 3.0, y: 4.0 };
    let c geom.V2 = geom.add(a, b);
    let d f64 = geom.dot(b, a);
    return sum(1, 2, 3, fib(6)) + c.x.to_type(int) + d.to_type(int);
}
