module main

// JSON 模型验收：句柄、空视图、多文档共存、输入生命周期、释放幂等、位置。

import io
import json

let failed int = 0

// ok 记录一条断言结果。
fn ok(condition int, name *char) void {
    if (condition == 0) {
        failed += 1
        io.print("FAIL ")
        io.println(name)
    }
}

// expect_kind 断言根值类型。
fn expect_kind(text *char, kind json.ValueKind, name *char) void {
    let result json.ParseResult = json.parse_text(text)
    if (result.status != json.parse_ok) {
        ok(0, name)
        json.release(&result.document)
        return
    }
    let root json.Value = json.root(&result.document)
    ok((json.kind(root) == kind).to_type(int), name)
    json.release(&result.document)
}

// check_kinds 断言各类型的根值。
fn check_kinds() void {
    expect_kind("{}", json.kind_object, "object")
    expect_kind("[]", json.kind_array, "array")
    expect_kind("null", json.kind_null, "null")
    expect_kind("true", json.kind_boolean, "boolean")
    expect_kind("1", json.kind_number, "number")
    expect_kind("\"s\"", json.kind_string, "string")
}

// check_empty 断言空视图与空输入。
fn check_empty() void {
    let empty json.Value
    empty.handle = 0
    ok((json.kind(empty) == json.kind_invalid).to_type(int), "empty view kind")
    let span json.Span = json.value_span(empty)
    ok((span.offset == 0 && span.line == 0).to_type(int), "empty view span")
    let bad json.ParseResult = json.parse(0, 0)
    ok((bad.status == json.parse_syntax_error).to_type(int), "empty input")
    ok((bad.document.handle == 0).to_type(int), "empty input no doc")
    ok((bad.error.code == json.error_syntax).to_type(int), "empty input code")
}

// check_multi 断言两个文档同时存活且互不覆盖。
fn check_multi() void {
    let first json.ParseResult = json.parse_text("{\"a\": 1}")
    let second json.ParseResult = json.parse_text("{\"a\": 2}")
    ok((first.status == json.parse_ok).to_type(int), "first ok")
    ok((second.status == json.parse_ok).to_type(int), "second ok")
    let a1 json.LookupResult = json.get(json.root(&first.document), "a")
    let a2 json.LookupResult = json.get(json.root(&second.document), "a")
    let v1 i64 = 0
    let v2 i64 = 0
    json.as_i64(a1.value, &v1)
    json.as_i64(a2.value, &v2)
    ok((v1 == 1 && v2 == 2).to_type(int), "two documents")
    json.release(&first.document)
    json.release(&second.document)
    ok((first.document.handle == 0).to_type(int), "release clears handle")
    json.release(&first.document)
    json.release(0)
}

// check_borrow 断言解析只借用输入。
fn check_borrow() void {
    let source [16]u8
    source[0] = 123
    source[1] = 34
    source[2] = 107
    source[3] = 34
    source[4] = 58
    source[5] = 55
    source[6] = 125
    let borrowed json.ParseResult = json.parse(&source[0], 7)
    ok((borrowed.status == json.parse_ok).to_type(int), "borrowed parse")
    let i int = 0
    for i < 16 {
        source[i] = 32
        i += 1
    }
    let key json.LookupResult = json.get(json.root(&borrowed.document), "k")
    let value i64 = 0
    ok((json.as_i64(key.value, &value) == json.query_ok).to_type(int),
        "borrowed query")
    ok((value == 7).to_type(int), "borrowed value")
    json.release(&borrowed.document)
}

// check_spans 断言位置信息。
fn check_spans() void {
    let located json.ParseResult = json.parse_text("{\n  \"k\": [1, 2]\n}")
    let array json.LookupResult = json.get(json.root(&located.document), "k")
    let array_span json.Span = json.value_span(array.value)
    ok((array_span.line == 2).to_type(int), "value line")
    let second_item json.LookupResult = json.array_get(array.value, 1)
    let item_span json.Span = json.value_span(second_item.value)
    ok((item_span.column == 12).to_type(int), "item column")
    json.release(&located.document)
}

// main 跑模型断言。
fn main() int {
    check_kinds()
    check_empty()
    check_multi()
    check_borrow()
    check_spans()
    if (failed == 0) {
        io.println("json model ok")
        return 0
    }
    return 1
}
