module app;

import helper;

pub const LIMIT int = 3
let counter int = 0

pub struct Thing {
    x int
}

fn secret(v int) int {
    return v + 1
}

pub fn value() int {
    return 7
}

test "仅测试使用 helper" {
    $assert(helper.bump(1) == 2)
}

test secret {
    $assert(secret(1) == 2)
}

test LIMIT {
    $assert(LIMIT == 3)
}

test counter {
    $assert(counter == 0)
}

test Thing {
    let t Thing
    $assert(t.x == 0)
}
