module main

import fmt
import io
import string

struct Point {
    x int
    y int
}

// add 验证插值表达式可以是函数调用。
fn add(left int, right int) int {
    return left + right
}

fn main() int {
    let name *char = "Bob"
    let count int = 7
    let point Point = Point{ x: 3, y: 4 }
    let values [3]int = [10, 20, 30]
    let uval u32 = 42
    let wide i64 = 99
    let first string.String = "Hello, ${name}! n=${count} sum=${add(count, 5)} p=${point.x},${point.y} idx=${values[0]} u=${uval} w=${wide}"
    let second string.String = "hex=${count:04x} f=${1.5:.2f} bool=${true} literal=\${n}"
    let first_c string.CStrResult = string.c_str(&first)
    let second_c string.CStrResult = string.c_str(&second)
    let brief string.String = string.make()
    let hi string.ViewResult = string.view_cstr("hi")
    fmt.append_text(&brief, hi.value)
    let brief_view string.View = string.as_view(&brief)
    let third string.String = "v=${brief_view}"
    let third_c string.CStrResult = string.c_str(&third)
    io.println(first_c.data)
    io.println(second_c.data)
    io.println("plain $5 and \${x} and \$x")
    io.println(third_c.data)
    string.release(&third)
    string.release(&brief)
    string.release(&first)
    string.release(&second)
    return 0
}
