module plib;

// 模块私有类型（2026-10-12，ADR-0013）：struct/union/enum 缺省 pub 即模块私有，
// 不进接口文件、跨模块不可命名。本 fixture 供 build-check 的正反用例共用。

struct Secret {
    v int;
}

union Raw {
    i int;
    f f32;
}

enum Kind {
    none;
    file;
}

// 私有类型的模块级存储：同样只在模块内可见。
let slot Secret;

// 对外只提供不泄漏类型名的 pub API（句柄/访问函数）。
pub fn set(v int) int {
    slot.v = v;
    return slot.v;
}

pub fn get() int {
    return slot.v;
}

pub fn kind() int {
    // Kind.file 判别值为 1
    return Kind.file;
}

pub fn raw(v int) int {
    let r Raw;
    r.i = v;
    return r.i;
}
