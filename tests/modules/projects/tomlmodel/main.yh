module main

// TOML T0 模型验收：句柄、空文档、多文档共存、输入生命周期、释放幂等。

import io
import toml

let failed int = 0

// ok 记录一条断言结果。
fn ok(condition int, name *char) void {
    if (condition == 0) {
        failed += 1
        io.print("FAIL ")
        io.println(name)
    }
}

// main 跑模型断言。
pub fn main() int {
    // 空文档合法。
    let empty toml.ParseResult = toml.parse(0, 0)
    ok((empty.status == toml.parse_ok).to_type(int), "empty parse")
    let empty_root toml.Value = toml.root(&empty.document)
    ok((toml.kind(empty_root) == toml.kind_table).to_type(int), "empty root table")
    let empty_count u64 = 99
    ok((toml.count(empty_root, &empty_count) == toml.query_ok).to_type(int),
        "empty count status")
    ok((empty_count == 0).to_type(int), "empty count")
    toml.release(&empty.document)
    ok((empty.document.handle == 0).to_type(int), "release clears handle")
    toml.release(&empty.document)

    // 输入只借用：解析后改写输入，文档值保持不变。
    let source [32]u8
    let i int = 0
    for i < 32 {
        source[i] = 32
        i += 1
    }
    source[0] = 'a'
    source[1] = ' '
    source[2] = '='
    source[3] = ' '
    source[4] = '1'
    let first toml.ParseResult = toml.parse(&source[0], 5)
    ok((first.status == toml.parse_ok).to_type(int), "first parse")
    source[4] = '9'
    let first_root toml.Value = toml.root(&first.document)
    let got toml.LookupResult = toml.get(first_root, "a")
    let number i64 = 0
    ok((toml.as_i64(got.value, &number) == toml.query_ok).to_type(int),
        "first as_i64")
    ok((number == 1).to_type(int), "input mutation isolated")
    let span toml.Span = toml.value_span(got.value)
    ok((span.offset == 4).to_type(int), "value span offset")
    ok((span.length == 1).to_type(int), "value span length")
    ok((span.line == 1).to_type(int), "value span line")
    ok((span.column == 5).to_type(int), "value span column")

    // 两个文档同时存活，互不覆盖。
    let second toml.ParseResult = toml.parse_text("a = 2")
    ok((second.status == toml.parse_ok).to_type(int), "second parse")
    let second_root toml.Value = toml.root(&second.document)
    let second_got toml.LookupResult = toml.get(second_root, "a")
    let second_number i64 = 0
    toml.as_i64(second_got.value, &second_number)
    ok((second_number == 2).to_type(int), "second value")
    toml.as_i64(got.value, &number)
    ok((number == 1).to_type(int), "first value still alive")

    // Value 是句柄的只读视图，复制结构体仍指向同一节点。
    let copied toml.Value = got.value
    let copied_number i64 = 0
    ok((toml.as_i64(copied, &copied_number) == toml.query_ok).to_type(int),
        "copied value")
    ok((copied_number == 1).to_type(int), "copied value payload")

    // 空句柄查询返回无效视图/参数错误，不崩溃。
    let invalid toml.Value = copied
    invalid.handle = 0
    ok((toml.kind(invalid) == toml.kind_invalid).to_type(int), "invalid kind")
    ok((toml.get(invalid, "a").status == toml.query_type_error).to_type(int),
        "invalid get")
    ok((toml.get(first_root, 0).status == toml.query_argument_error).to_type(int),
        "null key")
    let zero_span toml.Span = toml.value_span(invalid)
    ok((zero_span.offset == 0 && zero_span.length == 0).to_type(int),
        "invalid span")
    toml.release(&first.document)
    toml.release(&second.document)

    if (failed != 0) {
        return 1
    }
    io.println("toml model ok")
    return 0
}
