module app;

import testing;

fn bump(v int) int {
    return v + 1
}

test "通过" {
    $assert(bump(1) == 2)
}

test "显式失败" {
    testing.fail("helper 拒绝继续")
}

test "显式跳过" {
    testing.skip("本平台未实现")
}

test "带消息的断言失败" {
    $assert(bump(1) == 99, "bump 结果不对")
}

test "带输出的长消息失败" {
    printf("case-stdout-marker\n")
    $assert(bump(1) == 99, "这条消息刻意写得比较长，用来验证消息超过五十九字节时会出现截断提示，而不是被静默截断。")
}

test "跳过之后继续" {
    $assert(bump(41) == 42)
}
