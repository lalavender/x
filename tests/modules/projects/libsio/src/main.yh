module main;

import io;

// main 验证工具链 libs 项目的 io 模块，并检查成功与失败写入结果。
fn main() int {
    if (io.println("yh libs io ok") != 0) {
        return 1;
    }
    if (io.write_all(-1, "x", 1) != -1) {
        return 2;
    }
    if (io.write_all(1, "", 0) != 0) {
        return 3;
    }
    if (io.write_all(1, "x", -1) != -1) {
        return 4;
    }
    return 23;
}
