module app;

fn bump(v int) int {
    return v + 1
}

test "通过" {
    $assert(bump(1) == 2)
}

test "断言失败" {
    $assert(bump(1) == 99, "应当失败")
}

test "提前退出不算通过" {
    exit(0)
}

test "崩溃不算通过" {
    // 写一个**运行期才确定**的未映射地址：`p = 0` 的空指针写属于 UB，
    // LLVM 在 O0 也可能把它删掉（Windows/COFF 目标实测删成 nop，用例变成
    // 正常返回 → 被误判为 PASS）。用 getpid 派生的大地址让后端无法证明它
    // 不可写，store 一定发射，进程按访问违例结束。
    let base int = getpid() % 1024
    let p *int = (base * 1073741824 + 4096).to_type(*int)
    p[0] = 1
}

test "失败后继续执行" {
    $assert(bump(41) == 42)
}
