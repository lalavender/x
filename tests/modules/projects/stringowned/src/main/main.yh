module main

import io
import string

// view_of_cstr 把已知有效的 C 字符串转成视图。
fn view_of_cstr(text *char) string.View {
    let result string.ViewResult = string.view_cstr(text)
    return result.value
}

// view_of_bytes 把已知有效的字节区间转成视图。
fn view_of_bytes(data *u8, count u64) string.View {
    let result string.ViewResult = string.view_bytes(data, count)
    return result.value
}

// expect_cstr 比较视图与 NUL 结尾期望文本；失败返回 code。
fn expect_cstr(actual string.View, expected *char, code int) int {
    let expected_result string.ViewResult = string.view_cstr(expected)
    if (expected_result.status != string.status_ok) {
        return code
    }
    if (!string.view_equal(actual, expected_result.value)) {
        return code
    }
    return 0
}

// expect_bytes 比较视图与显式字节区间；失败返回 code。
fn expect_bytes(actual string.View, data *u8, count u64, code int) int {
    let expected string.View
    expected.data = data
    expected.count = count
    if (!string.view_equal(actual, expected)) {
        return code
    }
    return 0
}

// main 覆盖 ST3：生命周期、容量、赋值/追加/缩短、自别名与 C 边界。
fn main() int {
    // 零句柄空串与 O(1) 查询。
    let value string.String = string.make()
    if (value.handle != 0 || string.byte_length(&value) != 0
        || string.capacity(&value) != 0 || string.as_view(&value).count != 0) {
        return 1
    }

    // from_view 独立复制，输入改写不影响结果。
    let source [3]u8 = [0, 0, 0]
    source[0] = 'a'
    source[1] = 'b'
    source[2] = 'c'
    let from_result string.StringResult = string.from_view(view_of_bytes(&source[0], 3))
    if (from_result.status != string.status_ok || string.byte_length(&from_result.value) != 3) {
        return 2
    }
    let from_view string.View = string.as_view(&from_result.value)
    if (expect_cstr(from_view, "abc", 3) != 0) { return 3 }
    if (from_view.data[3] != 0) { return 4 }
    source[0] = 'X'
    if (expect_cstr(string.as_view(&from_result.value), "abc", 5) != 0) { return 5 }

    // append / append_byte：增长、空追加、内嵌 NUL 与额外 NUL。
    if (string.append(&from_result.value, view_of_cstr("def")) != string.status_ok) { return 6 }
    if (string.byte_length(&from_result.value) != 6
        || expect_cstr(string.as_view(&from_result.value), "abcdef", 7) != 0) {
        return 7
    }
    if (string.capacity(&from_result.value) < 6) { return 8 }
    if (string.append(&from_result.value, view_of_cstr("")) != string.status_ok) { return 9 }
    if (string.byte_length(&from_result.value) != 6) { return 10 }
    if (string.append_byte(&from_result.value, 0) != string.status_ok) { return 11 }
    if (string.byte_length(&from_result.value) != 7) { return 12 }
    let with_nul string.View = string.as_view(&from_result.value)
    if (with_nul.data[6] != 0 || with_nul.data[7] != 0) { return 13 }
    let nul_cstr string.CStrResult = string.c_str(&from_result.value)
    if (nul_cstr.status != string.status_embedded_nul || nul_cstr.data != 0) { return 14 }

    // assign：替换、复用容量、空赋值与自身子视图重叠。
    if (string.assign(&from_result.value, view_of_cstr("hello")) != string.status_ok) { return 15 }
    if (expect_cstr(string.as_view(&from_result.value), "hello", 16) != 0) { return 16 }
    let hello_capacity u64 = string.capacity(&from_result.value)
    if (string.assign(&from_result.value, view_of_cstr("")) != string.status_ok) { return 17 }
    if (string.byte_length(&from_result.value) != 0
        || string.capacity(&from_result.value) != hello_capacity) {
        return 18
    }
    if (string.assign(&from_result.value, view_of_cstr("abcdef")) != string.status_ok) { return 19 }
    let self_sub string.ViewResult = string.slice(string.as_view(&from_result.value), 2, 5)
    if (self_sub.status != string.status_ok) { return 20 }
    if (string.assign(&from_result.value, self_sub.value) != string.status_ok) { return 21 }
    if (expect_cstr(string.as_view(&from_result.value), "cde", 22) != 0) { return 22 }

    // clear 保留容量；清空后可继续追加。
    if (string.assign(&from_result.value, view_of_cstr("xyz")) != string.status_ok) { return 23 }
    let before_clear_capacity u64 = string.capacity(&from_result.value)
    string.clear(&from_result.value)
    if (string.byte_length(&from_result.value) != 0
        || string.capacity(&from_result.value) != before_clear_capacity) {
        return 24
    }
    if (string.append(&from_result.value, view_of_cstr("new")) != string.status_ok) { return 25 }
    if (expect_cstr(string.as_view(&from_result.value), "new", 26) != 0) { return 26 }

    // truncate 只缩短；越界报 bounds 且内容不变。
    if (string.truncate(&from_result.value, 2) != string.status_ok) { return 27 }
    if (expect_cstr(string.as_view(&from_result.value), "ne", 28) != 0) { return 28 }
    if (string.as_view(&from_result.value).data[2] != 0) { return 29 }
    if (string.truncate(&from_result.value, 5) != string.status_bounds) { return 30 }
    if (expect_cstr(string.as_view(&from_result.value), "ne", 31) != 0) { return 31 }
    if (string.truncate(&from_result.value, 0) != string.status_ok) { return 32 }

    // reserve 保证容量、保持内容；已有容量足够时不增长。
    if (string.assign(&from_result.value, view_of_cstr("reserve")) != string.status_ok) { return 33 }
    if (string.reserve(&from_result.value, 100) != string.status_ok) { return 34 }
    if (string.capacity(&from_result.value) < 100
        || expect_cstr(string.as_view(&from_result.value), "reserve", 35) != 0) {
        return 35
    }
    let reserved_capacity u64 = string.capacity(&from_result.value)
    if (string.reserve(&from_result.value, 10) != string.status_ok) { return 36 }
    if (string.capacity(&from_result.value) != reserved_capacity) { return 37 }

    // clone 深复制、move 清零、release 幂等与零串复用。
    let cloned string.StringResult = string.clone(&from_result.value)
    if (cloned.status != string.status_ok) { return 38 }
    if (string.append(&from_result.value, view_of_cstr("!")) != string.status_ok) { return 39 }
    if (expect_cstr(string.as_view(&cloned.value), "reserve", 40) != 0) { return 40 }
    let moved string.String = string.move(&from_result.value)
    if (from_result.value.handle != 0 || string.byte_length(&moved) != 8) { return 41 }
    string.release(&moved)
    string.release(&moved)
    if (moved.handle != 0) { return 42 }
    if (string.append(&moved, view_of_cstr("again")) != string.status_ok) { return 43 }
    if (expect_cstr(string.as_view(&moved), "again", 44) != 0) { return 44 }
    string.release(&moved)
    let zero_clone string.StringResult = string.clone(&moved)
    if (zero_clone.status != string.status_ok || zero_clone.value.handle != 0) { return 45 }

    // c_str：空串、非 ASCII、尾部 NUL 与内容内 NUL 拒绝。
    let empty_string string.String = string.make()
    let empty_cstr string.CStrResult = string.c_str(&empty_string)
    if (empty_cstr.status != string.status_ok || empty_cstr.data == 0
        || empty_cstr.data[0] != 0) {
        return 46
    }
    let text_result string.StringResult = string.from_view(view_of_cstr("hé中"))
    if (text_result.status != string.status_ok) { return 47 }
    let text_cstr string.CStrResult = string.c_str(&text_result.value)
    if (text_cstr.status != string.status_ok || text_cstr.data == 0) { return 48 }
    if (text_cstr.data[0] != 'h' || text_cstr.data[1] != 195 || text_cstr.data[2] != 169) {
        return 49
    }
    let text_bytes string.View = string.as_view(&text_result.value)
    if (text_bytes.count != 6 || text_bytes.data[6] != 0) { return 50 }
    if (string.append(&text_result.value, view_of_cstr("!")) != string.status_ok) { return 51 }
    let text_cstr_again string.CStrResult = string.c_str(&text_result.value)
    if (text_cstr_again.status != string.status_ok || text_cstr_again.data == 0) { return 52 }
    string.release(&text_result.value)

    // 自追加：容量足够与扩容两类，覆盖整串和子视图。
    let grow string.StringResult = string.from_view(view_of_cstr("abc"))
    if (grow.status != string.status_ok) { return 53 }
    if (string.reserve(&grow.value, 16) != string.status_ok) { return 54 }
    let grow_view string.View = string.as_view(&grow.value)
    if (string.append(&grow.value, grow_view) != string.status_ok) { return 55 }
    if (expect_cstr(string.as_view(&grow.value), "abcabc", 56) != 0) { return 56 }
    let grow_sub string.ViewResult = string.slice(string.as_view(&grow.value), 1, 4)
    if (grow_sub.status != string.status_ok) { return 57 }
    if (string.append(&grow.value, grow_sub.value) != string.status_ok) { return 58 }
    if (expect_cstr(string.as_view(&grow.value), "abcabcbca", 59) != 0) { return 59 }

    let expand string.StringResult = string.from_view(view_of_cstr("abcdef"))
    if (expand.status != string.status_ok) { return 60 }
    let expand_sub string.ViewResult = string.slice(string.as_view(&expand.value), 1, 4)
    if (expand_sub.status != string.status_ok) { return 61 }
    if (string.append(&expand.value, expand_sub.value) != string.status_ok) { return 62 }
    if (expect_cstr(string.as_view(&expand.value), "abcdefbcd", 63) != 0) { return 63 }
    let expand_all string.View = string.as_view(&expand.value)
    if (string.append(&expand.value, expand_all) != string.status_ok) { return 64 }
    if (string.byte_length(&expand.value) != 18) { return 65 }
    let expand_bytes string.View = string.as_view(&expand.value)
    if (expand_bytes.data[0] != 'a' || expand_bytes.data[17] != 'd') { return 66 }

    // assign 重叠：源是旧内容内的子区间。
    let overlap string.StringResult = string.from_view(view_of_cstr("abcdef"))
    if (overlap.status != string.status_ok) { return 67 }
    let overlap_sub string.ViewResult = string.slice(string.as_view(&overlap.value), 2, 5)
    if (overlap_sub.status != string.status_ok) { return 68 }
    if (string.assign(&overlap.value, overlap_sub.value) != string.status_ok) { return 69 }
    if (expect_cstr(string.as_view(&overlap.value), "cde", 70) != 0) { return 70 }
    string.release(&overlap.value)
    string.release(&grow.value)
    string.release(&expand.value)

    // 溢出先拒绝，不分配：超过 STRING_MAX_LENGTH 的视图长度。
    let huge_data [1]u8 = [0]
    let huge string.View
    huge.data = &huge_data[0]
    huge.count = 9223372036854775807
    let huge_result string.StringResult = string.from_view(huge)
    if (huge_result.status != string.status_overflow) { return 71 }
    if (string.reserve(&empty_string, 9223372036854775807) != string.status_overflow) {
        return 72
    }

    io.println("string owned ok")
    return 0
}
