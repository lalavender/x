module main;

@[comptime]
fn add_layout_item(value int) int {
    return value + 1;
}

const FIRST_LAYOUT_COUNT int = $add_layout_item(SECOND_LAYOUT_COUNT);

pub struct CrossFileLayoutPacket {
    values [$add_layout_item(FIRST_LAYOUT_COUNT) * 2]int;
}

fn main() int {
    let packet CrossFileLayoutPacket;
    if (len(packet.values) == 10 && sizeof(CrossFileLayoutPacket) == 40) {
        return 0;
    }
    return 1;
}
