module main;

pub struct Pair {
    left int;
    right int;
}

fn main() int {
    let p Pair = Pair{left: 20, right: 1};
    let binding int = ast_bindings(1);
    if (binding != 5) {
        return 1;
    }
    if (ast_forin() != 3) {
        return 1;
    }
    let shape int = ast_stmt_shapes(1);
    if (shape != 9) {
        return 1;
    }
    // ast_exprs 只用于表达式形状重放（UF1 要求被引用）；ast_exprs(0) 走
    // 假分支，等于 a[0] + s[1..3][0] = 1 + 2 = 3。
    if (ast_exprs(0) != 3) {
        return 1;
    }
    return evaluate(p);
}
