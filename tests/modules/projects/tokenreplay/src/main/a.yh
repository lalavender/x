module main;

struct Pair {
    left int;
    right int;
}

fn main() int {
    let p Pair = Pair{left: 20, right: 1};
    let binding int = ast_bindings(1);
    if (binding != 5) {
        return 1;
    }
    if (ast_forin() != 3) {
        return 1;
    }
    let shape int = ast_stmt_shapes(1);
    if (shape != 9) {
        return 1;
    }
    return evaluate(p);
}
