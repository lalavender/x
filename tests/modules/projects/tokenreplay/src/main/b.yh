module main;
import mathx;

const AST_BIAS int = 3;

fn evaluate(p Pair) int {
    return mathx.twice(p.left + p.right);
}

fn ast_exprs(x int) int {
    let a [3]int = [1, 2, 3];
    let s []int = a.to_type([]int);
    let value int = s[1..3][0];
    return x > 0 && value != 0 ? -value : a[0] + value;
}

fn ast_stmt_shapes(value int) int {
    if (value > 2) {
        value += 1;
    } else {
        value -= 1;
    }
    for value < 8 {
        value += 1;
        if (value == 6) {
            continue;
        }
    }
    switch value {
        case 8 {
            value = 9;
        }
        default {
            value = 10;
        }
    }
    return value;
}

fn ast_bindings(input int) int {
    let local int = input + AST_BIAS, next int = local + 1;
    {
        const adjusted int = 7;
        let local int = adjusted;
        local += 1;
    }
    return next;
}

fn ast_forin() int {
    let values [2]int = [1, 2];
    let sum int = 0;
    for value in values {
        sum += value;
    }
    return sum;
}
