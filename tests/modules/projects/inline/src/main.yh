module main;

@[extern]
fn putchar(ch int) int;

@[inline]
fn plus_three(value int) int {
    return value + 3;
}

@[inline]
pub fn public_plus_two(value int) int {
    return value + 2;
}

@[inline]
fn conditional(value int) int {
    if (value > 0) {
        return value + 1;
    }
    return value - 1;
}

fn main() int {
    if (plus_three(putchar(65)) != 68) {
        return 1;
    }
    if (public_plus_two(40) != 42) {
        return 2;
    }
    if (conditional(1) != 2) { return 3; }
    return 0;
}
