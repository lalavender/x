module main;

// 函数级 IR 缓存（PC1）回归夹具：三个函数足以覆盖「全命中」与
// 「改一个函数体只失效该函数」两条断言。
fn add_one(x int) int {
    return x + 1;
}

fn twice(x int) int {
    return x * 2;
}

fn main() int {
    let a int = add_one(1);
    let b int = twice(3);
    if (a == 2 && b == 6) {
        return 0;
    }
    return 1;
}
