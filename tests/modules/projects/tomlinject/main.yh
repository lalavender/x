module main

// TOML T4.1 分配失败注入验收：测试构建把私有注入点改成可运行时设置的全局，
// 逐次允许 0,1,2,... 次池分配，直到文档成功。每次失败都必须返回资源错误、
// 没有半成品文档，并且同一进程内再次解析仍能干净失败。
//
// 本 fixture 不能对产品标准库构建：它引用的 test_set_fail_after 只由
// tests/toml/injection.py 在临时标准库副本中注入。

import io
import toml

// print_u64 输出无符号十进制。
fn print_u64(value u64) void {
    let buf [32]char
    let at int = 31
    buf[at] = 0
    if (value == 0) {
        at -= 1
        buf[at] = '0'
    } else {
        let left u64 = value
        for left > 0 {
            at -= 1
            buf[at] = ('0'.to_type(int) + (left % 10).to_type(int)).to_type(char)
            left = left / 10
        }
    }
    io.print(&buf[at])
}

// source_document 返回覆盖键/字符串/数值/时间/数组/内联表/数组表的文档。
fn source_document() *char {
    return "title = \"yh\"\na.b.c = 1\n[server]\nhost = \"localhost\"\nport = 8080\nenabled = true\nratio = 1.5\nwhen = 1979-05-27T07:32:00Z\ntags = [\"a\", \"b\", { k = 1 }]\n[server.limits]\nmax = 10\n[[items]]\nname = \"first\"\n[[items]]\nname = \"second\"\n[[items]]\nname = \"third\"\n[inline]\nv = { a = 1, b = [1, 2], c = { d = \"x\" } }\n"
}

// failure_is_clean 判断一次解析失败是否满足契约。
fn failure_is_clean(result toml.ParseResult) int {
    if (result.status != toml.parse_resource_error) {
        return 0
    }
    if (result.error.code != toml.error_out_of_memory) {
        return 0
    }
    if (result.document.handle != 0) {
        return 0
    }
    return 1
}

// success_is_correct 校验成功文档的关键值。
fn success_is_correct(result toml.ParseResult) int {
    let root toml.Value = toml.root(&result.document)
    let title toml.Text
    if (toml.as_text(toml.get(root, "title").value, &title) != toml.query_ok
        || title.count != 2) {
        return 0
    }
    let server toml.LookupResult = toml.get(root, "server")
    let port i64 = 0
    if (toml.as_i64(toml.get(server.value, "port").value, &port)
        != toml.query_ok || port != 8080) {
        return 0
    }
    let items toml.LookupResult = toml.get(root, "items")
    let item_count u64 = 0
    if (toml.count(items.value, &item_count) != toml.query_ok
        || item_count != 3) {
        return 0
    }
    let inline_table toml.LookupResult = toml.get(root, "inline")
    let v toml.LookupResult = toml.get(inline_table.value, "v")
    let c toml.LookupResult = toml.get(v.value, "c")
    let text toml.Text
    if (toml.as_text(toml.get(c.value, "d").value, &text) != toml.query_ok
        || text.count != 1) {
        return 0
    }
    let a toml.LookupResult = toml.get(root, "a")
    let b toml.LookupResult = toml.get(a.value, "b")
    let number i64 = 0
    if (toml.as_i64(toml.get(b.value, "c").value, &number)
        != toml.query_ok || number != 1) {
        return 0
    }
    return 1
}

// main 从 0 开始逐次提高允许分配数；成功时打印计数。
pub fn main() int {
    let source *char = source_document()
    let allowed int = 0
    for allowed < 512 {
        toml.test_set_fail_after(allowed)
        let result toml.ParseResult = toml.parse_text(source)
        if (result.status == toml.parse_ok) {
            if (success_is_correct(result) == 0) {
                io.println("BAD_SUCCESS")
                toml.release(&result.document)
                return 1
            }
            io.print("INJECT_OK ")
            print_u64(allowed.to_type(u64))
            io.println("")
            toml.release(&result.document)
            return 0
        }
        if (failure_is_clean(result) == 0) {
            io.print("BAD_FAILURE ")
            print_u64(allowed.to_type(u64))
            io.print(" ")
            io.println(result.error.message)
            toml.release(&result.document)
            return 1
        }
        toml.release(&result.document)
        // 同一失败点再解析一次，验证失败没有留下跨文档状态。
        let again toml.ParseResult = toml.parse_text(source)
        if (failure_is_clean(again) == 0) {
            io.print("BAD_REPEAT ")
            print_u64(allowed.to_type(u64))
            io.println("")
            toml.release(&again.document)
            return 1
        }
        toml.release(&again.document)
        allowed += 1
    }
    io.println("NO_SUCCESS")
    return 1
}
