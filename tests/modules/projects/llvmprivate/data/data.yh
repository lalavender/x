module data;

// make_public_table：为跨模块测试生成 CT 聚合初始化式，验证接口闭包重放。
@[comptime] fn make_public_table() [3]int { return [7, 8, 9]; }

pub const PUBLIC_TABLE [3]int = $make_public_table();
let same_private_data [2]int = [3, 5];
let shared int = 10;

// private_total：私有初始化数据只经本模块函数读取。
pub fn private_total() int {
    return same_private_data[0] + same_private_data[1] + PUBLIC_TABLE[1] + 15;
}

// shared_value：pub 函数读取模块内可变状态。
pub fn shared_value() int { return shared; }

// set_shared：pub 函数修改模块内可变状态，避免导出可变全局。
pub fn set_shared(value int) void { shared = value; }
