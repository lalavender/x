module main;
import data;

let same_private_data [2]int = [40, 41];

// main：检验导入 pub const 的本地副本、pub 函数共享状态和私有名隔离。
fn main() int {
    let copy [3]int = data.PUBLIC_TABLE;
    copy[0] = 99;
    if (copy[0] != 99 || data.PUBLIC_TABLE[0] != 7 || data.PUBLIC_TABLE[2] != 9) { return 1; }
    if (data.private_total() != 31 || same_private_data[0] != 40
        || same_private_data[1] != 41) { return 2; }
    if (data.shared_value() != 10) { return 3; }
    data.set_shared(27);
    if (data.shared_value() != 27) { return 4; }
    return 0;
}
