module main;

import ctmath.api as math;

// Offset：消费者同名私有类型不得与提供方 CT 闭包的私有别名冲突。
type Offset = i64;
type Scalar = i64;

// write_back_total：导入方在自己帧内取址，交给外部模块的编译期过程写回。
@[comptime]
fn write_back_total() int {
    let acc int = 20;
    let result int = $math.write_back(&acc, 22);
    return acc + result;
}

const ANSWER int = $math.double_after_bump(20);
const WRITE_BACK int = $write_back_total();
const LETTER int = $math.first_letter();
const EXPORTED int = $math.exported_letter();
// HEAD：跨模块编译期调用里的直接字符串字面量实参（就地登记只读池）。
const HEAD int = $math.head_of("AB");
// MID：模块模式下延迟判别值枚举成员的顶层引用（low=4 → mid=5）。
const MID int = $math.level_mid();
// PS/PL：模块模式编译期正文里直接引用枚举成员（普通成员与延迟判别值成员各一）。
const PS int = $math.probe_simple();
const PL int = $math.probe_low();
// TEXT_ARG：跨模块实参用导入模块里以字面量初始化的 pub const 指针常量（'A' = 65）。
const TEXT_ARG int = $math.head_of(math.TEXT_PTR);
// ALIAS_ARG：跨模块实参用「引用式」指针常量（接口追到最终字面式重放，'h' = 104）。
const ALIAS_ARG int = $math.head_of(math.TEXT_ALIAS);
// ALIAS_BODY：提供方 CT 正文里引用引用式指针常量（'h' = 104）。
const ALIAS_BODY int = $math.alias_head();
// CHAIN_ARG：三级引用链的指针常量实参（'h' = 104）。
const CHAIN_ARG int = $math.head_of(math.CHAIN_3);
// PT：模块模式下顶层编译期调用的结构体聚合实参（3*10 + 4 = 34）。
const PT int = $math.probe_top();
// PRIV_CT：跨模块编译期读提供方私有聚合常量（闭包重放源文本 + 导入侧建模，
// 1+2+3 再取末位 3 → 9）。
const PRIV_CT int = $math.priv_tbl_ct();
// PRIV_SLICE_CT：跨模块编译期读提供方私有**切片**常量（5+7+9 + 首元素 5 + len 3 = 29）。
const PRIV_SLICE_CT int = $math.priv_slice_ct();
// PUB_CT：跨模块编译期执行提供方正文读**导出**聚合常量（4+5+6 + 中位 5 = 20）。
const PUB_CT int = $math.pub_tbl_ct();

// pub_model：消费者自己的编译期正文读导入的 pub 聚合常量（.s.i 加载即建模，
// 4+5+6 再取首元素 4 = 19）。
@[comptime]
fn pub_model() int {
    let s int = 0;
    for v in math.PUB_TBL { s += v; }
    return s + math.PUB_TBL[0];
}
const PUB_MODEL int = $pub_model();

// ct_tbl_model：消费者正文读导入的 **$ 初始化** pub 聚合常量
// （延迟执行后建模，7+8+9 再取首元素 7 = 31）。
@[comptime]
fn ct_tbl_model() int {
    let s int = 0;
    for v in math.CT_TBL { s += v; }
    return s + math.CT_TBL[0];
}
const CT_TBL_MODEL int = $ct_tbl_model();
// CT_TBL_CT：提供方正文读自己的 $ 初始化常量（7 + 9 = 16）。
const CT_TBL_CT int = $math.ct_tbl_ct();

fn main() int {
    return ANSWER - 42 + WRITE_BACK - 84 + LETTER - 104 + EXPORTED - 104 + HEAD - 65 + MID - 5 + PS - 2 + PL - 4 + PT - 34 + TEXT_ARG - 65 + ALIAS_ARG - 104 + ALIAS_BODY - 104 + CHAIN_ARG - 104 + math.priv_tbl_sum() - 6 + PRIV_CT - 9 + PRIV_SLICE_CT - 29 + PUB_CT - 20 + PUB_MODEL - 19 + CT_TBL_MODEL - 31 + CT_TBL_CT - 16 + math.PUB_TBL[0] + math.PUB_TBL[2] - 10 + math.CT_TBL[0] + math.CT_TBL[2] - 16;
}
