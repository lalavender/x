module base;
import types as dimensions;

// point_size：用与同模块另一源文件不同的导入别名引用同一个公共类型。
@[comptime]
fn point_size() int {
    return sizeof(dimensions.Point);
}

// TEXT：跨模块导出的字符串字面量指针常量（接口原样重放声明）。
pub const TEXT *char = "hi";

// letter：读取本模块导出的字符串字面量指针常量。
@[comptime]
pub fn letter() int {
    return (*TEXT).to_type(int);
}

// base_value：延迟判别值依赖的编译期函数。
@[comptime]
fn base_value() int {
    return 3;
}

// Level：判别值来自编译期调用，隐式成员依赖前值（模块模式下的延迟回填）。
pub enum Level {
    low = $base_value() + 1;
    mid;
}

// MID：模块模式顶层常量直接引用枚举成员。
pub const MID int = Level.mid;

// mid_ct：编译期函数读取该常量（模块模式下 CT 正文引用枚举成员本身仍不支持）。
@[comptime]
pub fn mid_ct() int {
    return MID;
}

// Simple：普通枚举（判别值不含编译期调用，成员值在登记时就绪）。
pub enum Simple {
    one = 1;
    two;
}

// simple_ct：模块模式编译期正文里直接引用普通枚举成员（走枚举成员表）。
@[comptime]
pub fn simple_ct() int {
    return Simple.two;
}

// low_ct：模块模式编译期正文里直接引用延迟判别值枚举的成员。
@[comptime]
pub fn low_ct() int {
    return Level.low;
}

// Pair：模块模式下顶层聚合实参验收用的结构体。
pub struct Pair {
    x int;
    y int;
}

// weigh：读取结构体聚合形参的编译期函数。
@[comptime]
fn weigh(p Pair) int {
    return p.x * 10 + p.y;
}

// TOP：模块模式下的顶层编译期调用，实参是结构体字面量（在编译期临时构造区折叠）。
pub const TOP int = $weigh(Pair{ x: 3, y: 4 });

// top_ct：供 api 转发的编译期函数，读取上面那个常量。
@[comptime]
pub fn top_ct() int {
    return TOP;
}
