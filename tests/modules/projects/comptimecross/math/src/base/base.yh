module base;
import types as geometry;

// BaseOffset：公开结构体供消费者 .s.i 解析 CT 正文中的底层类型。
pub struct BaseOffset {
    amount int;
}

// Offset：验证模块私有具名别名在跨模块 CT 正文中被擦除为公开底层类型。
type Offset = BaseOffset;

// Scalar：覆盖编译期正文中的私有标量别名与类型转换。
type Scalar = int;

// OFFSET：私有编译期常量，需随公开 CT 正文闭包传递。
const OFFSET int = 1;

// FACTOR：测试浮点全局常量随跨模块 CT 正文闭包传递。
const FACTOR f64 = 1.25;

// LABEL：测试字符串字面量初始化的指针常量随跨模块 CT 正文闭包传递。
const LABEL *char = "CT5B_STRING_CLOSURE";

// plus_one：下游 API 模块的公开 CT 依赖，用于验证正文闭包的跨模块重定位。
@[comptime]
pub fn plus_one(value int) int {
    if (value == 0) {
        let factor f64 = FACTOR;
    }
    if (value == 0) {
        let label *char = LABEL;
    }
    if (value == 21) {
        let diagnostic_offset int = OFFSET; let diagnostic_dimension int = $point_size(); $compile_error("CT5B_SOURCE_MAP");
    }
    let offset Offset = Offset{amount: OFFSET};
    let pointer *Offset = 0;
    let offsets [2]Offset = [offset, Offset{amount: 0}];
    let converted Scalar = value.to_type(Scalar);
    let point geometry.Point = geometry.Point{amount: 0};
    let dimension int = sizeof(geometry.Point)
        + sizeof(*geometry.Point) + sizeof(**geometry.Point) - 20;
    let typed int = value.to_type(geometry.Scalar);
    return converted + typed - value + point.amount + offsets[0].amount
        + sizeof(Offset) + sizeof(*Offset) + sizeof(**Offset) - 20
        + dimension + $point_size() - 4;
}
