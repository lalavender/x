module api;
import base;

// bump：私有编译期辅助函数，验证导出正文的可达私有闭包。
@[comptime]
fn bump(value int) int {
    return $base.plus_one(value);
}

// double_after_bump：导出编译期过程，结果由导入方在编译期间计算。
@[comptime]
pub fn double_after_bump(value int) int {
    return $bump(value) * 2;
}

// write_back：导出编译期过程，经指针形参写回导入方调用帧的局部值。
@[comptime]
pub fn write_back(target *int, delta int) int {
    *target += delta;
    return *target;
}

// first_letter：跨模块正文内的字符串字面量指针常量解引用（正文重放后自行登记字节池）。
@[comptime]
pub fn first_letter() int {
    let text *char = "hi";
    return (*text).to_type(int);
}

// exported_letter：经本模块另一源文件的编译期过程读取导出的字符串指针常量。
@[comptime]
pub fn exported_letter() int {
    return $base.letter();
}

// head_of：跨模块接收字符串指针实参（直接字面量实参被拒绝，需用导出常量）。
@[comptime]
pub fn head_of(text *char) int {
    return (*text).to_type(int);
}

// level_mid：经本模块另一源文件读取延迟判别值的枚举成员。
@[comptime]
pub fn level_mid() int {
    return $base.mid_ct();
}

// probe_simple：转发编译期函数，验证 CT 正文里的枚举成员引用可跨模块传递。
@[comptime]
pub fn probe_simple() int {
    return $base.simple_ct();
}

// probe_low：同上，成员判别值是编译期调用（延迟回填路径）。
@[comptime]
pub fn probe_low() int {
    return $base.low_ct();
}

// probe_top：转发模块内「顶层聚合实参」常量的编译期读取。
@[comptime]
pub fn probe_top() int {
    return $base.top_ct();
}

// TEXT_PTR：以字符串字面量初始化的导出指针常量（接口原样重放，导入方重新登记字节池），
// 供导入方作跨模块编译期实参。
pub const TEXT_PTR *char = "AB";

// TEXT_ALIAS_BASE：同模块裸名引用的目标（私有，不导出）。
const TEXT_ALIAS_BASE *char = "hi";

// TEXT_ALIAS：引用式写法 —— 接口导出时追到最终字面式重放给消费者。
pub const TEXT_ALIAS *char = TEXT_ALIAS_BASE;

// alias_head：正文里引用「引用式」指针常量（.s.ct 闭包按同一追链函数重放字面式）。
@[comptime]
pub fn alias_head() int {
    return (*TEXT_ALIAS).to_type(int);
}

// CHAIN_1..3：三级引用链（接口与 .s.ct 的追链是否够深）。
const CHAIN_1 *char = "hi";
const CHAIN_2 *char = CHAIN_1;
pub const CHAIN_3 *char = CHAIN_2;

// PRIV_TBL：模块模式下的**私有** const 聚合常量（不导出，接口无需支持聚合）。
const PRIV_TBL [3]int = [1, 2, 3];

// priv_tbl_sum：运行期读同模块的私有聚合常量。
// 编译期读还不支持：全局聚合常量的值在编译期不可得（数据在发射阶段才写出），
// 与 `.s.ct` 能否重放源文本无关 —— 见 todo。
pub fn priv_tbl_sum() int {
    return PRIV_TBL[0] + PRIV_TBL[1] + PRIV_TBL[2];
}
