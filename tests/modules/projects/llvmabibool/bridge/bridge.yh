module bridge;

// c_bool：声明跨模块可见的 C _Bool 标量入口。
@[extern]
pub fn c_bool(value bool) bool;

// c_check_yh：请求 C 侧反向调用本模块导出的 bool ABI 函数。
@[extern]
fn c_check_yh() int;

// yh_bool：导出 C _Bool 函数，接收参数后返回给 C 调用方。
@[extern]
pub fn yh_bool(value bool) bool { return value; }

// yh_bool_noncanonical：YH 字节 2 表示真，返回 C 前必须按非零值归一。
@[extern]
pub fn yh_bool_noncanonical() bool { return 2.to_type(bool); }

// check：验证 YH→C 的参数归一、C→YH 参数/结果及 C ABI 跨模块声明。
pub fn check() int {
    if (c_bool(2.to_type(bool)) != true || c_bool(false) != false) { return 1; }
    return c_check_yh();
}
