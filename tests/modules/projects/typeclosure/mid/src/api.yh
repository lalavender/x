module api;

import base.file_types as base_types;

// Holder 在公开字段中保存另一个项目定义的类型。
pub struct Holder {
    file base_types.File;
}

// make 转发基础项目的 File，公开返回类型必须保留跨项目类型身份。
pub fn make() base_types.File {
    return base_types.make();
}

// wrap 把外部类型放入本模块公开的 Holder。
pub fn wrap(file base_types.File) Holder {
    let holder Holder;
    holder.file = file;
    return holder;
}

// file_code 使用公开参数类型，供消费模块验证接口中的跨项目签名。
pub fn file_code(file base_types.File) int {
    return file.code;
}

// type_closure_probe 供消费模块导入接口时执行，接口仍包含上方外部类型签名。
pub fn type_closure_probe() int {
    return 23;
}
