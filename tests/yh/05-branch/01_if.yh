// 覆盖规则：ifStmt。
// 条件不加括号；可无 else；空块与单语句块均合法。

fn simple(flag bool) void {
    if (flag) {
    }
    if (flag) {
        let a int = 1
    }
}

fn comparisons(x int) int {
    if (x < 3) {
        return 1
    }
    if (x >= 3 && x != 10) {
        return 2
    }
    return 0
}

fn without_else(flag bool, other bool) int {
    if (flag) {
        return 1
    }
    if (other) {
        return 2
    }
    return 0
}
