// 覆盖规则：structInit、structInitBody、ifStmt。
// 歧义消解：structInitBody 强制非空，因此 `if flag {}` 是「条件 + 块」，
// 不会被误判成结构体字面量 `flag{}`；条件里用位置式字面量必须加括号。

pub struct Point {
    x int
    y int
}

fn disambiguate(flag bool) int {
    if (flag) {
        return 1
    }
    for flag {
        break
    }
    let p Point = Point{ 1, 2 }
    if ((Point{ 1, 2 }.x == 1)) {
        return 2
    }
    return 0
}

fn condition_is_identifier(name bool) int {
    if (name) {
        return 1
    } else {
        return 0
    }
}
