// 覆盖规则：ifStmt。
// `if` 条件必须带括号；`else if` 链与嵌套 if 同样带括号。

fn parens(value int) int {
    if (value > 10) {
        return 3
    } else if (value > 5) {
        return 2
    } else if (value > 0) {
        return 1
    } else {
        return 0
    }
}

fn nested(flag bool, other bool) int {
    if (flag) {
        if (other) {
            return 1
        } else {
            return 2
        }
    } else {
        return 3
    }
}

fn complex_condition(a int, b int, flag bool) int {
    if (a > 0 && b > 0 && flag) {
        return 1
    }
    if (!flag || a != b) {
        return 2
    }
    return 0
}
