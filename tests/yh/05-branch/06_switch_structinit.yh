// 覆盖规则：switchStmt、switchCase、structInit。
// `switch` 的开关表达式与 `case` 的值都可以是结构体字面量：
// 开关体的 `{` 与字面量的 `{}` 在词法上可区分——case/default 是保留字，
// 字面量体内不可能出现它们，因此两种解析只有一种可行。

struct S {
    x int;
    y int;
}

fn switch_on_literal() int {
    switch S{1, 2} {
        case S{1, 2} {
            return 1;
        }
        case S{2, 1} {
            return 2;
        }
        default {
            return 0;
        }
    }
}

fn switch_on_field(v S) int {
    switch v.x {
        case 1, 2 {
            return 1;
        }
        default {
            return 0;
        }
    }
}
