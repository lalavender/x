// 覆盖规则：ifStmt。
// 'else' 后可接 ifStmt（链式 else-if）或 block（收尾）。

fn chain(value int) int {
    if (value > 10) {
        return 3;
    } else if (value > 5) {
        return 2;
    } else if (value > 0) {
        return 1;
    } else {
        return 0;
    }
}

fn without_final_else(flag bool) int {
    if (flag) {
        return 1;
    } else if (!flag) {
        return 2;
    }
    return 0;
}

fn nested_in_else(flag bool, other bool) int {
    if (flag) {
        if (other) {
            return 1;
        } else {
            return 2;
        }
    } else {
        return 3;
    }
}
