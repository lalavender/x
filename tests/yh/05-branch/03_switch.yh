// 覆盖规则：switchStmt、switchCase。
// 单值 case、多值 case、default、空 switch、case 块内任意语句。

fn classify(value int) int {
    switch value {
        case 0 {
            return 0
        }
        case 1, 2, 3 {
            return 1
        }
        case 4, 5 {
            return 2
        }
        default {
            return 3
        }
    }
}

fn empty_switch(value int) void {
    switch value {
    }
}

fn switch_without_default(value int) int {
    let r int = 0
    switch value {
        case 1 {
            r = 1
        }
        case 2, 3 {
            r = 2
            r += 1
        }
    }
    return r
}
