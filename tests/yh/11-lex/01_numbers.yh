// 覆盖规则：NUMBER。
// 十六进制、二进制、八进制、十进制整数；下划线分隔；浮点与指数形式。

fn numbers() void {
    let dec int = 42;
    let hex int = 0xFF;
    let hex_upper int = 0XFF;
    let hex_under int = 0xDEAD_BEEF;
    let hex_e int = 0x1E;          // 含 E 的十六进制（E 是数字，不是指数）
    let hex_e2 int = 0xE0;
    let hex_e3 u64 = 0xAA0103E0;
    let hex_e4 int = 0x0e5;
    let bin int = 0b1010;
    let bin_under int = 0b1010_1010;
    let oct int = 0o17;
    let oct_under int = 0o7_5_5;
    let big int = 1_000_000;
    let f1 f64 = 3.14;
    let f2 f64 = 1e9;
    let f3 f64 = 1E9;
    let f4 f64 = 1e+9;
    let f5 f64 = 1e-9;
    let f6 f64 = 2.5e3;
    let f7 f64 = 0.5;
    let f8 f64 = 1_000.5;
}
