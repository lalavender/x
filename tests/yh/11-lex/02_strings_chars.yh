// 覆盖规则：STRING、CHAR。
// 双引号字符串与单引号字符；转义序列；空串；字符串内含注释符号（验证词法不被误切）。

fn strings() void {
    let empty *char = "";
    let plain *char = "hello";
    let escapes *char = "tab\tnewline\nquote\"backslash\\";
    let slashes *char = "a // b /* c */ d";
    let mixed *char = "中文与 ASCII 混排";
    let braces *char = "braces { } and ( ) and [ ]";
}

fn chars() void {
    let a char = 'a';
    let newline char = '\n';
    let tab char = '\t';
    let quote char = '\'';
    let backslash char = '\\';
    let zero char = '\0';
    let space char = ' ';
}
