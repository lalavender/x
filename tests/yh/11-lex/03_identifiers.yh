// 覆盖规则：IDENT。
// 下划线开头、单独下划线、数字结尾、下划线夹杂、与关键字近似的名字、全大写。

fn identifiers() void {
    let _x int = 1;
    let _ int = 2;
    let __ int = 3;
    let a1 int = 4;
    let abc_123 int = 5;
    let _snake_case_ int = 6;
    let ifx int = 7;
    let for_ int = 8;
    let lett int = 9;
    let fnn int = 10;
    let tru int = 11;
    let A_B_C int = 12;
    let INT int = 13;
}

fn identifiers_as_params(let_value int, _hidden int) int {
    return let_value + _hidden;
}
