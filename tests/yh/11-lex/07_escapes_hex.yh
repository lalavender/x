// 覆盖规则：STRING、CHAR。
// 转义集合收敛后的补全集：\xNN 十六进制转义（串与字符均支持）、
// \a \b \f \v \r。未知转义（如 \q）词法报错，见 rejected/26。

fn escapes() void {
    let hex *char = "\x41";
    let hex_lower *char = "\x4a";
    let hex_last *char = "\xff";
    let hex_char char = '\x41';
    let alert char = '\a';
    let backspace char = '\b';
    let formfeed char = '\f';
    let vtab char = '\v';
    let cr char = '\r';
    let mixed *char = "A\x41\a";
}
