// 覆盖规则：COMMENT。
// 行注释、块注释、跨行块注释；出现在文件头、声明之间、语句位置、行尾与参数表内。

/* 文件头块注释 */
// 文件头行注释

// 声明之间的行注释
/* 声明之间的块注释 */

let top_level int = 1; // 顶层声明后的行尾注释

fn comments(value int) int {
    // 语句前注释
    let result int = value; // 行尾注释
    /* 语句间块注释 */
    result += 1;
    return result; /* 返回后注释 */
}

fn comments_in_params(/* 参数前 */ a int /* 参数后 */, b int) int {
    return a + b; /* 表达式后 */
}

fn comments_in_args() int {
    return comments_in_params(/* 实参前 */ 1 /* 实参后 */, 2);
}

// 多行块注释
/*
 * 第一行
 * 第二行
 */
fn trailing() int {
    return 0;
}
