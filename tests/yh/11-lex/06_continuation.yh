// 覆盖规则：exprList、additiveExpr、callArgs。
// 表达式可以跨行：行尾是运算符、`,`、`(` 时续行，`;` 才是语句终点。

fn continuation(a int, b int) int {
    let x int = 1 +
        2

    let y int = a +
        b

    let z int = a *
        b

    return x + y + z
}

fn multiline_call(a int, b int) int {
    return sum_of(
        a,
        b
    )
}

fn sum_of(a int, b int) int {
    return a + b
}
