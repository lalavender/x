// 覆盖规则：NL、WS。
// 空行、行首缩进（空格与制表符）、行尾空白、运算符后续行、实参表跨行、多行块。

fn whitespace(a int, b int) int {
    let x int = 1 + 2

    let y int = 1 +
        2

    let z int = a +
        b

    let w int = a *
        b

    return x + y + z + w
}

fn multiline_args(a int, b int, c int) int {
    return a + b + c
}

fn call_multiline() int {
    let r int = multiline_args(
        1,
        2,
        3
    )
    return r
}

fn multiline_condition(a int, b int) int {
    if (a > 0 &&
        b > 0) {
        return 1
    }
    return 0
}

fn multiline_block(flag bool) int {
    let n int = 0
    if (flag)
    {
        n = 1
    }
    return n
}
