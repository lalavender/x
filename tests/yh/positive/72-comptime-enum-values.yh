// 覆盖规则：pubEnumDecl、enumMember、fnDecl、fnSignature、typeRef、builtinType、block、stmt、comptimeForStmt、expr、postfixExpr。
// 枚举 values 只接受具名枚举类型，成员访问限定为 name 和 value。
pub enum Mode {
    fast;
    safe = 5;
}

fn main() int {
    $for item in Mode.values {
        printf("%s=%d\n", item.name, item.value);
    }
    return 0;
}
