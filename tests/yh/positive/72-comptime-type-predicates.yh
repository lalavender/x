// 覆盖规则：expr、comptimeCall。
// `$is_type(x, T)`（第二实参是类型引用）与 `$is_int(x)`/`$is_float(x)`
// 快捷谓词的语法形态；结果都是编译期布尔常量。
fn f(v f64) bool {
    let a bool = $is_int(3)
    let b bool = $is_float(v)
    return $is_type(v, f64) && a && b
}

const K bool = $is_type(1, int)

fn main() int {
    return f(0.5).to_type(int) + K.to_type(int)
}