// 覆盖规则：expr、comptimeIfExpr。
// `$if (cond) e1 $else e2` 编译期表达式选择（链最上层，`$else` 必须书写）：
// 覆盖 let 初始化、return、实参位置与顶层 const 折叠形态。
fn choose(x int) int {
    let a int = $if (1 < 2) 10 $else 20
    return $if (x > 0) a $else 0
}

const K int = $if (true) 1 $else 2

fn main() int {
    return choose($if (2 > 1) 1 $else 0)
}