// 覆盖规则：typeDecl、fnType、typeRef、typeRefList、attributedDecl、attributeGroup、attributeName、attributedFnDecl、fnSignature、fnDecl、paramList、param、builtinType。
// C 函数类型前缀与顶层声明属性分别在各自语法位置解析。
type Callback = @[extern] fn(int) int;
@[extern]
fn pick() @[extern] fn(int) int;
fn main() int { let cb Callback = pick(); return cb(1); }
