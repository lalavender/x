// 覆盖规则：comptimeForStmt、expr、block。
// `$for f in T.fields` 字段元信息源（与 `$for v in E.values` 同形，
// 语法层共用 IDENT '.' IDENT 形态；分派在解析期按固定名完成）。
pub struct Mixed {
    a int;
    b f64;
}

pub enum Palette {
    red;
    green;
}

fn count() int {
    let n int = 0;
    $for f in Mixed.fields {
        let name *char = f.name;
        n += 1;
    }
    $for v in Palette.values {
        n += v.value;
    }
    return n;
}

fn main() int {
    return count();
}