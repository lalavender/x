// 覆盖规则：fnDecl、fnSignature、typeRef、builtinType、block、stmt、comptimeIfStmt、letDecl、returnStmt、expr。
// `$if` 条件里的目标标记名：linux / darwin / windows / arm64 / x64。
// 标记名不是词法关键字（见 compiler/comptime/ct_target.yh），只在 `$if` 条件位置
// 解析为不可遮蔽的布尔常量；本用例只要求语法形态被接受（语义与取值由
// tests/yh-run/run/207-target-marker-exclusive.yh 覆盖）。
fn marker() int {
    let n int = 0
    $if (linux) { n += 1 }
    $if (darwin) { n += 1 }
    $if (windows) { n += 1 }
    $if (arm64) { n += 1 }
    $if (x64) { n += 1 }
    return n
}

fn main() int {
    return marker()
}
