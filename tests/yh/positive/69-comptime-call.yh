// 覆盖规则：attributeGroup、attributeName、attributedDecl、attributedFnDecl、fnSignature、paramList、param、typeRef、builtinType、block、stmt、returnStmt、expr、additiveExpr、multiplicativeExpr、unaryExpr、postfixExpr、primaryExpr、comptimeCall、callArgs、exprList、constDecl、fnDecl。
@[comptime] fn combine(a int, b int) int {
    return a * 2 + b;
}

const RESULT int = $combine(19, 4);

fn main() int {
    return RESULT - 42;
}
