// 覆盖规则：fnDecl、fnSignature、typeRef、builtinType、block、stmt、comptimeIfStmt、comptimeForStmt、letDecl、returnStmt、expr。
fn choose() int {
    $if (true) {
        $for i in (0..2) {
            let copy int = i
            copy
        }
    } $else {
        return 1
    }
    return 0
}

fn main() int {
    return choose()
}
