// 覆盖规则：param、fnDecl、lenExpr。
// param 的类型化变参分支「名字 ... 类型」：函数体内该参数是 []T，
// 可用 len() 取长度、下标取元素、for 遍历。

fn sum(nums ... int) int {
    let total int = 0;
    for v in nums {
        total = total + v;
    }
    return total;
}

fn count(nums ... f64) int {
    return len(nums);
}

fn first_of(nums ... *char) *char {
    return nums[0];
}

fn mixed(first int, rest ... int) int {
    return first + len(rest);
}
