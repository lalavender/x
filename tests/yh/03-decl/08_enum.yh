// 覆盖规则：enumDecl、enumItem。
// 成员可带显式值（常量表达式）或不带；支持空枚举。

pub enum Color {
    red;
    green;
    blue;
}

pub enum HttpStatus {
    ok = 200;
    not_found = 404;
    server_error = 500;
}

pub enum Flags {
    none = 0;
    a = 1 << 0;
    b = 1 << 1;
    c = 1 << 2;
    ab = 3;
}

pub enum Empty {
}

fn use_enum(c Color, s HttpStatus) int {
    return s;
}
