// 覆盖规则：structDecl、unionDecl、fieldDecl。
// 字段按「名字 类型」逐行书写；覆盖空体、指针/数组字段、嵌套具名类型、可选分号。

pub struct Empty {
}

pub struct Point {
    x int;
    y int;
}

pub struct Node {
    next *Node;
    data int;
}

pub struct Mixed {
    a int; b f64;
    c [4]u8;
    d Point;
    e *Point;
}

pub union Value {
    i int;
    f f32;
    p *void;
}

pub union EmptyUnion {
}
