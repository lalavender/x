// 覆盖规则：topLevelDecl、testDecl、testName、plainDeclBody、fnDecl、fnSignature、paramList、param、typeRef、builtinType、structDecl、fieldDecl、memberName、structInit、structInitBody、structInitField、block、letDecl、binding、exprStmt、postfixExpr、postfixPart、comptimeCall、callArgs、exprList、expr、primaryExpr、literal、returnStmt、additiveExpr、equalityExpr。
// YT0：字符串行为测试、标识符文档测试、空块、中文名称与成员名 test 均合法。

struct Holder {
    test int
}

fn add(a int, b int) int {
    return a + b
}

test "中文名称与成员名" {
    let h Holder
    h = Holder{ test: 3 }
    h.test = add(1, 2)
    $assert(h.test == 3)
}

test "空块" {}

test add {
    $assert(add(41, 1) == 42, "加法结果应为 42")
}
