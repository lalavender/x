// 覆盖规则：typeDecl。
// 类型别名可指向指针、函数类型、定长数组、切片、具名类型与指针的指针。

struct Point {
    x int;
    y int;
}

type Handle = *void;
type Callback = fn(int, int) int;
type Buffer = [64]u8;
type Bytes = []u8;
type PointAlias = Point;
type Chain = *Callback;
type Matrix = [3][3]f64;

fn use_aliases(p Point, cb Callback) int {
    let h Handle = 0;
    let b Buffer;
    let s Bytes;
    return cb(p.x, p.y);
}
