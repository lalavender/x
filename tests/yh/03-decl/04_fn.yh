fn demo() void {
}

fn add(a int, b int) int {
    return a + b
}

fn no_return_type(a int) {
}

fn one_param(a int) int {
    return a
}

fn many_params(a int, b f64, c bool, d *void, e [4]u8) int {
    return a
}

fn pointer_params(p *int, q **void) void {
}

pub fn exported(x int) int {
    return x
}
