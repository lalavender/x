// 模块私有类型（2026-10-12，ADR-0013）：struct/union/enum 的 pub 可选。
// 不带 pub 的类型只在本模块可见、不进接口文件；这里验证语法与模块内使用。

struct Point {
    x int
    y int
}

union Raw {
    i int
    f f32
}

enum Kind {
    none
    file
}

fn main() int {
    let p Point
    p.x = 1
    p.y = 2
    let r Raw
    r.i = 3
    if (sizeof(Point) != 8) { return 1 }
    // Kind.file 判别值为 1
    return p.x + p.y + r.i + Kind.file - 7
}
