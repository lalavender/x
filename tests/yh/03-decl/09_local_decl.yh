// 覆盖规则：stmt、letDecl、constDecl。
// 局部作用域内的变量与常量声明，可与其它语句混排。

fn locals(param int) int {
    let a int = 1;
    const K int = 2;
    let b int = a + K;
    {
        let inner int = 3;
        const INNER_K int = 4;
        b = b + inner + INNER_K;
    }
    let c int;
    c = b + param;
    return c;
}

fn shadowing() int {
    let value int = 1;
    {
        let value int = 2;
    }
    return value;
}
