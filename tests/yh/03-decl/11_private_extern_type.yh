// 私有 + @[extern]：C 布局的模块私有类型。
// 属性对 struct/union/enum 已放行（inline/noreturn 除外），pub 与属性可自由组合。

@[extern] struct Header {
    magic u32
    len u32
}

@[extern] enum Kind {
    none
    file
}

fn main() int {
    let h Header
    h.magic = 1
    h.len = 2
    if (sizeof(Header) != 8) { return 1 }
    return h.magic + h.len + Kind.file - 4
}
