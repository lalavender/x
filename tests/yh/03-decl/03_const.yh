// 覆盖规则：constDecl。
// const 必须带初值，且类型必须显式写出；初值可为常量表达式。顶层与局部均可声明。

const PI f64 = 3.14159
const MAX_ITEMS int = 1 << 4
const FLAG bool = true
const MASK int = 0xFF
const GREETING *char = "hello"
const OFFSET i64 = MAX_ITEMS * 2

fn use_consts() int {
    const LOCAL_K int = 8
    const LOCAL_TYPED int = 9
    return MAX_ITEMS + MASK + LOCAL_K + LOCAL_TYPED
}
