// 覆盖规则：removedKeyword。
// removedKeyword 无产生式，正文绝不出现保留字；此处演示对应的替代写法。
//   while         → for
//   do ... while  → for
//   short / long  → i16 / i64
//   unsigned char → u8
//   typedef       → type
//   extern/static → pub / 默认文件内可见

fn loop_alternative(flag bool) int {
    let count int = 0
    for flag {
        count += 1
        break
    }
    return count
}

fn type_alternatives() void {
    let small i16 = 1
    let big i64 = 2
    let byte u8 = 255
    let plain int = 3
}

type Handle = *void

pub fn exported(x int) int {
    return x
}
