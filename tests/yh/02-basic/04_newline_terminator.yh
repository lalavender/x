// 覆盖规则：letDecl、returnStmt、block、switchStmt、structDecl、enumDecl。
// 行尾分号可省略；`()`/`[]` 内自由换行；`}` 前与文件尾可省略分号；
// 括号外续行必须把运算符放在上一行末尾。模块头见 tests/modules/accept。

let seed int = 7

struct Point {
    x int
    y int
}

enum Color {
    Red
    Green = 4
}

@[noreturn]
fn die(code int) void {
    exit(code)
}

fn add(a int, b int) int {
    let total int = a +
        b
    return total
}

fn pick(p Point) int {
    if (p.x > 0) {
        return p.x
    } else {
        return p.y
    }
}

fn sum_to(n int) int {
    let sum int = 0
    let i int = 0
    for i < n &&
        i < 10 {
        sum += i
        i += 1
    }
    return sum
}

fn classify(n int) int {
    switch n {
        case 0 {
            return 10
        }
        case 1, 2 {
            return 20
        }
        default {
            return 30
        }
    }
}

fn call_multi() int {
    return add(1,
        2)
}
