// 覆盖规则：typeRef。
// typeRef 的 IDENT 分支（具名类型）与数组长度中的表达式。

pub struct Point {
    x int
    y int
}

type Handle = *void

const N int = 4

fn named(p Point, h Handle) void {
    let a Point = p
    let b *Point = &p
    let c [2]Point
    let d []Handle
    let e **Point
}

fn length_exprs() void {
    let a [N]int
    let b [N * 2]int
    let c [N + 1]int
    let d [sizeof(int)]u8
    let e [2][N]int
}

fn named_in_fn_type(cb fn(Point, Handle) Point) void {
}
