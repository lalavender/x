// 覆盖规则：typeRef。
// 指针（'*' 分支）、定长数组与切片（'[' expr? ']' 分支）的各类组合。

const N int = 8

fn pointers(p *int, q **void, r ***u8) void {
    let a *void = q
    let b **int = &p
    let c ***char = r
}

fn arrays() void {
    let a [4]u8
    let b [2][3]int
    let c [N]int
    let d [2][N]f64
}

fn slices() void {
    let s []char
    let t [][]int
    let u []*void
}

fn mixed(p *[4]int, q []*char, r *[]u8) void {
    let a *[8]f64
    let b []*[2]u16
    let c *[]*[]void
}
