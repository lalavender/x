// 覆盖规则：fnType、typeRefList、typeRef。
// 函数类型：无参、多参、省略返回类型、作为参数与返回值、可嵌套。

type Callback = fn(int, int) int
type Producer = fn() int
type Consumer = fn(int) void
type Bare = fn()
type Nested = fn(fn(int) int) fn(int) int

fn apply(cb Callback, a int, b int) int {
    return cb(a, b)
}

fn higher_order(f fn(int) int, x int) int {
    return f(x)
}

fn returns_fn() fn(int) int {
    return 0
}

fn param_fn_type(cb fn(int, int) int) void {
}

fn fn_ptr_param(p *fn(int) int) void {
}

fn slice_of_fn(cbs []fn(int) int) int {
    return len(cbs)
}
