// 覆盖规则：builtinType。
// 14 种内建类型各出现一次：int、i8、i16、i32、i64、u8、u16、u32、u64、f32、f64、bool、char、void。

fn builtins() void {
    let a int = 0;
    let b i8 = 0;
    let c i16 = 0;
    let d i32 = 0;
    let e i64 = 0;
    let f u8 = 0;
    let g u16 = 0;
    let h u32 = 0;
    let i u64 = 0;
    let j f32 = 0.0;
    let k f64 = 0.0;
    let l bool = true;
    let m char = 'x';
    let n void;
}

fn returns_void() void {
}

fn takes_void_ptr(p *void) void {
}

fn takes_void_ptr_ptr(p **void) void {
}
