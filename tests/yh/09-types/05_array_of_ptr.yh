// 覆盖规则：typeRef。
// 定长数组套指针与切片：[4]*u8、[N]*char、[2]**int、[4][]int。
// 「长度表达式之后的 *」归元素类型而不是乘法：长度表达式必须先闭合，
// 这是手写 parser 最容易出错的一处边界（长度是变量、元素是指针时尤甚）。

const N int = 4;

fn arrays_of_pointers() void {
    let a [4]*u8;
    let b [N]*char;
    let c [2]**int;
}

fn arrays_of_slices() void {
    let a [4][]int;
    let b [N][]*char;
}

fn length_expr_then_pointer(n int) void {
    let a [n * 2]*int;
    let b [2 * n]**void;
}
