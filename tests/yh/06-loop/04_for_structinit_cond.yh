// 覆盖规则：forStmt、structInit、structInitBody。
// 条件位置的结构体字面量：structInitBody 强制非空，因此 `for S{1} { }` 的
// 第一个 `{…}` 归字面量、第二个 `{…}` 是循环体，两种解析只有一种可行；
// 为可读性，条件里写字面量建议加括号：`for (S{1}) { }`。

pub struct S {
    x int;
}

fn literal_condition() int {
    let hits int = 0;
    for S{1} {
        hits += 1;
        break;
    }
    for (S{ x: 1 }) {
        hits += 1;
        break;
    }
    return hits;
}
