// 覆盖规则：forStmt、forInParts。
// forInParts 不带 '..' 的两种形态：仅元素遍历、下标 + 元素遍历。

fn iterate(values [4]int) int {
    let total int = 0;
    for v in values {
        total = total + v;
    }
    for i, v in values {
        total = total + i * v;
    }
    return total;
}

fn nested(rows [2][3]int) int {
    let total int = 0;
    for row in rows {
        for cell in row {
            total = total + cell;
        }
    }
    return total;
}

fn over_slice(items []char) int {
    let n int = 0;
    for i, c in items {
        n = n + i;
    }
    return n;
}
