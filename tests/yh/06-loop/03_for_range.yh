// 覆盖规则：forInParts、RANGE。
// '..' 区间（左闭右开，RANGE 词法规则）；两端均可是任意表达式。

fn ranges(n int) int {
    let total int = 0;
    for i in 0..n {
        total = total + i;
    }
    for i in 1..n + 1 {
        total = total + i;
    }
    for i in 0..4 {
        for j in i..4 {
            total = total + j;
        }
    }
    return total;
}

fn with_variables(a int, b int) int {
    let total int = 0;
    for i in a..b {
        total = total + i;
    }
    for i in a * 2..b * 2 {
        total = total + i;
    }
    return total;
}

fn with_index_and_range(n int) int {
    let total int = 0;
    for i, v in 0..n {
        total = total + i;
    }
    return total;
}
