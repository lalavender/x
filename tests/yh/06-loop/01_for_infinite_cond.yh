// 覆盖规则：forStmt。
// forStmt 的无条件分支（无限循环）与条件表达式分支（原 while 的形态）。

fn infinite() void {
    for {
        break
    }
}

fn conditional(limit int) int {
    let i int = 0
    for i < limit {
        i += 1
    }
    for i != 0 {
        i -= 1
    }
    return i
}

fn nested(flag bool) void {
    for {
        for flag {
            break
        }
        break
    }
}

fn conditional_with_call(limit int) int {
    let i int = 0
    for i < limit && i != 3 {
        i += 1
    }
    return i
}
