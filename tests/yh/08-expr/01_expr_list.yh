// 覆盖规则：exprList、callArgs、postfixPart。
// 空实参、单实参、多实参、嵌套调用；exprList 用于实参表与表达式语句。

fn zero() int {
    return 0;
}

fn one(a int) int {
    return a;
}

fn three(a int, b int, c int) int {
    return a + b + c;
}

fn nested_calls() int {
    let r int = zero();
    r = one(1);
    r = three(1, 2, 3);
    r = three(one(1), zero(), three(1, 2, 3));
    return r;
}

fn multi_target() void {
    let a int = 0;
    let b int = 0;
    a, b = 1, 2;
    a, b = b, a;
}
