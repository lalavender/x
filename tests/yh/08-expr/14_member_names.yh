// 覆盖规则：memberName、fieldDecl、structInitField、postfixPart。
// 成员位置放开保留字（对齐 JavaScript 属性名规则）：字段名、字面量字段名、
// `.` 之后的访问名都可以是保留字；标识符位置（let / const / fn / enum 成员 /
// 标签）仍然严格。动机：union 标签域与 JSON/C 交互的高频字段名。

struct Packet {
    type int;
    len u64;
    default bool;
}

fn read(p *Packet) int {
    if (p.type == 1 && p.len > 0) {
        return p.type;
    }
    return 0;
}

fn make() Packet {
    return Packet{ type: 1, len: 8, default: false };
}

fn chained() u64 {
    return make().len;
}
