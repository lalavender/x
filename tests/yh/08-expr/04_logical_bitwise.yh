// 覆盖规则：logicalOrExpr、logicalAndExpr、bitOrExpr、bitXorExpr、bitAndExpr。
// 逻辑层与位运算层各自的分层与混合。

fn logical_or(a bool, b bool, c bool) bool {
    return a || b || c
}

fn logical_and(a bool, b bool, c bool) bool {
    return a && b && c
}

fn logical_mixed(a bool, b bool, c bool) bool {
    return a && b || c
}

fn bit_or(a int, b int, c int) int {
    return a | b | c
}

fn bit_xor(a int, b int) int {
    return a ^ b
}

fn bit_and(a int, b int, c int) int {
    return a & b & c
}

fn bit_mixed(a int, b int, c int, d int) int {
    return a | b ^ c & d
}
