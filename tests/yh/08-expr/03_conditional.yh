// 覆盖规则：conditionalExpr。
// 三元条件；右结合嵌套；可作实参、返回值与更大表达式的一部分。

fn choose(flag bool, a int, b int) int {
    return flag ? a : b;
}

fn nested(flag1 bool, flag2 bool, a int, b int, c int) int {
    return flag1 ? a : flag2 ? b : c;
}

fn as_argument(flag bool) int {
    return choose(flag ? true : false, 1, 2);
}

fn in_expression(flag bool, a int, b int, c int) int {
    let r int = (flag ? a : b) + c;
    return r;
}

fn in_statement(flag bool, a int, b int) void {
    let r int = 0;
    r = flag ? a : b;
}
