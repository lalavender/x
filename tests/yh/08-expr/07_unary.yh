// 覆盖规则：unaryExpr。
// 六种一元运算符（负、正、逻辑非、位取反、解引用、取地址）；可嵌套；
// 一元与二元同符出现在不同层级。

fn unary(x int, p *int, flag bool) void {
    let a int = -x
    let b int = +x
    let c bool = !flag
    let d int = ~x
    let e int = *p
    let f *int = &x
    let g int = - -x
    let h int = *&x
    let i int = ~~x
}

fn unary_vs_binary(a int, b int, p *int) int {
    let r int = a * b
    r = a - -b
    r = a + *p
    r = a & b
    r = a & *p
    return r
}
