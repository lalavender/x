// 覆盖规则：postfixExpr、postfixPart。
// 调用、下标、成员访问的链式组合；指针用 '.' 自动解引用（无箭头运算符）。

pub struct Inner {
    value int
}

pub struct Outer {
    inner Inner
    items [4]int
}

fn make() Outer {
    return Outer{ inner: Inner{ value: 1 }, items: 0 }
}

fn chains(o Outer, p *Outer) int {
    let a int = o.inner.value
    let b int = p.inner.value
    let c int = o.items[0]
    let d int = make().inner.value
    let e int = p.items[1]
    let f int = make().items[2]
    return a + b + c + d + e + f
}

fn nested_index(a [2][3]int) int {
    return a[0][1]
}
