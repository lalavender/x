// 覆盖规则：exprStmt、structInit。
// 语法层放行、语义层需拦截的形态在此钉住，避免被误当语法错误：
// 裸结构体字面量语句、赋值目标为任意表达式（比较结果、调用结果）。
// 这些都能通过语法检查；合法性由后续语义阶段判定。
// 注：v0.1 的 exprStmt 是单目标赋值，元组赋值的拒绝见 rejected/24。

pub struct Point {
    x int;
    y int;
}

fn zero() int {
    return 0;
}

fn permissive_stmts() void {
    let a int = 0;
    let b int = 0;
    Point{1, 2};
    a == b = zero();
    zero() = 1;
}
