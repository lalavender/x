// 覆盖规则：postfixExpr、postfixPart、unaryExpr、typeRef。
// to_type 是后缀操作：支持链式转换、转换后取下标/成员，以及一元负号的显式括号。

struct Header {
    magic int;
}

fn converted_array(a [4]int) int {
    let first int = a.to_type([]int)[0];
    return first.to_type(i64).to_type(int);
}

fn converted_pointer(p *u8) int {
    return p.to_type(*Header).magic;
}

fn converted_negative(x int) int {
    return (-x).to_type(i64).to_type(int);
}
