// 覆盖规则：equalityExpr、relationalExpr、shiftExpr、additiveExpr、multiplicativeExpr。
// 相等、比较、移位、加减、乘除模各自的分层与混合。

fn equality(a int, b int, c int) bool {
    return a == b != c
}

fn relational(a int, b int, c int) bool {
    return a < b >= c
}

fn relational_chain(a int, b int, c int, d int) bool {
    return a < b && b <= c && c > d && d >= a
}

fn shifts(a int, b int) int {
    return a << 2 >> 1
}

fn shift_and_add(a int, b int) int {
    return a << 1 + b
}

fn additive(a int, b int, c int) int {
    return a + b - c
}

fn multiplicative(a int, b int, c int) int {
    return a * b / c % 2
}

fn mixed(a int, b int) int {
    return a + b * 2 - a / 2
}
