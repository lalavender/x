// 覆盖规则：structInit、structInitBody、structInitField。
// 结构体字面量可作初值；命名式与位置式均可。

struct Point {
    x int;
    y int;
}

fn as_initializer() void {
    let a Point = Point{ x: 1, y: 2 };
    let b Point = Point{ 1, 2 };
    let c Point = Point{ x: 1, y: 2, };
}

fn as_return_value() Point {
    return Point{ 0, 0 };
}

fn in_argument(p Point) int {
    return p.x;
}

fn pass_literal() int {
    return in_argument(Point{ x: 1, y: 2 });
}
