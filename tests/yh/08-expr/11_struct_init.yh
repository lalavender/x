// 覆盖规则：structInit、structInitBody、structInitField。
// 命名式与位置式；尾逗号；嵌套；structInitBody 强制非空。

struct Point {
    x int;
    y int;
}

struct Outer {
    origin Point;
    label *char;
    count int;
}

fn named() Point {
    return Point{ x: 1, y: 2 };
}

fn positional() Point {
    return Point{ 1, 2 };
}

fn trailing_comma() Point {
    return Point{ x: 1, y: 2, };
}

fn nested() Outer {
    return Outer{ origin: Point{ 1, 2 }, label: "o", count: 3 };
}

fn nested_positional() Outer {
    return Outer{ Point{ 0, 0 }, "o", 0 };
}

fn as_argument(p Point) int {
    return p.x;
}

fn in_argument() int {
    return as_argument(Point{ x: 1, y: 2 });
}
