// 覆盖规则：expr、conditionalExpr、logicalOrExpr、logicalAndExpr、bitOrExpr、bitXorExpr、bitAndExpr、equalityExpr、relationalExpr、shiftExpr、additiveExpr、multiplicativeExpr、unaryExpr、postfixPart。
// 一条表达式自低到高贯穿整个优先级链。

fn chain(a int, b int, c int, d int, e int, flag bool) int {
    let r int = 1 + 2 * 3 - 4 / 2 % 3;
    r = a << 1 + b;
    r = a < b == flag;
    r = a | b ^ c & d;
    r = flag && a < b || c > d;
    r = flag ? a : b;
    r = a + b * c - d / e;
    r = -a + *&b;
    r = a.to_type(i64) + b;
    return r;
}

fn full_chain(a int, b int, c int, d int, flag bool) int {
    return 1 + 2 * 3 << 1 < 4 == flag && a | b ^ c & d ? a : b;
}
