// 覆盖规则：sizeofExpr、lenExpr。
// sizeof 作用于类型；len 作用于数组/切片表达式（含类型化变参）。

pub struct Point {
    x int
    y int
}

fn sizes() void {
    let a int = sizeof(int)
    let b int = sizeof(*void)
    let c int = sizeof(Point)
    let d int = sizeof([4]u8)
    let e int = sizeof([]char)
    let f int = sizeof(fn(int, int) int)
    let g int = sizeof(**void)
}

fn lengths(arr [8]int, slice []int) int {
    return len(arr) + len(slice)
}

fn variadic_len(nums ... int) int {
    return len(nums)
}

fn len_in_expression(arr [8]int) int {
    return len(arr) * sizeof(int)
}
