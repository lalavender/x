// 覆盖规则：primaryExpr、literal。
// 括号表达式与各类字面量：整数、浮点、字符、字符串、布尔。

fn parens(a int, b int, c int) int {
    return (a + b) * c;
}

fn literals() void {
    let i int = 42;
    let h int = 0xFF;
    let b int = 0b1010;
    let o int = 0o17;
    let f f64 = 3.14;
    let e f64 = 1e9;
    let c char = 'a';
    let s *char = "hello";
    let t bool = true;
    let u bool = false;
}

fn nested_parens(a int, b int) int {
    return ((a) + ((b)));
}

fn identifier_as_primary(a int) int {
    return a;
}

fn literal_in_argument() int {
    return parens(1, 2, 3);
}
