// 覆盖规则：castExpr。
// as 转换；可链式；目标可为内建类型、指针、切片与具名类型。

struct Header {
    magic int;
}

type Handle = *void;

fn casts(x int, p *u8) void {
    let a i64 = x as i64;
    let b u8 = x as u8;
    let c f64 = x as f64;
    let d *void = p as *void;
    let e Handle = p as Handle;
    let f int = x as i64 as int;
    let g *Header = p as *Header;
    let h []u8 = p as []u8;
}

fn cast_in_expression(x int, y int) int {
    return (x as i64 + y as i64) as int;
}

fn cast_in_argument(x int) int {
    return cast_in_expression(x as int, x as i64 as int);
}
