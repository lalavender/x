// 覆盖规则：postfixPart、typeRef。
// to_type 转换；可链式；目标可为内建类型、指针、切片与具名类型。

struct Header {
    magic int;
}

type Handle = *void;

fn casts(x int, p *u8) void {
    let a i64 = x.to_type(i64);
    let b u8 = x.to_type(u8);
    let c f64 = x.to_type(f64);
    let d *void = p.to_type(*void);
    let e Handle = p.to_type(Handle);
    let f int = x.to_type(i64).to_type(int);
    let g *Header = p.to_type(*Header);
    let h []u8 = p.to_type([]u8);
}

fn cast_in_expression(x int, y int) int {
    return (x.to_type(i64) + y.to_type(i64)).to_type(int);
}

fn cast_in_argument(x int) int {
    return cast_in_expression(x.to_type(int), x.to_type(i64).to_type(int));
}
