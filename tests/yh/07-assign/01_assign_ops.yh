// 覆盖规则：assignOp。
// 11 种赋值运算符各出现一次：等号、加等、减等、乘等、除等、模等、与等、或等、异或等、左移等、右移等。

fn assign_ops() void {
    let a int = 0
    a = 1
    a += 1
    a -= 1
    a *= 2
    a /= 2
    a %= 3
    a &= 7
    a |= 8
    a ^= 1
    a <<= 2
    a >>= 1
}

fn assign_rhs_expressions(b int, c int) int {
    let a int = 0
    a = b + c
    a += b * c
    a <<= b - c
    return a
}
