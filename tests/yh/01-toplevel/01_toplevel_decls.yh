// 覆盖规则：sourceFile、topLevelDecl、plainDeclBody、letDecl、constDecl、typeDecl、fnDecl、fnSignature、paramList、param、structDecl、unionDecl、enumDecl。
// 顶层声明全景：let/const/fn/type + pub const/pub fn + pub struct/pub union/pub enum。
// 2026-10-02 起 let 不支持导出（无 pub let），类型必须带 pub。
let mod_var int = 3
pub const LIMIT int = 9
type Handle = *int

pub struct Value {
    n int
}

pub union Raw {
    as_int int
}

pub enum Shade {
    dark
    light
}

fn hidden() int {
    return mod_var
}

pub fn identity(v int) int {
    return v
}
