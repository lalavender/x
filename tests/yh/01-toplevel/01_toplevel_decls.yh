// 覆盖规则：sourceFile、topLevelDecl、topLevelDeclBody。
// 七类顶层声明（let、const、fn、type、struct、union、enum）混排，均不带 pub。

let global_counter int = 0;

const MAX_ITEMS int = 128;

type Handle = *void;

struct Point {
    x int;
    y int;
}

union Value {
    i int;
    f f32;
}

enum Color {
    red;
    green;
    blue;
}

fn helper(a int) int {
    return a + 1;
}
