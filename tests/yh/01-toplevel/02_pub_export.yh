// pub 导出的顶层声明（2026-10-02「let 不导出」后：const/fn/struct/union/enum 可导出）。
pub const exported_counter int = 1;

pub struct ExportedPoint {
    x int;
    y int;
}

pub union ExportedValue {
    as_int int;
}

pub enum ExportedColor {
    red;
    green;
}

pub fn exported_identity(v int) int {
    return v;
}
