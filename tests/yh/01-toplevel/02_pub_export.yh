// 覆盖规则：topLevelDecl、topLevelDeclBody。
// 七类顶层声明全部带 pub，命中 topLevelDecl 的 'pub'? 分支。

pub let exported_counter int = 1;

pub const EXPORTED_MAX int = 64;

pub type ExportedHandle = *void;

pub struct ExportedPoint {
    x int;
    y int;
}

pub union ExportedValue {
    i int;
    f f32;
}

pub enum ExportedColor {
    red;
    green;
}

pub fn exported_helper(a int) int {
    return a;
}
