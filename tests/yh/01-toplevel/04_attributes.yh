// 覆盖规则：topLevelDecl、attributeGroup、attributeName、attributedDecl、attributedFnDecl、fnSignature。
// 单组属性列表修饰紧随其后的函数或导出数据类型；extern 函数可用分号声明。

@[extern, noreturn]
fn c_fatal(code int) void;

@[inline, noreturn]
fn fatal(code int) void {
    c_fatal(code);
}

@[extern]
pub fn yh_add(a int, b int) int {
    return a + b;
}

@[extern]
pub struct CHandle {
}

@[extern]
pub enum CStatus {
    ready = 0;
    failed = 1;
}
