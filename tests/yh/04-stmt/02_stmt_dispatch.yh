// 覆盖规则：stmt。
// stmt 的各个分支各出现一次：block、letDecl、constDecl、ifStmt、forStmt、
// switchStmt、returnStmt、branchStmt、gotoStmt、labelStmt、exprStmt。
// 注：commentStmt 已随注释走隐藏通道成为名义规则；semicolonStmt 已删除
// （`;` 只作语句终结符，不单独构成空语句），故两者不在 stmt 分支中。

fn dispatch(flag bool, value int) int {
    {
    }
    let a int = 1;
    const K int = 2;
    if (flag) {
        a = 1;
    }
    for {
        break;
    }
    switch value {
        case 1 {
            a = 2;
        }
        default {
            a = 3;
        }
    }
    // 行注释（注释走隐藏通道，不影响解析）
    top:
    if (a < 0) {
        goto done;
    }
    goto top;
    done:
    dispatch(flag, value);
    return a + K;
}
