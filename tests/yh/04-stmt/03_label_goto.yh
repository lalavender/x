// 覆盖规则：labelStmt、gotoStmt。
// 标签语句与 goto；goto 后可跟可选分号。

fn jumping(limit int) int {
    let i int = 0
    start:
    i += 1
    if (i < limit) {
        goto start
    }
    goto finish
    i = 100
    finish:
    return i
}

fn forward_and_backward(flag bool) int {
    let n int = 0
    back:
    n += 1
    if (flag) {
        goto forward
    }
    goto back
    forward:
    return n
}
