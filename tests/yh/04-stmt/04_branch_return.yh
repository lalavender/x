// 覆盖规则：branchStmt、returnStmt。
// break / continue、无值 return、带值 return、带分号的 return。

fn branching(limit int) int {
    let total int = 0
    for i in 0..limit {
        if (i == 2) {
            continue
        }
        if (i > 5) {
            break
        }
        total = total + i
    }
    return total
}

fn nested_break(rows int, cols int) int {
    let total int = 0
    for i in 0..rows {
        for j in 0..cols {
            if (j > 1) {
                break
            }
            total = total + j
        }
    }
    return total
}

fn early_return() void {
    return
}

fn with_semicolon() int {
    return 0
}

fn bare_return() void {
    return
}
