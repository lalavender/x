// 覆盖规则：exprStmt、exprList。
// 纯表达式语句、赋值语句、多目标赋值（exprList assignOp exprList）。

fn calls() int {
    return 0;
}

fn two_args(a int, b int) int {
    return a + b;
}

fn statements() void {
    calls();
    let a int = 1;
    let b int = 2;
    a = 3;
    a += 1;
    a, b = 1, 2;
    a, b = two_args(1, 2), calls();
    calls();
}
