// 覆盖规则：exprStmt。
// 表达式语句与单目标赋值语句：exprStmt 是 expr (assignOp expr)? ';'，
// v0.1 无元组赋值，逗号仅用于调用实参。

fn calls() int {
    return 0
}

fn two_args(a int, b int) int {
    return a + b
}

fn statements() void {
    calls()
    let a int = 1
    let b int = 2
    a = 3
    a += 1
    a = two_args(1, 2)
    b = calls()
    calls()
}
