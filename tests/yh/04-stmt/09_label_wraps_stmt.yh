// 覆盖规则：labelStmt。
// 标签包裹被标记的语句（IDENT ':' stmt）：不能悬空到块尾（同 C）；
// 可标记块、if、任意简单语句；嵌套书写 `L1: L2: stmt` 合法。

fn cleanup(flag bool) void {
    let status int = 0;
    if (flag) {
        goto end;
    }
    status = 2;
    end:
    return;
}

fn label_marks_block(n int) void {
    goto body;
    body:
    {
        let inner int = n;
    }
}

fn label_marks_if(flag bool) void {
    skip_check:
    if (flag) {
        goto done;
    }
    done:
    return;
}

fn nested_labels(n int) void {
    outer:
    inner:
    n += 1;
    if (n < 0) {
        goto outer;
    }
    goto inner;
}
