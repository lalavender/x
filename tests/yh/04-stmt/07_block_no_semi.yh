// 覆盖规则：block、stmt。
// 以块结尾的语句不写 `;`：裸块、if / for / switch 的块，以及 fn 声明。

fn blocks(flag bool) void {
    {
        let a int = 1;
    }
    if (flag) {
        a_marker();
    }
    for {
        break;
    }
    switch 1 {
        case 1 {
            a_marker();
        }
        default {
        }
    }
}

fn a_marker() void {
}
