// 覆盖规则：exprStmt、postfixPart、callArgs。
// 无 import、无 #include，直接调用 prelude 声明的符号。

fn use_prelude() int {
    printf("hello\n");
    let p *void = malloc(16);
    memcpy(p, p, 16);
    let n u64 = strlen("abc");
    free(p);
    if (n > 0) {
        return 0;
    }
    return 1;
}

fn nested_prelude_calls() int {
    let n u64 = strlen("abc");
    printf("len=%d\n", n);
    printf("%d %d\n", n, n);
    return 0;
}

fn prelude_in_expression() int {
    let p *void = malloc(sizeof(int));
    free(p);
    return 0;
}
