module parse
import token
import errors
import support

// ============================================================================
// parse_module.yh —— 自举编译器：模块头解析（MOD-U1 + project.toml 增强）
//
// 文件头语法（注释与空白之后）：module 归属声明 → import 声明 → 业务声明。
//   * module IDENT;（项目模式强制首声明；旧单文件 CLI 不要求）
//   * import NAME;                  同项目/标准库/三层解析，绑定名 NAME
//   * import NAME as ALIAS;         同上，绑定名 ALIAS
//   * import A.B;                   两段：先试依赖键 A（跨项目），未命中再按
//                                   本项目目录 A/B 找模块
//   * import A.B.C;                 三段及以上：一律按本项目目录路径 A/B/C
//                                   找模块（跨项目导入不提供三段）
//   * import A.B as ALIAS;          绑定名 = 末段（可改）
// 记录文件归属（module 名）与本文件导入表（ImportEnt：查找名/别名/
// 依赖键）。重复绑定名解析期报错；未使用导入在文件编译完后检查；
// 纯语法检查不解析 project.toml、不搜索依赖：未知模块不是语法错误。
// ============================================================================

// mod_valid_name：当前 token 是否可作模块/导入名——单个标识符，
// 且不恰为 "_"（设计 §1：_ 不能作模块名）。是返回 1。
fn mod_valid_name() int {
    if (p_cur() != token.TOK_IDENT) {
        return 0
    }
    if (token.ctx().tokens[token.ctx().pos].len == 1 && support.src_ctx().data[token.ctx().tokens[token.ctx().pos].start] == '_') {
        return 0
    }
    return 1
}

// mod_import_find：按绑定名（别名）源码区间查本文件导入表。
// 返回表内下标；未导入返回 -1（同绑定名重复检查用）。
fn mod_import_find(start int, n int) int {
    let i int = 0
    for i < support.fs().import_n {
        if (support.fs().imports[i].alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.fs().imports[i].alias_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i += 1
    }
    return -1
}

// mod_import_push：向本文件导入表追加一条（名字 intern 进名字池）。
// name=查找名（模块名，点分导入取末段），alias=绑定名，
// proj_key=跨项目依赖键（仅两段点分且首段是依赖键时有效；否则 -1/0），
// path=完整点分原文（如 a.b.c；单段时与 name 相同）。
// 平行的绑定/使用数组随表一起扩容（cmd 侧绑定 / 未使用检查用）。
// 返回 0 成功；内存分配失败输出诊断并返回 -1。
fn mod_import_push(start int, n int, astart int, alen int,
    kstart int, klen int, pstart int, plen int, line int, col int) int {
    if (support.fs().import_n == support.fs().import_cap) {
        let ncap int = support.fs().import_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let nd *support.ImportEnt = malloc((ncap * sizeof(support.ImportEnt)).to_type(u64)).to_type(*support.ImportEnt)
        if (nd == 0) {
            return errors.fail("内存分配失败")
        }
        if (support.fs().import_n > 0) {
            memcpy(nd, support.fs().imports, (support.fs().import_n * sizeof(support.ImportEnt)).to_type(u64))
        }
        free(support.fs().imports)
        support.fs().imports = nd
        let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndm == 0) {
            return errors.fail("内存分配失败")
        }
        if (support.fs().import_n > 0) {
            memcpy(ndm, support.fs().import_mod, (support.fs().import_n * sizeof(int)).to_type(u64))
        }
        free(support.fs().import_mod)
        support.fs().import_mod = ndm
        let ndu *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndu == 0) {
            return errors.fail("内存分配失败")
        }
        if (support.fs().import_n > 0) {
            memcpy(ndu, support.fs().import_used, (support.fs().import_n * sizeof(int)).to_type(u64))
        }
        free(support.fs().import_used)
        support.fs().import_used = ndu
        support.fs().import_cap = ncap
    }
    let off int = support.name_intern(start, n)
    if (off < 0) {
        return -1
    }
    let aoff int = support.name_intern(astart, alen)
    if (aoff < 0) {
        return -1
    }
    let poff int = support.name_intern(pstart, plen)
    if (poff < 0) {
        return -1
    }
    support.fs().imports[support.fs().import_n].name_off = off
    support.fs().imports[support.fs().import_n].name_len = n
    support.fs().imports[support.fs().import_n].path_off = poff
    support.fs().imports[support.fs().import_n].path_len = plen
    if (klen > 0) {
        let koff int = support.name_intern(kstart, klen)
        if (koff < 0) {
            return -1
        }
        support.fs().imports[support.fs().import_n].proj_key_off = koff
        support.fs().imports[support.fs().import_n].proj_key_len = klen
    } else {
        support.fs().imports[support.fs().import_n].proj_key_off = -1
        support.fs().imports[support.fs().import_n].proj_key_len = 0
    }
    support.fs().imports[support.fs().import_n].alias_off = aoff
    support.fs().imports[support.fs().import_n].alias_len = alen
    support.fs().imports[support.fs().import_n].line = line
    support.fs().imports[support.fs().import_n].col = col
    support.fs().import_mod[support.fs().import_n] = -1
    support.fs().import_used[support.fs().import_n] = 0
    support.fs().import_n += 1
    return 0
}

// mod_parse_alias：解析可选的 `as ALIAS`（无别名时绑定名 = 查找名）。
// 输入查找名源码区间 [dstart,dstart+dlen)；出参别名区间。
// 消费 `as IDENT`（若有）。返回 0；别名非法或重复报错返回 -1。
fn mod_parse_alias(dstart int, dlen int, astart *int, alen *int) int {
    astart[0] = dstart
    alen[0] = dlen
    if (p_cur() != token.TK_AS) {
        return 0
    }
    p_adv()
    if (mod_valid_name() == 0) {
        return token.err_tok("此处需要一个导入别名（单个标识符，_ 除外）")
    }
    astart[0] = token.ctx().tokens[token.ctx().pos].start
    alen[0] = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    return 0
}

// mod_skip_head：pass 2 子遍（globals/fns）跳过文件头 token。
// 调用前提：pass 1 已通过 mod_parse_head 校验，形态必然合法，此处不再
// 诊断，只把游标推进到第一个业务声明。
fn mod_skip_head() void {
    if (p_cur() == token.TK_MODULE) {
        p_adv()
        p_adv()
        p_adv()
    }
    for p_cur() == token.TK_IMPORT {
        // import 头 token 数不定（点分/别名），扫到本声明的 ';'
        for p_cur() != token.TK_SEMI {
            p_adv()
        }
        p_adv()
    }
}
