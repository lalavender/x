module parse;
import gen;

// ============================================================================
// parse_module.yh —— 自举编译器：模块头解析（MOD-U1 + project.toml 增强）
//
// 文件头语法（注释与空白之后）：module 归属声明 → import 声明 → 业务声明。
//   * module IDENT;（项目模式强制首声明；旧单文件 CLI 不要求）
//   * import NAME;                  同项目/标准库/三层解析，绑定名 NAME
//   * import NAME as ALIAS;         同上，绑定名 ALIAS
//   * import KEY.MOD;               跨项目：依赖键 KEY 项目的 MOD 模块，
//                                   绑定名 MOD（不走三层搜索）
//   * import KEY.MOD as ALIAS;      同上，绑定名 ALIAS
// 记录文件归属（module 名）与本文件导入表（ImportEnt：查找名/别名/
// 依赖键）。重复绑定名解析期报错；未使用导入在文件编译完后检查；
// 纯语法检查不解析 project.toml、不搜索依赖：未知模块不是语法错误。
// ============================================================================

// mod_valid_name：当前 token 是否可作模块/导入名——单个标识符，
// 且不恰为 "_"（设计 §1：_ 不能作模块名）。是返回 1。
fn mod_valid_name() int {
    let gs *gen.GenState = gen.G();
    if (p_cur() != gen.TOK_IDENT) {
        return 0;
    }
    if (gs.task.c_toks[gs.task.c_pos].len == 1 && gs.task.c_src[gs.task.c_toks[gs.task.c_pos].start] == '_') {
        return 0;
    }
    return 1;
}

// mod_import_find：按绑定名（别名）源码区间查本文件导入表。
// 返回表内下标；未导入返回 -1（同绑定名重复检查用）。
fn mod_import_find(start int, n int) int {
    let gs *gen.GenState = gen.G();
    let i int = 0;
    for i < gs.task.mod_import_n {
        if (gs.task.mod_imports[i].alias_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (gs.task.np_data[gs.task.mod_imports[i].alias_off + j] != gs.task.c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// mod_import_push：向本文件导入表追加一条（名字 intern 进名字池）。
// name=查找名（模块名，点分导入取 MOD 段），alias=绑定名，
// proj_key=跨项目依赖键（同项目传 -1/0）。
// 平行的绑定/使用数组随表一起扩容（cmd 侧绑定 / 未使用检查用）。
// 返回 0 成功；内存分配失败输出诊断并返回 -1。
fn mod_import_push(start int, n int, astart int, alen int,
    kstart int, klen int, line int, col int) int {
    let gs *gen.GenState = gen.G();
    if (gs.task.mod_import_n == gs.task.mod_import_cap) {
        let ncap int = gs.task.mod_import_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *gen.ImportEnt = malloc((ncap * sizeof(gen.ImportEnt)).to_type(u64)).to_type(*gen.ImportEnt);
        if (nd == 0) {
            return gen.fail("内存分配失败");
        }
        if (gs.task.mod_import_n > 0) {
            memcpy(nd, gs.task.mod_imports, (gs.task.mod_import_n * sizeof(gen.ImportEnt)).to_type(u64));
        }
        free(gs.task.mod_imports);
        gs.task.mod_imports = nd;
        let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (ndm == 0) {
            return gen.fail("内存分配失败");
        }
        if (gs.task.mod_import_n > 0) {
            memcpy(ndm, gs.task.mod_import_mod, (gs.task.mod_import_n * sizeof(int)).to_type(u64));
        }
        free(gs.task.mod_import_mod);
        gs.task.mod_import_mod = ndm;
        let ndu *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (ndu == 0) {
            return gen.fail("内存分配失败");
        }
        if (gs.task.mod_import_n > 0) {
            memcpy(ndu, gs.task.mod_import_used, (gs.task.mod_import_n * sizeof(int)).to_type(u64));
        }
        free(gs.task.mod_import_used);
        gs.task.mod_import_used = ndu;
        gs.task.mod_import_cap = ncap;
    }
    let off int = gen.name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    let aoff int = gen.name_intern(astart, alen);
    if (aoff < 0) {
        return -1;
    }
    gs.task.mod_imports[gs.task.mod_import_n].name_off = off;
    gs.task.mod_imports[gs.task.mod_import_n].name_len = n;
    if (klen > 0) {
        let koff int = gen.name_intern(kstart, klen);
        if (koff < 0) {
            return -1;
        }
        gs.task.mod_imports[gs.task.mod_import_n].proj_key_off = koff;
        gs.task.mod_imports[gs.task.mod_import_n].proj_key_len = klen;
    } else {
        gs.task.mod_imports[gs.task.mod_import_n].proj_key_off = -1;
        gs.task.mod_imports[gs.task.mod_import_n].proj_key_len = 0;
    }
    gs.task.mod_imports[gs.task.mod_import_n].alias_off = aoff;
    gs.task.mod_imports[gs.task.mod_import_n].alias_len = alen;
    gs.task.mod_imports[gs.task.mod_import_n].line = line;
    gs.task.mod_imports[gs.task.mod_import_n].col = col;
    gs.task.mod_import_mod[gs.task.mod_import_n] = -1;
    gs.task.mod_import_used[gs.task.mod_import_n] = 0;
    gs.task.mod_import_n += 1;
    return 0;
}

// mod_reset_file：开始解析一个新源文件前重置文件级模块状态。
pub fn mod_reset_file() void {
    let gs *gen.GenState = gen.G();
    gs.task.mod_import_n = 0;
    gs.task.mod_has_module = 0;
    gs.task.mod_name_off = -1;
    gs.task.mod_name_len = 0;
}


// mod_parse_alias：解析可选的 `as ALIAS`（无别名时绑定名 = 查找名）。
// 输入查找名源码区间 [dstart,dstart+dlen)；出参别名区间。
// 消费 `as IDENT`（若有）。返回 0；别名非法或重复报错返回 -1。
fn mod_parse_alias(dstart int, dlen int, astart *int, alen *int) int {
    let gs *gen.GenState = gen.G();
    astart[0] = dstart;
    alen[0] = dlen;
    if (p_cur() != gen.TK_AS) {
        return 0;
    }
    p_adv();
    if (mod_valid_name() == 0) {
        return gen.err_tok("此处需要一个导入别名（单个标识符，_ 除外）");
    }
    astart[0] = gs.task.c_toks[gs.task.c_pos].start;
    alen[0] = gs.task.c_toks[gs.task.c_pos].len;
    p_adv();
    return 0;
}

// mod_parse_head：解析文件头（module 声明 → import 声明）。
// 由 parse_source 开头调用（语法模式与编译 pass 1 共用），消费到的
// token 之后交给业务声明主循环。规则：
//   * module 声明必须是文件第一个 token；import 只能出现在 module 之后；
//   * 模块名为单个标识符（"_" 除外）；import 目标为 NAME 或 KEY.MOD；
//   * 同一文件重复绑定名报错（同模块用不同别名导入合法）。
// 返回 0 成功；失败 -1（诊断已输出）。
pub fn mod_parse_head() int {
    let gs *gen.GenState = gen.G();
    if (p_cur() != gen.TK_MODULE) {
        // 旧单文件形态：无模块头；import 不允许脱离 module 出现
        if (p_cur() == gen.TK_IMPORT) {
            return gen.err_tok("import 声明前必须有 module 声明");
        }
        return 0;
    }
    p_adv();
    if (mod_valid_name() == 0) {
        return gen.err_tok("此处需要一个模块名（单个标识符，_ 除外）");
    }
    let nstart int = gs.task.c_toks[gs.task.c_pos].start;
    let nlen int = gs.task.c_toks[gs.task.c_pos].len;
    p_adv();
    if (p_expect(gen.TK_SEMI, "期望 module 声明结尾 ';'") != 0) {
        return -1;
    }
    let off int = gen.name_intern(nstart, nlen);
    if (off < 0) {
        return -1;
    }
    gs.task.mod_has_module = 1;
    gs.task.mod_name_off = off;
    gs.task.mod_name_len = nlen;
    for p_cur() == gen.TK_IMPORT {
        p_adv();
        if (mod_valid_name() == 0) {
            return gen.err_tok("此处需要一个导入模块名（单个标识符，_ 除外）");
        }
        // 第一段：NAME 或 KEY（点分导入的项目键）
        let s1 int = gs.task.c_toks[gs.task.c_pos].start;
        let l1 int = gs.task.c_toks[gs.task.c_pos].len;
        let iline int = gs.task.c_toks[gs.task.c_pos].line;
        let icol int = gs.task.c_toks[gs.task.c_pos].col;
        p_adv();
        // 点分：KEY.MOD（仅两段；查找名 = MOD，依赖键 = KEY）
        let tstart int = s1;
        let tlen int = l1;
        let kstart int = -1;
        let klen int = 0;
        if (p_cur() == gen.TK_DOT) {
            p_adv();
            if (mod_valid_name() == 0) {
                return gen.err_tok("'.' 后需要一个模块名");
            }
            if (p_peek(1) == gen.TK_DOT) {
                return gen.err_tok("跨项目导入只支持两段（依赖键.模块名）");
            }
            kstart = s1;
            klen = l1;
            tstart = gs.task.c_toks[gs.task.c_pos].start;
            tlen = gs.task.c_toks[gs.task.c_pos].len;
            p_adv();
        }
        // 别名
        let astart int = 0;
        let alen int = 0;
        if (mod_parse_alias(tstart, tlen, &astart, &alen) != 0) {
            return -1;
        }
        // 同绑定名重复检查（不同查找名的同别名也冲突）
        if (mod_import_find(astart, alen) >= 0) {
            return gen.err_lc(iline, icol, "重复的导入绑定名（同模块不同来源请用 as 区分）");
        }
        if (mod_import_push(tstart, tlen, astart, alen, kstart, klen,
            iline, icol) != 0) {
            return -1;
        }
        if (p_expect(gen.TK_SEMI, "期望 import 声明结尾 ';'") != 0) {
            return -1;
        }
    }
    return 0;
}

// mod_skip_head：pass 2 子遍（globals/fns）跳过文件头 token。
// 调用前提：pass 1 已通过 mod_parse_head 校验，形态必然合法，此处不再
// 诊断，只把游标推进到第一个业务声明。
fn mod_skip_head() void {
    if (p_cur() == gen.TK_MODULE) {
        p_adv();
        p_adv();
        p_adv();
    }
    for p_cur() == gen.TK_IMPORT {
        // import 头 token 数不定（点分/别名），扫到本声明的 ';'
        for p_cur() != gen.TK_SEMI {
            p_adv();
        }
        p_adv();
    }
}
