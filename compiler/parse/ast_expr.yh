module parse;
import gen;

// ============================================================================
// ast_expr.yh —— 前端表达式 AST arena 与一致性检查
//
// 节点按构造顺序连续存放，子节点 ID 总小于父节点 ID；源位置使用当前
// 文件的 token 半开区间，并保存 token_count，避免多文件解析后游标变化
// 破坏源映射。build/check 均与旧解析/语义遍历同步构造该 arena；受支持
// 函数从中降低为 SSA，其他函数仍走旧发射器。完整语义解耦留后续 R1 切片。
// ============================================================================

// 表达式 AST 节点种类。
pub const AST_EXPR_PRIMARY int = 1;
pub const AST_EXPR_UNARY int = 2;
pub const AST_EXPR_BINARY int = 3;
pub const AST_EXPR_TERNARY int = 4;
pub const AST_EXPR_CALL int = 5;
pub const AST_EXPR_ARG_LIST int = 6;
pub const AST_EXPR_INDEX int = 7;
pub const AST_EXPR_SLICE int = 8;
pub const AST_EXPR_MEMBER int = 9;
pub const AST_EXPR_CAST int = 10;
pub const AST_EXPR_ARRAY int = 11;

// AstExpr：单个带类型表达式及其子节点索引。
pub struct AstExpr {
    kind int;           // AST_EXPR_* 语法结构
    op int;             // 运算符/基本 token 种类；无运算符时为 0
    first int;          // 源文件 token 半开区间起点
    after int;          // 源文件 token 半开区间终点
    token_count int;    // 解析该节点时所在文件的 token 数
    file_id int;        // 项目 SourceStore 文件编号
    type_id int;        // 语义阶段得到的类型；参数列表节点为 -1
    owner_decl int;     // 所属文件级声明索引；局部符号 ID 仅在此上下文内有效
    sym_id int;         // 解析时的符号表索引；与 file_id/owner_decl 共同标识绑定
    sym_name_off int;   // 解析时的名字池字节偏移；函数调用不依赖后续可复用的符号槽
    sym_name_len int;   // 解析时的符号名长度
    binding_row int;    // 局部/参数绑定表行；区分作用域弹出后复用的符号槽
    sym_type_id int;    // 捕获时符号类型表索引，避免作用域弹出后引用旧符号槽
    sym_kind int;       // 捕获时 SYM_VAR/SYM_CONST/SYM_FN；无引用时为 -1
    sym_flags int;      // 捕获时 F_* 属性，供后续 IR lowering 使用
    sym_offset int;     // 捕获时局部槽偏移或全局 BSS 序号
    is_const int;       // 1 表示旧语义遍历已确认编译期常量
    const_bits i64;     // 整数/指针常量位型；字符串/数据标签沿用 Res.ival
    is_lit int;         // 1 表示源整数文字量，供窄化规则和 lowering 使用
    lit_big int;        // 1 表示正整数文字量超出 i64 正数域
    fval_bits i64;      // 浮点常量 IEEE754 位型；非浮点常量为 0
    child0 int;         // 左操作数、基础表达式或前一段参数列表
    child1 int;         // 右操作数或当前参数表达式
    child2 int;         // 三元表达式第三支；其他节点为 -1
}

let ast_expr_nodes *AstExpr = 0;
let ast_expr_count int = 0;
let ast_expr_cap int = 0;
let ast_expr_parse_depth int = 0;

// ast_expr_reset：开始一个 check worker 的表达式树收集。
pub fn ast_expr_reset() void {
    let gs *gen.GenState = gen.G();
    if (ast_expr_nodes != 0) {
        free(ast_expr_nodes.to_type(*void));
    }
    ast_expr_nodes = 0;
    ast_expr_count = 0;
    ast_expr_cap = 0;
    ast_expr_parse_depth = 0;
    gs.c_stats_ast_nodes = 0;
    gs.c_stats_ast_refs = 0;
}

// ast_expr_start：读取已有表达式节点的 token 起点；空节点返回当前游标。
pub fn ast_expr_start(id int) int {
    let gs *gen.GenState = gen.G();
    if (id < 0 || id >= ast_expr_count) {
        return gs.c_pos;
    }
    return ast_expr_nodes[id].first;
}

// ast_expr_add：追加一个表达式节点，子节点必须已先完成构造。
pub fn ast_expr_add(kind int, op int, first int, after int, type_id int,
    child0 int, child1 int, child2 int) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_ast_capture == 0) {
        return -1;
    }
    if (gs.c_active_file < 0 || first < 0 || after < first || after > gs.c_tok_n
        || kind < AST_EXPR_PRIMARY || kind > AST_EXPR_ARRAY) {
        let buf [192]u8;
        let n int = 0;
        n = gen.append_str(buf, n, "内部错误：表达式 AST 范围无效 file=");
        n = gen.append_int(buf, n, gs.c_active_file);
        n = gen.append_str(buf, n, " first=");
        n = gen.append_int(buf, n, first);
        n = gen.append_str(buf, n, " after=");
        n = gen.append_int(buf, n, after);
        n = gen.append_str(buf, n, " tokens=");
        n = gen.append_int(buf, n, gs.c_tok_n);
        n = gen.append_str(buf, n, " kind=");
        n = gen.append_int(buf, n, kind);
        let mo int = gen.tml_intern_str(buf, 0, n);
        if (mo < 0) { return -1; }
        return gen.fail(gen.np_cstr(mo));
    }
    if (kind == AST_EXPR_ARG_LIST) {
        if (type_id != -1) { return -1; }
    } else if (type_id < 0) {
        return gen.fail("内部错误：表达式 AST 缺少语义类型");
    }
    let i int = 0;
    for i < 3 {
        let child int = -1;
        if (i == 0) { child = child0; }
        if (i == 1) { child = child1; }
        if (i == 2) { child = child2; }
        if (child < -1 || child >= ast_expr_count) {
            return gen.fail("内部错误：表达式 AST 子节点编号无效");
        }
        if (child >= 0 && ast_expr_nodes[child].file_id != gs.c_active_file) {
            return gen.fail("内部错误：表达式 AST 子节点跨文件");
        }
        if (child >= 0 && (ast_expr_nodes[child].first < first || ast_expr_nodes[child].after > after)) {
            return gen.fail("内部错误：表达式 AST 子节点超出父节点范围");
        }
        i += 1;
    }
    if (ast_expr_count == ast_expr_cap) {
        let ncap int = ast_expr_cap * 2;
        if (ncap == 0) { ncap = 64; }
        let next *AstExpr = malloc((ncap * sizeof(AstExpr)).to_type(u64)).to_type(*AstExpr);
        if (next == 0) {
            return gen.fail("表达式 AST 内存分配失败");
        }
        if (ast_expr_count > 0) {
            memcpy(next, ast_expr_nodes, (ast_expr_count * sizeof(AstExpr)).to_type(u64));
        }
        if (ast_expr_nodes != 0) {
            free(ast_expr_nodes.to_type(*void));
        }
        ast_expr_nodes = next;
        ast_expr_cap = ncap;
    }
    let id int = ast_expr_count;
    ast_expr_nodes[id].kind = kind;
    ast_expr_nodes[id].op = op;
    ast_expr_nodes[id].first = first;
    ast_expr_nodes[id].after = after;
    ast_expr_nodes[id].token_count = gs.c_tok_n;
    ast_expr_nodes[id].file_id = gs.c_active_file;
    ast_expr_nodes[id].type_id = type_id;
    ast_expr_nodes[id].owner_decl = gs.c_file_decl_i;
    ast_expr_nodes[id].sym_id = -1;
    ast_expr_nodes[id].sym_name_off = -1;
    ast_expr_nodes[id].sym_name_len = 0;
    ast_expr_nodes[id].binding_row = -1;
    ast_expr_nodes[id].sym_type_id = -1;
    ast_expr_nodes[id].sym_kind = -1;
    ast_expr_nodes[id].sym_flags = 0;
    ast_expr_nodes[id].sym_offset = 0;
    ast_expr_nodes[id].is_const = 0;
    ast_expr_nodes[id].const_bits = 0;
    ast_expr_nodes[id].is_lit = 0;
    ast_expr_nodes[id].lit_big = 0;
    ast_expr_nodes[id].fval_bits = 0;
    ast_expr_nodes[id].child0 = child0;
    ast_expr_nodes[id].child1 = child1;
    ast_expr_nodes[id].child2 = child2;
    ast_expr_count += 1;
    gs.c_stats_ast_nodes += 1;
    return id;
}

// ast_expr_set_semantics：复制本次解析的绑定和常量事实，供后续阶段直接消费。
pub fn ast_expr_set_semantics(id int, res *gen.Res) int {
    let gs *gen.GenState = gen.G();
    if (id < 0 || id >= ast_expr_count || res.type_id != ast_expr_nodes[id].type_id
        || res.sym < -1 || res.sym >= gs.c_sym_n
        || res.sym >= 0 && gs.c_syms == 0
        || (res.is_const != 0 && res.is_const != 1)
        || (res.is_lit != 0 && res.is_lit != 1)
        || (res.lit_big != 0 && res.lit_big != 1)) {
        return gen.fail("内部错误：表达式 AST 语义事实无效");
    }
    ast_expr_nodes[id].sym_id = res.sym;
    if (res.sym >= 0) {
        ast_expr_nodes[id].sym_name_off = gs.c_syms[res.sym].name_off;
        ast_expr_nodes[id].sym_name_len = gs.c_syms[res.sym].name_len;
        ast_expr_nodes[id].binding_row = gs.c_syms[res.sym].ast_binding_row;
        ast_expr_nodes[id].sym_type_id = gs.c_syms[res.sym].type_id;
        ast_expr_nodes[id].sym_kind = gs.c_syms[res.sym].kind;
        ast_expr_nodes[id].sym_flags = gs.c_syms[res.sym].flags;
        ast_expr_nodes[id].sym_offset = gs.c_syms[res.sym].offset;
    }
    ast_expr_nodes[id].is_const = res.is_const;
    ast_expr_nodes[id].const_bits = res.ival;
    ast_expr_nodes[id].is_lit = res.is_lit;
    ast_expr_nodes[id].lit_big = res.lit_big;
    ast_expr_nodes[id].fval_bits = res.fval_bits;
    if (res.sym >= 0) {
        gs.c_stats_ast_refs += 1;
    }
    return 0;
}

// ast_expr_finish：用当前语义结果与子节点完成一个表达式节点。
pub fn ast_expr_finish(res *gen.Res, kind int, op int, first int,
    child0 int, child1 int, child2 int) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_ast_capture == 0) {
        return 0;
    }
    let id int = ast_expr_add(kind, op, first, gs.c_pos, res.type_id,
        child0, child1, child2);
    if (id < 0) {
        return -1;
    }
    if (ast_expr_set_semantics(id, res) != 0) {
        return -1;
    }
    res.ast_id = id;
    return 0;
}

// ast_expr_args_append：以持久化单链表记录实参，保留源码顺序与范围。
pub fn ast_expr_args_append(list *int, arg int) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_ast_capture == 0) {
        return 0;
    }
    if (arg < 0 || arg >= ast_expr_count) {
        return -1;
    }
    let first int = ast_expr_start(arg);
    if (list[0] >= 0) {
        first = ast_expr_start(list[0]);
    }
    let id int = ast_expr_add(AST_EXPR_ARG_LIST, gen.TK_COMMA, first,
        ast_expr_nodes[arg].after, -1, list[0], arg, -1);
    if (id < 0) {
        return -1;
    }
    list[0] = id;
    return 0;
}

// ast_expr_verify：确认 AST 源范围、同文件子节点和后序编号完整。
pub fn ast_expr_verify() int {
    let gs *gen.GenState = gen.G();
    if (gs.c_ast_capture == 0) {
        return 0;
    }
    let i int = 0;
    for i < ast_expr_count {
        let node AstExpr = ast_expr_nodes[i];
        if (node.kind < AST_EXPR_PRIMARY || node.kind > AST_EXPR_ARRAY
            || node.file_id < 0 || node.first < 0 || node.after < node.first
            || node.after > node.token_count || node.token_count <= 0) {
            return -1;
        }
        if (node.kind != AST_EXPR_ARG_LIST && node.type_id < 0) {
            return -1;
        }
        if (node.file_id >= gs.p_file_n || node.owner_decl < 0
            || node.owner_decl >= gs.p_files[node.file_id].decl_n
            || (node.is_const != 0 && node.is_const != 1)
            || (node.is_lit != 0 && node.is_lit != 1)
            || (node.lit_big != 0 && node.lit_big != 1)) {
            return gen.fail("内部错误：表达式 AST 绑定或常量事实无效");
        }
        if (node.sym_id < -1 || node.binding_row < -1
            || (node.sym_id == -1
            && (node.sym_type_id != -1 || node.sym_kind != -1
                || node.sym_flags != 0 || node.sym_offset != 0
                || node.binding_row != -1))
            || (node.sym_id >= 0 && (node.sym_type_id < 0
                || node.sym_type_id >= gs.t_type_n
                || node.sym_kind < gen.SYM_VAR || node.sym_kind > gen.SYM_FN))) {
            return gen.fail("内部错误：表达式 AST 符号快照无效");
        }
        if (node.binding_row >= 0 && (node.binding_row >= ast_binding_count
            || ast_bindings[node.binding_row].file_id != node.file_id
            || ast_bindings[node.binding_row].owner_decl != node.owner_decl
            || ast_bindings[node.binding_row].sym_id != node.sym_id
            || ast_bindings[node.binding_row].sym_type_id != node.sym_type_id
            || ast_bindings[node.binding_row].sym_kind != node.sym_kind
            || ast_bindings[node.binding_row].sym_flags != node.sym_flags
            || ast_bindings[node.binding_row].sym_offset != node.sym_offset)) {
            return gen.fail("内部错误：表达式 AST 局部绑定行无效");
        }
        if (node.sym_id >= 0 && (node.sym_kind == gen.SYM_VAR || node.sym_kind == gen.SYM_CONST)
            && (node.sym_flags & gen.F_GLOBAL) == 0 && node.binding_row < 0) {
            return gen.fail("内部错误：局部变量表达式缺少稳定绑定行");
        }
        if (node.kind == AST_EXPR_PRIMARY && node.sym_id >= 0
            && node.sym_type_id != node.type_id) {
            return gen.fail("内部错误：基本表达式绑定类型与符号类型不匹配");
        }
        if (node.kind == AST_EXPR_ARG_LIST && node.type_id != -1) {
            return -1;
        }
        if (node.kind == AST_EXPR_ARG_LIST
            && (node.sym_id != -1 || node.sym_type_id != -1 || node.sym_kind != -1
                || node.sym_flags != 0 || node.sym_offset != 0 || node.binding_row != -1
                || node.is_const != 0 || node.const_bits != 0
                || node.is_lit != 0 || node.lit_big != 0 || node.fval_bits != 0)) {
            return gen.fail("内部错误：实参链 AST 带有表达式语义事实");
        }
        let j int = 0;
        for j < 3 {
            let child int = -1;
            if (j == 0) { child = node.child0; }
            if (j == 1) { child = node.child1; }
            if (j == 2) { child = node.child2; }
            if (child >= i || child < -1) {
                return -1;
            }
            if (child >= 0 && (ast_expr_nodes[child].file_id != node.file_id
                || ast_expr_nodes[child].first < node.first
                || ast_expr_nodes[child].after > node.after)) {
                return -1;
            }
            j += 1;
        }
        i += 1;
    }
    return 0;
}
