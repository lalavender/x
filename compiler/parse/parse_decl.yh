module parse
import token
import check
import types
import support
import table
import comptime
import ast
import proj

// ============================================================================
// parse_decl.yh —— 自举编译器：顶层声明与源文件入口（两遍驱动）
//
// 覆盖 docs/yh.g4 的 sourceFile / topLevelDecl / exportedDeclBody / plainDeclBody，以及
// letDecl、constDecl、fnDecl、paramList、param、typeDecl、structDecl、
// unionDecl、fieldDecl、enumDecl、enumItem。
//
// 两遍模型（语义边界 §1）：
//   pass 1（c_pass==1）  登记类型/字段/函数签名/全局名字，函数体与全局
//                        初始化表达式整块跳过（token 扫描）；
//   pass 2a              仅处理顶层 let/const：折叠初始化并发射数据；
//   pass 2b              仅处理 fn：逐个编译函数体。
// 语法模式（c_compile==0）单遍消费到 EOF，行为与 G1 一致。
//
// 语义与发射边界：本文件只做语法消费与声明登记，类型检查、聚合法则与发射
// 分别归 gen.sem_*、ast 捕获与 lowering。历史上按 B5 子集逐项放开的能力
// （切片、for-in、聚合按值、类型化变参、浮点）现已全部接通，见
// compiler/README.md「已实现的语义」与 tests/yh-run 语料。
// ============================================================================

// skip_to_decl_end：pass 1 跳过一条顶层声明的剩余 token。
// 以深度 0 处的 ';' 或 '}'（fn/struct/enum 体收尾）为界。

fn skip_to_decl_end() int {
    let depth int = 0
    for p_cur() != token.TOK_EOF {
        let k int = p_cur()
        p_adv()
        if (k == token.TK_LPAREN || k == token.TK_LBRACKET || k == token.TK_LBRACE) {
            depth += 1
            continue
        }
        if (k == token.TK_RPAREN || k == token.TK_RBRACKET || k == token.TK_RBRACE) {
            if (depth == 0) {
                return 0
            }
            depth -= 1
            if (depth == 0 && k == token.TK_RBRACE) {
                return 0
            }
            continue
        }
        if (k == token.TK_SEMI && depth == 0) {
            return 0
        }
    }
    return 0
}

fn skip_init() int {
    let depth int = 0
    for 1 {
        let k int = p_cur()
        if (k == token.TOK_EOF) {
            return 0
        }
        if (k == token.TK_LPAREN || k == token.TK_LBRACKET || k == token.TK_LBRACE) {
            depth += 1
        }
        if (k == token.TK_RPAREN || k == token.TK_RBRACKET || k == token.TK_RBRACE) {
            depth -= 1
        }
        if (depth == 0 && (k == token.TK_COMMA || k == token.TK_SEMI)) {
            return 0
        }
        p_adv()
    }
    return 0
}

fn at_top_decl_start(k int) int {
    if (k == token.TK_PUB || k == token.TK_LET || k == token.TK_CONST || k == token.TK_FN || k == token.TK_TYPE
        || k == token.TK_STRUCT || k == token.TK_UNION || k == token.TK_ENUM || k == token.TK_AT
        || k == token.TK_TEST) {
        return 1
    }
    return 0
}

// p_tok_text_is：比较当前 token 的源字节，用于识别属性名而不保留新关键字。
fn p_tok_text_is(text *char, n int) int {
    if (token.ctx().pos < 0 || token.ctx().pos >= token.ctx().count || token.ctx().tokens[token.ctx().pos].len != n) {
        return 0
    }
    let i int = 0
    for i < n {
        if (support.src_ctx().data[token.ctx().tokens[token.ctx().pos].start + i] != text[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    return 1
}

// parse_attr_list：消费一个非空、无尾逗号的属性列表并返回识别出的属性位。
fn parse_attr_list(attrs *int) int {
    *attrs = 0
    if (p_expect(token.TK_AT, "期望 '@'") != 0
        || p_expect(token.TK_LBRACKET, "属性列表期望 '['") != 0) {
        return -1
    }
    if (p_cur() == token.TK_RBRACKET) {
        return token.err_tok("属性列表不能为空")
    }
    let bits int = 0
    for 1 {
        let bit int = 0
        if (p_tok_text_is("extern", 6) != 0) {
            bit = token.ATTR_EXTERN
        } else if (p_tok_text_is("inline", 6) != 0) {
            bit = token.ATTR_INLINE
        } else if (p_tok_text_is("noreturn", 8) != 0) {
            bit = token.ATTR_NORETURN
        } else if (p_tok_text_is("comptime", 8) != 0) {
            bit = token.ATTR_COMPTIME
        } else {
            return token.err_tok("未知属性（仅支持 extern、inline、noreturn、comptime）")
        }
        if ((bits & bit) != 0) {
            return token.err_tok("属性列表中存在重复属性")
        }
        bits |= bit
        p_adv()
        if (p_cur() != token.TK_COMMA) { break }
        p_adv()
        if (p_cur() == token.TK_RBRACKET) {
            return token.err_tok("属性列表不允许尾逗号")
        }
    }
    if (p_expect(token.TK_RBRACKET, "属性列表期望 ']' ") != 0) {
        return -1
    }
    *attrs = bits
    return 0
}

// p_top_decl_kind：查看属性列表与 pub 之后的声明种类，不改变解析游标。
fn p_top_decl_kind() int {
    let pos int = token.ctx().pos
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_cur() == token.TK_LBRACKET) {
            p_adv()
            for p_cur() != token.TK_RBRACKET && p_cur() != token.TOK_EOF { p_adv() }
            if (p_cur() == token.TK_RBRACKET) { p_adv() }
        }
    }
    if (p_cur() == token.TK_PUB) { p_adv() }
    let kind int = p_cur()
    token.ctx().pos = pos
    return kind
}

// p_decl_is_comptime：检查指定顶层声明是否由 comptime 属性修饰。
fn p_decl_is_comptime(start int) int {
    let saved int = token.ctx().pos
    if (start < 0 || start >= token.ctx().count) { return 0 }
    token.ctx().pos = start
    let found int = 0
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_cur() == token.TK_LBRACKET) {
            p_adv()
            found = p_tok_text_is("comptime", 8)
        }
    }
    token.ctx().pos = saved
    return found
}

fn skip_top_decl() int {
    let depth int = 0
    let consumed int = 0
    for p_cur() != token.TOK_EOF {
        let k int = p_cur()
        if (consumed > 0 && depth == 0 && at_top_decl_start(k) != 0) {
            // 返回类型中的 fn(...) 与 @[extern] fn(...) 不是下一条顶层声明。
            // 声明的 fn 后必须是名字，类型的 fn 后则是左括号。
            let fn_type int = (k == token.TK_FN && p_peek(1) == token.TK_LPAREN).to_type(int)
            let attr_type int = (k == token.TK_AT && p_peek(1) == token.TK_LBRACKET
                && p_peek(3) == token.TK_RBRACKET && p_peek(4) == token.TK_FN
                && p_peek(5) == token.TK_LPAREN).to_type(int)
            // `.test` 是成员名（memberName 放开保留字），不是下一条声明。
            let member_test int = (k == token.TK_TEST && token.ctx().pos > 0
                && token.ctx().tokens[token.ctx().pos - 1].kind == token.TK_DOT).to_type(int)
            if (fn_type == 0 && attr_type == 0 && member_test == 0) { return 0 }
        }
        p_adv()
        consumed = 1
        if (k == token.TK_LPAREN || k == token.TK_LBRACKET || k == token.TK_LBRACE) {
            depth += 1
            continue
        }
        if (k == token.TK_RPAREN || k == token.TK_RBRACKET || k == token.TK_RBRACE) {
            if (depth > 0) {
                depth -= 1
            }
            continue
        }
        if (k == token.TK_SEMI && depth == 0) {
            return 0
        }
    }
    return 0
}

// parse_top_decl_body：消费已由 parse_top_decl 解析前缀后的声明主体。
fn parse_top_decl_body() int {
    let k int = p_cur()
    if (k == token.TK_LET) {
        // 2026-10-02「let 不导出」：let 只能是模块变量或函数局部变量，
        // 不接受 pub 前缀；接口加载（.s.i）侧按旧格式容忍 pub let 行。
        if (support.fc().c_decl_pub != 0 && support.session().iface_load == 0) {
            return token.err_tok("let 变量不支持导出（pub 仅用于 fn/const/struct/union/enum）")
        }
        if (support.session().compile != 0 && support.session().pass == 2) {
            // pass 2 全量遍不走这里（globals/fns 子遍分工）
            return parse_let_decl(1)
        }
        return parse_let_decl(1)
    }
    if (k == token.TK_CONST) {
        return parse_const_decl(1)
    }
    if (k == token.TK_FN) {
        return parse_fn_decl()
    }
    if (k == token.TK_TYPE) {
        return parse_type_decl()
    }
    if (k == token.TK_STRUCT || k == token.TK_UNION) {
        // pub 可选（2026-10-12，ADR-0013）：带 pub 的 struct/union 进接口、
        // 跨模块可命名（字段一律公开）；不带 pub 的是模块私有类型，
        // 只在本模块可见、不进 .s.i。
        return parse_struct_decl()
    }
    if (k == token.TK_ENUM) {
        // 同上：私有 enum 的成员常量不带 F_PUB，只在模块内可见。
        return parse_enum_decl()
    }
    if (k == token.TK_TEST) {
        // YT0：test 只允许顶层，不支持 pub/属性；测试体只做语法检查。
        if (support.fc().c_decl_pub != 0) {
            return token.err_tok("test 声明不支持 pub")
        }
        return parse_test_decl()
    }
    return token.err_tok("此处需要一个顶层声明")
}

// p_test_decl_active：当前文件是否属于 yh test 的目标项目。
// 依赖/标准库里也有 test 声明，但只有目标项目的测试才登记函数与检查体；
// 其余按生产构建处理（只做语法），避免留下没有函数体的受检声明。
fn p_test_decl_active() int {
    // 选择条件由 gen.test_file_selected 统一判定：前端不感知 --filter。
    return proj.test_file_selected(support.session().active_file)
}

// parse_test_fn_name：测试体在本模块内的稳定内部函数名。
// 名字只由项目文件号与文件内 PDecl 号组成，yh test 生成入口按同一规则调用。
fn parse_test_fn_name(buf *u8) int {
    let n int = 0
    n = support.append_str(buf, n, "__yh_test_")
    n = support.append_int(buf, n, parse_test_file_ordinal(support.session().active_file))
    n = support.append_byte(buf, n, '_')
    n = support.append_int(buf, n, ast.store().file_decl_i)
    return n
}

// parse_test_file_ordinal：文件在其所属模块里的序号（不是全局文件号）。
// 测试入口模块由 testkit 在**父进程**生成、测试函数由模块 worker 生成；
// Windows 无 fork 的模块子进程会重新装载项目索引，全局文件号在两个进程间
// 可能不同（父进程把标准库与项目文件放在同一张表里），用模块内序号才稳定。
fn parse_test_file_ordinal(file int) int {
    if (file < 0 || file >= proj.file_count()) { return file }
    let m int = proj.file(file).mod
    if (m < 0 || m >= proj.mod_count()) { return file }
    let i int = 0
    for i < proj.mod_file_count(m) {
        if (proj.mod_file_at(m, i) == file) { return i }
        i += 1
    }
    return file
}

// parse_test_decl：解析顶层 `test STRING|IDENT block`。
// 生产构建只做语法检查；yh test 的 pass1 登记 pub 无参 void 测试函数，
// pass2 用正常函数上下文解析并捕获测试体，供 CheckedModule/LLVM 降低与
// 测试入口模块调用。
fn parse_test_decl() int {
    p_adv()
    if (p_cur() == token.TOK_STRING) {
        if (token.ctx().tokens[token.ctx().pos].len <= 2) {
            return token.err_tok("test 名称不能为空字符串")
        }
        p_adv()
    } else if (p_cur() == token.TOK_IDENT) {
        p_adv()
    } else {
        return token.err_tok("test 后需要字符串字面量或声明名")
    }
    if (p_cur() != token.TK_LBRACE) {
        return token.err_tok("test 声明后需要块")
    }
    if (p_test_decl_active() != 0) {
        if (ast.store().file_indexed == 0 || ast.store().file_decl_i < 0) {
            return token.err_tok("内部错误：yh test 需要项目文件声明索引")
        }
        let name [96]u8
        let nn int = parse_test_fn_name(&name[0])
        if (support.session().pass == 1) {
            let noff int = support.tml_intern_str(&name[0], 0, nn)
            if (noff < 0) { return -1 }
            let ftid int = table.fn_abi(types.TY_VOID, table.ms().sigparam_n,
                0, 0, support.ABI_YH)
            if (ftid < 0) { return -1 }
            let idx int = check.sym_push_pool(noff, nn, table.SYM_FN, ftid,
                table.F_GLOBAL | table.F_PUB)
            if (idx < 0) { return -1 }
            ast.store().file_decls[ast.store().file_decl_i].test_sym = idx
            token.ctx().pos = ast.store().file_decls[ast.store().file_decl_i].end
            return 0
        }
        let sym int = ast.store().file_decls[ast.store().file_decl_i].test_sym
        if (sym < 0 || sym >= table.ms().sym_n
            || table.ms().syms[sym].kind != table.SYM_FN) {
            return token.err_tok("内部错误：测试函数符号丢失")
        }
        if (check.sem_fn_begin(sym) != 0) { return -1 }
        if (ast.ast_function_begin(support.session().active_file,
                ast.store().file_decl_i) != 0) { return -1 }
        ast.ast_binding_begin_function()
        let saved_body int = ctx().test_body
        ctx().test_body = 1
        let status int = parse_block()
        ctx().test_body = saved_body
        if (status != 0) { return -1 }
        if (check.sem_fn_end() != 0) { return -1 }
        if (ast.ast_function_end() != 0) { return -1 }
        return 0
    }
    // 生产构建：测试体只做语法检查，不登记符号、不捕获 AST。
    let saved_compile int = support.session().compile
    let saved_capture int = support.session().ast_capture
    support.session().compile = 0
    support.session().ast_capture = 0
    let status2 int = parse_block()
    support.session().compile = saved_compile
    support.session().ast_capture = saved_capture
    return status2
}

fn parse_local_init(idx int, tid int, kind int) int {
    if (kind == table.SYM_CONST) {
        support.fc().c_fold += 1
        let cr support.Res
        let crr int = parse_expr_iso(&cr)
        support.fc().c_fold -= 1
        if (crr != 0) {
            return -1
        }
        if (cr.is_const == 0) {
            return token.err_tok("const 初始化必须是编译期常量")
        }
        if (check.sem_can_assign(tid, cr.type_id, cr.is_lit, cr.ival, cr.lit_big) != 0) {
            return -1
        }
        table.ms().syms[idx].cval = cr.ival
        if (table.ms().types[tid].kind == types.TY_PTR) {
            table.ms().syms[idx].flags |= table.F_ADDR
        }
        table.ms().syms[idx].const_ready = 1
        return 0
    }
    let r support.Res
    // 数组/切片字面量依赖目标类型上下文
    let save_exp int = support.fc().c_expect_tid
    support.fc().c_expect_tid = tid
    let prr int = parse_expr_iso(&r)
    support.fc().c_expect_tid = save_exp
    if (prr != 0) {
        return -1
    }
    if (check.sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1
    }
    return check.sem_store_local_value(idx, tid)
}

fn parse_let_decl(global int) int {
    p_adv()
    for 1 {
        if (parse_binding(global, table.SYM_VAR) != 0) {
            return -1
        }
        if (p_cur() == token.TK_COMMA) {
            p_adv()
            continue
        }
        break
    }
    return p_expect(token.TK_SEMI, "期望 ';'")
}

fn parse_const_decl(global int) int {
    p_adv()
    for 1 {
        if (parse_binding(global, table.SYM_CONST) != 0) {
            return -1
        }
        if (p_cur() == token.TK_COMMA) {
            p_adv()
            continue
        }
        break
    }
    return p_expect(token.TK_SEMI, "期望 ';'")
}

fn parse_fn_decl() int {
    p_adv()
    if (p_cur() != token.TOK_IDENT) {
        return token.err_tok("此处需要一个函数名")
    }
    let start int = token.ctx().tokens[token.ctx().pos].start
    let n int = token.ctx().tokens[token.ctx().pos].len
    if ((support.fc().c_decl_attrs & token.ATTR_COMPTIME) != 0
        && parse_comptime_diag_kind() != 0) {
        return token.err_tok("编译期诊断内建名不能用于 @[comptime] 函数")
    }
    if ((support.fc().c_decl_attrs & token.ATTR_COMPTIME) != 0 && n == 4
        && support.src_ctx().data[start] == 'm' && support.src_ctx().data[start + 1] == 'a'
        && support.src_ctx().data[start + 2] == 'i' && support.src_ctx().data[start + 3] == 'n') {
        return token.err_tok("main 不能标记为 comptime")
    }
    p_adv()
    if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
        return -1
    }
    let saved_type_abi int = ctx().type_abi
    ctx().type_abi = (support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 ? support.ABI_C : support.ABI_YH
    // 参数类型收集（两遍都要）
    let ptypes [64]int
    let np int = 0
    let vararg int = 0
    let is_variadic_seen int = 0
    let pnames [64]int
    let pname_lens [64]int
    let pname_tokens [64]int
    if (p_cur() != token.TK_RPAREN) {
        for 1 {
            if (p_cur() == token.TK_ELLIPSIS) {
                p_adv()
                vararg = 1
                if (support.session().compile != 0) {
                    return token.err_tok("用户源码不允许裸变参（仅 prelude）")
                }
                break
            }
            if (p_cur() != token.TOK_IDENT) {
                return token.err_tok("此处需要一个参数名")
            }
            let ps int = token.ctx().tokens[token.ctx().pos].start
            let pn int = token.ctx().tokens[token.ctx().pos].len
            let ptoken int = token.ctx().pos
            p_adv()
            let ptid int = 0
            if (p_cur() == token.TK_ELLIPSIS) {
                // 类型化变参 name ... T：体内类型为 []T（打包为切片）
                p_adv()
                ptid = parse_type_ref()
                if (ptid < 0) {
                    return -1
                }
                if (support.session().compile != 0) {
                    if (is_variadic_seen != 0) {
                        return token.err_tok("类型化变参至多一个且在末尾")
                    }
                    is_variadic_seen = 1
                    ptid = check.ty_slice(ptid)
                }
            } else {
                ptid = parse_type_ref()
                if (ptid < 0) {
                    return -1
                }
            }
            if (np >= 64) {
                return token.err_tok("参数过多")
            }
            pnames[np] = ps
            pname_lens[np] = pn
            pname_tokens[np] = ptoken
            ptypes[np] = ptid
            np += 1
            if (p_cur() == token.TK_COMMA) {
                p_adv()
                continue
            }
            break
        }
    }
    if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
        return -1
    }
    let ret int = types.TY_VOID
    if (is_type_start(p_cur()) != 0) {
        let rt int = parse_type_ref()
        if (rt < 0) {
            return -1
        }
        ret = rt
    }
    if (support.session().compile != 0 && (support.fc().c_decl_attrs & token.ATTR_COMPTIME) != 0) {
        if (vararg != 0 || is_variadic_seen != 0
            || comptime.ct_ir_return_supported(ret) == 0) {
            return token.err_tok("comptime 函数要求固定参数，且返回值须为标量、受支持定长数组/结构体/联合体或受支持元素切片")
        }
        let ci_ct int = 0
        for ci_ct < np {
            if (comptime.ct_ir_param_supported(ptypes[ci_ct]) == 0) {
                return token.err_tok("comptime 函数形参只支持整数、浮点、当前帧标量指针、标量叶定长数组、受支持结构体/联合体、标量元素切片或受支持结构体元素切片")
            }
            ci_ct += 1
        }
    }
    ctx().type_abi = saved_type_abi
    if ((support.fc().c_decl_attrs & token.ATTR_NORETURN) != 0 && ret != types.TY_VOID) {
        return token.err_tok("noreturn 函数必须返回 void")
    }
    if (support.session().compile != 0) {
        if (table.ty_has_opaque_value(ret) != 0) {
            return token.err_tok("不透明 C 类型不能按值返回")
        }
        let pi_check int = 0
        for pi_check < np {
            if (table.ty_has_opaque_value(ptypes[pi_check]) != 0) {
                return token.err_tok("不透明 C 类型只能通过指针传递")
            }
            pi_check += 1
        }
        if ((support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0) {
            if (vararg != 0 || is_variadic_seen != 0) {
                return token.err_tok("C ABI v1 不支持 yh 变参")
            }
            if (ret != types.TY_VOID && table.cabi_param(ret) == 0) {
                return token.err_tok("C ABI 不支持该返回类型")
            }
            let ci int = 0
            for ci < np {
                if (table.cabi_param(ptypes[ci]) == 0) {
                    return token.err_tok("C ABI 不支持该参数类型")
                }
                ci += 1
            }
        }
    }
    let has_body int = (p_cur() == token.TK_LBRACE).to_type(int)
    if (has_body == 0 && (support.fc().c_decl_attrs & token.ATTR_EXTERN) == 0) {
        return token.err_tok("无函数体声明需要 extern 属性")
    }
    if (has_body == 0 && (support.fc().c_decl_attrs & token.ATTR_INLINE) != 0) {
        return token.err_tok("inline 函数必须提供函数体")
    }
    if (has_body == 0 && p_expect(token.TK_SEMI, "期望 ';'") != 0) {
        return -1
    }
    if (support.session().compile == 0) {
        // 语法模式：普通函数必须带体；extern 声明以分号收尾。
        if (has_body != 0) { return parse_block() }
        return 0
    }
    // 编译模式
    if (support.session().pass == 1) {
        // 登记函数符号与签名（重复时报告首次声明位置）
        let prev int = table.sym_lookup(start, n)
        if (prev >= 0) {
            let buf [128]u8
            let bn int = 0
            bn = support.append_str(buf, bn, "顶层符号重定义（首次声明于 ")
            bn = support.append_int(buf, bn, table.ms().syms[prev].def_line)
            bn = support.append_byte(buf, bn, ':')
            bn = support.append_int(buf, bn, table.ms().syms[prev].def_col)
            bn = support.append_str(buf, bn, "）")
            let mo int = support.tml_intern_str(buf, 0, bn)
            if (mo < 0) {
                return -1
            }
            return token.err_tok(support.np_cstr(mo))
        }
        let first int = table.ms().sigparam_n
        let i int = 0
        for i < np {
            check.ty_sig_param(ptypes[i])
            i += 1
        }
        let sig_np int = np
        let sig_va int = vararg
        if (is_variadic_seen != 0) {
            sig_np = np - 1
            sig_va = 2
        }
        let fn_abi int = (support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 ? support.ABI_C : support.ABI_YH
        let ftid int = table.fn_abi(ret, first, sig_np, sig_va, fn_abi)
        let fl int = table.F_GLOBAL
        if (support.fc().c_decl_pub != 0) {
            fl |= table.F_PUB
        }
        if ((support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0) {
            fl |= table.F_CABI
            if (has_body == 0) { fl |= table.F_EXTERN }
        }
        if ((support.fc().c_decl_attrs & token.ATTR_NORETURN) != 0) { fl |= table.F_NORETURN }
        if ((support.fc().c_decl_attrs & token.ATTR_INLINE) != 0) { fl |= table.F_INLINE }
        if ((support.fc().c_decl_attrs & token.ATTR_COMPTIME) != 0) { fl |= table.F_COMPTIME }
        let idx int = check.sym_push(start, n, table.SYM_FN, ftid, fl)
        if (idx < 0) {
            return -1
        }
        // main 的 ELF 符号保持 GLOBAL（crt1 引用），无论是否书写 pub。
        // 模块模式下仅入口模块的 main 裸名导出；其他模块的 main 是
        // 普通符号（按 pub 修饰决定绑定，符号名带模块后缀）。
        if (n == 4 && support.src_ctx().data[start] == 'm' && support.src_ctx().data[start + 1] == 'a'
            && support.src_ctx().data[start + 2] == 'i' && support.src_ctx().data[start + 3] == 'n'
            && (support.module_mode() == 0 || proj.cfg().is_entry_mod != 0)) {
            table.ms().syms[idx].flags |= table.F_PUB
        }
        // 有体定义跳过函数体；编译期函数另外保存正文快照，供全局常量求值。
        if (has_body == 0) { return 0 }
        let body_first int = token.ctx().pos
        let body_after int = 0
        if (ast.store().file_indexed != 0 && ast.store().file_decl_i >= 0) {
            body_after = ast.store().file_decls[ast.store().file_decl_i].end
            token.ctx().pos = ast.store().file_decls[ast.store().file_decl_i].end
        } else {
            if (skip_to_decl_end() != 0) { return -1 }
            body_after = token.ctx().pos
        }
        if ((support.fc().c_decl_attrs & token.ATTR_COMPTIME) != 0
            && support.session().iface_load == 0
            && ct_register_source_path(idx, &pnames[0], &pname_lens[0], &ptypes[0],
                np, ret, body_first, body_after) != 0) {
            return -1
        }
        return 0
    }
    // pass 2：编译函数体
    if (has_body == 0) { return 0 }
    let fidx int = table.sym_lookup(start, n)
    if (fidx < 0) {
        return token.err_tok("内部错误：函数符号丢失")
    }
    let compile_only int = ((table.ms().syms[fidx].flags & table.F_COMPTIME) != 0).to_type(int)
    if (compile_only != 0 && support.fc().c_ct_prepare_active == 0) {
        if (comptime.ct_is_prepared(fidx) != 0) {
            if (ast.store().file_indexed != 0 && ast.store().file_decl_i >= 0) {
                token.ctx().pos = ast.store().file_decls[ast.store().file_decl_i].end
            } else if (skip_to_decl_end() != 0) {
                return -1
            }
            return 0
        }
    }
    if (check.sem_fn_begin(fidx) != 0) {
        return -1
    }
    if (ast.ast_function_begin(support.session().active_file, ast.store().file_decl_i) != 0) {
        return -1
    }
    ast.ast_binding_begin_function()
    let fi int = 0
    // AAPCS64 整型与浮点参数寄存器各自独立计数：整型进 x0..x7、浮点进
    // d0..d7。因此给每个参数定位寄存器时，必须用「它在本类型中的序号」
    // 而非形参表中的位置（否则 `scale(v f64, k int)` 的 k 会错误地读 x1）。
    let ipos int = 0
    let fpos int = 0
    for fi < np {
        if (check.sem_check_duplicate(pnames[fi], pname_lens[fi]) != 0) {
            return -1
        }
        let apos int = ipos
        if (table.ty_is_float(ptypes[fi]) != 0) {
            apos = fpos
            fpos += 1
        } else {
            ipos += 1
        }
        if ((support.fc().c_fn_flags & table.F_CABI) != 0) { apos = fi }
        if (check.sem_declare_param(pnames[fi], pname_lens[fi], ptypes[fi], apos) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_binding_add(table.ms().sym_n - 1, pname_tokens[fi], 1) != 0) {
            return -1
        }
        fi += 1
    }
    if (parse_block() != 0) {
        return -1
    }
    if (check.sem_fn_end() != 0) {
        return -1
    }
    if (ast.ast_function_end() != 0) {
        return -1
    }
    if (compile_only != 0 && support.fc().c_ct_prepare_active != 0
        && ast.ast_function_ct_export(fidx) != 0) { return -1 }
    return 0
}

fn parse_type_decl() int {
    p_adv()
    if (p_cur() != token.TOK_IDENT) {
        return token.err_tok("此处需要一个类型名")
    }
    let start int = token.ctx().tokens[token.ctx().pos].start
    let n int = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    if (p_expect(token.TK_ASSIGN, "期望 '='") != 0) {
        return -1
    }
    let tid int = parse_type_ref()
    if (tid < 0) {
        return -1
    }
    if (p_expect(token.TK_SEMI, "期望 ';'") != 0) {
        return -1
    }
    if (support.session().compile != 0 && support.session().pass == 1) {
        let off int = support.name_intern(start, n)
        if (off < 0) {
            return -1
        }
        table.ms().name_form = 0
        return check.ty_declare_name(off, n, tid)
    }
    return 0
}

fn parse_struct_decl() int {
    let saved_type_abi int = ctx().type_abi
    // extern 共享布局中的回调字段默认采用 C ABI；类型别名仍保持自身约定。
    ctx().type_abi = (support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 ? support.ABI_C : support.ABI_YH
    let is_union int = (p_cur() == token.TK_UNION).to_type(int)
    p_adv()
    if (p_cur() != token.TOK_IDENT) {
        return token.err_tok("此处需要一个类型名")
    }
    let start int = token.ctx().tokens[token.ctx().pos].start
    let n int = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    let struct_line int = token.ctx().tokens[token.ctx().pos - 1].line
    let struct_col int = token.ctx().tokens[token.ctx().pos - 1].col
    if (support.session().compile != 0 && support.session().pass == 1) {
        // 预登记名字（自引用指针字段需要）
        let stid int = table.ty_push(types.TY_STRUCT, 0, 0, -1, 0, table.ms().field_n)
        if (stid < 0) {
            return -1
        }
        if (is_union != 0) {
            table.ms().types[stid].kind = types.TY_UNION
        }
        let off int = support.name_intern(start, n)
        if (off < 0) {
            return -1
        }
        table.ms().name_form = is_union + 1
        if (check.ty_declare_name(off, n, stid) != 0) {
            return -1
        }
        table.ms().cur_struct = stid
    }
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) {
        return -1
    }
    for p_cur() != token.TK_RBRACE && p_cur() != token.TOK_EOF {
        // pub struct 一等化：字段一律公开，用户源码不接受字段级 pub 前缀。
        // 例外：接口文件（.s.i，c_iface_load=1）的字段行按 yh-iface v1 格式
        // 仍带 pub 标记，加载时照旧跳过——接口格式保持稳定，固定点门才有
        // 逐字节可比的产物。
        if (p_cur() == token.TK_PUB) {
            if (support.session().iface_load == 0) {
                return token.err_tok("struct/union 字段一律公开，不接受 pub 前缀")
            }
            p_adv()
        }
        if (is_member_name(p_cur()) == 0) {
            return token.err_tok("此处需要一个字段名")
        }
        let fstart int = token.ctx().tokens[token.ctx().pos].start
        let fn2 int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        let ftid int = parse_type_ref()
        if (ftid < 0) {
            return -1
        }
        if (p_expect(token.TK_SEMI, "期望 ';'") != 0) {
            return -1
        }
        if (support.session().compile != 0 && support.session().pass == 1) {
            if (check.sem_add_field(table.ms().cur_struct, fstart, fn2, ftid) != 0) {
                return -1
            }
        }
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) {
        return -1
    }
    ctx().type_abi = saved_type_abi
    if (support.session().compile != 0 && support.session().pass == 1) {
        if (comptime.ct_layout_struct_pending(table.ms().cur_struct) != 0) {
            if (comptime.ct_layout_defer_struct(table.ms().cur_struct, is_union,
                    struct_line, struct_col) != 0) { return -1 }
        } else {
            if (table.sem_struct_finish(table.ms().cur_struct, is_union) != 0) {
                return -1
            }
        }
        if ((support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 && table.ms().types[table.ms().cur_struct].len == 0) {
            return check.ty_add_name_attrs(table.ms().cur_struct, token.ATTR_OPAQUE)
        }
        return 0
    }
    return 0
}

fn parse_enum_decl() int {
    p_adv()
    if (p_cur() != token.TOK_IDENT) {
        return token.err_tok("此处需要一个枚举类型名")
    }
    let start int = token.ctx().tokens[token.ctx().pos].start
    let n int = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    if (support.session().compile != 0 && support.session().pass == 1) {
        let etid int = table.ty_push(types.TY_ENUM, support.TG_ENUM_SIZE, 4, -1, -1, -1)
        if (etid < 0) {
            return -1
        }
        table.ms().cur_enum = etid
        let off int = support.name_intern(start, n)
        if (off < 0) {
            return -1
        }
        table.ms().name_form = 3
        if (check.ty_declare_name(off, n, etid) != 0) {
            return -1
        }
        support.fc().c_enum_next = 0
    }
    let item_count int = 0
    let forced_pending int = 0
    let prev_member_sym int = -1
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) {
        return -1
    }
    for p_cur() != token.TK_RBRACE && p_cur() != token.TOK_EOF {
        if (p_cur() != token.TOK_IDENT) {
            return token.err_tok("此处需要一个枚举成员名")
        }
        let istart int = token.ctx().tokens[token.ctx().pos].start
        let in2 int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        let has_val int = 0
        let v support.Res
        let pend_expr int = 0
        let pend_first int = -1
        let pend_after int = -1
        if (p_cur() == token.TK_ASSIGN) {
            p_adv()
            has_val = 1
            // 判别值必须在 pass1 折叠成常量；含编译期调用时要等 typed 正文捕获
            // （pass2）之后才能求值，这里登记为延迟项，由调度阶段回填。
            if (support.session().compile != 0) {
                let scan int = token.ctx().pos
                for scan < token.ctx().count {
                    let sk int = token.ctx().tokens[scan].kind
                    if (sk == token.TK_SEMI || sk == token.TK_RBRACE) { break }
                    if (sk == token.TK_DOLLAR) { pend_expr = 1; break }
                    scan += 1
                }
            }
            if (pend_expr != 0 || forced_pending != 0) {
                pend_first = token.ctx().pos
                let scan2 int = token.ctx().pos
                for scan2 < token.ctx().count {
                    if (token.ctx().tokens[scan2].kind == token.TK_SEMI) { break }
                    scan2 += 1
                }
                pend_after = scan2
                token.ctx().pos = scan2
            } else {
                if (support.session().compile != 0) {
                    support.fc().c_fold += 1
                }
                let r int = parse_expr_iso(&v)
                if (support.session().compile != 0) {
                    support.fc().c_fold -= 1
                }
                if (r != 0) {
                    return -1
                }
            }
        }
        if (has_val == 0 && forced_pending != 0) { pend_expr = 1 }
        if (p_expect(token.TK_SEMI, "期望 ';'") != 0) {
            return -1
        }
        item_count += 1
        if (support.session().compile != 0 && support.session().pass == 1) {
            let val i64 = support.fc().c_enum_next.to_type(i64)
            if (pend_expr == 0 && has_val != 0) {
                if (v.is_const == 0) {
                    return token.err_tok("枚举判别值必须是编译期常量")
                }
                val = v.ival
            }
            if ((support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 && pend_expr == 0
                && (val < -2147483648 || val > 2147483647)) {
                return token.err_tok("extern enum 判别值必须可用 i32 表示")
            }
            if ((support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 && pend_expr != 0) {
                return token.err_tok("extern enum 判别值必须是编译期常量")
            }
            // pub enum 一等化：成员常量随枚举导出（F_PUB 进入接口名字表），
            // 跨模块以 `模块名.成员` 引用；接口加载侧按 pub enum 重新登记。
            let mfl int = table.F_GLOBAL | table.F_ENUM_MEMBER
            if (support.fc().c_decl_pub != 0) {
                mfl |= table.F_PUB
            }
            let idx int = check.sym_push(istart, in2, table.SYM_CONST, table.ms().cur_enum, mfl)
            if (idx < 0) {
                return -1
            }
            if (pend_expr != 0) {
                // 延迟：值待调度阶段回填，隐式成员记前一个成员。
                if (ct_enum_pending_add(idx, pend_first, pend_after,
                        prev_member_sym) != 0) {
                    return token.err_tok("延迟求值的枚举判别值超过 64 个")
                }
                forced_pending = 1
                table.ms().syms[idx].cval = 0
                table.ms().syms[idx].const_ready = 0
            } else {
                table.ms().syms[idx].cval = val
                table.ms().syms[idx].const_ready = 1
                support.fc().c_enum_next = val.to_type(int) + 1
            }
            // 成员登记进枚举成员表（必须在本成员的值与就绪位写完之后：登记时快照）。
            if (table.em_add(idx) != 0) {
                return token.err_tok("枚举成员总数超过 512，无法登记")
            }
            prev_member_sym = idx
        }
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) { return -1 }
    if (support.session().compile != 0 && support.session().pass == 1
        && (support.fc().c_decl_attrs & token.ATTR_EXTERN) != 0 && item_count == 0) {
        return token.err_tok("extern enum 必须至少包含一个成员")
    }
    return 0
}

// ct_register_source_path：登记编译期函数，并先算好它的来源路径。
// 路径规则（`--trimpath` 下用项目相对路径）属于项目模型，应该由 parse 计算：
// `comptime` 不认识文件表，只接收结果，这样 CT 执行器只依赖 support/token。
// 从 .s.ct 导入的函数带自己的定义路径（ct_origin_active），不改写。
fn ct_register_source_path(sym_id int, names *int, name_lens *int, types *int,
    param_n int, ret_type int, body_first int, body_after int) int {
    let loc_path [1024]u8
    let loc_len int = 0
    if (support.session().ct_origin_active == 0 && support.session().active_file >= 0
        && support.session().active_file < proj.file_count()) {
        let n int = proj.file_locs_path(support.session().active_file, &loc_path[0], 1024)
        if (n > 0 && n < 1024) { loc_len = n }
    }
    return comptime.ct_register(sym_id, names, name_lens, types,
        param_n, ret_type, body_first, body_after,
        support.arr_cstr(loc_path), loc_len)
}
