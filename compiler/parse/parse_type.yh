module parse
import token
import support
import gen
import comptime

// ============================================================================
// parse_type.yh —— 自举编译器：类型引用解析与解析器共用工具
//
// 覆盖 docs/yh.g4 的 typeRef / fnType / typeRefList / builtinType。
// 语法模式（c_compile == 0）只消费 token 并返回 0（G1 行为不变）；
// 编译模式返回类型表编号（≥0，错误 -1），并按需构建/去重类型条目。
//
// fn 类型的参数类型先收集到本帧局部数组再统一入池——嵌套 fn 类型
//（fn(fn(int) int) int）各自入池互不串扰。
// ============================================================================

// p_cur：当前 token 种类。
pub fn p_cur() int {
    let t *gen.TaskCtx = gen.task()
    return token.ctx().tokens[token.ctx().pos].kind
}

// p_peek：向前看第 k 个 token 的种类；越过表尾按 EOF 处理。
fn p_peek(k int) int {
    let t *gen.TaskCtx = gen.task()
    if (token.ctx().pos + k < token.ctx().count) {
        return token.ctx().tokens[token.ctx().pos + k].kind
    }
    return token.TOK_EOF
}

// p_adv：游标前进一个 token；EOF 处不动。
fn p_adv() void {
    let t *gen.TaskCtx = gen.task()
    if (token.ctx().tokens[token.ctx().pos].kind != token.TOK_EOF) {
        token.ctx().pos += 1
    }
}

// p_expect：当前 token 必须是 kind，是则消费并返回 0，否则报错返回 -1。
// 右花括号前单独放行一个隐式终结符：字面量最后一个元素可以直接换行收尾；
// 显式分号不在此列，保持「空语句非法」。
fn p_expect(kind int, what *char) int {
    if (kind == token.TK_RBRACE && p_implicit_semi() != 0 && p_peek(1) == token.TK_RBRACE) {
        p_adv()
    }
    if (p_cur() == kind) {
        p_adv()
        return 0
    }
    return token.err_tok(what)
}

// p_implicit_semi：当前 token 是否为换行补入的隐式终结符（长度为 0）。
// 显式分号长度为 1，用它区分「语句结束」与「空语句」。
fn p_implicit_semi() int {
    let t *gen.TaskCtx = gen.task()
    return (p_cur() == token.TK_SEMI && token.ctx().tokens[token.ctx().pos].len == 0).to_type(int)
}

// p_take_block_end：块或顶层类型已闭合后消费其可选的隐式终结符。
// 只消费零长度终结符，显式分号仍按旧规则拒绝（块后多余分号、空语句）。
fn p_take_block_end() void {
    if (p_implicit_semi() != 0) { p_adv() }
}

// is_member_name：k 是否可作「成员名」（成员位置放开保留字，to_type 除外）。
fn is_member_name(k int) int {
    if (k == token.TOK_IDENT) {
        return 1
    }
    if (k >= token.TK_PUB && k <= token.TK_AS) {
        return 1
    }
    if (k == token.TK_RESERVED) {
        return 1
    }
    if (k == token.TK_TEST) {
        return 1
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        return 1
    }
    return 0
}

// is_type_start：k 是否可作为类型引用起始（返回类型省略判定用）。
fn is_type_start(k int) int {
    if (k == token.TK_AT || k == token.TK_STAR || k == token.TK_LBRACKET || k == token.TK_FN || k == token.TOK_IDENT) {
        return 1
    }
    return (k >= token.TK_INT && k <= token.TK_VOID).to_type(int)
}

// sizeof_starts_type：sizeof('(' 后当前 token 是否为「类型」形态。
// 用于区分 sizeof(T) 与 sizeof(expr)：内建类型、[、fn 直接判定；
// 连续 * 后跟已登记类型名判为指针类型（如 sizeof(*P)）；IDENT 仅当
// 已登记为类型名才走类型路径（否则是表达式，如 sizeof(x)、sizeof(*p)）。
fn sizeof_starts_type() int {
    let t *gen.TaskCtx = gen.task()
    let k int = p_cur()
    let off int = 0
    for k == token.TK_STAR {
        off += 1
        k = p_peek(off)
    }
    if (k == token.TK_AT || k == token.TK_LBRACKET || k == token.TK_FN) {
        return 1
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        return 1
    }
    if (k == token.TOK_IDENT) {
        // 跳过的星号是当前形态前缀；类型名字位于 token.pos + off。
        let type_pos int = token.ctx().pos + off
        let tid int = gen.ty_lookup_name(token.ctx().tokens[type_pos].start,
            token.ctx().tokens[type_pos].len)
        if (tid >= 0) {
            return 1
        }
        // 模块限定类型 m.T（P3）：绑定名在导入表且命名空间导出该类型名
        if (p_peek(off + 1) == token.TK_DOT
            && p_peek(off + 2) == token.TOK_IDENT) {
            let qb int = gen.mod_file_binding(token.ctx().tokens[type_pos].start,
                token.ctx().tokens[type_pos].len)
            if (qb >= 0 && gen.mod_ns_lookup(qb,
                token.ctx().tokens[type_pos + 2].start,
                token.ctx().tokens[type_pos + 2].len, 1) >= 0) {
                return 1
            }
        }
    }
    return 0
}

// tk_to_builtin：内建类型 token → 类型编号（编译模式）。
fn tk_to_builtin(k int) int {
    if (k == token.TK_INT) { return gen.TY_I32 }
    if (k == token.TK_I8) { return gen.TY_I8 }
    if (k == token.TK_I16) { return gen.TY_I16 }
    if (k == token.TK_I32) { return gen.TY_I32 }
    if (k == token.TK_I64) { return gen.TY_I64 }
    if (k == token.TK_U8) { return gen.TY_U8 }
    if (k == token.TK_U16) { return gen.TY_U16 }
    if (k == token.TK_U32) { return gen.TY_U32 }
    if (k == token.TK_U64) { return gen.TY_U64 }
    if (k == token.TK_F32) { return gen.TY_F32 }
    if (k == token.TK_F64) { return gen.TY_F64 }
    if (k == token.TK_BOOL) { return gen.TY_BOOL }
    if (k == token.TK_CHAR) { return gen.TY_CHAR }
    return gen.TY_VOID
}

// parse_type_ref：类型引用。返回类型编号（语法模式返回 0），错误 -1。
//   '*' typeRef | '[' expr? ']' typeRef | 'fn' '(' typeRefList? ')' typeRef?
//   | '@' '[' 'extern' ']' fnType | builtinType | IDENT
fn parse_type_ref() int {
    let tk *gen.TaskCtx = gen.task()
    // 类型属性只有精确的 @[extern] fn 分支，作用范围限定为该函数类型。
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_expect(token.TK_LBRACKET, "C 函数类型需要 '['") != 0) { return -1 }
        if (p_tok_text_is("extern", 6) == 0) { return token.err_tok("函数类型属性只允许 extern") }
        p_adv()
        if (p_expect(token.TK_RBRACKET, "C 函数类型属性只允许单个 extern") != 0) { return -1 }
        if (p_cur() != token.TK_FN) { return token.err_tok("类型属性只能修饰 fn 类型") }
        let gs0 *gen.TaskCtx = gen.task()
        let saved int = gs0.c_type_abi
        gs0.c_type_abi = support.ABI_C
        let result int = parse_type_ref()
        gs0.c_type_abi = saved
        return result
    }
    let k int = p_cur()
    if (k == token.TK_STAR) {
        p_adv()
        let e int = parse_type_ref()
        if (e < 0) {
            return -1
        }
        if (support.session().compile == 0) {
            return 0
        }
        return gen.ty_ptr(e)
    }
    if (k == token.TK_LBRACKET) {
        let array_line int = token.ctx().tokens[token.ctx().pos].line
        let array_col int = token.ctx().tokens[token.ctx().pos].col
        p_adv()
        let alen int = -1
        let deferred_sym int = -1
        let deferred_line int = 0
        let deferred_col int = 0
        let deferred_expr int = 0
        let deferred_expr_first int = -1
        let deferred_expr_after int = -1
        if (p_cur() != token.TK_RBRACKET) {
            let r gen.Res
            if (support.session().compile != 0) {
                // 简单的前向 const 保持符号请求；一般表达式保存 token 范围，
                // 待 typed CT 函数与其全局常量依赖登记完成后再求值。
                // 不限 pass1：同一处声明会在 CT 捕获/布局/全局/函数子遍重复
                // 解析，而长度常量此时可能仍未就绪；布局请求按长度来源去重
                // （见 ct_layout_array_find），重复解析复用同一 type_id。
                if (p_cur() == token.TOK_IDENT
                    && p_peek(1) == token.TK_RBRACKET) {
                    let tok_pos int = token.ctx().pos
                    let sym int = gen.sym_lookup(token.ctx().tokens[tok_pos].start,
                        token.ctx().tokens[tok_pos].len)
                    if (sym >= 0 && tk.c_syms[sym].kind == gen.SYM_CONST
                        && tk.c_syms[sym].const_ready == 0
                        && gen.ty_is_integer(tk.c_syms[sym].type_id) != 0) {
                        deferred_sym = sym
                        deferred_line = token.ctx().tokens[tok_pos].line
                        deferred_col = token.ctx().tokens[tok_pos].col
                        p_adv()
                    }
                }
                if (deferred_sym < 0) {
                    let close int = p_ct_layout_array_close(token.ctx().pos)
                    if (close > token.ctx().pos
                        && p_ct_layout_expr_defer_now(token.ctx().pos, close) != 0) {
                        deferred_expr = 1
                        deferred_expr_first = token.ctx().pos
                        deferred_expr_after = close
                        token.ctx().pos = close
                    }
                }
                if (deferred_sym < 0) {
                    if (deferred_expr == 0) {
                        tk.c_fold += 1
                        let rr int = parse_expr(&r)
                        tk.c_fold -= 1
                        if (rr != 0) {
                            return -1
                        }
                        if (r.is_const == 0) {
                            return gen.sem_err("数组长度必须是编译期常量")
                        }
                        if (r.ival <= 0) {
                            return gen.sem_err("数组长度必须为正")
                        }
                        if (r.ival > 2147483647) {
                            return gen.sem_err("数组长度超出限制")
                        }
                        alen = r.ival.to_type(int)
                    }
                }
            } else {
                if (parse_expr(&r) != 0) {
                    return -1
                }
            }
        }
        if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) {
            return -1
        }
        let e2 int = parse_type_ref()
        if (e2 < 0) {
            return -1
        }
        if (support.session().compile == 0) {
            return 0
        }
        if (alen < 0) {
            if (deferred_expr != 0) {
                return comptime.ct_layout_array_expr(e2, support.session().active_file,
                    deferred_expr_first, deferred_expr_after,
                    array_line, array_col)
            }
            if (deferred_sym >= 0) {
                return comptime.ct_layout_array(e2, -1, deferred_sym,
                    deferred_line, deferred_col)
            }
            return gen.ty_slice(e2)
        }
        if (tk.t_types[e2].size < 0) {
            return comptime.ct_layout_array(e2, alen, -1,
                array_line, array_col)
        }
        return gen.ty_array(e2, alen)
    }
    if (k == token.TK_FN) {
        p_adv()
        if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
            return -1
        }
        // 参数类型收集到本帧数组（递归安全），全部解析后统一入池
        let pts [32]int
        let np int = 0
        if (p_cur() != token.TK_RPAREN) {
            for 1 {
                let pt int = parse_type_ref()
                if (pt < 0) {
                    return -1
                }
                if (support.session().compile != 0) {
                    if (np >= 32) {
                        return gen.sem_err("fn 类型参数过多")
                    }
                    pts[np] = pt
                    np += 1
                }
                if (p_cur() == token.TK_COMMA) {
                    p_adv()
                    continue
                }
                break
            }
        }
        if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
            return -1
        }
        let ret int = gen.TY_VOID
        if (is_type_start(p_cur()) != 0) {
            let rt int = parse_type_ref()
            if (rt < 0) {
                return -1
            }
            ret = rt
        }
        if (support.session().compile == 0) {
            return 0
        }
        let first int = tk.t_sigparam_n
        let i int = 0
        for i < np {
            gen.ty_sig_param(pts[i])
            i += 1
        }
        let ftid int = gen.ty_fn_abi(ret, first, np, 0, tk.c_type_abi)
        // 显式 C 类型、别名与字段同样检查签名，不能绕过 extern 声明检查。
        if (ftid >= 0 && tk.c_type_abi == support.ABI_C && gen.ty_cabi_param(ftid) == 0) {
            return gen.sem_err("C ABI 不支持该函数类型")
        }
        return ftid
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        p_adv()
        if (support.session().compile == 0) {
            return 0
        }
        return tk_to_builtin(k)
    }
    if (k == token.TOK_IDENT) {
        let start int = token.ctx().tokens[token.ctx().pos].start
        let n int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        // 限定类型 m.T（U3/U4）：编译模式查导入绑定的模块命名空间；
        // 单段点链（更长链不支持，干净拒绝）；语法模式仅消费。
        if (p_cur() == token.TK_DOT) {
            p_adv()
            if (p_cur() != token.TOK_IDENT) {
                return token.err_tok("限定类型 '.' 后需要一个类型名")
            }
            let tstart int = token.ctx().tokens[token.ctx().pos].start
            let tlen int = token.ctx().tokens[token.ctx().pos].len
            let tline int = token.ctx().tokens[token.ctx().pos].line
            let tcol int = token.ctx().tokens[token.ctx().pos].col
            p_adv()
            if (p_cur() == token.TK_DOT) {
                return token.err_tok("限定类型只支持一层（m.T）")
            }
            if (support.session().compile == 0) {
                return 0
            }
            if (support.module_mode() == 0) {
                return gen.sem_err("限定类型只在模块模式可用")
            }
            let qb int = gen.mod_file_binding(start, n)
            if (qb < 0) {
                return support.err_lc(tline, tcol, "点号左侧不是导入的模块名")
            }
            let qe int = gen.mod_ns_lookup(qb, tstart, tlen, 1)
            if (qe < 0) {
                return support.err_lc(tline, tcol, "模块没有导出该类型")
            }
            let qi int = 0
            for qi < tk.mod_import_n {
                if (tk.mod_import_mod[qi] == qb) {
                    tk.mod_import_used[qi] = 1
                    break
                }
                qi += 1
            }
            return tk.c_mods[qb].ns[qe].tid
        }
        if (support.session().compile == 0) {
            return 0
        }
        let tid int = gen.ty_lookup_name(start, n)
        if (tid < 0) {
            return gen.sem_err("未知类型（类型必须先定义）")
        }
        return tid
    }
    return token.err_tok("此处需要一个类型")
}

// yh test 内建测试：成员名与类型起始判定。
test "is_member_name 放行集合" {
    $assert(is_member_name(token.TOK_IDENT) == 1)
    $assert(is_member_name(token.TK_PUB) == 1)
    $assert(is_member_name(token.TK_AS) == 1)
    $assert(is_member_name(token.TK_RESERVED) == 1)
    $assert(is_member_name(token.TK_TEST) == 1)
    $assert(is_member_name(token.TK_INT) == 1)
    $assert(is_member_name(token.TK_VOID) == 1)
}

test "is_member_name 拒绝集合" {
    $assert(is_member_name(token.TK_TO_TYPE) == 0)
    $assert(is_member_name(token.TK_AT) == 0)
    $assert(is_member_name(token.TK_MODULE) == 0)
    $assert(is_member_name(token.TK_PLUS) == 0)
}

test "is_type_start 判定" {
    $assert(is_type_start(token.TK_AT) == 1)
    $assert(is_type_start(token.TK_STAR) == 1)
    $assert(is_type_start(token.TK_LBRACKET) == 1)
    $assert(is_type_start(token.TK_FN) == 1)
    $assert(is_type_start(token.TOK_IDENT) == 1)
    $assert(is_type_start(token.TK_I32) == 1)
    $assert(is_type_start(token.TK_PLUS) == 0)
    $assert(is_type_start(token.TK_SEMI) == 0)
}
