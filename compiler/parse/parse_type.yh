module parse
import ast
import check
import token
import support

// ============================================================================
// parse_type.yh —— 类型引用的纯语法解析（S4 垂直切片）
//
// 覆盖 docs/yh.g4 的 typeRef / fnType / typeRefList / builtinType。
// 本文件只消费 token 并构造 ast.AstType 语法节点：名字 intern 进名字池，
// 不读类型/符号表；类型表编号、数组长度布局与 C ABI 校验由
// check.type_resolve 完成。编译模式保持原返回契约（类型表编号，错误 -1），
// 语法模式返回 0。
//
// fn 类型的参数先收集到本帧数组，解析完后一次性追加到类型语法参数表，
// 保证外层参数区间连续（嵌套 fn 类型的参数不会插进外层区间）。
// ============================================================================

// p_peek：向前看第 k 个 token 的种类；越过表尾按 EOF 处理。
fn p_peek(k int) int {
    if (token.ctx().pos + k < token.ctx().count) {
        return token.ctx().tokens[token.ctx().pos + k].kind
    }
    return token.TOK_EOF
}

// p_adv：游标前进一个 token；EOF 处不动。
fn p_adv() void {
    if (token.ctx().tokens[token.ctx().pos].kind != token.TOK_EOF) {
        token.ctx().pos += 1
    }
}

// p_expect：当前 token 必须是 kind，是则消费并返回 0，否则报错返回 -1。
// 右花括号前单独放行一个隐式终结符：字面量最后一个元素可以直接换行收尾；
// 显式分号不在此列，保持「空语句非法」。
fn p_expect(kind int, what *char) int {
    if (kind == token.TK_RBRACE && p_implicit_semi() != 0 && p_peek(1) == token.TK_RBRACE) {
        p_adv()
    }
    if (p_cur() == kind) {
        p_adv()
        return 0
    }
    return token.err_tok(what)
}

// p_implicit_semi：当前 token 是否为换行补入的隐式终结符（长度为 0）。
// 显式分号长度为 1，用它区分「语句结束」与「空语句」。
fn p_implicit_semi() int {
    return (p_cur() == token.TK_SEMI && token.ctx().tokens[token.ctx().pos].len == 0).to_type(int)
}

// p_take_block_end：块或顶层类型已闭合后消费其可选的隐式终结符。
// 只消费零长度终结符，显式分号仍按旧规则拒绝（块后多余分号、空语句）。
fn p_take_block_end() void {
    if (p_implicit_semi() != 0) { p_adv() }
}

// is_member_name：k 是否可作「成员名」（成员位置放开保留字，to_type 除外）。
fn is_member_name(k int) int {
    if (k == token.TOK_IDENT) {
        return 1
    }
    if (k >= token.TK_PUB && k <= token.TK_AS) {
        return 1
    }
    if (k == token.TK_RESERVED) {
        return 1
    }
    if (k == token.TK_TEST) {
        return 1
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        return 1
    }
    return 0
}

// is_type_start：k 是否可作为类型引用起始（返回类型省略判定用）。
fn is_type_start(k int) int {
    if (k == token.TK_AT || k == token.TK_STAR || k == token.TK_LBRACKET || k == token.TK_FN || k == token.TOK_IDENT) {
        return 1
    }
    return (k >= token.TK_INT && k <= token.TK_VOID).to_type(int)
}

// p_line_at / p_col_at：读取指定 token 的行列；越界返回 0。
fn p_line_at(pos int) int {
    if (pos < 0 || pos >= token.ctx().count) { return 0 }
    return token.ctx().tokens[pos].line
}

fn p_col_at(pos int) int {
    if (pos < 0 || pos >= token.ctx().count) { return 0 }
    return token.ctx().tokens[pos].col
}

// p_err_line / p_err_col：解析结束游标处的行列，用于在 check 侧复现
// 旧 parse_type 的 token.err_tok 诊断位置。
fn p_err_line() int {
    let pos int = token.ctx().pos
    if (pos >= token.ctx().count) { pos = token.ctx().count - 1 }
    return p_line_at(pos)
}

fn p_err_col() int {
    let pos int = token.ctx().pos
    if (pos >= token.ctx().count) { pos = token.ctx().count - 1 }
    return p_col_at(pos)
}

// sizeof_type_start_syntax：sizeof('(' 后是否是无歧义的类型起始：
// 内建类型、`[`、`fn`、`@`，以及它们前面的 `*` 链。名字路径（可能既是类型
// 又是值）不在这里判定，交给 check.sizeof_type_path 查表。
fn sizeof_type_start_syntax() int {
    let k int = p_cur()
    let off int = 0
    for k == token.TK_STAR {
        off += 1
        k = p_peek(off)
    }
    if (k == token.TK_AT || k == token.TK_LBRACKET || k == token.TK_FN) {
        return 1
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        return 1
    }
    return 0
}

// sizeof_operand_end：从 first 起扫描到与 sizeof '(' 配对的 ')' 下标；
// 只做括号深度统计，不解析表达式。失败返回 -1。
fn sizeof_operand_end(first int) int {
    let depth int = 0
    let i int = first
    for i < token.ctx().count {
        let k int = token.ctx().tokens[i].kind
        if (k == token.TOK_EOF) { return -1 }
        if (k == token.TK_LPAREN || k == token.TK_LBRACKET || k == token.TK_LBRACE) {
            depth += 1
        } else if (k == token.TK_RPAREN || k == token.TK_RBRACKET || k == token.TK_RBRACE) {
            if (depth == 0) {
                return k == token.TK_RPAREN ? i : -1
            }
            depth -= 1
        }
        i += 1
    }
    return -1
}

// sizeof_path_shape：操作数区间是否恰为「`*` 链 + IDENT (. IDENT)?」。
// 只判定形态；是否类型由 check 查表决定。
fn sizeof_path_shape(first int, after int) int {
    let i int = first
    for i < after && token.ctx().tokens[i].kind == token.TK_STAR {
        i += 1
    }
    if (i >= after || token.ctx().tokens[i].kind != token.TOK_IDENT) {
        return 0
    }
    i += 1
    if (i < after && token.ctx().tokens[i].kind == token.TK_DOT) {
        i += 1
        if (i >= after || token.ctx().tokens[i].kind != token.TOK_IDENT) {
            return 0
        }
        i += 1
    }
    return (i == after).to_type(int)
}

// parse_type_syntax：类型引用的纯语法节点。返回节点编号，错误 -1。
//   '*' typeRef | '[' expr? ']' typeRef | 'fn' '(' typeRefList? ')' typeRef?
//   | '@' '[' 'extern' ']' fnType | builtinType | IDENT ('.' IDENT)?
// abi 为当前声明的默认调用约定；@[extern] 强制整棵函数类型子树使用 C ABI。
fn parse_type_syntax(abi int) int {
    let first int = token.ctx().pos
    let start_line int = p_line_at(first)
    let start_col int = p_col_at(first)
    // 类型属性只有精确的 @[extern] fn 分支，作用范围限定为该函数类型。
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_expect(token.TK_LBRACKET, "C 函数类型需要 '['") != 0) { return -1 }
        if (p_tok_text_is("extern", 6) == 0) { return token.err_tok("函数类型属性只允许 extern") }
        p_adv()
        if (p_expect(token.TK_RBRACKET, "C 函数类型属性只允许单个 extern") != 0) { return -1 }
        if (p_cur() != token.TK_FN) { return token.err_tok("类型属性只能修饰 fn 类型") }
        let id int = parse_type_syntax(support.ABI_C)
        if (id < 0) {
            return -1
        }
        if (ast.ast_type_set_span(id, first, token.ctx().pos, start_line, start_col,
                p_err_line(), p_err_col()) != 0) {
            return -1
        }
        return id
    }
    let k int = p_cur()
    if (k == token.TK_STAR) {
        p_adv()
        let child int = parse_type_syntax(abi)
        if (child < 0) {
            return -1
        }
        let id int = ast.ast_type_add(ast.AST_TYPE_PTR, 0, first, token.ctx().pos,
            start_line, start_col, p_err_line(), p_err_col())
        if (id < 0) {
            return -1
        }
        if (ast.ast_type_set_child(id, child) != 0) {
            return -1
        }
        return id
    }
    if (k == token.TK_LBRACKET) {
        let array_line int = start_line
        let array_col int = start_col
        p_adv()
        let is_slice int = (p_cur() == token.TK_RBRACKET).to_type(int)
        let alen int = -1
        let deferred_sym int = -1
        let deferred_line int = 0
        let deferred_col int = 0
        let deferred_expr int = 0
        let deferred_expr_first int = -1
        let deferred_expr_after int = -1
        if (is_slice == 0) {
            let r support.Res
            if (support.session().compile != 0) {
                // 长度语义由 check 的求值窄口统一判定（check.type_array_length），
                // parse 只按模式记录语法：单个未就绪 const 记符号，布局期再求值；
                // 当前遍求不出的表达式记 token 区间，布局子遍求值；纯常量算术
                // 直接拿立即值。窄口不覆盖的形式仍由表达式解析器兜底，诊断与
                // 语义动作搬迁前逐字节一致。不限 pass：同一处声明会在 CT 捕获/
                // 布局/全局/函数子遍重复解析，布局请求按长度来源去重
                // （见 ct_layout_array_find），重复解析复用同一 type_id。
                let close int = p_ct_layout_array_close(token.ctx().pos)
                if (close > token.ctx().pos) {
                    let len_val i64 = 0
                    // 模式码（协议见 check/const_eval.yh 的 type_array_length）：
                    // 1=立即值、2=延迟 token 区间、3=延迟符号、0=表达式兜底、
                    // -1=已报错（窄口已给出诊断，直接终止，不能再兜底重解析）。
                    let mode int = check.type_array_length(token.ctx().pos, close,
                        &len_val, &deferred_sym)
                    if (mode == 3) {
                        let tok_pos int = token.ctx().pos
                        deferred_line = token.ctx().tokens[tok_pos].line
                        deferred_col = token.ctx().tokens[tok_pos].col
                        token.ctx().pos = close
                    } else if (mode == 2) {
                        deferred_expr = 1
                        deferred_expr_first = token.ctx().pos
                        deferred_expr_after = close
                        token.ctx().pos = close
                    } else if (mode == 1) {
                        token.ctx().pos = close
                        if (len_val <= 0) {
                            return token.err_tok("数组长度必须为正")
                        }
                        if (len_val > 2147483647) {
                            return token.err_tok("数组长度超出限制")
                        }
                        alen = len_val.to_type(int)
                    } else if (mode < 0) {
                        return -1
                    }
                }
                if (deferred_sym < 0 && deferred_expr == 0 && alen < 0) {
                    support.fc().c_fold += 1
                    let rr int = parse_expr(&r)
                    support.fc().c_fold -= 1
                    if (rr != 0) {
                        return -1
                    }
                    if (r.is_const == 0) {
                        return token.err_tok("数组长度必须是编译期常量")
                    }
                    if (r.ival <= 0) {
                        return token.err_tok("数组长度必须为正")
                    }
                    if (r.ival > 2147483647) {
                        return token.err_tok("数组长度超出限制")
                    }
                    alen = r.ival.to_type(int)
                }
            } else {
                if (parse_expr(&r) != 0) {
                    return -1
                }
            }
        }
        if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) {
            return -1
        }
        let elem int = parse_type_syntax(abi)
        if (elem < 0) {
            return -1
        }
        let kind int = is_slice != 0 ? ast.AST_TYPE_SLICE : ast.AST_TYPE_ARRAY
        let id int = ast.ast_type_add(kind, 0, first, token.ctx().pos,
            array_line, array_col, p_err_line(), p_err_col())
        if (id < 0) {
            return -1
        }
        if (kind == ast.AST_TYPE_SLICE) {
            if (ast.ast_type_set_child(id, elem) != 0) {
                return -1
            }
        } else if (ast.ast_type_set_array(id, elem, alen, deferred_sym,
                deferred_line, deferred_col, deferred_expr,
                deferred_expr_first, deferred_expr_after) != 0) {
            return -1
        }
        return id
    }
    if (k == token.TK_FN) {
        p_adv()
        if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
            return -1
        }
        // 参数先收在本帧数组；嵌套 fn 类型的参数不会插进外层区间。
        let pts [64]int
        let np int = 0
        if (p_cur() != token.TK_RPAREN) {
            for 1 {
                let pt int = parse_type_syntax(abi)
                if (pt < 0) {
                    return -1
                }
                if (support.session().compile != 0 && np >= 32) {
                    return token.err_tok("fn 类型参数过多")
                }
                if (np >= 64) {
                    return token.err_tok("fn 类型参数过多")
                }
                pts[np] = pt
                np += 1
                if (p_cur() == token.TK_COMMA) {
                    p_adv()
                    continue
                }
                break
            }
        }
        if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
            return -1
        }
        let ret int = -1
        if (is_type_start(p_cur()) != 0) {
            ret = parse_type_syntax(abi)
            if (ret < 0) {
                return -1
            }
        }
        let param_first int = -1
        let i int = 0
        for i < np {
            let idx int = ast.ast_type_param_add(pts[i])
            if (idx < 0) {
                return -1
            }
            if (i == 0) { param_first = idx }
            i += 1
        }
        let id int = ast.ast_type_add(ast.AST_TYPE_FN, 0, first, token.ctx().pos,
            start_line, start_col, p_err_line(), p_err_col())
        if (id < 0) {
            return -1
        }
        if (ast.ast_type_set_fn(id, ret, param_first, np, abi) != 0) {
            return -1
        }
        return id
    }
    if (k >= token.TK_INT && k <= token.TK_VOID) {
        p_adv()
        let id int = ast.ast_type_add(ast.AST_TYPE_BUILTIN, k, first,
            token.ctx().pos, start_line, start_col, p_err_line(), p_err_col())
        if (id < 0) {
            return -1
        }
        return id
    }
    if (k == token.TOK_IDENT) {
        let start int = token.ctx().tokens[token.ctx().pos].start
        let n int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        let qual_off int = -1
        let qual_len int = 0
        let name_off int = -1
        let name_len int = 0
        let name_line int = start_line
        let name_col int = start_col
        // 限定类型 m.T（U3/U4）：编译模式查导入绑定的模块命名空间；
        // 单段点链（更长链不支持，干净拒绝）；语法模式同样消费结构。
        if (p_cur() == token.TK_DOT) {
            p_adv()
            if (p_cur() != token.TOK_IDENT) {
                return token.err_tok("限定类型 '.' 后需要一个类型名")
            }
            let tstart int = token.ctx().tokens[token.ctx().pos].start
            let tlen int = token.ctx().tokens[token.ctx().pos].len
            name_line = token.ctx().tokens[token.ctx().pos].line
            name_col = token.ctx().tokens[token.ctx().pos].col
            p_adv()
            if (p_cur() == token.TK_DOT) {
                return token.err_tok("限定类型只支持一层（m.T）")
            }
            qual_off = support.name_intern(start, n)
            if (qual_off < 0) {
                return -1
            }
            qual_len = n
            name_off = support.name_intern(tstart, tlen)
            if (name_off < 0) {
                return -1
            }
            name_len = tlen
        } else {
            name_off = support.name_intern(start, n)
            if (name_off < 0) {
                return -1
            }
            name_len = n
        }
        let id int = ast.ast_type_add(ast.AST_TYPE_NAMED, 0, first,
            token.ctx().pos, name_line, name_col, p_err_line(), p_err_col())
        if (id < 0) {
            return -1
        }
        if (ast.ast_type_set_named(id, name_off, name_len, qual_off, qual_len) != 0) {
            return -1
        }
        return id
    }
    return token.err_tok("此处需要一个类型")
}

// parse_type_ref：类型引用。返回类型编号（语法模式返回 0），错误 -1。
// 语法解析在 parse，类型表/布局/ABI 解析在 check；仍紧随本次类型解析调用，
// 因此调用方的 token 游标与诊断时机不变。
fn parse_type_ref() int {
    let root int = parse_type_syntax(ctx().type_abi)
    if (root < 0) {
        return -1
    }
    if (support.session().compile == 0) {
        return 0
    }
    return check.type_resolve(root)
}

// yh test 内建测试：成员名与类型起始判定。
test "is_member_name 放行集合" {
    $assert(is_member_name(token.TOK_IDENT) == 1)
    $assert(is_member_name(token.TK_PUB) == 1)
    $assert(is_member_name(token.TK_AS) == 1)
    $assert(is_member_name(token.TK_RESERVED) == 1)
    $assert(is_member_name(token.TK_TEST) == 1)
    $assert(is_member_name(token.TK_INT) == 1)
    $assert(is_member_name(token.TK_VOID) == 1)
}

test "is_member_name 拒绝集合" {
    $assert(is_member_name(token.TK_TO_TYPE) == 0)
    $assert(is_member_name(token.TK_AT) == 0)
    $assert(is_member_name(token.TK_MODULE) == 0)
    $assert(is_member_name(token.TK_PLUS) == 0)
}

test "is_type_start 判定" {
    $assert(is_type_start(token.TK_AT) == 1)
    $assert(is_type_start(token.TK_STAR) == 1)
    $assert(is_type_start(token.TK_LBRACKET) == 1)
    $assert(is_type_start(token.TK_FN) == 1)
    $assert(is_type_start(token.TOK_IDENT) == 1)
    $assert(is_type_start(token.TK_I32) == 1)
    $assert(is_type_start(token.TK_PLUS) == 0)
    $assert(is_type_start(token.TK_SEMI) == 0)
}
