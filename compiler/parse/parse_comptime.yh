module parse
import gen
import comptime
import ast

// parse_comptime_block_end：查找从指定左花括号开始的匹配右花括号位置。
fn parse_comptime_block_end(first int) int {
    let gs *gen.GenState = gen.G()
    if (first < 0 || first >= gs.task.c_tok_n || gs.task.c_toks[first].kind != gen.TK_LBRACE) {
        return -1
    }
    let depth int = 0
    let i int = first
    for i < gs.task.c_tok_n {
        let kind int = gs.task.c_toks[i].kind
        if (kind == gen.TK_LBRACE) { depth += 1 }
        if (kind == gen.TK_RBRACE) {
            depth -= 1
            if (depth == 0) {
                // 块闭合后紧跟的隐式终结符属于本块，由调用方跳过。
                let after int = i + 1
                if (after < gs.task.c_tok_n && gs.task.c_toks[after].kind == gen.TK_SEMI
                    && gs.task.c_toks[after].len == 0) { after += 1 }
                return after
            }
        }
        i += 1
    }
    return -1
}

// parse_comptime_branch：选中分支正常检查/发码，未选分支只做语法检查。
fn parse_comptime_branch(selected int) int {
    let gs *gen.GenState = gen.G()
    let saved_compile int = gs.task.c_compile
    let saved_capture int = gs.task.c_ast_capture
    let saved_falls int = gs.task.c_fn_falls
    if (selected != 1 || saved_compile == 0) {
        gs.task.c_compile = 0
        gs.task.c_ast_capture = 0
    } else if (saved_capture != 0 && gs.task.c_ct_prepare_active == 0) {
        comptime.ct_expansion_capture_enter()
    }
    let status int = 0
    if (p_cur() == gen.TK_DOLLAR && p_peek(1) == gen.TK_IF) {
        status = parse_comptime_if()
    } else {
        if (p_cur() != gen.TK_LBRACE) {
            return gen.err_tok("语句位置的 $if 后需要块；表达式形态的 $if (…) e1 $else e2 只能出现在表达式位置")
        }
        status = parse_block()
    }
    gs.task.c_compile = saved_compile
    gs.task.c_ast_capture = saved_capture
    if (selected == 1 && saved_compile != 0 && saved_capture != 0
        && gs.task.c_ct_prepare_active == 0) {
        comptime.ct_expansion_capture_leave()
    }
    if (selected != 1 || saved_compile == 0) { gs.task.c_fn_falls = saved_falls }
    return status
}

// parse_comptime_if：在函数体内按已就绪常量选择一个语句块，不发条件跳转。
fn parse_comptime_if() int {
    if (comptime.ct_enter_control() != 0) { return -1 }
    let status int = parse_comptime_if_body()
    comptime.ct_leave_control()
    return status
}

// parse_comptime_if_body：解析一层编译期条件选择的语法和选中分支。
fn parse_comptime_if_body() int {
    let gs *gen.GenState = gen.G()
    let typed_if int = (gs.task.c_ct_prepare_active != 0
        && gs.task.c_ast_capture != 0).to_type(int)
    let parent_falls int = gs.task.c_fn_falls
    p_adv()
    if (p_expect(gen.TK_IF, "$ 后需要 if") != 0
        || p_expect(gen.TK_LPAREN, "$if 条件必须带括号") != 0) { return -1 }
    let cond gen.Res
    let saved_target_ctx int = gs.task.c_ct_target_ctx
    if (gs.task.c_compile != 0 && typed_if == 0) {
        gs.task.c_fold += 1
        gs.task.c_ct_target_ctx = 1
    } else if (gs.task.c_compile != 0) {
        gs.task.c_ct_target_ctx = 1
    }
    let cr int = parse_expr_iso(&cond)
    if (gs.task.c_compile != 0 && typed_if == 0) {
        gs.task.c_fold -= 1
        gs.task.c_ct_target_ctx = saved_target_ctx
    } else if (gs.task.c_compile != 0) {
        gs.task.c_ct_target_ctx = saved_target_ctx
    }
    if (cr != 0 || p_expect(gen.TK_RPAREN, "期望 ')' ") != 0) { return -1 }
    let selected int = -1
    if (gs.task.c_compile != 0) {
        if (sem_check_cond(&cond) != 0) { return -1 }
        if (typed_if == 0) {
            if (cond.is_const == 0) { return gen.sem_err("$if 条件必须是编译期常量") }
            selected = (cond.ival != 0).to_type(int)
        }
    }
    if (typed_if != 0) {
        gs.task.c_fn_falls = 1
        if (p_cur() != gen.TK_LBRACE) {
            return gen.err_tok("语句位置的 $if 后需要块；表达式形态的 $if (…) e1 $else e2 只能出现在表达式位置")
        }
        if (parse_block() != 0) { return -1 }
        let then_falls int = gs.task.c_fn_falls
        let has_else int = 0
        let else_falls int = parent_falls
        if (p_cur() == gen.TK_DOLLAR && p_peek(1) == gen.TK_ELSE) {
            has_else = 1
            p_adv()
            p_adv()
            gs.task.c_fn_falls = 1
            if (p_cur() != gen.TK_LBRACE) {
                return gen.err_tok("语句位置的 $if 后需要块；表达式形态的 $if (…) e1 $else e2 只能出现在表达式位置")
            }
            if (parse_block() != 0) { return -1 }
            else_falls = gs.task.c_fn_falls
        }
        if (has_else != 0) {
            gs.task.c_fn_falls = (parent_falls != 0
                && (then_falls != 0 || else_falls != 0)).to_type(int)
        } else {
            gs.task.c_fn_falls = parent_falls
        }
        return 0
    }
    if (parse_comptime_branch(selected) != 0) { return -1 }
    let then_falls int = gs.task.c_fn_falls
    let has_else int = 0
    let else_falls int = parent_falls
    if (p_cur() == gen.TK_DOLLAR && p_peek(1) == gen.TK_ELSE) {
        has_else = 1
        p_adv()
        p_adv()
        let else_selected int = 0
        if (selected == 0) { else_selected = 1 }
        if (selected < 0) { else_selected = -1 }
        if (parse_comptime_branch(else_selected) != 0) { return -1 }
        else_falls = gs.task.c_fn_falls
    }
    if (gs.task.c_compile != 0) {
        if (selected == 1) { gs.task.c_fn_falls = then_falls }
        else if (selected == 0 && has_else != 0) { gs.task.c_fn_falls = else_falls }
        else { gs.task.c_fn_falls = parent_falls }
    }
    return 0
}

// parse_comptime_for：按半开整数区间重复解析语句块，并为每次展开建立常量绑定。
fn parse_comptime_for() int {
    if (comptime.ct_enter_control() != 0) { return -1 }
    let gs *gen.GenState = gen.G()
    if (comptime.ct_for_boundary_enter(gs.task.c_loop_depth) != 0) {
        comptime.ct_leave_control()
        return -1
    }
    let status int = parse_comptime_for_body()
    comptime.ct_for_boundary_leave()
    comptime.ct_leave_control()
    return status
}

// parse_comptime_enum_for：按枚举成员声明顺序展开 `E.values`。
fn parse_comptime_enum_for(name_start int, name_len int, name_token int,
    typed_for int) int {
    let gs *gen.GenState = gen.G()
    let enum_start int = gs.task.c_toks[gs.task.c_pos].start
    let enum_len int = gs.task.c_toks[gs.task.c_pos].len
    p_adv()
    if (p_expect(gen.TK_DOT, "枚举 values 需要 '.'") != 0
        || p_cur() != gen.TOK_IDENT || p_tok_text_is("values", 6) == 0) {
        return gen.err_tok("$for 目前只支持 `枚举名.values` 元信息源")
    }
    p_adv()
    if (p_cur() != gen.TK_LBRACE) { return gen.err_tok("枚举 values 后需要块") }
    let body_first int = gs.task.c_pos
    let body_after int = parse_comptime_block_end(body_first)
    if (body_after < 0) { return gen.err_tok("$for 函数体缺少 '}'") }
    if (gs.task.c_compile == 0) { return parse_comptime_branch(-1) }

    let enum_type int = gen.ty_lookup_name(enum_start, enum_len)
    if (enum_type < 0) { return gen.sem_err("$for values 来源不是已声明的类型") }
    if (gs.task.t_types[enum_type].kind != gen.TY_ENUM) {
        return gen.sem_err("$for values 来源必须是枚举类型")
    }
    let member_count int = comptime.ct_enum_member_count(enum_type)
    if (member_count < 0) { return gen.fail("内部错误：枚举 values 成员表无效") }
    if (member_count > 1024) { return gen.sem_err("单个枚举 values 展开超过 1024 次") }
    if (typed_for != 0 && ast.ast_stmt_current_now() >= 0) {
        // typed comptime 函数将每个枚举成员保存为 wrapper 下的独立块，
        // 供编译期 IR 依次解释，而不是创建动态区间循环模板。
        ast.ast_stmt_node_op_set(ast.ast_stmt_current_now(), 0)
    }
    if (member_count == 0) { return parse_comptime_branch(0) }

    let parent_falls int = gs.task.c_fn_falls
    let ordinal int = 0
    for ordinal < member_count {
        let member int = comptime.ct_enum_member_at(enum_type, ordinal)
        if (member < 0) { return gen.fail("内部错误：枚举 values 成员序号失效") }
        if (comptime.ct_charge_expansion(body_after - body_first) != 0
            || comptime.ct_for_boundary_value(ordinal.to_type(i64)) != 0) { return -1 }
        if (typed_for != 0 && gs.task.c_ast_capture != 0
            && comptime.ct_charge_expansion_ast_nodes(body_after - body_first) != 0) {
            return -1
        }
        gs.task.c_pos = body_first
        gen.scope_push()
        let binding int = gen.sym_push(name_start, name_len,
            gen.SYM_CONST, enum_type, gen.F_ENUM_META)
        if (binding < 0) { return -1 }
        gs.task.c_syms[binding].offset = member
        gs.task.c_syms[binding].cval = gs.task.c_syms[member].cval
        gs.task.c_syms[binding].const_ready = 1
        if (gs.task.c_ast_capture != 0
            && ast.ast_binding_add(binding, name_token, 0) != 0) { return -1 }
        if (typed_for != 0) { gs.task.c_fn_falls = 1 }
        if (parse_block() != 0) { return -1 }
        if (gs.task.c_pos != body_after) {
            return gen.err_tok("内部错误：枚举 values 展开没有消费完整函数体")
        }
        if (typed_for != 0) { gs.task.c_fn_falls = parent_falls }
        gen.scope_pop()
        ordinal += 1
    }
    gs.task.c_pos = body_after
    return 0
}

// parse_comptime_field_for：按字段声明顺序展开 `T.fields` 元信息（CT6 P1b）。
// 每轮绑定携带字段下标（offset）、字段类型（type_id，供 $is_type/$is_int/
// $is_float 静态类型谓词）与宿主类型（cval，供 .name 投影查字段表）。
// typed 路径把每个字段保存为 wrapper 下的独立块，普通路径逐轮解析并正常发码。
fn parse_comptime_field_for(name_start int, name_len int, name_token int,
    typed_for int) int {
    let gs *gen.GenState = gen.G()
    let owner_start int = gs.task.c_toks[gs.task.c_pos].start
    let owner_len int = gs.task.c_toks[gs.task.c_pos].len
    p_adv()
    if (p_expect(gen.TK_DOT, "字段元信息需要 '.'") != 0
        || p_cur() != gen.TOK_IDENT || p_tok_text_is("fields", 6) == 0) {
        return gen.err_tok("$for 只支持 `枚举名.values` 与 `类型名.fields` 元信息源")
    }
    p_adv()
    if (p_cur() != gen.TK_LBRACE) { return gen.err_tok("fields 后需要块") }
    let body_first int = gs.task.c_pos
    let body_after int = parse_comptime_block_end(body_first)
    if (body_after < 0) { return gen.err_tok("$for 函数体缺少 '}'") }
    if (gs.task.c_compile == 0) { return parse_comptime_branch(-1) }

    let owner int = gen.ty_lookup_name(owner_start, owner_len)
    if (owner < 0) { return gen.sem_err("$for fields 来源不是已声明的类型") }
    let owner_kind int = gs.task.t_types[owner].kind
    if (owner_kind != gen.TY_STRUCT && owner_kind != gen.TY_UNION) {
        return gen.sem_err("$for fields 来源必须是结构体或联合体")
    }
    let field_count int = gs.task.t_types[owner].len
    if (field_count < 0) { return gen.fail("内部错误：字段表长度无效") }
    if (field_count > 1024) { return gen.sem_err("单个 fields 展开超过 1024 次") }
    if (typed_for != 0 && ast.ast_stmt_current_now() >= 0) {
        ast.ast_stmt_node_op_set(ast.ast_stmt_current_now(), 0)
    }
    if (field_count == 0) { return parse_comptime_branch(0) }

    let parent_falls int = gs.task.c_fn_falls
    let index int = 0
    for index < field_count {
        let field gen.SField = gs.task.t_fields[gs.task.t_types[owner].sub + index]
        if (comptime.ct_charge_expansion(body_after - body_first) != 0
            || comptime.ct_for_boundary_value(index.to_type(i64)) != 0) { return -1 }
        if (typed_for != 0 && gs.task.c_ast_capture != 0
            && comptime.ct_charge_expansion_ast_nodes(body_after - body_first) != 0) {
            return -1
        }
        gs.task.c_pos = body_first
        gen.scope_push()
        let binding int = gen.sym_push(name_start, name_len,
            gen.SYM_CONST, field.type_id, gen.F_FIELD_META)
        if (binding < 0) { return -1 }
        gs.task.c_syms[binding].offset = index
        gs.task.c_syms[binding].cval = owner.to_type(i64)
        gs.task.c_syms[binding].const_ready = 1
        if (gs.task.c_ast_capture != 0
            && ast.ast_binding_add(binding, name_token, 0) != 0) { return -1 }
        if (typed_for != 0) { gs.task.c_fn_falls = 1 }
        if (parse_block() != 0) { return -1 }
        if (gs.task.c_pos != body_after) {
            return gen.err_tok("内部错误：字段元信息展开没有消费完整函数体")
        }
        if (typed_for != 0) { gs.task.c_fn_falls = parent_falls }
        gen.scope_pop()
        index += 1
    }
    gs.task.c_pos = body_after
    return 0
}

// parse_comptime_template_safe：限制模板首片不跨越逐轮语义变化的编译期结构。
fn parse_comptime_template_safe(first int, after int) int {
    let gs *gen.GenState = gen.G()
    let i int = first
    for i < after {
        let kind int = gs.task.c_toks[i].kind
        if (kind == gen.TK_DOLLAR || kind == gen.TK_CONST || kind == gen.TK_TYPE
            || kind == gen.TK_STRUCT || kind == gen.TK_UNION || kind == gen.TK_ENUM) {
            return 0
        }
        i += 1
    }
    return 1
}

// parse_comptime_for_body：解析一层编译期区间展开及其迭代绑定。
fn parse_comptime_for_body() int {
    let gs *gen.GenState = gen.G()
    let typed_for int = (gs.task.c_ct_prepare_active != 0
        && gs.task.c_ast_capture != 0).to_type(int)
    p_adv()
    if (p_expect(gen.TK_FOR, "$ 后需要 for") != 0 || p_cur() != gen.TOK_IDENT) {
        return gen.err_tok("$for 需要循环变量名")
    }
    let name_start int = gs.task.c_toks[gs.task.c_pos].start
    let name_len int = gs.task.c_toks[gs.task.c_pos].len
    let name_token int = gs.task.c_pos
    p_adv()
    if (p_expect(gen.TK_IN, "$for 变量后需要 in") != 0) { return -1 }
    if (p_cur() == gen.TOK_IDENT && p_peek(1) == gen.TK_DOT) {
        // 元信息源按 `.` 之后的固定名分派：values（枚举）/ fields（结构体、联合体）。
        let saved_pos int = gs.task.c_pos
        p_adv()
        p_adv()
        let src_fields int = p_tok_text_is("fields", 6)
        gs.task.c_pos = saved_pos
        if (src_fields != 0) {
            return parse_comptime_field_for(name_start, name_len, name_token, typed_for)
        }
        return parse_comptime_enum_for(name_start, name_len, name_token, typed_for)
    }
    if (p_expect(gen.TK_LPAREN, "$for 区间必须带括号") != 0) { return -1 }
    let lo gen.Res
    if (gs.task.c_compile != 0 && typed_for == 0) { gs.task.c_fold += 1 }
    let lr int = parse_expr_blockctx(&lo)
    if (gs.task.c_compile != 0 && typed_for == 0) { gs.task.c_fold -= 1 }
    if (lr != 0 || p_expect(gen.TK_RANGE, "$for 区间需要 '..'") != 0) { return -1 }
    let hi gen.Res
    if (gs.task.c_compile != 0 && typed_for == 0) { gs.task.c_fold += 1 }
    let hr int = parse_expr_blockctx(&hi)
    if (gs.task.c_compile != 0 && typed_for == 0) { gs.task.c_fold -= 1 }
    if (hr != 0 || p_expect(gen.TK_RPAREN, "期望 ')' ") != 0) { return -1 }
    if (p_cur() != gen.TK_LBRACE) { return gen.err_tok("$for 区间后需要块") }
    let body_first int = gs.task.c_pos
    let body_after int = parse_comptime_block_end(body_first)
    if (body_after < 0) { return gen.err_tok("$for 函数体缺少 '}'") }
    let use_template int = (gs.task.c_ast_capture != 0 && typed_for == 0
        && parse_comptime_template_safe(body_first, body_after) != 0).to_type(int)
    let template_stmt int = ast.ast_stmt_current_now()
    if (gs.task.c_compile == 0) { return parse_comptime_branch(-1) }
    if (typed_for == 0 && (lo.is_const == 0 || hi.is_const == 0)) {
        return gen.sem_err("$for 区间边界必须是编译期常量")
    }
    if (gen.ty_is_integer(lo.type_id) == 0 || gen.ty_is_integer(hi.type_id) == 0) {
        return gen.sem_err("$for 区间边界必须是整数")
    }
    if (gen.sem_can_assign(gen.TY_I32, lo.type_id, lo.is_lit, lo.ival, lo.lit_big) != 0
        || gen.sem_can_assign(gen.TY_I32, hi.type_id, hi.is_lit, hi.ival, hi.lit_big) != 0) {
        return -1
    }
    if (typed_for != 0) {
        let parent_falls int = gs.task.c_fn_falls
        gen.scope_push()
        let sym int = gen.sym_push(name_start, name_len, gen.SYM_CONST, gen.TY_I32, 0)
        if (sym < 0) { return -1 }
        gs.task.c_syms[sym].const_ready = 0
        if (ast.ast_binding_add(sym, name_token, 0) != 0) { return -1 }
        gs.task.c_fn_falls = 1
        if (parse_block() != 0) { return -1 }
        if (gs.task.c_pos != body_after) {
            return gen.err_tok("内部错误：编译期 typed $for 没有消费完整函数体")
        }
        gs.task.c_fn_falls = parent_falls
        gen.scope_pop()
        return 0
    }
    let count int = 0
    let probe i64 = lo.ival
    for probe < hi.ival {
        count += 1
        if (count > 1024) { return gen.sem_err("单个 $for 区间超过 1024 次") }
        probe += 1
    }
    if (count == 0) {
        return parse_comptime_branch(0)
    }
    let template_stmt_base int = ast.ast_stmt_count_now()
    let template_expr_base int = ast.ast_expr_count_now()
    let template_binding_base int = ast.ast_binding_count_now()
    let template_binding_after int = template_binding_base
    let template_node_cost int = 0
    let template_body_stmt int = -1
    let value i64 = lo.ival
    for value < hi.ival {
        if (comptime.ct_charge_expansion(body_after - body_first) != 0) { return -1 }
        if (comptime.ct_for_boundary_value(value) != 0) { return -1 }
        if (use_template != 0 && value > lo.ival
            && comptime.ct_charge_expansion_ast_nodes(template_node_cost) != 0) {
            return -1
        }
        gs.task.c_pos = body_first
        gen.scope_push()
        let sym int = gen.sym_push(name_start, name_len, gen.SYM_CONST, gen.TY_I32, 0)
        if (sym < 0) { return -1 }
        gs.task.c_syms[sym].cval = value
        gs.task.c_syms[sym].const_ready = 1
        let saved_capture int = gs.task.c_ast_capture
        if (use_template != 0 && value > lo.ival) { gs.task.c_ast_capture = 0 }
        if (gs.task.c_ast_capture != 0 && ast.ast_binding_add(sym, name_token, 0) != 0) {
            gs.task.c_ast_capture = saved_capture
            return -1
        }
        let branch_status int = parse_comptime_branch(1)
        gs.task.c_ast_capture = saved_capture
        if (branch_status != 0) { return -1 }
        if (gs.task.c_pos != body_after) {
            return gen.err_tok("内部错误：$for 展开没有消费完整函数体")
        }
        if (use_template != 0 && value == lo.ival) {
            template_node_cost = (ast.ast_stmt_count_now() - template_stmt_base) +
                (ast.ast_expr_count_now() - template_expr_base) +
                (ast.ast_binding_count_now() - template_binding_base)
            template_binding_after = ast.ast_binding_count_now()
            template_body_stmt = ast.ast_stmt_node_first_child_of(template_stmt)
            if (template_node_cost <= 0 || template_body_stmt < 0) {
                return gen.fail("内部错误：编译期 `$for` typed AST 模板为空")
            }
        }
        gen.scope_pop()
        value += 1
    }
    if (use_template != 0 && ast.ast_comptime_for_add(template_stmt,
        template_binding_base, template_binding_after, template_body_stmt,
        lo.ival, hi.ival, template_node_cost) < 0) { return -1 }
    gs.task.c_pos = body_after
    return 0
}

// parse_comptime_control：分派函数体内的 $if 与 $for。
fn parse_comptime_control() int {
    if (p_peek(1) == gen.TK_IF) { return parse_comptime_if() }
    if (p_peek(1) == gen.TK_FOR) { return parse_comptime_for() }
    return gen.err_tok("语句位置的 $ 只支持 if 和 for")
}

// parse_comptime_diag_kind：将当前诊断内建名映射为固定类别，不新增词法关键字。
fn parse_comptime_diag_kind() int {
    if (p_tok_text_is("assert", 6) != 0) { return gen.CT_DIAG_ASSERT }
    if (p_tok_text_is("compile_error", 13) != 0) { return gen.CT_DIAG_ERROR }
    if (p_tok_text_is("compile_warn", 12) != 0) { return gen.CT_DIAG_WARN }
    return 0
}

// parse_comptime_diag_kind_at：检查指定语句起点是否为诊断调用，并恢复解析游标。
fn parse_comptime_diag_kind_at(first int) int {
    let gs *gen.GenState = gen.G()
    if (first < 0 || first + 1 >= gs.task.c_tok_n
        || gs.task.c_toks[first].kind != gen.TK_DOLLAR
        || gs.task.c_toks[first + 1].kind != gen.TOK_IDENT) {
        return 0
    }
    let saved int = gs.task.c_pos
    gs.task.c_pos = first + 1
    let kind int = parse_comptime_diag_kind()
    gs.task.c_pos = saved
    return kind
}

// parse_test_assert_lit：为测试断言调用构造编译器生成的标量实参 AST。
// line/col 与空消息没有源码 token，借用断言调用的 token 区间做来源范围。
fn parse_test_assert_lit(res *gen.Res, tid int, value i64,
    first int, after int) int {
    let gs *gen.GenState = gen.G()
    gen.sem_res_reset(res, tid)
    res.sym = -1
    res.is_const = 1
    res.is_lit = 1
    res.ival = value
    if (gs.task.c_ast_capture == 0) { return 0 }
    let id int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, gen.TOK_NUMBER,
        first, after, tid, -1, -1, -1)
    if (id < 0 || ast.ast_expr_set_semantics(id, res) != 0) { return -1 }
    res.ast_id = id
    return 0
}

// parse_test_assert_call：把 test 内的 $assert(cond, msg) 降低为对
// __yh_test_assert(cond, line, col, msg) 的普通运行期调用。
// 该符号是 prelude extern，由 yh test 生成的入口模块提供 C ABI 定义。
fn parse_test_assert_call(res *gen.Res, condition *gen.Res, msg *gen.Res,
    line int, col int, first int, after int) int {
    let gs *gen.GenState = gen.G()
    let name *char = "__yh_test_assert"
    let nlen int = 16
    let noff int = gen.tml_intern_str(name.to_type(*u8), 0, nlen)
    if (noff < 0) { return -1 }
    let sym int = gen.sym_lookup_off(noff, nlen)
    if (sym < 0 || gs.task.c_syms[sym].kind != gen.SYM_FN) {
        return gen.sem_err("内部错误：缺少 __yh_test_assert 运行时入口")
    }
    let callee gen.Res
    gen.sem_res_reset(&callee, gs.task.c_syms[sym].type_id)
    callee.sym = sym
    if (gen.sem_call_begin(&callee) != 1) {
        return gen.sem_err("内部错误：测试断言入口不是直接函数")
    }
    if (gen.sem_push_arg(condition, &callee) != 0) { return -1 }
    // 生成的实参节点与实参链统一使用断言调用的 token 范围：实参链按追加
    // 顺序逐层包住前一项，若各实参范围互不包含会让父节点范围校验失败。
    let lit_first int = first
    let lit_last int = after
    let line_res gen.Res
    if (parse_test_assert_lit(&line_res, gen.TY_I32, line.to_type(i64),
            lit_first, lit_last) != 0) { return -1 }
    if (gen.sem_push_arg(&line_res, &callee) != 0) { return -1 }
    let col_res gen.Res
    if (parse_test_assert_lit(&col_res, gen.TY_I32, col.to_type(i64),
            lit_first, lit_last) != 0) { return -1 }
    if (gen.sem_push_arg(&col_res, &callee) != 0) { return -1 }
    if (gen.sem_push_arg(msg, &callee) != 0) { return -1 }
    if (gen.sem_call(&callee, res) != 0) { return -1 }
    if (gs.task.c_ast_capture == 0) { return 0 }
    let args int = -1
    if (ast.ast_expr_assert_args_add(&args, condition.ast_id, line_res.ast_id,
            col_res.ast_id, msg.ast_id, first, after) != 0) { return -1 }
    let callee_ast int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, gen.TOK_IDENT,
        first, after, callee.type_id, -1, -1, -1)
    if (callee_ast < 0 || ast.ast_expr_set_semantics(callee_ast, &callee) != 0) {
        return -1
    }
    let call_ast int = ast.ast_expr_add(ast.AST_EXPR_CALL, gen.TK_LPAREN,
        first, after, res.type_id, callee_ast, args, -1)
    if (call_ast < 0 || ast.ast_expr_set_semantics(call_ast, res) != 0) {
        return -1
    }
    res.ast_id = call_ast
    return 0
}

// parse_comptime_diag_call：解析诊断实参并返回待独立语句消费的 void 标记结果。
fn parse_comptime_diag_call(res *gen.Res, kind int, line int, col int) int {
    let gs *gen.GenState = gen.G()
    let first int = gs.task.c_pos
    p_adv() // 诊断名
    if (p_expect(gen.TK_LPAREN, "编译期诊断调用期望 '('") != 0) { return -1 }
    let condition gen.Res
    let msg_start int = -1
    let msg_len int = 0
    if (kind == gen.CT_DIAG_ASSERT) {
        let saved_fold int = gs.task.c_fold
        let ct_body int = (gs.task.c_fn_flags & gen.F_COMPTIME) != 0
        // test 体里的断言是运行期检查（YT2 接执行器）；先按普通表达式
        // 解析，不做强制常量折叠，否则 helper(...) 会被误判为非常量。
        if (gs.task.c_compile != 0 && ct_body == 0 && gs.task.c_test_body == 0) {
            gs.task.c_fold += 1
        }
        let cr int = parse_expr_iso(&condition)
        gs.task.c_fold = saved_fold
        if (cr != 0) { return -1 }
        if (gs.task.c_compile != 0) {
            if (condition.ct_diag != 0) {
                return gen.sem_err("编译期诊断不能嵌套使用")
            }
            if (condition.type_id != gen.TY_BOOL) {
                return gen.sem_err("$assert 条件必须是 bool")
            }
            if (ct_body == 0 && condition.is_const == 0
                && gs.task.c_test_body == 0) {
                return gen.sem_err("$assert 条件必须是编译期常量")
            }
        }
        if (gs.task.c_test_body != 0) {
            // test 体：把断言降成运行期调用，消息可省略；调用本身是独立语句。
            let msg gen.Res
            if (p_cur() == gen.TK_COMMA) {
                p_adv()
                if (p_cur() != gen.TOK_STRING) {
                    return gen.err_tok("$assert 消息必须是字符串文字量")
                }
                if (parse_expr_iso(&msg) != 0) { return -1 }
            } else {
                if (parse_test_assert_lit(&msg, gen.ty_ptr(gen.TY_CHAR), 0,
                        first, gs.task.c_pos) != 0) { return -1 }
            }
            if (p_expect(gen.TK_RPAREN, "编译期诊断调用期望 ')'") != 0) { return -1 }
            return parse_test_assert_call(res, &condition, &msg, line, col,
                first, gs.task.c_pos)
        }
        if (gs.task.c_ast_capture != 0 && condition.ast_id >= 0
            && ast.ast_stmt_add_expr(condition.ast_id) != 0) { return -1 }
        if (p_cur() == gen.TK_COMMA) {
            p_adv()
            if (p_cur() != gen.TOK_STRING) {
                return gen.err_tok("$assert 消息必须是字符串文字量")
            }
            msg_start = gs.task.c_toks[gs.task.c_pos].start
            msg_len = gs.task.c_toks[gs.task.c_pos].len
            p_adv()
        }
    } else {
        if (p_cur() != gen.TOK_STRING) {
            return gen.err_tok("编译期诊断需要一个字符串文字量")
        }
        msg_start = gs.task.c_toks[gs.task.c_pos].start
        msg_len = gs.task.c_toks[gs.task.c_pos].len
        p_adv()
    }
    if (p_expect(gen.TK_RPAREN, "编译期诊断调用期望 ')'") != 0) { return -1 }
    gen.sem_res_reset(res, gen.TY_VOID)
    res.ct_diag = kind
    res.ct_diag_expr = kind == gen.CT_DIAG_ASSERT ? condition.ast_id : -1
    res.ct_diag_line = line
    res.ct_diag_col = col
    res.ct_diag_msg_start = msg_start
    res.ct_diag_msg_len = msg_len
    if (kind == gen.CT_DIAG_ASSERT && gs.task.c_compile != 0) {
        res.ival = (condition.ival != 0).to_type(i64)
    }
    return 0
}
