module parse;
import gen;
import ir;
import backend;

// ast_ir_release_built：释放 builder 转移后的堆表；types 指向当前栈内固定表。
fn ast_ir_release_built(f *ir.IRFunction) void {
    if (f == 0) { return; }
    f.types = 0;
    ir.ir_function_release(f);
}
// AstIRBuilder：单个函数 lowering 的全部可变状态。
pub struct AstIRBuilder {
    insts *ir.IRInst;          // 指令表（跨块连续存放）
    inst_count int;
    inst_cap int;
    blocks *ir.IRBlock;        // CFG 块表，下标即块编号
    block_count int;
    block_cap int;
    phis *ir.IRPhi;            // phi 输入片段表
    phi_count int;
    phi_cap int;
    phi_inputs *ir.IRPhiInput; // 所有 phi 的前驱输入
    phi_input_count int;
    phi_input_cap int;
    calls AstIRCalls;          // 直接调用表（复用既有缓冲协议）
    local_values *int;         // binding.id → 当前 SSA 值
    binding_count int;
    binding_first int;         // 本函数绑定在 ast_bindings 表中的起始行
    param_count int;
    local_count int;           // 已遍历的 let 数（绑定编号顺序校验）
    ret_ir_type int;           // 函数返回类型的 IR 编号；void 为 IR_TY_VOID
    types *ir.IRType;          // 函数私有 IR 类型表（由 lower_function 持有）
    cur_block int;             // 当前开放块；-1 = 所有路径已终结
    is_discovery int;          // 1 = 循环发现趟（只记结构，不复用产物）
    // 循环上下文（本切片不支持嵌套循环：再次遇到 for 即回退）
    break_target int;          // 退出块；-1 = 不在循环内
    continue_target int;       // 循环头块
    loop_header int;           // 本循环 header（continue 边的来源标记用）
    loop_preheader int;        // 进入循环前的块（phi 首输入前驱）
    carry_rows *int;           // 携带绑定的 AST 绑定行列表
    carry_count int;
    carry_cap int;
    carry_phis *int;           // real 趟：各携带绑定的 header phi 指令编号
    continue_done int;         // real 趟：已创建的 continue 边数
    break_done int;            // real 趟：已创建的 break 边数
    break_blocks *int;         // real 趟：各 break 站点块
    break_vals *int;           // real 趟：break 站点的携带值快照
    loop_has_latch int;        // 发现趟结论：体是否贯穿（有回边）
    loop_input_count int;      // 发现趟结论：header phi 每条输入数
    loop_continue_count int;   // 发现趟结论：continue 站点数
    loop_break_count int;      // 发现趟结论：break 站点数
}

// ast_ir_build.yh —— 函数级通用 SSA 构造器。
// 以递归下降方式把受支持的语句序列降低为 typed SSA：顺序语句、
// if/else（任意嵌套）、条件循环 for cond、break/continue 与 return。
// 形态之外的语句种类返回 -2，由调用方回退旧发射器。
//
// 循环采用两趟协议：第一趟在一次性 builder 里发现循环体的结构事实
// （携带绑定、continue/break 站点数、体是否贯穿），第二趟按发现的事实
// 预留 header phi 输入并真实降低；两趟执行同一份代码，保证一致。




// ast_ir_b_init：分配 builder 的初始缓冲；内存不足时 insts/local_values 为空。
// binding_first/ret_ir_type 由调用方在初始化后补齐。
fn ast_ir_b_init(b *AstIRBuilder, param_count int, binding_count int,
    inst_cap int) int {
    b.insts = 0;
    b.inst_count = 0;
    b.inst_cap = 0;
    b.blocks = 0;
    b.block_count = 0;
    b.block_cap = 0;
    b.phis = 0;
    b.phi_count = 0;
    b.phi_cap = 0;
    b.phi_inputs = 0;
    b.phi_input_count = 0;
    b.phi_input_cap = 0;
    ast_ir_call_init(&b.calls);
    b.local_values = 0;
    b.binding_count = binding_count;
    b.binding_first = -1;
    b.param_count = param_count;
    b.local_count = 0;
    b.ret_ir_type = ir.IR_TY_VOID;
    b.types = 0;
    b.cur_block = -1;
    b.is_discovery = 0;
    b.break_target = -1;
    b.continue_target = -1;
    b.loop_header = -1;
    b.loop_preheader = -1;
    b.carry_rows = 0;
    b.carry_count = 0;
    b.carry_cap = 0;
    b.carry_phis = 0;
    b.continue_done = 0;
    b.break_done = 0;
    b.break_blocks = 0;
    b.break_vals = 0;
    b.loop_has_latch = 0;
    b.loop_input_count = 0;
    b.loop_continue_count = 0;
    b.loop_break_count = 0;
    if (binding_count > 0) {
        b.local_values = malloc((binding_count * sizeof(int)).to_type(u64)).to_type(*int);
        if (b.local_values == 0) { return -1; }
        let i int = 0;
        for i < binding_count {
            b.local_values[i] = -1;
            i += 1;
        }
    }
    if (ast_ir_b_reserve_insts(b, inst_cap) != 0) { return -1; }
    if (ast_ir_b_reserve_blocks(b, 8) != 0) { return -1; }
    if (ast_ir_b_reserve_phis(b, 8, 16) != 0) { return -1; }
    return 0;
}

// ast_ir_b_release：释放 builder 全部缓冲（含发现趟/real 趟的循环表）。
fn ast_ir_b_release(b *AstIRBuilder) void {
    if (b.insts != 0) { free(b.insts.to_type(*void)); }
    if (b.blocks != 0) { free(b.blocks.to_type(*void)); }
    if (b.phis != 0) { free(b.phis.to_type(*void)); }
    if (b.phi_inputs != 0) { free(b.phi_inputs.to_type(*void)); }
    if (b.local_values != 0) { free(b.local_values.to_type(*void)); }
    if (b.carry_rows != 0) { free(b.carry_rows.to_type(*void)); }
    if (b.carry_phis != 0) { free(b.carry_phis.to_type(*void)); }
    if (b.break_blocks != 0) { free(b.break_blocks.to_type(*void)); }
    if (b.break_vals != 0) { free(b.break_vals.to_type(*void)); }
    ast_ir_call_release(&b.calls);
    b.insts = 0;
    b.blocks = 0;
    b.phis = 0;
    b.phi_inputs = 0;
    b.local_values = 0;
    b.carry_rows = 0;
    b.carry_phis = 0;
    b.break_blocks = 0;
    b.break_vals = 0;
}

// ast_ir_b_reserve_insts：按需扩容指令表，保留既有内容。
fn ast_ir_b_reserve_insts(b *AstIRBuilder, need int) int {
    if (need <= b.inst_cap) { return 0; }
    let next_cap int = b.inst_cap == 0 ? 16 : b.inst_cap * 2;
    for next_cap < need { next_cap *= 2; }
    let next *ir.IRInst = malloc((next_cap * sizeof(ir.IRInst)).to_type(u64)).to_type(*ir.IRInst);
    if (next == 0) { return -1; }
    if (b.inst_count > 0) { memcpy(next, b.insts, (b.inst_count * sizeof(ir.IRInst)).to_type(u64)); }
    if (b.insts != 0) { free(b.insts.to_type(*void)); }
    b.insts = next;
    b.inst_cap = next_cap;
    return 0;
}

// ast_ir_b_reserve_blocks：按需扩容块表。
fn ast_ir_b_reserve_blocks(b *AstIRBuilder, need int) int {
    if (need <= b.block_cap) { return 0; }
    let next_cap int = b.block_cap == 0 ? 8 : b.block_cap * 2;
    for next_cap < need { next_cap *= 2; }
    let next *ir.IRBlock = malloc((next_cap * sizeof(ir.IRBlock)).to_type(u64)).to_type(*ir.IRBlock);
    if (next == 0) { return -1; }
    if (b.block_count > 0) { memcpy(next, b.blocks, (b.block_count * sizeof(ir.IRBlock)).to_type(u64)); }
    if (b.blocks != 0) { free(b.blocks.to_type(*void)); }
    b.blocks = next;
    b.block_cap = next_cap;
    return 0;
}

// ast_ir_b_reserve_phis：按需扩容 phi 片段表与输入表。
fn ast_ir_b_reserve_phis(b *AstIRBuilder, need_phis int, need_inputs int) int {
    if (need_phis > b.phi_cap) {
        let next_cap int = b.phi_cap == 0 ? 8 : b.phi_cap * 2;
        for next_cap < need_phis { next_cap *= 2; }
        let next *ir.IRPhi = malloc((next_cap * sizeof(ir.IRPhi)).to_type(u64)).to_type(*ir.IRPhi);
        if (next == 0) { return -1; }
        if (b.phi_count > 0) { memcpy(next, b.phis, (b.phi_count * sizeof(ir.IRPhi)).to_type(u64)); }
        if (b.phis != 0) { free(b.phis.to_type(*void)); }
        b.phis = next;
        b.phi_cap = next_cap;
    }
    if (need_inputs > b.phi_input_cap) {
        let next_cap2 int = b.phi_input_cap == 0 ? 16 : b.phi_input_cap * 2;
        for next_cap2 < need_inputs { next_cap2 *= 2; }
        let next2 *ir.IRPhiInput = malloc((next_cap2 * sizeof(ir.IRPhiInput)).to_type(u64)).to_type(*ir.IRPhiInput);
        if (next2 == 0) { return -1; }
        if (b.phi_input_count > 0) { memcpy(next2, b.phi_inputs, (b.phi_input_count * sizeof(ir.IRPhiInput)).to_type(u64)); }
        if (b.phi_inputs != 0) { free(b.phi_inputs.to_type(*void)); }
        b.phi_inputs = next2;
        b.phi_input_cap = next_cap2;
    }
    return 0;
}

// ast_ir_b_alloc_block：分配空块编号；first_inst 延迟到进入块时确定，
// 使乱序填充（先分配合流块、后追加指令）也能得到正确区间。
fn ast_ir_b_alloc_block(b *AstIRBuilder) int {
    if (ast_ir_b_reserve_blocks(b, b.block_count + 1) != 0) { return -1; }
    let id int = b.block_count;
    b.blocks[id].id = id;
    b.blocks[id].first_inst = -1;
    b.blocks[id].inst_count = 0;
    b.blocks[id].term = ir.IR_TERM_UNREACHABLE;
    b.blocks[id].term_value = -1;
    b.blocks[id].succ0 = -1;
    b.blocks[id].succ1 = -1;
    b.block_count += 1;
    return id;
}

// ast_ir_b_enter_block：封存当前开放块的指令数并切换到目标块。
// 目标块首次进入时确定其指令起点。
fn ast_ir_b_enter_block(b *AstIRBuilder, id int) int {
    if (b.cur_block >= 0) {
        b.blocks[b.cur_block].inst_count = b.inst_count - b.blocks[b.cur_block].first_inst;
    }
    if (id >= 0 && b.blocks[id].first_inst < 0) {
        b.blocks[id].first_inst = b.inst_count;
    }
    b.cur_block = id;
    return 0;
}

// ast_ir_b_close_term：为指定块写终结符并封存其指令范围。
// block_id 可以是当前开放块（此时计算指令数），也可以是已封存的块
// （乱序合流时仅回填终结字段）。
fn ast_ir_b_close_term(b *AstIRBuilder, block_id int, term int, value int,
    succ0 int, succ1 int) int {
    if (block_id < 0 || block_id >= b.block_count
        || b.blocks[block_id].first_inst < 0) { return -1; }
    if (b.cur_block == block_id) {
        b.blocks[block_id].inst_count = b.inst_count - b.blocks[block_id].first_inst;
        b.cur_block = -1;
    } else if (b.blocks[block_id].term != ir.IR_TERM_UNREACHABLE
        || b.blocks[block_id].succ0 != -1) {
        // 已写过往终结符：重复封存说明构造器状态错误。
        return -1;
    }
    b.blocks[block_id].term = term;
    b.blocks[block_id].term_value = value;
    b.blocks[block_id].succ0 = succ0;
    b.blocks[block_id].succ1 = succ1;
    return 0;
}

// ast_ir_b_add_inst：向当前开放块追加一条定义值的指令。
fn ast_ir_b_add_inst(b *AstIRBuilder, op int, type_id int, a int, b2 int,
    imm i64) int {
    if (ast_ir_b_reserve_insts(b, b.inst_count + 1) != 0) { return -1; }
    return ast_ir_add_inst(b.insts, &b.inst_count, b.inst_cap,
        op, type_id, a, b2, imm);
}

// ast_ir_b_add_call：向当前开放块追加 CALL；result_type < 0 表示 void 调用。
fn ast_ir_b_add_call(b *AstIRBuilder, call_id int, result_type int) int {
    if (ast_ir_b_reserve_insts(b, b.inst_count + 1) != 0) { return -1; }
    if (result_type < 0) {
        return ast_ir_add_noresult_inst(b.insts, &b.inst_count, b.inst_cap,
            ir.IR_OP_CALL, call_id);
    }
    let id int = ast_ir_add_inst(b.insts, &b.inst_count, b.inst_cap,
        ir.IR_OP_CALL, result_type, -1, -1, 0);
    if (id < 0) { return -1; }
    b.insts[id].aux = call_id;
    return id;
}

// ast_ir_b_add_phi：在当前开放块创建带 input_count 个预留输入的 phi。
// 输入值由调用方按边序回填；预留段在 phi_input 表中连续。
fn ast_ir_b_add_phi(b *AstIRBuilder, type_id int, input_count int) int {
    if (ast_ir_b_reserve_phis(b, b.phi_count + 1,
        b.phi_input_count + input_count) != 0) { return -1; }
    if (ast_ir_b_reserve_insts(b, b.inst_count + 1) != 0) { return -1; }
    let phi_id int = b.phi_count;
    let input_first int = b.phi_input_count;
    b.phis[phi_id].first = input_first;
    b.phis[phi_id].count = input_count;
    let i int = 0;
    for i < input_count {
        b.phi_inputs[input_first + i].pred = -1;
        b.phi_inputs[input_first + i].value = -1;
        i += 1;
    }
    b.phi_input_count += input_count;
    let id int = b.inst_count;
    b.insts[id].op = ir.IR_OP_PHI;
    b.insts[id].result_id = id;
    b.insts[id].result_type = type_id;
    b.insts[id].a = -1;
    b.insts[id].b = -1;
    b.insts[id].imm = 0;
    b.insts[id].aux = phi_id;
    b.inst_count += 1;
    b.phi_count += 1;
    return id;
}

// ast_ir_b_set_phi_input：回填 phi 的第 slot 条边输入。
fn ast_ir_b_set_phi_input(b *AstIRBuilder, phi_inst int, slot int,
    pred int, value int) int {
    if (phi_inst < 0 || phi_inst >= b.inst_count) { return -1; }
    let phi_index int = b.insts[phi_inst].aux;
    if (phi_index < 0 || phi_index >= b.phi_count) { return -1; }
    let phi ir.IRPhi = b.phis[phi_index];
    if (slot < 0 || slot >= phi.count) { return -1; }
    b.phi_inputs[phi.first + slot].pred = pred;
    b.phi_inputs[phi.first + slot].value = value;
    return 0;
}

// ast_ir_b_term_br：以无条件分支封存当前块并切换目标。
fn ast_ir_b_term_br(b *AstIRBuilder, succ int) int {
    if (b.cur_block < 0) { return -1; }
    b.blocks[b.cur_block].inst_count = b.inst_count - b.blocks[b.cur_block].first_inst;
    b.blocks[b.cur_block].term = ir.IR_TERM_BR;
    b.blocks[b.cur_block].term_value = -1;
    b.blocks[b.cur_block].succ0 = succ;
    b.blocks[b.cur_block].succ1 = -1;
    b.cur_block = -1;
    return 0;
}

// ast_ir_b_term_cond：以条件分支封存当前块。
fn ast_ir_b_term_cond(b *AstIRBuilder, value int, succ0 int, succ1 int) int {
    if (b.cur_block < 0) { return -1; }
    b.blocks[b.cur_block].inst_count = b.inst_count - b.blocks[b.cur_block].first_inst;
    b.blocks[b.cur_block].term = ir.IR_TERM_COND_BR;
    b.blocks[b.cur_block].term_value = value;
    b.blocks[b.cur_block].succ0 = succ0;
    b.blocks[b.cur_block].succ1 = succ1;
    b.cur_block = -1;
    return 0;
}

// ast_ir_b_term_ret：以返回封存当前块；value < 0 表示 void 返回。
fn ast_ir_b_term_ret(b *AstIRBuilder, value int) int {
    if (b.cur_block < 0) { return -1; }
    b.blocks[b.cur_block].inst_count = b.inst_count - b.blocks[b.cur_block].first_inst;
    b.blocks[b.cur_block].term = ir.IR_TERM_RET;
    b.blocks[b.cur_block].term_value = value;
    b.blocks[b.cur_block].succ0 = -1;
    b.blocks[b.cur_block].succ1 = -1;
    b.cur_block = -1;
    return 0;
}

// ast_ir_b_expr：表达式降低入口（含短路求值）。
fn ast_ir_b_expr(b *AstIRBuilder, ctx *AstFunctionContext, expr_id int) int {
    return ast_ir_lower_expr(b, ctx, expr_id);
}

// ast_ir_b_cond：降低条件表达式并归一化为 IR bool。
// bool 直接使用；整数按「非零为真」与零常量比较，匹配旧发射器语义。
fn ast_ir_b_cond(b *AstIRBuilder, ctx *AstFunctionContext, expr_id int) int {
    let value int = ast_ir_lower_expr(b, ctx, expr_id);
    if (value == -2) { return -2; }
    if (value < 0) { return value; }
    let value_type int = b.insts[value].result_type;
    if (b.types[value_type].kind == ir.IR_TY_BOOL) { return value; }
    let zero int = ast_ir_b_add_inst(b, ir.IR_OP_CONST, value_type, -1, -1, 0);
    if (zero < 0) { return -1; }
    return ast_ir_b_add_inst(b, ir.IR_OP_NE, ir.IR_TY_BOOL, value, zero, 0);
}

// ast_ir_b_carry_record：发现趟中记录体内被赋值的绑定行（去重）。
fn ast_ir_b_carry_record(b *AstIRBuilder, binding_row int) int {
    let i int = 0;
    for i < b.carry_count {
        if (b.carry_rows[i] == binding_row) { return 0; }
        i += 1;
    }
    if (b.carry_count >= b.carry_cap) {
        let next_cap int = b.carry_cap == 0 ? 8 : b.carry_cap * 2;
        let next *int = malloc((next_cap * sizeof(int)).to_type(u64)).to_type(*int);
        if (next == 0) { return -1; }
        if (b.carry_count > 0) { memcpy(next, b.carry_rows, (b.carry_count * sizeof(int)).to_type(u64)); }
        if (b.carry_rows != 0) { free(b.carry_rows.to_type(*void)); }
        b.carry_rows = next;
        b.carry_cap = next_cap;
    }
    b.carry_rows[b.carry_count] = binding_row;
    b.carry_count += 1;
    return 0;
}

// ast_ir_b_loop_body_facts：发现趟——直接在主 builder 上降低循环体，
// 收集结构事实（携带绑定、continue/break 站点数、是否贯穿）后回滚全部
// 计数，使真实降低从干净状态开始。值编号与主 builder 一致，复合赋值等
// 依赖既有值 ID 的校验在发现趟中同样有效。
// 返回 0 成功；负数沿用语句降低的错误协议（-2 = 形态不支持）。
fn ast_ir_b_loop_body_facts(b *AstIRBuilder, ctx *AstFunctionContext,
    body_stmt int) int {
    b.carry_count = 0;
    let mark_inst int = b.inst_count;
    let mark_phi int = b.phi_count;
    let mark_pinput int = b.phi_input_count;
    let mark_block int = b.block_count;
    let mark_cur int = b.cur_block;
    let mark_local int = b.local_count;
    let mark_call int = b.calls.call_count;
    let mark_arg int = b.calls.arg_count;
    let mark_sym int = b.calls.symbol_size;
    let mark_values *int = malloc((b.binding_count * sizeof(int)).to_type(u64)).to_type(*int);
    if (mark_values == 0) { return -1; }
    let vi int = 0;
    for vi < b.binding_count {
        mark_values[vi] = b.local_values[vi];
        vi += 1;
    }
    // 哑目标块承接 break/continue；体的起点也是一次性哑块，
    // 进入它会把 preheader 的指令范围正确封存。
    let break_b int = ast_ir_b_alloc_block(b);
    let cont_b int = ast_ir_b_alloc_block(b);
    let entry_b int = ast_ir_b_alloc_block(b);
    if (break_b < 0 || cont_b < 0 || entry_b < 0) {
        free(mark_values.to_type(*void));
        return -1;
    }
    let old_break int = b.break_target;
    let old_cont int = b.continue_target;
    let old_disc int = b.is_discovery;
    b.break_target = break_b;
    b.continue_target = cont_b;
    b.is_discovery = 1;
    b.continue_done = 0;
    b.break_done = 0;
    ast_ir_b_enter_block(b, entry_b);
    let status int = ast_ir_b_stmts(b, ctx,
        ast_stmt_nodes[body_stmt].first_child);

    // 记录事实后回滚。
    let cont_sites int = b.continue_done;
    let break_sites int = b.break_done;
    b.break_target = old_break;
    b.continue_target = old_cont;
    b.is_discovery = old_disc;
    b.cur_block = mark_cur;
    b.local_count = mark_local;
    b.inst_count = mark_inst;
    b.phi_count = mark_phi;
    b.phi_input_count = mark_pinput;
    b.block_count = mark_block;
    b.calls.call_count = mark_call;
    b.calls.arg_count = mark_arg;
    b.calls.symbol_size = mark_sym;
    vi = 0;
    for vi < b.binding_count {
        b.local_values[vi] = mark_values[vi];
        vi += 1;
    }
    free(mark_values.to_type(*void));
    if (status < 0) { return status; }
    b.loop_continue_count = cont_sites;
    b.loop_break_count = break_sites;
    b.loop_has_latch = status == 1 ? 1 : 0;
    b.loop_input_count = 1 + cont_sites + b.loop_has_latch;
    return 0;
}

// ast_ir_b_stmts：降低语句序列到当前开放块。
// 返回 1 = 存在贯穿到序列尾的路径（当前块开放），0 = 所有路径已终结
// （后续不可达语句丢弃），-1 = 内部错误，-2 = 形态不支持（回退旧发射器）。
fn ast_ir_b_stmts(b *AstIRBuilder, ctx *AstFunctionContext, stmt_id int) int {
    for stmt_id >= 0 {
        let stmt AstStmt = ast_stmt_nodes[stmt_id];
        if (stmt.kind == AST_STMT_DECL) {
            if (ast_ir_let_supported(ctx, stmt_id, b.param_count,
                b.local_count) == 0) { return -2; }
            let binding AstBinding = ast_bindings[stmt.first_binding];
            let init_expr int = ast_stmt_exprs[stmt.first_expr].expr_id;
            let value int = ast_ir_b_expr(b, ctx, init_expr);
            if (value == -2) { return -2; }
            if (value < 0 || value >= b.inst_count) {
                return gen.fail("内部错误：SSA 局部初值降低失败");
            }
            if (b.insts[value].result_type != ast_ir_type(binding.sym_type_id)) {
                return -2;
            }
            b.local_values[binding.id] = value;
            b.local_count += 1;
        } else if (stmt.kind == AST_STMT_ASSIGN) {
            let binding_row int = ast_ir_assign_binding(ctx, stmt_id,
                b.param_count, b.binding_count);
            if (binding_row < 0) { return -2; }
            if (b.break_target >= 0) {
                // 循环体内赋值的外部绑定参与循环携带（real 趟去重）。
                if (ast_ir_b_carry_record(b, binding_row) != 0) { return -1; }
            }
            let lowered int = ast_ir_lower_assign_stmt(b, ctx, stmt_id,
                b.binding_count);
            if (lowered == -2) { return -2; }
            if (lowered < 0) { return lowered; }
            if (lowered == 0) { return -2; }
        } else if (stmt.kind == AST_STMT_EXPR) {
            let emitted int = ast_ir_lower_expr_stmt(b, ctx, stmt_id,
                b.param_count, b.binding_count);
            if (emitted == -3) { return 0; }
            if (emitted == -2) { return -2; }
            if (emitted < 0) { return emitted; }
            if (emitted == 0) { return -2; }
        } else if (stmt.kind == AST_STMT_RETURN) {
            // 返回语句：非 void 须有单表达式边，void 只接受裸 return;。
            if (stmt.first_expr < ctx.edge_first || stmt.first_expr >= ctx.edge_after) {
                if (b.ret_ir_type != ir.IR_TY_VOID) { return -2; }
                if (ast_ir_b_close_term(b, b.cur_block, ir.IR_TERM_RET, -1, -1, -1) != 0) {
                    return -1;
                }
                return 0;
            }
            if (stmt.first_expr != stmt.last_expr
                || ast_stmt_exprs[stmt.first_expr].next >= 0) {
return -2;
            }
            let ret_expr int = ast_stmt_exprs[stmt.first_expr].expr_id;
            let value int = ast_ir_b_expr(b, ctx, ret_expr);
            if (value == -2) {
return -2;
            }
            if (value < 0 || value >= b.inst_count) {
                return gen.fail("内部错误：SSA 返回值降低失败");
            }
            if (b.insts[value].result_type != b.ret_ir_type) {
return -2;
            }
            if (ast_ir_b_close_term(b, b.cur_block, ir.IR_TERM_RET, value, -1, -1) != 0) {
                return -1;
            }
            return 0;
        } else if (stmt.kind == AST_STMT_IF) {
            let status int = ast_ir_b_if(b, ctx, stmt_id);
            if (status != 1) { return status; }
        } else if (stmt.kind == AST_STMT_FOR) {
            let status int = ast_ir_b_for(b, ctx, stmt_id);
            if (status != 1) { return status; }
        } else if (stmt.kind == AST_STMT_BLOCK) {
            let status int = ast_ir_b_stmts(b, ctx, stmt.first_child);
            if (status != 1) { return status; }
        } else if (stmt.kind == AST_STMT_BREAK) {
            if (b.break_target < 0) { return -2; }
            if (b.is_discovery == 0) {
                if (b.break_done >= b.loop_break_count) { return -1; }
                let j int = 0;
                for j < b.carry_count {
                    let binding AstBinding = ast_bindings[b.carry_rows[j]];
                    b.break_vals[b.break_done * b.carry_count + j] =
                        b.local_values[binding.id];
                    j += 1;
                }
                b.break_blocks[b.break_done] = b.cur_block;
            }
            b.break_done += 1;
            if (ast_ir_b_close_term(b, b.cur_block, ir.IR_TERM_BR, -1,
                b.break_target, -1) != 0) { return -1; }
            return 0;
        } else if (stmt.kind == AST_STMT_CONTINUE) {
            if (b.continue_target < 0) { return -2; }
            if (b.is_discovery == 0) {
                if (b.continue_done >= b.loop_continue_count) { return -1; }
                let j int = 0;
                for j < b.carry_count {
                    let binding AstBinding = ast_bindings[b.carry_rows[j]];
                    if (ast_ir_b_set_phi_input(b, b.carry_phis[j],
                        1 + b.continue_done, b.cur_block,
                        b.local_values[binding.id]) != 0) { return -1; }
                    j += 1;
                }
            }
            b.continue_done += 1;
            if (ast_ir_b_close_term(b, b.cur_block, ir.IR_TERM_BR, -1,
                b.continue_target, -1) != 0) { return -1; }
            return 0;
        } else {
            return -2;
        }
        if (b.cur_block < 0) { return 0; }
        stmt_id = stmt.next_sibling;
    }
    return 1;
}

// ast_ir_b_merge_values：把两侧臂值合流到主副本；值不同的绑定在当前块
// 建 phi（双前驱），相同的直接沿用。调用方须已进入 join 块。返回 0 成功。
fn ast_ir_b_merge_values(b *AstIRBuilder, pred0 int, values0 *int,
    pred1 int, values1 *int) int {
    let bi int = 0;
    for bi < b.binding_count {
        if (values0[bi] == values1[bi]) {
            b.local_values[bi] = values0[bi];
            bi += 1;
            continue;
        }
        let value_type int = ast_ir_type(ast_bindings[b.binding_first + bi].sym_type_id);
        let phi int = ast_ir_b_add_phi(b, value_type, 2);
        if (phi < 0) { return -1; }
        if (ast_ir_b_set_phi_input(b, phi, 0, pred0, values0[bi]) != 0
            || ast_ir_b_set_phi_input(b, phi, 1, pred1, values1[bi]) != 0) {
            return -1;
        }
        b.local_values[bi] = phi;
        bi += 1;
    }
    return 0;
}

// ast_ir_b_if：降低 if/else 语句（else 允许接 if 形成链）。
// 返回协议与 ast_ir_b_stmts 相同。
fn ast_ir_b_if(b *AstIRBuilder, ctx *AstFunctionContext, stmt_id int) int {
    let stmt AstStmt = ast_stmt_nodes[stmt_id];
    if (stmt.first_expr < ctx.edge_first || stmt.first_expr >= ctx.edge_after
        || stmt.first_expr != stmt.last_expr
        || ast_stmt_exprs[stmt.first_expr].next >= 0) {
        return -2;
    }
    let cond_expr int = ast_stmt_exprs[stmt.first_expr].expr_id;
    // 条件可为 bool 或整数（归一化按非零为真）；形如聚合的比较仍回退。
    if (ast_ir_type(ast_expr_nodes[cond_expr].type_id) < 0) {
        return -2;
    }
    let then_stmt int = stmt.first_child;
    if (then_stmt < 0 || ast_stmt_nodes[then_stmt].kind != AST_STMT_BLOCK) {
        return -2;
    }
    let else_stmt int = ast_stmt_nodes[then_stmt].next_sibling;
    if (else_stmt >= 0 && else_stmt != stmt.last_child) { return -2; }
    let has_else int = else_stmt >= 0 ? 1 : 0;
    if (has_else != 0 && ast_stmt_nodes[else_stmt].kind != AST_STMT_BLOCK
        && ast_stmt_nodes[else_stmt].kind != AST_STMT_IF) { return -2; }

    let cond_value int = ast_ir_b_cond(b, ctx, cond_expr);
    if (cond_value == -2) {
        return -2;
    }
    if (cond_value < 0 || cond_value >= b.inst_count) {
        return gen.fail("内部错误：SSA 分支条件降低失败");
    }

    let preheader int = b.cur_block;
    let then_b int = ast_ir_b_alloc_block(b);
    let else_b int = -1;
    let join_b int = -1;
    if (has_else != 0) {
        else_b = ast_ir_b_alloc_block(b);
        if (then_b < 0 || else_b < 0) { return -1; }
        if (ast_ir_b_close_term(b, preheader, ir.IR_TERM_COND_BR,
            cond_value, then_b, else_b) != 0) { return -1; }
    } else {
        join_b = ast_ir_b_alloc_block(b);
        if (then_b < 0 || join_b < 0) { return -1; }
        if (ast_ir_b_close_term(b, preheader, ir.IR_TERM_COND_BR,
            cond_value, then_b, join_b) != 0) { return -1; }
    }

    // then 臂在独立值副本上降低。
    let then_vals *int = malloc((b.binding_count * sizeof(int)).to_type(u64)).to_type(*int);
    if (then_vals == 0) { return -1; }
    let main_values *int = b.local_values;
    let vi int = 0;
    for vi < b.binding_count {
        then_vals[vi] = main_values[vi];
        vi += 1;
    }
    b.local_values = then_vals;
    ast_ir_b_enter_block(b, then_b);
    // 只降低 then 块的子语句链；块节点本身不是链的一部分。
    let fall_then int = ast_ir_b_stmts(b, ctx,
        ast_stmt_nodes[then_stmt].first_child);
    if (fall_then < 0) {
        b.local_values = main_values;
        free(then_vals.to_type(*void));
        return fall_then;
    }
    let open_then int = fall_then == 1 ? b.cur_block : -1;
    b.local_values = main_values;

    let else_vals *int = 0;
    let fall_else int = 0;
    let open_else int = -1;
    if (has_else != 0) {
        else_vals = malloc((b.binding_count * sizeof(int)).to_type(u64)).to_type(*int);
        if (else_vals == 0) {
            free(then_vals.to_type(*void));
            return -1;
        }
        vi = 0;
        for vi < b.binding_count {
            else_vals[vi] = main_values[vi];
            vi += 1;
        }
        b.local_values = else_vals;
        ast_ir_b_enter_block(b, else_b);
        // else 可以是块（降其子链）或 if 语句（else-if 链，单语句链）。
        if (ast_stmt_nodes[else_stmt].kind == AST_STMT_BLOCK) {
            fall_else = ast_ir_b_stmts(b, ctx,
                ast_stmt_nodes[else_stmt].first_child);
        } else {
            fall_else = ast_ir_b_stmts(b, ctx, else_stmt);
        }
        if (fall_else < 0) {
            b.local_values = main_values;
            free(then_vals.to_type(*void));
            free(else_vals.to_type(*void));
            return fall_else;
        }
        open_else = fall_else == 1 ? b.cur_block : -1;
        b.local_values = main_values;
    }

    // 合流：双侧贯穿建双前驱 phi；单侧贯穿直接继续；双侧终结不产生后继。
    // 顺序约束：先封存臂块，再进入 join（确定指令起点），最后建 phi。
    let status int = 1;
    if (has_else == 0) {
        if (fall_then == 1) {
            if (ast_ir_b_close_term(b, open_then, ir.IR_TERM_BR, -1, join_b, -1) != 0) {
                free(then_vals.to_type(*void));
                return -1;
            }
            ast_ir_b_enter_block(b, join_b);
            if (ast_ir_b_merge_values(b, preheader, main_values,
                open_then, then_vals) != 0) {
                free(then_vals.to_type(*void));
                return -1;
            }
        } else {
            ast_ir_b_enter_block(b, join_b);
        }
    } else if (fall_then == 1 && fall_else == 1) {
        join_b = ast_ir_b_alloc_block(b);
        if (join_b < 0) {
            free(then_vals.to_type(*void));
            free(else_vals.to_type(*void));
            return -1;
        }
        if (ast_ir_b_close_term(b, open_else, ir.IR_TERM_BR, -1, join_b, -1) != 0
            || ast_ir_b_close_term(b, open_then, ir.IR_TERM_BR, -1, join_b, -1) != 0) {
            free(then_vals.to_type(*void));
            free(else_vals.to_type(*void));
            return -1;
        }
        ast_ir_b_enter_block(b, join_b);
        if (ast_ir_b_merge_values(b, open_then, then_vals,
            open_else, else_vals) != 0) {
            free(then_vals.to_type(*void));
            free(else_vals.to_type(*void));
            return -1;
        }
    } else if (fall_then == 1) {
        join_b = ast_ir_b_alloc_block(b);
        if (join_b < 0) {
            free(then_vals.to_type(*void));
            return -1;
        }
        if (ast_ir_b_close_term(b, open_then, ir.IR_TERM_BR, -1, join_b, -1) != 0) {
            free(then_vals.to_type(*void));
            return -1;
        }
        ast_ir_b_enter_block(b, join_b);
        let bi int = 0;
        for bi < b.binding_count {
            b.local_values[bi] = then_vals[bi];
            bi += 1;
        }
    } else if (fall_else == 1) {
        let bi2 int = 0;
        for bi2 < b.binding_count {
            b.local_values[bi2] = else_vals[bi2];
            bi2 += 1;
        }
    } else {
        status = 0;
    }
    free(then_vals.to_type(*void));
    if (else_vals != 0) { free(else_vals.to_type(*void)); }
    return status;
}

// ast_ir_b_for：降低条件循环 for cond { 体 }。
// 先在发现趟收集体的结构事实（携带绑定、continue/break 站点数、是否贯穿），
// 再按事实预留 header phi 输入并真实降低；两趟执行同一份降低代码。
// 返回协议与 ast_ir_b_stmts 相同；循环完成时当前块为退出块（贯穿）。
fn ast_ir_b_for(b *AstIRBuilder, ctx *AstFunctionContext, stmt_id int) int {
    let stmt AstStmt = ast_stmt_nodes[stmt_id];
    if (stmt.first_expr < ctx.edge_first || stmt.first_expr >= ctx.edge_after
        || stmt.first_expr != stmt.last_expr
        || ast_stmt_exprs[stmt.first_expr].next >= 0
        || stmt.first_binding >= 0) { return -2; }
    // 嵌套循环、for-in 与无限循环形态暂不支持。
    if (b.break_target >= 0) { return -2; }
    let cond_expr int = ast_stmt_exprs[stmt.first_expr].expr_id;
    if (ast_ir_type(ast_expr_nodes[cond_expr].type_id) < 0) {
        return -2;
    }
    let body_stmt int = stmt.first_child;
    if (body_stmt < 0 || body_stmt != stmt.last_child
        || body_stmt < ctx.stmt_first || body_stmt >= ctx.stmt_after
        || ast_stmt_nodes[body_stmt].kind != AST_STMT_BLOCK) {
        return -2;
    }

    // 发现趟：重置携带列表后收集本循环的结构事实。
    b.carry_count = 0;
    let facts int = ast_ir_b_loop_body_facts(b, ctx, body_stmt);
    if (facts != 0) { return facts; }

    // real 趟：入口块无条件进入循环头。
    let preheader int = b.cur_block;
    let header int = ast_ir_b_alloc_block(b);
    if (header < 0) { return -1; }
    if (ast_ir_b_close_term(b, preheader, ir.IR_TERM_BR, -1, header, -1) != 0) {
        return -1;
    }
    ast_ir_b_enter_block(b, header);

    // 携带 phi：输入槽布局为 [入口, continue×N, 回边(可选)]。
    if (b.carry_count > 0) {
        if (b.carry_phis != 0) { free(b.carry_phis.to_type(*void)); }
        b.carry_phis = malloc((b.carry_count * sizeof(int)).to_type(u64)).to_type(*int);
        if (b.carry_phis == 0) { return -1; }
    }
    let ci int = 0;
    for ci < b.carry_count {
        let binding AstBinding = ast_bindings[b.carry_rows[ci]];
        let phi int = ast_ir_b_add_phi(b, ast_ir_type(binding.sym_type_id),
            b.loop_input_count);
        if (phi < 0) { return -1; }
        b.carry_phis[ci] = phi;
        if (ast_ir_b_set_phi_input(b, phi, 0, preheader,
            b.local_values[binding.id]) != 0) { return -1; }
        b.local_values[binding.id] = phi;
        ci += 1;
    }

    // 条件在 header 内、phi 之后降低，读到的是循环携带版本。
    let cond_value int = ast_ir_b_cond(b, ctx, cond_expr);
    if (cond_value == -2) { return -2; }
    if (cond_value < 0 || cond_value >= b.inst_count) {
        return gen.fail("内部错误：SSA 循环条件降低失败");
    }

    let body_b int = ast_ir_b_alloc_block(b);
    let exit_b int = ast_ir_b_alloc_block(b);
    if (body_b < 0 || exit_b < 0) { return -1; }
    if (ast_ir_b_close_term(b, header, ir.IR_TERM_COND_BR, cond_value,
        body_b, exit_b) != 0) { return -1; }

    // 设置循环上下文并降低体。
    b.continue_target = header;
    b.break_target = exit_b;
    b.continue_done = 0;
    b.break_done = 0;
    if (b.loop_break_count > 0 && b.carry_count > 0) {
        if (b.break_blocks != 0) { free(b.break_blocks.to_type(*void)); }
        if (b.break_vals != 0) { free(b.break_vals.to_type(*void)); }
        b.break_blocks = malloc((b.loop_break_count * sizeof(int)).to_type(u64)).to_type(*int);
        b.break_vals = malloc((b.loop_break_count * b.carry_count * sizeof(int)).to_type(u64)).to_type(*int);
        if (b.break_blocks == 0 || b.break_vals == 0) { return -1; }
    }
    ast_ir_b_enter_block(b, body_b);
    let fall int = ast_ir_b_stmts(b, ctx, ast_stmt_nodes[body_stmt].first_child);
    if (fall < 0) { return fall; }

    // 结束循环上下文；体贯穿时回填回边输入。
    b.break_target = -1;
    b.continue_target = -1;
    if (fall == 1) {
        let latch int = b.cur_block;
        if (ast_ir_b_close_term(b, latch, ir.IR_TERM_BR, -1, header, -1) != 0) {
            return -1;
        }
        let lj int = 0;
        for lj < b.carry_count {
            let binding AstBinding = ast_bindings[b.carry_rows[lj]];
            if (ast_ir_b_set_phi_input(b, b.carry_phis[lj],
                1 + b.loop_continue_count, latch,
                b.local_values[binding.id]) != 0) { return -1; }
            lj += 1;
        }
    }
    // 循环后视角恢复为 header phi。
    let rj int = 0;
    for rj < b.carry_count {
        let binding AstBinding = ast_bindings[b.carry_rows[rj]];
        b.local_values[binding.id] = b.carry_phis[rj];
        rj += 1;
    }

    // 退出块：break 站点与条件假边的携带值不同时建合流 phi。
    ast_ir_b_enter_block(b, exit_b);
    if (b.loop_break_count > 0 && b.carry_count > 0) {
        let ej int = 0;
        for ej < b.carry_count {
            let binding AstBinding = ast_bindings[b.carry_rows[ej]];
            let header_value int = b.local_values[binding.id];
            let differ int = 0;
            let ei int = 0;
            for ei < b.break_done {
                if (b.break_vals[ei * b.carry_count + ej] != header_value) {
                    differ = 1;
                    break;
                }
                ei += 1;
            }
            if (differ != 0) {
                let exit_phi int = ast_ir_b_add_phi(b,
                    ast_ir_type(binding.sym_type_id), 1 + b.break_done);
                if (exit_phi < 0) { return -1; }
                if (ast_ir_b_set_phi_input(b, exit_phi, 0, header,
                    header_value) != 0) { return -1; }
                let ei2 int = 0;
                for ei2 < b.break_done {
                    if (ast_ir_b_set_phi_input(b, exit_phi, 1 + ei2,
                        b.break_blocks[ei2],
                        b.break_vals[ei2 * b.carry_count + ej]) != 0) { return -1; }
                    ei2 += 1;
                }
                b.local_values[binding.id] = exit_phi;
            }
            ej += 1;
        }
    }
    return 1;
}

// ast_ir_lower_expr：把受支持表达式后序降低为 SSA 值；-2 表示暂不支持。
// 逻辑或/与在此做短路求值：由 builder 创建条件块与合流 phi。
fn ast_ir_lower_expr(b *AstIRBuilder, ctx *AstFunctionContext,
    expr_id int) int {
    if (expr_id < ctx.expr_first || expr_id >= ctx.expr_after) {
        return -2;
    }
    let node AstExpr = ast_expr_nodes[expr_id];
    if (node.kind == AST_EXPR_PRIMARY) {
        if (node.child0 >= 0) {
            return ast_ir_lower_expr(b, ctx, node.child0);
        }
        if (node.sym_id >= 0) {
            if (node.binding_row < ctx.binding_first
                || node.binding_row >= ctx.binding_after) { return -2; }
            let binding AstBinding = ast_bindings[node.binding_row];
            let slots int = ctx.binding_after - ctx.binding_first;
            if (binding.id < 0 || binding.id >= slots
                || binding.file_id != node.file_id || binding.owner_decl != node.owner_decl
                || binding.sym_id != node.sym_id || binding.sym_kind != gen.SYM_VAR
                || ast_ir_type(binding.sym_type_id) != ast_ir_type(node.type_id)
                || ((binding.id < b.param_count && binding.is_param == 0)
                    || (binding.id >= b.param_count && binding.is_param != 0))) {
                return -2;
            }
            let value int = b.local_values[binding.id];
            if (value < 0 || value >= b.inst_count) { return -2; }
            return value;
        }
        if (node.is_const == 0) { return -2; }
        if (node.op != gen.TOK_NUMBER && node.op != gen.TOK_CHAR
            && node.op != gen.TK_TRUE && node.op != gen.TK_FALSE) {
            return -2;
        }
        let type_id int = ast_ir_type(node.type_id);
        if (type_id < 0) { return -2; }
        return ast_ir_b_add_inst(b, ir.IR_OP_CONST, type_id, -1, -1,
            node.const_bits);
    }
    if (node.kind == AST_EXPR_CALL) {
        return ast_ir_lower_call_expr(b, ctx, expr_id);
    }
    // 逻辑非：!x 降为 x 与 false 常量的相等比较（bool 结果取反）。
    if (node.kind == AST_EXPR_UNARY) {
        if (node.op != gen.TK_BANG || node.child0 < 0) {
            return -2;
        }
        // 旧语义层把 bool 的 ! 结果升为 i32；IR 一律产生 bool，
        // 源类型只要可映射即可（值 0/1 语义一致）。
        if (ast_ir_type(node.type_id) < 0) {
            return -2;
        }
        let inner int = ast_ir_lower_expr(b, ctx, node.child0);
        if (inner == -2) {
            return -2;
        }
        if (inner < 0) { return -1; }
        let false_bit int = ast_ir_b_add_inst(b, ir.IR_OP_CONST,
            ir.IR_TY_BOOL, -1, -1, 0);
        if (false_bit < 0) { return -1; }
        return ast_ir_b_add_inst(b, ir.IR_OP_EQ, ir.IR_TY_BOOL,
            inner, false_bit, 0);
    }
    if (node.kind != AST_EXPR_BINARY || node.child0 < 0 || node.child1 < 0) {
        return -2;
    }
    // 短路求值：a || b 在 a 为真时跳过 b；a && b 在 a 为假时跳过 b。
    // 操作数经条件归一化（整数非零为真），两侧 phi 输入同为 IR bool。
    if (node.op == gen.TK_OROR || node.op == gen.TK_ANDAND) {
        let left int = ast_ir_b_cond(b, ctx, node.child0);
        if (left == -2) {
            return -2;
        }
        if (left < 0) { return -1; }
        // 短路常量定义在条件块内，保证支配对应合流边。
        let short_bits i64 = node.op == gen.TK_OROR ? 1 : 0;
        let short_value int = ast_ir_b_add_inst(b, ir.IR_OP_CONST,
            ir.IR_TY_BOOL, -1, -1, short_bits);
        if (short_value < 0) { return -1; }
        let pre_block int = b.cur_block;
        let rhs_block int = ast_ir_b_alloc_block(b);
        let join_block int = ast_ir_b_alloc_block(b);
        if (rhs_block < 0 || join_block < 0) { return -1; }
        if (node.op == gen.TK_OROR) {
            if (ast_ir_b_close_term(b, pre_block, ir.IR_TERM_COND_BR,
                left, join_block, rhs_block) != 0) { return -1; }
        } else {
            if (ast_ir_b_close_term(b, pre_block, ir.IR_TERM_COND_BR,
                left, rhs_block, join_block) != 0) { return -1; }
        }
        ast_ir_b_enter_block(b, rhs_block);
        let right int = ast_ir_b_cond(b, ctx, node.child1);
        if (right == -2) {
            return -2;
        }
        if (right < 0) { return -1; }
        // 嵌套短路会把当前块推进到更深的合流块；phi 的第二前驱
        // 必须是实际分支到 join 的那个块。
        let rhs_end int = b.cur_block;
        if (ast_ir_b_close_term(b, rhs_end, ir.IR_TERM_BR, -1,
            join_block, -1) != 0) { return -1; }
        ast_ir_b_enter_block(b, join_block);
        let phi int = ast_ir_b_add_phi(b, ir.IR_TY_BOOL, 2);
        if (phi < 0) { return -1; }
        if (ast_ir_b_set_phi_input(b, phi, 0, pre_block, short_value) != 0
            || ast_ir_b_set_phi_input(b, phi, 1, rhs_end, right) != 0) {
            return -1;
        }
        return phi;
    }
    let op int = -1;
    if (node.op == gen.TK_PLUS) { op = ir.IR_OP_ADD; }
    if (node.op == gen.TK_MINUS) { op = ir.IR_OP_SUB; }
    if (node.op == gen.TK_STAR) { op = ir.IR_OP_MUL; }
    if (node.op == gen.TK_SLASH) { op = ir.IR_OP_DIV; }
    if (node.op == gen.TK_PERCENT) { op = ir.IR_OP_REM; }
    if (node.op == gen.TK_AMP) { op = ir.IR_OP_BAND; }
    if (node.op == gen.TK_PIPE) { op = ir.IR_OP_BOR; }
    if (node.op == gen.TK_CARET) { op = ir.IR_OP_BXOR; }
    if (node.op == gen.TK_LSHIFT) { op = ir.IR_OP_SHL; }
    if (node.op == gen.TK_RSHIFT) { op = ir.IR_OP_SHR; }
    if (node.op == gen.TK_EQEQ) { op = ir.IR_OP_EQ; }
    if (node.op == gen.TK_NEQ) { op = ir.IR_OP_NE; }
    if (node.op == gen.TK_LT) { op = ir.IR_OP_LT; }
    if (node.op == gen.TK_LEQ) { op = ir.IR_OP_LE; }
    if (node.op == gen.TK_GT) { op = ir.IR_OP_GT; }
    if (node.op == gen.TK_GEQ) { op = ir.IR_OP_GE; }
    if (op < 0) { return -2; }
    let left int = ast_ir_lower_expr(b, ctx, node.child0);
    if (left == -2) { return -2; }
    if (left < 0) { return -1; }
    let right int = ast_ir_lower_expr(b, ctx, node.child1);
    if (right == -2) { return -2; }
    if (right < 0) { return -1; }
    let result_type int = ast_ir_type(node.type_id);
    if (result_type < 0) { return -2; }
    return ast_ir_b_add_inst(b, op, result_type, left, right, 0);
}

// ast_ir_lower_function：生成/复用 SSA，并让后端替换该函数的旧汇编片段。
fn ast_ir_lower_function(ctx *AstFunctionContext, cache_dir *char,
    compiler_salt u64, asm_shift *int) int {
    let gs *gen.GenState = gen.G();
    if (ctx.decl_row < 0 || ctx.decl_row >= ast_decl_count) { return 0; }
    let decl *AstDecl = &ast_decl_nodes[ctx.decl_row];
    if (decl.kind != gen.TK_FN || decl.body_stmt < ctx.stmt_first
        || decl.body_stmt >= ctx.stmt_after || decl.sym_id < 0
        || decl.sym_id >= gs.c_sym_n || decl.type_id < 0
        || decl.type_id >= gs.t_type_n) {
        return 0;
    }
    let fn_type gen.CType = gs.t_types[decl.type_id];
    if (fn_type.kind != gen.TY_FN || fn_type.sub < 0 || fn_type.sub >= gs.t_sig_n) {
        return 0;
    }
    let sig int = fn_type.sub;
    if (ast_ir_bindings_supported(ctx, sig) == 0) {
        return 0;
    }
    let param_count int = gs.t_sig_np[sig];
    let binding_count int = ctx.binding_after - ctx.binding_first;
    if (binding_count < param_count) { return 0; }
    let ret_type int = ast_ir_type(gs.t_sig_ret[sig]);
    let is_void_ret int = 0;
    if (ret_type < 0) {
        // void 函数使用固定类型表下标 0（IR_TY_VOID）；其余不可映射类型仍拒绝。
        if (ast_ir_void_type(gs.t_sig_ret[sig]) == 0) { return 0; }
        is_void_ret = 1;
        ret_type = ir.IR_TY_VOID;
    }

    let body AstStmt = ast_stmt_nodes[decl.body_stmt];
    if (body.kind != AST_STMT_BLOCK) { return 0; }

    let cache_key u64 = ast_ir_cache_key(ctx, decl, sig, ret_type, compiler_salt);
    let cache_enabled int = cache_dir != 0 && cache_key != 0;
    let cache_path [620]u8;
    if (cache_enabled != 0) {
        ast_ir_cache_path(cache_dir, cache_key, cache_path);
        let cached ir.IRFunction;
        cached.types = 0;
        cached.insts = 0;
        cached.phis = 0;
        cached.phi_inputs = 0;
        cached.calls = 0;
        cached.call_args = 0;
        cached.call_symbols = 0;
        cached.blocks = 0;
        let cache_hit int = ast_ir_cache_read(gen.arr_cstr(cache_path), cache_key, &cached);
        if (cache_hit != 0
            && cached.ret_type == ret_type && cached.abi == gs.t_sig_abi[sig]) {
            let flags int = gs.c_syms[decl.sym_id].flags;
            if ((flags & gen.F_INLINE) != 0 && (flags & gen.F_PUB) == 0
                && ast_ir_inline_register(decl.sym_id, &cached) != 0) {
                ir.ir_function_release(&cached);
                return gen.fail("inline SSA 候选登记失败");
            }
            if (gs.c_check_only == 0) {
                let delta int = 0;
                let emitted int = backend.arm64_emit_replace(&cached,
                    decl.sym_id, ctx.asm_first + asm_shift[0],
                    ctx.asm_after + asm_shift[0], asm_shift, &delta);
                if (emitted < 0) {
                    ir.ir_function_release(&cached);
                    return -1;
                }
            }
            ir.ir_function_release(&cached);
            gs.c_stats_ir_cache_hits += 1;
            return 1;
        }
        ir.ir_function_release(&cached);
        gs.c_stats_ir_cache_misses += 1;
    }
    // 通用构造器：递归降低受支持的语句序列，形态之外整体回退旧发射器。
    let capacity int = ctx.expr_after - ctx.expr_first + param_count
        + binding_count + ctx.stmt_after - ctx.stmt_first;
    if (capacity < 1) { capacity = 1; }
    let b AstIRBuilder;
    if (ast_ir_b_init(&b, param_count, binding_count, capacity) != 0) {
        ast_ir_b_release(&b);
        return gen.fail("SSA 构造器内存分配失败");
    }
    b.binding_first = ctx.binding_first;
    let types [13]ir.IRType;
    types[0].kind = ir.IR_TY_VOID;
    types[0].elem = -1;
    types[0].bits = 0;
    types[1].kind = ir.IR_TY_BOOL;
    types[1].elem = -1;
    types[1].bits = 1;
    types[2].kind = ir.IR_TY_I8;
    types[2].elem = -1;
    types[2].bits = 8;
    types[3].kind = ir.IR_TY_I16;
    types[3].elem = -1;
    types[3].bits = 16;
    types[4].kind = ir.IR_TY_I32;
    types[4].elem = -1;
    types[4].bits = 32;
    types[5].kind = ir.IR_TY_I64;
    types[5].elem = -1;
    types[5].bits = 64;
    types[6].kind = ir.IR_TY_U8;
    types[6].elem = -1;
    types[6].bits = 8;
    types[7].kind = ir.IR_TY_U16;
    types[7].elem = -1;
    types[7].bits = 16;
    types[8].kind = ir.IR_TY_U32;
    types[8].elem = -1;
    types[8].bits = 32;
    types[9].kind = ir.IR_TY_U64;
    types[9].elem = -1;
    types[9].bits = 64;
    types[10].kind = ir.IR_TY_F32;
    types[10].elem = -1;
    types[10].bits = 32;
    types[11].kind = ir.IR_TY_F64;
    types[11].elem = -1;
    types[11].bits = 64;
    types[12].kind = ir.IR_TY_PTR;
    types[12].elem = ir.IR_TY_I64;
    types[12].bits = 64;
    b.ret_ir_type = ret_type;
    b.types = &types[0];
    let entry int = ast_ir_b_alloc_block(&b);
    if (entry < 0) {
        ast_ir_b_release(&b);
        return gen.fail("内部错误：SSA 入口块分配失败");
    }
    ast_ir_b_enter_block(&b, entry);
    let pi int = 0;
    for pi < param_count {
        let type_id int = ast_ir_type(gs.t_sig_params[gs.t_sig_first[sig] + pi]);
        let param_value int = ast_ir_b_add_inst(&b, ir.IR_OP_PARAM, type_id,
            -1, -1, pi.to_type(i64));
        if (type_id < 0 || param_value < 0) {
            ast_ir_b_release(&b);
            return gen.fail("内部错误：SSA 参数声明降低失败");
        }
        b.local_values[pi] = param_value;
        pi += 1;
    }
    let status int = ast_ir_b_stmts(&b, ctx, body.first_child);
    if (status == -2) {
        ast_ir_b_release(&b);
        return 0;
    }
    if (status < 0) {
        ast_ir_b_release(&b);
        return status;
    }
    if (status == 1) {
        // 函数尾贯穿：void 允许隐式结束；非 void 贯穿说明是回退形态。
        if (is_void_ret == 0) {
            ast_ir_b_release(&b);
            return 0;
        }
        ast_ir_b_close_term(&b, b.cur_block, ir.IR_TERM_RET, -1, -1, -1);
    }


    let f ir.IRFunction;
    f.abi = gs.t_sig_abi[sig];
    f.target_id = gs.c_dialect + 1;
    f.ret_type = ret_type;
    f.types = &types[0];
    f.type_count = 13;
    f.insts = b.insts;
    f.inst_count = b.inst_count;
    f.phis = b.phis;
    f.phi_count = b.phi_count;
    f.phi_inputs = b.phi_inputs;
    f.phi_input_count = b.phi_input_count;
    f.calls = b.calls.calls;
    f.call_count = b.calls.call_count;
    f.call_args = b.calls.args;
    f.call_arg_count = b.calls.arg_count;
    f.call_symbols = b.calls.symbols;
    f.call_symbol_size = b.calls.symbol_size;
    f.blocks = b.blocks;
    f.block_count = b.block_count;
    f.value_count = b.inst_count;
    // f 接管 builder 的 SSA 数组；后续内联可能替换其中的多张表。
    b.insts = 0;
    b.blocks = 0;
    b.phis = 0;
    b.phi_inputs = 0;
    b.calls.calls = 0;
    b.calls.args = 0;
    b.calls.symbols = 0;
    let inline_status int = ast_ir_inline_apply(ctx, &f);
    if (inline_status < 0) {
        ast_ir_release_built(&f);
        ast_ir_b_release(&b);
        return inline_status;
    }
    let verified int = ir.ir_simplify(&f);
    let fn_flags int = gs.c_syms[decl.sym_id].flags;
    if (verified == 0 && (fn_flags & gen.F_INLINE) != 0
        && (fn_flags & gen.F_PUB) == 0
        && ast_ir_inline_register(decl.sym_id, &f) != 0) {
        ast_ir_release_built(&f);
        ast_ir_b_release(&b);
        return gen.fail("inline SSA 候选登记失败");
    }
    if (verified == 0 && gs.c_check_only == 0) {
        let delta int = 0;
        let emitted int = backend.arm64_emit_replace(&f, decl.sym_id,
            ctx.asm_first + asm_shift[0], ctx.asm_after + asm_shift[0],
            asm_shift, &delta);
        if (emitted < 0) {
            ast_ir_release_built(&f);
            ast_ir_b_release(&b);
            return -1;
        }
    }
    if (verified == 0 && cache_enabled != 0) {
        ast_ir_cache_write(gen.arr_cstr(cache_path), cache_key, &f);
    }
    if (verified != 0) {
        ast_ir_release_built(&f);
        ast_ir_b_release(&b);
        return gen.fail("内部错误：SSA 函数校验失败");
    }
    ast_ir_release_built(&f);
    ast_ir_b_release(&b);
    return 1;
}
