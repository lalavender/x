module parse
import check
import support
import token
import gen
import comptime
import ast

// ============================================================================
// parse_stmt.yh —— 自举编译器：语句解析（语义钩子集成）
//
// 覆盖 docs/yh.g4 的 stmt 及其分支。语句边界由显式 ';' 钉死；以块收尾
// 的语句不带尾分号；标签必须后随被标记的语句。
//
// 赋值语句的 LHS 识别：进入表达式语句前先做一次 token 级扫描——在深度
// 0、';' 之前出现赋值运算符即赋值语句（g4：exprStmt 是唯一的赋值位置）。
// LHS 以 lvalue 模式解析出地址并存入临时槽（地址只计算一次），RHS 求值
// 后由 sem_assign 完成取改存。
//
// LL12：控制流不再发射标签/跳转/临时槽，结构由 AST 捕获与 lowering 生成。
// 三种形态统一为「条件标签 + 体 + 回跳」；switch 用比较链（无 fallthrough，
// 控制值存专用槽，case 值要求编译期常量）。
// ============================================================================

// scan_assign_ahead：从当前 token 扫描到 ';'，返回深度 0 处首个赋值
// 运算符的 token 种类；无则返回 0。括号/花括号/方括号内不视为顶层。
fn scan_assign_ahead() int {
    let t *gen.TaskCtx = gen.task()
    let i int = token.ctx().pos
    let depth int = 0
    for i < token.ctx().count {
        let k int = token.ctx().tokens[i].kind
        if (k == token.TK_LPAREN || k == token.TK_LBRACKET || k == token.TK_LBRACE) {
            depth += 1
        }
        if (k == token.TK_RPAREN || k == token.TK_RBRACKET || k == token.TK_RBRACE) {
            depth -= 1
        }
        if (depth <= 0 && token.is_assign_op(k) != 0) {
            return k
        }
        if (depth == 0 && (k == token.TK_SEMI || k == token.TOK_EOF)) {
            return 0
        }
        i += 1
    }
    return 0
}

// sem_check_cond：条件上下文类型检查（标量且非浮点）。
fn sem_check_cond(r *gen.Res) int {
    let t *gen.TaskCtx = gen.task()
    if (support.session().compile == 0) {
        return 0
    }
    if (gen.ty_is_scalar(r.type_id) == 0) {
        return gen.sem_err("条件必须是标量")
    }
    if (support.ty_is_float(r.type_id) != 0) {
        return gen.sem_err("浮点不能作条件（用 != 0 比较）")
    }
    return 0
}

// parse_block：'{' stmt* '}'。
fn parse_block() int {
    let t *gen.TaskCtx = gen.task()
    let own_ast int = 0
    let block_ast int = -1
    let top_root int = 0
    if (support.session().ast_capture != 0) {
        if (ast.ast_stmt_current_now() < 0
            || ast.ast_stmt_node_kind_of(ast.ast_stmt_current_now()) != ast.AST_STMT_BLOCK
            || ast.ast_stmt_node_first_of(ast.ast_stmt_current_now()) != token.ctx().pos) {
            own_ast = 1
            if (ast.ast_stmt_current_now() < 0) { top_root = 1 }
            block_ast = ast.ast_stmt_begin(ast.AST_STMT_BLOCK, token.TK_LBRACE, token.ctx().pos)
            if (block_ast < 0) { return -1 }
        }
    }
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) {
        return -1
    }
    gen.scope_push()
    for p_cur() != token.TK_RBRACE && p_cur() != token.TOK_EOF {
        let stmt_result int = 0
        if (support.session().ast_capture != 0) {
            stmt_result = parse_stmt_capture()
        } else {
            stmt_result = parse_stmt()
        }
        if (stmt_result != 0) {
            return -1
        }
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) {
        return -1
    }
    p_take_block_end()
    gen.scope_pop()
    if (own_ast != 0 && ast.ast_stmt_end(block_ast, token.ctx().pos) != 0) {
        return -1
    }
    if (own_ast != 0 && top_root != 0 && ast.store().file_decl_i >= 0
        && (t.c_ct_prepare_active == 0 || ast.store().file_indexed != 0)
        && ast.ast_decl_attach_body(support.session().active_file, ast.store().file_decl_i, block_ast) != 0) {
        return -1
    }
    return 0
}

// parse_stmt_capture：仅供 check worker 包装一条语句并记录 AST 范围。
fn parse_stmt_capture() int {
    let t *gen.TaskCtx = gen.task()
    let first int = token.ctx().pos
    let op int = p_cur()
    let kind int = ast.AST_STMT_EXPR
    let diag_kind int = 0
    let typed_if int = 0
    let typed_for int = 0
    if (op == token.TK_LBRACE) { kind = ast.AST_STMT_BLOCK }
    if (op == token.TK_LET || op == token.TK_CONST) { kind = ast.AST_STMT_DECL }
    if (op == token.TK_STRUCT || op == token.TK_UNION || op == token.TK_ENUM
        || op == token.TK_TYPE) { kind = ast.AST_STMT_TYPE }
    if (op == token.TK_IF) { kind = ast.AST_STMT_IF }
    if (op == token.TK_FOR) { kind = ast.AST_STMT_FOR }
    if (op == token.TK_DOLLAR && (p_peek(1) == token.TK_IF || p_peek(1) == token.TK_FOR)) {
        kind = ast.AST_STMT_COMPTIME
        if (t.c_ct_prepare_active != 0 && support.session().ast_capture != 0) {
            if (p_peek(1) == token.TK_IF) { typed_if = 1 }
            if (p_peek(1) == token.TK_FOR) { typed_for = 1 }
        }
    } else if (op == token.TK_DOLLAR && ctx().test_body == 0
        && parse_comptime_diag_kind_at(first) != 0) {
        // test 体内的 $assert 已降为运行期调用，按普通表达式语句记录。
        kind = ast.AST_STMT_COMPTIME
        diag_kind = parse_comptime_diag_kind_at(first)
    }
    if (op == token.TK_SWITCH) { kind = ast.AST_STMT_SWITCH }
    if (op == token.TK_RETURN) { kind = ast.AST_STMT_RETURN }
    if (op == token.TK_BREAK) { kind = ast.AST_STMT_BREAK }
    if (op == token.TK_CONTINUE) { kind = ast.AST_STMT_CONTINUE }
    if (op == token.TK_GOTO) { kind = ast.AST_STMT_GOTO }
    if (op == token.TOK_IDENT && p_peek(1) == token.TK_COLON) {
        kind = ast.AST_STMT_LABEL
    } else if (kind == ast.AST_STMT_EXPR) {
        let assign_op int = scan_assign_ahead()
        if (assign_op != 0) {
            kind = ast.AST_STMT_ASSIGN
            op = assign_op
        }
    }
    let id int = ast.ast_stmt_begin(kind, op, first)
    if (id < 0) { return -1 }
    if (parse_stmt() != 0) {
        return -1
    }
    if (diag_kind != 0) { ast.ast_stmt_node_op_set(id, diag_kind) }
    if (typed_if != 0) { ast.ast_stmt_node_op_set(id, token.TK_IF) }
    if (typed_for != 0 && ast.ast_stmt_node_op_of(id) != 0) {
        ast.ast_stmt_node_op_set(id, token.TK_FOR)
    }
    return ast.ast_stmt_end(id, token.ctx().pos)
}

// parse_stmt：按首 token 分派语句并调用现有语义钩子。
fn parse_stmt_inner() int {
    let t *gen.TaskCtx = gen.task()
    let k int = p_cur()
    if (k == token.TK_LBRACE) {
        return parse_block()
    }
    if (k == token.TK_STRUCT || k == token.TK_UNION || k == token.TK_ENUM || k == token.TK_TYPE) {
        // 类型声明禁止嵌套（pub struct 一等化）：struct/union/enum/type
        // 只能出现在顶层，函数体内一律拒绝。
        return token.err_tok("类型声明只能出现在顶层（函数体内不允许 struct/union/enum/type 声明）")
    }
    if (k == token.TK_LET) {
        return parse_let_decl(0)
    }
    if (k == token.TK_CONST) {
        return parse_const_decl(0)
    }
    if (k == token.TK_IF) {
        return parse_if()
    }
    if (k == token.TK_FOR) {
        return parse_for()
    }
    if (k == token.TK_DOLLAR && (p_peek(1) == token.TK_IF || p_peek(1) == token.TK_FOR)) {
        return parse_comptime_control()
    }
    if (k == token.TK_SWITCH) {
        return parse_switch()
    }
    if (k == token.TK_RETURN) {
        return parse_return()
    }
    if (k == token.TK_BREAK || k == token.TK_CONTINUE) {
        if (support.session().compile != 0
            && comptime.ct_validate_loop_exit(t.c_loop_depth, k) != 0) { return -1 }
        p_adv()
        let br int = 0
        if (k == token.TK_BREAK) {
            br = check.sem_break()
        } else {
            br = check.sem_continue()
        }
        if (br != 0) {
            return -1
        }
        return p_expect(token.TK_SEMI, "期望 ';'")
    }
    if (k == token.TK_GOTO) {
        p_adv()
        if (p_cur() != token.TOK_IDENT) {
            return token.err_tok("goto 后需要标签名")
        }
        let gstart int = token.ctx().tokens[token.ctx().pos].start
        let glen int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        if (check.sem_goto(gstart, glen) != 0) {
            return -1
        }
        return p_expect(token.TK_SEMI, "期望 ';'")
    }
    // 标签语句：IDENT ':' stmt
    if (k == token.TOK_IDENT && p_peek(1) == token.TK_COLON) {
        let lstart int = token.ctx().tokens[token.ctx().pos].start
        let llen int = token.ctx().tokens[token.ctx().pos].len
        p_adv()
        p_adv()
        if (check.sem_deflabel(lstart, llen) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0) {
            return parse_stmt_capture()
        }
        return parse_stmt()
    }
    // 表达式语句 / 单目标赋值
    let aop int = scan_assign_ahead()
    if (aop != 0) {
        let lres gen.Res
        let save int = t.c_lvalue
        t.c_lvalue += 1
        let r int = parse_expr(&lres)
        t.c_lvalue = save
        if (r != 0) {
            return -1
        }
        if (support.session().compile != 0 && t.c_res_is_addr == 0) {
            return gen.sem_err("赋值目标必须是可寻址的表达式")
        }
        // 消费赋值运算符
        p_adv()
        if (check.sem_stash_lvalue() != 0) {
            return -1
        }
        // RHS 恒为值上下文（清 c_lvalue，避免 s[i] 被取地址）；
        // 数组/切片字面量以左值类型为目标类型上下文
        let rres gen.Res
        let save_lv2 int = t.c_lvalue
        t.c_lvalue = 0
        let save_exp int = t.c_expect_tid
        t.c_expect_tid = lres.type_id
        let rr int = parse_expr(&rres)
        t.c_expect_tid = save_exp
        t.c_lvalue = save_lv2
        if (rr != 0) {
            return -1
        }
        if (support.session().compile != 0) {
            if (gen.sem_can_assign(lres.type_id, rres.type_id, rres.is_lit, rres.ival, rres.lit_big) != 0) {
                return -1
            }
            if (check.sem_assign(aop, &lres, &rres) != 0) {
                return -1
            }
        }
        return p_expect(token.TK_SEMI, "期望 ';'")
    }
    let res gen.Res
    let saved_diag_stmt int = t.c_ct_diag_stmt
    t.c_ct_diag_stmt = 1
    let expr_status int = parse_expr(&res)
    t.c_ct_diag_stmt = saved_diag_stmt
    if (expr_status != 0) {
        return -1
    }
    if (p_expect(token.TK_SEMI, "期望 ';'") != 0) { return -1 }
    if (support.session().compile != 0 && res.ct_diag != 0
        && (t.c_fn_flags & gen.F_COMPTIME) == 0
        && !(ctx().test_body != 0
            && res.ct_diag == gen.CT_DIAG_ASSERT)) {
        return comptime.ct_diag_emit(res.ct_diag, res.ival,
            res.ct_diag_line, res.ct_diag_col,
            res.ct_diag_msg_start, res.ct_diag_msg_len)
    }
    return 0
}

// parse_stmt：隔离当前语句的调用效果，并更新函数顺序落底状态。
fn parse_stmt() int {
    let t *gen.TaskCtx = gen.task()
    let first_kind int = p_cur()
    t.c_expr_noreturn = 0
    let status int = parse_stmt_inner()
    if (status != 0 || support.session().compile == 0) { return status }
    if (first_kind == token.TK_RETURN || first_kind == token.TK_BREAK
        || first_kind == token.TK_CONTINUE) {
        t.c_fn_falls = 0
    } else if (first_kind != token.TK_IF && first_kind != token.TK_FOR
        && first_kind != token.TK_SWITCH && first_kind != token.TK_LBRACE
        && t.c_expr_noreturn != 0) {
        t.c_fn_falls = 0
    }
    return 0
}

// parse_return：'return' expr? ';'。返回类型检查与收尾跳转由 sem 层管理。
fn parse_return() int {
    let t *gen.TaskCtx = gen.task()
    p_adv()
    if (support.session().compile != 0) {
        if ((t.c_fn_flags & gen.F_NORETURN) != 0) {
            return gen.sem_err("noreturn 函数定义不能包含 return")
        }
        if (t.c_fn_ret == gen.TY_VOID && p_cur() != token.TK_SEMI) {
            return gen.sem_err("void 函数不能返回值")
        }
        if (t.c_fn_ret != gen.TY_VOID && p_cur() == token.TK_SEMI) {
            return gen.sem_err("非 void 函数必须返回值")
        }
    }
    if (p_cur() != token.TK_SEMI) {
        let r gen.Res
        // 聚合字面量需要目标类型上下文：return 表达式的目标类型是函数返回类型
        // （与 let 初始化/赋值/调用实参一致，见 parse_array_literal）；非字面量
        // 表达式不受影响，随后的 sem_can_assign 仍做完整校验。
        let save_expect int = t.c_expect_tid
        t.c_expect_tid = t.c_fn_ret
        let rr int = parse_expr(&r)
        t.c_expect_tid = save_expect
        if (rr != 0) {
            return -1
        }
        if (support.session().compile != 0) {
            if (gen.sem_can_assign(t.c_fn_ret, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
                return -1
            }
            if (check.sem_return_value(&r) != 0) {
                return -1
            }
        }
    } else {
    }
    return p_expect(token.TK_SEMI, "期望 ';'")
}

// parse_if：'if' '(' expr ')' block ('else' (ifStmt | block))?。
fn parse_if() int {
    let t *gen.TaskCtx = gen.task()
    let parent_falls int = t.c_fn_falls
    p_adv()
    if (p_expect(token.TK_LPAREN, "if 条件必须带括号") != 0) {
        return -1
    }
    let cond gen.Res
    if (parse_expr_iso(&cond) != 0) {
        return -1
    }
    if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
        return -1
    }
    if (sem_check_cond(&cond) != 0) {
        return -1
    }
    let lbl_else int = 0
    let lbl_end int = 0
    t.c_fn_falls = 1
    if (parse_block() != 0) {
        return -1
    }
    let then_falls int = t.c_fn_falls
    if (p_cur() == token.TK_ELSE) {
        p_adv()
        t.c_fn_falls = 1
        if (p_cur() == token.TK_IF) {
            let nested_if_result int = 0
            if (support.session().ast_capture != 0) {
                nested_if_result = parse_stmt_capture()
            } else {
                nested_if_result = parse_stmt()
            }
            if (nested_if_result != 0) {
                return -1
            }
        } else {
            if (parse_block() != 0) {
                return -1
            }
        }
        let else_falls int = t.c_fn_falls
        t.c_fn_falls = parent_falls != 0 &&
            (then_falls != 0 || else_falls != 0) ? 1 : 0
        return 0
    }
    t.c_fn_falls = parent_falls != 0 ? 1 : 0
    return 0
}

// parse_for：三种形态（无限 / 条件 / for-in）。
fn parse_for() int {
    let t *gen.TaskCtx = gen.task()
    let parent_falls int = t.c_fn_falls
    p_adv()
    if (p_cur() == token.TK_LBRACE) {
        // 无限循环
        let ibrk int = 0
        let iend int = 0
        if (support.session().compile != 0) {
            if (check.sem_loop_push(iend, ibrk) != 0) {
                return -1
            }
        }
        t.c_fn_falls = 1
        if (parse_block() != 0) {
            return -1
        }
        let loop_depth int = t.c_loop_depth
        let has_break int = loop_depth > 0 ?
            t.c_loop_break_seen[loop_depth - 1] : 0
        t.c_fn_falls = parent_falls != 0 && has_break != 0 ? 1 : 0
        if (support.session().compile != 0) {
            check.sem_loop_pop()
        }
        return 0
    }
    if (p_cur() == token.TOK_IDENT) {
        // for-in 形态：语法全保留；编译模式 B7 提供
        let is_in int = 0
        if (p_peek(1) == token.TK_IN) {
            is_in = 1
        }
        if (p_peek(1) == token.TK_COMMA && p_peek(2) == token.TOK_IDENT && p_peek(3) == token.TK_IN) {
            is_in = 1
        }
        if (is_in != 0) {
            // 解析绑定：for v in ...  或 for i, v in ...
            let idx_start int = -1
            let idx_len int = -1
            let idx_token int = -1
            let elem_start int = -1
            let elem_len int = -1
            let elem_token int = -1
            if (p_peek(1) == token.TK_IN) {
                // 只有元素绑定
                elem_token = token.ctx().pos
                elem_start = token.ctx().tokens[token.ctx().pos].start
                elem_len = token.ctx().tokens[token.ctx().pos].len
                p_adv()
                p_adv()
            } else {
                // 下标 + 元素绑定
                idx_token = token.ctx().pos
                idx_start = token.ctx().tokens[token.ctx().pos].start
                idx_len = token.ctx().tokens[token.ctx().pos].len
                p_adv()
                p_adv()
                elem_token = token.ctx().pos
                elem_start = token.ctx().tokens[token.ctx().pos].start
                elem_len = token.ctx().tokens[token.ctx().pos].len
                p_adv()
                p_adv()
            }
            let it gen.Res
            if (parse_expr_blockctx(&it) != 0) {
                return -1
            }
            let is_range int = 0
            let end_res gen.Res
            let start_off int = 0
            if (p_cur() == token.TK_RANGE) {
                is_range = 1
                // 起点（x0）先存槽，再求终点
                p_adv()
                if (parse_expr_blockctx(&end_res) != 0) {
                    return -1
                }
            }
            if (support.session().compile == 0) {
                return parse_block()
            }
            // 编译模式：建立迭代层
            if (is_range != 0) {
                if (sem_check_cond(&it) != 0) { return -1 }
                if (sem_check_cond(&end_res) != 0) { return -1 }
                // 终点（x0）存临时槽
                t.c_end_tmp_off = 0
            }
            let lcond int = 0
            let lend int = 0
            if (check.sem_loop_push(lend, lcond) != 0) { return -1 }
            gen.scope_push()
            if (is_range != 0) {
                // 起点从槽读回 x0，然后启动区间迭代
                if (check.sem_forin_begin(&it, 1, &end_res) != 0) { return -1 }
            } else {
                if (check.sem_forin_begin(&it, 0, &end_res) != 0) { return -1 }
            }
            // 绑定声明为局部（值拷贝）
            let eoff int = -1
            let ioff int = -1
            if (elem_start >= 0) {
                let etid int = check.sem_forin_elem_type(&it, is_range)
                let esym int = check.sem_declare_local(elem_start, elem_len, etid)
                if (esym < 0) { return -1 }
                if (support.session().ast_capture != 0 && ast.ast_binding_add(esym, elem_token, 0) != 0) {
                    return -1
                }
                eoff = support.ms().syms[esym].offset
            }
            if (idx_start >= 0) {
                let isym int = check.sem_declare_local(idx_start, idx_len, gen.TY_I32)
                if (isym < 0) { return -1 }
                if (support.session().ast_capture != 0 && ast.ast_binding_add(isym, idx_token, 0) != 0) {
                    return -1
                }
                ioff = support.ms().syms[isym].offset
            }
            if (check.sem_forin_set_bind(eoff, ioff) != 0) { return -1 }
            if (check.sem_forin_check(lend) != 0) { return -1 }
            if (check.sem_forin_load(&it, is_range) != 0) { return -1 }
            t.c_fn_falls = 1
            if (parse_block() != 0) { return -1 }
            t.c_fn_falls = parent_falls
            if (check.sem_forin_step(lcond) != 0) { return -1 }
            gen.scope_pop()
            check.sem_forin_end()
            check.sem_loop_pop()
            return 0
        }
    }
    // 条件循环
    let lbl_cond int = 0
    let lbl_end int = 0
    if (support.session().compile != 0) {
        if (check.sem_loop_push(lbl_end, lbl_cond) != 0) {
            return -1
        }
    }
    let cond gen.Res
    if (parse_expr_blockctx(&cond) != 0) {
        return -1
    }
    if (support.session().compile != 0) {
        if (sem_check_cond(&cond) != 0) {
            return -1
        }
    }
    t.c_fn_falls = 1
    if (parse_block() != 0) {
        return -1
    }
    t.c_fn_falls = parent_falls
    if (support.session().compile != 0) {
        check.sem_loop_pop()
    }
    return 0
}

// parse_switch：'switch' expr '{' case 块* '}'。
// 控制值存专用槽；case 值要求编译期常量；无 fallthrough。
// 发射结构（每个 case）：
//   [比较值 v_i: ctrl==v_i → 跳 body]… 全不匹配 → 跳过块体到 next
//   body: 块体 → 跳 end
//   next:（下一个 case 的比较链开始处）
// default 分支的块体无条件执行（排在源码位置）。
fn parse_switch() int {
    let t *gen.TaskCtx = gen.task()
    p_adv()
    let ctrl gen.Res
    if (parse_expr_blockctx(&ctrl) != 0) {
        return -1
    }
    let slot int = 0
    if (support.session().compile != 0) {
        if (support.ty_is_integer(ctrl.type_id) == 0) {
            return gen.sem_err("switch 控制值必须是整数")
        }
    }
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) {
        return -1
    }
    let lbl_end int = 0
    let ncases int = 0
    for p_cur() == token.TK_CASE || p_cur() == token.TK_DEFAULT {
        let case_ast int = -1
        if (support.session().ast_capture != 0) {
            case_ast = ast.ast_stmt_begin(ast.AST_STMT_CASE, p_cur(), token.ctx().pos)
            if (case_ast < 0) { return -1 }
        }
        let body_lbl int = 0
        let skip_lbl int = 0
        let is_case int = (p_cur() == token.TK_CASE).to_type(int)
        if (is_case != 0) {
            p_adv()
            for 1 {
                let cv gen.Res
                if (support.session().compile != 0) {
                    t.c_fold += 1
                }
                let r int = parse_expr_blockctx(&cv)
                if (support.session().compile != 0) {
                    t.c_fold -= 1
                }
                if (r != 0) {
                    return -1
                }
                if (support.session().compile != 0) {
                    if (cv.is_const == 0) {
                        return gen.sem_err("case 值必须是编译期常量")
                    }
                    ncases += 1
                    if (ncases > 512) {
                        return gen.sem_err("switch 分支过多（上限 512 个 case 值）")
                    }
                }
                if (p_cur() == token.TK_COMMA) {
                    p_adv()
                    continue
                }
                break
            }
            // 本 case 的值全部未命中 → 跳过块体
        } else {
            p_adv()
        }
        if (parse_block() != 0) {
            return -1
        }
        if (support.session().ast_capture != 0 && ast.ast_stmt_end(case_ast, token.ctx().pos) != 0) {
            return -1
        }
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) {
        return -1
    }
    p_take_block_end()
    return 0
}
