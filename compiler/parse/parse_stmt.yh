module parse;
import gen;
import comptime;
import ast;

// ============================================================================
// parse_stmt.yh —— 自举编译器：语句解析（语义钩子集成）
//
// 覆盖 docs/yh.g4 的 stmt 及其分支。语句边界由显式 ';' 钉死；以块收尾
// 的语句不带尾分号；标签必须后随被标记的语句。
//
// 赋值语句的 LHS 识别：进入表达式语句前先做一次 token 级扫描——在深度
// 0、';' 之前出现赋值运算符即赋值语句（g4：exprStmt 是唯一的赋值位置）。
// LHS 以 lvalue 模式解析出地址并存入临时槽（地址只计算一次），RHS 求值
// 后由 sem_assign 完成取改存。
//
// 编译模式的控制流全部落到 em_* 标签原语：if/else 与三元同构；for 的
// 三种形态统一为「条件标签 + 体 + 回跳」；switch 用比较链（无 fallthrough，
// 控制值存专用槽，case 值要求编译期常量）。
// ============================================================================

// scan_assign_ahead：从当前 token 扫描到 ';'，返回深度 0 处首个赋值
// 运算符的 token 种类；无则返回 0。括号/花括号/方括号内不视为顶层。
fn scan_assign_ahead() int {
    let gs *gen.GenState = gen.G();
    let i int = gs.task.c_pos;
    let depth int = 0;
    for i < gs.task.c_tok_n {
        let k int = gs.task.c_toks[i].kind;
        if (k == gen.TK_LPAREN || k == gen.TK_LBRACKET || k == gen.TK_LBRACE) {
            depth += 1;
        }
        if (k == gen.TK_RPAREN || k == gen.TK_RBRACKET || k == gen.TK_RBRACE) {
            depth -= 1;
        }
        if (depth <= 0 && gen.is_assign_op(k) != 0) {
            return k;
        }
        if (depth == 0 && (k == gen.TK_SEMI || k == gen.TOK_EOF)) {
            return 0;
        }
        i += 1;
    }
    return 0;
}

// sem_check_cond：条件上下文类型检查（标量且非浮点）。
fn sem_check_cond(r *gen.Res) int {
    let gs *gen.GenState = gen.G();
    if (gs.task.c_compile == 0) {
        return 0;
    }
    if (gen.ty_is_scalar(r.type_id) == 0) {
        return gen.sem_err("条件必须是标量");
    }
    if (gen.ty_is_float(r.type_id) != 0) {
        return gen.sem_err("浮点不能作条件（用 != 0 比较）");
    }
    return 0;
}

// parse_block：'{' stmt* '}'。
fn parse_block() int {
    let gs *gen.GenState = gen.G();
    let own_ast int = 0;
    let block_ast int = -1;
    let top_root int = 0;
    if (gs.task.c_ast_capture != 0) {
        if (ast.ast_stmt_current_now() < 0
            || ast.ast_stmt_node_kind_of(ast.ast_stmt_current_now()) != ast.AST_STMT_BLOCK
            || ast.ast_stmt_node_first_of(ast.ast_stmt_current_now()) != gs.task.c_pos) {
            own_ast = 1;
            if (ast.ast_stmt_current_now() < 0) { top_root = 1; }
            block_ast = ast.ast_stmt_begin(ast.AST_STMT_BLOCK, gen.TK_LBRACE, gs.task.c_pos);
            if (block_ast < 0) { return -1; }
        }
    }
    if (p_expect(gen.TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    gen.scope_push();
    for p_cur() != gen.TK_RBRACE && p_cur() != gen.TOK_EOF {
        let stmt_result int = 0;
        if (gs.task.c_ast_capture != 0) {
            stmt_result = parse_stmt_capture();
        } else {
            stmt_result = parse_stmt();
        }
        if (stmt_result != 0) {
            return -1;
        }
    }
    if (p_expect(gen.TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    gen.scope_pop();
    if (own_ast != 0 && ast.ast_stmt_end(block_ast, gs.task.c_pos) != 0) {
        return -1;
    }
    if (own_ast != 0 && top_root != 0 && gs.task.c_file_decl_i >= 0
        && (gs.task.c_ct_prepare_active == 0 || gs.task.c_file_indexed != 0)
        && ast.ast_decl_attach_body(gs.task.c_active_file, gs.task.c_file_decl_i, block_ast) != 0) {
        return -1;
    }
    return 0;
}

// parse_stmt_capture：仅供 check worker 包装一条语句并记录 AST 范围。
fn parse_stmt_capture() int {
    let gs *gen.GenState = gen.G();
    let first int = gs.task.c_pos;
    let op int = p_cur();
    let kind int = ast.AST_STMT_EXPR;
    let diag_kind int = 0;
    let typed_if int = 0;
    let typed_for int = 0;
    if (op == gen.TK_LBRACE) { kind = ast.AST_STMT_BLOCK; }
    if (op == gen.TK_LET || op == gen.TK_CONST) { kind = ast.AST_STMT_DECL; }
    if (op == gen.TK_STRUCT || op == gen.TK_UNION || op == gen.TK_ENUM
        || op == gen.TK_TYPE) { kind = ast.AST_STMT_TYPE; }
    if (op == gen.TK_IF) { kind = ast.AST_STMT_IF; }
    if (op == gen.TK_FOR) { kind = ast.AST_STMT_FOR; }
    if (op == gen.TK_DOLLAR && (p_peek(1) == gen.TK_IF || p_peek(1) == gen.TK_FOR)) {
        kind = ast.AST_STMT_COMPTIME;
        if (gs.task.c_ct_prepare_active != 0 && gs.task.c_ast_capture != 0) {
            if (p_peek(1) == gen.TK_IF) { typed_if = 1; }
            if (p_peek(1) == gen.TK_FOR) { typed_for = 1; }
        }
    } else if (op == gen.TK_DOLLAR && parse_comptime_diag_kind_at(first) != 0) {
        kind = ast.AST_STMT_COMPTIME;
        diag_kind = parse_comptime_diag_kind_at(first);
    }
    if (op == gen.TK_SWITCH) { kind = ast.AST_STMT_SWITCH; }
    if (op == gen.TK_RETURN) { kind = ast.AST_STMT_RETURN; }
    if (op == gen.TK_BREAK) { kind = ast.AST_STMT_BREAK; }
    if (op == gen.TK_CONTINUE) { kind = ast.AST_STMT_CONTINUE; }
    if (op == gen.TK_GOTO) { kind = ast.AST_STMT_GOTO; }
    if (op == gen.TOK_IDENT && p_peek(1) == gen.TK_COLON) {
        kind = ast.AST_STMT_LABEL;
    } else if (kind == ast.AST_STMT_EXPR) {
        let assign_op int = scan_assign_ahead();
        if (assign_op != 0) {
            kind = ast.AST_STMT_ASSIGN;
            op = assign_op;
        }
    }
    let id int = ast.ast_stmt_begin(kind, op, first);
    if (id < 0) { return -1; }
    if (parse_stmt() != 0) {
        return -1;
    }
    if (diag_kind != 0) { ast.ast_stmt_node_op_set(id, diag_kind); }
    if (typed_if != 0) { ast.ast_stmt_node_op_set(id, gen.TK_IF); }
    if (typed_for != 0 && ast.ast_stmt_node_op_of(id) != 0) {
        ast.ast_stmt_node_op_set(id, gen.TK_FOR);
    }
    return ast.ast_stmt_end(id, gs.task.c_pos);
}

// parse_stmt：按首 token 分派语句并调用现有语义钩子。
fn parse_stmt_inner() int {
    let gs *gen.GenState = gen.G();
    let k int = p_cur();
    if (k == gen.TK_LBRACE) {
        return parse_block();
    }
    if (k == gen.TK_STRUCT || k == gen.TK_UNION || k == gen.TK_ENUM || k == gen.TK_TYPE) {
        // 类型声明禁止嵌套（pub struct 一等化）：struct/union/enum/type
        // 只能出现在顶层，函数体内一律拒绝。
        return gen.err_tok("类型声明只能出现在顶层（函数体内不允许 struct/union/enum/type 声明）");
    }
    if (k == gen.TK_LET) {
        return parse_let_decl(0);
    }
    if (k == gen.TK_CONST) {
        return parse_const_decl(0);
    }
    if (k == gen.TK_IF) {
        return parse_if();
    }
    if (k == gen.TK_FOR) {
        return parse_for();
    }
    if (k == gen.TK_DOLLAR && (p_peek(1) == gen.TK_IF || p_peek(1) == gen.TK_FOR)) {
        return parse_comptime_control();
    }
    if (k == gen.TK_SWITCH) {
        return parse_switch();
    }
    if (k == gen.TK_RETURN) {
        return parse_return();
    }
    if (k == gen.TK_BREAK || k == gen.TK_CONTINUE) {
        if (gs.task.c_compile != 0
            && comptime.ct_validate_loop_exit(gs.task.c_loop_depth, k) != 0) { return -1; }
        p_adv();
        let br int = 0;
        if (k == gen.TK_BREAK) {
            br = gen.sem_break();
        } else {
            br = gen.sem_continue();
        }
        if (br != 0) {
            return -1;
        }
        return p_expect(gen.TK_SEMI, "期望 ';'");
    }
    if (k == gen.TK_GOTO) {
        p_adv();
        if (p_cur() != gen.TOK_IDENT) {
            return gen.err_tok("goto 后需要标签名");
        }
        let gstart int = gs.task.c_toks[gs.task.c_pos].start;
        let glen int = gs.task.c_toks[gs.task.c_pos].len;
        p_adv();
        if (gen.sem_goto(gstart, glen) != 0) {
            return -1;
        }
        return p_expect(gen.TK_SEMI, "期望 ';'");
    }
    // 标签语句：IDENT ':' stmt
    if (k == gen.TOK_IDENT && p_peek(1) == gen.TK_COLON) {
        let lstart int = gs.task.c_toks[gs.task.c_pos].start;
        let llen int = gs.task.c_toks[gs.task.c_pos].len;
        p_adv();
        p_adv();
        if (gen.sem_deflabel(lstart, llen) != 0) {
            return -1;
        }
        if (gs.task.c_ast_capture != 0) {
            return parse_stmt_capture();
        }
        return parse_stmt();
    }
    // 表达式语句 / 单目标赋值
    let aop int = scan_assign_ahead();
    if (aop != 0) {
        let lres gen.Res;
        let save int = gs.task.c_lvalue;
        gs.task.c_lvalue += 1;
        let r int = parse_expr(&lres);
        gs.task.c_lvalue = save;
        if (r != 0) {
            return -1;
        }
        if (gs.task.c_compile != 0 && gs.task.c_res_is_addr == 0) {
            return gen.sem_err("赋值目标必须是可寻址的表达式");
        }
        // 消费赋值运算符
        p_adv();
        if (gen.sem_stash_lvalue() != 0) {
            return -1;
        }
        // RHS 恒为值上下文（清 c_lvalue，避免 s[i] 被取地址）；
        // 数组/切片字面量以左值类型为目标类型上下文
        let rres gen.Res;
        let save_lv2 int = gs.task.c_lvalue;
        gs.task.c_lvalue = 0;
        let save_exp int = gs.task.c_expect_tid;
        gs.task.c_expect_tid = lres.type_id;
        let rr int = parse_expr(&rres);
        gs.task.c_expect_tid = save_exp;
        gs.task.c_lvalue = save_lv2;
        if (rr != 0) {
            return -1;
        }
        if (gs.task.c_compile != 0) {
            if (gen.sem_can_assign(lres.type_id, rres.type_id, rres.is_lit, rres.ival, rres.lit_big) != 0) {
                return -1;
            }
            // RHS 值压栈，供 sem_assign 弹出（与 sem_assign 的取改存协议配套）
            if (gen.em_push() != 0) {
                return -1;
            }
            if (gen.sem_assign(aop, &lres, &rres) != 0) {
                return -1;
            }
        }
        return p_expect(gen.TK_SEMI, "期望 ';'");
    }
    let res gen.Res;
    let saved_diag_stmt int = gs.task.c_ct_diag_stmt;
    gs.task.c_ct_diag_stmt = 1;
    let expr_status int = parse_expr(&res);
    gs.task.c_ct_diag_stmt = saved_diag_stmt;
    if (expr_status != 0) {
        return -1;
    }
    if (p_expect(gen.TK_SEMI, "期望 ';'") != 0) { return -1; }
    if (gs.task.c_compile != 0 && res.ct_diag != 0
        && (gs.task.c_fn_flags & gen.F_COMPTIME) == 0) {
        return comptime.ct_diag_emit(res.ct_diag, res.ival,
            res.ct_diag_line, res.ct_diag_col,
            res.ct_diag_msg_start, res.ct_diag_msg_len);
    }
    return 0;
}

// parse_stmt：隔离当前语句的调用效果，并更新函数顺序落底状态。
fn parse_stmt() int {
    let gs *gen.GenState = gen.G();
    let first_kind int = p_cur();
    gs.task.c_expr_noreturn = 0;
    let status int = parse_stmt_inner();
    if (status != 0 || gs.task.c_compile == 0) { return status; }
    if (first_kind == gen.TK_RETURN || first_kind == gen.TK_BREAK
        || first_kind == gen.TK_CONTINUE) {
        gs.task.c_fn_falls = 0;
    } else if (first_kind != gen.TK_IF && first_kind != gen.TK_FOR
        && first_kind != gen.TK_SWITCH && first_kind != gen.TK_LBRACE
        && gs.task.c_expr_noreturn != 0) {
        gs.task.c_fn_falls = 0;
    }
    return 0;
}

// parse_return：'return' expr? ';'。返回类型检查与收尾跳转由 sem 层管理。
fn parse_return() int {
    let gs *gen.GenState = gen.G();
    p_adv();
    if (gs.task.c_compile != 0) {
        if ((gs.task.c_fn_flags & gen.F_NORETURN) != 0) {
            return gen.sem_err("noreturn 函数定义不能包含 return");
        }
        if (gs.task.c_fn_ret == gen.TY_VOID && p_cur() != gen.TK_SEMI) {
            return gen.sem_err("void 函数不能返回值");
        }
        if (gs.task.c_fn_ret != gen.TY_VOID && p_cur() == gen.TK_SEMI) {
            return gen.sem_err("非 void 函数必须返回值");
        }
    }
    if (p_cur() != gen.TK_SEMI) {
        let r gen.Res;
        // 聚合字面量需要目标类型上下文：return 表达式的目标类型是函数返回类型
        // （与 let 初始化/赋值/调用实参一致，见 parse_array_literal）；非字面量
        // 表达式不受影响，随后的 sem_can_assign 仍做完整校验。
        let save_expect int = gs.task.c_expect_tid;
        gs.task.c_expect_tid = gs.task.c_fn_ret;
        let rr int = parse_expr(&r);
        gs.task.c_expect_tid = save_expect;
        if (rr != 0) {
            return -1;
        }
        if (gs.task.c_compile != 0) {
            if (gen.sem_can_assign(gs.task.c_fn_ret, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
                return -1;
            }
            if (gen.sem_return_value(&r) != 0) {
                return -1;
            }
        }
    } else {
        if (gs.task.c_compile != 0) {
            if (gen.em_jmp(gs.task.c_fn_lbl) != 0) {
                return -1;
            }
        }
    }
    return p_expect(gen.TK_SEMI, "期望 ';'");
}

// parse_if：'if' '(' expr ')' block ('else' (ifStmt | block))?。
fn parse_if() int {
    let gs *gen.GenState = gen.G();
    let parent_falls int = gs.task.c_fn_falls;
    p_adv();
    if (p_expect(gen.TK_LPAREN, "if 条件必须带括号") != 0) {
        return -1;
    }
    let cond gen.Res;
    if (parse_expr_iso(&cond) != 0) {
        return -1;
    }
    if (p_expect(gen.TK_RPAREN, "期望 ')'") != 0) {
        return -1;
    }
    if (sem_check_cond(&cond) != 0) {
        return -1;
    }
    let lbl_else int = 0;
    let lbl_end int = 0;
    if (gs.task.c_compile != 0) {
        lbl_else = gen.em_new_label();
        if (gen.em_jz(lbl_else) != 0) {
            return -1;
        }
    }
    gs.task.c_fn_falls = 1;
    if (parse_block() != 0) {
        return -1;
    }
    let then_falls int = gs.task.c_fn_falls;
    if (p_cur() == gen.TK_ELSE) {
        p_adv();
        if (gs.task.c_compile != 0) {
            lbl_end = gen.em_new_label();
            if (gen.em_jmp(lbl_end) != 0) {
                return -1;
            }
            if (gen.em_label(lbl_else) != 0) {
                return -1;
            }
        }
        gs.task.c_fn_falls = 1;
        if (p_cur() == gen.TK_IF) {
            let nested_if_result int = 0;
            if (gs.task.c_ast_capture != 0) {
                nested_if_result = parse_stmt_capture();
            } else {
                nested_if_result = parse_stmt();
            }
            if (nested_if_result != 0) {
                return -1;
            }
        } else {
            if (parse_block() != 0) {
                return -1;
            }
        }
        if (gs.task.c_compile != 0) {
            if (gen.em_label(lbl_end) != 0) {
                return -1;
            }
        }
        let else_falls int = gs.task.c_fn_falls;
        gs.task.c_fn_falls = parent_falls != 0
            && (then_falls != 0 || else_falls != 0) ? 1 : 0;
        return 0;
    }
    gs.task.c_fn_falls = parent_falls != 0 ? 1 : 0;
    if (gs.task.c_compile != 0) {
        if (gen.em_label(lbl_else) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_for：三种形态（无限 / 条件 / for-in）。
fn parse_for() int {
    let gs *gen.GenState = gen.G();
    let parent_falls int = gs.task.c_fn_falls;
    p_adv();
    if (p_cur() == gen.TK_LBRACE) {
        // 无限循环
        let ibrk int = gen.em_new_label();
        let iend int = gen.em_new_label();
        if (gs.task.c_compile != 0) {
            if (gen.sem_loop_push(iend, ibrk) != 0) {
                return -1;
            }
            if (gen.em_label(ibrk) != 0) {
                return -1;
            }
        }
        gs.task.c_fn_falls = 1;
        if (parse_block() != 0) {
            return -1;
        }
        let loop_depth int = gs.task.c_loop_depth;
        let has_break int = loop_depth > 0
            ? gs.task.c_loop_break_seen[loop_depth - 1] : 0;
        gs.task.c_fn_falls = parent_falls != 0 && has_break != 0 ? 1 : 0;
        if (gs.task.c_compile != 0) {
            if (gen.em_jmp(ibrk) != 0) {
                return -1;
            }
            if (gen.em_label(iend) != 0) {
                return -1;
            }
            gen.sem_loop_pop();
        }
        return 0;
    }
    if (p_cur() == gen.TOK_IDENT) {
        // for-in 形态：语法全保留；编译模式 B7 提供
        let is_in int = 0;
        if (p_peek(1) == gen.TK_IN) {
            is_in = 1;
        }
        if (p_peek(1) == gen.TK_COMMA && p_peek(2) == gen.TOK_IDENT && p_peek(3) == gen.TK_IN) {
            is_in = 1;
        }
        if (is_in != 0) {
            // 解析绑定：for v in ...  或 for i, v in ...
            let idx_start int = -1;
            let idx_len int = -1;
            let idx_token int = -1;
            let elem_start int = -1;
            let elem_len int = -1;
            let elem_token int = -1;
            if (p_peek(1) == gen.TK_IN) {
                // 只有元素绑定
                elem_token = gs.task.c_pos;
                elem_start = gs.task.c_toks[gs.task.c_pos].start;
                elem_len = gs.task.c_toks[gs.task.c_pos].len;
                p_adv();
                p_adv();
            } else {
                // 下标 + 元素绑定
                idx_token = gs.task.c_pos;
                idx_start = gs.task.c_toks[gs.task.c_pos].start;
                idx_len = gs.task.c_toks[gs.task.c_pos].len;
                p_adv();
                p_adv();
                elem_token = gs.task.c_pos;
                elem_start = gs.task.c_toks[gs.task.c_pos].start;
                elem_len = gs.task.c_toks[gs.task.c_pos].len;
                p_adv();
                p_adv();
            }
            let it gen.Res;
            if (parse_expr_blockctx(&it) != 0) {
                return -1;
            }
            let is_range int = 0;
            let end_res gen.Res;
            let start_off int = 0;
            if (p_cur() == gen.TK_RANGE) {
                is_range = 1;
                // 起点（x0）先存槽，再求终点
                if (gs.task.c_compile != 0) {
                    start_off = gen.em_alloc_local(8);
                    if (gen.em_lea_local_to(start_off) != 0) { return -1; }
                    if (gen.em_ins("str\tx0, [x10]") != 0) { return -1; }
                }
                p_adv();
                if (parse_expr_blockctx(&end_res) != 0) {
                    return -1;
                }
            }
            if (gs.task.c_compile == 0) {
                return parse_block();
            }
            // 编译模式：建立迭代层
            if (is_range != 0) {
                if (sem_check_cond(&it) != 0) { return -1; }
                if (sem_check_cond(&end_res) != 0) { return -1; }
                // 终点（x0）存临时槽
                gs.task.c_end_tmp_off = gen.em_alloc_local(8);
                if (gen.em_lea_local_to(gs.task.c_end_tmp_off) != 0) { return -1; }
                if (gen.em_ins("str\tx0, [x10]") != 0) { return -1; }
            }
            let lcond int = gen.em_new_label();
            let lend int = gen.em_new_label();
            if (gen.sem_loop_push(lend, lcond) != 0) { return -1; }
            gen.scope_push();
            if (is_range != 0) {
                // 起点从槽读回 x0，然后启动区间迭代
                if (gen.em_lea_local_to(start_off) != 0) { return -1; }
                if (gen.em_ins("ldr\tx0, [x10]") != 0) { return -1; }
                if (gen.sem_forin_begin(&it, 1, &end_res) != 0) { return -1; }
            } else {
                if (gen.sem_forin_begin(&it, 0, &end_res) != 0) { return -1; }
            }
            // 绑定声明为局部（值拷贝）
            let eoff int = -1;
            let ioff int = -1;
            if (elem_start >= 0) {
                let etid int = gen.sem_forin_elem_type(&it, is_range);
                let esym int = gen.sem_declare_local(elem_start, elem_len, etid);
                if (esym < 0) { return -1; }
                if (gs.task.c_ast_capture != 0 && ast.ast_binding_add(esym, elem_token, 0) != 0) {
                    return -1;
                }
                eoff = gs.task.c_syms[esym].offset;
            }
            if (idx_start >= 0) {
                let isym int = gen.sem_declare_local(idx_start, idx_len, gen.TY_I32);
                if (isym < 0) { return -1; }
                if (gs.task.c_ast_capture != 0 && ast.ast_binding_add(isym, idx_token, 0) != 0) {
                    return -1;
                }
                ioff = gs.task.c_syms[isym].offset;
            }
            if (gen.sem_forin_set_bind(eoff, ioff) != 0) { return -1; }
            if (gen.em_label(lcond) != 0) { return -1; }
            if (gen.sem_forin_check(lend) != 0) { return -1; }
            if (gen.sem_forin_load(&it, is_range) != 0) { return -1; }
            gs.task.c_fn_falls = 1;
            if (parse_block() != 0) { return -1; }
            gs.task.c_fn_falls = parent_falls;
            if (gen.sem_forin_step(lcond) != 0) { return -1; }
            if (gen.em_label(lend) != 0) { return -1; }
            gen.scope_pop();
            gen.sem_forin_end();
            gen.sem_loop_pop();
            return 0;
        }
    }
    // 条件循环
    let lbl_cond int = gen.em_new_label();
    let lbl_end int = gen.em_new_label();
    if (gs.task.c_compile != 0) {
        if (gen.sem_loop_push(lbl_end, lbl_cond) != 0) {
            return -1;
        }
        if (gen.em_label(lbl_cond) != 0) {
            return -1;
        }
    }
    let cond gen.Res;
    if (parse_expr_blockctx(&cond) != 0) {
        return -1;
    }
    if (gs.task.c_compile != 0) {
        if (sem_check_cond(&cond) != 0) {
            return -1;
        }
        if (gen.em_jz(lbl_end) != 0) {
            return -1;
        }
    }
    gs.task.c_fn_falls = 1;
    if (parse_block() != 0) {
        return -1;
    }
    gs.task.c_fn_falls = parent_falls;
    if (gs.task.c_compile != 0) {
        if (gen.em_jmp(lbl_cond) != 0) {
            return -1;
        }
        if (gen.em_label(lbl_end) != 0) {
            return -1;
        }
        gen.sem_loop_pop();
    }
    return 0;
}

// parse_switch：'switch' expr '{' case 块* '}'。
// 控制值存专用槽；case 值要求编译期常量；无 fallthrough。
// 发射结构（每个 case）：
//   [比较值 v_i: ctrl==v_i → 跳 body]… 全不匹配 → 跳过块体到 next
//   body: 块体 → 跳 end
//   next:（下一个 case 的比较链开始处）
// default 分支的块体无条件执行（排在源码位置）。
fn parse_switch() int {
    let gs *gen.GenState = gen.G();
    p_adv();
    let ctrl gen.Res;
    if (parse_expr_blockctx(&ctrl) != 0) {
        return -1;
    }
    let slot int = 0;
    if (gs.task.c_compile != 0) {
        if (gen.ty_is_integer(ctrl.type_id) == 0) {
            return gen.sem_err("switch 控制值必须是整数");
        }
        slot = gen.em_alloc_local(8);
        if (gen.em_lea_local_to(slot) != 0) {
            return -1;
        }
        if (gen.em_ins("str\tx0, [x10]") != 0) {
            return -1;
        }
    }
    if (p_expect(gen.TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    let lbl_end int = gen.em_new_label();
    let ncases int = 0;
    for p_cur() == gen.TK_CASE || p_cur() == gen.TK_DEFAULT {
        let case_ast int = -1;
        if (gs.task.c_ast_capture != 0) {
            case_ast = ast.ast_stmt_begin(ast.AST_STMT_CASE, p_cur(), gs.task.c_pos);
            if (case_ast < 0) { return -1; }
        }
        let body_lbl int = gen.em_new_label();
        let skip_lbl int = gen.em_new_label();
        let is_case int = (p_cur() == gen.TK_CASE).to_type(int);
        if (is_case != 0) {
            p_adv();
            for 1 {
                let cv gen.Res;
                if (gs.task.c_compile != 0) {
                    gs.task.c_fold += 1;
                }
                let r int = parse_expr_blockctx(&cv);
                if (gs.task.c_compile != 0) {
                    gs.task.c_fold -= 1;
                }
                if (r != 0) {
                    return -1;
                }
                if (gs.task.c_compile != 0) {
                    if (cv.is_const == 0) {
                        return gen.sem_err("case 值必须是编译期常量");
                    }
                    ncases += 1;
                    if (ncases > 512) {
                        return gen.sem_err("switch 分支过多（上限 512 个 case 值）");
                    }
                    // 控制值 → x0，与常量比较；命中跳 body
                    if (gen.em_lea_local_to(slot) != 0) {
                        return -1;
                    }
                    if (gen.em_ins("ldr\tx0, [x10]") != 0) {
                        return -1;
                    }
                    let v int = cv.ival.to_type(int);
                    if (v >= 0 && v <= 4095) {
                        if (gen.em_frag("\tcmp\tx0, #") != 0) {
                            return -1;
                        }
                        if (gen.em_puti(v) != 0) {
                            return -1;
                        }
                        if (gen.em_frag("\n") != 0) {
                            return -1;
                        }
                    } else {
                        if (gen.em_mov_imm("x10", cv.ival) != 0) {
                            return -1;
                        }
                        if (gen.em_ins("cmp\tx0, x10") != 0) {
                            return -1;
                        }
                    }
                    if (gen.em_beq(body_lbl) != 0) {
                        return -1;
                    }
                }
                if (p_cur() == gen.TK_COMMA) {
                    p_adv();
                    continue;
                }
                break;
            }
            // 本 case 的值全部未命中 → 跳过块体
            if (gs.task.c_compile != 0) {
                if (gen.em_jmp(skip_lbl) != 0) {
                    return -1;
                }
                if (gen.em_label(body_lbl) != 0) {
                    return -1;
                }
            }
        } else {
            p_adv();
        }
        if (parse_block() != 0) {
            return -1;
        }
        if (gs.task.c_compile != 0) {
            if (gen.em_jmp(lbl_end) != 0) {
                return -1;
            }
            if (is_case != 0) {
                if (gen.em_label(skip_lbl) != 0) {
                    return -1;
                }
            }
        }
        if (gs.task.c_ast_capture != 0 && ast.ast_stmt_end(case_ast, gs.task.c_pos) != 0) {
            return -1;
        }
    }
    if (p_expect(gen.TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (gs.task.c_compile != 0) {
        if (gen.em_label(lbl_end) != 0) {
            return -1;
        }
    }
    return 0;
}
