module parse
import token
import ast
import support
import gen
import comptime

// p_ct_layout_array_close：在当前文件 token 中查找数组长度外层的右方括号。
fn p_ct_layout_array_close(first int) int {
    let depth int = 0
    let i int = first
    for i < token.ctx().count {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_EOF) { return -1 }
        if (kind == token.TK_LBRACKET) { depth += 1 }
        else if (kind == token.TK_RBRACKET) {
            if (depth == 0) { return i }
            depth -= 1
        }
        i += 1
    }
    return -1
}

// p_ct_layout_expr_needs_defer：识别必须等待 CT 函数、常量或 sizeof 布局的长度表达式。
fn p_ct_layout_expr_needs_defer(first int, after int) int {
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TK_DOLLAR || kind == token.TK_SIZEOF) { return 1 }
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST
                && support.ms().syms[sym].const_ready == 0) { return 1 }
        }
        i += 1
    }
    return 0
}

// p_ct_layout_expr_defer_now：当前 pass 下必须延迟求值的数组长度表达式。
// ① 含 `$` CT 调用或 `sizeof`：仅 pass1 延迟——CT 正文在 pass2 捕获，
//    之后的 pass 直接折叠（否则后续 pass 会重新拿回长度仍为 -2 的 pending
//    类型项，数组字面量个数检查会误报）。
// ② 引用未就绪 const：任何 pass 都延迟——普通 `const N int = 3;` 的值原本
//    只在全局子遍就绪，而全局/字段/形参/返回位置的 `[N]int` 在布局子遍就定长。
fn p_ct_layout_expr_defer_now(first int, after int) int {
    if (support.session().pass == 1 && p_ct_layout_expr_needs_defer(first, after) != 0) {
        return 1
    }
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST
                && support.ms().syms[sym].const_ready == 0) { return 1 }
        }
        i += 1
    }
    return 0
}

// p_ct_layout_expr_runnable：等待常量和 CT 函数中的 pending sizeof 类型布局就绪。
fn p_ct_layout_expr_runnable(first int, after int) int {
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST
                && support.ms().syms[sym].const_ready == 0) { return 0 }
        }
        if (kind == token.TK_DOLLAR && i + 1 < after
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            let sym int = support.sym_lookup(token.ctx().tokens[i + 1].start,
                token.ctx().tokens[i + 1].len)
            if (sym >= 0 && comptime.ct_layout_function_sym_pending(sym) != 0) {
                return 0
            }
        }
        if (kind == token.TK_SIZEOF && i + 3 < after
            && token.ctx().tokens[i + 1].kind == token.TK_LPAREN
            && token.ctx().tokens[i + 2].kind == token.TOK_IDENT) {
            let tid int = gen.ty_lookup_name(token.ctx().tokens[i + 2].start,
                token.ctx().tokens[i + 2].len)
            if (tid >= 0 && comptime.ct_layout_type_pending(tid) != 0) { return 0 }
        }
        i += 1
    }
    return 1
}

// p_ct_layout_expr_register：记录数组长度表达式直接依赖的值、类型和 CT 函数闭包。
fn p_ct_layout_expr_register(row int) int {
    let first int = comptime.ct_layout_expr_first(row)
    let after int = comptime.ct_layout_expr_after(row)
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST) {
                if (comptime.ct_layout_expr_value_dependency_add(row, sym) != 0) {
                    return -1
                }
                // 长度表达式引用的普通整数常量也要在布局期求出值：
                // `const N int = 3;` 原本只在全局子遍就绪，而全局/字段/形参
                // 位置的 `[N]int` 在布局子遍就要定长。仅限声明在前的常量，
                // 前向引用保持既有「编译期常量尚未就绪」诊断。
                if (support.ms().syms[sym].const_ready == 0
                    && gen.sym_declared_before(sym, token.ctx().tokens[first].line,
                        token.ctx().tokens[first].col) != 0
                    && comptime.ct_value_request_add(sym, support.ms().syms[sym].def_line,
                        support.ms().syms[sym].def_col) != 0) {
                    return -1
                }
            }
        }
        if (kind == token.TK_SIZEOF && i + 3 < after
            && token.ctx().tokens[i + 1].kind == token.TK_LPAREN
            && token.ctx().tokens[i + 2].kind == token.TOK_IDENT) {
            let tid int = gen.ty_lookup_name(token.ctx().tokens[i + 2].start,
                token.ctx().tokens[i + 2].len)
            if (tid >= 0
                && comptime.ct_layout_expr_type_dependency_add(row, tid) != 0) {
                return -1
            }
        }
        if (kind == token.TK_DOLLAR && i + 1 < after
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            let sym int = support.sym_lookup(token.ctx().tokens[i + 1].start,
                token.ctx().tokens[i + 1].len)
            if (sym >= 0
                && comptime.ct_layout_expr_function_dependency_add(row, sym) != 0) {
                return -1
            }
        }
        i += 1
    }
    return 0
}

// p_decl_ct_layout_eval_runnable：检查布局常量所依赖的值和 CT 函数是否可用。
fn p_decl_ct_layout_eval_runnable(start int) int {
    if (p_decl_ct_layout_const_unready(start) == 0) { return 0 }
    let sym int = p_decl_ct_layout_const_sym(start)
    if (sym < 0 || comptime.ct_value_request_runnable(sym) == 0) { return 0 }
    let i int = start
    for i < token.ctx().count && token.ctx().tokens[i].kind != token.TK_ASSIGN { i += 1 }
    if (i >= token.ctx().count) { return 0 }
    i += 1
    let first int = i
    let after int = i
    let depth int = 0
    for after < token.ctx().count {
        let kind int = token.ctx().tokens[after].kind
        if (kind == token.TK_SEMI && depth == 0) { break }
        if (kind == token.TK_LPAREN || kind == token.TK_LBRACKET
            || kind == token.TK_LBRACE) { depth += 1 }
        else if (kind == token.TK_RPAREN || kind == token.TK_RBRACKET
            || kind == token.TK_RBRACE) { depth -= 1 }
        after += 1
    }
    return p_ct_layout_expr_runnable(first, after)
}

// p_decl_ct_layout_const_unready：选择需要在布局期求值的未就绪整数 const。
// 两种来源：① 初始化器含 `$` CT 调用（原有判据）；② 该常量已被登记为布局
// 值请求——数组长度引用的普通常量（`const N int = 3;`）的值原本只在全局
// 子遍就绪，而全局/字段/形参/返回位置的 `[N]int` 在布局子遍就要定长。
fn p_decl_ct_layout_const_unready(start int) int {
    let saved int = token.ctx().pos
    token.ctx().pos = start
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_cur() == token.TK_LBRACKET) {
            p_adv()
            for p_cur() != token.TK_RBRACKET && p_cur() != token.TOK_EOF {
                p_adv()
            }
            if (p_cur() == token.TK_RBRACKET) { p_adv() }
        }
    }
    if (p_cur() == token.TK_PUB) { p_adv() }
    if (p_cur() != token.TK_CONST) {
        token.ctx().pos = saved
        return 0
    }
    p_adv()
    if (p_cur() != token.TOK_IDENT) {
        token.ctx().pos = saved
        return 0
    }
    let tok_pos int = token.ctx().pos
    let sym int = support.sym_lookup(token.ctx().tokens[tok_pos].start, token.ctx().tokens[tok_pos].len)
    token.ctx().pos = saved
    if (sym < 0 || support.ms().syms[sym].kind != support.SYM_CONST
        || support.ms().syms[sym].const_ready != 0
        || support.ty_is_integer(support.ms().syms[sym].type_id) == 0) { return 0 }
    let i int = tok_pos + 1
    let depth int = 0
    let has_call int = 0
    for i < token.ctx().count {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TK_SEMI && depth == 0) { break }
        if (kind == token.TK_LPAREN || kind == token.TK_LBRACKET || kind == token.TK_LBRACE) {
            depth += 1
        } else if (kind == token.TK_RPAREN || kind == token.TK_RBRACKET
            || kind == token.TK_RBRACE) {
            depth -= 1
        }
        if (kind == token.TK_DOLLAR && i + 1 < token.ctx().count
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            has_call = 1
            i += 1
        }
        i += 1
    }
    token.ctx().pos = saved
    if (has_call != 0) { return 1 }
    return comptime.ct_value_requested(sym)
}

// p_decl_ct_layout_const_sym：取得合格布局常量请求对应的全局符号编号。
fn p_decl_ct_layout_const_sym(start int) int {
    let saved int = token.ctx().pos
    token.ctx().pos = start
    if (p_cur() == token.TK_AT) {
        p_adv()
        if (p_cur() == token.TK_LBRACKET) {
            p_adv()
            for p_cur() != token.TK_RBRACKET && p_cur() != token.TOK_EOF { p_adv() }
            if (p_cur() == token.TK_RBRACKET) { p_adv() }
        }
    }
    if (p_cur() == token.TK_PUB) { p_adv() }
    if (p_cur() != token.TK_CONST) { token.ctx().pos = saved; return -1 }
    p_adv()
    if (p_cur() != token.TOK_IDENT) { token.ctx().pos = saved; return -1 }
    let tok_pos int = token.ctx().pos
    let sym int = support.sym_lookup(token.ctx().tokens[tok_pos].start, token.ctx().tokens[tok_pos].len)
    token.ctx().pos = saved
    return sym
}

// p_decl_ct_layout_const_register：登记请求并扫描初始化器中的未就绪 const 边。
fn p_decl_ct_layout_const_register(start int) int {
    if (p_decl_ct_layout_const_unready(start) == 0) { return 0 }
    let sym int = p_decl_ct_layout_const_sym(start)
    if (sym < 0 || sym >= support.ms().sym_n) { return support.fail("内部错误：布局常量符号丢失") }
    if (comptime.ct_value_request_add(sym, support.ms().syms[sym].def_line,
            support.ms().syms[sym].def_col) != 0) { return -1 }
    let i int = start
    for i < token.ctx().count && token.ctx().tokens[i].kind != token.TK_ASSIGN { i += 1 }
    if (i >= token.ctx().count) { return support.fail("内部错误：布局常量缺少初始化器") }
    i += 1
    let depth int = 0
    for i < token.ctx().count {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TK_SEMI && depth == 0) { break }
        if (kind == token.TK_LPAREN || kind == token.TK_LBRACKET || kind == token.TK_LBRACE) {
            depth += 1
        } else if (kind == token.TK_RPAREN || kind == token.TK_RBRACKET
            || kind == token.TK_RBRACE) {
            depth -= 1
        }
        if (kind == token.TOK_IDENT
            && (i == 0 || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let dep int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (dep >= 0 && dep < support.ms().sym_n && support.ms().syms[dep].kind == support.SYM_CONST
                && support.ms().syms[dep].const_ready == 0) {
                if (comptime.ct_value_dependency_add(sym, dep) != 0) { return -1 }
                // 依赖链上的常量同样要在布局期求出（`const N int = M + 1;`），
                // 但仅限声明在 owner 之前的依赖：前向引用保持既有诊断。
                if (gen.sym_declared_before(dep, support.ms().syms[sym].def_line,
                        support.ms().syms[sym].def_col) != 0
                    && comptime.ct_value_request_add(dep, support.ms().syms[dep].def_line,
                        support.ms().syms[dep].def_col) != 0) { return -1 }
            }
        }
        if (kind == token.TK_DOLLAR && i + 1 < token.ctx().count
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            let function_sym int = support.sym_lookup(token.ctx().tokens[i + 1].start,
                token.ctx().tokens[i + 1].len)
            if (function_sym >= 0
                && comptime.ct_value_function_dependency_add(sym,
                    function_sym) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// parse_source_ct_layout_register：先登记当前文件全部请求，使跨文件依赖边有稳定目标。
pub fn parse_source_ct_layout_register() int {
    if (comptime.ct_layout_request_count() == 0) { return 0 }
    let row int = 0
    for row < comptime.ct_layout_request_count() {
        if (comptime.ct_layout_expr_pending(row) != 0
            && comptime.ct_layout_expr_file(row) == support.session().active_file
            && p_ct_layout_expr_register(row) != 0) { return -1 }
        row += 1
    }
    if (ast.store().file_indexed != 0) {
        let i int = 0
        for i < ast.store().file_decl_n {
            let node token.PDecl = ast.store().file_decls[i]
            if (node.kind == token.TK_CONST
                && p_decl_ct_layout_const_register(node.start) != 0) { return -1 }
            i += 1
        }
        return 0
    }
    let saved int = token.ctx().pos
    token.ctx().pos = 0
    mod_skip_head()
    for p_cur() != token.TOK_EOF {
        let first int = token.ctx().pos
        if (p_top_decl_kind() == token.TK_CONST
            && p_decl_ct_layout_const_register(first) != 0) {
            token.ctx().pos = saved
            return -1
        }
        if (skip_top_decl() != 0) { token.ctx().pos = saved; return -1 }
    }
    token.ctx().pos = saved
    return 0
}

// parse_source_ct_layout_consts：只执行依赖已 READY 的布局常量请求。
pub fn parse_source_ct_layout_consts() int {
    if (comptime.ct_layout_request_count() == 0) { return 0 }
    let saved_pos int = token.ctx().pos
    let saved_capture int = support.session().ast_capture
    support.session().ast_capture = 0
    if (ast.store().file_indexed != 0) {
        let status int = parse_indexed_decls(4)
        support.session().ast_capture = saved_capture
        token.ctx().pos = saved_pos
        return status
    }
    token.ctx().pos = 0
    mod_skip_head()
    for p_cur() != token.TOK_EOF {
        let first int = token.ctx().pos
        if (p_top_decl_kind() == token.TK_CONST
            && p_decl_ct_layout_eval_runnable(first) != 0) {
            if (parse_top_decl() != 0) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return -1
            }
        } else if (skip_top_decl() != 0) {
            support.session().ast_capture = saved_capture
            token.ctx().pos = saved_pos
            return -1
        }
    }
    support.session().ast_capture = saved_capture
    token.ctx().pos = saved_pos
    return 0
}

// parse_source_ct_layout_exprs：在所属文件上下文中执行已满足依赖的数组长度表达式。
pub fn parse_source_ct_layout_exprs() int {
    if (comptime.ct_layout_expr_pending_count() == 0) { return 0 }
    let saved_pos int = token.ctx().pos
    let saved_capture int = support.session().ast_capture
    support.session().ast_capture = 0
    let row int = 0
    for row < comptime.ct_layout_request_count() {
        if (comptime.ct_layout_expr_pending(row) == 0
            || comptime.ct_layout_expr_file(row) != support.session().active_file) {
            row += 1
            continue
        }
        let first int = comptime.ct_layout_expr_first(row)
        let after int = comptime.ct_layout_expr_after(row)
        if (first < 0 || after <= first || after > token.ctx().count) {
            support.session().ast_capture = saved_capture
            token.ctx().pos = saved_pos
            return support.fail("内部错误：数组长度表达式 token 范围无效")
        }
        if (p_ct_layout_expr_runnable(first, after) != 0) {
            token.ctx().pos = first
            support.fc().c_fold += 1
            let result support.Res
            let status int = parse_expr(&result)
            support.fc().c_fold -= 1
            if (status != 0 || token.ctx().pos != after) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                if (status != 0) { return -1 }
                return support.err_lc(token.ctx().tokens[first].line,
                    token.ctx().tokens[first].col, "数组长度表达式解析范围不匹配")
            }
            if (result.is_const == 0 || result.layout_type_id >= 0) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return support.err_lc(token.ctx().tokens[first].line,
                    token.ctx().tokens[first].col, "数组长度必须是编译期常量")
            }
            if (comptime.ct_layout_expr_set_length(row, result.ival) != 0) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return -1
            }
        }
        row += 1
    }
    support.session().ast_capture = saved_capture
    token.ctx().pos = saved_pos
    return 0
}

// 枚举判别值延迟求值表：pass1 遇到含编译期调用的判别值时登记，正文捕获完成后
// 按登记顺序回填成员常量。上限 64；独立全局数组，避免撑大 GenState 字段偏移。
let enump_n int = 0
let enump_sym [64]int   // 成员常量符号下标
let enump_first [64]int // 显式值表达式起始 token；-1 = 隐式成员（前值 + 1）
let enump_after [64]int // 显式值表达式结束后的 token 下标
let enump_prev [64]int  // 声明顺序上的前一个成员符号；-1 = 无

// ct_enum_pending_add：登记一个待回填的枚举成员常量，返回非零表示表满。
fn ct_enum_pending_add(sym int, first int, after int, prev int) int {
    if (enump_n >= 64) { return -1 }
    enump_sym[enump_n] = sym
    enump_first[enump_n] = first
    enump_after[enump_n] = after
    enump_prev[enump_n] = prev
    enump_n += 1
    return 0
}

// ct_enum_pending_run：按登记顺序回填延迟的枚举成员常量。显式成员重解析表达式
// （此时编译期函数正文已捕获），隐式成员取前一成员值 + 1。
pub fn ct_enum_pending_run() int {
    if (enump_n == 0) { return 0 }
    let saved_pos int = token.ctx().pos
    let saved_capture int = support.session().ast_capture
    support.session().ast_capture = 0
    let i int = 0
    for i < enump_n {
        let sym int = enump_sym[i]
        let val i64 = 0
        if (enump_first[i] < 0) {
            let prev int = enump_prev[i]
            if (prev >= 0) {
                let pv int = support.ms().syms[prev].cval.to_type(int)
                val = (pv + 1).to_type(i64)
            }
        } else {
            let first int = enump_first[i]
            let after int = enump_after[i]
            if (after <= first || after > token.ctx().count) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return support.fail("内部错误：延迟枚举判别值 token 范围无效")
            }
            token.ctx().pos = first
            support.fc().c_fold += 1
            let result support.Res
            let status int = parse_expr(&result)
            support.fc().c_fold -= 1
            if (status != 0) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return -1
            }
            if (token.ctx().pos != after || result.is_const == 0) {
                support.session().ast_capture = saved_capture
                token.ctx().pos = saved_pos
                return support.err_lc(token.ctx().tokens[first].line, token.ctx().tokens[first].col,
                    "枚举判别值必须是编译期常量")
            }
            val = result.ival
        }
        support.ms().syms[sym].cval = val
        support.ms().syms[sym].const_ready = 1
        // 同步枚举成员表里的值快照（按名字池偏移匹配）。
        gen.em_update_value(support.ms().syms[sym].name_off, val)
        i += 1
    }
    support.session().ast_capture = saved_capture
    token.ctx().pos = saved_pos
    return 0
}
