module parse
import token
import check
import support
import comptime
import ast

// ============================================================================
// parse_expr.yh —— 自举编译器：表达式解析（语义钩子集成）
//
// 覆盖 docs/yh.g4 表达式优先级链（低 → 高）：
//   三元 ?: → || → && → | → ^ → & → ==/!= → 比较 → 移位 → 加减
//   → 乘除模 → 一元 → 后缀（调用/下标/.to_type/.成员） → 基本表达式。
//
// 语义协议：每个解析函数把结果通过 *Res 出参返回（类型/常量性/字面量
// 标记）；编译模式同时发码（结果留 x0）。c_fold>0 时只折叠。
// &&/|| 与三元由解析器配合 sem_* 钩子用标签短路实现。
//
// 「结构体字面量 vs 块」消解与 G1 相同：块跟随上下文（for/switch/case
// 头部）先试探 structInitBody 且配对 '}' 后必须紧跟 '{'，否则回退为块；
// 编译模式中结构体字面量作为值使用统一拒绝（B5 仅支持 let 直接初始化）。
// ============================================================================

// px_nest_depth / PX_NEST_MAX：表达式递归深度守卫。
//
// 括号、调用实参、下标、一元运算都是递归下降实现，嵌套层数不受控时会在
// 数千层耗尽宿主栈：实测 2,000 层可过、4,000 层 SIGSEGV（8 MB 栈）。
// 上限取 256，与 Clang 的 `-fbracket-depth` 缺省一致：远超手写与常见生成
// 代码的深度，又给 1 MB 线程栈留出余量。超限按语法错误拒绝而不是崩溃。
const PX_NEST_MAX int = 256
let px_nest_depth int = 0

// px_nest_enter：进入一层表达式递归；超限时在当前 token 处报错并返回非 0
// （此时不增加计数，调用方不必回退）。
fn px_nest_enter() int {
    if (px_nest_depth >= PX_NEST_MAX) {
        return token.err_tok("表达式嵌套层数超过上限 256")
    }
    px_nest_depth += 1
    return 0
}

// px_nest_leave：退出一层表达式递归。守卫包在入口包装里，内层任意 return
// 路径都不必各自减计数。
fn px_nest_leave() void {
    if (px_nest_depth > 0) {
        px_nest_depth -= 1
    }
}

// parse_expr：表达式入口（= 条件表达式层；`$if` 表达式位于链最上层）。
fn parse_expr(res *support.Res) int {
    if (px_nest_enter() != 0) {
        return -1
    }
    let r int = parse_expr_inner(res)
    px_nest_leave()
    return r
}

fn parse_expr_inner(res *support.Res) int {
    if (p_cur() == token.TK_DOLLAR && p_peek(1) == token.TK_IF) {
        // 与三元同等的 capture 语义：子表达式以 depth>0 解析（不会误挂语句
        // 表达式边），CTIF 节点本身在最外层 depth==0 时挂载。
        if (support.session().ast_capture == 0) {
            return parse_ct_if_expr(res)
        }
        ast.ast_expr_depth_add(1)
        let r int = parse_ct_if_expr(res)
        ast.ast_expr_depth_add(-1)
        if (r == 0 && support.session().compile != 0 && res.ct_diag != 0
            && support.fc().c_ct_diag_stmt == 0) {
            return token.err_tok("编译期诊断只能作为独立语句")
        }
        if (r == 0 && res.ct_diag == 0 && ast.ast_expr_depth_now() == 0
            && ast.ast_stmt_add_expr(res.ast_id) != 0) {
            return -1
        }
        return r
    }
    if (support.session().ast_capture == 0) {
        let r int = parse_ternary(res)
        if (r == 0 && support.session().compile != 0 && res.ct_diag != 0
            && support.fc().c_ct_diag_stmt == 0) {
            return token.err_tok("编译期诊断只能作为独立语句")
        }
        return r
    }
    ast.ast_expr_depth_add(1)
    let r int = parse_ternary(res)
    ast.ast_expr_depth_add(-1)
    if (r == 0 && support.session().compile != 0 && res.ct_diag != 0
        && support.fc().c_ct_diag_stmt == 0) {
        return token.err_tok("编译期诊断只能作为独立语句")
    }
    if (r == 0 && res.ct_diag == 0 && ast.ast_expr_depth_now() == 0
        && ast.ast_stmt_add_expr(res.ast_id) != 0) {
        return -1
    }
    return r
}

// parse_ct_if_expr：编译期表达式选择 `$if (cond) e1 $else e2`。
// `$else` 必须书写（表达式没有「原值」）。
// 普通路径：cond 必须折叠为编译期常量，选中分支正常检查与发码，未选分支
// 以 c_em_suppress 静默发射但**保留完整语义检查**（合流需要两侧类型）。
// typed（comptime 函数正文捕获）路径：两个分支都正常解析并捕获 AST，
// 执行器（ct_ir kind 14）按 cond 的编译期值选支。合流按类型相等，
// 字面量分支可向另一分支类型窄化/加宽（复用 sem_can_assign 的 is_lit
// 路径，与 `?:` 的赋值语义一致）。
fn parse_ct_if_expr(res *support.Res) int {
    let typed int = (support.fc().c_ct_prepare_active != 0 && support.session().ast_capture != 0).to_type(int)
    let first int = token.ctx().pos
    let cond_ast int = -1
    let then_ast int = -1
    let else_ast int = -1
    p_adv()
    p_adv() // 消费 `$` 与 `if`
    if (p_expect(token.TK_LPAREN, "$if 条件必须带括号") != 0) { return -1 }
    let cond support.Res
    let saved_fold int = support.fc().c_fold
    let saved_target_ctx int = support.fc().c_ct_target_ctx
    if (support.session().compile != 0 && typed == 0) {
        support.fc().c_fold += 1
        support.fc().c_ct_target_ctx = 1
    }
    let cr int = parse_expr_iso(&cond)
    if (support.session().compile != 0 && typed == 0) {
        support.fc().c_fold = saved_fold
        support.fc().c_ct_target_ctx = saved_target_ctx
    }
    if (cr != 0 || p_expect(token.TK_RPAREN, "期望 ')' ") != 0) { return -1 }
    let selected int = -1
    if (support.session().compile != 0) {
        if (sem_check_cond(&cond) != 0) { return -1 }
        if (typed == 0) {
            if (cond.is_const == 0) {
                return token.err_tok("$if 表达式条件必须是编译期常量")
            }
            selected = (cond.ival != 0).to_type(int)
        }
    }
    if (support.session().ast_capture != 0) { cond_ast = cond.ast_id }
    // then 分支：普通路径未选时静默发射但保留语义检查，不捕获 AST。
    let saved_capture int = support.session().ast_capture
    let then support.Res
    if (typed == 0 && support.session().compile != 0 && selected == 0) {
        support.session().ast_capture = 0
    }
    if (parse_expr(&then) != 0) {
        support.session().ast_capture = saved_capture
        return -1
    }
    support.session().ast_capture = saved_capture
    if (support.session().ast_capture != 0) { then_ast = then.ast_id }
    if (p_cur() != token.TK_DOLLAR || p_peek(1) != token.TK_ELSE) {
        return token.err_tok("$if 表达式必须写 $else")
    }
    p_adv()
    p_adv()
    // else 分支：普通路径选中 then 时静默发射，仍做完整语义检查。
    let els support.Res
    if (typed == 0 && support.session().compile != 0 && selected == 1) {
        support.session().ast_capture = 0
    }
    if (parse_expr(&els) != 0) {
        support.session().ast_capture = saved_capture
        return -1
    }
    support.session().ast_capture = saved_capture
    if (support.session().ast_capture != 0) { else_ast = els.ast_id }
    let merged int = -1
    if (support.session().compile != 0 && ct_if_merge_type(&then, &els, &merged) != 0) {
        return -1
    }
    if (support.session().compile != 0) {
        if (typed == 0) {
            // 普通路径：结果取选中分支的值语义，类型用合流类型。
            let src support.Res
            if (selected != 0) {
                check.sem_res_copy(&src, &then)
            } else {
                check.sem_res_copy(&src, &els)
            }
            check.sem_res_copy(res, &src)
            res.type_id = merged
            res.sym = -1
            res.layout_type_id = -1
            res.ct_diag = 0
        } else {
            check.sem_res_reset(res, merged)
        }
    }
    if (support.session().ast_capture != 0
        && ast.ast_expr_finish(res, ast.AST_EXPR_CTIF, token.TK_IF, first,
            cond_ast, then_ast, else_ast) != 0) { return -1 }
    return 0
}

// ct_if_merge_type：$if 表达式两分支的类型合流检查。
// 两支类型相等 → 该类型；字面量分支可通过 sem_can_assign 的 is_lit 路径
// 向另一分支类型窄化/加宽（与 `?:` 的赋值语义一致）；其余拒绝。
fn ct_if_merge_type(then *support.Res, els *support.Res, merged *int) int {
    if (then.type_id == els.type_id) {
        merged[0] = then.type_id
        return 0
    }
    if (then.is_lit != 0) {
        if (check.sem_can_assign(els.type_id, then.type_id,
                then.is_lit, then.ival, then.lit_big) != 0) { return -1 }
        merged[0] = els.type_id
        return 0
    }
    if (els.is_lit != 0) {
        if (check.sem_can_assign(then.type_id, els.type_id,
                els.is_lit, els.ival, els.lit_big) != 0) { return -1 }
        merged[0] = then.type_id
        return 0
    }
    return token.err_tok("$if 表达式两个分支的类型不一致")
}

// parse_array_literal：数组/切片字面量 '[' e1, e2, ... ']'。
// 目标类型取自 c_expect_tid（let 初始化/赋值上下文预先设置）；无上下文
// 干净拒绝。数组要求元素个数与长度一致；切片按元素个数建 {len, data}
// 视图。元素先逐个求值压栈，再逆序弹入临时数组（与类型化变参打包同法）。
fn parse_array_literal(res *support.Res, first int) int {
    let tid int = support.fc().c_expect_tid
    support.fc().c_expect_tid = -1
    if (support.session().compile == 0) {
        // 语法模式：只消费元素 token
        if (p_cur() != token.TK_RBRACKET) {
            for 1 {
                let d support.Res
                if (parse_expr_iso(&d) != 0) {
                    return -1
                }
                if (p_cur() == token.TK_COMMA) {
                    p_adv()
                    if (p_cur() == token.TK_RBRACKET) { break }
                    continue
                }
                break
            }
        }
        return p_expect(token.TK_RBRACKET, "期望 ']'")
    }
    if (tid < 0) {
        return token.err_tok("数组/切片字面量需要目标类型上下文（let 初始化或同型赋值）")
    }
    let fk int = support.ms().types[tid].kind
    if (fk != support.TY_ARRAY && fk != support.TY_SLICE) {
        return token.err_tok("数组/切片字面量的目标必须是数组或切片类型")
    }
    let elem int = support.ms().types[tid].elem
    let esz int = support.ms().types[elem].size
    let list int = -1
    // 解析元素并逐个压栈
    let count int = 0
    if (p_cur() != token.TK_RBRACKET) {
        for 1 {
            let e support.Res
            let save_lv int = support.fc().c_lvalue
            let save_expect int = support.fc().c_expect_tid
            support.fc().c_lvalue = 0
            support.fc().c_expect_tid = elem
            let er int = parse_expr_iso(&e)
            support.fc().c_lvalue = save_lv
            support.fc().c_expect_tid = save_expect
            if (er != 0) {
                return -1
            }
            if (check.sem_can_assign(elem, e.type_id, e.is_lit, e.ival, e.lit_big) != 0) {
                return -1
            }
            if (check.sem_push_value(&e) != 0) {
                return -1
            }
            if (support.session().ast_capture != 0 && ast.ast_expr_args_append(&list, e.ast_id) != 0) {
                return -1
            }
            count += 1
            if (p_cur() == token.TK_COMMA) {
                p_adv()
                if (p_cur() == token.TK_RBRACKET) { break }
                continue
            }
            break
        }
    }
    if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) {
        return -1
    }
    if (fk == support.TY_ARRAY && count != support.ms().types[tid].len) {
        return token.err_tok("数组字面量元素个数与数组长度不一致")
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("数组/切片字面量不是编译期常量")
    }
    check.sem_res_reset(res, tid)
    res.is_lit = 0
    res.is_const = 0
    support.fc().c_res_is_addr = 1
    if (support.session().ast_capture != 0
        && ast.ast_expr_finish(res, ast.AST_EXPR_ARRAY, token.TK_LBRACKET, first, list, -1, -1) != 0) {
        return -1
    }
    return 0
}

// parse_expr_iso：隔离上下文——「IDENT {」恒按结构体字面量处理。
fn parse_expr_iso(res *support.Res) int {
    let save int = ctx().ctx_block
    ctx().ctx_block = 0
    let r int = parse_expr(res)
    ctx().ctx_block = save
    return r
}

// parse_expr_blockctx：块跟随上下文——for/switch/case 头部表达式。
fn parse_expr_blockctx(res *support.Res) int {
    let save int = ctx().ctx_block
    ctx().ctx_block = 1
    let r int = parse_expr(res)
    ctx().ctx_block = save
    return r
}

// parse_ternary：cond ? a : b（右结合；两支经值栈汇合）。
fn parse_ternary(res *support.Res) int {
    if (parse_logical_or(res) != 0) {
        return -1
    }
    if (p_cur() == token.TK_QUEST) {
        let first int = token.ctx().pos
        let cond_ast int = -1
        if (support.session().ast_capture != 0) {
            cond_ast = res.ast_id
            first = ast.ast_expr_start(cond_ast)
        }
        p_adv()
        if (check.sem_ternary_cond(res) != 0) {
            return -1
        }
        let mid support.Res
        if (parse_expr(&mid) != 0) {
            return -1
        }
        let mid_ast int = mid.ast_id
        if (p_expect(token.TK_COLON, "期望 ':'") != 0) {
            return -1
        }
        if (check.sem_ternary_mid(res) != 0) {
            return -1
        }
        if (parse_expr(res) != 0) {
            return -1
        }
        let else_ast int = res.ast_id
        if (check.sem_ternary_end(res) != 0) {
            return -1
        }
        check.sem_res_copy(res, &mid)
        support.fc().c_res_is_addr = 0
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_TERNARY, token.TK_QUEST,
                first, cond_ast, mid_ast, else_ast) != 0) {
            return -1
        }
    }
    return 0
}

// parse_logical_or：a || b（短路）。
fn parse_logical_or(res *support.Res) int {
    if (parse_logical_and(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_OROR {
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        let op int = p_cur()
        p_adv()
        if (check.sem_shortcircuit(token.TK_OROR, res) != 0) {
            return -1
        }
        if (parse_logical_and(res) != 0) {
            return -1
        }
        let right_ast int = res.ast_id
        if (check.sem_shortcircuit_end(token.TK_OROR, res) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, right_ast, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_logical_and：a && b（短路）。
fn parse_logical_and(res *support.Res) int {
    if (parse_bit_or(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_ANDAND {
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        let op int = p_cur()
        p_adv()
        if (check.sem_shortcircuit(token.TK_ANDAND, res) != 0) {
            return -1
        }
        if (parse_bit_or(res) != 0) {
            return -1
        }
        let right_ast int = res.ast_id
        if (check.sem_shortcircuit_end(token.TK_ANDAND, res) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, right_ast, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_bit_or：a | b。
fn parse_bit_or(res *support.Res) int {
    if (parse_bit_xor(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_PIPE {
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        let op int = token.TK_PIPE
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_bit_xor(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(token.TK_PIPE, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_bit_xor：a ^ b。
fn parse_bit_xor(res *support.Res) int {
    if (parse_bit_and(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_CARET {
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        let op int = token.TK_CARET
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_bit_and(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(token.TK_CARET, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_bit_and：a & b。
fn parse_bit_and(res *support.Res) int {
    if (parse_equality(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_AMP {
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        let op int = token.TK_AMP
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_equality(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(token.TK_AMP, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_equality：a == b、a != b。
fn parse_equality(res *support.Res) int {
    if (parse_relational(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_EQEQ || p_cur() == token.TK_NEQ {
        let op int = p_cur()
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_relational(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(op, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_relational：a < b、<=、>、>=。
fn parse_relational(res *support.Res) int {
    if (parse_shift(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_LT || p_cur() == token.TK_LEQ || p_cur() == token.TK_GT || p_cur() == token.TK_GEQ {
        let op int = p_cur()
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_shift(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(op, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_shift：a << b、a >> b。
fn parse_shift(res *support.Res) int {
    if (parse_additive(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_LSHIFT || p_cur() == token.TK_RSHIFT {
        let op int = p_cur()
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_additive(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(op, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_additive：a + b、a - b（含指针 ± 整数）。
fn parse_additive(res *support.Res) int {
    if (parse_multiplicative(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_PLUS || p_cur() == token.TK_MINUS {
        let op int = p_cur()
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_multiplicative(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(op, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_multiplicative：a * b、a / b、a % b。
fn parse_multiplicative(res *support.Res) int {
    if (parse_unary(res) != 0) {
        return -1
    }
    for p_cur() == token.TK_STAR || p_cur() == token.TK_SLASH || p_cur() == token.TK_PERCENT {
        let op int = p_cur()
        let left_ast int = -1
        let first int = token.ctx().pos
        if (support.session().ast_capture != 0) {
            left_ast = res.ast_id
            first = ast.ast_expr_start(left_ast)
        }
        p_adv()
        let rhs support.Res
        if (check.sem_push_value(res) != 0) { return -1 }
        if (parse_unary(&rhs) != 0) {
            return -1
        }
        if (check.sem_binop(op, res, &rhs) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_BINARY, op, first, left_ast, rhs.ast_id, -1) != 0) {
            return -1
        }
    }
    return 0
}

// parse_unary：一元运算（可嵌套；后缀优先于一元）。
// AMP 取地址：操作数按 lvalue 解析出地址；STAR 解引用：操作数恒按值
// 解析（得到指针值），结果作为地址参与外层（c_lvalue 语义由钩子处理）。
fn parse_unary(res *support.Res) int {
    let k int = p_cur()
    if (k == token.TK_MINUS || k == token.TK_PLUS || k == token.TK_BANG || k == token.TK_TILDE) {
        let first int = token.ctx().pos
        p_adv()
        if (parse_unary(res) != 0) {
            return -1
        }
        let child int = res.ast_id
        if (check.sem_unary(k, res) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_UNARY, k, first, child, -1, -1) != 0) {
            return -1
        }
        return 0
    }
    if (k == token.TK_STAR) {
        let first2 int = token.ctx().pos
        p_adv()
        let save int = support.fc().c_lvalue
        support.fc().c_lvalue = 0
        let r int = parse_unary(res)
        support.fc().c_lvalue = save
        if (r != 0) {
            return -1
        }
        let child2 int = res.ast_id
        if (check.sem_unary(token.TK_STAR, res) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_UNARY, token.TK_STAR, first2, child2, -1, -1) != 0) {
            return -1
        }
        return 0
    }
    if (k == token.TK_AMP) {
        let first3 int = token.ctx().pos
        p_adv()
        let save2 int = support.fc().c_lvalue
        // 取地址与「赋值目标」都是左值上下文，但只读性检查必须区分二者：
        // 赋值用 +1、取地址用 +2（`&const_agg` 合法，`const_agg.f = v` 不合法）。
        support.fc().c_lvalue += 2
        let r2 int = parse_unary(res)
        support.fc().c_lvalue = save2
        if (r2 != 0) {
            return -1
        }
        let child3 int = res.ast_id
        if (check.sem_unary(token.TK_AMP, res) != 0) {
            return -1
        }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_UNARY, token.TK_AMP, first3, child3, -1, -1) != 0) {
            return -1
        }
        return 0
    }
    return parse_postfix(res)
}

// parse_postfix：后缀链：调用、下标、.to_type(T)、.成员。
fn parse_postfix(res *support.Res) int {
    if (parse_primary(res) != 0) {
        return -1
    }
    for 1 {
        let k int = p_cur()
        if (k == token.TK_LPAREN) {
            if (support.session().compile != 0 && res.sym >= 0 && res.sym < support.ms().sym_n
                && support.ms().syms[res.sym].kind == support.SYM_FN
                && (support.ms().syms[res.sym].flags & support.F_COMPTIME) != 0) {
                return token.err_tok("编译期函数必须使用 $函数(...) 调用")
            }
            let base_ast int = -1
            let first int = token.ctx().pos
            if (support.session().ast_capture != 0) {
                base_ast = res.ast_id
                first = ast.ast_expr_start(base_ast)
            }
            // 调用：实参表为行内列表，不允许尾逗号
            p_adv()
            let direct int = check.sem_call_begin(res)
            if (direct < 0) {
                return -1
            }
            // 直接调用：以形参类型作为实参数组/切片字面量的目标上下文。
            // 仅编译模式：语法模式 t_types 未初始化（NULL），不可访问；
            // 且须校验 FN 类型，否则非函数被调者的 sub（字段表起点）
            // 会被误当签名号。
            let sig int = -1
            let np int = 0
            if (direct == 1 && support.session().compile != 0 && res.type_id >= 0) {
                if (support.ms().types[res.type_id].kind == support.TY_FN) {
                    sig = support.ms().types[res.type_id].sub
                    np = support.ms().sig_np[sig]
                }
            }
            let argi int = 0
            let args int = -1
            if (p_cur() != token.TK_RPAREN) {
                for 1 {
                    let arg support.Res
                    let save_exp2 int = support.fc().c_expect_tid
                    if (sig >= 0 && argi < np) {
                        support.fc().c_expect_tid = support.ms().sig_params[support.ms().sig_first[sig] + argi]
                    }
                    let pr int = parse_expr_iso(&arg)
                    support.fc().c_expect_tid = save_exp2
                    if (pr != 0) {
                        return -1
                    }
                    if (support.session().ast_capture != 0 && ast.ast_expr_args_append(&args, arg.ast_id) != 0) {
                        return -1
                    }
                    argi += 1
                    if (check.sem_push_arg(&arg, res) != 0) {
                        return -1
                    }
                    if (p_cur() == token.TK_COMMA) {
                        p_adv()
                        continue
                    }
                    break
                }
            }
            if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
                return -1
            }
            if (check.sem_call(res, res) != 0) {
                return -1
            }
            if (support.session().ast_capture != 0
                && ast.ast_expr_finish(res, ast.AST_EXPR_CALL, token.TK_LPAREN,
                    first, base_ast, args, -1) != 0) {
                return -1
            }
            continue
        }
        if (k == token.TK_LBRACKET) {
            let base_ast2 int = -1
            let first2 int = token.ctx().pos
            if (support.session().ast_capture != 0) {
                base_ast2 = res.ast_id
                first2 = ast.ast_expr_start(base_ast2)
            }
            // 下标 / 切片表达式：基址压栈 → 首个下标表达式（恒为值，
            // 清 c_lvalue）→ 遇 '..' 为切片形态（再解析终点），否则普通下标
            p_adv()
            if (check.sem_push_value(res) != 0) { return -1 }
            let idx support.Res
            let save_lv int = support.fc().c_lvalue
            support.fc().c_lvalue = 0
            let ir int = parse_expr(&idx)
            support.fc().c_lvalue = save_lv
            if (ir != 0) {
                return -1
            }
            if (p_cur() == token.TK_RANGE) {
                // base[start..end]：start 压栈后解析 end（值在 x0）
                p_adv()
                if (check.sem_push_value(&idx) != 0) { return -1 }
                let eidx support.Res
                support.fc().c_lvalue = 0
                let er int = parse_expr(&eidx)
                support.fc().c_lvalue = save_lv
                if (er != 0) {
                    return -1
                }
                let start_ast int = idx.ast_id
                let end_ast int = eidx.ast_id
                if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) {
                    return -1
                }
                if (check.sem_slice(res, &idx, &eidx) != 0) {
                    return -1
                }
                if (support.session().ast_capture != 0
                    && ast.ast_expr_finish(res, ast.AST_EXPR_SLICE, token.TK_RANGE,
                        first2, base_ast2, start_ast, end_ast) != 0) {
                    return -1
                }
                continue
            }
            let idx_ast int = idx.ast_id
            if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) {
                return -1
            }
            if (check.sem_index(res, &idx) != 0) {
                return -1
            }
            if (support.session().ast_capture != 0
                && ast.ast_expr_finish(res, ast.AST_EXPR_INDEX, token.TK_LBRACKET,
                    first2, base_ast2, idx_ast, -1) != 0) {
                return -1
            }
            continue
        }
        if (k == token.TK_DOT) {
            let base_ast3 int = -1
            let first3 int = token.ctx().pos
            if (support.session().ast_capture != 0) {
                base_ast3 = res.ast_id
                first3 = ast.ast_expr_start(base_ast3)
            }
            p_adv()
            if (p_cur() == token.TK_TO_TYPE) {
                // .to_type(T)：参数是类型引用而非表达式
                p_adv()
                if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
                    return -1
                }
                let tid int = parse_type_ref()
                if (tid < 0) {
                    return -1
                }
                if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
                    return -1
                }
                if (check.sem_cast(res, tid) != 0) {
                    return -1
                }
                if (support.session().ast_capture != 0
                    && ast.ast_expr_finish(res, ast.AST_EXPR_CAST, token.TK_TO_TYPE,
                        first3, base_ast3, -1, -1) != 0) {
                    return -1
                }
                continue
            }
            if (is_member_name(p_cur()) != 0) {
                let start int = token.ctx().tokens[token.ctx().pos].start
                let n int = token.ctx().tokens[token.ctx().pos].len
                let meta_bits int = 0
                if (support.session().compile != 0 && res.sym >= 0 && res.sym < support.ms().sym_n) {
                    meta_bits = support.ms().syms[res.sym].flags &
                        (support.F_ENUM_META | support.F_FIELD_META)
                }
                let enum_meta int = ((meta_bits & support.F_ENUM_META) != 0).to_type(int)
                let field_meta int = ((meta_bits & support.F_FIELD_META) != 0).to_type(int)
                let enum_name int = (enum_meta != 0 && p_tok_text_is("name", 4) != 0).to_type(int)
                let enum_value int = (enum_meta != 0 && p_tok_text_is("value", 5) != 0).to_type(int)
                let field_name int = (field_meta != 0 && p_tok_text_is("name", 4) != 0).to_type(int)
                p_adv()
                if (field_meta != 0) {
                    // 字段元信息：只投影 .name（字段名字符串常量）。
                    if (field_name == 0 || n != 4) {
                        return token.err_tok("字段元信息迭代变量只支持 .name")
                    }
                    if (check.sem_field_meta_name(res) != 0) { return -1 }
                    if (support.session().ast_capture != 0) {
                        let id int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, token.TOK_STRING,
                            first3, token.ctx().pos, res.type_id, -1, -1, -1)
                        if (id < 0 || ast.ast_expr_set_semantics(id, res) != 0) {
                            return -1
                        }
                        res.ast_id = id
                    }
                    continue
                }
                if (enum_meta != 0) {
                    let ast_op int = token.TOK_NUMBER
                    if (enum_name != 0 && n == 4) {
                        ast_op = token.TOK_STRING
                        if (check.sem_enum_meta_name(res) != 0) { return -1 }
                    } else if (enum_value != 0 && n == 5) {
                        if (check.sem_enum_meta_value(res) != 0) { return -1 }
                    } else {
                        return token.err_tok("枚举 values 迭代变量只支持 .name 和 .value")
                    }
                    if (support.session().ast_capture != 0) {
                        let id int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, ast_op,
                            first3, token.ctx().pos, res.type_id, -1, -1, -1)
                        if (id < 0 || ast.ast_expr_set_semantics(id, res) != 0) {
                            return -1
                        }
                        res.ast_id = id
                    }
                    continue
                }
                if (check.sem_member(res, start, n) != 0) {
                    return -1
                }
                if (support.session().ast_capture != 0
                    && ast.ast_expr_finish(res, ast.AST_EXPR_MEMBER, token.TK_DOT,
                        first3, base_ast3, -1, -1) != 0) {
                    return -1
                }
                continue
            }
            return token.err_tok("'.' 之后需要一个成员名")
        }
        break
    }
    if (support.session().compile != 0 && ctx().ct_meta_bare == 0
        && res.sym >= 0 && res.sym < support.ms().sym_n) {
        let bare_meta int = support.ms().syms[res.sym].flags &
            (support.F_ENUM_META | support.F_FIELD_META)
        if ((bare_meta & support.F_FIELD_META) != 0) {
            return token.err_tok("字段元信息迭代变量必须访问 .name 或作类型谓词实参")
        }
        if (bare_meta != 0) {
            return token.err_tok("枚举 values 迭代变量必须访问 .name 或 .value")
        }
    }
    return 0
}

// parse_primary：基本表达式。进入时重置地址标记。
fn parse_primary(res *support.Res) int {
    let first int = token.ctx().pos
    let op int = p_cur()
    if (parse_primary_impl(res, first) != 0) {
        return -1
    }
    if (support.session().ast_capture == 0) {
        return 0
    }
    let child int = res.ast_id
    let id int = ast.ast_expr_add(ast.AST_EXPR_PRIMARY, op, first, token.ctx().pos,
        res.type_id, child, -1, -1)
    if (id < 0) {
        return -1
    }
    if (ast.ast_expr_set_semantics(id, res) != 0) {
        return -1
    }
    res.ast_id = id
    return 0
}

// parse_comptime_pred_kind：将当前内建类型谓词名映射为固定类别，不新增词法关键字。
fn parse_comptime_pred_kind() int {
    if (p_tok_text_is("is_type", 7) != 0) { return 1 }
    if (p_tok_text_is("is_int", 6) != 0) { return 2 }
    if (p_tok_text_is("is_float", 8) != 0) { return 3 }
    return 0
}

// parse_comptime_pred：编译期类型谓词 `$is_type(x, T)`（kind 1）、
// `$is_int(x)`（kind 2）、`$is_float(x)`（kind 3）——CT6 P1（类型分派，
// 候选 A 首片）。谓词只看**静态类型**，不求值实参表达式（实参以
// c_em_suppress 静默发射做完整语义检查）；结果恒为编译期布尔常量：
// 普通路径直接折叠，typed 捕获记入常量节点后由执行器经 PRIMARY 常量
// 路径返回，无需新增 typed IR kind。
fn parse_comptime_pred(res *support.Res, kind int) int {
    let first int = token.ctx().pos
    p_adv() // 谓词名
    if (p_expect(token.TK_LPAREN, "类型谓词期望 '('") != 0) { return -1 }
    let x support.Res
    let saved_fold int = support.fc().c_fold
    let saved_bare int = ctx().ct_meta_bare
    // 谓词不求值实参：折叠上下文（如 $if 条件）下也按普通语义解析，
    // 只取静态类型；发射由 c_em_suppress 静默；允许裸元信息绑定
    // （`$is_type(f, T)` 的 f 是字段/枚举迭代绑定，只作类型引用）。
    support.fc().c_fold = 0
    ctx().ct_meta_bare += 1
    let xr int = parse_expr_iso(&x)
    support.fc().c_fold = saved_fold
    ctx().ct_meta_bare = saved_bare
    if (xr != 0) { return -1 }
    let target int = -1
    if (kind == 1) {
        if (p_expect(token.TK_COMMA, "$is_type 需要第二个参数（类型）") != 0) { return -1 }
        target = parse_type_ref()
        if (target < 0) { return -1 }
    }
    if (p_expect(token.TK_RPAREN, "期望 ')' ") != 0) { return -1 }
    let v int = 0
    if (support.session().compile != 0) {
        if (kind == 1) { v = (x.type_id == target).to_type(int) }
        else if (kind == 2) { v = support.ty_is_integer(x.type_id) }
        else { v = support.ty_is_float(x.type_id) }
    }
    let c support.Res
    if (support.sem_res_const(&c, support.TY_BOOL, v.to_type(i64)) != 0) { return -1 }
    check.sem_res_copy(res, &c)
    support.fc().c_res_is_addr = 0
    if (support.session().ast_capture != 0
        && ast.ast_expr_finish(res, ast.AST_EXPR_PRIMARY, token.TOK_IDENT, first,
            -1, -1, -1) != 0) { return -1 }
    return 0
}

// parse_comptime_field_access：`$field(x, "name")` —— 按编译期常量字段名
// 读取 x 的字段（CT6 P1c 首片，只读）。语义等价于 `x.name`，但名字来自
// 字符串字面量：普通路径与 typed 路径共用 `sem_member` 的成员访问语义
// （值/地址形态、指针基底自动解引用都与 `.` 一致）；typed 捕获为
// AST_EXPR_CTFIELD 节点（op = 按名字解析出的字段下标），执行器按下标读取。
// 写入路径（ct_ir_lvalue）不识别该节点，因此赋值自然按只读拒绝。
fn parse_comptime_field_access(res *support.Res) int {
    let first int = token.ctx().pos
    p_adv() // 消费 field 名
    if (p_expect(token.TK_LPAREN, "$field 期望 '('") != 0) { return -1 }
    let base support.Res
    if (parse_expr_iso(&base) != 0) { return -1 }
    if (p_expect(token.TK_COMMA, "$field 需要第二个参数（字段名字符串）") != 0) {
        return -1
    }
    if (p_cur() != token.TOK_STRING) {
        return token.err_tok("$field 的字段名必须是字符串字面量")
    }
    let str_start int = token.ctx().tokens[token.ctx().pos].start
    let str_len int = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    if (p_expect(token.TK_RPAREN, "期望 ')' ") != 0) { return -1 }
    if (support.session().compile == 0) { return 0 }
    if (str_len < 3) { return token.err_tok("$field 的字段名不能为空") }
    let name_start int = str_start + 1
    let name_len int = str_len - 2
    let owner int = base.type_id
    if (owner >= 0 && owner < support.ms().type_n
        && support.ms().types[owner].kind == support.TY_PTR) {
        owner = support.ms().types[owner].elem
    }
    if (owner < 0 || owner >= support.ms().type_n
        || (support.ms().types[owner].kind != support.TY_STRUCT
            && support.ms().types[owner].kind != support.TY_UNION)) {
        return token.err_tok("$field 的左侧不是结构体或结构体指针")
    }
    let field_index int = -1
    let nf int = support.ms().types[owner].len
    let i int = 0
    for i < nf {
        let fld support.SField = support.ms().fields[support.ms().types[owner].sub + i]
        if (fld.name_len == name_len) {
            let same int = 1
            let j int = 0
            for j < name_len {
                if (support.pool_ctx().data[fld.name_off + j] != support.src_ctx().data[name_start + j]) {
                    same = 0
                    break
                }
                j += 1
            }
            if (same != 0) {
                field_index = i
                break
            }
        }
        i += 1
    }
    if (field_index < 0) { return token.err_tok("结构体没有该字段") }
    let base_ast int = base.ast_id
    if (check.sem_member(&base, name_start, name_len) != 0) { return -1 }
    check.sem_res_copy(res, &base)
    if (support.session().ast_capture != 0) {
        let id int = ast.ast_expr_add(ast.AST_EXPR_CTFIELD, token.TOK_STRING, first,
            token.ctx().pos, res.type_id, base_ast, -1, -1)
        if (id < 0 || ast.ast_expr_set_semantics(id, res) != 0) { return -1 }
        ast.ast_expr_op_set(id, field_index)
        res.ast_id = id
    }
    return 0
}

// parse_comptime_call：解析 $fn(args) 或 $module.fn(args)，并执行 CT 正文。
fn parse_comptime_call(res *support.Res) int {
    let call_token int = token.ctx().pos
    let call_line int = token.ctx().tokens[call_token].line
    let call_col int = token.ctx().tokens[call_token].col
    p_adv()
    if (p_cur() != token.TOK_IDENT) { return token.err_tok("$ 后需要编译期函数名") }
    let diag_kind int = parse_comptime_diag_kind()
    if (diag_kind != 0) {
        return parse_comptime_diag_call(res, diag_kind, call_line, call_col)
    }
    let pred_kind int = parse_comptime_pred_kind()
    if (pred_kind != 0) {
        return parse_comptime_pred(res, pred_kind)
    }
    if (p_tok_text_is("field", 5) != 0) {
        return parse_comptime_field_access(res)
    }
    let alias_start int = token.ctx().tokens[token.ctx().pos].start
    let alias_len int = token.ctx().tokens[token.ctx().pos].len
    let qualified int = 0
    let member_start int = alias_start
    let member_len int = alias_len
    if (token.ctx().pos + 1 < token.ctx().count
        && token.ctx().tokens[token.ctx().pos + 1].kind == token.TK_DOT) {
        qualified = 1
        p_adv()
        if (p_cur() != token.TK_DOT) { return token.err_tok("编译期模块调用期望 '.'") }
        p_adv()
        if (p_cur() != token.TOK_IDENT) {
            return token.err_tok("模块限定的编译期调用缺少函数名")
        }
        member_start = token.ctx().tokens[token.ctx().pos].start
        member_len = token.ctx().tokens[token.ctx().pos].len
    }
    let sym int = -1
    let sig int = -1
    let np int = 0
    if (support.session().compile != 0) {
        let signature_sym int = -1
        if (qualified == 0) {
            signature_sym = support.sym_lookup(member_start, member_len)
            sym = signature_sym
        } else {
            let mi int = support.mod_file_binding(alias_start, alias_len)
            if (mi < 0) {
                return token.err_tok("编译期模块调用必须使用当前文件的导入绑定名")
            }
            let entry int = support.mod_ns_lookup(mi, member_start,
                member_len, 0)
            if (entry < 0) {
                return token.err_tok("模块没有导出该编译期函数")
            }
            signature_sym = support.fs().mods[mi].ns[entry].sym
            if (signature_sym < 0 || signature_sym >= support.ms().sym_n
                || support.ms().syms[signature_sym].kind != support.SYM_FN) {
                return token.err_tok("$module.fn 的目标必须是公开函数")
            }
            // 模块可见性由 .s.i 决定；执行身份改为私有 .s.ct 正文符号。
            if ((support.ms().syms[signature_sym].flags & support.F_COMPTIME) != 0) {
                let hidden_off int = -1
                let hidden_len int = 0
                if (iface_ct_export_name(mi, entry, &hidden_off,
                        &hidden_len) != 0) { return -1 }
                sym = support.sym_lookup_off(hidden_off, hidden_len)
                if (sym < 0 || comptime.ct_find(sym) < 0) {
                    return token.err_tok("公开编译期函数缺少匹配的 .s.ct 正文")
                }
                if (support.ms().syms[sym].type_id
                    != support.ms().syms[signature_sym].type_id) {
                    return token.err_tok("公开编译期函数与 .s.ct 正文签名不匹配")
                }
            }
            let ii int = 0
            for ii < support.fs().import_n {
                if (support.fs().import_mod[ii] == mi) {
                    support.fs().import_used[ii] = 1
                    break
                }
                ii += 1
            }
        }
        if (signature_sym < 0 || signature_sym >= support.ms().sym_n
            || support.ms().syms[signature_sym].kind != support.SYM_FN) {
            return token.err_tok("$ 调用目标必须是编译期函数")
        }
        if ((support.ms().syms[signature_sym].flags & support.F_COMPTIME) == 0) {
            return token.err_tok("$ 调用目标缺少 @[comptime] 属性")
        }
        if (sym < 0) { return token.err_tok("公开编译期函数缺少正文") }
        sig = support.ms().types[support.ms().syms[signature_sym].type_id].sub
        np = support.ms().sig_np[sig]
    }
    p_adv()
    if (p_expect(token.TK_LPAREN, "编译期调用期望 '('") != 0) { return -1 }
    let args [64]support.Res
    let arg_n int = 0
    let defer_eval int = ((support.fc().c_fn_flags & support.F_COMPTIME) != 0).to_type(int)
    if (p_cur() != token.TK_RPAREN) {
        for 1 {
            if (arg_n >= 64) { return token.err_tok("编译期调用实参过多") }
            let save_exp int = support.fc().c_expect_tid
            if (sig >= 0 && arg_n < np) {
                support.fc().c_expect_tid = support.ms().sig_params[support.ms().sig_first[sig] + arg_n]
            }
            // 跨模块编译期调用的实参在提供方编译单元里求值，字面量会拿到那边的
            // 数据标签号，按标签号反查本地只读池会命中无关字面量（静默错值）。
            // 这里先按形参类型拒绝，支持路径是模块导出的 pub const 指针常量。
            // 顶层或普通函数里的编译期调用实参必须在 pass1 折叠成常量；聚合字面量
            // 做不到，这里给出可读诊断，替代内部的「结构体/数组字面量不是编译期常量」。
            let folded int = 0
            if ((support.fc().c_fn_flags & support.F_COMPTIME) == 0 && sig >= 0 && arg_n < np) {
                let ptid2 int = support.ms().sig_params[support.ms().sig_first[sig] + arg_n]
                let pk int = support.ms().types[ptid2].kind
                let agg_param int = 0
                if (pk == support.TY_STRUCT || pk == support.TY_ARRAY) { agg_param = 1 }
                if (pk == support.TY_SLICE || pk == support.TY_UNION) { agg_param = 1 }
                let agg_lit int = 0
                if (p_cur() == token.TK_LBRACKET) { agg_lit = 1 }
                if (p_cur() == token.TOK_IDENT && token.ctx().pos + 1 < token.ctx().count
                    && token.ctx().tokens[token.ctx().pos + 1].kind == token.TK_LBRACE) { agg_lit = 1 }
                if (agg_param != 0 && agg_lit != 0) {
                    // 结构体字面量且有对应形参类型时，先尝试在编译期临时构造区折出
                    // 聚合对象（顶层没有 CT 帧，这是唯一能在 pass1 拿到聚合值的路径）。
                    if (pk == support.TY_STRUCT) {
                        let fold int = p_ct_arg_struct_literal(&args[arg_n], ptid2)
                        if (fold < 0) { return -1 }
                        if (fold == 0) { agg_lit = 0; folded = 1 }
                    } else if (pk == support.TY_ARRAY) {
                        let fold2 int = p_ct_arg_array_literal(&args[arg_n], ptid2)
                        if (fold2 < 0) { return -1 }
                        if (fold2 == 0) { agg_lit = 0; folded = 1 }
                    } else if (pk == support.TY_SLICE) {
                        // 切片字面量：backing 聚合按元素个数创建（与全局切片常量的
                        // 模型同一形状），实参是切片类型 + 对象指针，见 p_ct_arg_slice_literal。
                        let fold3 int = p_ct_arg_slice_literal(&args[arg_n], ptid2)
                        if (fold3 < 0) { return -1 }
                        if (fold3 == 0) { agg_lit = 0; folded = 1 }
                    }
                    if (agg_lit != 0) {
                        return token.err_tok("编译期调用实参里的聚合值暂时只支持结构体、数组与切片字面量（字段/元素可递归嵌套标量、结构体、数组）；联合体仍需在 @[comptime] 函数体内构造")
                    }
                }
                // 命名的全局聚合常量实参：前端在语义阶段已把字面量元素值建成编译期
                // 模型（comptime/ct_global_agg.yh），直接把模型对象指针当聚合实参，
                // 与上面的字面量折叠走同一条 ct_call 协议。
                if (agg_param != 0 && agg_lit == 0 && folded == 0
                    && p_cur() == token.TOK_IDENT && token.ctx().pos + 1 < token.ctx().count
                    && (token.ctx().tokens[token.ctx().pos + 1].kind == token.TK_COMMA
                        || token.ctx().tokens[token.ctx().pos + 1].kind == token.TK_RPAREN)) {
                    let astart int = token.ctx().tokens[token.ctx().pos].start
                    let alen int = token.ctx().tokens[token.ctx().pos].len
                    let asym int = support.sym_lookup(astart, alen)
                    if (asym < 0) { return token.err_tok("引用了未声明的名字") }
                    if (support.ms().syms[asym].kind == support.SYM_CONST) {
                        let model i64 = comptime.ct_global_agg_lookup(asym)
                        if (model == 0) {
                            return token.err_tok("编译期实参里的全局聚合常量尚未在编译期建模（只支持标量元素的定长数组与标量字段结构体）")
                        }
                        check.sem_res_reset(&args[arg_n], support.ms().syms[asym].type_id)
                        args[arg_n].is_const = 1
                        args[arg_n].ival = model
                        args[arg_n].sym = asym
                        p_adv()
                        folded = 1
                    }
                }
            }
            // 单字节指针形参只接受直接写在实参位置的字符串字面量：它的字节就在本
            // 编译单元里，可以就地登记只读池，不受提供方标签号编号影响。
            let arg_str_tok int = -1
            if (p_cur() == token.TOK_STRING) { arg_str_tok = token.ctx().pos }
            if (folded != 0) {
                // 实参已在上面折进编译期临时构造区，表达式已被消费完。
                arg_n += 1
                if (p_cur() != token.TK_COMMA) { break }
                p_adv()
                continue
            }
            if (defer_eval == 0) { support.fc().c_fold += 1 }
            let ar int = parse_expr_iso(&args[arg_n])
            if (defer_eval == 0) { support.fc().c_fold -= 1 }
            support.fc().c_expect_tid = save_exp
            if (ar != 0) { return -1 }
            if (sig >= 0 && arg_n < np) {
                let ptid int = support.ms().sig_params[support.ms().sig_first[sig] + arg_n]
                let pelem int = comptime.ct_pool_elem_of(ptid)
                if (pelem >= 0) {
                    if (arg_str_tok >= 0) {
                        let addr i64 = comptime.ct_pool_register_src(
                            token.ctx().tokens[arg_str_tok].start,
                            token.ctx().tokens[arg_str_tok].len, pelem)
                        if (addr == 0) { return -1 }
                        args[arg_n].is_const = 1
                        args[arg_n].ival = addr
                    } else if (qualified != 0) {
                        // 非字面量实参：导入模块里以**字符串字面量**初始化的 pub const
                        // 指针常量由接口原样重放（`iface.yh` 的 F_ADDR 分支），导入侧的
                        // 字面量已重新登记只读字节池，因此它的标签号是**本地**的，
                        // 与直接字面量走同一条登记路径，可以直接使用。
                        let asym int = args[arg_n].sym
                        let local_addr int = 0
                        if (asym >= 0 && asym < support.ms().sym_n
                            && support.ms().syms[asym].kind == support.SYM_CONST
                            && (support.ms().syms[asym].flags & support.F_ADDR) != 0
                            && args[arg_n].is_const != 0) {
                            local_addr = 1
                        }
                        if (local_addr == 0) {
                            return token.err_tok("编译期调用的单字节指针形参（char/u8/i8）只接受直接字符串字面量实参，或导入模块里以字符串字面量初始化的 pub const 指针常量")
                        }
                    }
                }
            }
            arg_n += 1
            if (p_cur() != token.TK_COMMA) { break }
            p_adv()
        }
    }
    if (p_expect(token.TK_RPAREN, "编译期调用期望 ')' ") != 0) { return -1 }
    if (support.session().compile == 0) {
        check.sem_res_reset(res, 0)
        return 0
    }
    if ((support.fc().c_fn_flags & support.F_COMPTIME) != 0) {
        if (arg_n != np) { return token.err_tok("编译期调用实参数量与函数签名不符") }
        let ai int = 0
        for ai < arg_n {
            let tid int = support.ms().sig_params[support.ms().sig_first[sig] + ai]
            if (check.sem_can_assign(tid, args[ai].type_id, args[ai].is_lit,
                    args[ai].ival, args[ai].lit_big) != 0) { return -1 }
            ai += 1
        }
        check.sem_res_reset(res, support.ms().sig_ret[sig])
        if (support.session().ast_capture != 0 && support.fc().c_ct_prepare_active != 0) {
            let args_ast int = -1
            let ai2 int = 0
            for ai2 < arg_n {
                if (ast.ast_expr_args_append(&args_ast, args[ai2].ast_id) != 0) {
                    return -1
                }
                ai2 += 1
            }
            res.sym = sym
            let call_ast int = ast.ast_expr_add(ast.AST_EXPR_CALL, token.TK_DOLLAR,
                call_token, token.ctx().pos, res.type_id, -1, args_ast, -1)
            if (call_ast < 0 || ast.ast_expr_set_semantics(call_ast, res) != 0) {
                return -1
            }
            res.ast_id = call_ast
            // 函数符号归属于调用节点；外层 primary 是返回值表达式，不是函数值。
            res.sym = -1
        }
        support.fc().c_res_is_addr = 0
        return 0
    }
    return comptime.ct_call(sym, &args[0], arg_n, res)
}


// p_ct_arg_array_literal：把数组字面量折进编译期临时构造区。元素按源码顺序填位，
// 标量元素用 c_fold 折成常量，嵌套数组与结构体元素递归折叠。成功返回 0 并把 res 写成
// 「聚合对象指针常量」；不支持的形态返回 1（调用方给出诊断）。
fn p_ct_arg_array_literal(res *support.Res, tid int) int {
    let at support.CType = support.ms().types[tid]
    if (p_cur() != token.TK_LBRACKET) { return 1 }
    if (at.len <= 0 || at.len > 64) { return 1 }
    let vals [64]i64
    let tys [64]int
    p_adv()
    let idx int = 0
    for p_cur() != token.TK_RBRACKET {
        if (idx >= at.len) { return 1 }
        let ek int = support.ms().types[at.elem].kind
        if (ek == support.TY_ARRAY) {
            let er support.Res
            let sub int = p_ct_arg_array_literal(&er, at.elem)
            if (sub < 0) { return -1 }
            if (sub != 0) { return 1 }
            vals[idx] = er.ival
        } else if (ek == support.TY_STRUCT) {
            let sr support.Res
            let sub2 int = p_ct_arg_struct_literal(&sr, at.elem)
            if (sub2 < 0) { return -1 }
            if (sub2 != 0) { return 1 }
            vals[idx] = sr.ival
        } else if (ek == support.TY_UNION || ek == support.TY_SLICE) {
            return 1
        } else {
            let save_exp int = support.fc().c_expect_tid
            support.fc().c_expect_tid = at.elem
            support.fc().c_fold += 1
            let fr support.Res
            let rr int = parse_expr_iso(&fr)
            support.fc().c_fold -= 1
            support.fc().c_expect_tid = save_exp
            if (rr != 0) { return -1 }
            if (fr.is_const == 0) { return 1 }
            if (check.sem_can_assign(at.elem, fr.type_id, fr.is_lit,
                    fr.ival, fr.lit_big) != 0) { return -1 }
            vals[idx] = fr.ival
        }
        tys[idx] = at.elem
        idx += 1
        if (p_cur() != token.TK_COMMA) { break }
        p_adv()
    }
    if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) { return -1 }
    if (idx != at.len) { return 1 }
    let obj i64 = comptime.ct_arg_pool_agg(at.elem, &vals[0], &tys[0], at.len)
    if (obj == 0) { return -1 }
    check.sem_res_reset(res, tid)
    res.is_const = 1
    res.ival = obj
    return 0
}

// p_ct_arg_slice_literal：把切片字面量实参折进编译期临时构造区。
// backing 聚合按元素个数创建（与切片常量的编译期模型同一形状：elem_type = 元素
// 类型、count = 元素个数），res 的类型写回形参的切片类型 —— ct_ir_param_copy 的
// 切片分支按 ct_ir_slice_param_valid 校验后直接别名这个 backing，无需「地址+长度」
// 的独立视图表示。元素形态与数组字面量一致（标量/结构体/定长数组递归折叠），
// 空切片字面量 `[]` 合法；不支持返回 1（调用方给出诊断）。
fn p_ct_arg_slice_literal(res *support.Res, tid int) int {
    let st support.CType = support.ms().types[tid]
    if (p_cur() != token.TK_LBRACKET || st.kind != support.TY_SLICE) { return 1 }
    let vals [64]i64
    let tys [64]int
    p_adv()
    let idx int = 0
    for p_cur() != token.TK_RBRACKET {
        if (idx >= 64) { return 1 }
        let ek int = support.ms().types[st.elem].kind
        if (ek == support.TY_ARRAY) {
            let er support.Res
            let sub int = p_ct_arg_array_literal(&er, st.elem)
            if (sub < 0) { return -1 }
            if (sub != 0) { return 1 }
            vals[idx] = er.ival
        } else if (ek == support.TY_STRUCT) {
            let sr support.Res
            let sub2 int = p_ct_arg_struct_literal(&sr, st.elem)
            if (sub2 < 0) { return -1 }
            if (sub2 != 0) { return 1 }
            vals[idx] = sr.ival
        } else if (ek == support.TY_UNION || ek == support.TY_SLICE) {
            return 1
        } else {
            let save_exp int = support.fc().c_expect_tid
            support.fc().c_expect_tid = st.elem
            support.fc().c_fold += 1
            let fr support.Res
            let rr int = parse_expr_iso(&fr)
            support.fc().c_fold -= 1
            support.fc().c_expect_tid = save_exp
            if (rr != 0) { return -1 }
            if (fr.is_const == 0) { return 1 }
            if (check.sem_can_assign(st.elem, fr.type_id, fr.is_lit,
                    fr.ival, fr.lit_big) != 0) { return -1 }
            vals[idx] = fr.ival
        }
        tys[idx] = st.elem
        idx += 1
        if (p_cur() != token.TK_COMMA) { break }
        p_adv()
    }
    if (p_expect(token.TK_RBRACKET, "期望 ']'") != 0) { return -1 }
    let obj i64 = comptime.ct_arg_pool_agg(st.elem, &vals[0], &tys[0], idx)
    if (obj == 0) { return -1 }
    check.sem_res_reset(res, tid)
    res.is_const = 1
    res.ival = obj
    return 0
}

// p_ct_arg_struct_literal：把顶层编译期调用的结构体字面量实参折进编译期临时构造区，
// 成功时把 res 写成「聚合对象指针常量」并返回 0；不支持的字面量返回 1（调用方给出诊断）。
// 字段支持标量、嵌套结构体与数组（都递归折叠）；切片、联合体字段返回 1。
fn p_ct_arg_struct_literal(res *support.Res, tid int) int {
    let st support.CType = support.ms().types[tid]
    if (support.ty_lookup_name(token.ctx().tokens[token.ctx().pos].start,
            token.ctx().tokens[token.ctx().pos].len) != tid) {
        return 1
    }
    let vals [64]i64
    let tys [64]int
    if (st.len > 64) { return 1 }
    p_adv()
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) { return -1 }
    let filled int = 0
    for p_cur() != token.TK_RBRACE {
        if (p_cur() != token.TOK_IDENT) {
            return token.err_tok("结构体字面量期望字段名")
        }
        let nstart int = token.ctx().tokens[token.ctx().pos].start
        let nlen int = token.ctx().tokens[token.ctx().pos].len
        let fi int = -1
        let i int = 0
        for i < st.len {
            let field support.SField = support.ms().fields[st.sub + i]
            if (field.name_len == nlen) {
                let same int = 1
                let j int = 0
                for j < nlen {
                    if (support.pool_ctx().data[field.name_off + j] != support.src_ctx().data[nstart + j]) {
                        same = 0
                        break
                    }
                    j += 1
                }
                if (same != 0) { fi = i; break }
            }
            i += 1
        }
        if (fi < 0) { return token.err_tok("结构体没有这个字段") }
        let field2 support.SField = support.ms().fields[st.sub + fi]
        let fk int = support.ms().types[field2.type_id].kind
        if (fk == support.TY_UNION || fk == support.TY_SLICE) {
            return 1
        }
        p_adv()
        if (p_expect(token.TK_COLON, "期望 ':'") != 0) { return -1 }
        if (fk == support.TY_ARRAY) {
            // 数组字段：递归折叠数组字面量。
            let ar2 support.Res
            let sub3 int = p_ct_arg_array_literal(&ar2, field2.type_id)
            if (sub3 < 0) { return -1 }
            if (sub3 != 0) { return 1 }
            vals[fi] = ar2.ival
        } else if (fk == support.TY_STRUCT) {
            // 嵌套结构体字段：递归折叠出子对象指针 —— 执行器对聚合字段存的也是对象指针。
            let sr support.Res
            let sub int = p_ct_arg_struct_literal(&sr, field2.type_id)
            if (sub < 0) { return -1 }
            if (sub != 0) { return 1 }
            vals[fi] = sr.ival
        } else {
            let save_exp int = support.fc().c_expect_tid
            support.fc().c_expect_tid = field2.type_id
            support.fc().c_fold += 1
            let fr support.Res
            let rr int = parse_expr_iso(&fr)
            support.fc().c_fold -= 1
            support.fc().c_expect_tid = save_exp
            if (rr != 0) { return -1 }
            if (fr.is_const == 0) { return 1 }
            if (check.sem_can_assign(field2.type_id, fr.type_id, fr.is_lit,
                    fr.ival, fr.lit_big) != 0) { return -1 }
            vals[fi] = fr.ival
        }
        tys[fi] = field2.type_id
        filled += 1
        if (p_cur() != token.TK_COMMA) { break }
        p_adv()
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) { return -1 }
    if (filled != st.len) { return 1 }
    let obj i64 = comptime.ct_arg_pool_agg(tid, &vals[0], &tys[0], st.len)
    if (obj == 0) { return -1 }
    check.sem_res_reset(res, tid)
    res.is_const = 1
    res.ival = obj
    return 0
}

// parse_primary_impl：解析基本表达式；外层统一记录源范围和类型。
fn parse_primary_impl(res *support.Res, first int) int {
    support.fc().c_res_is_addr = 0
    let k int = p_cur()
    // 当前 token 的源区间（各字面量分支共用；stage0 同级块禁同名局部）
    let start int = token.ctx().tokens[token.ctx().pos].start
    let n int = token.ctx().tokens[token.ctx().pos].len
    if (k == token.TK_DOLLAR) {
        return parse_comptime_call(res)
    }
    if (k == token.TOK_INTERP_BEGIN) {
        return parse_interp(res)
    }
    if (k == token.TOK_NUMBER) {
        p_adv()
        return check.sem_number(start, n, res)
    }
    if (k == token.TOK_STRING) {
        p_adv()
        return check.sem_string(start, n, res)
    }
    if (k == token.TOK_CHAR) {
        p_adv()
        return check.sem_char(start, n, res)
    }
    if (k == token.TK_TRUE) {
        p_adv()
        return check.sem_bool(1, res)
    }
    if (k == token.TK_FALSE) {
        p_adv()
        return check.sem_bool(0, res)
    }
    if (k == token.TK_LPAREN) {
        p_adv()
        if (parse_expr_iso(res) != 0) {
            return -1
        }
        return p_expect(token.TK_RPAREN, "期望 ')'")
    }
    if (k == token.TK_SIZEOF) {
        p_adv()
        if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
            return -1
        }
        if (sizeof_starts_type() != 0) {
            // sizeof(T)：编译期类型大小
            let tid int = parse_type_ref()
            if (tid < 0) {
                return -1
            }
            if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
                return -1
            }
            return check.sem_sizeof(tid, res)
        }
        // sizeof(expr)：发射层静默求型（表达式不求值、不发码），
        // 取结果类型的大小。同型名的场景类型优先。
        let er support.Res
        let ererr int = parse_expr_iso(&er)
        if (ererr != 0) {
            return -1
        }
        if (er.ct_diag != 0) {
            return token.err_tok("编译期诊断只能作为独立语句")
        }
        if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
            return -1
        }
        return check.sem_sizeof(er.type_id, res)
    }
    if (k == token.TK_LEN) {
        p_adv()
        if (p_expect(token.TK_LPAREN, "期望 '('") != 0) {
            return -1
        }
        if (parse_expr_iso(res) != 0) {
            return -1
        }
        if (p_expect(token.TK_RPAREN, "期望 ')'") != 0) {
            return -1
        }
        let len_child int = res.ast_id
        if (check.sem_len(res) != 0) { return -1 }
        if (support.session().ast_capture != 0
            && ast.ast_expr_finish(res, ast.AST_EXPR_UNARY, token.TK_LEN, first,
                len_child, -1, -1) != 0) { return -1 }
        return 0
    }
    if (k == token.TK_LBRACKET) {
        // 数组/切片字面量（目标类型来自 let 初始化/赋值上下文）
        p_adv()
        return parse_array_literal(res, first)
    }
    if (k == token.TOK_IDENT) {
        return parse_ident_primary(res)
    }
    return token.err_tok("此处需要一个表达式")
}

// parse_ident_primary：标识符作为基本表达式（含结构体字面量决策与
// 模块限定名分派）。
fn parse_ident_primary(res *support.Res) int {
    // 注意：stage0 中 if/while 体不开新词法作用域，同名局部必须提升到函数级
    let istart int = token.ctx().tokens[token.ctx().pos].start
    let ilen int = token.ctx().tokens[token.ctx().pos].len
    if (support.session().compile != 0 && support.fc().c_ct_target_ctx != 0) {
        let target_name int = comptime.ct_target_symbol(istart, ilen, res)
        if (target_name != 0) {
            p_adv()
            return 0
        }
    }
    if (support.session().compile != 0 && p_peek(1) != token.TK_LPAREN) {
        let direct_sym int = support.sym_lookup(istart, ilen)
        if (direct_sym >= 0 && support.ms().syms[direct_sym].kind == support.SYM_FN
            && (support.ms().syms[direct_sym].flags & support.F_COMPTIME) != 0) {
            return token.err_tok("编译期函数不能作为运行时函数值使用")
        }
    }
    // 枚举成员限定引用 `EnumName.member`：枚举类型名不是值，直接解析到成员常量。
    // 基名被局部/全局符号占用时保持原路径（词法作用域优先）。
    if (support.session().compile != 0 && p_peek(1) == token.TK_DOT && p_peek(2) == token.TOK_IDENT
        && support.sym_lookup(istart, ilen) < 0) {
        let etid int = support.ty_lookup_name(istart, ilen)
        if (etid >= 0 && support.ms().types[etid].kind == support.TY_ENUM) {
            let mlen2 int = token.ctx().tokens[token.ctx().pos + 2].len
            let mstart int = token.ctx().tokens[token.ctx().pos + 2].start
            let direct int = support.sym_lookup(mstart, mlen2)
            let msym int = direct
            // 成员名被同名形参/局部变量遮蔽时，sym_lookup 命中的不是枚举成员；
            // 此时按名字在符号表里反查属于该枚举的成员符号（`.` 右侧总是成员名）。
            if (direct < 0
                || (support.ms().syms[direct].flags & support.F_ENUM_MEMBER) == 0) {
                msym = support.sym_find_enum_member(etid, support.src_ctx().data, mstart, mlen2)
            }
            // 不检查 const_ready：延迟求值的枚举成员被引用时可能还没回填，
            // 交给 sem_ident_val 给出「常量尚未就绪」这类准确诊断。
            if (msym >= 0 && (support.ms().syms[msym].flags & support.F_ENUM_MEMBER) != 0
                && support.ms().syms[msym].type_id == etid) {
                p_adv()
                p_adv()
                p_adv()
                return check.sem_ident_val(msym, res)
            }
        }
    }
    // 模块限定名（编译模式）：名字解析失败且是当前文件的导入绑定
    //（局部声明按词法作用域遮蔽导入）。语法模式不解析（U1 行为）。
    if (support.session().compile != 0 && support.module_mode() != 0 && p_peek(1) == token.TK_DOT && p_peek(2) == token.TOK_IDENT) {
        if (support.sym_lookup(istart, ilen) < 0) {
            let b int = support.mod_file_binding(istart, ilen)
            if (b >= 0) {
                // m.T { …：限定结构体字面量（仅非块跟随上下文）
                if (p_peek(3) == token.TK_LBRACE && ctx().ctx_block == 0) {
                    return parse_module_struct_lit(res, b)
                }
                return parse_module_qualified(res, b, 0)
            }
        }
    }
    if (p_peek(1) == token.TK_LBRACE) {
        if (ctx().ctx_block != 0) {
            if (try_struct_init() == 0) {
                return parse_struct_init_forced(res)
            }
            // 回退：该 '{' 是 for/switch/case 体，标识符保持裸形式
            p_adv()
            return check.sem_ident(istart, ilen, res)
        }
        return parse_struct_init_forced(res)
    }
    p_adv()
    return check.sem_ident(istart, ilen, res)
}

// parse_module_qualified：m.member 的模块成员访问（消费 m . member）。
// 命名空间命中后按普通名字求值（跨模块符号已带后缀且为外部引用）；
// 未使用的导入在此标记。want_type=0。
fn parse_module_qualified(res *support.Res, mi int, unused int) int {
    p_adv() // 绑定名
    p_adv() // '.'
    let mstart int = token.ctx().tokens[token.ctx().pos].start
    let mlen int = token.ctx().tokens[token.ctx().pos].len
    let mline int = token.ctx().tokens[token.ctx().pos].line
    let mcol int = token.ctx().tokens[token.ctx().pos].col
    p_adv()
    let e int = support.mod_ns_lookup(mi, mstart, mlen, 0)
    if (e < 0) {
        return support.err_lc(mline, mcol, "模块没有导出该名字（或它是类型名不能作值）")
    }
    // 标记导入已使用（未使用导入检查在文件编译完后做）
    let i int = 0
    for i < support.fs().import_n {
        if (support.fs().import_mod[i] == mi) {
            support.fs().import_used[i] = 1
            break
        }
        i += 1
    }
    return check.sem_ident_val(support.fs().mods[mi].ns[e].sym, res)
}

// parse_module_struct_lit：m.T { … } 限定结构体字面量（消费 m . T）。
// tid 来自接口命名空间；构造检查与本地类型一致（跨模块私有字段拒绝）。
fn parse_module_struct_lit(res *support.Res, mi int) int {
    p_adv()
    p_adv()
    let tstart int = token.ctx().tokens[token.ctx().pos].start
    let tlen int = token.ctx().tokens[token.ctx().pos].len
    let tline int = token.ctx().tokens[token.ctx().pos].line
    let tcol int = token.ctx().tokens[token.ctx().pos].col
    p_adv()
    let e int = support.mod_ns_lookup(mi, tstart, tlen, 1)
    if (e < 0) {
        return support.err_lc(tline, tcol, "模块没有导出该类型")
    }
    let tid int = support.fs().mods[mi].ns[e].tid
    let i int = 0
    for i < support.fs().import_n {
        if (support.fs().import_mod[i] == mi) {
            support.fs().import_used[i] = 1
            break
        }
        i += 1
    }
    return parse_struct_init_tid(tid, res)
}

// try_struct_init：试探「IDENT { structInitBody }」成立且其后紧跟 '{'。
fn try_struct_init() int {
    let save int = token.ctx().pos
    let save_fold int = support.fc().c_fold
    let save_lit_off int = support.fc().c_lit_off
    let save_fp int = support.fc().c_fp_off
    support.diag().spec += 1
    // 试探期只做语法判定：禁发码、禁分配槽（c_fold>0 让语义钩子短路）
    if (support.session().compile != 0) {
        support.fc().c_fold += 1
    }
    let dummy support.Res
    let r int = parse_struct_init_forced(&dummy)
    let ok int = 0
    if (r == 0 && p_cur() == token.TK_LBRACE) {
        ok = 1
    }
    if (support.session().compile != 0) {
        support.fc().c_fold -= 1
    }
    support.diag().spec -= 1
    token.ctx().pos = save
    support.fc().c_fold = save_fold
    support.fc().c_lit_off = save_lit_off
    support.fc().c_fp_off = save_fp
    if (ok == 1) {
        return 0
    }
    return -1
}

// parse_struct_init_forced：结构体字面量：IDENT '{' body '}'。
// 编译模式：作为值使用统一拒绝（B5 只支持 let 直接初始化路径）。
fn parse_struct_init_forced(res *support.Res) int {
    // 结构体字面量：IDENT '{' body '}'
    // 语法模式只消费 token；编译模式在临时槽构造聚合值，地址留 x0。
    let start int = token.ctx().tokens[token.ctx().pos].start
    let nlen int = token.ctx().tokens[token.ctx().pos].len
    p_adv()
    let tid int = 0
    if (support.session().compile != 0) {
        if (support.fc().c_fold != 0) {
            return token.err_tok("结构体字面量不是编译期常量")
        }
        tid = support.ty_lookup_name(start, nlen)
        if (tid < 0) {
            return token.err_tok("未知类型（结构体字面量）")
        }
        let tk int = support.ms().types[tid].kind
        if (tk != support.TY_STRUCT && tk != support.TY_UNION) {
            return token.err_tok("结构体字面量需要一个 struct/union 类型名")
        }
    }
    return parse_struct_init_tid(tid, res)
}

// parse_struct_init_tid：按给定类型构造结构体字面量（'{ … }' 由本函数
// 消费；本地路径与模块限定路径共用）。
fn parse_struct_init_tid(tid int, res *support.Res) int {
    let init_first int = token.ctx().pos
    if (p_expect(token.TK_LBRACE, "期望 '{'") != 0) {
        return -1
    }
    if (support.session().compile != 0) {
        if (check.sem_struct_lit_begin(tid) < 0) {
            return -1
        }
    }
    let fields int = -1
    if (parse_struct_init_body(tid, &fields) != 0) {
        return -1
    }
    if (p_expect(token.TK_RBRACE, "期望 '}'") != 0) {
        return -1
    }
    if (support.session().compile != 0) {
        if (check.sem_struct_lit_end(tid) != 0) {
            return -1
        }
        check.sem_res_reset(res, tid)
    }
    if (support.session().ast_capture != 0) {
        let id int = ast.ast_expr_add(ast.AST_EXPR_STRUCT_INIT, token.TK_LBRACE,
            init_first, token.ctx().pos, tid, fields, -1, -1)
        if (id < 0 || ast.ast_expr_set_semantics(id, res) != 0) { return -1 }
        res.ast_id = id
    }
    return 0
}

// parse_struct_init_body：字面量体（'{' 与 '}' 由调用方处理）。
// 强制非空；首元素第二个 token 为 ':' 即命名式；不得混写；允许尾逗号。
fn parse_struct_init_body(tid int, fields *int) int {
    if (p_cur() == token.TK_RBRACE) {
        return token.err_tok("结构体字面量不能为空")
    }
    let named int = 0
    if (is_member_name(p_cur()) != 0 && p_peek(1) == token.TK_COLON) {
        named = 1
    }
    let fv support.Res
    let fpos int = 0
    for 1 {
        let field_first int = token.ctx().pos
        let fidx int = -1
        if (named != 0) {
            if (is_member_name(p_cur()) == 0) {
                return token.err_tok("命名式字面量需要字段名")
            }
            if (support.session().compile != 0 && support.fc().c_fold == 0) {
                let fs int = token.ctx().tokens[token.ctx().pos].start
                let fl int = token.ctx().tokens[token.ctx().pos].len
                fidx = check.sem_lit_field_lookup(support.fc().c_lit_tid, fs, fl)
                if (fidx < 0) {
                    return token.err_tok("结构体没有该字段")
                }
            }
            p_adv()
            if (p_expect(token.TK_COLON, "期望 ':'") != 0) {
                return -1
            }
            let saved_expect int = support.fc().c_expect_tid
            if (support.session().compile != 0 && support.fc().c_fold == 0 && fidx >= 0) {
                support.fc().c_expect_tid = support.ms().fields[fidx].type_id
            }
            if (parse_expr_iso(&fv) != 0) {
                support.fc().c_expect_tid = saved_expect
                return -1
            }
            support.fc().c_expect_tid = saved_expect
        } else {
            if (support.session().compile != 0 && support.fc().c_fold == 0) {
                if (fpos >= support.ms().types[support.fc().c_lit_tid].len) {
                    return token.err_tok("位置式字面量字段过多")
                }
                fidx = support.ms().types[support.fc().c_lit_tid].sub + fpos
                fpos += 1
            }
            let saved_expect2 int = support.fc().c_expect_tid
            if (support.session().compile != 0 && support.fc().c_fold == 0 && fidx >= 0) {
                support.fc().c_expect_tid = support.ms().fields[fidx].type_id
            }
            if (parse_expr_iso(&fv) != 0) {
                support.fc().c_expect_tid = saved_expect2
                return -1
            }
            support.fc().c_expect_tid = saved_expect2
        }
        if (support.session().compile != 0 && support.fc().c_fold == 0) {
            support.fc().c_lit_last_type = fv.type_id
            support.fc().c_lit_last_lit = fv.is_lit
            support.fc().c_lit_last_ival = fv.ival
            if (check.sem_struct_lit_field(support.fc().c_lit_tid, fidx) != 0) {
                return -1
            }
        }
        if (support.session().ast_capture != 0) {
            if (fidx < 0 || fv.ast_id < 0) {
                return support.fail("内部错误：结构体初始化 AST 缺少字段或值")
            }
            let node_first int = field_first
            if (fields[0] >= 0) {
                node_first = ast.ast_expr_first_of(fields[0])
            }
            let field_node int = ast.ast_expr_add(ast.AST_EXPR_STRUCT_FIELD, fidx,
                node_first, token.ctx().pos, -1, fields[0], fv.ast_id, -1)
            if (field_node < 0) { return -1 }
            fields[0] = field_node
        }
        if (p_cur() == token.TK_COMMA) {
            p_adv()
            if (p_cur() == token.TK_RBRACE) {
                break
            }
            continue
        }
        break
    }
    return 0
}
