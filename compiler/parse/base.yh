module parse

// ============================================================================
// base.yh —— 解析器私有的每任务状态
//
// 只放「解析阶段独有、别的阶段不读」的开关与游标：测试体模式、CT 元信息
// 裸绑定、表达式块上下文、最近一次拒绝阶段。语义表/类型表仍归 check/gen，
// 本文件不持有任何跨阶段事实。
// ============================================================================

// ParseCtx：解析阶段的每任务状态（模块级单例，worker 进程内一份）。
pub struct ParseCtx {
    test_body int // 1 = 当前正在解析 test 声明体
    ct_meta_bare int // >0：允许裸元信息绑定作类型谓词实参（$is_type(f, T)）
    ctx_block int // 表达式块上下文：1 = 该表达式后可能紧跟 {
    ir_reject_reason int // 最近函数的拒绝阶段：1上下文…7落底（构建统计用）
}

// g_parse：解析阶段状态单例（零初始化）。
let g_parse ParseCtx

// ctx：解析阶段状态窄口；返回单例指针。
pub fn ctx() *ParseCtx {
    return &g_parse
}
