module parse
import check
import token
import support
import comptime
import lex
import ast

fn iface_ct_export_name(mi int, ns_row int, name_off *int,
    name_len *int) int {
    if (mi < 0 || mi >= support.fs().mod_n || ns_row < 0
        || ns_row >= support.fs().mods[mi].ns_n) {
        return support.fail("内部错误：公开 CT 接口条目无效")
    }
    let ent support.ModNsEnt = support.fs().mods[mi].ns[ns_row]
    let modinfo support.ModInfo = support.fs().mods[mi]
    let buf [1200]u8
    let n int = 0
    n = support.append_str(buf, n, "__yhct_")
    let i int = 0
    for i < ent.name_len {
        buf[n] = support.pool_ctx().data[ent.name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < modinfo.prefix_len {
        buf[n] = support.pool_ctx().data[modinfo.prefix_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(buf, 0, n)
    if (off < 0) { return -1 }
    name_off[0] = off
    name_len[0] = n
    return 0
}

fn iface_ct_header_valid(path *char, mi int) int {
    let prefix_len int = check.iface_ct_head_prefix_len()
    if (prefix_len < 0) {
        return support.fail_path("CT 接口版本或目标不兼容: ", path)
    }
    let i int = 0
    let end int = prefix_len
    for end < support.src_ctx().length && support.src_ctx().data[end] != '\n' { end += 1 }
    if (end - prefix_len != support.fs().mods[mi].prefix_len) {
        return support.fail_path("CT 接口模块后缀与 .s.i 不匹配: ", path)
    }
    i = 0
    for i < end - prefix_len {
        if (support.src_ctx().data[prefix_len + i]
            != support.pool_ctx().data[support.fs().mods[mi].prefix_off + i]) {
            return support.fail_path("CT 接口模块后缀与 .s.i 不匹配: ", path)
        }
        i += 1
    }
    return 0
}

// iface_ct_load：恢复一个依赖模块的 typed CT 闭包，不改变调用方解析状态。
// path 由调用方给出，通常直接指向可扩容名字池（proj.pool_str）；本函数解析 .s.ct
// 时会把隐藏正文名、形参名与新类型名 intern 进同一个池，池增长时 tml_intern_str
// 会 free 旧块并换新块（gen/symbols.yh），调用方指针随即悬垂。故入口先把 path
// 快照到本函数栈缓冲，之后一律只用快照——否则正文签名不匹配诊断读悬垂指针会
// 直接 SIGSEGV（实测：正文被改成 i64 且接口缓存命中时 100% 崩溃）。
pub fn iface_ct_load(path *char, mi int) int {
    let path_buf [1200]u8
    let path_n int = 0
    for path[path_n] != 0 && path_n < 1199 {
        path_buf[path_n] = path[path_n].to_type(u8)
        path_n += 1
    }
    path_buf[path_n] = 0
    let stable_path *char = support.arr_cstr(&path_buf[0])
    let old_compile int = support.session().compile
    let old_pass int = support.session().pass
    let old_iface int = support.session().iface_load
    let old_indexed int = ast.store().file_indexed
    let old_file int = support.session().active_file
    let old_decl int = ast.store().file_decl_i
    let old_ct_iface int = support.session().ct_iface_mode
    let old_data_count int = support.data_label()
    if (mi < 0 || mi >= support.fs().mod_n || support.read_source(stable_path) != 0
        || iface_ct_header_valid(stable_path, mi) != 0) { return -1 }
    token.ctx().count = 0
    token.ctx().pos = 0
    support.session().compile = 1
    support.session().pass = 1
    support.session().iface_load = 0
    ast.store().file_indexed = 0
    support.session().active_file = 0
    ast.store().file_decl_i = 0
    support.session().ct_iface_mode = 1
    if (lex.lex_all() != 0 || parse_source() != 0
        || support.diag().errors > 0) {
        support.session().ct_iface_mode = old_ct_iface
        return -1
    }
    support.session().pass = 2
    token.ctx().pos = 0
    // .s.ct 中的隐藏常量先折叠并就绪；c_iface_load 仅抑制数据段发射，
    // 随后恢复为普通前端状态以捕获 CT 函数正文。
    support.session().iface_load = 1
    if (parse_source_globals() != 0 || support.diag().errors > 0) {
        support.session().iface_load = old_iface
        support.session().ct_iface_mode = old_ct_iface
        support.data_label_set(old_data_count)
        return -1
    }
    support.session().iface_load = old_iface
    // 闭包常量只供 typed 正文解析；字符串字面量不属于消费者运行期数据。
    support.data_label_set(old_data_count)
    // 全局 pass 已扫描至 EOF；函数 pass 必须从文件头重新遍历。
    token.ctx().pos = 0
    if (parse_source_ct_fns() != 0 || support.diag().errors > 0) {
        support.session().ct_iface_mode = old_ct_iface
        return -1
    }
    let ns int = 0
    for ns < support.fs().mods[mi].ns_n {
        let public_sym int = support.fs().mods[mi].ns[ns].sym
        if (public_sym >= 0 && public_sym < support.ms().sym_n
            && (support.ms().syms[public_sym].flags & support.F_COMPTIME) != 0) {
            let hidden_off int = -1
            let hidden_len int = 0
            if (iface_ct_export_name(mi, ns, &hidden_off, &hidden_len) != 0) {
                support.session().ct_iface_mode = old_ct_iface
                return -1
            }
            let body_sym int = support.sym_lookup_off(hidden_off, hidden_len)
            if (body_sym < 0 || comptime.ct_find(body_sym) < 0
                || support.ms().syms[body_sym].type_id
                    != support.ms().syms[public_sym].type_id) {
                support.session().ct_iface_mode = old_ct_iface
                return support.fail_path("公开 CT 函数与 .s.ct 正文签名不匹配: ",
                    stable_path)
            }
        }
        ns += 1
    }
    // CT IR 已复制到 comptime arena；清空临时 AST，避免其合成文件身份
    // 混入当前模块的普通源码 AST 校验。
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    support.session().compile = old_compile
    support.session().pass = old_pass
    support.session().iface_load = old_iface
    ast.store().file_indexed = old_indexed
    support.session().active_file = old_file
    ast.store().file_decl_i = old_decl
    support.session().ct_iface_mode = old_ct_iface
    return 0
}
