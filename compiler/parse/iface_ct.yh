module parse
import check
import errors
import support
import proj

fn iface_ct_export_name(mi int, ns_row int, name_off *int,
    name_len *int) int {
    if (mi < 0 || mi >= proj.fs().mod_n || ns_row < 0
        || ns_row >= proj.fs().mods[mi].ns_n) {
        return errors.fail("内部错误：公开 CT 接口条目无效")
    }
    let ent proj.ModNsEnt = proj.fs().mods[mi].ns[ns_row]
    let modinfo proj.ModInfo = proj.fs().mods[mi]
    let buf [1200]u8
    let n int = 0
    n = support.append_str(buf, n, "__yhct_")
    let i int = 0
    for i < ent.name_len {
        buf[n] = support.pool_ctx().data[ent.name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < modinfo.prefix_len {
        buf[n] = support.pool_ctx().data[modinfo.prefix_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(buf, 0, n)
    if (off < 0) { return -1 }
    name_off[0] = off
    name_len[0] = n
    return 0
}

fn iface_ct_header_valid(path *char, mi int) int {
    let prefix_len int = check.iface_ct_head_prefix_len()
    if (prefix_len < 0) {
        return errors.fail_path("CT 接口版本或目标不兼容: ", path)
    }
    let i int = 0
    let end int = prefix_len
    for end < support.src_ctx().length && support.src_ctx().data[end] != '\n' { end += 1 }
    if (end - prefix_len != proj.fs().mods[mi].prefix_len) {
        return errors.fail_path("CT 接口模块后缀与 .s.i 不匹配: ", path)
    }
    i = 0
    for i < end - prefix_len {
        if (support.src_ctx().data[prefix_len + i]
            != support.pool_ctx().data[proj.fs().mods[mi].prefix_off + i]) {
            return errors.fail_path("CT 接口模块后缀与 .s.i 不匹配: ", path)
        }
        i += 1
    }
    return 0
}

