module parse;
import gen;
import comptime;

// ============================================================================
// parse_global_init.yh —— 绑定与全局初始化
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================


// ---- 绑定与初始化 ----

// parse_binding：名字 + 必需类型 + 可选初值。kind：SYM_VAR / SYM_CONST。
// global=1 为顶层绑定（pass1 登记 / pass2 折叠发射），global=0 为局部。
// 通过 c_bind_idx 返回涉及的符号下标（无则为 -1）。
let c_bind_idx int = -1;
pub fn parse_binding(global int, kind int) int {
    let gs *gen.GenState = gen.G();
    c_bind_idx = -1;
    if (p_cur() != gen.TOK_IDENT) {
        return gen.err_tok("此处需要一个变量名");
    }
    let name_token int = gs.c_pos;
    let start int = gs.c_toks[gs.c_pos].start;
    let n int = gs.c_toks[gs.c_pos].len;
    p_adv();
    let tid int = parse_type_ref();
    if (tid < 0) {
        return -1;
    }
    if (gs.c_compile == 0) {
        // 语法模式：只看初值形态
        if (p_cur() == gen.TK_ASSIGN) {
            p_adv();
            let r gen.Res;
            if (parse_expr_iso(&r) != 0) {
                return -1;
            }
        }
        return 0;
    }
    // 编译模式
    if (gen.ty_has_opaque_value(tid) != 0) {
        return gen.sem_err("不透明 C 类型只能通过指针声明");
    }
    let idx int = -1;
    if (gs.c_pass == 1) {
        // 顶层登记：标量/聚合（结构体/数组/切片）一律登记名字与类型；
        // 零初始化聚合在 pass 2 走 .bss，带初始化器的聚合走
        // parse_global_init 的数据发射。
        let fl int = gen.F_GLOBAL;
        if (gs.c_decl_pub != 0) {
            fl |= gen.F_PUB;
        }
        idx = gen.sym_push(start, n, kind, tid, fl);
        if (idx < 0) {
            return -1;
        }
    } else if (global != 0) {
        idx = gen.sym_lookup(start, n);
        if (idx < 0) {
            return gen.sem_err("内部错误：全局符号丢失");
        }
    } else {
        // 局部
        if (gen.sem_check_duplicate(start, n) != 0) {
            return -1;
        }
        if (kind == gen.SYM_CONST) {
            idx = gen.sym_push(start, n, gen.SYM_CONST, tid, 0);
        } else {
            idx = gen.sem_declare_local(start, n, tid);
        }
        if (idx < 0) {
            return -1;
        }
    }
    c_bind_idx = idx;
    if (global == 0 && ast_binding_add(idx, name_token, 0) != 0) {
        return -1;
    }
    if (p_cur() == gen.TK_ASSIGN) {
        p_adv();
        if (gs.c_pass == 1) {
            if (global != 0 && kind == gen.SYM_CONST
                && gen.ty_is_integer(tid) != 0) {
                let probe int = parse_global_ct_const_probe(idx, tid);
                if (probe < 0) { return -1; }
                if (probe > 0) { return 0; }
            }
            return skip_init();
        }
        if (global != 0) {
            return parse_global_init(idx, tid, kind);
        }
        return parse_local_init(idx, tid, kind);
    }
    // 无初值
    if (gs.c_compile != 0 && kind == gen.SYM_CONST) {
        return gen.sem_err("const 必须带初值");
    }
    if (gs.c_compile != 0 && gs.c_pass == 2 && global != 0 && kind == gen.SYM_VAR) {
        // 零初始化全局 → .bss
        return sem_global_zero(idx, tid);
    }
    return 0;
}

// record_aggregate_const_src：为聚合（结构体/数组）常量记下**初始化式源文本**
// （const_expr_kind = 4）。聚合常量的值在编译期不可得（数据在发射阶段才写出），
// 所以跨模块 CT 闭包改为重放源文本、由导入侧重新解析。范围由首尾 token 求得。
fn record_aggregate_const_src(idx int, first int, after int) int {
    let gs *gen.GenState = gen.G();
    if (after <= first) { return 0; }
    let start int = gs.c_toks[first].start;
    let last int = after - 1;
    let span int = gs.c_toks[last].start + gs.c_toks[last].len - start;
    if (span <= 0) { return 0; }
    let off int = gen.tml_intern_str(gs.c_src, start, span);
    if (off < 0) { return -1; }
    gs.c_syms[idx].const_expr_off = off;
    gs.c_syms[idx].const_expr_len = span;
    gs.c_syms[idx].const_expr_kind = 4;
    return 0;
}

pub fn parse_global_init(idx int, tid int, kind int) int {
    let gs *gen.GenState = gen.G();
    // 初始化式的起始 token：聚合常量要按这个位置记下源文本（见 record_aggregate_const_src）。
    let init_pos int = gs.c_pos;
    let fk int = gs.t_types[tid].kind;
    if (fk == gen.TY_STRUCT) {
        // const 聚合常量：与全局变量走同一条初始化路径（发射到数据段，运行期只读）。
        // 模块模式只拒绝 **pub** 的：接口（.s.i）的常量导出只能传标量 cval，覆盖不了聚合，
        // 私有常量不经过接口，可安全放行。
        if (kind == gen.SYM_CONST && gs.c_module_mode != 0
            && (gs.c_syms[idx].flags & gen.F_PUB) != 0) {
            return gen.sem_err("pub const 聚合常量暂不支持跨模块导出");
        }
        if (p_cur() == gen.TK_DOLLAR) {
            return parse_global_comptime_aggregate(idx, tid);
        }
        if (parse_global_struct_init(idx, tid) != 0) { return -1; }
        // 聚合常量没有标量值，但数据已发射到数据段：标记为已就绪，避免读取时
        // 被「编译期常量尚未就绪」拦下（运行期按全局符号地址访问字段）。
        if (kind == gen.SYM_CONST) {
            if (record_aggregate_const_src(idx, init_pos, gs.c_pos) != 0) {
                return -1;
            }
            gs.c_syms[idx].const_ready = 1;
        }
        return 0;
    }
    if (fk == gen.TY_UNION) {
        return gen.sem_err("union 全局初始化暂不支持");
    }
    if (fk == gen.TY_ARRAY || fk == gen.TY_SLICE) {
        // const 数组/切片常量：与结构体同理，单文件走变量同一条发射路径；
        // 模块模式同样只拒绝 **pub** 的（理由见上）。
        if (kind == gen.SYM_CONST && gs.c_module_mode != 0
            && (gs.c_syms[idx].flags & gen.F_PUB) != 0) {
            return gen.sem_err("pub const 聚合常量暂不支持跨模块导出");
        }
        if (p_cur() == gen.TK_DOLLAR) {
            return parse_global_comptime_aggregate(idx, tid);
        }
        if (p_cur() != gen.TK_LBRACKET) {
            return gen.sem_err("全局数组/切片初始化仅支持字面量（零初始化可用）");
        }
        if (parse_global_array_init(idx, tid, fk) != 0) { return -1; }
        // 聚合常量：数据已发射，标记已就绪供运行期按符号地址读取。
        if (kind == gen.SYM_CONST) {
            if (record_aggregate_const_src(idx, init_pos, gs.c_pos) != 0) {
                return -1;
            }
            gs.c_syms[idx].const_ready = 1;
        }
        return 0;
    }
    let init_token_first int = gs.c_pos;
    gs.c_fold += 1;
    let r gen.Res;
    let rr int = parse_expr_iso(&r);
    gs.c_fold -= 1;
    let init_token_after int = gs.c_pos;
    if (rr != 0) {
        return -1;
    }
    if (r.is_const == 0) {
        return gen.sem_err("全局初始化必须是编译期常量");
    }
    if (gen.sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1;
    }
    if (kind == gen.SYM_CONST) {
        gs.c_syms[idx].cval = r.ival;
        // 跨模块 CT 闭包需要重放浮点字面值；保存字节以避免十进制/IEEE 位转换丢精度。
        if (gen.ty_is_float(tid) != 0 && init_token_after == init_token_first + 1
            && gs.c_toks[init_token_first].kind == gen.TOK_NUMBER
            && gen.sem_num_is_float(gs.c_toks[init_token_first].start,
                gs.c_toks[init_token_first].len) != 0) {
            let expr_start int = gs.c_toks[init_token_first].start;
            let expr_len int = gs.c_toks[init_token_first].len;
            let expr_off int = gen.tml_intern_str(gs.c_src, expr_start,
                expr_len);
            if (expr_off < 0) { return -1; }
            gs.c_syms[idx].const_expr_off = expr_off;
            gs.c_syms[idx].const_expr_len = expr_len;
            gs.c_syms[idx].const_expr_kind = 1;
        }
        // 只保存单个字符串 token；跨模块闭包重放原字节，不传递提供方数据标签。
        if (fk == gen.TY_PTR && init_token_after == init_token_first + 1
            && gs.c_toks[init_token_first].kind == gen.TOK_STRING) {
            let expr_start int = gs.c_toks[init_token_first].start;
            let expr_len int = gs.c_toks[init_token_first].len;
            let expr_off int = gen.tml_intern_str(gs.c_src, expr_start,
                expr_len);
            if (expr_off < 0) { return -1; }
            gs.c_syms[idx].const_expr_off = expr_off;
            gs.c_syms[idx].const_expr_len = expr_len;
            gs.c_syms[idx].const_expr_kind = 2;
        }
        // 指针常量的初始化式是单个标识符（引用另一个指针常量）：记下该名字，
        // 供接口导出时追链到最终字面式（消费者看不到提供方的私有常量名）。
        if (fk == gen.TY_PTR && init_token_after == init_token_first + 1
            && gs.c_toks[init_token_first].kind == gen.TOK_IDENT) {
            let rid_start int = gs.c_toks[init_token_first].start;
            let rid_len int = gs.c_toks[init_token_first].len;
            let rid_off int = gen.tml_intern_str(gs.c_src, rid_start, rid_len);
            if (rid_off < 0) { return -1; }
            gs.c_syms[idx].const_expr_off = rid_off;
            gs.c_syms[idx].const_expr_len = rid_len;
            gs.c_syms[idx].const_expr_kind = 3;
        }
        if (fk == gen.TY_PTR) {
            gs.c_syms[idx].flags |= gen.F_ADDR;
        }
        gs.c_syms[idx].const_ready = 1;
        return 0;
    }
    // 全局变量：指针的 0 是 NULL（.xword 0）；标签号 ≥ 1 才是字符串地址
    if (fk == gen.TY_PTR) {
        if (r.ival == 0) {
            if (gs.c_bss_n >= 4096) {
                return gen.sem_err("零初始化全局过多");
            }
            gs.c_syms[idx].offset = gs.c_bss_n;
            gs.c_bss_syms[gs.c_bss_n] = idx;
            gs.c_bss_n += 1;
            return 0;
        }
        if (gen.em_data_symbol_header(idx, gs.t_types[tid].align) != 0) {
            return -1;
        }
        if (gen.dat_puts(".xword\t.LD") != 0) {
            return -1;
        }
        if (gen.dat_puti(r.ival.to_type(int)) != 0) {
            return -1;
        }
        return gen.dat_put('\n');
    }
    if (r.ival == 0) {
        if (gs.c_bss_n >= 4096) {
            return gen.sem_err("零初始化全局过多");
        }
        gs.c_syms[idx].offset = gs.c_bss_n;
        gs.c_bss_syms[gs.c_bss_n] = idx;
        gs.c_bss_n += 1;
        return 0;
    }
    if (gen.em_data_symbol_header(idx, gs.t_types[tid].align) != 0) {
        return -1;
    }
    return gen.em_data_scalar(tid, r.ival);
}

// parse_global_comptime_aggregate：折叠顶层 CT 聚合结果并写入全局数据符号。
pub fn parse_global_comptime_aggregate(idx int, tid int) int {
    let gs *gen.GenState = gen.G();
    gs.c_fold += 1;
    let result gen.Res;
    let status int = parse_expr_iso(&result);
    gs.c_fold -= 1;
    if (status != 0) { return -1; }
    if (result.is_const == 0) {
        return gen.sem_err("全局聚合初始化必须是编译期聚合结果");
    }
    if (gen.sem_can_assign(tid, result.type_id, result.is_lit,
            result.ival, result.lit_big) != 0) { return -1; }
    let value comptime.CtValue;
    value.type_id = tid;
    value.value = result.ival;
    value.is_lit = result.is_lit;
    value.lit_big = result.lit_big;
    return comptime.ct_ir_data_emit_global(idx, tid, &value);
}

// parse_global_ct_const_probe：提前折叠已登记的简单 CT 整数常量供后续数组布局使用。
pub fn parse_global_ct_const_probe(idx int, tid int) int {
    let gs *gen.GenState = gen.G();
    if (p_cur() != gen.TK_DOLLAR || p_peek(1) != gen.TOK_IDENT) { return 0; }
    // 早期 token 探测只接受当前可解析的名字；可能前向引用的 CT 初始化器
    // 留给全部声明登记后的 typed 布局常量依赖调度。
    if (parse_global_ct_const_has_unready_name() != 0) { return 0; }
    let token int = gs.c_pos + 1;
    let sym int = gen.sym_lookup(gs.c_toks[token].start, gs.c_toks[token].len);
    if (sym < 0 || gs.c_syms[sym].kind != gen.SYM_FN
        || (gs.c_syms[sym].flags & gen.F_COMPTIME) == 0
        // 只在目标编译期函数已捕获 typed IR 时才提前折叠：pass1 期间一律让位给
        // pass2a 之后的 typed 布局常量依赖调度，避免使用第二套 token 解释器。
        || comptime.ct_is_prepared(sym) == 0) { return 0; }
    gs.c_fold += 1;
    let value gen.Res;
    let status int = parse_expr_iso(&value);
    gs.c_fold -= 1;
    if (status != 0) { return -1; }
    if (value.is_const == 0) {
        return gen.sem_err("全局整数常量初始化必须是编译期常量");
    }
    if (gen.sem_can_assign(tid, value.type_id, value.is_lit,
            value.ival, value.lit_big) != 0) { return -1; }
    gs.c_syms[idx].cval = value.ival;
    gs.c_syms[idx].const_ready = 1;
    return 1;
}

// parse_global_ct_const_has_unready_name：检查简单早期探测是否会碰到未知或未就绪全局名。
fn parse_global_ct_const_has_unready_name() int {
    let gs *gen.GenState = gen.G();
    let i int = gs.c_pos;
    let depth int = 0;
    for i < gs.c_tok_n {
        let kind int = gs.c_toks[i].kind;
        if (kind == gen.TK_SEMI && depth == 0) { break; }
        if (kind == gen.TK_LPAREN || kind == gen.TK_LBRACKET || kind == gen.TK_LBRACE) {
            depth += 1;
        } else if (kind == gen.TK_RPAREN || kind == gen.TK_RBRACKET
            || kind == gen.TK_RBRACE) {
            depth -= 1;
        }
        if (kind == gen.TOK_IDENT
            && (i == 0 || (gs.c_toks[i - 1].kind != gen.TK_DOT
                && gs.c_toks[i - 1].kind != gen.TK_DOLLAR))) {
            let sym int = gen.sym_lookup(gs.c_toks[i].start, gs.c_toks[i].len);
            if (sym < 0) { return 1; }
            if (gs.c_syms[sym].kind == gen.SYM_CONST
                && gs.c_syms[sym].const_ready == 0) { return 1; }
        }
        i += 1;
    }
    return 0;
}

pub fn sem_global_zero(idx int, tid int) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_iface_load != 0) {
        return 0;
    }
    if (gs.c_bss_n >= 4096) {
        return gen.sem_err("零初始化全局过多");
    }
    gs.c_syms[idx].offset = gs.c_bss_n;
    gs.c_bss_syms[gs.c_bss_n] = idx;
    gs.c_bss_n += 1;
    return 0;
}

pub fn parse_global_array_init(idx int, tid int, fk int) int {
    let gs *gen.GenState = gen.G();
    let elem int = gs.t_types[tid].elem;
    let esz int = gs.t_types[elem].size;
    p_adv(); // 消费 '['
    let vals [64]i64;      // 整数值 / f64 位型
    let kinds [64]int;     // 0=标量 1=字符串
    let str_start [64]int; // 字符串源码区间（内容在元素槽之后补发）
    let str_len [64]int;
    let count int = 0;
    if (p_cur() != gen.TK_RBRACKET) {
        for 1 {
            if (count >= 64) {
                return gen.sem_err("全局数组字面量元素过多（上限 64）");
            }
            if (p_cur() == gen.TOK_STRING) {
                // 字符串元素：预领标签号（内容在元素槽之后补发）
                let ss int = gs.c_toks[gs.c_pos].start;
                let sl int = gs.c_toks[gs.c_pos].len;
                p_adv();
                kinds[count] = 1;
                vals[count] = gs.c_data_n.to_type(i64);
                gs.c_data_n += 1;
                str_start[count] = ss;
                str_len[count] = sl;
                count += 1;
                if (p_cur() == gen.TK_COMMA) {
                    p_adv();
                    if (p_cur() == gen.TK_RBRACKET) { break; }
                    continue;
                }
                break;
            }
            gs.c_fold += 1;
            let e gen.Res;
            let er int = parse_expr_iso(&e);
            gs.c_fold -= 1;
            if (er != 0) {
                return -1;
            }
            if (e.is_const == 0) {
                return gen.sem_err("全局数组字面量元素必须是编译期常量");
            }
            if (gen.sem_can_assign(elem, e.type_id, e.is_lit, e.ival, e.lit_big) != 0) {
                return -1;
            }
            if (gen.ty_is_float(elem) != 0) {
                if (gen.ty_is_float(e.type_id) == 0) {
                    return gen.sem_err("浮点元素需要浮点字面量");
                }
                if (esz != 8) {
                    return gen.sem_err("f32 元素的全局初始化暂不支持（请用 f64）");
                }
                vals[count] = e.fval_bits;
            } else {
                vals[count] = e.ival;
            }
            count += 1;
            if (p_cur() == gen.TK_COMMA) {
                p_adv();
                if (p_cur() == gen.TK_RBRACKET) { break; }
                continue;
            }
            break;
        }
    }
    if (p_expect(gen.TK_RBRACKET, "期望 ']'") != 0) {
        return -1;
    }
    if (fk == gen.TY_ARRAY && count != gs.t_types[tid].len) {
        return gen.sem_err("数组字面量元素个数与数组长度不一致");
    }
    // 发射变量数据
    let lbl int = 0;
    if (fk == gen.TY_SLICE) {
        lbl = gs.c_data_n;
        gs.c_data_n += 1;
    }
    if (gen.em_data_symbol_header(idx, gs.t_types[tid].align) != 0) {
        return -1;
    }
    if (fk == gen.TY_SLICE) {
        // {count, .LDlbl}
        if (gen.dat_puts(".xword\t") != 0) { return -1; }
        if (gen.dat_puthex(count.to_type(i64)) != 0) { return -1; }
        if (gen.dat_put('\n') != 0) { return -1; }
        if (gen.dat_puts(".xword\t.LD") != 0) { return -1; }
        if (gen.dat_puti(lbl) != 0) { return -1; }
        if (gen.dat_put('\n') != 0) { return -1; }
        if (gen.dat_puts(".balign\t") != 0) { return -1; }
        if (gen.dat_puti(esz) != 0) { return -1; }
        if (gen.dat_put('\n') != 0) { return -1; }
        if (gen.dat_puts(".LD") != 0) { return -1; }
        if (gen.dat_puti(lbl) != 0) { return -1; }
        if (gen.dat_put(':') != 0) { return -1; }
        if (gen.dat_put('\n') != 0) { return -1; }
    }
    let i int = 0;
    for i < count {
        if (kinds[i] == 1) {
            if (gen.dat_puts(".xword\t.LD") != 0) { return -1; }
            if (gen.dat_puti(vals[i].to_type(int)) != 0) { return -1; }
            if (gen.dat_put('\n') != 0) { return -1; }
        } else if (gen.ty_is_float(elem) != 0) {
            if (gen.dat_puts(".xword\t") != 0) { return -1; }
            if (gen.dat_puthex(vals[i]) != 0) { return -1; }
            if (gen.dat_put('\n') != 0) { return -1; }
        } else {
            if (gen.em_data_scalar(elem, vals[i]) != 0) { return -1; }
        }
        i += 1;
    }
    if (fk == gen.TY_ARRAY) {
        let used int = esz * count;
        if (used < gs.t_types[tid].size) {
            if (gen.dat_puts(".zero\t") != 0) { return -1; }
            if (gen.dat_puti(gs.t_types[tid].size - used) != 0) { return -1; }
            if (gen.dat_put('\n') != 0) { return -1; }
        }
    }
    // 补发字符串内容（标签号已在元素槽中引用）
    i = 0;
    for i < count {
        if (kinds[i] == 1) {
            if (gen.em_data_string_body(str_start[i], str_len[i], vals[i].to_type(int)) < 0) {
                return -1;
            }
        }
        i += 1;
    }
    return 0;
}

pub fn parse_global_struct_init(idx int, tid int) int {
    let gs *gen.GenState = gen.G();
    if (p_cur() != gen.TOK_IDENT) {
        return gen.sem_err("全局结构体初始化需要「类型名 { 字段 }」字面量");
    }
    let nstart int = gs.c_toks[gs.c_pos].start;
    let nlen int = gs.c_toks[gs.c_pos].len;
    if (gen.ty_lookup_name(nstart, nlen) != tid) {
        return gen.sem_err("初始化器类型与变量类型不一致");
    }
    p_adv();
    if (p_expect(gen.TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    if (gen.em_data_symbol_header(idx, gs.t_types[tid].align) != 0) {
        return -1;
    }
    let cur int = 0;
    if (parse_global_struct_body(tid, 0, &cur) != 0) {
        return -1;
    }
    if (p_expect(gen.TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (cur < gs.t_types[tid].size) {
        if (gen.dat_puts(".zero\t") != 0) {
            return -1;
        }
        if (gen.dat_puti(gs.t_types[tid].size - cur) != 0) {
            return -1;
        }
        return gen.dat_put('\n');
    }
    return 0;
}

pub fn parse_global_struct_body(tid int, base int, cur *int) int {
    let gs *gen.GenState = gen.G();
    if (p_cur() == gen.TK_RBRACE) {
        return gen.err_tok("结构体字面量不能为空");
    }
    let named int = 0;
    if (is_member_name(p_cur()) != 0 && p_peek(1) == gen.TK_COLON) {
        named = 1;
    }
    let fpos int = 0;
    for 1 {
        let fidx int = -1;
        if (named != 0) {
            if (is_member_name(p_cur()) == 0) {
                return gen.err_tok("命名式字面量需要字段名");
            }
            let fs int = gs.c_toks[gs.c_pos].start;
            let fl int = gs.c_toks[gs.c_pos].len;
            fidx = gen.sem_lit_field_lookup(tid, fs, fl);
            if (fidx < 0) {
                return gen.sem_err("结构体没有该字段");
            }
            p_adv();
            if (p_expect(gen.TK_COLON, "期望 ':'") != 0) {
                return -1;
            }
        } else {
            if (fpos >= gs.t_types[tid].len) {
                return gen.sem_err("位置式字面量字段过多");
            }
            fidx = gs.t_types[tid].sub + fpos;
            fpos += 1;
        }
        if (parse_global_field_value(fidx, base, cur) != 0) {
            return -1;
        }
        if (p_cur() == gen.TK_COMMA) {
            p_adv();
            if (p_cur() == gen.TK_RBRACE) {
                break;
            }
            continue;
        }
        break;
    }
    return 0;
}

pub fn parse_global_field_value(fidx int, base int, cur *int) int {
    let gs *gen.GenState = gen.G();
    let ftid int = gs.t_fields[fidx].type_id;
    let foff int = base + gs.t_fields[fidx].offset;
    if (foff > cur[0]) {
        // 字段间对齐间隙
        if (gen.dat_puts(".zero\t") != 0) {
            return -1;
        }
        if (gen.dat_puti(foff - cur[0]) != 0) {
            return -1;
        }
        if (gen.dat_put('\n') != 0) {
            return -1;
        }
    }
    cur[0] = foff;
    let fk int = gs.t_types[ftid].kind;
    if (fk == gen.TY_STRUCT) {
        // 嵌套结构体字面量：IDENT '{' body '}'
        if (p_cur() != gen.TOK_IDENT) {
            return gen.sem_err("嵌套字段需要「类型名 { 字段 }」字面量");
        }
        let ns int = gs.c_toks[gs.c_pos].start;
        let nl int = gs.c_toks[gs.c_pos].len;
        if (gen.ty_lookup_name(ns, nl) != ftid) {
            return gen.sem_err("嵌套字面量类型与字段类型不一致");
        }
        p_adv();
        if (p_expect(gen.TK_LBRACE, "期望 '{'") != 0) {
            return -1;
        }
        if (parse_global_struct_body(ftid, foff, cur) != 0) {
            return -1;
        }
        if (p_expect(gen.TK_RBRACE, "期望 '}'") != 0) {
            return -1;
        }
        if (cur[0] < foff + gs.t_types[ftid].size) {
            if (gen.dat_puts(".zero\t") != 0) {
                return -1;
            }
            if (gen.dat_puti(foff + gs.t_types[ftid].size - cur[0]) != 0) {
                return -1;
            }
            if (gen.dat_put('\n') != 0) {
                return -1;
            }
        }
        cur[0] = foff + gs.t_types[ftid].size;
        return 0;
    }
    if (fk == gen.TY_UNION) {
        return gen.sem_err("union 字段的全局初始化暂不支持");
    }
    if (fk == gen.TY_ARRAY || fk == gen.TY_SLICE) {
        return gen.sem_err("数组/切片字段的全局初始化暂不支持");
    }
    // 标量 / 指针 / 浮点：各分支自行折叠求值并发射
    let r int = 0;
    if (fk == gen.TY_PTR) {
        if (p_cur() == gen.TOK_STRING) {
            // 字符串字面量：先领标签号、发指针引用，再补内容——
            // 内容不能打断变量自身的字段布局（曾插进字段中间）。
            let ss int = gs.c_toks[gs.c_pos].start;
            let sl int = gs.c_toks[gs.c_pos].len;
            p_adv();
            let lbl int = gs.c_data_n;
            gs.c_data_n += 1;
            if (gen.dat_puts(".xword\t.LD") != 0) {
                return -1;
            }
            if (gen.dat_puti(lbl) != 0) {
                return -1;
            }
            if (gen.dat_put('\n') != 0) {
                return -1;
            }
            // 注意 em_data_string_body 返回标签号（可能 >0），不是错误码
            if (gen.em_data_string_body(ss, sl, lbl) < 0) {
                return -1;
            }
            r = 0;
        } else {
            gs.c_fold += 1;
            let pv gen.Res;
            let pr int = parse_expr_iso(&pv);
            gs.c_fold -= 1;
            if (pr != 0) {
                return -1;
            }
            if (pv.is_const == 0) {
                return gen.sem_err("全局初始化字段必须是编译期常量");
            }
            if (gen.sem_can_assign(ftid, pv.type_id, pv.is_lit, pv.ival, pv.lit_big) != 0) {
                return -1;
            }
            if (pv.ival != 0) {
                return gen.sem_err("指针字段全局初始化仅支持字符串与 NULL");
            }
            r = gen.em_data_scalar(ftid, 0);
        }
    } else if (gen.ty_is_float(ftid) != 0) {
        gs.c_fold += 1;
        let fv2 gen.Res;
        let fr int = parse_expr_iso(&fv2);
        gs.c_fold -= 1;
        if (fr != 0) {
            return -1;
        }
        if (fv2.is_const == 0) {
            return gen.sem_err("全局初始化字段必须是编译期常量");
        }
        if (gen.ty_is_float(fv2.type_id) == 0) {
            return gen.sem_err("浮点字段需要浮点字面量");
        }
        if (gs.t_types[ftid].size != 8) {
            return gen.sem_err("f32 字段的全局初始化暂不支持（请用 f64）");
        }
        if (gen.dat_puts(".xword\t") != 0) {
            return -1;
        }
        if (gen.dat_puthex(fv2.fval_bits) != 0) {
            return -1;
        }
        r = gen.dat_put('\n');
    } else {
        gs.c_fold += 1;
        let v gen.Res;
        let vr int = parse_expr_iso(&v);
        gs.c_fold -= 1;
        if (vr != 0) {
            return -1;
        }
        if (v.is_const == 0) {
            return gen.sem_err("全局初始化字段必须是编译期常量");
        }
        if (gen.sem_can_assign(ftid, v.type_id, v.is_lit, v.ival, v.lit_big) != 0) {
            return -1;
        }
        r = gen.em_data_scalar(ftid, v.ival);
    }
    if (r != 0) {
        return -1;
    }
    cur[0] = foff + gs.t_types[ftid].size;
    return 0;
}
