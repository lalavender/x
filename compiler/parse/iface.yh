module parse
import token
import support
import gen
import lex

// ============================================================================
// iface.yh —— 模块接口的发射与加载（MOD-U4）
//
// 接口文件（<模块>.yh.i）是编译器为每个模块生成的「稳定接口」：
//   * 头行：// yh-iface v1/v2/v3 arch=arm64 suffix=<符号后缀>
//   * 正文：pub 类型（struct/union/enum/type 别名，字段带 pub 标记）、
//     pub fn 签名（空体）、pub const（折叠后的字面量值）、pub let（无
//     初始化——存储由模块自己的 .s 提供）。
// 正文是合法 yh 源码：加载 = 头校验 + 正常 pass1 登记 + pass2a 折叠
// 常量（c_iface_load 抑制发射与 bss 登记），随后把新增符号/类型名改写
// 为「短名+后缀」并记录进 ModInfo.ns（限定名解析用）。
//
// 边界（首版）：pub 签名/字段只能引用本模块导出的具名类型或内建类型；
// 引用其他模块的类型报错（类型闭包内联留待按需实现）；pub 指针常量
// （字符串 const）暂不导出。
// ============================================================================

// —— 接口发射缓冲（独立于汇编缓冲；成功后一次写出） ——
let if_buf *u8 = 0
let if_len int = 0
let if_cap int = 0

// if_put / if_puts / if_puti / if_puti64：接口文本写入。
fn if_put(b u8) int {
    if (support.out_grow(&if_buf, if_len, &if_cap, if_len + 1) != 0) {
        return -1
    }
    if_buf[if_len] = b
    if_len += 1
    return 0
}

fn if_puts(s *char) int {
    let i int = 0
    for s[i] != 0 {
        if (if_put(s[i].to_type(u8)) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

fn if_puti(v int) int {
    let tmp [12]u8
    let k int = 0
    let neg int = 0
    if (v < 0) {
        neg = 1
        v = -v
    }
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    if (neg != 0) {
        if (if_put('-') != 0) {
            return -1
        }
    }
    for k > 0 {
        k -= 1
        if (if_put(tmp[k]) != 0) {
            return -1
        }
    }
    return 0
}

// if_put_np：写名字池字节区间。
fn if_put_np(off int, olen int) int {
    let t *gen.TaskCtx = gen.task()
    let i int = 0
    for i < olen {
        if (if_put(support.pool_ctx().data[off + i]) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

// if_emit_type：把类型编号渲染为 yh 类型引用文本。
// own_name_base：本模块类型名的 t_names 起始下标（跨模块引用拒绝）。
fn if_emit_type(tid int, own_name_base int) int {
    let t *gen.TaskCtx = gen.task()
    let k int = support.ms().types[tid].kind
    if (k == gen.TY_VOID) { return if_puts("void") }
    if (k == gen.TY_BOOL) { return if_puts("bool") }
    if (k == gen.TY_CHAR) { return if_puts("char") }
    if (k == gen.TY_I8) { return if_puts("i8") }
    if (k == gen.TY_I16) { return if_puts("i16") }
    if (k == gen.TY_I32) { return if_puts("int") }
    if (k == gen.TY_I64) { return if_puts("i64") }
    if (k == gen.TY_U8) { return if_puts("u8") }
    if (k == gen.TY_U16) { return if_puts("u16") }
    if (k == gen.TY_U32) { return if_puts("u32") }
    if (k == gen.TY_U64) { return if_puts("u64") }
    if (k == gen.TY_F32) { return if_puts("f32") }
    if (k == gen.TY_F64) { return if_puts("f64") }
    if (k == gen.TY_PTR) {
        if (if_put('*') != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == gen.TY_ARRAY) {
        if (if_put('[') != 0) { return -1 }
        if (if_puti(support.ms().types[tid].len) != 0) { return -1 }
        if (if_put(']') != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == gen.TY_SLICE) {
        if (if_puts("[]") != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == gen.TY_FN) {
        if (support.ms().sig_abi[support.ms().types[tid].sub] == support.ABI_C
            && if_puts("@[extern] ") != 0) { return -1 }
        if (if_puts("fn(") != 0) { return -1 }
        let sig int = support.ms().types[tid].sub
        let np2 int = support.ms().sig_np[sig]
        let i int = 0
        for i < np2 {
            if (i > 0) {
                if (if_puts(", ") != 0) { return -1 }
            }
            if (if_emit_type(support.ms().sig_params[support.ms().sig_first[sig] + i], own_name_base) != 0) {
                return -1
            }
            i += 1
        }
        if (if_puts(")") != 0) { return -1 }
        return if_emit_type(support.ms().sig_ret[sig], own_name_base)
    }
    // 具名类型（struct/union/enum/别名目标）：全表查询——pub 签名可引用
    // 本模块类型，也可引用已加载接口带来的跨模块类型（mangle 名原样
    // 写出，下游加载时作为普通类型名登记）
    let found int = -1
    let i2 int = 0
    for i2 < support.ms().name_n {
        if (support.ms().names[i2].type_id == tid) {
            found = i2
            break
        }
        i2 += 1
    }
    if (found < 0) {
        return gen.sem_err("pub 接口引用了非具名类型（无法导出）")
    }
    if (support.ms().names[found].is_pub == 0) {
        return gen.sem_err("pub 接口引用了非 pub 类型（请将该类型声明为 pub）")
    }
    return if_put_np(support.ms().names[found].name_off, support.ms().names[found].name_len)
}

// iface_emit：把本模块 pub 接口写到 path。
// sym_base/tname_base：本模块登记起点（此前是 prelude 与已加载接口）。
pub fn iface_emit(path *char, sym_base int, tname_base int) int {
    let t *gen.TaskCtx = gen.task()
    if_len = 0
    // 无属性接口保持 v1；已有函数属性使用 v2；公开 comptime 签名使用 v3。
    let iface_version int = 1
    let ti0 int = tname_base
    for ti0 < support.ms().name_n {
        if (support.ms().names[ti0].is_pub != 0
            && (support.ms().names[ti0].attrs & token.ATTR_EXTERN) != 0) {
            if (iface_version < 2) { iface_version = 2 }
        }
        ti0 += 1
    }
    let si0 int = sym_base
    for si0 < support.ms().sym_n {
        let flags int = support.ms().syms[si0].flags
        if ((flags & gen.F_PUB) != 0
            && ((flags & gen.F_EXTERN) == 0 || (flags & gen.F_CABI) != 0)
            && (flags & gen.F_COMPTIME) != 0) {
            iface_version = 3
        } else if ((flags & gen.F_PUB) != 0
            && ((flags & gen.F_EXTERN) == 0 || (flags & gen.F_CABI) != 0)
            && (flags & (gen.F_CABI | gen.F_INLINE | gen.F_NORETURN)) != 0
            && iface_version < 2) {
            iface_version = 2
        }
        si0 += 1
    }
    if (iface_version == 3) {
        if (if_puts("// yh-iface v3 arch=") != 0) { return -1 }
    } else if (iface_version == 2) {
        if (if_puts("// yh-iface v2 arch=") != 0) { return -1 }
    } else if (if_puts("// yh-iface v1 arch=") != 0) { return -1 }
    if (if_puts(support.target_arch_token()) != 0) { return -1 }
    if (if_puts(" suffix=") != 0) { return -1 }
    if (if_put_np(support.fs().sym_sfx_off, support.fs().sym_sfx_len) != 0) { return -1 }
    if (if_put('\n') != 0) { return -1 }
    // 类型（声明序）
    let ti int = tname_base
    for ti < support.ms().name_n {
        if (support.ms().names[ti].is_pub == 0) {
            ti += 1
            continue
        }
        let tid int = support.ms().names[ti].type_id
        if (support.ms().names[ti].form == 1 || support.ms().names[ti].form == 2) {
            if ((support.ms().names[ti].attrs & token.ATTR_EXTERN) != 0
                && if_puts("@[extern]\n") != 0) { return -1 }
            if (if_puts("pub ") != 0) { return -1 }
            if (support.ms().names[ti].form == 1) {
                if (if_puts("struct ") != 0) { return -1 }
            } else {
                if (if_puts("union ") != 0) { return -1 }
            }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" {\n") != 0) { return -1 }
            let st int = support.ms().types[tid].sub
            let nf int = support.ms().types[tid].len
            let fi int = 0
            for fi < nf {
                if (support.ms().fields[st + fi].is_pub != 0) {
                    if (if_puts("    pub ") != 0) { return -1 }
                } else {
                    if (if_puts("    ") != 0) { return -1 }
                }
                if (if_put_np(support.ms().fields[st + fi].name_off, support.ms().fields[st + fi].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().fields[st + fi].type_id, tname_base) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                fi += 1
            }
            if (if_puts("}\n") != 0) { return -1 }
        } else if (support.ms().names[ti].form == 3) {
            if ((support.ms().names[ti].attrs & token.ATTR_EXTERN) != 0
                && if_puts("@[extern]\n") != 0) { return -1 }
            if (if_puts("pub enum ") != 0) { return -1 }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" {\n") != 0) { return -1 }
            // 成员 = 类型为该枚举的全局常量（本模块登记的）
            let si int = sym_base
            for si < support.ms().sym_n {
                if (support.ms().syms[si].kind == gen.SYM_CONST && support.ms().syms[si].type_id == tid
                    && (support.ms().syms[si].flags & gen.F_EXTERN) == 0) {
                    if (if_puts("    ") != 0) { return -1 }
                    if (if_put_np(support.ms().syms[si].name_off, support.ms().syms[si].name_len) != 0) { return -1 }
                    if (if_puts(" = ") != 0) { return -1 }
                    if (if_puti(support.ms().syms[si].cval.to_type(int)) != 0) { return -1 }
                    if (if_puts(";\n") != 0) { return -1 }
                }
                si += 1
            }
            if (if_puts("}\n") != 0) { return -1 }
        } else {
            // type 别名
            if (if_puts("pub type ") != 0) { return -1 }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" = ") != 0) { return -1 }
            if (if_emit_type(tid, tname_base) != 0) { return -1 }
            if (if_puts(";\n") != 0) { return -1 }
        }
        ti += 1
    }
    // 值符号：fn / const / let
    let si2 int = sym_base
    for si2 < support.ms().sym_n {
        let fl int = support.ms().syms[si2].flags
        if ((fl & gen.F_PUB) == 0
            || ((fl & gen.F_EXTERN) != 0 && (fl & gen.F_CABI) == 0)) {
            si2 += 1
            continue
        }
        if (support.ms().syms[si2].kind == gen.SYM_FN) {
            // 类型化变参/裸变参不导出（前者为模块私有便利，后者仅 prelude）
            let ftid int = support.ms().syms[si2].type_id
            let sig int = support.ms().types[ftid].sub
            if (support.ms().sig_vararg[sig] != 0) {
                return gen.sem_err("变参函数不能导出为 pub")
            }
            let has_cabi int = ((fl & gen.F_CABI) != 0).to_type(int)
            if ((fl & (gen.F_CABI | gen.F_INLINE | gen.F_NORETURN
                    | gen.F_COMPTIME)) != 0) {
                if (if_puts("@[") != 0) { return -1 }
                let wrote int = 0
                if (has_cabi != 0) {
                    if (if_puts("extern") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & gen.F_INLINE) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("inline") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & gen.F_NORETURN) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("noreturn") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & gen.F_COMPTIME) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("comptime") != 0) { return -1 }
                }
                if (if_puts("]\n") != 0) { return -1 }
            }
            if (if_puts("pub fn ") != 0) { return -1 }
            if (if_put_np(support.ms().syms[si2].name_off, support.ms().syms[si2].name_len) != 0) { return -1 }
            if (if_put('(') != 0) { return -1 }
            let np2 int = support.ms().sig_np[sig]
            let i int = 0
            for i < np2 {
                if (i > 0) {
                    if (if_puts(", ") != 0) { return -1 }
                }
                if (if_puts("p") != 0) { return -1 }
                if (if_puti(i) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().sig_params[support.ms().sig_first[sig] + i], tname_base) != 0) { return -1 }
                i += 1
            }
            if (if_puts(") ") != 0) { return -1 }
            if (if_emit_type(support.ms().sig_ret[sig], tname_base) != 0) { return -1 }
            if (has_cabi != 0) {
                if (if_puts(";\n") != 0) { return -1 }
            } else if (if_puts(" { }\n") != 0) { return -1 }
        } else if (support.ms().syms[si2].kind == gen.SYM_CONST) {
            // enum 成员常量已随 pub enum 体导出（成员行），这里跳过——
            // 否则接口里重复登记，加载侧报重定义。
            if (support.ms().types[support.ms().syms[si2].type_id].kind == gen.TY_ENUM) {
                si2 += 1
                continue
            }
            // 聚合常量（结构体/定长数组/切片）：按**初始化式源文本**重放声明
            // （const_expr_kind = 4），导入侧按模块模式重新解析：编译期建模、
            // 运行期在导入方物化本单元副本（本地数据标签，见 em_data_symbol_header）。
            // 与 .s.ct 闭包的聚合常量重放共用同一份源文本。
            let ck3 int = support.ms().types[support.ms().syms[si2].type_id].kind
            if (ck3 == gen.TY_STRUCT || ck3 == gen.TY_ARRAY
                    || ck3 == gen.TY_SLICE) {
                let ck4 int = support.ms().syms[si2].const_expr_kind
                if ((ck4 != 4 && ck4 != 5)
                    || support.ms().syms[si2].const_expr_len <= 0) {
                    return gen.sem_err("pub 聚合常量暂只支持字面量或 $ 调用初始化式导出")
                }
                if (if_puts("pub const ") != 0) { return -1 }
                if (if_put_np(support.ms().syms[si2].name_off,
                        support.ms().syms[si2].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) {
                    return -1
                }
                if (if_puts(" = ") != 0) { return -1 }
                if (iface_emit_pub_agg_src(si2) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                si2 += 1
                continue
            }
            if ((fl & gen.F_ADDR) != 0) {
                // 字符串字面量指针常量：原样重放声明（含引号与转义），导入方按
                // 与函数体内字面量相同的规则重新登记只读字节池。
                // 引用式（`pub const A *char = B;`）由共用追链函数追到最终字面式。
                let lit_off int = 0
                let lit_len int = 0
                if (gen.sym_ct_lit_text(si2, &lit_off, &lit_len) != 0 || lit_len < 2) {
                    return gen.sem_err("pub 指针常量（字符串）暂不支持跨模块导出")
                }
                if (if_puts("pub const ") != 0) { return -1 }
                if (if_put_np(support.ms().syms[si2].name_off,
                        support.ms().syms[si2].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) { return -1 }
                if (if_puts(" = ") != 0) { return -1 }
                if (if_put_np(lit_off, lit_len) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                si2 += 1
                continue
            }
            if (if_puts("pub const ") != 0) { return -1 }
            if (if_put_np(support.ms().syms[si2].name_off, support.ms().syms[si2].name_len) != 0) { return -1 }
            if (if_put(' ') != 0) { return -1 }
            if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) { return -1 }
            if (if_puts(" = ") != 0) { return -1 }
            // 值文本与 .s.ct 闭包共用：按声明宽度输出（窄化到宿主 int 会把
            // u32 的 0xfeedfacf 打成负数、把 0x80000000 打成空的负号）
            if (iface_emit_const_value(si2) != 0) { return -1 }
            if (if_puts(";\n") != 0) { return -1 }
        } else if (support.ms().syms[si2].kind == gen.SYM_VAR) {
            // 2026-10-02「let 不导出」：可变全局不再跨模块导出，接口停发
            // pub let 行；编译器状态经 gen.task()/support.stats() 窄口访问。
        }
        si2 += 1
    }
    // 先写同目录临时文件，再 rename 发布完整接口；依赖调度器以文件出现
    // 作为 InterfaceReady 信号，不能让读取方看到半份接口。
    let flg int = 0x241
    if (support.tg_host_darwin() != 0) {
        flg = 0x601
    }
    let tmp [700]u8
    let tn int = 0
    tn = support.append_str(tmp, tn, path)
    tn = support.append_str(tmp, tn, ".tmp.")
    tn = support.append_int(tmp, tn, getpid())
    tmp[tn] = 0
    let fd int = open(support.arr_cstr(tmp), flg, 0x1a4)
    if (fd < 0) {
        return support.fail_path("无法创建接口文件: ", path)
    }
    let write_rc int = support.write_all(fd, if_buf, if_len)
    let close_rc int = close(fd)
    if (write_rc != 0 || close_rc != 0) {
        unlink(support.arr_cstr(tmp))
        return support.fail_path("写接口文件失败: ", path)
    }
    if (rename(support.arr_cstr(tmp), path) != 0) {
        unlink(support.arr_cstr(tmp))
        return support.fail_path("发布接口文件失败: ", path)
    }
    return 0
}

// —— 接口加载 ——

// —— 接口头行契约 ——
// 头行：// yh-iface v<N> arch=<arch> suffix=<符号后缀>
// 版本与架构都是**数据**：读取端按区间 [IFACE_VERSION_MIN, IFACE_VERSION_MAX]
// 与当前目标架构校验，写入端从同一组常量取值。此前用三条硬编码字面量加
// 手写长度 33 比对：新增版本要同时改四处，架构则永远写着 arm64。
const IFACE_HEAD_PREFIX *char = "// yh-iface v"
const IFACE_HEAD_ARCH *char = " arch="
const IFACE_HEAD_SUFFIX *char = " suffix="
const CTIFACE_HEAD_PREFIX *char = "// yh-ctiface v"
pub const IFACE_VERSION_MIN int = 1
pub const IFACE_VERSION_MAX int = 3
pub const CTIFACE_VERSION int = 1

// iface_lit_at：src[0..n) 从 pos 起是否以 lit 开头（越界即不匹配）。
fn iface_lit_at(src *u8, n int, pos int, lit *char) int {
    let k int = 0
    for lit[k] != 0 {
        if (pos + k >= n || src[pos + k] != lit[k].to_type(u8)) {
            return 0
        }
        k += 1
    }
    return 1
}

// iface_arch_at：src[0..n) 从 pos 起的架构标记是否与当前目标一致；
// 一致返回标记之后的位置，否则 -1。
fn iface_arch_at(src *u8, n int, pos int) int {
    let want *char = support.target_arch_token()
    let wlen int = support.cstr_len(want)
    let k int = 0
    for k < wlen {
        if (pos + k >= n || src[pos + k] != want[k].to_type(u8)) {
            return -1
        }
        k += 1
    }
    return pos + wlen
}

// iface_head_prefix_len：校验 .s.i 头前缀（版本区间 + 目标架构），
// 成功返回 suffix 起点，失败返回 -1。
fn iface_head_prefix_len() int {
    let t *gen.TaskCtx = gen.task()
    return iface_head_prefix_len_at(support.src_ctx().data, support.src_ctx().length)
}

// iface_head_prefix_len_at：纯函数版本（src + 长度），供内嵌测试直接构造输入。
fn iface_head_prefix_len_at(src *u8, n int) int {
    if (iface_lit_at(src, n, 0, IFACE_HEAD_PREFIX) == 0) { return -1 }
    let i int = support.cstr_len(IFACE_HEAD_PREFIX)
    let ver int = 0
    let digits int = 0
    for i < n {
        if (src[i] < '0' || src[i] > '9') { break }
        ver = ver * 10 + src[i].to_type(int) - 48
        i += 1
        digits += 1
    }
    if (digits == 0 || ver < IFACE_VERSION_MIN || ver > IFACE_VERSION_MAX) {
        return -1
    }
    if (iface_lit_at(src, n, i, IFACE_HEAD_ARCH) == 0) { return -1 }
    i = iface_arch_at(src, n, i + support.cstr_len(IFACE_HEAD_ARCH))
    if (i < 0) { return -1 }
    if (iface_lit_at(src, n, i, IFACE_HEAD_SUFFIX) == 0) { return -1 }
    return i + support.cstr_len(IFACE_HEAD_SUFFIX)
}

// iface_head_bad：头行不兼容的统一诊断（计一次错误并返回 -1）。
fn iface_head_bad(path *char) int {
    let t *gen.TaskCtx = gen.task()
    let buf [360]u8
    let n int = 0
    n = support.append_str_cap(buf, 360, n, "yh: 接口不兼容（头行须为 // yh-iface v")
    n = support.append_int_cap(buf, 360, n, IFACE_VERSION_MIN)
    n = support.append_str_cap(buf, 360, n, "..v")
    n = support.append_int_cap(buf, 360, n, IFACE_VERSION_MAX)
    n = support.append_str_cap(buf, 360, n, " arch=")
    n = support.append_str_cap(buf, 360, n, support.target_arch_token())
    n = support.append_str_cap(buf, 360, n, " suffix=）: ")
    n = support.append_str_cap(buf, 360, n, path)
    n = support.append_byte_cap(buf, 360, n, '\n')
    support.write_all(2, buf, n)
    support.diag().errors += 1
    return -1
}

// iface_header_suffix：校验头行并提取 suffix 到出参（入名字池）。
// c_src/c_src_len 为接口文件内容。成功 0；格式不符 -1（带诊断）。
fn iface_header_suffix(path *char, off *int, olen *int) int {
    let t *gen.TaskCtx = gen.task()
    let s int = iface_head_prefix_len()
    if (s < 0) {
        return iface_head_bad(path)
    }
    // suffix 到行尾
    let e int = s
    for e < support.src_ctx().length && support.src_ctx().data[e] != '\n' {
        e += 1
    }
    if (e == s) {
        support.diag().errors += 1
        let out2 [340]u8
        let on2 int = 0
        on2 = support.append_str(out2, on2, "yh: 接口头缺少 suffix: ")
        on2 = support.append_str(out2, on2, path)
        on2 = support.append_byte(out2, on2, '\n')
        support.write_all(2, out2, on2)
        return -1
    }
    let o int = support.tml_intern_str(support.src_ctx().data, s, e - s)
    if (o < 0) {
        return -1
    }
    off[0] = o
    olen[0] = e - s
    return 0
}

// iface_emit_pub_agg_src：输出聚合常量初始化式文本（.s.i 与 .s.ct 导出共用）。
// 字面量形态（const_expr_kind = 4）原样重放；$ 调用形态（kind = 5）把
// 同模块 `$fn` 重写为闭包隐藏名——导入方侧该函数只以隐藏符号登记，
// 重放文本按隐藏名解析才能命中正文。
fn iface_emit_pub_agg_src(sym_id int) int {
    let t *gen.TaskCtx = gen.task()
    if (support.ms().syms[sym_id].const_expr_kind == 4) {
        return if_put_np(support.ms().syms[sym_id].const_expr_off,
            support.ms().syms[sym_id].const_expr_len)
    }
    let off int = support.ms().syms[sym_id].const_expr_off
    let srclen int = support.ms().syms[sym_id].const_expr_len
    let cursor int = 0
    let i int = 0
    for i < srclen {
        if (support.pool_ctx().data[off + i] == 36 && i + 1 < srclen) {
            let j int = i + 1
            let c0 int = support.pool_ctx().data[off + j].to_type(int)
            if ((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
                let k int = j + 1
                for k < srclen {
                    let cc int = support.pool_ctx().data[off + k].to_type(int)
                    if ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90)
                        || (cc >= 97 && cc <= 122) || cc == 95) {
                        k += 1
                    } else {
                        break
                    }
                }
                let fnsym int = gen.sym_lookup_off(off + j, k - j)
                if (fnsym >= 0 && fnsym < support.ms().sym_n
                    && (support.ms().syms[fnsym].flags & gen.F_COMPTIME) != 0) {
                    if (if_put_np(off + cursor, i - cursor) != 0
                        || if_put('$') != 0) { return -1 }
                    let hidden_off int = -1
                    let hidden_len int = 0
                    if (iface_ct_name(fnsym, support.fs().sym_sfx_off,
                            support.fs().sym_sfx_len, &hidden_off, &hidden_len) != 0
                        || if_put_np(hidden_off, hidden_len) != 0) {
                        return -1
                    }
                    cursor = k
                    i = k
                    continue
                }
            }
        }
        i += 1
    }
    return if_put_np(off + cursor, srclen - cursor)
}

// iface_load：加载一份接口并登记为当前编译单元的导入模块。
// bind_off/len：导入绑定名（=模块名）。返回 ModInfo 下标；失败 -1。
pub fn iface_load(path *char, bind_off int, bind_len int) int {
    let t *gen.TaskCtx = gen.task()
    if (support.read_source(path) != 0) {
        return -1
    }
    let sfx_off int = -1
    let sfx_len int = 0
    if (iface_header_suffix(path, &sfx_off, &sfx_len) != 0) {
        return -1
    }
    let home int = support.fs().mod_home_next
    support.fs().mod_home_next += 1
    // 登记 ModInfo（ns 随后填充）
    if (support.fs().mod_n == support.fs().mod_cap) {
        let ncap int = support.fs().mod_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let nd *gen.ModInfo = malloc((ncap * sizeof(gen.ModInfo)).to_type(u64)).to_type(*gen.ModInfo)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.fs().mod_n > 0) {
            memcpy(nd, support.fs().mods, (support.fs().mod_n * sizeof(gen.ModInfo)).to_type(u64))
        }
        free(support.fs().mods)
        support.fs().mods = nd
        support.fs().mod_cap = ncap
    }
    let mi int = support.fs().mod_n
    support.fs().mods[mi].bind_off = bind_off
    support.fs().mods[mi].bind_len = bind_len
    support.fs().mods[mi].prefix_off = sfx_off
    support.fs().mods[mi].prefix_len = sfx_len
    support.fs().mods[mi].home = home
    support.fs().mods[mi].ns = 0
    support.fs().mods[mi].ns_n = 0
    support.fs().mods[mi].ns_cap = 0
    support.fs().mod_n += 1
    // 正文按 yh 源码登记：pass1 + pass2a（折叠常量；c_iface_load 抑制发射）
    token.ctx().count = 0
    token.ctx().pos = 0
    support.session().compile = 1
    support.session().pass = 1
    support.session().iface_load = 1
    let sym_base int = support.ms().sym_n
    let tname_base int = support.ms().name_n
    if (lex.lex_all() != 0) {
        support.session().iface_load = 0
        return -1
    }
    if (mod_parse_head() != 0) {
        support.session().iface_load = 0
        return -1
    }
    if (parse_source() != 0) {
        support.session().iface_load = 0
        return -1
    }
    if (support.diag().errors > 0) {
        support.session().iface_load = 0
        return -1
    }
    token.ctx().pos = 0
    support.session().pass = 2
    if (parse_source_globals() != 0) {
        support.session().iface_load = 0
        return -1
    }
    if (support.diag().errors > 0) {
        support.session().iface_load = 0
        return -1
    }
    support.session().iface_load = 0
    // ns 登记 + 名字改写（短名 → 短名+后缀；类型名同样改写避免冲突）
    let si int = sym_base
    for si < support.ms().sym_n {
        if ((support.ms().syms[si].flags & gen.F_PUB) == 0) {
            si += 1
            continue
        }
        if (mod_ns_add(mi, support.ms().syms[si].name_off, support.ms().syms[si].name_len, si, -1) != 0) {
            return -1
        }
        if ((support.ms().syms[si].flags & gen.F_CABI) == 0
            && sym_mangle(si, sfx_off, sfx_len) != 0) {
            return -1
        }
        support.ms().syms[si].flags |= gen.F_EXTERN
        if ((support.ms().syms[si].flags & gen.F_CABI) == 0) {
            support.ms().syms[si].flags |= gen.F_MODULE_IMPORT
        }
        si += 1
    }
    let ti int = tname_base
    for ti < support.ms().name_n {
        if (support.ms().home[support.ms().names[ti].type_id] < 0) {
            support.ms().home[support.ms().names[ti].type_id] = home
        }
        if (mod_ns_add(mi, support.ms().names[ti].name_off, support.ms().names[ti].name_len, -1, support.ms().names[ti].type_id) != 0) {
            return -1
        }
        if (tname_mangle(ti, sfx_off, sfx_len) != 0) {
            return -1
        }
        ti += 1
    }
    // 恢复编译状态（调用方继续编译本模块源文件）
    token.ctx().count = 0
    token.ctx().pos = 0
    return mi
}

// mod_ns_add：向 ModInfo 追加导出名条目。
fn mod_ns_add(mi int, name_off int, name_len int, sym int, tid int) int {
    let t *gen.TaskCtx = gen.task()
    if (support.fs().mods[mi].ns_n == support.fs().mods[mi].ns_cap) {
        let ncap int = support.fs().mods[mi].ns_cap * 2
        if (ncap == 0) {
            ncap = 16
        }
        let nd *gen.ModNsEnt = malloc((ncap * sizeof(gen.ModNsEnt)).to_type(u64)).to_type(*gen.ModNsEnt)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.fs().mods[mi].ns_n > 0) {
            memcpy(nd, support.fs().mods[mi].ns, (support.fs().mods[mi].ns_n * sizeof(gen.ModNsEnt)).to_type(u64))
        }
        free(support.fs().mods[mi].ns)
        support.fs().mods[mi].ns = nd
        support.fs().mods[mi].ns_cap = ncap
    }
    let e int = support.fs().mods[mi].ns_n
    support.fs().mods[mi].ns[e].name_off = name_off
    support.fs().mods[mi].ns[e].name_len = name_len
    support.fs().mods[mi].ns[e].sym = sym
    support.fs().mods[mi].ns[e].tid = tid
    support.fs().mods[mi].ns_n += 1
    return 0
}

// sym_mangle：把符号名改写为「短名+后缀」。
fn sym_mangle(si int, sfx_off int, sfx_len int) int {
    let t *gen.TaskCtx = gen.task()
    let nlen int = support.ms().syms[si].name_len + sfx_len
    let tmp [512]u8
    if (nlen > 500) {
        return support.fail("符号名过长")
    }
    let n int = 0
    let i int = 0
    for i < support.ms().syms[si].name_len {
        tmp[n] = support.pool_ctx().data[support.ms().syms[si].name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < sfx_len {
        tmp[n] = support.pool_ctx().data[sfx_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(tmp, 0, n)
    if (off < 0) {
        return -1
    }
    support.ms().syms[si].name_off = off
    support.ms().syms[si].name_len = n
    return 0
}

// tname_mangle：类型名同样改写（避免与使用者同名类型冲突）。
fn tname_mangle(ti int, sfx_off int, sfx_len int) int {
    let t *gen.TaskCtx = gen.task()
    let nlen int = support.ms().names[ti].name_len + sfx_len
    let tmp [512]u8
    if (nlen > 500) {
        return support.fail("类型名过长")
    }
    let n int = 0
    let i int = 0
    for i < support.ms().names[ti].name_len {
        tmp[n] = support.pool_ctx().data[support.ms().names[ti].name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < sfx_len {
        tmp[n] = support.pool_ctx().data[sfx_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(tmp, 0, n)
    if (off < 0) {
        return -1
    }
    support.ms().names[ti].name_off = off
    support.ms().names[ti].name_len = n
    return 0
}

// yh test 内建测试：头行契约的版本区间与目标架构校验。
// 纯函数入口让测试直接构造字节序列，不必改动会话状态。
test "iface 头行版本区间与目标架构" {
    let buf [64]u8
    let n int = 0
    n = support.append_str(&buf[0], n, IFACE_HEAD_PREFIX)
    n = support.append_byte(&buf[0], n, '3')
    n = support.append_str(&buf[0], n, IFACE_HEAD_ARCH)
    let arch *char = support.target_arch_token()
    n = support.append_str(&buf[0], n, arch)
    n = support.append_str(&buf[0], n, IFACE_HEAD_SUFFIX)
    n = support.append_byte(&buf[0], n, 'x')
    n = support.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    $assert(iface_head_prefix_len_at(&buf[0], n) > 0)

    // 版本 0 与 4 都在 [1,3] 之外。
    let vpos int = support.cstr_len(IFACE_HEAD_PREFIX)
    buf[vpos] = '0'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[vpos] = '4'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[vpos] = '3'

    // 目标架构不符（任意目标下都改首字节为 Z）。
    let apos int = vpos + 1 + support.cstr_len(IFACE_HEAD_ARCH)
    let keep u8 = buf[apos]
    buf[apos] = 'Z'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[apos] = keep

    // 截断到架构末尾（缺 " suffix="）与空输入。
    let cut int = apos + support.cstr_len(arch)
    $assert(iface_head_prefix_len_at(&buf[0], cut) < 0)
    $assert(iface_head_prefix_len_at(&buf[0], 0) < 0)
}

test "ctiface 头行版本必须为 1" {
    let buf [64]u8
    let n int = 0
    n = support.append_str(&buf[0], n, CTIFACE_HEAD_PREFIX)
    n = support.append_byte(&buf[0], n, '1')
    n = support.append_str(&buf[0], n, IFACE_HEAD_ARCH)
    n = support.append_str(&buf[0], n, support.target_arch_token())
    n = support.append_str(&buf[0], n, IFACE_HEAD_SUFFIX)
    n = support.append_byte(&buf[0], n, 'x')
    n = support.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    $assert(iface_ct_head_prefix_len_at(&buf[0], n) > 0)
    buf[support.cstr_len(CTIFACE_HEAD_PREFIX)] = '2'
    $assert(iface_ct_head_prefix_len_at(&buf[0], n) < 0)
}
