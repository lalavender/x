module cache

import gen
import hash

// ============================================================================
// cache_store.yh —— 全局内容寻址缓存（C4）
//
// 布局：
//   <root>/v1/actions/<ActionID>   输出角色 → OutputID 列表（二进制）
//   <root>/v1/outputs/<OutputID>   实际字节内容（按 SHA-256 去重）
//   <root>/v1/tmp/                 原子提交临时文件
//   <root>/v1/lock                 写入锁占位（真正的 flock 在 C6）
//
// 本文件只做路径、内容哈希、原子 put/get 与 action entry 编解码；不读项目表、
// 不决定哪些输入进键。读取失败/摘要不符/版本不符一律按 miss 返回 0，绝不把
// 损坏内容交给上层。
// ============================================================================

const CACHE_ACTION_MAGIC u64 = 0x3141435441485948 // "YHCACTA1" 的低 64 位近似
const CACHE_ACTION_VERSION u64 = 1
const CACHE_ACTION_ENTRY_BYTES int = 48 // role u64 + size u64 + id[32]
const CACHE_ACTION_HEAD_BYTES int = 24
pub const CACHE_ACTION_MAX_ENTRIES int = 16
pub const CACHE_ROOT_MAX int = 4096
const CACHE_IO_BUFFER int = 65536
const CACHE_READ_LIMIT int = 67108864 // 64 MiB：函数记录/模块对象足够

// CacheEntry：action entry 里的一个输出角色。
// id 是 OutputID 原始 32 字节；size 是发布时记录的字节数（已存在内容可能为 0，
// 读取端只把它当提示，不用于分配）。
pub struct CacheEntry {
    role int
    size u64
    id [CACHE_ID_SIZE]u8
}

// CacheStore：一次编译进程持有的全局缓存配置。
pub struct CacheStore {
    root [CACHE_ROOT_MAX]u8
    root_len int
    enabled int
    ready int
    max_size u64
}

// store_init：设置缓存根与开关；root 末尾斜杠会被去掉。0 = 成功。
pub fn store_init(store *CacheStore, root *char, enabled int, max_size u64) int {
    if (store == 0 || root == 0) { return -1 }
    let n int = strlen(root).to_type(int)
    if (n <= 0 || n + 1 > CACHE_ROOT_MAX) { return -1 }
    for n > 1 && root[n - 1] == '/' { n -= 1 }
    let i int = 0
    for i < n {
        store.root[i] = root[i].to_type(u8)
        i += 1
    }
    store.root[n] = 0
    store.root_len = n
    store.enabled = enabled != 0 ? 1 : 0
    store.ready = 1
    store.max_size = max_size
    return 0
}

// store_disable：显式关闭全局缓存；后续 put/get 全部按 miss 处理。
pub fn store_disable(store *CacheStore) void {
    if (store == 0) { return }
    store.enabled = 0
    store.ready = 1
    store.root_len = 0
}

// store_enabled：0 = 未启用（或未初始化）。
pub fn store_enabled(store *CacheStore) int {
    if (store == 0 || store.ready == 0 || store.enabled == 0
        || store.root_len <= 0) { return 0 }
    return 1
}

// store_task：取当前任务绑定的 CacheStore；未绑定返回 0。
// 指针由 build 在 mb_cache_init 写入 TaskCtx，ast/lower 因此无需 import build。
pub fn store_task() *CacheStore {
    let p *void = gen.task().cache_store
    if (p == 0) { return 0 }
    return p.to_type(*CacheStore)
}

// store_lookup：按 64 hex ActionID + role 从全局 action 读取输出内容，
// 内容经 OutputID 校验。1 = 命中（调用方 free），0 = miss/关闭。
pub fn store_lookup(store *CacheStore, action_hex *char, role int,
    out_data **u8, out_size *int) int {
    if (out_data != 0) { out_data[0] = 0 }
    if (out_size != 0) { out_size[0] = 0 }
    if (store_enabled(store) == 0 || action_hex == 0 || out_data == 0
        || out_size == 0) { return 0 }
    let action_id [CACHE_ID_SIZE]u8
    if (id_parse_hex(action_hex, &action_id[0]) != 0) { return 0 }
    let entries [4]CacheEntry
    let count int = 0
    if (store_action_get(store, &action_id[0], &entries[0], 4, &count) != 1) {
        return 0
    }
    let i int = 0
    for i < count {
        if (entries[i].role == role) {
            return store_get_bytes(store, &entries[i].id[0], out_data, out_size)
        }
        i += 1
    }
    return 0
}

// store_parse_size：解析 123、10G、512M、1T 形式（1024 进制，可选 B/iB）。
// 成功返回 0；非法或为 0 返回 -1。max_size 单位是字节。
pub fn store_parse_size(text *char, out_size *u64) int {
    if (text == 0 || out_size == 0) { return -1 }
    let i int = 0
    let value u64 = 0
    let digits int = 0
    for text[i] >= '0' && text[i] <= '9' {
        if (value > 9000000000000000000) { return -1 }
        value = value * 10 + (text[i] - '0').to_type(u64)
        digits += 1
        i += 1
    }
    if (digits == 0) { return -1 }
    let factor u64 = 1
    let c char = text[i]
    if (c == 'k' || c == 'K') { factor = 1024; i += 1 }
    if (c == 'm' || c == 'M') { factor = 1048576; i += 1 }
    if (c == 'g' || c == 'G') { factor = 1073741824; i += 1 }
    if (c == 't' || c == 'T') { factor = 1099511627776; i += 1 }
    if (text[i] == 'i' || text[i] == 'I') { i += 1 }
    if (text[i] == 'b' || text[i] == 'B') { i += 1 }
    if (text[i] != 0) { return -1 }
    if (value == 0) { return -1 }
    out_size[0] = value * factor
    return 0
}

// cs_open_out：以宿主正确的覆盖写旗标打开文件；失败返回 -1。
fn cs_open_out(path *char) int {
    let flg int = 0x241
    if (gen.tg_host_darwin() != 0) { flg = 0x601 }
    return open(path, flg, 0x1a4)
}

// cs_copy_text：把 text 追加到 out，超容量返回 -1（不静默截断）。
fn cs_copy_text(out *u8, n *int, capacity int, text *char) int {
    let i int = 0
    for text[i] != 0 {
        if (n[0] + 1 >= capacity) { return -1 }
        out[n[0]] = text[i].to_type(u8)
        n[0] += 1
        i += 1
    }
    return 0
}

// cs_build_path：root + "/" + a + "/" + b（b 可为 0）；成功写 NUL。
fn cs_build_path(store *CacheStore, a *char, b *char, out *u8,
    capacity int) int {
    if (store == 0 || out == 0 || capacity <= 1) { return -1 }
    let n int = 0
    let i int = 0
    for i < store.root_len {
        if (n + 1 >= capacity) { return -1 }
        out[n] = store.root[i]
        n += 1
        i += 1
    }
    if (cs_copy_text(out, &n, capacity, "/v1/") != 0) { return -1 }
    if (cs_copy_text(out, &n, capacity, a) != 0) { return -1 }
    if (b != 0) {
        if (cs_copy_text(out, &n, capacity, "/") != 0) { return -1 }
        if (cs_copy_text(out, &n, capacity, b) != 0) { return -1 }
    }
    out[n] = 0
    return 0
}

// cs_id_hex：把 OutputID 写成 64 位十六进制到 out[65]。
fn cs_id_hex(id *u8, out *u8) int {
    return hash.sha256_hex(id, out)
}

// store_output_path：<root>/v1/outputs/<id hex>。
pub fn store_output_path(store *CacheStore, id *u8, out *u8,
    capacity int) int {
    if (id == 0) { return -1 }
    let hex [CACHE_ID_TEXT]u8
    if (cs_id_hex(id, &hex[0]) != 0) { return -1 }
    return cs_build_path(store, "outputs", gen.arr_cstr(&hex[0]), out, capacity)
}

// store_action_path：<root>/v1/actions/<id hex>。
pub fn store_action_path(store *CacheStore, id *u8, out *u8,
    capacity int) int {
    if (id == 0) { return -1 }
    let hex [CACHE_ID_TEXT]u8
    if (cs_id_hex(id, &hex[0]) != 0) { return -1 }
    return cs_build_path(store, "actions", gen.arr_cstr(&hex[0]), out, capacity)
}

// store_tmp_path：<root>/v1/tmp/<name>；调用方保证 name 唯一。
fn store_tmp_path(store *CacheStore, name *char, out *u8, capacity int) int {
    return cs_build_path(store, "tmp", name, out, capacity)
}

// cs_write_atomic：临时文件写完再 rename 到 path；0 = 成功。
fn cs_write_atomic(tmp *char, path *char, data *u8, size int) int {
    let fd int = cs_open_out(tmp)
    if (fd < 0) { return -1 }
    if (gen.write_all(fd, data, size) != 0 || close(fd) != 0) {
        unlink(tmp)
        return -1
    }
    if (rename(tmp, path) != 0) {
        unlink(tmp)
        return -1
    }
    return 0
}

// cs_read_file：读取整个文件；超过 limit 或打开失败返回 0（按 miss）。
// 成功返回 1 并交出 malloc 缓冲所有权。
fn cs_read_file(path *char, out_data **u8, out_size *int) int {
    out_data[0] = 0
    out_size[0] = 0
    let fd int = open(path, 0)
    if (fd < 0) { return 0 }
    let capacity int = 65536
    let data *u8 = malloc(capacity.to_type(u64)).to_type(*u8)
    if (data == 0) { close(fd); return 0 }
    let length int = 0
    for 1 {
        if (length == capacity) {
            if (capacity >= CACHE_READ_LIMIT) {
                free(data.to_type(*void))
                close(fd)
                return 0
            }
            let next_capacity int = capacity * 2
            if (next_capacity > CACHE_READ_LIMIT) { next_capacity = CACHE_READ_LIMIT }
            let next *u8 = malloc(next_capacity.to_type(u64)).to_type(*u8)
            if (next == 0) {
                free(data.to_type(*void))
                close(fd)
                return 0
            }
            memcpy(next, data, length.to_type(u64))
            free(data.to_type(*void))
            data = next
            capacity = next_capacity
        }
        let got i64 = read(fd, data + length, (capacity - length).to_type(u64))
        if (got < 0) {
            free(data.to_type(*void))
            close(fd)
            return 0
        }
        if (got == 0) { break }
        length += got.to_type(int)
    }
    close(fd)
    out_data[0] = data
    out_size[0] = length
    return 1
}

// store_lock：打开全局 cache 写锁并取独占 flock；失败返回 -1（调用方按
// 缓存写失败处理，不影响构建）。调用方必须配对 store_unlock。
fn store_lock(store *CacheStore) int {
    if (store_enabled(store) == 0) { return -1 }
    let path [CACHE_ROOT_MAX + 64]u8
    if (cs_build_path(store, "lock", 0, &path[0], CACHE_ROOT_MAX + 64) != 0) {
        return -1
    }
    let fd int = cs_open_out(gen.arr_cstr(&path[0]))
    if (fd < 0) { return -1 }
    if (cache_lock_file(fd) != 0) {
        close(fd)
        return -1
    }
    return fd
}

// store_unlock：释放 store_lock 的 fd；-1 是空操作。
fn store_unlock(fd int) void {
    if (fd < 0) { return }
    cache_unlock_file(fd)
    close(fd)
}

// store_begin_write / store_end_write：给 build 侧 clean/trim 使用的写锁窄口。
pub fn store_begin_write(store *CacheStore) int {
    return store_lock(store)
}

pub fn store_end_write(fd int) void {
    store_unlock(fd)
}

// cs_file_matches：已存在的输出文件摘要是否等于预期；读失败按不匹配。
fn cs_file_matches(path *char, digest *u8) int {
    let current [CACHE_ID_SIZE]u8
    if (hash.sha256_file(path, &current[0]) != 0) { return 0 }
    let i int = 0
    for i < CACHE_ID_SIZE {
        if (current[i] != digest[i]) { return 0 }
        i += 1
    }
    return 1
}

// store_put_bytes：把 bytes 写成 OutputID；已存在相同内容时直接返回。
// 0 = 成功，-1 = 参数/IO 失败（调用方按缓存写失败处理，不影响构建）。
pub fn store_put_bytes(store *CacheStore, data *u8, size int, out_id *u8,
    out_size *u64) int {
    if (store_enabled(store) == 0 || data == 0 || size < 0 || out_id == 0
        || out_size == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_digest(data, size.to_type(u64), &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_SIZE {
        out_id[i] = digest[i]
        i += 1
    }
    out_size[0] = size.to_type(u64)
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, &digest[0], &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    if (cs_file_exists(gen.arr_cstr(&path[0])) != 0
        && cs_file_matches(gen.arr_cstr(&path[0]), &digest[0]) != 0) {
        return 0
    }
    let name [128]u8
    let n int = 0
    n = gen.append_str(&name[0], n, "put-")
    n = gen.append_int(&name[0], n, getpid())
    n = gen.append_byte(&name[0], n, '-')
    let hex [CACHE_ID_TEXT]u8
    hash.sha256_hex(&digest[0], &hex[0])
    n = gen.append_str_limit(&name[0], n, 64, gen.arr_cstr(&hex[0]))
    name[n] = 0
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, gen.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) { return -1 }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) { return -1 }
    // 等锁期间别的进程可能已发布同一内容；再次校验避免重复写。
    if (cs_file_exists(gen.arr_cstr(&path[0])) != 0
        && cs_file_matches(gen.arr_cstr(&path[0]), &digest[0]) != 0) {
        store_unlock(lock_fd)
        return 0
    }
    let rc int = cs_write_atomic(gen.arr_cstr(&tmp[0]), gen.arr_cstr(&path[0]),
        data, size)
    store_unlock(lock_fd)
    return rc
}

// cs_file_exists：缓存层不 import proj，用 open 探针判断输出是否已存在。
fn cs_file_exists(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) { return 0 }
    close(fd)
    return 1
}

// store_put_file：按文件内容发布输出；成功写 out_id 与 out_size（内容已存在时
// out_size 可能为 0，读取端不依赖它）。0 = 成功，-1 = 失败。
pub fn store_put_file(store *CacheStore, path *char, out_id *u8,
    out_size *u64) int {
    if (store_enabled(store) == 0 || path == 0 || out_id == 0
        || out_size == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_file(path, &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_SIZE {
        out_id[i] = digest[i]
        i += 1
    }
    out_size[0] = 0
    let opath [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, &digest[0], &opath[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    if (cs_file_exists(gen.arr_cstr(&opath[0])) != 0
        && cs_file_matches(gen.arr_cstr(&opath[0]), &digest[0]) != 0) {
        return 0
    }
    let name [160]u8
    let n int = 0
    n = gen.append_str(&name[0], n, "put-file-")
    n = gen.append_int(&name[0], n, getpid())
    n = gen.append_byte(&name[0], n, '-')
    let hex [CACHE_ID_TEXT]u8
    hash.sha256_hex(&digest[0], &hex[0])
    n = gen.append_str_limit(&name[0], n, 32, gen.arr_cstr(&hex[0]))
    name[n] = 0
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, gen.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) { return -1 }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) { return -1 }
    if (cs_file_exists(gen.arr_cstr(&opath[0])) != 0
        && cs_file_matches(gen.arr_cstr(&opath[0]), &digest[0]) != 0) {
        store_unlock(lock_fd)
        return 0
    }
    let fd_in int = open(path, 0)
    if (fd_in < 0) { store_unlock(lock_fd); return -1 }
    let fd_out int = cs_open_out(gen.arr_cstr(&tmp[0]))
    if (fd_out < 0) { close(fd_in); store_unlock(lock_fd); return -1 }
    let buffer *u8 = malloc(CACHE_IO_BUFFER.to_type(u64)).to_type(*u8)
    if (buffer == 0) {
        close(fd_in)
        close(fd_out)
        unlink(gen.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    let total u64 = 0
    for 1 {
        let got i64 = read(fd_in, buffer, CACHE_IO_BUFFER.to_type(u64))
        if (got < 0) {
            free(buffer.to_type(*void))
            close(fd_in)
            close(fd_out)
            unlink(gen.arr_cstr(&tmp[0]))
            store_unlock(lock_fd)
            return -1
        }
        if (got == 0) { break }
        if (gen.write_all(fd_out, buffer, got.to_type(int)) != 0) {
            free(buffer.to_type(*void))
            close(fd_in)
            close(fd_out)
            unlink(gen.arr_cstr(&tmp[0]))
            store_unlock(lock_fd)
            return -1
        }
        total += got.to_type(u64)
    }
    free(buffer.to_type(*void))
    close(fd_in)
    if (close(fd_out) != 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    if (rename(gen.arr_cstr(&tmp[0]), gen.arr_cstr(&opath[0])) != 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    out_size[0] = total
    store_unlock(lock_fd)
    return 0
}

// store_get_file：把 OutputID 复制到 dest；复制时重算摘要，损坏按 miss。
// 1 = 成功，0 = 缺失/摘要不符，-1 = 参数/本地写失败。
pub fn store_get_file(store *CacheStore, id *u8, dest *char) int {
    if (store_enabled(store) == 0 || id == 0 || dest == 0) { return -1 }
    let src [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, id, &src[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    let fd_in int = open(gen.arr_cstr(&src[0]), 0)
    if (fd_in < 0) { return 0 }
    let tmp [CACHE_ROOT_MAX + 256]u8
    let tn int = 0
    tn = gen.append_str(&tmp[0], 0, dest)
    tn = gen.append_str(&tmp[0], tn, ".yh-cache-tmp.")
    tn = gen.append_int(&tmp[0], tn, getpid())
    tmp[tn] = 0
    let fd_out int = cs_open_out(gen.arr_cstr(&tmp[0]))
    if (fd_out < 0) { close(fd_in); return -1 }
    let buffer *u8 = malloc(CACHE_IO_BUFFER.to_type(u64)).to_type(*u8)
    if (buffer == 0) {
        close(fd_in)
        close(fd_out)
        unlink(gen.arr_cstr(&tmp[0]))
        return -1
    }
    let sha hash.Sha256
    hash.sha256_init(&sha)
    let ok int = 1
    for 1 {
        let got i64 = read(fd_in, buffer, CACHE_IO_BUFFER.to_type(u64))
        if (got < 0) { ok = 0; break }
        if (got == 0) { break }
        if (hash.sha256_update(&sha, buffer, got.to_type(u64)) != 0
            || gen.write_all(fd_out, buffer, got.to_type(int)) != 0) {
            ok = 0
            break
        }
    }
    free(buffer.to_type(*void))
    close(fd_in)
    if (close(fd_out) != 0) { ok = 0 }
    let digest [CACHE_ID_SIZE]u8
    if (ok != 0 && hash.sha256_final(&sha, &digest[0]) != 0) { ok = 0 }
    if (ok != 0) {
        let i int = 0
        for i < CACHE_ID_SIZE {
            if (digest[i] != id[i]) { ok = 0; break }
            i += 1
        }
    }
    if (ok == 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        return 0
    }
    if (rename(gen.arr_cstr(&tmp[0]), dest) != 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        return -1
    }
    return 1
}

// store_get_bytes：读取 OutputID 到 malloc 缓冲并校验摘要。
// 1 = 成功（调用方 free），0 = 缺失/损坏/超限。
pub fn store_get_bytes(store *CacheStore, id *u8, out_data **u8,
    out_size *int) int {
    if (store_enabled(store) == 0 || id == 0 || out_data == 0
        || out_size == 0) { return 0 }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return 0
    }
    if (cs_read_file(gen.arr_cstr(&path[0]), out_data, out_size) == 0) {
        return 0
    }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_digest(out_data[0], out_size[0].to_type(u64), &digest[0]) != 0) {
        free(out_data[0].to_type(*void))
        out_data[0] = 0
        out_size[0] = 0
        return 0
    }
    let i int = 0
    for i < CACHE_ID_SIZE {
        if (digest[i] != id[i]) {
            free(out_data[0].to_type(*void))
            out_data[0] = 0
            out_size[0] = 0
            return 0
        }
        i += 1
    }
    return 1
}

// cs_put_u64 / cs_get_u64：action entry 的小端 64 位字。
fn cs_put_u64(data *u8, cursor *int, value u64) void {
    let i int = 0
    for i < 8 {
        data[cursor[0]] = ((value >> (i * 8)) & 255).to_type(u8)
        cursor[0] += 1
        i += 1
    }
}

fn cs_get_u64(data *u8, cursor *int) u64 {
    let value u64 = 0
    let i int = 0
    for i < 8 {
        value = value | (data[cursor[0]].to_type(u64) << (i * 8))
        cursor[0] += 1
        i += 1
    }
    return value
}

// store_action_put：原子写 ActionID → 输出角色表；0 = 成功，-1 = 失败。
pub fn store_action_put(store *CacheStore, action_id *u8,
    entries *CacheEntry, count int) int {
    if (store_enabled(store) == 0 || action_id == 0 || entries == 0
        || count <= 0 || count > CACHE_ACTION_MAX_ENTRIES) { return -1 }
    let size int = CACHE_ACTION_HEAD_BYTES + count * CACHE_ACTION_ENTRY_BYTES
    let data *u8 = malloc(size.to_type(u64)).to_type(*u8)
    if (data == 0) { return -1 }
    let cursor int = 0
    cs_put_u64(data, &cursor, CACHE_ACTION_MAGIC)
    cs_put_u64(data, &cursor, CACHE_ACTION_VERSION)
    cs_put_u64(data, &cursor, count.to_type(u64))
    let i int = 0
    for i < count {
        cs_put_u64(data, &cursor, entries[i].role.to_type(u64))
        cs_put_u64(data, &cursor, entries[i].size)
        let j int = 0
        for j < CACHE_ID_SIZE {
            data[cursor] = entries[i].id[j]
            cursor += 1
            j += 1
        }
        i += 1
    }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_action_path(store, action_id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        free(data.to_type(*void))
        return -1
    }
    let name [160]u8
    let n int = 0
    n = gen.append_str(&name[0], n, "action-")
    n = gen.append_int(&name[0], n, getpid())
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, gen.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) {
        free(data.to_type(*void))
        return -1
    }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) {
        free(data.to_type(*void))
        return -1
    }
    let rc int = cs_write_atomic(gen.arr_cstr(&tmp[0]),
        gen.arr_cstr(&path[0]), data, size)
    store_unlock(lock_fd)
    free(data.to_type(*void))
    return rc
}

// store_action_get：读 ActionID → 输出角色表；1 = 命中，0 = 缺失/损坏。
// 输出角色顺序保持写入顺序；调用方按 role 查找。
pub fn store_action_get(store *CacheStore, action_id *u8,
    entries *CacheEntry, capacity int, out_count *int) int {
    if (out_count != 0) { out_count[0] = 0 }
    if (store_enabled(store) == 0 || action_id == 0 || entries == 0
        || capacity <= 0 || out_count == 0) { return 0 }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_action_path(store, action_id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return 0
    }
    let data *u8 = 0
    let size int = 0
    if (cs_read_file(gen.arr_cstr(&path[0]), &data, &size) == 0) { return 0 }
    let cursor int = 0
    if (size < CACHE_ACTION_HEAD_BYTES
        || cs_get_u64(data, &cursor) != CACHE_ACTION_MAGIC
        || cs_get_u64(data, &cursor) != CACHE_ACTION_VERSION) {
        free(data.to_type(*void))
        return 0
    }
    let count u64 = cs_get_u64(data, &cursor)
    if (count == 0 || count > CACHE_ACTION_MAX_ENTRIES.to_type(u64)
        || count > capacity.to_type(u64)
        || size != CACHE_ACTION_HEAD_BYTES
            + count.to_type(int) * CACHE_ACTION_ENTRY_BYTES) {
        free(data.to_type(*void))
        return 0
    }
    let i int = 0
    for i < count.to_type(int) {
        let role u64 = cs_get_u64(data, &cursor)
        if (role > 0x7FFFFFFF) { free(data.to_type(*void)); return 0 }
        entries[i].role = role.to_type(int)
        entries[i].size = cs_get_u64(data, &cursor)
        let j int = 0
        for j < CACHE_ID_SIZE {
            entries[i].id[j] = data[cursor]
            cursor += 1
            j += 1
        }
        i += 1
    }
    free(data.to_type(*void))
    out_count[0] = count.to_type(int)
    return 1
}
