module cache

import gen
import hash

// ============================================================================
// cache_key.yh —— 缓存键的统一 schema 与 ActionID/OutputID 编码（C0）
//
// 所有缓存 action（module/file/check/ir/link）共用同一套前置序列：
//   magic("yh-cache-key") + schema_version + action_kind + label
// 然后由调用方按各自审计过的顺序混入输入事实。序列一旦改变必须递增
// CACHE_SCHEMA_VERSION，旧缓存因键变化自然失效。
//
// ActionID = 32 字节 SHA-256 原始摘要；文本形式为 64 个小写十六进制字符。
// OutputID 与 ActionID 同宽同编码，由输出字节单独计算（C4 接入）。
// ============================================================================

// 键 schema 版本：C0 起使用 SHA-256 与长度分帧；+CacheInputs/相对路径时递增。
pub const CACHE_SCHEMA_VERSION int = 3
// ActionID/OutputID 的二进制与文本长度（后者含结尾零）。
pub const CACHE_ID_SIZE int = 32
pub const CACHE_ID_HEX int = 64
pub const CACHE_ID_TEXT int = 65

// action 种类：进入键前缀，避免不同缓存层复用同一组输入时互相误命中。
pub const ACTION_MODULE int = 1
pub const ACTION_FILE int = 2
pub const ACTION_CHECK int = 3
pub const ACTION_IR int = 4
pub const ACTION_LINK int = 5

// 输出角色：action entry 中的稳定分类（C4 写入，当前只定义）。
pub const OUTPUT_OBJECT int = 1
pub const OUTPUT_IFACE int = 2
pub const OUTPUT_CT_IFACE int = 3
pub const OUTPUT_CHECK int = 4
pub const OUTPUT_IR int = 5
pub const OUTPUT_SUPPORT int = 6

// Key：一次 action 键计算的流式状态；只能由 key_init 开始。
pub struct Key {
    sha hash.Sha256
}

// key_mix_u64：按小端八字节混入；调用方无需关心平台字节序。
pub fn key_mix_u64(key *Key, value u64) int {
    if (key == 0) { return -1 }
    let bytes [8]u8
    let i int = 0
    for i < 8 {
        bytes[i] = ((value >> (i * 8)) & 255).to_type(u8)
        i += 1
    }
    return hash.sha256_update(&key.sha, &bytes[0], 8)
}

// key_mix_int：把 int 的补码位型按小端八字节混入。
pub fn key_mix_int(key *Key, value int) int {
    return key_mix_u64(key, value.to_type(i64).to_type(u64))
}

// key_mix_bytes：先混入长度再混入字节，避免相邻字段拼接歧义。
pub fn key_mix_bytes(key *Key, data *u8, count int) int {
    if (key == 0 || count < 0 || (data == 0 && count > 0)) { return -1 }
    if (key_mix_u64(key, count.to_type(u64)) != 0) { return -1 }
    if (count == 0) { return 0 }
    return hash.sha256_update(&key.sha, data, count.to_type(u64))
}

// key_mix_text：混入 NUL 结尾文本（不含结尾零）；空指针返回 -1。
pub fn key_mix_text(key *Key, text *char) int {
    if (key == 0 || text == 0) { return -1 }
    return key_mix_bytes(key, text.to_type(*u8), strlen(text).to_type(int))
}

// key_init：写入统一 schema 前缀；0 = 成功。
pub fn key_init(key *Key, kind int, label *char) int {
    if (key == 0 || label == 0) { return -1 }
    hash.sha256_init(&key.sha)
    if (key_mix_text(key, "yh-cache-key") != 0) { return -1 }
    if (key_mix_int(key, CACHE_SCHEMA_VERSION) != 0) { return -1 }
    if (key_mix_int(key, kind) != 0) { return -1 }
    return key_mix_text(key, label)
}

// CacheInputs：函数语义键允许读取的目标/环境白名单。
// SDK、selfhost 闭包与工具链已先解析成内容身份，汇总在 env_key / 编译器身份里；
// 这里只保留 target、ABI、优化级别与 trimpath 这些直接影响代码或来源表的输入。
pub struct CacheInputs {
    target_key int
    pointer_bits int
    layout_version int
    abi *char
    opt_level int
    trimpath int
}

// key_init_function：函数 check/IR 键的公共前缀。
// env_key 是模块环境事实（依赖接口/目标/优化/编译器身份）的摘要；inputs 是
// CacheInputs 白名单；path 是项目相对源文件路径。action 由调用方区分 check 与
// IR（两者不复用同一记录）。
pub fn key_init_function(key *Key, action int, env_key u64,
    inputs *CacheInputs, path *char) int {
    if (inputs == 0) { return -1 }
    if (key_init(key, action, "function") != 0) { return -1 }
    if (key_mix_u64(key, env_key) != 0) { return -1 }
    if (key_mix_int(key, inputs.target_key) != 0) { return -1 }
    if (key_mix_int(key, inputs.pointer_bits) != 0) { return -1 }
    if (key_mix_int(key, inputs.layout_version) != 0) { return -1 }
    if (key_mix_text(key, inputs.abi) != 0) { return -1 }
    if (key_mix_int(key, inputs.opt_level) != 0) { return -1 }
    if (key_mix_int(key, inputs.trimpath) != 0) { return -1 }
    return key_mix_text(key, path)
}

// key_mix_file：把文件内容摘要（SHA-256）混入键；文件缺失返回 -1。
// 用摘要而不是整文件字节，避免键计算路径把大文件常驻内存；摘要本身已
// 由流式 SHA-256 计算。
pub fn key_mix_file(key *Key, path *char) int {
    if (key == 0 || path == 0) { return -1 }
    let digest [32]u8
    if (hash.sha256_file(path, &digest[0]) != 0) { return -1 }
    return key_mix_bytes(key, &digest[0], 32)
}

// key_mix_tokens：把一段词法 token（种类 + 长度 + 源字节）混入键。
// 词法器已剥离注释/空白，因此注释变化不会让函数/文件键失效。
// 0 = 成功，-1 = 范围非法（该函数跳过缓存）。
pub fn key_mix_tokens(key *Key, source *u8, source_len int,
    tokens *gen.Tok, token_count int, first int, after int) int {
    if (key == 0 || source == 0 || tokens == 0 || source_len < 0
        || token_count < 0 || first < 0 || after <= first
        || after > token_count) { return -1 }
    if (key_mix_int(key, after - first) != 0) { return -1 }
    let i int = first
    for i < after {
        let tok gen.Tok = tokens[i]
        if (tok.start < 0 || tok.len < 0 || tok.start + tok.len > source_len) {
            return -1
        }
        if (key_mix_int(key, tok.kind) != 0) { return -1 }
        if (key_mix_u64(key, tok.len.to_type(u64)) != 0) { return -1 }
        if (tok.len > 0
            && hash.sha256_update(&key.sha, source + tok.start,
                tok.len.to_type(u64)) != 0) { return -1 }
        i += 1
    }
    return 0
}

// key_mix_type_facts：混入 ABI 相关类型事实；present=0 表示类型缺失。
// 不混 type_id 这类 arena 下标，避免检查顺序改变键。
pub fn key_mix_type_facts(key *Key, present int, kind int, size int,
    align int) int {
    if (key_mix_int(key, present) != 0) { return -1 }
    if (present == 0) { return 0 }
    if (key_mix_int(key, kind) != 0) { return -1 }
    if (key_mix_int(key, size) != 0) { return -1 }
    return key_mix_int(key, align)
}

// id_parse_hex：把 64 位小写十六进制文本解析为 32 字节 ID；非法返回 -1。
pub fn id_parse_hex(text *char, out *u8) int {
    if (text == 0 || out == 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_HEX {
        let c u8 = text[i].to_type(u8)
        let high int = -1
        if (c >= '0' && c <= '9') { high = c - '0' }
        if (c >= 'a' && c <= 'f') { high = c - 'a' + 10 }
        i += 1
        if (high < 0) { return -1 }
        let c2 u8 = text[i].to_type(u8)
        let low int = -1
        if (c2 >= '0' && c2 <= '9') { low = c2 - '0' }
        if (c2 >= 'a' && c2 <= 'f') { low = c2 - 'a' + 10 }
        if (low < 0) { return -1 }
        out[i / 2] = (high * 16 + low).to_type(u8)
        i += 1
    }
    return text[CACHE_ID_HEX] == 0 ? 0 : -1
}

// key_finish：写 32 字节二进制 ActionID；0 = 成功。
pub fn key_finish(key *Key, out *u8) int {
    if (key == 0 || out == 0) { return -1 }
    return hash.sha256_final(&key.sha, out)
}

// key_finish_hex：写 64 位十六进制 ActionID + 结尾零；out 至少 65 字节。
pub fn key_finish_hex(key *Key, out *u8) int {
    if (key == 0 || out == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (key_finish(key, &digest[0]) != 0) { return -1 }
    return hash.sha256_hex(&digest[0], out)
}
