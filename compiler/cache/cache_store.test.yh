module cache

// ============================================================================
// cache_store.test.yh —— C4 store 参数的纯函数测试
//
// 只由 `cd compiler && ../yh test cache` 执行；目录/IO 行为由
// tests/selfhost/llvm-global-cache.py 覆盖。
// ============================================================================

test "store_parse_size：整数与 1024 进制后缀" {
    let size u64 = 0
    $assert(store_parse_size("123", &size) == 0 && size == 123, "123")
    $assert(store_parse_size("10G", &size) == 0 && size == 10737418240, "10G")
    $assert(store_parse_size("512MiB", &size) == 0 && size == 536870912, "512MiB")
    $assert(store_parse_size("0", &size) != 0, "0 非法")
    $assert(store_parse_size("10X", &size) != 0, "未知后缀")
    $assert(store_parse_size("", &size) != 0, "空串")
}

test "id_parse_hex：64 hex 往返与非法输入" {
    let id [CACHE_ID_SIZE]u8
    $assert(id_parse_hex("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        &id[0]) == 0, "合法 64 hex")
    $assert(id[0] == 1 && id[1] == 35 && id[31] == 239, "字节解析")
    $assert(id_parse_hex("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde",
        &id[0]) != 0, "长度不足")
    $assert(id_parse_hex("g123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        &id[0]) != 0, "非法字符")
}
