module check
import token
import support

// ============================================================================
// sem_flow.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

fn sem_glabels_verify() int {
    let i int = 0
    for i < support.fc().c_glabel_n {
        if (support.fc().c_glabels[i].defined == 0) {
            return token.err_tok("goto 了未定义的标签")
        }
        i += 1
    }
    support.fc().c_glabel_n = 0
    return 0
}

