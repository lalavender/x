// ============================================================================
// sem_flow.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_forin_begin(it *gen.Res, is_range int, end_res *gen.Res) int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    if (gen.task().c_fi_depth >= 64) {
        return gen.sem_err("for-in 嵌套过深")
    }
    let d int = gen.task().c_fi_depth
    gen.task().c_fi_cnt_off[d] = 0
    gen.task().c_fi_len_off[d] = 0
    gen.task().c_fi_data_off[d] = 0
    gen.task().c_fi_step_off[d] = 0
    gen.task().c_fi_elem_off[d] = -1
    gen.task().c_fi_idx_off[d] = -1
    if (is_range != 0) {
        gen.task().c_fi_kind[d] = 1
        // x0 = 起点。先存 data 槽（起点），再与终点比较定步长与长度。
        // x11 = 终点（从临时槽）。用 x11 而非 x9：深帧下
        // em_lea_local_to 拼地址走 movz x9，会覆盖 x9 里的终点，
        // 区间长度被算成「槽偏移 - 起点」（run/27：长度 287 而非 4，
        // range_sum 累加成 37128——小帧时 lea 走 sub x10 不触雷，
        // 故 mini 复现全过）
        // x0 = 起点
        // 长度 = max(0, 终点 - 起点)：x11 = 终点-起点；若 <0 置 0
        let l_pos int = 0
        // x11 == 0：空区间，长度 0（保持 x11=0 即可）
        // 步长恒 +1（左闭右开区间）。先取地址再装常量：深帧 lea 的
        // movz x9 不能落在步长已入 x9 之后（同数组 len 的教训）
        gen.task().c_fi_depth += 1
        return 0
    }
    // 数组/切片
    gen.task().c_fi_kind[d] = 0
    let k int = support.ms().types[it.type_id].kind
    if (k == gen.TY_ARRAY) {
        // 先取地址再装 len：深帧 lea 的 movz x9 不能落在 len 已入 x9 之后
    } else if (k == gen.TY_SLICE) {
    } else {
        return gen.sem_err("for-in 需要数组、切片或区间")
    }
    gen.task().c_fi_depth += 1
    return 0
}

pub fn sem_forin_elem_type(it *gen.Res, is_range int) int {
    if (is_range != 0) {
        // 区间迭代绑定是默认整数类型 int（与 stage0 一致，便于 int 变量累加）
        return gen.TY_I32
    }
    return support.ms().types[it.type_id].elem
}

pub fn sem_forin_set_bind(elem_off int, idx_off int) int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    if (gen.task().c_fi_depth == 0) {
        return gen.sem_err("内部错误：for-in 状态缺失")
    }
    gen.task().c_fi_elem_off[gen.task().c_fi_depth - 1] = elem_off
    gen.task().c_fi_idx_off[gen.task().c_fi_depth - 1] = idx_off
    return 0
}

pub fn sem_forin_check(lbl_end int) int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    let d int = gen.task().c_fi_depth - 1
    return 0
}

pub fn sem_forin_load(it *gen.Res, is_range int) int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    let d int = gen.task().c_fi_depth - 1
    if (is_range != 0) {
        // 下标 = count；值 = 起点 + count*step
        if (gen.task().c_fi_idx_off[d] >= 0) {
        }
        if (gen.task().c_fi_elem_off[d] >= 0) {
            // x0 = count（下标）；值 = 起点 + count
        }
        return 0
    }
    // 数组/切片：值 = data[count]
    let elem int = support.ms().types[it.type_id].elem
    if (gen.task().c_fi_idx_off[d] >= 0) {
    }
    // 缩放下标 → data + i*size
    let esz int = support.ms().types[elem].size
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
    }
    if (gen.task().c_fi_elem_off[d] >= 0) {
        let ek int = support.ms().types[elem].kind
        if (ek == gen.TY_STRUCT || ek == gen.TY_UNION || ek == gen.TY_ARRAY || ek == gen.TY_SLICE) {
            // 聚合元素：块拷贝进绑定槽。x0 = 元素地址（add 的结果），
            // 先取绑定槽地址（x10）再拷贝——深帧 lea 的 movz x9 不碰
            // x0，此序天然安全；原「mov x9, x0 保地址」会被 lea 覆盖
            // （copy_block 源错）
        } else {
            // 标量元素：x10 = 元素地址，load 到 x0 后存绑定槽
        }
    }
    return 0
}

pub fn sem_forin_step(lbl_cond int) int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    let d int = gen.task().c_fi_depth - 1
    return 0
}

pub fn sem_forin_end() int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    gen.task().c_fi_depth -= 1
    return 0
}

pub fn sem_stash_lvalue() int {
    if (support.session().compile == 0 || gen.task().c_fold != 0) {
        return 0
    }
    if (gen.task().c_temp_off == 0) {
        gen.task().c_temp_off = 0
    }
    // 先保护 x0 中的左值地址，再取临时槽地址，最后写入
    return 0
}

pub fn sem_assign(op int, lres *gen.Res, rres *gen.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (gen.task().c_fold != 0) {
        return gen.sem_err("赋值不是编译期常量")
    }
    if (gen.ty_is_float(lres.type_id) != 0) {
        // 浮点赋值：值在 d0/s0
        if (op == token.TK_ASSIGN) {
            let fs *char = "d"
            if (support.ms().types[lres.type_id].size == 4) { fs = "s" }
            return 0
        }
        // 复合赋值：右值（d0）存入专用临时槽；目标地址进出 x10 各两次
        //（每次 em_lea_local_to 都会覆盖 x10，目标地址先压栈保护、用后
        // 弹回；压/弹必须成对，此前弹空栈导致 d1 从垃圾地址装入）。
        let fs2 *char = "d"
        if (support.ms().types[lres.type_id].size == 4) { fs2 = "s" }
        if (gen.task().c_fp_tmp_off == 0) {
            gen.task().c_fp_tmp_off = 0
        }
        let fb int = op
        if (op == token.TK_PLUSEQ) { fb = token.TK_PLUS }
        if (op == token.TK_MINUSEQ) { fb = token.TK_MINUS }
        if (op == token.TK_STAREQ) { fb = token.TK_STAR }
        if (op == token.TK_SLASHEQ) { fb = token.TK_SLASH }
        return 0
    }
    if (op == token.TK_ASSIGN) {
        // x10 先取回暂存的目标地址再存（临时槽里存的是地址，不是目标）
        // 聚合同型赋值 = 逐字节块拷贝（语义边界 §：数组同型赋值为值
        // 复制）。聚合的值语义即对象地址：x0 是源对象地址，x10 是目标
        // 地址；此前误走标量 store 只写前 8 字节。
        let lk int = support.ms().types[lres.type_id].kind
        if (lk == gen.TY_STRUCT || lk == gen.TY_UNION || lk == gen.TY_ARRAY || lk == gen.TY_SLICE) {
            return 0
        }
        return 0
    }
    // 复合赋值：x10 先取回暂存的左值地址，再读值运算后经 x10 存回
    let tid int = gen.sem_promote(lres.type_id, rres.type_id)
    let base int = op
    if (op == token.TK_PLUSEQ) { base = token.TK_PLUS }
    if (op == token.TK_MINUSEQ) { base = token.TK_MINUS }
    if (op == token.TK_STAREQ) { base = token.TK_STAR }
    if (op == token.TK_SLASHEQ) { base = token.TK_SLASH }
    if (op == token.TK_PERCENTEQ) { base = token.TK_PERCENT }
    if (op == token.TK_AMPEQ) { base = token.TK_AMP }
    if (op == token.TK_PIPEEQ) { base = token.TK_PIPE }
    if (op == token.TK_CARETEQ) { base = token.TK_CARET }
    if (op == token.TK_LSHIFTEQ) { base = token.TK_LSHIFT }
    if (op == token.TK_RSHIFTEQ) { base = token.TK_RSHIFT }
    return 0
}

pub fn sem_declare_local(start int, n int, tid int) int {
    if (gen.ty_has_opaque_value(tid) != 0) {
        return gen.sem_err("不透明 C 类型只能通过指针声明局部变量")
    }
    let size int = support.ms().types[tid].size
    let idx int = gen.sym_push(start, n, gen.SYM_VAR, tid, 0)
    if (idx < 0) {
        return -1
    }
    let off int = 0
    support.ms().syms[idx].offset = off
    // 零初始化（标量直接清零；聚合逐字节循环）
    if (size == 0) {
        return idx
    }
    if (size <= 8) {
        let zk *char = "strb\twzr, [x10]"
        if (size == 2) { zk = "strh\twzr, [x10]" }
        if (size == 4) { zk = "str\twzr, [x10]" }
        if (size == 8) { zk = "str\txzr, [x10]" }
        return idx
    }
    // 聚合清零循环：x9 = 剩余字节，x10 = 游标。先取槽地址再装计数器：
    // 深帧 lea 的 movz x9 会覆盖计数器（清零长度错/死循环）
    let lz int = 0
    let ld int = 0
    return idx
}

pub fn sem_store_local_value(idx int, tid int) int {
    if (support.session().compile == 0) {
        return 0
    }
    let k int = support.ms().types[tid].kind
    if (k == gen.TY_STRUCT || k == gen.TY_UNION || k == gen.TY_ARRAY || k == gen.TY_SLICE) {
        // 聚合初始化：x0 = 源聚合地址 → 块拷贝进局部槽
        let off int = support.ms().syms[idx].offset
        return 0
    }
    if (gen.ty_is_float(tid) != 0) {
        return 0
    }
    let soff int = support.ms().syms[idx].offset
    if (soff <= 255) {
        // 按大小选寄存器与助记符
        let size int = support.ms().types[tid].size
        if (size == 8) {
        } else if (size == 4) {
        } else if (size == 2) {
        } else {
        }
        return 0
    }
    // 偏移超出未缩放立即数范围：地址写 x10（不覆盖 x0 中的待存值）
    return 0
}

pub fn sem_check_duplicate(start int, n int) int {
    let i int = support.ms().sym_n - 1
    for i >= support.ms().scope_start[support.ms().scope_n - 1] {
        if (support.ms().syms[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.ms().syms[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return gen.sem_err("同一作用域内重复声明")
            }
        }
        i -= 1
    }
    return 0
}

pub fn sem_goto(start int, n int) int {
    if (support.session().compile == 0) {
        return 0
    }
    // 已定义？
    let i int = 0
    for i < gen.task().c_glabel_n {
        if (gen.task().c_glabels[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[gen.task().c_glabels[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return 0
            }
        }
        i += 1
    }
    // 前向引用：登记
    if (gen.task().c_glabel_n >= 128) {
        return gen.sem_err("goto 标签过多")
    }
    let off int = support.name_intern(start, n)
    gen.task().c_glabels[gen.task().c_glabel_n].name_off = off
    gen.task().c_glabels[gen.task().c_glabel_n].name_len = n
    let lbl int = 0
    gen.task().c_glabels[gen.task().c_glabel_n].lbl = lbl
    gen.task().c_glabels[gen.task().c_glabel_n].defined = 0
    gen.task().c_glabel_n += 1
    return 0
}

pub fn sem_deflabel(start int, n int) int {
    if (support.session().compile == 0) {
        return 0
    }
    let i int = 0
    for i < gen.task().c_glabel_n {
        if (gen.task().c_glabels[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[gen.task().c_glabels[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (gen.task().c_glabels[i].defined != 0) {
                    return gen.sem_err("标签重定义")
                }
                gen.task().c_glabels[i].defined = 1
                return 0
            }
        }
        i += 1
    }
    if (gen.task().c_glabel_n >= 128) {
        return gen.sem_err("goto 标签过多")
    }
    let off int = support.name_intern(start, n)
    gen.task().c_glabels[gen.task().c_glabel_n].name_off = off
    gen.task().c_glabels[gen.task().c_glabel_n].name_len = n
    let lbl int = 0
    gen.task().c_glabels[gen.task().c_glabel_n].lbl = lbl
    gen.task().c_glabels[gen.task().c_glabel_n].defined = 1
    gen.task().c_glabel_n += 1
    return 0
}

fn sem_glabels_verify() int {
    let i int = 0
    for i < gen.task().c_glabel_n {
        if (gen.task().c_glabels[i].defined == 0) {
            return gen.sem_err("goto 了未定义的标签")
        }
        i += 1
    }
    gen.task().c_glabel_n = 0
    return 0
}

pub fn sem_loop_push(brk int, cnt int) int {
    if (gen.task().c_loop_depth >= 64) {
        return gen.sem_err("循环嵌套过深")
    }
    gen.task().c_brk_stk[gen.task().c_loop_depth] = brk
    gen.task().c_cnt_stk[gen.task().c_loop_depth] = cnt
    gen.task().c_loop_break_seen[gen.task().c_loop_depth] = 0
    gen.task().c_loop_depth += 1
    gen.task().c_loop_brk = brk
    gen.task().c_loop_cnt = cnt
    return 0
}

pub fn sem_loop_pop() int {
    gen.task().c_loop_depth -= 1
    if (gen.task().c_loop_depth > 0) {
        gen.task().c_loop_brk = gen.task().c_brk_stk[gen.task().c_loop_depth - 1]
        gen.task().c_loop_cnt = gen.task().c_cnt_stk[gen.task().c_loop_depth - 1]
    }
    return 0
}

pub fn sem_break() int {
    if (support.session().compile == 0) {
        return 0
    }
    if (gen.task().c_loop_depth == 0) {
        return gen.sem_err("break 不在循环内")
    }
    gen.task().c_loop_break_seen[gen.task().c_loop_depth - 1] = 1
    return 0
}

pub fn sem_continue() int {
    if (support.session().compile == 0) {
        return 0
    }
    if (gen.task().c_loop_depth == 0) {
        return gen.sem_err("continue 不在循环内")
    }
    return 0
}
