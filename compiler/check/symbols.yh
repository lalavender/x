module check
import errors
import support

import table
// ============================================================================
// symbols.yh —— 语义内核：类型表/符号表/作用域/兼容性判定
//
// 从 gen/symbols.yh 迁入（F2 K2）。这些函数会写 `table.ms()` 的类型/符号表
// 并发带 token 位置的诊断，属于「语义动作」而非「值规则」，所以按 ADR-0021
// 归 check。gen 从此只保留编译期求值必需的纯值规则（value_rules.yh）。
//
// 约定：本文件只做登记与判定，不做语法解析；诊断一律走 token.err_tok。
// ============================================================================

// intvec_grow：int 数组统一扩容。
fn intvec_grow(vec **int, n int, cap *int) int {
    if (n < *cap) {
        return 0
    }
    let ncap int = *cap * 2
    if (ncap == 0) {
        ncap = 64
    }
    let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
    if (nd == 0) {
        return errors.fail("内存分配失败")
    }
    if (n > 0) {
        memcpy(nd, *vec, (n * sizeof(int)).to_type(u64))
    }
    free(*vec)
    *vec = nd
    *cap = ncap
    return 0
}

// ty_lookup_name_off：按池偏移查类型名（登记去重用）。
fn ty_lookup_name_off(off int, n int) int {
    let i int = table.ms().name_n - 1
    for i >= 0 {
        if (table.ms().names[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[table.ms().names[i].name_off + j] != support.pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return table.ms().names[i].type_id
            }
        }
        i -= 1
    }
    return -1
}

// sym_push_lit：以池内已有名字登记符号（prelude 用）。
fn sym_push_lit(off int, n int, kind int, tid int, flags int) int {
    let tmp int = table.ms().sym_n
    let idx int = sym_push(0, 0, kind, tid, flags)
    if (idx < 0) {
        return -1
    }
    table.ms().syms[idx].name_off = off
    table.ms().syms[idx].name_len = n
    return idx
}
