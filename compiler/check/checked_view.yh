module check
import support
import ast
import gen
import proj

// CheckedModuleView：供 check 只读验证快照的借用视图，不拥有任何表或嵌套数据。
// 视图只在 CheckedModule 所有者保持有效且未修改时使用；release 后立即失效。
pub struct CheckedModuleView {
    target support.TargetInfo
    expressions *ast.AstExpr
    expression_n int
    statements *ast.AstStmt
    statement_n int
    edges *ast.AstStmtExpr
    edge_n int
    bindings *ast.AstBinding
    binding_n int
    templates *ast.AstComptimeFor
    template_n int
    declarations *ast.AstDecl
    declaration_n int
    functions *CheckedFunction
    function_n int
    types *gen.CType
    type_n int
    fields *gen.SField
    field_n int
    type_names *gen.TName
    type_name_n int
    type_home *int
    sig_abi *int
    sig_ret *int
    sig_np *int
    sig_vararg *int
    sig_first *int
    sig_n int
    sig_params *int
    sig_param_n int
    symbols *gen.CSym
    symbol_n int
    names *u8
    name_n int
    files *proj.PFile
    file_n int
    imports *gen.ModInfo
    import_n int
    bss_symbols *int
    bss_n int
    strings *CheckedString
    string_n int
    static_data *CheckedStaticData
    static_data_n int
    suffix_off int
    suffix_len int
    is_entry int
}

// checked_module_view：借出快照自有表的只读视图，不复制、不分配或转移所有权。
// 调用方必须在对应 CheckedModule release 或修改前完成检查；无效所有者返回 -1。
pub fn checked_module_view(unit *CheckedModule, out *CheckedModuleView) int {
    if (unit == 0 || out == 0 || unit.storage == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    out.target = unit.target
    out.expressions = store.expressions; out.expression_n = store.expression_n
    out.statements = store.statements; out.statement_n = store.statement_n
    out.edges = store.edges; out.edge_n = store.edge_n
    out.bindings = store.bindings; out.binding_n = store.binding_n
    out.templates = store.templates; out.template_n = store.template_n
    out.declarations = store.declarations; out.declaration_n = store.declaration_n
    out.functions = store.functions; out.function_n = store.function_n
    out.types = store.types; out.type_n = store.type_n
    out.fields = store.fields; out.field_n = store.field_n
    out.type_names = store.type_names; out.type_name_n = store.type_name_n
    out.type_home = store.type_home
    out.sig_abi = store.sig_abi; out.sig_ret = store.sig_ret
    out.sig_np = store.sig_np; out.sig_vararg = store.sig_vararg
    out.sig_first = store.sig_first; out.sig_n = store.sig_n
    out.sig_params = store.sig_params; out.sig_param_n = store.sig_param_n
    out.symbols = store.symbols; out.symbol_n = store.symbol_n
    out.names = store.names; out.name_n = store.name_n
    out.files = store.files; out.file_n = store.file_n
    out.imports = store.imports; out.import_n = store.import_n
    out.bss_symbols = store.bss_symbols; out.bss_n = store.bss_n
    out.strings = store.strings; out.string_n = store.string_n
    out.static_data = store.static_data; out.static_data_n = store.static_data_n
    out.suffix_off = store.suffix_off; out.suffix_len = store.suffix_len
    out.is_entry = store.is_entry
    return 0
}
