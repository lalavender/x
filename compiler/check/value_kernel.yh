module check
import table
import token

// ============================================================================
// value_kernel.yh —— 值内核诊断适配（F4 收尾）
//
// `support/value_kernel.yh` 里三个纯值规则（隐式转换判定 + 两个常量折叠）
// 只返回错误码，不碰 token；诊断的**位置来源**在调用层。check 层是
// `token.err_tok`（当前 token 游标），所以这里做一层薄适配：
//   码 == 0            → 成功
//   码  > 0            → token.err_tok(vk_msg(码))，返回 -1
//
// 对调用方保持既有约定（0 = 通过，-1 = 已报错），因此 parse/check 的
// 调用点写法不需要改。
// ============================================================================

// sem_report：把值内核错误码转成带位置的诊断；0 原样返回 0。
fn sem_report(code int) int {
    if (code == 0) { return 0 }
    token.err_tok(table.vk_msg(code))
    return -1
}

