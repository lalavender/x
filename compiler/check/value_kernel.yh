module check
import support
import table
import token

// ============================================================================
// value_kernel.yh —— 值内核诊断适配（F4 收尾）
//
// `support/value_kernel.yh` 里三个纯值规则（隐式转换判定 + 两个常量折叠）
// 只返回错误码，不碰 token；诊断的**位置来源**在调用层。check 层是
// `token.err_tok`（当前 token 游标），所以这里做一层薄适配：
//   码 == 0            → 成功
//   码  > 0            → token.err_tok(vk_msg(码))，返回 -1
//
// 对调用方保持既有约定（0 = 通过，-1 = 已报错），因此 parse/check 的
// 调用点写法不需要改。
// ============================================================================

// sem_report：把值内核错误码转成带位置的诊断；0 原样返回 0。
// 位置优先用 parse 记录的表达式起点（support.fc().c_expr_first）：值内核
// 校验发生在表达式解析之后，游标此时已越过整个表达式（常在行尾），直接
// err_tok 会让 caret 指到出错构造之后。未记录时退回 token 游标。
// 说明行取 table.vk_help(code)（没有建议时与 err_at 等价）。
fn sem_report(code int) int {
    if (code == 0) { return 0 }
    let note *char = table.vk_help(code)
    let first int = support.fc().c_expr_first
    if (first >= 0 && first < token.ctx().count) {
        token.err_at_note(first, table.vk_msg(code), note)
    } else {
        token.err_tok_note(table.vk_msg(code), note)
    }
    return -1
}

