module check
import support
import comptime
import gen

// ============================================================================
// ct_bind.yh —— CT 执行器事实绑定的唯一入口
//
// `comptime` 不能 import gen（check → comptime → check 会成环），所以它读的是
// 零拷贝镜像（见 comptime/ct_facts.yh）。绑定点收在本文件：任何进入 CT 执行
// 的路径都先调 ct_facts_sync()，把类型表与符号表的槽交给镜像。
//
// 同时提供形状守卫 ct_type_layout_ok()：镜像结构/常量与 gen 不一致时立刻失败。
// ============================================================================

// ct_types_sync：只绑定类型表槽（保留给只需要类型的调用方）。
pub fn ct_types_sync() void {
    comptime.ct_types_bind((&support.ms().types).to_type(*void), &support.ms().type_n)
}

// ct_facts_sync：把类型表与符号表的「槽」一次绑定到 CT 镜像。
// 只传槽地址（不是表内容），表扩容/搬迁后镜像自动读到最新值；每任务一次。
pub fn ct_facts_sync() void {
    comptime.ct_types_bind((&support.ms().types).to_type(*void), &support.ms().type_n)
    comptime.ct_syms_bind((&support.ms().syms).to_type(*void), &support.ms().sym_n)
    comptime.ct_fields_bind((&support.ms().fields).to_type(*void), &support.ms().field_n)
    // 前端模式位：CT 读折叠开关、写结果寻址（两个标量槽）。
    comptime.ct_mode_bind((&support.fc().c_fold).to_type(*void), (&support.fc().c_res_is_addr).to_type(*void))
    // 文件导入表：CT 登记函数时要把导入别名一起带进 IR 目标描述。
    comptime.ct_imports_bind((&support.fs().imports).to_type(*void), &support.fs().import_n,
        (&support.fs().import_mod).to_type(*void))
    // 字符串标签 / 枚举成员：gen 里的模块级表，用槽地址绑定。
    let ds_lbl **int
    let ds_off **int
    let ds_len **int
    let ds_q **int
    support.data_str_slots((&ds_lbl).to_type(**int), (&ds_off).to_type(**int),
        (&ds_len).to_type(**int), (&ds_q).to_type(**int))
    let em_off **int
    let em_len **int
    let em_val **i64
    let em_ready **int
    support.em_slots((&em_off).to_type(**int), (&em_len).to_type(**int),
        (&em_val).to_type(**i64), (&em_ready).to_type(**int))
    comptime.ct_tables_bind(ds_lbl.to_type(**int), ds_off.to_type(**int), ds_len.to_type(**int), ds_q.to_type(**int),
        support.data_str_n_slot().to_type(*int),
        em_off.to_type(**int), em_len.to_type(**int), em_val.to_type(**i64),
        em_ready.to_type(**int), support.em_n_slot().to_type(*int),
        support.static_data_rows_slot().to_type(**comptime.CtStaticRow),
        support.static_data_n_slot())
}

// ct_import_count / ct_import_alias / ct_import_module：导入表镜像的只读窄口。
// 供 fixture 做差分；生产路径由 comptime 内部直接读镜像。
pub fn ct_import_count() int { return comptime.ct_import_count() }

// ct_import_alias：第 i 行的绑定名池偏移与长度；越界返回 -1。
pub fn ct_import_alias(i int, out_off *int, out_len *int) int {
    if (i < 0 || i >= comptime.ct_import_count()) { return -1 }
    let row comptime.CtImportRow = comptime.ct_import_row(i)
    out_off[0] = row.alias_off
    out_len[0] = row.alias_len
    return 0
}

// ct_import_module：第 i 行绑定的模块编号（-1 = 未绑定）。
pub fn ct_import_module(i int) int { return comptime.ct_import_module(i) }

// ct_fold_mode / ct_res_is_addr_set：前端模式位槽的读写窄口。
pub fn ct_fold_mode() int { return comptime.ct_fold_mode() }
pub fn ct_res_is_addr_set(v int) void { comptime.ct_res_is_addr_set(v) }

// ct_type_layout_ok：镜像与 gen 逐项一致返回 1，否则 0。
// 覆盖 struct 尺寸与全部 TY_* 常量值；字段顺序由 struct 定义保证。
pub fn ct_type_layout_ok() int {
    if (sizeof(gen.CType) != sizeof(comptime.CtTypeRow)) { return 0 }
    if (sizeof(gen.CSym) != sizeof(comptime.CtSymRow)) { return 0 }
    if (sizeof(gen.SField) != sizeof(comptime.CtFieldRow)) { return 0 }
    if (gen.CT_DIAG_ASSERT != comptime.CT_DIAG_ASSERT
        || gen.CT_DIAG_ERROR != comptime.CT_DIAG_ERROR
        || gen.CT_DIAG_WARN != comptime.CT_DIAG_WARN) { return 0 }
    if (gen.SYM_VAR != comptime.CT_SYM_VAR || gen.SYM_CONST != comptime.CT_SYM_CONST
        || gen.SYM_FN != comptime.CT_SYM_FN
        || gen.F_GLOBAL != comptime.CT_F_GLOBAL || gen.F_PARAM != comptime.CT_F_PARAM
        || gen.F_PUB != comptime.CT_F_PUB || gen.F_EXTERN != comptime.CT_F_EXTERN
        || gen.F_ADDR != comptime.CT_F_ADDR || gen.F_AGGPARAM != comptime.CT_F_AGGPARAM
        || gen.F_CABI != comptime.CT_F_CABI || gen.F_COMPTIME != comptime.CT_F_COMPTIME
        || gen.F_ENUM_MEMBER != comptime.CT_F_ENUM_MEMBER
        || gen.F_ENUM_META != comptime.CT_F_ENUM_META
        || gen.F_FIELD_META != comptime.CT_F_FIELD_META
        || gen.F_MODULE_IMPORT != comptime.CT_F_MODULE_IMPORT) { return 0 }
    if (gen.TY_VOID != comptime.CT_TY_VOID || gen.TY_BOOL != comptime.CT_TY_BOOL
        || gen.TY_CHAR != comptime.CT_TY_CHAR || gen.TY_I8 != comptime.CT_TY_I8
        || gen.TY_I16 != comptime.CT_TY_I16 || gen.TY_I32 != comptime.CT_TY_I32
        || gen.TY_I64 != comptime.CT_TY_I64 || gen.TY_U8 != comptime.CT_TY_U8
        || gen.TY_U16 != comptime.CT_TY_U16 || gen.TY_U32 != comptime.CT_TY_U32
        || gen.TY_U64 != comptime.CT_TY_U64 || gen.TY_F32 != comptime.CT_TY_F32
        || gen.TY_F64 != comptime.CT_TY_F64 || gen.TY_PTR != comptime.CT_TY_PTR
        || gen.TY_ARRAY != comptime.CT_TY_ARRAY || gen.TY_SLICE != comptime.CT_TY_SLICE
        || gen.TY_STRUCT != comptime.CT_TY_STRUCT || gen.TY_UNION != comptime.CT_TY_UNION
        || gen.TY_ENUM != comptime.CT_TY_ENUM || gen.TY_FN != comptime.CT_TY_FN) { return 0 }
    return 1
}

// yh test：镜像与 gen 类型表/符号表逐行一致（差分）与符号行差分。生产构建不登记。
test "ct 镜像与 gen 类型表逐行一致" {
    support.session_reset()
    if (gen.sem_init_tables() != 0 || gen.ty_register_builtins() != 0) { return }
    if (ct_type_layout_ok() == 0) { return }
    ct_facts_sync()
    let n int = comptime.ct_types_bound()
    if (n <= 0 || n != support.ms().type_n) { return }
    let i int = 0
    for i < n {
        let row gen.CType = support.ms().types[i]
        if (comptime.ct_ty_kind(i) != row.kind) { return }
        if (comptime.ct_ty_size(i) != row.size) { return }
        if (comptime.ct_ty_align(i) != row.align) { return }
        if (comptime.ct_ty_elem(i) != row.elem) { return }
        if (comptime.ct_ty_len(i) != row.len) { return }
        if (comptime.ct_ty_sub(i) != row.sub) { return }
        if (comptime.ct_ty_is_integer(i) != support.ty_is_integer(i)) { return }
        if (comptime.ct_ty_is_float(i) != support.ty_is_float(i)) { return }
        if (comptime.ct_ty_is_signed(i) != support.ty_is_signed(i)) { return }
        i += 1
    }
    let sn int = support.ms().sym_n
    if (comptime.ct_syms_bound() != sn) { return }
    let si int = 0
    for si < sn {
        let row gen.CSym = support.ms().syms[si]
        if (comptime.ct_sym_row(si).kind != row.kind) { return }
        if (comptime.ct_sym_row(si).type_id != row.type_id) { return }
        if (comptime.ct_sym_row(si).flags != row.flags) { return }
        if (comptime.ct_sym_row(si).offset != row.offset) { return }
        if (comptime.ct_sym_row(si).const_ready != row.const_ready) { return }
        if (comptime.ct_sym_row(si).cval != row.cval) { return }
        si += 1
    }
}

// —— 供外部（fixture/验证）读取镜像的窄口，避免它们直接 import comptime ——

// ct_types_bound：已绑定行数；0 表示未绑定。
pub fn ct_types_bound() int {
    return comptime.ct_types_bound()
}

// ct_syms_bound：已绑定符号行数；0 表示未绑定。
pub fn ct_syms_bound() int {
    return comptime.ct_syms_bound()
}

// ct_kind / ct_size / ct_align / ct_elem / ct_len / ct_sub：镜像行字段。
pub fn ct_kind(tid int) int { return comptime.ct_ty_kind(tid) }
pub fn ct_size(tid int) int { return comptime.ct_ty_size(tid) }
pub fn ct_align(tid int) int { return comptime.ct_ty_align(tid) }
pub fn ct_elem(tid int) int { return comptime.ct_ty_elem(tid) }
pub fn ct_len(tid int) int { return comptime.ct_ty_len(tid) }
pub fn ct_sub(tid int) int { return comptime.ct_ty_sub(tid) }

// ct_sym_kind / ct_sym_type / ct_sym_flags / ct_sym_ready：镜像符号行字段。
pub fn ct_sym_kind(i int) int { return comptime.ct_sym_row(i).kind }
pub fn ct_sym_type(i int) int { return comptime.ct_sym_row(i).type_id }
pub fn ct_sym_flags(i int) int { return comptime.ct_sym_row(i).flags }
pub fn ct_sym_ready(i int) int { return comptime.ct_sym_row(i).const_ready }

// ct_sym_declared_before：符号声明位置早于 (line,col)（与 gen 版同判据）。
pub fn ct_sym_declared_before(sym int, line int, col int) int {
    return comptime.ct_sym_declared_before(sym, line, col)
}

// ct_is_integer / ct_is_float / ct_is_signed：镜像谓词。
pub fn ct_is_integer(tid int) int { return comptime.ct_ty_is_integer(tid) }
pub fn ct_is_float(tid int) int { return comptime.ct_ty_is_float(tid) }
pub fn ct_is_signed(tid int) int { return comptime.ct_ty_is_signed(tid) }
