module check
import token
import gen
import support

// ============================================================================
// sem_expr.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_push_value(r *gen.Res) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.ty_is_float(r.type_id) != 0) {
        return 0
    }
    return 0
}




// sem_fold_float_binop：常量浮点算术与比较；值为 IEEE754 位模式，



pub fn sem_binop(op int, lhs *gen.Res, rhs *gen.Res) int {
    let tid int = 0
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    // 运算数检查
    if (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT || op == token.TK_LEQ
        || op == token.TK_GT || op == token.TK_GEQ) {
        // 指针只参与 ==/!=（与 0 或同型）
        if (support.ms().types[lhs.type_id].kind == gen.TY_PTR || support.ms().types[rhs.type_id].kind == gen.TY_PTR) {
            if (op != token.TK_EQEQ && op != token.TK_NEQ) {
                return gen.sem_err("指针只支持 == / != 比较")
            }
            let ok int = 0
            if (lhs.type_id == rhs.type_id) { ok = 1 }
            if (support.ms().types[lhs.type_id].elem == gen.TY_VOID) { ok = 1 }
            if (support.ms().types[rhs.type_id].elem == gen.TY_VOID) { ok = 1 }
            if (rhs.is_lit != 0 && rhs.is_const != 0 && rhs.ival == 0) { ok = 1 }
            if (lhs.is_lit != 0 && lhs.is_const != 0 && lhs.ival == 0) { ok = 1 }
            if (ok == 0) {
                return gen.sem_err("指针比较类型不匹配")
            }
            support.sem_res_const(lhs, gen.TY_BOOL, 0)
            if (support.fc().c_fold == 0) {
            }
            support.fc().c_res_is_addr = 0
            return 0
        }
    }
    // 字面量适配：一侧是字面量时借用另一侧类型
    if (rhs.is_lit != 0 && gen.ty_is_scalar(lhs.type_id) != 0
        && support.ty_is_integer(lhs.type_id) != 0 && support.ty_is_integer(rhs.type_id) != 0) {
        if (gen.sem_lit_fits(lhs.type_id, rhs.ival) != 0) {
            rhs.type_id = lhs.type_id
        }
    }
    if (lhs.is_lit != 0 && gen.ty_is_scalar(rhs.type_id) != 0
        && support.ty_is_integer(lhs.type_id) != 0 && support.ty_is_integer(rhs.type_id) != 0) {
        if (gen.sem_lit_fits(rhs.type_id, lhs.ival) != 0) {
            lhs.type_id = rhs.type_id
        }
    }
    // 指针算术：p + i / p - i（按元素大小缩放下标）；指针比较另走分支
    let lk int = support.ms().types[lhs.type_id].kind
    let rk int = support.ms().types[rhs.type_id].kind
    if ((lk == gen.TY_PTR && rk == gen.TY_PTR) || lk == gen.TY_ARRAY || rk == gen.TY_ARRAY) {
        return gen.sem_err("指针/数组不参与该运算")
    }
    if (lk == gen.TY_PTR && support.ty_is_integer(rhs.type_id) != 0) {
        if (op == token.TK_PLUS || op == token.TK_MINUS) {
            if (support.fc().c_fold != 0) {
                return gen.sem_err("指针运算不是编译期常量")
            }
            support.fc().c_res_is_addr = 1   // 结果是地址（可再解引用/下标）
            return 0
        }
        return gen.sem_err("指针只支持 + / - 整数")
    }
    if (rk == gen.TY_PTR && support.ty_is_integer(lhs.type_id) != 0 && op == token.TK_PLUS) {
        if (support.fc().c_fold != 0) {
            return gen.sem_err("指针运算不是编译期常量")
        }
        // x9 = 整数，x0 = 指针：交换后缩放
        // 结果类型取指针一侧（此前漏设会让 `i + p` 被当成整数）
        lhs.type_id = rhs.type_id
        support.fc().c_res_is_addr = 1
        return 0
    }
    tid = gen.sem_promote(lhs.type_id, rhs.type_id)
    if (support.ty_is_float(tid) != 0) {
        // 浮点二元/比较：折叠时直接按位模式求值，运行期左 d1、右 d0（值栈已按序压入）
        if (support.fc().c_fold != 0) {
            if (lhs.is_const == 0 || rhs.is_const == 0) {
                return gen.sem_err("这里需要编译期常量")
            }
            let value i64 = 0
            if (gen.sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) {
                return -1
            }
            let fp_cmp int = (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT
                || op == token.TK_LEQ || op == token.TK_GT || op == token.TK_GEQ).to_type(int)
            if (fp_cmp != 0) {
                support.sem_res_const(lhs, gen.TY_BOOL, value)
            } else {
                support.sem_res_const(lhs, tid, value)
                lhs.fval_bits = value
            }
            return 0
        }
        let iscmp int = (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT
                         || op == token.TK_LEQ || op == token.TK_GT || op == token.TK_GEQ).to_type(int)
        if (op != token.TK_PLUS && op != token.TK_MINUS && op != token.TK_STAR && op != token.TK_SLASH
            && iscmp == 0) {
            return gen.sem_err("浮点不支持该运算")
        }
        if (iscmp != 0) {
            support.sem_res_const(lhs, gen.TY_BOOL, 0)
        } else {
            sem_res_reset(lhs, tid)
        }
        lhs.is_const = 0
        support.fc().c_res_is_addr = 0
        return 0
    }
    if (gen.ty_is_scalar(tid) == 0) {
        return gen.sem_err("该类型不支持算术运算")
    }
    let is_cmp int = 0
    if (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT || op == token.TK_LEQ
        || op == token.TK_GT || op == token.TK_GEQ) {
        is_cmp = 1
    }
    if (support.fc().c_fold != 0) {
        if (lhs.is_const == 0 || rhs.is_const == 0) {
            return gen.sem_err("这里需要编译期常量")
        }
        let value i64 = 0
        if (gen.sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) { return -1 }
        if (is_cmp != 0) {
            support.sem_res_const(lhs, gen.TY_BOOL, value)
        } else {
            support.sem_res_const(lhs, tid, value)
            // 浮点常量同时保留位模式，供 const 初始化与浮点装载使用。
            if (support.ty_is_float(tid) != 0) { lhs.fval_bits = value }
        }
        return 0
    }
    if (is_cmp != 0) {
        support.sem_res_const(lhs, gen.TY_BOOL, 0)
    } else {
        // 运算按 64 位计算，源结果先恢复定宽位型，随后扩大转换不能读取高位残留。
        sem_res_reset(lhs, tid)
    }
    lhs.is_const = 0
    support.fc().c_res_is_addr = 0
    return 0
}

// sem_shortcircuit：检查逻辑左值；折叠时保存真值，运行时发射短路跳转。
pub fn sem_shortcircuit(op int, lhs *gen.Res) int {
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        if (gen.ty_is_scalar(lhs.type_id) == 0 || support.ty_is_float(lhs.type_id) != 0) {
            return gen.sem_err("逻辑运算要求非浮点标量")
        }
        if (lhs.is_const == 0) {
            return gen.sem_err("逻辑运算要求编译期常量")
        }
        if (support.fc().sc_sc_depth >= 64) {
            return gen.sem_err("逻辑运算嵌套超过 64 层")
        }
        support.fc().sc_sc_false_stk[support.fc().sc_sc_depth] = (lhs.ival != 0).to_type(int)
        support.fc().sc_sc_depth += 1
        support.fc().c_res_is_addr = 0
        return sem_res_reset(lhs, gen.TY_BOOL)
    }
    // 保存外层短路标签（嵌套 a&&b||c&&d 时内层不破坏外层）
    support.fc().sc_sc_false_stk[support.fc().sc_sc_depth] = support.fc().sc_lbl_false
    support.fc().sc_sc_end_stk[support.fc().sc_sc_depth] = support.fc().sc_lbl_end
    support.fc().sc_sc_depth += 1
    support.fc().sc_lbl_false = 0
    support.fc().sc_lbl_end = 0
    if (op == token.TK_ANDAND) {
    } else {
    }
    sem_res_reset(lhs, gen.TY_BOOL)
    support.fc().c_res_is_addr = 0
    return 0
}

// sem_shortcircuit_end：合并折叠的左右真值，或补齐运行时短路分支并恢复外层标签。
pub fn sem_shortcircuit_end(op int, lhs *gen.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_fold != 0) {
        if (gen.ty_is_scalar(lhs.type_id) == 0 || support.ty_is_float(lhs.type_id) != 0) {
            return gen.sem_err("逻辑运算要求非浮点标量")
        }
        if (lhs.is_const == 0) {
            return gen.sem_err("逻辑运算要求编译期常量")
        }
        support.fc().sc_sc_depth -= 1
        let left int = support.fc().sc_sc_false_stk[support.fc().sc_sc_depth]
        let right int = (lhs.ival != 0).to_type(int)
        let value int = 0
        if (op == token.TK_ANDAND) { value = (left != 0 && right != 0).to_type(int) }
        else { value = (left != 0 || right != 0).to_type(int) }
        support.fc().c_res_is_addr = 0
        return support.sem_res_const(lhs, gen.TY_BOOL, value.to_type(i64))
    }
    if (op == token.TK_ANDAND) {
        // 左真且右真 → 结果 1
    } else {
        // || ：左或右为真 → 结果 1
    }
    lhs.is_const = 0
    support.fc().c_res_is_addr = 0
    // 恢复外层短路标签（嵌套 a&&b||c&&d：内层用完即还）
    support.fc().sc_sc_depth -= 1
    support.fc().sc_lbl_false = support.fc().sc_sc_false_stk[support.fc().sc_sc_depth]
    support.fc().sc_lbl_end = support.fc().sc_sc_end_stk[support.fc().sc_sc_depth]
    return 0
}

pub fn sem_ternary_cond(lhs *gen.Res) int {
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        return gen.sem_err("三元不支持编译期折叠")
    }
    // 保存外层三元标签（嵌套 `a ? b : (c ? d : e)` 时内层不破坏外层；
    // 此前共用一对全局标签，内层覆盖外层后发射重复 .L 标签）
    if (support.fc().tn_depth >= 64) {
        return gen.sem_err("三元表达式嵌套超过 64 层")
    }
    support.fc().tn_else_stk[support.fc().tn_depth] = support.fc().tn_lbl_else
    support.fc().tn_end_stk[support.fc().tn_depth] = support.fc().tn_lbl_end
    support.fc().tn_depth += 1
    support.fc().tn_lbl_else = 0
    support.fc().tn_lbl_end = 0
    return 0
}

pub fn sem_ternary_mid(lhs *gen.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    return 0
}

pub fn sem_ternary_end(lhs *gen.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    support.fc().c_res_is_addr = 0
    // 恢复外层三元标签（嵌套时内层用完即还）
    support.fc().tn_depth -= 1
    support.fc().tn_lbl_else = support.fc().tn_else_stk[support.fc().tn_depth]
    support.fc().tn_lbl_end = support.fc().tn_end_stk[support.fc().tn_depth]
    return 0
}

pub fn sem_unary(op int, operand *gen.Res) int {
    if (support.session().compile == 0) {
        operand.type_id = 0
        return 0
    }
    if (op == token.TK_STAR) {
        if (support.ms().types[operand.type_id].kind != gen.TY_PTR) {
            return gen.sem_err("解引用的操作数必须是指针")
        }
        let elem int = support.ms().types[operand.type_id].elem
        let ek int = support.ms().types[elem].kind
        let agg int = (ek == gen.TY_STRUCT || ek == gen.TY_UNION
            || ek == gen.TY_ARRAY || ek == gen.TY_SLICE).to_type(int)
        if (support.fc().c_lvalue == 0 && support.fc().c_fold == 0 && agg == 0) {
            // x0 = 指针值（地址）→ 装入点值
        }
        // 聚合的值语义就是对象地址（见 emit_arm64.yh 的聚合原语约定）：
        // 解引用聚合**不装入**，x0 保持地址；按标量装入会把对象开头 8 字节
        // 当成地址（`*dst = *src` 曾因此块拷贝到野地址而段错误）。
        support.fc().c_res_is_addr = 1
        sem_res_reset(operand, support.ms().types[operand.type_id].elem)
        operand.is_const = 0
        return 0
    }
    if (op == token.TK_AMP) {
        if (support.fc().c_res_is_addr == 0) {
            return gen.sem_err("取地址的操作数必须是左值")
        }
        let pt int = gen.ty_ptr(operand.type_id)
        sem_res_reset(operand, pt)
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (operand.is_const != 0) {
        // 常量（含字面量）：折叠求值并保留字面量性（如 let n i8 = -100）
        if (support.ty_is_float(operand.type_id) != 0) {
            let fp_value i64 = 0
            if (gen.sem_fold_const_unary(op, operand.type_id, operand.ival,
                    operand.is_lit, &fp_value) != 0) { return -1 }
            operand.ival = fp_value
            operand.fval_bits = fp_value
            if (support.fc().c_fold == 0) {
            }
            return 0
        }
        let unary_type int = operand.type_id
        if (support.ms().types[unary_type].kind == gen.TY_BOOL) { unary_type = gen.TY_I32 }
        if (support.ty_is_integer(operand.type_id) != 0) {
            // 超出当前整数宽度的负数字面量先提升为 i64，保留完整值供赋值与二元运算适配。
            if (op == token.TK_MINUS && operand.is_lit != 0 && operand.ival >= 0) {
                let negative i64 = 0 - operand.ival
                if (gen.sem_lit_fits(unary_type, negative) == 0
                    && gen.sem_lit_fits(gen.TY_I64, negative) != 0) {
                    unary_type = gen.TY_I64
                }
            }
            let value i64 = 0
            if (gen.sem_fold_const_unary(op, unary_type, operand.ival,
                    operand.is_lit, &value) != 0) { return -1 }
            operand.ival = value
        } else {
            operand.ival = gen.fold_unary(op, operand.ival)
            unary_type = gen.TY_I32
        }
        // 常量与动态一元结果类型一致；bool 已升为 int，其他整数保留原宽度/符号性。
        operand.type_id = unary_type
        // 结果是新常量值，原符号绑定只属于操作数子节点；括号不能继承为错型基本表达式。
        operand.sym = -1
        return 0
    }
    let tid int = operand.type_id
    if (support.ty_is_float(tid) != 0) {
        if (op == token.TK_MINUS) {
            sem_res_reset(operand, tid)
            support.fc().c_res_is_addr = 0
            return 0
        }
        if (op == token.TK_PLUS) {
            return 0
        }
        return gen.sem_err("浮点只支持一元 +/-")
    }
    if (support.ms().types[tid].kind == gen.TY_BOOL) {
        tid = gen.TY_I32
    }
    if (gen.ty_is_scalar(tid) == 0) {
        return gen.sem_err("该类型不支持一元运算")
    }
    sem_res_reset(operand, tid)
    support.fc().c_res_is_addr = 0
    return 0
}

pub fn sem_index(base *gen.Res, idx *gen.Res) int {
    if (support.session().compile == 0) {
        base.type_id = 0
        return 0
    }
    if (support.ty_is_integer(idx.type_id) == 0) {
        return gen.sem_err("下标必须是整数")
    }
    let bk int = support.ms().types[base.type_id].kind
    let elem int = 0
    if (bk == gen.TY_PTR) {
        elem = support.ms().types[base.type_id].elem
    } else if (bk == gen.TY_ARRAY) {
        elem = support.ms().types[base.type_id].elem
    } else if (bk == gen.TY_SLICE) {
        elem = support.ms().types[base.type_id].elem
    } else {
        return gen.sem_err("该类型不支持下标访问")
    }
    if (support.fc().c_fold != 0) {
        return gen.sem_err("下标访问不是编译期常量")
    }
    // lvalue 模式下指针变量的基址是「变量的地址」——先装入指针值
    if (bk == gen.TY_PTR && support.fc().c_lvalue != 0) {
    }
    // 切片：基址是切片数据指针（槽内偏移 8），需先取 data 字段
    if (bk == gen.TY_SLICE) {
    }
    // 地址 = 基址(x9) + 下标(x0) * 元素大小
    let esz int = support.ms().types[elem].size
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
        // 任意大小的聚合元素（如 20 字节的 Tok）：乘法缩放
    }
    let ek int = support.ms().types[elem].kind
    if (ek == gen.TY_STRUCT || ek == gen.TY_UNION || ek == gen.TY_ARRAY || ek == gen.TY_SLICE) {
        // 聚合元素：保留地址语义（成员/下标链后续再加偏移）
        support.fc().c_res_is_addr = 1
    } else if (support.fc().c_lvalue == 0) {
        if (support.ty_is_float(elem) != 0) {
            // 浮点元素：装入浮点寄存器
            let fsfx *char = "d"
            if (support.ms().types[elem].size == 4) { fsfx = "s" }
        } else {
        }
        support.fc().c_res_is_addr = 0
    } else {
        support.fc().c_res_is_addr = 1
    }
    sem_res_reset(base, elem)
    return 0
}

pub fn sem_slice(base *gen.Res, sres *gen.Res, eres *gen.Res) int {
    if (support.session().compile == 0) {
        base.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        return gen.sem_err("切片表达式不是编译期常量")
    }
    let bk int = support.ms().types[base.type_id].kind
    if (bk != gen.TY_ARRAY && bk != gen.TY_SLICE) {
        return gen.sem_err("切片表达式需要数组或切片")
    }
    if (support.ty_is_integer(sres.type_id) == 0 || support.ty_is_integer(eres.type_id) == 0) {
        return gen.sem_err("切片下标必须是整数")
    }
    let elem int = support.ms().types[base.type_id].elem
    let esz int = support.ms().types[elem].size
    // x0 = end → x11 暂存；弹 start → x0；弹 base → x10
    // 切片基址取 data 字段（{len, data} 的偏移 8）
    if (bk == gen.TY_SLICE) {
    }
    // x9 = max(0, end - start)
    let l_pos int = 0
    // x0 = start * 元素大小
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
    }
    // x0 = 数据指针 = 基址 + start*esz
    // 构造 {len, data} 临时切片
    let soff int = 0
    base.type_id = gen.ty_slice(elem)
    base.is_lit = 0
    base.is_const = 0
    support.fc().c_res_is_addr = 1
    return 0
}

pub fn sem_member(base *gen.Res, name_start int, name_len int) int {
    if (support.session().compile == 0) {
        base.type_id = 0
        return 0
    }
    // 基底求值后的 x0 形态（进入本函数时 c_res_is_addr 尚未被改写）：
    // 1 = x0 是「存放基底的变量的地址」（如指针变量的 lvalue 引用、
    //     解引用未装载的 *p），指针基底需先 ldr 装入结构地址；
    // 0 = x0 已是基底值本身（函数调用返回的指针、RVALUE 已装载的变量），
    //     不得再间接一次——否则多解一层，字段访问落在野地址上。
    // 枚举基底：`EnumName.member` 里枚举类型名在模块模式下会被求值成枚举值
    //（类型名登记成常量符号，形态随 pass 变化），此时按成员名查符号表取成员常量。
    if (base.type_id >= 0 && support.ms().types[base.type_id].kind == gen.TY_ENUM) {
        let msym int = support.sym_lookup(name_start, name_len)
        if (msym < 0) {
            // 名字表里查不到时按名字反查枚举成员表（登记时快照名字与值，不经过符号表）：
            // 模块 worker 二次解析编译期正文时枚举成员符号不可见（实测）。
            let eidx int = support.em_find(name_start, name_len)
            if (eidx >= 0 && support.em_get_ready(eidx) != 0) {
                let evalue i64 = support.em_get_val(eidx)
                support.sem_res_const(base, base.type_id, evalue)
                return 0
            }
        }

        // 不校验成员符号的 type_id：模块模式下枚举成员登记时的类型上下文与基底
        // 枚举类型 id 不总一致；枚举成员注册在全局名字表里，同名成员本就不能共存。
        if (msym < 0 || (support.ms().syms[msym].flags & gen.F_ENUM_MEMBER) == 0) {
            // 模块模式：枚举类型名会被求值成枚举值，而此时成员符号在当前编译单元的
            // 名字表里已经查不到（实测），因此这里只能给出可操作的诊断。同模块顶层
            // 常量引用同一成员是正常的，推荐用常量中转。
            if (support.cfg().module_mode != 0) {
                return gen.sem_err("模块模式下编译期正文里直接引用枚举成员暂不支持；请在同模块顶层用 `pub const X int = 枚举名.成员;` 中转后再引用")
            }
            return gen.sem_err("枚举没有这个成员")
        }
        if (support.ms().syms[msym].const_ready == 0) {
            return gen.sem_err("编译期常量尚未就绪")
        }
        let value i64 = support.ms().syms[msym].cval
        support.sem_res_const(base, base.type_id, value)
        return 0
    }
    let base_indirect int = support.fc().c_res_is_addr
    let bk int = support.ms().types[base.type_id].kind
    let stid int = 0
    if (bk == gen.TY_PTR) {
        stid = support.ms().types[base.type_id].elem
        if (support.ms().types[stid].kind != gen.TY_STRUCT && support.ms().types[stid].kind != gen.TY_UNION) {
            return gen.sem_err("『.』的左侧不是结构体或结构体指针")
        }
    } else if (bk == gen.TY_STRUCT || bk == gen.TY_UNION) {
        stid = base.type_id
    } else {
        return gen.sem_err("『.』的左侧不是结构体或结构体指针")
    }
    if (gen.ty_is_opaque(stid) != 0) {
        return gen.sem_err("不透明 C 类型没有可访问字段")
    }
    // 字段查找
    let st int = support.ms().types[stid].sub
    let nf int = support.ms().types[stid].len
    let found int = -1
    let i int = 0
    for i < nf {
        let f int = st + i
        if (support.ms().fields[f].name_len == name_len) {
            let match int = 1
            let j int = 0
            for j < name_len {
                if (support.pool_ctx().data[support.ms().fields[f].name_off + j] != support.src_ctx().data[name_start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                found = f
                break
            }
        }
        i += 1
    }
    if (found < 0) {
        return gen.sem_err("结构体没有该字段")
    }
    // pub struct 一等化：字段一律公开，跨模块访问不再有字段级限制
    // （类型的跨模块可见性仍由类型自身的 pub 决定）。
    if (support.fc().c_fold != 0) {
        return gen.sem_err("字段访问不是编译期常量")
    }
    let off int = support.ms().fields[found].offset
    if (bk == gen.TY_PTR) {
        if (support.fc().c_lvalue != 0 && base_indirect != 0) {
            // x0 = 指针变量的地址 → 装入指针值
        }
        // x0 = 结构体地址；加字段偏移
    }
    if (off > 0) {
        if (off <= 4095) {
        } else {
            // 深结构体的字段偏移超出 add 的 12 位无符号立即数范围，借 x12 装偏移
            // （与 em_lea_local* 的深帧约定一致：调用方不依赖 x12 跨 lea 存活）。
        }
    }
    let ftid int = support.ms().fields[found].type_id
    if (support.fc().c_lvalue == 0) {
        let fk int = support.ms().types[ftid].kind
        if (fk != gen.TY_STRUCT && fk != gen.TY_UNION && fk != gen.TY_ARRAY && fk != gen.TY_SLICE) {
            support.fc().c_res_is_addr = 0
        } else {
            // 聚合字段：保持地址语义
            support.fc().c_res_is_addr = 1
        }
    } else {
        support.fc().c_res_is_addr = 1
    }
    sem_res_reset(base, ftid)
    return 0
}

pub fn sem_sizeof(tid int, r *gen.Res) int {
    sem_res_reset(r, gen.TY_I32)
    if (support.session().compile == 0) {
        return 0
    }
    if (gen.ty_is_opaque(tid) != 0) {
        return gen.sem_err("不透明 C 类型不能用于 sizeof")
    }
    if (support.ms().types[tid].size < 0) {
        // typed CT 函数先保存 sizeof 的目标类型，等布局调度器完成依赖后再执行。
        if (support.session().ast_capture != 0 && support.session().pass == 2) {
            r.layout_type_id = tid
            return 0
        }
        return gen.sem_err("sizeof 的类型布局尚未就绪")
    }
    r.is_const = 1
    r.is_lit = 0
    r.ival = support.ms().types[tid].size.to_type(i64)
    return 0
}

pub fn sem_len(r *gen.Res) int {
    if (support.session().compile == 0) {
        r.type_id = 0
        return 0
    }
    let k int = support.ms().types[r.type_id].kind
    if (k == gen.TY_ARRAY) {
        // 编译期折叠为常量并直接装 x0（同 sem_sizeof：折叠出的常量由
        // 这里物化，消费端不负责）。必须清 support.fc().c_res_is_addr——实参（数组
        // 标识符）的聚合地址语义会残留，否则 x0 里的数组地址被当成
        // 结果（曾致 return len(arr) 返回地址而非长度）。
        support.fc().c_res_is_addr = 0
        support.sem_res_const(r, gen.TY_I32, support.ms().types[r.type_id].len.to_type(i64))
        return 0
    }
    if (k == gen.TY_SLICE) {
        if (support.fc().c_fold != 0) {
            return gen.sem_err("切片长度不是编译期常量")
        }
        // 切片值在 x0（地址）；读 [x0] 的长度
        sem_res_reset(r, gen.TY_I32)
        support.fc().c_res_is_addr = 0
        return 0
    }
    return gen.sem_err("len 需要一个数组或切片")
}

pub fn sem_cast(operand *gen.Res, tid int) int {
    if (support.session().compile == 0) {
        operand.type_id = 0
        return 0
    }
    let ok int = support.ms().types[tid].kind
    if (ok == gen.TY_VOID) {
        return gen.sem_err("不能转换为 void")
    }
    let sk int = support.ms().types[operand.type_id].kind
    if (sk == gen.TY_FN && ok == gen.TY_FN
        && support.ms().sig_abi[support.ms().types[operand.type_id].sub] != support.ms().sig_abi[support.ms().types[tid].sub]) {
        return gen.sem_err("函数类型转换不能改变 C/yh 调用约定")
    }
    let scalar_to_scalar int = 0
    if (gen.ty_is_scalar(tid) != 0 && gen.ty_is_scalar(operand.type_id) != 0) {
        scalar_to_scalar = 1
    }
    // 数组 → 切片视图：构造 {len, data} 临时聚合（ADR-0002 的规范化视图）
    if (sk == gen.TY_ARRAY && ok == gen.TY_SLICE) {
        if (support.ms().types[operand.type_id].elem != support.ms().types[tid].elem) {
            return gen.sem_err("数组元素类型与目标切片不一致")
        }
        if (support.fc().c_fold != 0) {
            return gen.sem_err("数组转切片不是编译期常量")
        }
        let arrlen int = support.ms().types[operand.type_id].len
        // x0 = 数组地址（数组值即地址）
        let soff int = 0
        operand.type_id = tid
        operand.is_lit = 0
        operand.is_const = 0
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (scalar_to_scalar == 0) {
        return gen.sem_err("该转换不支持（标量之间或指针/整数）")
    }
    // 编译期常量转换：浮点参与的转换写位模式，整数转换按目标宽度归一。
    if (support.fc().c_fold != 0 && operand.is_const != 0) {
        if (support.ty_is_float(operand.type_id) != 0 || support.ty_is_float(tid) != 0) {
            let value i64 = support.sem_fold_float_convert(operand.type_id, tid, operand.ival)
            operand.ival = value
            operand.fval_bits = value
        } else {
            operand.ival = support.sem_fold_norm(tid, operand.ival)
        }
        operand.type_id = tid
        support.fc().c_res_is_addr = 0
        return 0
    }
    if (support.fc().c_fold == 0 && support.fc().c_res_is_addr == 0) {
        // 运行时转换
        let from_fp int = support.ty_is_float(operand.type_id)
        let to_fp int = support.ty_is_float(tid)
        if (to_fp != 0 && from_fp == 0) {
            let src_signed int = support.ty_is_signed(operand.type_id)
        } else if (to_fp != 0 && from_fp != 0) {
            // 浮点宽度转换：f32<->f64（d0/s0 互转）
            if (support.ms().types[operand.type_id].size != support.ms().types[tid].size) {
                if (support.ms().types[tid].size == 4) {
                } else {
                }
            }
        } else if (to_fp == 0 && from_fp != 0) {
            let dst_signed int = support.ty_is_signed(tid)
        } else if (support.ms().types[operand.type_id].size != support.ms().types[tid].size
                   || support.ty_is_signed(operand.type_id) != support.ty_is_signed(tid)) {
            // 整数 → 整数：x0 中按源类型已扩展，需按目标宽度/符号性重新扩展。
            // 例如 i64 → int 必须截断到低 32 位并符号扩展，否则比较/运算会用
            // 到高位的残留值（曾导致 i64 的 int 视图比较结果错误）。
        }
        // 其余整数→整数（更宽或同宽同符号）已在 x0 中正确扩展，无需发码。
    }
    operand.type_id = tid
    operand.is_lit = 0
    support.fc().c_res_is_addr = 0
    return 0
}
