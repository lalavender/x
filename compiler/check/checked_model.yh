module check
import token
import ast
import gen
import support
import comptime
import proj

// CheckedModule：语义遍历完成后的模块所有者，storage 独占受检表与只读源码副本。
// 必须以零初始化对象调用 capture；拥有者不能按值复制，读取副本须经有界访问入口。
// 使用快照 lowering 前，调用方须通过 check 校验且保证之后不修改；target 字符串为静态常量。
pub struct CheckedModule {
    target support.TargetInfo
    storage *void
}

// CheckedFunction：独立的受检函数身份和 AST 范围，不保存旧汇编缓冲的字节区间。
pub struct CheckedFunction {
    file_id int
    owner_decl int
    decl_row int
    token_first int
    token_after int
    expr_first int
    expr_after int
    stmt_first int
    stmt_after int
    edge_first int
    edge_after int
    binding_first int
    binding_after int
    body_stmt int
}

// CheckedString：视图引用的字符串标签与名称池字节关系；不单独拥有名称池。
pub struct CheckedString {
    label int
    name_off int
    name_len int
    quoted int
}

// CheckedStaticData：视图引用的静态对象快照，不引用 GenState 或 CT arena。
// sym_id/label 仅为本次前端会话内的来源键；重定位目标同样以来源键表达，lowering
// 会在建立模块符号表时解析，绝不把标签整数当成运行期地址。
pub struct CheckedStaticData {
    sym_id int
    label int
    type_id int
    elem_type int
    count int
    size int
    align int
    data *u8
    relocs *support.StaticDataReloc
    reloc_n int
}

// CheckedStorage：所有 arena 与语义表均独立复制，原 ID 在快照内继续指向相同行。
// 文件、导入描述符内部的指针也拥有副本；不持有 GenState、旧输出或 CT 对象指针。
// 静态数据目录按值深拷贝；CT 聚合、切片 backing 和导入字面量都不保留宿主指针。
// 纯快照 lowering 的上下文（CheckedFlow/CheckedLower）依赖本类型，按模块
// 「类型先声明后使用 + 文件名序编译」的约束放在 check/checked_model.yh。
pub struct CheckedStorage {
    expressions *ast.AstExpr
    expression_n int
    statements *ast.AstStmt
    statement_n int
    edges *ast.AstStmtExpr
    edge_n int
    bindings *ast.AstBinding
    binding_n int
    templates *ast.AstComptimeFor
    template_n int
    declarations *ast.AstDecl
    declaration_n int
    functions *CheckedFunction
    function_n int
    types *gen.CType
    type_n int
    fields *gen.SField
    field_n int
    type_names *gen.TName
    type_name_n int
    type_home *int
    sig_abi *int
    sig_ret *int
    sig_np *int
    sig_vararg *int
    sig_first *int
    sig_n int
    sig_params *int
    sig_param_n int
    symbols *gen.CSym
    symbol_n int
    names *u8
    name_n int
    files *proj.PFile
    file_n int
    imports *gen.ModInfo
    import_n int
    bss_symbols *int
    bss_n int
    strings *CheckedString
    string_n int
    static_data *CheckedStaticData
    static_data_n int
    suffix_off int
    suffix_len int
    is_entry int
}

// checked_copy_rows：复制无内部指针的表，空表返回 null；无效范围或分配失败也返回 null。
// 字节乘法在 int 范围内先检查，避免转换为 u64 之前溢出。
fn checked_copy_rows(source *void, count int, width int) *void {
    if (count == 0) { return 0 }
    if (source == 0 || count < 0 || width <= 0 || count > 2147483647 / width) {
        return 0
    }
    let bytes int = count * width
    let result *void = malloc(bytes.to_type(u64))
    if (result != 0) { memcpy(result, source, bytes.to_type(u64)) }
    return result
}

// checked_zero_rows：分配零初始化描述符数组，使部分捕获失败也能按同一协议释放。
pub fn checked_zero_rows(count int, width int) *void {
    if (count <= 0 || width <= 0 || count > 2147483647 / width) { return 0 }
    let bytes int = count * width
    let result *u8 = malloc(bytes.to_type(u64)).to_type(*u8)
    if (result == 0) { return 0 }
    let i int = 0
    for i < bytes { result[i] = 0; i += 1 }
    return result.to_type(*void)
}

// checked_storage_copy_ready：确认捕获器建立的表与嵌套缓冲可安全转交和释放。
// 这里只检查复制/所有权所需的非空指针，不验证快照内容；一致性检查由 check 负责。
fn checked_storage_copy_ready(store *CheckedStorage) int {
    if (store.expression_n < 0 || store.statement_n < 0 || store.edge_n < 0
        || store.binding_n < 0 || store.template_n < 0 || store.declaration_n < 0
        || store.function_n < 0 || store.type_n <= 0 || store.field_n < 0
        || store.type_name_n < 0 || store.sig_n < 0 || store.sig_param_n < 0
        || store.symbol_n < 0 || store.name_n < 0 || store.bss_n < 0
        || store.file_n < 0 || store.import_n < 0 || store.string_n < 0
        || store.static_data_n < 0
        || (store.expression_n > 0 && store.expressions == 0)
        || (store.statement_n > 0 && store.statements == 0)
        || (store.edge_n > 0 && store.edges == 0)
        || (store.binding_n > 0 && store.bindings == 0)
        || (store.template_n > 0 && store.templates == 0)
        || (store.declaration_n > 0 && store.declarations == 0)
        || (store.function_n > 0 && store.functions == 0)
        || store.types == 0 || store.type_home == 0
        || (store.field_n > 0 && store.fields == 0)
        || (store.type_name_n > 0 && store.type_names == 0)
        || (store.sig_n > 0 && (store.sig_abi == 0 || store.sig_ret == 0
            || store.sig_np == 0 || store.sig_vararg == 0 || store.sig_first == 0))
        || (store.sig_param_n > 0 && store.sig_params == 0)
        || (store.symbol_n > 0 && store.symbols == 0)
        || (store.name_n > 0 && store.names == 0)
        || (store.bss_n > 0 && store.bss_symbols == 0)
        || (store.file_n > 0 && store.files == 0)
        || (store.import_n > 0 && store.imports == 0)
        || (store.string_n > 0 && store.strings == 0)
        || (store.static_data_n > 0 && store.static_data == 0)) { return -1 }
    let i int = 0
    for i < store.file_n {
        let file proj.PFile = store.files[i]
        if ((file.source_len > 0 && file.source == 0)
            || (file.token_n > 0 && file.tokens == 0)
            || (file.decl_n > 0 && file.decls == 0)) { return -1 }
        i += 1
    }
    i = 0
    for i < store.import_n {
        if (store.imports[i].ns_n > 0 && store.imports[i].ns == 0) { return -1 }
        i += 1
    }
    i = 0
    for i < store.static_data_n {
        let item CheckedStaticData = store.static_data[i]
        if ((item.size > 0 && item.data == 0)
            || (item.reloc_n > 0 && item.relocs == 0)) { return -1 }
        i += 1
    }
    return 0
}

// checked_storage_tables：复制 AST、布局、签名、名称与符号，所有引用 ID 保持原值。
fn checked_storage_tables(store *CheckedStorage, tk *gen.TaskCtx) int {
    let tk *gen.TaskCtx = gen.task()
    let v ast.AstView
    ast.ast_view(&v)
    store.expression_n = v.expr_count
    store.statement_n = v.stmt_count
    store.edge_n = v.stmt_expr_count
    store.binding_n = v.binding_count
    store.template_n = v.comptime_for_count
    store.declaration_n = v.decl_count
    store.function_n = v.function_count
    store.type_n = tk.t_type_n
    store.field_n = tk.t_field_n
    store.type_name_n = tk.t_name_n
    store.sig_n = tk.t_sig_n
    store.sig_param_n = tk.t_sigparam_n
    store.symbol_n = tk.c_sym_n
    store.name_n = support.pool_ctx().length
    store.bss_n = tk.c_bss_n
    store.suffix_off = tk.c_sym_sfx_off
    store.suffix_len = tk.c_sym_sfx_len
    store.is_entry = proj.cfg().is_entry_mod
    store.expressions = checked_copy_rows(v.expr_nodes.to_type(*void),
        store.expression_n, sizeof(ast.AstExpr)).to_type(*ast.AstExpr)
    store.statements = checked_copy_rows(v.stmt_nodes.to_type(*void),
        store.statement_n, sizeof(ast.AstStmt)).to_type(*ast.AstStmt)
    store.edges = checked_copy_rows(v.stmt_exprs.to_type(*void),
        store.edge_n, sizeof(ast.AstStmtExpr)).to_type(*ast.AstStmtExpr)
    store.bindings = checked_copy_rows(v.bindings.to_type(*void),
        store.binding_n, sizeof(ast.AstBinding)).to_type(*ast.AstBinding)
    store.templates = checked_copy_rows(v.comptime_fors.to_type(*void),
        store.template_n, sizeof(ast.AstComptimeFor)).to_type(*ast.AstComptimeFor)
    store.declarations = checked_copy_rows(v.decl_nodes.to_type(*void),
        store.declaration_n, sizeof(ast.AstDecl)).to_type(*ast.AstDecl)
    store.functions = checked_zero_rows(store.function_n,
        sizeof(CheckedFunction)).to_type(*CheckedFunction)
    store.types = checked_copy_rows(tk.t_types.to_type(*void), store.type_n,
        sizeof(gen.CType)).to_type(*gen.CType)
    store.fields = checked_copy_rows(tk.t_fields.to_type(*void), store.field_n,
        sizeof(gen.SField)).to_type(*gen.SField)
    store.type_names = checked_copy_rows(tk.t_names.to_type(*void), store.type_name_n,
        sizeof(gen.TName)).to_type(*gen.TName)
    store.type_home = checked_copy_rows(tk.t_home.to_type(*void), store.type_n,
        sizeof(int)).to_type(*int)
    store.sig_abi = checked_copy_rows(tk.t_sig_abi.to_type(*void), store.sig_n,
        sizeof(int)).to_type(*int)
    store.sig_ret = checked_copy_rows(tk.t_sig_ret.to_type(*void), store.sig_n,
        sizeof(int)).to_type(*int)
    store.sig_np = checked_copy_rows(tk.t_sig_np.to_type(*void), store.sig_n,
        sizeof(int)).to_type(*int)
    store.sig_vararg = checked_copy_rows(tk.t_sig_vararg.to_type(*void), store.sig_n,
        sizeof(int)).to_type(*int)
    store.sig_first = checked_copy_rows(tk.t_sig_first.to_type(*void), store.sig_n,
        sizeof(int)).to_type(*int)
    store.sig_params = checked_copy_rows(tk.t_sig_params.to_type(*void), store.sig_param_n,
        sizeof(int)).to_type(*int)
    store.symbols = checked_copy_rows(tk.c_syms.to_type(*void), store.symbol_n,
        sizeof(gen.CSym)).to_type(*gen.CSym)
    store.names = checked_copy_rows(support.pool_ctx().data.to_type(*void), store.name_n,
        sizeof(u8)).to_type(*u8)
    store.bss_symbols = checked_copy_rows(tk.c_bss_syms.to_type(*void), store.bss_n,
        sizeof(int)).to_type(*int)
    if (checked_storage_copy_ready(store) != 0) { return -1 }
    let i int = 0
    for i < store.function_n {
        let ctx ast.AstFunctionContext = v.function_nodes[i]
        let dest *CheckedFunction = &store.functions[i]
        dest.file_id = ctx.file_id
        dest.owner_decl = ctx.owner_decl
        dest.decl_row = ctx.decl_row
        dest.token_first = ctx.token_first
        dest.token_after = ctx.token_after
        dest.expr_first = ctx.expr_first
        dest.expr_after = ctx.expr_after
        dest.stmt_first = ctx.stmt_first
        dest.stmt_after = ctx.stmt_after
        dest.edge_first = ctx.edge_first
        dest.edge_after = ctx.edge_after
        dest.binding_first = ctx.binding_first
        dest.binding_after = ctx.binding_after
        dest.body_stmt = ctx.body_stmt
        i += 1
    }
    return 0
}

// checked_storage_static_data：复制 typed 数据目录及其重定位/字节载荷。
// 此处浅拷贝只用于读取 gen 出口描述符；存入 CheckedStorage 的每个载荷均独立分配。
fn checked_storage_static_data(store *CheckedStorage) int {
    store.static_data_n = support.static_data_count()
    if (store.static_data_n < 0) { return -1 }
    store.static_data = checked_zero_rows(store.static_data_n,
        sizeof(CheckedStaticData)).to_type(*CheckedStaticData)
    if (store.static_data_n > 0 && store.static_data == 0) { return -1 }
    let i int = 0
    for i < store.static_data_n {
        let source support.StaticDataObject
        if (support.static_data_at(i, &source) != 0 || source.size < 0
            || source.reloc_n < 0 || (source.size > 0 && source.data == 0)
            || (source.reloc_n > 0 && source.relocs == 0)) { return -1 }
        let dest *CheckedStaticData = &store.static_data[i]
        dest.sym_id = source.sym_id; dest.label = source.label
        dest.type_id = source.type_id; dest.elem_type = source.elem_type
        dest.count = source.count; dest.size = source.size; dest.align = source.align
        dest.reloc_n = source.reloc_n
        dest.data = checked_copy_rows(source.data.to_type(*void), source.size,
            sizeof(u8)).to_type(*u8)
        dest.relocs = checked_copy_rows(source.relocs.to_type(*void), source.reloc_n,
            sizeof(support.StaticDataReloc)).to_type(*support.StaticDataReloc)
        if ((source.size > 0 && dest.data == 0)
            || (source.reloc_n > 0 && dest.relocs == 0)) { return -1 }
        i += 1
    }
    return 0
}

// checked_storage_sources：复制文件及导入命名空间的嵌套存储；未加载文件保持空指针。
// 源字节额外补一个 NUL，token/PDecl 保存原编号，不需借用 SourceStore 的寿命。
fn checked_storage_sources(store *CheckedStorage, tk *gen.TaskCtx) int {
    let tk *gen.TaskCtx = gen.task()
    store.file_n = proj.file_count()
    store.import_n = tk.c_mod_n
    store.files = checked_zero_rows(store.file_n, sizeof(proj.PFile)).to_type(*proj.PFile)
    store.imports = checked_zero_rows(store.import_n, sizeof(gen.ModInfo)).to_type(*gen.ModInfo)
    if ((store.file_n > 0 && (store.files == 0 || proj.ctx().files == 0))
        || (store.import_n > 0 && (store.imports == 0 || tk.c_mods == 0))) { return -1 }
    let i int = 0
    for i < store.file_n {
        let sp *proj.PFile = proj.file(i)
        let src proj.PFile = sp[0]
        let dest *proj.PFile = &store.files[i]
        dest[0] = src
        dest.source = 0
        dest.tokens = 0
        dest.decls = 0
        if (src.source_len < 0 || src.source_len >= 2147483647
            || src.token_n < 0 || src.decl_n < 0) { return -1 }
        if (src.source != 0) {
            dest.source = checked_zero_rows(src.source_len + 1, sizeof(u8)).to_type(*u8)
            if (dest.source == 0) { return -1 }
            if (src.source_len > 0) {
                memcpy(dest.source, src.source, src.source_len.to_type(u64))
            }
        } else if (src.source_len != 0 || src.token_n != 0 || src.decl_n != 0) { return -1 }
        dest.tokens = checked_copy_rows(src.tokens.to_type(*void), src.token_n,
            sizeof(token.Tok)).to_type(*token.Tok)
        dest.decls = checked_copy_rows(src.decls.to_type(*void), src.decl_n,
            sizeof(token.PDecl)).to_type(*token.PDecl)
        if ((src.token_n > 0 && dest.tokens == 0)
            || (src.decl_n > 0 && dest.decls == 0)) { return -1 }
        i += 1
    }
    i = 0
    for i < store.import_n {
        let src gen.ModInfo = tk.c_mods[i]
        store.imports[i] = src
        store.imports[i].ns = 0
        store.imports[i].ns_cap = src.ns_n
        if (src.ns_n < 0) { return -1 }
        store.imports[i].ns = checked_copy_rows(src.ns.to_type(*void), src.ns_n,
            sizeof(gen.ModNsEnt)).to_type(*gen.ModNsEnt)
        if (src.ns_n > 0 && store.imports[i].ns == 0) { return -1 }
        i += 1
    }
    store.strings = checked_zero_rows(support.data_label(), sizeof(CheckedString)).to_type(*CheckedString)
    if (support.data_label() < 0 || (support.data_label() > 0 && store.strings == 0)) { return -1 }
    let label int = 1
    for label <= support.data_label() {
        let off int = -1
        let length int = 0
        let quoted int = 0
        if (gen.data_str_lookup(label, &off, &length, &quoted) != 0) {
            store.strings[store.string_n].label = label
            store.strings[store.string_n].name_off = off
            store.strings[store.string_n].name_len = length
            store.strings[store.string_n].quoted = quoted
            store.string_n += 1
        }
        label += 1
    }
    return 0
}

// checked_module_capture：封存成功语义遍历的独立副本，只执行安全复制，不检查快照一致性。
// 失败不改出参并回收部分副本；调用方须在读取或 lowering 前调用 check 校验。
// 不生成汇编，不要求 LLVM 存在；仅接受已启用 AST 收集且没有未完成函数的模块 worker。
pub fn checked_module_capture(out *CheckedModule) int {
    let gs *gen.TaskCtx = gen.task()
    let v ast.AstView
    ast.ast_view(&v)
    if (out == 0 || out.storage != 0 || support.session().ast_capture == 0
        || support.diag().errors != 0 || v.function_active != 0) {
        return support.fail("受检模块捕获需要空所有者和已完成的语义检查")
    }
    let candidate CheckedModule
    if (proj.cfg().target.triple == 0
        || support.target_resolve(proj.cfg().target.triple, &candidate.target) != 0) {
        return support.fail("受检模块的完整目标身份无效")
    }
    let store *CheckedStorage = checked_zero_rows(1,
        sizeof(CheckedStorage)).to_type(*CheckedStorage)
    if (store == 0) { return support.fail("受检模块快照分配失败") }
    candidate.storage = store.to_type(*void)
    if (checked_storage_tables(store, gs) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块语义表复制失败")
    }
    if (checked_storage_static_data(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块静态数据复制失败")
    }
    if (checked_storage_sources(store, gs) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块源码与导入副本失败")
    }
    if (checked_storage_copy_ready(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块快照表存储无效")
    }
    out[0] = candidate
    return 0
}

// checked_module_release：释放唯一所有者的所有嵌套副本，再清零句柄；同一对象可重复释放。
// 返回过的名称/源码只读指针到此失效；原 AST/GenState 的存储从未由此函数释放。
pub fn checked_module_release(unit *CheckedModule) void {
    if (unit == 0) { return }
    if (unit.storage != 0) {
        let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
        let i int = 0
        if (store.files != 0) {
            for i < store.file_n {
                free(store.files[i].source.to_type(*void))
                free(store.files[i].tokens.to_type(*void))
                free(store.files[i].decls.to_type(*void))
                i += 1
            }
        }
        i = 0
        if (store.imports != 0) {
            for i < store.import_n {
                free(store.imports[i].ns.to_type(*void))
                i += 1
            }
        }
        free(store.expressions.to_type(*void))
        free(store.statements.to_type(*void))
        free(store.edges.to_type(*void))
        free(store.bindings.to_type(*void))
        free(store.templates.to_type(*void))
        free(store.declarations.to_type(*void))
        free(store.functions.to_type(*void))
        free(store.types.to_type(*void))
        free(store.fields.to_type(*void))
        free(store.type_names.to_type(*void))
        free(store.type_home.to_type(*void))
        free(store.sig_abi.to_type(*void))
        free(store.sig_ret.to_type(*void))
        free(store.sig_np.to_type(*void))
        free(store.sig_vararg.to_type(*void))
        free(store.sig_first.to_type(*void))
        free(store.sig_params.to_type(*void))
        free(store.symbols.to_type(*void))
        free(store.names.to_type(*void))
        free(store.files.to_type(*void))
        free(store.imports.to_type(*void))
        free(store.bss_symbols.to_type(*void))
        free(store.strings.to_type(*void))
        if (store.static_data != 0) {
            let i int = 0
            for i < store.static_data_n {
                free(store.static_data[i].data.to_type(*void))
                free(store.static_data[i].relocs.to_type(*void))
                i += 1
            }
        }
        free(store.static_data.to_type(*void))
        free(store.to_type(*void))
    }
    let empty CheckedModule
    unit[0] = empty
}

// checked_module_function：返回函数描述符副本，0 成功、-1 空快照或越界，不转移所有权。
pub fn checked_module_function(unit *CheckedModule, row int, out *CheckedFunction) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.function_n) { return -1 }
    out[0] = store.functions[row]
    return 0
}

// checked_module_type：复制一个布局条目；类型 ID 只在该 CheckedModule 内有意义。
pub fn checked_module_type(unit *CheckedModule, row int, out *gen.CType) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.type_n) { return -1 }
    out[0] = store.types[row]
    return 0
}

// checked_module_declaration：复制声明身份和类型/函数体关联，保留文件内稳定编号。
pub fn checked_module_declaration(unit *CheckedModule, row int, out *ast.AstDecl) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.declaration_n) { return -1 }
    out[0] = store.declarations[row]
    return 0
}

// checked_module_binding：复制参数/局部稳定绑定，供消费者避免已复用的语义符号槽。
pub fn checked_module_binding(unit *CheckedModule, row int, out *ast.AstBinding) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.binding_n) { return -1 }
    out[0] = store.bindings[row]
    return 0
}

// checked_module_expression：复用已有公开 CtExpr 布局给出副本，私有 ast.AstExpr 不泄漏进接口。
pub fn checked_module_expression(unit *CheckedModule, row int, out *comptime.CtExpr) int {
    if (unit == 0 || unit.storage == 0 || out == 0 || sizeof(ast.AstExpr) != sizeof(comptime.CtExpr)) {
        return -1
    }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.expression_n) { return -1 }
    memcpy(out, &store.expressions[row], sizeof(ast.AstExpr).to_type(u64))
    return 0
}

// checked_module_statement：复用公开 CtStmt 布局复制语句及其边号，不返回私有 arena 指针。
pub fn checked_module_statement(unit *CheckedModule, row int, out *comptime.CtStmt) int {
    if (unit == 0 || unit.storage == 0 || out == 0 || sizeof(ast.AstStmt) != sizeof(comptime.CtStmt)) {
        return -1
    }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.statement_n) { return -1 }
    memcpy(out, &store.statements[row], sizeof(ast.AstStmt).to_type(u64))
    return 0
}

// checked_module_edge：复制语句到表达式根的边，消费者可沿 next 有界遍历本快照。
pub fn checked_module_edge(unit *CheckedModule, row int, out *ast.AstStmtExpr) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.edge_n) { return -1 }
    out[0] = store.edges[row]
    return 0
}

// checked_name_valid：确认名称偏移和长度完整落在快照名称池中，避免访问器越界读取。
pub fn checked_name_valid(store *CheckedStorage, off int, length int) int {
    if (store.names == 0 || off < 0 || length < 0 || off >= store.name_n
        || length >= store.name_n - off || store.names[off + length] != 0) { return 0 }
    return 1
}

// checked_module_name：返回快照自有名称池的只读借用；只在本所有者 release 之前有效。
// 长度不含结尾 NUL，越界或非完整池字符串返回 null。
pub fn checked_module_name(unit *CheckedModule, off int, length int) *char {
    if (unit == 0 || unit.storage == 0) { return 0 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (checked_name_valid(store, off, length) == 0) { return 0 }
    return (store.names + off).to_type(*char)
}

// checked_module_source：返回快照自有源码的只读借用，同时返回字节长度；release 后失效。
pub fn checked_module_source(unit *CheckedModule, file_id int, length *int) *u8 {
    if (unit == 0 || unit.storage == 0 || length == 0) { return 0 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (file_id < 0 || file_id >= store.file_n) { return 0 }
    *length = store.files[file_id].source_len
    return store.files[file_id].source
}

// yh test 内建测试：受检快照的平面表分配与名字池边界。生产构建不登记。
test "checked_zero_rows 清零与越界" {
    let rows *int = checked_zero_rows(8, sizeof(int)).to_type(*int)
    $assert(rows != 0)
    let i int = 0
    let sum int = 0
    for i < 8 {
        sum += rows[i]
        i += 1
    }
    $assert(sum == 0)
    free(rows.to_type(*void))
    $assert(checked_zero_rows(0, sizeof(int)) == 0)
    $assert(checked_zero_rows(-1, sizeof(int)) == 0)
    $assert(checked_zero_rows(2, 0) == 0)
}
