module check
import token
import ast
import gen
import support
import ir
import proj
import cache

// ============================================================================
// checked_key.yh —— pass2b 前的函数 check 键（LA3.3 C3）
//
// 检查缓存必须在 parse/语义遍历之前判断能否跳过函数体。此时只有 GenState 的
// PFile/token/类型/签名/声明表，没有 CheckedStorage；本文件与
// module_snapshot_lower_cache.yh 共用 cache.Key 原语，但 action 种类与
// 声明面事实不同：check 用整张类型/签名表，IR 用逐声明布局序列。
//
// C0（2026-11-06）：键从 FNV 16 位十六进制迁移到 SHA-256 64 位十六进制；
// 旧 .fchk / index.check 的长度不再匹配，按 miss 处理。
// ============================================================================

// checked_gen_mix_type：混入一个类型编号的 ABI 事实；非法编号按缺失处理。
fn checked_gen_mix_type(key *cache.Key, tid int) int {
    let tk *gen.TaskCtx = gen.task()
    if (tid < 0 || tid >= support.ms().type_n) {
        return cache.key_mix_type_facts(key, 0, 0, 0, 0)
    }
    let ty gen.CType = support.ms().types[tid]
    return cache.key_mix_type_facts(key, 1, ty.kind, ty.size, ty.align)
}

// checked_gen_layout：混入 GenState 的类型/字段/签名表事实。
//
// check 键发生在 pass2b 之前，用整张声明面类型表（而不是逐声明序列）：
// 新插入一个签名相同的函数不会新增类型/签名表项，其他函数的 check 键保持
// 稳定；IR 键则在 lower 侧逐声明混入布局，插入声明会保守失效整模块。
// 两套 action 的键不同（ACTION_CHECK / ACTION_IR），但共用 cache.Key 原语。
fn checked_gen_layout(key *cache.Key) int {
    let tk *gen.TaskCtx = gen.task()
    if (cache.key_mix_int(key, support.ms().type_n) != 0) { return -1 }
    let i int = 0
    for i < support.ms().type_n {
        let ty gen.CType = support.ms().types[i]
        if (cache.key_mix_int(key, ty.kind) != 0) { return -1 }
        if (cache.key_mix_int(key, ty.size) != 0) { return -1 }
        if (cache.key_mix_int(key, ty.align) != 0) { return -1 }
        if (cache.key_mix_int(key, ty.elem) != 0) { return -1 }
        if (cache.key_mix_int(key, ty.len) != 0) { return -1 }
        if (cache.key_mix_int(key, ty.sub) != 0) { return -1 }
        i += 1
    }
    if (cache.key_mix_int(key, support.ms().field_n) != 0) { return -1 }
    i = 0
    for i < support.ms().field_n {
        let field gen.SField = support.ms().fields[i]
        if (cache.key_mix_int(key, field.name_len) != 0) { return -1 }
        if (cache.key_mix_int(key, field.type_id) != 0) { return -1 }
        if (cache.key_mix_int(key, field.offset) != 0) { return -1 }
        i += 1
    }
    if (cache.key_mix_int(key, support.ms().sig_n) != 0) { return -1 }
    i = 0
    for i < support.ms().sig_n {
        if (cache.key_mix_int(key, support.ms().sig_abi[i]) != 0) { return -1 }
        if (cache.key_mix_int(key, support.ms().sig_ret[i]) != 0) { return -1 }
        if (cache.key_mix_int(key, support.ms().sig_np[i]) != 0) { return -1 }
        if (cache.key_mix_int(key, support.ms().sig_vararg[i]) != 0) { return -1 }
        if (cache.key_mix_int(key, support.ms().sig_first[i]) != 0) { return -1 }
        i += 1
    }
    if (cache.key_mix_int(key, support.ms().sigparam_n) != 0) { return -1 }
    i = 0
    for i < support.ms().sigparam_n {
        if (cache.key_mix_int(key, support.ms().sig_params[i]) != 0) { return -1 }
        i += 1
    }
    return 0
}

// checked_gen_symbol_facts：pass2b 前混入源码级 const 的常量事实；类型用
// ABI 事实而不是 arena 下标。匿名/运行时符号不参与。
fn checked_gen_symbol_facts(key *cache.Key) int {
    let tk *gen.TaskCtx = gen.task()
    let v ast.AstView
    ast.ast_view(&v)
    let i int = 0
    for i < v.decl_count {
        let decl ast.AstDecl = v.decl_nodes[i]
        if (decl.kind == token.TK_CONST && decl.sym_id >= 0
            && decl.sym_id < support.ms().sym_n) {
            let sym gen.CSym = support.ms().syms[decl.sym_id]
            if (cache.key_mix_int(key, sym.kind) != 0) { return -1 }
            if (checked_gen_mix_type(key, sym.type_id) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.flags) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.cval.to_type(int)) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.const_ready) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.const_expr_kind) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_gen_mix_decl_tokens：混入一个声明的 token 范围。
fn checked_gen_mix_decl_tokens(decl ast.AstDecl, key *cache.Key) int {
    if (decl.file_id < 0 || decl.file_id >= proj.file_count()) { return -1 }
    let file_p *proj.PFile = proj.file(decl.file_id)
    let file proj.PFile = file_p[0]
    if (file.source == 0 || file.tokens == 0) { return -1 }
    return cache.key_mix_tokens(key, file.source, file.source_len, file.tokens,
        file.token_n, decl.first, decl.after)
}

// checked_gen_decl_facts：混入非函数声明 token 流；函数体不进入其他函数的键。
fn checked_gen_decl_facts(key *cache.Key) int {
    let v ast.AstView
    ast.ast_view(&v)
    let i int = 0
    for i < v.decl_count {
        let decl ast.AstDecl = v.decl_nodes[i]
        if (decl.kind != token.TK_FN) {
            if (checked_gen_mix_decl_tokens(decl, key) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_pdecl_decl_row：把文件内 PDecl 下标映射为 ast_decl_nodes 行。
pub fn checked_pdecl_decl_row(file_id int, pdecl_index int) int {
    let v ast.AstView
    ast.ast_view(&v)
    if (file_id < 0 || file_id >= v.decl_file_cap || v.decl_file_first == 0
        || v.decl_file_first[file_id] < 0) { return -1 }
    let row int = v.decl_file_first[file_id] + pdecl_index
    if (row < 0 || row >= v.decl_count
        || v.decl_nodes[row].file_id != file_id
        || v.decl_nodes[row].decl_index != pdecl_index) { return -1 }
    return row
}

// checked_gen_function_key：pass2b 前的函数 check 键；成功返回 0 并写 out。
// 输出是 64 位十六进制 + 结尾零（CACHE_ID_TEXT 字节）。
pub fn checked_gen_function_key(decl_row int, out *u8) int {
    let v ast.AstView
    ast.ast_view(&v)
    if (out == 0 || decl_row < 0 || decl_row >= v.decl_count) { return -1 }
    let decl ast.AstDecl = v.decl_nodes[decl_row]
    if (decl.kind != token.TK_FN || decl.file_id < 0
        || decl.file_id >= proj.file_count()) { return -1 }
    let rel_path [1024]u8
    if (proj.file_rel_path(decl.file_id, &rel_path[0], 1024) < 0) { return -1 }
    let target_key int = ir.ir_target_key(proj.cfg().target.triple)
    if (target_key < 0) { return -1 }
    let file_p *proj.PFile = proj.file(decl.file_id)
    let file proj.PFile = file_p[0]
    let inputs cache.CacheInputs
    inputs.target_key = target_key
    inputs.pointer_bits = proj.cfg().target.pointer_bits
    inputs.layout_version = proj.cfg().target.layout_version
    inputs.abi = proj.cfg().target.abi
    inputs.opt_level = proj.module_opt_level(file.mod)
    inputs.trimpath = proj.cfg().trimpath
    let key cache.Key
    if (cache.key_init_function(&key, cache.ACTION_CHECK, checked_check_cache_env,
            &inputs, support.arr_cstr(&rel_path[0])) != 0) { return -1 }
    if (checked_gen_layout(&key) != 0) { return -1 }
    if (checked_gen_symbol_facts(&key) != 0) { return -1 }
    if (checked_gen_decl_facts(&key) != 0) { return -1 }
    if (checked_gen_mix_decl_tokens(decl, &key) != 0) { return -1 }
    return cache.key_finish_hex(&key, out)
}
