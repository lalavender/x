module check
import support

// C ABI 的位置分类；种类常量与值/游标模型在 gen/abi_model.yh。

// abi_c_hfa：递归识别 f32/f64 同构聚合，返回 base_size*8+元素数；零为非 HFA。
// 联合体按最大成员元素数分类；结构体按元素数相加，数组按长度相乘。
fn abi_c_hfa(tid int) int {
    let t support.CType = support.ms().types[tid]
    if (t.kind == support.TY_F32 || t.kind == support.TY_F64) { return t.size * 8 + 1 }
    if (t.kind == support.TY_ARRAY) {
        let elem int = abi_c_hfa(t.elem)
        let count int = (elem % 8) * t.len
        if (elem == 0 || count < 1 || count > 4) { return 0 }
        return elem / 8 * 8 + count
    }
    if (t.kind != support.TY_STRUCT && t.kind != support.TY_UNION) { return 0 }
    let base int = 0
    let count int = 0
    let i int = 0
    for i < t.len {
        let part int = abi_c_hfa(support.ms().fields[t.sub + i].type_id)
        if (part == 0) { return 0 }
        if (base == 0) { base = part / 8 }
        if (base != part / 8) { return 0 }
        if (t.kind == support.TY_UNION) {
            if (part % 8 > count) { count = part % 8 }
        } else {
            count += part % 8
        }
        if (count > 4) { return 0 }
        i += 1
    }
    if (count == 0 || t.size != base * count) { return 0 }
    return base * 8 + count
}

// abi_c_describe：把前端类型布局转换为共享分类器输入，不进行任何发射。
fn abi_c_describe(tid int, out *support.ABIValue) void {
    let t support.CType = support.ms().types[tid]
    out.size = t.size
    out.align = t.align
    out.aggregate = (t.kind == support.TY_STRUCT || t.kind == support.TY_UNION).to_type(int)
    out.fp_size = 0
    out.fp_count = 0
    let hfa int = abi_c_hfa(tid)
    if (hfa != 0) {
        out.fp_size = hfa / 8
        out.fp_count = hfa % 8
    }
}

// abi_c_result：返回位置等同于首个参数的位置，普通大聚合的地址改用 x8。
fn abi_c_result(tid int, out *support.ABIArg) void {
    let value support.ABIValue
    abi_c_describe(tid, &value)
    let cursor support.ABICursor
    abi_c_cursor_init(&cursor, support.tg_darwin())
    abi_c_place(&value, &cursor, out)
    if (out.indirect != 0) { out.reg = 8 }
}
