module check
import token
import gen
import support

// ============================================================================
// sem_decl.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_fn_begin(idx int) int {
    support.fc().c_fn_sym = idx
    support.fc().c_fn_flags = support.ms().syms[idx].flags
    support.fc().c_fn_falls = 1
    support.fc().c_expr_noreturn = 0
    support.fc().c_fn_ret = support.ms().types[support.ms().syms[idx].type_id].elem
    // LL12：标签、栈槽、序言与体缓冲等机器状态由 LLVM lowering 生成，
    // 语义层只保留类型事实与诊断状态。
    support.fc().c_temp_off = 0
    support.fc().c_fp_tmp_off = 0
    support.fc().c_glabel_n = 0
    support.fc().c_spill_n = 0
    support.fc().c_aggparam_n = 0
    support.fc().c_fp_argn = 0
    support.fc().c_ret_ptr_off = 0
    support.fc().c_ret_agg_val = 0
    abi_c_cursor_init(&support.fc().c_cabi_cursor, support.tg_darwin())
    support.fc().c_fp_off = 16
    // 聚合返回：记录间接返回事实，返回缓冲地址由 lowering 处理。
    let rk int = support.ms().types[support.fc().c_fn_ret].kind
    let indirect_ret int = 1
    if ((support.fc().c_fn_flags & support.F_CABI) != 0) {
        let result support.ABIArg
        abi_c_result(support.fc().c_fn_ret, &result)
        indirect_ret = result.indirect
    }
    if (indirect_ret != 0 && (rk == support.TY_STRUCT || rk == support.TY_UNION
        || rk == support.TY_ARRAY || rk == support.TY_SLICE)) {
        support.fc().c_ret_agg = 1
    } else {
        support.fc().c_ret_agg = 0
    }
    gen.scope_push()
    return 0
}

pub fn sem_declare_param(start int, n int, tid int, regidx int) int {
    if (support.ty_has_opaque_value(tid) != 0) {
        return token.err_tok("不透明 C 类型只能通过指针传递")
    }
    // LL12：C ABI 的寄存器/栈分类由 LLVM lowering 处理，语义层只登记参数。
    let pk int = support.ms().types[tid].kind
    let is_agg int = ((pk == support.TY_ARRAY) || (pk == support.TY_STRUCT) || (pk == support.TY_UNION)
                      || (pk == support.TY_SLICE)).to_type(int)
    let idx int = gen.sym_push(start, n, support.SYM_VAR, tid, support.F_PARAM)
    if (idx < 0) {
        return -1
    }
    if (is_agg != 0) {
        // 聚合按值：形参持有调用方副本；独立副本与栈槽由 lowering 生成。
        support.ms().syms[idx].flags |= support.F_AGGPARAM
        support.fc().c_aggparam_n += 1
        return 0
    }
    if (support.ty_is_float(tid) != 0) {
        // yh 内部函数的浮点参数上限由旧 ABI 约定决定；C 函数按 lowering 的
        // ABI 分类处理（HFA 逐成员占寄存器，不受此上限约束）。
        if ((support.fc().c_fn_flags & support.F_CABI) == 0) {
            if (support.fc().c_fp_argn >= support.TG_ARG_REGS) {
                return token.err_tok("过多的浮点参数暂不支持")
            }
            support.fc().c_fp_argn += 1
        }
        return 0
    }
    return 0
}

pub fn sem_fn_end() int {
    if (sem_glabels_verify() != 0) {
        return -1
    }
    if ((support.fc().c_fn_flags & support.F_NORETURN) != 0) {
        if (support.fc().c_fn_ret != support.TY_VOID) {
            return token.err_tok("noreturn 函数必须返回 void")
        }
        if (support.fc().c_fn_falls != 0) {
            return token.err_tok("noreturn 函数存在正常落底路径")
        }
    }
    // LL12：落底返回、prologue、聚合参数入口拷贝与 epilogue 由 lowering 生成。
    gen.scope_pop()
    return 0
}

// sem_add_field：为 struct/union 登记一个字段（pass 1）。
// pub struct 一等化后字段一律公开，is_pub 恒 1（.s.i 接口按此发射）。
pub fn sem_add_field(stid int, start int, n int, ftid int) int {
    if (support.ty_has_opaque_value(ftid) != 0) {
        return token.err_tok("不透明 C 类型只能通过指针使用")
    }
    let fk int = support.ms().types[ftid].kind
    if ((support.ty_name_attrs(stid) & token.ATTR_EXTERN) != 0 && gen.ty_c_layout(ftid) == 0) {
        return token.err_tok("extern struct/union 字段不是 C 兼容布局类型")
    }
    if ((fk == support.TY_STRUCT || fk == support.TY_UNION) && support.ms().types[ftid].size == 0) {
        return token.err_tok("字段使用了不完整的类型")
    }
    if (support.ms().field_n == support.ms().field_cap) {
        let ncap int = support.ms().field_cap * 2
        if (ncap == 0) {
            ncap = 64
        }
        let nd *support.SField = malloc((ncap * sizeof(support.SField)).to_type(u64)).to_type(*support.SField)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.ms().field_n > 0) {
            memcpy(nd, support.ms().fields, (support.ms().field_n * sizeof(support.SField)).to_type(u64))
        }
        free(support.ms().fields)
        support.ms().fields = nd
        support.ms().field_cap = ncap
    }
    let off int = support.name_intern(start, n)
    if (off < 0) {
        return -1
    }
    support.ms().fields[support.ms().field_n].name_off = off
    support.ms().fields[support.ms().field_n].name_len = n
    support.ms().fields[support.ms().field_n].type_id = ftid
    support.ms().fields[support.ms().field_n].offset = 0
    support.ms().fields[support.ms().field_n].is_pub = 1
    support.ms().field_n += 1
    support.ms().types[stid].len = support.ms().field_n - support.ms().types[stid].sub
    return 0
}


fn sem_field_lookup(stid int, start int, n int) int {
    let st int = support.ms().types[stid].sub
    let nf int = support.ms().types[stid].len
    let i int = 0
    for i < nf {
        let f int = st + i
        if (support.ms().fields[f].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.ms().fields[f].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return f
            }
        }
        i += 1
    }
    return -1
}

// sem_check_main_common：校验程序入口返回 int，并接受无参数、argc/argv 或
// argc/argv/envp 三种形态；指针参数必须是 **char。require=0 用于库文件
// check：main 不存在时放行，但存在就必须满足同一签名规则。
fn sem_check_main_common(require int) int {
    let mname int = support.name_intern_lit("main")
    let i int = support.ms().sym_n - 1
    let found int = -1
    for i >= 0 {
        if (support.ms().syms[i].name_len == 4) {
            let match int = 1
            let j int = 0
            for j < 4 {
                if (support.pool_ctx().data[support.ms().syms[i].name_off + j] != support.pool_ctx().data[mname + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                found = i
                break
            }
        }
        i -= 1
    }
    if (found < 0) {
        if (require == 0) { return 0 }
        return token.err_tok("缺少 main 函数")
    }
    if (support.ms().syms[found].kind != support.SYM_FN) {
        return token.err_tok("main 必须是函数")
    }
    let sig int = support.ms().types[support.ms().syms[found].type_id].sub
    let np int = support.ms().sig_np[sig]
    let ret int = support.ms().sig_ret[sig]
    if (ret != support.TY_I32) {
        return token.err_tok("main 必须返回 int")
    }
    if (np == 0) {
        return 0
    }
    if (np == 2) {
        let p0 int = support.ms().sig_params[support.ms().sig_first[sig]]
        let p1 int = support.ms().sig_params[support.ms().sig_first[sig] + 1]
        let inner int = support.ms().types[p1].elem
        if (p0 == support.TY_I32 && support.ms().types[p1].kind == support.TY_PTR
            && support.ms().types[inner].kind == support.TY_PTR
            && support.ms().types[support.ms().types[inner].elem].kind == support.TY_CHAR) {
            return 0
        }
    }
    if (np == 3) {
        let p0 int = support.ms().sig_params[support.ms().sig_first[sig]]
        let p1 int = support.ms().sig_params[support.ms().sig_first[sig] + 1]
        let p2 int = support.ms().sig_params[support.ms().sig_first[sig] + 2]
        let a1 int = support.ms().types[p1].elem
        let a2 int = support.ms().types[p2].elem
        if (p0 == support.TY_I32 && support.ms().types[p1].kind == support.TY_PTR
            && support.ms().types[a1].kind == support.TY_PTR && support.ms().types[support.ms().types[a1].elem].kind == support.TY_CHAR
            && support.ms().types[p2].kind == support.TY_PTR
            && support.ms().types[a2].kind == support.TY_PTR && support.ms().types[support.ms().types[a2].elem].kind == support.TY_CHAR) {
            return 0
        }
    }
    return token.err_tok("main 签名必须是 ()、(argc int, argv **char) 或再带 envp **char")
}

// sem_check_main：程序编译/项目入口检查，缺少 main 即失败。
pub fn sem_check_main() int {
    return sem_check_main_common(1)
}

// sem_check_main_optional：单文件库 check 使用；main 可缺席，但存在时仍校验签名。
pub fn sem_check_main_optional() int {
    return sem_check_main_common(0)
}
