module check

import errors
import support

// ============================================================================
// front_stage.yh —— 受检前端阶段守卫（2026-11-10 自 support 迁入，ADR-0024）
//
// 「当前是否处于受检前端」是语义层阶段，不是基础设施：进入/校验/退出的
// 唯一入口归 check，support 只保留 session.front_checked 字段。build 在
// worker 入口与发射路径调用本文件三个函数。
// ============================================================================

// front_checked_begin：进入受检前端；重复进入报内部错误。
pub fn front_checked_begin() int {
    if (support.session().front_checked != 0) {
        return errors.fail("内部错误：受检前端阶段重复进入")
    }
    support.session().front_checked = 1
    return 0
}

// front_checked_verify：核对阶段仍在受检模式；0 = 仍在受检阶段。
pub fn front_checked_verify() int {
    if (support.session().front_checked == 0) {
        return errors.fail("内部错误：不在受检阶段")
    }
    return 0
}

// front_checked_end：成功检验后退出阶段；失败保留禁发状态。
pub fn front_checked_end() int {
    if (front_checked_verify() != 0) { return -1 }
    support.session().front_checked = 0
    return 0
}
