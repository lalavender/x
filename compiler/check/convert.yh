module check
import proj
import errors
import support

import table
// ============================================================================
// convert.yh —— 语句级隐式转换校验（S3a 首片）
//
// `parse` 在扫描到 `return expr;` 时会立刻做一次 `sem_can_assign(返回类型, expr)`。
// 本文件把那一步搬到 `check` 的后置遍历：AST 已经记录了表达式节点的类型、字面量性
// 与常量位型（parse 仍然填这些字段），因此校验结果与诊断文案完全一致。
//
// 位置复现：parse 期 `sem_can_assign` 用的是当时 token 游标，而 `ast_expr_finish`
// 恰好把 `after = 当时游标` 写进节点，所以这里用 `tokens[expr.after]` 的行列即可
// 逐字还原原诊断；文件路径按 `file_id` 临时切换，多文件模块也能报对文件名。
//
// 明确不做：不改 AST 结构、不做错误恢复、不一次报多个错误——首个错误即返回 -1，
// 与 parse 期行为等价。
// ============================================================================

// diag_file_at：在指定文件的 (line,col) 报告一个值内核错误码，返回 -1。
// 只临时切换 `src_ctx().path`（其余诊断状态不动），保证与 parse 期渲染一致。
fn diag_file_at(file_id int, line int, col int, code int) int {
    let saved *char = support.src_ctx().path
    if (file_id >= 0 && file_id < proj.file_count()) {
        let path *char = proj.pool_str(proj.file(file_id).path_off)
        if (path != 0) { support.src_ctx().path = path }
    }
    let status int = errors.err_lc(line, col, table.vk_msg(code))
    support.src_ctx().path = saved
    return status
}

// tok_line_at / tok_col_at：读指定文件第 index 个 token 的行/列；越界返回 0。
// 不切换 token 表，直接按项目文件快照取值（多文件模块下 AST 节点可能属于别的文件）。
fn tok_line_at(file_id int, index int) int {
    if (file_id < 0 || file_id >= proj.file_count()) { return 0 }
    let n int = proj.file(file_id).token_n
    if (index < 0 || index >= n) { return 0 }
    return proj.file(file_id).tokens[index].line
}

fn tok_col_at(file_id int, index int) int {
    if (file_id < 0 || file_id >= proj.file_count()) { return 0 }
    let n int = proj.file(file_id).token_n
    if (index < 0 || index >= n) { return 0 }
    return proj.file(file_id).tokens[index].col
}

