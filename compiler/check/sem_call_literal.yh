module check
import token
import gen
import support

// ============================================================================
// sem_call_literal.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_call_begin(callee *support.Res) int {
    if (support.session().compile == 0) {
        return 1
    }
    // 嵌套调用：记录本层实参基线与直接调用标志（内层不污染外层）
    if (support.fc().c_call_depth >= 64) {
        return token.err_tok("调用嵌套过深")
    }
    support.fc().c_call_base[support.fc().c_call_depth] = support.fc().c_arg_n
    support.fc().c_call_direct[support.fc().c_call_depth] = 0
    support.fc().c_call_abi[support.fc().c_call_depth] = support.ABI_YH
    if (support.ms().types[callee.type_id].kind == support.TY_FN) {
        support.fc().c_call_abi[support.fc().c_call_depth] = support.ms().sig_abi[support.ms().types[callee.type_id].sub]
    }
    support.fc().c_call_depth += 1
    if (callee.sym >= 0) {
        if (support.ms().syms[callee.sym].kind == support.SYM_FN) {
            support.fc().c_call_direct[support.fc().c_call_depth - 1] = 1
            return 1
        }
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("函数调用不是编译期常量")
    }
    return 0
}

// sem_push_arg：每个实参求值后立即保存标量或按值聚合副本，后续实参不能改变已求值的值。
// callee 提供形参类型；数组退化为指针时仍保存原地址，切片副本只复制描述符、不复制元素。
pub fn sem_push_arg(r *support.Res, callee *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_arg_n >= 256) {
        return token.err_tok("实参过多")
    }
    sem_res_copy(&support.fc().c_args[support.fc().c_arg_n], r)
    support.fc().c_argtys[support.fc().c_arg_n] = r.type_id
    support.fc().c_arg_n += 1
    if (support.fc().c_fold != 0) {
        return 0
    }
    let kind int = support.ms().types[r.type_id].kind
    let copy int = 0
    if (support.fc().c_call_depth > 0) {
        let depth int = support.fc().c_call_depth - 1
        if (support.fc().c_call_abi[depth] == support.ABI_C && (kind == support.TY_STRUCT || kind == support.TY_UNION)) {
            copy = 1
        }
        if (support.ms().types[callee.type_id].kind == support.TY_FN) {
            let sig int = support.ms().types[callee.type_id].sub
            let position int = support.fc().c_arg_n - support.fc().c_call_base[depth] - 1
            if (position < support.ms().sig_np[sig]) {
                let want int = support.ms().sig_params[support.ms().sig_first[sig] + position]
                if (support.ms().types[want].kind == kind
                    && (kind == support.TY_ARRAY || kind == support.TY_SLICE || kind == support.TY_STRUCT || kind == support.TY_UNION)) {
                    copy = 1
                }
            }
        }
    }
    return sem_push_value(r)
}

// sem_call：检查本层实参并发射调用。整数与浮点寄存器独立编号，
// 混合实参先全部暂存，再分类装载，保证每个值栈槽只消费一次。
pub fn sem_call(callee *support.Res, r *support.Res) int {
    if (support.session().compile == 0) {
        sem_res_reset(r, 0)
        return 0
    }
    if (support.ms().types[callee.type_id].kind != support.TY_FN) {
        return token.err_tok("被调用的表达式不是函数")
    }
    support.fc().c_call_depth -= 1
    let base int = support.fc().c_call_base[support.fc().c_call_depth]
    let direct int = support.fc().c_call_direct[support.fc().c_call_depth]
    let sig int = support.ms().types[callee.type_id].sub
    let np int = support.ms().sig_np[sig]
    let vararg int = support.ms().sig_vararg[sig]
    let ret int = support.ms().sig_ret[sig]
    let na int = support.fc().c_arg_n - base
    let noreturn int = 0
    if (direct != 0 && callee.sym >= 0
        && (support.ms().syms[callee.sym].flags & support.F_NORETURN) != 0) {
        noreturn = 1
    }
    // vararg==2：类型化变参（末尾打包为切片）；==1：裸 C 变参（仅 prelude）
    if (vararg == 2) {
        if (na < np) {
            return token.err_tok("实参个数少于固定参数")
        }
    } else if (na < np || (na > np && vararg == 0)) {
        return token.err_tok("实参个数与函数签名不符")
    }
    // 实参类型检查
    let first int = support.ms().sig_first[sig]
    let i int = 0
    for i < na {
        let want int = 0
        if (i < np) {
            want = support.ms().sig_params[first + i]
        } else {
            want = -1
        }
        if (want >= 0) {
            // C ABI 回调的函数类型必须保存 C 调用约定；直接函数、变量、
            // 返回值和字段均按完整签名检查，普通 yh 函数不能穿过边界。
            if (support.ms().types[want].kind == support.TY_FN && support.ms().sig_abi[sig] == support.ABI_C) {
                let arg_tid int = support.fc().c_args[base + i].type_id
                if (support.ms().types[arg_tid].kind != support.TY_FN
                    || support.ms().sig_abi[support.ms().types[arg_tid].sub] != support.ABI_C) {
                    return token.err_tok("C ABI 回调实参必须是 extern 函数")
                }
            }
            // 数组实参按指针形参退化
            let wat int = support.fc().c_args[base + i].type_id
            if (support.ms().types[wat].kind == support.TY_ARRAY && support.ms().types[want].kind == support.TY_PTR) {
                if (support.ms().types[wat].elem != support.ms().types[want].elem && support.ms().types[want].elem != support.TY_VOID) {
                    return token.err_tok("数组元素类型与指针形参不匹配")
                }
                i += 1
                continue
            }
            // 切片实参按切片形参（同元素类型；长度不参与相容判断）
            if (support.ms().types[wat].kind == support.TY_SLICE && support.ms().types[want].kind == support.TY_SLICE) {
                if (support.ms().types[wat].elem != support.ms().types[want].elem && support.ms().types[want].elem != support.TY_VOID) {
                    return token.err_tok("切片元素类型不匹配")
                }
                i += 1
                continue
            }
            if (gen.sem_can_assign(want, wat, support.fc().c_args[base + i].is_lit, support.fc().c_args[base + i].ival, support.fc().c_args[base + i].lit_big) != 0) {
                return -1
            }
        } else if (vararg == 2) {
            // 类型化变参：尾部实参类型须与元素类型相容
            let velem_t int = support.ms().types[support.ms().sig_params[first + np]].elem
            if (gen.sem_can_assign(velem_t, support.fc().c_args[base + i].type_id, support.fc().c_args[base + i].is_lit, support.fc().c_args[base + i].ival, support.fc().c_args[base + i].lit_big) != 0) {
                return -1
            }
        } else {
            // 裸变参位置：整数/指针按 C 提升进寄存器
            let at2 int = support.fc().c_args[base + i].type_id
            let k2 int = support.ms().types[at2].kind
            if (support.ty_is_float(at2) != 0) {
                return token.err_tok("裸变参的浮点实参将在 B7 支持")
            }
            if (k2 == support.TY_STRUCT || k2 == support.TY_UNION || k2 == support.TY_ARRAY || k2 == support.TY_SLICE) {
                return token.err_tok("聚合类型不能传给裸变参")
            }
        }
        i += 1
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("函数调用不是编译期常量")
    }
    if (support.ms().sig_abi[sig] == support.ABI_C) {
        // LL12：C ABI 的寄存器/栈搬运由 lowering 处理，语义层只记录结果形态。
        let ret_c int = support.ms().sig_ret[sig]
        let ret_agg_c int = (support.ms().types[ret_c].kind == support.TY_STRUCT
            || support.ms().types[ret_c].kind == support.TY_UNION).to_type(int)
        support.fc().c_arg_n = base
        sem_res_reset(r, ret_c)
        support.fc().c_res_is_addr = ret_agg_c
        // noreturn 的 C 调用仍是不可达边界，可达性判定必须保留。
        if (noreturn != 0) { support.fc().c_expr_noreturn = 1 }
        return 0
    }
    // 类型化变参：尾部实参打包为切片参数（数据由 lowering 生成）。
    let na2 int = na
    if (vararg == 2) {
        let vslice int = support.ms().sig_params[first + np]
        // 尾部已变成切片参数，后续分类不能沿用第一个浮点变参的类型。
        support.fc().c_args[base + np].type_id = vslice
        na2 = np + 1
    }
    // LL12：寄存器/栈实参与调用指令由 lowering 生成，这里保留浮点上限诊断。
    let regn int = na2
    if (support.tg_darwin() != 0 && vararg == 1 && na2 > np) { regn = np }
    let nfp int = 0
    let k int = base
    for k < base + regn {
        if (support.ty_is_float(support.fc().c_args[k].type_id) != 0) { nfp += 1 }
        k += 1
    }
    if (nfp > support.TG_ARG_REGS) {
        return token.err_tok("过多的浮点参数暂不支持")
    }
    let retk int = support.ms().types[ret].kind
    if (noreturn != 0) { support.fc().c_expr_noreturn = 1 }
    support.fc().c_arg_n = base
    sem_res_reset(r, ret)
    support.fc().c_res_is_addr = (retk == support.TY_STRUCT || retk == support.TY_UNION
        || retk == support.TY_ARRAY || retk == support.TY_SLICE).to_type(int)
    return 0
}

pub fn sem_return_value(r *support.Res) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    // LL12：聚合返回的缓冲拷贝与 return 跳转由 lowering 生成，这里只保留事实。
    if (support.fc().c_ret_agg != 0) {
        support.fc().c_ret_agg_val = 1
    }
    return 0
}

pub fn sem_lit_field_lookup(tid int, start int, n int) int {
    return sem_field_lookup(tid, start, n)
}

pub fn sem_struct_lit_begin(tid int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.ty_is_opaque(tid) != 0) {
        return token.err_tok("不透明 C 类型不能构造实例")
    }
    // pub struct 一等化：字段一律公开，跨模块位置式构造不再检查字段 pub。
    if (support.fc().c_lit_depth >= 32) {
        return token.err_tok("结构体字面量嵌套过深")
    }
    let off int = 0
    // 保存外层字面量的定位状态，供嵌套字面量结束后恢复
    support.fc().c_lit_save_off[support.fc().c_lit_depth] = support.fc().c_lit_off
    support.fc().c_lit_save_tid[support.fc().c_lit_depth] = support.fc().c_lit_tid
    support.fc().c_lit_depth += 1
    support.fc().c_lit_off = off
    support.fc().c_lit_tid = tid
    return off
}

pub fn sem_struct_lit_field(tid int, fidx int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    let ftid int = support.ms().fields[fidx].type_id
    let foff int = support.ms().fields[fidx].offset
    let fk int = support.ms().types[ftid].kind
    if (gen.sem_can_assign(ftid, support.fc().c_lit_last_type, support.fc().c_lit_last_lit, support.fc().c_lit_last_ival, 0) != 0) {
        return -1
    }
    return 0
}

pub fn sem_struct_lit_end(tid int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    // 恢复外层字面量的定位状态；结果地址由 lowering 生成。
    support.fc().c_lit_depth -= 1
    support.fc().c_lit_off = support.fc().c_lit_save_off[support.fc().c_lit_depth]
    support.fc().c_lit_tid = support.fc().c_lit_save_tid[support.fc().c_lit_depth]
    return 0
}
