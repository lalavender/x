module check
import support
import token
import ast
import gen
import proj

// 本模块只读 AstView 借用的 arena；不修改、不释放 AST 或解析状态。

// check_expr：确认 AST 源范围、同文件子节点和后序编号完整。
fn check_expr(view *ast.AstView) int {
    let gs *gen.TaskCtx = gen.task()
    if (support.session().ast_capture == 0) {
        return 0
    }
    let i int = 0
    for i < view.expr_count {
        let node ast.AstExpr = view.expr_nodes[i]
        if (node.kind < ast.AST_EXPR_PRIMARY || node.kind > ast.AST_EXPR_CTFIELD
            || node.file_id < 0 || node.first < 0 || node.after < node.first
            || node.after > node.token_count || node.token_count <= 0) {
            return -1
        }
        if (node.kind != ast.AST_EXPR_ARG_LIST && node.kind != ast.AST_EXPR_STRUCT_FIELD
            && (node.type_id < 0 || node.type_id >= gs.t_type_n)) {
            return -1
        }
        if (node.file_id >= proj.ctx().file_n || node.owner_decl < 0
            || node.owner_decl >= proj.ctx().files[node.file_id].decl_n
            || (node.is_const != 0 && node.is_const != 1)
            || (node.is_lit != 0 && node.is_lit != 1)
            || (node.lit_big != 0 && node.lit_big != 1)) {
            return support.fail("内部错误：表达式 AST 绑定或常量事实无效")
        }
        if (node.layout_type_id < -1 || node.layout_type_id >= gs.t_type_n
            || (node.layout_type_id >= 0
                && (node.kind != ast.AST_EXPR_PRIMARY || node.op != token.TK_SIZEOF))) {
            return support.fail("内部错误：表达式 AST sizeof 布局依赖无效")
        }
        if (node.sym_id < -1 || node.binding_row < -1
            || (node.sym_id == -1
            && (node.sym_type_id != -1 || node.sym_kind != -1
                || node.sym_flags != 0 || node.sym_offset != 0
                || node.binding_row != -1))
            || (node.sym_id >= 0 && (node.sym_type_id < 0
                || node.sym_type_id >= gs.t_type_n
                || node.sym_kind < gen.SYM_VAR || node.sym_kind > gen.SYM_FN))) {
            return support.fail("内部错误：表达式 AST 符号快照无效")
        }
        if (node.binding_row >= 0 && (node.binding_row >= view.binding_count
            || view.bindings[node.binding_row].file_id != node.file_id
            || view.bindings[node.binding_row].owner_decl != node.owner_decl
            || view.bindings[node.binding_row].sym_id != node.sym_id
            || view.bindings[node.binding_row].sym_type_id != node.sym_type_id
            || view.bindings[node.binding_row].sym_kind != node.sym_kind
            || view.bindings[node.binding_row].sym_flags != node.sym_flags
            || view.bindings[node.binding_row].sym_offset != node.sym_offset)) {
            return support.fail("内部错误：表达式 AST 局部绑定行无效")
        }
        if (node.sym_id >= 0 && (node.sym_kind == gen.SYM_VAR || node.sym_kind == gen.SYM_CONST)
            && (node.sym_flags & gen.F_GLOBAL) == 0 && node.binding_row < 0) {
            return support.fail("内部错误：局部变量表达式缺少稳定绑定行")
        }
        if (node.kind == ast.AST_EXPR_PRIMARY && node.sym_id >= 0
            && node.sym_type_id != node.type_id) {
            return support.fail("内部错误：基本表达式绑定类型与符号类型不匹配")
        }
        if ((node.kind == ast.AST_EXPR_ARG_LIST || node.kind == ast.AST_EXPR_STRUCT_FIELD)
            && node.type_id != -1) {
            return -1
        }
        if ((node.kind == ast.AST_EXPR_ARG_LIST || node.kind == ast.AST_EXPR_STRUCT_FIELD)
            && (node.sym_id != -1 || node.sym_type_id != -1 || node.sym_kind != -1
                || node.sym_flags != 0 || node.sym_offset != 0 || node.binding_row != -1
                || node.is_const != 0 || node.const_bits != 0
                || node.is_lit != 0 || node.lit_big != 0 || node.fval_bits != 0
                || node.layout_type_id != -1)) {
            return support.fail("内部错误：复合表达式链 AST 带有不应存在的语义事实")
        }
        if (node.kind == ast.AST_EXPR_STRUCT_FIELD
            && (node.op < 0 || node.child1 < 0 || node.child2 >= 0)) {
            return support.fail("内部错误：结构体字段初始化 AST 形态无效")
        }
        if (node.kind == ast.AST_EXPR_STRUCT_INIT
            && (node.child0 < 0 || node.child1 >= 0 || node.child2 >= 0
                || (gs.t_types[node.type_id].kind != gen.TY_STRUCT
                    && gs.t_types[node.type_id].kind != gen.TY_UNION))) {
            return support.fail("内部错误：结构体/联合体初始化 AST 形态无效")
        }
        let j int = 0
        for j < 3 {
            let child int = -1
            if (j == 0) { child = node.child0 }
            if (j == 1) { child = node.child1 }
            if (j == 2) { child = node.child2 }
            if (child >= i || child < -1) {
                return -1
            }
            if (child >= 0 && (view.expr_nodes[child].file_id != node.file_id
                || view.expr_nodes[child].first < node.first
                || view.expr_nodes[child].after > node.after)) {
                return -1
            }
            j += 1
        }
        i += 1
    }
    return 0
}

// check_stmt：检查父子树、根链、表达式边与源码区间的一致性。
fn check_stmt(view *ast.AstView) int {
    let gs *gen.TaskCtx = gen.task()
    if (support.session().ast_capture == 0) {
        return 0
    }
    if (view.stmt_current != -1 || view.expr_parse_depth != 0) {
        return support.fail("内部错误：语句 AST 解析栈未归零")
    }
    let i int = 0
    for i < view.stmt_count {
        let node ast.AstStmt = view.stmt_nodes[i]
        if (node.kind < ast.AST_STMT_BLOCK || node.kind > ast.AST_STMT_COMPTIME
            || node.file_id < 0 || node.first < 0 || node.after < node.first
            || node.after > node.token_count || node.token_count <= 0
            || node.parent >= i || node.parent < -1) {
            return support.fail("内部错误：语句 AST 节点或父节点无效")
        }
        if (node.kind == ast.AST_STMT_ASSIGN && token.is_assign_op(node.op) == 0) {
            return support.fail("内部错误：赋值 AST 未保存赋值运算符")
        }
        if (node.parent >= 0 && (view.stmt_nodes[node.parent].file_id != node.file_id
            || node.first < view.stmt_nodes[node.parent].first
            || node.after > view.stmt_nodes[node.parent].after)) {
            return support.fail("内部错误：语句 AST 子节点超出父节点范围")
        }
        let child int = node.first_child
        let previous int = -1
        let last int = -1
        let seen int = 0
        for child >= 0 {
            if (child >= view.stmt_count || view.stmt_nodes[child].parent != i
                || child <= previous || view.stmt_nodes[child].file_id != node.file_id) {
                return support.fail("内部错误：语句 AST 子节点链损坏")
            }
            previous = child
            last = child
            child = view.stmt_nodes[child].next_sibling
            seen += 1
            if (seen > view.stmt_count) { return support.fail("内部错误：语句 AST 子节点环") }
        }
        if (last != node.last_child || ((node.first_child < 0) != (node.last_child < 0))) {
            return support.fail("内部错误：语句 AST 首末子节点不匹配")
        }
        let edge int = node.first_expr
        let prior_edge int = -1
        let edge_last int = -1
        let edge_seen int = 0
        for edge >= 0 {
            if (edge >= view.stmt_expr_count || edge <= prior_edge) {
                return support.fail("内部错误：语句 AST 表达式边链损坏")
            }
            let expr_id int = view.stmt_exprs[edge].expr_id
            if (expr_id < 0 || expr_id >= view.expr_count
                || view.expr_nodes[expr_id].file_id != node.file_id
                || view.expr_nodes[expr_id].first < node.first
                || view.expr_nodes[expr_id].after > node.after) {
                return support.fail("内部错误：语句 AST 表达式不在语句范围内")
            }
            prior_edge = edge
            edge_last = edge
            edge = view.stmt_exprs[edge].next
            edge_seen += 1
            if (edge_seen > view.stmt_expr_count) {
                return support.fail("内部错误：语句 AST 表达式边环")
            }
        }
        if (edge_last != node.last_expr || ((node.first_expr < 0) != (node.last_expr < 0))) {
            return support.fail("内部错误：语句 AST 首末表达式边不匹配")
        }
        edge = node.first_binding
        prior_edge = -1
        edge_last = -1
        edge_seen = 0
        for edge >= 0 {
            if (edge >= view.binding_count || edge <= prior_edge
                || view.bindings[edge].stmt_id != i
                || view.bindings[edge].file_id != node.file_id
                || view.bindings[edge].name_token < node.first
                || view.bindings[edge].name_token >= node.after) {
                return support.fail("内部错误：语句 AST 绑定边链损坏")
            }
            prior_edge = edge
            edge_last = edge
            edge = view.bindings[edge].next
            edge_seen += 1
            if (edge_seen > view.binding_count) {
                return support.fail("内部错误：语句 AST 绑定边成环")
            }
        }
        if (edge_last != node.last_binding
            || ((node.first_binding < 0) != (node.last_binding < 0))) {
            return support.fail("内部错误：语句 AST 首末绑定边不匹配")
        }
        i += 1
    }
    let root int = view.stmt_root_first
    let prior_root int = -1
    let roots int = 0
    for root >= 0 {
        if (root >= view.stmt_count || view.stmt_nodes[root].parent != -1 || root <= prior_root) {
            return support.fail("内部错误：语句 AST 根链损坏")
        }
        prior_root = root
        root = view.stmt_nodes[root].root_next
        roots += 1
        if (roots > view.stmt_count) { return support.fail("内部错误：语句 AST 根链成环") }
    }
    if ((view.stmt_root_first < 0) != (view.stmt_root_last < 0)
        || prior_root != view.stmt_root_last) {
        return support.fail("内部错误：语句 AST 首末根节点不匹配")
    }
    let bi int = 0
    let previous_file int = -1
    let previous_decl int = -1
    let previous_id int = -1
    for bi < view.binding_count {
        let binding ast.AstBinding = view.bindings[bi]
        if (binding.id < 0 || binding.sym_id < 0 || binding.sym_type_id < 0
            || binding.sym_type_id >= gs.t_type_n
            || (binding.sym_kind != gen.SYM_VAR && binding.sym_kind != gen.SYM_CONST)
            || binding.file_id < 0 || binding.file_id >= proj.ctx().file_n
            || binding.owner_decl < 0
            || binding.owner_decl >= proj.ctx().files[binding.file_id].decl_n
            || (proj.ctx().files[binding.file_id].decls[binding.owner_decl].kind
                != token.TK_FN
                && proj.ctx().files[binding.file_id].decls[binding.owner_decl].kind
                != token.TK_TEST)
            || binding.name_token < proj.ctx().files[binding.file_id].decls[binding.owner_decl].start
            || binding.name_token >= proj.ctx().files[binding.file_id].decls[binding.owner_decl].end
            || proj.ctx().files[binding.file_id].tokens[binding.name_token].kind != token.TOK_IDENT
            || (binding.is_param != 0 && binding.is_param != 1)
            || (binding.is_param != 0 && (binding.stmt_id != -1
                || (binding.sym_flags & gen.F_PARAM) == 0))
            || (binding.is_param == 0 && (binding.stmt_id < 0
                || binding.stmt_id >= view.stmt_count))) {
            return support.fail("内部错误：函数局部绑定 AST 行无效")
        }
        if (binding.file_id == previous_file && binding.owner_decl == previous_decl) {
            if (binding.id != previous_id + 1) {
                return support.fail("内部错误：函数局部绑定编号不连续")
            }
        } else if (binding.id != 0) {
            return support.fail("内部错误：函数局部绑定编号未从零开始")
        }
        previous_file = binding.file_id
        previous_decl = binding.owner_decl
        previous_id = binding.id
        bi += 1
    }
    let ci int = 0
    for ci < view.comptime_for_count {
        let item ast.AstComptimeFor = view.comptime_fors[ci]
        if (item.stmt_id < 0 || item.stmt_id >= view.stmt_count
            || item.binding_row < 0 || item.binding_row >= view.binding_count
            || item.binding_after <= item.binding_row
            || item.binding_after > view.binding_count
            || item.body_stmt < 0 || item.body_stmt >= view.stmt_count
            || item.low >= item.high || item.node_cost < item.binding_after - item.binding_row) {
            return support.fail("内部错误：编译期 `$for` AST 模板范围损坏")
        }
        let wrapper ast.AstStmt = view.stmt_nodes[item.stmt_id]
        if (wrapper.kind != ast.AST_STMT_COMPTIME || wrapper.op != token.TK_FOR
            || wrapper.first_child != item.body_stmt || wrapper.last_child != item.body_stmt
            || view.stmt_nodes[item.body_stmt].parent != item.stmt_id
            || view.bindings[item.binding_row].stmt_id != item.stmt_id
            || view.bindings[item.binding_row].sym_kind != gen.SYM_CONST) {
            return support.fail("内部错误：编译期 `$for` AST 模板关联损坏")
        }
        ci += 1
    }
    return 0
}

// check_decl：检查声明范围、名字 token 及函数体根引用。
fn check_decl(view *ast.AstView) int {
    let tk *gen.TaskCtx = gen.task()
    if (support.session().ast_capture == 0) {
        return 0
    }
    let i int = 0
    for i < view.decl_count {
        let node ast.AstDecl = view.decl_nodes[i]
        if (node.file_id < 0 || node.first < 0 || node.after <= node.first
            || node.after > node.token_count || node.token_count <= 0
            || node.decl_index < 0 || (node.is_pub != 0 && node.is_pub != 1)) {
            return support.fail("内部错误：顶层声明 AST 范围无效")
        }
        if (node.name_token >= 0 && (node.name_token < node.first
            || node.name_token >= node.after)) {
            return support.fail("内部错误：顶层声明 AST 名字 token 越界")
        }
        if (node.kind == token.TK_TEST && node.sym_id < 0) {
            // 生产构建不登记 test 体函数：声明只有语法身份，没有符号/函数体。
            if (node.body_stmt != -1 || node.init_expr != -1) {
                return support.fail("内部错误：生产构建的 test 声明带有受检体")
            }
        } else if (node.kind == token.TK_FN || node.kind == token.TK_TEST) {
            if (node.sym_id < 0 || node.sym_id >= tk.c_sym_n
                || node.type_id < 0 || node.type_id >= tk.t_type_n
                || tk.c_syms[node.sym_id].kind != gen.SYM_FN
                || tk.c_syms[node.sym_id].type_id != node.type_id) {
                return support.fail("内部错误：函数声明 AST 未绑定到函数符号")
            }
            if ((tk.c_syms[node.sym_id].flags & gen.F_EXTERN) != 0) {
                if ((tk.c_syms[node.sym_id].flags & gen.F_CABI) == 0
                    || node.body_stmt != -1) {
                    return support.fail("内部错误：外部函数声明 AST 状态无效")
                }
            } else if (node.body_stmt < 0 || node.body_stmt >= view.stmt_count
                || view.stmt_nodes[node.body_stmt].kind != ast.AST_STMT_BLOCK
                || view.stmt_nodes[node.body_stmt].file_id != node.file_id
                || view.stmt_nodes[node.body_stmt].first < node.first
                || view.stmt_nodes[node.body_stmt].after > node.after) {
                return support.fail("内部错误：函数声明 AST 缺少函数体根")
            }
        } else if (node.body_stmt != -1) {
            return support.fail("内部错误：非函数声明 AST 带有函数体")
        }
        if (node.kind == token.TK_LET || node.kind == token.TK_CONST) {
            if (node.sym_id < 0 || node.sym_id >= tk.c_sym_n
                || (tk.c_syms[node.sym_id].flags & gen.F_GLOBAL) == 0
                || (tk.c_syms[node.sym_id].kind != gen.SYM_VAR
                    && tk.c_syms[node.sym_id].kind != gen.SYM_CONST)) {
                return support.fail("内部错误：全局声明 AST 未绑定到模块级符号")
            }
            if (node.init_expr >= 0 && (node.init_expr >= view.expr_count
                || view.expr_nodes[node.init_expr].file_id != node.file_id
                || view.expr_nodes[node.init_expr].owner_decl != node.decl_index
                || view.expr_nodes[node.init_expr].first < node.first
                || view.expr_nodes[node.init_expr].after > node.after)) {
                return support.fail("内部错误：全局声明 AST 初始化式引用无效")
            }
        } else if (node.init_expr != -1) {
            return support.fail("内部错误：非全局声明 AST 带有初始化式")
        }
        i += 1
    }
    return 0
}

// check_function：确认 arena 切片不重叠，且每条引用留在所属函数内。
fn check_function(view *ast.AstView) int {
    if (support.session().ast_capture == 0) { return 0 }
    if (view.function_active != 0 || view.function_count > view.function_cap) {
        return support.fail("内部错误：函数 AST 上下文未封存")
    }
    let i int = 0
    for i < view.function_count {
        let ctx ast.AstFunctionContext = view.function_nodes[i]
        if (ctx.file_id < 0 || ctx.file_id >= proj.ctx().file_n || ctx.owner_decl < 0
            || ctx.owner_decl >= proj.ctx().files[ctx.file_id].decl_n
            || ctx.decl_row < 0 || ctx.decl_row >= view.decl_count
            || ctx.expr_first < 0 || ctx.expr_after < ctx.expr_first
            || ctx.expr_after > view.expr_count || ctx.stmt_first < 0
            || ctx.stmt_after <= ctx.stmt_first || ctx.stmt_after > view.stmt_count
            || ctx.edge_first < 0 || ctx.edge_after < ctx.edge_first
            || ctx.edge_after > view.stmt_expr_count || ctx.binding_first < 0
            || ctx.binding_after < ctx.binding_first
            || ctx.binding_after > view.binding_count || ctx.asm_first < 0
            || ctx.asm_after < ctx.asm_first
            || ctx.body_stmt < ctx.stmt_first || ctx.body_stmt >= ctx.stmt_after) {
            return support.fail("内部错误：函数 AST arena 范围无效")
        }
        let decl ast.AstDecl = view.decl_nodes[ctx.decl_row]
        if ((decl.kind != token.TK_FN && decl.kind != token.TK_TEST)
            || decl.file_id != ctx.file_id
            || decl.decl_index != ctx.owner_decl || decl.first != ctx.token_first
            || decl.after != ctx.token_after || decl.body_stmt != ctx.body_stmt
            || view.stmt_nodes[ctx.body_stmt].kind != ast.AST_STMT_BLOCK
            || view.stmt_nodes[ctx.body_stmt].parent != -1) {
            return support.fail("内部错误：函数 AST 声明与上下文不匹配")
        }
        if (i > 0) {
            let prev ast.AstFunctionContext = view.function_nodes[i - 1]
            if (ctx.expr_first < prev.expr_after || ctx.stmt_first < prev.stmt_after
                || ctx.edge_first < prev.edge_after
                || ctx.binding_first < prev.binding_after
                || ctx.asm_first < prev.asm_after) {
                return support.fail("内部错误：函数 AST arena 切片互相重叠")
            }
        }
        let ei int = ctx.expr_first
        for ei < ctx.expr_after {
            let expr ast.AstExpr = view.expr_nodes[ei]
            if (expr.file_id != ctx.file_id || expr.owner_decl != ctx.owner_decl
                || expr.first < ctx.token_first || expr.after > ctx.token_after
                || (expr.child0 >= 0 && (expr.child0 < ctx.expr_first
                    || expr.child0 >= ctx.expr_after))
                || (expr.child1 >= 0 && (expr.child1 < ctx.expr_first
                    || expr.child1 >= ctx.expr_after))
                || (expr.child2 >= 0 && (expr.child2 < ctx.expr_first
                    || expr.child2 >= ctx.expr_after))
                || (expr.binding_row >= 0 && (expr.binding_row < ctx.binding_first
                    || expr.binding_row >= ctx.binding_after))) {
                return support.fail("内部错误：函数表达式越出所属上下文")
            }
            ei += 1
        }
        let si int = ctx.stmt_first
        for si < ctx.stmt_after {
            let stmt ast.AstStmt = view.stmt_nodes[si]
            if (stmt.file_id != ctx.file_id || stmt.first < ctx.token_first
                || stmt.after > ctx.token_after
                || (stmt.parent >= 0 && (stmt.parent < ctx.stmt_first
                    || stmt.parent >= ctx.stmt_after))
                || (stmt.first_expr >= 0 && (stmt.first_expr < ctx.edge_first
                    || stmt.first_expr >= ctx.edge_after))
                || (stmt.last_expr >= 0 && (stmt.last_expr < ctx.edge_first
                    || stmt.last_expr >= ctx.edge_after))
                || (stmt.first_binding >= 0 && (stmt.first_binding < ctx.binding_first
                    || stmt.first_binding >= ctx.binding_after))
                || (stmt.last_binding >= 0 && (stmt.last_binding < ctx.binding_first
                    || stmt.last_binding >= ctx.binding_after))) {
                return support.fail("内部错误：函数语句越出所属上下文")
            }
            si += 1
        }
        let edge int = ctx.edge_first
        for edge < ctx.edge_after {
            if (view.stmt_exprs[edge].expr_id < ctx.expr_first
                || view.stmt_exprs[edge].expr_id >= ctx.expr_after) {
                return support.fail("内部错误：函数语句表达式边越出所属上下文")
            }
            edge += 1
        }
        let bi int = ctx.binding_first
        for bi < ctx.binding_after {
            let binding ast.AstBinding = view.bindings[bi]
            if (binding.file_id != ctx.file_id || binding.owner_decl != ctx.owner_decl
                || binding.id != bi - ctx.binding_first
                || (binding.stmt_id >= 0 && (binding.stmt_id < ctx.stmt_first
                    || binding.stmt_id >= ctx.stmt_after))) {
                return support.fail("内部错误：函数绑定越出所属上下文")
            }
            bi += 1
        }
        i += 1
    }
    return 0
}
// verify_module：按表达式、语句、声明、函数顺序校验一份已捕获 AST。
// 返回 0 表示成功；1/2/3/4 分别表示对应阶段失败，供 cmd 保留原外层诊断。
// 捕获关闭时直接成功。view 及其中的 arena 在调用期间必须保持有效且只读。
pub fn verify_module(view *ast.AstView) int {
    if (support.session().ast_capture == 0) { return 0 }
    if (check_expr(view) != 0) { return 1 }
    if (check_stmt(view) != 0) { return 2 }
    if (check_decl(view) != 0) { return 3 }
    if (check_function(view) != 0) { return 4 }
    return 0
}
