module check

import support
import token
import ast
import ir
import proj
import cache
import comptime
// ============================================================================
// api.yh —— check 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// CheckedModule：语义遍历完成后的模块所有者，storage 独占受检表与只读源码副本。
// 必须以零初始化对象调用 capture；拥有者不能按值复制，读取副本须经有界访问入口。
// 使用快照 lowering 前，调用方须通过 check 校验且保证之后不修改；target 字符串为静态常量。
pub struct CheckedModule {
    target support.TargetInfo
    storage *void
}

// CheckedFunction：独立的受检函数身份和 AST 范围，不保存旧汇编缓冲的字节区间。
pub struct CheckedFunction {
    file_id int
    owner_decl int
    decl_row int
    token_first int
    token_after int
    expr_first int
    expr_after int
    stmt_first int
    stmt_after int
    edge_first int
    edge_after int
    binding_first int
    binding_after int
    body_stmt int
}

// CheckedString：视图引用的字符串标签与名称池字节关系；不单独拥有名称池。
pub struct CheckedString {
    label int
    name_off int
    name_len int
    quoted int
}

// CheckedStaticData：视图引用的静态对象快照，不引用 GenState 或 CT arena。
// sym_id/label 仅为本次前端会话内的来源键；重定位目标同样以来源键表达，lowering
// 会在建立模块符号表时解析，绝不把标签整数当成运行期地址。
pub struct CheckedStaticData {
    sym_id int
    label int
    type_id int
    elem_type int
    count int
    size int
    align int
    data *u8
    relocs *support.StaticDataReloc
    reloc_n int
}

// CheckedStorage：所有 arena 与语义表均独立复制，原 ID 在快照内继续指向相同行。
// 文件、导入描述符内部的指针也拥有副本；不持有 GenState、旧输出或 CT 对象指针。
// 静态数据目录按值深拷贝；CT 聚合、切片 backing 和导入字面量都不保留宿主指针。
// 纯快照 lowering 的上下文（CheckedFlow/CheckedLower）依赖本类型，按模块
// 「类型先声明后使用 + 文件名序编译」的约束放在 check/checked_model.yh。
pub struct CheckedStorage {
    expressions *ast.AstExpr
    expression_n int
    statements *ast.AstStmt
    statement_n int
    edges *ast.AstStmtExpr
    edge_n int
    bindings *ast.AstBinding
    binding_n int
    templates *ast.AstComptimeFor
    template_n int
    declarations *ast.AstDecl
    declaration_n int
    functions *CheckedFunction
    function_n int
    types *support.CType
    type_n int
    fields *support.SField
    field_n int
    type_names *support.TName
    type_name_n int
    type_home *int
    sig_abi *int
    sig_ret *int
    sig_np *int
    sig_vararg *int
    sig_first *int
    sig_n int
    sig_params *int
    sig_param_n int
    symbols *support.CSym
    symbol_n int
    names *u8
    name_n int
    files *proj.PFile
    file_n int
    imports *support.ModInfo
    import_n int
    bss_symbols *int
    bss_n int
    strings *CheckedString
    string_n int
    static_data *CheckedStaticData
    static_data_n int
    suffix_off int
    suffix_len int
    is_entry int
}

// CheckedModuleView：供 check 只读验证快照的借用视图，不拥有任何表或嵌套数据。
// 视图只在 CheckedModule 所有者保持有效且未修改时使用；release 后立即失效。
pub struct CheckedModuleView {
    target support.TargetInfo
    expressions *ast.AstExpr
    expression_n int
    statements *ast.AstStmt
    statement_n int
    edges *ast.AstStmtExpr
    edge_n int
    bindings *ast.AstBinding
    binding_n int
    templates *ast.AstComptimeFor
    template_n int
    declarations *ast.AstDecl
    declaration_n int
    functions *CheckedFunction
    function_n int
    types *support.CType
    type_n int
    fields *support.SField
    field_n int
    type_names *support.TName
    type_name_n int
    type_home *int
    sig_abi *int
    sig_ret *int
    sig_np *int
    sig_vararg *int
    sig_first *int
    sig_n int
    sig_params *int
    sig_param_n int
    symbols *support.CSym
    symbol_n int
    names *u8
    name_n int
    files *proj.PFile
    file_n int
    imports *support.ModInfo
    import_n int
    bss_symbols *int
    bss_n int
    strings *CheckedString
    string_n int
    static_data *CheckedStaticData
    static_data_n int
    suffix_off int
    suffix_len int
    is_entry int
}

// IfaceCtTokPosition：保存临时改写过的 sidecar token 行列，支持第二遍重解析。
pub struct IfaceCtTokPosition {
    index int
    line int
    col int
}

pub const IFACE_VERSION_MIN int = 1

pub const IFACE_VERSION_MAX int = 3

pub const CTIFACE_VERSION int = 1

// abi_c_cursor_init：开始一份独立签名分类，调用方显式指定目标平台。
pub fn abi_c_cursor_init(c *support.ABICursor, darwin int) void {
    c.gpr = 0
    c.fpr = 0
    c.stack = 0
    c.darwin = darwin
}

// abi_c_place：按 AAPCS64/Apple arm64 固定参数规则分配一个值。
// HFA 先于大聚合处理；HFA/GPR 聚合均不拆分到寄存器与栈。
pub fn abi_c_place(v *support.ABIValue, c *support.ABICursor, out *support.ABIArg) void {
    out.kind = support.CABI_VOID
    out.reg = 0
    out.count = 0
    out.stack = 0
    out.indirect = 0
    out.size = v.size
    out.fp_size = v.fp_size
    if (v.size == 0) { return }
    let size int = v.size
    let align int = v.align
    if (v.fp_count > 0) {
        if (c.fpr + v.fp_count <= 8) {
            out.kind = support.CABI_FPR
            out.reg = c.fpr
            out.count = v.fp_count
            c.fpr += v.fp_count
            return
        }
        c.fpr = 8
    } else {
        if (v.aggregate != 0 && size > 16) {
            out.indirect = 1
            size = 8
            align = 8
        }
        let count int = (size + 7) / 8
        if (align >= 16 && c.darwin == 0) { c.gpr = (c.gpr + 1) / 2 * 2 }
        if (c.gpr + count <= 8) {
            out.kind = support.CABI_GPR
            out.reg = c.gpr
            out.count = count
            c.gpr += count
            return
        }
        c.gpr = 8
    }
    if (c.darwin == 0) {
        if (align < 8) { align = 8 }
        size = (size + 7) / 8 * 8
    }
    c.stack = (c.stack + align - 1) / align * align
    out.kind = support.CABI_STACK
    out.stack = c.stack
    c.stack += size
}

// checked_pdecl_decl_row：把文件内 PDecl 下标映射为 ast_decl_nodes 行。
pub fn checked_pdecl_decl_row(file_id int, pdecl_index int) int {
    let v ast.AstView
    ast.ast_view(&v)
    if (file_id < 0 || file_id >= v.decl_file_cap || v.decl_file_first == 0
        || v.decl_file_first[file_id] < 0) { return -1 }
    let row int = v.decl_file_first[file_id] + pdecl_index
    if (row < 0 || row >= v.decl_count
        || v.decl_nodes[row].file_id != file_id
        || v.decl_nodes[row].decl_index != pdecl_index) { return -1 }
    return row
}

// checked_gen_function_key：pass2b 前的函数 check 键；成功返回 0 并写 out。
// 输出是 64 位十六进制 + 结尾零（CACHE_ID_TEXT 字节）。
pub fn checked_gen_function_key(decl_row int, out *u8) int {
    let v ast.AstView
    ast.ast_view(&v)
    if (out == 0 || decl_row < 0 || decl_row >= v.decl_count) { return -1 }
    let decl ast.AstDecl = v.decl_nodes[decl_row]
    if (decl.kind != token.TK_FN || decl.file_id < 0
        || decl.file_id >= proj.file_count()) { return -1 }
    let rel_path [1024]u8
    if (proj.file_rel_path(decl.file_id, &rel_path[0], 1024) < 0) { return -1 }
    let target_key int = ir.ir_target_key(proj.cfg().target.triple)
    if (target_key < 0) { return -1 }
    let file_p *proj.PFile = proj.file(decl.file_id)
    let file proj.PFile = file_p[0]
    let inputs cache.CacheInputs
    inputs.target_key = target_key
    inputs.pointer_bits = proj.cfg().target.pointer_bits
    inputs.layout_version = proj.cfg().target.layout_version
    inputs.abi = proj.cfg().target.abi
    inputs.opt_level = proj.module_opt_level(file.mod)
    inputs.trimpath = proj.cfg().trimpath
    let key cache.Key
    if (cache.key_init_function(&key, cache.ACTION_CHECK, checked_check_cache_env,
            &inputs, support.arr_cstr(&rel_path[0])) != 0) { return -1 }
    if (checked_gen_layout(&key) != 0) { return -1 }
    if (checked_gen_symbol_facts(&key) != 0) { return -1 }
    if (checked_gen_decl_facts(&key) != 0) { return -1 }
    if (checked_gen_mix_decl_tokens(decl, &key) != 0) { return -1 }
    return cache.key_finish_hex(&key, out)
}

// checked_zero_rows：分配零初始化描述符数组，使部分捕获失败也能按同一协议释放。
pub fn checked_zero_rows(count int, width int) *void {
    if (count <= 0 || width <= 0 || count > 2147483647 / width) { return 0 }
    let bytes int = count * width
    let result *u8 = malloc(bytes.to_type(u64)).to_type(*u8)
    if (result == 0) { return 0 }
    let i int = 0
    for i < bytes { result[i] = 0; i += 1 }
    return result.to_type(*void)
}

// checked_module_capture：封存成功语义遍历的独立副本，只执行安全复制，不检查快照一致性。
// 失败不改出参并回收部分副本；调用方须在读取或 lowering 前调用 check 校验。
// 不生成汇编，不要求 LLVM 存在；仅接受已启用 AST 收集且没有未完成函数的模块 worker。
pub fn checked_module_capture(out *CheckedModule) int {
    let v ast.AstView
    ast.ast_view(&v)
    if (out == 0 || out.storage != 0 || support.session().ast_capture == 0
        || support.diag().errors != 0 || v.function_active != 0) {
        return support.fail("受检模块捕获需要空所有者和已完成的语义检查")
    }
    let candidate CheckedModule
    if (proj.cfg().target.triple == 0
        || support.target_resolve(proj.cfg().target.triple, &candidate.target) != 0) {
        return support.fail("受检模块的完整目标身份无效")
    }
    let store *CheckedStorage = checked_zero_rows(1,
        sizeof(CheckedStorage)).to_type(*CheckedStorage)
    if (store == 0) { return support.fail("受检模块快照分配失败") }
    candidate.storage = store.to_type(*void)
    if (checked_storage_tables(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块语义表复制失败")
    }
    if (checked_storage_static_data(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块静态数据复制失败")
    }
    if (checked_storage_sources(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块源码与导入副本失败")
    }
    if (checked_storage_copy_ready(store) != 0) {
        checked_module_release(&candidate)
        return support.fail("受检模块快照表存储无效")
    }
    out[0] = candidate
    return 0
}

// checked_module_release：释放唯一所有者的所有嵌套副本，再清零句柄；同一对象可重复释放。
// 返回过的名称/源码只读指针到此失效；原 AST/GenState 的存储从未由此函数释放。
pub fn checked_module_release(unit *CheckedModule) void {
    if (unit == 0) { return }
    if (unit.storage != 0) {
        let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
        let i int = 0
        if (store.files != 0) {
            for i < store.file_n {
                free(store.files[i].source.to_type(*void))
                free(store.files[i].tokens.to_type(*void))
                free(store.files[i].decls.to_type(*void))
                i += 1
            }
        }
        i = 0
        if (store.imports != 0) {
            for i < store.import_n {
                free(store.imports[i].ns.to_type(*void))
                i += 1
            }
        }
        free(store.expressions.to_type(*void))
        free(store.statements.to_type(*void))
        free(store.edges.to_type(*void))
        free(store.bindings.to_type(*void))
        free(store.templates.to_type(*void))
        free(store.declarations.to_type(*void))
        free(store.functions.to_type(*void))
        free(store.types.to_type(*void))
        free(store.fields.to_type(*void))
        free(store.type_names.to_type(*void))
        free(store.type_home.to_type(*void))
        free(store.sig_abi.to_type(*void))
        free(store.sig_ret.to_type(*void))
        free(store.sig_np.to_type(*void))
        free(store.sig_vararg.to_type(*void))
        free(store.sig_first.to_type(*void))
        free(store.sig_params.to_type(*void))
        free(store.symbols.to_type(*void))
        free(store.names.to_type(*void))
        free(store.files.to_type(*void))
        free(store.imports.to_type(*void))
        free(store.bss_symbols.to_type(*void))
        free(store.strings.to_type(*void))
        if (store.static_data != 0) {
            let i int = 0
            for i < store.static_data_n {
                free(store.static_data[i].data.to_type(*void))
                free(store.static_data[i].relocs.to_type(*void))
                i += 1
            }
        }
        free(store.static_data.to_type(*void))
        free(store.to_type(*void))
    }
    let empty CheckedModule
    unit[0] = empty
}

// checked_module_function：返回函数描述符副本，0 成功、-1 空快照或越界，不转移所有权。
pub fn checked_module_function(unit *CheckedModule, row int, out *CheckedFunction) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.function_n) { return -1 }
    out[0] = store.functions[row]
    return 0
}

// checked_module_type：复制一个布局条目；类型 ID 只在该 CheckedModule 内有意义。
pub fn checked_module_type(unit *CheckedModule, row int, out *support.CType) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.type_n) { return -1 }
    out[0] = store.types[row]
    return 0
}

// checked_module_declaration：复制声明身份和类型/函数体关联，保留文件内稳定编号。
pub fn checked_module_declaration(unit *CheckedModule, row int, out *ast.AstDecl) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.declaration_n) { return -1 }
    out[0] = store.declarations[row]
    return 0
}

// checked_module_binding：复制参数/局部稳定绑定，供消费者避免已复用的语义符号槽。
pub fn checked_module_binding(unit *CheckedModule, row int, out *ast.AstBinding) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.binding_n) { return -1 }
    out[0] = store.bindings[row]
    return 0
}

// checked_module_expression：复用已有公开 CtExpr 布局给出副本，私有 ast.AstExpr 不泄漏进接口。
pub fn checked_module_expression(unit *CheckedModule, row int, out *comptime.CtExpr) int {
    if (unit == 0 || unit.storage == 0 || out == 0 || sizeof(ast.AstExpr) != sizeof(comptime.CtExpr)) {
        return -1
    }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.expression_n) { return -1 }
    memcpy(out, &store.expressions[row], sizeof(ast.AstExpr).to_type(u64))
    return 0
}

// checked_module_statement：复用公开 CtStmt 布局复制语句及其边号，不返回私有 arena 指针。
pub fn checked_module_statement(unit *CheckedModule, row int, out *comptime.CtStmt) int {
    if (unit == 0 || unit.storage == 0 || out == 0 || sizeof(ast.AstStmt) != sizeof(comptime.CtStmt)) {
        return -1
    }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.statement_n) { return -1 }
    memcpy(out, &store.statements[row], sizeof(ast.AstStmt).to_type(u64))
    return 0
}

// checked_module_edge：复制语句到表达式根的边，消费者可沿 next 有界遍历本快照。
pub fn checked_module_edge(unit *CheckedModule, row int, out *ast.AstStmtExpr) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (row < 0 || row >= store.edge_n) { return -1 }
    out[0] = store.edges[row]
    return 0
}

// checked_name_valid：确认名称偏移和长度完整落在快照名称池中，避免访问器越界读取。
pub fn checked_name_valid(store *CheckedStorage, off int, length int) int {
    if (store.names == 0 || off < 0 || length < 0 || off >= store.name_n
        || length >= store.name_n - off || store.names[off + length] != 0) { return 0 }
    return 1
}

// checked_module_name：返回快照自有名称池的只读借用；只在本所有者 release 之前有效。
// 长度不含结尾 NUL，越界或非完整池字符串返回 null。
pub fn checked_module_name(unit *CheckedModule, off int, length int) *char {
    if (unit == 0 || unit.storage == 0) { return 0 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (checked_name_valid(store, off, length) == 0) { return 0 }
    return (store.names + off).to_type(*char)
}

// checked_module_source：返回快照自有源码的只读借用，同时返回字节长度；release 后失效。
pub fn checked_module_source(unit *CheckedModule, file_id int, length *int) *u8 {
    if (unit == 0 || unit.storage == 0 || length == 0) { return 0 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (file_id < 0 || file_id >= store.file_n) { return 0 }
    *length = store.files[file_id].source_len
    return store.files[file_id].source
}

// checked_slice_capture：把快照中的一个函数编码为字节串。
// 成功返回 0 并交出 data/size；含模板或越界引用返回 1（跳过缓存）；内部错误 -1。
pub fn checked_slice_capture(unit *CheckedModule, function_index int,
    out_data **u8, out_size *int) int {
    if (unit == 0 || unit.storage == 0 || out_data == 0 || out_size == 0) {
        return -1
    }
    out_data[0] = 0; out_size[0] = 0
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    if (function_index < 0 || function_index >= store.function_n) { return -1 }
    let ctx CheckedFunction = store.functions[function_index]
    // CT 函数正文参与全局布局/CT 求值，初期不进入 check 缓存。
    if (ctx.decl_row >= 0 && ctx.decl_row < store.declaration_n) {
        let decl ast.AstDecl = store.declarations[ctx.decl_row]
        if (decl.sym_id >= 0 && decl.sym_id < store.symbol_n
            && (store.symbols[decl.sym_id].flags & support.F_COMPTIME) != 0) {
            return 1
        }
    }
    // v3：类型与静态数据不随记录携带 —— 只有「本函数没有新建」才允许复用切片。
    let snap_row int = ctx.decl_row
    if (snap_row < 0 || snap_row >= checked_check_keys_n
        || checked_check_type_first == 0 || checked_check_str_first == 0
        || checked_check_static_first == 0) { return 1 }
    let type_first int = checked_check_type_first[snap_row]
    let str_first int = checked_check_str_first[snap_row]
    let static_first int = checked_check_static_first[snap_row]
    if (type_first < 0 || str_first < 0 || static_first < 0
        || support.ty_count() != type_first
        || support.static_data_count() != static_first) { return 1 }
    let expr_n int = ctx.expr_after - ctx.expr_first
    let stmt_n int = ctx.stmt_after - ctx.stmt_first
    let edge_n int = ctx.edge_after - ctx.edge_first
    let binding_n int = ctx.binding_after - ctx.binding_first
    if (ctx.expr_first < 0 || ctx.expr_after > store.expression_n
        || ctx.stmt_first < 0 || ctx.stmt_after > store.statement_n
        || ctx.edge_first < 0 || ctx.edge_after > store.edge_n
        || ctx.binding_first < 0 || ctx.binding_after > store.binding_n) {
        return -1
    }
    if (checked_slice_validate(store, &ctx) != 0) { return 1 }
    // 字符串：本函数 expr 行引用到的数据标签（lowering 只用 expr.const_bits 查字符串），
    // 按标签去重后随记录携带；不依赖「哪个阶段登记」。
    let string_n int = 0
    let string_bytes int = 0
    let ei int = 0
    for ei < expr_n {
        let node ast.AstExpr = store.expressions[ctx.expr_first + ei]
        let slbl int = 0
        let soff int = 0
        let slen int = 0
        let squoted int = 0
        if (support.data_str_lookup(node.const_bits.to_type(int), &soff, &slen, &squoted) != 0
            && soff >= 0 && slen >= 0 && store.name_n - soff >= slen) {
            string_n += 1
            string_bytes += slen
        }
        ei += 1
    }
    if (ctx.file_id < 0 || ctx.file_id >= store.file_n) { return -1 }
    // 记录按项目相对路径保存：同源码搬目录后 check 切片仍能按当前文件找到。
    let rel_path [1024]u8
    let path_len int = proj.file_rel_path(ctx.file_id, &rel_path[0], 1024)
    if (path_len < 0) { return -1 }
    let path *char = support.arr_cstr(&rel_path[0])
    let path_size int = path_len + 1
    let symbol_used *u8 = malloc(store.symbol_n.to_type(u64)).to_type(*u8)
    let symbol_order *int = malloc((store.symbol_n * sizeof(int)).to_type(u64)).to_type(*int)
    if (symbol_used == 0 || symbol_order == 0) {
        if (symbol_used != 0) { free(symbol_used.to_type(*void)) }
        if (symbol_order != 0) { free(symbol_order.to_type(*void)) }
        return -1
    }
    let si_zero int = 0
    for si_zero < store.symbol_n { symbol_used[si_zero] = 0; si_zero += 1 }
    let symbol_n int = 0
    let symbol_name_bytes int = 0
    let symbol_status int = checked_slice_collect_symbols(store, &ctx, symbol_used,
        symbol_order, &symbol_n, &symbol_name_bytes)
    if (symbol_status != 0) {
        free(symbol_used.to_type(*void)); free(symbol_order.to_type(*void))
        return symbol_status
    }
    let size int = checked_slice_size(expr_n, stmt_n, edge_n, binding_n,
        symbol_n, symbol_name_bytes, string_n, string_bytes, path_size)
    if (size < 0 || size > CHECKED_SLICE_CACHE_MAX) {
        free(symbol_used.to_type(*void)); free(symbol_order.to_type(*void))
        return 1
    }
    let data *u8 = malloc(size.to_type(u64)).to_type(*u8)
    if (data == 0) { return -1 }
    let cursor int = 0
    checked_slice_put_u64(data, &cursor, CHECKED_SLICE_MAGIC)
    checked_slice_put_u64(data, &cursor, CHECKED_SLICE_VERSION.to_type(u64))
    checked_slice_put_int(data, &cursor, expr_n)
    checked_slice_put_int(data, &cursor, stmt_n)
    checked_slice_put_int(data, &cursor, edge_n)
    checked_slice_put_int(data, &cursor, binding_n)
    checked_slice_put_int(data, &cursor, symbol_n)
    checked_slice_put_int(data, &cursor, symbol_name_bytes)
    checked_slice_put_int(data, &cursor, path_size)
    checked_slice_put_int(data, &cursor, ctx.owner_decl)
    checked_slice_put_int(data, &cursor, ctx.decl_row)
    checked_slice_put_int(data, &cursor, ctx.token_first)
    checked_slice_put_int(data, &cursor, ctx.token_after)
    checked_slice_put_int(data, &cursor,
        checked_slice_loc(ctx.body_stmt, ctx.stmt_first, stmt_n))
    checked_slice_put_int(data, &cursor, string_n)
    checked_slice_put_int(data, &cursor, string_bytes)
    let i int = 0
    for i < path_size {
        data[cursor] = i < path_len ? path[i].to_type(u8) : 0
        cursor += 1
        i += 1
    }
    i = 0
    for i < expr_n {
        let node ast.AstExpr = store.expressions[ctx.expr_first + i]
        checked_slice_put_int(data, &cursor, node.kind)
        checked_slice_put_int(data, &cursor, node.op)
        checked_slice_put_int(data, &cursor, node.first)
        checked_slice_put_int(data, &cursor, node.after)
        checked_slice_put_int(data, &cursor, node.token_count)
        checked_slice_put_int(data, &cursor, node.file_id)
        checked_slice_put_int(data, &cursor, node.type_id)
        checked_slice_put_int(data, &cursor, node.owner_decl)
        let local_binding int = checked_slice_loc(node.binding_row,
            ctx.binding_first, binding_n)
        checked_slice_put_int(data, &cursor,
            local_binding >= 0 ? local_binding : node.sym_id)
        checked_slice_put_int(data, &cursor, node.sym_name_off)
        checked_slice_put_int(data, &cursor, node.sym_name_len)
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.binding_row, ctx.binding_first, binding_n))
        checked_slice_put_int(data, &cursor, node.sym_type_id)
        checked_slice_put_int(data, &cursor, node.sym_kind)
        checked_slice_put_int(data, &cursor, node.sym_flags)
        checked_slice_put_int(data, &cursor, node.sym_offset)
        checked_slice_put_int(data, &cursor, node.is_const)
        checked_slice_put_u64(data, &cursor, node.const_bits.to_type(u64))
        checked_slice_put_int(data, &cursor, node.is_lit)
        checked_slice_put_int(data, &cursor, node.lit_big)
        checked_slice_put_u64(data, &cursor, node.fval_bits.to_type(u64))
        checked_slice_put_int(data, &cursor, node.layout_type_id)
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.child0, ctx.expr_first, expr_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.child1, ctx.expr_first, expr_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.child2, ctx.expr_first, expr_n))
        i += 1
    }
    i = 0
    for i < stmt_n {
        let node ast.AstStmt = store.statements[ctx.stmt_first + i]
        checked_slice_put_int(data, &cursor, node.kind)
        checked_slice_put_int(data, &cursor, node.op)
        checked_slice_put_int(data, &cursor, node.first)
        checked_slice_put_int(data, &cursor, node.after)
        checked_slice_put_int(data, &cursor, node.token_count)
        checked_slice_put_int(data, &cursor, node.file_id)
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.parent, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.first_child, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.last_child, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.next_sibling, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_root_loc(node.root_next, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.first_expr, ctx.edge_first, edge_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.last_expr, ctx.edge_first, edge_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.first_binding, ctx.binding_first, binding_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(node.last_binding, ctx.binding_first, binding_n))
        i += 1
    }
    i = 0
    for i < edge_n {
        let edge ast.AstStmtExpr = store.edges[ctx.edge_first + i]
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(edge.expr_id, ctx.expr_first, expr_n))
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(edge.next, ctx.edge_first, edge_n))
        i += 1
    }
    i = 0
    for i < binding_n {
        let binding ast.AstBinding = store.bindings[ctx.binding_first + i]
        let bfile proj.PFile = store.files[binding.file_id]
        let btok token.Tok = bfile.tokens[binding.name_token]
        checked_slice_put_int(data, &cursor, binding.id)
        checked_slice_put_int(data, &cursor, binding.sym_id)
        checked_slice_put_int(data, &cursor, binding.sym_type_id)
        checked_slice_put_int(data, &cursor, binding.sym_kind)
        checked_slice_put_int(data, &cursor, binding.sym_flags)
        checked_slice_put_int(data, &cursor, binding.sym_offset)
        checked_slice_put_int(data, &cursor, binding.file_id)
        checked_slice_put_int(data, &cursor, binding.owner_decl)
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(binding.stmt_id, ctx.stmt_first, stmt_n))
        checked_slice_put_int(data, &cursor, binding.name_token)
        checked_slice_put_int(data, &cursor, binding.is_param)
        checked_slice_put_int(data, &cursor,
            checked_slice_loc(binding.next, ctx.binding_first, binding_n))
        i += 1
    }
    // 符号闭包：名字字节单独存放，导入时重新 intern 并追加局部符号。
    i = 0
    for i < symbol_n {
        let sym support.CSym = store.symbols[symbol_order[i]]
        checked_slice_put_int(data, &cursor, symbol_order[i])
        checked_slice_put_int(data, &cursor, sym.name_len)
        checked_slice_put_int(data, &cursor, sym.kind)
        checked_slice_put_int(data, &cursor, sym.type_id)
        checked_slice_put_int(data, &cursor, sym.offset)
        checked_slice_put_int(data, &cursor, sym.flags)
        checked_slice_put_u64(data, &cursor, sym.cval.to_type(u64))
        checked_slice_put_int(data, &cursor, sym.const_ready)
        checked_slice_put_int(data, &cursor, sym.const_expr_off)
        checked_slice_put_int(data, &cursor, sym.const_expr_len)
        checked_slice_put_int(data, &cursor, sym.const_expr_kind)
        checked_slice_put_int(data, &cursor, sym.def_line)
        checked_slice_put_int(data, &cursor, sym.def_col)
        checked_slice_put_int(data, &cursor, sym.ast_binding_row)
        let j int = 0
        for j < sym.name_len {
            data[cursor] = store.names[sym.name_off + j]
            cursor += 1
            j += 1
        }
        i += 1
    }
    // 字符串段（v3）：命中时按 label 恢复登记，lowering 才能查到字节。
    i = 0
    for i < expr_n {
        let node ast.AstExpr = store.expressions[ctx.expr_first + i]
        let slbl int = 0
        let soff int = 0
        let slen int = 0
        let squoted int = 0
        // 与计数循环用**同一个**谓词：任一条件不满足就不是可携带的字符串，
        // 否则发射字节数会超出按计数分配的空间（曾导致堆破坏与自旋）。
        if (support.data_str_lookup(node.const_bits.to_type(int), &soff, &slen, &squoted) == 0
            || soff < 0 || slen < 0 || store.name_n - soff < slen) {
            i += 1
            continue
        }
        checked_slice_put_int(data, &cursor, node.const_bits.to_type(int))
        checked_slice_put_int(data, &cursor, slen)
        checked_slice_put_int(data, &cursor, squoted)
        let j2 int = 0
        for j2 < slen {
            data[cursor] = store.names[soff + j2]
            cursor += 1
            j2 += 1
        }
        i += 1
    }
    out_data[0] = data; out_size[0] = cursor
    free(symbol_used.to_type(*void)); free(symbol_order.to_type(*void))
    return 0
}

// checked_slice_import：把切片追加到当前 AST arena，返回新函数行下标。
// decl_row_override>=0 时使用调用方当前的声明行（production 跳过路径）；
// 否则使用切片内 decl_row（C2 自测路径）。0 成功、1 不兼容、-1 内部错误。
pub fn checked_slice_import(data *u8, size int, decl_row_override int,
    out_index *int) int {
    let slice CheckedFunctionSlice
    let parsed int = checked_slice_parse(data, size, &slice)
    if (parsed != 0) { return parsed }
    let file_id int = checked_slice_find_file(slice.file_path)
    let target_decl int = decl_row_override >= 0 ? decl_row_override : slice.decl_row
    let before ast.AstView
    ast.ast_view(&before)
    if (file_id < 0 || target_decl < 0 || target_decl >= before.decl_count
        || before.decl_nodes[target_decl].body_stmt >= 0
        || ast.ast_arena_grow_expr(slice.expr_n) != 0
        || ast.ast_arena_grow_stmt(slice.stmt_n) != 0
        || ast.ast_arena_grow_edge(slice.edge_n) != 0
        || ast.ast_arena_grow_binding(slice.binding_n) != 0
        || ast.ast_arena_grow_function(1) != 0) {
        checked_slice_release(&slice); return -1
    }
    // 扩容可能替换 arena 指针：必须在 grow 之后重新取视图。
    let v ast.AstView
    ast.ast_view(&v)
    // 其他函数增删 token 会移动绝对 token 下标；按当前函数声明起点重定基。
    let old_first int = slice.token_first
    let new_first int = v.decl_nodes[target_decl].first
    let token_delta int = new_first - old_first
    let file_token_n int = proj.file(file_id).token_n
    let max_old int = support.ms().sym_n
    let si int = 0
    for si < slice.symbol_n {
        if (slice.symbols[si].old_id >= max_old) { max_old = slice.symbols[si].old_id + 1 }
        si += 1
    }
    // v3：先按记录恢复字符串标签与字节，lowering 命中时才查得到「受检字节」。
    let st int = 0
    for st < slice.string_n {
        let item *CheckedSliceString = &slice.strings[st]
        let pool_off int = support.tml_intern_str(item.name, 0, item.len)
        if (pool_off < 0
            || support.data_str_restore(item.label, pool_off, item.len,
                item.quoted) != 0) {
            checked_slice_release(&slice); return -1
        }
        st += 1
    }
    let sym_map *int = malloc((max_old * sizeof(int)).to_type(u64)).to_type(*int)
    if (sym_map == 0) { checked_slice_release(&slice); return -1 }
    si = 0
    for si < max_old { sym_map[si] = -1; si += 1 }
    si = 0
    for si < slice.symbol_n {
        let sym *CheckedSliceSymbol = &slice.symbols[si]
        let name_off int = support.tml_intern_str(sym.name, 0, sym.name_len)
        if (name_off < 0) {
            free(sym_map.to_type(*void)); checked_slice_release(&slice); return -1
        }
        if ((sym.flags & support.F_GLOBAL) != 0) {
            let found int = support.sym_lookup_off(name_off, sym.name_len)
            if (found < 0 || support.ms().syms[found].type_id != sym.type_id
                || support.ms().syms[found].kind != sym.kind
                || support.ms().syms[found].flags != sym.flags) {
                free(sym_map.to_type(*void)); checked_slice_release(&slice); return 1
            }
            sym_map[sym.old_id] = found
        } else {
            let added int = sym_push_pool(name_off, sym.name_len, sym.kind,
                sym.type_id, sym.flags)
            if (added < 0) {
                free(sym_map.to_type(*void)); checked_slice_release(&slice); return -1
            }
            support.ms().syms[added].offset = sym.offset
            support.ms().syms[added].cval = sym.cval
            support.ms().syms[added].const_ready = sym.const_ready
            support.ms().syms[added].const_expr_off = -1
            support.ms().syms[added].const_expr_len = 0
            support.ms().syms[added].const_expr_kind = 0
            support.ms().syms[added].def_line = sym.def_line
            support.ms().syms[added].def_col = sym.def_col
            support.ms().syms[added].ast_binding_row = -1
            sym_map[sym.old_id] = added
        }
        si += 1
    }
    // 局部符号：按 ast.AstBinding 行与当前源码 token 重建，保证 expr/binding 的
    // sym_id 指向同一个新符号槽。
    let binding_sym *int = malloc((slice.binding_n * sizeof(int)).to_type(u64)).to_type(*int)
    if (binding_sym == 0) {
        free(sym_map.to_type(*void)); checked_slice_release(&slice); return -1
    }
    si = 0
    for si < slice.binding_n { binding_sym[si] = -1; si += 1 }
    si = 0
    for si < slice.binding_n {
        let binding *ast.AstBinding = &slice.bindings[si]
        let file_p *proj.PFile = proj.file(file_id)
        let file proj.PFile = file_p[0]
        let name_token int = binding.name_token + token_delta
        if (name_token < 0 || name_token >= file.token_n) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        let tok token.Tok = file.tokens[name_token]
        if (tok.len <= 0 || tok.start < 0 || tok.start + tok.len > file.source_len) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        // 导入的局部符号在 GenState 中没有作用域弹出点；给名字加不可由源码
        // 产生的缓存前缀，避免它遮蔽后续函数查到的同名全局/局部。
        let prefixed [512]u8
        let pn int = 0
        prefixed[pn] = 1; pn += 1
        pn = support.append_int(&prefixed[0], pn, decl_row_override)
        pn = support.append_byte(&prefixed[0], pn, '.')
        if (tok.len > 480) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        let ti int = 0
        for ti < tok.len {
            prefixed[pn] = file.source[tok.start + ti]
            pn += 1
            ti += 1
        }
        let name_off int = support.tml_intern_str(&prefixed[0], 0, pn)
        if (name_off < 0) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return -1
        }
        let added int = sym_push_pool(name_off, pn, binding.sym_kind,
            binding.sym_type_id, binding.sym_flags)
        if (added < 0) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return -1
        }
        support.ms().syms[added].offset = binding.sym_offset
        support.ms().syms[added].const_expr_off = -1
        support.ms().syms[added].const_expr_len = 0
        support.ms().syms[added].const_expr_kind = 0
        support.ms().syms[added].def_line = tok.line
        support.ms().syms[added].def_col = tok.col
        support.ms().syms[added].ast_binding_row = -1
        binding_sym[si] = added
        si += 1
    }
    let expr_base int = v.expr_count
    let stmt_base int = v.stmt_count
    let edge_base int = v.stmt_expr_count
    let binding_base int = v.binding_count
    let i int = 0
    for i < slice.expr_n {
        let source ast.AstExpr = slice.exprs[i]
        let dest *ast.AstExpr = &v.expr_nodes[expr_base + i]
        dest[0] = source
        dest.file_id = file_id
        dest.first += token_delta
        dest.after += token_delta
        dest.token_count = file_token_n
        if (dest.first < 0 || dest.after < dest.first || dest.after > file_token_n) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        let mapped int = -1
        if (source.binding_row >= 0) {
            if (source.binding_row >= slice.binding_n) {
                free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
                checked_slice_release(&slice); return 1
            }
            mapped = binding_sym[source.binding_row]
        } else if (source.sym_id >= 0) {
            if (source.sym_id >= max_old) {
                free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
                checked_slice_release(&slice); return 1
            }
            mapped = sym_map[source.sym_id]
            if (mapped < 0) {
            }
        }
        if (mapped >= 0) {
            dest.sym_id = mapped
            dest.sym_name_off = support.ms().syms[mapped].name_off
            dest.sym_name_len = support.ms().syms[mapped].name_len
        } else {
            dest.sym_id = -1
            dest.sym_name_off = -1
            dest.sym_name_len = 0
        }
        if (source.child0 >= 0) { dest.child0 = expr_base + source.child0 }
        if (source.child1 >= 0) { dest.child1 = expr_base + source.child1 }
        if (source.child2 >= 0) { dest.child2 = expr_base + source.child2 }
        if (source.binding_row >= 0) {
            dest.binding_row = binding_base + source.binding_row
        }
        i += 1
    }
    i = 0
    for i < slice.stmt_n {
        let source ast.AstStmt = slice.stmts[i]
        let dest *ast.AstStmt = &v.stmt_nodes[stmt_base + i]
        dest[0] = source
        dest.file_id = file_id
        dest.first += token_delta
        dest.after += token_delta
        dest.token_count = file_token_n
        if (dest.first < 0 || dest.after < dest.first || dest.after > file_token_n) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        if (source.parent >= 0) { dest.parent = stmt_base + source.parent }
        if (source.first_child >= 0) { dest.first_child = stmt_base + source.first_child }
        if (source.last_child >= 0) { dest.last_child = stmt_base + source.last_child }
        if (source.next_sibling >= 0) { dest.next_sibling = stmt_base + source.next_sibling }
        if (source.root_next >= 0) { dest.root_next = stmt_base + source.root_next }
        if (source.first_expr >= 0) { dest.first_expr = edge_base + source.first_expr }
        if (source.last_expr >= 0) { dest.last_expr = edge_base + source.last_expr }
        if (source.first_binding >= 0) {
            dest.first_binding = binding_base + source.first_binding
        }
        if (source.last_binding >= 0) {
            dest.last_binding = binding_base + source.last_binding
        }
        i += 1
    }
    i = 0
    for i < slice.edge_n {
        let source ast.AstStmtExpr = slice.edges[i]
        let dest *ast.AstStmtExpr = &v.stmt_exprs[edge_base + i]
        dest[0] = source
        if (source.expr_id >= 0) { dest.expr_id = expr_base + source.expr_id }
        if (source.next >= 0) { dest.next = edge_base + source.next }
        i += 1
    }
    i = 0
    for i < slice.binding_n {
        let source ast.AstBinding = slice.bindings[i]
        let dest *ast.AstBinding = &v.bindings[binding_base + i]
        dest[0] = source
        dest.file_id = file_id
        dest.name_token += token_delta
        if (dest.name_token < 0 || dest.name_token >= file_token_n) {
            free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
            checked_slice_release(&slice); return 1
        }
        dest.sym_id = binding_sym[i]
        if (source.stmt_id >= 0) { dest.stmt_id = stmt_base + source.stmt_id }
        if (source.next >= 0) { dest.next = binding_base + source.next }
        i += 1
    }
    let row int = v.function_count
    let function *ast.AstFunctionContext = &v.function_nodes[row]
    function.file_id = file_id
    function.owner_decl = slice.owner_decl
    function.decl_row = target_decl
    function.token_first = new_first
    function.token_after = new_first + (slice.token_after - slice.token_first)
    if (function.token_after < new_first || function.token_after > file_token_n) {
        free(binding_sym.to_type(*void)); free(sym_map.to_type(*void))
        checked_slice_release(&slice); return 1
    }
    function.expr_first = expr_base
    function.expr_after = expr_base + slice.expr_n
    function.stmt_first = stmt_base
    function.stmt_after = stmt_base + slice.stmt_n
    function.edge_first = edge_base
    function.edge_after = edge_base + slice.edge_n
    function.binding_first = binding_base
    function.binding_after = binding_base + slice.binding_n
    function.body_stmt = stmt_base + slice.body_stmt
    function.asm_first = 0
    function.asm_after = 0
    // 视图是副本：行数必须提交回 arena 全局计数，否则 verify 看到空 arena。
    ast.ast_view_append_expr(slice.expr_n)
    ast.ast_view_append_stmt(slice.stmt_n)
    ast.ast_view_append_edge(slice.edge_n)
    ast.ast_view_append_binding(slice.binding_n)
    ast.ast_view_append_function()
    v.decl_nodes[target_decl].body_stmt = function.body_stmt
    free(binding_sym.to_type(*void))
    free(sym_map.to_type(*void))
    checked_slice_release(&slice)
    if (out_index != 0) { out_index[0] = row }
    return 0
}

// checked_check_cache_begin：挂接本轮只读 check 缓存；0 表示禁用。
pub fn checked_check_cache_begin(cache_in *ir.IRFunctionCacheSet, env_key u64) void {
    let v ast.AstView
    ast.ast_view(&v)
    checked_check_cache_in = cache_in
    checked_check_cache_env = env_key
    checked_check_keys_n = v.decl_count > 0 ? v.decl_count : 0
    if (checked_check_keys_n > 0) {
        checked_check_keys = checked_zero_rows(checked_check_keys_n,
            ir.IR_FUNCTION_CACHE_KEY_SIZE).to_type(*u8)
        checked_check_type_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        checked_check_str_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        checked_check_static_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        let i int = 0
        for i < checked_check_keys_n {
            checked_check_type_first[i] = -1
            checked_check_str_first[i] = -1
            checked_check_static_first[i] = -1
            i += 1
        }
    }
}

// checked_check_cache_end：解除挂接；集合仍由 cmd 所有者释放。
pub fn checked_check_cache_end() void {
    checked_check_cache_in = 0
    checked_check_cache_env = 0
    // 键表保留到本 worker 的 capture 结束；worker 是短生命周期进程，不在此释放。
}

// checked_slice_snapshot：只记录该声明的模块表规模（v3 守卫用）。
// 生产路径由 pass2b 前的 checked_check_store_key 顺带记录；测试前端（如
// llvmlower fixture 的 capture 自测）没有该钩子，捕获前显式调用一次即可。
pub fn checked_slice_snapshot(decl_row int) void {
    let v ast.AstView
    ast.ast_view(&v)
    if (decl_row < 0) { return }
    // 测试前端没有 begin：按当前声明数惰性建表（-1 = 未记录）。
    if (checked_check_keys_n <= decl_row) {
        checked_check_keys_n = v.decl_count > decl_row + 1 ? v.decl_count : decl_row + 1
        checked_check_type_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        checked_check_str_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        checked_check_static_first = checked_zero_rows(checked_check_keys_n,
            sizeof(int)).to_type(*int)
        if (checked_check_type_first == 0 || checked_check_str_first == 0
            || checked_check_static_first == 0) { return }
        let ri int = 0
        for ri < checked_check_keys_n {
            checked_check_type_first[ri] = -1
            checked_check_str_first[ri] = -1
            checked_check_static_first[ri] = -1
            ri += 1
        }
    }
    if (checked_check_type_first == 0 || checked_check_str_first == 0
        || checked_check_static_first == 0) { return }
    checked_check_type_first[decl_row] = support.ty_count()
    checked_check_str_first[decl_row] = support.data_str_count()
    checked_check_static_first[decl_row] = support.static_data_count()
}

// checked_check_store_key：保存 pass2b 前的函数键（供 capture 使用）。
pub fn checked_check_store_key(decl_row int, key *u8) void {
    if (key == 0 || decl_row < 0 || decl_row >= checked_check_keys_n
        || checked_check_keys == 0) { return }
    let base int = decl_row * ir.IR_FUNCTION_CACHE_KEY_SIZE
    // v3：同一时刻记录模块表规模，capture 用差值判断能否复用切片。
    if (checked_check_type_first != 0 && checked_check_str_first != 0
        && checked_check_static_first != 0) {
        checked_check_type_first[decl_row] = support.ty_count()
        checked_check_str_first[decl_row] = support.data_str_count()
        checked_check_static_first[decl_row] = support.static_data_count()
    }
    let i int = 0
    for i < ir.IR_FUNCTION_CACHE_KEY_SIZE {
        checked_check_keys[base + i] = key[i]
        i += 1
    }
}

// checked_check_cache_active：parser 判断是否启用 check 缓存。
pub fn checked_check_cache_active() int {
    return checked_check_cache_in != 0 ? 1 : 0
}

// checked_check_cache_lookup：按键取记录；命中返回 1 并借出 data/size，未命中 0。
pub fn checked_check_cache_lookup(key *char, out_data **u8, out_size *int) int {
    if (checked_check_cache_in == 0 || key == 0) { return 0 }
    let entry *ir.IRFunctionCacheEntry = ir.ir_function_cache_set_find(
        checked_check_cache_in, key)
    if (entry == 0 || entry.data == 0 || entry.size <= 0) {
        // 本地索引/记录缺失时查全局 content store；check 键同时是 ActionID。
        let global_data *u8 = 0
        let global_size int = 0
        let global_hit int = cache.store_lookup(cache.store_task(), key,
            cache.OUTPUT_CHECK, &global_data, &global_size)
        if (global_hit == 1) {
            if (ir.ir_function_cache_set_add(checked_check_cache_in, key,
                    global_data, global_size) != 0) {
                free(global_data.to_type(*void))
            }
            entry = ir.ir_function_cache_set_find(checked_check_cache_in, key)
        }
    }
    if (entry == 0 || entry.data == 0 || entry.size <= 0) { return 0 }
    out_data[0] = entry.data
    out_size[0] = entry.size
    return 1
}

// checked_check_cache_capture：从已验证快照 capture 全部函数的 check 切片。
// 含模板等暂不支持的函数跳过；内部错误返回 -1。
pub fn checked_check_cache_capture(unit *CheckedModule,
    out *ir.IRFunctionCacheSet, env_key u64) int {
    if (unit == 0 || unit.storage == 0 || out == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    let i int = 0
    let total_size int = 0
    for i < store.function_n {
        let key [ir.IR_FUNCTION_CACHE_KEY_SIZE]u8
        let decl_row int = store.functions[i].decl_row
        if (checked_check_key_for_decl(decl_row, &key[0]) != 0) {
            // 例如 CT 函数或未启用 check 缓存时：不写记录，下次仍完整检查。
            i += 1
            continue
        }
        let data *u8 = 0
        let size int = 0
        let captured int = checked_slice_capture(unit, i, &data, &size)
        if (captured == 0) {
            if (total_size + size > 16777216) {
                free(data.to_type(*void))
            } else if (ir.ir_function_cache_set_add(out, support.arr_cstr(&key[0]),
                    data, size) != 0) {
                free(data.to_type(*void))
                return -1
            } else {
                total_size += size
            }
        } else if (captured < 0) {
            return -1
        }
        i += 1
    }
    return 0
}

// checked_decl_restore：清空 AST arena 后按受检快照重建模块级声明骨架。
//
// 仅供函数切片与 lowering 的离线等价性探针（lower 模块）在重放切片前复位前端
// 状态；生产构建路径不调用。探针不再直接读写 ast 的模块级数组，是本文件对
// 「前端复位」唯一对外承诺。返回 0 成功、-1 快照不可用或声明登记失败。
pub fn checked_decl_restore(unit *CheckedModule) int {
    if (unit == 0 || unit.storage == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    support.session().active_file = 0
    ast.store().file_decl_i = -1
    ast.store().file_decls = proj.file(0).decls
    ast.store().file_decl_n = proj.file(0).decl_n
    if (ast.ast_decl_add_file(0) != 0) { return -1 }
    // arena 已复位并重建：视图必须在复位之后重新取（旧视图指向已释放的块）。
    let v ast.AstView
    ast.ast_view(&v)
    // 恢复模块级声明的语义字段（sym_id/type_id/init_expr 等）。
    let i int = 0
    for 1 {
        if (i >= store.declaration_n) { break }
        if (i < v.decl_count) {
            v.decl_nodes[i].sym_id = store.declarations[i].sym_id
            v.decl_nodes[i].type_id = store.declarations[i].type_id
            v.decl_nodes[i].init_expr = store.declarations[i].init_expr
            // 函数体由切片导入设置；非函数声明保持 store 的 -1。
            v.decl_nodes[i].body_stmt = store.declarations[i].kind == token.TK_FN ?
                -1 : store.declarations[i].body_stmt
        }
        i += 1
    }
    return 0
}

// checked_module_view：借出快照自有表的只读视图，不复制、不分配或转移所有权。
// 调用方必须在对应 CheckedModule release 或修改前完成检查；无效所有者返回 -1。
pub fn checked_module_view(unit *CheckedModule, out *CheckedModuleView) int {
    if (unit == 0 || out == 0 || unit.storage == 0) { return -1 }
    let store *CheckedStorage = unit.storage.to_type(*CheckedStorage)
    out.target = unit.target
    out.expressions = store.expressions; out.expression_n = store.expression_n
    out.statements = store.statements; out.statement_n = store.statement_n
    out.edges = store.edges; out.edge_n = store.edge_n
    out.bindings = store.bindings; out.binding_n = store.binding_n
    out.templates = store.templates; out.template_n = store.template_n
    out.declarations = store.declarations; out.declaration_n = store.declaration_n
    out.functions = store.functions; out.function_n = store.function_n
    out.types = store.types; out.type_n = store.type_n
    out.fields = store.fields; out.field_n = store.field_n
    out.type_names = store.type_names; out.type_name_n = store.type_name_n
    out.type_home = store.type_home
    out.sig_abi = store.sig_abi; out.sig_ret = store.sig_ret
    out.sig_np = store.sig_np; out.sig_vararg = store.sig_vararg
    out.sig_first = store.sig_first; out.sig_n = store.sig_n
    out.sig_params = store.sig_params; out.sig_param_n = store.sig_param_n
    out.symbols = store.symbols; out.symbol_n = store.symbol_n
    out.names = store.names; out.name_n = store.name_n
    out.files = store.files; out.file_n = store.file_n
    out.imports = store.imports; out.import_n = store.import_n
    out.bss_symbols = store.bss_symbols; out.bss_n = store.bss_n
    out.strings = store.strings; out.string_n = store.string_n
    out.static_data = store.static_data; out.static_data_n = store.static_data_n
    out.suffix_off = store.suffix_off; out.suffix_len = store.suffix_len
    out.is_entry = store.is_entry
    return 0
}

// convert_returns：校验每个 `return expr` 的表达式能否赋给当前函数返回类型。
// 成功返回 0；失败已写诊断并返回 -1（首个错误即停，与 parse 期一致）。
pub fn convert_returns(view *ast.AstView) int {
    let fi int = 0
    for fi < view.function_count {
        let fn_ctx ast.AstFunctionContext = view.function_nodes[fi]
        if (fn_ctx.decl_row < 0 || fn_ctx.decl_row >= view.decl_count) { fi += 1; continue }
        let decl ast.AstDecl = view.decl_nodes[fn_ctx.decl_row]
        if (decl.type_id < 0 || decl.type_id >= support.ms().type_n) { fi += 1; continue }
        let ret_tid int = support.ms().types[decl.type_id].elem
        let s int = fn_ctx.stmt_first
        for s < fn_ctx.stmt_after {
            if (view.stmt_nodes[s].kind == ast.AST_STMT_RETURN) {
                let edge int = view.stmt_nodes[s].first_expr
                if (edge >= 0 && edge < view.stmt_expr_count) {
                    let expr_id int = view.stmt_exprs[edge].expr_id
                    if (expr_id >= 0 && expr_id < view.expr_count) {
                        let value ast.AstExpr = view.expr_nodes[expr_id]
                        let code int = support.vk_can_assign(ret_tid, value.type_id,
                            value.is_lit, value.const_bits, value.lit_big)
                        if (code != 0) {
                            return diag_file_at(value.file_id,
                                tok_line_at(value.file_id, value.after),
                                tok_col_at(value.file_id, value.after), code)
                        }
                    }
                }
            }
            s += 1
        }
        fi += 1
    }
    return 0
}

// convert_assigns：校验单目标赋值 `lhs op= rhs` 的 rhs 能否赋给 lhs 类型。
// AST 的 ASSIGN 语句按顺序挂两条表达式边（先左值、后右值），因此直接取链上
// 第 1、2 条；位置同样用 rhs 的 `after`（= 解析结束游标）复现 parse 期诊断。
pub fn convert_assigns(view *ast.AstView) int {
    let s int = 0
    for s < view.stmt_count {
        if (view.stmt_nodes[s].kind == ast.AST_STMT_ASSIGN) {
            let edge int = view.stmt_nodes[s].first_expr
            if (edge >= 0 && edge < view.stmt_expr_count) {
                let next_edge int = view.stmt_exprs[edge].next
                let lhs_id int = view.stmt_exprs[edge].expr_id
                if (next_edge >= 0 && next_edge < view.stmt_expr_count
                    && lhs_id >= 0 && lhs_id < view.expr_count) {
                    let rhs_id int = view.stmt_exprs[next_edge].expr_id
                    if (rhs_id >= 0 && rhs_id < view.expr_count) {
                        let lhs ast.AstExpr = view.expr_nodes[lhs_id]
                        let rhs ast.AstExpr = view.expr_nodes[rhs_id]
                        let code int = support.vk_can_assign(lhs.type_id, rhs.type_id,
                            rhs.is_lit, rhs.const_bits, rhs.lit_big)
                        if (code != 0) {
                            return diag_file_at(rhs.file_id,
                                tok_line_at(rhs.file_id, rhs.after),
                                tok_col_at(rhs.file_id, rhs.after), code)
                        }
                    }
                }
            }
        }
        s += 1
    }
    return 0
}

// ct_types_sync：只绑定类型表槽（保留给只需要类型的调用方）。
pub fn ct_types_sync() void {
    comptime.ct_types_bind((&support.ms().types).to_type(*void), &support.ms().type_n)
}

// ct_facts_sync：把类型表与符号表的「槽」一次绑定到 CT 镜像。
// 只传槽地址（不是表内容），表扩容/搬迁后镜像自动读到最新值；每任务一次。
pub fn ct_facts_sync() void {
    comptime.ct_types_bind((&support.ms().types).to_type(*void), &support.ms().type_n)
    comptime.ct_syms_bind((&support.ms().syms).to_type(*void), &support.ms().sym_n)
    comptime.ct_fields_bind((&support.ms().fields).to_type(*void), &support.ms().field_n)
    // 前端模式位：CT 读折叠开关、写结果寻址（两个标量槽）。
    comptime.ct_mode_bind((&support.fc().c_fold).to_type(*void), (&support.fc().c_res_is_addr).to_type(*void))
    // 文件导入表：CT 登记函数时要把导入别名一起带进 IR 目标描述。
    comptime.ct_imports_bind((&support.fs().imports).to_type(*void), &support.fs().import_n,
        (&support.fs().import_mod).to_type(*void))
    // 字符串标签 / 枚举成员：gen 里的模块级表，用槽地址绑定。
    // 字符串标签/枚举成员表是固定容量全局数组，不随扩容搬迁：镜像直接持有基址。
    let ds_lbl *int
    let ds_off *int
    let ds_len *int
    let ds_q *int
    support.data_str_slots((&ds_lbl).to_type(**int), (&ds_off).to_type(**int),
        (&ds_len).to_type(**int), (&ds_q).to_type(**int))
    let em_off *int
    let em_len *int
    let em_val *i64
    let em_ready *int
    support.em_slots((&em_off).to_type(**int), (&em_len).to_type(**int),
        (&em_val).to_type(**i64), (&em_ready).to_type(**int))
    comptime.ct_tables_bind(ds_lbl, ds_off, ds_len, ds_q,
        support.data_str_n_slot(),
        em_off, em_len, em_val, em_ready, support.em_n_slot(),
        support.static_data_rows_slot().to_type(**comptime.CtStaticRow),
        support.static_data_n_slot())
}

// ct_import_count / ct_import_alias / ct_import_module：导入表镜像的只读窄口。
// 供 fixture 做差分；生产路径由 comptime 内部直接读镜像。
pub fn ct_import_count() int { return comptime.ct_import_count() }

// ct_import_alias：第 i 行的绑定名池偏移与长度；越界返回 -1。
pub fn ct_import_alias(i int, out_off *int, out_len *int) int {
    if (i < 0 || i >= comptime.ct_import_count()) { return -1 }
    let row comptime.CtImportRow = comptime.ct_import_row(i)
    out_off[0] = row.alias_off
    out_len[0] = row.alias_len
    return 0
}

// ct_import_module：第 i 行绑定的模块编号（-1 = 未绑定）。
pub fn ct_import_module(i int) int { return comptime.ct_import_module(i) }

// ct_fold_mode / ct_res_is_addr_set：前端模式位槽的读写窄口。
pub fn ct_fold_mode() int { return comptime.ct_fold_mode() }

pub fn ct_res_is_addr_set(v int) void { comptime.ct_res_is_addr_set(v) }

// ct_type_layout_ok：镜像与 gen 逐项一致返回 1，否则 0。
// 覆盖 struct 尺寸与全部 TY_* 常量值；字段顺序由 struct 定义保证。
pub fn ct_type_layout_ok() int {
    if (sizeof(support.CType) != sizeof(comptime.CtTypeRow)) { return 0 }
    if (sizeof(support.CSym) != sizeof(comptime.CtSymRow)) { return 0 }
    if (sizeof(support.SField) != sizeof(comptime.CtFieldRow)) { return 0 }
    // 导入表镜像按结构体布局零拷贝读取；字段漂移会让别名读取错位。
    if (sizeof(support.ImportEnt) != sizeof(comptime.CtImportRow)) { return 0 }
    if (support.CT_DIAG_ASSERT != comptime.CT_DIAG_ASSERT
        || support.CT_DIAG_ERROR != comptime.CT_DIAG_ERROR
        || support.CT_DIAG_WARN != comptime.CT_DIAG_WARN) { return 0 }
    if (support.SYM_VAR != comptime.CT_SYM_VAR || support.SYM_CONST != comptime.CT_SYM_CONST
        || support.SYM_FN != comptime.CT_SYM_FN
        || support.F_GLOBAL != comptime.CT_F_GLOBAL || support.F_PARAM != comptime.CT_F_PARAM
        || support.F_PUB != comptime.CT_F_PUB || support.F_EXTERN != comptime.CT_F_EXTERN
        || support.F_ADDR != comptime.CT_F_ADDR || support.F_AGGPARAM != comptime.CT_F_AGGPARAM
        || support.F_CABI != comptime.CT_F_CABI || support.F_COMPTIME != comptime.CT_F_COMPTIME
        || support.F_ENUM_MEMBER != comptime.CT_F_ENUM_MEMBER
        || support.F_ENUM_META != comptime.CT_F_ENUM_META
        || support.F_FIELD_META != comptime.CT_F_FIELD_META
        || support.F_MODULE_IMPORT != comptime.CT_F_MODULE_IMPORT) { return 0 }
    if (support.TY_VOID != comptime.CT_TY_VOID || support.TY_BOOL != comptime.CT_TY_BOOL
        || support.TY_CHAR != comptime.CT_TY_CHAR || support.TY_I8 != comptime.CT_TY_I8
        || support.TY_I16 != comptime.CT_TY_I16 || support.TY_I32 != comptime.CT_TY_I32
        || support.TY_I64 != comptime.CT_TY_I64 || support.TY_U8 != comptime.CT_TY_U8
        || support.TY_U16 != comptime.CT_TY_U16 || support.TY_U32 != comptime.CT_TY_U32
        || support.TY_U64 != comptime.CT_TY_U64 || support.TY_F32 != comptime.CT_TY_F32
        || support.TY_F64 != comptime.CT_TY_F64 || support.TY_PTR != comptime.CT_TY_PTR
        || support.TY_ARRAY != comptime.CT_TY_ARRAY || support.TY_SLICE != comptime.CT_TY_SLICE
        || support.TY_STRUCT != comptime.CT_TY_STRUCT || support.TY_UNION != comptime.CT_TY_UNION
        || support.TY_ENUM != comptime.CT_TY_ENUM || support.TY_FN != comptime.CT_TY_FN) { return 0 }
    return 1
}

// ct_types_bound：已绑定行数；0 表示未绑定。
pub fn ct_types_bound() int {
    return comptime.ct_types_bound()
}

// ct_syms_bound：已绑定符号行数；0 表示未绑定。
pub fn ct_syms_bound() int {
    return comptime.ct_syms_bound()
}

// ct_kind / ct_size / ct_align / ct_elem / ct_len / ct_sub：镜像行字段。
pub fn ct_kind(tid int) int { return comptime.ct_ty_kind(tid) }

pub fn ct_size(tid int) int { return comptime.ct_ty_size(tid) }

pub fn ct_align(tid int) int { return comptime.ct_ty_align(tid) }

pub fn ct_elem(tid int) int { return comptime.ct_ty_elem(tid) }

pub fn ct_len(tid int) int { return comptime.ct_ty_len(tid) }

pub fn ct_sub(tid int) int { return comptime.ct_ty_sub(tid) }

// ct_sym_kind / ct_sym_type / ct_sym_flags / ct_sym_ready：镜像符号行字段。
pub fn ct_sym_kind(i int) int { return comptime.ct_sym_row(i).kind }

pub fn ct_sym_type(i int) int { return comptime.ct_sym_row(i).type_id }

pub fn ct_sym_flags(i int) int { return comptime.ct_sym_row(i).flags }

pub fn ct_sym_ready(i int) int { return comptime.ct_sym_row(i).const_ready }

// ct_sym_declared_before：符号声明位置早于 (line,col)（与 gen 版同判据）。
pub fn ct_sym_declared_before(sym int, line int, col int) int {
    return comptime.ct_sym_declared_before(sym, line, col)
}

// ct_is_integer / ct_is_float / ct_is_signed：镜像谓词。
pub fn ct_is_integer(tid int) int { return comptime.ct_ty_is_integer(tid) }

pub fn ct_is_float(tid int) int { return comptime.ct_ty_is_float(tid) }

pub fn ct_is_signed(tid int) int { return comptime.ct_ty_is_signed(tid) }

// iface_emit：把本模块 pub 接口写到 path。
// sym_base/tname_base：本模块登记起点（此前是 prelude 与已加载接口）。
pub fn iface_emit(path *char, sym_base int, tname_base int) int {
    if_len = 0
    // 无属性接口保持 v1；已有函数属性使用 v2；公开 comptime 签名使用 v3。
    let iface_version int = 1
    let ti0 int = tname_base
    for ti0 < support.ms().name_n {
        if (support.ms().names[ti0].is_pub != 0
            && (support.ms().names[ti0].attrs & token.ATTR_EXTERN) != 0) {
            if (iface_version < 2) { iface_version = 2 }
        }
        ti0 += 1
    }
    let si0 int = sym_base
    for si0 < support.ms().sym_n {
        let flags int = support.ms().syms[si0].flags
        if ((flags & support.F_PUB) != 0
            && ((flags & support.F_EXTERN) == 0 || (flags & support.F_CABI) != 0)
            && (flags & support.F_COMPTIME) != 0) {
            iface_version = 3
        } else if ((flags & support.F_PUB) != 0
            && ((flags & support.F_EXTERN) == 0 || (flags & support.F_CABI) != 0)
            && (flags & (support.F_CABI | support.F_INLINE | support.F_NORETURN)) != 0
            && iface_version < 2) {
            iface_version = 2
        }
        si0 += 1
    }
    if (iface_version == 3) {
        if (if_puts("// yh-iface v3 arch=") != 0) { return -1 }
    } else if (iface_version == 2) {
        if (if_puts("// yh-iface v2 arch=") != 0) { return -1 }
    } else if (if_puts("// yh-iface v1 arch=") != 0) { return -1 }
    if (if_puts(support.target_arch_token()) != 0) { return -1 }
    if (if_puts(" suffix=") != 0) { return -1 }
    if (if_put_np(support.fs().sym_sfx_off, support.fs().sym_sfx_len) != 0) { return -1 }
    if (if_put('\n') != 0) { return -1 }
    // 类型（声明序）
    let ti int = tname_base
    for ti < support.ms().name_n {
        if (support.ms().names[ti].is_pub == 0) {
            ti += 1
            continue
        }
        let tid int = support.ms().names[ti].type_id
        if (support.ms().names[ti].form == 1 || support.ms().names[ti].form == 2) {
            if ((support.ms().names[ti].attrs & token.ATTR_EXTERN) != 0
                && if_puts("@[extern]\n") != 0) { return -1 }
            if (if_puts("pub ") != 0) { return -1 }
            if (support.ms().names[ti].form == 1) {
                if (if_puts("struct ") != 0) { return -1 }
            } else {
                if (if_puts("union ") != 0) { return -1 }
            }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" {\n") != 0) { return -1 }
            let st int = support.ms().types[tid].sub
            let nf int = support.ms().types[tid].len
            let fi int = 0
            for fi < nf {
                if (support.ms().fields[st + fi].is_pub != 0) {
                    if (if_puts("    pub ") != 0) { return -1 }
                } else {
                    if (if_puts("    ") != 0) { return -1 }
                }
                if (if_put_np(support.ms().fields[st + fi].name_off, support.ms().fields[st + fi].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().fields[st + fi].type_id, tname_base) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                fi += 1
            }
            if (if_puts("}\n") != 0) { return -1 }
        } else if (support.ms().names[ti].form == 3) {
            if ((support.ms().names[ti].attrs & token.ATTR_EXTERN) != 0
                && if_puts("@[extern]\n") != 0) { return -1 }
            if (if_puts("pub enum ") != 0) { return -1 }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" {\n") != 0) { return -1 }
            // 成员 = 类型为该枚举的全局常量（本模块登记的）
            let si int = sym_base
            for si < support.ms().sym_n {
                if (support.ms().syms[si].kind == support.SYM_CONST && support.ms().syms[si].type_id == tid
                    && (support.ms().syms[si].flags & support.F_EXTERN) == 0) {
                    if (if_puts("    ") != 0) { return -1 }
                    if (if_put_np(support.ms().syms[si].name_off, support.ms().syms[si].name_len) != 0) { return -1 }
                    if (if_puts(" = ") != 0) { return -1 }
                    if (if_puti(support.ms().syms[si].cval.to_type(int)) != 0) { return -1 }
                    if (if_puts(";\n") != 0) { return -1 }
                }
                si += 1
            }
            if (if_puts("}\n") != 0) { return -1 }
        } else {
            // type 别名
            if (if_puts("pub type ") != 0) { return -1 }
            if (if_put_np(support.ms().names[ti].name_off, support.ms().names[ti].name_len) != 0) { return -1 }
            if (if_puts(" = ") != 0) { return -1 }
            if (if_emit_type(tid, tname_base) != 0) { return -1 }
            if (if_puts(";\n") != 0) { return -1 }
        }
        ti += 1
    }
    // 值符号：fn / const / let
    let si2 int = sym_base
    for si2 < support.ms().sym_n {
        let fl int = support.ms().syms[si2].flags
        if ((fl & support.F_PUB) == 0
            || ((fl & support.F_EXTERN) != 0 && (fl & support.F_CABI) == 0)) {
            si2 += 1
            continue
        }
        if (support.ms().syms[si2].kind == support.SYM_FN) {
            // 类型化变参/裸变参不导出（前者为模块私有便利，后者仅 prelude）
            let ftid int = support.ms().syms[si2].type_id
            let sig int = support.ms().types[ftid].sub
            if (support.ms().sig_vararg[sig] != 0) {
                return token.err_tok("变参函数不能导出为 pub")
            }
            let has_cabi int = ((fl & support.F_CABI) != 0).to_type(int)
            if ((fl & (support.F_CABI | support.F_INLINE | support.F_NORETURN
                    | support.F_COMPTIME)) != 0) {
                if (if_puts("@[") != 0) { return -1 }
                let wrote int = 0
                if (has_cabi != 0) {
                    if (if_puts("extern") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & support.F_INLINE) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("inline") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & support.F_NORETURN) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("noreturn") != 0) { return -1 }
                    wrote = 1
                }
                if ((fl & support.F_COMPTIME) != 0) {
                    if (wrote != 0 && if_puts(", ") != 0) { return -1 }
                    if (if_puts("comptime") != 0) { return -1 }
                }
                if (if_puts("]\n") != 0) { return -1 }
            }
            if (if_puts("pub fn ") != 0) { return -1 }
            if (if_put_np(support.ms().syms[si2].name_off, support.ms().syms[si2].name_len) != 0) { return -1 }
            if (if_put('(') != 0) { return -1 }
            let np2 int = support.ms().sig_np[sig]
            let i int = 0
            for i < np2 {
                if (i > 0) {
                    if (if_puts(", ") != 0) { return -1 }
                }
                if (if_puts("p") != 0) { return -1 }
                if (if_puti(i) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().sig_params[support.ms().sig_first[sig] + i], tname_base) != 0) { return -1 }
                i += 1
            }
            if (if_puts(") ") != 0) { return -1 }
            if (if_emit_type(support.ms().sig_ret[sig], tname_base) != 0) { return -1 }
            if (has_cabi != 0) {
                if (if_puts(";\n") != 0) { return -1 }
            } else if (if_puts(" { }\n") != 0) { return -1 }
        } else if (support.ms().syms[si2].kind == support.SYM_CONST) {
            // enum 成员常量已随 pub enum 体导出（成员行），这里跳过——
            // 否则接口里重复登记，加载侧报重定义。
            if (support.ms().types[support.ms().syms[si2].type_id].kind == support.TY_ENUM) {
                si2 += 1
                continue
            }
            // 聚合常量（结构体/定长数组/切片）：按**初始化式源文本**重放声明
            // （const_expr_kind = 4），导入侧按模块模式重新解析：编译期建模、
            // 运行期在导入方物化本单元副本（本地数据标签，见 em_data_symbol_header）。
            // 与 .s.ct 闭包的聚合常量重放共用同一份源文本。
            let ck3 int = support.ms().types[support.ms().syms[si2].type_id].kind
            if (ck3 == support.TY_STRUCT || ck3 == support.TY_ARRAY
                    || ck3 == support.TY_SLICE) {
                let ck4 int = support.ms().syms[si2].const_expr_kind
                if ((ck4 != 4 && ck4 != 5)
                    || support.ms().syms[si2].const_expr_len <= 0) {
                    return token.err_tok("pub 聚合常量暂只支持字面量或 $ 调用初始化式导出")
                }
                if (if_puts("pub const ") != 0) { return -1 }
                if (if_put_np(support.ms().syms[si2].name_off,
                        support.ms().syms[si2].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) {
                    return -1
                }
                if (if_puts(" = ") != 0) { return -1 }
                if (iface_emit_pub_agg_src(si2) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                si2 += 1
                continue
            }
            if ((fl & support.F_ADDR) != 0) {
                // 字符串字面量指针常量：原样重放声明（含引号与转义），导入方按
                // 与函数体内字面量相同的规则重新登记只读字节池。
                // 引用式（`pub const A *char = B;`）由共用追链函数追到最终字面式。
                let lit_off int = 0
                let lit_len int = 0
                if (support.sym_ct_lit_text(si2, &lit_off, &lit_len) != 0 || lit_len < 2) {
                    return token.err_tok("pub 指针常量（字符串）暂不支持跨模块导出")
                }
                if (if_puts("pub const ") != 0) { return -1 }
                if (if_put_np(support.ms().syms[si2].name_off,
                        support.ms().syms[si2].name_len) != 0) { return -1 }
                if (if_put(' ') != 0) { return -1 }
                if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) { return -1 }
                if (if_puts(" = ") != 0) { return -1 }
                if (if_put_np(lit_off, lit_len) != 0) { return -1 }
                if (if_puts(";\n") != 0) { return -1 }
                si2 += 1
                continue
            }
            if (if_puts("pub const ") != 0) { return -1 }
            if (if_put_np(support.ms().syms[si2].name_off, support.ms().syms[si2].name_len) != 0) { return -1 }
            if (if_put(' ') != 0) { return -1 }
            if (if_emit_type(support.ms().syms[si2].type_id, tname_base) != 0) { return -1 }
            if (if_puts(" = ") != 0) { return -1 }
            // 值文本与 .s.ct 闭包共用：按声明宽度输出（窄化到宿主 int 会把
            // u32 的 0xfeedfacf 打成负数、把 0x80000000 打成空的负号）
            if (iface_emit_const_value(si2) != 0) { return -1 }
            if (if_puts(";\n") != 0) { return -1 }
        } else if (support.ms().syms[si2].kind == support.SYM_VAR) {
            // 2026-10-02「let 不导出」：可变全局不再跨模块导出，接口停发
            // pub let 行；编译器状态经 support.fc()/support.ctl() 窄口访问。
        }
        si2 += 1
    }
    // 先写同目录临时文件，再 rename 发布完整接口；依赖调度器以文件出现
    // 作为 InterfaceReady 信号，不能让读取方看到半份接口。
    let flg int = 0x241
    if (support.tg_host_darwin() != 0) {
        flg = 0x601
    }
    let tmp [700]u8
    let tn int = 0
    tn = support.append_str(tmp, tn, path)
    tn = support.append_str(tmp, tn, ".tmp.")
    tn = support.append_int(tmp, tn, getpid())
    tmp[tn] = 0
    let fd int = open(support.arr_cstr(tmp), flg, 0x1a4)
    if (fd < 0) {
        return support.fail_path("无法创建接口文件: ", path)
    }
    let write_rc int = support.write_all(fd, if_buf, if_len)
    let close_rc int = close(fd)
    if (write_rc != 0 || close_rc != 0) {
        unlink(support.arr_cstr(tmp))
        return support.fail_path("写接口文件失败: ", path)
    }
    if (rename(support.arr_cstr(tmp), path) != 0) {
        unlink(support.arr_cstr(tmp))
        return support.fail_path("发布接口文件失败: ", path)
    }
    return 0
}

// iface_lit_at：src[0..n) 从 pos 起是否以 lit 开头（越界即不匹配）。
pub fn iface_lit_at(src *u8, n int, pos int, lit *char) int {
    let k int = 0
    for lit[k] != 0 {
        if (pos + k >= n || src[pos + k] != lit[k].to_type(u8)) {
            return 0
        }
        k += 1
    }
    return 1
}

// iface_arch_at：src[0..n) 从 pos 起的架构标记是否与当前目标一致；
// 一致返回标记之后的位置，否则 -1。
pub fn iface_arch_at(src *u8, n int, pos int) int {
    let want *char = support.target_arch_token()
    let wlen int = support.cstr_len(want)
    let k int = 0
    for k < wlen {
        if (pos + k >= n || src[pos + k] != want[k].to_type(u8)) {
            return -1
        }
        k += 1
    }
    return pos + wlen
}

// iface_head_prefix_len：校验 .s.i 头前缀（版本区间 + 目标架构），
// 成功返回 suffix 起点，失败返回 -1。
pub fn iface_head_prefix_len() int {
    return iface_head_prefix_len_at(support.src_ctx().data, support.src_ctx().length)
}

// iface_head_prefix_len_at：纯函数版本（src + 长度），供内嵌测试直接构造输入。
pub fn iface_head_prefix_len_at(src *u8, n int) int {
    if (iface_lit_at(src, n, 0, IFACE_HEAD_PREFIX) == 0) { return -1 }
    let i int = support.cstr_len(IFACE_HEAD_PREFIX)
    let ver int = 0
    let digits int = 0
    for i < n {
        if (src[i] < '0' || src[i] > '9') { break }
        ver = ver * 10 + src[i].to_type(int) - 48
        i += 1
        digits += 1
    }
    if (digits == 0 || ver < IFACE_VERSION_MIN || ver > IFACE_VERSION_MAX) {
        return -1
    }
    if (iface_lit_at(src, n, i, IFACE_HEAD_ARCH) == 0) { return -1 }
    i = iface_arch_at(src, n, i + support.cstr_len(IFACE_HEAD_ARCH))
    if (i < 0) { return -1 }
    if (iface_lit_at(src, n, i, IFACE_HEAD_SUFFIX) == 0) { return -1 }
    return i + support.cstr_len(IFACE_HEAD_SUFFIX)
}

// iface_head_bad：头行不兼容的统一诊断（计一次错误并返回 -1）。
pub fn iface_head_bad(path *char) int {
    let buf [360]u8
    let n int = 0
    n = support.append_str_cap(buf, 360, n, "yh: 接口不兼容（头行须为 // yh-iface v")
    n = support.append_int_cap(buf, 360, n, IFACE_VERSION_MIN)
    n = support.append_str_cap(buf, 360, n, "..v")
    n = support.append_int_cap(buf, 360, n, IFACE_VERSION_MAX)
    n = support.append_str_cap(buf, 360, n, " arch=")
    n = support.append_str_cap(buf, 360, n, support.target_arch_token())
    n = support.append_str_cap(buf, 360, n, " suffix=）: ")
    n = support.append_str_cap(buf, 360, n, path)
    n = support.append_byte_cap(buf, 360, n, '\n')
    support.write_all(2, buf, n)
    support.diag().errors += 1
    return -1
}

// iface_header_suffix：校验头行并提取 suffix 到出参（入名字池）。
// c_src/c_src_len 为接口文件内容。成功 0；格式不符 -1（带诊断）。
pub fn iface_header_suffix(path *char, off *int, olen *int) int {
    let s int = iface_head_prefix_len()
    if (s < 0) {
        return iface_head_bad(path)
    }
    // suffix 到行尾
    let e int = s
    for e < support.src_ctx().length && support.src_ctx().data[e] != '\n' {
        e += 1
    }
    if (e == s) {
        support.diag().errors += 1
        let out2 [340]u8
        let on2 int = 0
        on2 = support.append_str(out2, on2, "yh: 接口头缺少 suffix: ")
        on2 = support.append_str(out2, on2, path)
        on2 = support.append_byte(out2, on2, '\n')
        support.write_all(2, out2, on2)
        return -1
    }
    let o int = support.tml_intern_str(support.src_ctx().data, s, e - s)
    if (o < 0) {
        return -1
    }
    off[0] = o
    olen[0] = e - s
    return 0
}

// sym_mangle：把符号名改写为「短名+后缀」。
pub fn sym_mangle(si int, sfx_off int, sfx_len int) int {
    let nlen int = support.ms().syms[si].name_len + sfx_len
    let tmp [512]u8
    if (nlen > 500) {
        return support.fail("符号名过长")
    }
    let n int = 0
    let i int = 0
    for i < support.ms().syms[si].name_len {
        tmp[n] = support.pool_ctx().data[support.ms().syms[si].name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < sfx_len {
        tmp[n] = support.pool_ctx().data[sfx_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(tmp, 0, n)
    if (off < 0) {
        return -1
    }
    support.ms().syms[si].name_off = off
    support.ms().syms[si].name_len = n
    return 0
}

// tname_mangle：类型名同样改写（避免与使用者同名类型冲突）。
pub fn tname_mangle(ti int, sfx_off int, sfx_len int) int {
    let nlen int = support.ms().names[ti].name_len + sfx_len
    let tmp [512]u8
    if (nlen > 500) {
        return support.fail("类型名过长")
    }
    let n int = 0
    let i int = 0
    for i < support.ms().names[ti].name_len {
        tmp[n] = support.pool_ctx().data[support.ms().names[ti].name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < sfx_len {
        tmp[n] = support.pool_ctx().data[sfx_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(tmp, 0, n)
    if (off < 0) {
        return -1
    }
    support.ms().names[ti].name_off = off
    support.ms().names[ti].name_len = n
    return 0
}

// iface_ct_name：生成仅供编译期调用的模块私有名字。
// 同一模块内所有闭包函数共用稳定后缀，避免与运行期符号或其他模块碰撞。
pub fn iface_ct_name(sym_id int, suffix_off int, suffix_len int,
    name_off *int, name_len *int) int {
    if (sym_id < 0 || sym_id >= support.ms().sym_n || suffix_off < 0
        || suffix_len < 0) {
        return support.fail("内部错误：CT 接口函数身份无效")
    }
    let sym support.CSym = support.ms().syms[sym_id]
    if (sym.name_len >= 7
        && support.pool_ctx().data[sym.name_off] == '_'
        && support.pool_ctx().data[sym.name_off + 1] == '_'
        && support.pool_ctx().data[sym.name_off + 2] == 'y'
        && support.pool_ctx().data[sym.name_off + 3] == 'h'
        && support.pool_ctx().data[sym.name_off + 4] == 'c'
        && support.pool_ctx().data[sym.name_off + 5] == 't'
        && support.pool_ctx().data[sym.name_off + 6] == '_') {
        name_off[0] = sym.name_off
        name_len[0] = sym.name_len
        return 0
    }
    let buf [1200]u8
    let n int = 0
    n = support.append_str(buf, n, "__yhct_")
    let i int = 0
    for i < sym.name_len {
        buf[n] = support.pool_ctx().data[sym.name_off + i]
        n += 1
        i += 1
    }
    i = 0
    for i < suffix_len {
        buf[n] = support.pool_ctx().data[suffix_off + i]
        n += 1
        i += 1
    }
    let off int = support.tml_intern_str(buf, 0, n)
    if (off < 0) { return -1 }
    name_off[0] = off
    name_len[0] = n
    return 0
}

// iface_ct_hex_value：把来源映射中的十六进制路径字节转换为 0..15。
pub fn iface_ct_hex_value(byte u8) int {
    if (byte >= '0' && byte <= '9') { return (byte - '0').to_type(int) }
    if (byte >= 'a' && byte <= 'f') { return (byte - 'a' + 10).to_type(int) }
    if (byte >= 'A' && byte <= 'F') { return (byte - 'A' + 10).to_type(int) }
    return -1
}

// iface_ct_origin_begin：按声明前的 sidecar 注释切换到函数定义源码路径与行号。
pub fn iface_ct_origin_begin(token_index int) int {
    if (support.session().ct_iface_mode == 0) { return 0 }
    support.src_ctx().path = support.src_ctx().path_buf.to_type(*char)
    support.session().ct_origin_active = 0
    support.diag().line_bias = 0
    if (token_index < 0 || token_index >= token.ctx().count) {
        return support.fail("内部错误：CT 来源映射声明 token 越界")
    }
    let fn_token int = token_index
    for fn_token < token.ctx().count && token.ctx().tokens[fn_token].kind != token.TK_FN {
        fn_token += 1
    }
    if (fn_token >= token.ctx().count) {
        return support.fail_path("CT 来源映射缺少函数签名: ", support.src_ctx().path)
    }
    let body_token int = fn_token + 1
    for body_token < token.ctx().count &&
        token.ctx().tokens[body_token].kind != token.TK_LBRACE {
        body_token += 1
    }
    if (body_token >= token.ctx().count) {
        return support.fail_path("CT 来源映射缺少函数体: ", support.src_ctx().path)
    }
    let line_start int = token.ctx().tokens[token_index].start
    for line_start > 0 && support.src_ctx().data[line_start - 1] != '\n' {
        line_start -= 1
    }
    if (line_start <= 0) { return 0 }
    let marker_end int = line_start - 1
    let marker_start int = marker_end
    for marker_start > 0 && support.src_ctx().data[marker_start - 1] != '\n' {
        marker_start -= 1
    }
    let prefix *char = "// yh-ctloc v1 "
    let prefix_len int = 15
    if (marker_end - marker_start < prefix_len) { return 0 }
    let i int = 0
    for i < prefix_len {
        if (support.src_ctx().data[marker_start + i] != prefix[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    let number_start int = marker_start + prefix_len
    let number_end int = number_start
    for number_end < marker_end && support.src_ctx().data[number_end] != ' ' {
        number_end += 1
    }
    if (number_end == number_start || number_end >= marker_end) {
        return support.fail_path("CT 接口来源映射格式无效: ", support.src_ctx().path)
    }
    let origin_line int = 0
    i = number_start
    for i < number_end {
        let digit int = (support.src_ctx().data[i] - '0').to_type(int)
        if (digit < 0 || digit > 9 || origin_line > 100000000) {
            return support.fail_path("CT 接口来源映射行号无效: ", support.src_ctx().path)
        }
        origin_line = origin_line * 10 + digit
        i += 1
    }
    let hex_start int = number_end + 1
    let hex_len int = marker_end - hex_start
    if (origin_line <= 0 || hex_len <= 0 || (hex_len & 1) != 0) {
        return support.fail_path("CT 接口来源映射范围无效: ", support.src_ctx().path)
    }
    let path_len int = hex_len / 2
    // RS1b：来源映射路径快照改任务私有可扩容缓冲（原固定 [1024]u8，
    // 超长路径直接拒绝；现按需扩容，任务生命期持有）。
    let obuf *u8 = support.task_buf_reserve(&support.fc().c_ct_origin_buf,
                                        &support.fc().c_ct_origin_buf_cap,
                                        path_len + 1)
    if (obuf == 0) {
        return support.fail_path("CT 来源映射路径缓冲分配失败: ", support.src_ctx().path)
    }
    i = 0
    for i < path_len {
        let high int = iface_ct_hex_value(support.src_ctx().data[hex_start + i * 2])
        let low int = iface_ct_hex_value(support.src_ctx().data[hex_start + i * 2 + 1])
        if (high < 0 || low < 0) {
            return support.fail_path("CT 接口来源映射路径无效: ", support.src_ctx().path)
        }
        let value u8 = (high * 16 + low).to_type(u8)
        if (value == 0 || value == '\n' || value == '\r') {
            return support.fail_path("CT 接口来源映射路径无效: ", support.src_ctx().path)
        }
        obuf[i] = value
        i += 1
    }
    obuf[path_len] = 0
    // 精确列映射是可选扩展；旧 sidecar 只有 ctloc 行号映射仍可导入。
    let col_end int = marker_start - 1
    let col_start int = col_end
    for col_start > 0 && support.src_ctx().data[col_start - 1] != '\n' {
        col_start -= 1
    }
    let col_status int = iface_ct_col_parse(col_start, col_end)
    if (col_status < 0) { return -1 }
    let body_after int = body_token
    let brace_depth int = 0
    for body_after < token.ctx().count {
        if (token.ctx().tokens[body_after].kind == token.TK_LBRACE) {
            brace_depth += 1
        } else if (token.ctx().tokens[body_after].kind == token.TK_RBRACE) {
            brace_depth -= 1
            if (brace_depth == 0) { body_after += 1; break }
        }
        body_after += 1
    }
    if (brace_depth != 0) {
        iface_ct_col_reset()
        return support.fail_path("CT 来源映射函数体不闭合: ", support.src_ctx().path)
    }
    support.session().ct_origin_active = 1
    support.session().ct_origin_line = origin_line
    support.diag().line_bias = origin_line - token.ctx().tokens[body_token].line
    support.src_ctx().path = support.fc().c_ct_origin_buf.to_type(*char)
    if (col_status > 0
        && iface_ct_col_apply(body_token, body_after, origin_line) != 0) {
        iface_ct_col_restore()
        support.session().ct_origin_active = 0
        support.diag().line_bias = 0
        support.src_ctx().path = support.src_ctx().path_buf.to_type(*char)
        return -1
    }
    return 0
}

// iface_ct_origin_end：恢复 sidecar 文件上下文，避免来源映射泄漏到下一声明。
pub fn iface_ct_origin_end() void {
    if (support.session().ct_iface_mode == 0) { return }
    iface_ct_col_restore()
    support.src_ctx().path = support.src_ctx().path_buf.to_type(*char)
    support.session().ct_origin_active = 0
    support.diag().line_bias = 0
}

// iface_ct_emit：导出公开 CT 函数可达的本模块闭包并写入版本化 .s.ct。
pub fn iface_ct_emit(path *char, sym_base int) int {
    if_len = 0
    if (if_puts("// yh-ctiface v1 arch=") != 0
        || if_puts(support.target_arch_token()) != 0
        || if_puts(" suffix=") != 0
        || if_put_np(support.fs().sym_sfx_off, support.fs().sym_sfx_len) != 0
        || if_put('\n') != 0) { return -1 }
    let count int = comptime.ct_iface_count()
    let reachable *int = malloc(((count + 1) * sizeof(int)).to_type(u64)) .
        to_type(*int)
    if (reachable == 0) { return support.fail("CT 接口闭包分配失败") }
    let i int = 0
    for i < count { reachable[i] = 0; i += 1 }
    i = 0
    for i < count {
        let item comptime.CtFunction = comptime.ct_iface_function(i)
        if (item.sym_id >= sym_base && item.sym_id < support.ms().sym_n
            && (support.ms().syms[item.sym_id].flags
                & (support.F_COMPTIME | support.F_PUB))
                == (support.F_COMPTIME | support.F_PUB)) {
            reachable[i] = 1
        }
        i += 1
    }
    // pub 聚合常量（$ 调用初始化）的调用目标是附加可达种子：它们的正文
    // 必须随闭包传给导入方，导入方才能重放 .s.i 声明并执行同一调用。
    let paf int = 0
    for paf < comptime.ct_pub_agg_fn_count() {
        let paf_sym int = comptime.ct_pub_agg_fn_at(paf)
        let paf_row int = comptime.ct_find(paf_sym)
        if (paf_row >= 0 && paf_row < count) {
            let paf_item comptime.CtFunction =
                comptime.ct_iface_function(paf_row)
            if (paf_item.sym_id >= sym_base && paf_item.sym_id < support.ms().sym_n) {
                reachable[paf_row] = 1
            }
        }
        paf += 1
    }
    let changed int = 1
    for changed != 0 {
        changed = 0
        i = 0
        for i < count {
            if (reachable[i] == 0) { i += 1; continue }
            let calls int = comptime.ct_iface_call_count(i)
            let ci int = 0
            for ci < calls {
                let target int = comptime.ct_iface_call_at(i, ci)
                let row int = comptime.ct_find(target)
                if (row >= 0 && row < count
                    && reachable[row] == 0) {
                    let target_item comptime.CtFunction =
                        comptime.ct_iface_function(row)
                    if (target_item.sym_id >= sym_base) {
                        reachable[row] = 1
                        changed = 1
                    }
                }
                ci += 1
            }
            i += 1
        }
    }
    let const_cap int = 0
    i = 0
    for i < count {
        if (reachable[i] != 0) {
            const_cap += comptime.ct_iface_const_count(i)
        }
        i += 1
    }
    let closure_consts *int = 0
    if (const_cap > 0) {
        closure_consts = malloc(((const_cap + 1) * sizeof(int)).to_type(u64)) .
            to_type(*int)
        if (closure_consts == 0) {
            free(reachable.to_type(*void))
            return support.fail("CT 接口常量闭包分配失败")
        }
    }
    let const_n int = 0
    i = 0
    for i < count {
        if (reachable[i] != 0) {
            let refs int = comptime.ct_iface_const_count(i)
            let ci int = 0
            for ci < refs {
                let target_const int = comptime.ct_iface_const_at(i, ci)
                let found int = 0
                let cj int = 0
                for cj < const_n {
                    if (closure_consts[cj] == target_const) {
                        found = 1
                        break
                    }
                    cj += 1
                }
                if (found == 0) {
                    closure_consts[const_n] = target_const
                    const_n += 1
                }
                ci += 1
            }
        }
        i += 1
    }
    i = 0
    for i < const_n {
        if (iface_ct_emit_const(closure_consts[i], support.fs().sym_sfx_off,
                support.fs().sym_sfx_len) != 0) {
            if (closure_consts != 0) { free(closure_consts.to_type(*void)) }
            free(reachable.to_type(*void))
            return -1
        }
        i += 1
    }
    if (closure_consts != 0) { free(closure_consts.to_type(*void)) }
    i = 0
    for i < count {
        if (reachable[i] != 0
            && iface_ct_emit_function(i, support.fs().sym_sfx_off,
                support.fs().sym_sfx_len) != 0) {
            free(reachable.to_type(*void))
            return -1
        }
        i += 1
    }
    free(reachable.to_type(*void))
    return iface_ct_write(path)
}

// iface_ct_head_prefix_len：校验 .s.ct 头前缀（版本必须为 CTIFACE_VERSION，
// 架构与当前目标一致），成功返回 suffix 起点，失败返回 -1。
pub fn iface_ct_head_prefix_len() int {
    return iface_ct_head_prefix_len_at(support.src_ctx().data, support.src_ctx().length)
}

// iface_ct_head_prefix_len_at：纯函数版本，供内嵌测试构造输入。
pub fn iface_ct_head_prefix_len_at(src *u8, n int) int {
    if (iface_lit_at(src, n, 0, CTIFACE_HEAD_PREFIX) == 0) { return -1 }
    let i int = support.cstr_len(CTIFACE_HEAD_PREFIX)
    let ver int = 0
    let digits int = 0
    for i < n {
        if (src[i] < '0' || src[i] > '9') { break }
        ver = ver * 10 + src[i].to_type(int) - 48
        i += 1
        digits += 1
    }
    if (digits == 0 || ver != CTIFACE_VERSION) { return -1 }
    if (iface_lit_at(src, n, i, IFACE_HEAD_ARCH) == 0) { return -1 }
    i = iface_arch_at(src, n, i + support.cstr_len(IFACE_HEAD_ARCH))
    if (i < 0) { return -1 }
    if (iface_lit_at(src, n, i, IFACE_HEAD_SUFFIX) == 0) { return -1 }
    return i + support.cstr_len(IFACE_HEAD_SUFFIX)
}

pub fn sem_call_begin(callee *support.Res) int {
    if (support.session().compile == 0) {
        return 1
    }
    // 嵌套调用：记录本层实参基线与直接调用标志（内层不污染外层）
    if (support.fc().c_call_depth >= 64) {
        return token.err_tok("调用嵌套过深")
    }
    support.fc().c_call_base[support.fc().c_call_depth] = support.fc().c_arg_n
    support.fc().c_call_direct[support.fc().c_call_depth] = 0
    support.fc().c_call_abi[support.fc().c_call_depth] = support.ABI_YH
    if (support.ms().types[callee.type_id].kind == support.TY_FN) {
        support.fc().c_call_abi[support.fc().c_call_depth] = support.ms().sig_abi[support.ms().types[callee.type_id].sub]
    }
    support.fc().c_call_depth += 1
    if (callee.sym >= 0) {
        if (support.ms().syms[callee.sym].kind == support.SYM_FN) {
            support.fc().c_call_direct[support.fc().c_call_depth - 1] = 1
            return 1
        }
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("函数调用不是编译期常量")
    }
    return 0
}

// sem_push_arg：每个实参求值后立即保存标量或按值聚合副本，后续实参不能改变已求值的值。
// callee 提供形参类型；数组退化为指针时仍保存原地址，切片副本只复制描述符、不复制元素。
pub fn sem_push_arg(r *support.Res, callee *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_arg_n >= 256) {
        return token.err_tok("实参过多")
    }
    sem_res_copy(&support.fc().c_args[support.fc().c_arg_n], r)
    support.fc().c_argtys[support.fc().c_arg_n] = r.type_id
    support.fc().c_arg_n += 1
    if (support.fc().c_fold != 0) {
        return 0
    }
    let kind int = support.ms().types[r.type_id].kind
    let copy int = 0
    if (support.fc().c_call_depth > 0) {
        let depth int = support.fc().c_call_depth - 1
        if (support.fc().c_call_abi[depth] == support.ABI_C && (kind == support.TY_STRUCT || kind == support.TY_UNION)) {
            copy = 1
        }
        if (support.ms().types[callee.type_id].kind == support.TY_FN) {
            let sig int = support.ms().types[callee.type_id].sub
            let position int = support.fc().c_arg_n - support.fc().c_call_base[depth] - 1
            if (position < support.ms().sig_np[sig]) {
                let want int = support.ms().sig_params[support.ms().sig_first[sig] + position]
                if (support.ms().types[want].kind == kind
                    && (kind == support.TY_ARRAY || kind == support.TY_SLICE || kind == support.TY_STRUCT || kind == support.TY_UNION)) {
                    copy = 1
                }
            }
        }
    }
    return sem_push_value(r)
}

// sem_call：检查本层实参并发射调用。整数与浮点寄存器独立编号，
// 混合实参先全部暂存，再分类装载，保证每个值栈槽只消费一次。
pub fn sem_call(callee *support.Res, r *support.Res) int {
    if (support.session().compile == 0) {
        sem_res_reset(r, 0)
        return 0
    }
    if (support.ms().types[callee.type_id].kind != support.TY_FN) {
        return token.err_tok("被调用的表达式不是函数")
    }
    support.fc().c_call_depth -= 1
    let base int = support.fc().c_call_base[support.fc().c_call_depth]
    let direct int = support.fc().c_call_direct[support.fc().c_call_depth]
    let sig int = support.ms().types[callee.type_id].sub
    let np int = support.ms().sig_np[sig]
    let vararg int = support.ms().sig_vararg[sig]
    let ret int = support.ms().sig_ret[sig]
    let na int = support.fc().c_arg_n - base
    let noreturn int = 0
    if (direct != 0 && callee.sym >= 0
        && (support.ms().syms[callee.sym].flags & support.F_NORETURN) != 0) {
        noreturn = 1
    }
    // vararg==2：类型化变参（末尾打包为切片）；==1：裸 C 变参（仅 prelude）
    if (vararg == 2) {
        if (na < np) {
            return token.err_tok("实参个数少于固定参数")
        }
    } else if (na < np || (na > np && vararg == 0)) {
        return token.err_tok("实参个数与函数签名不符")
    }
    // 实参类型检查
    let first int = support.ms().sig_first[sig]
    let i int = 0
    for i < na {
        let want int = 0
        if (i < np) {
            want = support.ms().sig_params[first + i]
        } else {
            want = -1
        }
        if (want >= 0) {
            // C ABI 回调的函数类型必须保存 C 调用约定；直接函数、变量、
            // 返回值和字段均按完整签名检查，普通 yh 函数不能穿过边界。
            if (support.ms().types[want].kind == support.TY_FN && support.ms().sig_abi[sig] == support.ABI_C) {
                let arg_tid int = support.fc().c_args[base + i].type_id
                if (support.ms().types[arg_tid].kind != support.TY_FN
                    || support.ms().sig_abi[support.ms().types[arg_tid].sub] != support.ABI_C) {
                    return token.err_tok("C ABI 回调实参必须是 extern 函数")
                }
            }
            // 数组实参按指针形参退化
            let wat int = support.fc().c_args[base + i].type_id
            if (support.ms().types[wat].kind == support.TY_ARRAY && support.ms().types[want].kind == support.TY_PTR) {
                if (support.ms().types[wat].elem != support.ms().types[want].elem && support.ms().types[want].elem != support.TY_VOID) {
                    return token.err_tok("数组元素类型与指针形参不匹配")
                }
                i += 1
                continue
            }
            // 切片实参按切片形参（同元素类型；长度不参与相容判断）
            if (support.ms().types[wat].kind == support.TY_SLICE && support.ms().types[want].kind == support.TY_SLICE) {
                if (support.ms().types[wat].elem != support.ms().types[want].elem && support.ms().types[want].elem != support.TY_VOID) {
                    return token.err_tok("切片元素类型不匹配")
                }
                i += 1
                continue
            }
            if (sem_can_assign(want, wat, support.fc().c_args[base + i].is_lit, support.fc().c_args[base + i].ival, support.fc().c_args[base + i].lit_big) != 0) {
                return -1
            }
        } else if (vararg == 2) {
            // 类型化变参：尾部实参类型须与元素类型相容
            let velem_t int = support.ms().types[support.ms().sig_params[first + np]].elem
            if (sem_can_assign(velem_t, support.fc().c_args[base + i].type_id, support.fc().c_args[base + i].is_lit, support.fc().c_args[base + i].ival, support.fc().c_args[base + i].lit_big) != 0) {
                return -1
            }
        } else {
            // 裸变参位置：整数/指针按 C 提升进寄存器
            let at2 int = support.fc().c_args[base + i].type_id
            let k2 int = support.ms().types[at2].kind
            if (support.ty_is_float(at2) != 0) {
                return token.err_tok("裸变参的浮点实参将在 B7 支持")
            }
            if (k2 == support.TY_STRUCT || k2 == support.TY_UNION || k2 == support.TY_ARRAY || k2 == support.TY_SLICE) {
                return token.err_tok("聚合类型不能传给裸变参")
            }
        }
        i += 1
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("函数调用不是编译期常量")
    }
    if (support.ms().sig_abi[sig] == support.ABI_C) {
        // LL12：C ABI 的寄存器/栈搬运由 lowering 处理，语义层只记录结果形态。
        let ret_c int = support.ms().sig_ret[sig]
        let ret_agg_c int = (support.ms().types[ret_c].kind == support.TY_STRUCT
            || support.ms().types[ret_c].kind == support.TY_UNION).to_type(int)
        support.fc().c_arg_n = base
        sem_res_reset(r, ret_c)
        support.fc().c_res_is_addr = ret_agg_c
        // noreturn 的 C 调用仍是不可达边界，可达性判定必须保留。
        if (noreturn != 0) { support.fc().c_expr_noreturn = 1 }
        return 0
    }
    // 类型化变参：尾部实参打包为切片参数（数据由 lowering 生成）。
    let na2 int = na
    if (vararg == 2) {
        let vslice int = support.ms().sig_params[first + np]
        // 尾部已变成切片参数，后续分类不能沿用第一个浮点变参的类型。
        support.fc().c_args[base + np].type_id = vslice
        na2 = np + 1
    }
    // LL12：寄存器/栈实参与调用指令由 lowering 生成，这里保留浮点上限诊断。
    let regn int = na2
    if (support.tg_darwin() != 0 && vararg == 1 && na2 > np) { regn = np }
    let nfp int = 0
    let k int = base
    for k < base + regn {
        if (support.ty_is_float(support.fc().c_args[k].type_id) != 0) { nfp += 1 }
        k += 1
    }
    if (nfp > support.TG_ARG_REGS) {
        return token.err_tok("过多的浮点参数暂不支持")
    }
    let retk int = support.ms().types[ret].kind
    if (noreturn != 0) { support.fc().c_expr_noreturn = 1 }
    support.fc().c_arg_n = base
    sem_res_reset(r, ret)
    support.fc().c_res_is_addr = (retk == support.TY_STRUCT || retk == support.TY_UNION
        || retk == support.TY_ARRAY || retk == support.TY_SLICE).to_type(int)
    return 0
}

pub fn sem_return_value(r *support.Res) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    // LL12：聚合返回的缓冲拷贝与 return 跳转由 lowering 生成，这里只保留事实。
    if (support.fc().c_ret_agg != 0) {
        support.fc().c_ret_agg_val = 1
    }
    return 0
}

pub fn sem_lit_field_lookup(tid int, start int, n int) int {
    return sem_field_lookup(tid, start, n)
}

pub fn sem_struct_lit_begin(tid int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.ty_is_opaque(tid) != 0) {
        return token.err_tok("不透明 C 类型不能构造实例")
    }
    // pub struct 一等化：字段一律公开，跨模块位置式构造不再检查字段 pub。
    if (support.fc().c_lit_depth >= 32) {
        return token.err_tok("结构体字面量嵌套过深")
    }
    let off int = 0
    // 保存外层字面量的定位状态，供嵌套字面量结束后恢复
    support.fc().c_lit_save_off[support.fc().c_lit_depth] = support.fc().c_lit_off
    support.fc().c_lit_save_tid[support.fc().c_lit_depth] = support.fc().c_lit_tid
    support.fc().c_lit_depth += 1
    support.fc().c_lit_off = off
    support.fc().c_lit_tid = tid
    return off
}

pub fn sem_struct_lit_field(tid int, fidx int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    let ftid int = support.ms().fields[fidx].type_id
    let foff int = support.ms().fields[fidx].offset
    let fk int = support.ms().types[ftid].kind
    if (sem_can_assign(ftid, support.fc().c_lit_last_type, support.fc().c_lit_last_lit, support.fc().c_lit_last_ival, 0) != 0) {
        return -1
    }
    return 0
}

pub fn sem_struct_lit_end(tid int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    // 恢复外层字面量的定位状态；结果地址由 lowering 生成。
    support.fc().c_lit_depth -= 1
    support.fc().c_lit_off = support.fc().c_lit_save_off[support.fc().c_lit_depth]
    support.fc().c_lit_tid = support.fc().c_lit_save_tid[support.fc().c_lit_depth]
    return 0
}

pub fn sem_fn_begin(idx int) int {
    support.fc().c_fn_sym = idx
    support.fc().c_fn_flags = support.ms().syms[idx].flags
    support.fc().c_fn_falls = 1
    support.fc().c_expr_noreturn = 0
    support.fc().c_fn_ret = support.ms().types[support.ms().syms[idx].type_id].elem
    // LL12：标签、栈槽、序言与体缓冲等机器状态由 LLVM lowering 生成，
    // 语义层只保留类型事实与诊断状态。
    support.fc().c_temp_off = 0
    support.fc().c_fp_tmp_off = 0
    support.fc().c_glabel_n = 0
    support.fc().c_spill_n = 0
    support.fc().c_aggparam_n = 0
    support.fc().c_fp_argn = 0
    support.fc().c_ret_ptr_off = 0
    support.fc().c_ret_agg_val = 0
    abi_c_cursor_init(&support.fc().c_cabi_cursor, support.tg_darwin())
    support.fc().c_fp_off = 16
    // 聚合返回：记录间接返回事实，返回缓冲地址由 lowering 处理。
    let rk int = support.ms().types[support.fc().c_fn_ret].kind
    let indirect_ret int = 1
    if ((support.fc().c_fn_flags & support.F_CABI) != 0) {
        let result support.ABIArg
        abi_c_result(support.fc().c_fn_ret, &result)
        indirect_ret = result.indirect
    }
    if (indirect_ret != 0 && (rk == support.TY_STRUCT || rk == support.TY_UNION
        || rk == support.TY_ARRAY || rk == support.TY_SLICE)) {
        support.fc().c_ret_agg = 1
    } else {
        support.fc().c_ret_agg = 0
    }
    scope_push()
    return 0
}

pub fn sem_declare_param(start int, n int, tid int, regidx int) int {
    if (support.ty_has_opaque_value(tid) != 0) {
        return token.err_tok("不透明 C 类型只能通过指针传递")
    }
    // LL12：C ABI 的寄存器/栈分类由 LLVM lowering 处理，语义层只登记参数。
    let pk int = support.ms().types[tid].kind
    let is_agg int = ((pk == support.TY_ARRAY) || (pk == support.TY_STRUCT) || (pk == support.TY_UNION)
                      || (pk == support.TY_SLICE)).to_type(int)
    let idx int = sym_push(start, n, support.SYM_VAR, tid, support.F_PARAM)
    if (idx < 0) {
        return -1
    }
    if (is_agg != 0) {
        // 聚合按值：形参持有调用方副本；独立副本与栈槽由 lowering 生成。
        support.ms().syms[idx].flags |= support.F_AGGPARAM
        support.fc().c_aggparam_n += 1
        return 0
    }
    if (support.ty_is_float(tid) != 0) {
        // yh 内部函数的浮点参数上限由旧 ABI 约定决定；C 函数按 lowering 的
        // ABI 分类处理（HFA 逐成员占寄存器，不受此上限约束）。
        if ((support.fc().c_fn_flags & support.F_CABI) == 0) {
            if (support.fc().c_fp_argn >= support.TG_ARG_REGS) {
                return token.err_tok("过多的浮点参数暂不支持")
            }
            support.fc().c_fp_argn += 1
        }
        return 0
    }
    return 0
}

pub fn sem_fn_end() int {
    if (sem_glabels_verify() != 0) {
        return -1
    }
    if ((support.fc().c_fn_flags & support.F_NORETURN) != 0) {
        if (support.fc().c_fn_ret != support.TY_VOID) {
            return token.err_tok("noreturn 函数必须返回 void")
        }
        if (support.fc().c_fn_falls != 0) {
            return token.err_tok("noreturn 函数存在正常落底路径")
        }
    }
    // LL12：落底返回、prologue、聚合参数入口拷贝与 epilogue 由 lowering 生成。
    scope_pop()
    return 0
}

// sem_add_field：为 struct/union 登记一个字段（pass 1）。
// pub struct 一等化后字段一律公开，is_pub 恒 1（.s.i 接口按此发射）。
pub fn sem_add_field(stid int, start int, n int, ftid int) int {
    if (support.ty_has_opaque_value(ftid) != 0) {
        return token.err_tok("不透明 C 类型只能通过指针使用")
    }
    let fk int = support.ms().types[ftid].kind
    if ((support.ty_name_attrs(stid) & token.ATTR_EXTERN) != 0 && ty_c_layout(ftid) == 0) {
        return token.err_tok("extern struct/union 字段不是 C 兼容布局类型")
    }
    if ((fk == support.TY_STRUCT || fk == support.TY_UNION) && support.ms().types[ftid].size == 0) {
        return token.err_tok("字段使用了不完整的类型")
    }
    if (support.ms().field_n == support.ms().field_cap) {
        let ncap int = support.ms().field_cap * 2
        if (ncap == 0) {
            ncap = 64
        }
        let nd *support.SField = malloc((ncap * sizeof(support.SField)).to_type(u64)).to_type(*support.SField)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.ms().field_n > 0) {
            memcpy(nd, support.ms().fields, (support.ms().field_n * sizeof(support.SField)).to_type(u64))
        }
        free(support.ms().fields)
        support.ms().fields = nd
        support.ms().field_cap = ncap
    }
    let off int = support.name_intern(start, n)
    if (off < 0) {
        return -1
    }
    support.ms().fields[support.ms().field_n].name_off = off
    support.ms().fields[support.ms().field_n].name_len = n
    support.ms().fields[support.ms().field_n].type_id = ftid
    support.ms().fields[support.ms().field_n].offset = 0
    support.ms().fields[support.ms().field_n].is_pub = 1
    support.ms().field_n += 1
    support.ms().types[stid].len = support.ms().field_n - support.ms().types[stid].sub
    return 0
}

// sem_check_main：程序编译/项目入口检查，缺少 main 即失败。
pub fn sem_check_main() int {
    return sem_check_main_common(1)
}

// sem_check_main_optional：单文件库 check 使用；main 可缺席，但存在时仍校验签名。
pub fn sem_check_main_optional() int {
    return sem_check_main_common(0)
}

pub fn sem_push_value(r *support.Res) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.ty_is_float(r.type_id) != 0) {
        return 0
    }
    return 0
}

pub fn sem_binop(op int, lhs *support.Res, rhs *support.Res) int {
    let tid int = 0
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    // 运算数检查
    if (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT || op == token.TK_LEQ
        || op == token.TK_GT || op == token.TK_GEQ) {
        // 指针只参与 ==/!=（与 0 或同型）
        if (support.ms().types[lhs.type_id].kind == support.TY_PTR || support.ms().types[rhs.type_id].kind == support.TY_PTR) {
            if (op != token.TK_EQEQ && op != token.TK_NEQ) {
                return token.err_tok("指针只支持 == / != 比较")
            }
            let ok int = 0
            if (lhs.type_id == rhs.type_id) { ok = 1 }
            if (support.ms().types[lhs.type_id].elem == support.TY_VOID) { ok = 1 }
            if (support.ms().types[rhs.type_id].elem == support.TY_VOID) { ok = 1 }
            if (rhs.is_lit != 0 && rhs.is_const != 0 && rhs.ival == 0) { ok = 1 }
            if (lhs.is_lit != 0 && lhs.is_const != 0 && lhs.ival == 0) { ok = 1 }
            if (ok == 0) {
                return token.err_tok("指针比较类型不匹配")
            }
            support.sem_res_const(lhs, support.TY_BOOL, 0)
            if (support.fc().c_fold == 0) {
            }
            support.fc().c_res_is_addr = 0
            return 0
        }
    }
    // 字面量适配：一侧是字面量时借用另一侧类型
    if (rhs.is_lit != 0 && support.ty_is_scalar(lhs.type_id) != 0
        && support.ty_is_integer(lhs.type_id) != 0 && support.ty_is_integer(rhs.type_id) != 0) {
        if (support.sem_lit_fits(lhs.type_id, rhs.ival) != 0) {
            rhs.type_id = lhs.type_id
        }
    }
    if (lhs.is_lit != 0 && support.ty_is_scalar(rhs.type_id) != 0
        && support.ty_is_integer(lhs.type_id) != 0 && support.ty_is_integer(rhs.type_id) != 0) {
        if (support.sem_lit_fits(rhs.type_id, lhs.ival) != 0) {
            lhs.type_id = rhs.type_id
        }
    }
    // 指针算术：p + i / p - i（按元素大小缩放下标）；指针比较另走分支
    let lk int = support.ms().types[lhs.type_id].kind
    let rk int = support.ms().types[rhs.type_id].kind
    if ((lk == support.TY_PTR && rk == support.TY_PTR) || lk == support.TY_ARRAY || rk == support.TY_ARRAY) {
        return token.err_tok("指针/数组不参与该运算")
    }
    if (lk == support.TY_PTR && support.ty_is_integer(rhs.type_id) != 0) {
        if (op == token.TK_PLUS || op == token.TK_MINUS) {
            if (support.fc().c_fold != 0) {
                return token.err_tok("指针运算不是编译期常量")
            }
            support.fc().c_res_is_addr = 1   // 结果是地址（可再解引用/下标）
            return 0
        }
        return token.err_tok("指针只支持 + / - 整数")
    }
    if (rk == support.TY_PTR && support.ty_is_integer(lhs.type_id) != 0 && op == token.TK_PLUS) {
        if (support.fc().c_fold != 0) {
            return token.err_tok("指针运算不是编译期常量")
        }
        // x9 = 整数，x0 = 指针：交换后缩放
        // 结果类型取指针一侧（此前漏设会让 `i + p` 被当成整数）
        lhs.type_id = rhs.type_id
        support.fc().c_res_is_addr = 1
        return 0
    }
    tid = sem_promote(lhs.type_id, rhs.type_id)
    if (support.ty_is_float(tid) != 0) {
        // 浮点二元/比较：折叠时直接按位模式求值，运行期左 d1、右 d0（值栈已按序压入）
        if (support.fc().c_fold != 0) {
            if (lhs.is_const == 0 || rhs.is_const == 0) {
                return token.err_tok("这里需要编译期常量")
            }
            let value i64 = 0
            if (sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) {
                return -1
            }
            let fp_cmp int = (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT
                || op == token.TK_LEQ || op == token.TK_GT || op == token.TK_GEQ).to_type(int)
            if (fp_cmp != 0) {
                support.sem_res_const(lhs, support.TY_BOOL, value)
            } else {
                support.sem_res_const(lhs, tid, value)
                lhs.fval_bits = value
            }
            return 0
        }
        let iscmp int = (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT
                         || op == token.TK_LEQ || op == token.TK_GT || op == token.TK_GEQ).to_type(int)
        if (op != token.TK_PLUS && op != token.TK_MINUS && op != token.TK_STAR && op != token.TK_SLASH
            && iscmp == 0) {
            return token.err_tok("浮点不支持该运算")
        }
        if (iscmp != 0) {
            support.sem_res_const(lhs, support.TY_BOOL, 0)
        } else {
            sem_res_reset(lhs, tid)
        }
        lhs.is_const = 0
        support.fc().c_res_is_addr = 0
        return 0
    }
    if (support.ty_is_scalar(tid) == 0) {
        return token.err_tok("该类型不支持算术运算")
    }
    let is_cmp int = 0
    if (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT || op == token.TK_LEQ
        || op == token.TK_GT || op == token.TK_GEQ) {
        is_cmp = 1
    }
    if (support.fc().c_fold != 0) {
        if (lhs.is_const == 0 || rhs.is_const == 0) {
            return token.err_tok("这里需要编译期常量")
        }
        let value i64 = 0
        if (sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) { return -1 }
        if (is_cmp != 0) {
            support.sem_res_const(lhs, support.TY_BOOL, value)
        } else {
            support.sem_res_const(lhs, tid, value)
            // 浮点常量同时保留位模式，供 const 初始化与浮点装载使用。
            if (support.ty_is_float(tid) != 0) { lhs.fval_bits = value }
        }
        return 0
    }
    if (is_cmp != 0) {
        support.sem_res_const(lhs, support.TY_BOOL, 0)
    } else {
        // 运算按 64 位计算，源结果先恢复定宽位型，随后扩大转换不能读取高位残留。
        sem_res_reset(lhs, tid)
    }
    lhs.is_const = 0
    support.fc().c_res_is_addr = 0
    return 0
}

// sem_shortcircuit：检查逻辑左值；折叠时保存真值，运行时发射短路跳转。
pub fn sem_shortcircuit(op int, lhs *support.Res) int {
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        if (support.ty_is_scalar(lhs.type_id) == 0 || support.ty_is_float(lhs.type_id) != 0) {
            return token.err_tok("逻辑运算要求非浮点标量")
        }
        if (lhs.is_const == 0) {
            return token.err_tok("逻辑运算要求编译期常量")
        }
        if (support.fc().sc_sc_depth >= 64) {
            return token.err_tok("逻辑运算嵌套超过 64 层")
        }
        support.fc().sc_sc_false_stk[support.fc().sc_sc_depth] = (lhs.ival != 0).to_type(int)
        support.fc().sc_sc_depth += 1
        support.fc().c_res_is_addr = 0
        return sem_res_reset(lhs, support.TY_BOOL)
    }
    // 保存外层短路标签（嵌套 a&&b||c&&d 时内层不破坏外层）
    support.fc().sc_sc_false_stk[support.fc().sc_sc_depth] = support.fc().sc_lbl_false
    support.fc().sc_sc_end_stk[support.fc().sc_sc_depth] = support.fc().sc_lbl_end
    support.fc().sc_sc_depth += 1
    support.fc().sc_lbl_false = 0
    support.fc().sc_lbl_end = 0
    if (op == token.TK_ANDAND) {
    } else {
    }
    sem_res_reset(lhs, support.TY_BOOL)
    support.fc().c_res_is_addr = 0
    return 0
}

// sem_shortcircuit_end：合并折叠的左右真值，或补齐运行时短路分支并恢复外层标签。
pub fn sem_shortcircuit_end(op int, lhs *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_fold != 0) {
        if (support.ty_is_scalar(lhs.type_id) == 0 || support.ty_is_float(lhs.type_id) != 0) {
            return token.err_tok("逻辑运算要求非浮点标量")
        }
        if (lhs.is_const == 0) {
            return token.err_tok("逻辑运算要求编译期常量")
        }
        support.fc().sc_sc_depth -= 1
        let left int = support.fc().sc_sc_false_stk[support.fc().sc_sc_depth]
        let right int = (lhs.ival != 0).to_type(int)
        let value int = 0
        if (op == token.TK_ANDAND) { value = (left != 0 && right != 0).to_type(int) }
        else { value = (left != 0 || right != 0).to_type(int) }
        support.fc().c_res_is_addr = 0
        return support.sem_res_const(lhs, support.TY_BOOL, value.to_type(i64))
    }
    if (op == token.TK_ANDAND) {
        // 左真且右真 → 结果 1
    } else {
        // || ：左或右为真 → 结果 1
    }
    lhs.is_const = 0
    support.fc().c_res_is_addr = 0
    // 恢复外层短路标签（嵌套 a&&b||c&&d：内层用完即还）
    support.fc().sc_sc_depth -= 1
    support.fc().sc_lbl_false = support.fc().sc_sc_false_stk[support.fc().sc_sc_depth]
    support.fc().sc_lbl_end = support.fc().sc_sc_end_stk[support.fc().sc_sc_depth]
    return 0
}

pub fn sem_ternary_cond(lhs *support.Res) int {
    if (support.session().compile == 0) {
        lhs.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("三元不支持编译期折叠")
    }
    // 保存外层三元标签（嵌套 `a ? b : (c ? d : e)` 时内层不破坏外层；
    // 此前共用一对全局标签，内层覆盖外层后发射重复 .L 标签）
    if (support.fc().tn_depth >= 64) {
        return token.err_tok("三元表达式嵌套超过 64 层")
    }
    support.fc().tn_else_stk[support.fc().tn_depth] = support.fc().tn_lbl_else
    support.fc().tn_end_stk[support.fc().tn_depth] = support.fc().tn_lbl_end
    support.fc().tn_depth += 1
    support.fc().tn_lbl_else = 0
    support.fc().tn_lbl_end = 0
    return 0
}

pub fn sem_ternary_mid(lhs *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    return 0
}

pub fn sem_ternary_end(lhs *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    support.fc().c_res_is_addr = 0
    // 恢复外层三元标签（嵌套时内层用完即还）
    support.fc().tn_depth -= 1
    support.fc().tn_lbl_else = support.fc().tn_else_stk[support.fc().tn_depth]
    support.fc().tn_lbl_end = support.fc().tn_end_stk[support.fc().tn_depth]
    return 0
}

pub fn sem_unary(op int, operand *support.Res) int {
    if (support.session().compile == 0) {
        operand.type_id = 0
        return 0
    }
    if (op == token.TK_STAR) {
        if (support.ms().types[operand.type_id].kind != support.TY_PTR) {
            return token.err_tok("解引用的操作数必须是指针")
        }
        let elem int = support.ms().types[operand.type_id].elem
        let ek int = support.ms().types[elem].kind
        let agg int = (ek == support.TY_STRUCT || ek == support.TY_UNION
            || ek == support.TY_ARRAY || ek == support.TY_SLICE).to_type(int)
        if (support.fc().c_lvalue == 0 && support.fc().c_fold == 0 && agg == 0) {
            // x0 = 指针值（地址）→ 装入点值
        }
        // 聚合的值语义就是对象地址（见 emit_arm64.yh 的聚合原语约定）：
        // 解引用聚合**不装入**，x0 保持地址；按标量装入会把对象开头 8 字节
        // 当成地址（`*dst = *src` 曾因此块拷贝到野地址而段错误）。
        support.fc().c_res_is_addr = 1
        sem_res_reset(operand, support.ms().types[operand.type_id].elem)
        operand.is_const = 0
        return 0
    }
    if (op == token.TK_AMP) {
        if (support.fc().c_res_is_addr == 0) {
            return token.err_tok("取地址的操作数必须是左值")
        }
        let pt int = ty_ptr(operand.type_id)
        sem_res_reset(operand, pt)
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (operand.is_const != 0) {
        // 常量（含字面量）：折叠求值并保留字面量性（如 let n i8 = -100）
        if (support.ty_is_float(operand.type_id) != 0) {
            let fp_value i64 = 0
            if (sem_fold_const_unary(op, operand.type_id, operand.ival,
                    operand.is_lit, &fp_value) != 0) { return -1 }
            operand.ival = fp_value
            operand.fval_bits = fp_value
            if (support.fc().c_fold == 0) {
            }
            return 0
        }
        let unary_type int = operand.type_id
        if (support.ms().types[unary_type].kind == support.TY_BOOL) { unary_type = support.TY_I32 }
        if (support.ty_is_integer(operand.type_id) != 0) {
            // 超出当前整数宽度的负数字面量先提升为 i64，保留完整值供赋值与二元运算适配。
            if (op == token.TK_MINUS && operand.is_lit != 0 && operand.ival >= 0) {
                let negative i64 = 0 - operand.ival
                if (support.sem_lit_fits(unary_type, negative) == 0
                    && support.sem_lit_fits(support.TY_I64, negative) != 0) {
                    unary_type = support.TY_I64
                }
            }
            let value i64 = 0
            if (sem_fold_const_unary(op, unary_type, operand.ival,
                    operand.is_lit, &value) != 0) { return -1 }
            operand.ival = value
        } else {
            operand.ival = fold_unary(op, operand.ival)
            unary_type = support.TY_I32
        }
        // 常量与动态一元结果类型一致；bool 已升为 int，其他整数保留原宽度/符号性。
        operand.type_id = unary_type
        // 结果是新常量值，原符号绑定只属于操作数子节点；括号不能继承为错型基本表达式。
        operand.sym = -1
        return 0
    }
    let tid int = operand.type_id
    if (support.ty_is_float(tid) != 0) {
        if (op == token.TK_MINUS) {
            sem_res_reset(operand, tid)
            support.fc().c_res_is_addr = 0
            return 0
        }
        if (op == token.TK_PLUS) {
            return 0
        }
        return token.err_tok("浮点只支持一元 +/-")
    }
    if (support.ms().types[tid].kind == support.TY_BOOL) {
        tid = support.TY_I32
    }
    if (support.ty_is_scalar(tid) == 0) {
        return token.err_tok("该类型不支持一元运算")
    }
    sem_res_reset(operand, tid)
    support.fc().c_res_is_addr = 0
    return 0
}

pub fn sem_index(base *support.Res, idx *support.Res) int {
    if (support.session().compile == 0) {
