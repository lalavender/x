    }
    // 切片：基址是切片数据指针（槽内偏移 8），需先取 data 字段
    if (bk == support.TY_SLICE) {
    }
    // 地址 = 基址(x9) + 下标(x0) * 元素大小
    let esz int = support.ms().types[elem].size
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
        // 任意大小的聚合元素（如 20 字节的 Tok）：乘法缩放
    }
    let ek int = support.ms().types[elem].kind
    if (ek == support.TY_STRUCT || ek == support.TY_UNION || ek == support.TY_ARRAY || ek == support.TY_SLICE) {
        // 聚合元素：保留地址语义（成员/下标链后续再加偏移）
        support.fc().c_res_is_addr = 1
    } else if (support.fc().c_lvalue == 0) {
        if (support.ty_is_float(elem) != 0) {
            // 浮点元素：装入浮点寄存器
            let fsfx *char = "d"
            if (support.ms().types[elem].size == 4) { fsfx = "s" }
        } else {
        }
        support.fc().c_res_is_addr = 0
    } else {
        support.fc().c_res_is_addr = 1
    }
    sem_res_reset(base, elem)
    return 0
}

pub fn sem_slice(base *support.Res, sres *support.Res, eres *support.Res) int {
    if (support.session().compile == 0) {
        base.type_id = 0
        return 0
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("切片表达式不是编译期常量")
    }
    let bk int = support.ms().types[base.type_id].kind
    if (bk != support.TY_ARRAY && bk != support.TY_SLICE) {
        return token.err_tok("切片表达式需要数组或切片")
    }
    if (support.ty_is_integer(sres.type_id) == 0 || support.ty_is_integer(eres.type_id) == 0) {
        return token.err_tok("切片下标必须是整数")
    }
    let elem int = support.ms().types[base.type_id].elem
    let esz int = support.ms().types[elem].size
    // x0 = end → x11 暂存；弹 start → x0；弹 base → x10
    // 切片基址取 data 字段（{len, data} 的偏移 8）
    if (bk == support.TY_SLICE) {
    }
    // x9 = max(0, end - start)
    let l_pos int = 0
    // x0 = start * 元素大小
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
    }
    // x0 = 数据指针 = 基址 + start*esz
    // 构造 {len, data} 临时切片
    let soff int = 0
    base.type_id = ty_slice(elem)
    base.is_lit = 0
    base.is_const = 0
    support.fc().c_res_is_addr = 1
    return 0
}

pub fn sem_member(base *support.Res, name_start int, name_len int) int {
    if (support.session().compile == 0) {
        base.type_id = 0
        return 0
    }
    // 基底求值后的 x0 形态（进入本函数时 c_res_is_addr 尚未被改写）：
    // 1 = x0 是「存放基底的变量的地址」（如指针变量的 lvalue 引用、
    //     解引用未装载的 *p），指针基底需先 ldr 装入结构地址；
    // 0 = x0 已是基底值本身（函数调用返回的指针、RVALUE 已装载的变量），
    //     不得再间接一次——否则多解一层，字段访问落在野地址上。
    // 枚举基底：`EnumName.member` 里枚举类型名在模块模式下会被求值成枚举值
    //（类型名登记成常量符号，形态随 pass 变化），此时按成员名查符号表取成员常量。
    if (base.type_id >= 0 && support.ms().types[base.type_id].kind == support.TY_ENUM) {
        let msym int = support.sym_lookup(name_start, name_len)
        if (msym < 0) {
            // 名字表里查不到时按名字反查枚举成员表（登记时快照名字与值，不经过符号表）：
            // 模块 worker 二次解析编译期正文时枚举成员符号不可见（实测）。
            let eidx int = support.em_find(name_start, name_len)
            if (eidx >= 0 && support.em_get_ready(eidx) != 0) {
                let evalue i64 = support.em_get_val(eidx)
                support.sem_res_const(base, base.type_id, evalue)
                return 0
            }
        }

        // 不校验成员符号的 type_id：模块模式下枚举成员登记时的类型上下文与基底
        // 枚举类型 id 不总一致；枚举成员注册在全局名字表里，同名成员本就不能共存。
        if (msym < 0 || (support.ms().syms[msym].flags & support.F_ENUM_MEMBER) == 0) {
            // 模块模式：枚举类型名会被求值成枚举值，而此时成员符号在当前编译单元的
            // 名字表里已经查不到（实测），因此这里只能给出可操作的诊断。同模块顶层
            // 常量引用同一成员是正常的，推荐用常量中转。
            if (support.cfg().module_mode != 0) {
                return token.err_tok("模块模式下编译期正文里直接引用枚举成员暂不支持；请在同模块顶层用 `pub const X int = 枚举名.成员;` 中转后再引用")
            }
            return token.err_tok("枚举没有这个成员")
        }
        if (support.ms().syms[msym].const_ready == 0) {
            return token.err_tok("编译期常量尚未就绪")
        }
        let value i64 = support.ms().syms[msym].cval
        support.sem_res_const(base, base.type_id, value)
        return 0
    }
    let base_indirect int = support.fc().c_res_is_addr
    let bk int = support.ms().types[base.type_id].kind
    let stid int = 0
    if (bk == support.TY_PTR) {
        stid = support.ms().types[base.type_id].elem
        if (support.ms().types[stid].kind != support.TY_STRUCT && support.ms().types[stid].kind != support.TY_UNION) {
            return token.err_tok("『.』的左侧不是结构体或结构体指针")
        }
    } else if (bk == support.TY_STRUCT || bk == support.TY_UNION) {
        stid = base.type_id
    } else {
        return token.err_tok("『.』的左侧不是结构体或结构体指针")
    }
    if (support.ty_is_opaque(stid) != 0) {
        return token.err_tok("不透明 C 类型没有可访问字段")
    }
    // 字段查找
    let st int = support.ms().types[stid].sub
    let nf int = support.ms().types[stid].len
    let found int = -1
    let i int = 0
    for i < nf {
        let f int = st + i
        if (support.ms().fields[f].name_len == name_len) {
            let match int = 1
            let j int = 0
            for j < name_len {
                if (support.pool_ctx().data[support.ms().fields[f].name_off + j] != support.src_ctx().data[name_start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                found = f
                break
            }
        }
        i += 1
    }
    if (found < 0) {
        return token.err_tok("结构体没有该字段")
    }
    // pub struct 一等化：字段一律公开，跨模块访问不再有字段级限制
    // （类型的跨模块可见性仍由类型自身的 pub 决定）。
    if (support.fc().c_fold != 0) {
        return token.err_tok("字段访问不是编译期常量")
    }
    let off int = support.ms().fields[found].offset
    if (bk == support.TY_PTR) {
        if (support.fc().c_lvalue != 0 && base_indirect != 0) {
            // x0 = 指针变量的地址 → 装入指针值
        }
        // x0 = 结构体地址；加字段偏移
    }
    if (off > 0) {
        if (off <= 4095) {
        } else {
            // 深结构体的字段偏移超出 add 的 12 位无符号立即数范围，借 x12 装偏移
            // （与 em_lea_local* 的深帧约定一致：调用方不依赖 x12 跨 lea 存活）。
        }
    }
    let ftid int = support.ms().fields[found].type_id
    if (support.fc().c_lvalue == 0) {
        let fk int = support.ms().types[ftid].kind
        if (fk != support.TY_STRUCT && fk != support.TY_UNION && fk != support.TY_ARRAY && fk != support.TY_SLICE) {
            support.fc().c_res_is_addr = 0
        } else {
            // 聚合字段：保持地址语义
            support.fc().c_res_is_addr = 1
        }
    } else {
        support.fc().c_res_is_addr = 1
    }
    sem_res_reset(base, ftid)
    return 0
}

pub fn sem_sizeof(tid int, r *support.Res) int {
    sem_res_reset(r, support.TY_I32)
    if (support.session().compile == 0) {
        return 0
    }
    if (support.ty_is_opaque(tid) != 0) {
        return token.err_tok("不透明 C 类型不能用于 sizeof")
    }
    if (support.ms().types[tid].size < 0) {
        // typed CT 函数先保存 sizeof 的目标类型，等布局调度器完成依赖后再执行。
        if (support.session().ast_capture != 0 && support.session().pass == 2) {
            r.layout_type_id = tid
            return 0
        }
        return token.err_tok("sizeof 的类型布局尚未就绪")
    }
    r.is_const = 1
    r.is_lit = 0
    r.ival = support.ms().types[tid].size.to_type(i64)
    return 0
}

pub fn sem_len(r *support.Res) int {
    if (support.session().compile == 0) {
        r.type_id = 0
        return 0
    }
    let k int = support.ms().types[r.type_id].kind
    if (k == support.TY_ARRAY) {
        // 编译期折叠为常量并直接装 x0（同 sem_sizeof：折叠出的常量由
        // 这里物化，消费端不负责）。必须清 support.fc().c_res_is_addr——实参（数组
        // 标识符）的聚合地址语义会残留，否则 x0 里的数组地址被当成
        // 结果（曾致 return len(arr) 返回地址而非长度）。
        support.fc().c_res_is_addr = 0
        support.sem_res_const(r, support.TY_I32, support.ms().types[r.type_id].len.to_type(i64))
        return 0
    }
    if (k == support.TY_SLICE) {
        if (support.fc().c_fold != 0) {
            return token.err_tok("切片长度不是编译期常量")
        }
        // 切片值在 x0（地址）；读 [x0] 的长度
        sem_res_reset(r, support.TY_I32)
        support.fc().c_res_is_addr = 0
        return 0
    }
    return token.err_tok("len 需要一个数组或切片")
}

pub fn sem_cast(operand *support.Res, tid int) int {
    if (support.session().compile == 0) {
        operand.type_id = 0
        return 0
    }
    let ok int = support.ms().types[tid].kind
    if (ok == support.TY_VOID) {
        return token.err_tok("不能转换为 void")
    }
    let sk int = support.ms().types[operand.type_id].kind
    if (sk == support.TY_FN && ok == support.TY_FN
        && support.ms().sig_abi[support.ms().types[operand.type_id].sub] != support.ms().sig_abi[support.ms().types[tid].sub]) {
        return token.err_tok("函数类型转换不能改变 C/yh 调用约定")
    }
    let scalar_to_scalar int = 0
    if (support.ty_is_scalar(tid) != 0 && support.ty_is_scalar(operand.type_id) != 0) {
        scalar_to_scalar = 1
    }
    // 数组 → 切片视图：构造 {len, data} 临时聚合（ADR-0002 的规范化视图）
    if (sk == support.TY_ARRAY && ok == support.TY_SLICE) {
        if (support.ms().types[operand.type_id].elem != support.ms().types[tid].elem) {
            return token.err_tok("数组元素类型与目标切片不一致")
        }
        if (support.fc().c_fold != 0) {
            return token.err_tok("数组转切片不是编译期常量")
        }
        let arrlen int = support.ms().types[operand.type_id].len
        // x0 = 数组地址（数组值即地址）
        let soff int = 0
        operand.type_id = tid
        operand.is_lit = 0
        operand.is_const = 0
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (scalar_to_scalar == 0) {
        return token.err_tok("该转换不支持（标量之间或指针/整数）")
    }
    // 编译期常量转换：浮点参与的转换写位模式，整数转换按目标宽度归一。
    if (support.fc().c_fold != 0 && operand.is_const != 0) {
        if (support.ty_is_float(operand.type_id) != 0 || support.ty_is_float(tid) != 0) {
            let value i64 = support.sem_fold_float_convert(operand.type_id, tid, operand.ival)
            operand.ival = value
            operand.fval_bits = value
        } else {
            operand.ival = support.sem_fold_norm(tid, operand.ival)
        }
        operand.type_id = tid
        support.fc().c_res_is_addr = 0
        return 0
    }
    if (support.fc().c_fold == 0 && support.fc().c_res_is_addr == 0) {
        // 运行时转换
        let from_fp int = support.ty_is_float(operand.type_id)
        let to_fp int = support.ty_is_float(tid)
        if (to_fp != 0 && from_fp == 0) {
            let src_signed int = support.ty_is_signed(operand.type_id)
        } else if (to_fp != 0 && from_fp != 0) {
            // 浮点宽度转换：f32<->f64（d0/s0 互转）
            if (support.ms().types[operand.type_id].size != support.ms().types[tid].size) {
                if (support.ms().types[tid].size == 4) {
                } else {
                }
            }
        } else if (to_fp == 0 && from_fp != 0) {
            let dst_signed int = support.ty_is_signed(tid)
        } else if (support.ms().types[operand.type_id].size != support.ms().types[tid].size
                   || support.ty_is_signed(operand.type_id) != support.ty_is_signed(tid)) {
            // 整数 → 整数：x0 中按源类型已扩展，需按目标宽度/符号性重新扩展。
            // 例如 i64 → int 必须截断到低 32 位并符号扩展，否则比较/运算会用
            // 到高位的残留值（曾导致 i64 的 int 视图比较结果错误）。
        }
        // 其余整数→整数（更宽或同宽同符号）已在 x0 中正确扩展，无需发码。
    }
    operand.type_id = tid
    operand.is_lit = 0
    support.fc().c_res_is_addr = 0
    return 0
}

pub fn sem_forin_begin(it *support.Res, is_range int, end_res *support.Res) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.fc().c_fi_depth >= 64) {
        return token.err_tok("for-in 嵌套过深")
    }
    let d int = support.fc().c_fi_depth
    support.fc().c_fi_cnt_off[d] = 0
    support.fc().c_fi_len_off[d] = 0
    support.fc().c_fi_data_off[d] = 0
    support.fc().c_fi_step_off[d] = 0
    support.fc().c_fi_elem_off[d] = -1
    support.fc().c_fi_idx_off[d] = -1
    if (is_range != 0) {
        support.fc().c_fi_kind[d] = 1
        // x0 = 起点。先存 data 槽（起点），再与终点比较定步长与长度。
        // x11 = 终点（从临时槽）。用 x11 而非 x9：深帧下
        // em_lea_local_to 拼地址走 movz x9，会覆盖 x9 里的终点，
        // 区间长度被算成「槽偏移 - 起点」（run/27：长度 287 而非 4，
        // range_sum 累加成 37128——小帧时 lea 走 sub x10 不触雷，
        // 故 mini 复现全过）
        // x0 = 起点
        // 长度 = max(0, 终点 - 起点)：x11 = 终点-起点；若 <0 置 0
        let l_pos int = 0
        // x11 == 0：空区间，长度 0（保持 x11=0 即可）
        // 步长恒 +1（左闭右开区间）。先取地址再装常量：深帧 lea 的
        // movz x9 不能落在步长已入 x9 之后（同数组 len 的教训）
        support.fc().c_fi_depth += 1
        return 0
    }
    // 数组/切片
    support.fc().c_fi_kind[d] = 0
    let k int = support.ms().types[it.type_id].kind
    if (k == support.TY_ARRAY) {
        // 先取地址再装 len：深帧 lea 的 movz x9 不能落在 len 已入 x9 之后
    } else if (k == support.TY_SLICE) {
    } else {
        return token.err_tok("for-in 需要数组、切片或区间")
    }
    support.fc().c_fi_depth += 1
    return 0
}

pub fn sem_forin_elem_type(it *support.Res, is_range int) int {
    if (is_range != 0) {
        // 区间迭代绑定是默认整数类型 int（与 stage0 一致，便于 int 变量累加）
        return support.TY_I32
    }
    return support.ms().types[it.type_id].elem
}

pub fn sem_forin_set_bind(elem_off int, idx_off int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.fc().c_fi_depth == 0) {
        return token.err_tok("内部错误：for-in 状态缺失")
    }
    support.fc().c_fi_elem_off[support.fc().c_fi_depth - 1] = elem_off
    support.fc().c_fi_idx_off[support.fc().c_fi_depth - 1] = idx_off
    return 0
}

pub fn sem_forin_check(lbl_end int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    let d int = support.fc().c_fi_depth - 1
    return 0
}

pub fn sem_forin_load(it *support.Res, is_range int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    let d int = support.fc().c_fi_depth - 1
    if (is_range != 0) {
        // 下标 = count；值 = 起点 + count*step
        if (support.fc().c_fi_idx_off[d] >= 0) {
        }
        if (support.fc().c_fi_elem_off[d] >= 0) {
            // x0 = count（下标）；值 = 起点 + count
        }
        return 0
    }
    // 数组/切片：值 = data[count]
    let elem int = support.ms().types[it.type_id].elem
    if (support.fc().c_fi_idx_off[d] >= 0) {
    }
    // 缩放下标 → data + i*size
    let esz int = support.ms().types[elem].size
    if (esz == 2) {
    } else if (esz == 4) {
    } else if (esz == 8) {
    } else if (esz != 1) {
    }
    if (support.fc().c_fi_elem_off[d] >= 0) {
        let ek int = support.ms().types[elem].kind
        if (ek == support.TY_STRUCT || ek == support.TY_UNION || ek == support.TY_ARRAY || ek == support.TY_SLICE) {
            // 聚合元素：块拷贝进绑定槽。x0 = 元素地址（add 的结果），
            // 先取绑定槽地址（x10）再拷贝——深帧 lea 的 movz x9 不碰
            // x0，此序天然安全；原「mov x9, x0 保地址」会被 lea 覆盖
            // （copy_block 源错）
        } else {
            // 标量元素：x10 = 元素地址，load 到 x0 后存绑定槽
        }
    }
    return 0
}

pub fn sem_forin_step(lbl_cond int) int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    let d int = support.fc().c_fi_depth - 1
    return 0
}

pub fn sem_forin_end() int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    support.fc().c_fi_depth -= 1
    return 0
}

pub fn sem_stash_lvalue() int {
    if (support.session().compile == 0 || support.fc().c_fold != 0) {
        return 0
    }
    if (support.fc().c_temp_off == 0) {
        support.fc().c_temp_off = 0
    }
    // 先保护 x0 中的左值地址，再取临时槽地址，最后写入
    return 0
}

pub fn sem_assign(op int, lres *support.Res, rres *support.Res) int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_fold != 0) {
        return token.err_tok("赋值不是编译期常量")
    }
    if (support.ty_is_float(lres.type_id) != 0) {
        // 浮点赋值：值在 d0/s0
        if (op == token.TK_ASSIGN) {
            let fs *char = "d"
            if (support.ms().types[lres.type_id].size == 4) { fs = "s" }
            return 0
        }
        // 复合赋值：右值（d0）存入专用临时槽；目标地址进出 x10 各两次
        //（每次 em_lea_local_to 都会覆盖 x10，目标地址先压栈保护、用后
        // 弹回；压/弹必须成对，此前弹空栈导致 d1 从垃圾地址装入）。
        let fs2 *char = "d"
        if (support.ms().types[lres.type_id].size == 4) { fs2 = "s" }
        if (support.fc().c_fp_tmp_off == 0) {
            support.fc().c_fp_tmp_off = 0
        }
        let fb int = op
        if (op == token.TK_PLUSEQ) { fb = token.TK_PLUS }
        if (op == token.TK_MINUSEQ) { fb = token.TK_MINUS }
        if (op == token.TK_STAREQ) { fb = token.TK_STAR }
        if (op == token.TK_SLASHEQ) { fb = token.TK_SLASH }
        return 0
    }
    if (op == token.TK_ASSIGN) {
        // x10 先取回暂存的目标地址再存（临时槽里存的是地址，不是目标）
        // 聚合同型赋值 = 逐字节块拷贝（语义边界 §：数组同型赋值为值
        // 复制）。聚合的值语义即对象地址：x0 是源对象地址，x10 是目标
        // 地址；此前误走标量 store 只写前 8 字节。
        let lk int = support.ms().types[lres.type_id].kind
        if (lk == support.TY_STRUCT || lk == support.TY_UNION || lk == support.TY_ARRAY || lk == support.TY_SLICE) {
            return 0
        }
        return 0
    }
    // 复合赋值：x10 先取回暂存的左值地址，再读值运算后经 x10 存回
    let tid int = sem_promote(lres.type_id, rres.type_id)
    let base int = op
    if (op == token.TK_PLUSEQ) { base = token.TK_PLUS }
    if (op == token.TK_MINUSEQ) { base = token.TK_MINUS }
    if (op == token.TK_STAREQ) { base = token.TK_STAR }
    if (op == token.TK_SLASHEQ) { base = token.TK_SLASH }
    if (op == token.TK_PERCENTEQ) { base = token.TK_PERCENT }
    if (op == token.TK_AMPEQ) { base = token.TK_AMP }
    if (op == token.TK_PIPEEQ) { base = token.TK_PIPE }
    if (op == token.TK_CARETEQ) { base = token.TK_CARET }
    if (op == token.TK_LSHIFTEQ) { base = token.TK_LSHIFT }
    if (op == token.TK_RSHIFTEQ) { base = token.TK_RSHIFT }
    return 0
}

pub fn sem_declare_local(start int, n int, tid int) int {
    if (support.ty_has_opaque_value(tid) != 0) {
        return token.err_tok("不透明 C 类型只能通过指针声明局部变量")
    }
    let size int = support.ms().types[tid].size
    let idx int = sym_push(start, n, support.SYM_VAR, tid, 0)
    if (idx < 0) {
        return -1
    }
    let off int = 0
    support.ms().syms[idx].offset = off
    // 零初始化（标量直接清零；聚合逐字节循环）
    if (size == 0) {
        return idx
    }
    if (size <= 8) {
        let zk *char = "strb\twzr, [x10]"
        if (size == 2) { zk = "strh\twzr, [x10]" }
        if (size == 4) { zk = "str\twzr, [x10]" }
        if (size == 8) { zk = "str\txzr, [x10]" }
        return idx
    }
    // 聚合清零循环：x9 = 剩余字节，x10 = 游标。先取槽地址再装计数器：
    // 深帧 lea 的 movz x9 会覆盖计数器（清零长度错/死循环）
    let lz int = 0
    let ld int = 0
    return idx
}

pub fn sem_store_local_value(idx int, tid int) int {
    if (support.session().compile == 0) {
        return 0
    }
    let k int = support.ms().types[tid].kind
    if (k == support.TY_STRUCT || k == support.TY_UNION || k == support.TY_ARRAY || k == support.TY_SLICE) {
        // 聚合初始化：x0 = 源聚合地址 → 块拷贝进局部槽
        let off int = support.ms().syms[idx].offset
        return 0
    }
    if (support.ty_is_float(tid) != 0) {
        return 0
    }
    let soff int = support.ms().syms[idx].offset
    if (soff <= 255) {
        // 按大小选寄存器与助记符
        let size int = support.ms().types[tid].size
        if (size == 8) {
        } else if (size == 4) {
        } else if (size == 2) {
        } else {
        }
        return 0
    }
    // 偏移超出未缩放立即数范围：地址写 x10（不覆盖 x0 中的待存值）
    return 0
}

pub fn sem_check_duplicate(start int, n int) int {
    let i int = support.ms().sym_n - 1
    for i >= support.ms().scope_start[support.ms().scope_n - 1] {
        if (support.ms().syms[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.ms().syms[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return token.err_tok("同一作用域内重复声明")
            }
        }
        i -= 1
    }
    return 0
}

pub fn sem_goto(start int, n int) int {
    if (support.session().compile == 0) {
        return 0
    }
    // 已定义？
    let i int = 0
    for i < support.fc().c_glabel_n {
        if (support.fc().c_glabels[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.fc().c_glabels[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return 0
            }
        }
        i += 1
    }
    // 前向引用：登记
    if (support.fc().c_glabel_n >= 128) {
        return token.err_tok("goto 标签过多")
    }
    let off int = support.name_intern(start, n)
    support.fc().c_glabels[support.fc().c_glabel_n].name_off = off
    support.fc().c_glabels[support.fc().c_glabel_n].name_len = n
    let lbl int = 0
    support.fc().c_glabels[support.fc().c_glabel_n].lbl = lbl
    support.fc().c_glabels[support.fc().c_glabel_n].defined = 0
    support.fc().c_glabel_n += 1
    return 0
}

pub fn sem_deflabel(start int, n int) int {
    if (support.session().compile == 0) {
        return 0
    }
    let i int = 0
    for i < support.fc().c_glabel_n {
        if (support.fc().c_glabels[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.fc().c_glabels[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (support.fc().c_glabels[i].defined != 0) {
                    return token.err_tok("标签重定义")
                }
                support.fc().c_glabels[i].defined = 1
                return 0
            }
        }
        i += 1
    }
    if (support.fc().c_glabel_n >= 128) {
        return token.err_tok("goto 标签过多")
    }
    let off int = support.name_intern(start, n)
    support.fc().c_glabels[support.fc().c_glabel_n].name_off = off
    support.fc().c_glabels[support.fc().c_glabel_n].name_len = n
    let lbl int = 0
    support.fc().c_glabels[support.fc().c_glabel_n].lbl = lbl
    support.fc().c_glabels[support.fc().c_glabel_n].defined = 1
    support.fc().c_glabel_n += 1
    return 0
}

pub fn sem_loop_push(brk int, cnt int) int {
    if (support.fc().c_loop_depth >= 64) {
        return token.err_tok("循环嵌套过深")
    }
    support.fc().c_brk_stk[support.fc().c_loop_depth] = brk
    support.fc().c_cnt_stk[support.fc().c_loop_depth] = cnt
    support.fc().c_loop_break_seen[support.fc().c_loop_depth] = 0
    support.fc().c_loop_depth += 1
    support.fc().c_loop_brk = brk
    support.fc().c_loop_cnt = cnt
    return 0
}

pub fn sem_loop_pop() int {
    support.fc().c_loop_depth -= 1
    if (support.fc().c_loop_depth > 0) {
        support.fc().c_loop_brk = support.fc().c_brk_stk[support.fc().c_loop_depth - 1]
        support.fc().c_loop_cnt = support.fc().c_cnt_stk[support.fc().c_loop_depth - 1]
    }
    return 0
}

pub fn sem_break() int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_loop_depth == 0) {
        return token.err_tok("break 不在循环内")
    }
    support.fc().c_loop_break_seen[support.fc().c_loop_depth - 1] = 1
    return 0
}

pub fn sem_continue() int {
    if (support.session().compile == 0) {
        return 0
    }
    if (support.fc().c_loop_depth == 0) {
        return token.err_tok("continue 不在循环内")
    }
    return 0
}

pub fn sem_res_reset(r *support.Res, tid int) int {
    r.type_id = tid
    r.is_const = 0
    r.ival = 0
    r.sym = -1
    r.is_lit = 0
    r.lit_big = 0
    r.fval_bits = 0
    r.ast_id = -1
    r.layout_type_id = -1
    r.ct_diag = 0
    r.ct_diag_expr = -1
    r.ct_diag_line = 0
    r.ct_diag_col = 0
    r.ct_diag_msg_start = -1
    r.ct_diag_msg_len = 0
    return 0
}

pub fn sem_res_copy(dst *support.Res, src *support.Res) int {
    dst.type_id = src.type_id
    dst.is_const = src.is_const
    dst.ival = src.ival
    dst.sym = src.sym
    dst.is_lit = src.is_lit
    dst.lit_big = src.lit_big
    dst.fval_bits = src.fval_bits
    dst.ast_id = src.ast_id
    dst.layout_type_id = src.layout_type_id
    dst.ct_diag = src.ct_diag
    dst.ct_diag_expr = src.ct_diag_expr
    dst.ct_diag_line = src.ct_diag_line
    dst.ct_diag_col = src.ct_diag_col
    dst.ct_diag_msg_start = src.ct_diag_msg_start
    dst.ct_diag_msg_len = src.ct_diag_msg_len
    return 0
}

pub fn sem_number(start int, n int, r *support.Res) int {
    sem_res_reset(r, support.TY_I32)
    if (support.session().compile == 0) {
        return 0
    }
    r.is_lit = 1
    r.is_const = 1
    // 浮点字面量（含 '.' 或指数）按 f64 处理
    if (sem_num_is_float(start, n) != 0) {
        r.type_id = support.TY_F64
        let bits i64 = sem_parse_float_bits(start, n)
        // 位模式同时写入 ival 与 fval_bits：const 初始化按 ival 保存常量值，
        // 浮点使用点读 fval_bits，两者必须一致。
        r.ival = bits
        r.fval_bits = bits
        return 0
    }
    if (sem_parse_number(start, n) != 0) {
        return -1
    }
    r.ival = support.fc().c_fold_ival
    r.lit_big = support.fc().c_fold_big
    return 0
}

pub fn sem_num_is_float(start int, n int) int {
    // 前缀进制字面量（0x/0X/0o/0O/0b/0B）恒为整数：其中的 e/E 是
    // 十六进制数字而非浮点指数（对齐 docs/yh.g4 的 NUMBER 规则——
    // 修复 0x1E、0xAA0103E0 等被误判为 f64 的缺陷）。
    if (n >= 2 && support.src_ctx().data[start] == '0') {
        let p2 u8 = support.src_ctx().data[start + 1]
        if (p2 == 'x' || p2 == 'X' || p2 == 'o' || p2 == 'O' || p2 == 'b' || p2 == 'B') {
            return 0
        }
    }
    let i int = 0
    for i < n {
        let b u8 = support.src_ctx().data[start + i]
        if (b == '.' || b == 'e' || b == 'E') {
            // 前缀 0x/0o/0b 中的 x/o/b 不算
            return 1
        }
        i += 1
    }
    return 0
}

// 宿主 C 运行库的十进制 → binary64：glibc 与 macOS libSystem 的 strtod 都
// 按当前舍入模式做正确舍入（就近、平局取偶），避免旧实现「逐位乘十」在
// 大指数（如 1.5e300）产生 1 ULP 偏差。词法器已校验字面量形状；这里只
// 去掉 `_` 分隔符并补 NUL，再交给 strtod。
// 依赖边界：编译器已链接宿主 libc（malloc/free 等）；E1 迁移到 libs/os 时
// 需要给字面量解析提供等价的纯 yh 实现（见 todo）。
@[extern] fn strtod(text *char, endptr *void) f64

pub fn sem_string(start int, slen int, r *support.Res) int {
    sem_res_reset(r, ty_ptr(support.TY_CHAR))
    if (support.session().compile == 0) {
        return 0
    }
    // LL12：标签只登记，字符串数据由后端快照按标签生成。
    let lbl int = support.data_label_advance()
    // 登记标签 → 原样字节，供编译期过程与后端快照按标签号反查。
    if (support.data_str_add(lbl, start, slen) != 0) { return -1 }
    r.is_const = 1
    r.ival = lbl.to_type(i64)
    return 0
}

// sem_raw_string：登记不含引号的字符串体（插值文本块/说明符）。
// 与 sem_string 相同的数据标签路径，quoted=2 让解码器处理转义但不剥引号。
pub fn sem_raw_string(start int, slen int, r *support.Res) int {
    sem_res_reset(r, ty_ptr(support.TY_CHAR))
    if (support.session().compile == 0) {
        return 0
    }
    let lbl int = support.data_label_advance()
    if (support.data_str_add_body(lbl, start, slen) != 0) { return -1 }
    r.is_const = 1
    r.ival = lbl.to_type(i64)
    return 0
}

pub fn sem_char(start int, clen int, r *support.Res) int {
    sem_res_reset(r, support.TY_CHAR)
    if (support.session().compile == 0) {
        return 0
    }
    // 解码单一字符/转义单元（start+1 起）
    let b u8 = support.src_ctx().data[start + 1]
    let v int = b.to_type(int)
    if (b == '\\') {
        let e u8 = support.src_ctx().data[start + 2]
        v = 0
        if (e == 'n') { v = 10 }
        if (e == 'r') { v = 13 }
        if (e == 't') { v = 9 }
        if (e == '0') { v = 0 }
        if (e == 'a') { v = 7 }
        if (e == 'b') { v = 8 }
        if (e == 'f') { v = 12 }
        if (e == 'v') { v = 11 }
        if (e == '\'') { v = 39 }
        if (e == '"') { v = 34 }
        if (e == '\\') { v = 92 }
        if (e == '$') { v = 36 }
        if (e == 'x') {
            v = support.hexval(support.src_ctx().data[start + 3]) * 16 + support.hexval(support.src_ctx().data[start + 4])
        }
    }
    r.is_const = 1
    r.is_lit = 1
    r.ival = v.to_type(i64)
    return 0
}

pub fn sem_bool(v int, r *support.Res) int {
    support.sem_res_const(r, support.TY_BOOL, v.to_type(i64))
    if (support.session().compile == 0) {
        return 0
    }
    return 0
}

pub fn sem_ident(start int, n int, r *support.Res) int {
    sem_res_reset(r, 0)
    if (support.session().compile == 0) {
        return 0
    }
    let idx int = support.sym_lookup(start, n)
    if (idx < 0) {
        return token.err_tok("引用了未声明的名字")
    }
    return sem_ident_val(idx, r)
}

pub fn sem_ident_val(idx int, r *support.Res) int {
    r.ast_id = -1
    r.sym = idx
    r.type_id = support.ms().syms[idx].type_id
    let kind int = support.ms().syms[idx].kind
    // 聚合常量（结构体/数组/切片/联合体）没有标量值：数据已发射到数据段，
    // 与全局变量同路径按符号地址访问，不能走下面的立即数取值分支。
    if (kind == support.SYM_CONST) {
        let ck int = support.ms().types[support.ms().syms[idx].type_id].kind
        if (ck == support.TY_STRUCT || ck == support.TY_ARRAY || ck == support.TY_SLICE || ck == support.TY_UNION) {
            // 聚合常量只读：**赋值目标**（c_lvalue == 1）直接拒绝。降级为变量语义只是
            // 为了按符号地址读取，不能连可写性一起放开；取地址（c_lvalue >= 2）是合法的
            // 只读引用，放行 —— 否则 `$f(&TABLE[0])` 这类编译期实参会被误拒。
            if (support.fc().c_lvalue == 1) {
                return token.err_tok("不能给 const 聚合常量赋值")
            }
            // 导入的聚合常量：接口加载时物化了本单元副本（cval = 本地数据标签号），
            // 按标签装载地址（与字符串指针常量同一路径），提供方符号不参与消费者链接。
            if ((support.ms().syms[idx].flags & support.F_EXTERN) != 0
                && support.ms().syms[idx].cval != 0) {
                support.fc().c_res_is_addr = 1
                return 0
            }
            kind = support.SYM_VAR
        }
    }
    if (kind == support.SYM_CONST) {
        if ((support.ms().syms[idx].flags & (support.F_ENUM_META | support.F_FIELD_META)) != 0) {
            // 元信息绑定（枚举 values / 结构体 fields）：本身不是值，
            // 只能投影 .name/.value（枚举）或 .name（字段）或作类型谓词实参。
            if (support.ms().syms[idx].const_ready == 0) {
                return token.err_tok("编译期元信息绑定尚未就绪")
            }
            return 0
        }
        if (support.ms().syms[idx].const_ready == 0) {
            if (support.fc().c_ct_prepare_active != 0
                && (support.fc().c_fn_flags & support.F_COMPTIME) != 0) {
                return 0
            }
            return token.err_tok("编译期常量尚未就绪")
        }
        r.is_const = 1
        r.ival = support.ms().syms[idx].cval
        if ((support.ms().syms[idx].flags & support.F_ADDR) != 0) {
            // 指针常量：值是数据标签
            return 0
        }
        if (support.ty_is_float(r.type_id) != 0) {
            r.fval_bits = support.ms().syms[idx].cval
        }
        return 0
    }
    if (kind == support.SYM_FN) {
        if (support.fc().c_fold != 0) {
            return token.err_tok("函数引用不是编译期常量")
        }
        support.fc().c_res_is_addr = 1
        return 0
    }
    // 变量
    if (support.fc().c_fold != 0) {
        return token.err_tok("变量不是编译期常量")
    }
    let tid int = support.ms().syms[idx].type_id
    let k int = support.ms().types[tid].kind
    let global int = ((support.ms().syms[idx].flags & support.F_GLOBAL) != 0).to_type(int)
    if (k == support.TY_ARRAY || k == support.TY_STRUCT || k == support.TY_UNION || k == support.TY_SLICE) {
        // 聚合：值语义即地址（数组退化 / 结构体以地址使用）
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (support.fc().c_lvalue != 0) {
        support.fc().c_res_is_addr = 1
        return 0
    }
    if (support.ty_is_float(tid) != 0) {
        support.fc().c_res_is_addr = 0
        return 0
    }
    support.fc().c_res_is_addr = 0
    return 0
}

// sem_enum_meta_value：把枚举 values 迭代绑定的 value 投影为只读枚举常量。
pub fn sem_enum_meta_value(meta *support.Res) int {
    if (meta.sym < 0 || meta.sym >= support.ms().sym_n
        || (support.ms().syms[meta.sym].flags & support.F_ENUM_META) == 0) {
        return token.err_tok("枚举 values 元信息绑定无效")
    }
    if (support.fc().c_lvalue != 0) {
        return token.err_tok("枚举 values 成员只读")
    }
    let member int = support.ms().syms[meta.sym].offset
    if (member < 0 || member >= support.ms().sym_n
        || (support.ms().syms[member].flags & support.F_ENUM_MEMBER) == 0
        || support.ms().syms[member].const_ready == 0) {
        return token.err_tok("枚举 values 成员索引无效")
    }
    let tid int = support.ms().syms[member].type_id
    let value i64 = support.ms().syms[member].cval
    support.sem_res_const(meta, tid, value)
    return 0
}

// sem_enum_meta_name：把枚举 values 迭代绑定的 name 投影为静态 C 字符串。
pub fn sem_enum_meta_name(meta *support.Res) int {
    if (meta.sym < 0 || meta.sym >= support.ms().sym_n
        || (support.ms().syms[meta.sym].flags & support.F_ENUM_META) == 0) {
        return token.err_tok("枚举 values 元信息绑定无效")
    }
    if (support.fc().c_lvalue != 0) {
        return token.err_tok("枚举 values 成员只读")
    }
    let member int = support.ms().syms[meta.sym].offset
    if (member < 0 || member >= support.ms().sym_n
        || (support.ms().syms[member].flags & support.F_ENUM_MEMBER) == 0
        || support.ms().syms[member].const_ready == 0) {
        return token.err_tok("枚举 values 成员索引无效")
    }
    // LL12：标签只登记，名称数据由快照生成。
    let lbl int = support.data_label_advance()
    if (support.data_str_add_pool(lbl, support.ms().syms[member].name_off,
        support.ms().syms[member].name_len) != 0) { return -1 }
    sem_res_reset(meta, ty_ptr(support.TY_CHAR))
    meta.is_const = 1
    meta.ival = lbl.to_type(i64)
    return 0
}

// sem_field_meta_name：把 `$for f in T.fields` 迭代绑定的 name 投影为只读
// 字段名静态 C 字符串。绑定槽位约定见 model.yh 的 support.F_FIELD_META：
// cval 存宿主结构体/联合体类型 id，offset 存字段下标。
pub fn sem_field_meta_name(meta *support.Res) int {
    if (meta.sym < 0 || meta.sym >= support.ms().sym_n
        || (support.ms().syms[meta.sym].flags & support.F_FIELD_META) == 0) {
        return token.err_tok("字段元信息绑定无效")
    }
    if (support.fc().c_lvalue != 0) {
        return token.err_tok("字段元信息只读")
    }
    let owner int = support.ms().syms[meta.sym].cval.to_type(int)
    let index int = support.ms().syms[meta.sym].offset
    if (owner < 0 || owner >= support.ms().type_n
        || (support.ms().types[owner].kind != support.TY_STRUCT
            && support.ms().types[owner].kind != support.TY_UNION)
        || index < 0 || index >= support.ms().types[owner].len) {
        return token.err_tok("字段元信息索引无效")
    }
    let field support.SField = support.ms().fields[support.ms().types[owner].sub + index]
    // LL12：标签只登记，名称数据由快照生成。
    let lbl int = support.data_label_advance()
    if (support.data_str_add_pool(lbl, field.name_off, field.name_len) != 0) { return -1 }
    sem_res_reset(meta, ty_ptr(support.TY_CHAR))
    meta.is_const = 1
    meta.ival = lbl.to_type(i64)
    return 0
}

// ty_push：向类型表追加条目，返回新类型编号。
// support.ms().home 平行数组同步增长（类型归属：-1 本地 / >=0 模块编号）。
pub fn ty_push(kind int, size int, align int, elem int, n int, sub int) int {
    return support.model_type_push(kind, size, align, elem, n, sub)
}

// ty_register_builtins：登记 0..12 号内建类型（固定编号，勿改顺序）。
pub fn ty_register_builtins() int {
    ty_push(support.TY_VOID, 0, 0, -1, -1, -1)
    ty_push(support.TY_BOOL, support.TG_CHAR_SIZE, support.TG_CHAR_SIZE, -1, -1, -1)
    ty_push(support.TY_CHAR, support.TG_CHAR_SIZE, support.TG_CHAR_SIZE, -1, -1, -1)
    ty_push(support.TY_I8, 1, 1, -1, -1, -1)
    ty_push(support.TY_I16, support.TG_SHORT_SIZE, support.TG_SHORT_SIZE, -1, -1, -1)
    ty_push(support.TY_I32, support.TG_INT_SIZE, support.TG_INT_SIZE, -1, -1, -1)
    ty_push(support.TY_I64, support.TG_LONG_SIZE, support.TG_LONG_SIZE, -1, -1, -1)
    ty_push(support.TY_U8, 1, 1, -1, -1, -1)
    ty_push(support.TY_U16, support.TG_SHORT_SIZE, support.TG_SHORT_SIZE, -1, -1, -1)
    ty_push(support.TY_U32, support.TG_INT_SIZE, support.TG_INT_SIZE, -1, -1, -1)
    ty_push(support.TY_U64, support.TG_LONG_SIZE, support.TG_LONG_SIZE, -1, -1, -1)
    ty_push(support.TY_F32, 4, 4, -1, -1, -1)
    ty_push(support.TY_F64, 8, 8, -1, -1, -1)
    return 0
}

// ty_push_agg：登记聚合类型并检查登记上限。
// 与方案 §4 一致：保留 512 的聚合类型登记上限，超限必须干净报错，
// 不能越界（对应 tests/yh-run/fail/12-wraps-too-many.yh）。
pub fn ty_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    return support.model_type_push_agg(kind, size, align, elem, n, sub)
}

// ty_ptr：指向 elem 的指针类型（按内容去重）。
pub fn ty_ptr(elem int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == support.TY_PTR && support.ms().types[i].elem == elem) {
            return i
        }
        i += 1
    }
    return ty_push(support.TY_PTR, support.TG_PTR_SIZE, support.TG_PTR_SIZE, elem, -1, -1)
}

// ty_array：[len] elem 定长数组类型（按内容去重）。
pub fn ty_array(elem int, alen int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == support.TY_ARRAY && support.ms().types[i].elem == elem && support.ms().types[i].len == alen) {
            return i
        }
        i += 1
    }
    let esz int = support.ms().types[elem].size
    let eal int = support.ms().types[elem].align
    if (eal < 1) {
        eal = 1
    }
    let size int = esz * alen
    let rpad int = (0 - size) % eal
    if (rpad < 0) {
        rpad += eal
    }
    size += rpad
    return ty_push_agg(support.TY_ARRAY, size, eal, elem, alen, -1)
}

// ty_slice：切片类型 []T = {u64 长度, T *数据}（16 字节聚合视图）。
// 去重按元素类型；元素类型参与同型判断（ADR-0001/0002）。
pub fn ty_slice(elem int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == support.TY_SLICE && support.ms().types[i].elem == elem) {
            return i
        }
        i += 1
    }
    return ty_push(support.TY_SLICE, support.TG_LONG_SIZE * 2, support.TG_LONG_SIZE, elem, -1, -1)
}

// ty_sig_param：向参数类型池追加一个参数类型。
pub fn ty_sig_param(tid int) int {
    if (intvec_grow(&support.ms().sig_params, support.ms().sigparam_n, &support.ms().sigparam_cap) != 0) {
        return -1
    }
    support.ms().sig_params[support.ms().sigparam_n] = tid
    support.ms().sigparam_n += 1
    return 0
}

// ty_fn：函数类型（签名按内容去重：返回 + 参数个数 + 逐个参数类型）。
// ty_fn_abi：按调用约定、返回与完整参数签名去重，禁止 C/yh 函数值混用。
pub fn ty_fn_abi(ret int, first int, np int, vararg int, abi int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == support.TY_FN) {
            let s int = support.ms().types[i].sub
            if (support.ms().sig_abi[s] == abi && support.ms().sig_ret[s] == ret && support.ms().sig_np[s] == np && support.ms().sig_vararg[s] == vararg) {
                let match int = 1
                let j int = 0
                for j < np {
                    if (support.ms().sig_params[support.ms().sig_first[s] + j] != support.ms().sig_params[first + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    return i
                }
            }
        }
        i += 1
    }
    let ns int = ty_sig_add(ret, np, vararg)
    if (ns < 0) { return -1 }
    support.ms().sig_abi[ns] = abi
    support.ms().sig_first[ns] = first
    return ty_push(support.TY_FN, support.TG_PTR_SIZE, support.TG_PTR_SIZE, ret, np, ns)
}

// ty_fn：构造普通 yh 函数类型，保留原有内部调用接口。
pub fn ty_fn(ret int, first int, np int, vararg int) int {
    return ty_fn_abi(ret, first, np, vararg, support.ABI_YH)
}

// ty_declare_name：登记类型名字（重复定义报错，含首次声明位置）。
// is_pub/form 取自调用方设置的全局（support.fc().c_decl_pub / support.ms().name_form）。
pub fn ty_declare_name(off int, n int, tid int) int {
    let prev int = ty_lookup_name_off(off, n)
    if (prev >= 0) {
        // 找到先前登记项的位置一并报告
        let pi int = support.ms().name_n - 1
        for pi >= 0 {
            if (support.ms().names[pi].name_len == n
                && support.pool_ctx().data[support.ms().names[pi].name_off] == support.pool_ctx().data[off]) {
                let match int = 1
                let j int = 1
                for j < n {
                    if (support.pool_ctx().data[support.ms().names[pi].name_off + j] != support.pool_ctx().data[off + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    break
                }
            }
            pi -= 1
        }
        if (pi >= 0 && support.diag().spec == 0) {
            let buf [128]u8
            let bn int = 0
            bn = support.append_str(buf, bn, "类型重定义（首次声明于 ")
            bn = support.append_int(buf, bn, support.ms().names[pi].def_line)
            bn = support.append_byte(buf, bn, ':')
            bn = support.append_int(buf, bn, support.ms().names[pi].def_col)
            bn = support.append_str(buf, bn, "）")
            let mo int = support.tml_intern_str(buf, 0, bn)
            if (mo < 0) {
                return -1
            }
            return token.err_tok(support.np_cstr(mo))
        }
        return token.err_tok("类型重定义")
    }
    if (support.ms().name_n == support.ms().name_cap) {
        let ncap int = support.ms().name_cap * 2
        if (ncap == 0) {
            ncap = 64
        }
        let nd *support.TName = malloc((ncap * sizeof(support.TName)).to_type(u64)).to_type(*support.TName)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.ms().name_n > 0) {
            memcpy(nd, support.ms().names, (support.ms().name_n * sizeof(support.TName)).to_type(u64))
        }
        free(support.ms().names)
        support.ms().names = nd
        support.ms().name_cap = ncap
    }
    support.ms().names[support.ms().name_n].name_off = off
    support.ms().names[support.ms().name_n].name_len = n
    support.ms().names[support.ms().name_n].type_id = tid
    support.ms().names[support.ms().name_n].is_pub = support.fc().c_decl_pub
    support.ms().names[support.ms().name_n].form = support.ms().name_form
    support.ms().names[support.ms().name_n].attrs = support.fc().c_decl_attrs
    support.ms().names[support.ms().name_n].def_line = token.ctx().tokens[token.ctx().pos].line
    support.ms().names[support.ms().name_n].def_col = token.ctx().tokens[token.ctx().pos].col
    support.ms().name_n += 1
    return 0
}

// ty_add_name_attrs：为刚登记的具名类型补充解析结束后才能确定的属性。
pub fn ty_add_name_attrs(tid int, attrs int) int {
    let found int = 0
    let i int = 0
    for i < support.ms().name_n {
        if (support.ms().names[i].type_id == tid) {
            support.ms().names[i].attrs |= attrs
            found = 1
        }
        i += 1
    }
    if (found == 0) { return support.fail("内部错误：类型属性找不到具名类型") }
    return 0
}

// ty_cabi_param：允许 C 标量、具备共享布局的聚合及完整 C 函数指针。
// 顶层数组不按值传递；切片和不透明值始终拒绝，数组仅可作为聚合字段。
pub fn ty_cabi_param(tid int) int {
    if (ty_cabi_scalar(tid) != 0) { return 1 }
    let kind int = support.ms().types[tid].kind
    if (kind == support.TY_STRUCT || kind == support.TY_UNION) { return ty_c_layout(tid) }
    if (kind != support.TY_FN) { return 0 }
    let sig int = support.ms().types[tid].sub
    if (support.ms().sig_abi[sig] != support.ABI_C || support.ms().sig_vararg[sig] != 0) { return 0 }
    let ret int = support.ms().sig_ret[sig]
    if (ret != support.TY_VOID && ty_cabi_param(ret) == 0) { return 0 }
    let i int = 0
    for i < support.ms().sig_np[sig] {
        if (ty_cabi_param(support.ms().sig_params[support.ms().sig_first[sig] + i]) == 0) { return 0 }
        i += 1
    }
    return 1
}

// ty_c_layout：判断值布局可否直接嵌入 extern struct/union 的 C 共享布局。
pub fn ty_c_layout(tid int) int {
    let kind int = support.ms().types[tid].kind
    if (kind >= support.TY_BOOL && kind <= support.TY_F64) { return 1 }
    if (kind == support.TY_PTR) { return 1 }
    if (kind == support.TY_FN) { return ty_cabi_param(tid) }
    if (kind == support.TY_ARRAY) { return ty_c_layout(support.ms().types[tid].elem) }
    if (kind == support.TY_ENUM) {
        return ((support.ty_name_attrs(tid) & support.ATTR_EXTERN) != 0).to_type(int)
    }
    if (kind == support.TY_STRUCT || kind == support.TY_UNION) {
        return ((support.ty_name_attrs(tid) & (support.ATTR_EXTERN | support.ATTR_OPAQUE)) == support.ATTR_EXTERN).to_type(int)
    }
    return 0
}

// sym_push：登记符号（名字先 intern 进池）。返回符号下标。
// 模块模式下对全局声明做重复检查（同模块重复顶层声明报两个位置）；
// 单文件模式行为不变（不检查）。
pub fn sym_push(start int, n int, kind int, tid int, flags int) int {
    let off int = support.name_intern(start, n)
    if (off < 0) {
        return -1
    }
    if (support.cfg().module_mode != 0 && (flags & support.F_GLOBAL) != 0 && (flags & support.F_EXTERN) == 0) {
        // 模块模式：全局（含 enum 成员）重名报错；首次位置一并报告
        let di int = 0
        for di < support.ms().sym_n {
            if ((support.ms().syms[di].flags & support.F_GLOBAL) != 0 && support.ms().syms[di].name_len == n
                && support.pool_ctx().data[support.ms().syms[di].name_off] == support.pool_ctx().data[off]) {
                let match int = 1
                let j int = 1
                for j < n {
                    if (support.pool_ctx().data[support.ms().syms[di].name_off + j] != support.pool_ctx().data[off + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    if (support.diag().spec == 0) {
                        let buf [128]u8
                        let bn int = 0
                        bn = support.append_str(buf, bn, "重复的顶层声明（首次声明于 ")
                        bn = support.append_int(buf, bn, support.ms().syms[di].def_line)
                        bn = support.append_byte(buf, bn, ':')
                        bn = support.append_int(buf, bn, support.ms().syms[di].def_col)
                        bn = support.append_str(buf, bn, "）")
                        let mo int = support.tml_intern_str(buf, 0, bn)
                        if (mo < 0) {
                            return -1
                        }
                        return token.err_tok(support.np_cstr(mo))
                    }
                    return -1
                }
            }
            di += 1
        }
    }
    if (support.ms().sym_n == support.ms().sym_cap) {
        let ncap int = support.ms().sym_cap * 2
        if (ncap == 0) {
            ncap = 256
        }
        let nd *support.CSym = malloc((ncap * sizeof(support.CSym)).to_type(u64)).to_type(*support.CSym)
        if (nd == 0) {
            support.fail("内存分配失败")
            return -1
        }
        if (support.ms().sym_n > 0) {
            memcpy(nd, support.ms().syms, (support.ms().sym_n * sizeof(support.CSym)).to_type(u64))
        }
        free(support.ms().syms)
        support.ms().syms = nd
        support.ms().sym_cap = ncap
    }
    support.ms().syms[support.ms().sym_n].name_off = off
    support.ms().syms[support.ms().sym_n].name_len = n
    support.ms().syms[support.ms().sym_n].kind = kind
    support.ms().syms[support.ms().sym_n].type_id = tid
    support.ms().syms[support.ms().sym_n].offset = 0
    support.ms().syms[support.ms().sym_n].flags = flags
    support.ms().syms[support.ms().sym_n].cval = 0
    support.ms().syms[support.ms().sym_n].const_ready = 0
    support.ms().syms[support.ms().sym_n].const_expr_off = -1
    support.ms().syms[support.ms().sym_n].const_expr_len = 0
    support.ms().syms[support.ms().sym_n].const_expr_kind = 0
    support.ms().syms[support.ms().sym_n].def_line = token.ctx().tokens[token.ctx().pos].line
    support.ms().syms[support.ms().sym_n].def_col = token.ctx().tokens[token.ctx().pos].col
    support.ms().syms[support.ms().sym_n].ast_binding_row = -1
    support.ms().sym_n += 1
    return support.ms().sym_n - 1
}

// sym_push_pool：以名字池中已有的名字登记符号（函数 check 缓存导入用）。
// 不做全局重名检查；调用方负责只对函数局部符号使用。
pub fn sym_push_pool(off int, n int, kind int, tid int, flags int) int {
    let idx int = sym_push_lit(off, n, kind, tid, flags)
    return idx
}

// scope_push / scope_pop：进入/退出块作用域（退出即截断符号）。
pub fn scope_push() int {
    support.ms().scope_start[support.ms().scope_n] = support.ms().sym_n
    support.ms().scope_n += 1
    return 0
}

pub fn scope_pop() int {
    support.ms().scope_n -= 1
    support.ms().sym_n = support.ms().scope_start[support.ms().scope_n]
    return 0
}

// fold_unary：对常量做一元运算。
pub fn fold_unary(op int, a i64) i64 {
    if (op == token.TK_MINUS) { return -a }
    if (op == token.TK_PLUS) { return a }
    if (op == token.TK_TILDE) { return ~a }
    if (op == token.TK_BANG) { return (a == 0).to_type(i64) }
    return a
}

pub fn sem_parse_number(start int, n int) int {
    let i int = start
    let end int = start + n
    let v i64 = 0
    let big int = 0
    let base i64 = 10
    if (support.src_ctx().data[i] == '0' && i + 1 < end) {
        let p2 u8 = support.src_ctx().data[i + 1]
        if (p2 == 'x' || p2 == 'X') { base = 16; i += 2 }
        if (p2 == 'b' || p2 == 'B') { base = 2; i += 2 }
        if (p2 == 'o' || p2 == 'O') { base = 8; i += 2 }
    }
    for i < end {
        let b u8 = support.src_ctx().data[i]
        if (b == '_') {
            i += 1
            continue
        }
        let d i64 = 0
        if (b >= '0' && b <= '9') {
            d = (b - '0').to_type(i64)
        } else if (b >= 'a' && b <= 'f') {
            d = ((b - 'a') + 10).to_type(i64)
        } else if (b >= 'A' && b <= 'F') {
            d = ((b - 'A') + 10).to_type(i64)
        } else {
            return token.err_tok("数字字面量含非法字符")
        }
        v = v * base + d
        if (v < 0) {
            big = 1
        }
        i += 1
    }
    support.fc().c_fold_ival = v
    support.fc().c_fold_big = big
    return 0
}

// sym_declared_before：符号声明点是否早于位置 (line, col)（同文件比较）。
// 用于保持「普通全局 const 按声明顺序求值」的既有规则：只有声明在前的常量
// 才允许在布局子遍提前求值，前向引用仍报「编译期常量尚未就绪」。
pub fn sym_declared_before(sym int, line int, col int) int {
    if (sym < 0 || sym >= support.ms().sym_n) { return 0 }
    let dl int = support.ms().syms[sym].def_line
    let dc int = support.ms().syms[sym].def_col
    if (dl < line) { return 1 }
    if (dl == line && dc < col) { return 1 }
    return 0
}

// sem_promote：二元运算公共类型（常规算术转换子集）。
pub fn sem_promote(a int, b int) int {
    if (a == b) {
        return a
    }
    let ak int = support.ms().types[a].kind
    let bk int = support.ms().types[b].kind
    if (ak == support.TY_BOOL) { a = support.TY_I32 }
    if (bk == support.TY_BOOL) { b = support.TY_I32 }
    if (ak == support.TY_CHAR) { a = support.TY_I32 }
    if (bk == support.TY_CHAR) { b = support.TY_I32 }
    if (ak == support.TY_ENUM) { a = support.TY_I32 }
    if (bk == support.TY_ENUM) { b = support.TY_I32 }
    if (a == b) {
        return a
    }
    if (support.ty_is_float(a) != 0 && support.ty_is_float(b) != 0) {
        if (support.ms().types[a].size >= support.ms().types[b].size) {
            return a
        }
        return b
    }
    if (support.ty_is_float(a) != 0 || support.ty_is_float(b) != 0) {
        // 调用方已先行拒绝；此处返回较大一方兜底
        if (support.ms().types[a].size >= support.ms().types[b].size) {
            return a
        }
        return b
    }
    let asz int = support.ms().types[a].size
    let bsz int = support.ms().types[b].size
    let aus int = (support.ty_is_signed(a) == 0).to_type(int)
    let bus int = (support.ty_is_signed(b) == 0).to_type(int)
    let size int = asz
    if (bsz > size) {
        size = bsz
    }
    let uns int = aus | bus
    if (size == 1) {
        if (uns != 0) { return support.TY_U8 }
        return support.TY_I8
    }
    if (size == 2) {
        if (uns != 0) { return support.TY_U16 }
        return support.TY_I16
    }
    if (size == 4) {
        if (uns != 0) { return support.TY_U32 }
        return support.TY_I32
    }
    if (uns != 0) { return support.TY_U64 }
    return support.TY_I64
}

// sem_init_tables：为全部堆分配的全局表分配空间（编译模式启动时调用一次）。
// stage0 每个编译单元只允许一个全局数组字面量，因此这些表统一走堆。
pub fn sem_init_tables() int {
    let n4 u64 = (4 * 64).to_type(u64)
    support.ms().scope_start = support.alloc(n4).to_type(*int)
    support.fc().c_brk_stk = support.alloc(n4).to_type(*int)
    support.fc().c_cnt_stk = support.alloc(n4).to_type(*int)
    support.fc().c_loop_break_seen = support.alloc(n4).to_type(*int)
    support.fc().c_glabels = support.alloc((sizeof(support.GLabel) * 128).to_type(u64)).to_type(*support.GLabel)
    support.fc().c_args = support.alloc((sizeof(support.Res) * 256).to_type(u64)).to_type(*support.Res)
    support.fc().c_argtys = support.alloc((4 * 256).to_type(u64)).to_type(*int)
    support.fc().c_spill_reg = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_spill_off = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_spill_size = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_call_base = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_call_abi = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_call_direct = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_arg_agg = support.alloc((4 * 256).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_indirect = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_src = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_dst = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_size = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_lit_save_off = support.alloc((4 * 32).to_type(u64)).to_type(*int)
    support.fc().c_lit_save_tid = support.alloc((4 * 32).to_type(u64)).to_type(*int)
    support.fc().c_fi_kind = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_cnt_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_len_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_data_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_step_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_elem_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_idx_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_bss_syms = support.alloc((4 * 4096).to_type(u64)).to_type(*int)
    support.fc().sc_sc_false_stk = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().sc_sc_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().tn_else_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().tn_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    if (support.ms().scope_start == 0 || support.fc().c_brk_stk == 0 || support.fc().c_cnt_stk == 0
        || support.fc().c_loop_break_seen == 0
        || support.fc().c_glabels == 0 || support.fc().c_args == 0 || support.fc().c_argtys == 0
        || support.fc().c_spill_reg == 0 || support.fc().c_spill_off == 0 || support.fc().c_spill_size == 0
        || support.fc().c_call_base == 0
        || support.fc().c_call_abi == 0 || support.fc().c_call_direct == 0 || support.fc().c_arg_agg == 0
        || support.fc().c_aggparam_indirect == 0 || support.fc().c_aggparam_src == 0 || support.fc().c_aggparam_dst == 0 || support.fc().c_aggparam_size == 0
        || support.fc().c_lit_save_off == 0 || support.fc().c_lit_save_tid == 0
        || support.fc().c_fi_kind == 0 || support.fc().c_fi_cnt_off == 0 || support.fc().c_fi_len_off == 0
        || support.fc().c_fi_data_off == 0 || support.fc().c_fi_step_off == 0
        || support.fc().c_fi_elem_off == 0 || support.fc().c_fi_idx_off == 0
        || support.fc().c_bss_syms == 0
        || support.fc().sc_sc_false_stk == 0 || support.fc().sc_sc_end_stk == 0
        || support.fc().tn_else_stk == 0 || support.fc().tn_end_stk == 0) {
        return support.fail("内存分配失败")
    }
    return 0
}

// prelude_add：登记一个 prelude 外部函数（名字进池；签名进签名表）。
// 供 builtin 模块的 sem_register_prelude 使用；gen 只提供符号表原语，不认识
// 具体内置函数名。
pub fn prelude_add(name *char, ret int, np int, vararg int) int {
    let n int = 0
    for name[n] != 0 {
        n += 1
    }
    let off int = support.name_intern_lit(name)
    if (off < 0) {
        return -1
    }
    let ftid int = ty_fn(ret, support.ms().sigparam_n - np, np, vararg)
    return sym_push_lit(off, n, support.SYM_FN, ftid, support.F_EXTERN | support.F_PUB)
}

// sem_can_assign：检查 src 能否赋给 dst（隐式转换规则见 support.vk_can_assign）。
// 通过返回 0；拒绝返回 -1 并已报错。
pub fn sem_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    return sem_report(support.vk_can_assign(dst, src, is_lit, ival, big))
}

// sem_fold_const_binop：常量二元折叠；成功写 result 并返回 0，失败返回 -1 并已报错。
pub fn sem_fold_const_binop(op int, tid int, left i64, right i64, result *i64) int {
    return sem_report(support.vk_fold_binop(op, tid, left, right, result))
}

// sem_fold_const_unary：常量一元折叠；成功写 result 并返回 0，失败返回 -1 并已报错。
pub fn sem_fold_const_unary(op int, tid int, value i64, is_lit int, result *i64) int {
    return sem_report(support.vk_fold_unary(op, tid, value, is_lit, result))
}

// verify_module：按表达式、语句、声明、函数顺序校验一份已捕获 AST。
// 返回 0 表示成功；1/2/3/4 分别表示对应阶段失败，供 cmd 保留原外层诊断。
// 捕获关闭时直接成功。view 及其中的 arena 在调用期间必须保持有效且只读。
pub fn verify_module(view *ast.AstView) int {
    if (support.session().ast_capture == 0) { return 0 }
    if (check_expr(view) != 0) { return 1 }
    if (check_stmt(view) != 0) { return 2 }
    if (check_decl(view) != 0) { return 3 }
    if (check_function(view) != 0) { return 4 }
    return 0
}

// verify_checked_module：校验独立快照及其目标身份，不写入节点、视图或全局状态。
// 返回 0 表示通过；1–11 对应表存储、类型子类、文件、表达式、语句、函数或目标错误。
pub fn verify_checked_module(unit *CheckedModule) int {
    let view CheckedModuleView
    if (checked_module_view(unit, &view) != 0
        || view.target.triple == 0 || view.target.data_layout == 0 || view.target.abi == 0) {
        return 11
    }
    let expected support.TargetInfo
    if (support.target_resolve(view.target.triple, &expected) != 0
        || support.cstr_eq(view.target.data_layout, expected.data_layout) == 0
        || support.cstr_eq(view.target.abi, expected.abi) == 0
        || view.target.os != expected.os || view.target.arch != expected.arch
        || view.target.pointer_bits != expected.pointer_bits
        || view.target.little_endian != expected.little_endian
        || view.target.layout_version != expected.layout_version) { return 11 }
    if (checked_storage_present(&view) != 0) { return 1 }
    let type_stage int = 0
    if (checked_verify_types(&view, &type_stage) != 0) {
        if (type_stage > 0) { return 2 }
        if (type_stage == -1) { return 3 }
        if (type_stage == -2 || type_stage == -3) { return 4 }
        if (type_stage == -4) { return 5 }
        if (type_stage == -5) { return 6 }
        return 2
    }
    if (checked_verify_files(&view) != 0) { return 7 }
    if (checked_verify_expressions(&view) != 0) { return 8 }
    if (checked_verify_statements(&view) != 0) { return 9 }
    if (checked_verify_functions(&view) != 0) { return 10 }
    return 0
}
