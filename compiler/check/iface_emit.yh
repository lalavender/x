module check
import token
import support
import comptime

// ============================================================================
// iface_emit.yh —— 模块接口与编译期正文的**发射**（.s.i / .s.ct 文本）
//
// 从 parse/iface.yh、parse/iface_ct.yh、parse/iface_ct_map.yh 迁入（S1）。
// 这一层只把受检事实（`support.ms()` 的类型/符号表、`ast` 声明区间、
// `comptime` 的 CT 函数注册表）序列化成文本，**不重新解析源码**，因此可以
// 待在 check（parse 的下游）。
//
// 留在 parse 的是**加载**侧：`iface_load` / `iface_ct_load` / 头部校验——它们
// 要重新词法/解析接口正文（`parse_source`），搬走会形成 check → parse 环。
//
// 少数被加载侧复用的文本/头部工具在这里声明为 `pub`，parse 以 `check.` 前缀调用。
// ============================================================================

// —— 接口发射缓冲（独立于汇编缓冲；成功后一次写出） ——
let if_buf *u8 = 0
let if_len int = 0
let if_cap int = 0

// IfaceCtColMap：.s.ct 中一段正文改写的生成位置与原始位置。
// 列坐标以函数体左花括号为基准；正文后续 token 仍使用 sidecar 的行号偏移。
struct IfaceCtColMap {
    gen_start_line int
    gen_start_col int
    gen_end_line int
    gen_end_col int
    gen_after_line int
    gen_after_col int
    src_start_line int
    src_start_col int
    src_after_line int
    src_after_col int
}

let if_ct_col_maps *IfaceCtColMap = 0
let if_ct_col_n int = 0
let if_ct_col_cap int = 0
let if_ct_col_body_col int = 0
let if_ct_col_saved *IfaceCtTokPosition = 0
let if_ct_col_saved_n int = 0
let if_ct_col_scan_offset int = 0
let if_ct_col_scan_line int = 0
let if_ct_col_scan_col int = 0

// if_put / if_puts / if_puti / if_puti64：接口文本写入。
fn if_put(b u8) int {
    if (support.out_grow(&if_buf, if_len, &if_cap, if_len + 1) != 0) {
        return -1
    }
    if_buf[if_len] = b
    if_len += 1
    return 0
}

fn if_puts(s *char) int {
    let i int = 0
    for s[i] != 0 {
        if (if_put(s[i].to_type(u8)) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

fn if_puti(v int) int {
    let tmp [12]u8
    let k int = 0
    let neg int = 0
    if (v < 0) {
        neg = 1
        v = -v
    }
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    if (neg != 0) {
        if (if_put('-') != 0) {
            return -1
        }
    }
    for k > 0 {
        k -= 1
        if (if_put(tmp[k]) != 0) {
            return -1
        }
    }
    return 0
}

// if_put_np：写名字池字节区间。

// if_put_np：写名字池字节区间。
fn if_put_np(off int, olen int) int {
    let i int = 0
    for i < olen {
        if (if_put(support.pool_ctx().data[off + i]) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

// if_emit_type：把类型编号渲染为 yh 类型引用文本。
// own_name_base：本模块类型名的 t_names 起始下标（跨模块引用拒绝）。

// if_emit_type：把类型编号渲染为 yh 类型引用文本。
// own_name_base：本模块类型名的 t_names 起始下标（跨模块引用拒绝）。
fn if_emit_type(tid int, own_name_base int) int {
    let k int = support.ms().types[tid].kind
    if (k == support.TY_VOID) { return if_puts("void") }
    if (k == support.TY_BOOL) { return if_puts("bool") }
    if (k == support.TY_CHAR) { return if_puts("char") }
    if (k == support.TY_I8) { return if_puts("i8") }
    if (k == support.TY_I16) { return if_puts("i16") }
    if (k == support.TY_I32) { return if_puts("int") }
    if (k == support.TY_I64) { return if_puts("i64") }
    if (k == support.TY_U8) { return if_puts("u8") }
    if (k == support.TY_U16) { return if_puts("u16") }
    if (k == support.TY_U32) { return if_puts("u32") }
    if (k == support.TY_U64) { return if_puts("u64") }
    if (k == support.TY_F32) { return if_puts("f32") }
    if (k == support.TY_F64) { return if_puts("f64") }
    if (k == support.TY_PTR) {
        if (if_put('*') != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == support.TY_ARRAY) {
        if (if_put('[') != 0) { return -1 }
        if (if_puti(support.ms().types[tid].len) != 0) { return -1 }
        if (if_put(']') != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == support.TY_SLICE) {
        if (if_puts("[]") != 0) { return -1 }
        return if_emit_type(support.ms().types[tid].elem, own_name_base)
    }
    if (k == support.TY_FN) {
        if (support.ms().sig_abi[support.ms().types[tid].sub] == support.ABI_C
            && if_puts("@[extern] ") != 0) { return -1 }
        if (if_puts("fn(") != 0) { return -1 }
        let sig int = support.ms().types[tid].sub
        let np2 int = support.ms().sig_np[sig]
        let i int = 0
        for i < np2 {
            if (i > 0) {
                if (if_puts(", ") != 0) { return -1 }
            }
            if (if_emit_type(support.ms().sig_params[support.ms().sig_first[sig] + i], own_name_base) != 0) {
                return -1
            }
            i += 1
        }
        if (if_puts(")") != 0) { return -1 }
        return if_emit_type(support.ms().sig_ret[sig], own_name_base)
    }
    // 具名类型（struct/union/enum/别名目标）：全表查询——pub 签名可引用
    // 本模块类型，也可引用已加载接口带来的跨模块类型（mangle 名原样
    // 写出，下游加载时作为普通类型名登记）
    let found int = -1
    let i2 int = 0
    for i2 < support.ms().name_n {
        if (support.ms().names[i2].type_id == tid) {
            found = i2
            break
        }
        i2 += 1
    }
    if (found < 0) {
        return token.err_tok("pub 接口引用了非具名类型（无法导出）")
    }
    if (support.ms().names[found].is_pub == 0) {
        return token.err_tok("pub 接口引用了非 pub 类型（请将该类型声明为 pub）")
    }
    return if_put_np(support.ms().names[found].name_off, support.ms().names[found].name_len)
}

// iface_emit：把本模块 pub 接口写到 path。
// sym_base/tname_base：本模块登记起点（此前是 prelude 与已加载接口）。

// —— 接口加载 ——

// —— 接口头行契约 ——
// 头行：// yh-iface v<N> arch=<arch> suffix=<符号后缀>
// 版本与架构都是**数据**：读取端按区间 [IFACE_VERSION_MIN, IFACE_VERSION_MAX]
// 与当前目标架构校验，写入端从同一组常量取值。此前用三条硬编码字面量加
// 手写长度 33 比对：新增版本要同时改四处，架构则永远写着 arm64。
const IFACE_HEAD_PREFIX *char = "// yh-iface v"
const IFACE_HEAD_ARCH *char = " arch="
const IFACE_HEAD_SUFFIX *char = " suffix="
const CTIFACE_HEAD_PREFIX *char = "// yh-ctiface v"

// iface_lit_at：src[0..n) 从 pos 起是否以 lit 开头（越界即不匹配）。

// iface_arch_at：src[0..n) 从 pos 起的架构标记是否与当前目标一致；
// 一致返回标记之后的位置，否则 -1。

// iface_head_prefix_len：校验 .s.i 头前缀（版本区间 + 目标架构），
// 成功返回 suffix 起点，失败返回 -1。

// iface_head_prefix_len_at：纯函数版本（src + 长度），供内嵌测试直接构造输入。

// iface_head_bad：头行不兼容的统一诊断（计一次错误并返回 -1）。

// iface_header_suffix：校验头行并提取 suffix 到出参（入名字池）。
// c_src/c_src_len 为接口文件内容。成功 0；格式不符 -1（带诊断）。

// iface_emit_pub_agg_src：输出聚合常量初始化式文本（.s.i 与 .s.ct 导出共用）。
// 字面量形态（const_expr_kind = 4）原样重放；$ 调用形态（kind = 5）把
// 同模块 `$fn` 重写为闭包隐藏名——导入方侧该函数只以隐藏符号登记，
// 重放文本按隐藏名解析才能命中正文。

// iface_emit_pub_agg_src：输出聚合常量初始化式文本（.s.i 与 .s.ct 导出共用）。
// 字面量形态（const_expr_kind = 4）原样重放；$ 调用形态（kind = 5）把
// 同模块 `$fn` 重写为闭包隐藏名——导入方侧该函数只以隐藏符号登记，
// 重放文本按隐藏名解析才能命中正文。
fn iface_emit_pub_agg_src(sym_id int) int {
    if (support.ms().syms[sym_id].const_expr_kind == 4) {
        return if_put_np(support.ms().syms[sym_id].const_expr_off,
            support.ms().syms[sym_id].const_expr_len)
    }
    let off int = support.ms().syms[sym_id].const_expr_off
    let srclen int = support.ms().syms[sym_id].const_expr_len
    let cursor int = 0
    let i int = 0
    for i < srclen {
        if (support.pool_ctx().data[off + i] == 36 && i + 1 < srclen) {
            let j int = i + 1
            let c0 int = support.pool_ctx().data[off + j].to_type(int)
            if ((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
                let k int = j + 1
                for k < srclen {
                    let cc int = support.pool_ctx().data[off + k].to_type(int)
                    if ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90)
                        || (cc >= 97 && cc <= 122) || cc == 95) {
                        k += 1
                    } else {
                        break
                    }
                }
                let fnsym int = support.sym_lookup_off(off + j, k - j)
                if (fnsym >= 0 && fnsym < support.ms().sym_n
                    && (support.ms().syms[fnsym].flags & support.F_COMPTIME) != 0) {
                    if (if_put_np(off + cursor, i - cursor) != 0
                        || if_put('$') != 0) { return -1 }
                    let hidden_off int = -1
                    let hidden_len int = 0
                    if (iface_ct_name(fnsym, support.fs().sym_sfx_off,
                            support.fs().sym_sfx_len, &hidden_off, &hidden_len) != 0
                        || if_put_np(hidden_off, hidden_len) != 0) {
                        return -1
                    }
                    cursor = k
                    i = k
                    continue
                }
            }
        }
        i += 1
    }
    return if_put_np(off + cursor, srclen - cursor)
}

// iface_load：加载一份接口并登记为当前编译单元的导入模块。
// bind_off/len：导入绑定名（=模块名）。返回 ModInfo 下标；失败 -1。

// tname_mangle：类型名同样改写（避免与使用者同名类型冲突）。

// yh test 内建测试：头行契约的版本区间与目标架构校验。
// 纯函数入口让测试直接构造字节序列，不必改动会话状态。
test "iface 头行版本区间与目标架构" {
    let buf [64]u8
    let n int = 0
    n = support.append_str(&buf[0], n, IFACE_HEAD_PREFIX)
    n = support.append_byte(&buf[0], n, '3')
    n = support.append_str(&buf[0], n, IFACE_HEAD_ARCH)
    let arch *char = support.target_arch_token()
    n = support.append_str(&buf[0], n, arch)
    n = support.append_str(&buf[0], n, IFACE_HEAD_SUFFIX)
    n = support.append_byte(&buf[0], n, 'x')
    n = support.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    $assert(iface_head_prefix_len_at(&buf[0], n) > 0)

    // 版本 0 与 4 都在 [1,3] 之外。
    let vpos int = support.cstr_len(IFACE_HEAD_PREFIX)
    buf[vpos] = '0'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[vpos] = '4'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[vpos] = '3'

    // 目标架构不符（任意目标下都改首字节为 Z）。
    let apos int = vpos + 1 + support.cstr_len(IFACE_HEAD_ARCH)
    let keep u8 = buf[apos]
    buf[apos] = 'Z'
    $assert(iface_head_prefix_len_at(&buf[0], n) < 0)
    buf[apos] = keep

    // 截断到架构末尾（缺 " suffix="）与空输入。
    let cut int = apos + support.cstr_len(arch)
    $assert(iface_head_prefix_len_at(&buf[0], cut) < 0)
    $assert(iface_head_prefix_len_at(&buf[0], 0) < 0)
}

test "ctiface 头行版本必须为 1" {
    let buf [64]u8
    let n int = 0
    n = support.append_str(&buf[0], n, CTIFACE_HEAD_PREFIX)
    n = support.append_byte(&buf[0], n, '1')
    n = support.append_str(&buf[0], n, IFACE_HEAD_ARCH)
    n = support.append_str(&buf[0], n, support.target_arch_token())
    n = support.append_str(&buf[0], n, IFACE_HEAD_SUFFIX)
    n = support.append_byte(&buf[0], n, 'x')
    n = support.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    $assert(iface_ct_head_prefix_len_at(&buf[0], n) > 0)
    buf[support.cstr_len(CTIFACE_HEAD_PREFIX)] = '2'
    $assert(iface_ct_head_prefix_len_at(&buf[0], n) < 0)
}

// iface_ct_export_name：由公开短名与提供方后缀推导对应隐藏正文名。

// iface_ct_emit_type：发出 CT 正文签名使用的规范类型名。
// 本地公开类型追加当前模块后缀；导入类型已经带提供方后缀。
fn iface_ct_emit_type(tid int, suffix_off int, suffix_len int) int {
    if (tid < 0 || tid >= support.ms().type_n) {
        return token.err_tok("编译期正文引用了无效类型")
    }
    let kind int = support.ms().types[tid].kind
    if (kind == support.TY_VOID) { return if_puts("void") }
    if (kind == support.TY_BOOL) { return if_puts("bool") }
    if (kind == support.TY_CHAR) { return if_puts("char") }
    if (kind == support.TY_I8) { return if_puts("i8") }
    if (kind == support.TY_I16) { return if_puts("i16") }
    if (kind == support.TY_I32) { return if_puts("int") }
    if (kind == support.TY_I64) { return if_puts("i64") }
    if (kind == support.TY_U8) { return if_puts("u8") }
    if (kind == support.TY_U16) { return if_puts("u16") }
    if (kind == support.TY_U32) { return if_puts("u32") }
    if (kind == support.TY_U64) { return if_puts("u64") }
    if (kind == support.TY_F32) { return if_puts("f32") }
    if (kind == support.TY_F64) { return if_puts("f64") }
    if (kind == support.TY_PTR) {
        if (if_put('*') != 0) { return -1 }
        return iface_ct_emit_type(support.ms().types[tid].elem, suffix_off,
            suffix_len)
    }
    if (kind == support.TY_ARRAY) {
        if (if_put('[') != 0 || if_puti(support.ms().types[tid].len) != 0
            || if_put(']') != 0) { return -1 }
        return iface_ct_emit_type(support.ms().types[tid].elem, suffix_off,
            suffix_len)
    }
    if (kind == support.TY_SLICE) {
        if (if_puts("[]") != 0) { return -1 }
        return iface_ct_emit_type(support.ms().types[tid].elem, suffix_off,
            suffix_len)
    }
    if (kind == support.TY_FN) {
        let sig int = support.ms().types[tid].sub
        if (support.ms().sig_abi[sig] == support.ABI_C
            && if_puts("@[extern] ") != 0) { return -1 }
        if (if_puts("fn(") != 0) { return -1 }
        let i int = 0
        for i < support.ms().sig_np[sig] {
            if (i > 0 && if_puts(", ") != 0) { return -1 }
            if (iface_ct_emit_type(
                    support.ms().sig_params[support.ms().sig_first[sig] + i],
                    suffix_off, suffix_len) != 0) { return -1 }
            i += 1
        }
        if (if_put(')') != 0) { return -1 }
        return iface_ct_emit_type(support.ms().sig_ret[sig], suffix_off,
            suffix_len)
    }
    let found int = -1
    let alias_found int = -1
    let i2 int = 0
    for i2 < support.ms().name_n {
        if (support.ms().names[i2].type_id == tid) {
            if (support.ms().names[i2].form != 0) { found = i2; break }
            if (alias_found < 0) { alias_found = i2 }
        }
        i2 += 1
    }
    if (found < 0) { found = alias_found }
    if (found < 0) { return token.err_tok("CT 正文引用了未命名类型") }
    if (support.ms().home[tid] < 0) {
        if (support.ms().names[found].is_pub == 0) {
            return token.err_tok("跨模块 CT 正文暂不支持模块私有具名类型")
        }
        if (if_put_np(support.ms().names[found].name_off,
                support.ms().names[found].name_len) != 0) { return -1 }
        let i3 int = 0
        for i3 < suffix_len {
            if (if_put(support.pool_ctx().data[suffix_off + i3]) != 0) { return -1 }
            i3 += 1
        }
        return 0
    }
    return if_put_np(support.ms().names[found].name_off,
        support.ms().names[found].name_len)
}

// iface_ct_source_type_id：按正文 token 名查找同模块具名类型，未命中返回 -1。

// iface_ct_source_type_id：按正文 token 名查找同模块具名类型，未命中返回 -1。
fn iface_ct_source_type_id(src *u8, start int, token_len int) int {
    let row int = 0
    for row < support.ms().name_n {
        let name support.TName = support.ms().names[row]
        if (name.name_len == token_len) {
            let i int = 0
            for i < token_len {
                if (src[start + i] != support.pool_ctx().data[name.name_off + i]) {
                    break
                }
                i += 1
            }
            if (i == token_len) { return name.type_id }
        }
        row += 1
    }
    return -1
}

// iface_ct_qualified_type_target：按函数注册时的导入快照解析 alias.Type。

// iface_ct_qualified_type_target：按函数注册时的导入快照解析 alias.Type。
fn iface_ct_qualified_type_target(item *comptime.CtFunction,
    alias_token int) int {
    if (alias_token < 0 || alias_token + 2 >= item.body_n
        || item.body[alias_token].kind != token.TOK_IDENT
        || item.body[alias_token + 1].kind != token.TK_DOT
        || item.body[alias_token + 2].kind != token.TOK_IDENT) { return -1 }
    let alias_start int = item.body[alias_token].start
    let alias_len int = item.body[alias_token].len
    let import_row int = 0
    for import_row < item.import_n {
        let imp comptime.CtImport = item.imports[import_row]
        if (imp.alias_len == alias_len) {
            let same int = 1
            let j int = 0
            for j < alias_len {
                if (item.src[alias_start + j]
                    != support.pool_ctx().data[imp.alias_off + j]) {
                    same = 0
                    break
                }
                j += 1
            }
            if (same != 0 && imp.module_id >= 0
                && imp.module_id < support.fs().mod_n) {
                let type_token int = alias_token + 2
                let type_start int = item.body[type_token].start
                let type_len int = item.body[type_token].len
                let ns_row int = 0
                for ns_row < support.fs().mods[imp.module_id].ns_n {
                    let ent support.ModNsEnt = support.fs().mods[imp.module_id].ns[ns_row]
                    if (ent.tid >= 0 && ent.name_len == type_len) {
                        let type_same int = 1
                        let k int = 0
                        for k < type_len {
                            if (item.src[type_start + k]
                                != support.pool_ctx().data[ent.name_off + k]) {
                                type_same = 0
                                break
                            }
                            k += 1
                        }
                        if (type_same != 0) { return ent.tid }
                    }
                    ns_row += 1
                }
            }
        }
        import_row += 1
    }
    return -1
}

// iface_ct_local_type_end：找出局部声明类型后的顶层初始化等号。
// 数组长度和函数类型中的括号会被跳过，返回等号 token 下标。

// iface_ct_local_type_end：找出局部声明类型后的顶层初始化等号。
// 数组长度和函数类型中的括号会被跳过，返回等号 token 下标。
fn iface_ct_local_type_end(item *comptime.CtFunction, start int) int {
    let round int = 0
    let square int = 0
    let brace int = 0
    let i int = start
    for i < item.body_n {
        let kind int = item.body[i].kind
        if (kind == token.TK_ASSIGN && round == 0 && square == 0
            && brace == 0) { return i }
        if (kind == token.TK_LPAREN) { round += 1 }
        else if (kind == token.TK_RPAREN) { round -= 1 }
        else if (kind == token.TK_LBRACKET) { square += 1 }
        else if (kind == token.TK_RBRACKET) { square -= 1 }
        else if (kind == token.TK_LBRACE) { brace += 1 }
        else if (kind == token.TK_RBRACE) { brace -= 1 }
        if (round < 0 || square < 0 || brace < 0) { return -1 }
        i += 1
    }
    return -1
}

// iface_ct_is_sizeof_type：识别 sizeof 中的具名类型，允许其前有连续指针星号。

// iface_ct_is_sizeof_type：识别 sizeof 中的具名类型，允许其前有连续指针星号。
fn iface_ct_is_sizeof_type(item *comptime.CtFunction, token_index int) int {
    let before int = token_index - 1
    for before >= 0 && item.body[before].kind == token.TK_STAR {
        before -= 1
    }
    if (before >= 1 && item.body[before].kind == token.TK_LPAREN
        && item.body[before - 1].kind == token.TK_SIZEOF) { return 1 }
    return 0
}

// iface_ct_hex_value：把来源映射中的十六进制路径字节转换为 0..15。

// iface_ct_origin_begin：按声明前的 sidecar 注释切换到函数定义源码路径与行号。

// iface_ct_origin_end：恢复 sidecar 文件上下文，避免来源映射泄漏到下一声明。

// iface_ct_emit_origin：把原始文件路径编码为十六进制，写入函数前的映射注释。

// iface_ct_emit_origin：把原始文件路径编码为十六进制，写入函数前的映射注释。
fn iface_ct_emit_origin(item *comptime.CtFunction) int {
    if (item.src_path == 0 || item.src_path_len <= 0
        || item.src_body_line <= 0) { return 0 }
    if (iface_ct_col_emit(item) != 0
        || if_puts("// yh-ctloc v1 ") != 0
        || if_puti(item.src_body_line) != 0 || if_put(' ') != 0) {
        return -1
    }
    let digits *char = "0123456789abcdef"
    let i int = 0
    for i < item.src_path_len {
        let byte int = item.src_path[i].to_type(int)
        if (if_put(digits[byte / 16].to_type(u8)) != 0
            || if_put(digits[byte % 16].to_type(u8)) != 0) { return -1 }
        i += 1
    }
    return if_put('\n')
}

// iface_ct_emit_newlines：重写 token 范围时保留换行数，稳定来源行号映射。

// iface_ct_emit_newlines：重写 token 范围时保留换行数，稳定来源行号映射。
fn iface_ct_emit_newlines(item *comptime.CtFunction, start int, after int) int {
    let i int = start
    for i < after {
        if (item.src[i] == '\n' && if_put('\n') != 0) { return -1 }
        i += 1
    }
    return 0
}

// iface_ct_emit_body：复制函数体并把显式 CT 调用重写到闭包私有符号。

// iface_ct_emit_body：复制函数体并把显式 CT 调用重写到闭包私有符号。
fn iface_ct_emit_body(row int, item *comptime.CtFunction) int {
    if (item.body_n <= 0) { return token.err_tok("CT 正文为空") }
    let start int = item.body[0].start
    let after int = item.body[item.body_n - 1].start +
        item.body[item.body_n - 1].len
    let cursor int = start
    let i int = 0
    for i < item.body_n {
        if (item.body[i].kind == token.TK_DOLLAR
            && i + 1 < item.body_n
            && item.body[i + 1].kind == token.TOK_IDENT) {
            let target int = comptime.ct_iface_call_target(row,
                item.body_token_first + i)
            if (target >= 0) {
                let dollar_start int = item.body[i].start
                let call_name_token int = i + 1
                let ident_after int = item.body[i + 1].start +
                    item.body[i + 1].len
                let token_after int = i + 2
                if (i + 3 < item.body_n
                    && item.body[i + 2].kind == token.TK_DOT
                    && item.body[i + 3].kind == token.TOK_IDENT) {
                    ident_after = item.body[i + 3].start +
                        item.body[i + 3].len
                    token_after = i + 4
                    call_name_token = i + 3
                }
                let copy int = cursor
                for copy < dollar_start {
                    if (if_put(item.src[copy]) != 0) { return -1 }
                    copy += 1
                }
                if (if_put('$') != 0) { return -1 }
                let map_gen_start int = if_len
                let name_off int = -1
                let name_len int = 0
                if (iface_ct_name(target, support.fs().sym_sfx_off,
                        support.fs().sym_sfx_len, &name_off, &name_len) != 0
                    || if_put_np(name_off, name_len) != 0) { return -1 }
                let map_gen_end int = if_len
                if (iface_ct_emit_newlines(item, dollar_start,
                        ident_after) != 0) { return -1 }
                if (iface_ct_col_note(item, map_gen_start, map_gen_end,
                        if_len, call_name_token, call_name_token, 1) != 0) {
                    return -1
                }
                cursor = ident_after
                i = token_after
                continue
            }
        }
        // 局部声明从类型引用起点整体重发语义类型；这样 `[N]Alias`、`*Alias`
        // 等复合类型不会把私有别名名留在消费者正文中。
        let local_type int = comptime.ct_iface_local_type_target(row,
            item.body_token_first + i)
        if (local_type >= 0) {
            let type_after int = iface_ct_local_type_end(item, i)
            if (type_after <= i) {
                return token.err_tok("无法确定 CT 局部声明的类型范围")
            }
            let type_start int = item.body[i].start
            let copy_type int = cursor
            for copy_type < type_start {
                if (if_put(item.src[copy_type]) != 0) { return -1 }
                copy_type += 1
            }
            let map_gen_start int = if_len
            if (iface_ct_emit_type(local_type, support.fs().sym_sfx_off,
                    support.fs().sym_sfx_len) != 0) {
                return -1
            }
            let map_gen_end int = if_len
            if (if_put(' ') != 0
                || iface_ct_emit_newlines(item, type_start,
                    item.body[type_after].start) != 0
                || iface_ct_col_note(item, map_gen_start, map_gen_end,
                    if_len, i, type_after, 0) != 0) { return -1 }
            cursor = item.body[type_after].start
            i = type_after
            continue
        }
        if (item.body[i].kind == token.TOK_IDENT) {
            let qualified_type int = iface_ct_qualified_type_target(item, i)
            if (qualified_type >= 0 && i + 3 < item.body_n) {
                let qualified_name int = i + 2
                let is_literal int = (item.body[i + 3].kind
                    == token.TK_LBRACE).to_type(int)
                let is_cast int = (i >= 2
                    && item.body[i - 1].kind == token.TK_LPAREN
                    && item.body[i - 2].kind == token.TK_TO_TYPE).to_type(int)
                let is_sizeof int = iface_ct_is_sizeof_type(item, i)
                if (is_literal != 0 || is_cast != 0 || is_sizeof != 0) {
                    let qualified_start int = item.body[i].start
                    let qualified_after int = item.body[qualified_name].start +
                        item.body[qualified_name].len
                    let copy_qualified int = cursor
                    for copy_qualified < qualified_start {
                        if (if_put(item.src[copy_qualified]) != 0) {
                            return -1
                    }
                    copy_qualified += 1
                }
                let map_gen_start int = if_len
                if (iface_ct_emit_type(qualified_type,
                        support.fs().sym_sfx_off,
                        support.fs().sym_sfx_len) != 0) { return -1 }
                let map_gen_end int = if_len
                if (iface_ct_emit_newlines(item, qualified_start,
                        qualified_after) != 0
                    || iface_ct_col_note(item, map_gen_start, map_gen_end,
                        if_len, i, qualified_name, 1) != 0) { return -1 }
                    cursor = qualified_after
                    i += 3
                    continue
                }
            }
            let target_const int = comptime.ct_iface_const_target(row,
                item.body_token_first + i)
            if (target_const >= 0) {
                let ident_start int = item.body[i].start
                let ident_after int = ident_start + item.body[i].len
                let copy_const int = cursor
                for copy_const < ident_start {
                    if (if_put(item.src[copy_const]) != 0) { return -1 }
                    copy_const += 1
                }
                let name_off_const int = -1
                let name_len_const int = 0
                let map_gen_start int = if_len
                if (iface_ct_name(target_const, support.fs().sym_sfx_off,
                        support.fs().sym_sfx_len, &name_off_const,
                        &name_len_const) != 0
                    || if_put_np(name_off_const, name_len_const) != 0) {
                    return -1
                }
                if (iface_ct_col_note(item, map_gen_start, if_len, if_len,
                        i, i, 1) != 0) { return -1 }
                cursor = ident_after
                i += 1
                continue
            }
            let target_type int = comptime.ct_iface_local_type_target(row,
                item.body_token_first + i)
            let type_start int = item.body[i].start
            let source_type int = iface_ct_source_type_id(item.src,
                type_start, item.body[i].len)
            if (target_type < 0 && i + 1 < item.body_n
                && item.body[i + 1].kind == token.TK_LBRACE) {
                target_type = source_type
            }
            // .to_type(T) 与 sizeof(T) 中的具名类型也需映射到闭包类型名。
            if (target_type < 0 && i >= 2
                && item.body[i - 1].kind == token.TK_LPAREN
                && item.body[i - 2].kind == token.TK_TO_TYPE) {
                target_type = source_type
            }
            if (target_type < 0
                && iface_ct_is_sizeof_type(item, i) != 0) {
                target_type = source_type
            }
            if (target_type >= 0 && source_type == target_type) {
                let type_after int = type_start + item.body[i].len
                let copy_type int = cursor
                for copy_type < type_start {
                    if (if_put(item.src[copy_type]) != 0) { return -1 }
                    copy_type += 1
                }
                let map_gen_start int = if_len
                if (iface_ct_emit_type(target_type,
                        support.fs().sym_sfx_off, support.fs().sym_sfx_len) != 0) {
                    return -1
                }
                if (iface_ct_col_note(item, map_gen_start, if_len, if_len,
                        i, i, 1) != 0) { return -1 }
                cursor = type_after
                i += 1
                continue
            }
        }
        i += 1
    }
    for cursor < after {
        if (if_put(item.src[cursor]) != 0) { return -1 }
        cursor += 1
    }
    return 0
}

// iface_ct_emit_i64：以十进制输出有符号常量，避免窄化为宿主 int。

// iface_ct_emit_i64：以十进制输出有符号常量，避免窄化为宿主 int。
fn iface_ct_emit_i64(value i64) int {
    let digits [24]u8
    let count int = 0
    let negative int = (value < 0).to_type(int)
    let magnitude u64 = value.to_type(u64)
    if (negative != 0) { magnitude = 0 - magnitude }
    if (magnitude == 0) {
        digits[count] = '0'
        count += 1
    }
    for magnitude > 0 {
        digits[count] = ((magnitude % 10) + 48).to_type(u8)
        count += 1
        magnitude = magnitude / 10
    }
    if (negative != 0 && if_put('-') != 0) { return -1 }
    for count > 0 {
        count -= 1
        if (if_put(digits[count]) != 0) { return -1 }
    }
    return 0
}

// iface_ct_emit_u64_hex：十六进制保留 u64 高位常量的原始位型。

// iface_ct_emit_u64_hex：十六进制保留 u64 高位常量的原始位型。
fn iface_ct_emit_u64_hex(value i64) int {
    let bits u64 = value.to_type(u64)
    if (if_puts("0x") != 0) { return -1 }
    let shift int = 60
    for shift >= 0 {
        let digit int = ((bits >> shift) & 15).to_type(int)
        let byte u8 = 0
        if (digit < 10) { byte = (digit + 48).to_type(u8) }
        else { byte = (digit + 87).to_type(u8) }
        if (if_put(byte) != 0) { return -1 }
        shift -= 4
    }
    return 0
}

// iface_emit_const_value：输出整型/bool 常量的值文本（.s.i 与 .s.ct 共用）。
// 必须按**声明宽度**取值：cval 是 64 位槽，窄化为宿主 int 会把 u32 的
// 0xfeedfacf 打成 -17958193、把 0x80000000 打成空的负号（导入侧报「字面量
// 超出目标类型可表示范围」）。u64 的高位常量为保位型走十六进制。

// iface_emit_const_value：输出整型/bool 常量的值文本（.s.i 与 .s.ct 共用）。
// 必须按**声明宽度**取值：cval 是 64 位槽，窄化为宿主 int 会把 u32 的
// 0xfeedfacf 打成 -17958193、把 0x80000000 打成空的负号（导入侧报「字面量
// 超出目标类型可表示范围」）。u64 的高位常量为保位型走十六进制。
fn iface_emit_const_value(sym_id int) int {
    let sym support.CSym = support.ms().syms[sym_id]
    let kind int = support.ms().types[sym.type_id].kind
    if (kind == support.TY_BOOL) {
        if (sym.cval == 0) {
            return if_puts("false")
        }
        return if_puts("true")
    }
    if (kind == support.TY_U64 && sym.cval < 0) {
        return iface_ct_emit_u64_hex(sym.cval)
    }
    return iface_ct_emit_i64(sym.cval)
}

// iface_ct_emit_const：把闭包读取的受支持常量写为稳定隐藏名字和值。

// iface_ct_emit_const：把闭包读取的受支持常量写为稳定隐藏名字和值。
fn iface_ct_emit_const(sym_id int, suffix_off int,
    suffix_len int) int {
    let type_id int = -1
    if (sym_id < 0 || sym_id >= support.ms().sym_n
        || support.ms().syms[sym_id].kind != support.SYM_CONST
        || support.ms().syms[sym_id].const_ready == 0) {
        return token.err_tok("跨模块 CT 正文引用了不支持的模块常量")
    }
    let sym support.CSym = support.ms().syms[sym_id]
    type_id = sym.type_id
    let type_kind int = support.ms().types[type_id].kind
    let string_ptr int = (type_kind == support.TY_PTR
        && support.ms().types[type_id].elem == support.TY_CHAR
        && (sym.flags & support.F_ADDR) != 0).to_type(int)
    // 聚合常量（kind 4/5）：重放初始化式源文本，导入侧按模块模式重新解析（私有聚合常量
    // 在第 47 轮已放行，所以导入侧能接受）。切片常量同样以源文本重放，导入侧按 count
    // 建模（run/165）；$ 调用初始化（kind 5）在重放时把调用目标重写为闭包隐藏名，
    // 导入侧延迟到闭包加载完成后执行（见 parse_global_init.yh 的 pub_agg_deferred_run）。
    let ck_src int = sym.const_expr_kind
    let agg_src int = (string_ptr == 0 && (ck_src == 4 || ck_src == 5)
        && sym.const_expr_len > 0
        && (type_kind == support.TY_ARRAY || type_kind == support.TY_STRUCT
            || type_kind == support.TY_SLICE)).to_type(int)
    if (support.ty_is_integer(type_id) == 0
        && support.ty_is_float(type_id) == 0 && string_ptr == 0 && agg_src == 0) {
        if (type_kind == support.TY_PTR) {
            return token.err_tok("跨模块 CT 闭包暂只支持直接字符串字面量指针常量")
        }
        return token.err_tok("跨模块 CT 正文引用了不支持的模块常量类型")
    }
    if (if_puts("const ") != 0) { return -1 }
    let name_off int = -1
    let name_len int = 0
    if (iface_ct_name(sym_id, suffix_off, suffix_len,
            &name_off, &name_len) != 0
        || if_put_np(name_off, name_len) != 0 || if_put(' ') != 0
        || iface_ct_emit_type(sym.type_id, suffix_off, suffix_len) != 0
        || if_puts(" = ") != 0) { return -1 }
    let kind int = support.ms().types[sym.type_id].kind
    if (support.ty_is_float(type_id) != 0) {
        if (sym.const_expr_kind != 1 || sym.const_expr_off < 0
            || sym.const_expr_len <= 0) {
            return token.err_tok("跨模块 CT 闭包暂只支持浮点字面式常量")
        }
        if (if_put_np(sym.const_expr_off, sym.const_expr_len) != 0) {
            return -1
        }
        return if_puts(";\n")
    }
    if (agg_src != 0) {
        // kind 4 原样重放；kind 5 重写 $ 调用目标（iface.yh 的公共实现）。
        if (iface_emit_pub_agg_src(sym_id) != 0) { return -1 }
        return if_puts(";\n")
    }
    if (string_ptr != 0) {
        let lit_off int = 0
        let lit_len int = 0
        if (support.sym_ct_lit_text(sym_id, &lit_off, &lit_len) != 0 || lit_len < 2) {
            return token.err_tok("跨模块 CT 闭包暂只支持直接或引用式的字符串字面量指针常量")
        }
        if (if_put_np(lit_off, lit_len) != 0) {
            return -1
        }
        return if_puts(";\n")
    }
    if (iface_emit_const_value(sym_id) != 0) { return -1 }
    return if_puts(";\n")
}

// iface_ct_emit_function：发出闭包中的一个 private @[comptime] 定义。

// iface_ct_emit_function：发出闭包中的一个 private @[comptime] 定义。
fn iface_ct_emit_function(row int, suffix_off int,
    suffix_len int) int {
    let item comptime.CtFunction = comptime.ct_iface_function(row)
    if (item.sym_id < 0 || item.sym_id >= support.ms().sym_n) {
        return support.fail("内部错误：CT 接口函数符号越界")
    }
    // 先在独立缓冲中完成正文改写，收集的列映射再写到函数声明之前。
    iface_ct_col_reset()
    let saved_buf *u8 = if_buf
    let saved_len int = if_len
    let saved_cap int = if_cap
    if_buf = 0
    if_len = 0
    if_cap = 0
    let body_status int = iface_ct_emit_body(row, &item)
    let body_buf *u8 = if_buf
    let body_len int = if_len
    if_buf = saved_buf
    if_len = saved_len
    if_cap = saved_cap
    if (body_status != 0) {
        if (body_buf != 0) { free(body_buf) }
        iface_ct_col_reset()
        return -1
    }
    let status int = iface_ct_emit_origin(&item)
    if (status == 0 && if_puts("@[comptime]\nfn ") != 0) { status = -1 }
    let name_off int = -1
    let name_len int = 0
    if (status == 0 && (iface_ct_name(item.sym_id, suffix_off, suffix_len,
            &name_off, &name_len) != 0
        || if_put_np(name_off, name_len) != 0 || if_put('(') != 0)) {
        status = -1
    }
    let i int = 0
    for i < item.param_n && status == 0 {
        if (i > 0 && if_puts(", ") != 0) { status = -1; break }
        let param comptime.CtParam = item.params[i]
        let j int = 0
        for j < param.name_len && status == 0 {
            if (if_put(item.src[param.name_start + j]) != 0) {
                status = -1
                break
            }
            j += 1
        }
        if (status == 0 && (if_put(' ') != 0
            || iface_ct_emit_type(param.type_id, suffix_off,
                suffix_len) != 0)) { status = -1 }
        i += 1
    }
    if (status == 0 && (if_puts(") ") != 0
        || iface_ct_emit_type(item.ret_type, suffix_off, suffix_len) != 0
        || if_put(' ') != 0)) { status = -1 }
    i = 0
    for i < body_len && status == 0 {
        if (if_put(body_buf[i]) != 0) { status = -1; break }
        i += 1
    }
    if (status == 0 && if_put('\n') != 0) { status = -1 }
    if (body_buf != 0) { free(body_buf) }
    iface_ct_col_reset()
    return status
}

// iface_ct_write：原子写出当前 if_buf，避免消费者看到半份 .s.ct。

// iface_ct_write：原子写出当前 if_buf，避免消费者看到半份 .s.ct。
fn iface_ct_write(path *char) int {
    let tmp [900]u8
    let tn int = 0
    tn = support.append_str(tmp, tn, path)
    tn = support.append_str(tmp, tn, ".tmp.")
    tn = support.append_int(tmp, tn, getpid())
    tmp[tn] = 0
    let flags int = 0x241
    if (support.tg_host_darwin() != 0) { flags = 0x601 }
    let fd int = open(support.arr_cstr(tmp), flags, 0x1a4)
    if (fd < 0) { return support.fail_path("无法创建 CT 接口: ", path) }
    let wr int = support.write_all(fd, if_buf, if_len)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(support.arr_cstr(tmp), path) != 0) {
        unlink(support.arr_cstr(tmp))
        return support.fail_path("无法发布 CT 接口: ", path)
    }
    return 0
}

// iface_ct_emit：导出公开 CT 函数可达的本模块闭包并写入版本化 .s.ct。

// iface_ct_head_prefix_len：校验 .s.ct 头前缀（版本必须为 CTIFACE_VERSION，
// 架构与当前目标一致），成功返回 suffix 起点，失败返回 -1。

// iface_ct_head_prefix_len_at：纯函数版本，供内嵌测试构造输入。

// iface_ct_col_reset：释放当前函数的改写映射与 token 位置快照。
fn iface_ct_col_reset() void {
    if (if_ct_col_maps != 0) { free(if_ct_col_maps.to_type(*void)) }
    if (if_ct_col_saved != 0) { free(if_ct_col_saved.to_type(*void)) }
    if_ct_col_maps = 0
    if_ct_col_n = 0
    if_ct_col_cap = 0
    if_ct_col_body_col = 0
    if_ct_col_saved = 0
    if_ct_col_saved_n = 0
    if_ct_col_scan_offset = 0
    if_ct_col_scan_line = 0
    if_ct_col_scan_col = 0
}

// iface_ct_col_grow：为正文重写记录扩容。

// iface_ct_col_grow：为正文重写记录扩容。
fn iface_ct_col_grow() int {
    let next_cap int = if_ct_col_cap * 2
    if (next_cap == 0) { next_cap = 16 }
    let next *IfaceCtColMap = malloc(
        (next_cap * sizeof(IfaceCtColMap)).to_type(u64)) .
        to_type(*IfaceCtColMap)
    if (next == 0) { return support.fail("CT 列映射分配失败") }
    if (if_ct_col_n > 0) {
        memcpy(next, if_ct_col_maps,
            (if_ct_col_n * sizeof(IfaceCtColMap)).to_type(u64))
    }
    if (if_ct_col_maps != 0) { free(if_ct_col_maps.to_type(*void)) }
    if_ct_col_maps = next
    if_ct_col_cap = next_cap
    return 0
}

// iface_ct_col_generated：将正文缓冲偏移换算为相对左花括号的行列坐标。

// iface_ct_col_generated：将正文缓冲偏移换算为相对左花括号的行列坐标。
fn iface_ct_col_generated(offset int, line *int, col *int) int {
    if (offset < if_ct_col_scan_offset || offset > if_len) { return -1 }
    let i int = if_ct_col_scan_offset
    for i < offset {
        if (if_buf[i] == '\n') {
            if_ct_col_scan_line += 1
            if_ct_col_scan_col = 1
        } else { if_ct_col_scan_col += 1 }
        i += 1
    }
    if_ct_col_scan_offset = offset
    line[0] = if_ct_col_scan_line
    col[0] = if_ct_col_scan_col
    return 0
}

// iface_ct_col_source：取得快照 token 的原始相对位置，兼容多层 sidecar 转发。

// iface_ct_col_source：取得快照 token 的原始相对位置，兼容多层 sidecar 转发。
fn iface_ct_col_source(item *comptime.CtFunction, token_index int,
    after_end int, line *int, col *int) int {
    if (token_index < 0 || token_index >= item.body_n
        || item.body_n <= 0) { return -1 }
    let brace_line int = item.body[0].line + item.src_line_bias
    let brace_col int = item.body[0].col
    let token_line int = item.body[token_index].line + item.src_line_bias
    let delta int = token_line - brace_line
    let column int = item.body[token_index].col
    if (delta == 0) { column -= brace_col }
    if (after_end != 0) { column += item.body[token_index].len }
    if (delta < 0 || column < 0) { return -1 }
    line[0] = delta
    col[0] = column
    return 0
}

// iface_ct_col_note：记录一次源文本替换，供导入侧把 token 列反映射回原文。

// iface_ct_col_note：记录一次源文本替换，供导入侧把 token 列反映射回原文。
fn iface_ct_col_note(item *comptime.CtFunction, gen_start int,
    gen_end int, gen_after int, src_start_token int,
    src_after_token int, src_after_end int) int {
    if (if_ct_col_n == if_ct_col_cap && iface_ct_col_grow() != 0) {
        return -1
    }
    let row IfaceCtColMap
    if (iface_ct_col_generated(gen_start, &row.gen_start_line,
            &row.gen_start_col) != 0
        || iface_ct_col_generated(gen_end, &row.gen_end_line,
            &row.gen_end_col) != 0
        || iface_ct_col_generated(gen_after, &row.gen_after_line,
            &row.gen_after_col) != 0
        || iface_ct_col_source(item, src_start_token, 0,
            &row.src_start_line, &row.src_start_col) != 0
        || iface_ct_col_source(item, src_after_token, src_after_end,
            &row.src_after_line, &row.src_after_col) != 0) {
        return token.err_tok("无法记录 CT 正文来源列")
    }
    if (row.src_after_line - row.src_start_line
        != row.gen_after_line - row.gen_start_line) {
        return token.err_tok("CT 正文改写改变了来源行数")
    }
    if_ct_col_maps[if_ct_col_n] = row
    if_ct_col_n += 1
    return 0
}

// iface_ct_col_emit：把当前正文的列改写记录写在 yh-ctloc 注释之前。

// iface_ct_col_emit：把当前正文的列改写记录写在 yh-ctloc 注释之前。
fn iface_ct_col_emit(item *comptime.CtFunction) int {
    if (if_puts("// yh-ctcol v1 ") != 0
        || if_puti(if_ct_col_n) != 0 || if_put(' ') != 0
        || if_puti(item.body[0].col) != 0) { return -1 }
    let i int = 0
    for i < if_ct_col_n {
        let row IfaceCtColMap = if_ct_col_maps[i]
        if (if_put(' ') != 0
            || if_puti(row.gen_start_line) != 0 || if_put(' ') != 0
            || if_puti(row.gen_start_col) != 0 || if_put(' ') != 0
            || if_puti(row.gen_end_line) != 0 || if_put(' ') != 0
            || if_puti(row.gen_end_col) != 0 || if_put(' ') != 0
            || if_puti(row.gen_after_line) != 0 || if_put(' ') != 0
            || if_puti(row.gen_after_col) != 0 || if_put(' ') != 0
            || if_puti(row.src_start_line) != 0 || if_put(' ') != 0
            || if_puti(row.src_start_col) != 0 || if_put(' ') != 0
            || if_puti(row.src_after_line) != 0 || if_put(' ') != 0
            || if_puti(row.src_after_col) != 0) { return -1 }
        i += 1
    }
    return if_put('\n')
}

// iface_ct_col_digit：读取来源映射整数时把十进制字符转换为数字。

// iface_ct_col_digit：读取来源映射整数时把十进制字符转换为数字。
fn iface_ct_col_digit(byte u8) int {
    if (byte < '0' || byte > '9') { return -1 }
    return (byte - '0').to_type(int)
}

// iface_ct_col_read_number：读取一个以空格分隔的非负十进制整数。

// iface_ct_col_read_number：读取一个以空格分隔的非负十进制整数。
fn iface_ct_col_read_number(pos *int, end int,
    value *int) int {
    for pos[0] < end && support.src_ctx().data[pos[0]] == ' ' { pos[0] += 1 }
    if (pos[0] >= end) { return -1 }
    let number int = 0
    let digits int = 0
    for pos[0] < end && support.src_ctx().data[pos[0]] != ' ' {
        let digit int = iface_ct_col_digit(support.src_ctx().data[pos[0]])
        if (digit < 0 || number > 100000000) { return -1 }
        number = number * 10 + digit
        digits += 1
        pos[0] += 1
    }
    if (digits == 0) { return -1 }
    value[0] = number
    return 0
}

// iface_ct_col_parse：解析可选的 yh-ctcol 行；旧 sidecar 没有该行时保持兼容。

// iface_ct_col_parse：解析可选的 yh-ctcol 行；旧 sidecar 没有该行时保持兼容。
fn iface_ct_col_parse(start int, end int) int {
    iface_ct_col_reset()
    let prefix *char = "// yh-ctcol v1 "
    let prefix_len int = 15
    if (end - start < prefix_len) { return 0 }
    let i int = 0
    for i < prefix_len {
        if (support.src_ctx().data[start + i] != prefix[i].to_type(u8)) { return 0 }
        i += 1
    }
    let pos int = start + prefix_len
    let count int = 0
    if (iface_ct_col_read_number(&pos, end, &count) != 0
        || iface_ct_col_read_number(&pos, end,
            &if_ct_col_body_col) != 0
        || count > 8192 || if_ct_col_body_col <= 0) {
        iface_ct_col_reset()
        return support.fail_path("CT 列映射格式无效: ", support.src_ctx().path)
    }
    if (count > 0) {
        if_ct_col_maps = malloc((count * sizeof(IfaceCtColMap)).to_type(u64)) .
            to_type(*IfaceCtColMap)
        if (if_ct_col_maps == 0) {
            iface_ct_col_reset()
            return support.fail("CT 列映射分配失败")
        }
        if_ct_col_cap = count
    }
    i = 0
    for i < count {
        let row IfaceCtColMap
        if (iface_ct_col_read_number(&pos, end,
                &row.gen_start_line) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.gen_start_col) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.gen_end_line) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.gen_end_col) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.gen_after_line) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.gen_after_col) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.src_start_line) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.src_start_col) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.src_after_line) != 0
            || iface_ct_col_read_number(&pos, end,
                &row.src_after_col) != 0
            || row.gen_start_line > row.gen_end_line
            || row.gen_end_line > row.gen_after_line
            || row.src_after_line - row.src_start_line
                != row.gen_after_line - row.gen_start_line) {
            iface_ct_col_reset()
            return support.fail_path("CT 列映射条目无效: ", support.src_ctx().path)
        }
        if_ct_col_maps[i] = row
        i += 1
    }
    for pos < end && support.src_ctx().data[pos] == ' ' { pos += 1 }
    if (pos != end) {
        iface_ct_col_reset()
        return support.fail_path("CT 列映射尾部无效: ", support.src_ctx().path)
    }
    if_ct_col_n = count
    return 1
}

// iface_ct_col_apply：临时改写函数体 token 列，并将被替换 token 映射回源码行。

// iface_ct_col_apply：临时改写函数体 token 列，并将被替换 token 映射回源码行。
fn iface_ct_col_apply(body_token int,
    body_after int, origin_line int) int {
    if (if_ct_col_n <= 0) { return 0 }
    let count int = body_after - body_token
    if (count <= 0) { return support.fail("CT 列映射函数体范围无效") }
    if_ct_col_saved = malloc((count * sizeof(IfaceCtTokPosition)).to_type(u64)) .
        to_type(*IfaceCtTokPosition)
    if (if_ct_col_saved == 0) { return support.fail("CT token 位置快照分配失败") }
    let brace_line int = token.ctx().tokens[body_token].line
    let brace_col int = token.ctx().tokens[body_token].col
    let i int = 0
    for i < count {
        let token_index int = body_token + i
        if_ct_col_saved[i].index = token_index
        if_ct_col_saved[i].line = token.ctx().tokens[token_index].line
        if_ct_col_saved[i].col = token.ctx().tokens[token_index].col
        if_ct_col_saved_n += 1
        let token_line int = token.ctx().tokens[token_index].line - brace_line
        let original_col int = token.ctx().tokens[token_index].col
        let token_col int = token.ctx().tokens[token_index].col
        if (token_line == 0) { token_col -= brace_col }
        let edit int = 0
        let mapped int = 0
        let col_delta int = 0
        for edit < if_ct_col_n {
            let row IfaceCtColMap = if_ct_col_maps[edit]
            let after_start int = (token_line > row.gen_start_line
                || (token_line == row.gen_start_line
                    && token_col >= row.gen_start_col)).to_type(int)
            let before_end int = (token_line < row.gen_end_line
                || (token_line == row.gen_end_line
                    && token_col < row.gen_end_col)).to_type(int)
            if (after_start != 0 && before_end != 0) {
                let source_line int = origin_line + row.src_start_line
                token.ctx().tokens[token_index].line = source_line -
                    support.diag().line_bias
                let source_col int = row.src_start_col
                if (row.src_start_line == 0) {
                    token.ctx().tokens[token_index].col = if_ct_col_body_col +
                        source_col
                } else { token.ctx().tokens[token_index].col = source_col }
                mapped = 1
                break
            }
            if (token_line == row.gen_after_line
                && token_col >= row.gen_after_col) {
                // 每条记录的差值相对原源码计算，后面的编辑覆盖前面的列偏移。
                col_delta = row.src_after_col - row.gen_after_col
            }
            edit += 1
        }
        if (mapped == 0) {
            token.ctx().tokens[token_index].col = original_col + col_delta
        }
        if (mapped == 0 && token.ctx().tokens[token_index].col <= 0) {
            return support.err_lc(token.ctx().tokens[token_index].line,
                token.ctx().tokens[token_index].col, "CT 列映射产生无效列号")
        }
        i += 1
    }
    return 0
}

// iface_ct_col_restore：恢复 sidecar token 原始行列，避免影响后续解析轮次。

// iface_ct_col_restore：恢复 sidecar token 原始行列，避免影响后续解析轮次。
fn iface_ct_col_restore() void {
    let i int = 0
    for i < if_ct_col_saved_n {
        let token_index int = if_ct_col_saved[i].index
        if (token_index >= 0 && token_index < token.ctx().count) {
            token.ctx().tokens[token_index].line = if_ct_col_saved[i].line
            token.ctx().tokens[token_index].col = if_ct_col_saved[i].col
        }
        i += 1
    }
    iface_ct_col_reset()
}
