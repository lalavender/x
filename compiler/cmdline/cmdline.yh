module cmdline

import libs.cli
import gen

// ============================================================================
// cmdline.yh —— yh 命令行的声明与解析（CLI-R，2026-10-27）
//
// 本模块是「argv → CliRequest」的唯一实现：用 libs/cli 声明全部选项与子命令，
// 解析后把结果填进 CliRequest 供 cmd 分派。放在独立模块（而不是 module main）
// 是为了保持 `cmd` 只做参数映射与调用面（A6 架构契约），并让
// `main -> cmdline -> libs` 这条标准库依赖在 arch-check 里显式登记。
//
// 两个 parser（对应 driver 的历史分派方式）：
//   project —— `build/check/run/test/list/version` 六个子命令；
//   file    —— 单文件形态（`--syntax-check`、`--emit-asm`、`-o`）。
// 全局选项（`--target/-target`、`--backend`、`-O0/-O2`、`--emit-llvm`、`--stats`、
// `--legacy-system`）声明在公共 parent 上再 inherit 进子 parser，因此
// 「子命令前后都能写」与旧的手写扫描一致。
//
// 豁免：内部子进程协议 `--emit-module` 不经过本模块（见 driver.yh）。
// ============================================================================

// CliCommand 是顶层动作；取值与 driver 的分派一一对应。
pub const CLI_BARE int = 0
pub const CLI_BUILD int = 1
pub const CLI_CHECK int = 2
pub const CLI_RUN int = 3
pub const CLI_TEST int = 4
pub const CLI_LIST int = 5
pub const CLI_VERSION int = 6
pub const CLI_FILE int = 7

// 单文件形态的模式位（与 API_SYNTAX/API_ASM/API_EXE 语义一致）。
pub const CLIFILE_NONE int = 0
pub const CLIFILE_SYNTAX int = 1
pub const CLIFILE_ASM int = 2
pub const CLIFILE_EXE int = 3

// CliRequest 是解析结果；文本指针借用 result 的池，必须与 result 同寿。
pub struct CliRequest {
    command int
    file_mode int
    result cli.Result      // 持有解析结果（文本借用其池）
    src *char              // 单文件源 / build 模块 / check 目标 / test 选择器
    has_src int
    out *char              // -o/--output 输出路径
    target *char           // --target（0 表示未提供）
    backend *char          // --backend（0 表示未提供）
    opt_level int          // -O0/-O2，最后出现者生效
    emit_llvm int
    stats int
    legacy_system int
    link_count int
    links [16]*char        // --link 组名（借用 argv）
    list_mode int
    no_run int
    filter *char
    timeout_secs int
    contracts int
    resolve *char
    has_resolve int
}

// cli_common_add 声明全局选项；配置错误返回 -1。
fn cli_common_add(common *cli.Parser) int {
    let config cli.ParserConfig = cli.parser_config("yh")
    config.add_help = false
    config.color = cli.never
    config.help_format.section_positional = "位置参数"
    config.help_format.section_options = "选项"
    config.help_format.section_commands = "命令"
    if (cli.init(common, config) != 0) {
        return -1
    }
    let target cli.Argument = cli.option("--target", "-target")
    target.help = "选择完整输出目标（LLVM triple）"
    target.metavar = "TRIPLE"
    if (cli.add_argument(common, target) < 0) {
        return -1
    }
    let backend cli.Argument = cli.option("--backend", 0)
    backend.help = "代码生成后端（只接受 llvm）"
    backend.metavar = "NAME"
    if (cli.add_argument(common, backend) < 0) {
        return -1
    }
    // -O0/-O2 共用 dest：按 token 顺序写入，最后出现者生效（旧扫描语义）。
    let zero cli.Value = cli.value_i64(0)
    let two cli.Value = cli.value_i64(2)
    let zero_default cli.Default = cli.default_of(zero)
    let o0 cli.Argument = cli.option("-O0", 0)
    o0.dest = "opt"
    o0.action = cli.store_const
    o0.const_value = zero
    o0.default_value = zero_default
    o0.help = "不优化（默认）"
    if (cli.add_argument(common, o0) < 0) {
        return -1
    }
    let o2 cli.Argument = cli.option("-O2", 0)
    o2.dest = "opt"
    o2.action = cli.store_const
    o2.const_value = two
    o2.default_value = zero_default
    o2.help = "优化级别 2"
    if (cli.add_argument(common, o2) < 0) {
        return -1
    }
    let emit_llvm cli.Argument = cli.option("--emit-llvm", 0)
    emit_llvm.action = cli.store_true
    emit_llvm.help = "只写 LLVM 文本（每模块一个 .ll）"
    if (cli.add_argument(common, emit_llvm) < 0) {
        return -1
    }
    let stats cli.Argument = cli.option("--stats", 0)
    stats.action = cli.store_true
    stats.help = "打印构建统计"
    if (cli.add_argument(common, stats) < 0) {
        return -1
    }
    let legacy cli.Argument = cli.option("--legacy-system", 0)
    legacy.dest = "legacy_system"
    legacy.action = cli.store_true
    legacy.help = "启用兼容 system(cmd) 接口"
    if (cli.add_argument(common, legacy) < 0) {
        return -1
    }
    return 0
}

// cli_add_link 给 build/run 声明可重复的 --link；失败返回 -1。
fn cli_add_link(p *cli.Parser) int {
    let link cli.Argument = cli.option("--link", 0)
    link.action = cli.append
    link.metavar = "GROUP"
    link.help = "链接清单里的组（可重复）"
    return cli.add_argument(p, link)
}

// cli_add_out 声明 -o/--output 输出路径；失败返回 -1。
fn cli_add_out(p *cli.Parser) int {
    let out cli.Argument = cli.option("--output", "-o")
    out.metavar = "PATH"
    out.help = "输出路径"
    return cli.add_argument(p, out)
}

// cli_add_src 声明位置参数（module/selector/check target/file 共用）。
// dest 单独给出，避免与全局选项 dest（如 --target）撞名；失败返回 -1。
fn cli_add_src(p *cli.Parser, name *char, dest *char, required int) int {
    let src cli.Argument = cli.positional(name)
    src.dest = dest
    if (required == 0) {
        src.arity = cli.optional()
    }
    return cli.add_argument(p, src)
}

// cli_build_project 构造项目命令 parser；返回非 0 表示配置失败。
fn cli_build_project(root *cli.Parser) int {
    let config cli.ParserConfig = cli.parser_config("yh")
    config.add_help = false
    config.color = cli.never
    config.help_format.section_positional = "位置参数"
    config.help_format.section_options = "选项"
    config.help_format.section_commands = "命令"
    if (cli.init(root, config) != 0) {
        return -1
    }
    let common cli.Parser
    if (cli_common_add(&common) != 0) {
        return -1
    }
    if (cli.inherit(root, &common) != 0) {
        cli.destroy(&common)
        return -1
    }
    let spec cli.Subparsers = cli.subparsers()
    spec.required = true
    spec.title = "命令"
    let slot int = cli.add_subparsers(root, spec)
    if (slot < 0) {
        cli.destroy(&common)
        return -1
    }
    // build
    let build_cmd cli.Command = cli.command("build")
    build_cmd.help = "构建当前项目"
    let build_p *cli.Parser = cli.add_parser(root, slot, build_cmd)
    if (build_p == 0 || cli.inherit(build_p, &common) != 0
        || cli_add_link(build_p) < 0 || cli_add_out(build_p) < 0
        || cli_add_src(build_p, "module", "module", 0) < 0) {
        cli.destroy(&common)
        return -1
    }
    // check
    let check_cmd cli.Command = cli.command("check")
    check_cmd.help = "检查语义，不生成后端产物"
    let check_p *cli.Parser = cli.add_parser(root, slot, check_cmd)
    if (check_p == 0 || cli.inherit(check_p, &common) != 0
        || cli_add_src(check_p, "target", "check_target", 0) < 0) {
        cli.destroy(&common)
        return -1
    }
    // run
    let run_cmd cli.Command = cli.command("run")
    run_cmd.help = "构建并运行 main 模块"
    let run_p *cli.Parser = cli.add_parser(root, slot, run_cmd)
    if (run_p == 0 || cli.inherit(run_p, &common) != 0 || cli_add_link(run_p) < 0) {
        cli.destroy(&common)
        return -1
    }
    // test
    let test_cmd cli.Command = cli.command("test")
    test_cmd.help = "发现、构建并执行语言内测试"
    let test_p *cli.Parser = cli.add_parser(root, slot, test_cmd)
    if (test_p == 0 || cli.inherit(test_p, &common) != 0) {
        cli.destroy(&common)
        return -1
    }
    let list_opt cli.Argument = cli.option("--list", 0)
    list_opt.dest = "list_mode"
    list_opt.action = cli.store_true
    list_opt.help = "只列出测试身份"
    let no_run cli.Argument = cli.option("--no-run", 0)
    no_run.dest = "no_run"
    no_run.action = cli.store_true
    no_run.help = "只构建不执行"
    let filter cli.Argument = cli.option("--filter", 0)
    filter.metavar = "SUBSTR"
    filter.help = "只跑身份含该子串的用例"
    let timeout cli.Argument = cli.option("--timeout", 0)
    timeout.metavar = "SECS"
    timeout.value_kind = cli.integer
    timeout.help = "单例超时秒数（1..3600）"
    timeout.default_value = cli.default_of(cli.value_i64(15))
    if (cli.add_argument(test_p, list_opt) < 0 || cli.add_argument(test_p, no_run) < 0
        || cli.add_argument(test_p, filter) < 0 || cli.add_argument(test_p, timeout) < 0
        || cli_add_src(test_p, "selector", "selector", 0) < 0) {
        cli.destroy(&common)
        return -1
    }
    // list
    let list_cmd cli.Command = cli.command("list")
    list_cmd.help = "列出模块或导入绑定"
    let list_p *cli.Parser = cli.add_parser(root, slot, list_cmd)
    if (list_p == 0 || cli.inherit(list_p, &common) != 0) {
        cli.destroy(&common)
        return -1
    }
    let resolve cli.Argument = cli.option("--resolve", 0)
    resolve.metavar = "NAME"
    resolve.help = "解释该导入名的绑定来源"
    if (cli.add_argument(list_p, resolve) < 0) {
        cli.destroy(&common)
        return -1
    }
    // version
    let version_cmd cli.Command = cli.command("version")
    version_cmd.help = "显示项目名与版本"
    let version_p *cli.Parser = cli.add_parser(root, slot, version_cmd)
    if (version_p == 0 || cli.inherit(version_p, &common) != 0) {
        cli.destroy(&common)
        return -1
    }
    let contracts cli.Argument = cli.option("--contracts", 0)
    contracts.action = cli.store_true
    contracts.help = "显示产物契约版本"
    if (cli.add_argument(version_p, contracts) < 0) {
        cli.destroy(&common)
        return -1
    }
    cli.destroy(&common)
    return 0
}

// cli_build_file 构造单文件形态 parser；返回非 0 表示配置失败。
fn cli_build_file(root *cli.Parser) int {
    let config cli.ParserConfig = cli.parser_config("yh")
    config.add_help = false
    config.color = cli.never
    config.help_format.section_positional = "位置参数"
    config.help_format.section_options = "选项"
    if (cli.init(root, config) != 0) {
        return -1
    }
    let common cli.Parser
    if (cli_common_add(&common) != 0) {
        return -1
    }
    if (cli.inherit(root, &common) != 0) {
        cli.destroy(&common)
        return -1
    }
    let syntax cli.Argument = cli.option("--syntax-check", 0)
    syntax.dest = "syntax_check"
    syntax.action = cli.store_true
    syntax.help = "只做词法/语法检查"
    let asm cli.Argument = cli.option("--emit-asm", 0)
    asm.dest = "emit_asm"
    asm.action = cli.store_true
    asm.help = "发射当前目标汇编到标准输出"
    if (cli.add_argument(root, syntax) < 0 || cli.add_argument(root, asm) < 0
        || cli_add_out(root) < 0 || cli_add_src(root, "file", "file", 1) < 0) {
        cli.destroy(&common)
        return -1
    }
    cli.destroy(&common)
    return 0
}

// cli_is_command 判断 token 是否是顶层子命令名（用于在两种 parser 间分流）。
fn cli_is_command(token *char) int {
    if (gen.cstr_eq(token, "build") != 0 || gen.cstr_eq(token, "check") != 0
        || gen.cstr_eq(token, "run") != 0 || gen.cstr_eq(token, "test") != 0
        || gen.cstr_eq(token, "list") != 0 || gen.cstr_eq(token, "version") != 0) {
        return 1
    }
    return 0
}

// cli_first_token 跳过全局选项，返回第一个非全局 token 的下标（没有返回 -1）。
// 与旧 `drv_scan_target` 的「全局选项位置无关」一致。
fn cli_first_token(argc int, argv **char) int {
    let i int = 1
    for i < argc {
        if (gen.cstr_eq(argv[i], "--target") != 0 || gen.cstr_eq(argv[i], "-target") != 0
            || gen.cstr_eq(argv[i], "--backend") != 0) {
            i += 2
            continue
        }
        if (gen.cstr_eq(argv[i], "-O0") != 0 || gen.cstr_eq(argv[i], "-O2") != 0
            || gen.cstr_eq(argv[i], "--emit-llvm") != 0
            || gen.cstr_eq(argv[i], "--stats") != 0
            || gen.cstr_eq(argv[i], "--legacy-system") != 0) {
            i += 1
            continue
        }
        return i
    }
    return -1
}

// cli_copy_message 把结果诊断复制进调用方缓冲；没有消息时写空串。
fn cli_copy_message(result *cli.Result, buffer *char, capacity int) void {
    buffer[0] = 0
    if (result.error.message == 0) {
        return
    }
    let i int = 0
    for result.error.message[i] != 0 && i + 1 < capacity {
        buffer[i] = result.error.message[i]
        i += 1
    }
    buffer[i] = 0
}

// cli_read_text 取文本 dest 的借用指针；缺失返回 0。
fn cli_read_text(req *CliRequest, dest *char) *char {
    let text *char = 0
    if (cli.get_text(&req.result.values, dest, &text) != 0) {
        return 0
    }
    return text
}

// cli_read_i64 取整数 dest；缺失或类型不符返回 fallback。
fn cli_read_i64(req *CliRequest, dest *char, fallback i64) i64 {
    let value i64 = 0
    if (cli.get_i64(&req.result.values, dest, &value) != 0) {
        return fallback
    }
    return value
}

// cli_read_flag 取布尔 dest；缺失或类型不符返回 0。
fn cli_read_flag(req *CliRequest, dest *char) int {
    let value bool = false
    if (cli.get_bool(&req.result.values, dest, &value) != 0) {
        return 0
    }
    return value.to_type(int)
}

// cli_read_links 把 --link 列表复制进请求（借用 argv 指针）；超上限返回 -1。
fn cli_read_links(req *CliRequest) int {
    let values []cli.Value
    if (cli.get_list(&req.result.values, "link", &values) != 0) {
        return 0
    }
    let i int = 0
    for i < len(values) {
        if (i >= 16) {
            return -1
        }
        if (values[i].kind != cli.text || values[i].data.text == 0) {
            return -1
        }
        req.links[i] = values[i].data.text
        i += 1
    }
    req.link_count = len(values)
    return 0
}

// cli_take_globals 把全局选项写进 CliRequest（target/opt/emit_llvm/stats/legacy）。
fn cli_take_globals(req *CliRequest) void {
    req.target = cli_read_text(req, "target")
    req.backend = cli_read_text(req, "backend")
    req.opt_level = cli_read_i64(req, "opt", 0).to_type(int)
    req.emit_llvm = cli_read_flag(req, "emit_llvm")
    req.stats = cli_read_flag(req, "stats")
    req.legacy_system = cli_read_flag(req, "legacy_system")
}

// parse_request 解析 argv 并填请求。
// 返回 0 成功、2 用法错误、1 配置/资源错误；错误文本写入 message（可为 0 长度）。
pub fn parse_request(argc int, argv **char, req *CliRequest,
    message *char, message_capacity int) int {
    let fresh cli.Result
    req.result = fresh
    req.command = CLI_BARE
    req.file_mode = CLIFILE_NONE
    req.has_src = 0
    req.has_resolve = 0
    req.link_count = 0
    req.timeout_secs = 15
    message[0] = 0
    if (argc <= 1) {
        return 0
    }
    let first int = cli_first_token(argc, argv)
    let chained int = (first >= 0 && cli_is_command(argv[first]) != 0) ? 1 : 0
    let parser cli.Parser
    let built int = 0
    if (chained != 0) {
        built = cli_build_project(&parser)
    } else {
        built = cli_build_file(&parser)
    }
    if (built != 0) {
        cli.destroy(&parser)
        return 1
    }
    req.result = cli.parse_main(&parser, argc, argv)
    cli.destroy(&parser)
    if (req.result.status != cli.ok) {
        cli_copy_message(&req.result, message, message_capacity)
        if (req.result.status == cli.usage_error) {
            return 2
        }
        return 1
    }
    cli_take_globals(req)
    req.out = cli_read_text(req, "output")
    if (chained != 0) {
        let token *char = (first >= 0) ? argv[first] : 0
        if (token == 0) {
            return 0
        }
        if (gen.cstr_eq(token, "build") != 0) {
            req.command = CLI_BUILD
            req.src = cli_read_text(req, "module")
        } else if (gen.cstr_eq(token, "check") != 0) {
            req.command = CLI_CHECK
            req.src = cli_read_text(req, "check_target")
        } else if (gen.cstr_eq(token, "run") != 0) {
            req.command = CLI_RUN
        } else if (gen.cstr_eq(token, "test") != 0) {
            req.command = CLI_TEST
            req.src = cli_read_text(req, "selector")
            req.list_mode = cli_read_flag(req, "list_mode")
            req.no_run = cli_read_flag(req, "no_run")
            req.filter = cli_read_text(req, "filter")
            req.timeout_secs = cli_read_i64(req, "timeout", 15).to_type(int)
        } else if (gen.cstr_eq(token, "list") != 0) {
            req.command = CLI_LIST
            req.resolve = cli_read_text(req, "resolve")
            req.has_resolve = (req.resolve != 0) ? 1 : 0
        } else {
            req.command = CLI_VERSION
            req.contracts = cli_read_flag(req, "contracts")
        }
        req.has_src = (req.src != 0) ? 1 : 0
        if (cli_read_links(req) != 0) {
            return 1
        }
        return 0
    }
    // 单文件形态
    req.src = cli_read_text(req, "file")
    req.has_src = (req.src != 0) ? 1 : 0
    let syntax int = cli_read_flag(req, "syntax_check")
    let asm int = cli_read_flag(req, "emit_asm")
    if (syntax != 0 && asm != 0) {
        return 2
    }
    if (syntax != 0) {
        req.file_mode = CLIFILE_SYNTAX
    } else if (asm != 0) {
        req.file_mode = CLIFILE_ASM
    } else if (req.out != 0) {
        req.file_mode = CLIFILE_EXE
    }
    if (req.file_mode == CLIFILE_NONE) {
        // 只有源文件、没有模式也没有 -o：对应旧实现 `n != 2` 的分支。
        return 2
    }
    if (req.file_mode != CLIFILE_EXE && req.out != 0) {
        return 2
    }
    if (req.file_mode == CLIFILE_EXE && req.out == 0) {
        return 2
    }
    req.command = CLI_FILE
    return 0
}

// release_request 释放请求持有的解析结果。
pub fn release_request(req *CliRequest) void {
    cli.release(&req.result)
}

// usage：输出用法说明（文件描述符 2）。逐行写入：单行最长约 80 字节，
// 远小于 256 缓冲；不可改回整段拼接——用法行会持续增加，总长曾超出
// 512 字节固定缓冲导致栈溢出。
pub fn usage() void {
    let buf [256]u8
    let n int = 0
    n = gen.append_str(buf, 0, "用法: yh --syntax-check <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh --emit-asm <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh -o <out> <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh build [-o out] [module] [--link 组名]... [--stats] 项目构建\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh check <file.yh>       检查单文件语义，不要求 main\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh check [module]         检查项目语义，不生成后端产物\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      --legacy-system          显式启用兼容 shell system(cmd) 接口\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      --target <triple>         选择完整输出目标（LLVM）\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh run [--link 组名]...      构建并运行 main 模块\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh version                   显示当前项目名与版本\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh version --contracts       显示产物契约版本（key=value）\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh list [--resolve name]     列出模块/解释导入绑定\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh test [模块|源文件] [--list] [--no-run] [--filter 子串] [--timeout 秒] [--emit-llvm]\n")
    gen.write_all(2, buf, n)
}

// is_yh_source：判断路径是否以用户源文件后缀 .yh 结尾。
pub fn is_yh_source(path *char) int {
    if (path == 0) { return 0 }
    let n int = 0
    for path[n] != 0 { n += 1 }
    return n >= 3 && path[n - 3] == '.' &&
        path[n - 2] == 'y' && path[n - 1] == 'h' ? 1 : 0
}

// is_removed_target_alias：判断是否是 LL12 已移除的目标简写别名。
// 保留旧诊断文本，避免把「简写不支持」误报成「未知 triple」。
pub fn is_removed_target_alias(target *char) int {
    if (gen.cstr_eq(target, "linux") != 0 || gen.cstr_eq(target, "gnu") != 0
        || gen.cstr_eq(target, "elf") != 0 || gen.cstr_eq(target, "darwin") != 0
        || gen.cstr_eq(target, "macho") != 0 || gen.cstr_eq(target, "macos") != 0) {
        return 1
    }
    return 0
}
