module support

// ============================================================================
// layout.yh —— struct/union 字段布局（从 gen/target.yh 下沉）
//
// 只读类型表与字段表（support.ms()），不回写全局：大小/对齐经出参返回，
// 调用方（gen.sem_struct_finish）自己写回类型行。因此 comptime 也能直接用。
// 规则：字段偏移向上取整到字段对齐；union 所有字段偏移 0、大小取最大字段；
// struct 大小向上取整到自身对齐。
// ============================================================================

pub fn model_layout_struct(first int, n int, is_union int,
    out_size *int, out_align *int) int {
    let off int = 0
    let maxal int = 1
    let maxsz int = 0
    let i int = 0
    for i < n {
        let ftid int = ms().fields[first + i].type_id
        let fsz int = ms().types[ftid].size
        let fal int = ms().types[ftid].align
        if (fal > maxal) {
            maxal = fal
        }
        if (is_union != 0) {
            ms().fields[first + i].offset = 0
        } else {
            // 向上取整到字段对齐
            let pad int = (0 - off) % fal
            if (pad < 0) {
                pad += fal
            }
            off += pad
            ms().fields[first + i].offset = off
            off += fsz
        }
        if (fsz > maxsz) {
            maxsz = fsz
        }
        i += 1
    }
    let size int = 0
    if (is_union != 0) {
        size = maxsz
    } else {
        size = off
    }
    // 结构体大小向上取整到自身对齐
    let rpad int = (0 - size) % maxal
    if (rpad < 0) {
        rpad += maxal
    }
    size += rpad
    out_size[0] = size
    out_align[0] = maxal
    return 0
}

