module support

// clock_ns：返回单调纳秒计数；调用失败时返回 0（与其它平台的容错一致）。
fn clock_ns_impl() u64 {
    let counter i64 = 0
    let frequency i64 = 0
    if (QueryPerformanceCounter(&counter) == 0) { return 0 }
    if (QueryPerformanceFrequency(&frequency) == 0) { return 0 }
    if (counter < 0 || frequency <= 0) { return 0 }
    let ticks u64 = counter.to_type(u64)
    let freq u64 = frequency.to_type(u64)
    let seconds u64 = ticks / freq
    let remainder u64 = ticks % freq
    return seconds * 1000000000.to_type(u64) +
        (remainder * 1000000000.to_type(u64)) / freq
}
