module support

// clock_ns：Windows/x64 宿主的单调时钟（W2-3a；与 clock.<os>.yh 同位置）。
//
// 用 QueryPerformanceCounter（内核提供的单调计数器）与 QueryPerformanceFrequency
// 换算纳秒；不用 GetTickCount64（毫秒精度不够看构建阶段耗时）。
//
// 换算顺序很重要：先做 秒=计数/频率、余=计数%频率，再算 ns，
// 避免 counter*1e9 在长时间运行后溢出 u64（10 MHz 计数器约 30 分钟就会溢出）。
@[extern] fn QueryPerformanceCounter(counter *i64) i32
@[extern] fn QueryPerformanceFrequency(frequency *i64) i32

// clock_ns：返回单调纳秒计数；调用失败时返回 0（与其它平台的容错一致）。
pub fn clock_ns() u64 {
    let counter i64 = 0
    let frequency i64 = 0
    if (QueryPerformanceCounter(&counter) == 0) { return 0 }
    if (QueryPerformanceFrequency(&frequency) == 0) { return 0 }
    if (counter < 0 || frequency <= 0) { return 0 }
    let ticks u64 = counter.to_type(u64)
    let freq u64 = frequency.to_type(u64)
    let seconds u64 = ticks / freq
    let remainder u64 = ticks % freq
    return seconds * 1000000000.to_type(u64) +
        (remainder * 1000000000.to_type(u64)) / freq
}
