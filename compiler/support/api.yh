module support

import errors

// ============================================================================
// api.yh —— support 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// ABIValue 描述已完成 C 布局的值。fp_count=1 表示浮点标量；聚合非零时
// 表示 HFA，fp_size 为同构元素宽度。普通聚合的 fp_count 必须为零。
pub struct ABIValue {
    size int
    align int
    aggregate int
    fp_size int
    fp_count int
}

// ABICursor 保存一份签名分配到当前参数前的状态。Darwin 的栈参数使用
// 自然大小与对齐，Linux 的每个槽至少八字节；最终调用区统一十六字节对齐。
pub struct ABICursor {
    gpr int
    fpr int
    stack int
    darwin int
}

// ABIArg 是单个逻辑参数/返回值的位置计划。寄存器片连续；stack 是调用时
// SP 起的字节偏移；indirect 表示按调用方副本地址传参或按 x8 返回。
pub struct ABIArg {
    kind int
    reg int
    count int
    stack int
    indirect int
    size int
    fp_size int
}

// SourceCtx：当前任务的源文件字节与路径快照。
// data/length 由 source.read 分配并持有到任务结束；path 指向 path_buf 内部，
// path_buf 扩容后必须重新取 path（set_source_path 负责）。
pub struct SourceCtx {
    data *u8 // 源文件字节（malloc；任务生命期持有）
    length int // 源字节长度（不含额外 NUL）
    path *char // 当前源路径（指向 path_buf，不单独分配）
    path_buf *u8 // 路径快照缓冲（堆分配倍增扩容）
    path_buf_cap int // 路径快照容量
}

// PoolCtx：通用名字/字符串 intern 池。符号名、类型名、模块名、路径都放这里；
// 表内只存池偏移与长度。池内字节带 NUL 结尾，便于调试与 np_cstr。
pub struct PoolCtx {
    data *u8 // intern 池（malloc；倍增扩容）
    length int // 已用字节数（含每个名字的结尾 NUL）
    cap int // 已分配容量
}

// TargetInfo：完整代码生成目标身份；字符串借用编译器静态常量，不拥有堆内存。
pub struct TargetInfo {
    triple *char
    data_layout *char
    os int
    arch int
    abi *char
    pointer_bits int
    little_endian int
    layout_version int
}

// TargetCfg：目标/编译期配置；实体存储在 proj.ProjectCtx.cfg，support 只持指针。
// 字段顺序是 ABI/缓存键的一部分，不重排。
pub struct TargetCfg {
    target TargetInfo
    host_target TargetInfo
    target_explicit int
    dialect int
    opt_level int
    trimpath int
    emit_kind int
    emit_asm int
    emit_text_path *char
    module_mode int
    is_entry_mod int
}

// SessionCtx：一次编译/构建的会话开关与模式位。
// 这些开关由 driver/worker 设置、前端与构建层只读；不随函数重置。
pub struct SessionCtx {
    compile int // 0 = 纯语法模式（--syntax-check）；1 = 编译模式
    pass int // 1 = 顶层扫描登记；2 = 函数体编译与全局初始化
    check_only int // 1 = 项目 check 模式，只做语义检查，不生成后端产物
    test_mode int // 1 = yh test 模式；解析测试体语义并跳过生产缓存
    legacy_system int // 1 = 兼容配置显式开放 system
    ast_capture int // 1 = worker 同遍历记录表达式、语句和声明 AST
    syntax_ast int // 1 = 纯语法 AST 解析模式（S4-2 地基，内部开关）
    active_file int // 当前前端快照文件编号，AST 源映射使用
    data_label int // 匿名数据标签计数（字符串字面量）；0 保留为 NULL
    front_checked int // 1：受检前端阶段（front_stage.yh 唯一读写点）
    iface_load int // 1：正在加载接口文件（登记不发射、不进 bss）
    ct_iface_mode int // 1：正在读取 .s.ct（识别生成的来源映射注释）
    ct_origin_active int // 1：当前声明从 .s.ct 来源映射切换到定义源码
    ct_origin_line int // 当前 CT 函数定义源码体起始行
}

// BuildCtl：构建/发射的控制位（与统计无关的开关与身份）。
// front_cache：worker 保存项目源与 token 快照；firc_write_off：本轮不写函数级
// IR 缓存（全冷构建）；ir_cache_salt：父构建器传入的编译器二进制指纹。
pub struct BuildCtl {
    front_cache int
    firc_write_off int
    ir_cache_salt u64
}

// SupportCtx：support 的单例。把统计/源/名字池收在一个结构里，
// 避免每类状态各占一个模块级 `let`；新增基础状态加到本结构。
pub struct SupportCtx {
    ctl BuildCtl
    src SourceCtx
    pool PoolCtx
    session SessionCtx
    cfg *TargetCfg
    fallback TargetCfg
}

pub struct ImportEnt {
    name_off int       // 查找名（模块名）名字池偏移；点分导入时为末段
    name_len int
    path_off int       // 完整点分原文（a.b.c）名字池偏移；用于目录路径解析
    path_len int
    proj_key_off int   // 跨项目导入首段的依赖键池偏移；不适用时 -1
    proj_key_len int
    alias_off int      // 绑定名（限定调用用的标识符）池偏移
    alias_len int
    line int           // 1 基行号（诊断用）
    col int            // 1 基列号
}

// ModNsEnt：已加载接口的一个导出名字条目。
// sym/type_id 恰有一个 >= 0：值/函数/常量走 sym，纯类型名走 type_id。
pub struct ModNsEnt {
    name_off int       // 短名（源码名）名字池偏移
    name_len int
    sym int            // 值/函数/常量符号下标；纯类型名为 -1
    tid int            // 类型编号（类型名条目）；值条目 -1
}

// ModInfo：一个已绑定导入模块（每份接口一条，含导出名字表）。
pub struct ModInfo {
    bind_off int       // 绑定名（=模块名）池偏移
    bind_len int
    prefix_off int     // 接口头宣布的符号后缀（__proj__mod）池偏移
    prefix_len int
    home int           // 模块编号（ms().home 归属标记用）
    ns *ModNsEnt       // 导出名字表（堆分配）
    ns_n int
    ns_cap int
}

// FileScope：单文件的模块归属 + 导入表 + 已加载接口集合。
// 生命周期 = 一个编译单元（换文件时 fscope_reset），堆缓冲由导入推送路径扩容。
pub struct FileScope {
    has_module int // 1 = 文件带 module 归属声明（模块模式）
    name_off int // 模块名名字池偏移（has_module 时有效）
    name_len int
    imports *ImportEnt // 本文件导入表（堆分配，import_push 扩容）
    import_n int
    import_cap int
    import_mod *int // 与 imports 平行：导入绑定的 ModInfo 下标
    import_used *int // 与 imports 平行：本文件是否用到该导入
    mods *ModInfo // 当前编译单元已加载的导入模块
    mod_n int
    mod_cap int
    mod_home_next int // 下一个模块编号（home 分配计数）
    sym_sfx_off int // 本模块符号后缀（__proj__mod）池偏移；单文件 -1
    sym_sfx_len int
}

// Res：一次表达式求值的结果描述符（类型、常量性、字面量与编译期诊断）。
// 语义动作边解析边求值，每个表达式节点通过 *Res 出参返回。
// 约定：is_const=1 时 ival 有效（按 i64 位型；指针常量存数据标签号）。
pub struct Res {
    type_id int        // 类型表编号（<0 不出现；错误走函数返回值）
    is_const int       // 1 = 编译期常量
    ival i64           // 常量位型值；字符串/指针常量存数据标签号
    sym int            // 裸名字引用时的符号表下标，否则 -1（直接调用优化用）
    is_lit int         // 1 = 文本字面量（参与隐式窄化范围检查）
    lit_big int        // 1 = 字面量超出 i64 正数域（仅 u64 目标可接受）
    fval_bits i64      // 浮点常量位型（IEEE754，f64 为 64 位）
    ast_id int         // 本次 check 生成的表达式 AST 节点编号；未记录为 -1
    layout_type_id int // 延迟 sizeof 的目标类型；普通表达式为 -1
    ct_diag int        // 非零表示该表达式是待语句位置消费的编译期诊断
    ct_diag_expr int   // $assert 的已解析条件表达式 AST 编号；其他诊断为 -1
    ct_diag_line int   // 诊断调用起始行
    ct_diag_col int    // 诊断调用起始列
    ct_diag_msg_start int // 消息字符串 token 在源文件中的起点；-1 表示默认消息
    ct_diag_msg_len int // 消息字符串 token 长度
}

// CType：类型表的一行。内建类型占固定编号 0..12（TY_VOID..TY_F64），
// 其后按需增长并按内容去重。
pub struct CType {
    kind int           // TY_* 种类
    size int           // 字节大小
    align int          // 字节对齐
    elem int           // PTR：目标类型；ARRAY/SLICE：元素类型
    len int            // ARRAY：长度；STRUCT/UNION：字段数；其余 -1
    sub int            // STRUCT/UNION：字段表起始下标；FN：签名号
}

// SField：结构体/联合体字段表的一行。
pub struct SField {
    name_off int       // 名字池偏移
    name_len int
    type_id int
    offset int         // 相对结构体起始的字节偏移
    is_pub int         // 恒 1（pub struct 字段一律公开）；保留以稳定 .s.i 接口格式
}

// CSym：值符号表（全局/局部/参数/函数）的一行。
pub struct CSym {
    name_off int       // 名字池偏移
    name_len int
    kind int           // SYM_*
    type_id int
    offset int         // 局部/参数：距 fp 的字节距离（地址 = fp - offset）；
                        // 全局：bss 清单下标（数据见 flags）
    flags int          // F_*
    cval i64           // 常量值位型；指针常量存数据标签号
    const_ready int    // 1 = cval 已由声明初始化，可参与编译期求值
    const_expr_off int // 可重放的直接常量字面式在名字池中的偏移；其他常量为 -1。
    const_expr_len int // 可重放常量字面式字节长度。
    const_expr_kind int // 0=无 1=浮点数字面式 2=字符串字面式。
    def_line int       // 声明点行号（模块模式重复声明诊断用）
    def_col int        // 声明点列号
    ast_binding_row int // check AST 中对应的函数内绑定行；普通构建或全局为 -1
}

// TName：类型名字空间的一行（struct/union/enum/type 别名，仅顶层声明）。
// 与 CType 平行：名字池偏移 + 类型编号 + 后端再发射所需的形态/属性/声明点。
pub struct TName {
    name_off int       // 名字池偏移
    name_len int
    type_id int
    is_pub int         // 1 = pub 类型（接口导出）
    form int           // 0=type 别名 1=struct 2=union 3=enum（接口再发射用）
    attrs int          // ATTR_*：具名类型属性（别名目标属性由类型本身保留）
    def_line int       // 声明点行号（重定义诊断用）
    def_col int
}

// PubAggDeferred：导入侧延迟执行的 pub 聚合常量（$ 调用初始化）登记项。
// .s.i 先于 .s.ct 加载，调用目标（隐藏符号）在 .s.ct 里才可见，因此把
// 初始化式执行推迟到接口闭包加载完成之后；path 存 .s.i 路径，执行时
// 重新读源与词法化后按 token 区间解析。
pub struct PubAggDeferred {
    sym int            // 常量符号编号
    first int          // 初始化式 token 区间起点
    after int          // 初始化式 token 区间终点（半开）
    path_off int       // 接口文件路径（pool 偏移），0 表示无
    path_len int
}

// —— goto 标签表（每函数重置） ——
pub struct GLabel {
    name_off int       // 名字池偏移
    name_len int
    lbl int            // 汇编标签号
    defined int        // 1 = 已见定义点
}

// ModelStore：前端语义表的全部存储。
// 生命周期 = 一个编译任务（state_init 时整体清零，释放旧缓冲）。
pub struct ModelStore {
    // —— 类型表（TY_*；内建类型占 0..12）——
    types *CType
    type_n int
    type_cap int
    // —— 结构体/联合体字段表 ——
    fields *SField
    field_n int
    field_cap int
    // —— 函数签名表（FN 类型通过 sub 引用签名号）——
    sig_abi *int // 调用约定，参与函数类型判等
    sig_acap int // ABI 表容量
    sig_ret *int // 返回类型
    sig_np *int // 固定参数个数
    sig_vararg *int // 1 = 末尾裸变参（仅 prelude）
    sig_first *int // 参数类型池起始下标
    sig_params *int // 参数类型池
    sig_n int
    sig_rcap int
    sig_ncap int
    sig_vcap int
    sig_fcap int
    sigparam_n int
    sigparam_cap int
    // —— 类型名字空间（struct/union/enum/type 别名）——
    names *TName
    name_n int
    name_cap int
    // —— 聚合类型登记上限计数（方案 §4）——
    aggtype_n int
    // —— 正在解析的类型（parse/check 共享的「当前位置」）——
    cur_enum int // 正在解析的 enum 类型编号
    cur_struct int // 正在解析的 struct/union 类型编号
    name_form int // 当前类型登记形态：0=type 别名 1=struct 2=union 3=enum
    // —— 类型归属（跨模块 pub 字段检查；与 types 平行）——
    home *int
    home_cap int
    // —— 符号表与作用域栈 ——
    syms *CSym
    sym_n int
    sym_cap int
    scope_start *int // 每层作用域进入时的符号表下标（64 层）
    scope_n int
}

// StaticDataReloc：独占数据中的一个 64 位指针槽；目标是前端符号或数据标签。
// target_sym/target_label 恰有一个有效，addend 按目标布局计字节；槽内始终为零。
pub struct StaticDataReloc {
    offset int
    width int
    target_sym int
    target_label int
    addend i64
}

// StaticDataObject：编译单元独占的已物化字节和重定位，不含 CT 执行器地址。
// type_id>=0 表示受检对象；-1 表示以 elem_type/count 描述的匿名 backing。
// 导入副本可同时保留 sym_id 和 label；访问器返回的指针只借用到替换或 reset。
pub struct StaticDataObject {
    sym_id int
    label int
    type_id int
    elem_type int
    count int
    size int
    align int
    data *u8
    relocs *StaticDataReloc
    reloc_n int
}

// FrontCtx：前端每任务瞬时状态。字段语义见各自行尾注释。
pub struct FrontCtx {
    c_ct_origin_buf *u8 // [任务私有] .s.ct 来源映射解码路径（堆分配倍增扩容），独立于 sidecar 路径
    c_ct_origin_buf_cap int // 来源映射路径缓冲容量；同样任务生命期持有
    c_fold int // >0：表达式只做常量折叠，不发射代码
    c_ct_target_ctx int // >0：当前正解析 $if 条件，目标标记按内建常量解析
    c_ct_diag_stmt int // >0：当前完整表达式语句可消费编译期诊断结果
    c_ct_prepare_active int // >0：当前正在 pass2a 前捕获 comptime 函数 typed IR
    c_ct_prepare_first int // 当前待捕获编译期函数在文件 token 表中的起点
    c_pub_agg_dep *PubAggDeferred // 导入侧延迟执行的 pub $ 聚合常量登记表
    c_pub_agg_dep_n int
    c_pub_agg_dep_cap int
    c_expect_tid int // 数组/切片字面量的目标类型（let 初始化/赋值上下文）
    c_bss_syms *int // 零初始化全局符号的 sym 下标清单（.bss）
    c_bss_n int
    c_fn_ret int // 当前函数返回类型
    c_fn_flags int // 当前函数声明属性；旧发射与控制流检查共享
    c_fn_falls int // 当前解析路径仍可能顺序落底
    c_expr_noreturn int // 当前语句表达式中是否已执行 noreturn 调用
    c_fn_sym int // 当前函数的符号下标（prologue 用名字）
    c_fp_off int // 当前栈帧已分配字节数（局部/参数/临时累计）
    c_temp_off int // 通用临时槽的 fp 距离（0 = 未分配）
    c_loop_brk int // 当前循环 break 目标标签号
    c_loop_cnt int // 当前循环 continue 目标标签号
    c_loop_depth int // 循环嵌套深度（栈顶 = c_loop_brk/cnt）
    c_loop_break_seen *int // 各循环是否含有 break，用于 noreturn 无限循环检查
    c_spill_reg *int // 参数溢出记录（寄存器号），堆分配 16 项
    c_spill_off *int // 参数溢出记录（槽偏移），堆分配 16 项
    c_spill_n int
    c_spill_size *int // 溢出槽的类型（浮点判定；0 = 整型/指针）
    c_fp_argn int // 浮点参数计数（独立于整型寄存器序）
    c_lvalue int // >0：解析赋值目标，地址型钩子发地址不发值
    c_res_is_addr int // 刚解析的表达式在 x0 中留下的是地址（可赋值）
    c_call_abi *int // 每层调用约定，聚合在求值时生成独立 C 副本
    c_call_direct *int // 每层调用是否直接调用（callee 是裸函数名），堆分配 64 项
    c_enum_next int // enum 成员的自动判别值
    c_args *Res // 当前调用的实参 Res（堆分配 256 项，嵌套共享）
    c_argtys *int // 当前调用的实参类型（堆分配 256 项）
    c_arg_n int // 已收集的实参总数（嵌套调用以基线区分）
    c_call_base *int // 每层调用的实参起始下标（堆分配 64 项）
    c_call_depth int // 当前调用嵌套深度
    c_arg_agg *int // 每个实参是否为聚合（堆分配 256 项）
    c_ret_agg int // 当前函数返回聚合（x8 隐藏指针）
    c_ret_ptr_off int // 当前函数保存 x8 入参指针的槽（0 = 未用）
    c_ret_agg_val int // 1 = 本函数已为聚合返回准备好 x0
    c_fp_tmp_off int // 浮点复合赋值的右值临时槽  // 调用聚合返回函数时的调用方缓冲槽
    c_lit_off int // 结构体字面量临时槽（fp 距离）
    c_lit_tid int // 结构体字面量目标类型
    c_lit_last_type int // 字面量字段最近一次求值的类型/字面量性
    c_lit_last_lit int
    c_lit_last_ival i64
    c_lit_depth int // 字面量嵌套深度
    c_lit_save_off *int // 外层字面量槽（堆分配 32 项）
    c_lit_save_tid *int // 外层字面量类型（堆分配 32 项）
    c_aggparam_indirect *int // 1 表示源槽保存指针，0 表示源是栈内聚合
    c_cabi_cursor ABICursor // 当前 C 函数入口的参数分类游标
    c_aggparam_n int // 聚合参数入口拷贝任务数
    c_aggparam_src *int // 指针槽（堆分配 64 项）
    c_aggparam_dst *int // 体型槽（堆分配 64 项）
    c_aggparam_size *int // 字节数（堆分配 64 项）
    c_decl_pub int // 当前顶层声明是否带 pub
    c_decl_attrs int // 当前顶层声明属性位（ATTR_*）
    c_fold_ival i64 // 最近一次数字字面量的位型值
    c_fold_big int // 1 = 字面量超出 i64 正数域
    sc_lbl_false int
    sc_lbl_end int
    sc_sc_false_stk *int // 嵌套短路标签或折叠左值保存栈（堆分配 64 项）
    sc_sc_end_stk *int
    sc_sc_depth int
    tn_lbl_else int
    tn_lbl_end int
    tn_else_stk *int // 嵌套三元标签保存栈（堆分配 64 项）
    tn_end_stk *int
    tn_depth int
    c_glabels *GLabel // goto 标签表（堆分配 128 项）
    c_glabel_n int
    c_fi_kind *int // 0=数组/切片（按元素地址），1=区间（按下标）
    c_fi_cnt_off *int // 循环计数槽（fp 距离）
    c_fi_len_off *int // 长度槽（fp 距离）
    c_fi_data_off *int // 数据/区间起点槽（fp 距离）
    c_fi_step_off *int // 区间步长槽（+1/-1）
    c_fi_elem_off *int // 元素/下标绑定槽（fp 距离，-1 未绑定）
    c_fi_idx_off *int // 下标绑定槽（fp 距离，-1 未绑定）
    c_fi_depth int
    c_end_tmp_off int // 区间终点临时槽（for-in 区间用）
    c_brk_stk *int
    c_cnt_stk *int
}

// res_reset：Res 的纯字段清零（type_id 置为 tid，其余回到"未记录"初值）。
// 与 Res 同层定义，check.sem_res_reset 委托到此处；parse 的纯语法模式
// （syntax_ast）也用它清结果，避免 parse 对 check 的仅重置引用。
pub fn res_reset(r *Res, tid int) int {
    r.type_id = tid
    r.is_const = 0
    r.ival = 0
    r.sym = -1
    r.is_lit = 0
    r.lit_big = 0
    r.fval_bits = 0
    r.ast_id = -1
    r.layout_type_id = -1
    r.ct_diag = 0
    r.ct_diag_expr = -1
    r.ct_diag_line = 0
    r.ct_diag_col = 0
    r.ct_diag_msg_start = -1
    r.ct_diag_msg_len = 0
    return 0
}

