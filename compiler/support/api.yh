// 与 token/base.yh 的历史编号必须一致：.s.i/.s.ct 与缓存键都按这些数编码。
pub const TK_PLUS int = 64

pub const TK_MINUS int = 65

pub const TK_STAR int = 66

pub const TK_SLASH int = 67

pub const TK_PERCENT int = 68

pub const TK_AMP int = 69

pub const TK_PIPE int = 70

