module support

import errors

// ============================================================================
// api.yh —— support 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// support 现只此一个文件：基础设施（缓冲/名字池/源/会话/目标）、诊断转发、
// 前端共享态（Res/FrontCtx/ModuleSym）。语义表与值规则在 table；文件作用域在
// proj；诊断实现在 errors。本文件不 import table/proj（保持底座无环）。
// ============================================================================

// C ABI 分类结构（ABIValue/ABICursor/ABIArg）与 CABI_* 种类常量已迁到 check
// （ADR-0024，check/api.yh）；只有 check/abi_c 消费它们。

// SourceCtx：当前任务的源文件字节与路径快照。
// data/length 由 source.read 分配并持有到任务结束；path 指向 path_buf 内部，
// path_buf 扩容后必须重新取 path（set_source_path 负责）。
pub struct SourceCtx {
    data *u8 // 源文件字节（malloc；任务生命期持有）
    length int // 源字节长度（不含额外 NUL）
    path *char // 当前源路径（指向 path_buf，不单独分配）
    path_buf *u8 // 路径快照缓冲（堆分配倍增扩容）
    path_buf_cap int // 路径快照容量
}

// PoolCtx：通用名字/字符串 intern 池。符号名、类型名、模块名、路径都放这里；
// 表内只存池偏移与长度。池内字节带 NUL 结尾，便于调试与 np_cstr。
pub struct PoolCtx {
    data *u8 // intern 池（malloc；倍增扩容）
    length int // 已用字节数（含每个名字的结尾 NUL）
    cap int // 已分配容量
}

// TargetInfo：完整代码生成目标身份；字符串借用编译器静态常量，不拥有堆内存。
pub struct TargetInfo {
    triple *char
    data_layout *char
    os int
    arch int
    abi *char
    pointer_bits int
    little_endian int
    layout_version int
}

// TargetCfg：目标/编译期配置；实体存储在 proj.ProjectCtx.cfg，support 只持指针。
// 字段顺序是 ABI/缓存键的一部分，不重排。
pub struct TargetCfg {
    target TargetInfo
    host_target TargetInfo
    target_explicit int
    dialect int
    opt_level int
    trimpath int
    emit_kind int
    emit_asm int
    emit_text_path *char
    module_mode int
    is_entry_mod int
}

// SessionCtx：一次编译/构建的会话开关与模式位。
// 这些开关由 driver/worker 设置、前端与构建层只读；不随函数重置。
pub struct SessionCtx {
    compile int // 0 = 纯语法模式（--syntax-check）；1 = 编译模式
    pass int // 1 = 顶层扫描登记；2 = 函数体编译与全局初始化
    check_only int // 1 = 项目 check 模式，只做语义检查，不生成后端产物
    test_mode int // 1 = yh test 模式；解析测试体语义并跳过生产缓存
    legacy_system int // 1 = 兼容配置显式开放 system
    ast_capture int // 1 = worker 同遍历记录表达式、语句和声明 AST
    syntax_ast int // 1 = 纯语法 AST 解析模式（S4-2 地基，内部开关）
    active_file int // 当前前端快照文件编号，AST 源映射使用
    data_label int // 匿名数据标签计数（字符串字面量）；0 保留为 NULL
    front_checked int // 1：受检前端阶段（front_stage.yh 唯一读写点）
    iface_load int // 1：正在加载接口文件（登记不发射、不进 bss）
    ct_iface_mode int // 1：正在读取 .s.ct（识别生成的来源映射注释）
    ct_origin_active int // 1：当前声明从 .s.ct 来源映射切换到定义源码
    ct_origin_line int // 当前 CT 函数定义源码体起始行
}

// BuildCtl：构建/发射的控制位（与统计无关的开关与身份）。
// front_cache：worker 保存项目源与 token 快照；firc_write_off：本轮不写函数级
// IR 缓存（全冷构建）；ir_cache_salt：父构建器传入的编译器二进制指纹。
pub struct BuildCtl {
    front_cache int
    firc_write_off int
    ir_cache_salt u64
}

// ModuleSym：当前模块的符号后缀（__proj__mod）。构建 worker 从 ModuleJob 写入，
// 接口发射与受检快照读取；单文件模式为 -1/0。2026-11-10 自 FileScope 拆出
// （FileScope 归 proj，符号后缀是模块构建态，不是文件作用域）。
pub struct ModuleSym {
    off int
    len int
}

// msym：模块符号后缀的窄口。
pub fn msym() *ModuleSym {
    return &g_support.sym
}

// SupportCtx：support 的单例。把统计/源/名字池收在一个结构里，
// 避免每类状态各占一个模块级 `let`；新增基础状态加到本结构。
pub struct SupportCtx {
    ctl BuildCtl
    src SourceCtx
    pool PoolCtx
    session SessionCtx
    sym ModuleSym
    cfg *TargetCfg
    fallback TargetCfg
}

// g_support：进程内唯一的 support 状态（零初始化）。
// 生命周期 = 进程级；fork worker 通过 COW 继承，各自写自己的副本。
let g_support SupportCtx

// FileScope / ImportEnt / ModNsEnt / ModInfo 定义在 proj 模块（2026-11-10 迁出，
// ADR-0024）；support 不再持有文件作用域数据。

// Res：一次表达式求值的结果描述符（类型、常量性、字面量与编译期诊断）。
// 语义动作边解析边求值，每个表达式节点通过 *Res 出参返回。
// 约定：is_const=1 时 ival 有效（按 i64 位型；指针常量存数据标签号）。
pub struct Res {
    type_id int        // 类型表编号（<0 不出现；错误走函数返回值）
    is_const int       // 1 = 编译期常量
    ival i64           // 常量位型值；字符串/指针常量存数据标签号
    sym int            // 裸名字引用时的符号表下标，否则 -1（直接调用优化用）
    is_lit int         // 1 = 文本字面量（参与隐式窄化范围检查）
    lit_big int        // 1 = 字面量超出 i64 正数域（仅 u64 目标可接受）
    fval_bits i64      // 浮点常量位型（IEEE754，f64 为 64 位）
    ast_id int         // 本次 check 生成的表达式 AST 节点编号；未记录为 -1
    layout_type_id int // 延迟 sizeof 的目标类型；普通表达式为 -1
    ct_diag int        // 非零表示该表达式是待语句位置消费的编译期诊断
    ct_diag_expr int   // $assert 的已解析条件表达式 AST 编号；其他诊断为 -1
    ct_diag_line int   // 诊断调用起始行
    ct_diag_col int    // 诊断调用起始列
    ct_diag_msg_start int // 消息字符串 token 在源文件中的起点；-1 表示默认消息
    ct_diag_msg_len int // 消息字符串 token 长度
}

// types.CType/types.SField：类型表与字段表行定义在 types 模块（types.CType/types.SField）。
// 本模块只持有 ModelStore 存储实例并提供增删与布局操作。

// CSym：值符号表（全局/局部/参数/函数）的一行。

// types.TName 定义在 types 模块（types.TName）；ModelStore 的 names 表持有实例。

// PubAggDeferred：导入侧延迟执行的 pub 聚合常量（$ 调用初始化）登记项。
// .s.i 先于 .s.ct 加载，调用目标（隐藏符号）在 .s.ct 里才可见，因此把
// 初始化式执行推迟到接口闭包加载完成之后；path 存 .s.i 路径，执行时
// 重新读源与词法化后按 token 区间解析。
pub struct PubAggDeferred {
    sym int            // 常量符号编号
    first int          // 初始化式 token 区间起点
    after int          // 初始化式 token 区间终点（半开）
    path_off int       // 接口文件路径（pool 偏移），0 表示无
    path_len int
}

// —— goto 标签表（每函数重置） ——
pub struct GLabel {
    name_off int       // 名字池偏移
    name_len int
    lbl int            // 汇编标签号
    defined int        // 1 = 已见定义点
}

// ModelStore：前端语义表的全部存储。
// 生命周期 = 一个编译任务（state_init 时整体清零，释放旧缓冲）。

// FrontCtx：前端每任务瞬时状态。字段语义见各自行尾注释。
pub struct FrontCtx {
    c_ct_origin_buf *u8 // [任务私有] .s.ct 来源映射解码路径（堆分配倍增扩容），独立于 sidecar 路径
    c_ct_origin_buf_cap int // 来源映射路径缓冲容量；同样任务生命期持有
    c_fold int // >0：表达式只做常量折叠，不发射代码
    c_ct_target_ctx int // >0：当前正解析 $if 条件，目标标记按内建常量解析
    c_ct_diag_stmt int // >0：当前完整表达式语句可消费编译期诊断结果
    c_ct_prepare_active int // >0：当前正在 pass2a 前捕获 comptime 函数 typed IR
    c_ct_prepare_first int // 当前待捕获编译期函数在文件 token 表中的起点
    c_pub_agg_dep *PubAggDeferred // 导入侧延迟执行的 pub $ 聚合常量登记表
    c_pub_agg_dep_n int
    c_pub_agg_dep_cap int
    c_expect_tid int // 数组/切片字面量的目标类型（let 初始化/赋值上下文）
    c_bss_syms *int // 零初始化全局符号的 sym 下标清单（.bss）
    c_bss_n int
    c_fn_ret int // 当前函数返回类型
    c_fn_flags int // 当前函数声明属性；旧发射与控制流检查共享
    c_fn_falls int // 当前解析路径仍可能顺序落底
    c_expr_noreturn int // 当前语句表达式中是否已执行 noreturn 调用
    c_fn_sym int // 当前函数的符号下标（prologue 用名字）
    c_fp_off int // 当前栈帧已分配字节数（局部/参数/临时累计）
    c_loop_brk int // 当前循环 break 目标标签号
    c_loop_cnt int // 当前循环 continue 目标标签号
    c_loop_depth int // 循环嵌套深度（栈顶 = c_loop_brk/cnt）
    c_loop_break_seen *int // 各循环是否含有 break，用于 noreturn 无限循环检查
    c_spill_reg *int // 参数溢出记录（寄存器号），堆分配 16 项
    c_spill_off *int // 参数溢出记录（槽偏移），堆分配 16 项
    c_spill_n int
    c_spill_size *int // 溢出槽的类型（浮点判定；0 = 整型/指针）
    c_fp_argn int // 浮点参数计数（独立于整型寄存器序）
    c_lvalue int // >0：解析赋值目标，地址型钩子发地址不发值
    c_res_is_addr int // 刚解析的表达式在 x0 中留下的是地址（可赋值）
    c_call_abi *int // 每层调用约定，聚合在求值时生成独立 C 副本
    c_call_direct *int // 每层调用是否直接调用（callee 是裸函数名），堆分配 64 项
    c_enum_next int // enum 成员的自动判别值
    c_args *Res // 当前调用的实参 Res（堆分配 256 项，嵌套共享）
    c_argtys *int // 当前调用的实参类型（堆分配 256 项）
    c_arg_n int // 已收集的实参总数（嵌套调用以基线区分）
    c_call_base *int // 每层调用的实参起始下标（堆分配 64 项）
    c_call_depth int // 当前调用嵌套深度
    c_arg_agg *int // 每个实参是否为聚合（堆分配 256 项）
    c_ret_agg int // 当前函数返回聚合（x8 隐藏指针）
    c_ret_ptr_off int // 当前函数保存 x8 入参指针的槽（0 = 未用）
    c_ret_agg_val int // 1 = 本函数已为聚合返回准备好 x0
    c_fp_tmp_off int // 浮点复合赋值的右值临时槽  // 调用聚合返回函数时的调用方缓冲槽
    c_lit_last_type int // 字面量字段最近一次求值的类型/字面量性
    c_lit_last_lit int
    c_lit_last_ival i64
    c_lit_depth int // 字面量嵌套深度
    c_aggparam_indirect *int // 1 表示源槽保存指针，0 表示源是栈内聚合
    c_aggparam_n int // 聚合参数入口拷贝任务数
    c_aggparam_src *int // 指针槽（堆分配 64 项）
    c_aggparam_dst *int // 体型槽（堆分配 64 项）
    c_aggparam_size *int // 字节数（堆分配 64 项）
    c_decl_pub int // 当前顶层声明是否带 pub
    c_decl_attrs int // 当前顶层声明属性位（ATTR_*）
    c_fold_ival i64 // 最近一次数字字面量的位型值
    c_fold_big int // 1 = 字面量超出 i64 正数域
    tn_depth int
    c_glabels *GLabel // goto 标签表（堆分配 128 项）
    c_glabel_n int
    c_fi_depth int
    c_end_tmp_off int // 区间终点临时槽（for-in 区间用）
    c_brk_stk *int
    c_cnt_stk *int
}

// g_front：前端每任务状态单例（worker 进程内一份）。
// FrontCtx 的字段描述「当前正在编译哪个函数体的哪个位置」（函数体游标、调用
// 实参收集、字面量临时槽、for-in 槽位、短路/三元标签栈、溢出槽等）。parse 写、
// check 读写、ast/token 也读，而 parse 依赖 check，收在 support 是唯一无环的选择。
// 生命周期 = 一个编译单元/函数（session_reset 清零，函数开始处按需重置）。
let g_front FrontCtx

// res_reset：Res 的纯字段清零（type_id 置为 tid，其余回到"未记录"初值）。
// 与 Res 同层定义，check.sem_res_reset 委托到此处；parse 的纯语法模式
// （syntax_ast）也用它清结果，避免 parse 对 check 的仅重置引用。
pub fn res_reset(r *Res, tid int) int {
    r.type_id = tid
    r.is_const = 0
    r.ival = 0
    r.sym = -1
    r.is_lit = 0
    r.lit_big = 0
    r.fval_bits = 0
    r.ast_id = -1
    r.layout_type_id = -1
    r.ct_diag = 0
    r.ct_diag_expr = -1
    r.ct_diag_line = 0
    r.ct_diag_col = 0
    r.ct_diag_msg_start = -1
    r.ct_diag_msg_len = 0
    return 0
}

// res_copy：把语义结果整块复制到目标（纯字段拷贝，不含任何语义动作）。
// 与 res_reset 同层：只读写 Res 字段，因此 parse 侧不需要为了复制一个结果
// 反向依赖 check。
pub fn res_copy(dst *Res, src *Res) int {
    dst.type_id = src.type_id
    dst.is_const = src.is_const
    dst.ival = src.ival
    dst.sym = src.sym
    dst.is_lit = src.is_lit
    dst.lit_big = src.lit_big
    dst.fval_bits = src.fval_bits
    dst.ast_id = src.ast_id
    dst.layout_type_id = src.layout_type_id
    dst.ct_diag = src.ct_diag
    dst.ct_diag_expr = src.ct_diag_expr
    dst.ct_diag_line = src.ct_diag_line
    dst.ct_diag_col = src.ct_diag_col
    dst.ct_diag_msg_start = src.ct_diag_msg_start
    dst.ct_diag_msg_len = src.ct_diag_msg_len
    return 0
}

// ctl：构建控制位窄口；返回单例中的 ctl 指针。
pub fn ctl() *BuildCtl {
    return &g_support.ctl
}

// src_ctx：源文件上下文窄口；返回单例中的 src 指针。
pub fn src_ctx() *SourceCtx {
    return &g_support.src
}

// pool_ctx：名字池上下文窄口；返回单例中的 pool 指针。
pub fn pool_ctx() *PoolCtx {
    return &g_support.pool
}

// session：会话开关窄口；返回单例中的 session 指针。
pub fn session() *SessionCtx {
    return &g_support.session
}

// data_label：当前可用的下一个标签号。
pub fn data_label() int {
    return g_support.session.data_label
}

// data_label_advance：取当前标签号并推进一位（返回分配到的标签）。
pub fn data_label_advance() int {
    let lbl int = g_support.session.data_label
    g_support.session.data_label += 1
    return lbl
}

// data_label_set：把计数器设到 v（跳号/回滚用）。
pub fn data_label_set(v int) void {
    g_support.session.data_label = v
}

// data_label_reset：会话开始复位（0 保留给 NULL）。
pub fn data_label_reset() void {
    g_support.session.data_label = 1
}

// append_byte：向 buf 的 n 处写入一个字节，返回新的写入位置。
// 仅用于栈上小缓冲（诊断消息拼装），不做容量检查——调用方保证空间。
pub fn append_byte(buf *u8, n int, b u8) int {
    buf[n] = b
    return n + 1
}

// append_str：向 buf 追加一个 NUL 结尾字符串（不含结尾 NUL），返回新位置。
// 不做容量检查；调用方必须保证 buf 至少还有 cstr_len(s) 字节。
pub fn append_str(buf *u8, n int, s *char) int {
    let i int = 0
    for s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// cstr_len：C 字符串长度（不含结尾 NUL）。
// 接口头行等固定前缀用它代替手写字节数常量，避免字面量与长度常量漂移。
pub fn cstr_len(s *char) int {
    let i int = 0
    for s[i] != 0 {
        i += 1
    }
    return i
}

// append_str_limit：向 buf 追加字符串，最多写到 limit 之前，返回新位置。
// 用于包含源代码消息的诊断拼装，避免长输入写出固定缓冲区边界。
pub fn append_str_limit(buf *u8, n int, limit int, s *char) int {
    let i int = 0
    for s[i] != 0 && n < limit {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// append_int：向 buf 追加十进制整数（含负号），返回新位置。
// 行号/列号规模远小于 2^31，不处理 INT_MIN 取负溢出。
pub fn append_int(buf *u8, n int, v int) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf
    let tmp [12]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// append_i64：向 buf 追加十进制 64 位整数（含负号），返回新位置。
// append_int 的实参是 32 位 int，超过 2^31 的值会被静默截断——构建统计里的
// 纳秒计时正好跨在这条线上（2.147 s 以上就翻负），故 64 位量一律走这里。
// 与 append_int 一样不处理 INT64_MIN 取负溢出。
pub fn append_i64(buf *u8, n int, v i64) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf（i64 最长 19 位数字 + 符号）
    let tmp [24]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// write_all：把 buf 前 n 个字节全部写到 fd。
// write 可能短写（返回实际写出字节数），循环推进直到写完；负返回视为错误。
// 返回 0 成功、-1 表示 write 失败（不重试 EINTR，调用方按编译失败处理）。
pub fn write_all(fd int, buf *u8, n int) int {
    let done int = 0
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64))
        if (w <= 0) {
            return -1
        }
        done += w.to_type(int)
    }
    return 0
}

// alloc：统一分配入口（A0d）。
//
// 编译器在内存耗尽后无法继续：与其让调用方解引用空指针、在任意深处
// 无声崩溃，不如在这里写一条确定诊断并终止。这是编译器里**唯一**的
// 进程级退出点；新增分配一律走这里，不再逐点重复判空。
// 返回非 0 指针，调用方按需 `.to_type(*T)` 转换。
pub fn alloc(size u64) *u8 {
    let p *u8 = malloc(size).to_type(*u8)
    if (p == 0) {
        errors.fail("内存不足，无法继续")
        exit(1)
    }
    return p
}

// task_buf_reserve：任务私有缓冲的统一倍增扩容（RS1b）。
// 任务生命期持有、不在任务内释放；扩容后旧块不复用，需要跨扩容稳定的指针
// 必须整体重写后重新取。返回 0 表示分配失败；need 按字节总数（含 NUL）传入。
pub fn task_buf_reserve(buf **u8, cap *int, need int) *u8 {
    if (*buf != 0 && *cap >= need) {
        return *buf
    }
    let ncap int = *cap * 2
    if (ncap < need) {
        ncap = need
    }
    if (ncap < 256) {
        ncap = 256
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return 0
    }
    *buf = nd
    *cap = ncap
    return nd
}

// append_str_cap：容量受限追加字符串，返回新的长度（写满即止）。
pub fn append_str_cap(buf *u8, cap int, n int, s *char) int {
    let i int = 0
    for n < cap - 1 && s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// append_byte_cap：容量受限追加单字节，返回新的长度（写满即止）。
pub fn append_byte_cap(buf *u8, cap int, n int, b u8) int {
    if (n >= cap - 1) { return n }
    buf[n] = b
    n += 1
    buf[n] = 0
    return n
}

// append_int_cap：容量受限追加十进制整数，返回新的长度（写满即止）。
pub fn append_int_cap(buf *u8, cap int, n int, v int) int {
    let tmp [24]u8
    let m int = 0
    let x int = v
    if (x < 0) {
        n = append_byte_cap(buf, cap, n, '-')
        x = -x
    }
    if (x == 0) { return append_byte_cap(buf, cap, n, '0') }
    for x > 0 && m < 24 {
        tmp[m] = (x % 10 + 48).to_type(u8)
        m += 1
        x = x / 10
    }
    for m > 0 {
        m -= 1
        n = append_byte_cap(buf, cap, n, tmp[m])
    }
    return n
}

// cstr_eq：按字节比较两个 NUL 结尾字符串，相等返回 1、不等返回 0。
// prelude 没有 strcmp，这里手写；仅用于命令行参数/模块名比对。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0
    for 1 {
        if (a[i] != b[i]) {
            return 0
        }
        if (a[i] == 0) {
            return 1
        }
        i += 1
    }
    return 0
}

// arr_cstr：把字节缓冲当作 NUL 结尾 C 字符串取 *char。
// 注意：数组局部不可直接 `.to_type(*char)`（接收者语义不同），必须先
// 作参数传递完成退化（本函数的 buf 参数），再对指针做类型转换。
pub fn arr_cstr(buf *u8) *char {
    return buf.to_type(*char)
}

// out_grow：把 data/cap 指向的缓冲扩容到至少能容纳 need 字节。
// 成功返回 0，分配失败输出诊断并返回 -1；成功后 *data/*cap 已更新。
pub fn out_grow(data **u8, n int, cap *int, need int) int {
    if (n < *cap) {
        return 0
    }
    let ncap int = *cap * 2
    if (ncap == 0) {
        ncap = 65536
    }
    if (ncap < need) {
        ncap = need
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return errors.fail("内存分配失败")
    }
    if (n > 0) {
        memcpy(nd, *data, n.to_type(u64))
    }
    free(*data)
    *data = nd
    *cap = ncap
    return 0
}

// hexval：十六进制字符转数值（0-9/a-f/A-F）；调用方保证输入在此集合内。
pub fn hexval(b u8) int {
    if (b >= '0' && b <= '9') {
        return (b - '0').to_type(int)
    }
    if (b >= 'a' && b <= 'f') {
        return ((b - 'a') + 10).to_type(int)
    }
    return ((b - 'A') + 10).to_type(int)
}

// fs/fscope_reset 与文件作用域数据已迁到 proj（ADR-0024）。

// 受检前端阶段守卫（front_checked_*）归 check（ADR-0024，check/front_stage.yh）；
// session.front_checked 字段仍由 support 持有。

// ms：语义表存储窄口。

// np_cstr：名字池内偏移转 NUL 结尾 C 字符串（池内字节本就带 NUL）。
pub fn np_cstr(off int) *char {
    return (pool_ctx().data + off).to_type(*char)
}

// name_intern：把源码 [start,len) 复制进名字池，返回池内偏移。
// 池里字节带 NUL 结尾；分配失败输出诊断并返回 -1。
pub fn name_intern(start int, n int) int {
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = src_ctx().data[start + i]
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off
}

// name_intern_lit：登记编译器内置名字（如 prelude 符号名），返回池偏移。
// 与 name_intern 共用同一池；分配失败返回 -1。
pub fn name_intern_lit(s *char) int {
    let n int = 0
    for s[n] != 0 {
        n += 1
    }
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off2 int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = s[i].to_type(u8)
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off2
}

// tml_intern_str：把任意缓冲字节 intern 进名字池（路径/模块名/诊断消息）。
pub fn tml_intern_str(buf *u8, start int, n int) int {
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = buf[start + i]
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off
}

// append_np_cap：容量受限追加名字池片段（偏移 + 长度），返回新位置。
pub fn append_np_cap(buf *u8, cap int, n int, off int, olen int) int {
    let i int = 0
    for i < olen && n < cap - 1 {
        buf[n] = pool_ctx().data[off + i]
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// append_np：不设上界的名字池字节追加（调用方自行保证缓冲够大）。
pub fn append_np(buf *u8, n int, off int, olen int) int {
    return append_np_cap(buf, 2147483647, n, off, olen)
}

// set_source_path：把当前文件路径复制进任务私有可扩容缓冲，避免可扩容
// 字符串池搬迁后 path 悬空。成功返回 0；路径为空/分配失败返回 -1。
pub fn set_source_path(path *char) int {
    if (path == 0) {
        return errors.fail("源文件路径为空")
    }
    let n int = 0
    for path[n] != 0 {
        n += 1
    }
    let buf *u8 = task_buf_reserve(&src_ctx().path_buf, &src_ctx().path_buf_cap, n + 1)
    if (buf == 0) {
        return errors.fail("路径快照缓冲分配失败")
    }
    let i int = 0
    for i < n {
        buf[i] = path[i].to_type(u8)
        i += 1
    }
    buf[n] = 0
    src_ctx().path = buf.to_type(*char)
    return 0
}

// read_source：读取完整源文件到 SourceCtx.data/length。
// 流程：open（O_RDONLY=0）→ 循环 read 到倍增缓冲（0 即 EOF，负数错误）→
// close。缓冲初始 64 KiB，每次翻倍并整体拷贝；NUL 字节按普通字节保留。
// 成功返回 0；任何一步失败释放资源、输出诊断并返回 -1。
pub fn read_source(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) {
        return errors.fail_path("无法打开文件: ", path)
    }
    let cap int = 65536
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8)
    if (data == 0) {
        close(fd)
        return errors.fail("内存分配失败")
    }
    let blen int = 0
    for 1 {
        // 保证至少 64 KiB 余量再读（read 一次最多取 64 KiB）
        if (cap - blen < 65536) {
            let ncap int = cap * 2
            let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
            if (nd == 0) {
                free(data)
                close(fd)
                return errors.fail("内存分配失败")
            }
            memcpy(nd, data, blen.to_type(u64))
            free(data)
            data = nd
            cap = ncap
        }
        let n i64 = read(fd, data + blen, (cap - blen).to_type(u64))
        if (n < 0) {
            free(data)
            close(fd)
            return errors.fail_path("读取失败: ", path)
        }
        if (n == 0) {
            break
        }
        blen += n.to_type(int)
    }
    close(fd)
    src_ctx().data = data
    src_ctx().length = blen
    return 0
}

// mod_file_binding / mod_ns_lookup / mod_import_find 已迁到 proj（ADR-0024）。

// data_str_add：登记字符串字面量的数据标签与原样字节，返回非零表示表满或分配失败。
// 字节 intern 进名字池（np_data），消费侧（ct_pool_adopt_label）按同一个池取字节。

// data_str_add_pool：直接登记已经位于名字池中的字节，不把池偏移误当源文件偏移。

// data_str_add_body：登记不含首尾引号的字符串体；quoted=2 让解码器仍处理
// 转义，但不剥引号。插值字面文本/说明符使用该模式直接引用源码区间。

// state_init：恢复非零初始值（原 pub let 声明初始化器迁移而来）。
// 在每次编译会话开始（driver 入口与 worker 初始化）调用。
pub fn state_init() void {
    // 诊断路径槽位登记一次：errors 在调用时刻读本字段，直写换源也可见。
    errors.set_path_slot(&g_support.src.path)
    session().active_file = -1
    fc().c_expect_tid = -1
    data_label_reset()
    fc().c_ct_target_ctx = 0
    fc().c_ct_diag_stmt = 0
    msym().off = -1
}

// data_str_slots：字符串标签表四列的地址（CT 镜像用；行数走 data_str_n_slot）。

// data_str_n_slot：字符串标签表行数的地址（表增长后 CT 镜像自动跟随）。

// em_slots：枚举成员登记表的列与行数（`n` 是活行数，由 CT 每次重读）。

// em_n_slot：枚举成员登记行数的地址（表增长后 CT 镜像自动跟随）。

// session_reset：编译会话的非零初值复位（原 gen.state_init）。
// 次序 = 「表计数清零 → 会话游标复位 → 前端瞬时态复位」，调用方在每次
// 进入编译前调用一次；不释放堆缓冲（各推送路径自行扩容/替换）。
pub fn session_reset() void {
    // 诊断路径槽位登记一次：errors 在调用时刻读本字段，直写换源也可见。
    errors.set_path_slot(&g_support.src.path)
    session().active_file = -1
    fc().c_expect_tid = -1
    data_label_reset()
    fc().c_ct_target_ctx = 0
    fc().c_ct_diag_stmt = 0
    msym().off = -1
}

// cfg：目标/配置读写口；已绑定时用 proj 的存储，否则用宿主默认实例。
pub fn cfg() *TargetCfg {
    if (g_support.cfg == 0) {
        // 单模块嵌入没有 proj.init：首次读目标时给 fallback 宿主默认值。
        if (g_support.fallback.target.triple == 0) {
            target_cfg_defaults(&g_support.fallback)
        }
        return &g_support.fallback
    }
    return g_support.cfg
}

// bind_cfg：把目标/配置存储（proj.ProjectCtx.cfg）绑定到 support。
// 必须在任何需要目标的代码之前调用（driver 在 proj.init() 之后）。
pub fn bind_cfg(pointer *TargetCfg) void {
    g_support.cfg = pointer
}

// target_cfg_defaults：把一份目标/配置重置为「宿主身份 + CLI 默认值」。
pub fn target_cfg_defaults(out *TargetCfg) void {
    out.target_explicit = 0
    out.opt_level = 0
    out.trimpath = 0
    out.emit_kind = 0
    out.emit_asm = 0
    out.emit_text_path = 0
    out.module_mode = 0
    out.is_entry_mod = 0
    out.dialect = TG_DIALECT_GNU
    target_host_info(&out.host_target)
    out.target = out.host_target
    if (out.target.os == TARGET_OS_DARWIN) { out.dialect = TG_DIALECT_DARWIN }
}

// module_mode / is_entry_mod：构建模式窄口（供前端查询）。
pub fn module_mode() int {
    return cfg().module_mode
}

pub fn is_entry_mod() int {
    return cfg().is_entry_mod
}

// tg_darwin：是否 Darwin 方言（符号加 `_`、取址用 @PAGE、外部走 GOT）。
pub fn tg_darwin() int {
    return (cfg().dialect == TG_DIALECT_DARWIN).to_type(int)
}

// target_arch_token：接口头行里的架构标记，与 project.arch 的写法一致。
// 头行架构必须随目标变化：此前两处写入端把它硬编码成 arm64，一旦接入
// x64 目标，头行会"说谎"，读取端又只比对字面量，等于失去目标校验。
pub fn target_arch_token() *char {
    if (cfg().target.arch == TARGET_ARCH_X64) {
        return "x64"
    }
    return "arm64"
}

// tg_host_darwin：**宿主**平台探测（进程实际运行的操作系统）——macOS 独有的
// 系统 plist（Linux 无此路径）。与 tg_darwin（输出目标方言）区分：
// open 旗标、目录类宿主文件操作按**宿主内核**语义取值，交叉目标
// （-target darwin）不得改变宿主文件操作（Linux 内核不认 Darwin 的
// O_CREAT 位值，0x601 在 Linux 上是 O_APPEND 组合）。
pub fn tg_host_darwin() int {
    let fd int = open("/System/Library/CoreServices/SystemVersion.plist", 0)
    if (fd >= 0) {
        close(fd)
        return 1
    }
    return 0
}

// tg_host_windows：**宿主**操作系统是否为 Windows。与 tg_windows（输出目标
// 方言）区分：本函数用于 PATH 分隔符、路径分隔符等**运行在本机的编译器自身**
// 的文件操作。构建时目标就是产物将来的宿主（自举交叉编译），所以用 $if
// 编译期选择即可；运行时不受 --target 影响。
pub fn tg_host_windows() int {
    $if (windows) { return 1 }
    $else { return 0 }
}

// target_resolve：严格解析当前支持的完整 triple，成功填出参，失败保持出参原值。
// LLVM 21.1.8 的布局已用固定版本 oracle 核对；这里查静态数据，check 不初始化 LLVM。
// Windows/x64 的 data_layout 是 2026-10-27 用本机 clang 21.1.8
// （`clang --target=x86_64-pc-windows-msvc -S -emit-llvm`）实测值，不要手抄别处。
pub fn target_resolve(triple *char, out *TargetInfo) int {
    let target TargetInfo
    target.pointer_bits = 64
    target.little_endian = 1
    target.layout_version = 1
    if (cstr_eq(triple, "x86_64-unknown-linux-gnu") != 0) {
        target.triple = "x86_64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_X64
        target.abi = "sysv-amd64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-unknown-linux-gnu") != 0) {
        target.triple = "aarch64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_ARM64
        target.abi = "aapcs64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-apple-darwin") != 0) {
        target.triple = "x86_64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_X64
        target.abi = "darwin-amd64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-apple-darwin") != 0) {
        target.triple = "aarch64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_ARM64
        target.abi = "darwin-aapcs64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-pc-windows-msvc") != 0) {
        // 首版 Windows 只接 x64 + MSVC ABI（零 CRT 路线，见方案 §3 D1/D2）。
        target.triple = "x86_64-pc-windows-msvc"
        target.os = TARGET_OS_WINDOWS
        target.arch = TARGET_ARCH_X64
        target.abi = "win64-msvc"
        target.data_layout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else { return -1 }
    out[0] = target
    return 0
}

// target_host_info：构建编译器时选择并固化进程身份，运行时输出 --target 不改变这些分支。
// 启动种子只需认识已有 arm64/darwin 标记；生成原生 x64 编译器时自动选择其 $else。
pub fn target_host_info(out *TargetInfo) int {
    $if (darwin) {
        $if (arm64) { return target_resolve("aarch64-apple-darwin", out) }
        $else { return target_resolve("x86_64-apple-darwin", out) }
    } $else $if (windows) {
        // Windows 宿主（W2-1）：首版只接 x64；arm64 宿主留给矩阵收尾阶段。
        $if (arm64) { return -1 }
        $else { return target_resolve("x86_64-pc-windows-msvc", out) }
    } $else {
        $if (arm64) { return target_resolve("aarch64-unknown-linux-gnu", out) }
        $else { return target_resolve("x86_64-unknown-linux-gnu", out) }
    }
}

// target_select：只更新输出目标及过渡期旧汇编方言，不能写宿主身份。
pub fn target_select(triple *char) int {
    let target TargetInfo
    if (target_resolve(triple, &target) != 0) { return -1 }
    cfg().target = target
    cfg().dialect = target.os == TARGET_OS_DARWIN ? TG_DIALECT_DARWIN : TG_DIALECT_GNU
    return 0
}

// target_select_os_arch：按项目清单的 os/arch 选择目标；0 表示使用宿主身份。
// 只允许已支持的 Linux/Darwin × ARM64/x64 与 Windows × x64 组合。
pub fn target_select_os_arch(os int, arch int) int {
    if (os == 0) { os = cfg().host_target.os }
    if (arch == 0) { arch = cfg().host_target.arch }
    if (os == TARGET_OS_LINUX) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-unknown-linux-gnu") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-unknown-linux-gnu") }
        return -1
    }
    if (os == TARGET_OS_DARWIN) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-apple-darwin") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-apple-darwin") }
        return -1
    }
    // Windows：首版只有 x64；ARM64 留给矩阵收尾阶段（方案 §8 W3）。
    if (os == TARGET_OS_WINDOWS) {
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-pc-windows-msvc") }
        return -1
    }
    return -1
}

// target_matches_host：当前输出目标是否与编译器宿主平台一致。
pub fn target_matches_host() int {
    if (cfg().target.os != cfg().host_target.os) { return 0 }
    if (cfg().target.arch != cfg().host_target.arch) { return 0 }
    return 1
}

// fc：前端瞬时状态窄口。
pub fn fc() *FrontCtx {
    return &g_front
}

// sem_fold_const_binop：按 yh 整数类型执行有边界的常量二元运算。

// sem_fold_const_unary：按目标类型执行常量一元运算，并允许最小值的直接负数字面量。
// 浮点取负走符号位翻转，避免生成冻结子集之外的 fneg。

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。

// ty_is_integer：整数类（bool..u64 与 enum）。

// ty_is_signed：有符号整数类（char..i64 与 enum）。

// ty_is_float：f32/f64。

// sem_fold_norm：把常量按目标整数类型截断，并对有符号值做符号扩展。

// sem_fold_fp_to_int：按目标符号性向零转换到完整 64 位值域，再按源级目标宽度截断。
// 常量折叠和 typed CT 共用，避免无符号高位先经过 i64 饱和而丢失；NaN/越界沿用宿主饱和规则。

// sem_fold_float_convert：常量浮点转换（整数↔浮点、浮点↔浮点），结果写位模式。

pub fn fp64_bits(v f64) i64 {
    let holder *f64 = alloc(8).to_type(*f64)
    holder[0] = v
    let pb *i64 = holder.to_type(*i64)
    let r i64 = pb[0]
    free(holder.to_type(*void))
    return r
}

// fp64_from_bits：把 IEEE754 位模式还原为宿主 f64，供常量折叠使用。
pub fn fp64_from_bits(bits i64) f64 {
    let holder *i64 = alloc(8).to_type(*i64)
    holder[0] = bits
    let view *f64 = holder.to_type(*f64)
    let value f64 = view[0]
    free(holder.to_type(*void))
    return value
}

// fp32_bits：把 IEEE754 双精度位模式窄化为单精度 32 位模式（低位对齐）。
// 编译期浮点值统一以双精度位模式保存（见 fp64_norm_bits），而 f32 对象的
// 初始化字节只有 4 字节；直接截低 4 字节会丢掉指数位，必须真正转一次 f32。
// 低层静态数据与 lowering 的全局初始化共用本函数，避免两份窄化实现漂移。
pub fn fp32_bits(bits i64) i64 {
    let holder *f32 = alloc(4).to_type(*f32)
    if (holder == 0) { return 0 }
    holder[0] = fp64_from_bits(bits).to_type(f32)
    let view *i32 = holder.to_type(*i32)
    let result i64 = view[0].to_type(i64)
    free(holder.to_type(*void))
    return result
}

// fp64_norm_bits：按目标浮点类型规范化位模式；f32 经一次往返窄化到单精度。

pub fn sem_res_const(r *Res, tid int, v i64) int {
    r.type_id = tid
    r.is_const = 1
    r.ival = v
    r.sym = -1
    r.is_lit = 0
    r.lit_big = 0
    r.ast_id = -1
    r.layout_type_id = -1
    r.ct_diag = 0
    r.ct_diag_expr = -1
    r.ct_diag_line = 0
    r.ct_diag_col = 0
    r.ct_diag_msg_start = -1
    r.ct_diag_msg_len = 0
    return 0
}

// sem_struct_finish：结构体/联合体字段登记完成后结算布局，写回类型行。
// 布局算法在 support/model 的 layout.yh；本函数只做「读字段表 → 算 → 写回」。

// 平台宿主代码已全部迁出 support：console/argv → cmd（ADR-0025）；
// clock 单调时钟删除（ADR-0026），testkit 超时改用 libs/time.monotonic_ns。
// support 不再有任何平台变体文件与 Win32 extern。

// C ABI 位置分类种类与结构已迁到 check（ADR-0024）；算法与词汇同在 check/abi_c。

// —— 目标身份与数据模型（换平台第一步） ——
pub const TARGET_OS_LINUX int = 1

pub const TARGET_OS_DARWIN int = 2

pub const TARGET_OS_WINDOWS int = 3

pub const TARGET_ARCH_ARM64 int = 1

pub const TARGET_ARCH_X64 int = 2

// —— 标量数据模型/调用约定/方言（字节与 ABI 量化约束） ——
pub const TG_PTR_SIZE int = 8

pub const TG_INT_SIZE int = 4

pub const TG_CHAR_SIZE int = 1

pub const TG_SHORT_SIZE int = 2

pub const TG_LONG_SIZE int = 8

pub const TG_ENUM_SIZE int = 4

pub const TG_STACK_ALIGN int = 16

pub const TG_ARG_REGS int = 8

pub const TG_VALUE_SLOT int = 16

pub const TG_DIALECT_GNU int = 0

pub const TG_DIALECT_DARWIN int = 1

pub const ABI_YH int = 0

pub const ABI_C int = 1

// —— 具名类型属性位（ATTR_*）——
// 源头在 support（support 是叶子，不能 import token）；token 侧写成转发别名，
// 因此 token.ATTR_* 与 support.ATTR_* 恒等。数值改动必须同步 .s.i 接口测试。
pub const ATTR_EXTERN int = 1

pub const ATTR_INLINE int = 2

pub const ATTR_NORETURN int = 4

pub const ATTR_OPAQUE int = 8 // 仅编译器内部标记 extern 空 struct/union

pub const ATTR_COMPTIME int = 16 // @[comptime]：函数体可在编译期显式求值

// —— 运算符 token 码（源头在 support；token 侧只是转发别名）——
// 与 token/base.yh 的历史编号必须一致：.s.i/.s.ct 与缓存键都按这些数编码。
pub const TK_PLUS int = 64

pub const TK_MINUS int = 65

pub const TK_STAR int = 66

pub const TK_SLASH int = 67

pub const TK_PERCENT int = 68

pub const TK_AMP int = 69

pub const TK_PIPE int = 70

pub const TK_CARET int = 71

pub const TK_TILDE int = 72

pub const TK_BANG int = 73

pub const TK_LT int = 74

pub const TK_GT int = 75

pub const TK_EQEQ int = 76

pub const TK_NEQ int = 77

pub const TK_LEQ int = 78

pub const TK_GEQ int = 79

pub const TK_ANDAND int = 80

pub const TK_OROR int = 81

pub const TK_LSHIFT int = 82

pub const TK_RSHIFT int = 83

pub const TK_ASSIGN int = 84

pub const TK_PLUSEQ int = 85

pub const TK_MINUSEQ int = 86

pub const TK_STAREQ int = 87

pub const TK_SLASHEQ int = 88

pub const TK_PERCENTEQ int = 89

pub const TK_AMPEQ int = 90

pub const TK_PIPEEQ int = 91

pub const TK_CARETEQ int = 92

pub const TK_LSHIFTEQ int = 93

pub const TK_RSHIFTEQ int = 94

pub const TK_RANGE int = 95

pub const TK_ELLIPSIS int = 96

// —— 类型/符号/值规则 ——
// 类型种类（TY_*）、类型表行（CType/SField/TName）在 types；
// 符号种类/标志（SYM_*/F_*）、值规则错误码（VK_*）与语义表在 table。


// —— 编译期诊断种类（$assert/$compile_error/$compile_warn） ——
pub const CT_DIAG_ASSERT int = 1 // $assert 编译期指令

pub const CT_DIAG_ERROR int = 2 // $compile_error 编译期指令

pub const CT_DIAG_WARN int = 3 // $compile_warn 编译期指令



// num_is_float：数字字面量文本是否为浮点形态（含小数点或指数）。
// 前缀进制（0x/0o/0b）恒为整数：其中的 e/E 是数字而非指数。
pub fn num_is_float(start int, n int) int {
    if (n >= 2 && src_ctx().data[start] == '0') {
        let p2 u8 = src_ctx().data[start + 1]
        if (p2 == 'x' || p2 == 'X' || p2 == 'o' || p2 == 'O'
            || p2 == 'b' || p2 == 'B') { return 0 }
    }
    let i int = 0
    for i < n {
        let b u8 = src_ctx().data[start + i]
        if (b == '.' || b == 'e' || b == 'E') { return 1 }
        i += 1
    }
    return 0
}

// loop_push：进入一层循环，登记 break/continue 跳转位；深度超限返回 -1
// （诊断由调用方给，support 不依赖 token）。纯 fc() 栈操作。
pub fn loop_push(brk int, cnt int) int {
    if (fc().c_loop_depth >= 64) { return -1 }
    fc().c_brk_stk[fc().c_loop_depth] = brk
    fc().c_cnt_stk[fc().c_loop_depth] = cnt
    fc().c_loop_break_seen[fc().c_loop_depth] = 0
    fc().c_loop_depth += 1
    fc().c_loop_brk = brk
    fc().c_loop_cnt = cnt
    return 0
}

// loop_pop：退出一层循环，恢复外层最近的 break/continue 跳转位。
pub fn loop_pop() int {
    fc().c_loop_depth -= 1
    if (fc().c_loop_depth > 0) {
        fc().c_loop_brk = fc().c_brk_stk[fc().c_loop_depth - 1]
        fc().c_loop_cnt = fc().c_cnt_stk[fc().c_loop_depth - 1]
    }
    return 0
}
