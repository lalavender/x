    g_model.sym_n = 0
    g_model.sym_cap = 0
    g_model.scope_start = 0
    g_model.scope_n = 0
}

// model_type_push：追加一行类型（必要时扩容类型表与归属表），返回新行号。
// 只做存储：按内容去重、内建类型登记等语义规则仍在 gen/check。
// 扩容时类型表与 home 表同步翻倍，新增归属填 -1（本地）。
pub fn model_type_push(kind int, size int, align int, elem int, n int, sub int) int {
    let m *ModelStore = ms()
    if (m.type_n == m.type_cap) {
        let ncap int = m.type_cap * 2
        if (ncap == 0) { ncap = 64 }
        let nd *CType = malloc((ncap * sizeof(CType)).to_type(u64)).to_type(*CType)
        if (nd == 0) { return errors.fail("内存分配失败") }
        if (m.type_n > 0) {
            memcpy(nd, m.types, (m.type_n * sizeof(CType)).to_type(u64))
        }
        free(m.types)
        m.types = nd
        let nh *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nh == 0) { return errors.fail("内存分配失败") }
        if (m.home_cap > 0) {
            memcpy(nh, m.home, (m.home_cap * sizeof(int)).to_type(u64))
        }
        if (m.home_cap > 0) { free(m.home) }
        m.home = nh
        let hi int = m.home_cap
        for hi < ncap {
            m.home[hi] = -1
            hi += 1
        }
        m.home_cap = ncap
        m.type_cap = ncap
    }
    m.types[m.type_n].kind = kind
    m.types[m.type_n].size = size
    m.types[m.type_n].align = align
    m.types[m.type_n].elem = elem
    m.types[m.type_n].len = n
    m.types[m.type_n].sub = sub
    m.type_n += 1
    return m.type_n - 1
}

// model_type_push_agg：追加聚合类型并检查登记上限；超限返回 -1。
pub fn model_type_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    if (ms().aggtype_n >= AGGTYPE_LIMIT) {
        return errors.fail("聚合类型登记过多（上限 512）")
    }
    ms().aggtype_n += 1
    return model_type_push(kind, size, align, elem, n, sub)
}

// np_cstr：名字池内偏移转 NUL 结尾 C 字符串（池内字节本就带 NUL）。
pub fn np_cstr(off int) *char {
    return (pool_ctx().data + off).to_type(*char)
}

// name_intern：把源码 [start,len) 复制进名字池，返回池内偏移。
// 池里字节带 NUL 结尾；分配失败输出诊断并返回 -1。
pub fn name_intern(start int, n int) int {
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = src_ctx().data[start + i]
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off
}

// name_intern_lit：登记编译器内置名字（如 prelude 符号名），返回池偏移。
// 与 name_intern 共用同一池；分配失败返回 -1。
pub fn name_intern_lit(s *char) int {
    let n int = 0
    for s[n] != 0 {
        n += 1
    }
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off2 int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = s[i].to_type(u8)
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off2
}

// tml_intern_str：把任意缓冲字节 intern 进名字池（路径/模块名/诊断消息）。
pub fn tml_intern_str(buf *u8, start int, n int) int {
    let need int = pool_ctx().length + n + 1
    if (need > pool_ctx().cap) {
        let ncap int = pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (pool_ctx().length > 0) {
            memcpy(nd, pool_ctx().data, pool_ctx().length.to_type(u64))
        }
        free(pool_ctx().data)
        pool_ctx().data = nd
        pool_ctx().cap = ncap
    }
    let off int = pool_ctx().length
    let i int = 0
    for i < n {
        pool_ctx().data[pool_ctx().length] = buf[start + i]
        pool_ctx().length += 1
        i += 1
    }
    pool_ctx().data[pool_ctx().length] = 0
    pool_ctx().length += 1
    return off
}

// append_np_cap：容量受限追加名字池片段（偏移 + 长度），返回新位置。
pub fn append_np_cap(buf *u8, cap int, n int, off int, olen int) int {
    let i int = 0
    for i < olen && n < cap - 1 {
        buf[n] = pool_ctx().data[off + i]
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// append_np：不设上界的名字池字节追加（调用方自行保证缓冲够大）。
pub fn append_np(buf *u8, n int, off int, olen int) int {
    return append_np_cap(buf, 2147483647, n, off, olen)
}

// set_source_path：把当前文件路径复制进任务私有可扩容缓冲，避免可扩容
// 字符串池搬迁后 path 悬空。成功返回 0；路径为空/分配失败返回 -1。
pub fn set_source_path(path *char) int {
    if (path == 0) {
        return errors.fail("源文件路径为空")
    }
    let n int = 0
    for path[n] != 0 {
        n += 1
    }
    let buf *u8 = task_buf_reserve(&src_ctx().path_buf, &src_ctx().path_buf_cap, n + 1)
    if (buf == 0) {
        return errors.fail("路径快照缓冲分配失败")
    }
    let i int = 0
    for i < n {
        buf[i] = path[i].to_type(u8)
        i += 1
    }
    buf[n] = 0
    src_ctx().path = buf.to_type(*char)
    return 0
}

// read_source：读取完整源文件到 SourceCtx.data/length。
// 流程：open（O_RDONLY=0）→ 循环 read 到倍增缓冲（0 即 EOF，负数错误）→
// close。缓冲初始 64 KiB，每次翻倍并整体拷贝；NUL 字节按普通字节保留。
// 成功返回 0；任何一步失败释放资源、输出诊断并返回 -1。
pub fn read_source(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) {
        return errors.fail_path("无法打开文件: ", path)
    }
    let cap int = 65536
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8)
    if (data == 0) {
        close(fd)
        return errors.fail("内存分配失败")
    }
    let blen int = 0
    for 1 {
        // 保证至少 64 KiB 余量再读（read 一次最多取 64 KiB）
        if (cap - blen < 65536) {
            let ncap int = cap * 2
            let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
            if (nd == 0) {
                free(data)
                close(fd)
                return errors.fail("内存分配失败")
            }
            memcpy(nd, data, blen.to_type(u64))
            free(data)
            data = nd
            cap = ncap
        }
        let n i64 = read(fd, data + blen, (cap - blen).to_type(u64))
        if (n < 0) {
            free(data)
            close(fd)
            return errors.fail_path("读取失败: ", path)
        }
        if (n == 0) {
            break
        }
        blen += n.to_type(int)
    }
    close(fd)
    src_ctx().data = data
    src_ctx().length = blen
    return 0
}

// static_data_add：创建预清零对象；同符号或同标签重复登记时替换原行并清空重定位。
// 先分配再替换，失败不破坏已有对象；返回稳定行号或 -1，允许空 backing。
pub fn static_data_add(sym_id int, label int, type_id int, elem_type int,
    count int, size int, align int) int {
    if (sym_id < -1 || label < -1 || label == 0 || (sym_id < 0 && label < 1)
        || type_id < -1 || elem_type < -1 || count < 0 || size < 0 || size > STATIC_DATA_LIMIT
        || align <= 0 || align > STATIC_DATA_LIMIT || (align & (align - 1)) != 0
        || (type_id < 0 && elem_type < 0)) {
        return errors.fail("静态数据对象的身份或布局无效")
    }
    let row int = -1; let i int = 0
    for i < static_object_n {
        let current StaticDataObject = static_objects[i]
        if ((sym_id >= 0 && current.sym_id == sym_id)
            || (label >= 1 && current.label == label)) {
            if (row >= 0 && row != i) { return errors.fail("静态数据符号与标签身份冲突") }
            row = i
        }
        i += 1
    }
    let object StaticDataObject
    object.sym_id = sym_id; object.label = label; object.type_id = type_id
    object.elem_type = elem_type; object.count = count; object.size = size; object.align = align
    if (size > 0) {
        object.data = malloc(size.to_type(u64)).to_type(*u8)
        if (object.data == 0) { return errors.fail("静态数据字节分配失败") }
        i = 0
        for i < size { object.data[i] = 0; i += 1 }
    }
    if (row < 0 && static_object_n == static_object_cap) {
        let capacity int = static_object_cap == 0 ? 16 : static_object_cap * 2
        if (capacity > STATIC_DATA_LIMIT / sizeof(StaticDataObject)) {
            static_data_drop(&object); return errors.fail("静态数据目录过大")
        }
        let next *StaticDataObject = malloc((capacity * sizeof(StaticDataObject)).to_type(u64)) .
            to_type(*StaticDataObject)
        if (next == 0) { static_data_drop(&object); return errors.fail("静态数据目录分配失败") }
        if (static_object_n > 0) {
            memcpy(next, static_objects, (static_object_n * sizeof(StaticDataObject)).to_type(u64))
        }
        free(static_objects.to_type(*void)); static_objects = next; static_object_cap = capacity
    }
    if (row < 0) { row = static_object_n; static_object_n += 1 }
    else { static_data_drop(&static_objects[row]) }
    static_objects[row] = object
    return row
}

// static_data_scalar：按小端写入完整低位，不允许越界或覆盖已有指针重定位槽。
// bits 仅表示目标标量位型，绝不按宿主地址解引用；成功返回 0。
pub fn static_data_scalar(row int, offset int, width int, bits i64) int {
    if (row < 0 || row >= static_object_n || offset < 0 || width < 1 || width > 8
        || offset > static_objects[row].size || width > static_objects[row].size - offset) {
        return errors.fail("静态数据标量写入范围无效")
    }
    let object *StaticDataObject = &static_objects[row]
    let i int = 0
    for i < object.reloc_n {
        let reloc StaticDataReloc = object.relocs[i]
        if (offset < reloc.offset + reloc.width && reloc.offset < offset + width) {
            return errors.fail("静态数据标量与指针重定位重叠")
        }
        i += 1
    }
    i = 0
    for i < width { object.data[offset + i] = (bits.to_type(u64) >> (i * 8)).to_type(u8); i += 1 }
    return 0
}

// static_data_reloc：登记一个未重叠的 8 字节指针槽；目标必须为符号或正标签。
// 源槽只接受零占位，目标尚未登记也可引用，最终闭包由受检模块与 IR verifier 校验。
// ponytail: 单对象重定位按追加复制；大量指针槽成为实测瓶颈时再增加私有容量表。
pub fn static_data_reloc(row int, offset int, target_sym int, target_label int, addend i64) int {
    if (row < 0 || row >= static_object_n || offset < 0
        || offset > static_objects[row].size || 8 > static_objects[row].size - offset
        || target_sym < -1 || target_label < -1 || target_label == 0
        || (target_sym < 0 && target_label < 1) || (target_sym >= 0 && target_label >= 1)) {
        return errors.fail("静态数据指针重定位无效")
    }
    let object *StaticDataObject = &static_objects[row]
    let i int = 0
    for i < 8 {
        if (object.data[offset + i] != 0) { return errors.fail("静态数据指针槽必须使用零占位") }
        i += 1
    }
    i = 0
    for i < object.reloc_n {
        if (offset < object.relocs[i].offset + 8 && object.relocs[i].offset < offset + 8) {
            return errors.fail("静态数据指针重定位重叠")
        }
        i += 1
    }
    if (object.reloc_n >= STATIC_DATA_LIMIT / sizeof(StaticDataReloc)) {
        return errors.fail("静态数据重定位过多")
    }
    let next *StaticDataReloc = malloc(((object.reloc_n + 1) * sizeof(StaticDataReloc)).to_type(u64)) .
        to_type(*StaticDataReloc)
    if (next == 0) { return errors.fail("静态数据重定位分配失败") }
    if (object.reloc_n > 0) {
        memcpy(next, object.relocs, (object.reloc_n * sizeof(StaticDataReloc)).to_type(u64))
    }
    next[object.reloc_n].offset = offset; next[object.reloc_n].width = 8
    next[object.reloc_n].target_sym = target_sym; next[object.reloc_n].target_label = target_label
    next[object.reloc_n].addend = addend
    free(object.relocs.to_type(*void)); object.relocs = next; object.reloc_n += 1
    return 0
}

// static_data_count：返回当前编译单元已封存的对象数，不暴露可变目录表。
pub fn static_data_count() int { return static_object_n }

// static_data_at：复制一行描述符，内部缓冲只读借用；消费者封存时须深拷贝。
// 越界或空出参返回 -1，不改出参；同一行替换或目录 reset 后借用失效。
pub fn static_data_at(row int, out *StaticDataObject) int {
    if (row < 0 || row >= static_object_n || out == 0) { return -1 }
    out[0] = static_objects[row]
    return 0
}

// static_data_reset：释放本编译单元全部目录与子缓冲；允许空目录和重复调用。
pub fn static_data_reset() void {
    let i int = 0
    for i < static_object_n { static_data_drop(&static_objects[i]); i += 1 }
    free(static_objects.to_type(*void)); static_objects = 0; static_object_n = 0; static_object_cap = 0
}

// static_data_rows_slot：静态数据目录首址的槽（CT 镜像用，不复制）。
pub fn static_data_rows_slot() **StaticDataObject { return &static_objects }

// static_data_n_slot：静态数据目录行数的槽。
pub fn static_data_n_slot() *int { return &static_object_n }

pub fn sym_lookup_off(off int, n int) int {
    let i int = ms().sym_n - 1
    for i >= 0 {
        if (ms().syms[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ms().syms[i].name_off + j] != pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i -= 1
    }
    return -1
}

// sym_lookup：当前作用域链内查找（符号按名字池比较）。找不到返回 -1。
pub fn sym_lookup(start int, n int) int {
    let i int = ms().sym_n - 1
    for i >= 0 {
        if (ms().syms[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ms().syms[i].name_off + j] != src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i -= 1
    }
    return -1
}

// sym_lookup_off：按名字池偏移查符号（池对池比较，供构建器诊断用）。
// 只查全局层（ms().scope_start[0] 以下）。找不到返回 -1。
// sym_ct_lit_text：把「字符串指针常量」沿引用链追到最终的字面式初始化文本。引用式
// （`const A *char = B;`，kind 3）逐跳跟进，直到找到 kind 2 的字面式 —— 消费者看不到提供方的
// 私有常量名，重放引用本身会在导入侧解析失败。跳数上限 16 兼作环与超深链的兜底
// （`A -> B -> A` 这类环不会死循环）。成功填 out_off/out_len 返回 0，否则返回 1。
pub fn sym_ct_lit_text(sym_id int, out_off *int, out_len *int) int {
    if (sym_id < 0 || sym_id >= ms().sym_n) { return 1 }
    let cur int = sym_id
    let hops int = 0
    for hops < 16 {
        let kind int = ms().syms[cur].const_expr_kind
        if (kind == 2) {
            *out_off = ms().syms[cur].const_expr_off
            *out_len = ms().syms[cur].const_expr_len
            return 0
        }
        if (kind != 3) { return 1 }
        let nxt int = sym_lookup_off(ms().syms[cur].const_expr_off,
            ms().syms[cur].const_expr_len)
        if (nxt < 0 || nxt >= ms().sym_n || nxt == cur) { return 1 }
        if (ms().syms[nxt].kind != SYM_CONST
            || (ms().syms[nxt].flags & F_ADDR) == 0) {
            return 1
        }
        cur = nxt
        hops += 1
    }
    return 1
}

// ty_name_attrs：合并同一底层类型的具名别名属性，保留 C/opaque 类型身份。
pub fn ty_name_attrs(tid int) int {
    let attrs int = 0
    let i int = 0
    for i < ms().name_n {
        if (ms().names[i].type_id == tid) {
            attrs |= ms().names[i].attrs
        }
        i += 1
    }
    return attrs
}

// ty_is_opaque：判断底层类型是否由 extern 空 struct/union 声明为不透明类型。
pub fn ty_is_opaque(tid int) int {
    return ((ty_name_attrs(tid) & ATTR_OPAQUE) != 0).to_type(int)
}

// ty_is_scalar：可放进寄存器的标量（整数/浮点/指针/fn）。
pub fn ty_is_scalar(tid int) int {
    let k int = ms().types[tid].kind
    if (k == TY_PTR || k == TY_FN) {
        return 1
    }
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE || k == TY_VOID) {
        return 0
    }
    return 1
}

// ty_has_opaque_value：数组/切片等复合值不得把不透明 C 对象按值存储。
pub fn ty_has_opaque_value(tid int) int {
    if (ty_is_opaque(tid) != 0) { return 1 }
    let kind int = ms().types[tid].kind
    if (kind == TY_ARRAY || kind == TY_SLICE) {
        return ty_has_opaque_value(ms().types[tid].elem)
    }
    return 0
}

// ty_lookup_name：按名字查类型。找不到返回 -1。
pub fn ty_lookup_name(start int, n int) int {
    let i int = ms().name_n - 1
    for i >= 0 {
        if (ms().names[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ms().names[i].name_off + j] != src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return ms().names[i].type_id
            }
        }
        i -= 1
    }
    return -1
}

// ty_lookup_name_pool：按名字池偏移查类型；语义同 ty_lookup_name。
// 供 check 解析已 intern 的类型语法节点，不依赖当前源文件偏移。
pub fn ty_lookup_name_pool(off int, n int) int {
    let i int = ms().name_n - 1
    for i >= 0 {
        if (ms().names[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ms().names[i].name_off + j] != pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return ms().names[i].type_id
            }
        }
        i -= 1
    }
    return -1
}

// mod_file_binding：当前文件导入表中查绑定名，返回 ModInfo 下标；无 -1。
pub fn mod_file_binding(start int, n int) int {
    if (fs().import_mod == 0) {
        return -1
    }
    // 按绑定名（别名）匹配：限定调用的第一段标识符是别名
    let i int = 0
    for i < fs().import_n {
        if (fs().import_mod[i] >= 0 && fs().imports[i].alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[fs().imports[i].alias_off + j] != src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return fs().import_mod[i]
            }
        }
        i += 1
    }
    return -1
}

// mod_file_binding_pool：按名字池偏移查当前文件导入绑定；语义同 mod_file_binding。
pub fn mod_file_binding_pool(off int, n int) int {
    if (fs().import_mod == 0) {
        return -1
    }
    let i int = 0
    for i < fs().import_n {
        let ent ImportEnt = fs().imports[i]
        if (fs().import_mod[i] >= 0 && ent.alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ent.alias_off + j] != pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return fs().import_mod[i]
            }
        }
        i += 1
    }
    return -1
}

// mod_ns_lookup：模块命名空间查条目下标。want_type=1 查类型名，否则查值。
pub fn mod_ns_lookup(mi int, start int, n int, want_type int) int {
    let i int = 0
    for i < fs().mods[mi].ns_n {
        if (fs().mods[mi].ns[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[fs().mods[mi].ns[i].name_off + j] != src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (want_type != 0) {
                    if (fs().mods[mi].ns[i].tid >= 0) {
                        return i
                    }
                    return -1
                }
                if (fs().mods[mi].ns[i].sym >= 0) {
                    return i
                }
                return -1
            }
        }
        i += 1
    }
    return -1
}

// mod_ns_lookup_pool：按名字池中的名字查模块导出；语义同 mod_ns_lookup。
// 供编译器合成的 fmt 调用使用（名字不来自源码 token）。
pub fn mod_ns_lookup_pool(mi int, off int, n int, want_type int) int {
    if (mi < 0 || mi >= fs().mod_n) {
        return -1
    }
    let i int = 0
    for i < fs().mods[mi].ns_n {
        let ent ModNsEnt = fs().mods[mi].ns[i]
        if (ent.name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ent.name_off + j] != pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (want_type != 0) {
                    return ent.tid >= 0 ? i : -1
                }
                return ent.sym >= 0 ? i : -1
            }
        }
        i += 1
    }
    return -1
}

// mod_import_find：按绑定名（别名）在文件导入表里查找模块；找不到返回 -1。
// 供插值降级定位 fmt 的导入绑定，不依赖源码中的 token 位置。
pub fn mod_import_find(name *char, n int) int {
    if (fs().import_mod == 0) {
        return -1
    }
    let i int = 0
    for i < fs().import_n {
        let ent ImportEnt = fs().imports[i]
        if (fs().import_mod[i] >= 0 && ent.alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_ctx().data[ent.alias_off + j] != name[j].to_type(u8)) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return fs().import_mod[i]
            }
        }
        i += 1
    }
    return -1
}

// sem_lit_fits：字面量位型值是否落在整数类型可表示范围内。
// ast 的 SSA 降低用它做**字面量适配**（与 sem_binop 同判据），故为 pub。
pub fn sem_lit_fits(tid int, v i64) int {
    let k int = ms().types[tid].kind
    if (k == TY_U8) { return ((v >= 0) && (v <= 255)).to_type(int) }
    if (k == TY_U16) { return ((v >= 0) && (v <= 65535)).to_type(int) }
    if (k == TY_U32) { return ((v >= 0) && (v <= 4294967295)).to_type(int) }
    if (k == TY_U64) { return 1 }
    if (k == TY_I8) { return ((v >= -128) && (v <= 127)).to_type(int) }
    if (k == TY_I16) { return ((v >= -32768) && (v <= 32767)).to_type(int) }
    if (k == TY_I32 || k == TY_ENUM) {
        return ((v >= -2147483648) && (v <= 2147483647)).to_type(int)
    }
    if (k == TY_I64) { return 1 }
    if (k == TY_CHAR) { return ((v >= 0) && (v <= 255)).to_type(int) }
    if (k == TY_BOOL) { return ((v == 0) || (v == 1)).to_type(int) }
    return 1
}

// data_str_add：登记字符串字面量的数据标签与原样字节，返回非零表示表满或分配失败。
// 字节 intern 进名字池（np_data），消费侧（ct_pool_adopt_label）按同一个池取字节。
pub fn data_str_add(lbl int, start int, slen int) int {
    if (c_data_str_n >= DATA_STR_CAP) { return -1 }
    let off int = name_intern(start, slen)
    if (off < 0) { return -1 }
    return data_str_add_entry(lbl, off, slen, 1)
}

// data_str_add_pool：直接登记已经位于名字池中的字节，不把池偏移误当源文件偏移。
pub fn data_str_add_pool(lbl int, off int, slen int) int {
    return data_str_add_entry(lbl, off, slen, 0)
}

// data_str_add_body：登记不含首尾引号的字符串体；quoted=2 让解码器仍处理
// 转义，但不剥引号。插值字面文本/说明符使用该模式直接引用源码区间。
pub fn data_str_add_body(lbl int, start int, slen int) int {
    let off int = name_intern(start, slen)
    if (off < 0) { return -1 }
    return data_str_add_entry(lbl, off, slen, 2)
}

// ty_count：当前编译单元已登记的类型数（check 切片 v3 用它判断本函数是否新建类型）。
pub fn ty_count() int { return ms().type_n }

// data_str_count / data_str_row：字符串登记表规模与逐行读取（check 切片 v3 携带用）。
pub fn data_str_count() int { return c_data_str_n }

pub fn data_str_row(row int, lbl *int, off *int, slen *int, quoted *int) int {
    if (row < 0 || row >= c_data_str_n) { return -1 }
    lbl[0] = c_data_str_lbl[row]; off[0] = c_data_str_off[row]
    slen[0] = c_data_str_len[row]; quoted[0] = c_data_str_quoted[row]
    return 0
}

// data_str_restore：按记录里的既有标签恢复字符串登记（check 切片 v3）。
// 被跳过的函数不再分配标签，这里把 c_data_n 推到该标签之后，保证后续分配不撞号。
pub fn data_str_restore(lbl int, off int, slen int, quoted int) int {
    let have_off int = 0
    let have_len int = 0
    let have_quoted int = 0
    if (data_str_lookup(lbl, &have_off, &have_len, &have_quoted) == 0) {
        if (data_str_add_entry(lbl, off, slen, quoted) != 0) { return -1 }
    }
    if (data_label() <= lbl) { data_label_set(lbl + 1) }
    return 0
}

// data_str_lookup：按数据标签号查登记项；**命中返回非零**并写出名字池偏移与字节长度，
// 未命中返回 0（调用方 `if (data_str_lookup(...) != 0)` 以非零为命中）。
pub fn data_str_lookup(lbl int, off *int, slen *int, quoted *int) int {
    let i int = 0
    for i < c_data_str_n {
        if (c_data_str_lbl[i] == lbl) {
            *off = c_data_str_off[i]
            *slen = c_data_str_len[i]
            *quoted = c_data_str_quoted[i]
            return 1
        }
        i += 1
    }
    return 0
}

// em_add：登记一个枚举成员（必须在成员的值与就绪位写完之后调用，否则快照到 0）。
pub fn em_add(sym int) int {
    if (em_n >= 512) { return -1 }
    em_name_off[em_n] = ms().syms[sym].name_off
    em_name_len[em_n] = ms().syms[sym].name_len
    em_val[em_n] = ms().syms[sym].cval
    em_ready[em_n] = ms().syms[sym].const_ready
    em_n += 1
    return 0
}

// em_update_value：延迟回填枚举成员值时同步表内快照（按名字池偏移匹配，不依赖符号下标）。
pub fn em_update_value(name_off int, val i64) void {
    let i int = 0
    for i < em_n {
        if (em_name_off[i] == name_off) {
            em_val[i] = val
            em_ready[i] = 1
        }
        i += 1
    }
}

// em_find_src：按给定源码缓冲的名字字节反查登记项下标，找不到返回 -1。
// 编译期目标另有一份源码缓冲（frame.target.src），与前端 c_src 不一定同一个。
pub fn em_find_src(src *u8, start int, n int) int {
    let i int = 0
    for i < em_n {
        if (em_name_eq(i, src, start, n) != 0) { return i }
        i += 1
    }
    return -1
}

// em_find：按前端当前源文件（c_src）的名字字节反查登记项下标。
pub fn em_find(start int, n int) int {
    return em_find_src(src_ctx().data, start, n)
}

// sym_find_enum_member：在符号表里按名字找属于枚举类型 etid 的成员符号。
// 用于「成员名被同名形参/局部变量遮蔽」时仍能解析 `EnumName.member`：
// 词法作用域里的同名声明优先用于普通标识符，但 `.` 右侧的成员名总是枚举成员。
pub fn sym_find_enum_member(etid int, src *u8, start int, n int) int {
    let i int = 0
    for i < ms().sym_n {
        let candidate CSym = ms().syms[i]
        if ((candidate.flags & F_ENUM_MEMBER) != 0 && candidate.type_id == etid
            && candidate.name_len == n) {
            let off int = candidate.name_off
            let j int = 0
            for j < n {
                if (pool_ctx().data[off + j].to_type(int)
                    != src[start + j].to_type(int)) {
                    break
                }
                j += 1
            }
            if (j == n) {
                return i
            }
        }
        i += 1
    }
    return -1
}

// em_get_val / em_get_ready：读取登记项的值与就绪位。
pub fn em_get_val(idx int) i64 {
    return em_val[idx]
}

pub fn em_get_ready(idx int) int {
    return em_ready[idx]
}

// state_init：恢复非零初始值（原 pub let 声明初始化器迁移而来）。
// 在每次编译会话开始（driver 入口与 worker 初始化）调用。
pub fn state_init() void {
    static_data_reset()
    // 诊断路径槽位登记一次：errors 在调用时刻读本字段，直写换源也可见。
    errors.set_path_slot(&g_support.src.path)
    session().active_file = -1
    fc().c_expect_tid = -1
    data_label_reset()
    c_data_str_n = 0
    em_n = 0
    fc().c_ct_target_ctx = 0
    fc().c_ct_diag_stmt = 0
    fs().name_off = -1
    fs().sym_sfx_off = -1
}

// data_str_slots：字符串标签表四列的地址（CT 镜像用；行数走 data_str_n_slot）。
pub fn data_str_slots(lbl **int, off **int, slen **int, quoted **int) void {
    lbl[0] = &c_data_str_lbl[0]
    off[0] = &c_data_str_off[0]
    slen[0] = &c_data_str_len[0]
    quoted[0] = &c_data_str_quoted[0]
}

// data_str_n_slot：字符串标签表行数的地址（表增长后 CT 镜像自动跟随）。
pub fn data_str_n_slot() *int { return &c_data_str_n }

// em_slots：枚举成员登记表的列与行数（`n` 是活行数，由 CT 每次重读）。
pub fn em_slots(off **int, slen **int, val **i64, ready **int) void {
    off[0] = &em_name_off[0]
    slen[0] = &em_name_len[0]
    val[0] = &em_val[0]
    ready[0] = &em_ready[0]
}

// em_n_slot：枚举成员登记行数的地址（表增长后 CT 镜像自动跟随）。
pub fn em_n_slot() *int { return &em_n }

// session_reset：编译会话的非零初值复位（原 gen.state_init）。
// 次序 = 「表计数清零 → 会话游标复位 → 前端瞬时态复位」，调用方在每次
// 进入编译前调用一次；不释放堆缓冲（各推送路径自行扩容/替换）。
pub fn session_reset() void {
    static_data_reset()
    // 诊断路径槽位登记一次：errors 在调用时刻读本字段，直写换源也可见。
    errors.set_path_slot(&g_support.src.path)
    session().active_file = -1
    fc().c_expect_tid = -1
    data_label_reset()
    c_data_str_n = 0
    em_n = 0
    fc().c_ct_target_ctx = 0
    fc().c_ct_diag_stmt = 0
    fs().name_off = -1
    fs().sym_sfx_off = -1
}

// cfg：目标/配置读写口；已绑定时用 proj 的存储，否则用宿主默认实例。
pub fn cfg() *TargetCfg {
    if (g_support.cfg == 0) {
        // 单模块嵌入没有 proj.init：首次读目标时给 fallback 宿主默认值。
        if (g_support.fallback.target.triple == 0) {
            target_cfg_defaults(&g_support.fallback)
        }
        return &g_support.fallback
    }
    return g_support.cfg
}

// bind_cfg：把目标/配置存储（proj.ProjectCtx.cfg）绑定到 support。
// 必须在任何需要目标的代码之前调用（driver 在 proj.init() 之后）。
pub fn bind_cfg(pointer *TargetCfg) void {
    g_support.cfg = pointer
}

// target_cfg_defaults：把一份目标/配置重置为「宿主身份 + CLI 默认值」。
pub fn target_cfg_defaults(out *TargetCfg) void {
    out.target_explicit = 0
    out.opt_level = 0
    out.trimpath = 0
    out.emit_kind = 0
    out.emit_asm = 0
    out.emit_text_path = 0
    out.module_mode = 0
    out.is_entry_mod = 0
    out.dialect = TG_DIALECT_GNU
    target_host_info(&out.host_target)
    out.target = out.host_target
    if (out.target.os == TARGET_OS_DARWIN) { out.dialect = TG_DIALECT_DARWIN }
}

// module_mode / is_entry_mod：构建模式窄口（供前端查询）。
pub fn module_mode() int {
    return cfg().module_mode
}

pub fn is_entry_mod() int {
    return cfg().is_entry_mod
}

// tg_darwin：是否 Darwin 方言（符号加 `_`、取址用 @PAGE、外部走 GOT）。
pub fn tg_darwin() int {
    return (cfg().dialect == TG_DIALECT_DARWIN).to_type(int)
}

// target_arch_token：接口头行里的架构标记，与 project.arch 的写法一致。
// 头行架构必须随目标变化：此前两处写入端把它硬编码成 arm64，一旦接入
// x64 目标，头行会"说谎"，读取端又只比对字面量，等于失去目标校验。
pub fn target_arch_token() *char {
    if (cfg().target.arch == TARGET_ARCH_X64) {
        return "x64"
    }
    return "arm64"
}

// tg_host_darwin：**宿主**平台探测（进程实际运行的操作系统）——macOS 独有的
// 系统 plist（Linux 无此路径）。与 tg_darwin（输出目标方言）区分：
// open 旗标、目录类宿主文件操作按**宿主内核**语义取值，交叉目标
// （-target darwin）不得改变宿主文件操作（Linux 内核不认 Darwin 的
// O_CREAT 位值，0x601 在 Linux 上是 O_APPEND 组合）。
pub fn tg_host_darwin() int {
    let fd int = open("/System/Library/CoreServices/SystemVersion.plist", 0)
    if (fd >= 0) {
        close(fd)
        return 1
    }
    return 0
}

// tg_host_windows：**宿主**操作系统是否为 Windows。与 tg_windows（输出目标
// 方言）区分：本函数用于 PATH 分隔符、路径分隔符等**运行在本机的编译器自身**
// 的文件操作。构建时目标就是产物将来的宿主（自举交叉编译），所以用 $if
// 编译期选择即可；运行时不受 --target 影响。
pub fn tg_host_windows() int {
    $if (windows) { return 1 }
    $else { return 0 }
}

// target_resolve：严格解析当前支持的完整 triple，成功填出参，失败保持出参原值。
// LLVM 21.1.8 的布局已用固定版本 oracle 核对；这里查静态数据，check 不初始化 LLVM。
// Windows/x64 的 data_layout 是 2026-10-27 用本机 clang 21.1.8
// （`clang --target=x86_64-pc-windows-msvc -S -emit-llvm`）实测值，不要手抄别处。
pub fn target_resolve(triple *char, out *TargetInfo) int {
    let target TargetInfo
    target.pointer_bits = 64
    target.little_endian = 1
    target.layout_version = 1
    if (cstr_eq(triple, "x86_64-unknown-linux-gnu") != 0) {
        target.triple = "x86_64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_X64
        target.abi = "sysv-amd64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-unknown-linux-gnu") != 0) {
        target.triple = "aarch64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_ARM64
        target.abi = "aapcs64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-apple-darwin") != 0) {
        target.triple = "x86_64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_X64
        target.abi = "darwin-amd64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-apple-darwin") != 0) {
        target.triple = "aarch64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_ARM64
        target.abi = "darwin-aapcs64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-pc-windows-msvc") != 0) {
        // 首版 Windows 只接 x64 + MSVC ABI（零 CRT 路线，见方案 §3 D1/D2）。
        target.triple = "x86_64-pc-windows-msvc"
        target.os = TARGET_OS_WINDOWS
        target.arch = TARGET_ARCH_X64
        target.abi = "win64-msvc"
        target.data_layout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else { return -1 }
    out[0] = target
    return 0
}

// target_host_info：构建编译器时选择并固化进程身份，运行时输出 --target 不改变这些分支。
// 启动种子只需认识已有 arm64/darwin 标记；生成原生 x64 编译器时自动选择其 $else。
pub fn target_host_info(out *TargetInfo) int {
    $if (darwin) {
        $if (arm64) { return target_resolve("aarch64-apple-darwin", out) }
        $else { return target_resolve("x86_64-apple-darwin", out) }
    } $else $if (windows) {
        // Windows 宿主（W2-1）：首版只接 x64；arm64 宿主留给矩阵收尾阶段。
        $if (arm64) { return -1 }
        $else { return target_resolve("x86_64-pc-windows-msvc", out) }
    } $else {
        $if (arm64) { return target_resolve("aarch64-unknown-linux-gnu", out) }
        $else { return target_resolve("x86_64-unknown-linux-gnu", out) }
    }
}

// target_select：只更新输出目标及过渡期旧汇编方言，不能写宿主身份。
pub fn target_select(triple *char) int {
    let target TargetInfo
    if (target_resolve(triple, &target) != 0) { return -1 }
    cfg().target = target
    cfg().dialect = target.os == TARGET_OS_DARWIN ? TG_DIALECT_DARWIN : TG_DIALECT_GNU
    return 0
}

// target_select_os_arch：按项目清单的 os/arch 选择目标；0 表示使用宿主身份。
// 只允许已支持的 Linux/Darwin × ARM64/x64 与 Windows × x64 组合。
pub fn target_select_os_arch(os int, arch int) int {
    if (os == 0) { os = cfg().host_target.os }
    if (arch == 0) { arch = cfg().host_target.arch }
    if (os == TARGET_OS_LINUX) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-unknown-linux-gnu") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-unknown-linux-gnu") }
        return -1
    }
    if (os == TARGET_OS_DARWIN) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-apple-darwin") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-apple-darwin") }
        return -1
    }
    // Windows：首版只有 x64；ARM64 留给矩阵收尾阶段（方案 §8 W3）。
    if (os == TARGET_OS_WINDOWS) {
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-pc-windows-msvc") }
        return -1
    }
    return -1
}

// target_matches_host：当前输出目标是否与编译器宿主平台一致。
pub fn target_matches_host() int {
    if (cfg().target.os != cfg().host_target.os) { return 0 }
    if (cfg().target.arch != cfg().host_target.arch) { return 0 }
    return 1
}

// fc：前端瞬时状态窄口。
pub fn fc() *FrontCtx {
    return &g_front
}

// vk_msg：错误码 → 诊断文案；未知码返回通用文案（不应发生）。
pub fn vk_msg(code int) *char {
    if (code == VK_INT_OVERFLOW) { return "编译期整数运算溢出" }
    if (code == VK_DIV_ZERO) { return "编译期除数不能为零" }
    if (code == VK_UNSUPPORTED_INT_OP) { return "编译期不支持该整数运算" }
    if (code == VK_LIT_OUT_OF_RANGE) { return "字面量超出目标类型可表示范围" }
    if (code == VK_FP_UNSUPPORTED_OP) { return "浮点不支持该运算" }
    if (code == VK_ARITH_NEEDS_INT) { return "编译期算术运算要求整数" }
    if (code == VK_SHIFT_OUT_OF_WIDTH) { return "编译期移位超出位宽" }
    if (code == VK_UNARY_FP_OP) { return "浮点只支持一元 +/-" }
    if (code == VK_UNARY_NEEDS_INT) { return "编译期一元运算要求整数" }
    if (code == VK_AGG_MISMATCH) { return "聚合类型不匹配（长度或元素类型不同）" }
    if (code == VK_PTR_MISMATCH) { return "指针类型不匹配（需要 .to_type 显式转换）" }
    if (code == VK_NON_PTR_TO_PTR) { return "不能把非指针值赋给指针" }
    if (code == VK_PTR_TO_NON_PTR) { return "不能把指针赋给非指针（用 .to_type）" }
    if (code == VK_FN_SIG_MISMATCH) { return "函数签名不匹配" }
    if (code == VK_FN_VALUE_MISMATCH) { return "fn 值只能赋给同签名类型或 *void" }
    if (code == VK_FP_NEEDS_CAST) { return "浮点与整数之间需要 .to_type 显式转换" }
    if (code == VK_INT_TO_BOOL) { return "整数不能隐式转为 bool（用 .to_type(bool)）" }
    if (code == VK_BOOL_TO_TYPE) { return "bool 不能隐式转为该类型" }
    if (code == VK_TYPE_MISMATCH) { return "类型不匹配" }
    if (code == VK_SAME_WIDTH_NEEDS_CAST) { return "同宽整数之间需要 .to_type 显式转换" }
    if (code == VK_IMPLICIT_NARROW) { return "不允许的隐式窄化（用 .to_type）" }
    if (code == VK_CONST_DIV_ZERO) { return "常量除以零" }
    if (code == VK_CONST_MOD_ZERO) { return "常量模零" }
    return "编译期值运算失败"
}

// sem_fold_const_binop：按 yh 整数类型执行有边界的常量二元运算。
pub fn vk_fold_binop(op int, tid int, left i64, right i64, result *i64) int {
    if (ty_is_float(tid) != 0) {
        return vk_fold_float_binop(op, tid, left, right, result)
    }
    if (ty_is_integer(tid) == 0) { return VK_ARITH_NEEDS_INT }
    let bits int = ms().types[tid].size * 8
    let is_signed_ty int = ty_is_signed(tid)
    let a i64 = sem_fold_norm(tid, left)
    let b i64 = sem_fold_norm(tid, right)
    let is_cmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ).to_type(int)
    if (is_cmp != 0) {
        let yes int = 0
        if (op == TK_EQEQ) { yes = (a == b).to_type(int) }
        else if (op == TK_NEQ) { yes = (a != b).to_type(int) }
        else if (is_signed_ty != 0 && op == TK_LT) { yes = (a < b).to_type(int) }
        else if (is_signed_ty != 0 && op == TK_LEQ) { yes = (a <= b).to_type(int) }
        else if (is_signed_ty != 0 && op == TK_GT) { yes = (a > b).to_type(int) }
        else if (is_signed_ty != 0 && op == TK_GEQ) { yes = (a >= b).to_type(int) }
        else {
            let ua u64 = a.to_type(u64)
            let ub u64 = b.to_type(u64)
            if (op == TK_LT) { yes = (ua < ub).to_type(int) }
            else if (op == TK_LEQ) { yes = (ua <= ub).to_type(int) }
            else if (op == TK_GT) { yes = (ua > ub).to_type(int) }
            else if (op == TK_GEQ) { yes = (ua >= ub).to_type(int) }
        }
        *result = yes.to_type(i64)
        return 0
    }
    if (op == TK_LSHIFT || op == TK_RSHIFT) {
        if (right < 0 || right >= bits.to_type(i64)) {
            return VK_SHIFT_OUT_OF_WIDTH
        }
        let count int = right.to_type(int)
        if (op == TK_RSHIFT) {
            if (is_signed_ty != 0) { *result = a >> count }
            else { *result = (a.to_type(u64) >> count).to_type(i64) }
            return 0
        }
        if (is_signed_ty != 0) {
            if (a < 0) { return VK_INT_OVERFLOW }
            let max_s i64 = 9223372036854775807
            if (bits == 8) { max_s = 127 }
            else if (bits == 16) { max_s = 32767 }
            else if (bits == 32) { max_s = 2147483647 }
            if (a > (max_s >> count)) { return VK_INT_OVERFLOW }
            *result = a << count
            return 0
        }
        let max_u u64 = (-1).to_type(u64)
        if (bits == 8) { max_u = 255 }
        else if (bits == 16) { max_u = 65535 }
        else if (bits == 32) { max_u = 4294967295 }
        let ua u64 = a.to_type(u64)
        if (ua > (max_u >> count)) { return VK_INT_OVERFLOW }
        *result = sem_fold_norm(tid, (ua << count).to_type(i64))
        return 0
    }
    if (op == TK_AMP || op == TK_PIPE || op == TK_CARET) {
        let raw i64 = 0
        let rc int = fold_binop(op, a, b, &raw)
        if (rc != 0) { return rc }
        *result = sem_fold_norm(tid, raw)
        return 0
    }
    if (is_signed_ty != 0) {
        let max_s i64 = 9223372036854775807
        if (bits == 8) { max_s = 127 }
        else if (bits == 16) { max_s = 32767 }
        else if (bits == 32) { max_s = 2147483647 }
        let min_s i64 = 0 - max_s - 1
        if (op == TK_PLUS) {
            if ((b > 0 && a > max_s - b) || (b < 0 && a < min_s - b)) {
                return VK_INT_OVERFLOW
            }
            *result = a + b
        } else if (op == TK_MINUS) {
            if ((b < 0 && a > max_s + b) || (b > 0 && a < min_s + b)) {
                return VK_INT_OVERFLOW
            }
            *result = a - b
        } else if (op == TK_STAR) {
            if (a > 0 && ((b > 0 && a > max_s / b) || (b < 0 && b < min_s / a))) {
                return VK_INT_OVERFLOW
            }
            if (a < 0 && ((b > 0 && a < min_s / b) || (b < 0 && a < max_s / b))) {
                return VK_INT_OVERFLOW
            }
            *result = a * b
        } else if (op == TK_SLASH || op == TK_PERCENT) {
            if (b == 0) { return VK_DIV_ZERO }
            if (a == min_s && b == -1) { return VK_INT_OVERFLOW }
            if (op == TK_SLASH) { *result = a / b }
            else { *result = a % b }
        } else {
            return VK_UNSUPPORTED_INT_OP
        }
        return 0
    }
    let max_u u64 = (-1).to_type(u64)
    if (bits == 8) { max_u = 255 }
    else if (bits == 16) { max_u = 65535 }
    else if (bits == 32) { max_u = 4294967295 }
    let ua u64 = a.to_type(u64)
    let ub u64 = b.to_type(u64)
    if (op == TK_PLUS) {
        if (ua > max_u - ub) { return VK_INT_OVERFLOW }
        *result = sem_fold_norm(tid, (ua + ub).to_type(i64))
    } else if (op == TK_MINUS) {
        if (ua < ub) { return VK_INT_OVERFLOW }
        *result = sem_fold_norm(tid, (ua - ub).to_type(i64))
    } else if (op == TK_STAR) {
        if (ub != 0 && ua > max_u / ub) { return VK_INT_OVERFLOW }
        *result = sem_fold_norm(tid, (ua * ub).to_type(i64))
    } else if (op == TK_SLASH || op == TK_PERCENT) {
        if (ub == 0) { return VK_DIV_ZERO }
        if (op == TK_SLASH) { *result = (ua / ub).to_type(i64) }
        else { *result = (ua % ub).to_type(i64) }
    } else {
        return VK_UNSUPPORTED_INT_OP
    }
    return 0
}

// sem_fold_const_unary：按目标类型执行常量一元运算，并允许最小值的直接负数字面量。
// 浮点取负走符号位翻转，避免生成冻结子集之外的 fneg。
pub fn vk_fold_unary(op int, tid int, value i64, is_lit int, result *i64) int {
    if (ty_is_float(tid) != 0) {
        if (op == TK_MINUS) {
            *result = value ^ (1.to_type(i64) << 63)
            return 0
        }
        if (op == TK_PLUS) { *result = value; return 0 }
        return VK_UNARY_FP_OP
    }
    if (ty_is_integer(tid) == 0) { return VK_UNARY_NEEDS_INT }
    let bits int = ms().types[tid].size * 8
    let is_signed_ty int = ty_is_signed(tid)
    let a i64 = sem_fold_norm(tid, value)
    if (op == TK_MINUS) {
        if (is_signed_ty != 0) {
            let max_s i64 = 9223372036854775807
            if (bits == 8) { max_s = 127 }
            else if (bits == 16) { max_s = 32767 }
            else if (bits == 32) { max_s = 2147483647 }
            let min_s i64 = 0 - max_s - 1
            if (a == min_s) {
                if (is_lit != 0 && bits < 64 && value == max_s + 1) {
                    *result = min_s
                    return 0
                }
                return VK_INT_OVERFLOW
            }
            *result = 0 - a
            return 0
        }
        if (a != 0) { return VK_INT_OVERFLOW }
        *result = 0
        return 0
    }
    if (op == TK_PLUS) { *result = a; return 0 }
    if (op == TK_TILDE) { *result = sem_fold_norm(tid, ~a); return 0 }
    if (op == TK_BANG) { *result = (a == 0).to_type(i64); return 0 }
    *result = a
    return 0
}

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。
pub fn vk_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    if (dst == src) {
        return 0
    }
    let dk int = ms().types[dst].kind
    let sk int = ms().types[src].kind
    // 聚合：同型已在上面通过；不同类型（含长度不同）一律拒绝
    if ((dk == TY_STRUCT || dk == TY_UNION || dk == TY_ARRAY || dk == TY_SLICE)
        && (sk == TY_STRUCT || sk == TY_UNION || sk == TY_ARRAY || sk == TY_SLICE)) {
        // 数组是结构化类型：编译期布局会为延迟长度表达式建立独立类型项，
        // 与同元素类型、同长度的既有数组项完全等价，按内容放行。
        if (dk == TY_ARRAY && sk == TY_ARRAY
            && ms().types[dst].elem == ms().types[src].elem
            && ms().types[dst].len == ms().types[src].len) {
            return 0
        }
        return VK_AGG_MISMATCH
    }
    if (dk == TY_PTR) {
        // 字面量 0 = 空指针（最宽匹配，先判）
        if (is_lit != 0 && ival == 0) {
            return 0
        }
        if (sk == TY_PTR) {
            if (ms().types[dst].elem == TY_VOID || ms().types[src].elem == TY_VOID) {
                return 0
            }
            return VK_PTR_MISMATCH
        }
        if (sk == TY_FN && ms().types[dst].elem == TY_VOID) {
            return 0
        }
        return VK_NON_PTR_TO_PTR
    }
    if (sk == TY_PTR) {
        return VK_PTR_TO_NON_PTR
    }
    if (dk == TY_FN || sk == TY_FN) {
        if (dk == TY_FN && sk == TY_FN) {
            return VK_FN_SIG_MISMATCH
        }
        return VK_FN_VALUE_MISMATCH
    }
    if (ty_is_float(dst) != 0 || ty_is_float(src) != 0) {
        if (dk == sk) {
            return 0
        }
        return VK_FP_NEEDS_CAST
    }
    if (dk == TY_BOOL && sk != TY_BOOL) {
        return VK_INT_TO_BOOL
    }
    if (sk == TY_BOOL && ty_is_integer(dst) == 0 && dk != TY_BOOL) {
        return VK_BOOL_TO_TYPE
    }
    if (ty_is_integer(dst) == 0 || ty_is_integer(src) == 0) {
        return VK_TYPE_MISMATCH
    }
    let dsz int = ms().types[dst].size
    let ssz int = ms().types[src].size
    if (is_lit != 0) {
        if (big != 0 && dk != TY_U64) {
            return VK_LIT_OUT_OF_RANGE
        }
        if (sem_lit_fits(dst, ival) != 0) {
            return 0
        }
        return VK_LIT_OUT_OF_RANGE
    }
    if (dsz > ssz) {
        return 0
    }
    if (dsz == ssz) {
        if (dk == sk) {
            return 0
        }
        if (dk == TY_ENUM || sk == TY_ENUM) {
            return 0
        }
        return VK_SAME_WIDTH_NEEDS_CAST
    }
    return VK_IMPLICIT_NARROW
}

// ty_is_integer：整数类（bool..u64 与 enum）。
pub fn ty_is_integer(tid int) int {
    let k int = ms().types[tid].kind
    if (k >= TY_BOOL && k <= TY_U64) { return 1 }
    return (k == TY_ENUM).to_type(int)
}

// ty_is_signed：有符号整数类（char..i64 与 enum）。
pub fn ty_is_signed(tid int) int {
    let k int = ms().types[tid].kind
    return ((k >= TY_CHAR && k <= TY_I64) || k == TY_ENUM).to_type(int)
}

// ty_is_float：f32/f64。
pub fn ty_is_float(tid int) int {
    let k int = ms().types[tid].kind
    return (k == TY_F32 || k == TY_F64).to_type(int)
}

// sem_fold_norm：把常量按目标整数类型截断，并对有符号值做符号扩展。
pub fn sem_fold_norm(tid int, value i64) i64 {
    let bits int = ms().types[tid].size * 8
    if (bits >= 64) { return value }
    let mask u64 = (1.to_type(u64) << bits) - 1.to_type(u64)
    let raw u64 = value.to_type(u64) & mask
    if (ty_is_signed(tid) != 0) {
        let sign u64 = 1.to_type(u64) << (bits - 1)
        if ((raw & sign) != 0) { return (raw | ~mask).to_type(i64) }
    }
    return raw.to_type(i64)
}

// sem_fold_fp_to_int：按目标符号性向零转换到完整 64 位值域，再按源级目标宽度截断。
// 常量折叠和 typed CT 共用，避免无符号高位先经过 i64 饱和而丢失；NaN/越界沿用宿主饱和规则。
pub fn sem_fold_fp_to_int(tid int, value f64) i64 {
    if (ty_is_signed(tid) != 0) { return sem_fold_norm(tid, value.to_type(i64)) }
    return sem_fold_norm(tid, value.to_type(u64).to_type(i64))
}

// sem_fold_float_convert：常量浮点转换（整数↔浮点、浮点↔浮点），结果写位模式。
pub fn sem_fold_float_convert(src_tid int, dst_tid int, bits i64) i64 {
    let src_fp int = ty_is_float(src_tid)
    let dst_fp int = ty_is_float(dst_tid)
    if (src_fp != 0) {
        let source f64 = fp64_from_bits(bits)
        if (dst_fp != 0) { return fp64_norm_bits(dst_tid, source) }
        return sem_fold_fp_to_int(dst_tid, source)
    }
    if (dst_fp == 0) { return bits }
    let widened f64 = 0.0
    if (ty_is_signed(src_tid) != 0) {
        widened = bits.to_type(f64)
    } else {
        widened = bits.to_type(u64).to_type(f64)
    }
    return fp64_norm_bits(dst_tid, widened)
}

pub fn fp64_bits(v f64) i64 {
    let holder *f64 = alloc(8).to_type(*f64)
    holder[0] = v
    let pb *i64 = holder.to_type(*i64)
    let r i64 = pb[0]
    free(holder.to_type(*void))
    return r
}

// fp64_from_bits：把 IEEE754 位模式还原为宿主 f64，供常量折叠使用。
pub fn fp64_from_bits(bits i64) f64 {
    let holder *i64 = alloc(8).to_type(*i64)
    holder[0] = bits
    let view *f64 = holder.to_type(*f64)
    let value f64 = view[0]
    free(holder.to_type(*void))
    return value
}

// fp32_bits：把 IEEE754 双精度位模式窄化为单精度 32 位模式（低位对齐）。
// 编译期浮点值统一以双精度位模式保存（见 fp64_norm_bits），而 f32 对象的
// 初始化字节只有 4 字节；直接截低 4 字节会丢掉指数位，必须真正转一次 f32。
// 低层静态数据与 lowering 的全局初始化共用本函数，避免两份窄化实现漂移。
pub fn fp32_bits(bits i64) i64 {
    let holder *f32 = alloc(4).to_type(*f32)
    if (holder == 0) { return 0 }
    holder[0] = fp64_from_bits(bits).to_type(f32)
    let view *i32 = holder.to_type(*i32)
    let result i64 = view[0].to_type(i64)
    free(holder.to_type(*void))
    return result
}

// fp64_norm_bits：按目标浮点类型规范化位模式；f32 经一次往返窄化到单精度。
pub fn fp64_norm_bits(tid int, value f64) i64 {
    if (ms().types[tid].kind == TY_F32) {
        return fp64_bits(value.to_type(f32).to_type(f64))
    }
    return fp64_bits(value)
}

pub fn sem_res_const(r *Res, tid int, v i64) int {
    r.type_id = tid
    r.is_const = 1
    r.ival = v
    r.sym = -1
    r.is_lit = 0
    r.lit_big = 0
    r.ast_id = -1
    r.layout_type_id = -1
    r.ct_diag = 0
    r.ct_diag_expr = -1
    r.ct_diag_line = 0
    r.ct_diag_col = 0
    r.ct_diag_msg_start = -1
    r.ct_diag_msg_len = 0
    return 0
}

// sem_struct_finish：结构体/联合体字段登记完成后结算布局，写回类型行。
// 布局算法在 support/model 的 layout.yh；本函数只做「读字段表 → 算 → 写回」。
pub fn sem_struct_finish(stid int, is_union int) int {
    let sub int = ms().types[stid].sub
    let n int = ms().types[stid].len
    let size int = 0
    let align int = 0
    if (model_layout_struct(sub, n, is_union, &size, &align) != 0) { return -1 }
    ms().types[stid].size = size
    ms().types[stid].align = align
    return 0
}

// argv_utf8_rebuild：平台无关入口；实现见 argv.<平台>.yh 的 argv_utf8_rebuild_impl。
pub fn argv_utf8_rebuild(argc_out *int, argv_out ***char) {
    argv_utf8_rebuild_impl(argc_out, argv_out)
}

// clock_ns：平台无关入口；实现见 clock.<平台>.yh 的 clock_ns_impl。
pub fn clock_ns() u64 {
    return clock_ns_impl()
}

// console_utf8_init：平台无关入口；实现见 console.<平台>.yh 的 console_utf8_init_impl。
pub fn console_utf8_init() {
    console_utf8_init_impl()
}

// clock_ns：Windows/x64 宿主的单调时钟（W2-3a；与 clock.<os>.yh 同位置）。
//
// 用 QueryPerformanceCounter（内核提供的单调计数器）与 QueryPerformanceFrequency
// 换算纳秒；不用 GetTickCount64（毫秒精度不够看构建阶段耗时）。
//
// 换算顺序很重要：先做 秒=计数/频率、余=计数%频率，再算 ns，
// 避免 counter*1e9 在长时间运行后溢出 u64（10 MHz 计数器约 30 分钟就会溢出）。
@[extern] fn QueryPerformanceCounter(counter *i64) i32

@[extern] fn QueryPerformanceFrequency(frequency *i64) i32

@[extern] fn SetConsoleOutputCP(code u32) i32

@[extern] fn SetConsoleCP(code u32) i32

@[extern] fn GetCommandLineW() *i16

@[extern] fn WideCharToMultiByte(code_page u32, flags u32, wide *i16, wide_len int, out *u8, out_cap int, default_char *void, used_default *void) int

// C ABI 位置分类种类；算法在 check/abi_c.yh 里消费这些常量。
pub const CABI_GPR int = 0

pub const CABI_FPR int = 1

pub const CABI_STACK int = 2

pub const CABI_VOID int = 3

