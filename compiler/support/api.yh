pub fn ctl() *BuildCtl {
    return &g_support.ctl
}

// src_ctx：源文件上下文窄口；返回单例中的 src 指针。
pub fn src_ctx() *SourceCtx {
    return &g_support.src
}

// pool_ctx：名字池上下文窄口；返回单例中的 pool 指针。
pub fn pool_ctx() *PoolCtx {
    return &g_support.pool
}

// session：会话开关窄口；返回单例中的 session 指针。
pub fn session() *SessionCtx {
    return &g_support.session
}

// data_label：当前可用的下一个标签号。
pub fn data_label() int {
    return g_support.session.data_label
}

// data_label_advance：取当前标签号并推进一位（返回分配到的标签）。
pub fn data_label_advance() int {
    let lbl int = g_support.session.data_label
    g_support.session.data_label += 1
    return lbl
}

// data_label_set：把计数器设到 v（跳号/回滚用）。
pub fn data_label_set(v int) void {
    g_support.session.data_label = v
}

// data_label_reset：会话开始复位（0 保留给 NULL）。
pub fn data_label_reset() void {
    g_support.session.data_label = 1
}

// append_byte：向 buf 的 n 处写入一个字节，返回新的写入位置。
// 仅用于栈上小缓冲（诊断消息拼装），不做容量检查——调用方保证空间。
pub fn append_byte(buf *u8, n int, b u8) int {
    buf[n] = b
    return n + 1
}

// append_str：向 buf 追加一个 NUL 结尾字符串（不含结尾 NUL），返回新位置。
// 不做容量检查；调用方必须保证 buf 至少还有 cstr_len(s) 字节。
pub fn append_str(buf *u8, n int, s *char) int {
    let i int = 0
    for s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// cstr_len：C 字符串长度（不含结尾 NUL）。
// 接口头行等固定前缀用它代替手写字节数常量，避免字面量与长度常量漂移。
pub fn cstr_len(s *char) int {
    let i int = 0
    for s[i] != 0 {
        i += 1
    }
    return i
}

// append_str_limit：向 buf 追加字符串，最多写到 limit 之前，返回新位置。
// 用于包含源代码消息的诊断拼装，避免长输入写出固定缓冲区边界。
pub fn append_str_limit(buf *u8, n int, limit int, s *char) int {
    let i int = 0
    for s[i] != 0 && n < limit {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// append_int：向 buf 追加十进制整数（含负号），返回新位置。
// 行号/列号规模远小于 2^31，不处理 INT_MIN 取负溢出。
pub fn append_int(buf *u8, n int, v int) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf
    let tmp [12]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// append_i64：向 buf 追加十进制 64 位整数（含负号），返回新位置。
// append_int 的实参是 32 位 int，超过 2^31 的值会被静默截断——构建统计里的
// 纳秒计时正好跨在这条线上（2.147 s 以上就翻负），故 64 位量一律走这里。
// 与 append_int 一样不处理 INT64_MIN 取负溢出。
pub fn append_i64(buf *u8, n int, v i64) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf（i64 最长 19 位数字 + 符号）
    let tmp [24]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// write_all：把 buf 前 n 个字节全部写到 fd。
// write 可能短写（返回实际写出字节数），循环推进直到写完；负返回视为错误。
// 返回 0 成功、-1 表示 write 失败（不重试 EINTR，调用方按编译失败处理）。
pub fn write_all(fd int, buf *u8, n int) int {
    let done int = 0
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64))
        if (w <= 0) {
            return -1
        }
        done += w.to_type(int)
    }
    return 0
}

// alloc：统一分配入口（A0d）。
//
// 编译器在内存耗尽后无法继续：与其让调用方解引用空指针、在任意深处
// 无声崩溃，不如在这里写一条确定诊断并终止。这是编译器里**唯一**的
// 进程级退出点；新增分配一律走这里，不再逐点重复判空。
// 返回非 0 指针，调用方按需 `.to_type(*T)` 转换。
pub fn alloc(size u64) *u8 {
    let p *u8 = malloc(size).to_type(*u8)
    if (p == 0) {
        errors.fail("内存不足，无法继续")
        exit(1)
    }
    return p
}

// task_buf_reserve：任务私有缓冲的统一倍增扩容（RS1b）。
// 任务生命期持有、不在任务内释放；扩容后旧块不复用，需要跨扩容稳定的指针
// 必须整体重写后重新取。返回 0 表示分配失败；need 按字节总数（含 NUL）传入。
pub fn task_buf_reserve(buf **u8, cap *int, need int) *u8 {
    if (*buf != 0 && *cap >= need) {
        return *buf
    }
    let ncap int = *cap * 2
    if (ncap < need) {
        ncap = need
    }
    if (ncap < 256) {
        ncap = 256
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return 0
    }
    *buf = nd
    *cap = ncap
    return nd
}

// append_str_cap：容量受限追加字符串，返回新的长度（写满即止）。
pub fn append_str_cap(buf *u8, cap int, n int, s *char) int {
    let i int = 0
    for n < cap - 1 && s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// append_byte_cap：容量受限追加单字节，返回新的长度（写满即止）。
pub fn append_byte_cap(buf *u8, cap int, n int, b u8) int {
    if (n >= cap - 1) { return n }
    buf[n] = b
    n += 1
    buf[n] = 0
    return n
}

// append_int_cap：容量受限追加十进制整数，返回新的长度（写满即止）。
pub fn append_int_cap(buf *u8, cap int, n int, v int) int {
    let tmp [24]u8
    let m int = 0
    let x int = v
    if (x < 0) {
        n = append_byte_cap(buf, cap, n, '-')
        x = -x
    }
    if (x == 0) { return append_byte_cap(buf, cap, n, '0') }
    for x > 0 && m < 24 {
        tmp[m] = (x % 10 + 48).to_type(u8)
        m += 1
        x = x / 10
    }
    for m > 0 {
        m -= 1
        n = append_byte_cap(buf, cap, n, tmp[m])
    }
    return n
}

// cstr_eq：按字节比较两个 NUL 结尾字符串，相等返回 1、不等返回 0。
// prelude 没有 strcmp，这里手写；仅用于命令行参数/模块名比对。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0
    for 1 {
        if (a[i] != b[i]) {
            return 0
        }
        if (a[i] == 0) {
            return 1
        }
        i += 1
    }
    return 0
}

// arr_cstr：把字节缓冲当作 NUL 结尾 C 字符串取 *char。
// 注意：数组局部不可直接 `.to_type(*char)`（接收者语义不同），必须先
// 作参数传递完成退化（本函数的 buf 参数），再对指针做类型转换。
pub fn arr_cstr(buf *u8) *char {
    return buf.to_type(*char)
}

// out_grow：把 data/cap 指向的缓冲扩容到至少能容纳 need 字节。
// 成功返回 0，分配失败输出诊断并返回 -1；成功后 *data/*cap 已更新。
pub fn out_grow(data **u8, n int, cap *int, need int) int {
    if (n < *cap) {
        return 0
    }
    let ncap int = *cap * 2
    if (ncap == 0) {
        ncap = 65536
    }
    if (ncap < need) {
        ncap = need
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return errors.fail("内存分配失败")
    }
    if (n > 0) {
        memcpy(nd, *data, n.to_type(u64))
    }
    free(*data)
    *data = nd
    *cap = ncap
    return 0
}

// hexval：十六进制字符转数值（0-9/a-f/A-F）；调用方保证输入在此集合内。
pub fn hexval(b u8) int {
    if (b >= '0' && b <= '9') {
        return (b - '0').to_type(int)
    }
    if (b >= 'a' && b <= 'f') {
        return ((b - 'a') + 10).to_type(int)
    }
    return ((b - 'A') + 10).to_type(int)
}

// fs：文件作用域窄口。
pub fn fs() *FileScope {
    return &g_fscope
}

// fscope_reset：把归属与导入表清零（state_init 调用；旧缓冲由持有方先释放）。
pub fn fscope_reset() void {
    g_fscope.has_module = 0
    g_fscope.name_off = -1
    g_fscope.name_len = 0
    g_fscope.imports = 0
    g_fscope.import_n = 0
    g_fscope.import_cap = 0
    g_fscope.import_mod = 0
    g_fscope.import_used = 0
    g_fscope.mods = 0
    g_fscope.mod_n = 0
    g_fscope.mod_cap = 0
    g_fscope.mod_home_next = 0
    g_fscope.sym_sfx_off = -1
    g_fscope.sym_sfx_len = 0
}

// front_checked_begin：进入受检前端；重复进入报内部错误。
pub fn front_checked_begin() int {
    if (g_support.session.front_checked != 0) {
        return errors.fail("内部错误：受检前端阶段重复进入")
    }
    g_support.session.front_checked = 1
    return 0
}

// front_checked_verify：核对阶段仍在受检模式；0 = 仍在受检阶段。
pub fn front_checked_verify() int {
    if (g_support.session.front_checked == 0) {
        return errors.fail("内部错误：不在受检阶段")
    }
    return 0
}

// front_checked_end：成功检验后退出阶段；失败保留禁发状态。
pub fn front_checked_end() int {
    if (front_checked_verify() != 0) { return -1 }
    g_support.session.front_checked = 0
    return 0
}

pub fn model_layout_struct(first int, n int, is_union int,
    out_size *int, out_align *int) int {
    let off int = 0
    let maxal int = 1
    let maxsz int = 0
    let i int = 0
    for i < n {
        let ftid int = ms().fields[first + i].type_id
        let fsz int = ms().types[ftid].size
        let fal int = ms().types[ftid].align
        if (fal > maxal) {
            maxal = fal
        }
        if (is_union != 0) {
            ms().fields[first + i].offset = 0
        } else {
            // 向上取整到字段对齐
            let pad int = (0 - off) % fal
            if (pad < 0) {
                pad += fal
            }
            off += pad
            ms().fields[first + i].offset = off
            off += fsz
        }
        if (fsz > maxsz) {
            maxsz = fsz
        }
        i += 1
    }
    let size int = 0
    if (is_union != 0) {
        size = maxsz
    } else {
        size = off
    }
    // 结构体大小向上取整到自身对齐
    let rpad int = (0 - size) % maxal
    if (rpad < 0) {
        rpad += maxal
    }
    size += rpad
    out_size[0] = size
    out_align[0] = maxal
    return 0
}

// ms：语义表存储窄口。
pub fn ms() *ModelStore {
    return &g_model
}

// mstore_reset：把存储整体清零（state_init 调用；旧缓冲由既有代码先释放）。
pub fn mstore_reset() void {
    g_model.types = 0
    g_model.type_n = 0
    g_model.type_cap = 0
    g_model.fields = 0
    g_model.field_n = 0
    g_model.field_cap = 0
    g_model.sig_abi = 0
    g_model.sig_acap = 0
    g_model.sig_ret = 0
    g_model.sig_np = 0
    g_model.sig_vararg = 0
    g_model.sig_first = 0
    g_model.sig_params = 0
    g_model.sig_n = 0
    g_model.sig_rcap = 0
    g_model.sig_ncap = 0
    g_model.sig_vcap = 0
    g_model.sig_fcap = 0
    g_model.sigparam_n = 0
    g_model.sigparam_cap = 0
    g_model.names = 0
    g_model.name_n = 0
    g_model.name_cap = 0
    g_model.aggtype_n = 0
    g_model.cur_enum = -1
    g_model.cur_struct = -1
    g_model.name_form = 0
    g_model.home = 0
    g_model.home_cap = 0
