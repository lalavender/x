module support

// ============================================================================
// model_store.yh —— 前端语义表的存储（类型/签名/具名类型/符号）
//
// 这些表原本是 support.FrontCtx 的字段。它们的**操作**（ty_push/ty_array/sym_push/
// scope_push…）是语义规则，仍归 check/gen；这里只持有存储：指针、行数与容量。
//
// 为什么放 support：表被 parse/check/comptime/gen 共用，而 comptime 不允许
// 依赖 check。support 是唯一在所有消费方之下的模块，且这些表不含 I/O 语义。
// 迁移沿用「保留同名窄口」：所有读写点改 ms()，表内容仍按需扩容。
// ============================================================================

// g_model：前端语义表存储单例（worker 进程内一份）。
let g_model ModelStore

// AGGTYPE_LIMIT：聚合类型登记上限（方案 §4；超出必须干净报错，不能越界）。
const AGGTYPE_LIMIT int = 512

