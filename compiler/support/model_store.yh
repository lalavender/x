module support

// ============================================================================
// model_store.yh —— 前端语义表的存储（类型/签名/具名类型/符号）
//
// 这些表原本是 gen.TaskCtx 的字段。它们的**操作**（ty_push/ty_array/sym_push/
// scope_push…）是语义规则，仍归 check/gen；这里只持有存储：指针、行数与容量。
//
// 为什么放 support：表被 parse/check/comptime/gen 共用，而 comptime 不允许
// 依赖 check。support 是唯一在所有消费方之下的模块，且这些表不含 I/O 语义。
// 迁移沿用「保留同名窄口」：所有读写点改 support.ms()，表内容仍按需扩容。
// ============================================================================

// ModelStore：前端语义表的全部存储。
// 生命周期 = 一个编译任务（state_init 时整体清零，释放旧缓冲）。
pub struct ModelStore {
    // —— 类型表（TY_*；内建类型占 0..12）——
    types *CType
    type_n int
    type_cap int
    // —— 结构体/联合体字段表 ——
    fields *SField
    field_n int
    field_cap int
    // —— 函数签名表（FN 类型通过 sub 引用签名号）——
    sig_abi *int // 调用约定，参与函数类型判等
    sig_acap int // ABI 表容量
    type_abi int // 当前解析的函数类型默认 ABI，签名结束后恢复
    sig_ret *int // 返回类型
    sig_np *int // 固定参数个数
    sig_vararg *int // 1 = 末尾裸变参（仅 prelude）
    sig_first *int // 参数类型池起始下标
    sig_params *int // 参数类型池
    sig_n int
    sig_rcap int
    sig_ncap int
    sig_vcap int
    sig_fcap int
    sigparam_n int
    sigparam_cap int
    // —— 类型名字空间（struct/union/enum/type 别名）——
    names *TName
    name_n int
    name_cap int
    // —— 聚合类型登记上限计数（方案 §4）——
    aggtype_n int
    // —— 正在解析的类型（parse/check 共享的「当前位置」）——
    cur_enum int // 正在解析的 enum 类型编号
    cur_struct int // 正在解析的 struct/union 类型编号
    name_form int // 当前类型登记形态：0=type 别名 1=struct 2=union 3=enum
    // —— 类型归属（跨模块 pub 字段检查；与 types 平行）——
    home *int
    home_cap int
    // —— 符号表与作用域栈 ——
    syms *CSym
    sym_n int
    sym_cap int
    scope_start *int // 每层作用域进入时的符号表下标（64 层）
    scope_n int
}

// g_model：前端语义表存储单例（worker 进程内一份）。
let g_model ModelStore

// ms：语义表存储窄口。
pub fn ms() *ModelStore {
    return &g_model
}

// mstore_reset：把存储整体清零（state_init 调用；旧缓冲由既有代码先释放）。
pub fn mstore_reset() void {
    g_model.types = 0
    g_model.type_n = 0
    g_model.type_cap = 0
    g_model.fields = 0
    g_model.field_n = 0
    g_model.field_cap = 0
    g_model.sig_abi = 0
    g_model.sig_acap = 0
    g_model.type_abi = 0
    g_model.sig_ret = 0
    g_model.sig_np = 0
    g_model.sig_vararg = 0
    g_model.sig_first = 0
    g_model.sig_params = 0
    g_model.sig_n = 0
    g_model.sig_rcap = 0
    g_model.sig_ncap = 0
    g_model.sig_vcap = 0
    g_model.sig_fcap = 0
    g_model.sigparam_n = 0
    g_model.sigparam_cap = 0
    g_model.names = 0
    g_model.name_n = 0
    g_model.name_cap = 0
    g_model.aggtype_n = 0
    g_model.cur_enum = -1
    g_model.cur_struct = -1
    g_model.name_form = 0
    g_model.home = 0
    g_model.home_cap = 0
    g_model.syms = 0
    g_model.sym_n = 0
    g_model.sym_cap = 0
    g_model.scope_start = 0
    g_model.scope_n = 0
}

// model_type_push：追加一行类型（必要时扩容类型表与归属表），返回新行号。
// 只做存储：按内容去重、内建类型登记等语义规则仍在 gen/check。
// 扩容时类型表与 home 表同步翻倍，新增归属填 -1（本地）。
pub fn model_type_push(kind int, size int, align int, elem int, n int, sub int) int {
    let m *ModelStore = ms()
    if (m.type_n == m.type_cap) {
        let ncap int = m.type_cap * 2
        if (ncap == 0) { ncap = 64 }
        let nd *CType = malloc((ncap * sizeof(CType)).to_type(u64)).to_type(*CType)
        if (nd == 0) { return fail("内存分配失败") }
        if (m.type_n > 0) {
            memcpy(nd, m.types, (m.type_n * sizeof(CType)).to_type(u64))
        }
        free(m.types)
        m.types = nd
        let nh *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nh == 0) { return fail("内存分配失败") }
        if (m.home_cap > 0) {
            memcpy(nh, m.home, (m.home_cap * sizeof(int)).to_type(u64))
        }
        if (m.home_cap > 0) { free(m.home) }
        m.home = nh
        let hi int = m.home_cap
        for hi < ncap {
            m.home[hi] = -1
            hi += 1
        }
        m.home_cap = ncap
        m.type_cap = ncap
    }
    m.types[m.type_n].kind = kind
    m.types[m.type_n].size = size
    m.types[m.type_n].align = align
    m.types[m.type_n].elem = elem
    m.types[m.type_n].len = n
    m.types[m.type_n].sub = sub
    m.type_n += 1
    return m.type_n - 1
}

// AGGTYPE_LIMIT：聚合类型登记上限（方案 §4；超出必须干净报错，不能越界）。
const AGGTYPE_LIMIT int = 512

// model_type_push_agg：追加聚合类型并检查登记上限；超限返回 -1。
pub fn model_type_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    if (ms().aggtype_n >= AGGTYPE_LIMIT) {
        return fail("聚合类型登记过多（上限 512）")
    }
    ms().aggtype_n += 1
    return model_type_push(kind, size, align, elem, n, sub)
}
