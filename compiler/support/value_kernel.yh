module support

// ============================================================================
// value_kernel.yh —— 编译期值内核（F4 收尾：从 gen 迁入）
//
// 从 gen/value_rules.yh 迁入。三个函数是 `comptime` 也需要的纯值规则，而
// `comptime → check` 会成环（check → comptime 已存在）；同时 `support` 是叶子、
// 不能 import token，所以这里**不发诊断**：遇错返回错误码（VK_*），
// 由调用方用自己的位置来源报错（check → token.err_tok，comptime → ct_err）。
//
// 消息表 vk_msg() 放在本模块：纯字符串常量，三层共用，杜绝文案漂移。
// 明确不做：不读语法、不分配、不发诊断、不碰 token 表。
// ============================================================================

// sem_fold_float_binop：常量浮点算术与比较；值为 IEEE754 位模式，
// 算术结果按目标类型窄化，比较结果写 0/1。
fn vk_fold_float_binop(op int, tid int, left i64, right i64, result *i64) int {
    let a f64 = fp64_from_bits(left)
    let b f64 = fp64_from_bits(right)
    if (op == TK_EQEQ) { *result = (a == b).to_type(i64); return 0 }
    if (op == TK_NEQ) { *result = (a != b).to_type(i64); return 0 }
    // 初始宿主仍可能由旧种子发射 lt/le；显式有序守卫让第一代候选就遵守 NaN 契约。
    if (op == TK_LT) { *result = (a == a && b == b && a < b).to_type(i64); return 0 }
    if (op == TK_LEQ) { *result = (a == a && b == b && a <= b).to_type(i64); return 0 }
    if (op == TK_GT) { *result = (a > b).to_type(i64); return 0 }
    if (op == TK_GEQ) { *result = (a >= b).to_type(i64); return 0 }
    let value f64 = 0.0
    if (op == TK_PLUS) { value = a + b }
    else if (op == TK_MINUS) { value = a - b }
    else if (op == TK_STAR) { value = a * b }
    else if (op == TK_SLASH) { value = a / b }
    else { return VK_FP_UNSUPPORTED_OP }
    *result = fp64_norm_bits(tid, value)
    return 0
}

// fold_binop：两个常量的二元运算（i64 位型）。成功返回 0 并写 out；
// 除零/模零返回对应错误码（本函数当前只被位运算分支调用，保留完整语义）。
fn fold_binop(op int, a i64, b i64, out *i64) int {
    if (op == TK_PLUS) { out[0] = a + b; return 0 }
    if (op == TK_MINUS) { out[0] = a - b; return 0 }
    if (op == TK_STAR) { out[0] = a * b; return 0 }
    if (op == TK_SLASH) {
        if (b == 0) { return VK_CONST_DIV_ZERO }
        out[0] = a / b
        return 0
    }
    if (op == TK_PERCENT) {
        if (b == 0) { return VK_CONST_MOD_ZERO }
        out[0] = a % b
        return 0
    }
    if (op == TK_AMP) { out[0] = a & b; return 0 }
    if (op == TK_PIPE) { out[0] = a | b; return 0 }
    if (op == TK_CARET) { out[0] = a ^ b; return 0 }
    if (op == TK_LSHIFT) { out[0] = a << b; return 0 }
    if (op == TK_RSHIFT) { out[0] = a >> b; return 0 }
    if (op == TK_EQEQ) { out[0] = (a == b).to_type(i64); return 0 }
    if (op == TK_NEQ) { out[0] = (a != b).to_type(i64); return 0 }
    if (op == TK_LT) { out[0] = (a < b).to_type(i64); return 0 }
    if (op == TK_LEQ) { out[0] = (a <= b).to_type(i64); return 0 }
    if (op == TK_GT) { out[0] = (a > b).to_type(i64); return 0 }
    if (op == TK_GEQ) { out[0] = (a >= b).to_type(i64); return 0 }
    return 0
}

