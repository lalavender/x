module support

// ============================================================================
// model.yh —— 前端共享的语言模型（常量 + 结构体）
//
// 这些声明原本在 gen/model.yh，但它们是 gen/check/parse/comptime/lower/ast
// 共同的语言模型，本身不携带任何「每任务状态」（t_types/c_syms 等存储仍在
// TaskCtx）。留在 gen 里会让消费方（尤其 comptime、lower）反向依赖 gen，
// 因此下沉到 support：gen 保留同名 type/const 别名，迁移可以分批做。
//
// 数值必须与历史值一致：.s.i/.s.ct 编码、CT 镜像常量（CT_TY_*/CT_SYM_*/
// CT_F_*）都按这些数逐项比对，check.ct_type_layout_ok() 会断言漂移。
// ============================================================================

// Res：一次表达式求值的结果描述符（类型、常量性、字面量与编译期诊断）。
// 语义动作边解析边求值，每个表达式节点通过 *Res 出参返回。
// 约定：is_const=1 时 ival 有效（按 i64 位型；指针常量存数据标签号）。
pub struct Res {
    type_id int        // 类型表编号（<0 不出现；错误走函数返回值）
    is_const int       // 1 = 编译期常量
    ival i64           // 常量位型值；字符串/指针常量存数据标签号
    sym int            // 裸名字引用时的符号表下标，否则 -1（直接调用优化用）
    is_lit int         // 1 = 文本字面量（参与隐式窄化范围检查）
    lit_big int        // 1 = 字面量超出 i64 正数域（仅 u64 目标可接受）
    fval_bits i64      // 浮点常量位型（IEEE754，f64 为 64 位）
    ast_id int         // 本次 check 生成的表达式 AST 节点编号；未记录为 -1
    layout_type_id int // 延迟 sizeof 的目标类型；普通表达式为 -1
    ct_diag int        // 非零表示该表达式是待语句位置消费的编译期诊断
    ct_diag_expr int   // $assert 的已解析条件表达式 AST 编号；其他诊断为 -1
    ct_diag_line int   // 诊断调用起始行
    ct_diag_col int    // 诊断调用起始列
    ct_diag_msg_start int // 消息字符串 token 在源文件中的起点；-1 表示默认消息
    ct_diag_msg_len int // 消息字符串 token 长度
}

// CType：类型表的一行。内建类型占固定编号 0..12（TY_VOID..TY_F64），
// 其后按需增长并按内容去重。
pub struct CType {
    kind int           // TY_* 种类
    size int           // 字节大小
    align int          // 字节对齐
    elem int           // PTR：目标类型；ARRAY/SLICE：元素类型
    len int            // ARRAY：长度；STRUCT/UNION：字段数；其余 -1
    sub int            // STRUCT/UNION：字段表起始下标；FN：签名号
}

// SField：结构体/联合体字段表的一行。
pub struct SField {
    name_off int       // 名字池偏移
    name_len int
    type_id int
    offset int         // 相对结构体起始的字节偏移
    is_pub int         // 恒 1（pub struct 字段一律公开）；保留以稳定 .s.i 接口格式
}

// CSym：值符号表（全局/局部/参数/函数）的一行。
pub struct CSym {
    name_off int       // 名字池偏移
    name_len int
    kind int           // SYM_*
    type_id int
    offset int         // 局部/参数：距 fp 的字节距离（地址 = fp - offset）；
                        // 全局：bss 清单下标（数据见 flags）
    flags int          // F_*
    cval i64           // 常量值位型；指针常量存数据标签号
    const_ready int    // 1 = cval 已由声明初始化，可参与编译期求值
    const_expr_off int // 可重放的直接常量字面式在名字池中的偏移；其他常量为 -1。
    const_expr_len int // 可重放常量字面式字节长度。
    const_expr_kind int // 0=无 1=浮点数字面式 2=字符串字面式。
    def_line int       // 声明点行号（模块模式重复声明诊断用）
    def_col int        // 声明点列号
    ast_binding_row int // check AST 中对应的函数内绑定行；普通构建或全局为 -1
}

// TName：类型名字空间的一行（struct/union/enum/type 别名，仅顶层声明）。
// 与 CType 平行：名字池偏移 + 类型编号 + 后端再发射所需的形态/属性/声明点。
pub struct TName {
    name_off int       // 名字池偏移
    name_len int
    type_id int
    is_pub int         // 1 = pub 类型（接口导出）
    form int           // 0=type 别名 1=struct 2=union 3=enum（接口再发射用）
    attrs int          // ATTR_*：具名类型属性（别名目标属性由类型本身保留）
    def_line int       // 声明点行号（重定义诊断用）
    def_col int
}

// PubAggDeferred：导入侧延迟执行的 pub 聚合常量（$ 调用初始化）登记项。
// .s.i 先于 .s.ct 加载，调用目标（隐藏符号）在 .s.ct 里才可见，因此把
// 初始化式执行推迟到接口闭包加载完成之后；path 存 .s.i 路径，执行时
// 重新读源与词法化后按 token 区间解析。
pub struct PubAggDeferred {
    sym int            // 常量符号编号
    first int          // 初始化式 token 区间起点
    after int          // 初始化式 token 区间终点（半开）
    path_off int       // 接口文件路径（pool 偏移），0 表示无
    path_len int
}

// —— goto 标签表（每函数重置） ——
pub struct GLabel {
    name_off int       // 名字池偏移
    name_len int
    lbl int            // 汇编标签号
    defined int        // 1 = 已见定义点
}

// —— 类型种类 ——
pub const TY_VOID int = 0
pub const TY_BOOL int = 1
pub const TY_CHAR int = 2
pub const TY_I8 int = 3
pub const TY_I16 int = 4
pub const TY_I32 int = 5
pub const TY_I64 int = 6
pub const TY_U8 int = 7
pub const TY_U16 int = 8
pub const TY_U32 int = 9
pub const TY_U64 int = 10
pub const TY_F32 int = 11
pub const TY_F64 int = 12
pub const TY_PTR int = 13
pub const TY_ARRAY int = 14
pub const TY_SLICE int = 15
pub const TY_STRUCT int = 16
pub const TY_UNION int = 17
pub const TY_ENUM int = 18
pub const TY_FN int = 19

// —— 符号种类与标志 ——
pub const SYM_VAR int = 0      // 变量（全局或局部）
pub const SYM_CONST int = 1    // 编译期常量绑定
pub const SYM_FN int = 2       // 函数
pub const F_GLOBAL int = 1     // 全局（否则局部/参数）
pub const F_PARAM int = 2      // 函数参数
pub const F_PUB int = 4        // pub（GLOBAL 绑定）
pub const F_EXTERN int = 8     // prelude 外部符号
pub const F_ADDR int = 16      // 常量的值是数据标签号（cval）
pub const F_AGGPARAM int = 32  // 聚合参数：槽内是指向调用方副本的指针
pub const F_INTRINSIC int = 64 // 由目标后端直接发射的内建调用
pub const F_LINUX_SYSCALL int = 128 // Linux AArch64 svc 内建
pub const F_RUNTIME_MEMCPY int = 256 // 本地字节复制运行时入口
pub const F_RUNTIME_STRLEN int = 512 // 本地 C 字符串长度运行时入口
pub const F_RUNTIME_MALLOC int = 1024 // 本地 OS 映射分配运行时入口
pub const F_RUNTIME_FREE int = 2048 // 本地 OS 映射释放运行时入口
pub const F_RUNTIME_PRINTF int = 4096 // 本地格式化输出运行时入口
const F_RUNTIME_USED int = 8192 // 在本模块被调用或取址的运行时入口
pub const F_CABI int = 16384 // 用户声明的 C ABI 函数或外部类型
pub const F_NORETURN int = 32768 // 正常控制流不返回
pub const F_INLINE int = 65536 // 函数内联提示
pub const F_COMPTIME int = 131072 // 编译期函数；调用必须使用 $ 函数形式
pub const F_ENUM_MEMBER int = 262144 // enum 声明登记的成员常量
pub const F_ENUM_META int = 524288 // $for enum.values 的只读迭代元信息绑定
pub const F_FIELD_META int = 1048576 // $for T.fields 的只读迭代元信息绑定
pub const F_MODULE_IMPORT int = 2097152 // 从模块接口加载的符号
//   绑定槽位约定（与 F_ENUM_META 平行）：offset = 字段下标（宿主类型 sub + offset），

// —— 编译期诊断种类（$assert/$compile_error/$compile_warn） ——
pub const CT_DIAG_ASSERT int = 1 // $assert 编译期指令
pub const CT_DIAG_ERROR int = 2 // $compile_error 编译期指令
pub const CT_DIAG_WARN int = 3 // $compile_warn 编译期指令
