module support

// ============================================================================
// abi_model.yh —— C ABI 分类的数据模型（值描述、游标、位置计划）
//
// 分类算法在 check/abi_c.yh；这里只放类型。2026-11-06 起从 gen 下沉到
// support，因为前端上下文（support/task_ctx.yh）持有 ABICursor，而 support
// 是唯一在所有消费方之下的模块。算法与模型仍分属两层：
// support 提供「签名分类的存储形状」，check 提供「怎么分类」。
// ============================================================================

// C ABI 位置分类种类；算法在 check/abi_c.yh 里消费这些常量。
pub const CABI_GPR int = 0
pub const CABI_FPR int = 1
pub const CABI_STACK int = 2
pub const CABI_VOID int = 3

// ABIValue 描述已完成 C 布局的值。fp_count=1 表示浮点标量；聚合非零时
// 表示 HFA，fp_size 为同构元素宽度。普通聚合的 fp_count 必须为零。
pub struct ABIValue {
    size int
    align int
    aggregate int
    fp_size int
    fp_count int
}

// ABICursor 保存一份签名分配到当前参数前的状态。Darwin 的栈参数使用
// 自然大小与对齐，Linux 的每个槽至少八字节；最终调用区统一十六字节对齐。
pub struct ABICursor {
    gpr int
    fpr int
    stack int
    darwin int
}

// ABIArg 是单个逻辑参数/返回值的位置计划。寄存器片连续；stack 是调用时
// SP 起的字节偏移；indirect 表示按调用方副本地址传参或按 x8 返回。
pub struct ABIArg {
    kind int
    reg int
    count int
    stack int
    indirect int
    size int
    fp_size int
}

