module support

// ============================================================================
// console.windows.yh —— Windows 控制台 UTF-8 显示（VENC，2026-11-05）。
//
// yh 的诊断/帮助文本是 UTF-8 字节；中文 Windows 控制台默认码页（GBK/936）
// 会把它按 GBK 渲染成乱码。进程启动时把输出/输入码页切到 65001（UTF-8），
// 与 git/ripgrep 等工具的 UTF-8 输出约定一致。调用是会话级的：yh 退出后
// 控制台保持 65001（Windows Terminal 下无副作用）。
//
// 管道/重定向不受码页影响——写出的始终是原始 UTF-8 字节。
// ============================================================================

@[extern] fn SetConsoleOutputCP(code u32) i32
@[extern] fn SetConsoleCP(code u32) i32

pub fn console_utf8_init() void {
    SetConsoleOutputCP(65001)
    SetConsoleCP(65001)
}
