module support

// 从 compiler/support/buffer.yh 迁出的 yh test 块（pub 声明已迁 api.yh）。

test "hexval 十进制与十六进制" {
    $assert(hexval('0') == 0)
    $assert(hexval('9') == 9)
    $assert(hexval('a') == 10)
    $assert(hexval('f') == 15)
    $assert(hexval('A') == 10)
    $assert(hexval('F') == 15)
}

test "append_int 十进制与负数" {
    let buf [16]u8
    let n int = 0
    n = append_int(buf, n, 0)
    $assert(n == 1 && buf[0] == '0')
    n = 0
    n = append_int(buf, n, 123)
    $assert(n == 3 && buf[0] == '1' && buf[2] == '3')
    n = 0
    n = append_int(buf, n, -42)
    $assert(n == 3 && buf[0] == '-' && buf[2] == '2')
}
