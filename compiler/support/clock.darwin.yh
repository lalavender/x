module support

// GenTimespec：Darwin clock_gettime 使用的 64 位秒/纳秒结构。
struct GenTimespec {
    sec i64
    nsec i64
}

// clock_ns：单调纳秒时钟。放在 gen（叶子模块）里供 build / lower / ir 共用：
// 这三层互有单向依赖，只有最底层的 gen 能被同时引用，避免每层各复制一份
// platform syscall 包装。
pub fn clock_ns() u64 {
    let stamp GenTimespec
    if (clock_gettime(6, (&stamp).to_type(*void)) != 0
        || stamp.sec < 0 || stamp.nsec < 0 || stamp.nsec >= 1000000000) {
        return 0
    }
    return stamp.sec.to_type(u64) * 1000000000.to_type(u64) +
        stamp.nsec.to_type(u64)
}
