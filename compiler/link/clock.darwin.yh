module link

// CmdTimespec：Darwin clock_gettime 使用的 64 位秒与纳秒结构。
struct CmdTimespec {
    sec i64
    nsec i64
}

// cmd_clock_ns：读取 Darwin CLOCK_MONOTONIC 并转换为单调纳秒计数。
pub fn cmd_clock_ns() u64 {
    let stamp CmdTimespec
    if (clock_gettime(6, (&stamp).to_type(*void)) != 0
        || stamp.sec < 0 || stamp.nsec < 0 || stamp.nsec >= 1000000000) {
        return 0
    }
    return stamp.sec.to_type(u64) * 1000000000.to_type(u64) +
        stamp.nsec.to_type(u64)
}
