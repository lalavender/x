module link
import support
import proj

// ============================================================================
// link_inputs.test.yh —— C2 文件内容身份测试
//
// 只由 `cd compiler && ../yh test link` 执行。验证：
//   * 同一内容重复读取身份稳定；
//   * 重写同内容（mtime 变化）身份不变；
//   * 同长度不同内容身份必须变化。
// ============================================================================

// li_test_write：覆盖写一个测试文件；0 = 成功。
fn li_test_write(path *char, text *char, count int) int {
    let fd int = proj.open_out(path)
    if (fd < 0) { return -1 }
    let rc int = support.write_all(fd, text.to_type(*u8), count)
    if (close(fd) != 0) { return -1 }
    return rc
}

// li_test_identity：计算测试文件的 64 位内容身份；0 表示读取失败。
fn li_test_identity(path *char) u64 {
    let digest u64 = proj.hash_init()
    if (mb_mix_file_identity(&digest, path) != 0) { return 0 }
    return digest
}

test "内容身份：touch/重写不变，内容变化必变" {
    $assert(cmd_mkdirs("tmp") == 0, "创建测试目录")
    let path [256]u8
    let n int = support.append_str(&path[0], 0, "tmp/link_identity_")
    n = support.append_int(&path[0], n, getpid())
    n = support.append_str(&path[0], n, ".bin")
    path[n] = 0
    let file *char = support.arr_cstr(&path[0])
    $assert(li_test_write(file, "abc", 3) == 0, "写测试文件")
    let first u64 = li_test_identity(file)
    let second u64 = li_test_identity(file)
    $assert(first != 0, "首次读取失败")
    $assert(first == second, "同内容重复读取必须稳定")
    // 覆盖写同内容：mtime 变化，内容身份必须不变。
    $assert(li_test_write(file, "abc", 3) == 0, "重写同内容")
    $assert(li_test_identity(file) == first, "重写同内容不得改变身份")
    // 同长度不同内容：身份必须变化。
    $assert(li_test_write(file, "abd", 3) == 0, "写不同内容")
    $assert(li_test_identity(file) != first, "内容变化必须改变身份")
    unlink(file)
}

// li_test_bytes_eq：比较缓冲区前 n 字节与 C 字符串；1 = 相等。
fn li_test_bytes_eq(buf *u8, n int, text *char) int {
    let i int = 0
    for i < n {
        if (text[i] == 0 || buf[i] != text[i].to_type(u8)) { return 0 }
        i += 1
    }
    return text[n] == 0 ? 1 : 0
}

// li_test_has_byte：缓冲区前 n 字节里是否有 c。
fn li_test_has_byte(buf *u8, n int, c u8) int {
    let i int = 0
    for i < n {
        if (buf[i] == c) { return 1 }
        i += 1
    }
    return 0
}

test "清单路径：环境变量展开，未定义变量按字面保留" {
    // 已定义变量（PATH 各平台必然存在且非空）必须替换成值。
    let src [128]u8
    let n int = support.append_str(&src[0], 0, "\${PATH}")
    $assert(n == 7, "源路径应为七个字节")
    let inoff int = support.tml_intern_str(&src[0], 0, n)
    $assert(inoff >= 0, "intern 源路径")
    let out [4096]u8
    let m int = li_expand_vars(-1, inoff, n, &out[0], 4096)
    $assert(m > 3, "PATH 必须展开成非空值")
    $assert(li_test_has_byte(&out[0], m, '$') == 0, "展开结果不得残留美元花括号")
    // 未定义变量：保留字面量，便于诊断直接报出该设哪个变量。
    let unset [128]u8
    let un int = support.append_str(&unset[0], 0, "\${YH_LINK_TEST_UNSET_VAR}")
    let uoff int = support.tml_intern_str(&unset[0], 0, un)
    $assert(uoff >= 0, "intern 未定义变量路径")
    let out2 [4096]u8
    let m2 int = li_expand_vars(-1, uoff, un, &out2[0], 4096)
    $assert(m2 == un, "未定义变量必须原样保留")
    $assert(li_test_bytes_eq(&out2[0], m2, support.arr_cstr(&unset[0])) != 0, "字面量必须逐字节相同")
    // 普通路径不受影响。
    let plain [128]u8
    let pn int = support.append_str(&plain[0], 0, "a/b")
    let poff int = support.tml_intern_str(&plain[0], 0, pn)
    let out3 [4096]u8
    let m3 int = li_expand_vars(-1, poff, pn, &out3[0], 4096)
    $assert(li_test_bytes_eq(&out3[0], m3, support.arr_cstr(&plain[0])) != 0, "普通路径必须原样复制")
}
