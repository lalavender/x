module link
import errors
import support
import backend
import proj

// DarwinLinkConfig：保存一次编译进程使用的 Darwin SDK 与部署身份；字符串由本模块持有。
struct DarwinLinkConfig {
    sdk_root *char
    sdk_version [32]u8
    min_os [32]u8
    min_parts [3]int
    sdk_identity [32]u8
    min_ready int
    ready int
}

let cmd_darwin_link_config DarwinLinkConfig

// cmd_darwin_version：解析两段或三段十进制版本，规范化为 major.minor.patch。
// 不接受空白、符号、空段、零主版本或超过 9999 的组件。
fn cmd_darwin_version(value *u8, length int, output *u8,
    parts *int) int {
    if (value == 0 || output == 0 || parts == 0 || length <= 0 || length >= 32) {
        return -1
    }
    let numbers [3]int
    let count int = 0
    let current int = 0
    let i int = 0
    for i < length {
        let byte u8 = value[i]
        if (byte >= '0' && byte <= '9') {
            current = current * 10 + (byte - '0').to_type(int)
            if (current > 9999) { return -1 }
        } else if (byte == '.' && count < 2) {
            if (i == 0 || value[i - 1] == '.') { return -1 }
            numbers[count] = current
            count += 1
            current = 0
        } else { return -1 }
        i += 1
    }
    if (value[length - 1] == '.') { return -1 }
    numbers[count] = current
    count += 1
    if (count < 2 || count > 3 || numbers[0] == 0) { return -1 }
    if (count == 2) { numbers[2] = 0 }
    let written int = support.append_int(output, 0, numbers[0])
    written = support.append_byte(output, written, '.')
    written = support.append_int(output, written, numbers[1])
    written = support.append_byte(output, written, '.')
    written = support.append_int(output, written, numbers[2])
    output[written] = 0
    parts[0] = numbers[0]; parts[1] = numbers[1]; parts[2] = numbers[2]
    return 0
}

// cmd_darwin_version_compare：按三个数值分量比较版本，返回 -1/0/1。
fn cmd_darwin_version_compare(left *int, right *int) int {
    let i int = 0
    for i < 3 {
        if (left[i] < right[i]) { return -1 }
        if (left[i] > right[i]) { return 1 }
        i += 1
    }
    return 0
}

// cmd_darwin_sdk_settings：读取 SDKSettings.json 的 Version 字段，限制文件大小并做版本校验。
fn cmd_darwin_sdk_settings(root *char, version *u8, identity *u8,
    parts *int) int {
    if (root == 0 || version == 0 || identity == 0 || parts == 0) { return -1 }
    let path [4096]u8
    let length int = strlen(root).to_type(int)
    if (length <= 0 || length > 4000) { return -1 }
    let i int = 0
    for i < length { path[i] = root[i].to_type(u8); i += 1 }
    if (path[length - 1] != '/') {
        path[length] = '/'; length += 1
    }
    let suffix *char = "SDKSettings.json"
    let j int = 0
    for suffix[j] != 0 { path[length + j] = suffix[j].to_type(u8); j += 1 }
    path[length + j] = 0
    let fd int = open(support.arr_cstr(path), 0)
    if (fd < 0) { return -1 }
    let data [65536]u8
    let total int = 0
    let overflow int = 0
    for 1 {
        let got i64 = read(fd, (&data[total]).to_type(*u8),
            (65535 - total).to_type(u64))
        if (got < 0) { overflow = 1; break }
        if (got == 0) { break }
        total += got.to_type(int)
        if (total >= 65535) { overflow = 1; break }
    }
    close(fd)
    if (overflow != 0 || total == 0) { return -1 }
    data[total] = 0

    let key *char = "\"Version\""
    let key_length int = strlen(key).to_type(int)
    let found int = -1
    i = 0
    for i + key_length < total {
        let same int = 1
        j = 0
        for j < key_length {
            if (data[i + j] != key[j].to_type(u8)) { same = 0; break }
            j += 1
        }
        if (same != 0) { found = i + key_length; break }
        i += 1
    }
    if (found < 0) { return -1 }
    i = found
    for i < total && (data[i] == ' ' || data[i] == '\t' || data[i] == '\r' || data[i] == '\n') {
        i += 1
    }
    if (i >= total || data[i] != ':') { return -1 }
    i += 1
    for i < total && (data[i] == ' ' || data[i] == '\t' || data[i] == '\r' || data[i] == '\n') {
        i += 1
    }
    if (i >= total || data[i] != '"') { return -1 }
    i += 1
    let start int = i
    for i < total && data[i] != '"' { i += 1 }
    if (i >= total || cmd_darwin_version(&data[start], i - start, version, parts) != 0) {
        return -1
    }

    // SDK 配置摘要绑定 root 与完整 JSON 字节；最终链接键还会校验 SDK 内容清单。
    let hash u64 = 14695981039346656037
    i = 0
    for root[i] != 0 {
        hash = (hash ^ root[i].to_type(u8).to_type(u64)) * 1099511628211
        i += 1
    }
    i = 0
    for i < total {
        hash = (hash ^ data[i].to_type(u64)) * 1099511628211
        i += 1
    }
    let hex *char = "0123456789abcdef"
    i = 0
    for i < 16 {
        let shift int = (15 - i) * 4
        identity[i] = hex[((hash >> shift) & 15).to_type(int)].to_type(u8)
        i += 1
    }
    identity[16] = 0
    return 0
}

// cmd_darwin_sdk_discover：原生 Darwin 未指定 SDKROOT 时从 xcrun 发现 SDK 路径。
fn cmd_darwin_sdk_discover(output *u8) int {
    if (proj.cfg().host_target.os != support.TARGET_OS_DARWIN) {
        return errors.fail("Darwin 交叉编译必须显式设置 SDKROOT")
    }
    if (cmd_mkdirs("tmp/llvm-migration/darwin-sdk") != 0) {
        return errors.fail("无法创建 Darwin SDK 临时目录")
    }
    let capture [4096]u8
    let path [256]u8
    let n int = support.append_str(&path[0], 0, "tmp/llvm-migration/darwin-sdk/xcrun-")
    n = support.append_int(&path[0], n, getpid())
    n = support.append_str(&path[0], n, ".txt"); path[n] = 0
    let args [5]*char
    args[0] = "xcrun"; args[1] = "--sdk"; args[2] = "macosx"
    args[3] = "--show-sdk-path"; args[4] = 0.to_type(*char)
    let length int = cmd_process_capture(&args[0], support.arr_cstr(path), &capture[0], 4096)
    if (length <= 0 || length >= 4000) {
        return errors.fail("xcrun 无法发现 macOS SDK；请显式设置 SDKROOT")
    }
    let i int = 0
    for i < length {
        if (capture[i] == '\n' || capture[i] == '\r') { capture[i] = 0; break }
        output[i] = capture[i]; i += 1
    }
    output[i] = 0
    return i > 0 ? i : -1
}

// cmd_darwin_bundle_ok：目录是否包含随编译器分发的 Darwin SDK stub。
// 只检查链接必需的两个输入：SDKSettings.json 与 libSystem.tbd。
fn cmd_darwin_bundle_ok(root *u8) int {
    if (root == 0 || root[0] == 0) { return 0 }
    let path [4200]u8
    let n int = support.append_str(&path[0], 0, support.arr_cstr(root))
    n = support.append_str(&path[0], n, "/SDKSettings.json")
    path[n] = 0
    if (proj.file_exists(support.arr_cstr(&path[0])) == 0) { return 0 }
    n = support.append_str(&path[0], 0, support.arr_cstr(root))
    n = support.append_str(&path[0], n, "/usr/lib/libSystem.tbd")
    path[n] = 0
    return proj.file_exists(support.arr_cstr(&path[0]))
}

// cmd_darwin_copy_root：把已校验的候选路径写入调用方缓冲。
fn cmd_darwin_copy_root(candidate *char, root *u8, length *int) int {
    let n int = strlen(candidate).to_type(int)
    if (n <= 0 || n >= 4096) { return -1 }
    let i int = 0
    for i < n { root[i] = candidate[i].to_type(u8); i += 1 }
    root[n] = 0
    length[0] = n
    return 0
}

// cmd_darwin_bundled_sdk：查找随编译器分发的 Darwin SDK stub 目录。
// 顺序：YH_DARWIN_SDK → 可执行文件附近的 darwin-sdk、vendor/darwin-sdk、
// ../vendor/darwin-sdk、../../vendor/darwin-sdk、../share|lib/yh/darwin-sdk。
// 显式 SDKROOT 由调用方先处理，优先级最高。
fn cmd_darwin_bundled_sdk(root *u8, length *int) int {
    let env_off int = -1
    let env_len int = 0
    if (proj.env_fetch("YH_DARWIN_SDK", &env_off, &env_len) == 0 && env_len > 0) {
        if (env_len >= 4096) { return -1 }
        let i int = 0
        for i < env_len {
            root[i] = support.pool_ctx().data[env_off + i]
            i += 1
        }
        root[env_len] = 0
        if (cmd_darwin_bundle_ok(root) == 0) { return -1 }
        length[0] = env_len
        return 0
    }
    let dir [4096]u8
    let dir_len int = 0
    if (argv0() != 0) {
        let slash int = -1
        let i int = 0
        for argv0()[i] != 0 {
            if (argv0()[i] == '/') { slash = i }
            i += 1
        }
        if (slash >= 0) {
            i = 0
            for i <= slash {
                dir[i] = argv0()[i].to_type(u8)
                i += 1
            }
            dir_len = slash + 1
        }
    }
    if (dir_len == 0) {
        dir[0] = '.'
        dir[1] = '/'
        dir_len = 2
    }
    let suffixes [6]*char
    suffixes[0] = "darwin-sdk"
    suffixes[1] = "vendor/darwin-sdk"
    suffixes[2] = "../vendor/darwin-sdk"
    suffixes[3] = "../../vendor/darwin-sdk"
    suffixes[4] = "../share/yh/darwin-sdk"
    suffixes[5] = "../lib/yh/darwin-sdk"
    let si int = 0
    for si < 6 {
        let candidate [4096]u8
        let n int = 0
        let i int = 0
        for i < dir_len {
            candidate[n] = dir[i]
            n += 1
            i += 1
        }
        if (n > 0 && candidate[n - 1] != '/') {
            candidate[n] = '/'
            n += 1
        }
        n = support.append_str(&candidate[0], n, suffixes[si])
        candidate[n] = 0
        if (cmd_darwin_bundle_ok(&candidate[0]) != 0) {
            return cmd_darwin_copy_root(support.arr_cstr(&candidate[0]), root, length)
        }
        si += 1
    }
    return -1
}

// cmd_darwin_sdk_validate_explicit：校验显式 SDKROOT，但不查找/要求 SDK。
// 显式值代表用户意图，拼错时即使只 emit asm/object 也应立即失败；未设置时
// emit-only 路径不因缺少 SDK 而失败。
fn cmd_darwin_sdk_validate_explicit() int {
    if (proj.cfg().target.os != support.TARGET_OS_DARWIN) { return 0 }
    let root_off int; let root_len int
    if (proj.env_fetch("SDKROOT", &root_off, &root_len) != 0) {
        return errors.fail("读取 SDKROOT 环境失败")
    }
    if (root_len == 0) { return 0 }
    if (root_len >= 4000) { return errors.fail("SDKROOT 路径过长") }
    let root [4096]u8
    let source *char = proj.pool_str(root_off)
    let i int = 0
    for i < root_len { root[i] = source[i].to_type(u8); i += 1 }
    root[root_len] = 0
    let version [32]u8
    let identity [32]u8
    let sdk_parts [3]int
    if (cmd_darwin_sdk_settings((&root[0]).to_type(*char),
            &version[0], &identity[0], &sdk_parts[0]) != 0) {
        return errors.fail("SDKROOT 不含有效的 macOS SDKSettings.json Version 字段")
    }
    if (cmd_darwin_version_compare(&cmd_darwin_link_config.min_parts[0], &sdk_parts[0]) > 0) {
        return errors.fail("MACOSX_DEPLOYMENT_TARGET 高于所选 macOS SDK 版本")
    }
    return 0
}

// cmd_darwin_min_os_configure：解析并校验部署版本，不要求 SDK 存在。
// 编译/`--emit-asm`/`--emit-llvm` 只需要目标 minOS；SDK 仅链接期需要。
fn cmd_darwin_min_os_configure() int {
    if (proj.cfg().target.os != support.TARGET_OS_DARWIN) { return 0 }
    if (cmd_darwin_link_config.min_ready != 0) { return 0 }

    let min_off int; let min_len int
    if (proj.env_fetch("MACOSX_DEPLOYMENT_TARGET", &min_off, &min_len) != 0) {
        return errors.fail("读取 MACOSX_DEPLOYMENT_TARGET 环境失败")
    }
    let min_source *char = min_len > 0 ? proj.pool_str(min_off) : "14.0.0"
    if (min_len == 0) { min_len = 6 }
    if (cmd_darwin_version(min_source.to_type(*u8), min_len,
            &cmd_darwin_link_config.min_os[0],
            &cmd_darwin_link_config.min_parts[0]) != 0) {
        return errors.fail("MACOSX_DEPLOYMENT_TARGET 必须是 major.minor 或 major.minor.patch")
    }
    if (cmd_darwin_link_config.min_parts[0] < 14) {
        return errors.fail("本 Darwin LLVM 候选仅承诺 macOS 14.0.0 及以上部署版本")
    }
    if (cmd_darwin_sdk_validate_explicit() != 0) { return -1 }
    cmd_darwin_link_config.min_ready = 1
    return 0
}

// cmd_darwin_link_configure：按会话快照 SDKROOT 与 MACOSX_DEPLOYMENT_TARGET。
// SDKROOT 有值时绝不回退 xcrun；只有链接/缓存身份路径需要本函数。
fn cmd_darwin_link_configure() int {
    if (proj.cfg().target.os != support.TARGET_OS_DARWIN) { return 0 }
    if (cmd_darwin_link_config.ready != 0) { return 0 }
    if (cmd_darwin_min_os_configure() != 0) { return -1 }

    let root_off int; let root_len int
    if (proj.env_fetch("SDKROOT", &root_off, &root_len) != 0) {
        return errors.fail("读取 SDKROOT 环境失败")
    }
    let root [4096]u8
    let root_length int = 0
    if (root_len > 0) {
        if (root_len >= 4000) { return errors.fail("SDKROOT 路径过长") }
        let source *char = proj.pool_str(root_off)
        let i int = 0
        for i < root_len { root[i] = source[i].to_type(u8); i += 1 }
        root[root_len] = 0
        root_length = root_len
    } else {
        // 自带 bundle 优先：交叉主机没有 xcrun；原生主机没有安装 SDK 时
        // 也能开箱链接。显式 SDKROOT 仍在上面优先。
        let bundle_length int = 0
        if (cmd_darwin_bundled_sdk(&root[0], &bundle_length) == 0) {
            root_length = bundle_length
        } else if (proj.cfg().host_target.os == support.TARGET_OS_DARWIN) {
            root_length = cmd_darwin_sdk_discover(&root[0])
            if (root_length <= 0) { return -1 }
        } else {
            return errors.fail("交叉编译需要显式 SDKROOT 或编译器自带 darwin-sdk")
        }
    }

    let sdk_parts [3]int
    if (cmd_darwin_sdk_settings((&root[0]).to_type(*char), &cmd_darwin_link_config.sdk_version[0],
            &cmd_darwin_link_config.sdk_identity[0], &sdk_parts[0]) != 0) {
        return errors.fail("SDKROOT 不含有效的 macOS SDKSettings.json Version 字段")
    }
    if (cmd_darwin_version_compare(&cmd_darwin_link_config.min_parts[0], &sdk_parts[0]) > 0) {
        return errors.fail("MACOSX_DEPLOYMENT_TARGET 高于所选 macOS SDK 版本")
    }
    let owned *char = malloc((root_length + 1).to_type(u64)).to_type(*char)
    if (owned == 0) { return errors.fail("Darwin SDK 路径分配失败") }
    let i int = 0
    for i < root_length { owned[i] = root[i].to_type(char); i += 1 }
    owned[root_length] = 0
    cmd_darwin_link_config.sdk_root = owned
    cmd_darwin_link_config.ready = 1
    return 0
}

// cmd_darwin_sdk_root：返回当前会话校验过的 SDK 根路径，供 Mach-O 链接与缓存签名使用。
fn cmd_darwin_sdk_root() *char {
    if (cmd_darwin_link_configure() != 0) { return 0 }
    return cmd_darwin_link_config.sdk_root
}

// cmd_darwin_sdk_version：返回 SDKSettings.json 中的规范化 SDK 版本。
fn cmd_darwin_sdk_version() *char {
    if (cmd_darwin_link_configure() != 0) { return 0 }
    return (&cmd_darwin_link_config.sdk_version[0]).to_type(*char)
}

// cmd_darwin_sdk_identity：返回 SDK 根路径与 SDKSettings.json 字节生成的会话摘要。
fn cmd_darwin_sdk_identity() *char {
    if (cmd_darwin_link_configure() != 0) { return 0 }
    return (&cmd_darwin_link_config.sdk_identity[0]).to_type(*char)
}

// mb_macho_u32：按 Mach-O little-endian 规则读取一个已界限检查的 32 位字段。
fn mb_macho_u32(data *u8, offset int) int {
    return data[offset].to_type(int) |
        (data[offset + 1].to_type(int) << 8) |
        (data[offset + 2].to_type(int) << 16) |
        (data[offset + 3].to_type(int) << 24)
}

// mb_darwin_strip_enabled：是否给 ld64.lld 加 -x（剥离局部符号表，缺省关）。
// 只用于 release 打包：删掉局部符号表项（不是代码），实测再省约 3.6%；
// `YH_LINK_STRIP=1/on/true/yes` 打开。
fn mb_darwin_strip_enabled() int {
    let off int = -1
    let olen int = 0
    if (proj.env_fetch("YH_LINK_STRIP", &off, &olen) != 0 || olen == 0) { return 0 }
    let first char = support.np_cstr(off)[0]
    if (first == '1' || first == 'y' || first == 'Y' || first == 't' || first == 'T') {
        return 1
    }
    return 0
}

// mb_darwin_dead_strip_enabled：是否给 ld64.lld 加 -dead_strip（缺省开启）。
//
// 缺省开：链接后按符号可达性回收未引用的 stdlib 函数与字符串字面量；
// 否则「整模块一个对象」的链接粒度会让每个用 fmt 的程序背上整个
// string/os/sys 闭包（J6-L1 实测 hello 级程序 155,872 B → 89,632 B）。
// `YH_LINK_DEAD_STRIP=0/off/no/false`（只看首字符 0/n/N/f/F）关闭，用于对照与回退。
fn mb_darwin_dead_strip_enabled() int {
    let off int = -1
    let olen int = 0
    if (proj.env_fetch("YH_LINK_DEAD_STRIP", &off, &olen) != 0 || olen == 0) {
        return 1
    }
    let first char = support.np_cstr(off)[0]
    if (first == '0' || first == 'n' || first == 'N'
        || first == 'f' || first == 'F') {
        return 0
    }
    return 1
}

// mb_macho_link_prefix：给单文件与项目链接写入一致的 ld64.lld 固定参数。
// output 必须是调用方持有的临时文件名，成功后由父进程验证并原子发布。
fn mb_macho_link_prefix(argv **char, output *char) int {
    if (argv == 0 || output == 0 || cmd_darwin_link_configure() != 0) {
        return -1
    }
    let sdk_root *char = cmd_darwin_sdk_root()
    let sdk_version *char = cmd_darwin_sdk_version()
    let min_os *char = cmd_darwin_min_os()
    if (sdk_root == 0 || sdk_version == 0 || min_os == 0) { return -1 }
    let system_hash u64 = proj.hash_init()
    if (mb_hash_macho_library(&system_hash, sdk_root, "System", 1) != 0) {
        return -1
    }
    let count int = 0
    argv[count] = "ld64.lld"; count += 1
    argv[count] = "-arch"; count += 1
    argv[count] = "arm64"; count += 1
    argv[count] = "-platform_version"; count += 1
    argv[count] = "macos"; count += 1
    argv[count] = min_os; count += 1
    argv[count] = sdk_version; count += 1
    argv[count] = "-syslibroot"; count += 1
    argv[count] = sdk_root; count += 1
    argv[count] = "-pie"; count += 1
    // J6-L1/L4：死代码回收与（可选）局部符号表剥离；两者都参与链接键。
    if (mb_darwin_dead_strip_enabled() != 0) {
        argv[count] = "-dead_strip"; count += 1
    }
    if (mb_darwin_strip_enabled() != 0) {
        argv[count] = "-x"; count += 1
    }
    argv[count] = "-adhoc_codesign"; count += 1
    argv[count] = "-o"; count += 1
    argv[count] = output; count += 1
    return count
}

// mb_macho_link_worker：隔离一次 raw ld64.lld 调用，处理不可重入状态并返回父进程状态。
fn mb_macho_link_worker(argv **char, argc int) int {
    if (argv == 0 || argc <= 0) { return errors.fail("Darwin lld 参数无效") }
    let child int = fork()
    if (child < 0) { return errors.fail("无法启动 Darwin lld worker") }
    if (child == 0) {
        let diagnostic [backend.LLVM_LLD_DIAG]u8
        let status int = backend.llvm_lld_link_argv(argv, argc,
            (&diagnostic[0]).to_type(*char))
        if (status != 0) {
            if (diagnostic[0] != 0) {
                support.write_all(2, &diagnostic[0],
                    strlen((&diagnostic[0]).to_type(*char)).to_type(int))
                support.write_all(2, "\n".to_type(*u8), 1)
            }
            if (status == -2) { exit(253) }
            exit(1)
        }
        exit(0)
    }
    let status int = cmd_process_status(child)
    if (status == 253) { return -2 }
    return status == 0 ? 0 : -1
}

// mb_macho_tbd_collect：从一个 .tbd 的 `reexported-libraries` 段收集库路径。
//
// TAPI stub 只描述符号而不含代码；真正决定链接结果的是它重导出的那批
// stub 文件。因此最终链接键不能只哈希 libSystem.tbd 本身，还要沿 reexport
// 闭包逐项哈希。每行写入 names 的第 slot 行（行宽 stride 字节，含 NUL）；
// 返回条数（不超过 capacity），读取失败返回 -1。
fn mb_macho_tbd_collect(tbd *char, names *u8, stride int, capacity int) int {
    if (support.read_source(tbd) != 0) { return -1 }
    let text *u8 = support.src_ctx().data
    let n int = support.src_ctx().length
    let marker *char = "reexported-libraries:"
    let ml int = strlen(marker).to_type(int)
    let i int = 0
    let found int = -1
    for i + ml <= n {
        let same int = 1
        let j int = 0
        for j < ml {
            if (text[i + j] != marker[j].to_type(u8)) { same = 0; break }
            j += 1
        }
        if (same != 0) { found = i + ml; break }
        i += 1
    }
    if (found < 0) { return 0 }
    // 该段结束于下一个顶格键行：TAPI 续行都以空白缩进，新键从列首开始。
    let segment_end int = n
    let line int = found
    for line < n {
        if (text[line] == '\n') {
            let next int = line + 1
            if (next < n) {
                let c u8 = text[next]
                if (c == '-' || c == '_' || (c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')) {
                    segment_end = next
                    break
                }
            }
        }
        line += 1
    }
    let count int = 0
    i = found
    for i < segment_end {
        if (text[i] != '\'') { i += 1; continue }
        let start int = i + 1
        let j int = start
        for j < segment_end && text[j] != '\'' { j += 1 }
        if (j >= segment_end) { break }
        // 只收绝对路径：安装名与符号不参与库闭包。
        if (start < j && text[start] == '/' && count < capacity) {
            let slot int = count * stride
            let copy_len int = j - start
            if (copy_len >= stride) { copy_len = stride - 1 }
            let k int = 0
            for k < copy_len {
                names[slot + k] = text[start + k]
                k += 1
            }
            names[slot + copy_len] = 0
            count += 1
        }
        i = j + 1
    }
    return count
}

// mb_macho_tbd_hash_stub：把 SDK 内的 `/usr/lib/...dylib` 逻辑路径解析到
// 实际 stub 并混入缓存键；随后递归处理它自己的 reexport（深度有界）。
//
// SDK 用 `<name>.tbd` 表示动态库，因此先把 `.dylib` 换成 `.tbd`，其次再试原路径。
// 两者都不存在时混入哨兵字节而不是失败：缺失与存在必须区分，但是否致命由
// 调用方的 required 决定（项目 `-l` 允许落到 LIBRARY_PATH）。
fn mb_macho_tbd_hash_stub(hash *u64, sdk_root *char, name *char, depth int) int {
    let path [4096]u8
    let pn int = support.append_str(&path[0], 0, sdk_root)
    if (pn > 0 && path[pn - 1] == '/' && name[0] == '/') {
        pn = support.append_str(&path[0], pn, name + 1)
    } else {
        pn = support.append_str(&path[0], pn, name)
    }
    let name_len int = strlen(name).to_type(int)
    let stripped int = 0
    if (name_len > 6 && support.cstr_eq(name + (name_len - 6), ".dylib") != 0) {
        // 把 `.dylib` 换成 `.tbd`；append_str 不写终止符，必须自己补 NUL。
        pn = support.append_str(&path[0], pn - 6, ".tbd")
        path[pn] = 0
        stripped = 1
    } else {
        path[pn] = 0
    }
    if (stripped != 0 && proj.file_exists(support.arr_cstr(&path[0])) != 0) {
        // 用 stub 内容与它的解析路径共同入键：内容变化必须失效，同内容
        // 不同路径也保持可区分（便于诊断 SDK 切换）。
        let pi int = 0
        for path[pi] != 0 { proj.fnv(hash, path[pi]); pi += 1 }
        proj.fnv(hash, 0)
        if (proj.hash_file(hash, support.arr_cstr(&path[0])) != 0) { return -1 }
        return mb_macho_tbd_closure(hash, sdk_root, support.arr_cstr(&path[0]), depth + 1)
    }
    // 回退到原名（可能是 .tbd 直接给出，或 SDK 内放了真实 .dylib/.a）。
    pn = support.append_str(&path[0], 0, sdk_root)
    if (pn > 0 && path[pn - 1] == '/' && name[0] == '/') {
        pn = support.append_str(&path[0], pn, name + 1)
    } else {
        pn = support.append_str(&path[0], pn, name)
    }
    path[pn] = 0
    if (proj.file_exists(support.arr_cstr(&path[0])) != 0) {
        let pi int = 0
        for path[pi] != 0 { proj.fnv(hash, path[pi]); pi += 1 }
        proj.fnv(hash, 0)
        return proj.hash_file(hash, support.arr_cstr(&path[0]))
    }
    proj.fnv(hash, 255)
    return 0
}

// mb_macho_tbd_closure：哈希一个 .tbd 的全部 reexport 闭包（深度上限 2）。
// libSystem 会重导出 /usr/lib/system/*.dylib，其中 libmathCommon.tbd 又是
// libSystem.tbd 的符号链接；深度上限既覆盖真实嵌套，也保证环不会无限递归。
fn mb_macho_tbd_closure(hash *u64, sdk_root *char, tbd *char, depth int) int {
    if (depth > 2) { return 0 }
    let names [64 * 192]u8
    let count int = mb_macho_tbd_collect(tbd, &names[0], 192, 64)
    if (count < 0) { return -1 }
    let i int = 0
    for i < count {
        if (mb_macho_tbd_hash_stub(hash, sdk_root,
                support.arr_cstr(&names[i * 192]), depth) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

// mb_hash_macho_library：混入 Darwin 系统库名及其固定 SDK 内的 stub/归档内容。
// 动态 stub（.tbd）还要沿 reexport 闭包入键：libSystem 的符号实际来自
// /usr/lib/system/*.tbd，只哈希 libSystem.tbd 会把这些输入变化漏掉。
// project library 若不在 SDK 中仍交给 lld 诊断。
fn mb_hash_macho_library(hash *u64, sdk_root *char, name *char,
    required int) int {
    if (sdk_root == 0 || name == 0) { return errors.fail("Darwin 链接库身份无效") }
    let i int = 0
    for name[i] != 0 { proj.fnv(hash, name[i].to_type(u8)); i += 1 }
    proj.fnv(hash, 0)
    let path [4096]u8
    let stem int = 0
    stem = support.append_str(&path[0], stem, sdk_root)
    stem = support.append_str(&path[0], stem, "/usr/lib/lib")
    stem = support.append_str(&path[0], stem, name)
    let suffixes [3]*char
    suffixes[0] = ".tbd"; suffixes[1] = ".dylib"; suffixes[2] = ".a"
    let suffix int = 0
    for suffix < 3 {
        let length int = support.append_str(&path[0], stem, suffixes[suffix])
        path[length] = 0
        if (proj.file_exists(support.arr_cstr(path)) != 0) {
            let j int = 0
            for support.arr_cstr(path)[j] != 0 {
                proj.fnv(hash, support.arr_cstr(path)[j].to_type(u8)); j += 1
            }
            proj.fnv(hash, 0)
            if (proj.hash_file(hash, support.arr_cstr(path)) != 0) { return -1 }
            // 只有动态 stub 有 reexport 语义；静态 .a 内容已完整入键。
            if (suffix == 0) {
                return mb_macho_tbd_closure(hash, sdk_root,
                    support.arr_cstr(path), 0)
            }
            return 0
        }
        suffix += 1
    }
    if (required != 0) {
        return errors.fail_path("Darwin SDK 缺少链接库: ", name)
    }
    proj.fnv(hash, 255)
    return 0
}

// mb_hash_macho_identity：为 Darwin 最终链接键加入 lld、SDK/minOS 与系统库身份。
fn mb_hash_macho_identity(hash *u64, projects *int,
    project_count int) int {
    let identity *char = backend.llvm_lld_identity()
    let sdk_root *char = cmd_darwin_sdk_root()
    let sdk_identity *char = cmd_darwin_sdk_identity()
    let min_os *char = cmd_darwin_min_os()
    // 链接参数里由环境控制的两项也进键：-dead_strip 缺省开、-x 缺省关。
    proj.fnv(hash, mb_darwin_dead_strip_enabled().to_type(u8))
    proj.fnv(hash, mb_darwin_strip_enabled().to_type(u8))
    if (identity == 0 || identity[0] == 0 || sdk_root == 0
        || sdk_identity == 0 || min_os == 0) {
        return errors.fail("当前编译器缺少有效的 Darwin LLVM 链接身份")
    }
    let i int = 0
    for identity[i] != 0 { proj.fnv(hash, identity[i].to_type(u8)); i += 1 }
    proj.fnv(hash, 0)
    i = 0
    for sdk_identity[i] != 0 { proj.fnv(hash, sdk_identity[i].to_type(u8)); i += 1 }
    proj.fnv(hash, 0)
    i = 0
    for min_os[i] != 0 { proj.fnv(hash, min_os[i].to_type(u8)); i += 1 }
    proj.fnv(hash, 0)
    // 自举闭包来自构建机（YH_LLVM_SELFHOST_FLAGS 文件；过渡种子用桥内常量）：
    // 参数集合变化必须换链接键，否则会命中旧闭包链接出的产物。
    if (mb_darwin_selfhost_enabled() != 0) {
        let selfhost_n int = backend.llvm_lld_selfhost_flag_count()
        if (selfhost_n < 0) {
            return errors.fail("自举链接闭包文件不可读：检查 YH_LLVM_SELFHOST_FLAGS")
        }
        let si int = 0
        for si < selfhost_n {
            let flag *char = backend.llvm_lld_selfhost_flag(si)
            if (flag == 0) { return errors.fail("自举链接闭包参数无效") }
            let sj int = 0
            for flag[sj] != 0 {
                proj.fnv(hash, flag[sj].to_type(u8))
                sj += 1
            }
            proj.fnv(hash, 0)
            si += 1
        }
        proj.fnv(hash, 253)
    }
    let settings [4096]u8
    i = support.append_str(&settings[0], 0, sdk_root)
    i = support.append_str(&settings[0], i, "/SDKSettings.json")
    settings[i] = 0
    if (proj.hash_file(hash, support.arr_cstr(settings)) != 0
        || mb_hash_macho_library(hash, sdk_root, "System", 1) != 0) {
        return -1
    }
    let environment_off int = -1
    let environment_len int = 0
    if (proj.env_fetch("LIBRARY_PATH", &environment_off, &environment_len) != 0) {
        return -1
    }
    i = 0
    for i < environment_len { proj.fnv(hash, support.pool_ctx().data[environment_off + i]); i += 1 }
    proj.fnv(hash, 254)
    let project_i int = 0
    for project_i < project_count {
        let project int = projects[project_i]
        let library_i int = 0
        for library_i < proj.ctx().projs[project].c_lib_n {
            let library proj.PInput = proj.ctx().projs[project].c_libs[library_i]
            let name [128]u8
            let length int = support.append_np(&name[0], 0, library.path_off, library.path_len)
            name[length] = 0
            if (mb_hash_macho_library(hash, sdk_root, support.arr_cstr(name), 0) != 0) {
                return -1
            }
            library_i += 1
        }
        project_i += 1
    }
    return 0
}
