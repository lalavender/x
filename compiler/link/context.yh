module link

// ============================================================================
// context.yh —— 工具链调用层的会话状态（B2-2，2026-10-26）
//
// `link` 是「调用外部工具链」的那一层：汇编、链接驱动、内嵌 lld、进程与时钟。
// 它需要的会话状态只有两样，都归本模块私有：
//   1. 编译器自身 argv[0]：定位同目录的链接包装器 / 自举闭包；
//   2. 本层自己的阶段计时（对象阶段、链接阶段），由链接流程写入，
//      build 的 `--stats` 通过 `object_ns()`/`link_ns()` 读取后汇总。
//
// 为什么不再用 build.BuildCtx：`link` 是 build 的下层（build → link），
// 反向读 build 的会话结构会成环。argv0 由 build 在入口处转交（`set_argv0`），
// 计时归写者所有。
// ============================================================================

// lk_argv0：编译器自身 argv[0]（借自 argv，不复制不释放）。
let lk_argv0 *char


// set_argv0：由 build 的入口（mb_set_argv0）转交编译器自身路径。
pub fn set_argv0(p *char) void {
    lk_argv0 = p
}

// argv0：读取编译器自身路径；未设置时为 null（调用方按"没有 argv0"处理）。
pub fn argv0() *char {
    return lk_argv0
}

// object_ns / link_ns：读本层阶段耗时（供 build 的统计输出）。
