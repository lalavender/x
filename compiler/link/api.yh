module link

import errors
import support
import backend
import proj
import hash
// ============================================================================
// api.yh —— link 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// set_argv0：由 build 的入口（mb_set_argv0）转交编译器自身路径。
pub fn set_argv0(p *char) void {
    lk_argv0 = p
}

// argv0：读取编译器自身路径；未设置时为 null（调用方按"没有 argv0"处理）。
pub fn argv0() *char {
    return lk_argv0
}

// cmd_darwin_min_os：返回已校验、由会话配置持有的 LLVM v2 部署版本字符串。
// 不要求 SDK：asm/object 发射可先于链接、也可在无 SDK 的交叉主机完成。
pub fn cmd_darwin_min_os() *char {
    if (cmd_darwin_min_os_configure() != 0) { return 0 }
    return (&cmd_darwin_link_config.min_os[0]).to_type(*char)
}

// mb_darwin_executable_matches：验证 ld64.lld 输出是 arm64 可执行文件，且部署版本与签名完整。
// 检查 Mach-O load command 字节，避免仅凭 magic 或外部工具成功码发布错误目标。
pub fn mb_darwin_executable_matches(path *char) int {
    if (support.read_source(path) != 0 || support.src_ctx().length < 32) { return 0 }
    let data *u8 = support.src_ctx().data
    let length int = support.src_ctx().length
    if (data[0] != 207 || data[1] != 250 || data[2] != 237 || data[3] != 254
        || mb_macho_u32(data, 4) != 16777228 || mb_macho_u32(data, 12) != 2) {
        return 0
    }
    let command_count int = mb_macho_u32(data, 16)
    let command_bytes int = mb_macho_u32(data, 20)
    if (command_count <= 0 || command_count > 65536 || command_bytes < 8
        || command_bytes > length - 32) {
        return 0
    }
    let min_text [32]u8
    let min_parts [3]int
    let minimum *char = cmd_darwin_min_os()
    if (minimum == 0 || cmd_darwin_version(minimum.to_type(*u8),
            strlen(minimum).to_type(int), &min_text[0], &min_parts[0]) != 0
        || min_parts[1] > 255 || min_parts[2] > 255) {
        return 0
    }
    let sdk_version *char = cmd_darwin_sdk_version()
    let sdk_parts [3]int
    if (sdk_version == 0 || cmd_darwin_version(sdk_version.to_type(*u8),
            strlen(sdk_version).to_type(int), &min_text[0], &sdk_parts[0]) != 0
        || sdk_parts[1] > 255 || sdk_parts[2] > 255) {
        return 0
    }
    let expected_min int = (min_parts[0] << 16) | (min_parts[1] << 8) | min_parts[2]
    let expected_sdk int = (sdk_parts[0] << 16) | (sdk_parts[1] << 8) | sdk_parts[2]
    let build_versions int = 0
    let signatures int = 0
    let cursor int = 32
    let end int = 32 + command_bytes
    let command_i int = 0
    for command_i < command_count {
        if (cursor < 32 || cursor + 8 > end || cursor + 8 > length) { return 0 }
        let command int = mb_macho_u32(data, cursor)
        let size int = mb_macho_u32(data, cursor + 4)
        if (size < 8 || size > end - cursor || size > length - cursor) { return 0 }
        if (command == 50) {
            if (size < 24 || mb_macho_u32(data, cursor + 8) != 1
                || mb_macho_u32(data, cursor + 12) != expected_min
                || mb_macho_u32(data, cursor + 16) != expected_sdk) {
                return 0
            }
            build_versions += 1
        } else if (command == 29) {
            if (size < 16) { return 0 }
            let offset int = mb_macho_u32(data, cursor + 8)
            let signature_size int = mb_macho_u32(data, cursor + 12)
            if (offset < end || signature_size <= 0 || offset > length
                || signature_size > length - offset) {
                return 0
            }
            signatures += 1
        }
        cursor += size
        command_i += 1
    }
    return cursor == end && build_versions == 1 && signatures == 1 ? 1 : 0
}

// mb_lld_darwin_enabled：仅在 Darwin/ARM64 LLVM 目标且内嵌 lld 可用时走生产 Mach-O 链接。
// 用户显式指定 YH_CC 时保持独立的外部链接路径，不覆盖其工具选择。
pub fn mb_lld_darwin_enabled() int {
    if (proj.cfg().target.os != support.TARGET_OS_DARWIN
        || proj.cfg().target.arch != support.TARGET_ARCH_ARM64) {
        return 0
    }
    let override_off int = -1
    let override_len int = 0
    if (proj.env_fetch("YH_CC", &override_off, &override_len) == 0
        && override_len > 0) {
        return 0
    }
    let identity *char = backend.llvm_lld_identity()
    if (identity == 0 || identity[0] == 0) { return 0 }
    return 1
}

// rmdir(path *char) int —— 仅用于清理 Darwin 链接暂存目录（prelude 未登记该符号）。
@[extern] fn rmdir(path *char) int

// mb_macho_tmp_split：为 Darwin/ARM64 链接准备「暂存子目录 + 最终 basename」路径。
//
// lld 的 -adhoc_codesign 用**输出文件的 basename** 生成 codesign identifier。
// 若沿用 ELF 那套 `<out>.yh-tmp.<pid>` 当 -o，identifier 就带上 pid，同一源码
// 两次构建的产物大小与哈希都不同（RB5），发行可比性被破坏。这里把临时产物放进
// `<out 所在目录>/.yh-tmp.<pid>/` 并沿用最终 basename：identifier 只取决于产物
// 名；子目录按 pid 隔离并发构建；子目录与产物同文件系统，rename 仍是原子的。
//
// out_path：最终产物路径（相对/绝对均可）；dir_out/file_out 由调用方提供缓冲。
// 返回 0 成功；-1 表示入参为空、pid 异常或路径超出缓冲区（调用方给带上下文的错误）。
pub fn mb_macho_tmp_split(out_path *char, dir_cap int, dir_out *u8,
    file_cap int, file_out *u8) int {
    if (out_path == 0 || dir_out == 0 || file_out == 0) { return -1 }
    let total int = strlen(out_path).to_type(int)
    if (total <= 0) { return -1 }
    // 最后一个 '/' 之后是 basename；dir 前缀保留末尾的 '/'。
    let cut int = 0
    let i int = 0
    for i < total {
        if (out_path[i] == '/') { cut = i + 1 }
        i += 1
    }
    let pid int = getpid()
    if (pid <= 0) { return -1 }
    let pid_digits int = 1
    let scaled int = pid
    for scaled >= 10 {
        scaled = scaled / 10
        pid_digits += 1
    }
    let marker_len int = 9   // "/.yh-tmp." 的字节数
    let dir_len int = cut + marker_len + pid_digits
    let file_len int = dir_len + 1 + (total - cut)
    if (dir_len >= dir_cap || file_len >= file_cap) { return -1 }
    let n int = 0
    i = 0
    for i < cut {
        dir_out[n] = out_path[i].to_type(u8)
        n += 1
        i += 1
    }
    n = support.append_str(dir_out, n, "/.yh-tmp.")
    n = support.append_int(dir_out, n, pid)
    dir_out[n] = 0
    i = 0
    for i < n {
        file_out[i] = dir_out[i]
        i += 1
    }
    file_out[i] = '/'
    i += 1
    let j int = cut
    for j < total {
        file_out[i] = out_path[j].to_type(u8)
        i += 1
        j += 1
    }
    file_out[i] = 0
    return 0
}

// mb_macho_link_stage：为 Darwin raw lld 链接准备「暂存子目录 + 暂存产物路径」。
//
// 返回 1 = 暂存目录已就绪（file 为 `<dir>/<basename>`）；返回 -1 = 已写诊断
// （产物路径过长或建目录失败）。调用方发布或失败后必须调用
// mb_macho_tmp_discard 收尾，否则会留下空目录。
pub fn mb_macho_link_stage(out_path *char, dir *u8, dir_cap int,
    file *u8, file_cap int) int {
    if (mb_macho_tmp_split(out_path, dir_cap, dir, file_cap, file) != 0) {
        return errors.fail_path("Darwin 链接产物路径过长: ", out_path)
    }
    if (mkdir(support.arr_cstr(dir), 493) != 0) {
        // pid 复用：上一轮被强杀的进程可能留下同名暂存目录/文件，
        // 清掉残留后再试一次，避免把崩溃残骸当成链接错误。
        unlink(support.arr_cstr(file))
        rmdir(support.arr_cstr(dir))
        if (mkdir(support.arr_cstr(dir), 493) != 0) {
            return errors.fail_path("无法创建 Darwin 链接暂存目录: ", out_path)
        }
    }
    return 1
}

// mb_macho_tmp_discard：收尾一次链接的暂存位置。
//
// stage 为 0 表示调用方走非 raw lld 路径（Linux 的 `<out>.yh-tmp.<pid>` 文件），
// 只删文件；stage 非 0 表示 Darwin 暂存子目录，删残余产物后再移除目录，
// 失败路径因此不会留下空目录。所有错误都被忽略：收尾不改变链接结论。
pub fn mb_macho_tmp_discard(stage int, dir *u8, file *char) void {
    if (file != 0 && file[0] != 0) { unlink(file) }
    if (stage != 0 && dir != 0 && dir[0] != 0) { rmdir((&dir[0]).to_type(*char)) }
}

// mb_macho_link_single：链接一个 Darwin/ARM64 对象，供单文件 LLVM 命令共用项目参数。
pub fn mb_macho_link_single(object *char, output *char) int {
    if (object == 0 || output == 0) { return errors.fail("Darwin 单文件链接输入无效") }
    let argv [20]*char
    let count int = mb_macho_link_prefix(&argv[0], output)
    if (count < 0) { return -1 }
    argv[count] = object; count += 1
    argv[count] = "-lSystem"; count += 1
    return mb_macho_link_worker(&argv[0], count)
}

// mb_object_machine_matches：校验对象或程序头与当前目标的文件格式和 machine 一致。
// Linux 只接受 ELF64 little-endian，Darwin 只接受 Mach-O 64 little-endian。
pub fn mb_object_machine_matches(path *char) int {
    if (support.read_source(path) != 0 || support.src_ctx().length < 20) { return 0 }
    if (proj.cfg().target.os == support.TARGET_OS_LINUX) {
        if (support.src_ctx().data[0] != 127 || support.src_ctx().data[1] != 'E' || support.src_ctx().data[2] != 'L'
            || support.src_ctx().data[3] != 'F' || support.src_ctx().data[4] != 2 || support.src_ctx().data[5] != 1) {
            return 0
        }
        let machine int = support.src_ctx().data[18].to_type(int) |
            (support.src_ctx().data[19].to_type(int) << 8)
        if (proj.cfg().target.arch == support.TARGET_ARCH_X64) { return machine == 62 ? 1 : 0 }
        if (proj.cfg().target.arch == support.TARGET_ARCH_ARM64) { return machine == 183 ? 1 : 0 }
        return 0
    }
    // COFF 对象：Machine 就是前两个字节（0x8664 = x64），没有 MZ/PE 头。
    if (proj.cfg().target.os == support.TARGET_OS_WINDOWS && support.src_ctx().length >= 20
        && support.src_ctx().data[0] == 0x64 && support.src_ctx().data[1] == 0x86) {
        return proj.cfg().target.arch == support.TARGET_ARCH_X64 ? 1 : 0
    }
    // COFF/PE：`MZ` + e_lfanew 处的 `PE 00 00`，Machine 在 COFF 头偏移 4（0x8664 = x64）。
    if (proj.cfg().target.os == support.TARGET_OS_WINDOWS && support.src_ctx().length >= 0x40
        && support.src_ctx().data[0] == 77 && support.src_ctx().data[1] == 90) {
        let lfanew int = support.src_ctx().data[60].to_type(int) |
            (support.src_ctx().data[61].to_type(int) << 8) |
            (support.src_ctx().data[62].to_type(int) << 16) |
            (support.src_ctx().data[63].to_type(int) << 24)
        if (lfanew <= 0 || lfanew + 6 > support.src_ctx().length) { return 0 }
        if (support.src_ctx().data[lfanew] != 80 || support.src_ctx().data[lfanew + 1] != 69
            || support.src_ctx().data[lfanew + 2] != 0 || support.src_ctx().data[lfanew + 3] != 0) { return 0 }
        let machine int = support.src_ctx().data[lfanew + 4].to_type(int) |
            (support.src_ctx().data[lfanew + 5].to_type(int) << 8)
        if (proj.cfg().target.arch == support.TARGET_ARCH_X64) { return machine == 34404 ? 1 : 0 }
        return 0
    }
    if (proj.cfg().target.os == support.TARGET_OS_DARWIN && support.src_ctx().length >= 8
        && support.src_ctx().data[0] == 207 && support.src_ctx().data[1] == 250
        && support.src_ctx().data[2] == 237 && support.src_ctx().data[3] == 254) {
        let cpu int = support.src_ctx().data[4].to_type(int) |
            (support.src_ctx().data[5].to_type(int) << 8) |
            (support.src_ctx().data[6].to_type(int) << 16) |
            (support.src_ctx().data[7].to_type(int) << 24)
        if (proj.cfg().target.arch == support.TARGET_ARCH_X64) { return cpu == 16777223 ? 1 : 0 }
        if (proj.cfg().target.arch == support.TARGET_ARCH_ARM64) { return cpu == 16777228 ? 1 : 0 }
    }
    return 0
}

// mb_lld_linux_enabled：Linux x64/AArch64 target 且当前 yh 内嵌 lld 时启用进程内链接。
// 目标 ELF 的启动文件、动态加载器与默认库由固定宿主 GCC 的 -### 配置生成；
// 两架构各自在对应宿主构建，不共享架构专用模板。
pub fn mb_lld_linux_enabled() int {
    if (proj.cfg().target.os != support.TARGET_OS_LINUX
        || (proj.cfg().target.arch != support.TARGET_ARCH_X64
            && proj.cfg().target.arch != support.TARGET_ARCH_ARM64)) {
        return 0
    }
    let identity *char = backend.llvm_lld_identity()
    if (identity == 0 || identity[0] == 0) { return 0 }
    return 1
}

// mb_lld_link_worker：在一次性子进程中执行静态内嵌 lld，避免复用不可重入状态。
// 子进程只负责写临时输出并立即退出；父进程依据返回码决定是否发布。
pub fn mb_lld_link_worker(objects **char, object_count int, extra_args **char,
    extra_count int, output *char) int {
    let child int = fork()
    if (child < 0) { return errors.fail("无法启动内嵌 lld worker") }
    if (child == 0) {
        let diagnostic [backend.LLVM_LLD_DIAG]u8
        let status int = backend.llvm_lld_link_driver(output, objects,
            object_count, extra_args, extra_count,
            (&diagnostic[0]).to_type(*char))
        if (status != 0) {
            if (diagnostic[0] != 0) {
                support.write_all(2, &diagnostic[0],
                    strlen((&diagnostic[0]).to_type(*char)).to_type(int))
                support.write_all(2, "\n".to_type(*u8), 1)
            }
            if (status == -2) { exit(253) }
            exit(1)
        }
        exit(0)
    }
    let status int = cmd_process_status(child)
    if (status == 253) { return -2 }
    return status == 0 ? 0 : -1
}

// mb_select_linker：按输出目标选择链接驱动；YH_CC 可显式覆盖，Linux x64 默认
// 使用原生绝对路径，避免 PATH 前置的 ARM64 crossbin/gcc 包装器劫持。
pub fn mb_select_linker(out *u8) *char {
    let selected *char = "gcc"
    if (support.tg_darwin() != 0) { selected = "clang" }
    // Windows 目标：[c].sources 用 clang 编（LLVM 自带 COFF 后端；Windows 宿主上
    // clang 默认就是 x86_64-pc-windows-msvc）。msvcrt 环境没有 gcc。
    if (proj.cfg().target.os == support.TARGET_OS_WINDOWS) { selected = "clang" }
    if (proj.cfg().target.os == support.TARGET_OS_LINUX
        && proj.cfg().target.arch == support.TARGET_ARCH_X64) {
        selected = "/usr/bin/gcc"
    }
    let env_off int = -1
        let env_len int = 0
        if (proj.env_fetch("YH_CC", &env_off, &env_len) == 0 && env_len > 0) {
            if (env_len >= 1200) { errors.fail("YH_CC 路径过长"); return 0.to_type(*char) }
            let i int = 0
            for i < env_len { out[i] = support.pool_ctx().data[env_off + i]; i += 1 }
            out[i] = 0
            if (proj.file_exists(support.arr_cstr(out)) == 0) {
                errors.fail_path("YH_CC 工具不存在: ", support.arr_cstr(out))
                return 0.to_type(*char)
            }
            return support.arr_cstr(out)
        }
    return selected
}

// mb_link：链接一次构建的全部对象。五个阶段各返回 0/-1，失败时统一释放。
pub fn mb_link(out_path *char, build_off int, build_len int,
    count int, root_proj int) int {
    let p LinkPlan
    p.out_path = out_path
    p.build_off = build_off
    p.build_len = build_len
    p.count = count
    p.root_proj = root_proj
    p.llvm_objects = 1
    if (mb_link_prepare(&p) != 0) {
        mb_link_release(&p)
        return -1
    }
    if (mb_link_objects(&p) != 0) {
        mb_link_release(&p)
        return -1
    }
    let hit int = mb_link_key(&p)
    if (hit < 0) {
        mb_link_release(&p)
        return -1
    }
    if (hit != 0) {
        mb_link_release(&p)
        return 0
    }
    if (mb_link_args(&p) != 0) {
        mb_link_release(&p)
        return -1
    }
    if (mb_link_libs(&p) != 0) {
        mb_link_release(&p)
        return -1
    }
    if (mb_link_exec(&p) != 0) {
        mb_link_release(&p)
        return -1
    }
    mb_link_release(&p)
    return 0
}

// POSIX 文件/环境接口：直接声明 C ABI，避免把宿主路径语义塞进 prelude。
@[extern] pub fn realpath(path *char, resolved *char) *char

@[extern] fn stat(path *char, buf *u64) int

@[extern] fn setenv(name *char, value *char, overwrite int) int

@[extern] fn getenv(name *char) *char

// li_select_reset：命令开始时清空 --link 选择。
pub fn li_select_reset() void {
    li_select_n = 0
}

// li_select_add：追加一个组名；重复名称按首次出现去重。
pub fn li_select_add(off int, plen int) int {
    let i int = 0
    for i < li_select_n {
        if (li_select_len[i] == plen) {
            let same int = 1
            let k int = 0
            for k < plen {
                if (support.pool_ctx().data[li_select_off[i] + k]
                    != support.pool_ctx().data[off + k]) { same = 0; break }
                k += 1
            }
            if (same != 0) { return 0 }
        }
        i += 1
    }
    if (li_select_n == li_select_cap) {
        let ncap int = li_select_cap * 2
        if (ncap == 0) { ncap = 4 }
        let no *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        let nl *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (no == 0 || nl == 0) { return errors.fail("--link 选择表内存分配失败") }
        if (li_select_n > 0) {
            memcpy(no, li_select_off, (li_select_n * sizeof(int)).to_type(u64))
            memcpy(nl, li_select_len, (li_select_n * sizeof(int)).to_type(u64))
            free(li_select_off.to_type(*void))
            free(li_select_len.to_type(*void))
        }
        li_select_off = no
        li_select_len = nl
        li_select_cap = ncap
    }
    li_select_off[li_select_n] = off
    li_select_len[li_select_n] = plen
    li_select_n += 1
    return 0
}

// li_select_count：显式 --link 的组数；0 表示默认全部组。
pub fn li_select_count() int { return li_select_n }

// mb_file_stat：读取文件 size/mtime\(ns\)；C6 trim/verify 使用。
// 成功返回 0，读不到返回 -1。
pub fn mb_file_stat(path *char, size *u64, mtime *u64) int {
    let sec u64 = 0
    let nsec u64 = 0
    if (li_stat_file(path, &sec, &nsec, size) != 0) { return -1 }
    mtime[0] = sec * 1000000000 + nsec
    return 0
}

// mb_mix_file_identity：把文件内容的 SHA-256 混入缓存身份（C2）。
// touch、复制或换 mtime 不改变身份；内容变一个字节就会换键。调用方负责决定
// 缓存粒度（编译器每构建一次，工具身份每链接一次），本函数不缓存结果。
pub fn mb_mix_file_identity(out_hash *u64, path *char) int {
    let digest [32]u8
    if (hash.sha256_file(path, &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < 32 {
        proj.fnv(out_hash, digest[i])
        i += 1
    }
    return 0
}

// li_apply_runtime_env：yh run 临时追加共享库目录到宿主加载器变量。
pub fn li_apply_runtime_env() int {
    let dirs *char = li_runtime_path()
    if (dirs == 0 || dirs[0] == 0) { return 0 }
    let name *char = support.tg_host_darwin() != 0 ?
        "DYLD_LIBRARY_PATH" : "LD_LIBRARY_PATH"
    let old *char = getenv(name)
    let buf [16384]u8
    let n int = 0
    if (old != 0) {
        let i int = 0
        for old[i] != 0 && n < 16000 {
            buf[n] = old[i].to_type(u8)
            n += 1
            i += 1
        }
        if (n > 0) { buf[n] = ':'; n += 1 }
    }
    let k int = 0
    for dirs[k] != 0 && n < 16380 {
        buf[n] = dirs[k].to_type(u8)
        n += 1
        k += 1
    }
    buf[n] = 0
    if (setenv(name, support.arr_cstr(&buf[0]), 1) != 0) {
        return errors.fail("无法设置运行时共享库搜索路径")
    }
    return 0
}

// mb_can_fork：本机是否支持 fork 式进程隔离。Windows 没有 fork，模块 worker
// 退化为「在本进程里串行编译」（worker 入口自带会话重置，见 build_scheduler）。
// 这是启动 W2 的最小步骤；真正的 CreateProcess 重入（W2-4b）后续再做。
pub fn mb_can_fork() int {
    // 测试钩子：YH_NO_FORK=1 在 Linux/Darwin 上强制串行路径，用来验证 Windows
    // 宿主的构建流程（否则只有 Windows 机器能覆盖这段代码）。
    let off int = -1
    let len int = 0
    if (proj.env_fetch("YH_NO_FORK", &off, &len) == 0) {
        if (len == 1 && support.pool_ctx().data[off] == '1') { return 0 }
    }
    $if (windows) { return 0 }
    $else { return 1 }
}

// cmd_mkdirs：按路径分隔符逐段创建目录，实现构建所需的 mkdir -p 行为。
pub fn cmd_mkdirs(path *char) int {
    if (path == 0) {
        return -1
    }
    let n int = strlen(path).to_type(int)
    if (n <= 0 || n > 1096) {
        return -1
    }
    let buf [1100]u8
    let i int = 0
    for i < n {
        buf[i] = path[i].to_type(u8)
        i += 1
    }
    buf[n] = 0
    i = 1
    for i <= n {
        if (i == n || buf[i] == '/') {
            let saved u8 = buf[i]
            buf[i] = 0
            if (i > 0 && cmd_mkdir_if_missing(support.arr_cstr(buf)) != 0) {
                return -1
            }
            buf[i] = saved
        }
        i += 1
    }
    return 0
}

// yh_win_spawn_wait：Windows 侧「运行 argv 并等待退出」的包装
// （compiler/llvm/windows_shim.c）。仅无 fork 宿主使用，其余平台不引用。
@[extern] fn yh_win_spawn_wait(argv **char, argc int) int

// yh_win_spawn_capture：Windows 侧「运行 argv 并把 stdout 写到文件」的包装
// （compiler/llvm/windows_shim.c）。仅无 fork 宿主使用，其余平台不引用。
@[extern] fn yh_win_spawn_capture(argv **char, argc int, path *char) int

// cmd_process_status：把 waitpid 的状态字转换为普通退出码或信号退出码。
pub fn cmd_process_status(pid int) int {
    let status int = 0
    if (pid <= 0 || waitpid(pid, &status, 0) != pid) {
        return -1
    }
    if ((status & 127) == 0) {
        return (status >> 8) & 255
    }
    return 128 + (status & 127)
}

// cmd_process_run：用 argv 直接执行程序并等待它结束；失败返回 -1。
pub fn cmd_process_run(argv **char) int {
    if (argv == 0 || argv[0] == 0) {
        return -1
    }
    // Windows 没有 fork/exec：直接 CreateProcessA 并等待（yh run / C 源工具）。
    $if (windows) {
        let count int = 0
        for argv[count] != 0 { count += 1 }
        return yh_win_spawn_wait(argv, count)
    } $else {
        let pid int = fork()
        if (pid < 0) {
            return -1
        }
        if (pid == 0) {
            execvp(argv[0], argv)
            exit(127)
        }
        return cmd_process_status(pid)
    }
}

// cmd_process_capture：在不经过 shell 的前提下捕获子进程标准输出。
// capture_path 是本次调用专属的临时文件路径；函数负责创建、读取并删除它。
// 返回捕获字节数；命令失败、输出超出容量或文件操作失败时返回 -1。
pub fn cmd_process_capture(argv **char, capture_path *char,
    output *u8, capacity int) int {
    if (argv == 0 || argv[0] == 0 || capture_path == 0
        || output == 0 || capacity <= 0) {
        return -1
    }
    $if (windows) {
        let count int = 0
        for argv[count] != 0 { count += 1 }
        if (yh_win_spawn_capture(argv, count, capture_path) != 0) {
            unlink(capture_path)
            return -1
        }
    } $else {
        let pid int = fork()
        if (pid < 0) {
            return -1
        }
        if (pid == 0) {
            let flags int = 0x241
            if (support.tg_host_darwin() != 0) {
                flags = 0x601
            }
            let out_fd int = open(capture_path, flags, 0x1a4)
            if (out_fd < 0) {
                exit(126)
            }
            if (dup2(out_fd, 1) < 0) {
                close(out_fd)
                exit(126)
            }
            close(out_fd)
            execvp(argv[0], argv)
            exit(127)
        }
        if (cmd_process_status(pid) != 0) {
            unlink(capture_path)
            return -1
        }
    }
    let in_fd int = open(capture_path, 0)
    if (in_fd < 0) {
        unlink(capture_path)
        return -1
    }
    let total int = 0
    let failed int = 0
    let chunk [512]u8
    for 1 {
        let got i64 = read(in_fd, (&chunk[0]).to_type(*u8), 512)
        if (got < 0) {
            failed = 1
            break
        }
        if (got == 0) {
            break
        }
        let count int = got.to_type(int)
        if (total + count >= capacity) {
            failed = 1
            break
        }
        let i int = 0
        for i < count {
            output[total + i] = chunk[i]
            i += 1
        }
        total += count
    }
    close(in_fd)
    unlink(capture_path)
    if (failed != 0) {
        return -1
    }
    output[total] = 0
    return total
}

// yh_win_spawn_link：Windows 侧「跑一次 lld 链接子进程」的包装
// （compiler/llvm/windows_shim.c）。stdout 固定接 NUL、stderr 写 stderr_path。
@[extern] fn yh_win_spawn_link(argv **char, argc int, stderr_path *char) int

// mb_lld_windows_enabled：Windows/x64 目标且当前 yh 内嵌 lld 时启用进程内 COFF 链接。
pub fn mb_lld_windows_enabled() int {
    if (proj.cfg().target.os != support.TARGET_OS_WINDOWS
        || proj.cfg().target.arch != support.TARGET_ARCH_X64) {
        return 0
    }
    let identity *char = backend.llvm_lld_identity()
    if (identity == 0 || identity[0] == 0) { return 0 }
    return 1
}

// mb_coff_link_child：--lld-link 子进程入口。响应文件每行一个 argv（路径不含换行），
// 子进程只做一次 lld 链接并退出；父进程等退出后再读/改名产物，句柄已随进程关闭。
// 这样 Windows 也能沿用「临时产物 → 验机 → rename → 链接缓存」的通用流程。
pub fn mb_coff_link_child(path *char) int {
    // 读响应文件失败必须出声：父进程只会看到「链接失败」，子进程静默退 1 会让
    // 定位变成猜谜。
    if (support.read_source(path) != 0) {
        return errors.fail_path("无法读取 COFF 链接响应文件: ", path)
    }
    let n int = support.src_ctx().length
    if (n <= 0) { return errors.fail("COFF 链接响应文件为空") }
    let cap int = n / 2 + 4
    let args **char = support.alloc((cap * sizeof(*char)).to_type(u64)).to_type(**char)
    if (args == 0) { return errors.fail("COFF 链接参数分配失败") }
    let count int = 0
    let start int = 0
    let i int = 0
    for i < n {
        if (support.src_ctx().data[i] == '\n') {
            support.src_ctx().data[i] = 0
            if (i > start) {
                args[count] = (support.src_ctx().data + start).to_type(*char)
                count += 1
            }
            start = i + 1
        }
        i += 1
    }
    if (count <= 0) { return errors.fail("COFF 链接响应文件没有参数") }
    let diag [backend.LLVM_LLD_DIAG]u8
    let rc int = backend.llvm_lld_link_argv(&args[0], count,
        (&diag[0]).to_type(*char))
    if (rc != 0) {
        if (diag[0] != 0) {
            support.write_all(2, &diag[0], strlen((&diag[0]).to_type(*char)).to_type(int))
            support.write_all(2, "\n".to_type(*u8), 1)
        } else {
            // 空诊断会让链接失败完全静默；至少报出 lld 返回码，便于定位。
            let msg [96]u8
            let mn int = support.append_str(&msg[0], 0, "内嵌 lld 链接失败（返回码 ")
            mn = support.append_int(&msg[0], mn, rc)
            mn = support.append_str(&msg[0], mn, "）\n")
            support.write_all(2, &msg[0], mn)
        }
        return 1
    }
    return 0
}

// mb_coff_link_single：单文件链接的 COFF 入口（`yh file.yh -o out`）。
// 装配固定前缀 + 一个对象后交给链接 worker；build 模块只调用这一个窄口，
// 不直接拼 lld argv（前缀/导入库/栈桩属 link 的实现细节）。
pub fn mb_coff_link_single(object *char, out_path *char) int {
    let import_lib [1200]u8
    let chkstk_obj [1200]u8
    if (mb_windows_link_inputs(&import_lib[0], 1200, &chkstk_obj[0], 1200) != 0) {
        return -1
    }
    let out_arg [900]u8
    let oan int = support.append_str(&out_arg[0], 0, "/out:")
    oan = support.append_str(&out_arg[0], oan, out_path)
    out_arg[oan] = 0
    let coff_argv [24]*char
    let cn int = mb_coff_link_prefix(&coff_argv[0], support.arr_cstr(&out_arg[0]),
        support.arr_cstr(&import_lib[0]), support.arr_cstr(&chkstk_obj[0]))
    if (cn < 0) { return -1 }
    coff_argv[cn] = object
    cn += 1
    return mb_coff_link_worker(&coff_argv[0], cn, out_path)
}
