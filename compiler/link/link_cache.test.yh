module link
import support

// ============================================================================
// link_cache.test.yh —— 链接对象行去重（mb_row_dup）
//
// 只由 `cd compiler && ../yh test link` 执行。背景：两个项目产出同名模块 tag
// 时对象路径完全相同，同一 `.o` 会被加入 argv 两次（ld.lld 报 duplicate
// symbol，ld64 只是容忍）。mb_link_args 用本函数按装配后的路径去重。
//
// 覆盖：重复行命中、不同行不命中、rows=0 不命中、rows 之外的行不算命中。
// ============================================================================

test "mb_row_dup：重复行命中，不同行与边界不误判" {
    // 两张 900 字节的行槽（与 LinkPlan.paths 的行宽一致）。
    let paths [1800]u8
    let i int = 0
    for i < 1800 {
        paths[i] = 0.to_type(u8)
        i += 1
    }
    // 第 0 行 "obj/a.o"，第 1 行 "obj/b.o"；两者等长，换写不会留残尾。
    let n0 int = support.append_str(&paths[0], 0, "obj/a.o")
    paths[n0] = 0
    let n1 int = support.append_str(&paths[900], 0, "obj/b.o")
    paths[900 + n1] = 0
    let probe [900]u8
    let pn int = support.append_str(&probe[0], 0, "obj/a.o")
    probe[pn] = 0
    $assert(mb_row_dup(&paths[0], 2, &probe[0]) == 1, "重复行必须命中")
    let qn int = support.append_str(&probe[0], 0, "obj/c.o")
    probe[qn] = 0
    $assert(mb_row_dup(&paths[0], 2, &probe[0]) == 0, "不同行不得命中")
    $assert(mb_row_dup(&paths[0], 0, &probe[0]) == 0, "rows=0 时无命中")
    let bn int = support.append_str(&probe[0], 0, "obj/b.o")
    probe[bn] = 0
    $assert(mb_row_dup(&paths[0], 1, &probe[0]) == 0, "rows 之外的行不算命中")
    $assert(mb_row_dup(&paths[0], 2, &probe[0]) == 1, "rows 之内的第 1 行命中")
}
