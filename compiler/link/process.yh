module link
import support

// process.yh —— 编译器用显式 argv 启动宿主进程，不经过命令解释器。

// cmd_mkdir_if_missing：调用宿主 mkdir API；若目录已存在则确认它确为目录。
fn cmd_mkdir_if_missing(path *char) int {
    if (path == 0) {
        return -1
    }
    if (mkdir(path, 493) == 0) {
        return 0
    }
    let n int = strlen(path).to_type(int)
    if (n < 0 || n > 1096) {
        return -1
    }
    let probe [1100]u8
    let i int = 0
    for i < n {
        probe[i] = path[i].to_type(u8)
        i += 1
    }
    probe[n] = '/'
    probe[n + 1] = '.'
    probe[n + 2] = 0
    let fd int = open(support.arr_cstr(probe), 0)
    if (fd < 0) {
        return -1
    }
    close(fd)
    return 0
}

