module comptime
import token
import errors
import support

import table
const CT_LAYOUT_ARRAY int = 1
const CT_LAYOUT_STRUCT int = 2

// ct_layout_reset：清除本编译单元登记的待完成数组和结构体布局请求。
fn ct_layout_reset() void {
    if (ct_layout_requests != 0) { free(ct_layout_requests) }
    if (ct_value_requests != 0) { free(ct_value_requests) }
    if (ct_value_edges != 0) { free(ct_value_edges) }
    ct_dependency_reset()
    ct_layout_requests = 0
    ct_layout_request_n = 0
    ct_layout_request_cap = 0
    ct_value_requests = 0
    ct_value_request_n = 0
    ct_value_request_cap = 0
    ct_value_edges = 0
    ct_value_edge_n = 0
    ct_value_edge_cap = 0
}

// ct_value_find：按全局符号编号查找布局阶段的 typed CT 常量请求。
fn ct_value_find(sym_id int) int {
    let i int = 0
    for i < ct_value_request_n {
        if (ct_value_requests[i].sym_id == sym_id) { return i }
        i += 1
    }
    return -1
}

// ct_value_request_grow：扩容布局常量请求表，保留已登记节点。
fn ct_value_request_grow() int {
    if (ct_value_request_n < ct_value_request_cap) { return 0 }
    let next_cap int = ct_value_request_cap * 2
    if (next_cap == 0) { next_cap = 16 }
    let next *CtValueRequest = malloc(
        (next_cap * sizeof(CtValueRequest)).to_type(u64)).to_type(*CtValueRequest)
    if (next == 0) { return errors.fail("内存分配失败") }
    if (ct_value_request_n > 0) {
        memcpy(next, ct_value_requests,
            (ct_value_request_n * sizeof(CtValueRequest)).to_type(u64))
    }
    if (ct_value_requests != 0) { free(ct_value_requests) }
    ct_value_requests = next
    ct_value_request_cap = next_cap
    return 0
}

// ct_value_edge_grow：扩容常量依赖边表并保留现有边。
fn ct_value_edge_grow() int {
    if (ct_value_edge_n < ct_value_edge_cap) { return 0 }
    let next_cap int = ct_value_edge_cap * 2
    if (next_cap == 0) { next_cap = 32 }
    let next *CtValueEdge = malloc(
        (next_cap * sizeof(CtValueEdge)).to_type(u64)).to_type(*CtValueEdge)
    if (next == 0) { return errors.fail("内存分配失败") }
    if (ct_value_edge_n > 0) {
        memcpy(next, ct_value_edges,
            (ct_value_edge_n * sizeof(CtValueEdge)).to_type(u64))
    }
    if (ct_value_edges != 0) { free(ct_value_edges) }
    ct_value_edges = next
    ct_value_edge_cap = next_cap
    return 0
}

// ct_value_cycle_visit：深度优先查找未就绪常量图中的环并构造闭环名称链。
fn ct_value_cycle_visit(row int, stack *int, depth int,
    message *u8, message_n *int) int {
    ct_value_requests[row].visit = 1
    stack[depth] = row
    let i int = 0
    for i < ct_value_edge_n {
        if (ct_value_edges[i].owner_sym == ct_value_requests[row].sym_id) {
            let dep int = ct_value_edges[i].dep_sym
            if (dep >= 0 && dep < ct_syms_bound() && ct_sym_row(dep).const_ready == 0) {
                let dep_row int = ct_value_find(dep)
                if (dep_row >= 0 && ct_value_requests[dep_row].visit == 1) {
                    let first int = 0
                    for first <= depth && stack[first] != dep_row { first += 1 }
                    *message_n = support.append_str_limit(message, *message_n,
                        500, "编译期常量依赖环: ")
                    let at int = first
                    for at <= depth {
                        if (at > first) {
                            *message_n = support.append_str_limit(message, *message_n,
                                500, " -> ")
                        }
                        let sym int = ct_value_requests[stack[at]].sym_id
                        *message_n = support.append_str_limit(message, *message_n,
                            500, support.np_cstr(ct_sym_row(sym).name_off))
                        at += 1
                    }
                    *message_n = support.append_str_limit(message, *message_n,
                        500, " -> ")
                    *message_n = support.append_str_limit(message, *message_n,
                        500, support.np_cstr(ct_sym_row(dep).name_off))
                    message[*message_n] = 0
                    return 1
                }
                if (dep_row >= 0 && ct_value_requests[dep_row].visit == 0) {
                    if (ct_value_cycle_visit(dep_row, stack, depth + 1,
                            message, message_n) != 0) { return 1 }
                }
            }
        }
        i += 1
    }
    ct_value_requests[row].visit = 2
    return 0
}

// ct_value_cycle_diagnostic：仅报告常量依赖图内可确认的环，无环时返回 0。
fn ct_value_cycle_diagnostic() int {
    let stack *int = malloc((ct_value_request_n * sizeof(int)).to_type(u64)).to_type(*int)
    if (ct_value_request_n > 0 && stack == 0) { return errors.fail("内存分配失败") }
    let i int = 0
    for i < ct_value_request_n {
        ct_value_requests[i].visit = 0
        i += 1
    }
    let message *u8 = malloc(512.to_type(u64)).to_type(*u8)
    if (message == 0) {
        free(stack)
        return errors.fail("内存分配失败")
    }
    let j int = 0
    for j < ct_value_request_n {
        let sym int = ct_value_requests[j].sym_id
        if (sym >= 0 && sym < ct_syms_bound() && ct_sym_row(sym).const_ready == 0
            && ct_value_requests[j].visit == 0) {
            let message_n int = 0
            if (ct_value_cycle_visit(j, stack, 0, message, &message_n) != 0) {
                free(stack)
                let status int = errors.err_lc(ct_value_requests[j].line,
                    ct_value_requests[j].col, support.arr_cstr(message))
                free(message.to_type(*void))
                return status
            }
        }
        j += 1
    }
    free(stack)
    free(message.to_type(*void))
    return 0
}

// ct_layout_grow：为布局请求表扩容，保留当前编译单元已有请求。
fn ct_layout_grow() int {
    if (ct_layout_request_n < ct_layout_request_cap) { return 0 }
    let next_cap int = ct_layout_request_cap * 2
    if (next_cap == 0) { next_cap = 16 }
    let next *CtLayoutRequest = malloc((next_cap * sizeof(CtLayoutRequest)).to_type(u64)).to_type(*CtLayoutRequest)
    if (next == 0) { return errors.fail("内存分配失败") }
    if (ct_layout_request_n > 0) {
        memcpy(next, ct_layout_requests,
            (ct_layout_request_n * sizeof(CtLayoutRequest)).to_type(u64))
    }
    if (ct_layout_requests != 0) { free(ct_layout_requests) }
    ct_layout_requests = next
    ct_layout_request_cap = next_cap
    return 0
}

// ct_layout_add：追加数组或结构体请求，并记录用于诊断的源码位置。
fn ct_layout_add(kind int, type_id int, const_sym int, length int,
    is_union int, line int, col int, expr_file_id int,
    expr_first int, expr_after int) int {
    if (ct_layout_grow() != 0) { return -1 }
    let row int = ct_layout_request_n
    ct_layout_requests[row].kind = kind
    ct_layout_requests[row].type_id = type_id
    ct_layout_requests[row].const_sym = const_sym
    ct_layout_requests[row].length = length
    ct_layout_requests[row].is_union = is_union
    ct_layout_requests[row].line = line
    ct_layout_requests[row].col = col
    ct_layout_requests[row].ready = 0
    ct_layout_requests[row].expr_file_id = expr_file_id
    ct_layout_requests[row].expr_first = expr_first
    ct_layout_requests[row].expr_after = expr_after
    ct_layout_requests[row].visit = 0
    ct_layout_request_n += 1
    return row
}

// ct_layout_array_find：按「元素类型 + 长度来源」查找既有布局数组类型项。
// 布局期数组类型由请求创建，而同一处声明会在多个 pass 重复解析（pass1、
// CT 捕获、布局登记、布局求值、全局、函数）：同一来源必须复用同一 type_id，
// 否则会与 check.ty_array 的规范项并存（内容相同、编号不同，即 2026-10-07
// 遗留的别名/同长数组类型编号不一致）。
// 来源判据按优先级：同一 const 符号 → 同一长度 token 区间 → 同一已知长度。
fn ct_layout_array_find(elem int, length int, const_sym int,
    file_id int, first int, after int) int {
    let i int = 0
    for i < ct_layout_request_n {
        if (ct_layout_requests[i].kind == CT_LAYOUT_ARRAY) {
            let tid int = ct_layout_requests[i].type_id
            if (tid >= 0 && tid < ct_types_bound()
                && ct_type_row(tid).kind == CT_TY_ARRAY
                && ct_type_row(tid).elem == elem) {
                if (const_sym >= 0 && ct_layout_requests[i].const_sym == const_sym) {
                    return tid
                }
                if (file_id >= 0 && ct_layout_requests[i].expr_file_id == file_id
                    && ct_layout_requests[i].expr_first == first
                    && ct_layout_requests[i].expr_after == after) {
                    return tid
                }
                if (length > 0 && const_sym < 0 && file_id < 0
                    && ct_layout_requests[i].const_sym < 0
                    && ct_layout_requests[i].expr_first < 0
                    && ct_layout_requests[i].length == length) {
                    return tid
                }
            }
        }
        i += 1
    }
    return -1
}

// ct_layout_function_pending：检查 typed 函数签名、表达式或局部绑定是否引用 pending 类型。
fn ct_layout_function_pending(item CtFunction) int {
    if (ct_layout_type_pending(item.ret_type) != 0) { return 1 }
    let i int = 0
    for i < item.param_n {
        if (ct_layout_type_pending(item.params[i].type_id) != 0) { return 1 }
        i += 1
    }
    if (item.ir_ready == 0) { return 0 }
    i = item.ir_expr_first
    for i < item.ir_expr_after {
        let type_id int = ct_ir_exprs[i].type_id
        if (type_id >= 0 && ct_layout_type_pending(type_id) != 0) { return 1 }
        let sizeof_type int = ct_ir_exprs[i].layout_type_id
        if (sizeof_type >= 0 && ct_layout_type_pending(sizeof_type) != 0) { return 1 }
        i += 1
    }
    i = item.ir_binding_first
    for i < item.ir_binding_after {
        if (ct_layout_type_pending(ct_ir_bindings[i].sym_type_id) != 0) { return 1 }
        i += 1
    }
    return 0
}

// ct_layout_function_pending_walk：沿 typed CT 调用节点查找嵌套函数中的 pending 布局。
fn ct_layout_function_pending_walk(sym_id int, path *int, depth int) int {
    if (depth >= 64) { return 0 }
    let i int = 0
    for i < depth {
        if (path[i] == sym_id) { return 0 }
        i += 1
    }
    let row int = ct_find(sym_id)
    if (row < 0) { return 0 }
    path[depth] = sym_id
    let item CtFunction = ct_functions[row]
    if (ct_layout_function_pending(item) != 0 || item.ir_ready == 0) {
        return ct_layout_function_pending(item)
    }
    i = item.ir_expr_first
    for i < item.ir_expr_after {
        let expr CtExpr = ct_ir_exprs[i]
        if (expr.kind == 5 && expr.op == token.TK_DOLLAR
            && expr.sym_id >= 0
            && ct_layout_function_pending_walk(expr.sym_id, path,
                depth + 1) != 0) { return 1 }
        i += 1
    }
    return 0
}

// ct_layout_array_finish：在元素布局 READY 后写入数组最终长度、大小和对齐。
fn ct_layout_array_finish(row int) int {
    let type_id int = ct_layout_requests[row].type_id
    let elem int = ct_type_row(type_id).elem
    let length int = ct_layout_requests[row].length
    if (length <= 0 || ct_type_row(elem).size < 0
        || ct_layout_type_pending(elem) != 0) { return 0 }
    let size int = ct_type_row(elem).size * length
    let align int = ct_type_row(elem).align
    if (align < 1) { align = 1 }
    let padding int = (0 - size) % align
    if (padding < 0) { padding += align }
    ct_type_at(type_id)[0].len = length
    ct_type_at(type_id)[0].size = size + padding
    ct_type_at(type_id)[0].align = align
    ct_layout_requests[row].ready = 1
    return 1
}

// ct_layout_canon_type：数组类型的规范编号（同元素、同长度、同大小项中的最小编号）。
// 布局期可能为同一 (元素, 长度) 建立多个类型项——长度来源不同（const 符号、
// token 区间、已知字面量）时各自成项，内容全同；归一到最小编号后，函数签名
// 等按类型编号比较的路径不再把它们当成不同类型。
fn ct_layout_canon_type(tid int) int {
    if (tid < 0 || tid >= ct_types_bound() || ct_type_row(tid).kind != CT_TY_ARRAY) {
        return tid
    }
    let elem int = ct_type_row(tid).elem
    let alen int = ct_type_row(tid).len
    let size int = ct_type_row(tid).size
    let i int = 0
    for i < tid {
        if (ct_type_row(i).kind == CT_TY_ARRAY && ct_type_row(i).elem == elem
            && ct_type_row(i).len == alen && ct_type_row(i).size == size) {
            return i
        }
        i += 1
    }
    return tid
}

// ct_layout_canonicalize：布局完成后把重复的数组类型编号归一到规范项。
// 改写面覆盖持久保存类型编号的表：类型表（指针/切片/数组的元素）、结构体与
// 联合体字段、签名返回与形参、符号类型。重复项本身保留（内容与规范项相同），
// 归一只保证后续比较与新建类型都走规范编号。
fn ct_layout_canonicalize() int {
    let i int = 0
    for i < ct_types_bound() {
        let kind int = ct_type_row(i).kind
        if (kind == CT_TY_PTR || kind == CT_TY_SLICE || kind == CT_TY_ARRAY) {
            let elem int = ct_type_row(i).elem
            let canon int = ct_layout_canon_type(elem)
            if (canon != elem) { ct_type_at(i)[0].elem = canon }
        }
        i += 1
    }
    i = 0
    for i < ct_fields_bound() {
        let canon int = ct_layout_canon_type(ct_field_row(i).type_id)
        if (canon != ct_field_row(i).type_id) { ct_field_at(i)[0].type_id = canon }
        i += 1
    }
    i = 0
    for i < table.ms().sig_n {
        let canon int = ct_layout_canon_type(table.ms().sig_ret[i])
        if (canon != table.ms().sig_ret[i]) { table.ms().sig_ret[i] = canon }
        i += 1
    }
    i = 0
    for i < table.ms().sigparam_n {
        let canon int = ct_layout_canon_type(table.ms().sig_params[i])
        if (canon != table.ms().sig_params[i]) { table.ms().sig_params[i] = canon }
        i += 1
    }
    i = 0
    for i < ct_syms_bound() {
        let canon int = ct_layout_canon_type(ct_sym_row(i).type_id)
        if (canon != ct_sym_row(i).type_id) { ct_sym_at(i)[0].type_id = canon }
        i += 1
    }
    return 0
}

