module comptime
import support
import token

// ============================================================================
// ct_facts.yh —— CT 执行器读语义事实的零拷贝镜像
//
// 执行器需要类型/符号/静态数据的「形状」，但不得 import gen（否则
// check → comptime → check 成环）。这里用与 gen 结构**逐字段同序同宽**的
// 镜像结构 + 「指针 + 行数」绑定：调用方（check）在进入 CT 前把
// ms().types 等表的指针交进来，执行器按镜像读，不复制、不拥有。
//
// 为什么不用复制：解析期类型表会持续增长，复制会立刻过期；指针绑定只写两个
// 标量，表扩容后重新绑定即可。形状漂移由 check.ct_type_layout_ok() 断言。
// 明确不做：不分配、不释放、不校验下标（调用方保证 tid 在 [0,n)）。
// ============================================================================

// ---- 类型种类镜像常量：数值必须与 gen/model.yh 的 TY_* 一致 ----
// check.ct_type_layout_ok() 会逐项断言，漂移即编译/测试失败。
pub const CT_TY_VOID int = 0
pub const CT_TY_BOOL int = 1
pub const CT_TY_CHAR int = 2
pub const CT_TY_I8 int = 3
pub const CT_TY_I16 int = 4
pub const CT_TY_I32 int = 5
pub const CT_TY_I64 int = 6
pub const CT_TY_U8 int = 7
pub const CT_TY_U16 int = 8
pub const CT_TY_U32 int = 9
pub const CT_TY_U64 int = 10
pub const CT_TY_F32 int = 11
pub const CT_TY_F64 int = 12
pub const CT_TY_PTR int = 13
pub const CT_TY_ARRAY int = 14
pub const CT_TY_SLICE int = 15
pub const CT_TY_STRUCT int = 16
pub const CT_TY_UNION int = 17
pub const CT_TY_ENUM int = 18
pub const CT_TY_FN int = 19

// CtTypeRow：gen.CType 的镜像。字段顺序与宽度必须与 gen.CType 完全一致。
pub struct CtTypeRow {
    kind int // TY_* 种类（与 gen 同值）
    size int // 字节大小
    align int // 字节对齐
    elem int // PTR/ARRAY/SLICE 的元素类型；其余 -1
    len int // ARRAY 长度 / STRUCT 字段数；其余 -1
    sub int // STRUCT 字段表起点 / FN 签名号
}

// ct_rows_slot：指向「gen 的类型表指针字段」的地址（`**CType` 的槽），
// 不是表本身。读的时候每次都解引用，因此表扩容/搬迁后仍然是最新指针。
let ct_rows_slot *void = 0
// ct_n_slot：指向「gen 的类型表行数字段」的地址；同样每次解引用。
let ct_n_slot *int = 0

// ct_types_bind：绑定类型表的「槽」；rows_slot 是 `&TaskCtx.t_types`，
// n_slot 是 `&TaskCtx.t_type_n`。绑定一次即对后续扩容免疫（每次读都解引用）。
// 由 check.ct_types_sync() 在任务初始化时调用。
pub fn ct_types_bind(rows_slot *void, n_slot *int) void {
    ct_rows_slot = rows_slot
    ct_n_slot = n_slot
}

// ct_types_bound：当前类型表行数；0 表示尚未绑定。
pub fn ct_types_bound() int {
    if (ct_n_slot == 0) { return 0 }
    return ct_n_slot[0]
}

// ct_rows：解引用槽得到当前类型表首址。
// 未绑定是内部错误（入口忘了调 check.ct_types_sync）：写诊断后终止，
// 绝不让调用方读到空表而静默算错。
fn ct_rows() *CtTypeRow {
    if (ct_rows_slot == 0 || ct_n_slot == 0) {
        support.fail("内部错误：CT 类型表未绑定（缺 check.ct_types_sync）")
        exit(1)
    }
    let slot **CtTypeRow = ct_rows_slot.to_type(**CtTypeRow)
    return slot[0]
}

// ct_type_row：取第 tid 行镜像；调用方必须保证 0 <= tid < ct_types_bound()。
pub fn ct_type_row(tid int) CtTypeRow {
    let rows *CtTypeRow = ct_rows()
    return rows[tid]
}

// ct_type_at：第 tid 行类型的**可写视图**。
// 注意：`ct_type_row(tid)` 按值返回一行，对它字段赋值只改临时副本（静默丢失）；
// 写表一律走本函数返回的指针。
pub fn ct_type_at(tid int) *CtTypeRow {
    let rows *CtTypeRow = ct_rows()
    return &rows[tid]
}

// ct_ty_kind：类型种类（TY_*）。
pub fn ct_ty_kind(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].kind
}

// ct_ty_size：类型的字节大小。
pub fn ct_ty_size(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].size
}

// ct_ty_align：类型的字节对齐。
pub fn ct_ty_align(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].align
}

// ct_ty_elem：指针/数组/切片的元素类型；其余为 -1。
pub fn ct_ty_elem(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].elem
}

// ct_ty_len：数组长度或结构体字段数；其余为 -1。
pub fn ct_ty_len(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].len
}

// ct_ty_sub：结构体字段表起点或函数签名号。
pub fn ct_ty_sub(tid int) int {
    let rows *CtTypeRow = ct_rows()
    return rows[tid].sub
}

// ct_ty_is_integer：整数类（bool..u64 与 enum），与 support.ty_is_integer 同定义。
pub fn ct_ty_is_integer(tid int) int {
    let k int = ct_ty_kind(tid)
    if (k >= CT_TY_BOOL && k <= CT_TY_U64) { return 1 }
    return (k == CT_TY_ENUM).to_type(int)
}

// ct_ty_is_signed：有符号整数类（char..i64 与 enum），与 support.ty_is_signed 同定义。
pub fn ct_ty_is_signed(tid int) int {
    let k int = ct_ty_kind(tid)
    return ((k >= CT_TY_CHAR && k <= CT_TY_I64) || k == CT_TY_ENUM).to_type(int)
}

// ct_ty_is_float：f32/f64。
pub fn ct_ty_is_float(tid int) int {
    let k int = ct_ty_kind(tid)
    return (k == CT_TY_F32 || k == CT_TY_F64).to_type(int)
}

// CtSymRow：gen.CSym 的镜像。字段顺序与宽度必须与 gen.CSym 完全一致。
pub struct CtSymRow {
    name_off int // 名字池偏移
    name_len int
    kind int // CT_SYM_*
    type_id int
    offset int // 局部/参数：距 fp 的字节距离；全局：bss 清单下标
    flags int // CT_F_*
    cval i64 // 常量值位型；指针常量存数据标签号
    const_ready int // 1 = cval 已就绪，可参与编译期求值
    const_expr_off int
    const_expr_len int
    const_expr_kind int
    def_line int
    def_col int
    ast_binding_row int
}

// —— 符号种类/标志镜像常量：数值必须与 gen/model.yh 一致（check 断言） ——
pub const CT_SYM_VAR int = 0
pub const CT_SYM_CONST int = 1
pub const CT_SYM_FN int = 2
pub const CT_F_GLOBAL int = 1
pub const CT_F_PARAM int = 2
pub const CT_F_PUB int = 4
pub const CT_F_EXTERN int = 8
pub const CT_F_ADDR int = 16
pub const CT_F_AGGPARAM int = 32
pub const CT_F_CABI int = 16384
pub const CT_F_COMPTIME int = 131072
pub const CT_F_ENUM_MEMBER int = 262144
pub const CT_F_ENUM_META int = 524288
pub const CT_F_FIELD_META int = 1048576
pub const CT_F_MODULE_IMPORT int = 2097152

// ct_sym_slot：指向「gen 符号表指针字段」的地址；与类型表同一套路。
let ct_sym_slot *void = 0
// ct_sym_n_slot：指向「符号表行数字段」的地址。
let ct_sym_n_slot *int = 0

// ct_syms_bind：绑定符号表的槽（`&TaskCtx.c_syms` / `&TaskCtx.c_sym_n`）。
pub fn ct_syms_bind(rows_slot *void, n_slot *int) void {
    ct_sym_slot = rows_slot
    ct_sym_n_slot = n_slot
}

// ct_syms_bound：当前符号表行数；0 表示未绑定。
pub fn ct_syms_bound() int {
    if (ct_sym_n_slot == 0) { return 0 }
    return ct_sym_n_slot[0]
}

// ct_sym_row：取第 idx 行符号镜像；未绑定或越界由调用方保证不发生。
pub fn ct_sym_row(idx int) CtSymRow {
    if (ct_sym_slot == 0) {
        support.fail("内部错误：CT 符号表未绑定（缺 check.ct_facts_sync）")
        exit(1)
    }
    let slot **CtSymRow = ct_sym_slot.to_type(**CtSymRow)
    let rows *CtSymRow = slot[0]
    return rows[idx]
}

// ct_sym_at：第 idx 行符号的可写视图（写表一律走指针，理由同 ct_type_at）。
pub fn ct_sym_at(idx int) *CtSymRow {
    if (ct_sym_slot == 0) {
        support.fail("内部错误：CT 符号表未绑定（缺 check.ct_facts_sync）")
        exit(1)
    }
    let slot **CtSymRow = ct_sym_slot.to_type(**CtSymRow)
    let rows *CtSymRow = slot[0]
    return &rows[idx]
}

// ct_sym_declared_before：符号声明位置是否早于 (line,col)（同一文件内）。
// 从 check.sym_declared_before 搬到镜像侧（F4：纯读查询，执行器不再进 gen）。
// 越界符号一律返回 0（与 gen 版一致：下标不可信时按「未声明在前」处理）。
pub fn ct_sym_declared_before(sym int, line int, col int) int {
    if (sym < 0 || sym >= ct_syms_bound()) { return 0 }
    let row CtSymRow = ct_sym_row(sym)
    if (row.def_line < line) { return 1 }
    if (row.def_line == line && row.def_col < col) { return 1 }
    return 0
}

// CtFieldRow：gen.SField 的镜像（结构体/联合体字段表）。
pub struct CtFieldRow {
    name_off int
    name_len int
    type_id int
    offset int // 相对结构体起始的字节偏移
    is_pub int
}

// ct_field_at：第 idx 行字段的可写视图（写表一律走指针，理由同 ct_type_at）。
pub fn ct_field_at(idx int) *CtFieldRow {
    if (ct_field_slot == 0) {
        support.fail("内部错误：CT 字段表未绑定（缺 check.ct_facts_sync）")
        exit(1)
    }
    let slot **CtFieldRow = ct_field_slot.to_type(**CtFieldRow)
    let rows *CtFieldRow = slot[0]
    return &rows[idx]
}

// —— 编译期诊断种类镜像常量：数值必须与 gen/model.yh 一致 ——
pub const CT_DIAG_ASSERT int = 1
pub const CT_DIAG_ERROR int = 2
pub const CT_DIAG_WARN int = 3

// ct_field_slot / ct_field_n_slot：字段表的槽（与类型表同一套路）。
let ct_field_slot *void = 0
let ct_field_n_slot *int = 0

// ct_fields_bind：绑定字段表的槽（`&TaskCtx.t_fields` / `&TaskCtx.t_field_n`）。
pub fn ct_fields_bind(rows_slot *void, n_slot *int) void {
    ct_field_slot = rows_slot
    ct_field_n_slot = n_slot
}

// ct_fields_bound：当前字段表行数；0 表示未绑定。
pub fn ct_fields_bound() int {
    if (ct_field_n_slot == 0) { return 0 }
    return ct_field_n_slot[0]
}

// ct_field_row：取第 idx 行字段镜像。
pub fn ct_field_row(idx int) CtFieldRow {
    if (ct_field_slot == 0) {
        support.fail("内部错误：CT 字段表未绑定（缺 check.ct_facts_sync）")
        exit(1)
    }
    let slot **CtFieldRow = ct_field_slot.to_type(**CtFieldRow)
    let rows *CtFieldRow = slot[0]
    return rows[idx]
}

// CtImportRow：ImportEnt 的镜像（文件导入表一行，8 个 int 字段同序同宽）。
pub struct CtImportRow {
    name_off int // 查找名（模块名）名字池偏移
    name_len int
    proj_key_off int // 跨项目导入的依赖键池偏移；同项目 -1
    proj_key_len int
    alias_off int // 绑定名池偏移
    alias_len int
    line int // 1 基行号
    col int // 1 基列号
}

// ct_imp_slot / ct_imp_n_slot / ct_imp_mod_slot：导入表三张表的槽。
let ct_imp_slot *void = 0
let ct_imp_n_slot *int = 0
let ct_imp_mod_slot *void = 0

// ct_imports_bind：绑定文件导入表（`&TaskCtx.mod_imports` / `&mod_import_n` /
// `&mod_import_mod`）。只传槽，表扩容后镜像自动跟随；每任务一次。
pub fn ct_imports_bind(rows_slot *void, n_slot *int, mod_slot *void) void {
    ct_imp_slot = rows_slot
    ct_imp_n_slot = n_slot
    ct_imp_mod_slot = mod_slot
}

// ct_import_count：当前文件导入表行数；未绑定为 0。
pub fn ct_import_count() int {
    if (ct_imp_n_slot == 0) { return 0 }
    return ct_imp_n_slot[0]
}

// ct_import_row：第 idx 行导入镜像；调用方保证下标有效且已绑定。
pub fn ct_import_row(idx int) CtImportRow {
    if (ct_imp_slot == 0) {
        support.fail("内部错误：CT 导入表未绑定（缺 check.ct_facts_sync）")
        exit(1)
    }
    let slot **CtImportRow = ct_imp_slot.to_type(**CtImportRow)
    let rows *CtImportRow = slot[0]
    return rows[idx]
}

// ct_import_module：第 idx 个导入绑定的模块编号（-1 = 未绑定模块）。
pub fn ct_import_module(idx int) int {
    if (ct_imp_mod_slot == 0) { return -1 }
    let slot **int = ct_imp_mod_slot.to_type(**int)
    return slot[0][idx]
}

// —— 前端模式位：CT 只做「读折叠开关、写结果寻址性」两件事 ——
// 两者都是 support.FrontCtx 的标量字段；用槽绑定读写，执行器不再 import gen。
let ct_fold_slot *void = 0 // &TaskCtx.c_fold（读）
let ct_addr_slot *void = 0 // &TaskCtx.c_res_is_addr（写）

// ct_mode_bind：绑定折叠开关与结果寻址位的槽；由 check.ct_facts_sync 调用。
pub fn ct_mode_bind(fold_slot *void, addr_slot *void) void {
    ct_fold_slot = fold_slot
    ct_addr_slot = addr_slot
}

// ct_fold_mode：当前是否处于「只做常量折叠」模式；未绑定按 0 处理。
pub fn ct_fold_mode() int {
    if (ct_fold_slot == 0) { return 0 }
    let slot *int = ct_fold_slot.to_type(*int)
    return slot[0]
}

// ct_res_is_addr_set：把「刚求得的表达式在栈上留下地址」写回前端。
// 未绑定时静默忽略（调用方一定在 ct_facts_sync 之后才进执行器）。
pub fn ct_res_is_addr_set(v int) void {
    if (ct_addr_slot == 0) { return }
    let slot *int = ct_addr_slot.to_type(*int)
    slot[0] = v
}

// ct_err：编译期诊断（带当前 token 位置），返回 -1 便于链式返回。
// 与 gen.sem_err 同语义：位置取 token 游标；token 表缺失时退化为无位置诊断。
// 放在 ct_facts 是为了让执行器不再依赖 gen 的诊断入口（F4-4）。
pub fn ct_err(msg *char) int {
    let tk *token.TokenCtx = token.ctx()
    if (tk.tokens == 0 || tk.pos < 0 || tk.pos >= tk.count) {
        return support.fail(msg)
    }
    return support.err_lc(tk.tokens[tk.pos].line, tk.tokens[tk.pos].col, msg)
}

// ---------------------------------------------------------------------------
// 字符串标签 / 枚举成员 / 静态数据目录：只读镜像（同样绑定「槽」）
// ---------------------------------------------------------------------------

// CtStaticRow：support.StaticDataObject 的镜像（不含 relocs 内容，只带指针与行数）。
pub struct CtStaticRow {
    sym_id int
    label int
    type_id int
    elem_type int
    count int
    size int
    align int
    data *u8
    relocs *void // 指向 gen 的 StaticDataReloc 数组（只转发给 check 使用）
    reloc_n int
}

let ct_ds_lbl_slot *int = 0
let ct_ds_off_slot *int = 0
let ct_ds_len_slot *int = 0
let ct_ds_q_slot *int = 0
let ct_ds_n_slot *int = 0

let ct_em_off_slot *int = 0
let ct_em_len_slot *int = 0
let ct_em_val_slot *i64 = 0
let ct_em_ready_slot *int = 0
let ct_em_n_slot *int = 0

let ct_static_rows_slot **CtStaticRow = 0
let ct_static_n_slot *int = 0

// ct_tables_bind：绑定字符串标签、枚举成员、静态数据目录的槽。
// 全部传「槽的地址」，表增长/搬迁后读时自动跟随。
pub fn ct_tables_bind(ds_lbl *int, ds_off *int, ds_len *int, ds_q *int,
    ds_n *int, em_off *int, em_len *int, em_val *i64, em_ready *int,
    em_n *int, static_rows **CtStaticRow, static_n *int) void {
    ct_ds_lbl_slot = ds_lbl
    ct_ds_off_slot = ds_off
    ct_ds_len_slot = ds_len
    ct_ds_q_slot = ds_q
    ct_ds_n_slot = ds_n
    ct_em_off_slot = em_off
    ct_em_len_slot = em_len
    ct_em_val_slot = em_val
    ct_em_ready_slot = em_ready
    ct_em_n_slot = em_n
    ct_static_rows_slot = static_rows
    ct_static_n_slot = static_n
}

// pool_byte：读名字池第 off 字节（枚举成员名比较用）。
fn pool_byte(off int) u8 {
    return support.pool_ctx().data[off]
}

// ct_data_str_lookup：按数据标签查字符串字面式字节；1 命中、0 未命中。
pub fn ct_data_str_lookup(lbl int, off *int, slen *int, quoted *int) int {
    if (ct_ds_n_slot == 0) { return 0 }
    let n int = ct_ds_n_slot[0]
    let lbls *int = ct_ds_lbl_slot
    let i int = 0
    for i < n {
        if (lbls[i] == lbl) {
            off[0] = ct_ds_off_slot[i]
            slen[0] = ct_ds_len_slot[i]
            quoted[0] = ct_ds_q_slot[i]
            return 1
        }
        i += 1
    }
    return 0
}

// ct_em_count：枚举成员登记行数。
pub fn ct_em_count() int {
    if (ct_em_n_slot == 0) { return 0 }
    return ct_em_n_slot[0]
}

// ct_em_val / ct_em_ready：枚举成员的值与就绪位。
pub fn ct_em_val(idx int) i64 { return ct_em_val_slot[idx] }
pub fn ct_em_ready(idx int) int { return ct_em_ready_slot[idx] }

// ct_em_find_src：按源码字节 [start,start+n) 反查枚举成员登记行；-1 未命中。
pub fn ct_em_find_src(src *u8, start int, n int) int {
    let rows int = ct_em_count()
    let offs *int = ct_em_off_slot
    let lens *int = ct_em_len_slot
    let i int = 0
    for i < rows {
        if (lens[i] == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (pool_byte(offs[i] + j) != src[start + j]) { match = 0; break }
                j += 1
            }
            if (match != 0) { return i }
        }
        i += 1
    }
    return -1
}

// ct_static_count：静态数据目录行数。
pub fn ct_static_count() int {
    if (ct_static_n_slot == 0) { return 0 }
    return ct_static_n_slot[0]
}

// ct_static_at：取第 row 行静态数据镜像；越界返回 0/1 状态。
pub fn ct_static_at(row int, out *CtStaticRow) int {
    if (ct_static_rows_slot == 0 || row < 0 || row >= ct_static_count()) { return -1 }
    let rows *CtStaticRow = ct_static_rows_slot[0]
    out[0] = rows[row]
    return 0
}
