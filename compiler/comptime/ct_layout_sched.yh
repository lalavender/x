module comptime
import token
import support

// ============================================================================
// ct_layout_sched.yh —— 布局请求的可运行判定与登记（S2，自 parse 迁入）
//
// 这两个函数只读 token 表与语义表（`support.sym_lookup`/`ms()`），并写 comptime
// 自己的依赖图（`ct_value_*`/`ct_layout_function_*`），不重入解析器、不读 AST。
// 放在 comptime 让请求数据与「何时可跑」的判据同处一个模块；`parse` 的两个
// 驱动循环（register / exprs）与 `check` 都可以直接调用。
// ============================================================================

// p_ct_layout_expr_runnable：等待常量和 CT 函数中的 pending sizeof 类型布局就绪。
pub fn ct_layout_expr_runnable(first int, after int) int {
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST
                && support.ms().syms[sym].const_ready == 0) { return 0 }
        }
        if (kind == token.TK_DOLLAR && i + 1 < after
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            let sym int = support.sym_lookup(token.ctx().tokens[i + 1].start,
                token.ctx().tokens[i + 1].len)
            if (sym >= 0 && ct_layout_function_sym_pending(sym) != 0) {
                return 0
            }
        }
        if (kind == token.TK_SIZEOF && i + 3 < after
            && token.ctx().tokens[i + 1].kind == token.TK_LPAREN
            && token.ctx().tokens[i + 2].kind == token.TOK_IDENT) {
            let tid int = support.ty_lookup_name(token.ctx().tokens[i + 2].start,
                token.ctx().tokens[i + 2].len)
            if (tid >= 0 && ct_layout_type_pending(tid) != 0) { return 0 }
        }
        i += 1
    }
    return 1
}

// p_ct_layout_expr_register：记录数组长度表达式直接依赖的值、类型和 CT 函数闭包。
pub fn ct_layout_expr_register(row int) int {
    let first int = ct_layout_expr_first(row)
    let after int = ct_layout_expr_after(row)
    let i int = first
    for i < after {
        let kind int = token.ctx().tokens[i].kind
        if (kind == token.TOK_IDENT
            && (i == first || (token.ctx().tokens[i - 1].kind != token.TK_DOT
                && token.ctx().tokens[i - 1].kind != token.TK_DOLLAR))) {
            let sym int = support.sym_lookup(token.ctx().tokens[i].start, token.ctx().tokens[i].len)
            if (sym >= 0 && sym < support.ms().sym_n
                && support.ms().syms[sym].kind == support.SYM_CONST) {
                if (ct_layout_expr_value_dependency_add(row, sym) != 0) {
                    return -1
                }
                // 长度表达式引用的普通整数常量也要在布局期求出值：
                // `const N int = 3;` 原本只在全局子遍就绪，而全局/字段/形参
                // 位置的 `[N]int` 在布局子遍就要定长。仅限声明在前的常量，
                // 前向引用保持既有「编译期常量尚未就绪」诊断。
                if (support.ms().syms[sym].const_ready == 0
                    && ct_sym_declared_before(sym, token.ctx().tokens[first].line,
                        token.ctx().tokens[first].col) != 0
                    && ct_value_request_add(sym, support.ms().syms[sym].def_line,
                        support.ms().syms[sym].def_col) != 0) {
                    return -1
                }
            }
        }
        if (kind == token.TK_SIZEOF && i + 3 < after
            && token.ctx().tokens[i + 1].kind == token.TK_LPAREN
            && token.ctx().tokens[i + 2].kind == token.TOK_IDENT) {
            let tid int = support.ty_lookup_name(token.ctx().tokens[i + 2].start,
                token.ctx().tokens[i + 2].len)
            if (tid >= 0
                && ct_layout_expr_type_dependency_add(row, tid) != 0) {
                return -1
            }
        }
        if (kind == token.TK_DOLLAR && i + 1 < after
            && token.ctx().tokens[i + 1].kind == token.TOK_IDENT) {
            let sym int = support.sym_lookup(token.ctx().tokens[i + 1].start,
                token.ctx().tokens[i + 1].len)
            if (sym >= 0
                && ct_layout_expr_function_dependency_add(row, sym) != 0) {
                return -1
            }
        }
        i += 1
    }
    return 0
}
