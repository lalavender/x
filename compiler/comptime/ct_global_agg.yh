module comptime

// ============================================================================
// ct_global_agg.yh —— 全局聚合常量（顶层 const 数组/结构体）的编译期模型
//
// 背景：全局聚合常量的 cval 是**数据段标签**，数据要到发射阶段才写出，而编译期
// 执行发生在语义阶段，因此 `TABLE[0]`、`P.x`、`for v in TABLE`、把 TABLE 当聚合
// 实参传参此前只能拒绝（"编译期不支持下标访问全局聚合常量"）。前端的字面量初始化
// 在语义阶段就知道每个元素/字段的值，这里把它们建成 CtAggregate 对象（局部聚合
// 常量早就这么做），编译期读下标/字段/迭代/传参于是复用既有聚合路径。
//
// 所有权：模型对象放在独立的只增区 ct_global_pool（与顶层实参临时构造区同一取舍：
// 借用出去的对象可能被结果池保留，主动释放有悬空风险）；登记表按编译单元清空
// （ct_global_agg_reset 由 ct_reset 调用），元素总量由 ct_ir_aggregate_new 的
// 100000 上限兜住。
// ============================================================================

// CtGlobalAgg：一个全局聚合常量的编译期模型登记项。
struct CtGlobalAgg {
    sym_id int // 全局 const 的符号编号。
    obj i64 // 模型对象指针（CtAggregate 元素值区首地址）。
}

// ct_global_agg_cap：登记表容量；超出时给出明确诊断，不静默丢弃模型。
let ct_global_agg_cap int = 1024
// ct_global_pool：全局聚合常量模型的拥有区（只增不减，见文件头所有权说明）。
let ct_global_pool CtFrame
let ct_global_aggs [1024]CtGlobalAgg
let ct_global_agg_n int = 0

// ct_global_agg_slot：把模型对象与元素下标解析成 CtValue 槽；越界返回 0。
fn ct_global_agg_slot(obj i64, index int) *CtValue {
    if (obj == 0) { return 0 }
    let aggregate *CtAggregate = obj.to_type(u64).to_type(*CtAggregate)
    if (aggregate == 0 || aggregate.values == 0 || index < 0
        || index >= aggregate.count) { return 0 }
    return &aggregate.values[index]
}

// ct_global_agg_owns：判断聚合对象是否属于全局聚合常量的编译期模型。
// 模型的元素槽只供读取（取址/写入没有只读别名语义），诊断与只读保护按它区分
// 「全局常量」与「临时聚合」两类非局部基址。
fn ct_global_agg_owns(aggregate *CtAggregate) int {
    if (aggregate == 0) { return 0 }
    let item *CtAggregate = ct_global_pool.aggregates
    for item != 0 {
        if (item == aggregate) { return 1 }
        item = item.next
    }
    return 0
}

// ct_global_agg_chain：返回全局聚合常量模型拥有区的链头（含嵌套子对象）。
fn ct_global_agg_chain() *CtAggregate {
    return ct_global_pool.aggregates
}

// ct_global_agg_hit：判断进程地址是否落在任一模型对象的元素槽区间内。
// 与 ct_pool_hit 的用途一致：解引用读取经 ct_ir_pointer_target 解析槽（允许），
// 写入在赋值语句统一按此拒绝（只读别名语义）。
fn ct_global_agg_hit(addr i64) int {
    if (addr == 0) { return 0 }
    let a u64 = addr.to_type(u64)
    let item *CtAggregate = ct_global_pool.aggregates
    for item != 0 {
        if (item.values != 0 && item.count > 0) {
            let start u64 = item.values.to_type(u64)
            let bytes u64 = (item.count * sizeof(CtValue)).to_type(u64)
            if (a >= start && a < start + bytes) { return 1 }
        }
        item = item.next
    }
    return 0
}

// ct_global_agg_reset：清空登记表（模型对象留在只增区，随进程结束回收）。
fn ct_global_agg_reset() void {
    ct_global_agg_n = 0
}
