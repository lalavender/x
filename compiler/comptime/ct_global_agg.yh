module comptime;
import gen;

// ============================================================================
// ct_global_agg.yh —— 全局聚合常量（顶层 const 数组/结构体）的编译期模型
//
// 背景：全局聚合常量的 cval 是**数据段标签**，数据要到发射阶段才写出，而编译期
// 执行发生在语义阶段，因此 `TABLE[0]`、`P.x`、`for v in TABLE`、把 TABLE 当聚合
// 实参传参此前只能拒绝（"编译期不支持下标访问全局聚合常量"）。前端的字面量初始化
// 在语义阶段就知道每个元素/字段的值，这里把它们建成 CtAggregate 对象（局部聚合
// 常量早就这么做），编译期读下标/字段/迭代/传参于是复用既有聚合路径。
//
// 所有权：模型对象放在独立的只增区 ct_global_pool（与顶层实参临时构造区同一取舍：
// 借用出去的对象可能被结果池保留，主动释放有悬空风险）；登记表按编译单元清空
// （ct_global_agg_reset 由 ct_reset 调用），元素总量由 ct_ir_aggregate_new 的
// 100000 上限兜住。
// ============================================================================

// CtGlobalAgg：一个全局聚合常量的编译期模型登记项。
struct CtGlobalAgg {
    sym_id int; // 全局 const 的符号编号。
    obj i64; // 模型对象指针（CtAggregate 元素值区首地址）。
}

// ct_global_agg_cap：登记表容量；超出时给出明确诊断，不静默丢弃模型。
let ct_global_agg_cap int = 1024;
// ct_global_pool：全局聚合常量模型的拥有区（只增不减，见文件头所有权说明）。
let ct_global_pool CtFrame;
let ct_global_aggs [1024]CtGlobalAgg;
let ct_global_agg_n int = 0;

// ct_global_agg_modelable：判断类型能否在编译期建模。
// 只接受整数/浮点标量、整数或浮点元素的定长数组，以及字段递归满足同一条件的
// 结构体。指针（含字符串元素）、切片、联合体不建模：前端的全局初始化对它们
// 要么拒绝，要么只能给出数据标签，建模会得到错误的元素值。
pub fn ct_global_agg_modelable(type_id int, depth int) int {
    let gs *gen.GenState = gen.G();
    if (depth >= 32 || type_id < 0 || type_id >= gs.t_type_n) { return 0; }
    if (gen.ty_is_integer(type_id) != 0 || gen.ty_is_float(type_id) != 0) {
        return 1;
    }
    let kind int = gs.t_types[type_id].kind;
    if (kind == gen.TY_ARRAY) {
        let elem int = gs.t_types[type_id].elem;
        return (gen.ty_is_integer(elem) != 0 || gen.ty_is_float(elem) != 0)
            .to_type(int);
    }
    if (kind == gen.TY_STRUCT) {
        let st gen.CType = gs.t_types[type_id];
        let i int = 0;
        for i < st.len {
            if (ct_global_agg_modelable(gs.t_fields[st.sub + i].type_id,
                    depth + 1) == 0) { return 0; }
            i += 1;
        }
        return 1;
    }
    return 0;
}

// ct_global_agg_new：在全局常量区建一个模型对象并预置零值，返回对象指针；
// 0 表示失败（诊断已给出）。elem_type 约定同 ct_ir_aggregate_new：数组传元素
// 类型、结构体传自身类型。结构体按字段类型逐个预置类型，命名式字面量漏写的
// 字段因此得到正确的零值类型。
pub fn ct_global_agg_new(elem_type int, count int) i64 {
    let gs *gen.GenState = gen.G();
    let aggregate *CtAggregate = ct_ir_aggregate_new(&ct_global_pool,
        elem_type, count);
    if (aggregate == 0) { return 0; }
    let struct_like int = (elem_type >= 0 && elem_type < gs.t_type_n
        && gs.t_types[elem_type].kind == gen.TY_STRUCT).to_type(int);
    let st gen.CType;
    if (struct_like != 0) { st = gs.t_types[elem_type]; }
    let i int = 0;
    for i < count {
        let slot_type int = elem_type;
        if (struct_like != 0 && i < st.len) {
            slot_type = gs.t_fields[st.sub + i].type_id;
        }
        aggregate.values[i].type_id = slot_type;
        aggregate.values[i].value = 0;
        aggregate.values[i].is_lit = 0;
        aggregate.values[i].lit_big = 0;
        i += 1;
    }
    return aggregate.to_type(u64).to_type(i64);
}

// ct_global_agg_slot：把模型对象与元素下标解析成 CtValue 槽；越界返回 0。
fn ct_global_agg_slot(obj i64, index int) *CtValue {
    if (obj == 0) { return 0; }
    let aggregate *CtAggregate = obj.to_type(u64).to_type(*CtAggregate);
    if (aggregate == 0 || aggregate.values == 0 || index < 0
        || index >= aggregate.count) { return 0; }
    return &aggregate.values[index];
}

// ct_global_agg_set：写入模型第 index 个元素/字段的标量值，按目标类型归一
// （整数截断到宽度、浮点窄化）。返回 0 成功，-1 表示内部越界。
pub fn ct_global_agg_set(obj i64, index int, type_id int, value i64) int {
    let slot *CtValue = ct_global_agg_slot(obj, index);
    if (slot == 0) {
        return gen.sem_err("内部错误：全局聚合常量模型写入越界");
    }
    slot.type_id = type_id;
    slot.value = ct_ir_norm_scalar(type_id, value);
    slot.is_lit = 0;
    slot.lit_big = 0;
    return 0;
}

// ct_global_agg_set_obj：写入模型第 index 个元素/字段的嵌套聚合对象指针。
pub fn ct_global_agg_set_obj(obj i64, index int, type_id int,
    child i64) int {
    let slot *CtValue = ct_global_agg_slot(obj, index);
    if (slot == 0 || child == 0) {
        return gen.sem_err("内部错误：全局聚合常量嵌套模型写入越界");
    }
    slot.type_id = type_id;
    slot.value = child;
    slot.is_lit = 0;
    slot.lit_big = 0;
    return 0;
}

// ct_global_agg_register：登记符号的编译期模型；同一符号重复登记（多遍解析）
// 时覆盖旧对象，保持「最后一个模型生效」。
pub fn ct_global_agg_register(sym_id int, obj i64) int {
    if (sym_id < 0 || obj == 0) {
        return gen.sem_err("内部错误：全局聚合常量模型登记参数无效");
    }
    let i int = 0;
    for i < ct_global_agg_n {
        if (ct_global_aggs[i].sym_id == sym_id) {
            ct_global_aggs[i].obj = obj;
            return 0;
        }
        i += 1;
    }
    if (ct_global_agg_n >= ct_global_agg_cap) {
        return gen.sem_err("全局聚合常量过多（编译期模型上限 1024 个）");
    }
    ct_global_aggs[ct_global_agg_n].sym_id = sym_id;
    ct_global_aggs[ct_global_agg_n].obj = obj;
    ct_global_agg_n += 1;
    return 0;
}

// ct_global_agg_lookup：查符号的编译期模型对象指针；未登记返回 0。
pub fn ct_global_agg_lookup(sym_id int) i64 {
    let i int = 0;
    for i < ct_global_agg_n {
        if (ct_global_aggs[i].sym_id == sym_id) { return ct_global_aggs[i].obj; }
        i += 1;
    }
    return 0;
}

// ct_global_agg_owns：判断聚合对象是否属于全局聚合常量的编译期模型。
// 模型的元素槽只供读取（取址/写入没有只读别名语义），诊断与只读保护按它区分
// 「全局常量」与「临时聚合」两类非局部基址。
fn ct_global_agg_owns(aggregate *CtAggregate) int {
    if (aggregate == 0) { return 0; }
    let item *CtAggregate = ct_global_pool.aggregates;
    for item != 0 {
        if (item == aggregate) { return 1; }
        item = item.next;
    }
    return 0;
}

// ct_global_agg_chain：返回全局聚合常量模型拥有区的链头（含嵌套子对象）。
fn ct_global_agg_chain() *CtAggregate {
    return ct_global_pool.aggregates;
}

// ct_global_agg_hit：判断进程地址是否落在任一模型对象的元素槽区间内。
// 与 ct_pool_hit 的用途一致：解引用读取经 ct_ir_pointer_target 解析槽（允许），
// 写入在赋值语句统一按此拒绝（只读别名语义）。
fn ct_global_agg_hit(addr i64) int {
    if (addr == 0) { return 0; }
    let a u64 = addr.to_type(u64);
    let item *CtAggregate = ct_global_pool.aggregates;
    for item != 0 {
        if (item.values != 0 && item.count > 0) {
            let start u64 = item.values.to_type(u64);
            let bytes u64 = (item.count * sizeof(CtValue)).to_type(u64);
            if (a >= start && a < start + bytes) { return 1; }
        }
        item = item.next;
    }
    return 0;
}

// ct_global_agg_reset：清空登记表（模型对象留在只增区，随进程结束回收）。
fn ct_global_agg_reset() void {
    ct_global_agg_n = 0;
}
