module comptime
import errors

// ct_grow：扩大当前模块的编译期函数目录。
fn ct_grow() int {
    let ncap int = ct_function_cap * 2
    if (ncap == 0) { ncap = 16 }
    let next *CtFunction = malloc((ncap * sizeof(CtFunction)).to_type(u64)).to_type(*CtFunction)
    if (next == 0) { return errors.fail("编译期函数目录分配失败") }
    if (ct_function_n > 0) {
        memcpy(next, ct_functions, (ct_function_n * sizeof(CtFunction)).to_type(u64))
    }
    if (ct_functions != 0) { free(ct_functions.to_type(*void)) }
    ct_functions = next
    ct_function_cap = ncap
    return 0
}

// ct_invoke_in_frame：验证实参并执行函数，将聚合结果限制在调用方帧生命周期内。
fn ct_invoke_in_frame(caller *CtFrame, sym_id int, args *CtValue,
    arg_n int, out *CtValue) int {
    let row int = ct_find(sym_id)
    if (row < 0) { return ct_err("编译期函数正文不在当前编译单元中") }
    let target CtFunction = ct_functions[row]
    if (ct_layout_function_sym_pending(sym_id) != 0) {
        return ct_err("编译期函数引用了尚未完成布局的类型")
    }
    if (arg_n != target.param_n) { return ct_err("编译期调用实参数量与函数签名不符") }
    if (ct_ir_return_supported(target.ret_type) == 0) {
        return ct_err("编译期函数返回值类型不受支持")
    }
    let typed int = (target.ir_ready != 0 && target.ir_supported != 0).to_type(int)
    let return_kind int = ct_type_row(target.ret_type).kind
    let aggregate_return int = ((return_kind == CT_TY_ARRAY
        || return_kind == CT_TY_STRUCT || return_kind == CT_TY_SLICE
        || return_kind == CT_TY_UNION).to_type(int))
    if (aggregate_return != 0 && (caller == 0 || typed == 0)) {
        return ct_err("编译期聚合返回只支持嵌套 typed IR 调用")
    }
    let call_values [64]CtValue
    let i int = 0
    for i < arg_n {
        let param_type int = target.params[i].type_id
        if (ct_ir_param_supported(param_type) == 0) {
            return ct_err("编译期函数形参类型不受支持")
        }
        if (ct_ty_is_integer(param_type) == 0 && ct_ty_is_float(param_type) == 0
            && typed == 0) {
            return ct_err("编译期聚合或指针形参要求函数具有受支持的 typed IR 正文")
        }
        if (ct_can_assign(param_type, args[i].type_id,
                args[i].is_lit, args[i].value, args[i].lit_big) != 0) { return -1 }
        if (ct_type_row(param_type).kind == CT_TY_SLICE
            && ct_ir_slice_param_valid(param_type, &args[i]) == 0) {
            return ct_err("编译期切片形参需要有效的本地数组或切片视图")
        }
        call_values[i] = args[i]
        if (ct_pool_adopt_label(&call_values[i]) != 0) { return -1 }
        call_values[i].type_id = param_type
        call_values[i].is_lit = 0
        call_values[i].lit_big = 0
        i += 1
    }
    if (ct_eval_depth >= 64) {
        return ct_err("编译期函数调用深度超过 64 层")
    }
    ct_eval_depth += 1
    let value CtValue
    let status int = 0
    if (target.ir_ready != 0 && target.ir_supported != 0) {
        status = ct_eval_ir_body(target, &call_values[0], &value, caller)
    } else {
        // typed IR 是唯一执行器：正文不在支持子集内的函数不再回退 token 解释，
        // 按捕获时记录的原因码指出具体构造，便于在源码快照中定位。
        return ct_unsupported_diagnostic(target.ir_unsupported)
    }
    ct_eval_depth -= 1
    if (status != 0) { return -1 }
    if (ct_can_assign(target.ret_type, value.type_id, value.is_lit,
            value.value, value.lit_big) != 0) { return -1 }
    *out = value
    out.type_id = target.ret_type
    return 0
}

// ct_unsupported_diagnostic：按捕获时记录的原因码报告不受支持的正文构造。
fn ct_unsupported_diagnostic(code int) int {
    if (code == 100) {
        return ct_err("编译期函数正文的类型声明不在受支持的 typed IR 子集内")
    }
    if (code == 200) {
        return ct_err("编译期函数正文的 goto 语句不在受支持的 typed IR 子集内")
    }
    if (code == 300) {
        return ct_err("编译期函数正文的标签语句不在受支持的 typed IR 子集内")
    }
    if (code == 400) {
        return ct_err("编译期函数正文的编译期语句不在受支持的 typed IR 子集内")
    }
    if (code == 500) {
        return ct_err("编译期函数正文含不在受支持的 typed IR 子集内的语句")
    }
    if (code == 600) {
        return ct_err("编译期函数正文含不在受支持的 typed IR 子集内的表达式")
    }
    if (code == 700) {
        return ct_err("编译期函数正文含缺少类型的表达式（typed IR 子集要求完整类型）")
    }
    return ct_err("编译期函数正文不在受支持的 typed IR 子集内")
}

// —— pub 聚合常量（$ 调用初始化）的闭包可达种子 ——
// 提供方把 `pub const TBL [3]int = $mk();` 初始化式里调用的编译期函数登记
// 到这里（仅模块模式、pub、`$IDENT(...)` 同模块形态），.s.ct 闭包发射时
// 把它们作为初始可达种子，保证导入方重放声明后能执行同一调用。
let ct_pub_agg_fn [64]int
let ct_pub_agg_fn_n int = 0

