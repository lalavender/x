module comptime;

// CtToken：快照中保留求值所需的词法信息，避免持有前端可复用 token 表。
pub struct CtToken {
    kind int;
    start int;
    len int;
    line int;
    col int;
}

// CtParam：编译期函数形参在源快照中的名字范围和已解析类型。
pub struct CtParam {
    name_start int;
    name_len int;
    type_id int;
}

// CtFunction：编译期函数的私有签名及其源/token 快照。
pub struct CtFunction {
    sym_id int;
    ret_type int;
    param_n int;
    params *CtParam;
    src *u8;
    body *CtToken;
    body_n int;
}

// CtValue：编译期整数求值结果，沿用前端常量赋值所需的类型与字面量信息。
pub struct CtValue {
    type_id int;
    value i64;
    is_lit int;
    lit_big int;
}

// CtReader：一次函数体表达式求值的只读 token 游标和形参绑定。
pub struct CtReader {
    target CtFunction;
    values *CtValue;
    pos int;
}

let ct_functions *CtFunction = 0;
let ct_function_n int = 0;
let ct_function_cap int = 0;
let ct_expansion_count int = 0;
