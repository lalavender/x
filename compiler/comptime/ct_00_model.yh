module comptime;

// CtToken：快照中保留求值所需的词法信息，避免持有前端可复用 token 表。
pub struct CtToken {
    kind int;
    start int;
    len int;
    line int;
    col int;
}

// CtParam：编译期函数形参在源快照中的名字范围和已解析类型。
pub struct CtParam {
    name_start int;
    name_len int;
    type_id int;
}

// CtImport：保存编译期函数定义文件中的导入别名及其已绑定模块编号。
pub struct CtImport {
    alias_off int; // 导入别名在全局名字池中的偏移。
    alias_len int; // 导入别名字节长度。
    module_id int; // 已加载模块接口在 c_mods 中的编号。
}

// CtFunction：编译期函数的私有签名及其源/token 快照。
pub struct CtFunction {
    sym_id int;
    ret_type int;
    param_n int;
    params *CtParam;
    import_n int;
    imports *CtImport;
    src *u8;
    src_path *u8; // 定义源码路径副本；跨模块闭包转发时继续保留来源。
    src_path_len int; // 定义源码路径字节长度，不含结尾 NUL。
    src_body_line int; // 原始函数体左花括号的 1 基行号。
    src_line_bias int; // 当前快照行号转换为定义源码行号的偏移。
    body *CtToken;
    body_n int;
    body_token_first int;
    ir_ready int;
    ir_supported int;
    ir_unsupported int; // 正文不受支持时的原因码（CT_UNSUP_*），0 表示受支持。
    ir_expr_first int;
    ir_expr_after int;
    ir_stmt_first int;
    ir_stmt_after int;
    ir_edge_first int;
    ir_edge_after int;
    ir_binding_first int;
    ir_binding_after int;
    ir_body_stmt int;
}

// CtExpr：与前端 AstExpr 字段布局一致的编译期私有表达式节点快照。
pub struct CtExpr {
    kind int;
    op int;
    first int;
    after int;
    token_count int;
    file_id int;
    type_id int;
    owner_decl int;
    sym_id int;
    sym_name_off int;
    sym_name_len int;
    binding_row int;
    sym_type_id int;
    sym_kind int;
    sym_flags int;
    sym_offset int;
    is_const int;
    const_bits i64;
    is_lit int;
    lit_big int;
    fval_bits i64;
    layout_type_id int;
    child0 int;
    child1 int;
    child2 int;
}

// CtStmt：与前端 AstStmt 字段布局一致的编译期私有语句节点快照。
pub struct CtStmt {
    kind int;
    op int;
    first int;
    after int;
    token_count int;
    file_id int;
    parent int;
    first_child int;
    last_child int;
    next_sibling int;
    root_next int;
    first_expr int;
    last_expr int;
    first_binding int;
    last_binding int;
}

// CtEdge：表达式根边，布局与前端 AstStmtExpr 保持一致。
pub struct CtEdge {
    expr_id int;
    next int;
}

// CtBinding：编译期局部槽快照，布局与前端 AstBinding 保持一致。
pub struct CtBinding {
    id int;
    sym_id int;
    sym_type_id int;
    sym_kind int;
    sym_flags int;
    sym_offset int;
    file_id int;
    owner_decl int;
    stmt_id int;
    name_token int;
    is_param int;
    next int;
}

// CtValue：编译期整数求值结果，沿用前端常量赋值所需的类型与字面量信息。
pub struct CtValue {
    type_id int;
    value i64;
    is_lit int;
    lit_big int;
}

// CtAggregate：调用帧的数组元素区、结构体字段值区，或指向数组元素区的非拥有视图。
pub struct CtAggregate {
    values *CtValue; // 首个可见值；数组视图指向底层存储的偏移位置。
    count int; // 数组/切片视图长度或结构体字段数。
    elem_type int; // 数组元素类型；结构体字段区保存所属结构体类型。
    owned int; // 1 表示释放时释放 values；0 表示 values 由源聚合拥有。
    next *CtAggregate; // 调用帧创建链，返回或失败时统一释放聚合头与自有数据。
}

// CtPlace：编译期赋值目标，可指向局部值槽、聚合元素或当前帧内的直接值槽。
pub struct CtPlace {
    slot int; // 局部绑定槽；聚合元素位置同时记录其所属基址槽。
    aggregate *CtAggregate; // 非空表示目标是聚合元素，空表示普通局部值。
    index int; // 聚合元素下标；普通局部值为 -1。
    type_id int; // 赋值目标的元素类型或局部变量类型。
    direct *CtValue; // 非空表示目标由受检查的局部指针直接寻址。
}

// CtPoolSpan：编译期字符串字面量的只读字节池区间（每字节一个 CtValue 槽）。
pub struct CtPoolSpan {
    addr i64; // 首字节槽的进程内地址。
    count int; // 槽数（含结尾 NUL 槽）。
    elem int; // 元素类型：TY_CHAR、TY_U8 或 TY_I8。
    key i64; // 字节来源键：函数体字面量用源字节起点，全局常量用 -(intern 偏移 + 1)。
}

// CtLayoutRequest：等待编译期常量或元素布局就绪的数组/结构体布局项。
pub struct CtLayoutRequest {
    kind int; // 1 = 数组，2 = struct/union。
    type_id int;
    const_sym int; // 数组长度来源；已知长度或结构体请求为 -1。
    length int; // 未求值的 const 长度为 -1。
    is_union int;
    line int;
    col int;
    ready int;
    expr_file_id int; // 长度表达式所在源文件；无延迟表达式时为 -1。
    expr_first int; // 长度表达式 token 起点；无延迟表达式时为 -1。
    expr_after int; // 长度表达式 token 终点；半开区间。
    visit int; // 混合依赖图 DFS 状态：0 未访问、1 活动、2 完成。
}

// CtValueRequest：布局阶段延迟执行的 typed CT 整数全局常量及其诊断位置。
pub struct CtValueRequest {
    sym_id int; // 被求值的全局整数 const 符号。
    line int; // 初始化器声明位置，用于未就绪或依赖环诊断。
    col int;
    visit int; // 依赖环深度优先遍历状态：0 未访问、1 活动、2 完成。
}

// CtValueEdge：一个布局常量初始化器引用的未就绪全局 const。
pub struct CtValueEdge {
    owner_sym int;
    dep_sym int;
}

// CtDependencyEdge：把编译期常量和值布局统一连接到值/布局依赖节点。
pub struct CtDependencyEdge {
    owner_kind int; // 1 = 编译期常量，2 = 类型布局。
    owner_id int; // 值符号编号或类型编号。
    dep_kind int; // 1 = 编译期常量，2 = 类型布局。
    dep_id int; // 值符号编号或类型编号。
}

// CtDependencyNode：混合依赖环诊断 DFS 中的一个值或布局节点。
pub struct CtDependencyNode {
    kind int; // 1 = 编译期常量，2 = 类型布局。
    id int; // 值符号编号或类型编号。
}

// CtFrame：一次 typed IR 执行帧的局部槽与函数绑定范围。
pub struct CtFrame {
    target CtFunction;
    locals *CtValue;
    local_n int;
    aggregates *CtAggregate;
    aggregate_element_count int;
    live_next *CtFrame; // 存活调用帧链；用于校验编译期指针只指向存活的局部槽。
}

let ct_functions *CtFunction = 0;
let ct_function_n int = 0;
let ct_function_cap int = 0;
let ct_expansion_count int = 0;
let ct_expansion_size int = 0;
let ct_expansion_ast_depth int = 0;
// ct_eval_depth：当前 typed IR 执行器的活动调用帧数。
let ct_eval_depth int = 0;
// ct_control_depth：当前解析栈中的编译期结构控制层数。
let ct_control_depth int = 0;
// ct_for_boundary_bases：各层编译期 for 开始时外部运行期循环的深度。
let ct_for_boundary_bases [32]int;
let ct_for_trace_bases [32]int;
let ct_for_boundary_depth int = 0;
let ct_ir_exprs *CtExpr = 0;
let ct_ir_expr_n int = 0;
let ct_ir_expr_cap int = 0;
let ct_ir_stmts *CtStmt = 0;
let ct_ir_stmt_n int = 0;
let ct_ir_stmt_cap int = 0;
let ct_ir_edges *CtEdge = 0;
let ct_ir_edge_n int = 0;
let ct_ir_edge_cap int = 0;
let ct_ir_bindings *CtBinding = 0;
let ct_ir_binding_n int = 0;
let ct_ir_binding_cap int = 0;
let ct_ir_steps int = 0;
// ct_ir_expr_pool：与 ct_ir_exprs 并行的字符串字面量池地址（0 表示非池指针）。
let ct_ir_expr_pool *i64 = 0;
let ct_ir_expr_pool_cap int = 0;
// ct_pool_spans：本编译单元已登记的字符串字面量只读池区间。
let ct_pool_spans [64]CtPoolSpan;
let ct_pool_span_n int = 0;
// ct_live_frames：当前存活的 typed IR 调用帧链头，随执行栈增长和收缩。
let ct_live_frames *CtFrame = 0;
let ct_top_aggregates *CtAggregate = 0; // 顶层编译期结果在当前编译单元中的拥有区。
let ct_layout_requests *CtLayoutRequest = 0;
let ct_layout_request_n int = 0;
let ct_layout_request_cap int = 0;
let ct_value_requests *CtValueRequest = 0;
let ct_value_request_n int = 0;
let ct_value_request_cap int = 0;
let ct_value_edges *CtValueEdge = 0;
let ct_value_edge_n int = 0;
let ct_value_edge_cap int = 0;
let ct_dependency_edges *CtDependencyEdge = 0;
let ct_dependency_edge_n int = 0;
let ct_dependency_edge_cap int = 0;
