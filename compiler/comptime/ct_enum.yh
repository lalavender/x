module comptime
import gen

// ct_enum_member_count：统计枚举类型已登记的成员，保持符号表中的声明顺序。
pub fn ct_enum_member_count(enum_type int) int {
    let tk *gen.TaskCtx = gen.task()
    if (enum_type < 0 || enum_type >= tk.t_type_n
        || tk.t_types[enum_type].kind != CT_TY_ENUM) { return -1 }
    let count int = 0
    let i int = 0
    for i < ct_syms_bound() {
        if (ct_sym_row(i).kind == CT_SYM_CONST
            && ct_sym_row(i).type_id == enum_type
            && (ct_sym_row(i).flags & CT_F_ENUM_MEMBER) != 0
            && ct_sym_row(i).const_ready != 0) {
            count += 1
        }
        i += 1
    }
    return count
}

// ct_enum_member_at：按声明序号取枚举符号；无效序号返回 -1。
pub fn ct_enum_member_at(enum_type int, ordinal int) int {
    let tk *gen.TaskCtx = gen.task()
    if (enum_type < 0 || enum_type >= tk.t_type_n
        || tk.t_types[enum_type].kind != CT_TY_ENUM || ordinal < 0) { return -1 }
    let seen int = 0
    let i int = 0
    for i < ct_syms_bound() {
        if (ct_sym_row(i).kind == CT_SYM_CONST
            && ct_sym_row(i).type_id == enum_type
            && (ct_sym_row(i).flags & CT_F_ENUM_MEMBER) != 0
            && ct_sym_row(i).const_ready != 0) {
            if (seen == ordinal) { return i }
            seen += 1
        }
        i += 1
    }
    return -1
}
