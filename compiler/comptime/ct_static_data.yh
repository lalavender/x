module comptime
import support
import gen

// CtStaticSpan：一次封存期间的值槽区间到目标对象位置映射；只在栈上上下文借用。
// values 不进入 gen 静态目录；同一 owner 的不同切片视图复用 row 并增加目标字节 addend。
struct CtStaticSpan {
    values *CtValue
    count int
    elem int
    row int
    offset int
    next *CtStaticSpan
}

// CtStaticContext：一次根对象封存的临时区间链；完成或失败后统一释放所有链节点。
struct CtStaticContext {
    spans *CtStaticSpan
}

// ct_static_span_add：记下一个已分配目标区间，供随后出现的切片按元素槽寻找别名。
// 区间表仅保存当前序列化调用的借用指针，gen 目录始终只有独占字节和稳定身份。
fn ct_static_span_add(ctx *CtStaticContext, values *CtValue, count int,
    elem int, row int, offset int) int {
    let span *CtStaticSpan = malloc(sizeof(CtStaticSpan).to_type(u64)).to_type(*CtStaticSpan)
    if (span == 0) { return support.fail("编译期静态数据区间分配失败") }
    span.values = values; span.count = count; span.elem = elem
    span.row = row; span.offset = offset; span.next = ctx.spans; ctx.spans = span
    return 0
}

// ct_static_contains：以 CtValue 槽校验完整视图包含关系；空视图允许位于区间末端。
// 使用无符号差值避免宿主地址相减溢出，返回槽偏移或 -1，不把宿主偏移当目标字节。
fn ct_static_contains(values *CtValue, count int, view *CtAggregate) int {
    if (values == 0 || count < 0 || view == 0 || view.values == 0 || view.count < 0) { return -1 }
    let base u64 = values.to_type(u64); let start u64 = view.values.to_type(u64)
    if (start < base) { return -1 }
    let delta u64 = start - base
    if (delta % sizeof(CtValue).to_type(u64) != 0) { return -1 }
    let index u64 = delta / sizeof(CtValue).to_type(u64)
    if (index > count.to_type(u64) || view.count.to_type(u64) > count.to_type(u64) - index) { return -1 }
    return index.to_type(int)
}

// ct_static_span_find：查找已定位的完整视图区间；类型必须一致，不跨类型重解释槽地址。
fn ct_static_span_find(ctx *CtStaticContext, view *CtAggregate) *CtStaticSpan {
    let span *CtStaticSpan = ctx.spans
    for span != 0 {
        if (span.elem == view.elem_type && ct_static_contains(span.values, span.count, view) >= 0) {
            return span
        }
        span = span.next
    }
    return 0
}

// ct_static_owner_chain：在存活拥有链中寻找包含视图的最大完整 owner。
// 视图先出现时也恢复其完整 backing，而不是错误地为可见片段创建独立数据。
fn ct_static_owner_chain(best *CtAggregate, chain *CtAggregate, view *CtAggregate) *CtAggregate {
    let current *CtAggregate = chain
    for current != 0 {
        if (current.owned != 0 && current.elem_type == view.elem_type
            && ct_static_contains(current.values, current.count, view) >= 0
            && (best == 0 || current.count > best.count)) { best = current }
        current = current.next
    }
    return best
}

// ct_static_index：先定位根对象内所有按值数组，再发射任何切片重定位。
// 因而结构体中先声明的切片也能引用其后出现的数组字段，不受字段遍历顺序影响。
fn ct_static_index(ctx *CtStaticContext, row int, offset int, type_id int,
    value *CtValue, depth int) int {
    if (depth > 32 || type_id < 0 || type_id >= ct_types_bound() || value == 0
        || value.type_id != type_id) { return ct_err("编译期静态数据类型或深度无效") }
    let ty CtTypeRow = ct_type_row(type_id)
    if (ty.kind != CT_TY_ARRAY && ty.kind != CT_TY_STRUCT) { return 0 }
    let object *CtAggregate = value.value.to_type(u64).to_type(*CtAggregate)
    if (object == 0 || object.count != ty.len || (object.count > 0 && object.values == 0)
        || object.elem_type != (ty.kind == CT_TY_ARRAY ? ty.elem : type_id)) {
        return ct_err("编译期静态聚合存储无效")
    }
    if (ty.kind == CT_TY_ARRAY
        && ct_static_span_add(ctx, object.values, object.count, ty.elem, row, offset) != 0) { return -1 }
    let i int = 0
    for i < object.count {
        let child_type int = ty.elem
        let child_offset int = i * (ty.kind == CT_TY_ARRAY ? ct_type_row(ty.elem).size : 0)
        if (ty.kind == CT_TY_STRUCT) {
            child_type = ct_field_row(ty.sub + i).type_id
            child_offset = ct_field_row(ty.sub + i).offset
        }
        if (ct_static_index(ctx, row, offset + child_offset, child_type,
                &object.values[i], depth + 1) != 0) { return -1 }
        i += 1
    }
    return 0
}

// ct_static_backing：把尚未定位的切片 owner 物化为匿名数组并返回区间映射。
// label 来自同一前端数据身份分配器；先登记全部内嵌数组，再递归写入值和指针槽。
fn ct_static_backing(ctx *CtStaticContext, view *CtAggregate, depth int) *CtStaticSpan {
    let tk *gen.TaskCtx = gen.task()
    let found *CtStaticSpan = ct_static_span_find(ctx, view)
    if (found != 0) { return found }
    let owner *CtAggregate = ct_static_owner_chain(0, ct_top_aggregates, view)
    owner = ct_static_owner_chain(owner, ct_global_agg_chain(), view)
    owner = ct_static_owner_chain(owner, ct_arg_pool.aggregates, view)
    if (owner == 0) { owner = view }
    let elem int = view.elem_type
    if (elem < 0 || elem >= ct_types_bound() || owner.count < 0 || owner.count > 100000
        || ct_type_row(elem).size < 0
        || (ct_type_row(elem).size > 0 && owner.count > 67108864 / ct_type_row(elem).size)) {
        ct_err("编译期静态 backing 布局无效"); return 0
    }
    let label int = tk.c_data_n; tk.c_data_n += 1
    let row int = gen.static_data_add(-1, label, -1, elem, owner.count,
        owner.count * ct_type_row(elem).size, ct_type_row(elem).align)
    if (row < 0 || ct_static_span_add(ctx, owner.values, owner.count, elem, row, 0) != 0) { return 0 }
    let i int = 0
    for i < owner.count {
        if (ct_static_index(ctx, row, i * ct_type_row(elem).size, elem,
                &owner.values[i], depth + 1) != 0) { return 0 }
        i += 1
    }
    i = 0
    for i < owner.count {
        if (ct_static_value(ctx, row, i * ct_type_row(elem).size, elem,
                &owner.values[i], depth + 1) != 0) { return 0 }
        i += 1
    }
    return ct_static_span_find(ctx, view)
}

// ct_static_value：按已完成的受检布局写独占小端字节；所有间隙由 add 的预清零保留。
// slice 的长度与零指针槽分开记录，符号/标签和目标字节 addend 不含任何宿主地址。
fn ct_static_value(ctx *CtStaticContext, row int, offset int, type_id int,
    value *CtValue, depth int) int {
    if (depth > 32 || type_id < 0 || type_id >= ct_types_bound() || value == 0
        || value.type_id != type_id) { return ct_err("编译期静态数据值无效") }
    let ty CtTypeRow = ct_type_row(type_id)
    if (ct_ty_is_integer(type_id) != 0 || ct_ty_is_float(type_id) != 0) {
        let bits i64 = value.value
        if (ty.kind == CT_TY_F32) { bits = ct_ir_fp32_bits(bits) }
        return gen.static_data_scalar(row, offset, ty.size, bits)
    }
    let object *CtAggregate = value.value.to_type(u64).to_type(*CtAggregate)
    if (ty.kind == CT_TY_SLICE) {
        if (ct_ir_slice_param_valid(type_id, value) == 0) { return ct_err("编译期静态切片视图无效") }
        let span *CtStaticSpan = ct_static_backing(ctx, object, depth)
        if (span == 0) { return -1 }
        let target CtStaticRow
        if (ct_static_at(span.row, &target) != 0
            || gen.static_data_scalar(row, offset, 8, object.count.to_type(i64)) != 0) { return -1 }
        let index int = ct_static_contains(span.values, span.count, object)
        let addend i64 = (span.offset + index * ct_type_row(ty.elem).size).to_type(i64)
        return gen.static_data_reloc(row, offset + 8, target.label >= 1 ? -1 : target.sym_id,
            target.label >= 1 ? target.label : -1, addend)
    }
    if (ty.kind != CT_TY_ARRAY && ty.kind != CT_TY_STRUCT) {
        return ct_err("编译期静态数据尚不支持该对象类型")
    }
    let i int = 0
    for i < object.count {
        let child_type int = ty.elem
        let child_offset int = i * (ty.kind == CT_TY_ARRAY ? ct_type_row(ty.elem).size : 0)
        if (ty.kind == CT_TY_STRUCT) {
            child_type = ct_field_row(ty.sub + i).type_id
            child_offset = ct_field_row(ty.sub + i).offset
        }
        if (ct_static_value(ctx, row, offset + child_offset, child_type,
                &object.values[i], depth + 1) != 0) { return -1 }
        i += 1
    }
    return 0
}

// ct_static_data_record：封存一个根对象及其可达 backing，成功或失败均释放临时区间链。
// .s.ct 隐藏常量的标签随后会回滚，不能登记为运行期对象；其余路径不依赖 AST 捕获开关。
fn ct_static_data_record(sym_id int, label int, type_id int, value *CtValue) int {
    let tk *gen.TaskCtx = gen.task()
    if (tk.c_ct_iface_mode != 0) { return 0 }
    if (type_id < 0 || type_id >= ct_types_bound()) { return ct_err("编译期静态根对象类型无效") }
    let ty CtTypeRow = ct_type_row(type_id)
    let row int = gen.static_data_add(sym_id, label, type_id, -1, 0, ty.size, ty.align)
    if (row < 0) { return -1 }
    let ctx CtStaticContext
    let result int = ct_static_index(&ctx, row, 0, type_id, value, 0)
    if (result == 0) { result = ct_static_value(&ctx, row, 0, type_id, value, 0) }
    let span *CtStaticSpan = ctx.spans
    for span != 0 {
        let next *CtStaticSpan = span.next; free(span.to_type(*void)); span = next
    }
    return result
}
