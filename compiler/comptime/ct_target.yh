module comptime;
import gen;

// ct_target_name_is：比较源代码范围与目标标记名，不将标记名加入普通词法关键字。
fn ct_target_name_is(start int, n int, name *char, want int) int {
    let gs *gen.GenState = gen.G();
    if (n != want) { return 0; }
    let i int = 0;
    for i < want {
        if (gs.c_src[start + i] != name[i].to_type(u8)) { return 0; }
        i += 1;
    }
    return 1;
}

// ct_target_symbol：仅在 $if 条件中把目标系统/架构名解析为不可遮蔽的布尔常量。
pub fn ct_target_symbol(start int, n int, out *gen.Res) int {
    let gs *gen.GenState = gen.G();
    let recognized int = 1;
    let value i64 = 0;
    if (ct_target_name_is(start, n, "linux", 5) != 0) {
        value = (gs.c_target.os == gen.TARGET_OS_LINUX).to_type(i64);
    } else if (ct_target_name_is(start, n, "darwin", 6) != 0) {
        value = (gs.c_target.os == gen.TARGET_OS_DARWIN).to_type(i64);
    } else if (ct_target_name_is(start, n, "arm64", 5) != 0) {
        value = (gs.c_target.arch == gen.TARGET_ARCH_ARM64).to_type(i64);
    } else if (ct_target_name_is(start, n, "x64", 3) != 0) {
        value = (gs.c_target.arch == gen.TARGET_ARCH_X64).to_type(i64);
    } else {
        recognized = 0;
    }
    if (recognized == 0) { return 0; }
    gen.sem_res_const(out, gen.TY_BOOL, value);
    return 1;
}
