module comptime
import support

// ct_target_name_is：比较源代码范围与目标标记名，不将标记名加入普通词法关键字。
fn ct_target_name_is(start int, n int, name *char, want int) int {
    if (n != want) { return 0 }
    let i int = 0
    for i < want {
        if (support.src_ctx().data[start + i] != name[i].to_type(u8)) { return 0 }
        i += 1
    }
    return 1
}

