module comptime
import support
import gen
import proj

// ct_target_name_is：比较源代码范围与目标标记名，不将标记名加入普通词法关键字。
fn ct_target_name_is(start int, n int, name *char, want int) int {
    if (n != want) { return 0 }
    let i int = 0
    for i < want {
        if (support.src_ctx().data[start + i] != name[i].to_type(u8)) { return 0 }
        i += 1
    }
    return 1
}

// ct_target_symbol：仅在 $if 条件中把目标系统/架构名解析为不可遮蔽的布尔常量。
// `windows` 于 W0-2a 追加：先让**种子**学会识别这个标记名，新一代源码才允许写
// `$if (windows)`（顺序约束见 docs/02-plan/yh-Windows-x86_64-LLVM后端接入实施方案
// §4.1；在旧种子上直接使用新标记会编译失败，等于锁死种子）。
pub fn ct_target_symbol(start int, n int, out *support.Res) int {
    let recognized int = 1
    let value i64 = 0
    if (ct_target_name_is(start, n, "linux", 5) != 0) {
        value = (proj.cfg().target.os == support.TARGET_OS_LINUX).to_type(i64)
    } else if (ct_target_name_is(start, n, "darwin", 6) != 0) {
        value = (proj.cfg().target.os == support.TARGET_OS_DARWIN).to_type(i64)
    } else if (ct_target_name_is(start, n, "windows", 7) != 0) {
        value = (proj.cfg().target.os == support.TARGET_OS_WINDOWS).to_type(i64)
    } else if (ct_target_name_is(start, n, "arm64", 5) != 0) {
        value = (proj.cfg().target.arch == support.TARGET_ARCH_ARM64).to_type(i64)
    } else if (ct_target_name_is(start, n, "x64", 3) != 0) {
        value = (proj.cfg().target.arch == support.TARGET_ARCH_X64).to_type(i64)
    } else {
        recognized = 0
    }
    if (recognized == 0) { return 0 }
    gen.sem_res_const(out, CT_TY_BOOL, value)
    return 1
}
