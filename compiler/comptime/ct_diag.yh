module comptime
import errors
import support

import table
// ct_diag_hex_digit：把已经由词法器验证的十六进制字符转换成 0..15。
fn ct_diag_hex_digit(b u8) int {
    if (b >= '0' && b <= '9') { return (b - '0').to_type(int) }
    if (b >= 'a' && b <= 'f') { return (b - 'a' + 10).to_type(int) }
    if (b >= 'A' && b <= 'F') { return (b - 'A' + 10).to_type(int) }
    return 0
}

// ct_diag_decode：解码诊断字符串；将换行、回车与 NUL 转义成可见文本以保持单行诊断。
fn ct_diag_decode(src *u8, start int, n int) *char {
    let out *u8 = malloc((n + 1).to_type(u64)).to_type(*u8)
    if (out == 0) { return 0 }
    let i int = start + 1
    let end int = start + n - 1
    let used int = 0
    for i < end {
        let b u8 = src[i]
        if (b == '\\') {
            let e u8 = src[i + 1]
            let value int = 0
            if (e == 'n') { value = 10 }
            if (e == 'r') { value = 13 }
            if (e == 't') { value = 9 }
            if (e == '0') { value = 0 }
            if (e == 'a') { value = 7 }
            if (e == 'b') { value = 8 }
            if (e == 'f') { value = 12 }
            if (e == 'v') { value = 11 }
            if (e == '\'') { value = 39 }
            if (e == '"') { value = 34 }
            if (e == '\\') { value = 92 }
            if (e == '$') { value = 36 }
            if (e == 'x') {
                value = ct_diag_hex_digit(src[i + 2]) * 16 +
                    ct_diag_hex_digit(src[i + 3])
                i += 4
            } else {
                i += 2
            }
            if (value == 0 || value == 10 || value == 13) {
                out[used] = '\\'
                used += 1
                if (value == 10) { out[used] = 'n' }
                else if (value == 13) { out[used] = 'r' }
                else { out[used] = '0' }
                used += 1
            } else {
                out[used] = value.to_type(u8)
                used += 1
            }
            continue
        }
        if (b == 0) {
            out[used] = '\\'
            used += 1
            out[used] = '0'
            used += 1
        } else if (b == 10 || b == 13) {
            out[used] = '\\'
            used += 1
            if (b == 10) { out[used] = 'n' }
            else { out[used] = 'r' }
            used += 1
        } else {
            out[used] = b
            used += 1
        }
        i += 1
    }
    out[used] = 0
    return out.to_type(*char)
}

// ct_diag_emit_source：从指定源码快照解码消息并触发编译期诊断。
fn ct_diag_emit_source(kind int, value i64, line int, col int,
    src *u8, msg_start int, msg_len int, path *u8,
    line_bias int) int {
    if (kind == CT_DIAG_ASSERT && value != 0) { return 0 }
    let msg *char = "$assert 失败"
    let allocated *char = 0
    if (msg_start >= 0) {
        allocated = ct_diag_decode(src, msg_start, msg_len)
        if (allocated == 0) { return errors.fail("编译期诊断消息分配失败") }
        msg = allocated
    }
    let status int = 0
    let old_path *char = support.src_ctx().path
    if (path != 0) { support.src_ctx().path = path.to_type(*char) }
    if (kind == CT_DIAG_ASSERT) {
        status = errors.err_lc(line + line_bias, col, msg)
    } else if (kind == CT_DIAG_ERROR) {
        status = errors.err_lc(line + line_bias, col, msg)
    } else if (kind == CT_DIAG_WARN) {
        status = errors.warn_lc(line + line_bias, col, msg)
    } else {
        status = errors.fail("内部错误：未知编译期诊断类别")
    }
    support.src_ctx().path = old_path
    if (allocated != 0) { free(allocated.to_type(*void)) }
    return status
}

// —— 值内核适配（F4 收尾）：错误码 → CT 诊断 ——
// support/value_kernel 只返回码；执行器用自己的位置来源（CT 目标 token /
// 当前 token 游标）经 ct_err 报错，与 check 层保持一致的文案。

// ct_report：码 0 → 0；>0 → ct_err(vk_msg(码)) 并返回 -1。
fn ct_report(code int) int {
    if (code == 0) { return 0 }
    return ct_err(table.vk_msg(code))
}

