module comptime
import support

// ct_ir_data_zero：校验聚合字段或尾部填充长度。
// LL12：填充字节由受检快照/模块 IR 生成，不再写汇编文本。
fn ct_ir_data_zero(size int) int {
    if (size < 0) { return support.fail("内部错误：编译期数据填充长度为负") }
    return 0
}

// ct_ir_data_slice：校验切片描述符与 backing 形状。
// LL12：标签、延迟队列与 .xword 文本已删除；数据由 ct_static_data_record 登记。
fn ct_ir_data_slice(type_id int, value *CtValue,
    aggregate *CtAggregate) int {
    if (ct_ir_slice_param_valid(type_id, value) == 0 || aggregate == 0
        || aggregate.count < 0 || aggregate.count > 100000
        || aggregate.elem_type != ct_type_row(type_id).elem
        || (aggregate.count > 0 && aggregate.values == 0)) {
        return ct_err("顶层编译期切片存储无效")
    }
    return 0
}

// ct_ir_data_value：递归校验当前执行器支持的标量、数组、结构体和切片。
fn ct_ir_data_value(type_id int, value *CtValue, depth int) int {
    if (value == 0 || depth > 32 || type_id < 0 || type_id >= ct_types_bound()
        || value.type_id != type_id) {
        return ct_err("顶层编译期聚合类型或嵌套深度无效")
    }
    if (ct_ty_is_integer(type_id) != 0 || ct_ty_is_float(type_id) != 0) {
        // LL12：标量数据由 ct_static_data_record 登记，不再发 .data 字节。
        return 0
    }
    let kind int = ct_type_row(type_id).kind
    let aggregate *CtAggregate = value.value.to_type(u64).to_type(*CtAggregate)
    if (kind == CT_TY_SLICE) {
        return ct_ir_data_slice(type_id, value, aggregate)
    }
    if (kind == CT_TY_ARRAY) {
        if (ct_ir_array_supported(type_id, 0) == 0 || aggregate == 0
            || aggregate.count != ct_type_row(type_id).len
            || aggregate.elem_type != ct_type_row(type_id).elem
            || (aggregate.count > 0 && aggregate.values == 0)) {
            return ct_err("顶层编译期定长数组存储无效")
        }
        let elem int = ct_type_row(type_id).elem
        let cursor int = 0
        let i int = 0
        for i < aggregate.count {
            if (ct_ir_data_value(elem, &aggregate.values[i], depth + 1) != 0) {
                return -1
            }
            cursor += ct_type_row(elem).size
            i += 1
        }
        return ct_ir_data_zero(ct_type_row(type_id).size - cursor)
    }
    if (kind == CT_TY_STRUCT) {
        if (ct_ir_struct_supported(type_id, 0) == 0 || aggregate == 0
            || aggregate.elem_type != type_id
            || aggregate.count != ct_type_row(type_id).len
            || (aggregate.count > 0 && aggregate.values == 0)) {
            return ct_err("顶层编译期结构体存储无效")
        }
        let st CtTypeRow = ct_type_row(type_id)
        let cursor int = 0
        let i int = 0
        for i < st.len {
            let field CtFieldRow = ct_field_row(st.sub + i)
            if (field.offset < cursor
                || ct_ir_data_zero(field.offset - cursor) != 0
                || ct_ir_data_value(field.type_id, &aggregate.values[i],
                    depth + 1) != 0) { return -1 }
            cursor = field.offset + ct_type_row(field.type_id).size
            i += 1
        }
        return ct_ir_data_zero(st.size - cursor)
    }
    return ct_err("顶层编译期数据只支持标量、定长数组、结构体或受支持元素切片")
}

// ct_ir_data_emit_temp：为运行期表达式登记匿名静态对象并返回数据标签。
// LL12：只登记 ct_static_data_record 并保留值校验，不再发 .data 文本。
fn ct_ir_data_emit_temp(type_id int, value *CtValue) int {
    let label int = support.data_label()
    support.data_label_advance()
    if (ct_static_data_record(-1, label, type_id, value) != 0
        || ct_ir_data_value(type_id, value, 0) != 0) { return -1 }
    return label
}

// ct_ir_data_bind_iface_label：接口加载时为导入聚合常量副本分配本地标签。
// LL12：只登记 cval 与 c_data_n，不写 .LD 文本；LLVM 快照按 label 命名对象。
fn ct_ir_data_bind_iface_label(sym_id int) void {
    if (support.session().iface_load != 0) {
        let lbl int = support.data_label()
        support.data_label_advance()
        ct_sym_row(sym_id).cval = lbl.to_type(i64)
    }
}

// ct_ir_data_emit_global：把全局初始化中的 CT 聚合和 backing 写入目标数据区。
pub fn ct_ir_data_emit_global(sym_id int, type_id int, value *CtValue) int {
    if (sym_id < 0 || sym_id >= ct_syms_bound() || value == 0
        || value.type_id != type_id || ct_ir_return_supported(type_id) == 0) {
        return ct_err("全局编译期聚合初始化类型无效")
    }
    ct_ir_data_bind_iface_label(sym_id)
    let label int = (ct_sym_row(sym_id).flags & CT_F_EXTERN) != 0 ?
        ct_sym_row(sym_id).cval.to_type(int) : -1
    if (ct_static_data_record(sym_id, label, type_id, value) != 0
        || ct_ir_data_value(type_id, value, 0) != 0) { return -1 }
    return 0
}
