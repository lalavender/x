module errors

// errors 模块内测试：诊断状态机、推测解析静默与返回码。
// 诊断文本格式由 tests/yh-run 的 fail 语料端到端覆盖，这里不断言文本。

test "diag 单例与字段读写" {
    $assert(diag() == diag())
    diag().errors = 0
    diag().errors += 1
    $assert(diag().errors == 1)
    diag().errors = 0
}

test "fail 与 fail_path 返回 -1" {
    $assert(fail("测试失败") == -1)
    $assert(fail_path("无法打开: ", "不存在的路径") == -1)
}

test "err_lc 计数与推测解析静默" {
    let path *char = "errors-test.yh"
    set_path_slot(&path)
    diag().errors = 0
    diag().spec = 0
    $assert(err_lc(1, 1, "测试错误") == -1)
    $assert(diag().errors == 1)
    diag().spec = 1
    $assert(err_lc(1, 1, "静默错误") == -1)
    $assert(diag().errors == 1)
    diag().spec = 0
}

test "warn_lc 不计数且推测解析静默" {
    let path *char = "errors-test.yh"
    set_path_slot(&path)
    diag().errors = 0
    diag().spec = 0
    $assert(warn_lc(1, 1, "测试警告") == 0)
    $assert(diag().errors == 0)
    diag().spec = 1
    $assert(warn_lc(1, 1, "静默警告") == 0)
    $assert(diag().errors == 0)
    diag().spec = 0
}