module build
import cache

// BuildCtx：一次构建的进程级会话状态。
pub struct BuildCtx {
    argv0 *char // 编译器自身 argv[0]（子进程再入与指纹用）
    iface_suffix *char // 本轮接口后缀（.s.i/.s.ct 之外的文件名尾缀）
    compiler_identity [32]u8 // 编译器二进制 SHA-256（内容身份，参与模块键）
    compiler_fingerprint u64 // compiler_identity 的 64 位摘要（worker 环境键）
    compiler_fingerprint_ready int // 1 = 身份已算过
    self_path *char // 自身路径（读取编译器指纹）
    cache_store cache.CacheStore // 全局 content store（C4；off 时 enabled=0）
    cache_debug int // 1 = YH_CACHE_DEBUG，输出 ActionID 与命中原因

    sched_limit int         // worker 并发上限（YH_WORKERS，缺省 4）
    sched_limit_ready int   // 1 = 已读环境变量

    dep_bind *int           // 绑定名池偏移
    dep_bindlen *int
    dep_ifoff *int          // 依赖模块 .s.i 路径池偏移
    dep_ctoff *int          // 依赖模块 .s.ct 路径池偏移
    dep_mod *int            // 依赖模块下标
    dep_mi *int             // 加载后的接口模块编号
    dep_n int
    dep_cap int
    dep_base int            // 本模块接口加载前 c_mod_n 基线
}

// g_build_ctx：build 模块私有单例（零初始化；非零初值由 setup 显式设置）。
let g_build_ctx BuildCtx

// bc：构建会话上下文的唯一入口。
pub fn bc() *BuildCtx {
    return &g_build_ctx
}
