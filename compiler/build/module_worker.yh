module build
import gen
import parse
import comptime
import ast
import check
import builtin
import ir
import lower

// module_worker.yh：在 fork 继承的项目快照上初始化私有语义状态并编译单个模块。

// mb_verify_checked_snapshot：把只读快照校验的失败阶段映射回捕获期既有诊断。
fn mb_verify_checked_snapshot(unit *ast.CheckedModule) int {
    let stage int = check.verify_checked_module(unit)
    if (stage == 0) { return 0 }
    if (stage == 1) { return gen.fail("受检模块快照表存储无效") }
    if (stage == 2) { return gen.fail("受检模块类型或函数签名快照校验失败") }
    if (stage == 3) { return gen.fail("受检模块字段类型快照校验失败") }
    if (stage == 4) { return gen.fail("受检模块函数参数签名快照校验失败") }
    if (stage == 5) { return gen.fail("受检模块类型别名快照校验失败") }
    if (stage == 6) { return gen.fail("受检模块符号类型快照校验失败") }
    if (stage == 7) { return gen.fail("受检模块文件快照校验失败") }
    if (stage == 8) { return gen.fail("受检模块表达式快照校验失败") }
    if (stage == 9) { return gen.fail("受检模块语句快照校验失败") }
    if (stage == 10) { return gen.fail("受检模块函数快照校验失败") }
    return gen.fail("受检模块快照校验失败")
}

// mb_llvm_module_paths：算出本模块的 LLVM 产物路径与审阅文本路径。
// 对象放在当前目标命名空间的 obj/<tag>.o，文本放在 llvm/<tag>.ll；
// 两者都用 mb_mod_tag 生成的项目+模块标记防同名冲突。
// 返回 0 成功；任一缓冲不足或标记失败返回 -1。
fn mb_llvm_module_paths(m int, main_off int, main_len int,
    obj_out *u8, text_out *u8) int {
    let build_off int = mb_build_dir(main_off, main_len)
    if (build_off < 0) { return -1 }
    let build_len int = pj_state().canon_len
    let tag_off int = -1
    let tag_len int = 0
    if (mb_mod_tag(m, &tag_off, &tag_len) != 0) { return -1 }
    let n int = 0
    n = gen.append_str(obj_out, n, pj_pool_str(build_off))
    n = gen.append_str(obj_out, n, "/obj/")
    n = gen.append_str(obj_out, n, pj_pool_str(tag_off))
    n = gen.append_str(obj_out, n, ".o")
    obj_out[n] = 0
    n = 0
    n = gen.append_str(text_out, n, pj_pool_str(build_off))
    n = gen.append_str(text_out, n, "/llvm/")
    n = gen.append_str(text_out, n, pj_pool_str(tag_off))
    n = gen.append_str(text_out, n, ".ll")
    text_out[n] = 0
    return 0
}

// mb_llvm_emit_module：LLVM 后端模式下的模块编译（LA1a）。
// 本函数只保留模块前端、快照校验与接口/缓存编排；受检快照 → 模块 IR →
// LLVM 文本 → 内嵌桥 → 原子对象发布由 llvm_pipeline 统一承担。
// 返回 0 成功、-1 失败（诊断已写 stderr）。
fn mb_llvm_emit_module(m int, main_off int, main_len int,
    cache_in *ir.IRFunctionCacheSet, cache_out *ir.IRFunctionCacheSet,
    env_key u64, lower_stats *lower.CheckedLowerStats, check_dir *char,
    check_env u64) int {
    let gs *gen.GenState = gen.G()
    let obj_path [700]u8
    let text_path [700]u8
    if (mb_llvm_module_paths(m, main_off, main_len, &obj_path[0], &text_path[0]) != 0) {
        return -1
    }
    let view ast.AstView
    ast.ast_view(&view)
    if (check.verify_module(&view) != 0) {
        return gen.fail("内部错误：受检 AST 上下文校验失败")
    }
    let checked ast.CheckedModule
    if (gen.front_checked_verify() != 0
        || ast.checked_module_capture(&checked) != 0) {
        return -1
    }
    let checked_status int = mb_verify_checked_snapshot(&checked)
    if (checked_status != 0) {
        ast.checked_module_release(&checked)
        return checked_status
    }
    // LA3.3 C3：从已验证快照 capture 本轮 check 切片；命中/未命中都刷新记录。
    let check_out ir.IRFunctionCacheSet
    let check_capture int = 0
    if (check_env != 0) {
        check_capture = ast.checked_check_cache_capture(&checked, &check_out,
            check_env)
        if (check_capture != 0) {
            gen.fail("函数 check 缓存捕获失败（本次不提交 check 缓存）")
        }
    }
    // 文本路径只在 --emit-llvm 时给出；对象始终发布，构建步才能继续链接。
    let text_out *char = gs.c_emit_kind == 1 ? gen.arr_cstr(&text_path[0]) : 0.to_type(*char)
    let status int = llvm_emit_module_to_cached(&checked, 0,
        gen.arr_cstr(&obj_path[0]), text_out, 0, cache_in, cache_out,
        env_key, lower_stats)
    ast.checked_module_release(&checked)
    if (status == 0 && check_env != 0 && check_capture == 0) {
        firc_check_commit(check_dir, &check_out)
    }
    ir.ir_function_cache_set_release(&check_out)
    return status
}

@[extern] fn getppid() int

// —— worker 父进程存活检查（RB1） ——
// 构建被中断（Ctrl-C / 超时 / harness abort / kill -9）时，父进程没有机会回收
// fork 出来的模块 worker；若不检查，这些 worker 会变成 ppid=1 的孤儿继续编译，
// 把机器 CPU 吃满（实测 5 个孤儿把 load 推到 195）。worker 在几个粗粒度检查点
// 比对 getppid()，父已不在就立刻退出。
let mb_worker_parent int = 0

// mb_worker_parent_set：子进程入口记录父 pid（fork 后、开始编译前调用一次）。
pub fn mb_worker_parent_set() void { mb_worker_parent = getppid() }

// mb_worker_parent_alive：父进程仍在返回 1；未设置检查时视为在（单进程路径）。
fn mb_worker_parent_alive() int {
    if (mb_worker_parent == 0) { return 1 }
    return getppid() == mb_worker_parent ? 1 : 0
}

// mb_emit_indexed_module：复用父进程已扫描的项目、词法 token 与顶层声明索引，
// 只在当前子进程建立语义表、检查模块并发布 LLVM 对象与本轮私有接口。
// 参数 out_dir/ir_cache_salt 是旧按文件汇编路径的遗留，待 C2 清理调用链。
fn mb_emit_indexed_module(m int, main_off int, main_len int,
    out_dir *char, ir_cache_salt u64) int {
    let gs *gen.GenState = gen.G()
    if (mb_worker_parent_alive() == 0) { return -1 }
    // worker 只走受检前端：check 与 LLVM 发射共用同一条语义遍历。
    if (gen.front_checked_begin() != 0) {
        return -1
    }
    comptime.ct_reset()
    gs.c_front_cache = 1
    gs.task.c_ast_capture = 0
    gs.c_ir_cache_salt = ir_cache_salt
    gs.task.c_errors = 0
    let sfx_off int = -1
    let sfx_len int = 0
    if (m < 0 || m >= gs.p_mod_n
        || pj_mod_suffix(gs.p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1
    }
    gs.c_module_mode = 1
    gs.c_is_entry_mod = gs.p_mods[m].is_entry
    gs.task.c_sym_sfx_off = sfx_off
    gs.task.c_sym_sfx_len = sfx_len
    if (gen.sem_init_tables() != 0) {
        return -1
    }
    if (builtin.front_prepare() != 0) {
        return -1
    }
    let build_off int = mb_build_dir(main_off, main_len)
    if (build_off < 0) {
        return -1
    }
    // RS3b：按文件汇编目录（父进程只创建到 asm/ 一级）
    if (gs.task.c_check_only == 0 && cmd_mkdirs(out_dir) != 0) {
        return gen.fail_path("无法创建汇编目录: ", out_dir)
    }
    let build_len int = pj_state().canon_len
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1
    }
    let di int = 0
    for di < mb_dep_n {
        if (gen.set_source_path(pj_pool_str(mb_dep_ifoff[di])) != 0) {
            return -1
        }
        if (parse.iface_load(pj_pool_str(mb_dep_ifoff[di]),
                mb_dep_bind[di], mb_dep_bindlen[di]) < 0) {
            return -1
        }
        di += 1
    }
    gs.task.c_ast_capture = 1
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    let cti int = 0
    for cti < mb_dep_n {
        if (gen.set_source_path(pj_pool_str(mb_dep_ctoff[cti])) != 0
            || parse.iface_ct_load(pj_pool_str(mb_dep_ctoff[cti]),
                mb_dep_base + cti) != 0) {
            return -1
        }
        cti += 1
    }
    // .s.ct 闭包加载完成后执行导入侧延迟的 pub $ 聚合常量初始化式
    // （调用目标隐藏符号此刻已登记；.s.i 先于 .s.ct 加载，见
    // parse_global_init.yh 的 pub_agg_deferred_run）。
    if (parse.pub_agg_deferred_run() != 0) {
        return -1
    }
    let afi int = 0
    for afi < gs.p_mods[m].file_n {
        let decl_fi int = gs.p_mods[m].files[afi]
        if (mb_restore_front_file(pj_pool_str(gs.p_files[decl_fi].path_off),
                decl_fi) != 0 || mb_file_head_bind(decl_fi) != 0
            || parse.decl_index_file(decl_fi) != 0
            || mb_restore_front_file(pj_pool_str(gs.p_files[decl_fi].path_off),
                decl_fi) != 0 || ast.ast_decl_add_file(decl_fi) != 0) {
            return -1
        }
        afi += 1
    }
    let sym_base int = gs.task.c_sym_n
    let tname_base int = gs.task.t_name_n
    gs.task.c_compile = 1
    gs.task.c_pass = 1
    let fi int = 0
    for fi < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi]
        if (mb_pass1_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id) != 0) {
            return -1
        }
        fi += 1
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    let bind_i int = 0
    for bind_i < gs.p_mods[m].file_n {
        let bind_fi int = gs.p_mods[m].files[bind_i]
        if (mb_restore_front_file(pj_pool_str(gs.p_files[bind_fi].path_off),
                bind_fi) != 0 || ast.ast_decl_bind_file(bind_fi) != 0) {
            return -1
        }
        bind_i += 1
    }
    if (mb_check_binding_clash(m) != 0) {
        return -1
    }
    if (gs.c_is_entry_mod != 0) {
        // yh test 允许入口模块没有 main（仅检查测试）；生产构建仍强制 main。
        if (gs.task.c_test_mode != 0) {
            if (gen.sem_check_main_optional() != 0) { return -1 }
        } else if (gen.sem_check_main() != 0) {
            return -1
        }
    }
    // UF1：pass1 已登记本模块全部符号与顶层声明索引，先报未使用的私有函数，
    // 不必等正文编译完（跨文件使用同样计入，见 unused_function.yh）。
    if (unused_function_report(gs.p_mods[m].files, gs.p_mods[m].file_n,
            sym_base) != 0) {
        return -1
    }
    gs.task.c_pass = 2
    let fi_ct int = 0
    for fi_ct < gs.p_mods[m].file_n {
        let file_ct int = gs.p_mods[m].files[fi_ct]
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_ct].path_off),
                file_ct, 2) != 0) { return -1 }
        fi_ct += 1
    }
    if (gs.task.c_errors > 0) { return -1 }
    let fi_ct_layout int = 0
    for fi_ct_layout < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi_ct_layout]
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 3) != 0) { return -1 }
        fi_ct_layout += 1
    }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_before == 0) { break }
        let fi_layout_eval int = 0
        for fi_layout_eval < gs.p_mods[m].file_n {
            let file_id int = gs.p_mods[m].files[fi_layout_eval]
            if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                    file_id, 4) != 0) { return -1 }
            if (mb_restore_front_file(pj_pool_str(gs.p_files[file_id].path_off),
                    file_id) != 0 || mb_file_head_bind(file_id) != 0
                || parse.parse_source_ct_layout_exprs() != 0) { return -1 }
            fi_layout_eval += 1
        }
        if (comptime.ct_layout_advance() < 0) { return -1 }
        let pending_after int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_after == 0) { break }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic()
            } else {
                comptime.ct_value_stuck_diagnostic()
            }
            return -1
        }
    }
    if (comptime.ct_layout_resolve() != 0 || gs.task.c_errors > 0) { return -1 }
    // 延迟的枚举判别值：此时编译期函数正文已捕获，可以真实求值。
    if (parse.ct_enum_pending_run() != 0) { return -1 }
    // 全局初始化（mode 1）：ST/CT 数据登记，供受检快照消费。
    let fi2 int = 0
    for fi2 < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi2]
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 1) != 0) {
            return -1
        }
        fi2 += 1
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    let ctpath [700]u8
    let ipath [700]u8
    if (mb_module_ctiface_path(m, build_off, build_len, ctpath) != 0
        || parse.iface_ct_emit(gen.arr_cstr(ctpath), sym_base) != 0
        || mb_module_iface_path(m, build_off, build_len, ipath) != 0
        || parse.iface_emit(gen.arr_cstr(ipath), sym_base, tname_base) != 0) {
        return -1
    }
    let ready_path [700]u8
    if (mb_module_ready_path(m, build_off, build_len, &ready_path[0]) != 0
        || mb_iface_write_ready(gen.arr_cstr(&ready_path[0])) != 0) {
        return gen.fail("无法发布模块接口就绪标记")
    }
    // LA3.3 C3：函数体 pass2b 前装载 check 缓存。项目 check-only 始终完整检查，
    // 避免把“检查”变成缓存命中报告。
    let firc_dir [700]u8
    if (firc_dir_path(m, build_off, build_len, &firc_dir[0]) != 0) {
        return -1
    }
    // yh test 的测试体与生产函数共用签名，但受检切片/IR 里多出测试函数与
    // 断言调用；测试构建不装载、不提交函数级缓存，避免与生产记录串用。
    let check_in ir.IRFunctionCacheSet
    let check_env u64 = 0
    let check_cache_on int = 0
    // PC2 v3：切片携带本函数字符串登记并守卫类型/静态数据规模，可重新装载。
    if (gs.task.c_check_only == 0 && gs.task.c_test_mode == 0) {
        firc_check_load(gen.arr_cstr(&firc_dir[0]), &check_in)
        if (firc_env_key(m, build_off, build_len, &check_env) != 0) {
            ir.ir_function_cache_set_release(&check_in)
            return -1
        }
        ast.checked_check_cache_begin(&check_in, check_env)
        check_cache_on = 1
    }
    let fi3 int = 0
    for fi3 < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi3]
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 0) != 0) {
            if (check_cache_on != 0) { ast.checked_check_cache_end() }
            ir.ir_function_cache_set_release(&check_in)
            return -1
        }
        fi3 += 1
    }
    if (check_cache_on != 0) {
        ast.checked_check_cache_end()
        let total int = gs.task.c_stats_ast_functions
        let hits int = gs.c_stats_check_cache_hits
        gs.c_stats_check_cache_misses = total > hits ? total - hits : 0
    }
    ir.ir_function_cache_set_release(&check_in)
    // yh test：全部普通函数登记完成后检查目标项目的测试体。测试体只在
    // 各自模块内解析，依赖/标准库的测试不进入本轮。
    if (gs.task.c_test_mode != 0 && gs.p_mods[m].proj == gs.c_test_project
        && (gs.c_test_mod_filter < 0 || gs.c_test_mod_filter == m)) {
        let fit int = 0
        for fit < gs.p_mods[m].file_n {
            let fit_file int = gs.p_mods[m].files[fit]
            if (gs.c_test_file_filter < 0 || gs.c_test_file_filter == fit_file) {
                if (mb_pass2_file(pj_pool_str(gs.p_files[fit_file].path_off),
                        fit_file, 5) != 0) {
                    return -1
                }
            }
            fit += 1
        }
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    let view ast.AstView
    ast.ast_view(&view)
    // verify_module 的 1–4 表达式、语句、声明、函数阶段；映射回既有外层诊断。
    let check_result int = check.verify_module(&view)
    if (check_result == 1) {
        return gen.fail("内部错误：表达式 AST 校验失败")
    }
    if (check_result == 2) {
        return gen.fail("内部错误：语句 AST 校验失败")
    }
    if (check_result == 3) {
        return gen.fail("内部错误：顶层声明 AST 校验失败")
    }
    if (check_result == 4) {
        return gen.fail("内部错误：函数 AST 上下文校验失败")
    }
    if (check_result != 0) { return -1 }
    // check 也通过真实受检快照边界，确认合法输入不依赖旧输出或可变语义表。
    // LLVM 编译继续 lowering 并发布对象；check 只验证受检快照，不触发后端发射。
    if (gs.task.c_check_only != 0) {
        let checked ast.CheckedModule
        if (gen.front_checked_verify() != 0
            || ast.checked_module_capture(&checked) != 0) { return -1 }
        let checked_ok int = mb_verify_checked_snapshot(&checked)
        ast.checked_module_release(&checked)
        if (checked_ok != 0) { return checked_ok }
        if (gen.front_checked_end() != 0) { return -1 }
        mb_print_stats()
        return 0
    }
    // LA3：函数级 IR 缓存。缓存目录按模块隔离；装载失败按 miss 处理，
    // 只有模块完整成功后才提交本轮记录与索引。
    let cache_in ir.IRFunctionCacheSet
    let cache_out ir.IRFunctionCacheSet
    let env_key u64 = 0
    if (gs.task.c_test_mode == 0) {
        firc_load(gen.arr_cstr(&firc_dir[0]), &cache_in)
        if (firc_env_key(m, build_off, build_len, &env_key) != 0) {
            ir.ir_function_cache_set_release(&cache_in)
            return -1
        }
    }
    if (mb_worker_parent_alive() == 0) { return -1 }
    let lower_stats lower.CheckedLowerStats
    // 全冷构建不写函数级缓存（PC3）：cache_out 传空，capture 与 firc_commit 同跳。
    let cache_out_p *ir.IRFunctionCacheSet = gs.c_firc_write_off != 0 ?
        0.to_type(*ir.IRFunctionCacheSet) : &cache_out
    // LLVM 后端：受检快照 → 模块 IR（可复用函数 IR）→ LLVM 文本 → 内嵌桥发布对象。
    let emitted int = mb_llvm_emit_module(m, main_off, main_len, &cache_in,
        cache_out_p, env_key, &lower_stats, gen.arr_cstr(&firc_dir[0]),
        check_cache_on != 0 ? check_env : 0)
    gs.c_stats_ir_functions += lower_stats.hits + lower_stats.misses
    gs.c_stats_ir_cache_hits += lower_stats.hits
    gs.c_stats_ir_cache_misses += lower_stats.misses
    gs.c_stats_ir_lowered += lower_stats.lowered
    if (emitted == 0 && gs.task.c_test_mode == 0 && cache_out_p != 0) {
        firc_commit(gen.arr_cstr(&firc_dir[0]), &cache_out)
    }
    ir.ir_function_cache_set_release(&cache_in)
    ir.ir_function_cache_set_release(&cache_out)
    if (emitted != 0) { return -1 }
    if (gen.front_checked_end() != 0) { return -1 }
    mb_print_stats()
    return 0
}
