module build
import errors
import support
import table
import parse
import comptime
import ast
import check
import builtin
import ir
import lower
import proj
import link

// module_worker.yh：在 fork 继承的项目快照上初始化私有语义状态并编译单个模块。

// mb_verify_checked_snapshot：把只读快照校验的失败阶段映射回捕获期既有诊断。
fn mb_verify_checked_snapshot(unit *check.CheckedModule) int {
    let stage int = check.verify_checked_module(unit)
    if (stage == 0) { return 0 }
    if (stage == 1) { return errors.fail("受检模块快照表存储无效") }
    if (stage == 2) { return errors.fail("受检模块类型或函数签名快照校验失败") }
    if (stage == 3) { return errors.fail("受检模块字段类型快照校验失败") }
    if (stage == 4) { return errors.fail("受检模块函数参数签名快照校验失败") }
    if (stage == 5) { return errors.fail("受检模块类型别名快照校验失败") }
    if (stage == 6) { return errors.fail("受检模块符号类型快照校验失败") }
    if (stage == 7) { return errors.fail("受检模块文件快照校验失败") }
    if (stage == 8) { return errors.fail("受检模块表达式快照校验失败") }
    if (stage == 9) { return errors.fail("受检模块语句快照校验失败") }
    if (stage == 10) { return errors.fail("受检模块函数快照校验失败") }
    return errors.fail("受检模块快照校验失败")
}

// mb_llvm_module_paths：算出本模块的 LLVM 对象、文本与汇编路径。
// 对象放在 obj/<tag>.o，文本放在 llvm/<tag>.ll，汇编放在 asm/<tag>.s；
// 三者都用 proj.mod_tag 生成的项目+模块标记防同名冲突。
// build_off/build_len 由任务携带（父进程已解析），本函数不再重算构建目录。
// asm_out/text_out 传 0 表示不需要该路径。返回 0 成功；标记失败返回 -1。
fn mb_llvm_module_paths(m int, build_off int, build_len int,
    obj_out *u8, text_out *u8, asm_out *u8) int {
    let tag_off int = -1
    let tag_len int = 0
    if (proj.mod_tag(m, &tag_off, &tag_len) != 0) { return -1 }
    let n int = 0
    n = support.append_str(obj_out, n, proj.pool_str(build_off))
    n = support.append_str(obj_out, n, "/obj/")
    n = support.append_str(obj_out, n, proj.pool_str(tag_off))
    n = support.append_str(obj_out, n, ".o")
    obj_out[n] = 0
    n = 0
    n = support.append_str(text_out, n, proj.pool_str(build_off))
    n = support.append_str(text_out, n, "/llvm/")
    n = support.append_str(text_out, n, proj.pool_str(tag_off))
    n = support.append_str(text_out, n, ".ll")
    text_out[n] = 0
    if (asm_out != 0) {
        n = 0
        n = support.append_str(asm_out, n, proj.pool_str(build_off))
        n = support.append_str(asm_out, n, "/asm/")
        n = support.append_str(asm_out, n, proj.pool_str(tag_off))
        n = support.append_str(asm_out, n, ".s")
        asm_out[n] = 0
    }
    return 0
}

// mb_llvm_emit_module：LLVM 后端模式下的模块编译（LA1a）。
// 本函数只保留模块前端、快照校验与接口/缓存编排；受检快照 → 模块 IR →
// LLVM 文本 → 内嵌桥 → 原子对象发布由 llvm_pipeline 统一承担。
// 返回 0 成功、-1 失败（诊断已写 stderr）。
fn mb_llvm_emit_module(m int, build_off int, build_len int,
    cache_in *ir.IRFunctionCacheSet, cache_out *ir.IRFunctionCacheSet,
    env_key u64, lower_stats *lower.CheckedLowerStats, check_dir *char,
    check_env u64) int {
    let obj_path [700]u8
    let text_path [700]u8
    let asm_path [700]u8
    if (mb_llvm_module_paths(m, build_off, build_len, &obj_path[0],
            &text_path[0], &asm_path[0]) != 0) {
        return -1
    }
    let view ast.AstView
    ast.ast_view(&view)
    if (check.verify_module(&view) != 0) {
        return errors.fail("内部错误：受检 AST 上下文校验失败")
    }
    let checked check.CheckedModule
    if (check.front_checked_verify() != 0
        || check.checked_module_capture(&checked) != 0) {
        return -1
    }
    let checked_status int = mb_verify_checked_snapshot(&checked)
    if (checked_status != 0) {
        check.checked_module_release(&checked)
        return checked_status
    }
    // LA3.3 C3：从已验证快照 capture 本轮 check 切片；命中/未命中都刷新记录。
    let check_out ir.IRFunctionCacheSet
    let check_capture int = 0
    if (check_env != 0) {
        check_capture = check.checked_check_cache_capture(&checked, &check_out,
            check_env)
        if (check_capture != 0) {
            errors.fail("函数 check 缓存捕获失败（本次不提交 check 缓存）")
        }
    }
    // 文本/汇编路径只在对应开关打开时给出；对象始终发布，构建步才能继续链接。
    let text_out *char = proj.cfg().emit_kind == 1 ? support.arr_cstr(&text_path[0]) : 0.to_type(*char)
    let asm_out *char = proj.cfg().emit_asm == 1 ? support.arr_cstr(&asm_path[0]) : 0.to_type(*char)
    let status int = llvm_emit_module_to_cached(&checked, 0,
        support.arr_cstr(&obj_path[0]), text_out, asm_out, 0, cache_in, cache_out,
        env_key, lower_stats, proj.module_opt_level(m))
    check.checked_module_release(&checked)
    if (status == 0 && check_env != 0 && check_capture == 0) {
        firc_check_commit(check_dir, &check_out)
    }
    ir.ir_function_cache_set_release(&check_out)
    return status
}

// —— worker 父进程存活检查（RB1） ——
// 构建被中断（Ctrl-C / 超时 / harness abort / kill -9）时，父进程没有机会回收
// fork 出来的模块 worker；若不检查，这些 worker 会变成 ppid=1 的孤儿继续编译，
// 把机器 CPU 吃满（实测 5 个孤儿把 load 推到 195）。worker 在几个粗粒度检查点
// 比对 getppid()，父已不在就立刻退出。
let mb_worker_parent int = 0

// mb_worker_parent_alive：父进程仍在返回 1；未设置检查时视为在（单进程路径）。
fn mb_worker_parent_alive() int {
    if (mb_worker_parent == 0) { return 1 }
    return getppid() == mb_worker_parent ? 1 : 0
}

// mb_emit_job：复用已扫描的项目、词法 token 与顶层声明索引，编译 job.mod 一个模块。
// 输入全部来自 job（模式、依赖接口、符号后缀、构建目录与汇编输出目录）；
// 只在当前子进程建立语义表、检查模块并发布 LLVM 对象与本轮私有接口。
// 返回 0 = 成功；-1 = 失败（诊断已写 stderr）。
fn mb_emit_job(job *ModuleJob) int {
    if (mb_worker_parent_alive() == 0) { return -1 }
    // worker 只走受检前端：check 与 LLVM 发射共用同一条语义遍历。
    if (check.front_checked_begin() != 0) {
        return -1
    }
    comptime.ct_reset()
    support.ctl().front_cache = 1
    support.session().ast_capture = 0
    support.ctl().ir_cache_salt = job.ir_cache_salt
    errors.diag().errors = 0
    let m int = job.mod
    if (m < 0 || m >= proj.mod_count()) { return -1 }
    // B0 过渡：job.mode 是 worker 边界的权威模式，落回会话开关供下游既有读点使用；
    // B1 把这些读点切到 job.mode 后删除这两行。
    support.session().check_only = (job.mode & JOB_CHECK) != 0 ? 1 : 0
    support.session().test_mode = (job.mode & JOB_TEST) != 0 ? 1 : 0
    proj.cfg().module_mode = 1
    proj.cfg().is_entry_mod = proj.mod_at(m).is_entry
    support.msym().off = job.sym_sfx_off
    support.msym().len = job.sym_sfx_len
    if (check.sem_init_tables() != 0) {
        return -1
    }
    // F4：绑定 CT 类型表槽（见 check/ct_bind.yh）。
    check.ct_facts_sync()
    if (builtin.front_prepare() != 0) {
        return -1
    }
    let build_off int = job.build_off
    let build_len int = job.build_len
    // RS3b：按文件汇编目录（父进程只创建到 asm/ 一级）
    if (support.session().check_only == 0 && link.cmd_mkdirs(job.out_dir) != 0) {
        return errors.fail_path("无法创建汇编目录: ", job.out_dir)
    }
    let di int = 0
    for di < mb_job_dep_count(job) {
        let dep *BDep = mb_job_dep_at(job, di)
        if (support.set_source_path(proj.pool_str(dep.ifoff)) != 0) {
            return -1
        }
        if (parse.iface_load(proj.pool_str(dep.ifoff),
                dep.bind_off, dep.bind_len) < 0) {
            return -1
        }
        di += 1
    }
    support.session().ast_capture = 1
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_type_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    let cti int = 0
    for cti < mb_job_dep_count(job) {
        let dep *BDep = mb_job_dep_at(job, cti)
        if (support.set_source_path(proj.pool_str(dep.ctoff)) != 0
            || parse.iface_ct_load(proj.pool_str(dep.ctoff),
                job.dep_base + cti) != 0) {
            return -1
        }
        cti += 1
    }
    // .s.ct 闭包加载完成后执行导入侧延迟的 pub $ 聚合常量初始化式
    // （调用目标隐藏符号此刻已登记；.s.i 先于 .s.ct 加载，见
    // parse_global_init.yh 的 pub_agg_deferred_run）。
    if (parse.pub_agg_deferred_run() != 0) {
        return -1
    }
    let afi int = 0
    for afi < proj.mod_file_count(m) {
        let decl_fi int = proj.mod_file_at(m, afi)
        if (mb_restore_front_file(proj.pool_str(proj.file(decl_fi).path_off),
                decl_fi) != 0 || mb_file_head_bind(decl_fi) != 0
            || parse.decl_index_file(decl_fi) != 0
            || mb_restore_front_file(proj.pool_str(proj.file(decl_fi).path_off),
                decl_fi) != 0 || ast.ast_decl_add_file(decl_fi) != 0) {
            return -1
        }
        afi += 1
    }
    // 内部 S4-2 地基：项目上下文齐全时跑纯语法 AST 解析（不查语义、不发射）。
    let syn_off int = -1
    let syn_len int = 0
    if (proj.env_fetch("YH_SYNTAX_AST", &syn_off, &syn_len) == 0 && syn_len > 0) {
        support.session().compile = 0
        support.session().ast_capture = 1
        support.session().syntax_ast = 1
        let sfi int = 0
        for sfi < proj.mod_file_count(m) {
            let sfid int = proj.mod_file_at(m, sfi)
            if (mb_restore_front_file(proj.pool_str(proj.file(sfid).path_off),
                    sfid) != 0
                || mb_file_head_bind(sfid) != 0
                || parse.parse_indexed_decls(0) != 0) {
                return -1
            }
            sfi += 1
        }
        if (errors.diag().errors > 0) { return -1 }
        if (ast.ast_expr_count_now() == 0 || ast.ast_stmt_count_now() == 0) {
            return errors.fail("纯语法 AST 未产生表达式或语句节点")
        }
        return 0
    }
    let sym_base int = table.ms().sym_n
    let tname_base int = table.ms().name_n
    support.session().compile = 1
    support.session().pass = 1
    let fi int = 0
    for fi < proj.mod_file_count(m) {
        let file_id int = proj.mod_file_at(m, fi)
        if (mb_pass1_file(proj.pool_str(proj.file(file_id).path_off),
                file_id) != 0) {
            return -1
        }
        fi += 1
    }
    if (errors.diag().errors > 0) {
        return -1
    }
    let bind_i int = 0
    for bind_i < proj.mod_file_count(m) {
        let bind_fi int = proj.mod_file_at(m, bind_i)
        if (mb_restore_front_file(proj.pool_str(proj.file(bind_fi).path_off),
                bind_fi) != 0 || ast.ast_decl_bind_file(bind_fi) != 0) {
            return -1
        }
        bind_i += 1
    }
    if (mb_check_binding_clash(m) != 0) {
        return -1
    }
    if (proj.cfg().is_entry_mod != 0) {
        // yh test 允许入口模块没有 main（仅检查测试）；生产构建仍强制 main。
        if (support.session().test_mode != 0) {
            if (check.sem_check_main_optional() != 0) { return -1 }
        } else if (check.sem_check_main() != 0) {
            return -1
        }
    }
    // UF1（合入 0.0.11-rc）：pass1 已登记本模块全部符号与顶层声明索引，
    // 先报未使用的私有函数，不必等正文编译完（跨文件使用同样计入）。
    if (unused_function_report(proj.mod_files_base(m),
            proj.mod_file_count(m), sym_base) != 0) {
        return -1
    }
    support.session().pass = 2
    let fi_ct int = 0
    for fi_ct < proj.mod_file_count(m) {
        let file_ct int = proj.mod_file_at(m, fi_ct)
        if (mb_pass2_file(proj.pool_str(proj.file(file_ct).path_off),
                file_ct, MB_PASS2_CT_FNS) != 0) { return -1 }
        fi_ct += 1
    }
    if (errors.diag().errors > 0) { return -1 }
    let fi_ct_layout int = 0
    for fi_ct_layout < proj.mod_file_count(m) {
        let file_id int = proj.mod_file_at(m, fi_ct_layout)
        if (mb_pass2_file(proj.pool_str(proj.file(file_id).path_off),
                file_id, MB_PASS2_LAYOUT_REGISTER) != 0) { return -1 }
        fi_ct_layout += 1
    }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_before == 0) { break }
        let fi_layout_eval int = 0
        for fi_layout_eval < proj.mod_file_count(m) {
            let file_id int = proj.mod_file_at(m, fi_layout_eval)
            if (mb_pass2_file(proj.pool_str(proj.file(file_id).path_off),
                    file_id, MB_PASS2_LAYOUT_EVAL) != 0) { return -1 }
            if (mb_restore_front_file(proj.pool_str(proj.file(file_id).path_off),
                    file_id) != 0 || mb_file_head_bind(file_id) != 0
                || parse.parse_source_ct_layout_exprs() != 0) { return -1 }
            fi_layout_eval += 1
        }
        if (comptime.ct_layout_advance() < 0) { return -1 }
        let pending_after int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_after == 0) { break }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic()
            } else {
                comptime.ct_value_stuck_diagnostic()
            }
            return -1
        }
    }
    if (comptime.ct_layout_resolve() != 0 || errors.diag().errors > 0) { return -1 }
    // 延迟的枚举判别值：此时编译期函数正文已捕获，可以真实求值。
    if (parse.ct_enum_pending_run() != 0) { return -1 }
    // 全局初始化（mode 1）：ST/CT 数据登记，供受检快照消费。
    let fi2 int = 0
    for fi2 < proj.mod_file_count(m) {
        let file_id int = proj.mod_file_at(m, fi2)
        if (mb_pass2_file(proj.pool_str(proj.file(file_id).path_off),
                file_id, MB_PASS2_GLOBALS) != 0) {
            return -1
        }
        fi2 += 1
    }
    if (errors.diag().errors > 0) {
        return -1
    }
    let ctpath [700]u8
    let ipath [700]u8
    if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            ctpath) != 0
        || check.iface_ct_emit(support.arr_cstr(ctpath), sym_base) != 0
        || proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, ipath) != 0
        || check.iface_emit(support.arr_cstr(ipath), sym_base, tname_base) != 0) {
        return -1
    }
    let ready_path [700]u8
    if (mb_module_ready_path(m, build_off, build_len, &ready_path[0]) != 0
        || mb_iface_write_ready(support.arr_cstr(&ready_path[0])) != 0) {
        return errors.fail("无法发布模块接口就绪标记")
    }
    // LA3.3 C3：函数体 pass2b 前装载 check 缓存。项目 check-only 始终完整检查，
    // 避免把“检查”变成缓存命中报告。
    let firc_dir [700]u8
    if (firc_dir_path(m, build_off, build_len, &firc_dir[0]) != 0) {
        return -1
    }
    // yh test 的测试体与生产函数共用签名，但受检切片/IR 里多出测试函数与
    // 断言调用；测试构建不装载、不提交函数级缓存，避免与生产记录串用。
    let check_in ir.IRFunctionCacheSet
    let check_env u64 = 0
    let check_cache_on int = 0
    // PC2 v3：切片携带本函数字符串登记并守卫类型/静态数据规模，可重新装载。
    if (support.session().check_only == 0 && support.session().test_mode == 0) {
        firc_check_load(support.arr_cstr(&firc_dir[0]), &check_in)
        if (firc_env_key(m, build_off, build_len, &check_env) != 0) {
            ir.ir_function_cache_set_release(&check_in)
            return -1
        }
        check.checked_check_cache_begin(&check_in, check_env)
        check_cache_on = 1
    }
    let fi3 int = 0
    for fi3 < proj.mod_file_count(m) {
        let file_id int = proj.mod_file_at(m, fi3)
        if (mb_pass2_file(proj.pool_str(proj.file(file_id).path_off),
                file_id, MB_PASS2_FN_BODY) != 0) {
            if (check_cache_on != 0) { check.checked_check_cache_end() }
            ir.ir_function_cache_set_release(&check_in)
            return -1
        }
        fi3 += 1
    }
    if (check_cache_on != 0) {
        check.checked_check_cache_end()
    }
    ir.ir_function_cache_set_release(&check_in)
    // yh test：全部普通函数登记完成后检查目标项目的测试体。测试体只在
    // 各自模块内解析，依赖/标准库的测试不进入本轮。
    if (support.session().test_mode != 0 && proj.mod_at(m).proj == proj.ctx().test_project
        && (proj.ctx().test_mod_filter < 0 || proj.ctx().test_mod_filter == m)) {
        let fit int = 0
        for fit < proj.mod_file_count(m) {
            let fit_file int = proj.mod_file_at(m, fit)
            if (proj.ctx().test_file_filter < 0 || proj.ctx().test_file_filter == fit_file) {
                if (mb_pass2_file(proj.pool_str(proj.file(fit_file).path_off),
                        fit_file, MB_PASS2_TEST_BODY) != 0) {
                    return -1
                }
            }
            fit += 1
        }
    }
    // S4-2 影子门：从语法节点重算表达式语义并与 parse 注解比对。
    // 仅门禁开启（YH_AST_FULL_CHECK=1）时运行；不一致直接失败，不静默放过。
    let fc_off int = -1
    let fc_len int = 0
    if (proj.env_fetch("YH_AST_FULL_CHECK", &fc_off, &fc_len) == 0 && fc_len > 0) {
        let vfi int = 0
        for vfi < proj.mod_file_count(m) {
            let vid int = proj.mod_file_at(m, vfi)
            if (mb_restore_front_file(proj.pool_str(proj.file(vid).path_off),
                    vid) != 0 || mb_file_head_bind(vid) != 0) {
                return -1
            }
            let bad int = check.full_verify_file(vid)
            if (bad < 0) { return -1 }
            if (bad > 0) { return check.full_fail_report() }
            vfi += 1
        }
        // ponytail: 不做「判定数为 0 就失败」的运行时守卫——标准库里有完全不含
        // 折叠常量的项目（libs/time 消费者构建实测），逐构建要求非空会误杀；
        // 非空性由 tests/tools/front-full 夹具（const 算术 + 数组长度）保证，
        // 覆盖扩大后若担心空转，再在夹具里加形状而不是在驱动层加阈值。
    }
    if (errors.diag().errors > 0) {
        return -1
    }
    let view ast.AstView
    ast.ast_view(&view)
    // verify_module 的 1–4 表达式、语句、声明、函数阶段；映射回既有外层诊断。
    // S3a：语句级隐式转换校验（parse 已不做，移到遍历 AST 之后、结构校验之前）。
    if (check.convert_returns(&view) != 0) { return -1 }
    if (check.convert_assigns(&view) != 0) { return -1 }
    let check_result int = check.verify_module(&view)
    if (check_result == 1) {
        return errors.fail("内部错误：表达式 AST 校验失败")
    }
    if (check_result == 2) {
        return errors.fail("内部错误：语句 AST 校验失败")
    }
    if (check_result == 3) {
        return errors.fail("内部错误：顶层声明 AST 校验失败")
    }
    if (check_result == 4) {
        return errors.fail("内部错误：函数 AST 上下文校验失败")
    }
    if (check_result != 0) { return -1 }
    // PF2：前端段到 check 通过为止（含 check-only 路径）；后续 lower/IR/桥另计。
    // check 也通过真实受检快照边界，确认合法输入不依赖旧输出或可变语义表。
    // LLVM 编译继续 lowering 并发布对象；check 只验证受检快照，不触发后端发射。
    if (support.session().check_only != 0) {
        let checked check.CheckedModule
        if (check.front_checked_verify() != 0
            || check.checked_module_capture(&checked) != 0) { return -1 }
        let checked_ok int = mb_verify_checked_snapshot(&checked)
        check.checked_module_release(&checked)
        if (checked_ok != 0) { return checked_ok }
        if (check.front_checked_end() != 0) { return -1 }
        return 0
    }
    // LA3：函数级 IR 缓存。缓存目录按模块隔离；装载失败按 miss 处理，
    // 只有模块完整成功后才提交本轮记录与索引。
    let cache_in ir.IRFunctionCacheSet
    let cache_out ir.IRFunctionCacheSet
    let env_key u64 = 0
    if (support.session().test_mode == 0) {
        firc_load(support.arr_cstr(&firc_dir[0]), &cache_in)
        if (firc_env_key(m, build_off, build_len, &env_key) != 0) {
            ir.ir_function_cache_set_release(&cache_in)
            return -1
        }
    }
    if (mb_worker_parent_alive() == 0) { return -1 }
    let lower_stats lower.CheckedLowerStats
    // 全冷构建不写函数级缓存（PC3）：cache_out 传空，capture 与 firc_commit 同跳。
    let cache_out_p *ir.IRFunctionCacheSet = support.ctl().firc_write_off != 0 ?
        0.to_type(*ir.IRFunctionCacheSet) : &cache_out
    // LLVM 后端：受检快照 → 模块 IR（可复用函数 IR）→ LLVM 文本 → 内嵌桥发布对象。
    let emitted int = mb_llvm_emit_module(m, build_off, build_len, &cache_in,
        cache_out_p, env_key, &lower_stats, support.arr_cstr(&firc_dir[0]),
        check_cache_on != 0 ? check_env : 0)
    if (emitted == 0 && support.session().test_mode == 0 && cache_out_p != 0) {
        firc_commit(support.arr_cstr(&firc_dir[0]), &cache_out)
    }
    ir.ir_function_cache_set_release(&cache_in)
    ir.ir_function_cache_set_release(&cache_out)
    if (emitted != 0) { return -1 }
    if (check.front_checked_end() != 0) { return -1 }
    return 0
}
