module build
import check
import support
import ir
import proj
import link

// ============================================================================
// module_build.yh —— 构建命令面与标准库装载（B2-4 拆分后的剩余部分）
//
// 本文件只剩「命令怎么做」：yh build / run / version / list 的参数解析与
// 编排、标准库项目发现与装载、以及 --stats/--contracts 输出。
// 单模块发射流水线见 module_emit.yh，缓存键与依赖表见 module_cache.yh，
// 产物路径/哈希在 proj（proj_40_art.yh），工具链调用在 link。
// ============================================================================

// bc().argv0：自身可执行路径（argv[0] 借用，不复制），用于编译器指纹。


// MB_TAG_MAX / MB_BUILD_DIR_MAX：路径预算。
//
// 项目名与模块名都来自用户输入，`proj.mod_tag` 用 [512]u8 临时缓冲拼接，
// 派生的接口/对象路径又写进 600/700/900 字节的定长缓冲。两个名字不限长时
// 会写穿栈（且 `support.append_str` 不做容量检查）。这里在源头设预算：
//   构建目录 ≤ 400，标记 ≤ 120，派生路径最长 400 + 7 + 120 + 5 + 1 = 533，
//   低于最小的 600 字节缓冲；超限给出可操作诊断而不是崩溃。
const MB_BUILD_DIR_MAX int = 400
const MB_TAG_MAX int = 120

// mb_intern_arg：命令行参数字符串入名字池，返回偏移（长度出参）。
pub fn mb_intern_arg(s *char, olen *int) int {
    let sl int = 0
    for s[sl] != 0 {
        sl += 1
    }
    olen[0] = sl
    return support.tml_intern_str(s.to_type(*u8), 0, sl)
}

// mb_try_default_stdlib：尝试 dir+suffix 下的标准库项目。
// 返回 1 表示已装载，0 表示该候选不存在，-1 表示候选存在但装载失败。
// 只接受带 project.toml 的目录；不猜测库名，也不把任意模块目录当标准库。
fn mb_try_default_stdlib(dir *char, suffix *char) int {
    let c_off int = 0
    let c_len int = 0
    let path [1200]u8
    let n int = 0
    // Windows 的 exe 目录来自 GetFullPathNameA（反斜杠），suffix 里是 '/'；
    // pj_canon 按 '/' 切段，混合分隔符会让 `..` 解析失效（安装布局
    // <root>/bin/yh + <root>/share/yh/libs 曾因此找不到标准库）。
    // 统一成 '/'：Win32 API 同样接受。
    let i0 int = 0
    for dir[i0] != 0 {
        if (n + 1 >= 1200) { return 0 }
        path[n] = dir[i0] == 92 ? 47 : dir[i0].to_type(u8)
        n += 1
        i0 += 1
    }
    n = support.append_str(path, n, suffix)
    path[n] = 0
    if (proj.canon(0, 0, support.arr_cstr(path), &c_off, &c_len) != 0) {
        return 0
    }
    let cand_off int = c_off
    let cand_len int = c_len
    let manifest [1200]u8
    let mn int = 0
    let i int = 0
    for i < cand_len {
        manifest[mn] = support.pool_ctx().data[cand_off + i]
        mn += 1
        i += 1
    }
    mn = support.append_str(manifest, mn, "/project.toml")
    manifest[mn] = 0
    if (proj.file_exists(support.arr_cstr(manifest)) == 0) {
        return 0
    }
    let loaded int = pj_load_project(cand_off, cand_len)
    if (loaded < 0) {
        return -1
    }
    proj.ctx().stdlib = loaded
    return 1
}

// mb_load_default_stdlib：按可执行文件附近布局查找标准库。
// 依次尝试 <exe_dir>/libs（仓库构建）、<exe_dir>/../libs（bin 下种子）
// 与 <exe_dir>/../share/yh/libs（安装布局）。找不到时保持无标准库层；
// 找到但项目损坏时返回 -1，不静默回退到其它候选。
fn mb_load_default_stdlib() int {
    if (mb_resolve_self_path() != 0) {
        return 0
    }
    let self_len int = strlen(bc().self_path).to_type(int)
    // 分隔符两种都认：Git Bash / cmd.exe 启动时 argv[0] 往往是反斜杠形式
    // （实测 `C:\...\bin\yh`），只按 '/' 切会让 cut 落到 0、dir 退化成 '.'，
    // 于是安装布局（`<root>/bin/yh` + `<root>/share/yh/libs`）永远找不到标准库。
    let cut int = self_len
    for cut > 0 && bc().self_path[cut - 1] != '/' && bc().self_path[cut - 1] != 92 {
        cut -= 1
    }
    let dir [1200]u8
    let dn int = 0
    if (cut > 1) {
        let i int = 0
        for i < cut - 1 {
            dir[dn] = bc().self_path[i].to_type(u8)
            dn += 1
            i += 1
        }
    } else if (cut == 1) {
        dir[0] = '/'
        dn = 1
    } else {
        dir[0] = '.'
        dn = 1
    }
    dir[dn] = 0
    let found int = mb_try_default_stdlib(support.arr_cstr(dir), "/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(support.arr_cstr(dir), "/../libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(support.arr_cstr(dir), "/../share/yh/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    proj.ctx().stdlib = -1
    return 0
}

// mb_load_stdlib：装载 YH_STDLIB 指定的标准库项目。
// YH_STDLIB 非空时优先且失败不回退；为空/未设置时按可执行文件附近布局
// 查找默认标准库（仓库 <root>/libs、bin 种子相邻 libs 或安装 share/yh/libs）。
pub fn mb_load_stdlib() int {
    let c_off int = 0
    let c_len int = 0
    if (proj.ctx().stdlib >= 0) {
        return 0
    }
    let off int = -1
    let olen int = 0
    if (proj.env_fetch("YH_STDLIB", &off, &olen) < 0) {
        return -1
    }
    if (olen == 0) {
        return mb_load_default_stdlib()
    }
    if (proj.canon(0, 0, proj.pool_str(off), &c_off, &c_len) != 0) {
        return -1
    }
    let s int = pj_load_project(c_off, c_len)
    if (s < 0) {
        return -1
    }
    proj.ctx().stdlib = s
    return 0
}

// pj_topo_multi：库模式——从项目每个模块出发收集依赖序。
pub fn pj_topo_multi(pj int) int {
    if (pj_topo(proj.ctx().projs[pj].mods[0]) < 0) {
        return -1
    }
    let i int = 1
    for i < proj.ctx().projs[pj].mod_n {
        if (proj.ctx().mark[proj.ctx().projs[pj].mods[i]] != 2) {
            if (pj_dfs(proj.ctx().projs[pj].mods[i]) != 0) {
                return -1
            }
        }
        i += 1
    }
    return proj.ctx().order_n
}

// mb_ensure_binary_dir：确保默认产物目录 <root>/.build 存在。
// 缓存根可被 YH_BUILD_CACHE 迁到项目外（proj.cache_root），此时 mb_mkdir
// 只建缓存树，默认产物目录需单独创建；显式 -o 的目标归用户。
fn mb_ensure_binary_dir(root_off int, root_len int) int {
    let c_off int = 0
    let c_len int = 0
    if (proj.canon(root_off, root_len, ".build", &c_off, &c_len) != 0) {
        return -1
    }
    if (link.cmd_mkdirs(proj.pool_str(c_off)) != 0) {
        return support.fail_path("无法创建产物目录: ", proj.pool_str(c_off))
    }
    return 0
}

// mb_select_links：把 cli 解析出的 --link 组名登记进链接选择表（CLI-R）。
// 调用方已先 link.li_select_reset()；0 成功、2 组名非法、-1 内部失败。
pub fn mb_select_links(links []*char) int {
    let i int = 0
    for i < len(links) {
        let link_arg *char = links[i]
        let ll int = 0
        for link_arg[ll] != 0 { ll += 1 }
        let lo int = support.tml_intern_str(link_arg.to_type(*u8), 0, ll)
        if (lo < 0) { return -1 }
        if (pl_group_name_ok(lo, ll) == 0) {
            support.fail("--link 组名只能包含字母、数字、_、-")
            return 2
        }
        if (link.li_select_add(lo, ll) != 0) { return -1 }
        i += 1
    }
    return 0
}

// mb_cmd_build：按 cli 解析出的请求构建项目（CLI-R）。out_path 可空，
// module 由 has_module 指示，links 是 --link 组名（借用 argv）。
// 返回 0 成功、1 源码/语义错误、2 用法错误、-1 内部失败。
pub fn mb_cmd_build(out_path *char, module_arg *char, has_module int, links []*char) int {
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    let out_arg *char = out_path
    let mod_arg_off int = -1
    let mod_arg_len int = 0
    let mod_arg_n int = 0
    link.li_select_reset()
    let link_rc int = mb_select_links(links)
    if (link_rc != 0) {
        return link_rc
    }
    if (has_module != 0 && module_arg != 0) {
        let sl int = 0
        for module_arg[sl] != 0 { sl += 1 }
        let mo int = support.tml_intern_str(module_arg.to_type(*u8), 0, sl)
        if (mo < 0) { return -1 }
        mod_arg_off = mo
        mod_arg_len = sl
        mod_arg_n = 1
    }
    if (support.session().check_only != 0 && link.li_select_count() > 0) {
        support.fail("yh check 不支持 --link")
        return 2
    }
    support.src_ctx().path = "yh"
    // 父进程建立可继承的只读前端快照，fork worker 不再重扫项目源码。
    support.ctl().front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    // 根路径长度由 pj_find_root 出参返回（不再依赖全局游标）。
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    // 构建根：显式模块参数 > 名为 main 的入口模块 > 库模式
    let rootmod int = -1
    if (mod_arg_off >= 0) {
        rootmod = proj.module_in_project(pj, mod_arg_off, mod_arg_len)
        if (rootmod < 0) {
            let buf [128]u8
            let n int = 0
            n = support.append_str(buf, n, "本项目没有模块: ")
            n = support.append_np(buf, n, mod_arg_off, mod_arg_len)
            let mo4 int = support.tml_intern_str(buf, 0, n)
            if (mo4 < 0) {
                return -1
            }
            return support.fail(support.np_cstr(mo4))
        }
    } else {
        rootmod = pj_entry_mod(pj)
    }
    if (rootmod < 0 && link.li_select_count() > 0) {
        support.fail("库项目没有可链接产物，--link 不适用")
        return 2
    }
    // topo（依赖序）
    let count int = 0
    if (rootmod >= 0) {
        count = pj_topo(rootmod)
        if (count < 0) {
            return 1
        }
    } else {
        count = pj_topo_multi(pj)
        if (count < 0) {
            return 1
        }
    }
    // 构建目录
    let build_len int = 0
    let build_off int = proj.build_dir(root_off, root_len, &build_len)
    if (build_off < 0) {
        return 1
    }
    if (mb_mkdir(proj.pool_str(build_off)) != 0) {
        return 1
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        if (support.session().check_only != 0) {
            mb_check_clear_ifaces(build_off, build_len, count)
        }
        return 1
    }
    if (support.session().check_only != 0) {
        mb_check_clear_ifaces(build_off, build_len, count)
        pj_out_s("检查通过: ")
        pj_out_np(proj.ctx().projs[pj].name_off, proj.ctx().projs[pj].name_len)
        pj_out_s("\n")
        return 0
    }
    // 链接（有入口时）
    if (rootmod >= 0) {
        let outbuf [620]u8
        let on int = 0
        if (out_arg != 0) {
            on = support.append_str(outbuf, on, out_arg)
        } else {
            // 无 -o：产物名取清单 project.name
            if (mb_ensure_binary_dir(root_off, root_len) != 0) { return 1 }
            if (proj.default_binary_path(root_off, root_len, build_off,
                    pj, &outbuf[0]) < 0) { return 1 }
            on = 0
            for outbuf[on] != 0 { on += 1 }
        }
        outbuf[on] = 0
        if (link.mb_link(support.arr_cstr(outbuf), build_off, build_len, count, pj) != 0) {
            return 1
        }
        pj_out_s("构建完成: ")
        pj_out_s(support.arr_cstr(outbuf))
        pj_out_s("\n")
        return 0
    }
    pj_out_s("库构建完成（模块对象与接口在 ")
    pj_out_np(build_off, build_len)
    pj_out_s("）\n")
    return 0
}

// mb_cmd_run：按 cli 解析出的请求构建并运行 main 模块（CLI-R）。
// links 是 --link 组名（借用 argv）；跨目标在本机运行前明确拒绝。
pub fn mb_cmd_run(links []*char) int {
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    link.li_select_reset()
    let link_rc int = mb_select_links(links)
    if (link_rc != 0) {
        return link_rc
    }
    support.src_ctx().path = "yh"
    support.ctl().front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (support.target_matches_host() == 0) {
        return support.fail("yh run 的目标平台必须与宿主一致；跨目标请用 yh build")
    }
    if (pj_entry_mod(pj) < 0) {
        return support.fail("库项目没有入口，无法 run（需要一个 module main;）")
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    let rootmod int = pj_entry_mod(pj)
    let count int = pj_topo(rootmod)
    if (count < 0) {
        return 1
    }
    let build_len int = 0
    let build_off int = proj.build_dir(root_off, root_len, &build_len)
    if (build_off < 0) {
        return 1
    }
    if (mb_mkdir(proj.pool_str(build_off)) != 0) {
        return 1
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        return 1
    }
    let binbuf [620]u8
    if (mb_ensure_binary_dir(root_off, root_len) != 0) { return 1 }
    let bn int = proj.default_binary_path(root_off, root_len, build_off,
        pj, &binbuf[0])
    if (bn < 0) { return 1 }
    if (link.mb_link(support.arr_cstr(binbuf), build_off, build_len, count, pj) != 0) {
        return 1
    }
    if (link.li_apply_runtime_env() != 0) { return 1 }
    // 运行（继承 stdout/stderr；退出码由 waitpid 状态字解码）。
    let args [2]*char
    args[0] = support.arr_cstr(binbuf)
    args[1] = 0.to_type(*char)
    let rc int = link.cmd_process_run(&args[0])
    return rc < 0 ? 1 : rc
}

// mb_print_version：打印当前项目的 name 与 version（清单 project.version
// 缺省时标注未声明）。quiet=1 时找不到项目静默返回（usage 顺手显示）。
// mb_print_contracts：输出本编译器认识的产物契约版本（key=value，稳定格式）。
//
// 供 CI 与外部工具（yh-explorer、VSCode 扩展）协商：它们读这里的版本，
// 而不是去猜 `.s.i`/`.s.ct` 头行或 IR 序列化格式。版本常量单点定义在
// parse（接口头行）与 ir（序列化）模块，这里只做展示，不另存副本。
pub fn mb_print_contracts() int {
    let buf [512]u8
    let n int = 0
    n = support.append_str(&buf[0], n, "iface-min=")
    n = support.append_int(&buf[0], n, check.IFACE_VERSION_MIN)
    n = support.append_byte(&buf[0], n, '\n')
    n = support.append_str(&buf[0], n, "iface-max=")
    n = support.append_int(&buf[0], n, check.IFACE_VERSION_MAX)
    n = support.append_byte(&buf[0], n, '\n')
    n = support.append_str(&buf[0], n, "ctiface=")
    n = support.append_int(&buf[0], n, check.CTIFACE_VERSION)
    n = support.append_byte(&buf[0], n, '\n')
    n = support.append_str(&buf[0], n, "ir-function=")
    n = support.append_int(&buf[0], n, ir.IR_SERIAL_VERSION)
    n = support.append_byte(&buf[0], n, '\n')
    n = support.append_str(&buf[0], n, "ir-module=")
    n = support.append_int(&buf[0], n, ir.IR_MODULE_SERIAL_VERSION)
    n = support.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    pj_out_s(support.arr_cstr(&buf[0]))
    return 0
}

pub fn mb_print_version(quiet int) int {
    let root_len int = 0
    let root int = pj_find_root(quiet, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    pj_out_np(proj.ctx().projs[pj].name_off, proj.ctx().projs[pj].name_len)
    if (proj.ctx().projs[pj].ver_off >= 0) {
        pj_out_s(" ")
        pj_out_np(proj.ctx().projs[pj].ver_off, proj.ctx().projs[pj].ver_len)
    } else {
        pj_out_s(" (未声明 version)")
    }
    pj_out_s("\n")
    return 0
}

// mb_cmd_list：按 cli 解析出的请求列出模块或解释导入绑定（CLI-R）。
// resolve 可空；返回 0 成功、2 用法错误、-1 内部失败。
pub fn mb_cmd_list(resolve *char, has_resolve int) int {
    let resolve_off int = -1
    let resolve_len int = 0
    if (has_resolve != 0 && resolve != 0) {
        let sl int = 0
        for resolve[sl] != 0 { sl += 1 }
        let mo int = support.tml_intern_str(resolve.to_type(*u8), 0, sl)
        if (mo < 0) { return -1 }
        resolve_off = mo
        resolve_len = sl
    }
    support.src_ctx().path = "yh"
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    return pj_cmd_list(pj, resolve_off, resolve_len, has_resolve)
}
