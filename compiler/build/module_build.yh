module build
import gen
import parse
import backend
import ir
import proj

// ============================================================================
// module_build.yh —— 项目构建管线（MOD-U4/U5）
//
// 命令（设计 §11）：
//   yh build [-o out] [module] [--stats] 项目构建；stats 只输出阶段计数
//   yh check [module]           项目语义检查，不生成后端产物
//   yh run                       构建并运行清单 entry
//   yh list [--resolve name]     列出模块/解释导入绑定（project.yh）
//   yh --emit-module M ROOT -o ASMDIR （内部）把模块 M 编译为按文件汇编
//        目录（每文件一个 .s + <tag>.stub.s 运行时桩对象，RS3b 起）
//
// 构建流程：装载项目与依赖 → 绑定导入 → topo 排序（环报完整链）→
// 依赖就绪时由有界 fork worker 并行编译；worker 继承父进程只读项目快照，
// 再加载已发布接口 → 两遍编译模块文件 → 产出
// 按文件汇编（asm/<tag>/<file>.s + <tag>.stub.s）与接口 .s.i（pub 符号
// GLOBAL、private LOCAL 且发 hidden 可见性、符号带 __proj__mod 后缀）
// → mb_link 逐文件汇编成 obj/<tag>/<file>.o → 一次链接全部 .o。
//
// 缓存（U5）：解析不缓存（每轮重解析——重绑定由构造保证）；对象缓存
// 按 manifest 内容哈希：后缀+entry+各源文件内容+各依赖接口内容+版本
// 标记，命中且 .s/.i 存在则跳过重编译；发射确定性（G3 已证）保证
// 冷热构建一致。接口加载时校验头行（版本/架构），损坏或不兼容的
// 接口干净拒绝，不回退低层。
//
// 过渡宿主能力：外部进程都通过显式 argv 启动；目录枚举和环境读取
// 暂时调用独立宿主工具，R3 后续会迁入自有 OS 适配层。
// ============================================================================

// bc().argv0：自身可执行路径（argv[0] 借用，不复制），用于编译器指纹。

// mb_set_argv0 / mb_set_iface_suffix：两个跨模块只写全局的受控写入口。
// 跨模块全局不能直接导出（yh 的 pub 只用于 fn/const/struct/union/enum），
// 而这两个值分别由 CLI 入口（自身路径）与内部子进程协议（接口后缀）设置，
// 因此各给一个 setter，避免为了两个赋值把整块状态外移。
pub fn mb_set_argv0(p *char) void {
    bc().argv0 = p
}

pub fn mb_set_iface_suffix(p *char) void {
    bc().iface_suffix = p
}


// mb_mix_compiler_fingerprint：每进程读取一次编译器二进制，后续模块只混入指纹。
fn mb_mix_compiler_fingerprint(h *u64) int {
    if (bc().compiler_fingerprint_ready == 0) {
        bc().compiler_fingerprint = proj.hash_init()
        let binary *char = bc().argv0
        if (bc().self_path != 0) {
            binary = bc().self_path
        }
        // PC7a：按 (size, mtime_ns) 取身份，不再每轮重哈希 ~70 MB 的编译器自身。
        if (mb_mix_file_identity(&bc().compiler_fingerprint, binary) != 0) { return -1 }
        bc().compiler_fingerprint_ready = 1
        if (gen.stats().enabled != 0) {
            gen.stats().compiler_hashes += 1
        }
    }
    let shift int = 0
    for shift < 64 {
        proj.fnv(h, ((bc().compiler_fingerprint >> shift) & 255).to_type(u8))
        shift += 8
    }
    return 0
}

// mb_parse_hex：把恰好 16 位十六进制指纹解析为 u64；非法输入返回 -1。
pub fn mb_parse_hex(text *char, value *u64) int {
    let result u64 = 0
    let i int = 0
    for i < 16 {
        let c u8 = text[i].to_type(u8)
        let digit int = -1
        if (c >= '0' && c <= '9') { digit = c - '0' }
        if (c >= 'a' && c <= 'f') { digit = c - 'a' + 10 }
        if (c >= 'A' && c <= 'F') { digit = c - 'A' + 10 }
        if (digit < 0) { return -1 }
        result = (result << 4) | digit.to_type(u64)
        i += 1
    }
    if (text[16] != 0) { return -1 }
    value[0] = result
    return 0
}




// MB_TAG_MAX / MB_BUILD_DIR_MAX：路径预算。
//
// 项目名与模块名都来自用户输入，`proj.mod_tag` 用 [512]u8 临时缓冲拼接，
// 派生的接口/对象路径又写进 600/700/900 字节的定长缓冲。两个名字不限长时
// 会写穿栈（且 `gen.append_str` 不做容量检查）。这里在源头设预算：
//   构建目录 ≤ 400，标记 ≤ 120，派生路径最长 400 + 7 + 120 + 5 + 1 = 533，
//   低于最小的 600 字节缓冲；超限给出可操作诊断而不是崩溃。
const MB_BUILD_DIR_MAX int = 400
const MB_TAG_MAX int = 120




// mb_mkdir：确保构建目录存在。
pub fn mb_mkdir(dir *char) int {
    // 建 .build 六子目录（asm/obj/iface/manifest/ir/llvm）
    let subs [6]*char
    subs[0] = "asm"
    subs[1] = "obj"
    subs[2] = "iface"
    subs[3] = "manifest"
    subs[4] = "ir"
    subs[5] = "llvm"
    if (cmd_mkdirs(dir) != 0) {
        return gen.fail_path("无法创建构建目录: ", dir)
    }
    let k int = 0
    for k < 6 {
        let path [1100]u8
        let n int = gen.append_str(path, 0, dir)
        n = gen.append_byte(path, n, '/')
        n = gen.append_str(path, n, subs[k])
        path[n] = 0
        if (cmd_mkdirs(gen.arr_cstr(path)) != 0) {
            return gen.fail_path("无法创建构建目录: ", dir)
        }
        k += 1
    }
    return 0
}

// mb_dep_*：模块导入的去重清单（按解析结果模块下标去重）。
// bind/bindlen = 绑定名（诊断用）；ifoff = 接口路径；mod = 解析模块下标；
// mi = 该模块接口加载后的 ModInfo 下标（mb_emit_module 填写）。





// mb_check_clear_ifaces：删除本轮 check 生成的临时模块接口。
// check 使用独立构建目录，不覆盖正式构建缓存；依赖接口保留到全部模块检查结束。
fn mb_check_clear_ifaces(build_off int, build_len int, count int) void {
    let ci int = 0
    for ci < count {
        let m int = proj.ctx().order[ci]
        let path [700]u8
        if (proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        // 清除升级前留下的无后缀 check 接口。
        if (proj.module_iface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        if (proj.module_ctiface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        ci += 1
    }
}

// mb_dep_push：按解析结果模块下标去重后追加一条依赖接口记录。
// 返回 1 = 新追加，0 = 已存在，-1 = 内存失败。
fn mb_dep_push(target int, bind_off int, bind_len int) int {
    let k int = 0
    for k < bc().dep_n {
        if (bc().dep_mod[k] == target) {
            return 0
        }
        k += 1
    }
    if (bc().dep_n == bc().dep_cap) {
        let ncap int = bc().dep_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let na *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (na == 0) {
            return gen.fail("内存分配失败")
        }
        if (bc().dep_n > 0) {
            memcpy(na, bc().dep_bind, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_bind)
        bc().dep_bind = na
        let nb *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nb == 0) {
            return gen.fail("内存分配失败")
        }
        if (bc().dep_n > 0) {
            memcpy(nb, bc().dep_bindlen, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_bindlen)
        bc().dep_bindlen = nb
        let nc *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nc == 0) {
            return gen.fail("内存分配失败")
        }
        if (bc().dep_n > 0) {
            memcpy(nc, bc().dep_ifoff, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_ifoff)
        bc().dep_ifoff = nc
        let nct *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nct == 0) { return gen.fail("内存分配失败") }
        if (bc().dep_n > 0) {
            memcpy(nct, bc().dep_ctoff, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_ctoff)
        bc().dep_ctoff = nct
        let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndm == 0) {
            return gen.fail("内存分配失败")
        }
        if (bc().dep_n > 0) {
            memcpy(ndm, bc().dep_mod, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_mod)
        bc().dep_mod = ndm
        let ndi *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndi == 0) {
            return gen.fail("内存分配失败")
        }
        if (bc().dep_n > 0) {
            memcpy(ndi, bc().dep_mi, (bc().dep_n * sizeof(int)).to_type(u64))
        }
        free(bc().dep_mi)
        bc().dep_mi = ndi
        bc().dep_cap = ncap
    }
    bc().dep_bind[bc().dep_n] = bind_off
    bc().dep_bindlen[bc().dep_n] = bind_len
    bc().dep_mod[bc().dep_n] = target
    bc().dep_mi[bc().dep_n] = -1
    bc().dep_ifoff[bc().dep_n] = -1
    bc().dep_ctoff[bc().dep_n] = -1
    bc().dep_n += 1
    return 1
}

// mb_dep_order_rank：模块在本轮拓扑序 proj.ctx().order 中的位置；不在则 -1。
fn mb_dep_order_rank(m int) int {
    let i int = 0
    for i < proj.ctx().order_n {
        if (proj.ctx().order[i] == m) {
            return i
        }
        i += 1
    }
    return -1
}

// mb_module_iface_deps：收集模块 M 依赖的全部接口（接口路径 =
// <build>/iface/<tag>.s.i），分四步：
//   1. 直接导入（绑定名 = 源码导入别名）；
//   2. 传递闭包——导出结构体的字段可引用外模块类型的 mangle 名，读接口
//      正文前必须先登记被依赖方接口，因此依赖的依赖也要加载；导入环已在
//      解析期拒绝，此处按不动点扩充终止。传递依赖没有源码别名，绑定名
//      取目标模块的 mangle 后缀（全局唯一，不与显式导入冲突）；
//   3. 按本轮拓扑序排序——mangle 类型名要求提供方接口先于引用方登记；
//   4. 统一构造接口路径（本轮会话接口优先于持久缓存）。
fn mb_module_iface_deps(m int, build_off int, build_len int) int {
    let c_off int = 0
    let c_len int = 0
    bc().dep_n = 0
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        let f int = proj.ctx().mods[m].files[fi]
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] != f || proj.ctx().imp_mod[ii] < 0) {
                ii += 1
                continue
            }
            if (mb_dep_push(proj.ctx().imp_mod[ii], proj.ctx().imp_off[ii],
                    proj.ctx().imp_len[ii]) < 0) {
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    let changed int = 1
    for changed != 0 {
        changed = 0
        let ei int = 0
        for ei < bc().dep_n {
            let em int = bc().dep_mod[ei]
            let efi int = 0
            for efi < proj.ctx().mods[em].file_n {
                let ef int = proj.ctx().mods[em].files[efi]
                let eii int = 0
                for eii < proj.ctx().imp_n {
                    if (proj.ctx().imp_file[eii] != ef || proj.ctx().imp_mod[eii] < 0) {
                        eii += 1
                        continue
                    }
                    let so int = -1
                    let sl int = 0
                    if (pj_mod_suffix(proj.ctx().mods[proj.ctx().imp_mod[eii]].proj,
                            proj.ctx().imp_mod[eii], &so, &sl) != 0) {
                        return -1
                    }
                    let pr int = mb_dep_push(proj.ctx().imp_mod[eii], so, sl)
                    if (pr < 0) {
                        return -1
                    }
                    if (pr == 1) {
                        changed = 1
                    }
                    eii += 1
                }
                efi += 1
            }
            ei += 1
        }
    }
    let si int = 0
    for si < bc().dep_n {
        let best int = si
        let bv int = mb_dep_order_rank(bc().dep_mod[si])
        if (bv < 0) {
            return gen.fail("内部错误：依赖模块不在拓扑序中")
        }
        let sj int = si + 1
        for sj < bc().dep_n {
            let rv int = mb_dep_order_rank(bc().dep_mod[sj])
            if (rv < 0) {
                return gen.fail("内部错误：依赖模块不在拓扑序中")
            }
            if (rv < bv) {
                best = sj
                bv = rv
            }
            sj += 1
        }
        if (best != si) {
            let t1 int = bc().dep_bind[si]
            bc().dep_bind[si] = bc().dep_bind[best]
            bc().dep_bind[best] = t1
            let t2 int = bc().dep_bindlen[si]
            bc().dep_bindlen[si] = bc().dep_bindlen[best]
            bc().dep_bindlen[best] = t2
            let t3 int = bc().dep_ifoff[si]
            bc().dep_ifoff[si] = bc().dep_ifoff[best]
            bc().dep_ifoff[best] = t3
            let tct int = bc().dep_ctoff[si]
            bc().dep_ctoff[si] = bc().dep_ctoff[best]
            bc().dep_ctoff[best] = tct
            let t4 int = bc().dep_mod[si]
            bc().dep_mod[si] = bc().dep_mod[best]
            bc().dep_mod[best] = t4
            let t5 int = bc().dep_mi[si]
            bc().dep_mi[si] = bc().dep_mi[best]
            bc().dep_mi[best] = t5
        }
        si += 1
    }
    let di int = 0
    for di < bc().dep_n {
        if (proj.mod_tag(bc().dep_mod[di], &c_off, &c_len) != 0) {
            return -1
        }
        let pbuf [760]u8
        let pn int = 0
        pn = gen.append_str(pbuf, pn, proj.pool_str(build_off))
        pn = gen.append_str(pbuf, pn, "/iface/")
        pn = gen.append_str(pbuf, pn, proj.pool_str(c_off))
        pn = gen.append_str(pbuf, pn, ".s.i")
        pbuf[pn] = 0
        let chosen *char = gen.arr_cstr(pbuf)
        let iface_session int = 0
        if (bc().iface_suffix != 0) {
            let session [760]u8
            let sn int = 0
            sn = gen.append_str(session, sn, gen.arr_cstr(pbuf))
            sn = gen.append_str(session, sn, bc().iface_suffix)
            session[sn] = 0
            let ready [760]u8
            let rn int = gen.append_str(&ready[0], 0, gen.arr_cstr(pbuf))
            rn = gen.append_str(&ready[0], rn, ".ready")
            rn = gen.append_str(&ready[0], rn, bc().iface_suffix)
            ready[rn] = 0
            if (proj.file_exists(gen.arr_cstr(&ready[0])) != 0
                && proj.file_exists(gen.arr_cstr(session)) != 0) {
                iface_session = 1
                pn = sn
                let k int = 0
                for k <= sn {
                    pbuf[k] = session[k]
                    k += 1
                }
            }
        }
        let po int = gen.tml_intern_str(chosen.to_type(*u8), 0, pn)
        if (po < 0) {
            return -1
        }
        bc().dep_ifoff[di] = po
        let ctpath [1000]u8
        if (proj.module_ctiface_plain_path(bc().dep_mod[di], build_off,
                build_len, ctpath) != 0) { return -1 }
        let ctn int = strlen(gen.arr_cstr(ctpath)).to_type(int)
        if (bc().iface_suffix != 0 && iface_session != 0) {
            let session_ct [1000]u8
            let csn int = gen.append_str(session_ct, 0,
                gen.arr_cstr(ctpath))
            csn = gen.append_str(session_ct, csn, bc().iface_suffix)
            session_ct[csn] = 0
            ctn = csn
            let k2 int = 0
            for k2 <= csn {
                ctpath[k2] = session_ct[k2]
                k2 += 1
            }
        }
        let cto int = gen.tml_intern_str(ctpath, 0, ctn)
        if (cto < 0) { return -1 }
        bc().dep_ctoff[di] = cto
        di += 1
    }
    return bc().dep_n
}


// mb_compile_start：检查模块缓存；命中返回 1，否则启动 worker 并返回 0。
// root_off/len：项目根（调用方捕获的池偏移；函数内部 canon 会改写全局
// 游标，故由调用方先取好）。
fn mb_compile_start(m int, root_off int, root_len int, build_off int,
    build_len int, pid_out *int, key_out *u8) int {
    let c_off int = 0
    let c_len int = 0
    let tk *gen.TaskCtx = gen.task()
    let sfx_off int = -1
    let sfx_len int = 0
    if (pj_mod_suffix(proj.ctx().mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1
    }
    let is_entry int = proj.ctx().mods[m].is_entry
    // 产物目录 = .build/asm/<tag>/（tag 含项目，防同名冲突；RS3b 起每模块
    // 一个目录，内含每文件 .s 与 <tag>.stub.s 运行时桩对象）
    if (proj.mod_tag(m, &c_off, &c_len) != 0) {
        return -1
    }
    let tag_off int = c_off
    if (proj.canon(build_off, build_len, "asm", &c_off, &c_len) != 0) {
        return -1
    }
    let asmdir [900]u8
    let an int = 0
    an = gen.append_str(asmdir, an, proj.pool_str(c_off))
    an = gen.append_byte(asmdir, an, '/')
    an = gen.append_str(asmdir, an, proj.pool_str(tag_off))
    asmdir[an] = 0
    let cache_artifact [1000]u8
    let artifact_path *char = 0
    let ignored_text [700]u8
    if (mb_llvm_module_paths(m, root_off, root_len, &cache_artifact[0],
            &ignored_text[0]) != 0) { return -1 }
    artifact_path = gen.arr_cstr(&cache_artifact[0])
    if (proj.canon(build_off, build_len, "iface", &c_off, &c_len) != 0) {
        return -1
    }
    let ipath [600]u8
    let in2 int = 0
    in2 = gen.append_str(ipath, in2, proj.pool_str(c_off))
    in2 = gen.append_byte(ipath, in2, '/')
    in2 = gen.append_str(ipath, in2, proj.pool_str(tag_off))
    in2 = gen.append_str(ipath, in2, ".s.i")
    ipath[in2] = 0
    let ctpath [600]u8
    let ctn int = 0
    ctn = gen.append_str(ctpath, ctn, proj.pool_str(c_off))
    ctn = gen.append_byte(ctpath, ctn, '/')
    ctn = gen.append_str(ctpath, ctn, proj.pool_str(tag_off))
    ctn = gen.append_str(ctpath, ctn, ".s.ct")
    ctpath[ctn] = 0
    let session_ipath [700]u8
    if (proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, session_ipath) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(session_ipath))
    let session_ctpath [700]u8
    if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            session_ctpath) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(session_ctpath))
    let session_ready [700]u8
    if (mb_module_ready_path(m, build_off, build_len, &session_ready[0]) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(&session_ready[0]))
    if (proj.canon(build_off, build_len, "manifest", &c_off, &c_len) != 0) {
        return -1
    }
    let mpath [600]u8
    let mn int = 0
    mn = gen.append_str(mpath, mn, proj.pool_str(c_off))
    mn = gen.append_byte(mpath, mn, '/')
    mn = gen.append_str(mpath, mn, proj.pool_str(tag_off))
    mn = gen.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    // check 不读取或更新正式构建 manifest 与缓存。yh test 用独立的构建目录
    // （tmp/yh-test）与扩展键（见下方 c_test_key），既不复用生产对象，也能在
    // 选中测试集合不变时增量复用测试对象。
    if (tk.c_check_only != 0) {
        if (mb_spawn_indexed_module(m, root_off, root_len,
                gen.arr_cstr(asmdir), 0, pid_out) != 0) {
            return gen.fail("无法启动项目检查/测试 worker")
        }
        gen.stats().workers += 1
        return 0
    }
    // —— manifest 哈希（U5）——
    let h u64 = proj.hash_init()
    let hi int = 0
    for hi < sfx_len {
        proj.fnv(&h, tk.np_data[sfx_off + hi])
        hi += 1
    }
    proj.fnv(&h, ('0' + is_entry).to_type(u8))
    proj.fnv(&h, '\n')
    proj.fnv(&h, ('0' + tk.c_legacy_system).to_type(u8))
    proj.fnv(&h, '\n')
    // yh test：测试对象还取决于「本轮选中了哪些测试」，把选择摘要与协议版本
    // 并入键。生产构建不混入，且两种构建目录本身互不相通。
    if (tk.c_test_mode != 0) {
        proj.fnv(&h, 'T')
        proj.fnv(&h, 'S')
        let key_tag *char = "yh-test-key-1"
        let kti int = 0
        for key_tag[kti] != 0 {
            proj.fnv(&h, key_tag[kti].to_type(u8))
            kti += 1
        }
        let key_bits u64 = proj.ctx().test_key
        let kbi int = 0
        for kbi < 8 {
            proj.fnv(&h, ((key_bits >> (kbi * 8)) & 255).to_type(u8))
            kbi += 1
        }
    }
    let triple_i int = 0
        for proj.cfg().target.triple[triple_i] != 0 {
            proj.fnv(&h, proj.cfg().target.triple[triple_i].to_type(u8))
            triple_i += 1
        }
        proj.fnv(&h, 0)
        triple_i = 0
        for proj.cfg().target.data_layout[triple_i] != 0 {
            proj.fnv(&h, proj.cfg().target.data_layout[triple_i].to_type(u8))
            triple_i += 1
        }
        proj.fnv(&h, 0)
        triple_i = 0
        for proj.cfg().target.abi[triple_i] != 0 {
            proj.fnv(&h, proj.cfg().target.abi[triple_i].to_type(u8))
            triple_i += 1
        }
        proj.fnv(&h, ('0' + proj.cfg().opt_level).to_type(u8))
        let bridge_version *char = backend.llvm_bridge_version()
        triple_i = 0
        for bridge_version[triple_i] != 0 {
            proj.fnv(&h, bridge_version[triple_i].to_type(u8))
            triple_i += 1
        }
        let bridge_abi *char = "yh-llvm-bridge-abi1"
        triple_i = 0
        for bridge_abi[triple_i] != 0 {
            proj.fnv(&h, bridge_abi[triple_i].to_type(u8))
            triple_i += 1
        }
        if (proj.cfg().target.os == gen.TARGET_OS_DARWIN) {
            let min_os *char = cmd_darwin_min_os()
            if (min_os == 0) { return -1 }
            proj.fnv(&h, 0)
            triple_i = 0
            for min_os[triple_i] != 0 {
                proj.fnv(&h, min_os[triple_i].to_type(u8))
                triple_i += 1
            }
            proj.fnv(&h, 0)
            // Darwin 对象由桥按目标强制 PIC（见 llvm/bridge.c）；把重定位模式
            // 显式写入对象键，避免将来引入非 PIC 变体时旧对象误命中。
            proj.fnv(&h, 'P')
            proj.fnv(&h, 'I')
            proj.fnv(&h, 'C')
        }
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        if (proj.hash_file(&h, proj.pool_str(proj.ctx().files[proj.ctx().mods[m].files[fi]].path_off)) != 0) {
            return -1
        }
        fi += 1
    }
    // 依赖接口内容（解析结果变化 → 接口路径变化 → 哈希变化）
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1
    }
    let di int = 0
    for di < bc().dep_n {
        if (proj.file_exists(proj.pool_str(bc().dep_ifoff[di])) == 0
            || proj.file_exists(proj.pool_str(bc().dep_ctoff[di])) == 0) {
            // 依赖接口缺失：视为需要重编译
            di = bc().dep_n + 1
            break
        }
        if (proj.hash_file(&h, proj.pool_str(bc().dep_ifoff[di])) != 0
            || proj.hash_file(&h, proj.pool_str(bc().dep_ctoff[di])) != 0) {
            return -1
        }        di += 1
    }
    let deps_ok int = 1
    if (di == bc().dep_n + 1) {
        deps_ok = 0
    }
    // 编译器身份：对自身二进制 FNV（滚动代次下热缓存必需）
    if (mb_mix_compiler_fingerprint(&h) != 0) {
        return -1
    }
    // 版本标记
    let tag *char = "yh-iface-cache-3-ct"
    let ti int = 0
    for tag[ti] != 0 {
        proj.fnv(&h, tag[ti].to_type(u8))
        ti += 1
    }
    // 期望 manifest（十六进制串）
    let want [16]u8
    let wn int = 0
    let digits *char = "0123456789abcdef"
    let shift int = 60
    for shift >= 0 {
        want[wn] = digits[((h >> shift) & 15).to_type(int)].to_type(u8)
        wn += 1
        shift -= 4
    }
    // 缓存命中：三个产物齐全且 manifest 字节一致
    if (deps_ok != 0 && proj.file_exists(artifact_path) != 0
        && proj.file_exists(gen.arr_cstr(ipath)) != 0
        && proj.file_exists(gen.arr_cstr(ctpath)) != 0
        && proj.file_exists(gen.arr_cstr(mpath)) != 0) {
        // manifest 无显式版本（A1c 决策）：64 字节 = 模块键 16 + 对象摘要 16 +
        // 每文件接口摘要 16×N。键本身含编译器二进制指纹与全部输入内容，
        // 所以任何格式变更（必然换编译器）都会让旧 manifest 键不匹配；
        // 长度检查挡住布局变更。**改布局时必须同时改长度或键组成**。
        // manifest 无显式版本（A1c 决策）：64 字节 = 模块键 16 + 对象摘要 16 +
        // 每文件接口摘要 16×N。键本身含编译器二进制指纹与全部输入内容，
        // 所以任何格式变更（必然换编译器）都会让旧 manifest 键不匹配；
        // 长度检查挡住布局变更。**改布局时必须同时改长度或键组成**。
        let manifest_len int = 64
        if (gen.read_source(gen.arr_cstr(mpath)) == 0
            && tk.c_src_len == manifest_len) {
            let saved_manifest [64]u8
            let si int = 0
            for si < manifest_len { saved_manifest[si] = tk.c_src[si]; si += 1 }
            let same int = 1
            let ci int = 0
            for ci < wn {
                if (saved_manifest[ci] != want[ci]) {
                    same = 0
                    break
                }
                ci += 1
            }
            if (same != 0) {
                let object_hash u64 = proj.hash_init()
                let object_digest [16]u8
                if (proj.hash_file(&object_hash, artifact_path) != 0
                    || mb_object_machine_matches(artifact_path) == 0) {
                    same = 0
                } else {
                    proj.hash_hex(object_hash, object_digest)
                    ci = 0
                    for ci < 16 {
                        if (saved_manifest[16 + ci] != object_digest[ci]) {
                            same = 0
                            break
                        }
                        ci += 1
                    }
                }
                let iface_paths [2]*char
                iface_paths[0] = gen.arr_cstr(ipath)
                iface_paths[1] = gen.arr_cstr(ctpath)
                let fi2 int = 0
                for fi2 < 2 && same != 0 {
                    let iface_hash u64 = proj.hash_init()
                    let iface_digest [16]u8
                    if (proj.hash_file(&iface_hash, iface_paths[fi2]) != 0) {
                        same = 0
                    } else {
                        proj.hash_hex(iface_hash, iface_digest)
                        ci = 0
                        for ci < 16 {
                            if (saved_manifest[32 + fi2 * 16 + ci]
                                != iface_digest[ci]) {
                                same = 0
                                break
                            }
                            ci += 1
                        }
                    }
                    fi2 += 1
                }
            }
            if (same != 0) {
                pj_out_s("  [缓存] ")
                pj_out_np(proj.ctx().mods[m].name_off, proj.ctx().mods[m].name_len)
                pj_out_s("\n")
                return 1
            }
        }
    }
    // 缓存键随 worker 状态保存，只有完整编译成功后父进程才提交 manifest。
    let ki int = 0
    for ki < wn {
        key_out[ki] = want[ki]
        ki += 1
    }
    // —— 子进程编译（提供方项目根 + 主项目根） ——
    if (mb_spawn_indexed_module(m, root_off, root_len, gen.arr_cstr(asmdir),
            bc().compiler_fingerprint, pid_out) != 0) {
        return gen.fail("无法启动模块编译 worker")
    }
    gen.stats().workers += 1
    return 0
}

// mb_manifest_commit：worker 完整成功后原子提交模块缓存键。
fn mb_manifest_commit(m int, build_off int, build_len int, key *u8) int {
    let c_off int = 0
    let c_len int = 0
    if (proj.mod_tag(m, &c_off, &c_len) != 0) {
        return -1
    }
    let tag_off int = c_off
    if (proj.canon(build_off, build_len, "manifest", &c_off, &c_len) != 0) {
        return -1
    }
    let mpath [600]u8
    let mn int = 0
    mn = gen.append_str(mpath, mn, proj.pool_str(c_off))
    mn = gen.append_byte(mpath, mn, '/')
    mn = gen.append_str(mpath, mn, proj.pool_str(tag_off))
    mn = gen.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    let tmp [700]u8
    let tn int = 0
    tn = gen.append_str(tmp, tn, gen.arr_cstr(mpath))
    tn = gen.append_str(tmp, tn, ".tmp.")
    tn = gen.append_int(tmp, tn, getpid())
    tmp[tn] = 0
    let fd int = proj.open_out(gen.arr_cstr(tmp))
    if (fd < 0) {
        return gen.fail_path("无法写 manifest: ", gen.arr_cstr(mpath))
    }
    let manifest_data [64]u8
    let manifest_len int = 16
    let ki int = 0
    for ki < 16 { manifest_data[ki] = key[ki]; ki += 1 }
    let object [700]u8
        let on int = gen.append_str(&object[0], 0, proj.pool_str(build_off))
        on = gen.append_str(&object[0], on, "/obj/")
        on = gen.append_str(&object[0], on, proj.pool_str(tag_off))
        on = gen.append_str(&object[0], on, ".o")
        object[on] = 0
        if (mb_object_machine_matches(gen.arr_cstr(&object[0])) == 0) {
            close(fd)
            unlink(gen.arr_cstr(tmp))
            return gen.fail("LLVM 对象缺失或目标架构错误，拒绝提交缓存")
        }
        let object_hash u64 = proj.hash_init()
        if (proj.hash_file(&object_hash, gen.arr_cstr(&object[0])) != 0) {
            close(fd)
            unlink(gen.arr_cstr(tmp))
            return -1
        }
        proj.hash_hex(object_hash, &manifest_data[16])
        let iface_path [2][700]u8
        let suffix *char = ".s.i"
        let fi2 int = 0
        for fi2 < 2 {
            if (fi2 == 1) { suffix = ".s.ct" }
            let in2 int = gen.append_str(&iface_path[fi2][0], 0,
                proj.pool_str(build_off))
            in2 = gen.append_str(&iface_path[fi2][0], in2, "/iface/")
            in2 = gen.append_str(&iface_path[fi2][0], in2,
                proj.pool_str(tag_off))
            in2 = gen.append_str(&iface_path[fi2][0], in2, suffix)
            iface_path[fi2][in2] = 0
            let iface_hash u64 = proj.hash_init()
            if (proj.file_exists(gen.arr_cstr(&iface_path[fi2][0])) == 0
                || proj.hash_file(&iface_hash,
                    gen.arr_cstr(&iface_path[fi2][0])) != 0) {
                close(fd)
                unlink(gen.arr_cstr(tmp))
                return gen.fail("LLVM 模块接口缺失，拒绝提交缓存")
            }
            proj.hash_hex(iface_hash, &manifest_data[32 + fi2 * 16])
            fi2 += 1
        }
        manifest_len = 64
    let rc int = gen.write_all(fd, &manifest_data[0], manifest_len)
    close(fd)
    if (rc != 0 || rename(gen.arr_cstr(tmp), gen.arr_cstr(mpath)) != 0) {
        unlink(gen.arr_cstr(tmp))
        return gen.fail_path("无法提交 manifest: ", gen.arr_cstr(mpath))
    }
    return 0
}





// mb_module_ready_path：本轮接口就绪标记 <tag>.s.i.ready[suffix]。
// worker 先写 .s.ct、再写 .s.i、最后写 ready；父调度器只认 ready。
fn mb_module_ready_path(m int, build_off int, build_len int, out *u8) int {
    let plain [700]u8
    if (proj.module_iface_plain_path(m, build_off, build_len, plain) != 0) {
        return -1
    }
    let n int = 0
    n = gen.append_str(out, n, gen.arr_cstr(plain))
    n = gen.append_str(out, n, ".ready")
    if (bc().iface_suffix != 0) {
        n = gen.append_str(out, n, bc().iface_suffix)
    }
    out[n] = 0
    return 0
}

// mb_iface_write_ready：原子写就绪标记；内容只用于存在性，不参与身份。
fn mb_iface_write_ready(path *char) int {
    let tmp [800]u8
    let n int = 0
    n = gen.append_str(tmp, n, path)
    n = gen.append_str(tmp, n, ".tmp.")
    n = gen.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(gen.arr_cstr(tmp))
    if (fd < 0) { return -1 }
    let data u8 = 49
    let wr int = gen.write_all(fd, &data, 1)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(gen.arr_cstr(tmp), path) != 0) {
        unlink(gen.arr_cstr(tmp))
        return -1
    }
    return 0
}

// mb_iface_ct_same：比较本轮 session CT 接口与持久 CT 接口内容。
// 返回 1 相同（允许早期启动），0 不同/缺失（等待依赖完成）。
fn mb_iface_ct_same(m int, build_off int, build_len int) int {
    let tk *gen.TaskCtx = gen.task()
    let session [700]u8
    let plain [700]u8
    if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            session) != 0
        || proj.module_ctiface_plain_path(m, build_off, build_len, plain) != 0) {
        return 0
    }
    // 没有 CT 正文（文件缺失/空）时不存在旧 CT 可复用，允许早期启动。
    if (proj.file_exists(gen.arr_cstr(session)) == 0) { return 1 }
    if (gen.read_source(gen.arr_cstr(session)) != 0) { return 0 }
    if (tk.c_src_len == 0) { return 1 }
    // 首次构建没有持久 CT，不存在可复用的旧值；session ready 已是新接口。
    if (proj.file_exists(gen.arr_cstr(plain)) == 0) { return 1 }
    if (gen.read_source(gen.arr_cstr(plain)) != 0) { return 0 }
    if (tk.c_src_len == 0) { return 0 }
    let hs u64 = proj.hash_init()
    let hp u64 = proj.hash_init()
    if (proj.hash_file(&hs, gen.arr_cstr(session)) != 0
        || proj.hash_file(&hp, gen.arr_cstr(plain)) != 0) { return 0 }
    return hs == hp ? 1 : 0
}

// mb_iface_copy_file：完整读取源接口，经同目录暂存后原子发布到目标路径。
fn mb_iface_copy_file(src *char, dst *char) int {
    let tk *gen.TaskCtx = gen.task()
    if (gen.read_source(src) != 0) {
        return -1
    }
    let tmp [800]u8
    let n int = 0
    n = gen.append_str(tmp, n, dst)
    n = gen.append_str(tmp, n, ".tmp.")
    n = gen.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(gen.arr_cstr(tmp))
    if (fd < 0) {
        return -1
    }
    let wr int = gen.write_all(fd, tk.c_src, tk.c_src_len)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(gen.arr_cstr(tmp), dst) != 0) {
        unlink(gen.arr_cstr(tmp))
        return -1
    }
    return 0
}

// —— 子进程：--emit-module M ROOT -o out.s ——

// mb_file_head_bind：解析当前文件头并绑定导入（编译前每文件调用）。
// 先重置文件级导入表——pass 2 会对同一文件再次解析文件头。
fn mb_file_head_bind(fi int) int {
    let tk *gen.TaskCtx = gen.task()
    // 绑定不再按名匹配：cmd 侧持有扫描期的解析结果（p_imp），按声明位置
    // （line/col）对应后把 ModInfo 下标直接写入 mod_import_mod。
    // 支持别名与跨项目 KEY.MOD 导入（解析结果与名字解耦）。
    parse.mod_reset_file()
    if (parse.mod_parse_head() != 0) {
        return -1
    }
    let i int = 0
    for i < tk.mod_import_n {
        let found int = -1
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] == fi
                && proj.ctx().imp_line[ii] == tk.mod_imports[i].line
                && proj.ctx().imp_col[ii] == tk.mod_imports[i].col) {
                found = ii
                break
            }
            ii += 1
        }
        if (found < 0) {
            return gen.err_lc(tk.mod_imports[i].line, tk.mod_imports[i].col,
                "内部错误：导入与扫描记录不对应")
        }
        let imp_proj int = proj.ctx().mods[proj.ctx().files[fi].mod].proj
        if (proj.ctx().imp_test_only[found] != 0
            && (tk.c_test_mode == 0 || imp_proj != proj.ctx().test_project)) {
            // 生产构建/非目标项目不绑定 test 专用导入；标记 used 以免报未使用。
            tk.mod_import_mod[i] = -1
            tk.mod_import_used[i] = 1
            i += 1
            continue
        }
        let target int = proj.ctx().imp_mod[found]
        let mi int = -1
        let di int = 0
        for di < bc().dep_n {
            if (bc().dep_mod[di] == target) {
                mi = bc().dep_base + di
                break
            }
            di += 1
        }
        if (mi < 0) {
            return gen.err_lc(tk.mod_imports[i].line, tk.mod_imports[i].col,
                "内部错误：导入的接口未加载")
        }
        tk.mod_import_mod[i] = mi
        tk.mod_import_used[i] = 0
        // 导入可只在全局初始化器中使用，而模块文件会在全局遍历与
        // 函数遍历之间重新绑定头部；按 token 快照保留整文件的限定引用。
        let ti int = 0
        for ti + 1 < tk.c_tok_n {
            if (tk.c_toks[ti].kind == gen.TOK_IDENT
                && tk.c_toks[ti].len == tk.mod_imports[i].alias_len
                && tk.c_toks[ti + 1].kind == gen.TK_DOT) {
                let same int = 1
                let j int = 0
                for j < tk.mod_imports[i].alias_len {
                    if (tk.c_src[tk.c_toks[ti].start + j]
                        != tk.np_data[tk.mod_imports[i].alias_off + j]) {
                        same = 0
                        break
                    }
                    j += 1
                }
                if (same != 0) {
                    tk.mod_import_used[i] = 1
                    break
                }
            }
            ti += 1
        }
        i += 1
    }
    return 0
}

// mb_pass1_file：pass 1 从只读词法快照登记一个源文件（含头解析与绑定）。
fn mb_pass1_file(path *char, fi int) int {
    if (gen.stats().enabled != 0) {
        gen.stats().pass1 += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    return parse.parse_indexed_decls(0)
}

// mb_restore_front_file：将当前解析器切换到项目索引时保存的只读快照。
pub fn mb_restore_front_file(path *char, fi int) int {
    let tk *gen.TaskCtx = gen.task()
    if (gen.stats().front_cache == 0 || proj.ctx().files[fi].source == 0
        || proj.ctx().files[fi].tokens == 0) {
        return gen.fail("内部错误：模块 worker 缺少前端文件快照")
    }
    tk.c_src = proj.ctx().files[fi].source
    tk.c_src_len = proj.ctx().files[fi].source_len
    tk.c_toks = proj.ctx().files[fi].tokens
    tk.c_tok_n = proj.ctx().files[fi].token_n
    tk.c_tok_cap = proj.ctx().files[fi].token_n
    tk.c_file_decls = proj.ctx().files[fi].decls
    tk.c_file_decl_n = proj.ctx().files[fi].decl_n
    tk.c_file_decl_i = -1
    tk.c_file_indexed = 1
    tk.c_active_file = fi
    tk.c_pos = 0
    if (gen.set_source_path(path) != 0) {
        return -1
    }
    tk.c_spec = 0
    tk.c_ctx_block = 0
    return 0
}

// mb_pass2_file：复用模块文件快照执行全局、CT 捕获/布局常量子遍或函数子遍。
// 1 全局初始化，2 CT 正文捕获，3 布局请求登记，4 布局 const 求值，0 普通函数。
fn mb_pass2_file(path *char, fi int, is_globals int) int {
    let tk *gen.TaskCtx = gen.task()
    if (is_globals == 1 && gen.stats().enabled != 0) {
        gen.stats().globals += 1
    }
    if (is_globals == 0 && gen.stats().enabled != 0) {
        gen.stats().functions += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    if (is_globals != 0) {
        if (is_globals == 2) {
            if (parse.parse_source_ct_fns() != 0) { return -1 }
        } else if (is_globals == 3) {
            if (parse.parse_source_ct_layout_register() != 0) { return -1 }
        } else if (is_globals == 4) {
            if (parse.parse_source_ct_layout_consts() != 0) { return -1 }
        } else if (is_globals == 5) {
            if (parse.parse_source_tests() != 0) { return -1 }
        } else if (parse.parse_source_globals() != 0) {
            return -1
        }
    } else {
        if (parse.parse_source_fns() != 0) {
            return -1
        }
        // 未使用导入检查（U3）：本文件编译完后仍为零使用的导入报错
        let i int = 0
        for i < tk.mod_import_n {
            if (tk.mod_import_used[i] == 0) {
                return gen.err_lc(tk.mod_imports[i].line, tk.mod_imports[i].col,
                    "导入未使用（同文件没有任何限定名引用）")
            }
            i += 1
        }
    }
    return 0
}

// mb_check_binding_clash：导入名与本模块顶层声明重名检查（pass1 后）。
// 遍历模块全部文件的导入，逐个查全局符号表。
fn mb_check_binding_clash(m int) int {
    let tk *gen.TaskCtx = gen.task()
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        let f int = proj.ctx().mods[m].files[fi]
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] != f) {
                ii += 1
                continue
            }
            let imp_proj int = proj.ctx().mods[proj.ctx().files[f].mod].proj
            if (proj.ctx().imp_test_only[ii] != 0
                && (tk.c_test_mode == 0 || imp_proj != proj.ctx().test_project)) {
                ii += 1
                continue
            }
            let idx int = gen.sym_lookup_off(proj.ctx().imp_off[ii], proj.ctx().imp_len[ii])
            if (idx >= 0 && (tk.c_syms[idx].flags & gen.F_GLOBAL) != 0
                && (tk.c_syms[idx].flags & gen.F_EXTERN) == 0) {
                let buf [192]u8
                let n int = 0
                n = gen.append_int_cap(buf, 192, n, tk.c_syms[idx].def_line)
                n = gen.append_byte_cap(buf, 192, n, ':')
                n = gen.append_int_cap(buf, 192, n, tk.c_syms[idx].def_col)
                n = gen.append_str_cap(buf, 192, n, ": 顶层声明与导入名冲突（导入名 ")
                n = gen.append_np_cap(buf, 192, n, proj.ctx().imp_off[ii], proj.ctx().imp_len[ii])
                n = gen.append_str_cap(buf, 192, n, "）")
                let mo int = gen.tml_intern_str(buf, 0, n)
                if (mo < 0) {
                    return -1
                }
                tk.c_errors += 1
                let out [256]u8
                let on int = 0
                on = gen.append_str(out, on, proj.pool_str(proj.ctx().files[f].path_off))
                on = gen.append_byte(out, on, ':')
                on = append_bytes_np(out, on, mo, n)
                on = gen.append_byte(out, on, '\n')
                gen.write_all(2, out, on)
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    return 0
}

// mb_emit_module：子进程入口——编译一个模块为按文件汇编 + 接口；check-only
// 复用语义遍历并只写本轮依赖需要的临时接口。
// prov_root：模块提供方项目根（在其中查找模块）；main_root：主项目根
// （构建目录基准，接口路径与父进程一致）；out_dir：按文件汇编目录
// <build>/asm/<tag>（RS3b）。
pub fn mb_emit_module(mod_off int, mod_len int, prov_off int, prov_len int,
    main_off int, main_len int, out_dir *char, ir_cache_salt u64) int {
    let tk *gen.TaskCtx = gen.task()
    gen.stats().front_cache = 1
    tk.c_ast_capture = 0
    gen.stats().ir_cache_salt = ir_cache_salt
    if (mb_load_stdlib() != 0) {
        return -1
    }
    let pj int = pj_load_project(prov_off, prov_len)
    if (pj < 0) {
        return -1
    }
    if (pj_bind_imports() != 0) {
        return -1
    }
    let m int = proj.module_in_project(pj, mod_off, mod_len)
    if (m < 0) {
        return gen.fail("内部错误：模块不在索引中")
    }
    return mb_emit_indexed_module(m, main_off, main_len, out_dir, ir_cache_salt)
}

// —— 父进程：build / run ——

// mb_print_stats：开发验收时输出当前进程的阶段计数；默认构建保持静默。
pub fn mb_print_stats() void {
    let tk *gen.TaskCtx = gen.task()
    if (gen.stats().enabled == 0) {
        return
    }
    let buf [1024]u8
    let n int = 0
    n = gen.append_str(buf, n, "yh-stats lex=")
    n = gen.append_int(buf, n, gen.stats().lex)
    n = gen.append_str(buf, n, " syntax=")
    n = gen.append_int(buf, n, gen.stats().syntax)
    n = gen.append_str(buf, n, " index=")
    n = gen.append_int(buf, n, gen.stats().index)
    n = gen.append_str(buf, n, " pass1=")
    n = gen.append_int(buf, n, gen.stats().pass1)
    n = gen.append_str(buf, n, " globals=")
    n = gen.append_int(buf, n, gen.stats().globals)
    n = gen.append_str(buf, n, " functions=")
    n = gen.append_int(buf, n, gen.stats().functions)
    n = gen.append_str(buf, n, " ir_functions=")
    n = gen.append_int(buf, n, gen.stats().ir_functions)
    n = gen.append_str(buf, n, " ir_cache_hits=")
    n = gen.append_int(buf, n, gen.stats().ir_cache_hits)
    n = gen.append_str(buf, n, " ir_cache_misses=")
    n = gen.append_int(buf, n, gen.stats().ir_cache_misses)
    n = gen.append_str(buf, n, " ir_lowered=")
    n = gen.append_int(buf, n, gen.stats().ir_lowered)
    n = gen.append_str(buf, n, " ast_nodes=")
    n = gen.append_int(buf, n, tk.c_stats_ast_nodes)
    n = gen.append_str(buf, n, " stmt_nodes=")
    n = gen.append_int(buf, n, tk.c_stats_stmt_nodes)
    n = gen.append_str(buf, n, " decl_nodes=")
    n = gen.append_int(buf, n, tk.c_stats_decl_nodes)
    n = gen.append_str(buf, n, " ast_refs=")
    n = gen.append_int(buf, n, tk.c_stats_ast_refs)
    n = gen.append_str(buf, n, " ast_bindings=")
    n = gen.append_int(buf, n, tk.c_stats_ast_bindings)
    n = gen.append_str(buf, n, " ast_functions=")
    n = gen.append_int(buf, n, tk.c_stats_ast_functions)
    n = gen.append_str(buf, n, " workers=")
    n = gen.append_int(buf, n, gen.stats().workers)
    n = gen.append_str(buf, n, " workers_peak=")
    n = gen.append_int(buf, n, bc().sched_peak)
    n = gen.append_str(buf, n, " iface_early=")
    n = gen.append_int(buf, n, bc().sched_iface_early)
    n = gen.append_str(buf, n, " asm=")
    n = gen.append_int(buf, n, gen.stats().asm)
    n = gen.append_str(buf, n, " link=")
    n = gen.append_int(buf, n, gen.stats().link)
    n = gen.append_str(buf, n, " compiler_hashes=")
    n = gen.append_int(buf, n, gen.stats().compiler_hashes)
    n = gen.append_str(buf, n, " time_project_ns=")
    n = gen.append_i64(buf, n, bc().project_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_schedule_ns=")
    n = gen.append_i64(buf, n, bc().schedule_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_object_ns=")
    n = gen.append_i64(buf, n, bc().object_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_link_ns=")
    n = gen.append_i64(buf, n, bc().link_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_total_ns=")
    let total_ns u64 = 0
    if (bc().build_start_ns != 0) {
        let now u64 = cmd_clock_ns()
        if (now >= bc().build_start_ns) {
            total_ns = now - bc().build_start_ns
        }
    }
    n = gen.append_i64(buf, n, total_ns.to_type(i64))
    // 新覆盖字段追加在原统计行尾，保留已有性能工具的字段顺序和含义。
    n = gen.append_str(buf, n, " checked_functions=")
    n = gen.append_int(buf, n, gen.stats().checked_functions)
    n = gen.append_str(buf, n, " backend_emitted_functions=")
    n = gen.append_int(buf, n, gen.stats().backend_emitted)
    n = gen.append_str(buf, n, " rejected_functions=")
    n = gen.append_int(buf, n, gen.stats().ir_rejected)
    n = gen.append_str(buf, n, " backend_rejected_functions=")
    n = gen.append_int(buf, n, gen.stats().backend_rejected)
    n = gen.append_str(buf, n, " fallback_functions=")
    n = gen.append_int(buf, n, gen.stats().ir_rejected + gen.stats().backend_rejected)
    n = gen.append_str(buf, n, " check_cache_hits=")
    n = gen.append_int(buf, n, gen.stats().check_cache_hits)
    n = gen.append_str(buf, n, " check_cache_misses=")
    n = gen.append_int(buf, n, gen.stats().check_cache_misses)
    n = gen.append_str(buf, n, " check_skipped=")
    n = gen.append_int(buf, n, gen.stats().check_cache_skipped)
    n = gen.append_byte(buf, n, '\n')
    gen.write_all(2, buf, n)
}

// mb_intern_arg：命令行参数字符串入名字池，返回偏移（长度出参）。
pub fn mb_intern_arg(s *char, olen *int) int {
    let sl int = 0
    for s[sl] != 0 {
        sl += 1
    }
    olen[0] = sl
    return gen.tml_intern_str(s.to_type(*u8), 0, sl)
}

// mb_try_default_stdlib：尝试 dir+suffix 下的标准库项目。
// 返回 1 表示已装载，0 表示该候选不存在，-1 表示候选存在但装载失败。
// 只接受带 project.toml 的目录；不猜测库名，也不把任意模块目录当标准库。
fn mb_try_default_stdlib(dir *char, suffix *char) int {
    let c_off int = 0
    let c_len int = 0
    let tk *gen.TaskCtx = gen.task()
    let path [1200]u8
    let n int = 0
    n = gen.append_str(path, n, dir)
    n = gen.append_str(path, n, suffix)
    path[n] = 0
    if (proj.canon(0, 0, gen.arr_cstr(path), &c_off, &c_len) != 0) {
        return 0
    }
    let cand_off int = c_off
    let cand_len int = c_len
    let manifest [1200]u8
    let mn int = 0
    let i int = 0
    for i < cand_len {
        manifest[mn] = tk.np_data[cand_off + i]
        mn += 1
        i += 1
    }
    mn = gen.append_str(manifest, mn, "/project.toml")
    manifest[mn] = 0
    if (proj.file_exists(gen.arr_cstr(manifest)) == 0) {
        return 0
    }
    let loaded int = pj_load_project(cand_off, cand_len)
    if (loaded < 0) {
        return -1
    }
    proj.ctx().stdlib = loaded
    return 1
}

// mb_load_default_stdlib：按可执行文件附近布局查找标准库。
// 依次尝试 <exe_dir>/libs（仓库构建）、<exe_dir>/../libs（bin 下种子）
// 与 <exe_dir>/../share/yh/libs（安装布局）。找不到时保持无标准库层；
// 找到但项目损坏时返回 -1，不静默回退到其它候选。
fn mb_load_default_stdlib() int {
    if (mb_resolve_self_path() != 0) {
        return 0
    }
    let self_len int = strlen(bc().self_path).to_type(int)
    let cut int = self_len
    for cut > 0 && bc().self_path[cut - 1] != '/' {
        cut -= 1
    }
    let dir [1200]u8
    let dn int = 0
    if (cut > 1) {
        let i int = 0
        for i < cut - 1 {
            dir[dn] = bc().self_path[i].to_type(u8)
            dn += 1
            i += 1
        }
    } else if (cut == 1) {
        dir[0] = '/'
        dn = 1
    } else {
        dir[0] = '.'
        dn = 1
    }
    dir[dn] = 0
    let found int = mb_try_default_stdlib(gen.arr_cstr(dir), "/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(gen.arr_cstr(dir), "/../libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(gen.arr_cstr(dir), "/../share/yh/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    proj.ctx().stdlib = -1
    return 0
}

// mb_load_stdlib：装载 YH_STDLIB 指定的标准库项目。
// YH_STDLIB 非空时优先且失败不回退；为空/未设置时按可执行文件附近布局
// 查找默认标准库（仓库 <root>/libs、bin 种子相邻 libs 或安装 share/yh/libs）。
pub fn mb_load_stdlib() int {
    let c_off int = 0
    let c_len int = 0
    if (proj.ctx().stdlib >= 0) {
        return 0
    }
    let off int = -1
    let olen int = 0
    if (proj.env_fetch("YH_STDLIB", &off, &olen) < 0) {
        return -1
    }
    if (olen == 0) {
        return mb_load_default_stdlib()
    }
    if (proj.canon(0, 0, proj.pool_str(off), &c_off, &c_len) != 0) {
        return -1
    }
    let s int = pj_load_project(c_off, c_len)
    if (s < 0) {
        return -1
    }
    proj.ctx().stdlib = s
    return 0
}

// pj_topo_multi：库模式——从项目每个模块出发收集依赖序。
pub fn pj_topo_multi(pj int) int {
    if (pj_topo(proj.ctx().projs[pj].mods[0]) < 0) {
        return -1
    }
    let i int = 1
    for i < proj.ctx().projs[pj].mod_n {
        if (proj.ctx().mark[proj.ctx().projs[pj].mods[i]] != 2) {
            if (pj_dfs(proj.ctx().projs[pj].mods[i]) != 0) {
                return -1
            }
        }
        i += 1
    }
    return proj.ctx().order_n
}

// mb_cmd_build：构建项目；可选 --stats 输出当前构建与模块 worker 计数。
// argc/argv 已剥离程序名；由 build/check 命令共用。
pub fn mb_cmd_build(av **char, an int) int {
    let tk *gen.TaskCtx = gen.task()
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    let out_arg *char = 0
    let mod_arg_off int = -1
    let mod_arg_len int = 0
    let mod_arg_n int = 0
    li_select_reset()
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--stats") != 0) {
            gen.stats().enabled = 1
            i += 1
            continue
        }
        if (gen.cstr_eq(av[i], "--link") != 0) {
            if (i + 1 >= an || av[i + 1][0] == 0) {
                gen.fail("--link 需要一个组名")
                return 2
            }
            let link_arg *char = av[i + 1]
            let ll int = 0
            for link_arg[ll] != 0 { ll += 1 }
            let lo int = gen.tml_intern_str(link_arg.to_type(*u8), 0, ll)
            if (lo < 0) { return -1 }
            if (pl_group_name_ok(lo, ll) == 0) {
                gen.fail("--link 组名只能包含字母、数字、_、-")
                return 2
            }
            if (li_select_add(lo, ll) != 0) { return -1 }
            i += 2
            continue
        }
        if (gen.cstr_eq(av[i], "-o") != 0) {
            if (i + 1 >= an) {
                gen.fail("-o 需要一个输出路径")
                return 2
            }
            out_arg = av[i + 1]
            i += 2
            continue
        }
        if (av[i][0] == '-') {
            gen.fail_path("未知的项目构建选项: ", av[i])
            return 2
        }
        // 模块参数：只允许一个，避免最后一个静默覆盖。
        let sl int = 0
        for av[i][sl] != 0 { sl += 1 }
        let mo int = gen.tml_intern_str(av[i].to_type(*u8), 0, sl)
        if (mo < 0) { return -1 }
        if (mod_arg_n > 0) {
            gen.fail("yh build 只能指定一个模块")
            return 2
        }
        mod_arg_off = mo
        mod_arg_len = sl
        mod_arg_n += 1
        i += 1
    }
    if (tk.c_check_only != 0 && li_select_count() > 0) {
        gen.fail("yh check 不支持 --link")
        return 2
    }
    bc().build_start_ns = 0
    bc().project_ns = 0
    bc().schedule_ns = 0
    bc().object_ns = 0
    bc().link_ns = 0
    if (gen.stats().enabled != 0) {
        bc().build_start_ns = cmd_clock_ns()
    }
    tk.c_path = "yh"
    // 父进程建立可继承的只读前端快照，fork worker 不再重扫项目源码。
    gen.stats().front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    // 根路径长度由 pj_find_root 出参返回（不再依赖全局游标）。
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    // 构建根：显式模块参数 > 名为 main 的入口模块 > 库模式
    let rootmod int = -1
    if (mod_arg_off >= 0) {
        rootmod = proj.module_in_project(pj, mod_arg_off, mod_arg_len)
        if (rootmod < 0) {
            let buf [128]u8
            let n int = 0
            n = gen.append_str(buf, n, "本项目没有模块: ")
            n = append_bytes_np(buf, n, mod_arg_off, mod_arg_len)
            let mo4 int = gen.tml_intern_str(buf, 0, n)
            if (mo4 < 0) {
                return -1
            }
            return gen.fail(gen.np_cstr(mo4))
        }
    } else {
        rootmod = pj_entry_mod(pj)
    }
    if (rootmod < 0 && li_select_count() > 0) {
        gen.fail("库项目没有可链接产物，--link 不适用")
        return 2
    }
    // topo（依赖序）
    let count int = 0
    if (rootmod >= 0) {
        count = pj_topo(rootmod)
        if (count < 0) {
            return 1
        }
    } else {
        count = pj_topo_multi(pj)
        if (count < 0) {
            return 1
        }
    }
    // 构建目录
    let build_len int = 0
    let build_off int = proj.build_dir(root_off, root_len, &build_len)
    if (build_off < 0) {
        return 1
    }
    if (mb_mkdir(proj.pool_str(build_off)) != 0) {
        return 1
    }
    if (gen.stats().enabled != 0) {
        bc().project_ns = cmd_clock_ns() - bc().build_start_ns
    }
    let schedule_start_ns u64 = 0
    if (gen.stats().enabled != 0) {
        schedule_start_ns = cmd_clock_ns()
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        if (tk.c_check_only != 0) {
            mb_check_clear_ifaces(build_off, build_len, count)
        }
        return 1
    }
    if (gen.stats().enabled != 0) {
        bc().schedule_ns = cmd_clock_ns() - schedule_start_ns
    }
    if (tk.c_check_only != 0) {
        mb_check_clear_ifaces(build_off, build_len, count)
        pj_out_s("检查通过: ")
        pj_out_np(proj.ctx().projs[pj].name_off, proj.ctx().projs[pj].name_len)
        pj_out_s("\n")
        mb_print_stats()
        return 0
    }
    // 链接（有入口时）
    if (rootmod >= 0) {
        let outbuf [620]u8
        let on int = 0
        if (out_arg != 0) {
            on = gen.append_str(outbuf, on, out_arg)
        } else {
            // 无 -o：产物名取清单 project.name
            if (proj.default_binary_path(root_off, root_len, build_off,
                    pj, &outbuf[0]) < 0) { return 1 }
            on = 0
            for outbuf[on] != 0 { on += 1 }
        }
        outbuf[on] = 0
        if (mb_link(gen.arr_cstr(outbuf), build_off, build_len, count, pj) != 0) {
            return 1
        }
        pj_out_s("构建完成: ")
        pj_out_s(gen.arr_cstr(outbuf))
        pj_out_s("\n")
        mb_print_stats()
        return 0
    }
    pj_out_s("库构建完成（模块对象与接口在 ")
    pj_out_np(build_off, build_len)
    pj_out_s("）\n")
    mb_print_stats()
    return 0
}

// mb_cmd_run：yh run——构建清单 entry 并运行，返回程序退出码。
// 支持与 build 相同的 --link 组选择；跨目标在本机运行前明确拒绝。
pub fn mb_cmd_run(av **char, an int) int {
    let tk *gen.TaskCtx = gen.task()
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    li_select_reset()
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--stats") != 0) {
            gen.stats().enabled = 1
            i += 1
            continue
        }
        if (gen.cstr_eq(av[i], "--link") != 0) {
            if (i + 1 >= an || av[i + 1][0] == 0) {
                gen.fail("--link 需要一个组名")
                return 2
            }
            let link_arg *char = av[i + 1]
            let ll int = 0
            for link_arg[ll] != 0 { ll += 1 }
            let lo int = gen.tml_intern_str(link_arg.to_type(*u8), 0, ll)
            if (lo < 0) { return -1 }
            if (pl_group_name_ok(lo, ll) == 0) {
                gen.fail("--link 组名只能包含字母、数字、_、-")
                return 2
            }
            if (li_select_add(lo, ll) != 0) { return -1 }
            i += 2
            continue
        }
        gen.fail_path("yh run 未知参数: ", av[i])
        return 2
    }
    tk.c_path = "yh"
    gen.stats().front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (gen.target_matches_host() == 0) {
        return gen.fail("yh run 的目标平台必须与宿主一致；跨目标请用 yh build")
    }
    if (pj_entry_mod(pj) < 0) {
        return gen.fail("库项目没有入口，无法 run（需要一个 module main;）")
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    let rootmod int = pj_entry_mod(pj)
    let count int = pj_topo(rootmod)
    if (count < 0) {
        return 1
    }
    let build_len int = 0
    let build_off int = proj.build_dir(root_off, root_len, &build_len)
    if (build_off < 0) {
        return 1
    }
    if (mb_mkdir(proj.pool_str(build_off)) != 0) {
        return 1
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        return 1
    }
    let binbuf [620]u8
    let bn int = proj.default_binary_path(root_off, root_len, build_off,
        pj, &binbuf[0])
    if (bn < 0) { return 1 }
    if (mb_link(gen.arr_cstr(binbuf), build_off, build_len, count, pj) != 0) {
        return 1
    }
    if (li_apply_runtime_env() != 0) { return 1 }
    // 运行（继承 stdout/stderr；退出码由 waitpid 状态字解码）。
    let args [2]*char
    args[0] = gen.arr_cstr(binbuf)
    args[1] = 0.to_type(*char)
    let rc int = cmd_process_run(&args[0])
    return rc < 0 ? 1 : rc
}

// mb_print_version：打印当前项目的 name 与 version（清单 project.version
// 缺省时标注未声明）。quiet=1 时找不到项目静默返回（usage 顺手显示）。
// mb_print_contracts：输出本编译器认识的产物契约版本（key=value，稳定格式）。
//
// 供 CI 与外部工具（yh-explorer、VSCode 扩展）协商：它们读这里的版本，
// 而不是去猜 `.s.i`/`.s.ct` 头行或 IR 序列化格式。版本常量单点定义在
// parse（接口头行）与 ir（序列化）模块，这里只做展示，不另存副本。
pub fn mb_print_contracts() int {
    let buf [512]u8
    let n int = 0
    n = gen.append_str(&buf[0], n, "iface-min=")
    n = gen.append_int(&buf[0], n, parse.IFACE_VERSION_MIN)
    n = gen.append_byte(&buf[0], n, '\n')
    n = gen.append_str(&buf[0], n, "iface-max=")
    n = gen.append_int(&buf[0], n, parse.IFACE_VERSION_MAX)
    n = gen.append_byte(&buf[0], n, '\n')
    n = gen.append_str(&buf[0], n, "ctiface=")
    n = gen.append_int(&buf[0], n, parse.CTIFACE_VERSION)
    n = gen.append_byte(&buf[0], n, '\n')
    n = gen.append_str(&buf[0], n, "ir-function=")
    n = gen.append_int(&buf[0], n, ir.IR_SERIAL_VERSION)
    n = gen.append_byte(&buf[0], n, '\n')
    n = gen.append_str(&buf[0], n, "ir-module=")
    n = gen.append_int(&buf[0], n, ir.IR_MODULE_SERIAL_VERSION)
    n = gen.append_byte(&buf[0], n, '\n')
    buf[n] = 0
    pj_out_s(gen.arr_cstr(&buf[0]))
    return 0
}

pub fn mb_print_version(quiet int) int {
    let root_len int = 0
    let root int = pj_find_root(quiet, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    pj_out_np(proj.ctx().projs[pj].name_off, proj.ctx().projs[pj].name_len)
    if (proj.ctx().projs[pj].ver_off >= 0) {
        pj_out_s(" ")
        pj_out_np(proj.ctx().projs[pj].ver_off, proj.ctx().projs[pj].ver_len)
    } else {
        pj_out_s(" (未声明 version)")
    }
    pj_out_s("\n")
    return 0
}

// mb_cmd_list：yh list [--resolve name]。
pub fn mb_cmd_list(av **char, an int) int {
    let tk *gen.TaskCtx = gen.task()
    let resolve_off int = -1
    let resolve_len int = 0
    let has_resolve int = 0
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--link") != 0) {
            gen.fail("yh list 不支持 --link")
            return 2
        }
        if (gen.cstr_eq(av[i], "--resolve") != 0 && i + 1 < an) {
            let sl int = 0
            for av[i + 1][sl] != 0 {
                sl += 1
            }
            let mo int = gen.tml_intern_str(av[i + 1].to_type(*u8), 0, sl)
            if (mo < 0) {
                return -1
            }
            resolve_off = mo
            resolve_len = sl
            has_resolve = 1
            i += 2
            continue
        }
        return 2
    }
    tk.c_path = "yh"
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root_len int = 0
    let root int = pj_find_root(0, &root_len)
    if (root < 0) {
        return 1
    }
    let root_off int = root
    proj.set_root_project(root_off, root_len)
    let pj int = pj_load_project(root_off, root_len)
    if (pj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    return pj_cmd_list(pj, resolve_off, resolve_len, has_resolve)
}
