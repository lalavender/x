module build
import errors
import support
import proj
import link

// ============================================================================
// module_build.yh —— 构建命令面与标准库装载（B2-4 拆分后的剩余部分）
//
// 本文件只剩「命令怎么做」：yh build / run / version / list 的参数解析与
// 编排、标准库项目发现与装载、以及 --stats/--contracts 输出。
// 单模块发射流水线见 module_emit.yh，缓存键与依赖表见 module_cache.yh，
// 产物路径/哈希在 proj（proj_40_art.yh），工具链调用在 link。
// ============================================================================

// bc().argv0：自身可执行路径（argv[0] 借用，不复制），用于编译器指纹。

// MB_TAG_MAX / MB_BUILD_DIR_MAX：路径预算。
//
// 项目名与模块名都来自用户输入，`proj.mod_tag` 用 [512]u8 临时缓冲拼接，
// 派生的接口/对象路径又写进 600/700/900 字节的定长缓冲。两个名字不限长时
// 会写穿栈（且 `support.append_str` 不做容量检查）。这里在源头设预算：
//   构建目录 ≤ 400，标记 ≤ 120，派生路径最长 400 + 7 + 120 + 5 + 1 = 533，
//   低于最小的 600 字节缓冲；超限给出可操作诊断而不是崩溃。
const MB_BUILD_DIR_MAX int = 400
const MB_TAG_MAX int = 120

// mb_try_default_stdlib：尝试 dir+suffix 下的标准库项目。
// 返回 1 表示已装载，0 表示该候选不存在，-1 表示候选存在但装载失败。
// 只接受带 project.toml 的目录；不猜测库名，也不把任意模块目录当标准库。
fn mb_try_default_stdlib(dir *char, suffix *char) int {
    let c_off int = 0
    let c_len int = 0
    let path [1200]u8
    let n int = 0
    // Windows 的 exe 目录来自 GetFullPathNameA（反斜杠），suffix 里是 '/'；
    // pj_canon 按 '/' 切段，混合分隔符会让 `..` 解析失效（安装布局
    // <root>/bin/yh + <root>/share/yh/libs 曾因此找不到标准库）。
    // 统一成 '/'：Win32 API 同样接受。
    let i0 int = 0
    for dir[i0] != 0 {
        if (n + 1 >= 1200) { return 0 }
        path[n] = dir[i0] == 92 ? 47 : dir[i0].to_type(u8)
        n += 1
        i0 += 1
    }
    n = support.append_str(path, n, suffix)
    path[n] = 0
    if (proj.canon(0, 0, support.arr_cstr(path), &c_off, &c_len) != 0) {
        return 0
    }
    let cand_off int = c_off
    let cand_len int = c_len
    let manifest [1200]u8
    let mn int = 0
    let i int = 0
    for i < cand_len {
        manifest[mn] = support.pool_ctx().data[cand_off + i]
        mn += 1
        i += 1
    }
    mn = support.append_str(manifest, mn, "/project.toml")
    manifest[mn] = 0
    if (proj.file_exists(support.arr_cstr(manifest)) == 0) {
        return 0
    }
    let loaded int = load_project(cand_off, cand_len)
    if (loaded < 0) {
        return -1
    }
    proj.ctx().stdlib = loaded
    return 1
}

// mb_load_default_stdlib：按可执行文件附近布局查找标准库。
// 依次尝试 <exe_dir>/libs（仓库构建）、<exe_dir>/../libs（bin 下种子）
// 与 <exe_dir>/../share/yh/libs（安装布局）。找不到时保持无标准库层；
// 找到但项目损坏时返回 -1，不静默回退到其它候选。
fn mb_load_default_stdlib() int {
    if (mb_resolve_self_path() != 0) {
        return 0
    }
    let self_len int = strlen(bc().self_path).to_type(int)
    // 分隔符两种都认：Git Bash / cmd.exe 启动时 argv[0] 往往是反斜杠形式
    // （实测 `C:\...\bin\yh`），只按 '/' 切会让 cut 落到 0、dir 退化成 '.'，
    // 于是安装布局（`<root>/bin/yh` + `<root>/share/yh/libs`）永远找不到标准库。
    let cut int = self_len
    for cut > 0 && bc().self_path[cut - 1] != '/' && bc().self_path[cut - 1] != 92 {
        cut -= 1
    }
    let dir [1200]u8
    let dn int = 0
    if (cut > 1) {
        let i int = 0
        for i < cut - 1 {
            dir[dn] = bc().self_path[i].to_type(u8)
            dn += 1
            i += 1
        }
    } else if (cut == 1) {
        dir[0] = '/'
        dn = 1
    } else {
        dir[0] = '.'
        dn = 1
    }
    dir[dn] = 0
    let found int = mb_try_default_stdlib(support.arr_cstr(dir), "/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(support.arr_cstr(dir), "/../libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(support.arr_cstr(dir), "/../share/yh/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    proj.ctx().stdlib = -1
    return 0
}

// mb_ensure_binary_dir：确保默认产物目录 <root>/.build 存在。
// 缓存根可被 YH_BUILD_CACHE 迁到项目外（proj.cache_root），此时 mb_mkdir
// 只建缓存树，默认产物目录需单独创建；显式 -o 的目标归用户。
fn mb_ensure_binary_dir(root_off int, root_len int) int {
    let c_off int = 0
    let c_len int = 0
    if (proj.canon(root_off, root_len, ".build", &c_off, &c_len) != 0) {
        return -1
    }
    if (link.cmd_mkdirs(proj.pool_str(c_off)) != 0) {
        return errors.fail_path("无法创建产物目录: ", proj.pool_str(c_off))
    }
    return 0
}

