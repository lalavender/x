module build

// ============================================================================
// build_ctx.yh —— 构建会话上下文 BuildCtx（B1-3，2026-10-26）
//
// `build` 原先用 21 个模块级 `let` 存「一次构建的会话状态」：编译器自身路径与
// 指纹、接口后缀、阶段计时、调度观测、以及模块依赖表（`mb_dep_*`）。
// 它们被 build 的多个文件共享、父子进程各自持一份（fork 的 COW），
// 收进一个结构后：读点归属清楚（`bc().<字段>`）、模块级可变 `let` 少 21 个。
//
// 与 proj 的分工：proj 存**项目模型的只读快照**（跨进程共享、只由父进程写），
// BuildCtx 存**本次构建的可变会话状态**（每进程一份，worker 写自己的副本）。
// 本文件按文件名序排在 build 模块最前，因此其它文件都能直接用 `bc()`。
// ============================================================================

// BuildCtx：一次构建的进程级会话状态。
pub struct BuildCtx {
    // —— 会话身份（driver/入口写入，构建期只读） ——
    argv0 *char // 编译器自身 argv[0]（子进程再入与指纹用）
    iface_suffix *char // 本轮接口后缀（.s.i/.s.ct 之外的文件名尾缀）
    compiler_fingerprint u64 // 编译器二进制指纹（参与缓存键）
    compiler_fingerprint_ready int // 1 = 指纹已算过
    self_path *char // 自身路径（读取编译器指纹）
    // —— 阶段计时（仅 --stats） ——
    build_start_ns u64
    project_ns u64
    schedule_ns u64
    object_ns u64
    link_ns u64
    // —— 调度观测 ——
    sched_peak int // 同时在跑的 worker 峰值
    sched_iface_early int // 1 = 接口提前发布路径被走到
    // —— 当前模块的依赖表（父进程装填，worker 继承只读基线后扩容） ——
    dep_bind *int // 绑定名池偏移
    dep_bindlen *int
    dep_ifoff *int // 依赖模块 .s.i 路径池偏移
    dep_ctoff *int // 依赖模块 .s.ct 路径池偏移
    dep_mod *int // 依赖模块下标
    dep_mi *int // 加载后的接口模块编号
    dep_n int
    dep_cap int
    dep_base int // 本模块接口加载前 c_mod_n 基线
}

// g_build_ctx：build 模块私有单例（零初始化；非零初值由 setup 显式设置）。
let g_build_ctx BuildCtx

// bc：构建会话上下文的唯一入口。
pub fn bc() *BuildCtx {
    return &g_build_ctx
}
