module build
import errors
import support
import libs.list

// ============================================================================
// toml.yh —— project.toml 最小 TOML 解析器（MOD-U2）
//
// 覆盖清单 schema（设计 §4）所需的 TOML 1.0 子集：
//   * 节头 [name]；裸键 [A-Za-z0-9_-]+；
//   * 值：基本字符串、字面量字符串、整数、字符串数组及字符串内联表；
//   * 注释 # 到行尾；空白含换行。
// 其余 TOML 形态（多行字符串、日期、点键、[[数组表]]）一律
// 语法报错——清单用不到，报错比静默误读安全。
//
// 解析结果存入 toml_secs（节 → 键值表）；schema 校验（允许键、类型、
// 必填）由 project.yh 负责，本文件只做语法与「值形态」判定。
// 诊断格式 <toml路径>:<line>: 错误: <msg>，由 tml_err 输出（project.toml
// 不是 yh 源码，不走 err_lc/c_path）。
// ============================================================================

struct TomlArrayItem {
    sval_off int       // 数组元素的字符串池偏移
    sval_len int
}
struct TomlSec {
    name_off int       // 节名池偏移
    name_len int
    vals list.List     // 键值表（元素类型 TomlVal）
    line int           // 节头行
}
// 解析结果是进程级解析区：递归装载子项目会清空复用（tml_reset）。
let toml_secs list.List
let toml_array_items list.List

// tml_reset：清空本次解析的节表与字符串数组，保留已分配容量。
// 首次调用时按元素类型初始化两个列表。
fn tml_reset() void {
    if (toml_secs.element_size == 0) {
        toml_secs = list.make(sizeof(TomlSec).to_type(u64))
    }
    if (toml_array_items.element_size == 0) {
        toml_array_items = list.make(sizeof(TomlArrayItem).to_type(u64))
    }
    toml_secs.count = 0
    toml_array_items.count = 0
}

// tml_sec_count：当前解析的节数。
fn tml_sec_count() int { return toml_secs.count.to_type(int) }

// tml_sec_at：第 sec 个节的地址；调用方保证 0 <= sec < tml_sec_count()。
fn tml_sec_at(sec int) *TomlSec {
    let base *TomlSec = list.first(&toml_secs).to_type(*TomlSec)
    return &base[sec]
}

// tml_val_count：第 sec 个节的键值数。
fn tml_val_count(sec int) int {
    let s *TomlSec = tml_sec_at(sec)
    return s.vals.count.to_type(int)
}

// tml_val_at：第 sec 个节第 i 个键值的地址。
fn tml_val_at(sec int, i int) *TomlVal {
    let s *TomlSec = tml_sec_at(sec)
    let base *TomlVal = list.first(&s.vals).to_type(*TomlVal)
    return &base[i]
}

// tml_array_count：本次解析保存的字符串数组元素数。
fn tml_array_count() int { return toml_array_items.count.to_type(int) }

// tml_array_at：第 index 个字符串数组元素的地址。
fn tml_array_at(index int) *TomlArrayItem {
    let base *TomlArrayItem = list.first(&toml_array_items).to_type(*TomlArrayItem)
    return &base[index]
}

// —— 解析游标与诊断上下文 ——
let t_src *u8 = 0          // project.toml 字节
let t_len int = 0
let t_pos int = 0          // 当前字节下标
let t_line int = 1         // 当前行号
let t_file *char = 0       // 诊断用清单路径（借调用方，不复制）

// tml_err：project.toml 诊断（带行号，无列——TOML 错误按行报告足够定位）。
fn tml_err(line int, msg *char) int {
    let buf [512]u8
    let n int = 0
    n = support.append_str_cap(buf, 512, n, t_file)
    n = support.append_byte_cap(buf, 512, n, ':')
    n = support.append_int_cap(buf, 512, n, line)
    n = support.append_str_cap(buf, 512, n, ": 错误: ")
    n = support.append_str_cap(buf, 512, n, msg)
    n = support.append_byte_cap(buf, 512, n, '\n')
    support.write_all(2, buf, n)
    return -1
}

// tml_intern：把 [start,start+n) 字节 intern 进名字池并带 NUL（调试用）。
fn tml_intern(start int, n int) int {
    let off int = support.pool_ctx().length
    let i int = 0
    // name_intern 从 c_src 取字节；project.toml 不在 c_src，手工入池
    let need int = support.pool_ctx().length + n + 1
    if (need > support.pool_ctx().cap) {
        let ncap int = support.pool_ctx().cap * 2
        if (ncap < need) {
            ncap = need
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
        if (nd == 0) {
            errors.fail("内存分配失败")
            return -1
        }
        if (support.pool_ctx().length > 0) {
            memcpy(nd, support.pool_ctx().data, support.pool_ctx().length.to_type(u64))
        }
        free(support.pool_ctx().data)
        support.pool_ctx().data = nd
        support.pool_ctx().cap = ncap
    }
    for i < n {
        support.pool_ctx().data[support.pool_ctx().length] = t_src[start + i]
        support.pool_ctx().length += 1
        i += 1
    }
    support.pool_ctx().data[support.pool_ctx().length] = 0
    support.pool_ctx().length += 1
    return off
}

// tml_ws：跳过空白、注释与换行（维护行号）。
fn tml_ws() void {
    for t_pos < t_len {
        let b u8 = t_src[t_pos]
        if (b == ' ' || b == '\t' || b == '\r') {
            t_pos += 1
            continue
        }
        if (b == '\n') {
            t_pos += 1
            t_line += 1
            continue
        }
        if (b == '#') {
            for t_pos < t_len && t_src[t_pos] != '\n' {
                t_pos += 1
            }
            continue
        }
        break
    }
}

// tml_is_bare：裸键字节。
fn tml_is_bare(b u8) int {
    if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
        || (b >= '0' && b <= '9') || b == '_' || b == '-') {
        return 1
    }
    return 0
}

// tml_sec_find：按名查节；没有返回 -1。
fn tml_sec_find(name_off int, name_len int) int {
    let total int = tml_sec_count()
    let i int = 0
    for i < total {
        let s *TomlSec = tml_sec_at(i)
        if (s.name_len == name_len
            && support.pool_ctx().data[s.name_off] == support.pool_ctx().data[name_off]) {
            // 节名较短，逐字节比较
            let match int = 1
            let j int = 1
            for j < name_len {
                if (support.pool_ctx().data[s.name_off + j] != support.pool_ctx().data[name_off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i += 1
    }
    return -1
}

// tml_sec_push：追加一个节（同名节重复报错）。
fn tml_sec_push(name_start int, name_len int) int {
    let off int = tml_intern(name_start, name_len)
    if (off < 0) {
        return -1
    }
    if (tml_sec_find(off, name_len) >= 0) {
        return tml_err(t_line, "重复的节")
    }
    let section TomlSec
    section.name_off = off
    section.name_len = name_len
    section.vals = list.make(sizeof(TomlVal).to_type(u64))
    section.line = t_line
    if (list.push(&toml_secs, (&section).to_type(*void)) != list.status_ok) {
        return errors.fail("内存分配失败")
    }
    return tml_sec_count() - 1
}

// tml_val_push：向节追加键值（复制 v 指向的整条记录）。
fn tml_val_push(sec int, v *TomlVal) int {
    let s *TomlSec = tml_sec_at(sec)
    if (list.push(&s.vals, v.to_type(*void)) != list.status_ok) {
        return errors.fail("内存分配失败")
    }
    return 0
}

// tml_string：解析一个字符串值（基本或字面量），intern 后写 out 偏移。
// 返回 0 成功；语法错误 -1。
fn tml_string(v *TomlVal) int {
    let q u8 = t_src[t_pos]
    let start int = t_pos + 1
    t_pos += 1
    if (q == '\'') {
        // 字面量字符串：无转义，到下一个 '
        for t_pos < t_len && t_src[t_pos] != '\'' {
            if (t_src[t_pos] == '\n') {
                return tml_err(v.line, "字符串未终结")
            }
            t_pos += 1
        }
        if (t_pos >= t_len) {
            return tml_err(v.line, "字符串未终结")
        }
        v.kind = 1
        v.sval_off = support.tml_intern_str(t_src, start, t_pos - start)
        v.sval_len = t_pos - start
        t_pos += 1
        return 0
    }
    // 基本字符串：转义处理进小缓冲再入池（清单字符串都很短）
    let tmp [512]u8
    let n int = 0
    for t_pos < t_len {
        let b u8 = t_src[t_pos]
        if (b == '"') {
            v.kind = 1
            v.sval_off = support.tml_intern_str(tmp, 0, n)
            v.sval_len = n
            t_pos += 1
            return 0
        }
        if (b == '\n') {
            return tml_err(v.line, "字符串未终结")
        }
        if (b == '\\') {
            if (t_pos + 1 >= t_len) {
                return tml_err(v.line, "转义序列不完整")
            }
            let e u8 = t_src[t_pos + 1]
            t_pos += 2
            if (e == 'n') { tmp[n] = 10; n += 1; continue }
            if (e == 't') { tmp[n] = 9; n += 1; continue }
            if (e == 'r') { tmp[n] = 13; n += 1; continue }
            if (e == '"') { tmp[n] = '"'; n += 1; continue }
            if (e == '\\') { tmp[n] = '\\'; n += 1; continue }
            return tml_err(v.line, "不支持的转义序列")
        }
        if (n >= 511) {
            return tml_err(v.line, "字符串过长")
        }
        tmp[n] = b
        n += 1
        t_pos += 1
    }
    return tml_err(v.line, "字符串未终结")
}

// tml_inline_table：解析 { k = v, ... }（v 限字符串）。填写 v.path_*。
fn tml_inline_table(v *TomlVal) int {
    t_pos += 1 // '{'
    v.kind = 2
    v.path_off = -1
    v.path_len = 0
    tml_ws()
    if (t_pos < t_len && t_src[t_pos] == '}') {
        t_pos += 1
        return tml_err(v.line, "依赖必须提供 path")
    }
    for 1 {
        tml_ws()
        if (t_pos >= t_len) {
            return tml_err(v.line, "内联表未终结")
        }
        // 键
        let ks int = t_pos
        for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
            t_pos += 1
        }
        let kn int = t_pos - ks
        if (kn == 0) {
            return tml_err(t_line, "内联表需要一个键")
        }
        tml_ws()
        if (t_pos >= t_len || t_src[t_pos] != '=') {
            return tml_err(t_line, "期望 '='")
        }
        t_pos += 1
        tml_ws()
        let line int = tml_string(v)
        if (line != 0) {
            return -1
        }
        // 目前只关心 path 键；其余键报未知（schema 简单性）
        if (kn == 4 && t_src[ks] == 'p' && t_src[ks + 1] == 'a'
            && t_src[ks + 2] == 't' && t_src[ks + 3] == 'h') {
            v.path_off = v.sval_off
            v.path_len = v.sval_len
        } else {
            return tml_err(v.line, "依赖表只支持 path 键")
        }
        tml_ws()
        if (t_pos < t_len && t_src[t_pos] == ',') {
            t_pos += 1
            continue
        }
        if (t_pos < t_len && t_src[t_pos] == '}') {
            t_pos += 1
            return 0
        }
        return tml_err(t_line, "期望 ',' 或 '}'")
    }
    return 0
}

// tml_array_push：保存一个字符串数组元素，索引在当前清单解析期内稳定。
fn tml_array_push(off int, n int) int {
    let item TomlArrayItem
    item.sval_off = off
    item.sval_len = n
    if (list.push(&toml_array_items, (&item).to_type(*void)) != list.status_ok) {
        return errors.fail("TOML 字符串数组内存分配失败")
    }
    return 0
}

// tml_array：解析 TOML 字符串数组；允许空数组与末尾逗号，不接受嵌套值。
fn tml_array(v *TomlVal) int {
    t_pos += 1
    v.kind = 4
    v.arr_first = tml_array_count()
    v.arr_count = 0
    tml_ws()
    if (t_pos < t_len && t_src[t_pos] == ']') {
        t_pos += 1
        return 0
    }
    for 1 {
        if (t_pos >= t_len || (t_src[t_pos] != '"' && t_src[t_pos] != '\'')) {
            return tml_err(v.line, "数组只接受字符串元素")
        }
        let item TomlVal
        item.line = t_line
        if (tml_string(&item) != 0
            || tml_array_push(item.sval_off, item.sval_len) != 0) { return -1 }
        v.arr_count += 1
        tml_ws()
        if (t_pos < t_len && t_src[t_pos] == ']') {
            t_pos += 1
            return 0
        }
        if (t_pos >= t_len || t_src[t_pos] != ',') {
            return tml_err(v.line, "期望 ',' 或 ']'")
        }
        t_pos += 1
        tml_ws()
        if (t_pos < t_len && t_src[t_pos] == ']') {
            t_pos += 1
            return 0
        }
    }
    return 0
}

// tml_value：解析一个值（字符串 / 内联表 / 整数 / 字符串数组）。
fn tml_value(v *TomlVal) int {
    let b u8 = t_src[t_pos]
    if (b == '"' || b == '\'') {
        return tml_string(v)
    }
    if (b == '{') {
        return tml_inline_table(v)
    }
    if (b == '[') {
        return tml_array(v)
    }
    if (b == '+' || b == '-' || (b >= '0' && b <= '9')) {
        let neg int = 0
        if (b == '+' || b == '-') {
            if (b == '-') {
                neg = 1
            }
            t_pos += 1
        }
        let val int = 0
        let digits int = 0
        for t_pos < t_len && t_src[t_pos] >= '0' && t_src[t_pos] <= '9' {
            val = val * 10 + (t_src[t_pos] - '0').to_type(int)
            digits += 1
            t_pos += 1
        }
        if (digits == 0) {
            return tml_err(v.line, "不支持的值类型")
        }
        v.kind = 3
        v.ival = (0 - val) * neg + val * (1 - neg)
        return 0
    }
    return tml_err(v.line, "不支持的值类型（仅字符串/内联表/整数/字符串数组）")
}

// tml_parse：解析整个清单。成功 0；语法错误 -1（诊断已输出）。
// t_src/t_len/t_file 由调用方设置。
fn tml_parse() int {
    let cur int = -1
    tml_reset()
    for 1 {
        tml_ws()
        if (t_pos >= t_len) {
            return 0
        }
        if (t_src[t_pos] == '[') {
            t_pos += 1
            let ks int = t_pos
            for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
                t_pos += 1
            }
            let kn int = t_pos - ks
            if (kn == 0) {
                return tml_err(t_line, "节名不能为空")
            }
            if (t_pos >= t_len || t_src[t_pos] != ']') {
                return tml_err(t_line, "期望 ']'")
            }
            t_pos += 1
            cur = tml_sec_push(ks, kn)
            if (cur < 0) {
                return -1
            }
            continue
        }
        // 键值行（必须在节内）
        if (cur < 0) {
            return tml_err(t_line, "键值必须位于节内（先写 [project]）")
        }
        let ks2 int = t_pos
        for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
            t_pos += 1
        }
        let kn2 int = t_pos - ks2
        if (kn2 == 0) {
            return tml_err(t_line, "此处需要一个键")
        }
        tml_ws()
        if (t_pos >= t_len || t_src[t_pos] != '=') {
            return tml_err(t_line, "期望 '='")
        }
        t_pos += 1
        tml_ws()
        let v TomlVal
        v.key_off = tml_intern(ks2, kn2)
        if (v.key_off < 0) {
            return -1
        }
        v.key_len = kn2
        v.line = t_line
        v.sval_off = -1
        v.sval_len = 0
        v.path_off = -1
        v.arr_first = -1
        v.arr_count = 0
        v.ival = 0
        if (tml_value(&v) != 0) {
            return -1
        }
        if (tml_val_push(cur, &v) != 0) {
            return -1
        }
        // 行尾：行内空白与注释后必须换行或 EOF（跨行跳过交回主循环）
        for t_pos < t_len && (t_src[t_pos] == ' ' || t_src[t_pos] == '\t' || t_src[t_pos] == '\r') {
            t_pos += 1
        }
        if (t_pos < t_len && t_src[t_pos] == '#') {
            for t_pos < t_len && t_src[t_pos] != '\n' {
                t_pos += 1
            }
        }
        if (t_pos < t_len && t_src[t_pos] != '\n') {
            return tml_err(t_line, "一行只能有一个键值（期望换行）")
        }
    }
    return 0
}

// toml_find_sec：按名查节，返回下标；无 -1。
fn toml_find_sec(name *char) int {
    let n int = 0
    for name[n] != 0 {
        n += 1
    }
    let total int = tml_sec_count()
    let i int = 0
    for i < total {
        let s *TomlSec = tml_sec_at(i)
        if (s.name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[s.name_off + j] != name[j].to_type(u8)) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i += 1
    }
    return -1
}

// toml_sec_str：节内取字符串键值（intern 偏移出参）。
// 找到返回 1（off/len 有效）；节或键不存在返回 0；类型错误返回 -1（诊断）。
fn toml_sec_str(sec int, key *char, off *int, olen *int) int {
    if (sec < 0) {
        return 0
    }
    let n int = 0
    for key[n] != 0 {
        n += 1
    }
    let val_n int = tml_val_count(sec)
    let i int = 0
    for i < val_n {
        let v *TomlVal = tml_val_at(sec, i)
        if (v.key_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[v.key_off + j] != key[j].to_type(u8)) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (v.kind != 1) {
                    let buf [64]u8
                    let m int = 0
                    m = support.append_str(buf, m, "字段必须是字符串: ")
                    m = support.append_str(buf, m, key)
                    let mo int = support.tml_intern_str(buf, 0, m)
                    if (mo < 0) {
                        return -1
                    }
                    return tml_err(v.line, support.np_cstr(mo))
                }
                off[0] = v.sval_off
                olen[0] = v.sval_len
                return 1
            }
        }
        i += 1
    }
    return 0
}
