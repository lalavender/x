module build
import gen
import lex
import parse

// ============================================================================
// project_index.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// pj_input_push：追加一个 project.toml C 输入，按所属项目保留稳定顺序。
fn pj_input_push(items **gen.PInput, count *int, capacity *int,
    off int, n int) int {
    if (count[0] == capacity[0]) {
        let ncap int = capacity[0] * 2
        if (ncap == 0) { ncap = 8 }
        let next *gen.PInput = malloc(
            (ncap * sizeof(gen.PInput)).to_type(u64)).to_type(*gen.PInput)
        if (next == 0) { return gen.fail("C 项目输入表内存分配失败") }
        if (count[0] > 0) {
            memcpy(next, items[0], (count[0] * sizeof(gen.PInput)).to_type(u64))
        }
        if (items[0] != 0) { free(items[0].to_type(*void)) }
        items[0] = next
        capacity[0] = ncap
    }
    items[0][count[0]].path_off = off
    items[0][count[0]].path_len = n
    count[0] += 1
    return 0
}

// pj_c_path：验证项目相对路径、扩展名和文件存在性，返回规范化路径。
fn pj_c_path(proj int, item_off int, item_len int, suffix *char,
    line int) int {
    let gs *gen.GenState = gen.G()
    if (item_len == 0 || gs.task.np_data[item_off] == '/') {
        return pj_proj_diag(gs.p_projs[proj].root_off, line,
            "[c] 路径必须是非空的项目相对路径")
    }
    let seg_start int = 0
    let path_i int = 0
    for path_i <= item_len {
        if (path_i == item_len || gs.task.np_data[item_off + path_i] == '/') {
            if (path_i - seg_start == 2
                && gs.task.np_data[item_off + seg_start] == '.'
                && gs.task.np_data[item_off + seg_start + 1] == '.') {
                return pj_proj_diag(gs.p_projs[proj].root_off, line,
                    "[c] 路径不能含 .. 目录段")
            }
            seg_start = path_i + 1
        }
        path_i += 1
    }
    let suffix_len int = 0
    for suffix[suffix_len] != 0 { suffix_len += 1 }
    if (item_len <= suffix_len) {
        return pj_proj_diag(gs.p_projs[proj].root_off, line,
            "[c] 路径扩展名不符合 sources/objects 要求")
    }
    let i int = 0
    for i < suffix_len {
        if (gs.task.np_data[item_off + item_len - suffix_len + i]
            != suffix[i].to_type(u8)) {
            return pj_proj_diag(gs.p_projs[proj].root_off, line,
                "[c] 路径扩展名不符合 sources/objects 要求")
        }
        i += 1
    }
    let rel [1024]u8
    if (item_len >= 1024) {
        return pj_proj_diag(gs.p_projs[proj].root_off, line, "[c] 路径过长")
    }
    i = 0
    for i < item_len {
        rel[i] = gs.task.np_data[item_off + i]
        i += 1
    }
    rel[item_len] = 0
    if (pj_canon(gs.p_projs[proj].root_off,
        gs.p_projs[proj].root_len, gen.arr_cstr(rel)) != 0) { return -1 }
    if (pj_file_exists(pj_pool_str(pj_state().canon_off)) == 0) {
        return pj_proj_diag(gs.p_projs[proj].root_off, line,
            "[c] 配置路径对应的文件不存在")
    }
    return 0
}

// pj_c_lib_name：限制系统库名为普通名字，避免把链接器选项当作库名传入。
fn pj_c_lib_name(off int, n int) int {
    let tk *gen.TaskCtx = gen.task()
    if (n == 0) { return 0 }
    let i int = 0
    for i < n {
        let b u8 = tk.np_data[off + i]
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_' || b == '-')) { return 0 }
        i += 1
    }
    return 1
}

// pj_load_c_config：在递归依赖装载前快照并验证 [c] 的三个字符串数组。
fn pj_load_c_config(proj int, sec int) int {
    let gs *gen.GenState = gen.G()
    if (sec < 0) { return 0 }
    let vi int = 0
    for vi < toml_secs[sec].val_n {
        let val TomlVal = toml_secs[sec].vals[vi]
        let kind int = 0
        if (val.key_len == 7 && gs.task.np_data[val.key_off] == 's'
            && gs.task.np_data[val.key_off + 1] == 'o'
            && gs.task.np_data[val.key_off + 2] == 'u'
            && gs.task.np_data[val.key_off + 3] == 'r'
            && gs.task.np_data[val.key_off + 4] == 'c'
            && gs.task.np_data[val.key_off + 5] == 'e'
            && gs.task.np_data[val.key_off + 6] == 's') { kind = 1 }
        if (val.key_len == 7 && gs.task.np_data[val.key_off] == 'o'
            && gs.task.np_data[val.key_off + 1] == 'b'
            && gs.task.np_data[val.key_off + 2] == 'j'
            && gs.task.np_data[val.key_off + 3] == 'e'
            && gs.task.np_data[val.key_off + 4] == 'c'
            && gs.task.np_data[val.key_off + 5] == 't'
            && gs.task.np_data[val.key_off + 6] == 's') { kind = 2 }
        if (val.key_len == 4 && gs.task.np_data[val.key_off] == 'l'
            && gs.task.np_data[val.key_off + 1] == 'i'
            && gs.task.np_data[val.key_off + 2] == 'b'
            && gs.task.np_data[val.key_off + 3] == 's') { kind = 3 }
        if (kind == 0) {
            return pj_proj_diag(gs.p_projs[proj].root_off, val.line,
                "[c] 未知字段（仅支持 sources、objects、libs）")
        }
        if (val.kind != 4 || val.arr_first < 0 || val.arr_count < 0
            || val.arr_first + val.arr_count > toml_array_n) {
            return pj_proj_diag(gs.p_projs[proj].root_off, val.line,
                "[c] sources、objects、libs 必须是字符串数组")
        }
        let ai int = 0
        for ai < val.arr_count {
            let item TomlArrayItem = toml_array_items[val.arr_first + ai]
            let off int = item.sval_off
            let n int = item.sval_len
            if (kind == 1 || kind == 2) {
                let suffix *char = kind == 1 ? ".c" : ".o"
                if (pj_c_path(proj, off, n, suffix, val.line) != 0) { return -1 }
                let path_off int = pj_state().canon_off
                let path_len int = pj_state().canon_len
                if (kind == 1) {
                    if (pj_input_push(&gs.p_projs[proj].c_sources,
                        &gs.p_projs[proj].c_source_n,
                        &gs.p_projs[proj].c_source_cap, path_off, path_len) != 0) { return -1 }
                } else if (pj_input_push(&gs.p_projs[proj].c_objects,
                    &gs.p_projs[proj].c_object_n,
                    &gs.p_projs[proj].c_object_cap, path_off, path_len) != 0) { return -1 }
            } else {
                if (pj_c_lib_name(off, n) == 0) {
                    return pj_proj_diag(gs.p_projs[proj].root_off, val.line,
                        "[c] libs 元素必须是普通系统库名")
                }
                if (pj_input_push(&gs.p_projs[proj].c_libs,
                    &gs.p_projs[proj].c_lib_n, &gs.p_projs[proj].c_lib_cap,
                    off, n) != 0) { return -1 }
            }
            ai += 1
        }
        vi += 1
    }
    return 0
}

pub fn pj_load_project(root_off int, root_len int) int {
    let gs *gen.GenState = gen.G()
    // 依赖环 / 重复装载
    let known int = pj_proj_find_root(root_off, root_len)
    if (known >= 0) {
        if (gs.p_state[known] == 1) {
            pj_proj_diag(root_off, 0, "依赖环：项目正在装载中")
            return -1
        }
        return known
    }
    let me int = pj_proj_push(root_off, root_len)
    if (me < 0) {
        return -1
    }
    let is_root int = pj_is_root_project(root_off, root_len)
    // p_state 平行扩容
    let nst *int = malloc((gs.p_proj_cap * sizeof(int)).to_type(u64)).to_type(*int)
    if (nst == 0) {
        return gen.fail("内存分配失败")
    }
    if (gs.p_proj_n > 0) {
        memcpy(nst, gs.p_state, ((gs.p_proj_n - 1) * sizeof(int)).to_type(u64))
    }
    free(gs.p_state)
    gs.p_state = nst
    gs.p_state[me] = 1
    // 读清单
    let mpath [1024]u8
    let mn int = 0
    mn = gen.append_str(mpath, mn, pj_pool_str(root_off))
    mn = gen.append_str(mpath, mn, "/project.toml")
    mpath[mn] = 0
    if (gen.read_source(gen.arr_cstr(mpath)) != 0) {
        return -1
    }
    t_src = gs.task.c_src
    t_len = gs.task.c_src_len
    t_pos = 0
    t_line = 1
    t_file = gen.arr_cstr(mpath)
    toml_sec_n = 0
    if (tml_parse() != 0) {
        return -1
    }
    // schema：[project]
    let sec int = toml_find_sec("project")
    if (sec < 0) {
        return pj_proj_diag(root_off, 1, "缺少 [project] 节")
    }
    let so int = 0
    let sl int = 0
    let got int = toml_sec_str(sec, "name", &so, &sl)
    if (got < 0) {
        return -1
    }
    if (got == 0 || sl == 0) {
        return pj_proj_diag(root_off, toml_secs[sec].line, "project.name 必填且非空")
    }
    // name 必须是标识符：产物名与接口 tag 都由它派生，不允许分隔符
    let nb0 u8 = gs.task.np_data[so]
    if (!((nb0 >= 'a' && nb0 <= 'z') || (nb0 >= 'A' && nb0 <= 'Z') || nb0 == '_')) {
        return pj_proj_diag(root_off, toml_secs[sec].line,
            "project.name 必须是标识符（字母或下划线开头）")
    }
    let nk int = 0
    for nk < sl {
        let cb u8 = gs.task.np_data[so + nk]
        if (!((cb >= 'a' && cb <= 'z') || (cb >= 'A' && cb <= 'Z')
            || (cb >= '0' && cb <= '9') || cb == '_')) {
            return pj_proj_diag(root_off, toml_secs[sec].line,
                "project.name 只能是字母、数字与下划线")
        }
        nk += 1
    }
    gs.p_projs[me].name_off = so
    gs.p_projs[me].name_len = sl
    // source（默认 src）
    got = toml_sec_str(sec, "source", &so, &sl)
    if (got < 0) {
        return -1
    }
    let srcname *char = "src"
    if (got == 1) {
        srcname = pj_pool_str(so)
    }
    if (pj_canon(root_off, root_len, srcname) != 0) {
        return -1
    }
    gs.p_projs[me].src_off = pj_state().canon_off
    gs.p_projs[me].src_len = pj_state().canon_len
    // version（可选，仅供 yh version 展示）
    got = toml_sec_str(sec, "version", &so, &sl)
    if (got < 0) {
        return -1
    }
    if (got == 1) {
        gs.p_projs[me].ver_off = so
        gs.p_projs[me].ver_len = sl
    }
    // [project].os/arch：必填；host 表示跟随编译器宿主平台。
    if (pl_load_project_target(me, sec) != 0) { return -1 }
    // [project] 未知字段检查
    let vi int = 0
    for vi < toml_secs[sec].val_n {
        let vo int = toml_secs[sec].vals[vi].key_off
        let vl int = toml_secs[sec].vals[vi].key_len
        let okf int = 0
        if (vl == 4 && gs.task.np_data[vo] == 'n' && gs.task.np_data[vo + 1] == 'a'
            && gs.task.np_data[vo + 2] == 'm' && gs.task.np_data[vo + 3] == 'e') { okf = 1 }
        if (vl == 7 && gs.task.np_data[vo] == 'v' && gs.task.np_data[vo + 1] == 'e'
            && gs.task.np_data[vo + 2] == 'r' && gs.task.np_data[vo + 3] == 's'
            && gs.task.np_data[vo + 4] == 'i' && gs.task.np_data[vo + 5] == 'o'
            && gs.task.np_data[vo + 6] == 'n') { okf = 1 }
        if (vl == 6 && gs.task.np_data[vo] == 's' && gs.task.np_data[vo + 1] == 'o'
            && gs.task.np_data[vo + 2] == 'u' && gs.task.np_data[vo + 3] == 'r'
            && gs.task.np_data[vo + 4] == 'c' && gs.task.np_data[vo + 5] == 'e') { okf = 1 }
        if (vl == 6 && gs.task.np_data[vo] == 'a' && gs.task.np_data[vo + 1] == 'u'
            && gs.task.np_data[vo + 2] == 't' && gs.task.np_data[vo + 3] == 'h'
            && gs.task.np_data[vo + 4] == 'o' && gs.task.np_data[vo + 5] == 'r') { okf = 1 }
        if (vl == 2 && gs.task.np_data[vo] == 'o'
            && gs.task.np_data[vo + 1] == 's') { okf = 1 }
        if (vl == 4 && gs.task.np_data[vo] == 'a'
            && gs.task.np_data[vo + 1] == 'r'
            && gs.task.np_data[vo + 2] == 'c'
            && gs.task.np_data[vo + 3] == 'h') { okf = 1 }
        if (okf == 0) {
            let buf [64]u8
            let bn int = 0
            bn = gen.append_str(buf, bn, "project 未知字段: ")
            let k int = 0
            for k < vl {
                buf[bn] = gs.task.np_data[vo + k]
                bn += 1
                k += 1
            }
            let mo int = gen.tml_intern_str(buf, 0, bn)
            if (mo < 0) {
                return -1
            }
            return pj_proj_diag(root_off, toml_secs[sec].vals[vi].line, gen.np_cstr(mo))
        }
        vi += 1
    }
    if (pj_load_c_config(me, toml_find_sec("c")) != 0) { return -1 }
    if (pl_load_link_config(me, is_root) != 0) { return -1 }
    if (is_root != 0 && pl_apply_project_target(me) != 0) { return -1 }
    // [dependencies]：先整表快照——递归装载会重置 toml_secs（全局解析区）
    let dsec int = toml_find_sec("dependencies")
    let snap_key_off [64]int
    let snap_key_len [64]int
    let snap_path_off [64]int
    let snap_line [64]int
    let snap_n int = 0
    if (dsec >= 0) {
        for snap_n < toml_secs[dsec].val_n && snap_n < 64 {
            snap_key_off[snap_n] = toml_secs[dsec].vals[snap_n].key_off
            snap_key_len[snap_n] = toml_secs[dsec].vals[snap_n].key_len
            snap_path_off[snap_n] = toml_secs[dsec].vals[snap_n].path_off
            snap_line[snap_n] = toml_secs[dsec].vals[snap_n].line
            snap_n += 1
        }
    }
    if (dsec >= 0) {
        let di int = 0
            for di < snap_n {
                    // 快照依赖条目：递归装载会重置 toml_secs（全局解析区）
            let key_off int = snap_key_off[di]
            let key_len int = snap_key_len[di]
            let dep_line int = snap_line[di]
            if (snap_path_off[di] < 0) {
                return pj_proj_diag(root_off, dep_line,
                    "依赖必须是 { path = \"...\" } 表")
            }
            let path_off int = snap_path_off[di]
            // 依赖项目根 = 规范化(root + path)
            if (pj_canon(root_off, root_len, pj_pool_str(path_off)) != 0) {
                return -1
            }
            let dep int = pj_load_project(pj_state().canon_off, pj_state().canon_len)
            if (dep < 0) {
                return -1
            }
            // 登记依赖
            if (gs.p_projs[me].dep_n == gs.p_projs[me].dep_cap) {
                let ncap int = gs.p_projs[me].dep_cap * 2
                if (ncap == 0) {
                    ncap = 8
                }
                let nd *gen.PDep = malloc((ncap * sizeof(gen.PDep)).to_type(u64)).to_type(*gen.PDep)
                if (nd == 0) {
                    return gen.fail("内存分配失败")
                }
                if (gs.p_projs[me].dep_n > 0) {
                    memcpy(nd, gs.p_projs[me].deps, (gs.p_projs[me].dep_n * sizeof(gen.PDep)).to_type(u64))
                }
                free(gs.p_projs[me].deps)
                gs.p_projs[me].deps = nd
                gs.p_projs[me].dep_cap = ncap
            }
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].key_off = key_off
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].key_len = key_len
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].proj = dep
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].line = dep_line
            gs.p_projs[me].dep_n += 1
            di += 1
        }
    }
    // 扫描源码根
    if (pj_scan_source(gs.p_projs[me].src_off, gs.p_projs[me].src_len, me) != 0) {
        return -1
    }
    // 测试专用导入分类：必须在 pj_bind_imports 之前完成，生产构建据此跳过
    // 只在 test 体内使用的依赖；测试模式仍绑定全部导入。
    if (pj_classify_test_imports(me) != 0) {
        return -1
    }
    // 入口模块：模块名为 main 的那个（模块名与目录名无关；同名模块跨目录
    // 合并为一个，故至多命中一次）
    let mi int = 0
    for mi < gs.p_projs[me].mod_n {
        let um int = gs.p_projs[me].mods[mi]
        if (gs.p_mods[um].name_len == 4
            && gs.task.np_data[gs.p_mods[um].name_off] == 'm'
            && gs.task.np_data[gs.p_mods[um].name_off + 1] == 'a'
            && gs.task.np_data[gs.p_mods[um].name_off + 2] == 'i'
            && gs.task.np_data[gs.p_mods[um].name_off + 3] == 'n') {
            gs.p_mods[um].is_entry = 1
            break
        }
        mi += 1
    }
    gs.p_state[me] = 2
    return me
}

fn pj_scan_source(dir_off int, dir_len int, proj int) int {
    let entries *PJDirEntry = 0.to_type(*PJDirEntry)
    let es_n int = 0
    let es_cap int = 0
    if (pj_os_dir_list(pj_pool_str(dir_off), &entries, &es_n, &es_cap) != 0) {
        if (entries != 0) { free(entries.to_type(*void)) }
        return -1
    }
    pj_dir_sort(entries, es_n)
    let e int = 0
    for e < es_n {
        if (pj_scan_entry(dir_off, dir_len, entries[e].name_off,
            entries[e].name_len, entries[e].is_dir, proj) != 0) {
            free(entries.to_type(*void))
            return -1
        }
        e += 1
    }
    if (entries != 0) { free(entries.to_type(*void)) }
    return 0
}

// pj_dir_less：按文件名字节序排序，保证跨宿主扫描与构建顺序稳定。
fn pj_dir_less(a PJDirEntry, b PJDirEntry) int {
    let tk *gen.TaskCtx = gen.task()
    let n int = a.name_len
    if (b.name_len < n) { n = b.name_len }
    let i int = 0
    for i < n {
        let av int = tk.np_data[a.name_off + i].to_type(int)
        let bv int = tk.np_data[b.name_off + i].to_type(int)
        if (av < bv) { return 1 }
        if (av > bv) { return 0 }
        i += 1
    }
    return (a.name_len < b.name_len).to_type(int)
}

// pj_dir_sort：按小目录常见情况原地插入排序，不另申请排序缓冲。
fn pj_dir_sort(entries *PJDirEntry, n int) int {
    let i int = 1
    for i < n {
        let item PJDirEntry = entries[i]
        let j int = i
        for j > 0 && pj_dir_less(item, entries[j - 1]) != 0 {
            entries[j] = entries[j - 1]
            j -= 1
        }
        entries[j] = item
        i += 1
    }
    return 0
}

// pj_scan_skip_dir：源码根内的构建产物目录不参与扫描。
// `tmp/` 与 `.build/` 可能位于源码根之下（例如标准库项目 source = "."），
// 其中的生成文件（含 yh test 的测试入口）不是用户源码。
fn pj_scan_skip_dir(name_start int, name_len int) int {
    let tk *gen.TaskCtx = gen.task()
    if (name_len == 3 && tk.np_data[name_start] == 't'
        && tk.np_data[name_start + 1] == 'm'
        && tk.np_data[name_start + 2] == 'p') {
        return 1
    }
    if (name_len == 6 && tk.np_data[name_start] == '.'
        && tk.np_data[name_start + 1] == 'b'
        && tk.np_data[name_start + 2] == 'u'
        && tk.np_data[name_start + 3] == 'i'
        && tk.np_data[name_start + 4] == 'l'
        && tk.np_data[name_start + 5] == 'd') {
        return 1
    }
    return 0
}

// pj_scan_is_target：单文件模式下，path 是否就是被选中的那个文件。
fn pj_scan_is_target(path *char) int {
    let gs *gen.GenState = gen.G()
    if (gs.c_scan_file_off < 0) { return 1 }
    let n int = 0
    for path[n] != 0 { n += 1 }
    if (n != gs.c_scan_file_len) { return 0 }
    let i int = 0
    for i < n {
        if (gs.task.np_data[gs.c_scan_file_off + i] != path[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    return 1
}

// pj_scan_applies：--scan-file 是否适用于该项目。
// 单文件测试的扫描过滤只约束**被测项目**（扫描文件位于其源码根之下）；
// 标准库与依赖项目的文件必须整份索引，否则无 fork 宿主（Windows）的模块
// 子进程里会出现“模块不存在: string/memory”。
fn pj_scan_applies(proj int) int {
    let gs *gen.GenState = gen.G()
    if (gs.c_scan_file_off < 0) { return 0 }
    if (proj < 0 || proj >= gs.p_proj_n) { return 0 }
    let root_off int = gs.p_projs[proj].src_off
    let root_len int = gs.p_projs[proj].src_len
    if (root_len <= 0 || root_len > gs.c_scan_file_len) { return 0 }
    let i int = 0
    for i < root_len {
        if (gs.task.np_data[root_off + i]
            != gs.task.np_data[gs.c_scan_file_off + i]) {
            return 0
        }
        i += 1
    }
    return 1
}

fn pj_scan_entry(dir_off int, dir_len int, name_start int, name_len int, is_dir int, proj int) int {
    let gs *gen.GenState = gen.G()
    if (is_dir != 0) {
        // 单文件模式（yh test <项目外文件>）不进入任何子目录，也不装入相邻文件；
        // 只对被测项目生效（见 pj_scan_applies）。
        if (pj_scan_applies(proj) != 0) { return 0 }
        if (pj_scan_skip_dir(name_start, name_len) != 0) { return 0 }
        // 子目录相对路径：<dir>/<name>，规范化后递归
        let nm [300]u8
        let nn int = 0
        let k2 int = 0
        for k2 < name_len {
            nm[nn] = gs.task.np_data[name_start + k2]
            nn += 1
            k2 += 1
        }
        nm[nn] = 0
        if (pj_canon(dir_off, dir_len, gen.arr_cstr(nm)) != 0) {
            return -1
        }
        let sub_off int = pj_state().canon_off
        let sub_len int = pj_state().canon_len
        // 嵌套项目边界：含 mod.toml 的子目录属于另一项目，不进入
        let probe [1100]u8
        let pn int = 0
        pn = gen.append_str(probe, pn, pj_pool_str(sub_off))
        pn = gen.append_str(probe, pn, "/project.toml")
        probe[pn] = 0
        if (pj_file_exists(gen.arr_cstr(probe)) != 0) {
            return 0
        }
        return pj_scan_source(sub_off, sub_len, proj)
    }
    if (pj_source_target_match(name_start, name_len) == 0) {
        return 0
    }
    // .yh 后缀检查
    if (name_len < 3 || gs.task.np_data[name_start + name_len - 3] != '.'
        || gs.task.np_data[name_start + name_len - 2] != 'y' || gs.task.np_data[name_start + name_len - 1] != 'h') {
        return 0
    }
    // 完整路径 = <dir>/<name>
    let full [1100]u8
    let flen2 int = 0
    flen2 = gen.append_str(full, flen2, pj_pool_str(dir_off))
    full[flen2] = '/'
    flen2 += 1
    let k int = 0
    for k < name_len {
        full[flen2] = gs.task.np_data[name_start + k]
        flen2 += 1
        k += 1
    }
    full[flen2] = 0
    // 单文件模式：只接受选中的那一个文件，其它相邻 .yh 一律忽略。
    if (pj_scan_applies(proj) != 0
        && pj_scan_is_target(gen.arr_cstr(&full[0])) == 0) { return 0 }
    // 读文件并解析模块头（诊断指向被扫文件）
    let save_path *char = gs.task.c_path
    gs.task.c_path = gen.arr_cstr(full)
    let r int = pj_index_file(gen.arr_cstr(full), proj)
    gs.task.c_path = save_path
    return r
}

// pj_target_tag_is：比较名称池中的单个后缀段，不要求池内文件名带 NUL。
fn pj_target_tag_is(start int, n int, tag *char) int {
    let tk *gen.TaskCtx = gen.task()
    let i int = 0
    for tag[i] != 0 {
        if (i >= n || tk.np_data[start + i] != tag[i].to_type(u8)) { return 0 }
        i += 1
    }
    return (i == n).to_type(int)
}

// pj_source_target_match：从 .yh 前向左读取目标后缀段，OS/架构均须匹配当前 TargetInfo。
// 标记：.linux/.darwin/.windows（OS）与 .arm64/.x64（架构）；未识别段按普通文件名接受
// ——所以新增 `*.windows.yh` 前必须先在此登记，否则会被所有目标编入（方案 §4.2）。
fn pj_source_target_match(name_start int, name_len int) int {
    let gs *gen.GenState = gen.G()
    let end int = name_start + name_len - 3
    for end > name_start {
        let dot int = end - 1
        for dot >= name_start && gs.task.np_data[dot] != '.' { dot -= 1 }
        if (dot < name_start) { return 1 }
        let start int = dot + 1
        let n int = end - start
        if (pj_target_tag_is(start, n, "linux") != 0) {
            if (gs.c_target.os != gen.TARGET_OS_LINUX) { return 0 }
        } else if (pj_target_tag_is(start, n, "darwin") != 0) {
            if (gs.c_target.os != gen.TARGET_OS_DARWIN) { return 0 }
        } else if (pj_target_tag_is(start, n, "windows") != 0) {
            if (gs.c_target.os != gen.TARGET_OS_WINDOWS) { return 0 }
        } else if (pj_target_tag_is(start, n, "arm64") != 0) {            if (gs.c_target.arch != gen.TARGET_ARCH_ARM64) { return 0 }
        } else if (pj_target_tag_is(start, n, "x64") != 0) {
            if (gs.c_target.arch != gen.TARGET_ARCH_X64) { return 0 }
        } else { return 1 }
        end = dot
    }
    return 1
}

// pj_synth_module_name：从文件路径派生标识符模块名（去目录、去 .yh、非法字符转 _，
// 首字符非字母时前置 _）。写入 task 的 mod_name_off/mod_name_len 并置 has_module。
fn pj_synth_module_name(path *char) int {
    let gs *gen.GenState = gen.G()
    let base int = 0
    let i int = 0
    for path[i] != 0 {
        if (path[i] == '/') { base = i + 1 }
        i += 1
    }
    let end int = i
    if (end - base > 3 && path[end - 3] == '.' && path[end - 2] == 'y'
        && path[end - 1] == 'h') {
        end -= 3
    }
    if (end <= base) { return gen.fail("单文件测试无法从文件名派生模块名") }
    let tmp [160]u8
    let n int = 0
    let k int = base
    for k < end {
        let c u8 = path[k].to_type(u8)
        let ok int = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
            (c >= '0' && c <= '9') || c == '_'
        if (ok != 0) {
            tmp[n] = c
        } else {
            tmp[n] = '_'
        }
        n += 1
        k += 1
    }
    if (tmp[0] >= 48 && tmp[0] <= 57) {
        // 首字符不能是数字：前置下划线后整体后移。
        let m int = n
        for m > 0 {
            tmp[m] = tmp[m - 1]
            m -= 1
        }
        tmp[0] = '_'
        n += 1
    }
    let off int = gen.tml_intern_str(&tmp[0], 0, n)
    if (off < 0) { return -1 }
    gs.task.mod_name_off = off
    gs.task.mod_name_len = n
    gs.task.mod_has_module = 1
    return 0
}

pub fn pj_index_file(path *char, proj int) int {
    let gs *gen.GenState = gen.G()
    if (gs.c_stats_enabled != 0) {
        gs.c_stats_index += 1
    }
    if (gen.read_source(path) != 0) {
        return -1
    }
    gs.task.c_tok_n = 0
    gs.task.c_pos = 0
    gs.task.c_errors = 0
    if (lex.lex_all() != 0) {
        return -1
    }
    parse.mod_reset_file()
    if (parse.mod_parse_head() != 0) {
        return -1
    }
    if (gs.task.mod_has_module == 0 && gs.c_scan_file_off >= 0
        && pj_scan_is_target(path) != 0) {
        // 单文件测试：文件可以省略 module 头，用文件名派生一个模块名。
        if (pj_synth_module_name(path) != 0) { return -1 }
    }
    if (gs.task.mod_has_module == 0) {
        // 源码根内的文件必须声明模块（旧单文件形态不属于项目源码根）
        gs.task.c_errors += 1
        let buf [256]u8
        let n int = 0
        n = gen.append_str(buf, n, gs.task.c_path)
        n = gen.append_str(buf, n, ":1:1: 错误: 项目源码内的文件必须以 module 声明开头\n")
        gen.write_all(2, buf, n)
        return -1
    }
    // 查找/创建模块
    let mod int = -1
    let mi int = 0
    for mi < gs.p_mod_n {
        if (gs.p_mods[mi].proj == proj && gs.p_mods[mi].name_len == gs.task.mod_name_len
            && gs.task.np_data[gs.p_mods[mi].name_off] == gs.task.np_data[gs.task.mod_name_off]) {
            let match int = 1
            let j int = 1
            for j < gs.task.mod_name_len {
                if (gs.task.np_data[gs.p_mods[mi].name_off + j] != gs.task.np_data[gs.task.mod_name_off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                mod = mi
                break
            }
        }
        mi += 1
    }
    if (mod < 0) {
        mod = pj_mod_push(gs.task.mod_name_off, gs.task.mod_name_len, proj)
        if (mod < 0) {
            return -1
        }
        if (pj_proj_add_mod(proj, mod) != 0) {
            return -1
        }
    }
    // 登记文件（路径 intern）
    let plen int = 0
    for path[plen] != 0 {
        plen += 1
    }
    let poff int = gen.tml_intern_str(path.to_type(*u8), 0, plen)
    if (poff < 0) {
        return -1
    }
    let fidx int = pj_file_push(poff, plen, mod)
    if (fidx < 0) {
        return -1
    }
    if (gs.c_front_cache != 0) {
        let toks *gen.Tok = malloc((gs.task.c_tok_n * sizeof(gen.Tok)).to_type(u64)).to_type(*gen.Tok)
        if (toks == 0) {
            return gen.fail("内存分配失败")
        }
        memcpy(toks, gs.task.c_toks, (gs.task.c_tok_n * sizeof(gen.Tok)).to_type(u64))
        gs.p_files[fidx].source = gs.task.c_src
        gs.p_files[fidx].source_len = gs.task.c_src_len
        gs.p_files[fidx].tokens = toks
        gs.p_files[fidx].token_n = gs.task.c_tok_n
    }
    if (pj_mod_add_file(mod, fidx) != 0) {
        return -1
    }
    // 目录唯一模块检查：同目录内只允许一个模块（用户规划）
    let di int = 0
    for di < gs.p_file_n {
        let dn int = gs.p_files[di].path_len
        let dl int = pj_dir_prefix_len(gs.p_files[di].path_off, dn)
        let nl int = pj_dir_prefix_len(poff, plen)
        if (dl == nl && pj_same_np(gs.p_files[di].path_off, dl, poff, dl)
            && gs.p_files[di].mod != mod) {
            let buf [512]u8
            let bn int = 0
            bn = gen.append_str(buf, bn, "同目录存在另一个模块（每目录一个模块）: ")
            bn = append_bytes_np(buf, bn, gs.p_mods[mod].name_off, gs.p_mods[mod].name_len)
            bn = gen.append_str(buf, bn, " 与 ")
            bn = append_bytes_np(buf, bn, gs.p_mods[gs.p_files[di].mod].name_off,
                gs.p_mods[gs.p_files[di].mod].name_len)
            let mo int = gen.tml_intern_str(buf, 0, bn)
            if (mo < 0) {
                return -1
            }
            gs.task.c_errors += 1
            let out [600]u8
            let on int = 0
            on = gen.append_str(out, on, gen.np_cstr(mo))
            on = gen.append_byte(out, on, '\n')
            gen.write_all(2, out, on)
            return -1
        }
        di += 1
    }
    // 导入记录
    let ii int = 0
    for ii < gs.task.mod_import_n {
        if (pj_imp_push(fidx, gs.task.mod_imports[ii].name_off, gs.task.mod_imports[ii].name_len,
            gs.task.mod_imports[ii].proj_key_off, gs.task.mod_imports[ii].proj_key_len,
            gs.task.mod_imports[ii].alias_off, gs.task.mod_imports[ii].alias_len,
            gs.task.mod_imports[ii].line, gs.task.mod_imports[ii].col) != 0) {
            return -1
        }
        ii += 1
    }
    return 0
}

// pj_dir_prefix_len：路径的目录前缀长度（最后一个 '/' 之前；无 '/' 为 0）。
fn pj_dir_prefix_len(off int, plen int) int {
    let tk *gen.TaskCtx = gen.task()
    let last int = -1
    let i int = 0
    for i < plen {
        if (tk.np_data[off + i] == '/') {
            last = i
        }
        i += 1
    }
    if (last < 0) {
        return 0
    }
    return last
}

// pj_same_np：名字池两段字节相等。
fn pj_same_np(o1 int, l1 int, o2 int, l2 int) int {
    let tk *gen.TaskCtx = gen.task()
    if (l1 != l2) {
        return 0
    }
    let j int = 0
    for j < l1 {
        if (tk.np_data[o1 + j] != tk.np_data[o2 + j]) {
            return 0
        }
        j += 1
    }
    return 1
}

// pj_imp_alias_match：文件 f 的第 ti 个 token 是否等于导入 ii 的绑定名。
fn pj_imp_alias_match(f int, ti int, ii int) int {
    let gs *gen.GenState = gen.G()
    let tok gen.Tok = gs.p_files[f].tokens[ti]
    let n int = gs.p_imp_alias_len[ii]
    if (tok.kind != gen.TOK_IDENT || tok.len != n) {
        return 0
    }
    let j int = 0
    for j < n {
        if (gs.p_files[f].source[tok.start + j]
            != gs.task.np_data[gs.p_imp_alias_off[ii] + j]) {
            return 0
        }
        j += 1
    }
    return 1
}

// pj_mark_test_tokens：把文件 f 中每个顶层 test 声明的块体 token 标记为 1。
// 用于区分「只在 test 体内使用」的导入；只扫描 token，不做语义解析。
fn pj_mark_test_tokens(f int) *u8 {
    let gs *gen.GenState = gen.G()
    let n int = gs.p_files[f].token_n
    if (n <= 0) { return 0 }
    let marks *u8 = malloc(n.to_type(u64)).to_type(*u8)
    if (marks == 0) { return 0 }
    let i int = 0
    for i < n {
        marks[i] = 0
        i += 1
    }
    let depth int = 0
    i = 0
    for i < n {
        let k int = gs.p_files[f].tokens[i].kind
        if (k == gen.TK_LBRACE) {
            depth += 1
            i += 1
            continue
        }
        if (k == gen.TK_RBRACE) {
            if (depth > 0) { depth -= 1 }
            i += 1
            continue
        }
        if (depth == 0 && k == gen.TK_TEST
            && (i == 0 || gs.p_files[f].tokens[i - 1].kind != gen.TK_DOT)) {
            let j int = i + 1
            for j < n {
                let jk int = gs.p_files[f].tokens[j].kind
                if (jk == gen.TK_LBRACE || jk == gen.TK_SEMI || jk == gen.TOK_EOF) {
                    break
                }
                j += 1
            }
            if (j < n && gs.p_files[f].tokens[j].kind == gen.TK_LBRACE) {
                let d int = 0
                let e int = j
                for e < n {
                    let ek int = gs.p_files[f].tokens[e].kind
                    if (ek == gen.TK_LBRACE) { d += 1 }
                    if (ek == gen.TK_RBRACE) {
                        d -= 1
                        if (d == 0) { break }
                    }
                    e += 1
                }
                if (e < n) {
                    let q int = j
                    for q <= e {
                        marks[q] = 1
                        q += 1
                    }
                    i = e + 1
                    continue
                }
            }
        }
        i += 1
    }
    return marks
}

// pj_classify_test_imports：为项目 proj 的每条导入分类 test_only。
// 仅当绑定名以 `alias.` 形式出现，且所有出现都在该文件的 test 块体内，
// 才标记为测试专用；生产构建随后跳过该导入的绑定、依赖边和未使用诊断。
fn pj_classify_test_imports(proj int) int {
    let gs *gen.GenState = gen.G()
    let mi int = 0
    for mi < gs.p_projs[proj].mod_n {
        let m int = gs.p_projs[proj].mods[mi]
        let fi int = 0
        for fi < gs.p_mods[m].file_n {
            let f int = gs.p_mods[m].files[fi]
            let marks *u8 = pj_mark_test_tokens(f)
            if (marks == 0) {
                if (gs.p_files[f].token_n > 0) { return gen.fail("内存分配失败") }
                fi += 1
                continue
            }
            let ii int = 0
            for ii < gs.p_imp_n {
                if (gs.p_imp_file[ii] != f) {
                    ii += 1
                    continue
                }
                let inside int = 0
                let outside int = 0
                let ti int = 0
                let n int = gs.p_files[f].token_n
                for ti + 1 < n {
                    if (gs.p_files[f].tokens[ti].kind == gen.TOK_IDENT
                        && gs.p_files[f].tokens[ti + 1].kind == gen.TK_DOT
                        && pj_imp_alias_match(f, ti, ii) != 0) {
                        if (marks[ti] != 0) {
                            inside = 1
                        } else {
                            outside = 1
                            break
                        }
                    }
                    ti += 1
                }
                gs.p_imp_test_only[ii] = (inside != 0 && outside == 0).to_type(int)
                ii += 1
            }
            free(marks.to_type(*void))
            fi += 1
        }
        mi += 1
    }
    return 0
}

// TCase：一条已发现的测试。name_* 是名字池中的显示名（字符串去引号）。

// tc_reset：清空一次 yh test 会话的发现结果。
