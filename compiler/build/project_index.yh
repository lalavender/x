module build
import token
import support
import proj

// ============================================================================
// project_index.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// pj_input_push：追加一个 project.toml C 输入，按所属项目保留稳定顺序。
fn pj_input_push(items **proj.PInput, count *int, capacity *int,
    off int, n int) int {
    if (count[0] == capacity[0]) {
        let ncap int = capacity[0] * 2
        if (ncap == 0) { ncap = 8 }
        let next *proj.PInput = malloc(
            (ncap * sizeof(proj.PInput)).to_type(u64)).to_type(*proj.PInput)
        if (next == 0) { return support.fail("C 项目输入表内存分配失败") }
        if (count[0] > 0) {
            memcpy(next, items[0], (count[0] * sizeof(proj.PInput)).to_type(u64))
        }
        if (items[0] != 0) { free(items[0].to_type(*void)) }
        items[0] = next
        capacity[0] = ncap
    }
    items[0][count[0]].path_off = off
    items[0][count[0]].path_len = n
    count[0] += 1
    return 0
}

// pj_c_path：验证项目相对路径、扩展名和文件存在性，返回规范化路径。
fn pj_c_path(pj int, item_off int, item_len int, suffix *char,
    line int, out_off *int, out_len *int) int {
    let c_off int = 0
    let c_len int = 0
    if (item_len == 0 || support.pool_ctx().data[item_off] == '/') {
        return proj.diag(proj.ctx().projs[pj].root_off, line,
            "[c] 路径必须是非空的项目相对路径")
    }
    let seg_start int = 0
    let path_i int = 0
    for path_i <= item_len {
        if (path_i == item_len || support.pool_ctx().data[item_off + path_i] == '/') {
            if (path_i - seg_start == 2
                && support.pool_ctx().data[item_off + seg_start] == '.'
                && support.pool_ctx().data[item_off + seg_start + 1] == '.') {
                return proj.diag(proj.ctx().projs[pj].root_off, line,
                    "[c] 路径不能含 .. 目录段")
            }
            seg_start = path_i + 1
        }
        path_i += 1
    }
    let suffix_len int = 0
    for suffix[suffix_len] != 0 { suffix_len += 1 }
    if (item_len <= suffix_len) {
        return proj.diag(proj.ctx().projs[pj].root_off, line,
            "[c] 路径扩展名不符合 sources/objects 要求")
    }
    let i int = 0
    for i < suffix_len {
        if (support.pool_ctx().data[item_off + item_len - suffix_len + i]
            != suffix[i].to_type(u8)) {
            return proj.diag(proj.ctx().projs[pj].root_off, line,
                "[c] 路径扩展名不符合 sources/objects 要求")
        }
        i += 1
    }
    let rel [1024]u8
    if (item_len >= 1024) {
        return proj.diag(proj.ctx().projs[pj].root_off, line, "[c] 路径过长")
    }
    i = 0
    for i < item_len {
        rel[i] = support.pool_ctx().data[item_off + i]
        i += 1
    }
    rel[item_len] = 0
    if (proj.canon(proj.ctx().projs[pj].root_off,
        proj.ctx().projs[pj].root_len, support.arr_cstr(rel), &c_off, &c_len) != 0) { return -1 }
    if (proj.file_exists(proj.pool_str(c_off)) == 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, line,
            "[c] 配置路径对应的文件不存在")
    }
    out_off[0] = c_off
    out_len[0] = c_len
    return 0
}

// pj_c_lib_name：限制系统库名为普通名字，避免把链接器选项当作库名传入。
fn pj_c_lib_name(off int, n int) int {
    if (n == 0) { return 0 }
    let i int = 0
    for i < n {
        let b u8 = support.pool_ctx().data[off + i]
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_' || b == '-')) { return 0 }
        i += 1
    }
    return 1
}

// pj_load_c_config：在递归依赖装载前快照并验证 [c] 的三个字符串数组。
fn pj_load_c_config(pj int, sec int) int {
    if (sec < 0) { return 0 }
    let vi int = 0
    for vi < toml_secs[sec].val_n {
        let val TomlVal = toml_secs[sec].vals[vi]
        let kind int = 0
        if (val.key_len == 7 && support.pool_ctx().data[val.key_off] == 's'
            && support.pool_ctx().data[val.key_off + 1] == 'o'
            && support.pool_ctx().data[val.key_off + 2] == 'u'
            && support.pool_ctx().data[val.key_off + 3] == 'r'
            && support.pool_ctx().data[val.key_off + 4] == 'c'
            && support.pool_ctx().data[val.key_off + 5] == 'e'
            && support.pool_ctx().data[val.key_off + 6] == 's') { kind = 1 }
        if (val.key_len == 7 && support.pool_ctx().data[val.key_off] == 'o'
            && support.pool_ctx().data[val.key_off + 1] == 'b'
            && support.pool_ctx().data[val.key_off + 2] == 'j'
            && support.pool_ctx().data[val.key_off + 3] == 'e'
            && support.pool_ctx().data[val.key_off + 4] == 'c'
            && support.pool_ctx().data[val.key_off + 5] == 't'
            && support.pool_ctx().data[val.key_off + 6] == 's') { kind = 2 }
        if (val.key_len == 4 && support.pool_ctx().data[val.key_off] == 'l'
            && support.pool_ctx().data[val.key_off + 1] == 'i'
            && support.pool_ctx().data[val.key_off + 2] == 'b'
            && support.pool_ctx().data[val.key_off + 3] == 's') { kind = 3 }
        if (kind == 0) {
            return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                "[c] 未知字段（仅支持 sources、objects、libs）")
        }
        if (val.kind != 4 || val.arr_first < 0 || val.arr_count < 0
            || val.arr_first + val.arr_count > toml_array_n) {
            return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                "[c] sources、objects、libs 必须是字符串数组")
        }
        let ai int = 0
        for ai < val.arr_count {
            let item TomlArrayItem = toml_array_items[val.arr_first + ai]
            let off int = item.sval_off
            let n int = item.sval_len
            if (kind == 1 || kind == 2) {
                let suffix *char = kind == 1 ? ".c" : ".o"
                let path_off int = 0
                let path_len int = 0
                if (pj_c_path(pj, off, n, suffix, val.line,
                    &path_off, &path_len) != 0) { return -1 }
                if (kind == 1) {
                    if (pj_input_push(&proj.ctx().projs[pj].c_sources,
                        &proj.ctx().projs[pj].c_source_n,
                        &proj.ctx().projs[pj].c_source_cap, path_off, path_len) != 0) { return -1 }
                } else if (pj_input_push(&proj.ctx().projs[pj].c_objects,
                    &proj.ctx().projs[pj].c_object_n,
                    &proj.ctx().projs[pj].c_object_cap, path_off, path_len) != 0) { return -1 }
            } else {
                if (pj_c_lib_name(off, n) == 0) {
                    return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                        "[c] libs 元素必须是普通系统库名")
                }
                if (pj_input_push(&proj.ctx().projs[pj].c_libs,
                    &proj.ctx().projs[pj].c_lib_n, &proj.ctx().projs[pj].c_lib_cap,
                    off, n) != 0) { return -1 }
            }
            ai += 1
        }
        vi += 1
    }
    return 0
}

// pj_env_diag：拼「前缀 + 键名」诊断并输出到清单行；失败 -1。
fn pj_env_diag(root_off int, line int, msg *char, key_off int, key_len int) int {
    let buf [256]u8
    let n int = 0
    n = support.append_str(buf, n, msg)
    let k int = 0
    for k < key_len && n < 200 && key_off >= 0 {
        buf[n] = support.pool_ctx().data[key_off + k]
        n += 1
        k += 1
    }
    let mo int = support.tml_intern_str(buf, 0, n)
    if (mo < 0) { return -1 }
    return proj.diag(root_off, line, support.np_cstr(mo))
}

// pj_load_env_config：[env] 节 → 项目快照（环境变量默认值）。
//
// 只接受字符串值；键名必须是合法变量名（字母或下划线开头，其后仅字母、数字、
// 下划线）。值原样保存、不做路径规范化，也不递归展开——它只参与清单里
// `${NAME}` 的展开（见 link.li_expand_vars），由引用处决定绝对/相对语义。
// 进程环境优先于 [env]，所以每台构建机可以不改清单就换掉某条路径。
fn pj_load_env_config(pj int, sec int) int {
    if (sec < 0 || sec >= toml_sec_n) { return 0 }
    let root_off int = proj.ctx().projs[pj].root_off
    let i int = 0
    for i < toml_secs[sec].val_n {
        let v *TomlVal = &toml_secs[sec].vals[i]
        let key_off int = v.key_off
        let key_len int = v.key_len
        if (key_off < 0 || key_len <= 0) {
            return proj.diag(root_off, v.line, "env 键无法解析")
        }
        let name_ok int = key_len > 0 ? 1 : 0
        let k int = 0
        for k < key_len {
            let c u8 = support.pool_ctx().data[key_off + k]
            let is_alpha int = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') ? 1 : 0
            let is_digit int = (c >= '0' && c <= '9') ? 1 : 0
            if (is_alpha == 0 && (is_digit == 0 || k == 0)) { name_ok = 0 }
            k += 1
        }
        if (name_ok == 0) {
            return pj_env_diag(root_off, v.line, "env 变量名非法: ", key_off, key_len)
        }
        if (v.kind != 1) {
            return pj_env_diag(root_off, v.line, "env 值必须是字符串: ", key_off, key_len)
        }
        if (v.sval_off < 0 || v.sval_len < 0) {
            return proj.diag(root_off, v.line, "env 值无法解析")
        }
        if (proj.ctx().projs[pj].env_n == proj.ctx().projs[pj].env_cap) {
            let ncap int = proj.ctx().projs[pj].env_cap * 2
            if (ncap == 0) { ncap = 8 }
            let ne *proj.PEnv = malloc(
                (ncap * sizeof(proj.PEnv)).to_type(u64)).to_type(*proj.PEnv)
            if (ne == 0) { return support.fail("内存分配失败") }
            if (proj.ctx().projs[pj].env_n > 0) {
                memcpy(ne, proj.ctx().projs[pj].envs,
                    (proj.ctx().projs[pj].env_n * sizeof(proj.PEnv)).to_type(u64))
            }
            if (proj.ctx().projs[pj].envs != 0) {
                free(proj.ctx().projs[pj].envs.to_type(*void))
            }
            proj.ctx().projs[pj].envs = ne
            proj.ctx().projs[pj].env_cap = ncap
        }
        let at int = proj.ctx().projs[pj].env_n
        proj.ctx().projs[pj].envs[at].name_off = key_off
        proj.ctx().projs[pj].envs[at].name_len = key_len
        proj.ctx().projs[pj].envs[at].val_off = v.sval_off
        proj.ctx().projs[pj].envs[at].val_len = v.sval_len
        proj.ctx().projs[pj].envs[at].line = v.line
        proj.ctx().projs[pj].env_n += 1
        i += 1
    }
    return 0
}

fn pj_scan_source(dir_off int, dir_len int, pj int) int {
    let entries *PJDirEntry = 0.to_type(*PJDirEntry)
    let es_n int = 0
    let es_cap int = 0
    if (pj_os_dir_list(proj.pool_str(dir_off), &entries, &es_n, &es_cap) != 0) {
        if (entries != 0) { free(entries.to_type(*void)) }
        return -1
    }
    pj_dir_sort(entries, es_n)
    let e int = 0
    for e < es_n {
        if (pj_scan_entry(dir_off, dir_len, entries[e].name_off,
            entries[e].name_len, entries[e].is_dir, pj) != 0) {
            free(entries.to_type(*void))
            return -1
        }
        e += 1
    }
    if (entries != 0) { free(entries.to_type(*void)) }
    return 0
}

// pj_name_is_test：文件名是否以 .test.yh 结尾（VTEST，2026-11-05）。
// .test.yh 是测试文件的唯一标识：扫描排序保证它们排在非测试文件之后，
// 文件名本身不再承担排序语义（zz_/99_ 前缀已废止）。
fn pj_name_is_test(name_off int, name_len int) int {
    if (name_len < 8) { return 0 }
    let s int = name_off + name_len - 8
    let tag *char = ".test.yh"
    let i int = 0
    for i < 8 {
        if (support.pool_ctx().data[s + i] != tag[i].to_type(u8)) { return 0 }
        i += 1
    }
    return 1
}

// pj_dir_less：按文件名字节序排序，保证跨宿主扫描与构建顺序稳定；
// 例外：*.test.yh 测试文件一律排在非测试文件之后（它们引用生产声明，
// 且文件名不再带排序前缀）。
fn pj_dir_less(a PJDirEntry, b PJDirEntry) int {
    let at int = pj_name_is_test(a.name_off, a.name_len)
    let bt int = pj_name_is_test(b.name_off, b.name_len)
    if (at != bt) {
        return bt
    }
    let n int = a.name_len
    if (b.name_len < n) { n = b.name_len }
    let i int = 0
    for i < n {
        let av int = support.pool_ctx().data[a.name_off + i].to_type(int)
        let bv int = support.pool_ctx().data[b.name_off + i].to_type(int)
        if (av < bv) { return 1 }
        if (av > bv) { return 0 }
        i += 1
    }
    return (a.name_len < b.name_len).to_type(int)
}

// pj_dir_sort：按小目录常见情况原地插入排序，不另申请排序缓冲。
fn pj_dir_sort(entries *PJDirEntry, n int) int {
    let i int = 1
    for i < n {
        let item PJDirEntry = entries[i]
        let j int = i
        for j > 0 && pj_dir_less(item, entries[j - 1]) != 0 {
            entries[j] = entries[j - 1]
            j -= 1
        }
        entries[j] = item
        i += 1
    }
    return 0
}

// pj_scan_skip_dir：源码根内的构建产物目录不参与扫描。
// `tmp/` 与 `.build/` 可能位于源码根之下（例如标准库项目 source = "."），
// 其中的生成文件（含 yh test 的测试入口）不是用户源码。
fn pj_scan_skip_dir(name_start int, name_len int) int {
    if (name_len == 3 && support.pool_ctx().data[name_start] == 't'
        && support.pool_ctx().data[name_start + 1] == 'm'
        && support.pool_ctx().data[name_start + 2] == 'p') {
        return 1
    }
    if (name_len == 6 && support.pool_ctx().data[name_start] == '.'
        && support.pool_ctx().data[name_start + 1] == 'b'
        && support.pool_ctx().data[name_start + 2] == 'u'
        && support.pool_ctx().data[name_start + 3] == 'i'
        && support.pool_ctx().data[name_start + 4] == 'l'
        && support.pool_ctx().data[name_start + 5] == 'd') {
        return 1
    }
    return 0
}

// pj_scan_is_target：单文件模式下，path 是否就是被选中的那个文件。
fn pj_scan_is_target(path *char) int {
    if (proj.ctx().scan_file_off < 0) { return 1 }
    let n int = 0
    for path[n] != 0 { n += 1 }
    if (n != proj.ctx().scan_file_len) { return 0 }
    let i int = 0
    for i < n {
        if (support.pool_ctx().data[proj.ctx().scan_file_off + i] != path[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    return 1
}

// pj_scan_applies：--scan-file 是否适用于该项目。
// 单文件测试的扫描过滤只约束**被测项目**（扫描文件位于其源码根之下）；标准库与
// 依赖项目的文件必须整份索引，否则无 fork 宿主（Windows）的模块子进程里会出现
// “模块不存在: string/memory”——子进程会重新装载索引，父进程的 fork 路径不会。
fn pj_scan_applies(project int) int {
    let ctx *proj.ProjectCtx = proj.ctx()
    if (ctx.scan_file_off < 0) { return 0 }
    if (project < 0 || project >= ctx.proj_n) { return 0 }
    let root_off int = ctx.projs[project].src_off
    let root_len int = ctx.projs[project].src_len
    if (root_len <= 0 || root_len > ctx.scan_file_len) { return 0 }
    let i int = 0
    for i < root_len {
        if (support.pool_ctx().data[root_off + i] != support.pool_ctx().data[ctx.scan_file_off + i]) {
            return 0
        }
        i += 1
    }
    return 1
}

fn pj_scan_entry(dir_off int, dir_len int, name_start int, name_len int, is_dir int, pj int) int {
    let c_off int = 0
    let c_len int = 0
    if (is_dir != 0) {
        // 单文件模式（yh test <项目外文件>）不进入任何子目录，也不装入相邻文件。
        // 只对被测项目生效（见 pj_scan_applies）。
        if (pj_scan_applies(pj) != 0) { return 0 }
        if (pj_scan_skip_dir(name_start, name_len) != 0) { return 0 }
        // 子目录相对路径：<dir>/<name>，规范化后递归
        let nm [300]u8
        let nn int = 0
        let k2 int = 0
        for k2 < name_len {
            nm[nn] = support.pool_ctx().data[name_start + k2]
            nn += 1
            k2 += 1
        }
        nm[nn] = 0
        if (proj.canon(dir_off, dir_len, support.arr_cstr(nm), &c_off, &c_len) != 0) {
            return -1
        }
        let sub_off int = c_off
        let sub_len int = c_len
        // 嵌套项目边界：含 mod.toml 的子目录属于另一项目，不进入
        let probe [1100]u8
        let pn int = 0
        pn = support.append_str(probe, pn, proj.pool_str(sub_off))
        pn = support.append_str(probe, pn, "/project.toml")
        probe[pn] = 0
        if (proj.file_exists(support.arr_cstr(probe)) != 0) {
            return 0
        }
        return pj_scan_source(sub_off, sub_len, pj)
    }
    if (pj_source_target_match(name_start, name_len) == 0) {
        return 0
    }
    // .yh 后缀检查
    if (name_len < 3 || support.pool_ctx().data[name_start + name_len - 3] != '.'
        || support.pool_ctx().data[name_start + name_len - 2] != 'y' || support.pool_ctx().data[name_start + name_len - 1] != 'h') {
        return 0
    }
    // 完整路径 = <dir>/<name>
    let full [1100]u8
    let flen2 int = 0
    flen2 = support.append_str(full, flen2, proj.pool_str(dir_off))
    full[flen2] = '/'
    flen2 += 1
    let k int = 0
    for k < name_len {
        full[flen2] = support.pool_ctx().data[name_start + k]
        flen2 += 1
        k += 1
    }
    full[flen2] = 0
    // 单文件模式：只接受选中的那一个文件，其它相邻 .yh 一律忽略（只对被测项目生效）。
    if (pj_scan_applies(pj) != 0
        && pj_scan_is_target(support.arr_cstr(&full[0])) == 0) { return 0 }
    // 读文件并解析模块头（诊断指向被扫文件）
    let save_path *char = support.src_ctx().path
    support.src_ctx().path = support.arr_cstr(full)
    let r int = pj_index_file(support.arr_cstr(full), pj)
    support.src_ctx().path = save_path
    return r
}

// pj_target_tag_is：比较名称池中的单个后缀段，不要求池内文件名带 NUL。
fn pj_target_tag_is(start int, n int, tag *char) int {
    let i int = 0
    for tag[i] != 0 {
        if (i >= n || support.pool_ctx().data[start + i] != tag[i].to_type(u8)) { return 0 }
        i += 1
    }
    return (i == n).to_type(int)
}

// pj_source_target_match：从 .yh 前向左读取目标后缀段，OS/架构均须匹配当前 TargetInfo。
// 标记：.linux/.darwin/.windows（OS）与 .arm64/.x64（架构）；未识别段按普通文件名接受
// ——所以新增 `*.windows.yh` 前必须先在此登记，否则会被所有目标编入（方案 §4.2）。
fn pj_source_target_match(name_start int, name_len int) int {
    let end int = name_start + name_len - 3
    for end > name_start {
        let dot int = end - 1
        for dot >= name_start && support.pool_ctx().data[dot] != '.' { dot -= 1 }
        if (dot < name_start) { return 1 }
        let start int = dot + 1
        let n int = end - start
        if (pj_target_tag_is(start, n, "linux") != 0) {
            if (proj.cfg().target.os != support.TARGET_OS_LINUX) { return 0 }
        } else if (pj_target_tag_is(start, n, "darwin") != 0) {
            if (proj.cfg().target.os != support.TARGET_OS_DARWIN) { return 0 }
        } else if (pj_target_tag_is(start, n, "windows") != 0) {
            if (proj.cfg().target.os != support.TARGET_OS_WINDOWS) { return 0 }
        } else if (pj_target_tag_is(start, n, "arm64") != 0) {
            if (proj.cfg().target.arch != support.TARGET_ARCH_ARM64) { return 0 }
        } else if (pj_target_tag_is(start, n, "x64") != 0) {
            if (proj.cfg().target.arch != support.TARGET_ARCH_X64) { return 0 }
        } else { return 1 }
        end = dot
    }
    return 1
}

// pj_synth_module_name：从文件路径派生标识符模块名（去目录、去 .yh、非法字符转 _，
// 首字符非字母时前置 _）。写入 task 的 mod_name_off/mod_name_len 并置 has_module。
fn pj_synth_module_name(path *char) int {
    let base int = 0
    let i int = 0
    for path[i] != 0 {
        if (path[i] == '/') { base = i + 1 }
        i += 1
    }
    let end int = i
    if (end - base > 3 && path[end - 3] == '.' && path[end - 2] == 'y'
        && path[end - 1] == 'h') {
        end -= 3
    }
    if (end <= base) { return support.fail("单文件测试无法从文件名派生模块名") }
    let tmp [160]u8
    let n int = 0
    let k int = base
    for k < end {
        let c u8 = path[k].to_type(u8)
        let ok int = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
            (c >= '0' && c <= '9') || c == '_'
        if (ok != 0) {
            tmp[n] = c
        } else {
            tmp[n] = '_'
        }
        n += 1
        k += 1
    }
    if (tmp[0] >= 48 && tmp[0] <= 57) {
        // 首字符不能是数字：前置下划线后整体后移。
        let m int = n
        for m > 0 {
            tmp[m] = tmp[m - 1]
            m -= 1
        }
        tmp[0] = '_'
        n += 1
    }
    let off int = support.tml_intern_str(&tmp[0], 0, n)
    if (off < 0) { return -1 }
    support.fs().name_off = off
    support.fs().name_len = n
    support.fs().has_module = 1
    return 0
}

// pj_dir_prefix_len：路径的目录前缀长度（最后一个 '/' 之前；无 '/' 为 0）。
fn pj_dir_prefix_len(off int, plen int) int {
    let last int = -1
    let i int = 0
    for i < plen {
        if (support.pool_ctx().data[off + i] == '/') {
            last = i
        }
        i += 1
    }
    if (last < 0) {
        return 0
    }
    return last
}

// pj_same_np：名字池两段字节相等。
fn pj_same_np(o1 int, l1 int, o2 int, l2 int) int {
    if (l1 != l2) {
        return 0
    }
    let j int = 0
    for j < l1 {
        if (support.pool_ctx().data[o1 + j] != support.pool_ctx().data[o2 + j]) {
            return 0
        }
        j += 1
    }
    return 1
}

// pj_imp_alias_match：文件 f 的第 ti 个 token 是否等于导入 ii 的绑定名。
fn pj_imp_alias_match(f int, ti int, ii int) int {
    let tok token.Tok = proj.ctx().files[f].tokens[ti]
    let n int = proj.ctx().imp_alias_len[ii]
    if (tok.kind != token.TOK_IDENT || tok.len != n) {
        return 0
    }
    let j int = 0
    for j < n {
        if (proj.ctx().files[f].source[tok.start + j]
            != support.pool_ctx().data[proj.ctx().imp_alias_off[ii] + j]) {
            return 0
        }
        j += 1
    }
    return 1
}

// pj_mark_test_tokens：把文件 f 中每个顶层 test 声明的块体 token 标记为 1。
// 用于区分「只在 test 体内使用」的导入；只扫描 token，不做语义解析。
fn pj_mark_test_tokens(f int) *u8 {
    let n int = proj.ctx().files[f].token_n
    if (n <= 0) { return 0 }
    let marks *u8 = malloc(n.to_type(u64)).to_type(*u8)
    if (marks == 0) { return 0 }
    let i int = 0
    for i < n {
        marks[i] = 0
        i += 1
    }
    let depth int = 0
    i = 0
    for i < n {
        let k int = proj.ctx().files[f].tokens[i].kind
        if (k == token.TK_LBRACE) {
            depth += 1
            i += 1
            continue
        }
        if (k == token.TK_RBRACE) {
            if (depth > 0) { depth -= 1 }
            i += 1
            continue
        }
        if (depth == 0 && k == token.TK_TEST
            && (i == 0 || proj.ctx().files[f].tokens[i - 1].kind != token.TK_DOT)) {
            let j int = i + 1
            for j < n {
                let jk int = proj.ctx().files[f].tokens[j].kind
                if (jk == token.TK_LBRACE || jk == token.TK_SEMI || jk == token.TOK_EOF) {
                    break
                }
                j += 1
            }
            if (j < n && proj.ctx().files[f].tokens[j].kind == token.TK_LBRACE) {
                let d int = 0
                let e int = j
                for e < n {
                    let ek int = proj.ctx().files[f].tokens[e].kind
                    if (ek == token.TK_LBRACE) { d += 1 }
                    if (ek == token.TK_RBRACE) {
                        d -= 1
                        if (d == 0) { break }
                    }
                    e += 1
                }
                if (e < n) {
                    let q int = j
                    for q <= e {
                        marks[q] = 1
                        q += 1
                    }
                    i = e + 1
                    continue
                }
            }
        }
        i += 1
    }
    return marks
}

// pj_classify_test_imports：为项目 pj 的每条导入分类 test_only。
// 仅当绑定名以 `alias.` 形式出现，且所有出现都在该文件的 test 块体内，
// 才标记为测试专用；生产构建随后跳过该导入的绑定、依赖边和未使用诊断。
fn pj_classify_test_imports(pj int) int {
    let mi int = 0
    for mi < proj.ctx().projs[pj].mod_n {
        let m int = proj.ctx().projs[pj].mods[mi]
        let fi int = 0
        for fi < proj.ctx().mods[m].file_n {
            let f int = proj.ctx().mods[m].files[fi]
            let marks *u8 = pj_mark_test_tokens(f)
            if (marks == 0) {
                if (proj.ctx().files[f].token_n > 0) { return support.fail("内存分配失败") }
                fi += 1
                continue
            }
            let ii int = 0
            for ii < proj.ctx().imp_n {
                if (proj.ctx().imp_file[ii] != f) {
                    ii += 1
                    continue
                }
                let inside int = 0
                let outside int = 0
                let ti int = 0
                let n int = proj.ctx().files[f].token_n
                for ti + 1 < n {
                    if (proj.ctx().files[f].tokens[ti].kind == token.TOK_IDENT
                        && proj.ctx().files[f].tokens[ti + 1].kind == token.TK_DOT
                        && pj_imp_alias_match(f, ti, ii) != 0) {
                        if (marks[ti] != 0) {
                            inside = 1
                        } else {
                            outside = 1
                            break
                        }
                    }
                    ti += 1
                }
                proj.ctx().imp_test_only[ii] = (inside != 0 && outside == 0).to_type(int)
                ii += 1
            }
            free(marks.to_type(*void))
            fi += 1
        }
        mi += 1
    }
    return 0
}
