module build
import gen
import backend
import proj

// mb_hash_hex：把 64 位内容指纹格式化为固定长度十六进制串。
fn mb_hash_hex(h u64, out *u8) int {
    let digits *char = "0123456789abcdef"
    let n int = 0
    let shift int = 60
    for shift >= 0 {
        out[n] = digits[((h >> shift) & 15).to_type(int)].to_type(u8)
        n += 1
        shift -= 4
    }
    return n
}

// mb_write_manifest：写缓存键；写失败时不保留可被误认的旧键。
fn mb_write_manifest(path *char, data *u8, data_len int) int {
    let tmp [800]u8
    let n int = gen.append_str(&tmp[0], 0, path)
    n = gen.append_str(&tmp[0], n, ".tmp.")
    n = gen.append_int(&tmp[0], n, getpid())
    tmp[n] = 0
    let fd int = mb_open_out((&tmp[0]).to_type(*char))
    if (fd < 0) {
        return gen.fail_path("无法写缓存 manifest: ", path)
    }
    if (gen.write_all(fd, data, data_len) != 0) {
        close(fd)
        unlink((&tmp[0]).to_type(*char))
        return -1
    }
    if (close(fd) != 0) {
        unlink((&tmp[0]).to_type(*char))
        return gen.fail_path("关闭缓存 manifest 失败: ", path)
    }
    if (rename((&tmp[0]).to_type(*char), path) != 0) {
        unlink((&tmp[0]).to_type(*char))
        return gen.fail_path("无法提交缓存 manifest: ", path)
    }
    return 0
}

// mb_object_machine_matches：校验对象或程序头与当前目标的文件格式和 machine 一致。
// Linux 只接受 ELF64 little-endian，Darwin 只接受 Mach-O 64 little-endian。
fn mb_object_machine_matches(path *char) int {
    let tk *gen.TaskCtx = gen.task()
    if (gen.read_source(path) != 0 || tk.c_src_len < 20) { return 0 }
    if (proj.cfg().target.os == gen.TARGET_OS_LINUX) {
        if (tk.c_src[0] != 127 || tk.c_src[1] != 'E' || tk.c_src[2] != 'L'
            || tk.c_src[3] != 'F' || tk.c_src[4] != 2 || tk.c_src[5] != 1) {
            return 0
        }
        let machine int = tk.c_src[18].to_type(int) |
            (tk.c_src[19].to_type(int) << 8)
        if (proj.cfg().target.arch == gen.TARGET_ARCH_X64) { return machine == 62 ? 1 : 0 }
        if (proj.cfg().target.arch == gen.TARGET_ARCH_ARM64) { return machine == 183 ? 1 : 0 }
        return 0
    }
    if (proj.cfg().target.os == gen.TARGET_OS_DARWIN && tk.c_src_len >= 8
        && tk.c_src[0] == 207 && tk.c_src[1] == 250
        && tk.c_src[2] == 237 && tk.c_src[3] == 254) {
        let cpu int = tk.c_src[4].to_type(int) |
            (tk.c_src[5].to_type(int) << 8) |
            (tk.c_src[6].to_type(int) << 16) |
            (tk.c_src[7].to_type(int) << 24)
        if (proj.cfg().target.arch == gen.TARGET_ARCH_X64) { return cpu == 16777223 ? 1 : 0 }
        if (proj.cfg().target.arch == gen.TARGET_ARCH_ARM64) { return cpu == 16777228 ? 1 : 0 }
    }
    return 0
}

// mb_c_project_order：前序收集根项目及其本地依赖，去重并保持清单顺序。
fn mb_c_project_order(pj int, projects *int, count *int, capacity int) int {
    if (pj < 0 || pj >= proj.ctx().proj_n) { return -1 }
    let i int = 0
    for i < count[0] {
        if (projects[i] == pj) { return 0 }
        i += 1
    }
    if (count[0] >= capacity) { return gen.fail("C 项目依赖数量超出限制") }
    projects[count[0]] = pj
    count[0] += 1
    let dep int = 0
    for dep < proj.ctx().projs[pj].dep_n {
        let child int = proj.ctx().projs[pj].deps[dep].proj
        if (mb_c_project_order(child, projects, count, capacity) != 0) { return -1 }
        dep += 1
    }
    return 0
}

// mb_c_obj_path：生成当前 build 目录下某个 C 源文件对应的对象路径。
fn mb_c_obj_path(build_off int, project int, source_index int, out *u8) int {
    let n int = 0
    n = gen.append_str(out, n, proj.pool_str(build_off))
    n = gen.append_str(out, n, "/obj/c-")
    n = gen.append_int(out, n, project)
    n = gen.append_byte(out, n, '-')
    n = gen.append_int(out, n, source_index)
    n = gen.append_str(out, n, ".o")
    out[n] = 0
    return n
}

// mb_c_compile_sources：每次 build/run 重编可达项目的 C 源，避免漏掉头文件变化。
fn mb_c_compile_sources(projects *int, project_count int,
    build_off int, cc *char) int {
    let pi int = 0
    for pi < project_count {
        let pj int = projects[pi]
        let si int = 0
        for si < proj.ctx().projs[pj].c_source_n {
            let out [700]u8
            mb_c_obj_path(build_off, pj, si, out)
            unlink(gen.arr_cstr(out))
            let args [6]*char
            args[0] = cc
            args[1] = "-c"
            args[2] = proj.pool_str(proj.ctx().projs[pj].c_sources[si].path_off)
            args[3] = "-o"
            args[4] = gen.arr_cstr(out)
            args[5] = 0.to_type(*char)
            if (cmd_process_run(&args[0]) != 0) {
                return gen.fail_path("C 源文件编译失败: ", args[2])
            }
            let object [700]u8
            mb_c_obj_path(build_off, pj, si, &object[0])
            if (mb_object_machine_matches(gen.arr_cstr(&object[0])) == 0) {
                return gen.fail_path("C 目标文件架构与当前 target 不符: ",
                    gen.arr_cstr(&object[0]))
            }
            si += 1
        }
        pi += 1
    }
    return 0
}

// mb_c_input_hash：把 C 对象内容、输入路径和系统库名纳入最终链接缓存键。
fn mb_c_input_hash(hash *u64, projects *int, project_count int,
    build_off int) int {
    let tk *gen.TaskCtx = gen.task()
    let pi int = 0
    for pi < project_count {
        let pj int = projects[pi]
        let si int = 0
        for si < proj.ctx().projs[pj].c_source_n {
            let object [700]u8
            mb_c_obj_path(build_off, pj, si, object)
            if (mb_object_machine_matches(gen.arr_cstr(object)) == 0) {
                return gen.fail_path("C 目标文件架构与当前 target 不符: ",
                    gen.arr_cstr(object))
            }
            if (mb_hash_file(hash, gen.arr_cstr(object)) != 0) { return -1 }
            let path_off int = proj.ctx().projs[pj].c_sources[si].path_off
            let path_len int = proj.ctx().projs[pj].c_sources[si].path_len
            let j int = 0
            for j < path_len { mb_fnv(hash, tk.np_data[path_off + j]); j += 1 }
            mb_fnv(hash, 0)
            si += 1
        }
        let oi int = 0
        for oi < proj.ctx().projs[pj].c_object_n {
            let input proj.PInput = proj.ctx().projs[pj].c_objects[oi]
            if (mb_object_machine_matches(proj.pool_str(input.path_off)) == 0) {
                return gen.fail_path("C 目标文件架构与当前 target 不符: ",
                    proj.pool_str(input.path_off))
            }
            if (mb_hash_file(hash, proj.pool_str(input.path_off)) != 0) { return -1 }
            let j2 int = 0
            for j2 < input.path_len { mb_fnv(hash, tk.np_data[input.path_off + j2]); j2 += 1 }
            mb_fnv(hash, 0)
            oi += 1
        }
        let li int = 0
        for li < proj.ctx().projs[pj].c_lib_n {
            let lib proj.PInput = proj.ctx().projs[pj].c_libs[li]
            let j3 int = 0
            for j3 < lib.path_len { mb_fnv(hash, tk.np_data[lib.path_off + j3]); j3 += 1 }
            mb_fnv(hash, 255)
            li += 1
        }
        pi += 1
    }
    return 0
}

// mb_link：把模块汇编与可达项目 C 输入转对象并链接，缓存键覆盖全部对象。
// mb_asm_tool：决定把模块 .s 变成 .o 用哪个工具（legacy 后端专用）。
//
// 返回 1 表示用外部汇编器 yh_link，并把它的路径写进 candidate（调用方给的
// 定长缓冲）；返回 0 表示回落系统 cc（darwin 上 clang，其余 gcc）。
//
// 查找顺序：
//   1. 环境变量 YH_LINK——显式指定，优先级最高。
//   2. PATH 上的 yh_link——把兼容汇编器装进 bin 目录时自然命中；
//      门禁脚本也靠这一条把 wrapper 插到 PATH 前面来观测真实进程调用。
//   3. 编译器可执行文件同目录下的 yh_link——`yh` 与兼容汇编器放在一起但
//      目录不在 PATH 上时仍然能自动用上。
//
// 兼容汇编器的汇编子集需与本编译器的发射方言一一对应（@PAGE/@PAGEOFF、
// _ 前缀符号），所以两边可以互换；对不上时应由汇编器报错而不是静默用 cc，
// 因此这里只按「文件在不在」判断，不做能力探测。
fn mb_asm_tool(candidate *u8) int {
    let tk *gen.TaskCtx = gen.task()
    let env_off int = -1
    let env_len int = 0
    if (proj.env_fetch("YH_LINK", &env_off, &env_len) != 0) {
        return 0
    }
    if (env_len > 0 && tk.np_data[env_off] != 0) {
        let n int = 0
        let k int = 0
        for k < env_len {
            candidate[n] = tk.np_data[env_off + k]
            n += 1
            k += 1
        }
        candidate[n] = 0
        if (proj.file_exists(gen.arr_cstr(candidate)) != 0) {
            return 1
        }
        return 0
    }
    if (mb_path_find("yh_link", candidate) != 0) {
        return 1
    }
    // 与 c_argv0 同目录的 yh_link
    let slash int = -1
    let i int = 0
    for c_argv0[i] != 0 {
        if (c_argv0[i] == '/') {
            slash = i
        }
        i += 1
    }
    let n int = 0
    let k int = 0
    for k <= slash {
        candidate[n] = c_argv0[k].to_type(u8)
        n += 1
        k += 1
    }
    n = gen.append_str(candidate, n, "yh_link")
    candidate[n] = 0
    if (proj.file_exists(gen.arr_cstr(candidate)) != 0) {
        return 1
    }
    return 0
}

// mb_path_find：在 PATH 上查找名为 name 的文件。找到返回 1 并把**绝对路径**
// 写进 candidate（调用方给的定长缓冲）；找不到返回 0。
// 空目录项按 POSIX 惯例解释为当前目录。
fn mb_path_find(name *char, candidate *u8) int {
    let tk *gen.TaskCtx = gen.task()
    let path_off int = -1
    let path_len int = 0
    if (proj.env_fetch("PATH", &path_off, &path_len) != 0) {
        return 0
    }
    let start int = 0
    let end int = 0
    for end <= path_len {
        if (end == path_len || tk.np_data[path_off + end] == ':') {
            let n int = 0
            if (end == start) {
                n = gen.append_str(candidate, n, ".")
            } else {
                let k int = start
                for k < end {
                    candidate[n] = tk.np_data[path_off + k]
                    n += 1
                    k += 1
                }
            }
            n = gen.append_byte(candidate, n, '/')
            n = gen.append_str(candidate, n, name)
            candidate[n] = 0
            if (proj.file_exists(gen.arr_cstr(candidate)) != 0) {
                return 1
            }
            start = end + 1
        }
        end += 1
    }
    return 0
}

// mb_hash_tool_identity：把工具解析路径与文件内容纳入缓存身份；原路径更新版本时缓存失效。
fn mb_hash_tool_identity(hash *u64, command *char) int {
    let resolved [1200]u8
    let has_slash int = 0
    let i int = 0
    for command[i] != 0 {
        if (command[i] == '/') { has_slash = 1 }
        i += 1
    }
    if (has_slash != 0) {
        i = 0
        for command[i] != 0 { resolved[i] = command[i].to_type(u8); i += 1 }
        resolved[i] = 0
    } else if (mb_path_find(command, &resolved[0]) == 0) {
        return gen.fail_path("找不到工具: ", command)
    }
    i = 0
    for resolved[i] != 0 { mb_fnv(hash, resolved[i]); i += 1 }
    mb_fnv(hash, 0)
    // PC7a：工具身份按 (size, mtime_ns)，不再每轮哈希整个链接器/驱动二进制。
    if (mb_mix_file_identity(hash, (&resolved[0]).to_type(*char)) != 0) {
        return gen.fail_path("无法读取工具状态: ", (&resolved[0]).to_type(*char))
    }
    return 0
}

// mb_lld_linux_enabled：Linux x64/AArch64 target 且当前 yh 内嵌 lld 时启用进程内链接。
// 目标 ELF 的启动文件、动态加载器与默认库由固定宿主 GCC 的 -### 配置生成；
// 两架构各自在对应宿主构建，不共享架构专用模板。
fn mb_lld_linux_enabled() int {
    if (proj.cfg().target.os != gen.TARGET_OS_LINUX
        || (proj.cfg().target.arch != gen.TARGET_ARCH_X64
            && proj.cfg().target.arch != gen.TARGET_ARCH_ARM64)) {
        return 0
    }
    let identity *char = backend.llvm_lld_identity()
    if (identity == 0 || identity[0] == 0) { return 0 }
    return 1
}

// mb_hash_lld_library：混入库名与 lld 实际会解析到的库文件内容。
// required=1 用于固定模板库；项目库缺失时留给 lld 产生标准链接诊断。
fn mb_hash_lld_library(hash *u64, name *char, required int) int {
    if (name == 0) { return gen.fail("lld 链接库名为空") }
    let i int = 0
    for name[i] != 0 {
        mb_fnv(hash, name[i].to_type(u8))
        i += 1
    }
    mb_fnv(hash, 0)
    let path [1200]u8
    let resolved int = backend.llvm_lld_resolve_library(name,
        (&path[0]).to_type(*char))
    if (resolved == 0) {
        i = 0
        for path[i] != 0 {
            mb_fnv(hash, path[i].to_type(u8))
            i += 1
        }
        mb_fnv(hash, 255)
        return mb_hash_file(hash, gen.arr_cstr(path))
    }
    if (resolved < 0) { return gen.fail_path("无法解析 lld 链接库: ", name) }
    mb_fnv(hash, 254)
    if (required != 0) { return gen.fail_path("找不到 lld 默认链接库: ", name) }
    return 0
}

// mb_hash_lld_identity：把 shim/SDK/默认链接模板、宿主环境与所有系统链接输入计入缓存键。
fn mb_hash_lld_identity(hash *u64, projects *int, project_count int) int {
    let tk *gen.TaskCtx = gen.task()
    let identity *char = backend.llvm_lld_identity()
    if (identity == 0 || identity[0] == 0) {
        return gen.fail("当前 yh 未内嵌可用的 Linux lld 驱动")
    }
    let i int = 0
    for identity[i] != 0 {
        mb_fnv(hash, identity[i].to_type(u8))
        i += 1
    }
    mb_fnv(hash, 0)

    let env_names [3]*char
    env_names[0] = "LIBRARY_PATH"
    env_names[1] = "LD_RUN_PATH"
    env_names[2] = 0.to_type(*char)
    let ei int = 0
    for env_names[ei] != 0 {
        let env_off int = -1
        let env_len int = 0
        if (proj.env_fetch(env_names[ei], &env_off, &env_len) != 0) { return -1 }
        i = 0
        for env_names[ei][i] != 0 {
            mb_fnv(hash, env_names[ei][i].to_type(u8))
            i += 1
        }
        mb_fnv(hash, 0)
        let j int = 0
        for j < env_len {
            mb_fnv(hash, tk.np_data[env_off + j])
            j += 1
        }
        mb_fnv(hash, 255)
        ei += 1
    }

    let file_count int = backend.llvm_lld_default_file_count()
    i = 0
    for i < file_count {
        let path *char = backend.llvm_lld_default_file(i)
        if (path == 0) { return gen.fail("lld 默认启动文件清单损坏") }
        let j int = 0
        for path[j] != 0 {
            mb_fnv(hash, path[j].to_type(u8))
            j += 1
        }
        mb_fnv(hash, 0)
        if (mb_hash_file(hash, path) != 0) { return -1 }
        i += 1
    }
    let library_count int = backend.llvm_lld_default_library_count()
    i = 0
    for i < library_count {
        if (mb_hash_lld_library(hash, backend.llvm_lld_default_library(i), 1) != 0) {
            return -1
        }
        i += 1
    }
    if (mb_hash_lld_library(hash, "m", 1) != 0) { return -1 }

    let pi int = 0
    for pi < project_count {
        let pj int = projects[pi]
        let li int = 0
        for li < proj.ctx().projs[pj].c_lib_n {
            let lib proj.PInput = proj.ctx().projs[pj].c_libs[li]
            let name [128]u8
            let n int = append_bytes_np(&name[0], 0, lib.path_off, lib.path_len)
            name[n] = 0
            if (mb_hash_lld_library(hash, gen.arr_cstr(name), 0) != 0) { return -1 }
            li += 1
        }
        pi += 1
    }
    return 0
}

// mb_lld_link_worker：在一次性子进程中执行静态内嵌 lld，避免复用不可重入状态。
// 子进程只负责写临时输出并立即退出；父进程依据返回码决定是否发布。
fn mb_lld_link_worker(objects **char, object_count int, extra_args **char,
    extra_count int, output *char) int {
    let child int = fork()
    if (child < 0) { return gen.fail("无法启动内嵌 lld worker") }
    if (child == 0) {
        let diagnostic [backend.LLVM_LLD_DIAG]u8
        let status int = backend.llvm_lld_link_driver(output, objects,
            object_count, extra_args, extra_count,
            (&diagnostic[0]).to_type(*char))
        if (status != 0) {
            if (diagnostic[0] != 0) {
                gen.write_all(2, &diagnostic[0],
                    strlen((&diagnostic[0]).to_type(*char)).to_type(int))
                gen.write_all(2, "\n".to_type(*u8), 1)
            }
            if (status == -2) { exit(253) }
            exit(1)
        }
        exit(0)
    }
    let status int = cmd_process_status(child)
    if (status == 253) { return -2 }
    return status == 0 ? 0 : -1
}

// mb_link_query_identity：哈希驱动器实际报告的搜索路径、工具、启动文件和库文件。
// 查询通过 argv 执行并写入 build/manifest 下的临时文件，避免 shell 转义与管道差异。
fn mb_link_query_identity(hash *u64, cc *char, projects *int,
    project_count int, build_off int) int {
    let tk *gen.TaskCtx = gen.task()
    let capture_path [900]u8
    let pn int = 0
    pn = gen.append_str(&capture_path[0], pn, proj.pool_str(build_off))
    pn = gen.append_str(&capture_path[0], pn, "/manifest/link-query.")
    pn = gen.append_int(&capture_path[0], pn, getpid())
    capture_path[pn] = 0
    let output *u8 = malloc(65536).to_type(*u8)
    if (output == 0) { return gen.fail("链接器查询缓冲分配失败") }

    let env_names **char = malloc((9 * sizeof(*char)).to_type(u64)).to_type(**char)
    if (env_names == 0) {
        free(output.to_type(*void))
        return gen.fail("链接器环境清单分配失败")
    }
    env_names[0] = "PATH"
    env_names[1] = "LIBRARY_PATH"
    env_names[2] = "COMPILER_PATH"
    env_names[3] = "GCC_EXEC_PREFIX"
    env_names[4] = "GCC_SPECS"
    env_names[5] = "SDKROOT"
    env_names[6] = "MACOSX_DEPLOYMENT_TARGET"
    env_names[7] = "LD_RUN_PATH"
    env_names[8] = 0.to_type(*char)
    let ei int = 0
    for env_names[ei] != 0 {
        let env_off int = -1
        let env_len int = 0
        if (proj.env_fetch(env_names[ei], &env_off, &env_len) != 0) {
            free(env_names.to_type(*void))
            free(output.to_type(*void))
            return -1
        }
        let en int = 0
        for env_names[ei][en] != 0 {
            mb_fnv(hash, env_names[ei][en].to_type(u8))
            en += 1
        }
        mb_fnv(hash, 0)
        let ev int = 0
        for ev < env_len {
            mb_fnv(hash, tk.np_data[env_off + ev])
            ev += 1
        }
        mb_fnv(hash, 255)
        ei += 1
    }
    free(env_names.to_type(*void))

    let fixed_queries **char = malloc((10 * sizeof(*char)).to_type(u64)).to_type(**char)
    if (fixed_queries == 0) {
        free(output.to_type(*void))
        return gen.fail("链接器查询清单分配失败")
    }
    fixed_queries[0] = "-print-search-dirs"
    fixed_queries[1] = "-print-sysroot"
    fixed_queries[2] = "-dumpmachine"
    fixed_queries[3] = "-dumpfullversion"
    fixed_queries[4] = "-dumpspecs"
    fixed_queries[5] = "-print-prog-name=ld"
    fixed_queries[6] = "-print-prog-name=collect2"
    fixed_queries[7] = "-print-prog-name=as"
    fixed_queries[8] = 0.to_type(*char)
    fixed_queries[9] = 0.to_type(*char)
    // Darwin 的链接驱动是 clang，不接受下面这批 GCC 专用查询
    // （实测 `clang: error: unknown argument: '-print-sysroot'` 后整轮构建失败）。
    // 目标为 Darwin 时清空清单跳过整轮：签名只保留驱动器路径与环境变量。
    if (proj.cfg().target.os == gen.TARGET_OS_DARWIN) { fixed_queries[0] = 0.to_type(*char) }
    let qi int = 0
    for fixed_queries[qi] != 0 {
        let argv [3]*char
        argv[0] = cc
        argv[1] = fixed_queries[qi]
        argv[2] = 0.to_type(*char)
        let n int = cmd_process_capture(&argv[0],
            (&capture_path[0]).to_type(*char), output, 65536)
        if (n < 0) {
            free(fixed_queries.to_type(*void))
            free(output.to_type(*void))
            return gen.fail("无法读取链接驱动信息")
        }
        let q int = 0
        for fixed_queries[qi][q] != 0 {
            mb_fnv(hash, fixed_queries[qi][q].to_type(u8))
            q += 1
        }
        mb_fnv(hash, 0)
        let oi int = 0
        for oi < n { mb_fnv(hash, output[oi]); oi += 1 }
        mb_fnv(hash, 254)
        if (qi >= 5) {
            for n > 0 && (output[n - 1] == 10 || output[n - 1] == 13) {
                n -= 1
            }
            output[n] = 0
            if (n > 0 && mb_hash_tool_identity(hash,
                (&output[0]).to_type(*char)) != 0) {
                free(fixed_queries.to_type(*void))
                free(output.to_type(*void))
                return -1
            }
        }
        qi += 1
    }
    free(fixed_queries.to_type(*void))

    let fixed_files **char = malloc((13 * sizeof(*char)).to_type(u64)).to_type(**char)
    if (fixed_files == 0) {
        free(output.to_type(*void))
        return gen.fail("链接启动文件清单分配失败")
    }
    fixed_files[0] = "crt1.o"
    fixed_files[1] = "Scrt1.o"
    fixed_files[2] = "crti.o"
    fixed_files[3] = "crtn.o"
    fixed_files[4] = "crtbegin.o"
    fixed_files[5] = "crtbeginS.o"
    fixed_files[6] = "crtend.o"
    fixed_files[7] = "crtendS.o"
    fixed_files[8] = "libc.so"
    fixed_files[9] = "libc.so.6"
    fixed_files[10] = "libgcc.a"
    fixed_files[11] = "libgcc_s.so"
    fixed_files[12] = 0.to_type(*char)
    qi = 0
    for fixed_files[qi] != 0 {
        let query [96]u8
        let qn int = gen.append_str(&query[0], 0, "-print-file-name=")
        qn = gen.append_str(&query[0], qn, fixed_files[qi])
        query[qn] = 0
        let argv [3]*char
        argv[0] = cc
        argv[1] = (&query[0]).to_type(*char)
        argv[2] = 0.to_type(*char)
        let n int = cmd_process_capture(&argv[0],
            (&capture_path[0]).to_type(*char), output, 65536)
        if (n < 0) {
            free(fixed_files.to_type(*void))
            free(output.to_type(*void))
            return gen.fail("无法解析链接输入")
        }
        let oi int = 0
        for oi < n { mb_fnv(hash, output[oi]); oi += 1 }
        mb_fnv(hash, 254)
        for n > 0 && (output[n - 1] == 10 || output[n - 1] == 13) {
            n -= 1
        }
        output[n] = 0
        if (n > 0 && proj.file_exists((&output[0]).to_type(*char)) != 0) {
            let pi int = 0
            for output[pi] != 0 { mb_fnv(hash, output[pi]); pi += 1 }
            mb_fnv(hash, 0)
            if (mb_hash_file(hash, (&output[0]).to_type(*char)) != 0) {
                free(fixed_files.to_type(*void))
                free(output.to_type(*void))
                return -1
            }
        }
        qi += 1
    }
    free(fixed_files.to_type(*void))

    let pi int = 0
    for pi < project_count {
        let pj int = projects[pi]
        let li int = 0
        for li < proj.ctx().projs[pj].c_lib_n {
            let lib proj.PInput = proj.ctx().projs[pj].c_libs[li]
            let suffixes **char = malloc((4 * sizeof(*char)).to_type(u64)).to_type(**char)
            if (suffixes == 0) {
                free(output.to_type(*void))
                return gen.fail("系统库后缀清单分配失败")
            }
            suffixes[0] = ".so"
            suffixes[1] = ".a"
            suffixes[2] = ".dylib"
            suffixes[3] = 0.to_type(*char)
            let si int = 0
            for suffixes[si] != 0 {
                let query [160]u8
                let qn int = gen.append_str(&query[0], 0, "-print-file-name=lib")
                qn = append_bytes_np(&query[0], qn, lib.path_off, lib.path_len)
                qn = gen.append_str(&query[0], qn, suffixes[si])
                query[qn] = 0
                let argv [3]*char
                argv[0] = cc
                argv[1] = (&query[0]).to_type(*char)
                argv[2] = 0.to_type(*char)
                let n int = cmd_process_capture(&argv[0],
                    (&capture_path[0]).to_type(*char), output, 65536)
                if (n < 0) {
                    free(suffixes.to_type(*void))
                    free(output.to_type(*void))
                    return gen.fail("无法解析配置的系统库")
                }
                let oi int = 0
                for oi < n { mb_fnv(hash, output[oi]); oi += 1 }
                mb_fnv(hash, 254)
                for n > 0 && (output[n - 1] == 10 || output[n - 1] == 13) {
                    n -= 1
                }
                output[n] = 0
                if (n > 0 && proj.file_exists((&output[0]).to_type(*char)) != 0) {
                    let path_i int = 0
                    for output[path_i] != 0 { mb_fnv(hash, output[path_i]); path_i += 1 }
                    mb_fnv(hash, 0)
                    if (mb_hash_file(hash, (&output[0]).to_type(*char)) != 0) {
                        free(suffixes.to_type(*void))
                        free(output.to_type(*void))
                        return -1
                    }
                }
                si += 1
            }
            free(suffixes.to_type(*void))
            li += 1
        }
        pi += 1
    }
    if (gen.tg_host_darwin() == 0) {
        let suffixes **char = malloc((3 * sizeof(*char)).to_type(u64)).to_type(**char)
        if (suffixes == 0) {
            free(output.to_type(*void))
            return gen.fail("libm 后缀清单分配失败")
        }
        suffixes[0] = ".so"
        suffixes[1] = ".a"
        suffixes[2] = 0.to_type(*char)
        let si int = 0
        for suffixes[si] != 0 {
            let query [96]u8
            let qn int = gen.append_str(&query[0], 0, "-print-file-name=libm")
            qn = gen.append_str(&query[0], qn, suffixes[si])
            query[qn] = 0
            let argv [3]*char
            argv[0] = cc
            argv[1] = (&query[0]).to_type(*char)
            argv[2] = 0.to_type(*char)
            let n int = cmd_process_capture(&argv[0],
                (&capture_path[0]).to_type(*char), output, 65536)
            if (n < 0) {
                free(suffixes.to_type(*void))
                free(output.to_type(*void))
                return gen.fail("无法解析 libm")
            }
            let oi int = 0
            for oi < n { mb_fnv(hash, output[oi]); oi += 1 }
            mb_fnv(hash, 254)
            for n > 0 && (output[n - 1] == 10 || output[n - 1] == 13) {
                n -= 1
            }
            output[n] = 0
            if (n > 0 && proj.file_exists((&output[0]).to_type(*char)) != 0) {
                let path_i int = 0
                for output[path_i] != 0 { mb_fnv(hash, output[path_i]); path_i += 1 }
                mb_fnv(hash, 0)
                if (mb_hash_file(hash, (&output[0]).to_type(*char)) != 0) {
                    free(suffixes.to_type(*void))
                    free(output.to_type(*void))
                    return -1
                }
            }
            si += 1
        }
        free(suffixes.to_type(*void))
    }
    free(output.to_type(*void))
    return 0
}

// mb_select_linker：按输出目标选择链接驱动；YH_CC 可显式覆盖，Linux x64 默认
// 使用原生绝对路径，避免 PATH 前置的 ARM64 crossbin/gcc 包装器劫持。
fn mb_select_linker(out *u8) *char {
    let tk *gen.TaskCtx = gen.task()
    let selected *char = "gcc"
    if (gen.tg_darwin() != 0) { selected = "clang" }
    if (proj.cfg().target.os == gen.TARGET_OS_LINUX
        && proj.cfg().target.arch == gen.TARGET_ARCH_X64) {
        selected = "/usr/bin/gcc"
    }
    let env_off int = -1
        let env_len int = 0
        if (proj.env_fetch("YH_CC", &env_off, &env_len) == 0 && env_len > 0) {
            if (env_len >= 1200) { gen.fail("YH_CC 路径过长"); return 0.to_type(*char) }
            let i int = 0
            for i < env_len { out[i] = tk.np_data[env_off + i]; i += 1 }
            out[i] = 0
            if (proj.file_exists(gen.arr_cstr(out)) == 0) {
                gen.fail_path("YH_CC 工具不存在: ", gen.arr_cstr(out))
                return 0.to_type(*char)
            }
            return gen.arr_cstr(out)
        }
    return selected
}

// mb_darwin_selfhost_enabled：编译器自举链接时是否追加固定静态闭包。
// 仅在显式 `YH_LLVM_SELFHOST=1` 时为真；普通程序链接不注入桥/LLVM 归档。
fn mb_darwin_selfhost_enabled() int {
    let off int = -1
    let value_len int = 0
    if (proj.env_fetch("YH_LLVM_SELFHOST", &off, &value_len) != 0
        || value_len != 1) { return 0 }
    return gen.G().task.np_data[off] == '1' ? 1 : 0
}

pub fn mb_link(out_path *char, build_off int, build_len int,
    count int, root_proj int) int {
    let c_off int = 0
    let c_len int = 0
    let gs *gen.GenState = gen.G()
    let use_lld int = mb_lld_linux_enabled()
    let use_macho int = mb_lld_darwin_enabled()
    // 自举闭包由构建机提供：优先读 YH_LLVM_SELFHOST_FLAGS 指向的文件，
    // 未提供时桥内烘焙常量作为过渡回退。负数是文件不可读，0 是没有任何闭包
    // （新种子不再烘焙绝对路径），两种情况都要立刻给出可操作诊断。
    let selfhost_on int = li_manifest_mode(root_proj) != 0 ?
        0 : mb_darwin_selfhost_enabled()
    let selfhost_flag_n int = 0
    // 内嵌 lld 的 Linux 与 Darwin 都从同一运行时闭包文件读取桥/静态 LLVM；
    // 自举时必须先证明闭包存在，不能让空闭包静默链接出不可发射的二进代。
    if ((use_macho != 0 || use_lld != 0) && selfhost_on != 0) {
        selfhost_flag_n = backend.llvm_lld_selfhost_flag_count()
        if (selfhost_flag_n < 0) {
            return gen.fail("自举链接闭包文件不可读：检查 YH_LLVM_SELFHOST_FLAGS（每行一个链接参数）")
        }
        if (selfhost_flag_n == 0) {
            return gen.fail("自举链接缺少 LLVM 闭包：先运行 make llvm-host，或用 YH_LLVM_SELFHOST_FLAGS 指定闭包文件")
        }
    }
    let object_start_ns u64 = 0
    if (gs.c_stats_enabled != 0) {
        object_start_ns = cmd_clock_ns()
    }
    // 两步链接（用户规划：.build/asm → .build/obj → 链接）
    let cc_storage [1200]u8
    let cc *char = mb_select_linker(&cc_storage[0])
    if (cc == 0) { return -1 }
    let project_capacity int = proj.ctx().proj_n > 0 ? proj.ctx().proj_n : 1
    // LLVM 后端：worker 已用内嵌桥把每个模块直接发成目标命名空间的 obj/<tag>.o，
    // 没有 .s 中间产物，因此跳过「汇编 → 目标」步，链接参数直接收这些对象。
    let llvm_objects int = 1
    let c_projects *int = malloc((project_capacity * sizeof(int)).to_type(u64)) .
        to_type(*int)
    if (c_projects == 0) { return gen.fail("C 项目顺序表内存分配失败") }
    let c_project_n int = 0
    if (mb_c_project_order(root_proj, c_projects, &c_project_n,
        project_capacity) != 0) { return -1 }
    let c_object_n int = 0
    let c_lib_n int = 0
    let cpi int = 0
    for cpi < c_project_n {
        let cproj int = c_projects[cpi]
        c_object_n += proj.ctx().projs[cproj].c_source_n + proj.ctx().projs[cproj].c_object_n
        c_lib_n += proj.ctx().projs[cproj].c_lib_n
        cpi += 1
    }
    if (li_prepare(root_proj, build_off, build_len) != 0) {
        return -1
    }
    let link_lib_n int = li_count()
    if (mb_c_compile_sources(c_projects, c_project_n, build_off, cc) != 0) {
        return -1
    }
    // 步骤 1：逐模块汇编为 .o（RS3b：每模块 N+1 个对象——N 个文件 + 1 个
    // 运行时桩；文件对象键只含本文件 .s 内容，兄弟文件 private 变更不影响）
    let i int = 0
    for i < count {
        let m int = proj.ctx().order[i]
        if (mb_mod_tag(m, &c_off, &c_len) != 0) {
            return -1
        }
        if (llvm_objects != 0) {
            // LLVM 模式：对象已由 worker 发布，这里只登记路径（不重新汇编）。
            i += 1
            continue
        }
        let objdir [900]u8
        let odn int = 0
        odn = gen.append_str(objdir, odn, proj.pool_str(build_off))
        odn = gen.append_str(objdir, odn, "/obj/")
        odn = gen.append_str(objdir, odn, proj.pool_str(c_off))
        objdir[odn] = 0
        if (cmd_mkdirs(gen.arr_cstr(&objdir[0])) != 0) {
            return gen.fail_path("无法创建对象目录: ", gen.arr_cstr(&objdir[0]))
        }
        let rowk int = 0
        for rowk <= proj.ctx().mods[m].file_n {
            let spath [900]u8
            let opath [900]u8
            let obj_manifest [950]u8
            if (mb_module_obj_row(m, build_off, build_len, rowk,
                    &spath[0], &opath[0], &obj_manifest[0]) != 0) {
                return -1
            }
            let h u64 = mb_hash_init()
            if (mb_hash_file(&h, gen.arr_cstr(spath)) != 0) {
                return -1
            }
            let ci int = 0
            for cc[ci] != 0 {
                mb_fnv(&h, cc[ci].to_type(u8))
                ci += 1
            }
            // 键里带上真实命令前缀：换工具链（cc ↔ yh_link）必然换键，
            // 否则会拿 cc 产出的旧对象当命中。
            let tool_buf [1200]u8
            tool_buf[0] = 0
            let use_yh int = mb_asm_tool(&tool_buf[0])
            let cmd0 *char = cc
            if (use_yh != 0) {
                cmd0 = gen.arr_cstr(&tool_buf[0])
            }
            let ci2 int = 0
            for cmd0[ci2] != 0 {
                mb_fnv(&h, cmd0[ci2].to_type(u8))
                ci2 += 1
            }
            let flags *char = " -c"
            if (use_yh != 0) {
                flags = " asm"
            }
            let fi int = 0
            for flags[fi] != 0 {
                mb_fnv(&h, flags[fi].to_type(u8))
                fi += 1
            }
            if (gen.tg_darwin() != 0) {
                mb_fnv(&h, 'D')
            } else {
                mb_fnv(&h, 'L')
            }
            if (mb_hash_tool_identity(&h, cmd0) != 0) { return -1 }
            let want [16]u8
            mb_hash_hex(h, want)
            let object_hit int = 0
            if (proj.file_exists(gen.arr_cstr(opath)) != 0
                && proj.file_exists(gen.arr_cstr(obj_manifest)) != 0
                && gen.read_source(gen.arr_cstr(obj_manifest)) == 0 && gs.task.c_src_len == 32) {
                let key_matches int = 1
                let k int = 0
                for k < 16 {
                    if (gs.task.c_src[k] != want[k]) {
                        key_matches = 0
                        break
                    }
                    k += 1
                }
                let saved_object [16]u8
                let k2 int = 0
                for k2 < 16 {
                    saved_object[k2] = gs.task.c_src[16 + k2]
                    k2 += 1
                }
                let hobj u64 = mb_hash_init()
                if (key_matches != 0 && mb_hash_file(&hobj, gen.arr_cstr(opath)) == 0
                    && mb_object_machine_matches(gen.arr_cstr(opath)) != 0) {
                    let object_key [16]u8
                    mb_hash_hex(hobj, object_key)
                    object_hit = 1
                    let k3 int = 0
                    for k3 < 16 {
                        if (saved_object[k3] != object_key[k3]) {
                            object_hit = 0
                            break
                        }
                        k3 += 1
                    }
                }
            }
            if (object_hit == 0) {
                unlink(gen.arr_cstr(obj_manifest))
                let args [8]*char
                if (use_yh != 0) {
                    // yh_link asm -t darwin -o <obj> <src>（Linux 目标不带 -t，
                    // yh_link 的默认目标就是 ELF64）
                    args[0] = gen.arr_cstr(&tool_buf[0])
                    args[1] = "asm"
                    if (gen.tg_darwin() != 0) {
                        args[2] = "-t"
                        args[3] = "darwin"
                        args[4] = "-o"
                        args[5] = gen.arr_cstr(opath)
                        args[6] = gen.arr_cstr(spath)
                        args[7] = 0.to_type(*char)
                    } else {
                        args[2] = "-o"
                        args[3] = gen.arr_cstr(opath)
                        args[4] = gen.arr_cstr(spath)
                        args[5] = 0.to_type(*char)
                    }
                } else {
                    args[0] = cc
                    args[1] = "-c"
                    args[2] = gen.arr_cstr(spath)
                    args[3] = "-o"
                    args[4] = gen.arr_cstr(opath)
                    args[5] = 0.to_type(*char)
                }
                if (gs.c_stats_enabled != 0) {
                    gs.c_stats_asm += 1
                }
                if (cmd_process_run(&args[0]) != 0) {
                    return gen.fail_path("汇编失败: ", gen.arr_cstr(spath))
                }
                let object_hash u64 = mb_hash_init()
                if (mb_hash_file(&object_hash, gen.arr_cstr(opath)) != 0) {
                    return -1
                }
                let object_saved [32]u8
                mb_hash_hex(h, object_saved)
                mb_hash_hex(object_hash, &object_saved[16])
                if (mb_write_manifest(gen.arr_cstr(obj_manifest), object_saved, 32) != 0) {
                    return -1
                }
            }
            rowk += 1
        }
        i += 1
    }
    let link_start_ns u64 = 0
    if (gs.c_stats_enabled != 0) {
        mb_stats_object_ns = cmd_clock_ns() - object_start_ns
        link_start_ns = cmd_clock_ns()
    }
    // 最终链接键包括目标、参数、输出路径、模块顺序与全部对象内容。
    let hlink u64 = mb_hash_init()
    let cci int = 0
    for cc[cci] != 0 {
        mb_fnv(&hlink, cc[cci].to_type(u8))
        cci += 1
    }
    let link_flags *char = use_lld != 0 ?
        " lld-in-process -no-pie -o" : " -no-pie -o"
    if (use_macho != 0) { link_flags = " ld64.lld-in-process -pie -adhoc_codesign -o" }
    if (gen.tg_darwin() != 0) {
        link_flags = " -o"
        mb_fnv(&hlink, 'D')
    } else {
        mb_fnv(&hlink, 'L')
    }
    mb_fnv(&hlink, ('0' + gs.task.c_legacy_system).to_type(u8))
    let target_i int = 0
    for proj.cfg().target.triple[target_i] != 0 {
        mb_fnv(&hlink, proj.cfg().target.triple[target_i].to_type(u8))
        target_i += 1
    }
    mb_fnv(&hlink, 0)
    target_i = 0
    for proj.cfg().target.data_layout[target_i] != 0 {
        mb_fnv(&hlink, proj.cfg().target.data_layout[target_i].to_type(u8))
        target_i += 1
    }
    mb_fnv(&hlink, '1'.to_type(u8))
    mb_fnv(&hlink, ('0' + proj.cfg().opt_level).to_type(u8))
    if (use_lld != 0) {
        if (mb_hash_lld_identity(&hlink, c_projects, c_project_n) != 0) { return -1 }
    } else if (use_macho != 0) {
        if (mb_hash_macho_identity(&hlink, c_projects, c_project_n) != 0) { return -1 }
    } else {
        if (mb_hash_tool_identity(&hlink, cc) != 0) { return -1 }
        if (mb_link_query_identity(&hlink, cc,
            c_projects, c_project_n, build_off) != 0) { return -1 }
    }
    let lfi int = 0
    for link_flags[lfi] != 0 {
        mb_fnv(&hlink, link_flags[lfi].to_type(u8))
        lfi += 1
    }
    let oi int = 0
    for out_path[oi] != 0 {
        mb_fnv(&hlink, out_path[oi].to_type(u8))
        oi += 1
    }
    i = 0
    for i < count {
        let m int = proj.ctx().order[i]
        if (llvm_objects != 0) {
            if (mb_mod_tag(m, &c_off, &c_len) != 0) {
                return -1
            }
            let tagoff int = c_off
            let taglen int = c_len
            let ti int = 0
            for ti < taglen {
                mb_fnv(&hlink, gs.task.np_data[tagoff + ti])
                ti += 1
            }
            let opath [900]u8
            let on3 int = 0
            on3 = gen.append_str(opath, on3, proj.pool_str(build_off))
            on3 = gen.append_str(opath, on3, "/obj/")
            on3 = gen.append_str(opath, on3, proj.pool_str(tagoff))
            on3 = gen.append_str(opath, on3, ".o")
            opath[on3] = 0
            if (mb_object_machine_matches(gen.arr_cstr(opath)) == 0) {
                return gen.fail_path("目标文件架构与当前 target 不符: ",
                    gen.arr_cstr(opath))
            }
            if (mb_hash_file(&hlink, gen.arr_cstr(opath)) != 0) {
                return -1
            }
            i += 1
            continue
        }
        // 旧后端（RS3b）：每模块 N+1 个对象，路径即顺序标识
        let rowk int = 0
        for rowk <= proj.ctx().mods[m].file_n {
            let opath [900]u8
            if (mb_module_obj_row(m, build_off, build_len, rowk, 0,
                    &opath[0], 0) != 0) {
                return -1
            }
            let opi int = 0
            for opath[opi] != 0 {
                mb_fnv(&hlink, opath[opi].to_type(u8))
                opi += 1
            }
            mb_fnv(&hlink, 0)
            if (mb_object_machine_matches(gen.arr_cstr(opath)) == 0) {
                return gen.fail_path("目标文件架构与当前 target 不符: ",
                    gen.arr_cstr(opath))
            }
            if (mb_hash_file(&hlink, gen.arr_cstr(opath)) != 0) {
                return -1
            }
            rowk += 1
        }
        i += 1
    }
    if (mb_c_input_hash(&hlink, c_projects, c_project_n, build_off) != 0) {
        return -1
    }
    li_hash(&hlink)
    let link_want [16]u8
    mb_hash_hex(hlink, link_want)
    let link_manifest [620]u8
    let lmn int = 0
    lmn = gen.append_str(link_manifest, lmn, proj.pool_str(build_off))
    lmn = gen.append_str(link_manifest, lmn, "/manifest/link.manifest")
    link_manifest[lmn] = 0
    // manifest 同时校验输出文件内容，避免跳过被用户覆盖的产物。
    let link_hit int = 0
    if (proj.file_exists(out_path) != 0 && proj.file_exists(gen.arr_cstr(link_manifest)) != 0
        && gen.read_source(gen.arr_cstr(link_manifest)) == 0 && gs.task.c_src_len == 32) {
        let key_matches int = 1
        let sk int = 0
        for sk < 16 {
            if (gs.task.c_src[sk] != link_want[sk]) {
                key_matches = 0
                break
            }
            sk += 1
        }
        let saved_output [16]u8
        let sk2 int = 0
        for sk2 < 16 {
            saved_output[sk2] = gs.task.c_src[16 + sk2]
            sk2 += 1
        }
        let hout u64 = mb_hash_init()
        if (key_matches != 0 && mb_hash_file(&hout, out_path) == 0) {
            let output_key [16]u8
            mb_hash_hex(hout, output_key)
            let j int = 0
            link_hit = 1
            for j < 16 {
                if (saved_output[j] != output_key[j]) {
                    link_hit = 0
                    break
                }
                j += 1
            }
        }
    }
    if (link_hit != 0) {
        if (gs.c_stats_enabled != 0) {
            mb_stats_link_ns = cmd_clock_ns() - link_start_ns
        }
        return 0
    }
    // 步骤 2：链接全部 .o
    // 对象行数 = 各模块（文件数 + 1 个桩）；LLVM 模式每模块 1 个。
    let total_rows int = 0
    i = 0
    for i < count {
        let m0 int = proj.ctx().order[i]
        if (llvm_objects != 0) {
            total_rows += 1
        } else {
            total_rows += proj.ctx().mods[m0].file_n + 1
        }
        i += 1
    }
    if (total_rows < 1) { total_rows = 1 }
    let library_search_storage [4096]u8
    let library_search_len int = 0
    let library_search_count int = 0
    if (use_macho != 0) {
        let search_off int = -1
        if (proj.env_fetch("LIBRARY_PATH", &search_off, &library_search_len) != 0) {
            return -1
        }
        if (library_search_len >= 4095) {
            return gen.fail("LIBRARY_PATH 超过 Darwin 链接路径限制")
        }
        if (library_search_len > 0) {
            library_search_count = 1
            let search_i int = 0
            for search_i < library_search_len {
                library_search_storage[search_i] = gs.task.np_data[search_off + search_i]
                if (library_search_storage[search_i] == ':') {
                    library_search_count += 1
                }
                search_i += 1
            }
            library_search_storage[library_search_len] = 0
        }
    }
    let argc int = total_rows + c_object_n + c_lib_n + link_lib_n * 2 +
        li_runtime_count() + 24 +
        (library_search_count * 2) +
        selfhost_flag_n
    let args **char = gen.alloc((argc * sizeof(*char)).to_type(u64)).to_type(**char)
    let paths *u8 = malloc((total_rows * 900).to_type(u64)).to_type(*u8)
    let cpaths *u8 = malloc(((c_object_n > 0 ? c_object_n : 1) * 700).to_type(u64)).to_type(*u8)
    let libpaths *u8 = malloc(((c_lib_n > 0 ? c_lib_n : 1) * 128).to_type(u64)).to_type(*u8)
    if (args == 0 || paths == 0 || cpaths == 0 || libpaths == 0) {
        if (args != 0) { free(args.to_type(*void)) }
        if (paths != 0) { free(paths.to_type(*void)) }
        if (cpaths != 0) { free(cpaths.to_type(*void)) }
        if (libpaths != 0) { free(libpaths.to_type(*void)) }
        return gen.fail("链接 argv 缓冲分配失败")
    }
    let link_tmp [900]u8
    let tmp_len int = gen.append_str(&link_tmp[0], 0, out_path)
    tmp_len = gen.append_str(&link_tmp[0], tmp_len, ".yh-tmp.")
    tmp_len = gen.append_int(&link_tmp[0], tmp_len, getpid())
    link_tmp[tmp_len] = 0
    unlink((&link_tmp[0]).to_type(*char))
    let next_arg int = 0
    if (use_macho != 0) {
        next_arg = mb_macho_link_prefix(args, (&link_tmp[0]).to_type(*char))
        if (next_arg < 0) {
            free(args.to_type(*void))
            free(paths.to_type(*void))
            free(cpaths.to_type(*void))
            free(libpaths.to_type(*void))
            return -1
        }
        let search_i int = 0
        let search_start int = 0
        for search_i <= library_search_len && library_search_len > 0 {
            if (search_i == library_search_len || library_search_storage[search_i] == ':') {
                let empty int = search_i == search_start ? 1 : 0
                library_search_storage[search_i] = 0
                args[next_arg] = "-L"; next_arg += 1
                args[next_arg] = empty != 0 ?
                    "." : (&library_search_storage[search_start]).to_type(*char)
                next_arg += 1
                search_start = search_i + 1
            }
            search_i += 1
        }
    } else if (use_lld == 0) {
        args[next_arg] = cc
        next_arg += 1
        if (gen.tg_darwin() == 0) {
            args[next_arg] = "-no-pie"
            next_arg += 1
        }
        args[next_arg] = "-o"
        next_arg += 1
        args[next_arg] = (&link_tmp[0]).to_type(*char)
        next_arg += 1
    }
    let object_start int = next_arg
    let row_fill int = 0
    i = 0
    for i < count {
        let m int = proj.ctx().order[i]
        if (llvm_objects != 0) {
            if (mb_mod_tag(m, &c_off, &c_len) != 0) {
                free(args.to_type(*void))
                free(paths.to_type(*void))
                free(cpaths.to_type(*void))
                free(libpaths.to_type(*void))
                return -1
            }
            let row *u8 = paths + (row_fill * 900)
            let n int = 0
            n = gen.append_str(row, n, proj.pool_str(build_off))
            n = gen.append_str(row, n, "/obj/")
            n = gen.append_str(row, n, proj.pool_str(c_off))
            n = gen.append_str(row, n, ".o")
            row[n] = 0
            args[next_arg] = row.to_type(*char)
            next_arg += 1
            row_fill += 1
            i += 1
            continue
        }
        let rowk int = 0
        for rowk <= proj.ctx().mods[m].file_n {
            let row *u8 = paths + (row_fill * 900)
            if (mb_module_obj_row(m, build_off, build_len, rowk, 0, row, 0) != 0) {
                free(args.to_type(*void))
                free(paths.to_type(*void))
                free(cpaths.to_type(*void))
                free(libpaths.to_type(*void))
                return -1
            }
            args[next_arg] = row.to_type(*char)
            next_arg += 1
            row_fill += 1
            rowk += 1
        }
        i += 1
    }
    let cp int = 0
    let cpath_i int = 0
    for cp < c_project_n {
        let cproj int = c_projects[cp]
        let si2 int = 0
        for si2 < proj.ctx().projs[cproj].c_source_n {
            let row2 *u8 = cpaths + (cpath_i * 700)
            mb_c_obj_path(build_off, cproj, si2, row2)
            args[next_arg] = row2.to_type(*char)
            next_arg += 1
            cpath_i += 1
            si2 += 1
        }
        let oi2 int = 0
        for oi2 < proj.ctx().projs[cproj].c_object_n {
            args[next_arg] = proj.pool_str(proj.ctx().projs[cproj].c_objects[oi2].path_off)
            next_arg += 1
            oi2 += 1
        }
        cp += 1
    }
    let object_count int = next_arg - object_start
    let extra_start int = next_arg
    // [link] 库紧跟在 yh/C 对象之后、[c].libs 和系统库之前。
    // Linux/ELF 的静态库循环引用由同一个 --start-group 覆盖；共享库也放入
    // group，保持声明顺序。Darwin 没有等价 group，按声明顺序直接传入。
    if (link_lib_n > 0) {
        let elv int = proj.cfg().target.os == gen.TARGET_OS_LINUX ? 1 : 0
        if (elv != 0) {
            args[next_arg] = use_lld != 0 ? "--start-group" : "-Wl,--start-group"
            next_arg += 1
        }
        let whole_on int = 0
        let lb int = 0
        for lb < link_lib_n {
            let want_whole int = elv != 0 ? li_whole(lb) : 0
            if (elv != 0 && want_whole != whole_on) {
                if (want_whole != 0) {
                    args[next_arg] = use_lld != 0 ? "--whole-archive" : "-Wl,--whole-archive"
                } else {
                    args[next_arg] = use_lld != 0 ? "--no-whole-archive" : "-Wl,--no-whole-archive"
                }
                next_arg += 1
                whole_on = want_whole
            }
            if (elv == 0 && li_whole(lb) != 0) {
                args[next_arg] = "-force_load"
                next_arg += 1
            }
            args[next_arg] = li_path(lb)
            next_arg += 1
            lb += 1
        }
        if (elv != 0) {
            if (whole_on != 0) {
                args[next_arg] = use_lld != 0 ? "--no-whole-archive" : "-Wl,--no-whole-archive"
                next_arg += 1
            }
            args[next_arg] = use_lld != 0 ? "--end-group" : "-Wl,--end-group"
            next_arg += 1
        }
    }
    cp = 0
    let libpath_i int = 0
    for cp < c_project_n {
        let cproj2 int = c_projects[cp]
        let li2 int = 0
        for li2 < proj.ctx().projs[cproj2].c_lib_n {
            let lib proj.PInput = proj.ctx().projs[cproj2].c_libs[li2]
            let row3 *u8 = libpaths + (libpath_i * 128)
            let ln int = gen.append_str(row3, 0, "-l")
            ln = append_bytes_np(row3, ln, lib.path_off, lib.path_len)
            row3[ln] = 0
            args[next_arg] = row3.to_type(*char)
            next_arg += 1
            libpath_i += 1
            li2 += 1
        }
        cp += 1
    }
    let rt int = 0
    for rt < li_runtime_count() {
        args[next_arg] = li_runtime_flag(rt)
        next_arg += 1
        rt += 1
    }
    // Linux：glibc 把数学函数放在独立的 libm 里，libs/math 与标准库用到
    // cos/pow 等；Darwin 的 libSystem 已包含（宿主链接命令按宿主平台取）。
    if (proj.cfg().target.os == gen.TARGET_OS_LINUX) {
        args[next_arg] = "-lm"
        next_arg += 1
    } else if (use_macho != 0) {
        // 编译器自举：Darwin raw lld argv 由 yh 侧拼装，需要把桥与
        // LLVM/lld 静态闭包以 force_load 形式追加；普通程序不注入。
        if (selfhost_on != 0) {
            if (next_arg + selfhost_flag_n > argc) {
                return gen.fail("Darwin 自举链接参数超出 argv 容量")
            }
            let fi int = 0
            for fi < selfhost_flag_n {
                let flag *char = backend.llvm_lld_selfhost_flag(fi)
                if (flag == 0 || flag[0] == 0) {
                    return gen.fail("Darwin 自举链接参数无效")
                }
                args[next_arg] = flag
                next_arg += 1
                fi += 1
            }
        }
        args[next_arg] = "-lSystem"
        next_arg += 1
    }
    let extra_count int = next_arg - extra_start
    if (use_lld == 0 && use_macho == 0) { args[next_arg] = 0.to_type(*char) }
    if (gs.c_stats_enabled != 0) {
        gs.c_stats_link += 1
    }
    let link_rc int = use_macho != 0 ?
        mb_macho_link_worker(args, next_arg) :
        use_lld != 0 ?
            mb_lld_link_worker(args + object_start, object_count,
                args + extra_start, extra_count, (&link_tmp[0]).to_type(*char)) :
            cmd_process_run(&args[0])
    free(args.to_type(*void))
    free(paths.to_type(*void))
    free(cpaths.to_type(*void))
    free(libpaths.to_type(*void))
    if (link_rc == -2) {
        unlink((&link_tmp[0]).to_type(*char))
        return gen.fail("lld 不可重入：链接 worker 已结束，未发布输出")
    }
    if (link_rc != 0) {
        unlink((&link_tmp[0]).to_type(*char))
        return gen.fail_path("链接失败: ", out_path)
    }
    if (mb_object_machine_matches((&link_tmp[0]).to_type(*char)) == 0) {
        unlink((&link_tmp[0]).to_type(*char))
        return gen.fail_path("链接产物架构与当前 target 不符: ", out_path)
    }
    if (use_macho != 0
        && mb_darwin_executable_matches((&link_tmp[0]).to_type(*char)) == 0) {
        unlink((&link_tmp[0]).to_type(*char))
        return gen.fail_path("Darwin 链接产物版本或代码签名校验失败: ", out_path)
    }
    if (rename((&link_tmp[0]).to_type(*char), out_path) != 0) {
        unlink((&link_tmp[0]).to_type(*char))
        return gen.fail_path("无法发布链接产物: ", out_path)
    }
    let final_hash u64 = mb_hash_init()
    if (mb_hash_file(&final_hash, out_path) != 0) {
        return -1
    }
    let link_saved [32]u8
    mb_hash_hex(hlink, link_saved)
    mb_hash_hex(final_hash, &link_saved[16])
    if (mb_write_manifest(gen.arr_cstr(link_manifest), link_saved, 32) != 0) {
        return -1
    }
    if (gs.c_stats_enabled != 0) {
        mb_stats_link_ns = cmd_clock_ns() - link_start_ns
    }
    return 0
}
