module build
import parse
import support
import gen
import proj
import link
import cache

// ============================================================================
// build_scheduler.yh —— 有界快照 worker 进程池与 InterfaceReady 调度。
//
// worker 从父进程 fork 并继承只读项目快照；写时复制隔离语义全局与产物缓冲。
// 调度器按接口原子发布推进依赖，不等待提供方完成私有函数与汇编。
// ============================================================================


// mb_sched_worker_limit：worker 上限，默认 4（合入 perf WIP 的 PF3 开关）。
// `YH_WORKERS` 可在 1..32 内覆盖，供并发扩展性测量；非法/缺省值回落到 4，
// 避免环境变量把构建打坏。父进程读一次后缓存在 BuildCtx 里。
fn mb_sched_worker_limit() int {
    if (bc().sched_limit_ready != 0) { return bc().sched_limit }
    bc().sched_limit_ready = 1
    bc().sched_limit = 4
    // 走 proj 的环境向量读口（driver 已把 envp 交进来），不额外声明 libc getenv。
    let off int = -1
    let len int = 0
    if (proj.env_fetch("YH_WORKERS", &off, &len) != 0 || len == 0) {
        return bc().sched_limit
    }
    let tk *gen.TaskCtx = gen.task()
    let value int = 0
    let i int = 0
    for i < len {
        let c int = support.pool_ctx().data[off + i].to_type(int)
        if (c < 48 || c > 57) { return bc().sched_limit }
        value = value * 10 + (c - 48)
        if (value > 32) { return bc().sched_limit }
        i += 1
    }
    if (value >= 1) { bc().sched_limit = value }
    return bc().sched_limit
}

// yh_win_spawn_wait：Windows 侧 CreateProcessA 包装（compiler/llvm/windows_shim.c）。
// 仅无 fork 宿主使用；其余平台不引用，符号不会进入链接。
@[extern] fn yh_win_spawn_wait(argv **char, argc int) int

// mb_sched_reset_worker_stats：子进程继承项目快照，但阶段计数只记录模块自身。
fn mb_sched_reset_worker_stats() void {
    let tk *gen.TaskCtx = gen.task()
    bc().build_start_ns = 0
    bc().project_ns = 0
    bc().schedule_ns = 0
    bc().front_ns = 0
    bc().lower_ns = 0
    bc().irbuild_ns = 0
    bc().bridge_ns = 0
    link.reset_timings()
    support.stats().lex = 0
    support.stats().syntax = 0
    support.stats().index = 0
    support.stats().pass1 = 0
    support.stats().globals = 0
    support.stats().functions = 0
    support.stats().ir_functions = 0
    support.stats().ir_cache_hits = 0
    support.stats().ir_cache_misses = 0
    support.stats().ir_lowered = 0
    support.stats().check_cache_hits = 0
    support.stats().check_cache_misses = 0
    support.stats().check_cache_skipped = 0
    support.stats().checked_functions = 0
    support.stats().backend_emitted = 0
    support.stats().ir_rejected = 0
    support.stats().backend_rejected = 0
    support.stats().lower_prep_ns = 0
    support.stats().lower_decl_ns = 0
    support.stats().lower_build_ns = 0
    support.stats().lower_verify_ns = 0
    support.stats().lower_lookup_ns = 0
    support.stats().lower_cache_ns = 0
    support.stats().lower_fn_ns = 0
    support.stats().lower_capture_ns = 0
    parse.ctx().ir_reject_reason = 0
    support.stats().workers = 0
    support.stats().asm = 0
    support.stats().link = 0
    support.stats().compiler_hashes = 0
    support.session().stats_ast_nodes = 0
    support.session().stats_ast_refs = 0
    support.session().stats_stmt_nodes = 0
    support.session().stats_ast_bindings = 0
    support.session().stats_ast_functions = 0
    support.session().stats_decl_nodes = 0
    bc().sched_peak = 0
    bc().sched_iface_early = 0
}

// mb_spawn_module_child：无 fork 宿主（Windows）把模块编译放进一次性子进程。
// 子进程重走 --emit-module 协议（重新索引项目，前端状态天然干净），父进程
// 等到退出后按 pid=0 走「已完成」分支。argv 沿用父进程的目标/优化/会话参数。
fn mb_spawn_module_child(module_idx int, root_off int, root_len int,
    out_dir *char, ir_cache_salt u64) int {
    let tk *gen.TaskCtx = gen.task()
    let mod int = module_idx
    if (mod < 0 || mod >= proj.ctx().mod_n) { return -1 }
    let name_buf [160]u8
    let nn int = proj.ctx().mods[mod].name_len
    if (nn <= 0 || nn >= 160) { return -1 }
    let ni int = 0
    for ni < nn {
        name_buf[ni] = support.pool_ctx().data[proj.ctx().mods[mod].name_off + ni]
        ni += 1
    }
    name_buf[nn] = 0
    let prov int = proj.ctx().mods[mod].proj
    let args [32]*char
    let ai int = 0
    args[ai] = 0.to_type(*char); ai += 1
    args[ai] = "--emit-module"; ai += 1
    args[ai] = (&name_buf[0]).to_type(*char); ai += 1
    args[ai] = proj.pool_str(proj.ctx().projs[prov].root_off); ai += 1
    args[ai] = proj.pool_str(root_off); ai += 1
    args[ai] = "-o"; ai += 1
    args[ai] = out_dir; ai += 1
    if (bc().iface_suffix != 0) {
        args[ai] = "--iface-suffix"; ai += 1
        args[ai] = bc().iface_suffix; ai += 1
    }
    let hex [17]u8
    if (ir_cache_salt != 0) {
        proj.hash_hex(ir_cache_salt, &hex[0])
        hex[16] = 0
        args[ai] = "--ir-key"; ai += 1
        args[ai] = (&hex[0]).to_type(*char); ai += 1
    }
    args[ai] = "--target"; ai += 1
    args[ai] = proj.cfg().target.triple; ai += 1
    args[ai] = proj.cfg().opt_level == 2 ? "-O2" : "-O0"; ai += 1
    if (proj.cfg().trimpath != 0) { args[ai] = "--trimpath"; ai += 1 }
    if (proj.cfg().emit_kind != 0) { args[ai] = "--emit-llvm"; ai += 1 }
    if (proj.cfg().emit_asm != 0) { args[ai] = "--emit-asm"; ai += 1 }
    if (support.session().check_only != 0) { args[ai] = "--check-only"; ai += 1 }
    if (support.session().test_mode != 0) {
        args[ai] = "--test-mode"; ai += 1
        // testkit 生成的 runner 在项目 tmp/ 下，子进程重新扫描时看不到它。
        if (proj.ctx().mods[mod].file_n > 0 && proj.ctx().mods[mod].name_len >= 8) {
            let name *char = proj.pool_str(proj.ctx().mods[mod].name_off)
            if (name[0] == 'y' && name[1] == 'h' && name[2] == '_'
                && name[3] == 't' && name[4] == 'e' && name[5] == 's'
                && name[6] == 't' && name[7] == '_') {
                let first int = proj.ctx().mods[mod].files[0]
                args[ai] = "--extra-file"; ai += 1
                args[ai] = proj.pool_str(proj.ctx().files[first].path_off); ai += 1
            }
        }
    }
    if (support.stats().enabled != 0) { args[ai] = "--stats"; ai += 1 }
    // 全冷构建不写函数级 IR 缓存（PC3）的判定在父进程的调度器里做
    // （c_firc_write_off = 链接清单不存在）。无 fork 宿主的模块编译在独立子进程，
    // 必须把该判定显式带过去，否则子进程会把冷编的缓存记录写下来——下一轮
    // 清空 .build 后那些记录永远不会被读，且“首轮重编应全部 miss”的期望会反转。
    if (support.stats().firc_write_off != 0) { args[ai] = "--no-firc"; ai += 1 }
    // 单文件测试（yh test <项目外文件>）的扫描过滤要在子进程重建：子进程自己
    // 重新装载项目，不传就会把相邻 .yh 也装进来（Windows 无 fork 的 re-exec 路径）。
    let scan_buf [1100]u8
    if (proj.ctx().scan_file_off >= 0 && proj.ctx().scan_file_len > 0
        && proj.ctx().scan_file_len < 1100) {
        let si int = 0
        for si < proj.ctx().scan_file_len {
            scan_buf[si] = support.pool_ctx().data[proj.ctx().scan_file_off + si]
            si += 1
        }
        scan_buf[proj.ctx().scan_file_len] = 0
        args[ai] = "--scan-file"; ai += 1
        args[ai] = (&scan_buf[0]).to_type(*char); ai += 1
    }
    args[ai] = 0.to_type(*char)
    if (mb_resolve_self_path() != 0) { return -1 }
    args[0] = bc().self_path
    $if (windows) {
        return yh_win_spawn_wait(&args[0], ai)
    } $else {
        return -1
    }
}

// mb_spawn_indexed_module：fork 当前已索引项目快照，子进程独占语义状态并编译模块。
// out_dir：本模块的按文件汇编目录 <build>/asm/<tag>（RS3b）。
fn mb_spawn_indexed_module(module_idx int, root_off int, root_len int,
    out_dir *char, ir_cache_salt u64, pid_out *int) int {
    if (link.mb_can_fork() == 0) {
        // 无 fork 宿主（Windows，W2-4b）：每个模块经 --emit-module 起一次性
        // 子进程，前端状态不跨模块复用（串行进程内复用会污染符号/文件快照）。
        $if (windows) {
            if (mb_spawn_module_child(module_idx, root_off, root_len,
                    out_dir, ir_cache_salt) != 0) {
                return -1
            }
            pid_out[0] = 0
            return 0
        }
        $else {
            // Linux/Darwin 的 YH_NO_FORK=1 测试钩子：维持原有的进程内串行
            // 路径（W2-4a 已知 stage 7 未修，仅用于探针）。
            if (mb_emit_indexed_module(module_idx, root_off, root_len,
                    out_dir, ir_cache_salt) != 0) {
                return -1
            }
            pid_out[0] = 0
            return 0
        }
    }
    let child int = fork()
    if (child < 0) {
        return -1
    }
    if (child == 0) {
        mb_worker_parent_set()
        mb_sched_reset_worker_stats()
        let result int = mb_emit_indexed_module(module_idx, root_off, root_len,
            out_dir, ir_cache_salt)
        if (result == 0) {
            exit(0)
        }
        exit(1)
    }
    pid_out[0] = child
    return 0
}

// mb_sched_set_session：为本次构建分配不可与其他进程混用的接口后缀。
fn mb_sched_set_session() int {
    let text [40]u8
    let n int = support.append_str(text, 0, ".session-")
    n = support.append_int(text, n, getpid())
    text[n] = 0
    bc().iface_suffix = malloc((n + 1).to_type(u64)).to_type(*char)
    if (bc().iface_suffix == 0) {
        return support.fail("内存分配失败")
    }
    let i int = 0
    for i <= n {
        bc().iface_suffix[i] = text[i].to_type(char)
        i += 1
    }
    return 0
}

// mb_resolve_self_path：把 PATH 命令名解析为编译器指纹可读取的文件路径。
pub fn mb_resolve_self_path() int {
    let tk *gen.TaskCtx = gen.task()
    if (bc().self_path != 0) {
        return 0
    }
    let has_slash int = 0
    let i int = 0
    for bc().argv0[i] != 0 {
        if (bc().argv0[i] == '/' || bc().argv0[i] == 92) {
            has_slash = 1
            break
        }
        i += 1
    }
    if (has_slash != 0) {
        bc().self_path = bc().argv0
        return 0
    }
    let path_off int = -1
    let path_len int = 0
    if (proj.env_fetch("PATH", &path_off, &path_len) != 0) {
        return support.fail("无法解析编译器可执行路径")
    }
    let start int = 0
    let end int = 0
    let windows int = support.tg_host_windows()
    let separator u8 = windows != 0 ? ';' : ':'
    for end <= path_len {
        if (end == path_len || support.pool_ctx().data[path_off + end] == separator) {
            let candidate [1200]u8
            let n int = 0
            if (end == start) {
                n = support.append_str(candidate, n, ".")
            } else {
                let k int = start
                for k < end {
                    candidate[n] = support.pool_ctx().data[path_off + k]
                    n += 1
                    k += 1
                }
            }
            n = support.append_byte(candidate, n, '/')
            n = support.append_str(candidate, n, bc().argv0)
            candidate[n] = 0
            if (proj.file_exists(support.arr_cstr(candidate)) != 0) {
                bc().self_path = malloc((n + 1).to_type(u64)).to_type(*char)
                if (bc().self_path == 0) {
                    return -1
                }
                let j int = 0
                for j < n {
                    bc().self_path[j] = candidate[j].to_type(char)
                    j += 1
                }
                bc().self_path[n] = 0.to_type(char)
                return 0
            }
            start = end + 1
        }
        end += 1
    }
    return support.fail("PATH 中找不到当前 yh 可执行文件")
}

// mb_sched_order_index：在本轮拓扑序中查找模块位置；未找到返回 -1。
fn mb_sched_order_index(module_idx int, count int) int {
    let i int = 0
    for i < count {
        if (proj.ctx().order[i] == module_idx) {
            return i
        }
        i += 1
    }
    return -1
}

// mb_sched_refresh_interfaces：将已原子发布接口的运行任务推进到状态 2。
fn mb_sched_refresh_interfaces(states *int, count int,
    build_off int, build_len int) int {
    let i int = 0
    for i < count {
        if (states[i] == 1) {
            let path [700]u8
            if (mb_module_ready_path(proj.ctx().order[i], build_off, build_len, &path[0]) != 0) {
                return -1
            }
            if (proj.file_exists(support.arr_cstr(&path[0])) != 0) {
                states[i] = 2
            }
        }
        i += 1
    }
    return 0
}

// mb_sched_deps_ready：依赖均已完成或接口就绪时返回 1，否则返回 0。
// early_out 表示至少有一个依赖仍在运行，但已发布可用接口。
fn mb_sched_deps_ready(module_idx int, states *int, count int,
    build_off int, build_len int, early_out *int) int {
    early_out[0] = 0
    if (mb_module_iface_deps(module_idx, build_off, build_len) < 0) {
        return -1
    }
    let di int = 0
    for di < bc().dep_n {
        let oi int = mb_sched_order_index(bc().dep_mod[di], count)
        if (oi < 0) {
            return support.fail("内部错误：依赖模块不在当前构建序列")
        }
        if (states[oi] == 1) {
            let path [700]u8
            if (mb_module_ready_path(bc().dep_mod[di], build_off, build_len, &path[0]) != 0) {
                return -1
            }
            if (proj.file_exists(support.arr_cstr(&path[0])) != 0) {
                states[oi] = 2
            }
        }
        if (states[oi] != 2 && states[oi] != 3) {
            return 0
        }
        if (states[oi] == 2) {
            // 早期启动只允许 CT 接口没有变化的依赖；CT 变了就等完整提交，
            // 避免消费者用旧 .s.ct 计算全局编译期常量。
            if (mb_iface_ct_same(bc().dep_mod[di], build_off, build_len) == 0) {
                return 0
            }
            early_out[0] = 1
        }
        if (proj.file_exists(proj.pool_str(bc().dep_ifoff[di])) == 0) {
            return 0
        }
        if (proj.file_exists(proj.pool_str(bc().dep_ctoff[di])) == 0) {
            return 0
        }
        di += 1
    }
    return 1
}

// mb_sched_cancel_workers：失败时终止并回收尚未结束的子进程。
fn mb_sched_cancel_workers(states *int, pids *int, count int) void {
    let i int = 0
    for i < count {
        // 串行宿主的 pid 是 0：kill(0, sig) 会打到整个进程组，必须跳过。
        if ((states[i] == 1 || states[i] == 2) && pids[i] != 0) {
            kill(pids[i], 15)
        }
        i += 1
    }
    i = 0
    for i < count {
        if ((states[i] == 1 || states[i] == 2) && pids[i] != 0) {
            let status int = 0
            waitpid(pids[i], &status, 0)
            states[i] = 4
        }
        i += 1
    }
}

// mb_sched_publish_interface：worker 全成功后更新持久接口缓存副本。
fn mb_sched_publish_interface(module_idx int, build_off int,
    build_len int) int {
    let session_path [700]u8
    let persistent_path [700]u8
    let session_ct [700]u8
    let persistent_ct [700]u8
    if (proj.module_iface_path(module_idx, build_off, build_len, bc().iface_suffix, session_path) != 0
        || proj.module_ctiface_path(module_idx, build_off, build_len, bc().iface_suffix,
            session_ct) != 0
        || proj.module_iface_plain_path(module_idx, build_off, build_len,
            persistent_path) != 0
        || proj.module_ctiface_plain_path(module_idx, build_off, build_len,
            persistent_ct) != 0) {
        return -1
    }
    if (mb_iface_copy_file(support.arr_cstr(session_ct),
            support.arr_cstr(persistent_ct)) != 0) {
        return support.fail_path("无法提交模块 CT 接口: ",
            support.arr_cstr(persistent_ct))
    }
    if (mb_iface_copy_file(support.arr_cstr(session_path),
            support.arr_cstr(persistent_path)) != 0) {
        return support.fail_path("无法提交模块接口: ", support.arr_cstr(persistent_path))
    }
    return 0
}

// mb_sched_clear_interfaces：清除本轮临时接口，避免跨构建误读。
fn mb_sched_clear_interfaces(count int, build_off int,
    build_len int) void {
    if (bc().iface_suffix == 0) {
        return
    }
    let i int = 0
    for i < count {
        let path [700]u8
        if (proj.module_iface_path(proj.ctx().order[i], build_off, build_len, bc().iface_suffix, path) == 0) {
            unlink(support.arr_cstr(path))
        }
        if (proj.module_ctiface_path(proj.ctx().order[i], build_off, build_len, bc().iface_suffix,
            path) == 0) {
            unlink(support.arr_cstr(path))
        }
        let ready [700]u8
        if (mb_module_ready_path(proj.ctx().order[i], build_off, build_len, &ready[0]) == 0) {
            unlink(support.arr_cstr(&ready[0]))
        }
        i += 1
    }
}

// mb_schedule_modules：同项目构建锁保护下的调度入口。
// 锁只串行化同一项目；不同项目仍可并行。锁不可用时按原流程继续。
pub fn mb_schedule_modules(count int, root_off int, root_len int,
    build_off int, build_len int) int {
    let tk *gen.TaskCtx = gen.task()
    if (count <= 0 || support.session().check_only != 0) {
        return mb_schedule_modules_locked(count, root_off, root_len,
            build_off, build_len)
    }
    let lock_fd int = mb_project_lock(root_off, root_len)
    let rc int = mb_schedule_modules_locked(count, root_off, root_len,
        build_off, build_len)
    mb_project_unlock(lock_fd)
    return rc
}

// mb_schedule_modules_locked：最多并行四个 worker，接口 ready 后即可启动消费者。
// 进程退出成功后才提交 manifest；失败或被取消的本轮不会进入最终链接。
fn mb_schedule_modules_locked(count int, root_off int, root_len int,
    build_off int, build_len int) int {
    let tk *gen.TaskCtx = gen.task()
    if (count <= 0) {
        bc().sched_peak = 0
        bc().sched_iface_early = 0
        return 0
    }
    mb_cache_init()
    if (mb_sched_set_session() != 0) {
        return -1
    }
    // 上一轮没有完成链接（.build 刚被 make 清空）时不写函数级缓存：capture 占
    // 冷编约四成时间，写下的记录在下一轮清空后永远不会被读。
    let link_manifest [420]u8
    let lmn int = support.append_str(&link_manifest[0], 0, proj.pool_str(build_off))
    lmn = support.append_str(&link_manifest[0], lmn, "/manifest/link.manifest")
    link_manifest[lmn] = 0
    support.stats().firc_write_off = proj.file_exists(support.arr_cstr(&link_manifest[0])) == 0 ? 1 : 0
    let states *int = malloc((count * sizeof(int)).to_type(u64)).to_type(*int)
    let pids *int = malloc((count * sizeof(int)).to_type(u64)).to_type(*int)
    let keys *u8 = malloc((count * cache.CACHE_ID_SIZE).to_type(u64)).to_type(*u8)
    if (states == 0 || pids == 0 || keys == 0) {
        free(states)
        free(pids)
        free(keys)
        return support.fail("内存分配失败")
    }
    let i int = 0
    for i < count {
        states[i] = 0
        pids[i] = 0
        i += 1
    }
    let completed int = 0
    let active int = 0
    let failed int = 0
    bc().sched_peak = 0
    bc().sched_iface_early = 0
    for completed < count && failed == 0 {
        let progress int = 0
        if (mb_sched_refresh_interfaces(states, count, build_off, build_len) != 0) {
            failed = 1
            break
        }
        i = 0
        for i < count {
            if (states[i] == 1 || states[i] == 2) {
                let status int = 0
                // 串行宿主（Windows）的模块在 mb_spawn_indexed_module 里同步完成，
                // pid 为 0，不需要 waitpid —— 直接进入发布/提交分支。
                let waited int = pids[i] == 0 ? 0 : waitpid(pids[i], &status, 1)
                if (waited == pids[i]) {
                    active -= 1
                    progress = 1
                    if (status != 0) {
                        states[i] = 4
                        failed = 1
                        break
                    }
                    states[i] = 3
                    completed += 1
                    if (support.session().check_only != 0) {
                        pj_out_s("  [检查] ")
                    } else {
                        if (mb_sched_publish_interface(proj.ctx().order[i], build_off,
                                build_len) != 0) {
                            failed = 1
                            break
                        }
                        if (mb_manifest_commit(proj.ctx().order[i], build_off, build_len,
                                keys + (i * cache.CACHE_ID_SIZE)) != 0) {
                            failed = 1
                            break
                        }
                        pj_out_s("  [编译] ")
                    }
                    pj_out_np(proj.ctx().mods[proj.ctx().order[i]].name_off,
                        proj.ctx().mods[proj.ctx().order[i]].name_len)
                    pj_out_s("\n")
                } else if (waited < 0) {
                    kill(pids[i], 15)
                    waitpid(pids[i], &status, 0)
                    active -= 1
                    states[i] = 4
                    failed = 1
                    break
                }
            }
            i += 1
        }
        if (failed != 0) {
            break
        }
        if (mb_sched_refresh_interfaces(states, count, build_off, build_len) != 0) {
            failed = 1
            break
        }
        i = 0
        for i < count && active < mb_sched_worker_limit() {
            if (states[i] == 0) {
                let early int = 0
                let ready int = mb_sched_deps_ready(proj.ctx().order[i], states, count,
                    build_off, build_len, &early)
                if (ready < 0) {
                    failed = 1
                    break
                }
                if (ready != 0) {
                    let pid int = 0
                    let started int = mb_compile_start(proj.ctx().order[i], root_off,
                        root_len, build_off, build_len, &pid,
                        keys + (i * cache.CACHE_ID_SIZE))
                    if (started < 0) {
                        failed = 1
                        break
                    }
                    progress = 1
                    if (started == 1) {
                        states[i] = 3
                        completed += 1
                    } else {
                        states[i] = 1
                        pids[i] = pid
                        active += 1
                        if (active > bc().sched_peak) {
                            bc().sched_peak = active
                        }
                        if (early != 0) {
                            bc().sched_iface_early += 1
                        }
                    }
                }
            }
            i += 1
        }
        if (failed != 0) {
            break
        }
        if (completed < count && active == 0 && progress == 0) {
            failed = 1
            support.fail("内部错误：并行构建无法满足模块依赖")
            break
        }
        if (completed < count && progress == 0) {
            usleep(1000)
        }
    }
    if (failed != 0) {
        mb_sched_cancel_workers(states, pids, count)
        if (support.session().check_only != 0) {
            support.fail("项目语义检查失败")
        } else {
            support.fail("模块编译失败；已停止最终链接")
        }
    }
    mb_sched_clear_interfaces(count, build_off, build_len)
    free(states)
    free(pids)
    free(keys)
    if (failed != 0) {
        return -1
    }
    return 0
}
