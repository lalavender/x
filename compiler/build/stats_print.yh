module build

// stats_print.yh：--stats 单行输出的字段拼装（从 module_build 抽出，
// 便于 module_build 保持 arch-check 的文件预算；字段顺序与含义不变）。
import gen

// mb_print_stats：开发验收时输出当前进程的阶段计数；默认构建保持静默。
pub fn mb_print_stats() void {
    let gs *gen.GenState = gen.G()
    if (gs.c_stats_enabled == 0) {
        return
    }
    let buf [2048]u8
    let n int = 0
    n = gen.append_str(buf, n, "yh-stats lex=")
    n = gen.append_int(buf, n, gs.c_stats_lex)
    n = gen.append_str(buf, n, " syntax=")
    n = gen.append_int(buf, n, gs.c_stats_syntax)
    n = gen.append_str(buf, n, " index=")
    n = gen.append_int(buf, n, gs.c_stats_index)
    n = gen.append_str(buf, n, " pass1=")
    n = gen.append_int(buf, n, gs.c_stats_pass1)
    n = gen.append_str(buf, n, " globals=")
    n = gen.append_int(buf, n, gs.c_stats_globals)
    n = gen.append_str(buf, n, " functions=")
    n = gen.append_int(buf, n, gs.c_stats_functions)
    n = gen.append_str(buf, n, " ir_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_functions)
    n = gen.append_str(buf, n, " ir_cache_hits=")
    n = gen.append_int(buf, n, gs.c_stats_ir_cache_hits)
    n = gen.append_str(buf, n, " ir_cache_misses=")
    n = gen.append_int(buf, n, gs.c_stats_ir_cache_misses)
    n = gen.append_str(buf, n, " ir_lowered=")
    n = gen.append_int(buf, n, gs.c_stats_ir_lowered)
    n = gen.append_str(buf, n, " ast_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_nodes)
    n = gen.append_str(buf, n, " stmt_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_stmt_nodes)
    n = gen.append_str(buf, n, " decl_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_decl_nodes)
    n = gen.append_str(buf, n, " ast_refs=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_refs)
    n = gen.append_str(buf, n, " ast_bindings=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_bindings)
    n = gen.append_str(buf, n, " ast_functions=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_functions)
    n = gen.append_str(buf, n, " workers=")
    n = gen.append_int(buf, n, gs.c_stats_workers)
    n = gen.append_str(buf, n, " workers_peak=")
    n = gen.append_int(buf, n, mb_sched_peak)
    n = gen.append_str(buf, n, " iface_early=")
    n = gen.append_int(buf, n, mb_sched_iface_early)
    n = gen.append_str(buf, n, " asm=")
    n = gen.append_int(buf, n, gs.c_stats_asm)
    n = gen.append_str(buf, n, " link=")
    n = gen.append_int(buf, n, gs.c_stats_link)
    n = gen.append_str(buf, n, " compiler_hashes=")
    n = gen.append_int(buf, n, gs.c_stats_compiler_hashes)
    n = gen.append_str(buf, n, " time_project_ns=")
    n = gen.append_i64(buf, n, mb_stats_project_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_schedule_ns=")
    n = gen.append_i64(buf, n, mb_stats_schedule_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_object_ns=")
    n = gen.append_i64(buf, n, mb_stats_object_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_link_ns=")
    n = gen.append_i64(buf, n, mb_stats_link_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_total_ns=")
    let total_ns u64 = 0
    if (mb_stats_build_start_ns != 0) {
        let now u64 = cmd_clock_ns()
        if (now >= mb_stats_build_start_ns) {
            total_ns = now - mb_stats_build_start_ns
        }
    }
    n = gen.append_i64(buf, n, total_ns.to_type(i64))
    // PF2 归因：worker 内四段累计（父进程行通常为 0）；四段互斥，相加得到
    // 本进程后端编译的累计工作量，不包含链链与 --emit-llvm 的文本写出。
    n = gen.append_str(buf, n, " time_front_ns=")
    n = gen.append_i64(buf, n, mb_stats_front_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_ns=")
    n = gen.append_i64(buf, n, mb_stats_lower_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_irbuild_ns=")
    n = gen.append_i64(buf, n, mb_stats_irbuild_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_bridge_ns=")
    n = gen.append_i64(buf, n, mb_stats_bridge_ns.to_type(i64))
    // PL1：lowering 四段分解，紧跟 time_lower_ns 之后，便于工具成组解析。
    n = gen.append_str(buf, n, " time_lower_prep_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_prep_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_decl_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_decl_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_build_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_build_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_verify_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_verify_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_lookup_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_lookup_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_cache_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_cache_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_fn_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_fn_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_lower_capture_ns=")
    n = gen.append_i64(buf, n, gs.c_stats_lower_capture_ns.to_type(i64))
    // 新覆盖字段追加在原统计行尾，保留已有性能工具的字段顺序和含义。
    n = gen.append_str(buf, n, " checked_functions=")
    n = gen.append_int(buf, n, gs.c_stats_checked_functions)
    n = gen.append_str(buf, n, " backend_emitted_functions=")
    n = gen.append_int(buf, n, gs.c_stats_backend_emitted)
    n = gen.append_str(buf, n, " rejected_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_rejected)
    n = gen.append_str(buf, n, " backend_rejected_functions=")
    n = gen.append_int(buf, n, gs.c_stats_backend_rejected)
    n = gen.append_str(buf, n, " fallback_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_rejected + gs.c_stats_backend_rejected)
    n = gen.append_str(buf, n, " check_cache_hits=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_hits)
    n = gen.append_str(buf, n, " check_cache_misses=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_misses)
    n = gen.append_str(buf, n, " check_skipped=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_skipped)
    n = gen.append_byte(buf, n, '\n')
    gen.write_all(2, buf, n)
}
