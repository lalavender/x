module build
import support

// stats_print.yh：--stats 单行输出的字段拼装（从 module_build 抽出，
// 便于 module_build 保持 arch-check 的文件预算；字段顺序与含义不变）。
import link

// mb_print_stats：开发验收时输出当前进程的阶段计数；默认构建保持静默。
pub fn mb_print_stats() void {
    if (support.stats().enabled == 0) {
        return
    }
    let buf [2048]u8
    let n int = 0
    n = support.append_str(buf, n, "yh-stats lex=")
    n = support.append_int(buf, n, support.stats().lex)
    n = support.append_str(buf, n, " syntax=")
    n = support.append_int(buf, n, support.stats().syntax)
    n = support.append_str(buf, n, " index=")
    n = support.append_int(buf, n, support.stats().index)
    n = support.append_str(buf, n, " pass1=")
    n = support.append_int(buf, n, support.stats().pass1)
    n = support.append_str(buf, n, " globals=")
    n = support.append_int(buf, n, support.stats().globals)
    n = support.append_str(buf, n, " functions=")
    n = support.append_int(buf, n, support.stats().functions)
    n = support.append_str(buf, n, " ir_functions=")
    n = support.append_int(buf, n, support.stats().ir_functions)
    n = support.append_str(buf, n, " ir_cache_hits=")
    n = support.append_int(buf, n, support.stats().ir_cache_hits)
    n = support.append_str(buf, n, " ir_cache_misses=")
    n = support.append_int(buf, n, support.stats().ir_cache_misses)
    n = support.append_str(buf, n, " ir_lowered=")
    n = support.append_int(buf, n, support.stats().ir_lowered)
    n = support.append_str(buf, n, " ast_nodes=")
    n = support.append_int(buf, n, support.session().stats_ast_nodes)
    n = support.append_str(buf, n, " stmt_nodes=")
    n = support.append_int(buf, n, support.session().stats_stmt_nodes)
    n = support.append_str(buf, n, " decl_nodes=")
    n = support.append_int(buf, n, support.session().stats_decl_nodes)
    n = support.append_str(buf, n, " ast_refs=")
    n = support.append_int(buf, n, support.session().stats_ast_refs)
    n = support.append_str(buf, n, " ast_bindings=")
    n = support.append_int(buf, n, support.session().stats_ast_bindings)
    n = support.append_str(buf, n, " ast_functions=")
    n = support.append_int(buf, n, support.session().stats_ast_functions)
    n = support.append_str(buf, n, " workers=")
    n = support.append_int(buf, n, support.stats().workers)
    n = support.append_str(buf, n, " workers_peak=")
    n = support.append_int(buf, n, bc().sched_peak)
    n = support.append_str(buf, n, " iface_early=")
    n = support.append_int(buf, n, bc().sched_iface_early)
    n = support.append_str(buf, n, " asm=")
    n = support.append_int(buf, n, support.stats().asm)
    n = support.append_str(buf, n, " link=")
    n = support.append_int(buf, n, support.stats().link)
    n = support.append_str(buf, n, " compiler_hashes=")
    n = support.append_int(buf, n, support.stats().compiler_hashes)
    n = support.append_str(buf, n, " time_project_ns=")
    n = support.append_i64(buf, n, bc().project_ns.to_type(i64))
    n = support.append_str(buf, n, " time_schedule_ns=")
    n = support.append_i64(buf, n, bc().schedule_ns.to_type(i64))
    n = support.append_str(buf, n, " time_object_ns=")
    n = support.append_i64(buf, n, link.object_ns().to_type(i64))
    n = support.append_str(buf, n, " time_link_ns=")
    n = support.append_i64(buf, n, link.link_ns().to_type(i64))
    n = support.append_str(buf, n, " time_total_ns=")
    let total_ns u64 = 0
    if (bc().build_start_ns != 0) {
        let now u64 = support.clock_ns()
        if (now >= bc().build_start_ns) {
            total_ns = now - bc().build_start_ns
        }
    }
    n = support.append_i64(buf, n, total_ns.to_type(i64))
    // PF2 归因：worker 内四段累计（父进程行通常为 0）；四段互斥，相加得到
    // 本进程后端编译的累计工作量，不包含链链与 --emit-llvm 的文本写出。
    n = support.append_str(buf, n, " time_front_ns=")
    n = support.append_i64(buf, n, bc().front_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_ns=")
    n = support.append_i64(buf, n, bc().lower_ns.to_type(i64))
    n = support.append_str(buf, n, " time_irbuild_ns=")
    n = support.append_i64(buf, n, bc().irbuild_ns.to_type(i64))
    n = support.append_str(buf, n, " time_bridge_ns=")
    n = support.append_i64(buf, n, bc().bridge_ns.to_type(i64))
    // PL1：lowering 四段分解，紧跟 time_lower_ns 之后，便于工具成组解析。
    n = support.append_str(buf, n, " time_lower_prep_ns=")
    n = support.append_i64(buf, n, support.stats().lower_prep_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_decl_ns=")
    n = support.append_i64(buf, n, support.stats().lower_decl_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_build_ns=")
    n = support.append_i64(buf, n, support.stats().lower_build_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_verify_ns=")
    n = support.append_i64(buf, n, support.stats().lower_verify_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_lookup_ns=")
    n = support.append_i64(buf, n, support.stats().lower_lookup_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_cache_ns=")
    n = support.append_i64(buf, n, support.stats().lower_cache_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_fn_ns=")
    n = support.append_i64(buf, n, support.stats().lower_fn_ns.to_type(i64))
    n = support.append_str(buf, n, " time_lower_capture_ns=")
    n = support.append_i64(buf, n, support.stats().lower_capture_ns.to_type(i64))
    // 新覆盖字段追加在原统计行尾，保留已有性能工具的字段顺序和含义。
    n = support.append_str(buf, n, " checked_functions=")
    n = support.append_int(buf, n, support.stats().checked_functions)
    n = support.append_str(buf, n, " backend_emitted_functions=")
    n = support.append_int(buf, n, support.stats().backend_emitted)
    n = support.append_str(buf, n, " rejected_functions=")
    n = support.append_int(buf, n, support.stats().ir_rejected)
    n = support.append_str(buf, n, " backend_rejected_functions=")
    n = support.append_int(buf, n, support.stats().backend_rejected)
    n = support.append_str(buf, n, " fallback_functions=")
    n = support.append_int(buf, n, support.stats().ir_rejected + support.stats().backend_rejected)
    n = support.append_str(buf, n, " check_cache_hits=")
    n = support.append_int(buf, n, support.stats().check_cache_hits)
    n = support.append_str(buf, n, " check_cache_misses=")
    n = support.append_int(buf, n, support.stats().check_cache_misses)
    n = support.append_str(buf, n, " check_skipped=")
    n = support.append_int(buf, n, support.stats().check_cache_skipped)
    n = support.append_byte(buf, n, '\n')
    support.write_all(2, buf, n)
}
