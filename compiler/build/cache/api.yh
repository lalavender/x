module cache

import token
import hash
import support
// ============================================================================
// api.yh —— cache 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// 键 schema 版本：C0 起使用 SHA-256 与长度分帧；+CacheInputs/相对路径时递增。
pub const CACHE_SCHEMA_VERSION int = 3

// ActionID/OutputID 的二进制与文本长度（后者含结尾零）。
pub const CACHE_ID_SIZE int = 32

pub const CACHE_ID_HEX int = 64

pub const CACHE_ID_TEXT int = 65

// action 种类：进入键前缀，避免不同缓存层复用同一组输入时互相误命中。
pub const ACTION_MODULE int = 1

pub const ACTION_FILE int = 2

pub const ACTION_CHECK int = 3

pub const ACTION_IR int = 4

pub const ACTION_LINK int = 5

// 输出角色：action entry 中的稳定分类（C4 写入，当前只定义）。
pub const OUTPUT_OBJECT int = 1

pub const OUTPUT_IFACE int = 2

pub const OUTPUT_CT_IFACE int = 3

pub const OUTPUT_CHECK int = 4

pub const OUTPUT_IR int = 5

pub const OUTPUT_SUPPORT int = 6

// Key：一次 action 键计算的流式状态；只能由 key_init 开始。
pub struct Key {
    sha hash.Sha256
}

// CacheInputs：函数语义键允许读取的目标/环境白名单。
// SDK、selfhost 闭包与工具链已先解析成内容身份，汇总在 env_key / 编译器身份里；
// 这里只保留 target、ABI、优化级别与 trimpath 这些直接影响代码或来源表的输入。
pub struct CacheInputs {
    target_key int
    pointer_bits int
    layout_version int
    abi *char
    opt_level int
    trimpath int
}

pub const CACHE_ACTION_MAX_ENTRIES int = 16

pub const CACHE_ROOT_MAX int = 4096

// CacheEntry：action entry 里的一个输出角色。
// id 是 OutputID 原始 32 字节；size 是发布时记录的字节数（已存在内容可能为 0，
// 读取端只把它当提示，不用于分配）。
pub struct CacheEntry {
    role int
    size u64
    id [CACHE_ID_SIZE]u8
}

// CacheStore：一次编译进程持有的全局缓存配置。
pub struct CacheStore {
    root [CACHE_ROOT_MAX]u8
    root_len int
    enabled int
    ready int
    max_size u64
}

// key_mix_u64：按小端八字节混入；调用方无需关心平台字节序。
pub fn key_mix_u64(key *Key, value u64) int {
    if (key == 0) { return -1 }
    let bytes [8]u8
    let i int = 0
    for i < 8 {
        bytes[i] = ((value >> (i * 8)) & 255).to_type(u8)
        i += 1
    }
    return hash.sha256_update(&key.sha, &bytes[0], 8)
}

// key_mix_int：把 int 的补码位型按小端八字节混入。
pub fn key_mix_int(key *Key, value int) int {
    return key_mix_u64(key, value.to_type(i64).to_type(u64))
}

// key_mix_bytes：先混入长度再混入字节，避免相邻字段拼接歧义。
pub fn key_mix_bytes(key *Key, data *u8, count int) int {
    if (key == 0 || count < 0 || (data == 0 && count > 0)) { return -1 }
    if (key_mix_u64(key, count.to_type(u64)) != 0) { return -1 }
    if (count == 0) { return 0 }
    return hash.sha256_update(&key.sha, data, count.to_type(u64))
}

// key_mix_text：混入 NUL 结尾文本（不含结尾零）；空指针返回 -1。
pub fn key_mix_text(key *Key, text *char) int {
    if (key == 0 || text == 0) { return -1 }
    return key_mix_bytes(key, text.to_type(*u8), strlen(text).to_type(int))
}

// key_init：写入统一 schema 前缀；0 = 成功。
pub fn key_init(key *Key, kind int, label *char) int {
    if (key == 0 || label == 0) { return -1 }
    hash.sha256_init(&key.sha)
    if (key_mix_text(key, "yh-cache-key") != 0) { return -1 }
    if (key_mix_int(key, CACHE_SCHEMA_VERSION) != 0) { return -1 }
    if (key_mix_int(key, kind) != 0) { return -1 }
    return key_mix_text(key, label)
}

// key_init_function：函数 check/IR 键的公共前缀。
// env_key 是模块环境事实（依赖接口/目标/优化/编译器身份）的摘要；inputs 是
// CacheInputs 白名单；path 是项目相对源文件路径。action 由调用方区分 check 与
// IR（两者不复用同一记录）。
pub fn key_init_function(key *Key, action int, env_key u64,
    inputs *CacheInputs, path *char) int {
    if (inputs == 0) { return -1 }
    if (key_init(key, action, "function") != 0) { return -1 }
    if (key_mix_u64(key, env_key) != 0) { return -1 }
    if (key_mix_int(key, inputs.target_key) != 0) { return -1 }
    if (key_mix_int(key, inputs.pointer_bits) != 0) { return -1 }
    if (key_mix_int(key, inputs.layout_version) != 0) { return -1 }
    if (key_mix_text(key, inputs.abi) != 0) { return -1 }
    if (key_mix_int(key, inputs.opt_level) != 0) { return -1 }
    if (key_mix_int(key, inputs.trimpath) != 0) { return -1 }
    return key_mix_text(key, path)
}

// key_mix_file：把文件内容摘要（SHA-256）混入键；文件缺失返回 -1。
// 用摘要而不是整文件字节，避免键计算路径把大文件常驻内存；摘要本身已
// 由流式 SHA-256 计算。
pub fn key_mix_file(key *Key, path *char) int {
    if (key == 0 || path == 0) { return -1 }
    let digest [32]u8
    if (hash.sha256_file(path, &digest[0]) != 0) { return -1 }
    return key_mix_bytes(key, &digest[0], 32)
}

// key_mix_tokens：把一段词法 token（种类 + 长度 + 源字节）混入键。
// 词法器已剥离注释/空白，因此注释变化不会让函数/文件键失效。
// 0 = 成功，-1 = 范围非法（该函数跳过缓存）。
pub fn key_mix_tokens(key *Key, source *u8, source_len int,
    tokens *token.Tok, token_count int, first int, after int) int {
    if (key == 0 || source == 0 || tokens == 0 || source_len < 0
        || token_count < 0 || first < 0 || after <= first
        || after > token_count) { return -1 }
    if (key_mix_int(key, after - first) != 0) { return -1 }
    let i int = first
    for i < after {
        let tok token.Tok = tokens[i]
        if (tok.start < 0 || tok.len < 0 || tok.start + tok.len > source_len) {
            return -1
        }
        if (key_mix_int(key, tok.kind) != 0) { return -1 }
        if (key_mix_u64(key, tok.len.to_type(u64)) != 0) { return -1 }
        if (tok.len > 0
            && hash.sha256_update(&key.sha, source + tok.start,
                tok.len.to_type(u64)) != 0) { return -1 }
        i += 1
    }
    return 0
}

// key_mix_type_facts：混入 ABI 相关类型事实；present=0 表示类型缺失。
// 不混 type_id 这类 arena 下标，避免检查顺序改变键。
pub fn key_mix_type_facts(key *Key, present int, kind int, size int,
    align int) int {
    if (key_mix_int(key, present) != 0) { return -1 }
    if (present == 0) { return 0 }
    if (key_mix_int(key, kind) != 0) { return -1 }
    if (key_mix_int(key, size) != 0) { return -1 }
    return key_mix_int(key, align)
}

// id_parse_hex：把 64 位小写十六进制文本解析为 32 字节 ID；非法返回 -1。
pub fn id_parse_hex(text *char, out *u8) int {
    if (text == 0 || out == 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_HEX {
        let c u8 = text[i].to_type(u8)
        let high int = -1
        if (c >= '0' && c <= '9') { high = c - '0' }
        if (c >= 'a' && c <= 'f') { high = c - 'a' + 10 }
        i += 1
        if (high < 0) { return -1 }
        let c2 u8 = text[i].to_type(u8)
        let low int = -1
        if (c2 >= '0' && c2 <= '9') { low = c2 - '0' }
        if (c2 >= 'a' && c2 <= 'f') { low = c2 - 'a' + 10 }
        if (low < 0) { return -1 }
        out[i / 2] = (high * 16 + low).to_type(u8)
        i += 1
    }
    return text[CACHE_ID_HEX] == 0 ? 0 : -1
}

// key_finish：写 32 字节二进制 ActionID；0 = 成功。
pub fn key_finish(key *Key, out *u8) int {
    if (key == 0 || out == 0) { return -1 }
    return hash.sha256_final(&key.sha, out)
}

// key_finish_hex：写 64 位十六进制 ActionID + 结尾零；out 至少 65 字节。
pub fn key_finish_hex(key *Key, out *u8) int {
    if (key == 0 || out == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (key_finish(key, &digest[0]) != 0) { return -1 }
    return hash.sha256_hex(&digest[0], out)
}

// store_init：设置缓存根与开关；root 末尾斜杠会被去掉。0 = 成功。
pub fn store_init(store *CacheStore, root *char, enabled int, max_size u64) int {
    if (store == 0 || root == 0) { return -1 }
    let n int = strlen(root).to_type(int)
    if (n <= 0 || n + 1 > CACHE_ROOT_MAX) { return -1 }
    for n > 1 && root[n - 1] == '/' { n -= 1 }
    let i int = 0
    for i < n {
        store.root[i] = root[i].to_type(u8)
        i += 1
    }
    store.root[n] = 0
    store.root_len = n
    store.enabled = enabled != 0 ? 1 : 0
    store.ready = 1
    store.max_size = max_size
    return 0
}

// store_disable：显式关闭全局缓存；后续 put/get 全部按 miss 处理。
pub fn store_disable(store *CacheStore) void {
    if (store == 0) { return }
    store.enabled = 0
    store.ready = 1
    store.root_len = 0
}

// store_enabled：0 = 未启用（或未初始化）。
pub fn store_enabled(store *CacheStore) int {
    if (store == 0 || store.ready == 0 || store.enabled == 0
        || store.root_len <= 0) { return 0 }
    return 1
}

// store_task：取当前任务绑定的 CacheStore；未绑定返回 0。
// 指针由 build 在 mb_cache_init 写入 TaskCtx，ast/lower 因此无需 import build。
pub fn store_task() *CacheStore {
    let p *void = store_bound()
    if (p == 0) { return 0 }
    return p.to_type(*CacheStore)
}

// store_lookup：按 64 hex ActionID + role 从全局 action 读取输出内容，
// 内容经 OutputID 校验。1 = 命中（调用方 free），0 = miss/关闭。
pub fn store_lookup(store *CacheStore, action_hex *char, role int,
    out_data **u8, out_size *int) int {
    if (out_data != 0) { out_data[0] = 0 }
    if (out_size != 0) { out_size[0] = 0 }
    if (store_enabled(store) == 0 || action_hex == 0 || out_data == 0
        || out_size == 0) { return 0 }
    let action_id [CACHE_ID_SIZE]u8
    if (id_parse_hex(action_hex, &action_id[0]) != 0) { return 0 }
    let entries [4]CacheEntry
    let count int = 0
    if (store_action_get(store, &action_id[0], &entries[0], 4, &count) != 1) {
        return 0
    }
    let i int = 0
    for i < count {
        if (entries[i].role == role) {
            return store_get_bytes(store, &entries[i].id[0], out_data, out_size)
        }
        i += 1
    }
    return 0
}

// store_parse_size：解析 123、10G、512M、1T 形式（1024 进制，可选 B/iB）。
// 成功返回 0；非法或为 0 返回 -1。max_size 单位是字节。
pub fn store_parse_size(text *char, out_size *u64) int {
    if (text == 0 || out_size == 0) { return -1 }
    let i int = 0
    let value u64 = 0
    let digits int = 0
    for text[i] >= '0' && text[i] <= '9' {
        if (value > 9000000000000000000) { return -1 }
        value = value * 10 + (text[i] - '0').to_type(u64)
        digits += 1
        i += 1
    }
    if (digits == 0) { return -1 }
    let factor u64 = 1
    let c char = text[i]
    if (c == 'k' || c == 'K') { factor = 1024; i += 1 }
    if (c == 'm' || c == 'M') { factor = 1048576; i += 1 }
    if (c == 'g' || c == 'G') { factor = 1073741824; i += 1 }
    if (c == 't' || c == 'T') { factor = 1099511627776; i += 1 }
    if (text[i] == 'i' || text[i] == 'I') { i += 1 }
    if (text[i] == 'b' || text[i] == 'B') { i += 1 }
    if (text[i] != 0) { return -1 }
    if (value == 0) { return -1 }
    out_size[0] = value * factor
    return 0
}

// store_output_path：<root>/v1/outputs/<id hex>。
pub fn store_output_path(store *CacheStore, id *u8, out *u8,
    capacity int) int {
    if (id == 0) { return -1 }
    let hex [CACHE_ID_TEXT]u8
    if (cs_id_hex(id, &hex[0]) != 0) { return -1 }
    return cs_build_path(store, "outputs", support.arr_cstr(&hex[0]), out, capacity)
}

// store_action_path：<root>/v1/actions/<id hex>。
pub fn store_action_path(store *CacheStore, id *u8, out *u8,
    capacity int) int {
    if (id == 0) { return -1 }
    let hex [CACHE_ID_TEXT]u8
    if (cs_id_hex(id, &hex[0]) != 0) { return -1 }
    return cs_build_path(store, "actions", support.arr_cstr(&hex[0]), out, capacity)
}

// store_begin_write / store_end_write：给 build 侧 clean/trim 使用的写锁窄口。
pub fn store_begin_write(store *CacheStore) int {
    return store_lock(store)
}

pub fn store_end_write(fd int) void {
    store_unlock(fd)
}

// store_put_bytes：把 bytes 写成 OutputID；已存在相同内容时直接返回。
// 0 = 成功，-1 = 参数/IO 失败（调用方按缓存写失败处理，不影响构建）。
pub fn store_put_bytes(store *CacheStore, data *u8, size int, out_id *u8,
    out_size *u64) int {
    if (store_enabled(store) == 0 || data == 0 || size < 0 || out_id == 0
        || out_size == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_digest(data, size.to_type(u64), &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_SIZE {
        out_id[i] = digest[i]
        i += 1
    }
    out_size[0] = size.to_type(u64)
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, &digest[0], &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    if (cs_file_exists(support.arr_cstr(&path[0])) != 0
        && cs_file_matches(support.arr_cstr(&path[0]), &digest[0]) != 0) {
        return 0
    }
    let name [128]u8
    let n int = 0
    n = support.append_str(&name[0], n, "put-")
    n = support.append_int(&name[0], n, getpid())
    n = support.append_byte(&name[0], n, '-')
    let hex [CACHE_ID_TEXT]u8
    hash.sha256_hex(&digest[0], &hex[0])
    n = support.append_str_limit(&name[0], n, 64, support.arr_cstr(&hex[0]))
    name[n] = 0
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, support.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) { return -1 }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) { return -1 }
    // 等锁期间别的进程可能已发布同一内容；再次校验避免重复写。
    if (cs_file_exists(support.arr_cstr(&path[0])) != 0
        && cs_file_matches(support.arr_cstr(&path[0]), &digest[0]) != 0) {
        store_unlock(lock_fd)
        return 0
    }
    let rc int = cs_write_atomic(support.arr_cstr(&tmp[0]), support.arr_cstr(&path[0]),
        data, size)
    store_unlock(lock_fd)
    return rc
}

// store_put_file：按文件内容发布输出；成功写 out_id 与 out_size（内容已存在时
// out_size 可能为 0，读取端不依赖它）。0 = 成功，-1 = 失败。
pub fn store_put_file(store *CacheStore, path *char, out_id *u8,
    out_size *u64) int {
    if (store_enabled(store) == 0 || path == 0 || out_id == 0
        || out_size == 0) { return -1 }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_file(path, &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < CACHE_ID_SIZE {
        out_id[i] = digest[i]
        i += 1
    }
    out_size[0] = 0
    let opath [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, &digest[0], &opath[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    if (cs_file_exists(support.arr_cstr(&opath[0])) != 0
        && cs_file_matches(support.arr_cstr(&opath[0]), &digest[0]) != 0) {
        return 0
    }
    let name [160]u8
    let n int = 0
    n = support.append_str(&name[0], n, "put-file-")
    n = support.append_int(&name[0], n, getpid())
    n = support.append_byte(&name[0], n, '-')
    let hex [CACHE_ID_TEXT]u8
    hash.sha256_hex(&digest[0], &hex[0])
    n = support.append_str_limit(&name[0], n, 32, support.arr_cstr(&hex[0]))
    name[n] = 0
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, support.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) { return -1 }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) { return -1 }
    if (cs_file_exists(support.arr_cstr(&opath[0])) != 0
        && cs_file_matches(support.arr_cstr(&opath[0]), &digest[0]) != 0) {
        store_unlock(lock_fd)
        return 0
    }
    let fd_in int = open(path, 0)
    if (fd_in < 0) { store_unlock(lock_fd); return -1 }
    let fd_out int = cs_open_out(support.arr_cstr(&tmp[0]))
    if (fd_out < 0) { close(fd_in); store_unlock(lock_fd); return -1 }
    let buffer *u8 = malloc(CACHE_IO_BUFFER.to_type(u64)).to_type(*u8)
    if (buffer == 0) {
        close(fd_in)
        close(fd_out)
        unlink(support.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    let total u64 = 0
    for 1 {
        let got i64 = read(fd_in, buffer, CACHE_IO_BUFFER.to_type(u64))
        if (got < 0) {
            free(buffer.to_type(*void))
            close(fd_in)
            close(fd_out)
            unlink(support.arr_cstr(&tmp[0]))
            store_unlock(lock_fd)
            return -1
        }
        if (got == 0) { break }
        if (support.write_all(fd_out, buffer, got.to_type(int)) != 0) {
            free(buffer.to_type(*void))
            close(fd_in)
            close(fd_out)
            unlink(support.arr_cstr(&tmp[0]))
            store_unlock(lock_fd)
            return -1
        }
        total += got.to_type(u64)
    }
    free(buffer.to_type(*void))
    close(fd_in)
    if (close(fd_out) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    if (rename(support.arr_cstr(&tmp[0]), support.arr_cstr(&opath[0])) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        store_unlock(lock_fd)
        return -1
    }
    out_size[0] = total
    store_unlock(lock_fd)
    return 0
}

// store_get_file：把 OutputID 复制到 dest；复制时重算摘要，损坏按 miss。
// 1 = 成功，0 = 缺失/摘要不符，-1 = 参数/本地写失败。
pub fn store_get_file(store *CacheStore, id *u8, dest *char) int {
    if (store_enabled(store) == 0 || id == 0 || dest == 0) { return -1 }
    let src [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, id, &src[0], CACHE_ROOT_MAX + 128) != 0) {
        return -1
    }
    let fd_in int = open(support.arr_cstr(&src[0]), 0)
    if (fd_in < 0) { return 0 }
    let tmp [CACHE_ROOT_MAX + 256]u8
    let tn int = 0
    tn = support.append_str(&tmp[0], 0, dest)
    tn = support.append_str(&tmp[0], tn, ".yh-cache-tmp.")
    tn = support.append_int(&tmp[0], tn, getpid())
    tmp[tn] = 0
    let fd_out int = cs_open_out(support.arr_cstr(&tmp[0]))
    if (fd_out < 0) { close(fd_in); return -1 }
    let buffer *u8 = malloc(CACHE_IO_BUFFER.to_type(u64)).to_type(*u8)
    if (buffer == 0) {
        close(fd_in)
        close(fd_out)
        unlink(support.arr_cstr(&tmp[0]))
        return -1
    }
    let sha hash.Sha256
    hash.sha256_init(&sha)
    let ok int = 1
    for 1 {
        let got i64 = read(fd_in, buffer, CACHE_IO_BUFFER.to_type(u64))
        if (got < 0) { ok = 0; break }
        if (got == 0) { break }
        if (hash.sha256_update(&sha, buffer, got.to_type(u64)) != 0
            || support.write_all(fd_out, buffer, got.to_type(int)) != 0) {
            ok = 0
            break
        }
    }
    free(buffer.to_type(*void))
    close(fd_in)
    if (close(fd_out) != 0) { ok = 0 }
    let digest [CACHE_ID_SIZE]u8
    if (ok != 0 && hash.sha256_final(&sha, &digest[0]) != 0) { ok = 0 }
    if (ok != 0) {
        let i int = 0
        for i < CACHE_ID_SIZE {
            if (digest[i] != id[i]) { ok = 0; break }
            i += 1
        }
    }
    if (ok == 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return 0
    }
    if (rename(support.arr_cstr(&tmp[0]), dest) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return -1
    }
    return 1
}

// store_get_bytes：读取 OutputID 到 malloc 缓冲并校验摘要。
// 1 = 成功（调用方 free），0 = 缺失/损坏/超限。
pub fn store_get_bytes(store *CacheStore, id *u8, out_data **u8,
    out_size *int) int {
    if (store_enabled(store) == 0 || id == 0 || out_data == 0
        || out_size == 0) { return 0 }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_output_path(store, id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return 0
    }
    if (cs_read_file(support.arr_cstr(&path[0]), out_data, out_size) == 0) {
        return 0
    }
    let digest [CACHE_ID_SIZE]u8
    if (hash.sha256_digest(out_data[0], out_size[0].to_type(u64), &digest[0]) != 0) {
        free(out_data[0].to_type(*void))
        out_data[0] = 0
        out_size[0] = 0
        return 0
    }
    let i int = 0
    for i < CACHE_ID_SIZE {
        if (digest[i] != id[i]) {
            free(out_data[0].to_type(*void))
            out_data[0] = 0
            out_size[0] = 0
            return 0
        }
        i += 1
    }
    return 1
}

// store_action_put：原子写 ActionID → 输出角色表；0 = 成功，-1 = 失败。
pub fn store_action_put(store *CacheStore, action_id *u8,
    entries *CacheEntry, count int) int {
    if (store_enabled(store) == 0 || action_id == 0 || entries == 0
        || count <= 0 || count > CACHE_ACTION_MAX_ENTRIES) { return -1 }
    let size int = CACHE_ACTION_HEAD_BYTES + count * CACHE_ACTION_ENTRY_BYTES
    let data *u8 = malloc(size.to_type(u64)).to_type(*u8)
    if (data == 0) { return -1 }
    let cursor int = 0
    cs_put_u64(data, &cursor, CACHE_ACTION_MAGIC)
    cs_put_u64(data, &cursor, CACHE_ACTION_VERSION)
    cs_put_u64(data, &cursor, count.to_type(u64))
    let i int = 0
    for i < count {
        cs_put_u64(data, &cursor, entries[i].role.to_type(u64))
        cs_put_u64(data, &cursor, entries[i].size)
        let j int = 0
        for j < CACHE_ID_SIZE {
            data[cursor] = entries[i].id[j]
            cursor += 1
            j += 1
        }
        i += 1
    }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_action_path(store, action_id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        free(data.to_type(*void))
        return -1
    }
    let name [160]u8
    let n int = 0
    n = support.append_str(&name[0], n, "action-")
    n = support.append_int(&name[0], n, getpid())
    let tmp [CACHE_ROOT_MAX + 256]u8
    if (store_tmp_path(store, support.arr_cstr(&name[0]), &tmp[0],
            CACHE_ROOT_MAX + 256) != 0) {
        free(data.to_type(*void))
        return -1
    }
    let lock_fd int = store_lock(store)
    if (lock_fd < 0) {
        free(data.to_type(*void))
        return -1
    }
    let rc int = cs_write_atomic(support.arr_cstr(&tmp[0]),
        support.arr_cstr(&path[0]), data, size)
    store_unlock(lock_fd)
    free(data.to_type(*void))
    return rc
}

// store_action_get：读 ActionID → 输出角色表；1 = 命中，0 = 缺失/损坏。
// 输出角色顺序保持写入顺序；调用方按 role 查找。
pub fn store_action_get(store *CacheStore, action_id *u8,
    entries *CacheEntry, capacity int, out_count *int) int {
    if (out_count != 0) { out_count[0] = 0 }
    if (store_enabled(store) == 0 || action_id == 0 || entries == 0
        || capacity <= 0 || out_count == 0) { return 0 }
    let path [CACHE_ROOT_MAX + 128]u8
    if (store_action_path(store, action_id, &path[0], CACHE_ROOT_MAX + 128) != 0) {
        return 0
    }
    let data *u8 = 0
    let size int = 0
    if (cs_read_file(support.arr_cstr(&path[0]), &data, &size) == 0) { return 0 }
    let cursor int = 0
    if (size < CACHE_ACTION_HEAD_BYTES
        || cs_get_u64(data, &cursor) != CACHE_ACTION_MAGIC
        || cs_get_u64(data, &cursor) != CACHE_ACTION_VERSION) {
        free(data.to_type(*void))
        return 0
    }
    let count u64 = cs_get_u64(data, &cursor)
    if (count == 0 || count > CACHE_ACTION_MAX_ENTRIES.to_type(u64)
        || count > capacity.to_type(u64)
        || size != CACHE_ACTION_HEAD_BYTES
            + count.to_type(int) * CACHE_ACTION_ENTRY_BYTES) {
        free(data.to_type(*void))
        return 0
    }
    let i int = 0
    for i < count.to_type(int) {
        let role u64 = cs_get_u64(data, &cursor)
        if (role > 0x7FFFFFFF) { free(data.to_type(*void)); return 0 }
        entries[i].role = role.to_type(int)
        entries[i].size = cs_get_u64(data, &cursor)
        let j int = 0
        for j < CACHE_ID_SIZE {
            entries[i].id[j] = data[cursor]
            cursor += 1
            j += 1
        }
        i += 1
    }
    free(data.to_type(*void))
    out_count[0] = count.to_type(int)
    return 1
}

// store_bind：绑定当前任务的 Store；build 在 cache_global_init 之后调用一次。
pub fn store_bind(store *void) void {
    g_bound_store = store
}

// store_bound：已绑定的 Store 指针；0 表示未绑定。
pub fn store_bound() *void {
    return g_bound_store
}

// cache_lock_file：平台无关入口；实现见 lock.<平台>.yh 的 cache_lock_file_impl。
pub fn cache_lock_file(fd int) int {
    return cache_lock_file_impl(fd)
}

// cache_unlock_file：平台无关入口；实现见 lock.<平台>.yh 的 cache_unlock_file_impl。
pub fn cache_unlock_file(fd int) {
    cache_unlock_file_impl(fd)
}

// POSIX flock 的 C 入口（Darwin/Linux 共用；Windows 另有实现）。
@[extern] fn flock(fd int, operation int) int
