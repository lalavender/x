module cache

// lock.linux.yh —— C6 的 POSIX flock 封装（Linux）。

@[extern] fn flock(fd int, operation int) int

// cache_lock_file：对已打开 fd 取阻塞独占 flock；0 = 成功。
pub fn cache_lock_file(fd int) int {
    if (fd < 0) { return -1 }
    return flock(fd, 2) == 0 ? 0 : -1
}

// cache_unlock_file：释放 flock；调用方随后负责 close。
pub fn cache_unlock_file(fd int) void {
    if (fd >= 0) { flock(fd, 8) }
}
