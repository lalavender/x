module build
import gen
import lex
import parse
import comptime
import ast
import check
import builtin

// ============================================================================
// llvm_emit.yh —— LLVM 后端发射的驱动侧共用入口（LL3）
//
// 本文件保留单文件前端与 CLI 形态转换；受检快照到 LLVM 文本/对象/汇编的
// 共用驱动在 cmd/llvm_pipeline.yh（LA1a），单文件 check 与编译共用
// llvm_check_single_file（LA1b）。
//
// 约束（与实施方案 LL3 一致）：
//   * 不调用任何外部 LLVM 工具（clang/llc/opt/llvm-as），只经内嵌桥；
//   * 形态不支持时带真实来源诊断并**停止发布产物**，绝不回退旧 ARM64 发射；
//   * 目标身份由 GenState 的 TargetInfo 提供，模块 IR 与桥各自再校验一次。
// ============================================================================

// llvm_emit_result：一次 LLVM 发射的产物统计，供 --stats 与门禁核对覆盖。
// emitted 是模块内实际发射的函数定义数，为 0 说明 lowering 拒绝或模块为空。
pub struct LLVMEmitResult {
    emitted int
    text_length int
}

// ============================================================================
// 单文件受检前端（LL3）
//
// 单文件路径（`yh --backend llvm -o out file.yh`）必须走到与项目 worker 相同的
// 受检形态，才能交出 CheckedModule 快照。这里采用与项目 worker 一致的
// 「已索引文件」形态：只有这一形态会给顶层声明编号，AST 捕获的
// ast_function_begin / ast_decl_attach_body 依赖该编号；旧单文件形态该编号恒为 -1。
// 单文件 check 与编译都从 llvm_check_single_file 进入，AST 捕获在语义遍历前
// 打开（c_ast_capture = 1），arena 一直活到 CheckedModule 快照生成之后。
// ============================================================================

// mb_llvm_file_begin：为单文件建立 PFile 只读快照并切到已索引形态。
// 路径同时进入 set_source_path 的固定缓冲（解析期诊断）与名字池（PFile.path_off，
// 快照与 lowering 诊断）。返回 0 成功，非 0 表示重复会话/路径过长/分配失败。
fn mb_llvm_file_begin(path *char) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_files != 0) { return 1 }
    if (gen.set_source_path(path) != 0) { return 1 }
    let path_len int = 0
    for path[path_len] != 0 { path_len += 1 }
    let path_off int = gen.tml_intern_str(path.to_type(*u8), 0, path_len)
    if (path_off < 0) { return 1 }
    let files *gen.PFile = malloc(sizeof(gen.PFile).to_type(u64)).to_type(*gen.PFile)
    if (files == 0) { return 1 }
    let file gen.PFile
    file.path_off = path_off
    file.path_len = path_len
    file.mod = -1
    file.line = 0
    file.source = gs.task.c_src
    file.source_len = gs.task.c_src_len
    file.tokens = gs.task.c_toks
    file.token_n = gs.task.c_tok_n
    file.decls = 0
    file.decl_n = 0
    files[0] = file
    gs.p_files = files
    gs.p_file_n = 1
    gs.p_file_cap = 1
    gs.task.c_active_file = 0
    gs.task.c_file_decl_i = -1
    gs.task.c_file_indexed = 1
    // 文件头与顶层声明索引：decl_index_file 之后逐条设置 c_file_decl_i。
    if (parse.mod_parse_head() != 0 || parse.decl_index_file(0) != 0) { return 1 }
    gs.task.c_pos = 0
    gs.task.c_file_decl_i = -1
    gs.task.c_file_decls = gs.p_files[0].decls
    gs.task.c_file_decl_n = gs.p_files[0].decl_n
    // 捕获开关与四个 arena 必须在语义遍历前打开：arena 要活到快照生成之后。
    gs.task.c_ast_capture = 1
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    return ast.ast_decl_add_file(0) == 0 ? 0 : 1
}

// mb_llvm_semantics：单文件受检语义两遍；require_main=0 用于库文件 check，
// =1 用于程序编译。入口检查条件化，但函数体、全局与编译期检查一律保留。
// 返回 0 成功；任一遍失败或产生诊断（c_errors > 0）返回非 0。
fn mb_llvm_semantics(require_main int) int {
    let tk *gen.TaskCtx = gen.task()
    comptime.ct_reset()
    tk.c_pass = 1
    tk.c_pos = 0
    if (parse.parse_indexed_decls(0) != 0 || tk.c_errors > 0) { return 1 }
    tk.c_pos = 0
    if (ast.ast_decl_bind_file(0) != 0) { return 1 }
    let main_status int = 0
    if (require_main != 0) {
        main_status = gen.sem_check_main()
    } else {
        main_status = gen.sem_check_main_optional()
    }
    if (main_status != 0) { return 1 }
    tk.c_pass = 2
    tk.c_pos = 0
    if (parse.parse_source_ct_fns() != 0 || tk.c_errors > 0) { return 1 }
    if (parse.parse_source_ct_layout_register() != 0) { return 1 }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_before == 0) { break }
        if (parse.parse_source_ct_layout_consts() != 0) { return 1 }
        if (parse.parse_source_ct_layout_exprs() != 0) { return 1 }
        if (comptime.ct_layout_advance() < 0) { return 1 }
        let pending_after int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_after == 0) { break }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic()
            } else {
                comptime.ct_value_stuck_diagnostic()
            }
            return 1
        }
    }
    if (comptime.ct_layout_resolve() != 0 || tk.c_errors > 0) { return 1 }
    if (parse.ct_enum_pending_run() != 0) { return 1 }
    tk.c_pos = 0
    if (parse.parse_source_globals() != 0 || tk.c_errors > 0) { return 1 }
    tk.c_pos = 0
    if (parse.parse_source_fns() != 0 || tk.c_errors > 0) { return 1 }
    let view ast.AstView
    ast.ast_view(&view)
    if (check.verify_module(&view) != 0) { return 1 }
    return 0
}

// llvm_check_single_file：单文件受检前端共用入口（LA1b）。
// 调用方必须先完成会话初始化、读源与 sem_init_tables；本函数负责词法、
// 单文件 PFile/声明索引、两遍语义与 CheckedModule 捕获/校验。
// require_main=0 用于库文件 check，=1 用于程序编译；helper 不 lowering、
// 不调用 LLVM、不写正式缓存。成功交付独占快照（out 由调用方释放），
// 失败不改 out 并保留前端诊断。
pub fn llvm_check_single_file(source_path *char, require_main int,
    out *ast.CheckedModule) int {
    let tk *gen.TaskCtx = gen.task()
    if (out == 0) { return -1 }
    if (gen.front_checked_begin() != 0) { return 1 }
    if (lex.lex_all() != 0) { return 1 }
    if (mb_llvm_file_begin(source_path) != 0) { return 1 }
    tk.c_compile = 1
    if (builtin.front_prepare() != 0) { return 1 }
    if (mb_llvm_semantics(require_main) != 0) { return 1 }
    if (gen.front_checked_verify() != 0) { return 1 }
    if (ast.checked_module_capture(out) != 0) { return -1 }
    let checked_status int = llvm_emit_verify_checked_snapshot(out)
    if (checked_status != 0) {
        ast.checked_module_release(out)
        return checked_status
    }
    if (gen.front_checked_end() != 0) {
        ast.checked_module_release(out)
        return 1
    }
    return 0
}

// llvm_emit_single_file：单文件入口（--emit-asm / -o）在 LLVM 模式下的实现。
// 调用方必须已完成会话初始化（state_init + 读源 + 语义表）；
// 受检前端由 llvm_check_single_file 建立，本函数只负责 CLI 形态与产物发布。
// link 非 0：产物是**可执行文件**（对象与可执行文件先写临时文件，验机后发布）；
// link 为 0：产物是**对象文件**（kind=0）或汇编文本（kind=1）。
// text_path 非空时额外写出 LLVM 文本（"-" = 标准输出）。
// 返回 0 成功、1 源/形态错误、-1 内部或桥失败。
pub fn llvm_emit_single_file(source_path *char, out_path *char, kind int,
    text_path *char, link int) int {
    let gs *gen.GenState = gen.G()
    // 单文件 check 与编译共用同一条受检前端；调用方只做过读源与建表。
    let checked ast.CheckedModule
    let checked_status int = llvm_check_single_file(source_path, 1, &checked)
    if (checked_status != 0) { return checked_status }
    // 链接形态先把对象写到 <out>.yh-tmp.o，避免与最终可执行文件同名。
    let object [620]u8
    let on int = 0
    let emit_path *char = out_path
    let link_tmp [720]u8
    let link_tmp_path *char = 0.to_type(*char)
    if (link != 0) {
        on = gen.append_str(&object[0], on, out_path)
        on = gen.append_str(&object[0], on, ".yh-tmp.o")
        object[on] = 0
        emit_path = gen.arr_cstr(&object[0])
        let link_len int = gen.append_str(&link_tmp[0], 0, out_path)
        link_len = gen.append_str(&link_tmp[0], link_len, ".yh-link-tmp")
        link_tmp[link_len] = 0
        link_tmp_path = gen.arr_cstr(&link_tmp[0])
    }
    // out_path 为空 = 只写 LLVM 文本（--emit-llvm 单文件形态），不调用桥。
    if (emit_path == 0) {
        let stats_only LLVMEmitResult
        let text_rc int = llvm_emit_text_only(&checked, text_path, &stats_only)
        ast.checked_module_release(&checked)
        return text_rc
    }
    let stats LLVMEmitResult
    // "--emit-asm" 形态：桥只按路径发布，因此先写临时文件再回显到标准输出。
    if (gen.cstr_eq(out_path, "-") != 0) {
        let temporary [64]u8
        let tn int = gen.append_str(&temporary[0], 0, "/tmp/yh-llvm-asm-")
        tn = gen.append_int(&temporary[0], tn, getpid())
        tn = gen.append_str(&temporary[0], tn, ".s")
        temporary[tn] = 0
        let asm int = llvm_emit_module_to(&checked, kind, gen.arr_cstr(&temporary[0]),
            text_path, &stats)
        ast.checked_module_release(&checked)
        if (asm != 0) {
            unlink(gen.arr_cstr(&temporary[0]))
            return -1
        }
        let fd int = open(gen.arr_cstr(&temporary[0]), 0x0, 0)
        if (fd < 0) {
            unlink(gen.arr_cstr(&temporary[0]))
            return gen.fail("无法读回 LLVM 汇编产物")
        }
        let chunk [4096]u8
        for 1 {
            let got i64 = read(fd, (&chunk[0]).to_type(*u8), 4096)
            if (got <= 0) { break }
            if (gen.write_all(1, (&chunk[0]).to_type(*u8), got.to_type(int)) != 0) {
                close(fd)
                unlink(gen.arr_cstr(&temporary[0]))
                return gen.fail("写入 LLVM 汇编到标准输出失败")
            }
        }
        close(fd)
        unlink(gen.arr_cstr(&temporary[0]))
        return 0
    }
    let emitted int = llvm_emit_module_to(&checked, kind, emit_path, text_path, &stats)
    ast.checked_module_release(&checked)
    if (emitted != 0) {
        if (link != 0) { unlink(gen.arr_cstr(&object[0])) }
        else { unlink(out_path) }
        return -1
    }
    if (link == 0) { return 0 }
    // 单文件链接沿用项目路径的目标选择；Linux x64/AArch64 有内嵌 lld 时不 fork cc。
    let link_rc int = -1
    if (mb_lld_darwin_enabled() != 0) {
        link_rc = mb_macho_link_single(gen.arr_cstr(&object[0]), link_tmp_path)
    } else if (mb_lld_linux_enabled() != 0) {
        let objects [2]*char
        objects[0] = gen.arr_cstr(&object[0])
        objects[1] = 0.to_type(*char)
        let extra_args [3]*char
        extra_args[0] = "-no-pie"
        extra_args[1] = "-lm"
        extra_args[2] = 0.to_type(*char)
        link_rc = mb_lld_link_worker(&objects[0], 1, &extra_args[0], 2,
            link_tmp_path)
    } else {
        let cc_storage [1200]u8
        let cc *char = mb_select_linker(&cc_storage[0])
        if (cc == 0) {
            unlink(gen.arr_cstr(&object[0]))
            return -1
        }
        let args [8]*char
        args[0] = cc
        args[1] = "-no-pie"
        args[2] = "-o"
        args[3] = link_tmp_path
        args[4] = gen.arr_cstr(&object[0])
        if (gs.c_target.os == gen.TARGET_OS_LINUX) {
            args[5] = "-lm"
            args[6] = 0.to_type(*char)
        } else {
            args[5] = 0.to_type(*char)
        }
        link_rc = cmd_process_run(&args[0])
    }
    unlink(gen.arr_cstr(&object[0]))
    if (link_rc == -2) {
        unlink(link_tmp_path)
        return gen.fail("内嵌 lld 链接 worker 已结束，未发布输出")
    }
    if (link_rc != 0) {
        unlink(link_tmp_path)
        return gen.fail_path("LLVM 产物链接失败: ", out_path)
    }
    if (mb_object_machine_matches(link_tmp_path) == 0) {
        unlink(link_tmp_path)
        return gen.fail_path("LLVM 链接产物架构与当前 target 不符: ", out_path)
    }
    if (mb_lld_darwin_enabled() != 0
        && mb_darwin_executable_matches(link_tmp_path) == 0) {
        unlink(link_tmp_path)
        return gen.fail_path("Darwin LLVM 链接产物版本或代码签名校验失败: ", out_path)
    }
    if (rename(link_tmp_path, out_path) != 0) {
        unlink(link_tmp_path)
        return gen.fail_path("无法发布 LLVM 链接产物: ", out_path)
    }
    return 0
}
