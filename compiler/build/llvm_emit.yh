module build
import token
import support
import parse
import comptime
import ast
import check
import proj

// mb_llvm_file_begin：为单文件建立 PFile 只读快照并切到已索引形态。
// 路径同时进入 set_source_path 的固定缓冲（解析期诊断）与名字池（PFile.path_off，
// 快照与 lowering 诊断）。返回 0 成功，非 0 表示重复会话/路径过长/分配失败。
fn mb_llvm_file_begin(path *char) int {
    if (proj.ctx().files != 0) { return 1 }
    if (support.set_source_path(path) != 0) { return 1 }
    let path_len int = 0
    for path[path_len] != 0 { path_len += 1 }
    let path_off int = support.tml_intern_str(path.to_type(*u8), 0, path_len)
    if (path_off < 0) { return 1 }
    let files *proj.PFile = malloc(sizeof(proj.PFile).to_type(u64)).to_type(*proj.PFile)
    if (files == 0) { return 1 }
    let file proj.PFile
    file.path_off = path_off
    file.path_len = path_len
    file.mod = -1
    file.line = 0
    file.source = support.src_ctx().data
    file.source_len = support.src_ctx().length
    file.tokens = token.ctx().tokens
    file.token_n = token.ctx().count
    file.decls = 0
    file.decl_n = 0
    files[0] = file
    proj.ctx().files = files
    proj.ctx().file_n = 1
    proj.ctx().file_cap = 1
    support.session().active_file = 0
    ast.store().file_decl_i = -1
    ast.store().file_indexed = 1
    // 文件头与顶层声明索引：decl_index_file 之后逐条设置 c_file_decl_i。
    if (parse.mod_parse_head() != 0 || parse.decl_index_file(0) != 0) { return 1 }
    token.ctx().pos = 0
    ast.store().file_decl_i = -1
    ast.store().file_decls = proj.ctx().files[0].decls
    ast.store().file_decl_n = proj.ctx().files[0].decl_n
    // 捕获开关与四个 arena 必须在语义遍历前打开：arena 要活到快照生成之后。
    support.session().ast_capture = 1
    ast.ast_expr_reset()
    ast.ast_stmt_reset()
    ast.ast_decl_reset()
    ast.ast_function_reset()
    return ast.ast_decl_add_file(0) == 0 ? 0 : 1
}

// mb_llvm_semantics：单文件受检语义两遍；require_main=0 用于库文件 check，
// =1 用于程序编译。入口检查条件化，但函数体、全局与编译期检查一律保留。
// 返回 0 成功；任一遍失败或产生诊断（c_errors > 0）返回非 0。
fn mb_llvm_semantics(require_main int) int {
    comptime.ct_reset()
    support.session().pass = 1
    token.ctx().pos = 0
    if (parse.parse_indexed_decls(0) != 0 || support.diag().errors > 0) { return 1 }
    token.ctx().pos = 0
    if (ast.ast_decl_bind_file(0) != 0) { return 1 }
    let main_status int = 0
    if (require_main != 0) {
        main_status = check.sem_check_main()
    } else {
        main_status = check.sem_check_main_optional()
    }
    if (main_status != 0) { return 1 }
    // UF1：单文件把该文件当作整个模块做未使用函数检查。
    let uf_files [1]int
    uf_files[0] = 0
    if (unused_function_report(&uf_files[0], 1, 0) != 0) { return 1 }
    support.session().pass = 2
    token.ctx().pos = 0
    if (parse.parse_source_ct_fns() != 0 || support.diag().errors > 0) { return 1 }
    if (parse.parse_source_ct_layout_register() != 0) { return 1 }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_before == 0) { break }
        if (parse.parse_source_ct_layout_consts() != 0) { return 1 }
        if (parse.parse_source_ct_layout_exprs() != 0) { return 1 }
        if (comptime.ct_layout_advance() < 0) { return 1 }
        let pending_after int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_after == 0) { break }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic()
            } else {
                comptime.ct_value_stuck_diagnostic()
            }
            return 1
        }
    }
    if (comptime.ct_layout_resolve() != 0 || support.diag().errors > 0) { return 1 }
    if (parse.ct_enum_pending_run() != 0) { return 1 }
    token.ctx().pos = 0
    if (parse.parse_source_globals() != 0 || support.diag().errors > 0) { return 1 }
    token.ctx().pos = 0
    if (parse.parse_source_fns() != 0 || support.diag().errors > 0) { return 1 }
    let view ast.AstView
    ast.ast_view(&view)
    // S3a：语句级隐式转换校验（parse 已不做，移到遍历 AST 之后、结构校验之前）。
    if (check.convert_returns(&view) != 0) { return 1 }
    if (check.convert_assigns(&view) != 0) { return 1 }
    if (check.verify_module(&view) != 0) { return 1 }
    return 0
}

// mb_env_to_buf：把环境变量值复制到 NUL 结尾缓冲，返回长度（0 = 未设置或过长）。
// 只用于拼宿主临时路径；调用方负责容量。
fn mb_env_to_buf(name *char, out *u8, capacity int) int {
    let off int = -1
    let len int = 0
    if (proj.env_fetch(name, &off, &len) != 0) { return 0 }
    if (len <= 0 || len + 1 >= capacity) { return 0 }
    let i int = 0
    for i < len {
        out[i] = support.pool_ctx().data[off + i]
        i += 1
    }
    out[len] = 0
    return len
}

