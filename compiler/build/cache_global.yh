module build
import support

import proj
import link
import cache

// ============================================================================
// cache_global.yh —— 全局 content store 的构建侧接线（C4）
//
// 本文件把模块 action 与 `YH_CACHE` 连接起来：
//   * 初始化全局缓存根（显式覆盖 / 平台默认 / off）；
//   * worker 成功后把 obj/.s.i/.s.ct 发布到 outputs + actions；
//   * 本地 manifest 未命中时按 ActionID 查询全局 action，命中则把输出
//     物化回项目 .build 并补写本地 manifest。
//
// 缓存失败只降级为 miss/不写入，不把构建判失败；最终可执行文件仍留在项目
// 本地，不进入全局缓存。
// ============================================================================

const CACHE_DEFAULT_MAX u64 = 10737418240 // 10 GiB

// mb_cache_join：把 base（NUL 串）与 suffix 拼成一条路径；容量不足返回 -1。
fn mb_cache_join(out *u8, capacity int, base *char, suffix *char) int {
    if (out == 0 || base == 0 || suffix == 0 || capacity <= 1) { return -1 }
    let n int = 0
    let i int = 0
    for base[i] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = base[i].to_type(u8)
        n += 1
        i += 1
    }
    if (n > 0 && out[n - 1] != '/') {
        if (n + 1 >= capacity) { return -1 }
        out[n] = '/'
        n += 1
    }
    i = 0
    for suffix[i] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = suffix[i].to_type(u8)
        n += 1
        i += 1
    }
    out[n] = 0
    return 0
}

// mb_cache_default_root：按宿主给出默认缓存根；平台变量缺失返回 -1。
// Windows 只看 LOCALAPPDATA；Linux 优先 XDG_CACHE_HOME，其次 HOME/.cache；
// Darwin 使用 ~/Library/Caches。HOME 缺失时对应平台回退为未启用。
fn mb_cache_default_root(out *u8, capacity int) int {
    if (support.tg_host_windows() != 0) {
        let app_off int = -1
        let app_len int = 0
        if (proj.env_fetch("LOCALAPPDATA", &app_off, &app_len) != 0
            || app_len <= 0) { return -1 }
        return mb_cache_join(out, capacity, proj.pool_str(app_off), "yh/cache")
    }
    if (support.tg_host_darwin() == 0) {
        let xdg_off int = -1
        let xdg_len int = 0
        if (proj.env_fetch("XDG_CACHE_HOME", &xdg_off, &xdg_len) != 0) {
            return -1
        }
        if (xdg_len > 0) {
            return mb_cache_join(out, capacity, proj.pool_str(xdg_off), "yh")
        }
    }
    let home_off int = -1
    let home_len int = 0
    if (proj.env_fetch("HOME", &home_off, &home_len) != 0) { return -1 }
    let home *char = proj.pool_str(home_off)
    if (home_len <= 0) { return -1 }
    if (support.tg_host_darwin() != 0) {
        return mb_cache_join(out, capacity, home, "Library/Caches/yh")
    }
    let home_cache [cache.CACHE_ROOT_MAX + 32]u8
    if (mb_cache_join(&home_cache[0], cache.CACHE_ROOT_MAX + 32, home, ".cache") != 0) {
        return -1
    }
    return mb_cache_join(out, capacity, support.arr_cstr(&home_cache[0]), "yh")
}

// mb_project_lock：同项目构建锁。锁文件在 <root>/.build/yh-build.lock，
// 与 YH_BUILD_CACHE 无关；失败返回 -1（Windows 后置时返回 -1/no-op）。
fn mb_project_lock(root_off int, root_len int) int {
    let c_off int = 0
    let c_len int = 0
    if (proj.canon(root_off, root_len, ".build", &c_off, &c_len) != 0) {
        return -1
    }
    let dir [cache.CACHE_ROOT_MAX + 64]u8
    let dn int = 0
    dn = support.append_str(&dir[0], dn, proj.pool_str(c_off))
    dir[dn] = 0
    if (link.cmd_mkdirs(support.arr_cstr(&dir[0])) != 0) { return -1 }
    let lock_path [cache.CACHE_ROOT_MAX + 96]u8
    let ln int = 0
    ln = support.append_str(&lock_path[0], ln, proj.pool_str(c_off))
    ln = support.append_str(&lock_path[0], ln, "/yh-build.lock")
    lock_path[ln] = 0
    let fd int = proj.open_out(support.arr_cstr(&lock_path[0]))
    if (fd < 0) { return -1 }
    if (cache.cache_lock_file(fd) != 0) {
        close(fd)
        return -1
    }
    return fd
}

// mb_project_unlock：释放同项目构建锁；-1 是空操作。
fn mb_project_unlock(fd int) void {
    if (fd < 0) { return }
    cache.cache_unlock_file(fd)
    close(fd)
}

// mb_module_path：构造本地模块产物路径 <build>/<sub>/<tag><suffix>。
fn mb_module_path(m int, build_off int, build_len int, sub *char,
    suffix *char, out *u8, capacity int) int {
    let tag_off int = -1
    let tag_len int = 0
    if (proj.mod_tag(m, &tag_off, &tag_len) != 0) { return -1 }
    let n int = 0
    let a int = 0
    let base *char = proj.pool_str(build_off)
    for base[a] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = base[a].to_type(u8)
        n += 1
        a += 1
    }
    if (n + 1 >= capacity) { return -1 }
    out[n] = '/'; n += 1
    a = 0
    for sub[a] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = sub[a].to_type(u8)
        n += 1
        a += 1
    }
    if (n + 1 >= capacity) { return -1 }
    out[n] = '/'; n += 1
    a = 0
    let tag *char = proj.pool_str(tag_off)
    for tag[a] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = tag[a].to_type(u8)
        n += 1
        a += 1
    }
    a = 0
    for suffix[a] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = suffix[a].to_type(u8)
        n += 1
        a += 1
    }
    out[n] = 0
    return 0
}

