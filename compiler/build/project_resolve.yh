module build
import support
import proj

// ============================================================================
// project_resolve.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================


// pj_entry_mod：项目的入口模块下标（模块名 main，pj_load_project 已标记
// is_entry 并保证至多一个）；无 main 模块即库项目，返回 -1。
pub fn pj_entry_mod(pj int) int {
    let i int = 0
    for i < proj.ctx().projs[pj].mod_n {
        let m int = proj.ctx().projs[pj].mods[i]
        if (proj.ctx().mods[m].is_entry != 0) {
            return m
        }
        i += 1
    }
    return -1
}

pub fn pj_bind_imports() int {
    let i int = 0
    for i < proj.ctx().imp_n {
        let f int = proj.ctx().imp_file[i]
        let pj int = proj.ctx().mods[proj.ctx().files[f].mod].proj
        // 生产构建跳过 test 专用导入；测试模式只对目标项目绑定它们。
        // 依赖/标准库的测试与测试专用依赖不进入本轮测试图。
        if (proj.ctx().imp_test_only[i] != 0
            && (support.session().test_mode == 0 || pj != proj.ctx().test_project)) {
            i += 1
            continue
        }
        let off int = proj.ctx().imp_off[i]
        let olen int = proj.ctx().imp_len[i]
        let path_off int = proj.ctx().imp_path_off[i]
        let path_len int = proj.ctx().imp_path_len[i]
        // 点分导入（path 比末段长）：两段先试跨项目依赖键，未命中再按本项目
        // 目录路径解析（A.B.C → 目录 <source>/A/B/C，末段是模块名）。
        if (path_len > olen) {
            let koff int = proj.ctx().imp_key_off[i]
            let klen int = proj.ctx().imp_key_len[i]
            let dk int = -1
            let di int = 0
            if (koff >= 0) {
                for di < proj.ctx().projs[pj].dep_n {
                    if (pj_same_np(proj.ctx().projs[pj].deps[di].key_off,
                        proj.ctx().projs[pj].deps[di].key_len, koff, klen) != 0) {
                        dk = proj.ctx().projs[pj].deps[di].proj
                        break
                    }
                    di += 1
                }
            }
            if (dk >= 0) {
                let km int = proj.module_in_project(dk, off, olen)
                if (km < 0 || proj.ctx().mods[km].is_entry != 0) {
                    return imp_msg(i, "依赖项目没有可导入的该模块: ", off, olen)
                }
                proj.ctx().imp_mod[i] = km
                i += 1
                continue
            }
            let dir_off int = -1
            let dir_len int = 0
            if (pj_import_dir(pj, path_off, path_len, &dir_off, &dir_len) != 0) {
                return -1
            }
            let dm int = proj.module_at_dir(pj, off, olen, dir_off, dir_len)
            if (dm < 0) {
                return imp_msg(i, "模块不存在（路径导入与目录不匹配）: ", path_off, path_len)
            }
            if (proj.ctx().mods[dm].is_entry != 0) {
                return imp_msg(i, "入口模块不可作为库导入: ", off, olen)
            }
            proj.ctx().imp_mod[i] = dm
            i += 1
            continue
        }
        // 单段：本项目按名字查；同一项目内多个目录同名 = 歧义（要改用路径导入）。
        let cnt int = proj.module_count_in_project(pj, off, olen)
        if (cnt > 1) {
            return imp_msg(i, "模块名歧义（本项目多个目录声明同名模块，请用路径导入区分）: ", off, olen)
        }
        // 第 1 层：本项目
        let m int = proj.module_in_project(pj, off, olen)
        if (m >= 0) {
            if (proj.ctx().mods[m].is_entry != 0) {
                return imp_msg(i, "入口模块不可作为库导入: ", off, olen)
            }
            proj.ctx().imp_mod[i] = m
            i += 1
            continue
        }
        // 第 2 层：标准库
        if (proj.ctx().stdlib >= 0) {
            m = proj.module_in_project(proj.ctx().stdlib, off, olen)
            if (m >= 0) {
                proj.ctx().imp_mod[i] = m
                i += 1
                continue
            }
        }
        // 第 3 层：直接依赖（排除其入口模块；多个候选 = 歧义）
        let found int = -1
        let count int = 0
        let di int = 0
        for di < proj.ctx().projs[pj].dep_n {
            let dp int = proj.ctx().projs[pj].deps[di].proj
            let cm int = proj.module_in_project(dp, off, olen)
            if (cm >= 0 && proj.ctx().mods[cm].is_entry == 0) {
                count += 1
                found = cm
            }
            di += 1
        }
        if (count > 1) {
            let buf3 [256]u8
            let n3 int = 0
            n3 = support.append_str(buf3, n3, "模块名歧义（多个直接依赖提供）: ")
            n3 = support.append_np(buf3, n3, off, olen)
            let mo3 int = support.tml_intern_str(buf3, 0, n3)
            if (mo3 < 0) {
                return -1
            }
            return imp_diag(i, support.np_cstr(mo3))
        }
        if (count == 1) {
            proj.ctx().imp_mod[i] = found
            i += 1
            continue
        }
        let buf2 [192]u8
        let n2 int = 0
        n2 = support.append_str(buf2, n2, "模块不存在: ")
        n2 = support.append_np(buf2, n2, off, olen)
        n2 = support.append_str(buf2, n2, "（已搜索 本项目 → 标准库 → 直接依赖）")
        let mo2 int = support.tml_intern_str(buf2, 0, n2)
        if (mo2 < 0) {
            return -1
        }
        return imp_diag(i, support.np_cstr(mo2))
    }
    return 0
}

// pj_import_dir：点分导入 A.B.C → 相对路径 A/B/C，再拼到源码根并归一化。
// 用 proj.canon（源码根可能是 "." 或 "src"，相对路径要按同一规则解析）。
// 出参 off/len 指向名字池里的目录串；返回 0；失败 -1。
fn pj_import_dir(pj int, path_off int, path_len int, off *int, len *int) int {
    if (path_len + 1 >= 900) {
        return support.fail("导入路径过长")
    }
    let rel [900]u8
    let n int = 0
    let i int = 0
    for i < path_len {
        let c u8 = support.pool_ctx().data[path_off + i]
        rel[n] = (c == '.' ? '/'.to_type(u8) : c)
        n += 1
        i += 1
    }
    rel[n] = 0
    return proj.canon(proj.ctx().projs[pj].src_off, proj.ctx().projs[pj].src_len,
        support.arr_cstr(&rel[0]), off, len)
}

// imp_msg：拼「前缀 + 名字池区间」诊断并输出；总是返回 -1。
fn imp_msg(i int, prefix *char, off int, olen int) int {
    let buf [256]u8
    let n int = 0
    n = support.append_str_cap(buf, 256, n, prefix)
    n = support.append_np_cap(buf, 256, n, off, olen)
    let mo int = support.tml_intern_str(buf, 0, n)
    if (mo < 0) {
        return -1
    }
    return imp_diag(i, support.np_cstr(mo))
}

fn imp_diag(i int, msg *char) int {
    let f int = proj.ctx().imp_file[i]
    let buf [512]u8
    let n int = 0
    n = support.append_str_cap(buf, 512, n, proj.pool_str(proj.ctx().files[f].path_off))
    n = support.append_byte_cap(buf, 512, n, ':')
    n = support.append_int_cap(buf, 512, n, proj.ctx().imp_line[i])
    n = support.append_byte_cap(buf, 512, n, ':')
    n = support.append_int_cap(buf, 512, n, proj.ctx().imp_col[i])
    n = support.append_str_cap(buf, 512, n, ": 错误: ")
    n = support.append_str_cap(buf, 512, n, msg)
    n = support.append_byte_cap(buf, 512, n, '\n')
    support.write_all(2, buf, n)
    support.diag().errors += 1
    return -1
}


// —— topo 排序与环路诊断 ——

let pj_pathstk *int = 0    // 访问路径栈（环诊断）
let pj_pathstk_n int = 0
fn pj_mod_edge(m int, e int) int {
    let seen int = 0
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        let f int = proj.ctx().mods[m].files[fi]
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] == f && proj.ctx().imp_mod[ii] >= 0) {
                let target int = proj.ctx().imp_mod[ii]
                // 是否已作为更早的边出现过
                let done int = 0
                let fi2 int = 0
                for fi2 < proj.ctx().mods[m].file_n {
                    let f2 int = proj.ctx().mods[m].files[fi2]
                    let ii2 int = 0
                    for ii2 < proj.ctx().imp_n {
                        if (proj.ctx().imp_file[ii2] == f2 && proj.ctx().imp_mod[ii2] == target) {
                            if (ii2 < ii || fi2 < fi) {
                                done = 1
                            }
                            break
                        }
                        ii2 += 1
                    }
                    if (done != 0) {
                        break
                    }
                    fi2 += 1
                }
                if (done == 0) {
                    if (seen == e) {
                        return target
                    }
                    seen += 1
                }
            }
            ii += 1
        }
        fi += 1
    }
    return -1
}

pub fn pj_dfs(m int) int {
    if (proj.ctx().mark[m] == 2) {
        return 0
    }
    if (proj.ctx().mark[m] == 1) {
        // 环：路径栈中从 m 开始的链
        let buf [512]u8
        let n int = 0
        n = support.append_str(buf, n, "模块导入环: ")
        let start int = 0
        for start < pj_pathstk_n {
            if (pj_pathstk[start] == m) {
                break
            }
            start += 1
        }
        let k int = start
        for k < pj_pathstk_n {
            n = support.append_np(buf, n, proj.ctx().mods[pj_pathstk[k]].name_off, proj.ctx().mods[pj_pathstk[k]].name_len)
            n = support.append_str(buf, n, " -> ")
            k += 1
        }
        n = support.append_np(buf, n, proj.ctx().mods[m].name_off, proj.ctx().mods[m].name_len)
        let mo int = support.tml_intern_str(buf, 0, n)
        if (mo < 0) {
            return -1
        }
        support.diag().errors += 1
        let out [600]u8
        let on int = 0
        on = support.append_str(out, on, "yh: ")
        on = support.append_np(out, on, mo, n)
        on = support.append_byte(out, on, '\n')
        support.write_all(2, out, on)
        return -1
    }
    proj.ctx().mark[m] = 1
    pj_pathstk[pj_pathstk_n] = m
    pj_pathstk_n += 1
    let e int = 0
    for 1 {
        let target int = pj_mod_edge(m, e)
        if (target < 0) {
            break
        }
        if (pj_dfs(target) != 0) {
            return -1
        }
        e += 1
    }
    pj_pathstk_n -= 1
    proj.ctx().mark[m] = 2
    proj.ctx().order[proj.ctx().order_n] = m
    proj.ctx().order_n += 1
    return 0
}

pub fn pj_topo(root int) int {
    // 标记数组按需扩容
    if (proj.ctx().mod_n > 0) {
        let nm *int = malloc((proj.ctx().mod_n * sizeof(int)).to_type(u64)).to_type(*int)
        if (nm == 0) {
            support.fail("内存分配失败")
            return -1
        }
        if (proj.ctx().mark != 0) {
            free(proj.ctx().mark)
        }
        proj.ctx().mark = nm
        let ord *int = malloc((proj.ctx().mod_n * sizeof(int)).to_type(u64)).to_type(*int)
        if (ord == 0) {
            return support.fail("内存分配失败")
        }
        if (proj.ctx().order != 0) {
            free(proj.ctx().order)
        }
        proj.ctx().order = ord
        let stk *int = malloc((proj.ctx().mod_n * sizeof(int)).to_type(u64)).to_type(*int)
        if (stk == 0) {
            return support.fail("内存分配失败")
        }
        if (pj_pathstk != 0) {
            free(pj_pathstk)
        }
        pj_pathstk = stk
    }
    let i int = 0
    for i < proj.ctx().mod_n {
        proj.ctx().mark[i] = 0
        i += 1
    }
    proj.ctx().order_n = 0
    pj_pathstk_n = 0
    if (pj_dfs(root) != 0) {
        return -1
    }
    return proj.ctx().order_n
}

pub fn pj_mod_suffix(pj int, mod int, off *int, olen *int) int {
    let tmp [512]u8
    let n int = 0
    n = support.append_byte(tmp, n, '_')
    n = support.append_byte(tmp, n, '_')
    let i int = 0
    for i < proj.ctx().projs[pj].name_len {
        let b u8 = support.pool_ctx().data[proj.ctx().projs[pj].name_off + i]
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_')) {
            b = '_'
        }
        tmp[n] = b
        n += 1
        i += 1
    }
    n = support.append_byte(tmp, n, '_')
    n = support.append_byte(tmp, n, '_')
    i = 0
    for i < proj.ctx().mods[mod].name_len {
        let b2 u8 = support.pool_ctx().data[proj.ctx().mods[mod].name_off + i]
        if (!((b2 >= 'a' && b2 <= 'z') || (b2 >= 'A' && b2 <= 'Z')
            || (b2 >= '0' && b2 <= '9') || b2 == '_')) {
            b2 = '_'
        }
        tmp[n] = b2
        n += 1
        i += 1
    }
    // 同名模块（同项目多个目录）：追加目录指纹，避免两个模块的符号名相撞。
    if (proj.mod_dir_dup(mod) != 0) {
        n = support.append_byte(tmp, n, '_')
        n = proj.append_dir_fp(&tmp[0], n, mod)
    }
    // 再加一个 '_' 结尾：符号形如 name__proj__mod_
    n = support.append_byte(tmp, n, '_')
    tmp[n] = 0
    off[0] = support.tml_intern_str(tmp, 0, n)
    olen[0] = n
    if (off[0] < 0) {
        return -1
    }
    return 0
}

pub fn pj_out_np(off int, olen int) void {
    support.write_all(1, support.pool_ctx().data + off, olen)
}

pub fn pj_out_s(s *char) void {
    let n int = 0
    for s[n] != 0 {
        n += 1
    }
    support.write_all(1, s.to_type(*u8), n)
}

pub fn pj_cmd_list(root int, resolve_off int, resolve_len int, has_resolve int) int {
    pj_out_s("项目 ")
    pj_out_np(proj.ctx().projs[root].name_off, proj.ctx().projs[root].name_len)
    pj_out_s("（源码根 ")
    pj_out_np(proj.ctx().projs[root].src_off, proj.ctx().projs[root].src_len)
    pj_out_s("）\n")
    let i int = 0
    for i < proj.ctx().projs[root].mod_n {
        let m int = proj.ctx().projs[root].mods[i]
        pj_out_s("  模块 ")
        pj_out_np(proj.ctx().mods[m].name_off, proj.ctx().mods[m].name_len)
        if (proj.ctx().mods[m].is_entry != 0) {
            pj_out_s("（入口）")
        }
        pj_out_s("\n")
        let fi int = 0
        for fi < proj.ctx().mods[m].file_n {
            pj_out_s("    ")
            pj_out_np(proj.ctx().files[proj.ctx().mods[m].files[fi]].path_off, proj.ctx().files[proj.ctx().mods[m].files[fi]].path_len)
            pj_out_s("\n")
            fi += 1
        }
        i += 1
    }
    if (has_resolve == 0) {
        return 0
    }
    pj_out_s("import 解析: ")
    pj_out_np(resolve_off, resolve_len)
    pj_out_s("\n")
    // 按当前项目上下文演示三层搜索
    let rm int = proj.module_in_project(root, resolve_off, resolve_len)
    let cat *char = 0
    if (rm >= 0) {
        if (proj.ctx().mods[rm].is_entry != 0) {
            pj_out_s("  命中本项目入口模块（不可导入）\n")
            return 1
        }
        cat = "本地"
    }
    if (rm < 0 && proj.ctx().stdlib >= 0) {
        rm = proj.module_in_project(proj.ctx().stdlib, resolve_off, resolve_len)
        if (rm >= 0) {
            cat = "标准库"
        }
    }
    if (rm < 0) {
        let count int = 0
        let found int = -1
        let di int = 0
        for di < proj.ctx().projs[root].dep_n {
            let cm int = proj.module_in_project(proj.ctx().projs[root].deps[di].proj, resolve_off, resolve_len)
            if (cm >= 0 && proj.ctx().mods[cm].is_entry == 0) {
                count += 1
                found = cm
            }
            di += 1
        }
        if (count > 1) {
            pj_out_s("  歧义：多个直接依赖提供同名模块\n")
            return 1
        }
        if (count == 1) {
            rm = found
            cat = "第三方"
        }
    }
    if (rm < 0) {
        pj_out_s("  未找到（搜索顺序 本项目 → 标准库 → 直接依赖）\n")
        return 1
    }
    pj_out_s("  来源: ")
    pj_out_s(cat)
    pj_out_s("  项目: ")
    pj_out_np(proj.ctx().projs[proj.ctx().mods[rm].proj].name_off, proj.ctx().projs[proj.ctx().mods[rm].proj].name_len)
    pj_out_s("\n")
    let fi2 int = 0
    for fi2 < proj.ctx().mods[rm].file_n {
        pj_out_s("    ")
        pj_out_np(proj.ctx().files[proj.ctx().mods[rm].files[fi2]].path_off, proj.ctx().files[proj.ctx().mods[rm].files[fi2]].path_len)
        pj_out_s("\n")
        fi2 += 1
    }
    return 0
}

// pj_find_root：从当前目录向上最多 32 层找 project.toml，结果写入
// out_len 写出根路径长度。quiet=1 时找不到不报诊断（usage 顺手显示版本用）。
pub fn pj_find_root(quiet int, out_len *int) int {
    let depth int = 0
    for depth <= 32 {
        // 组装候选路径：depth 个 "../" + "project.toml"
        let cand [512]u8
        let n int = 0
        let rootb [512]u8
        let rn int = 0
        let k int = 0
        for k < depth {
            rootb[rn] = '.'
            rootb[rn + 1] = '.'
            rootb[rn + 2] = '/'
            rn += 3
            k += 1
        }
        if (rn == 0) {
            rootb[0] = '.'
            rn = 1
        }
        rootb[rn] = 0
        n = support.append_str(cand, n, support.arr_cstr(rootb))
        n = support.append_str(cand, n, "/project.toml")
        cand[n] = 0
        if (proj.file_exists(support.arr_cstr(cand)) != 0) {
            // 根直接入池（相对前缀本身已规范）
            let off int = support.tml_intern_str(rootb, 0, rn)
            if (off < 0) {
                return -1
            }
            out_len[0] = rn
            return off
        }
        depth += 1
    }
    if (quiet == 0) {
        support.fail("未找到 project.toml（自当前目录向上 32 层）")
    }
    return -1
}

