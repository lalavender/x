module build
import support
import proj

// ============================================================================
// project_resolve.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// pj_import_dir：点分导入 A.B.C → 相对路径 A/B/C，再拼到源码根并归一化。
// 用 proj.canon（源码根可能是 "." 或 "src"，相对路径要按同一规则解析）。
// 出参 off/len 指向名字池里的目录串；返回 0；失败 -1。
fn pj_import_dir(pj int, path_off int, path_len int, off *int, len *int) int {
    if (path_len + 1 >= 900) {
        return support.fail("导入路径过长")
    }
    let rel [900]u8
    let n int = 0
    let i int = 0
    for i < path_len {
        let c u8 = support.pool_ctx().data[path_off + i]
        rel[n] = (c == '.' ? '/'.to_type(u8) : c)
        n += 1
        i += 1
    }
    rel[n] = 0
    return proj.canon(proj.ctx().projs[pj].src_off, proj.ctx().projs[pj].src_len,
        support.arr_cstr(&rel[0]), off, len)
}

// imp_msg：拼「前缀 + 名字池区间」诊断并输出；总是返回 -1。
fn imp_msg(i int, prefix *char, off int, olen int) int {
    let buf [256]u8
    let n int = 0
    n = support.append_str_cap(buf, 256, n, prefix)
    n = support.append_np_cap(buf, 256, n, off, olen)
    let mo int = support.tml_intern_str(buf, 0, n)
    if (mo < 0) {
        return -1
    }
    return imp_diag(i, support.np_cstr(mo))
}

fn imp_diag(i int, msg *char) int {
    let f int = proj.ctx().imp_file[i]
    let buf [512]u8
    let n int = 0
    n = support.append_str_cap(buf, 512, n, proj.pool_str(proj.ctx().files[f].path_off))
    n = support.append_byte_cap(buf, 512, n, ':')
    n = support.append_int_cap(buf, 512, n, proj.ctx().imp_line[i])
    n = support.append_byte_cap(buf, 512, n, ':')
    n = support.append_int_cap(buf, 512, n, proj.ctx().imp_col[i])
    n = support.append_str_cap(buf, 512, n, ": 错误: ")
    n = support.append_str_cap(buf, 512, n, msg)
    n = support.append_byte_cap(buf, 512, n, '\n')
    support.write_all(2, buf, n)
    support.diag().errors += 1
    return -1
}

// —— topo 排序与环路诊断 ——

let pj_pathstk *int = 0    // 访问路径栈（环诊断）
let pj_pathstk_n int = 0
fn pj_mod_edge(m int, e int) int {
    let seen int = 0
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        let f int = proj.ctx().mods[m].files[fi]
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] == f && proj.ctx().imp_mod[ii] >= 0) {
                let target int = proj.ctx().imp_mod[ii]
                // 是否已作为更早的边出现过
                let done int = 0
                let fi2 int = 0
                for fi2 < proj.ctx().mods[m].file_n {
                    let f2 int = proj.ctx().mods[m].files[fi2]
                    let ii2 int = 0
                    for ii2 < proj.ctx().imp_n {
                        if (proj.ctx().imp_file[ii2] == f2 && proj.ctx().imp_mod[ii2] == target) {
                            if (ii2 < ii || fi2 < fi) {
                                done = 1
                            }
                            break
                        }
                        ii2 += 1
                    }
                    if (done != 0) {
                        break
                    }
                    fi2 += 1
                }
                if (done == 0) {
                    if (seen == e) {
                        return target
                    }
                    seen += 1
                }
            }
            ii += 1
        }
        fi += 1
    }
    return -1
}

