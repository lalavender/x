module build
import errors
import support
import proj
import link
import hash
import cache
import libs.list

// ============================================================================
// module_cache.yh —— 模块缓存键、依赖表与接口就绪（B2-4，2026-10-26 拆出）
//
// 缓存身份：编译器指纹（argv0 + 自身二进制）、模块依赖表（mb_dep_* → BuildCtx）、
// 依赖接口路径收集、以及模块 manifest 的原子提交。
// 产物路径与哈希原语在 proj（proj_40_art），本文件只拼装缓存键。
// ============================================================================

// mb_compiler_identity_ensure：每进程只读一次编译器二进制，缓存 32 字节
// SHA-256 内容身份与派生 64 位指纹（worker 环境键使用）。返回 0 成功。
fn mb_compiler_identity_ensure() int {
    if (bc().compiler_fingerprint_ready != 0) { return 0 }
    let binary *char = bc().argv0
    if (bc().self_path != 0) {
        binary = bc().self_path
    }
    let digest [32]u8
    if (hash.sha256_file(binary, &digest[0]) != 0) { return -1 }
    let i int = 0
    for i < 32 {
        bc().compiler_identity[i] = digest[i]
        i += 1
    }
    let fp u64 = proj.hash_init()
    i = 0
    for i < 32 {
        proj.fnv(&fp, digest[i])
        i += 1
    }
    bc().compiler_fingerprint = fp
    bc().compiler_fingerprint_ready = 1
    return 0
}

// mb_mix_compiler_identity：把完整 32 字节编译器内容身份混入 C4 ActionID；
// 每进程只哈希一次二进制，后续模块复用缓存。
fn mb_mix_compiler_identity(key *cache.Key) int {
    if (key == 0 || mb_compiler_identity_ensure() != 0) { return -1 }
    return cache.key_mix_bytes(key, &bc().compiler_identity[0], 32)
}

// mb_dep_reset：清空本轮模块的依赖记录（保留列表容量）。
fn mb_dep_reset() void {
    if (bc().dep.element_size == 0) {
        bc().dep = list.make(sizeof(BDep).to_type(u64))
    }
    bc().dep.count = 0
}

// mb_dep_push：按解析结果模块下标去重后追加一条依赖接口记录。
// 返回 1 = 新追加，0 = 已存在，-1 = 内存失败。
fn mb_dep_push(target int, bind_off int, bind_len int) int {
    let k int = 0
    for k < bdep_count() {
        if (bdep_at(k).mod == target) {
            return 0
        }
        k += 1
    }
    let entry BDep
    entry.bind_off = bind_off
    entry.bind_len = bind_len
    entry.ifoff = -1
    entry.ctoff = -1
    entry.mod = target
    entry.mi = -1
    if (list.push(&bc().dep, (&entry).to_type(*void)) != list.status_ok) {
        return errors.fail("内存分配失败")
    }
    return 1
}

// mb_dep_order_rank：模块在本轮拓扑序 proj.order 中的位置；不在则 -1。
fn mb_dep_order_rank(m int) int {
    let i int = 0
    for i < proj.order_count() {
        if (proj.order_at(i) == m) {
            return i
        }
        i += 1
    }
    return -1
}

// mb_module_iface_deps：收集模块 M 依赖的全部接口（接口路径 =
// <build>/iface/<tag>.s.i），分四步：
//   1. 直接导入（绑定名 = 源码导入别名）；
//   2. 传递闭包——导出结构体的字段可引用外模块类型的 mangle 名，读接口
//      正文前必须先登记被依赖方接口，因此依赖的依赖也要加载；导入环已在
//      解析期拒绝，此处按不动点扩充终止。传递依赖没有源码别名，绑定名
//      取目标模块的 mangle 后缀（全局唯一，不与显式导入冲突）；
//   3. 按本轮拓扑序排序——mangle 类型名要求提供方接口先于引用方登记；
//   4. 统一构造接口路径（本轮会话接口优先于持久缓存）。
fn mb_module_iface_deps(m int, build_off int, build_len int) int {
    let c_off int = 0
    let c_len int = 0
    mb_dep_reset()
    let fi int = 0
    for fi < proj.mod_file_count(m) {
        let f int = proj.mod_file_at(m, fi)
        let ii int = 0
        for ii < proj.import_count() {
            if (proj.import_at(ii).file != f || proj.import_at(ii).mod < 0) {
                ii += 1
                continue
            }
            if (mb_dep_push(proj.import_at(ii).mod, proj.import_at(ii).off,
                    proj.import_at(ii).len) < 0) {
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    let changed int = 1
    for changed != 0 {
        changed = 0
        let ei int = 0
        for ei < bdep_count() {
            let em int = bdep_at(ei).mod
            let efi int = 0
            for efi < proj.mod_file_count(em) {
                let ef int = proj.mod_file_at(em, efi)
                let eii int = 0
                for eii < proj.import_count() {
                    if (proj.import_at(eii).file != ef || proj.import_at(eii).mod < 0) {
                        eii += 1
                        continue
                    }
                    let so int = -1
                    let sl int = 0
                    if (pj_mod_suffix(proj.mod_at(proj.import_at(eii).mod).proj,
                            proj.import_at(eii).mod, &so, &sl) != 0) {
                        return -1
                    }
                    let pr int = mb_dep_push(proj.import_at(eii).mod, so, sl)
                    if (pr < 0) {
                        return -1
                    }
                    if (pr == 1) {
                        changed = 1
                    }
                    eii += 1
                }
                efi += 1
            }
            ei += 1
        }
    }
    let si int = 0
    for si < bdep_count() {
        let best int = si
        let bv int = mb_dep_order_rank(bdep_at(si).mod)
        if (bv < 0) {
            return errors.fail("内部错误：依赖模块不在拓扑序中")
        }
        let sj int = si + 1
        for sj < bdep_count() {
            let rv int = mb_dep_order_rank(bdep_at(sj).mod)
            if (rv < 0) {
                return errors.fail("内部错误：依赖模块不在拓扑序中")
            }
            if (rv < bv) {
                best = sj
                bv = rv
            }
            sj += 1
        }
        if (best != si) {
            let held BDep = bdep_at(si)[0]
            bdep_at(si)[0] = bdep_at(best)[0]
            bdep_at(best)[0] = held
        }
        si += 1
    }
    let di int = 0
    for di < bdep_count() {
        if (proj.mod_tag(bdep_at(di).mod, &c_off, &c_len) != 0) {
            return -1
        }
        let pbuf [760]u8
        let pn int = 0
        pn = support.append_str(pbuf, pn, proj.pool_str(build_off))
        pn = support.append_str(pbuf, pn, "/iface/")
        pn = support.append_str(pbuf, pn, proj.pool_str(c_off))
        pn = support.append_str(pbuf, pn, ".s.i")
        pbuf[pn] = 0
        let chosen *char = support.arr_cstr(pbuf)
        let iface_session int = 0
        if (bc().iface_suffix != 0) {
            let session [760]u8
            let sn int = 0
            sn = support.append_str(session, sn, support.arr_cstr(pbuf))
            sn = support.append_str(session, sn, bc().iface_suffix)
            session[sn] = 0
            let ready [760]u8
            let rn int = support.append_str(&ready[0], 0, support.arr_cstr(pbuf))
            rn = support.append_str(&ready[0], rn, ".ready")
            rn = support.append_str(&ready[0], rn, bc().iface_suffix)
            ready[rn] = 0
            if (proj.file_exists(support.arr_cstr(&ready[0])) != 0
                && proj.file_exists(support.arr_cstr(session)) != 0) {
                iface_session = 1
                pn = sn
                let k int = 0
                for k <= sn {
                    pbuf[k] = session[k]
                    k += 1
                }
            }
        }
        let po int = support.tml_intern_str(chosen.to_type(*u8), 0, pn)
        if (po < 0) {
            return -1
        }
        bdep_at(di).ifoff = po
        let ctpath [1000]u8
        if (proj.module_ctiface_plain_path(bdep_at(di).mod, build_off,
                build_len, ctpath) != 0) { return -1 }
        let ctn int = strlen(support.arr_cstr(ctpath)).to_type(int)
        if (bc().iface_suffix != 0 && iface_session != 0) {
            let session_ct [1000]u8
            let csn int = support.append_str(session_ct, 0,
                support.arr_cstr(ctpath))
            csn = support.append_str(session_ct, csn, bc().iface_suffix)
            session_ct[csn] = 0
            ctn = csn
            let k2 int = 0
            for k2 <= csn {
                ctpath[k2] = session_ct[k2]
                k2 += 1
            }
        }
        let cto int = support.tml_intern_str(ctpath, 0, ctn)
        if (cto < 0) { return -1 }
        bdep_at(di).ctoff = cto
        di += 1
    }
    return bdep_count()
}

// mb_write_blob：临时文件写完再 rename 到 path；0 = 成功。
fn mb_write_blob(path *char, data *u8, size int) int {
    let tmp [800]u8
    let n int = 0
    n = support.append_str(&tmp[0], 0, path)
    n = support.append_str(&tmp[0], n, ".tmp.")
    n = support.append_int(&tmp[0], n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(support.arr_cstr(&tmp[0]))
    if (fd < 0) { return errors.fail_path("无法写缓存记录: ", path) }
    if (support.write_all(fd, data, size) != 0 || close(fd) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return -1
    }
    if (rename(support.arr_cstr(&tmp[0]), path) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return errors.fail_path("无法提交缓存记录: ", path)
    }
    return 0
}

// mb_manifest_write：写 128 字节模块 manifest，并写只含 ActionID 的本地索引。
// 布局：[0..32) ActionID；[32..64) obj；[64..96) .s.i；[96..128) .s.ct。
fn mb_manifest_write(m int, build_off int, build_len int, action_id *u8,
    object_id *u8, iface_id *u8, ct_id *u8) int {
    let c_off int = 0
    let c_len int = 0
    if (proj.mod_tag(m, &c_off, &c_len) != 0) { return -1 }
    let tag_off int = c_off
    if (proj.canon(build_off, build_len, "manifest", &c_off, &c_len) != 0) {
        return -1
    }
    let mpath [700]u8
    let mn int = 0
    mn = support.append_str(mpath, mn, proj.pool_str(c_off))
    mn = support.append_byte(mpath, mn, '/')
    mn = support.append_str(mpath, mn, proj.pool_str(tag_off))
    mn = support.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    let data [128]u8
    let i int = 0
    for i < cache.CACHE_ID_SIZE {
        data[i] = action_id[i]
        data[cache.CACHE_ID_SIZE + i] = object_id[i]
        data[cache.CACHE_ID_SIZE * 2 + i] = iface_id[i]
        data[cache.CACHE_ID_SIZE * 3 + i] = ct_id[i]
        i += 1
    }
    if (mb_write_blob(support.arr_cstr(&mpath[0]), &data[0], 128) != 0) { return -1 }
    // 本地索引只放 ActionID（64 hex + 换行），供 C4/C6 观测与跨 worktree 调试。
    if (proj.canon(build_off, build_len, "index", &c_off, &c_len) != 0) {
        return -1
    }
    let ipath [700]u8
    let in2 int = 0
    in2 = support.append_str(ipath, in2, proj.pool_str(c_off))
    in2 = support.append_byte(ipath, in2, '/')
    in2 = support.append_str(ipath, in2, proj.pool_str(tag_off))
    ipath[in2] = 0
    let hex [cache.CACHE_ID_TEXT]u8
    if (hash.sha256_hex(action_id, &hex[0]) != 0) { return -1 }
    let line [cache.CACHE_ID_TEXT + 1]u8
    i = 0
    for i < cache.CACHE_ID_HEX {
        line[i] = hex[i]
        i += 1
    }
    line[cache.CACHE_ID_HEX] = 10
    return mb_write_blob(support.arr_cstr(&ipath[0]), &line[0],
        cache.CACHE_ID_HEX + 1)
}

// mb_manifest_commit：worker 完整成功后校验产物并提交本地 manifest，
// 同时把模块三个中间产物发布到全局 content store（失败不影响构建）。
fn mb_manifest_commit(m int, build_off int, build_len int, key *u8) int {
    let object_path [1200]u8
    let iface_path [1200]u8
    let ct_path [1200]u8
    if (mb_module_path(m, build_off, build_len, "obj", ".o",
            &object_path[0], 1200) != 0
        || mb_module_path(m, build_off, build_len, "iface", ".s.i",
            &iface_path[0], 1200) != 0
        || mb_module_path(m, build_off, build_len, "iface", ".s.ct",
            &ct_path[0], 1200) != 0) { return -1 }
    if (link.mb_object_machine_matches(support.arr_cstr(&object_path[0])) == 0) {
        return errors.fail("LLVM 对象缺失或目标架构错误，拒绝提交缓存")
    }
    let object_id [cache.CACHE_ID_SIZE]u8
    let iface_id [cache.CACHE_ID_SIZE]u8
    let ct_id [cache.CACHE_ID_SIZE]u8
    if (hash.sha256_file(support.arr_cstr(&object_path[0]), &object_id[0]) != 0
        || hash.sha256_file(support.arr_cstr(&iface_path[0]), &iface_id[0]) != 0
        || hash.sha256_file(support.arr_cstr(&ct_path[0]), &ct_id[0]) != 0) {
        return -1
    }
    if (mb_manifest_write(m, build_off, build_len, key, &object_id[0],
            &iface_id[0], &ct_id[0]) != 0) { return -1 }
    mb_cache_publish_module(m, build_off, build_len, key, &object_id[0],
        &iface_id[0], &ct_id[0])
    return 0
}
