module build
import errors
import libs.list

// pj_os_dir_probe：d_type 缺失（DT_UNKNOWN = 0）时用 openat 探测是否为目录。
// 部分 overlayfs / 网络文件系统不填 d_type；只看 `d_type == 4` 会把目录当文件
// 跳过，目录里的模块就此「消失」。openat(O_DIRECTORY|O_NOFOLLOW) 成功 → 目录。
// arm64：openat = 56，close = 57，O_DIRECTORY = 0x4000、O_NOFOLLOW = 0x8000
// （**不是** x86_64 的 0x10000/0x20000，见下面 pj_os_dir_list 的注释）→ 合计 0xC000。
fn pj_os_dir_probe(dirfd i64, name *u8) int {
    let fd i64 = linux_syscall6(56.to_type(u64), dirfd.to_type(u64),
        name.to_type(u64), 0xC000.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64))
    if (fd < 0) {
        return 0
    }
    linux_syscall6(57.to_type(u64), fd.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
    return 1
}

// pj_os_dir_list：用 Linux arm64 openat/getdents64 syscall 批量枚举目录。
// 原始目录项在缓冲区复用前复制到本次扫描向量，不经过 libc/CRT。
//
// flags 必须用 **arm64 自己的 fcntl 取值**：O_DIRECTORY = 0o40000 = 0x4000。
// arm64 的 O_DIRECTORY/O_NOFOLLOW/O_DIRECT/O_LARGEFILE 与 x86_64（asm-generic）
// 不同名同值：0x10000 在 arm64 上是 **O_DIRECT**，拿它打开目录会被
// tmpfs/ext4/overlayfs 判 EINVAL（`无法打开目录: .`），只有不校验该标志的
// 9p（WSL 的 /mnt/c）会侥幸放行——所以这个值错了在 9p 上完全看不出来，
// 一进容器（overlayfs）就必挂。见 tests/selfhost/foreign-fs-py。
fn pj_os_dir_list(dir *char, entries *list.List) int {
    let fd i64 = linux_syscall6(56.to_type(u64), (-100).to_type(u64),
        dir.to_type(u64), 0x4000.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64))
    if (fd < 0) {
        return errors.fail_path("无法打开目录: ", dir)
    }
    let buf [8192]u8
    let bufp *u8 = &buf[0]
    let failed int = 0
    for 1 == 1 {
        let n i64 = linux_syscall6(61.to_type(u64), fd.to_type(u64),
            bufp.to_type(u64), 8192.to_type(u64), 0.to_type(u64),
            0.to_type(u64), 0.to_type(u64))
        if (n < 0) {
            failed = 1
            break
        }
        if (n == 0) {
            break
        }
        let pos int = 0
        for pos < n.to_type(int) {
            let rec_len int = bufp[pos + 16].to_type(int) |
                (bufp[pos + 17].to_type(int) << 8)
            if (rec_len < 20 || rec_len > n.to_type(int) - pos) {
                failed = 1
                break
            }
            let name *u8 = (bufp + pos + 19).to_type(*u8)
            let name_len int = 0
            for name[name_len] != 0 && name_len < rec_len - 19 {
                name_len += 1
            }
            if (name_len == rec_len - 19) {
                failed = 1
                break
            }
            // d_type：4 = DT_DIR；0 = DT_UNKNOWN 时按 openat 探测补判。
            let dtype int = bufp[pos + 18].to_type(int)
            let is_dir int = 0
            if (dtype == 4) {
                is_dir = 1
            } else if (dtype == 0) {
                is_dir = pj_os_dir_probe(fd, name)
            }
            if (pj_dir_add(entries, name, name_len, is_dir) != 0) {
                failed = 1
                break
            }
            pos += rec_len
        }
        if (failed != 0) {
            break
        }
    }
    linux_syscall6(57.to_type(u64), fd.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
    if (failed != 0) {
        return errors.fail_path("无法读取目录: ", dir)
    }
    return 0
}
