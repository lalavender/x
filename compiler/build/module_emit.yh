module build
import token
import ast
import support
import proj
import parse
import backend
import link
import cache
import hash

// ============================================================================
// module_emit.yh —— 单个模块的发射流水线（B2-4，2026-10-26 自 module_build 拆出）
//
// 一次 `mb_compile_start` 的完整生命周期：缓存判定 → fork 模块 worker →
// 两遍前端（声明索引、全局初始化、函数体）→ 受检快照 → lowering/后端 →
// 原子发布对象与接口 + manifest 提交。父进程只做编排与等待，
// 执行体在 worker 进程（COW 继承 proj 表与前端快照）。
//
// 目录/路径的纯计算在 proj（proj_40_art），工具链调用在 link；本文件只负责
// 「按什么顺序做、失败怎么收尾」。
// ============================================================================

// mb_mkdir：确保构建目录存在。
pub fn mb_mkdir(dir *char) int {
    // 建 .build 七子目录（asm/obj/iface/manifest/ir/llvm/index）
    let subs [7]*char
    subs[0] = "asm"
    subs[1] = "obj"
    subs[2] = "iface"
    subs[3] = "manifest"
    subs[4] = "ir"
    subs[5] = "llvm"
    subs[6] = "index"
    if (link.cmd_mkdirs(dir) != 0) {
        return support.fail_path("无法创建构建目录: ", dir)
    }
    let k int = 0
    for k < 7 {
        let path [1100]u8
        let n int = support.append_str(path, 0, dir)
        n = support.append_byte(path, n, '/')
        n = support.append_str(path, n, subs[k])
        path[n] = 0
        if (link.cmd_mkdirs(support.arr_cstr(path)) != 0) {
            return support.fail_path("无法创建构建目录: ", dir)
        }
        k += 1
    }
    return 0
}

// mb_check_clear_ifaces：删除本轮 check 生成的临时模块接口。
// check 使用独立构建目录，不覆盖正式构建缓存；依赖接口保留到全部模块检查结束。
fn mb_check_clear_ifaces(build_off int, build_len int, count int) void {
    let ci int = 0
    for ci < count {
        let m int = proj.ctx().order[ci]
        let path [700]u8
        if (proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, path) == 0) {
            unlink(support.arr_cstr(path))
        }
        if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            path) == 0) {
            unlink(support.arr_cstr(path))
        }
        // 清除升级前留下的无后缀 check 接口。
        if (proj.module_iface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(support.arr_cstr(path))
        }
        if (proj.module_ctiface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(support.arr_cstr(path))
        }
        ci += 1
    }
}

// mb_compile_start：检查模块缓存；命中返回 1，否则启动 worker 并返回 0。
// root_off/len：项目根（调用方捕获的池偏移；函数内部 canon 会改写全局
// 游标，故由调用方先取好）。
fn mb_compile_start(m int, root_off int, root_len int, build_off int,
    build_len int, pid_out *int, key_out *u8) int {
    let c_off int = 0
    let c_len int = 0
    let sfx_off int = -1
    let sfx_len int = 0
    if (pj_mod_suffix(proj.ctx().mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1
    }
    let is_entry int = proj.ctx().mods[m].is_entry
    // 产物目录 = .build/asm/<tag>/（tag 含项目，防同名冲突；RS3b 起每模块
    // 一个目录，内含每文件 .s 与 <tag>.stub.s 运行时桩对象）
    if (proj.mod_tag(m, &c_off, &c_len) != 0) {
        return -1
    }
    let tag_off int = c_off
    if (proj.canon(build_off, build_len, "asm", &c_off, &c_len) != 0) {
        return -1
    }
    let asmdir [900]u8
    let an int = 0
    an = support.append_str(asmdir, an, proj.pool_str(c_off))
    an = support.append_byte(asmdir, an, '/')
    an = support.append_str(asmdir, an, proj.pool_str(tag_off))
    asmdir[an] = 0
    let cache_artifact [1000]u8
    let artifact_path *char = 0
    let text_artifact [700]u8
    let asm_artifact [700]u8
    if (mb_llvm_module_paths(m, root_off, root_len, &cache_artifact[0],
            &text_artifact[0], &asm_artifact[0]) != 0) { return -1 }
    artifact_path = support.arr_cstr(&cache_artifact[0])
    if (proj.canon(build_off, build_len, "iface", &c_off, &c_len) != 0) {
        return -1
    }
    let ipath [600]u8
    let in2 int = 0
    in2 = support.append_str(ipath, in2, proj.pool_str(c_off))
    in2 = support.append_byte(ipath, in2, '/')
    in2 = support.append_str(ipath, in2, proj.pool_str(tag_off))
    in2 = support.append_str(ipath, in2, ".s.i")
    ipath[in2] = 0
    let ctpath [600]u8
    let ctn int = 0
    ctn = support.append_str(ctpath, ctn, proj.pool_str(c_off))
    ctn = support.append_byte(ctpath, ctn, '/')
    ctn = support.append_str(ctpath, ctn, proj.pool_str(tag_off))
    ctn = support.append_str(ctpath, ctn, ".s.ct")
    ctpath[ctn] = 0
    let session_ipath [700]u8
    if (proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, session_ipath) != 0) {
        return -1
    }
    unlink(support.arr_cstr(session_ipath))
    let session_ctpath [700]u8
    if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            session_ctpath) != 0) {
        return -1
    }
    unlink(support.arr_cstr(session_ctpath))
    let session_ready [700]u8
    if (mb_module_ready_path(m, build_off, build_len, &session_ready[0]) != 0) {
        return -1
    }
    unlink(support.arr_cstr(&session_ready[0]))
    if (proj.canon(build_off, build_len, "manifest", &c_off, &c_len) != 0) {
        return -1
    }
    let mpath [600]u8
    let mn int = 0
    mn = support.append_str(mpath, mn, proj.pool_str(c_off))
    mn = support.append_byte(mpath, mn, '/')
    mn = support.append_str(mpath, mn, proj.pool_str(tag_off))
    mn = support.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    // check 不读取或更新正式构建 manifest 与缓存。yh test 用独立的构建目录
    // （tmp/yh-test）与扩展键（见下方 c_test_key），既不复用生产对象，也能在
    // 选中测试集合不变时增量复用测试对象。
    if (support.session().check_only != 0) {
        if (mb_spawn_indexed_module(m, root_off, root_len,
                support.arr_cstr(asmdir), 0, pid_out) != 0) {
            return support.fail("无法启动项目检查/测试 worker")
        }
        support.stats().workers += 1
        return 0
    }
    // —— manifest 哈希（U5，C4：SHA-256 ActionID）——
    // 模块 ActionID 与 copy 到全局 content store 的 action 键完全一致；
    // 旧 FNV manifest 因长度/键格式不同自然 miss。
    let ckey cache.Key
    if (cache.key_init(&ckey, cache.ACTION_MODULE, "module") != 0) { return -1 }
    if (cache.key_mix_text(&ckey, proj.pool_str(sfx_off)) != 0) { return -1 }
    // 模块目录：同名不同目录的两个模块必须得到不同 ActionID（产物名已用目录
    // 指纹区分，键里也显式混入，避免改命名规则时误命中）。
    if (cache.key_mix_text(&ckey, proj.pool_str(proj.ctx().mods[m].dir_off)) != 0) { return -1 }
    if (cache.key_mix_int(&ckey, is_entry) != 0) { return -1 }
    if (cache.key_mix_int(&ckey, support.session().legacy_system) != 0) { return -1 }
    // yh test：测试对象还取决于「本轮选中了哪些测试」，把选择摘要与协议版本
    // 并入键。生产构建不混入，且两种构建目录本身互不相通。
    if (support.session().test_mode != 0) {
        if (cache.key_mix_text(&ckey, "yh-test-key-1") != 0) { return -1 }
        if (cache.key_mix_u64(&ckey, proj.ctx().test_key) != 0) { return -1 }
    }
    if (cache.key_mix_text(&ckey, proj.cfg().target.triple) != 0
        || cache.key_mix_text(&ckey, proj.cfg().target.data_layout) != 0
        || cache.key_mix_text(&ckey, proj.cfg().target.abi) != 0) { return -1 }
    if (cache.key_mix_int(&ckey, proj.module_opt_level(m)) != 0) { return -1 }
    if (cache.key_mix_int(&ckey, proj.cfg().trimpath) != 0) { return -1 }
    if (cache.key_mix_text(&ckey, backend.llvm_bridge_version()) != 0) { return -1 }
    if (cache.key_mix_text(&ckey, "yh-llvm-bridge-abi1") != 0) { return -1 }
    if (proj.cfg().target.os == support.TARGET_OS_DARWIN) {
        let min_os *char = link.cmd_darwin_min_os()
        if (min_os == 0) { return -1 }
        if (cache.key_mix_text(&ckey, min_os) != 0) { return -1 }
        // Darwin 对象由桥按目标强制 PIC（见 llvm/bridge.c）；把重定位模式
        // 显式写入对象键，避免将来引入非 PIC 变体时旧对象误命中。
        if (cache.key_mix_text(&ckey, "PIC") != 0) { return -1 }
    }
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        if (cache.key_mix_file(&ckey,
                proj.pool_str(proj.ctx().files[proj.ctx().mods[m].files[fi]].path_off)) != 0) {
            return -1
        }
        fi += 1
    }
    // 依赖接口内容（解析结果变化 → 接口路径变化 → 哈希变化）
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1
    }
    let di int = 0
    for di < bc().dep_n {
        if (proj.file_exists(proj.pool_str(bc().dep_ifoff[di])) == 0
            || proj.file_exists(proj.pool_str(bc().dep_ctoff[di])) == 0) {
            // 依赖接口缺失：视为需要重编译
            di = bc().dep_n + 1
            break
        }
        if (cache.key_mix_file(&ckey, proj.pool_str(bc().dep_ifoff[di])) != 0
            || cache.key_mix_file(&ckey, proj.pool_str(bc().dep_ctoff[di])) != 0) {
            return -1
        }
        di += 1
    }
    let deps_ok int = 1
    if (di == bc().dep_n + 1) {
        deps_ok = 0
    }
    // 编译器身份：每进程只读一次二进制，混入完整 32 字节内容身份。
    if (mb_mix_compiler_identity(&ckey) != 0) {
        return -1
    }
    // 版本标记：schema 变化必须换键。
    if (cache.key_mix_text(&ckey, "yh-iface-cache-5-ct") != 0) { return -1 }
    let action_id [cache.CACHE_ID_SIZE]u8
    if (cache.key_finish(&ckey, &action_id[0]) != 0) { return -1 }
    mb_cache_debug_action("module action", &action_id[0])
    // 缓存命中：对象/接口/manifest 齐全，且本次显式请求的 .ll/.s 也存在。
    // 后两项不参与模块键（对象内容不变），只在缺失时强制重跑 worker 补产物。
    if (deps_ok != 0 && proj.file_exists(artifact_path) != 0
        && (proj.cfg().emit_kind == 0
            || proj.file_exists(support.arr_cstr(&text_artifact[0])) != 0)
        && (proj.cfg().emit_asm == 0
            || proj.file_exists(support.arr_cstr(&asm_artifact[0])) != 0)
        && proj.file_exists(support.arr_cstr(ipath)) != 0
        && proj.file_exists(support.arr_cstr(ctpath)) != 0
        && proj.file_exists(support.arr_cstr(mpath)) != 0) {
        // C4 manifest 固定 128 字节：
        //   [0..32) 模块 ActionID；[32..64) 对象 OutputID；
        //   [64..96) .s.i OutputID；[96..128) .s.ct OutputID。
        // 所有 ID 都是 SHA-256 原始摘要；旧 64 字节 FNV manifest 按长度拒绝。
        let manifest_len int = 128
        if (support.read_source(support.arr_cstr(mpath)) == 0
            && support.src_ctx().length == manifest_len) {
            // read_source 的 c_src 缓冲会被后续 object/iface 读取覆盖；先复制
            // manifest 快照，再比较任何内容摘要。
            let saved [128]u8
            let si int = 0
            for si < manifest_len { saved[si] = support.src_ctx().data[si]; si += 1 }
            let same int = 1
            let ci int = 0
            for ci < cache.CACHE_ID_SIZE {
                if (saved[ci] != action_id[ci]) {
                    same = 0
                    break
                }
                ci += 1
            }
            if (same != 0 && link.mb_object_machine_matches(artifact_path) != 0) {
                let object_id [cache.CACHE_ID_SIZE]u8
                if (hash.sha256_file(artifact_path, &object_id[0]) != 0) {
                    same = 0
                } else {
                    ci = 0
                    for ci < cache.CACHE_ID_SIZE {
                        if (saved[cache.CACHE_ID_SIZE + ci] != object_id[ci]) {
                            same = 0
                            break
                        }
                        ci += 1
                    }
                }
            } else {
                same = 0
            }
            if (same != 0) {
                let iface_paths [2]*char
                iface_paths[0] = support.arr_cstr(ipath)
                iface_paths[1] = support.arr_cstr(ctpath)
                let fi2 int = 0
                for fi2 < 2 && same != 0 {
                    let iface_id [cache.CACHE_ID_SIZE]u8
                    if (hash.sha256_file(iface_paths[fi2], &iface_id[0]) != 0) {
                        same = 0
                    } else {
                        ci = 0
                        for ci < cache.CACHE_ID_SIZE {
                            if (saved[cache.CACHE_ID_SIZE * 2 + fi2 * cache.CACHE_ID_SIZE + ci]
                                != iface_id[ci]) {
                                same = 0
                                break
                            }
                            ci += 1
                        }
                    }
                    fi2 += 1
                }
            }
            if (same != 0) {
                mb_cache_debug_action("module local hit", &action_id[0])
                pj_out_s("  [缓存] ")
                pj_out_np(proj.ctx().mods[m].name_off, proj.ctx().mods[m].name_len)
                pj_out_s("\n")
                return 1
            }
        }
    }
    // 本地 manifest 未命中：查全局 content store；命中则物化 obj/iface/ct 并
    // 补写本地 manifest。任何读取/校验失败都回到 worker。
    mb_cache_debug_action("module local miss", &action_id[0])
    if (mb_cache_lookup_module(m, build_off, build_len, &action_id[0]) == 1) {
        mb_cache_debug_action("module global hit", &action_id[0])
        pj_out_s("  [缓存] ")
        pj_out_np(proj.ctx().mods[m].name_off, proj.ctx().mods[m].name_len)
        pj_out_s("\n")
        return 1
    }
    // 缓存键随 worker 状态保存，只有完整编译成功后父进程才提交 manifest。
    let ki int = 0
    for ki < cache.CACHE_ID_SIZE {
        key_out[ki] = action_id[ki]
        ki += 1
    }
    // 子进程编译（提供方项目根 + 主项目根）
    if (mb_spawn_indexed_module(m, root_off, root_len, support.arr_cstr(asmdir),
            bc().compiler_fingerprint, pid_out) != 0) {
        // 不要把「子进程启动失败」与「子进程启动后因参数/编译错误退出」混为一谈：
        // 无 fork 宿主（Windows）上，worker 以非 0 退出时这里同样是 -1，真实原因
        // 在 worker 自己打印的诊断里（例如 --emit-module 参数被拒时退出码 2）。
        // 注意：yh 语法不支持相邻字符串字面量拼接，诊断必须写成一个字面量。
        return support.fail("模块编译 worker 未成功完成（启动失败或子进程提前退出）；请检查 --emit-module 子命令的参数是否被接受")
    }
    support.stats().workers += 1
    return 0
}

// mb_module_ready_path：本轮接口就绪标记 <tag>.s.i.ready[suffix]。
// worker 先写 .s.ct、再写 .s.i、最后写 ready；父调度器只认 ready。
fn mb_module_ready_path(m int, build_off int, build_len int, out *u8) int {
    let plain [700]u8
    if (proj.module_iface_plain_path(m, build_off, build_len, plain) != 0) {
        return -1
    }
    let n int = 0
    n = support.append_str(out, n, support.arr_cstr(plain))
    n = support.append_str(out, n, ".ready")
    if (bc().iface_suffix != 0) {
        n = support.append_str(out, n, bc().iface_suffix)
    }
    out[n] = 0
    return 0
}

// mb_iface_write_ready：原子写就绪标记；内容只用于存在性，不参与身份。
fn mb_iface_write_ready(path *char) int {
    let tmp [800]u8
    let n int = 0
    n = support.append_str(tmp, n, path)
    n = support.append_str(tmp, n, ".tmp.")
    n = support.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(support.arr_cstr(tmp))
    if (fd < 0) { return -1 }
    let data u8 = 49
    let wr int = support.write_all(fd, &data, 1)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(support.arr_cstr(tmp), path) != 0) {
        unlink(support.arr_cstr(tmp))
        return -1
    }
    return 0
}

// mb_iface_ct_same：比较本轮 session CT 接口与持久 CT 接口内容。
// 返回 1 相同（允许早期启动），0 不同/缺失（等待依赖完成）。
fn mb_iface_ct_same(m int, build_off int, build_len int) int {
    let session [700]u8
    let plain [700]u8
    if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            session) != 0
        || proj.module_ctiface_plain_path(m, build_off, build_len, plain) != 0) {
        return 0
    }
    // 没有 CT 正文（文件缺失/空）时不存在旧 CT 可复用，允许早期启动。
    if (proj.file_exists(support.arr_cstr(session)) == 0) { return 1 }
    if (support.read_source(support.arr_cstr(session)) != 0) { return 0 }
    if (support.src_ctx().length == 0) { return 1 }
    // 首次构建没有持久 CT，不存在可复用的旧值；session ready 已是新接口。
    if (proj.file_exists(support.arr_cstr(plain)) == 0) { return 1 }
    if (support.read_source(support.arr_cstr(plain)) != 0) { return 0 }
    if (support.src_ctx().length == 0) { return 0 }
    let hs u64 = proj.hash_init()
    let hp u64 = proj.hash_init()
    if (proj.hash_file(&hs, support.arr_cstr(session)) != 0
        || proj.hash_file(&hp, support.arr_cstr(plain)) != 0) { return 0 }
    return hs == hp ? 1 : 0
}

// mb_iface_copy_file：完整读取源接口，经同目录暂存后原子发布到目标路径。
fn mb_iface_copy_file(src *char, dst *char) int {
    if (support.read_source(src) != 0) {
        return -1
    }
    let tmp [800]u8
    let n int = 0
    n = support.append_str(tmp, n, dst)
    n = support.append_str(tmp, n, ".tmp.")
    n = support.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(support.arr_cstr(tmp))
    if (fd < 0) {
        return -1
    }
    let wr int = support.write_all(fd, support.src_ctx().data, support.src_ctx().length)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(support.arr_cstr(tmp), dst) != 0) {
        unlink(support.arr_cstr(tmp))
        return -1
    }
    return 0
}

// mb_file_head_bind：解析当前文件头并绑定导入（编译前每文件调用）。
// 先重置文件级导入表——pass 2 会对同一文件再次解析文件头。
fn mb_file_head_bind(fi int) int {
    // 绑定不再按名匹配：cmd 侧持有扫描期的解析结果（p_imp），按声明位置
    // （line/col）对应后把 ModInfo 下标直接写入 mod_import_mod。
    // 支持别名与跨项目 KEY.MOD 导入（解析结果与名字解耦）。
    parse.mod_reset_file()
    if (parse.mod_parse_head() != 0) {
        return -1
    }
    let i int = 0
    for i < support.fs().import_n {
        let found int = -1
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] == fi
                && proj.ctx().imp_line[ii] == support.fs().imports[i].line
                && proj.ctx().imp_col[ii] == support.fs().imports[i].col) {
                found = ii
                break
            }
            ii += 1
        }
        if (found < 0) {
            return support.err_lc(support.fs().imports[i].line, support.fs().imports[i].col,
                "内部错误：导入与扫描记录不对应")
        }
        let imp_proj int = proj.ctx().mods[proj.ctx().files[fi].mod].proj
        if (proj.ctx().imp_test_only[found] != 0
            && (support.session().test_mode == 0 || imp_proj != proj.ctx().test_project)) {
            // 生产构建/非目标项目不绑定 test 专用导入；标记 used 以免报未使用。
            support.fs().import_mod[i] = -1
            support.fs().import_used[i] = 1
            i += 1
            continue
        }
        let target int = proj.ctx().imp_mod[found]
        let mi int = -1
        let di int = 0
        for di < bc().dep_n {
            if (bc().dep_mod[di] == target) {
                mi = bc().dep_base + di
                break
            }
            di += 1
        }
        if (mi < 0) {
            return support.err_lc(support.fs().imports[i].line, support.fs().imports[i].col,
                "内部错误：导入的接口未加载")
        }
        support.fs().import_mod[i] = mi
        support.fs().import_used[i] = 0
        // 导入可只在全局初始化器中使用，而模块文件会在全局遍历与
        // 函数遍历之间重新绑定头部；按 token 快照保留整文件的限定引用。
        let ti int = 0
        for ti + 1 < token.ctx().count {
            if (token.ctx().tokens[ti].kind == token.TOK_IDENT
                && token.ctx().tokens[ti].len == support.fs().imports[i].alias_len
                && token.ctx().tokens[ti + 1].kind == token.TK_DOT) {
                let same int = 1
                let j int = 0
                for j < support.fs().imports[i].alias_len {
                    if (support.src_ctx().data[token.ctx().tokens[ti].start + j]
                        != support.pool_ctx().data[support.fs().imports[i].alias_off + j]) {
                        same = 0
                        break
                    }
                    j += 1
                }
                if (same != 0) {
                    support.fs().import_used[i] = 1
                    break
                }
            }
            ti += 1
        }
        i += 1
    }
    return 0
}

// mb_pass1_file：pass 1 从只读词法快照登记一个源文件（含头解析与绑定）。
fn mb_pass1_file(path *char, fi int) int {
    if (support.stats().enabled != 0) {
        support.stats().pass1 += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    return parse.parse_indexed_decls(0)
}

// mb_restore_front_file：将当前解析器切换到项目索引时保存的只读快照。
pub fn mb_restore_front_file(path *char, fi int) int {
    if (support.stats().front_cache == 0 || proj.ctx().files[fi].source == 0
        || proj.ctx().files[fi].tokens == 0) {
        return support.fail("内部错误：模块 worker 缺少前端文件快照")
    }
    support.src_ctx().data = proj.ctx().files[fi].source
    support.src_ctx().length = proj.ctx().files[fi].source_len
    token.ctx().tokens = proj.ctx().files[fi].tokens
    token.ctx().count = proj.ctx().files[fi].token_n
    token.ctx().cap = proj.ctx().files[fi].token_n
    ast.store().file_decls = proj.ctx().files[fi].decls
    ast.store().file_decl_n = proj.ctx().files[fi].decl_n
    ast.store().file_decl_i = -1
    ast.store().file_indexed = 1
    support.session().active_file = fi
    token.ctx().pos = 0
    if (support.set_source_path(path) != 0) {
        return -1
    }
    support.diag().spec = 0
    parse.ctx().ctx_block = 0
    return 0
}

// mb_pass2_file：复用模块文件快照执行全局、CT 捕获/布局常量子遍或函数子遍。
// 1 全局初始化，2 CT 正文捕获，3 布局请求登记，4 布局 const 求值，0 普通函数。
fn mb_pass2_file(path *char, fi int, is_globals int) int {
    if (is_globals == 1 && support.stats().enabled != 0) {
        support.stats().globals += 1
    }
    if (is_globals == 0 && support.stats().enabled != 0) {
        support.stats().functions += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    if (is_globals != 0) {
        if (is_globals == 2) {
            if (parse.parse_source_ct_fns() != 0) { return -1 }
        } else if (is_globals == 3) {
            if (parse.parse_source_ct_layout_register() != 0) { return -1 }
        } else if (is_globals == 4) {
            if (parse.parse_source_ct_layout_consts() != 0) { return -1 }
        } else if (is_globals == 5) {
            if (parse.parse_source_tests() != 0) { return -1 }
        } else if (parse.parse_source_globals() != 0) {
            return -1
        }
    } else {
        if (parse.parse_source_fns() != 0) {
            return -1
        }
        // 未使用导入检查（U3）：本文件编译完后仍为零使用的导入报错
        let i int = 0
        for i < support.fs().import_n {
            if (support.fs().import_used[i] == 0) {
                return support.err_lc(support.fs().imports[i].line, support.fs().imports[i].col,
                    "导入未使用（同文件没有任何限定名引用）")
            }
            i += 1
        }
    }
    return 0
}

// mb_check_binding_clash：导入名与本模块顶层声明重名检查（pass1 后）。
// 遍历模块全部文件的导入，逐个查全局符号表。
fn mb_check_binding_clash(m int) int {
    let fi int = 0
    for fi < proj.ctx().mods[m].file_n {
        let f int = proj.ctx().mods[m].files[fi]
        let ii int = 0
        for ii < proj.ctx().imp_n {
            if (proj.ctx().imp_file[ii] != f) {
                ii += 1
                continue
            }
            let imp_proj int = proj.ctx().mods[proj.ctx().files[f].mod].proj
            if (proj.ctx().imp_test_only[ii] != 0
                && (support.session().test_mode == 0 || imp_proj != proj.ctx().test_project)) {
                ii += 1
                continue
            }
            let idx int = support.sym_lookup_off(proj.ctx().imp_off[ii], proj.ctx().imp_len[ii])
            if (idx >= 0 && (support.ms().syms[idx].flags & support.F_GLOBAL) != 0
                && (support.ms().syms[idx].flags & support.F_EXTERN) == 0) {
                let buf [192]u8
                let n int = 0
                n = support.append_int_cap(buf, 192, n, support.ms().syms[idx].def_line)
                n = support.append_byte_cap(buf, 192, n, ':')
                n = support.append_int_cap(buf, 192, n, support.ms().syms[idx].def_col)
                n = support.append_str_cap(buf, 192, n, ": 顶层声明与导入名冲突（导入名 ")
                n = support.append_np_cap(buf, 192, n, proj.ctx().imp_off[ii], proj.ctx().imp_len[ii])
                n = support.append_str_cap(buf, 192, n, "）")
                let mo int = support.tml_intern_str(buf, 0, n)
                if (mo < 0) {
                    return -1
                }
                support.diag().errors += 1
                let out [256]u8
                let on int = 0
                on = support.append_str(out, on, proj.pool_str(proj.ctx().files[f].path_off))
                on = support.append_byte(out, on, ':')
                on = support.append_np(out, on, mo, n)
                on = support.append_byte(out, on, '\n')
                support.write_all(2, out, on)
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    return 0
}

// mb_emit_module：子进程入口——编译一个模块为按文件汇编 + 接口；check-only
// 复用语义遍历并只写本轮依赖需要的临时接口。
// prov_root：模块提供方项目根（在其中查找模块）；main_root：主项目根
// （构建目录基准，接口路径与父进程一致）；out_dir：按文件汇编目录
// <build>/asm/<tag>（RS3b）。
pub fn mb_emit_module(mod_off int, mod_len int, prov_off int, prov_len int,
    main_off int, main_len int, out_dir *char, ir_cache_salt u64,
    extra *char) int {
    support.stats().front_cache = 1
    support.session().ast_capture = 0
    support.stats().ir_cache_salt = ir_cache_salt
    if (mb_load_stdlib() != 0) {
        return -1
    }
    let pj int = pj_load_project(prov_off, prov_len)
    if (pj < 0) {
        return -1
    }
    // --emit-module 的独立子进程（无 fork 宿主）必须自己装载主项目并重建拓扑序：
    // 依赖排序与接口路径都按主项目的 order/构建目录算；fork 路径继承父进程快照，
    // 这两步是 Windows 的 re-exec 路径独有的。
    let main_proj int = pj_load_project(main_off, main_len)
    if (main_proj < 0) {
        return -1
    }
    if (support.session().test_mode != 0) {
        // 测试模式：测试项目就是主项目；父进程已清掉入口标记，子进程同样要清，
        // 否则 runner 的 main 会被加模块后缀。
        let ctx *proj.ProjectCtx = proj.ctx()
        ctx.test_project = main_proj
        let ci int = 0
        for ci < ctx.projs[main_proj].mod_n {
            ctx.mods[ctx.projs[main_proj].mods[ci]].is_entry = 0
            ci += 1
        }
    }
    if (extra != 0) {
        // 测试 runner 由 testkit 生成在项目 tmp/ 下（不在 source 根扫描范围），
        // 独立子进程必须显式把它加进索引，否则「模块不在索引中」。
        if (pj_index_file(extra, pj) != 0) { return -1 }
    }
    if (pj_bind_imports() != 0) {
        return -1
    }
    let rootmod int = pj_entry_mod(main_proj)
    let order_n int = rootmod >= 0 ? pj_topo(rootmod) : pj_topo_multi(main_proj)
    if (order_n < 0) {
        return -1
    }
    let m int = proj.module_in_project(pj, mod_off, mod_len)
    if (m < 0) {
        return support.fail("内部错误：模块不在索引中")
    }
    // 测试 runner 是入口模块：testkit 在父进程里置 is_entry=1，独立子进程重新
    // 装载索引后必须做同样标记，否则零 CRT 入口桩不发射。
    if (extra != 0 && support.session().test_mode != 0) {
        proj.ctx().mods[m].is_entry = 1
    }
    return mb_emit_indexed_module(m, main_off, main_len, out_dir, ir_cache_salt)
}

