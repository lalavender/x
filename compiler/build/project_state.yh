module build
import gen

// ============================================================================
// project_state.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// pj_state().envp：进程入口提供的只读环境向量，由 driver.main 设置。
// PjState：项目模型的可变游标与拓扑结果（A2b 前置）。
//
// 这些字段原先散落成 6 个模块级全局，被 project_*/module_build/link_cache/
// build_scheduler/test_cmd 直接读写共 93 处。收进一个结构后：
//   * 只有 `pj_state()` 一个入口，将来搬进 build 模块只需改访问前缀；
//   * 跨模块传指针（`&pj_state().canon_off`）语义明确，不再有"改哪个全局"的歧义。
pub struct PjState {
    canon_off int        // pj_canon 的最近结果（路径池偏移）
    canon_len int
    order *int           // topo 顺序（模块下标）
    order_n int
    mark *int            // 模块标记：0 未访问 / 1 访问中 / 2 完成
    envp **char          // 宿主环境向量（driver 入口写入）
    root_off int         // 根项目路径
    root_len int
}

let pj_state_v PjState

// pj_state：项目模型状态的唯一入口。
pub fn pj_state() *PjState {
    return &pj_state_v
}


pub fn pj_pool_str(off int) *char {
    let tk *gen.TaskCtx = gen.task()
    return (tk.np_data + off).to_type(*char)
}

// 项目元数据通过文件 API 读取；目录扫描由平台 OS 适配直接枚举。

// pj_dir_add：把非隐藏目录项加入本次扫描的私有向量，并立即复制名称。
fn pj_dir_add(entries **PJDirEntry, n *int, cap *int,
    name *u8, name_len int, is_dir int) int {
    if (name_len <= 0 || name[0] == '.') {
        return 0
    }
    let name_off int = gen.tml_intern_str(name, 0, name_len)
    if (name_off < 0) {
        return -1
    }
    if (n[0] == cap[0]) {
        let ncap int = cap[0] * 2
        if (ncap == 0) {
            ncap = 64
        }
        let next *PJDirEntry = malloc((ncap * sizeof(PJDirEntry)).to_type(u64)) .
            to_type(*PJDirEntry)
        if (next == 0) {
            return gen.fail("内存分配失败")
        }
        if (n[0] > 0) {
            memcpy(next, entries[0], (n[0] * sizeof(PJDirEntry)).to_type(u64))
            free(entries[0].to_type(*void))
        }
        entries[0] = next
        cap[0] = ncap
    }
    entries[0][n[0]].name_off = name_off
    entries[0][n[0]].name_len = name_len
    entries[0][n[0]].is_dir = is_dir
    n[0] += 1
    return 0
}

// pj_env_fetch：在 OS 传入的 envp 中精确匹配 name= 前缀，并把值 intern 到
// 编译器字符串池。name 以 NUL 结尾；off/olen 返回值的池偏移和字节长度；
// 变量缺失时成功返回空字符串，参数无效或字符串池分配失败时返回 -1。
pub fn pj_env_fetch(name *char, off *int, olen *int) int {
    if (name == 0 || off == 0 || olen == 0) {
        return -1
    }
    let key_len int = 0
    for name[key_len] != 0 {
        key_len += 1
    }
    let rowi int = 0
    for pj_state().envp != 0 && pj_state().envp[rowi] != 0 {
        let row *char = pj_state().envp[rowi]
        let j int = 0
        for j < key_len && row[j] == name[j] {
            j += 1
        }
        if (j == key_len && row[j] == '=') {
            let value *char = (row + j + 1).to_type(*char)
            let value_len int = 0
            for value[value_len] != 0 {
                value_len += 1
            }
            let value_off int = gen.tml_intern_str(value.to_type(*u8), 0, value_len)
            if (value_off < 0) {
                return -1
            }
            off[0] = value_off
            olen[0] = value_len
            return 0
        }
        rowi += 1
    }
    let empty [1]u8
    empty[0] = 0
    let empty_off int = gen.tml_intern_str(empty, 0, 0)
    if (empty_off < 0) {
        return -1
    }
    off[0] = empty_off
    olen[0] = 0
    return 0
}

pub fn pj_file_exists(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) {
        return 0
    }
    close(fd)
    return 1
}


// —— 路径规范化（去重用）：段栈处理，消解 . / .. / 重复斜杠。 ——

// pj_canon：把 base（池内串）与 rel（NUL 串）连接并规范化，intern 后
// 经全局出参 pj_state().canon_off/len 返回。rel 以 '/' 开头时仅用 rel。

// pj_state().root_off/len：本次命令的根项目路径；-1 表示尚未设置。
// 依赖项目递归装载时保持根路径不变，供 project_link 只对根项目解析 [link]。

// pj_set_root_project：命令在装载根项目前登记根路径。
pub fn pj_set_root_project(off int, plen int) void {
    pj_state().root_off = off
    pj_state().root_len = plen
}

// pj_is_root_project：当前装载的是不是命令根项目。
fn pj_is_root_project(off int, plen int) int {
    if (pj_state().root_off < 0) { return 0 }
    if (pj_state().root_len != plen) { return 0 }
    let i int = 0
    for i < plen {
        if (gen.G().task.np_data[pj_state().root_off + i]
            != gen.G().task.np_data[off + i]) { return 0 }
        i += 1
    }
    return 1
}

pub fn pj_canon(base_off int, base_len int, rel *char) int {
    let gs *gen.GenState = gen.G()
    // 组装原始串到临时堆缓冲（路径有 1024 上限，超出报错）
    let raw [1024]u8
    let rn int = 0
    let use_rel_only int = 0
    if (rel[0] == '/') {
        use_rel_only = 1
    }
    if (use_rel_only == 0) {
        let i int = 0
        for i < base_len {
            raw[rn] = gs.task.np_data[base_off + i]
            rn += 1
            i += 1
        }
        if (rn > 0 && raw[rn - 1] != '/') {
            raw[rn] = '/'
            rn += 1
        }
    }
    let j int = 0
    for rel[j] != 0 {
        raw[rn] = rel[j].to_type(u8)
        rn += 1
        j += 1
        if (rn >= 1023) {
            return gen.fail("路径过长")
        }
    }
    raw[rn] = 0
    // 段栈规范化
    let segs [128][256]u8  // 每段最长 255
    let seg_len [128]int
    let sn int = 0
    let i2 int = 0
    for i2 < rn {
        // 跳过多余斜杠
        for i2 < rn && raw[i2] == '/' {
            i2 += 1
        }
        let s int = i2
        for i2 < rn && raw[i2] != '/' {
            i2 += 1
        }
        let sl int = i2 - s
        if (sl == 0) {
            break
        }
        if (sl == 1 && raw[s] == '.') {
            continue
        }
        if (sl == 2 && raw[s] == '.' && raw[s + 1] == '.') {
            // 顶端是普通段才弹出；否则保留 ".."（相对路径上越 cwd）
            if (sn > 0 && !(seg_len[sn - 1] == 2 && segs[sn - 1][0] == '.' && segs[sn - 1][1] == '.')) {
                sn -= 1
                continue
            }
        }
        if (sn >= 128 || sl > 255) {
            return gen.fail("路径过长")
        }
        let k int = 0
        for k < sl {
            segs[sn][k] = raw[s + k]
            k += 1
        }
        seg_len[sn] = sl
        sn += 1
    }
    // 重新拼接入池
    let tmp [1024]u8
    let tn int = 0
    // 空段栈：绝对路径为根 '/'；相对路径（如 "." 折叠后）为本目录 "."。
    // 契约与其他路径一致：结果写 pj_state().canon_off/len，成功返回 0。
    if (sn == 0) {
        if (rn > 0 && raw[0] == '/') {
            tmp[0] = '/'
            tn = 1
        } else {
            tmp[0] = '.'
            let o int = gen.tml_intern_str(tmp, 0, 1)
            if (o < 0) {
                return -1
            }
            pj_state().canon_off = o
            pj_state().canon_len = 1
            return 0
        }
    }
    if (rn > 0 && raw[0] == '/') {
        tmp[0] = '/'
        tn = 1
    }
    let si int = 0
    for si < sn {
        if (tn > 0 && tmp[tn - 1] != '/') {
            tmp[tn] = '/'
            tn += 1
        }
        let k2 int = 0
        for k2 < seg_len[si] {
            tmp[tn] = segs[si][k2]
            tn += 1
            k2 += 1
        }
        si += 1
    }
    tmp[tn] = 0
    pj_state().canon_off = gen.tml_intern_str(tmp, 0, tn)
    pj_state().canon_len = tn
    if (pj_state().canon_off < 0) {
        return -1
    }
    return 0
}

fn pj_proj_push(root_off int, root_len int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_proj_n == gs.p_proj_cap) {
        let ncap int = gs.p_proj_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let nd *gen.PProj = malloc((ncap * sizeof(gen.PProj)).to_type(u64)).to_type(*gen.PProj)
        if (nd == 0) {
            gen.fail("内存分配失败")
            return -1
        }
        if (gs.p_proj_n > 0) {
            memcpy(nd, gs.p_projs, (gs.p_proj_n * sizeof(gen.PProj)).to_type(u64))
        }
        free(gs.p_projs)
        gs.p_projs = nd
        gs.p_proj_cap = ncap
    }
    gs.p_projs[gs.p_proj_n].root_off = root_off
    gs.p_projs[gs.p_proj_n].root_len = root_len
    gs.p_projs[gs.p_proj_n].name_off = -1
    gs.p_projs[gs.p_proj_n].name_len = 0
    gs.p_projs[gs.p_proj_n].src_off = -1
    gs.p_projs[gs.p_proj_n].src_len = 0
    gs.p_projs[gs.p_proj_n].ver_off = -1
    gs.p_projs[gs.p_proj_n].ver_len = 0
    gs.p_projs[gs.p_proj_n].os_code = 0
    gs.p_projs[gs.p_proj_n].arch_code = 0
    gs.p_projs[gs.p_proj_n].deps = 0
    gs.p_projs[gs.p_proj_n].dep_n = 0
    gs.p_projs[gs.p_proj_n].dep_cap = 0
    gs.p_projs[gs.p_proj_n].mods = 0
    gs.p_projs[gs.p_proj_n].mod_n = 0
    gs.p_projs[gs.p_proj_n].mod_cap = 0
    gs.p_projs[gs.p_proj_n].c_sources = 0
    gs.p_projs[gs.p_proj_n].c_source_n = 0
    gs.p_projs[gs.p_proj_n].c_source_cap = 0
    gs.p_projs[gs.p_proj_n].c_objects = 0
    gs.p_projs[gs.p_proj_n].c_object_n = 0
    gs.p_projs[gs.p_proj_n].c_object_cap = 0
    gs.p_projs[gs.p_proj_n].c_libs = 0
    gs.p_projs[gs.p_proj_n].c_lib_n = 0
    gs.p_projs[gs.p_proj_n].c_lib_cap = 0
    gs.p_projs[gs.p_proj_n].link_groups = 0
    gs.p_projs[gs.p_proj_n].link_group_n = 0
    gs.p_projs[gs.p_proj_n].link_group_cap = 0
    gs.p_proj_n += 1
    return gs.p_proj_n - 1
}

fn pj_proj_find_root(root_off int, root_len int) int {
    let gs *gen.GenState = gen.G()
    let i int = 0
    for i < gs.p_proj_n {
        if (gs.p_projs[i].root_len == root_len
            && gs.task.np_data[gs.p_projs[i].root_off] == gs.task.np_data[root_off]) {
            let match int = 1
            let j int = 1
            for j < root_len {
                if (gs.task.np_data[gs.p_projs[i].root_off + j] != gs.task.np_data[root_off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return i
            }
        }
        i += 1
    }
    return -1
}

fn pj_mod_push(name_off int, name_len int, proj int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_mod_n == gs.p_mod_cap) {
        let ncap int = gs.p_mod_cap * 2
        if (ncap == 0) {
            ncap = 16
        }
        let nd *gen.PMod = malloc((ncap * sizeof(gen.PMod)).to_type(u64)).to_type(*gen.PMod)
        if (nd == 0) {
            gen.fail("内存分配失败")
            return -1
        }
        if (gs.p_mod_n > 0) {
            memcpy(nd, gs.p_mods, (gs.p_mod_n * sizeof(gen.PMod)).to_type(u64))
        }
        free(gs.p_mods)
        gs.p_mods = nd
        gs.p_mod_cap = ncap
    }
    gs.p_mods[gs.p_mod_n].name_off = name_off
    gs.p_mods[gs.p_mod_n].name_len = name_len
    gs.p_mods[gs.p_mod_n].proj = proj
    gs.p_mods[gs.p_mod_n].files = 0
    gs.p_mods[gs.p_mod_n].file_n = 0
    gs.p_mods[gs.p_mod_n].file_cap = 0
    gs.p_mods[gs.p_mod_n].is_entry = 0
    gs.p_mod_n += 1
    return gs.p_mod_n - 1
}

fn pj_proj_add_mod(proj int, mod int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_projs[proj].mod_n == gs.p_projs[proj].mod_cap) {
        let ncap int = gs.p_projs[proj].mod_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd == 0) {
            return gen.fail("内存分配失败")
        }
        if (gs.p_projs[proj].mod_n > 0) {
            memcpy(nd, gs.p_projs[proj].mods, (gs.p_projs[proj].mod_n * sizeof(int)).to_type(u64))
        }
        free(gs.p_projs[proj].mods)
        gs.p_projs[proj].mods = nd
        gs.p_projs[proj].mod_cap = ncap
    }
    gs.p_projs[proj].mods[gs.p_projs[proj].mod_n] = mod
    gs.p_projs[proj].mod_n += 1
    return 0
}

fn pj_mod_add_file(mod int, file int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_mods[mod].file_n == gs.p_mods[mod].file_cap) {
        let ncap int = gs.p_mods[mod].file_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd == 0) {
            return gen.fail("内存分配失败")
        }
        if (gs.p_mods[mod].file_n > 0) {
            memcpy(nd, gs.p_mods[mod].files, (gs.p_mods[mod].file_n * sizeof(int)).to_type(u64))
        }
        free(gs.p_mods[mod].files)
        gs.p_mods[mod].files = nd
        gs.p_mods[mod].file_cap = ncap
    }
    gs.p_mods[mod].files[gs.p_mods[mod].file_n] = file
