}

fn pj_file_push(path_off int, path_len int, mod int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_file_n == gs.p_file_cap) {
        let ncap int = gs.p_file_cap * 2
        if (ncap == 0) {
            ncap = 32
        }
        let nd *gen.PFile = malloc((ncap * sizeof(gen.PFile)).to_type(u64)).to_type(*gen.PFile)
        if (nd == 0) {
            gen.fail("内存分配失败")
            return -1
        }
        if (gs.p_file_n > 0) {
            memcpy(nd, gs.p_files, (gs.p_file_n * sizeof(gen.PFile)).to_type(u64))
        }
        free(gs.p_files)
        gs.p_files = nd
        gs.p_file_cap = ncap
    }
    gs.p_files[gs.p_file_n].path_off = path_off
    gs.p_files[gs.p_file_n].path_len = path_len
    gs.p_files[gs.p_file_n].mod = mod
    gs.p_files[gs.p_file_n].source = 0
    gs.p_files[gs.p_file_n].source_len = 0
    gs.p_files[gs.p_file_n].tokens = 0
    gs.p_files[gs.p_file_n].token_n = 0
    gs.p_files[gs.p_file_n].decls = 0
    gs.p_files[gs.p_file_n].decl_n = 0
    gs.p_file_n += 1
    return gs.p_file_n - 1
}

// pj_imp_push：登记一条文件导入（绑定期解析）。
// name=查找名（模块名，点分导入取 MOD 段），key=跨项目依赖键（-1/0 同项目），
// alias=绑定名。平铺数组按块扩容。
fn pj_imp_push(file int, off int, olen int, koff int, klen int,
    aoff int, alen int, line int, col int) int {
    let gs *gen.GenState = gen.G()
    if (gs.p_imp_n == gs.p_imp_cap) {
        let ncap int = gs.p_imp_cap * 2
        if (ncap == 0) {
            ncap = 32
        }
        let old [10]*int
        old[0] = gs.p_imp_file; old[1] = gs.p_imp_off; old[2] = gs.p_imp_len
        old[3] = gs.p_imp_key_off; old[4] = gs.p_imp_key_len
        old[5] = gs.p_imp_alias_off; old[6] = gs.p_imp_alias_len
        old[7] = gs.p_imp_line; old[8] = gs.p_imp_col
        old[9] = gs.p_imp_test_only
        let nd0 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd0 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd1 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd1 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd2 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd2 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd3 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd3 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd4 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd4 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd5 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd5 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd6 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd6 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd7 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd7 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd8 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd8 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd9 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd9 == 0) {
            return gen.fail("内存分配失败")
        }
        let nd10 *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nd10 == 0) {
            return gen.fail("内存分配失败")
        }
        if (gs.p_imp_n > 0) {
            let cnt u64 = (gs.p_imp_n * sizeof(int)).to_type(u64)
            memcpy(nd0, gs.p_imp_file, cnt)
            memcpy(nd1, gs.p_imp_off, cnt)
            memcpy(nd2, gs.p_imp_len, cnt)
            memcpy(nd3, gs.p_imp_key_off, cnt)
            memcpy(nd4, gs.p_imp_key_len, cnt)
            memcpy(nd5, gs.p_imp_alias_off, cnt)
            memcpy(nd6, gs.p_imp_alias_len, cnt)
            memcpy(nd7, gs.p_imp_line, cnt)
            memcpy(nd8, gs.p_imp_col, cnt)
            memcpy(nd9, gs.p_imp_mod, cnt)
            memcpy(nd10, gs.p_imp_test_only, cnt)
        }
        free(gs.p_imp_file); gs.p_imp_file = nd0
        free(gs.p_imp_off); gs.p_imp_off = nd1
        free(gs.p_imp_len); gs.p_imp_len = nd2
        free(gs.p_imp_key_off); gs.p_imp_key_off = nd3
        free(gs.p_imp_key_len); gs.p_imp_key_len = nd4
        free(gs.p_imp_alias_off); gs.p_imp_alias_off = nd5
        free(gs.p_imp_alias_len); gs.p_imp_alias_len = nd6
        free(gs.p_imp_line); gs.p_imp_line = nd7
        free(gs.p_imp_col); gs.p_imp_col = nd8
        free(gs.p_imp_mod); gs.p_imp_mod = nd9
        free(gs.p_imp_test_only); gs.p_imp_test_only = nd10
        gs.p_imp_cap = ncap
    }
    gs.p_imp_file[gs.p_imp_n] = file
    gs.p_imp_off[gs.p_imp_n] = off
    gs.p_imp_len[gs.p_imp_n] = olen
    gs.p_imp_key_off[gs.p_imp_n] = koff
    gs.p_imp_key_len[gs.p_imp_n] = klen
    gs.p_imp_alias_off[gs.p_imp_n] = aoff
    gs.p_imp_alias_len[gs.p_imp_n] = alen
    gs.p_imp_line[gs.p_imp_n] = line
    gs.p_imp_col[gs.p_imp_n] = col
    gs.p_imp_mod[gs.p_imp_n] = -1
    gs.p_imp_test_only[gs.p_imp_n] = 0
    gs.p_imp_n += 1
    return 0
}

pub fn pj_proj_diag(root_off int, line int, msg *char) int {
    let tk *gen.TaskCtx = gen.task()
    let buf [1024]u8
    let n int = 0
    n = gen.append_str(buf, n, pj_pool_str(root_off))
    n = gen.append_str(buf, n, "/project.toml:")
    n = gen.append_int(buf, n, line)
    n = gen.append_str(buf, n, ": 错误: ")
    n = gen.append_str(buf, n, msg)
    n = gen.append_byte(buf, n, '\n')
    gen.write_all(2, buf, n)
    tk.c_errors += 1
    return -1
}
