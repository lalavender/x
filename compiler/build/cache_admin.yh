module build
import support

import link
import cache
import libs.os
import libs.list

// ============================================================================
// cache_admin.yh —— C6：全局缓存的 info/clean/trim/verify
//
// 只操作 <YH_CACHE>/v1 下的 actions/outputs/tmp；最终可执行文件不在全局缓存，
// 因此这些命令不会碰项目 .build。clean/trim 持全局写锁，verify/info 只读。
// trim 只删除没有被任何 action 引用的 output；动作表本身留给 clean/后续 GC。
// ============================================================================

// CacheFile：目录条目的固定 64 hex 名称 + size/mtime。
struct CacheFile {
    name [cache.CACHE_ID_TEXT]u8
    size u64
    mtime u64
}

// IdSet：OutputID 引用集；开放寻址，容量按 action 最大输出数预留。
struct IdSet {
    slots *u8
    used *u8
    capacity int
    count int
}

// admin_out：把一行文本写到 stdout；失败不影响命令结果。
fn admin_out(text *char) void {
    printf("%s\n", text)
}

// admin_join：root/sub/name 拼成路径；name 为 0 时只到 sub。
fn admin_join(root *char, sub *char, name *u8, name_len int,
    out *u8, capacity int) int {
    if (root == 0 || sub == 0 || out == 0 || capacity <= 1) { return -1 }
    let n int = 0
    let i int = 0
    for root[i] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = root[i].to_type(u8)
        n += 1
        i += 1
    }
    if (n > 0 && out[n - 1] != '/') {
        if (n + 1 >= capacity) { return -1 }
        out[n] = '/'
        n += 1
    }
    i = 0
    for sub[i] != 0 {
        if (n + 1 >= capacity) { return -1 }
        out[n] = sub[i].to_type(u8)
        n += 1
        i += 1
    }
    if (name != 0) {
        if (n + 1 >= capacity) { return -1 }
        out[n] = '/'
        n += 1
        i = 0
        for i < name_len {
            if (n + 1 >= capacity) { return -1 }
            out[n] = name[i]
            n += 1
            i += 1
        }
    }
    out[n] = 0
    return 0
}

// admin_list_dir：列出 <root>/v1/<sub> 下 64 hex 的普通文件并读取 size/mtime。
// 成功返回 1（空目录也算成功）；目录打不开返回 0。调用方 free 输出数组。
fn admin_list_dir(store *cache.CacheStore, sub *char,
    out_files **CacheFile, out_count *int) int {
    out_files[0] = 0
    out_count[0] = 0
    if (store == 0) { return 0 }
    let dir [cache.CACHE_ROOT_MAX + 128]u8
    if (admin_join(support.arr_cstr(&store.root[0]), sub, 0, 0,
            &dir[0], cache.CACHE_ROOT_MAX + 128) != 0) { return 0 }
    let buffer [16384]u8
    let opened os.DirReaderResult = os.open_dir(support.arr_cstr(&dir[0]),
        buffer[0..16384])
    if (opened.reader.active == 0) { return 0 }
    let files *CacheFile = 0
    let count int = 0
    let capacity int = 0
    for 1 {
        let result os.DirEntryResult = os.next_entry(&opened.reader)
        if (result.status == os.dir_entry_end) { break }
        if (result.status == os.dir_entry_error) { break }
        let name_len int = result.entry.name_len.to_type(int)
        if (name_len != cache.CACHE_ID_HEX) { continue }
        if (count == capacity) {
            let next_capacity int = capacity == 0 ? 16 : capacity * 2
            let next *CacheFile = malloc(
                (next_capacity * sizeof(CacheFile)).to_type(u64)).to_type(*CacheFile)
            if (next == 0) { break }
            if (count > 0) {
                memcpy(next, files, (count * sizeof(CacheFile)).to_type(u64))
            }
            if (files != 0) { free(files.to_type(*void)) }
            files = next
            capacity = next_capacity
        }
        let path [cache.CACHE_ROOT_MAX + 256]u8
        if (admin_join(support.arr_cstr(&store.root[0]), sub,
                result.entry.name, name_len, &path[0],
                cache.CACHE_ROOT_MAX + 256) != 0) { continue }
        let size u64 = 0
        let mtime u64 = 0
        if (link.mb_file_stat(support.arr_cstr(&path[0]), &size, &mtime) != 0) {
            continue
        }
        let i int = 0
        for i < name_len {
            files[count].name[i] = result.entry.name[i]
            i += 1
        }
        files[count].name[name_len] = 0
        files[count].size = size
        files[count].mtime = mtime
        count += 1
    }
    os.close_dir(&opened.reader)
    out_files[0] = files
    out_count[0] = count
    return 1
}

// admin_release_files：释放 admin_list_dir 的结果。
fn admin_release_files(files *CacheFile) void {
    if (files != 0) { free(files.to_type(*void)) }
}

// admin_sum_size：统计文件数组总字节数。
fn admin_sum_size(files *CacheFile, count int) u64 {
    let total u64 = 0
    let i int = 0
    for i < count {
        total += files[i].size
        i += 1
    }
    return total
}

// admin_unlink_dir：删除 <root>/v1/<sub> 下所有普通文件；0 = 成功。
fn admin_unlink_dir(store *cache.CacheStore, sub *char) int {
    if (store == 0) { return -1 }
    let dir [cache.CACHE_ROOT_MAX + 128]u8
    if (admin_join(support.arr_cstr(&store.root[0]), sub, 0, 0,
            &dir[0], cache.CACHE_ROOT_MAX + 128) != 0) { return -1 }
    let buffer [16384]u8
    let opened os.DirReaderResult = os.open_dir(support.arr_cstr(&dir[0]),
        buffer[0..16384])
    if (opened.reader.active == 0) { return 0 }
    for 1 {
        let result os.DirEntryResult = os.next_entry(&opened.reader)
        if (result.status != os.dir_entry_ok) { break }
        let name_len int = result.entry.name_len.to_type(int)
        let path [cache.CACHE_ROOT_MAX + 256]u8
        if (admin_join(support.arr_cstr(&store.root[0]), sub,
                result.entry.name, name_len, &path[0],
                cache.CACHE_ROOT_MAX + 256) == 0) {
            unlink(support.arr_cstr(&path[0]))
        }
    }
    os.close_dir(&opened.reader)
    return 0
}

// idset_hash：取 OutputID 前 8 字节做开放寻址初始槽。
fn idset_hash(set *IdSet, id *u8) int {
    let value u64 = 0
    let i int = 0
    for i < 8 {
        value = value | (id[i].to_type(u64) << (i * 8))
        i += 1
    }
    return (value & 0x7FFFFFFFFFFFFFFF).to_type(int) & (set.capacity - 1)
}

// idset_init：按预计引用数分配；0 = 成功。
fn idset_init(set *IdSet, expected int) int {
    set.count = 0
    let capacity int = 16
    for capacity < expected * 2 && capacity < 1048576 {
        capacity = capacity * 2
    }
    set.capacity = capacity
    set.slots = malloc((capacity * cache.CACHE_ID_SIZE).to_type(u64)).to_type(*u8)
    set.used = malloc(capacity.to_type(u64)).to_type(*u8)
    if (set.slots == 0 || set.used == 0) {
        if (set.slots != 0) { free(set.slots.to_type(*void)) }
        if (set.used != 0) { free(set.used.to_type(*void)) }
        set.slots = 0; set.used = 0; set.capacity = 0
        return -1
    }
    let i int = 0
    for i < capacity { set.used[i] = 0; i += 1 }
    return 0
}

// idset_add：插入 OutputID；表满返回 -1（调用方保守停止回收）。
fn idset_add(set *IdSet, id *u8) int {
    if (set == 0 || set.slots == 0 || set.capacity <= 0) { return -1 }
    let slot int = idset_hash(set, id)
    let first int = slot
    for 1 {
        if (set.used[slot] == 0) {
            let j int = 0
            for j < cache.CACHE_ID_SIZE {
                set.slots[slot * cache.CACHE_ID_SIZE + j] = id[j]
                j += 1
            }
            set.used[slot] = 1
            set.count += 1
            return 0
        }
        let same int = 1
        let j2 int = 0
        for j2 < cache.CACHE_ID_SIZE {
            if (set.slots[slot * cache.CACHE_ID_SIZE + j2] != id[j2]) {
                same = 0
                break
            }
            j2 += 1
        }
        if (same != 0) { return 0 }
        slot = (slot + 1) & (set.capacity - 1)
        if (slot == first) { return -1 }
    }
    return -1
}

// idset_has：OutputID 是否在引用集中。
fn idset_has(set *IdSet, id *u8) int {
    if (set == 0 || set.slots == 0 || set.capacity <= 0) { return 0 }
    let slot int = idset_hash(set, id)
    let first int = slot
    for 1 {
        if (set.used[slot] == 0) { return 0 }
        let same int = 1
        let j int = 0
        for j < cache.CACHE_ID_SIZE {
            if (set.slots[slot * cache.CACHE_ID_SIZE + j] != id[j]) {
                same = 0
                break
            }
            j += 1
        }
        if (same != 0) { return 1 }
        slot = (slot + 1) & (set.capacity - 1)
        if (slot == first) { return 0 }
    }
    return 0
}

// idset_release：释放引用集。
fn idset_release(set *IdSet) void {
    if (set == 0) { return }
    if (set.slots != 0) { free(set.slots.to_type(*void)) }
    if (set.used != 0) { free(set.used.to_type(*void)) }
    set.slots = 0; set.used = 0; set.capacity = 0; set.count = 0
}

// admin_collect_refs：把所有 action entry 的 OutputID 收进引用集。
// action 文件损坏时跳过；0 = 成功。
fn admin_collect_refs(store *cache.CacheStore, set *IdSet) int {
    let actions *CacheFile = 0
    let action_count int = 0
    if (admin_list_dir(store, "v1/actions", &actions, &action_count) == 0) {
        return 0
    }
    let i int = 0
    for i < action_count {
        let action_id [cache.CACHE_ID_SIZE]u8
        if (cache.id_parse_hex(support.arr_cstr(&actions[i].name[0]),
                &action_id[0]) == 0) {
            let entries [cache.CACHE_ACTION_MAX_ENTRIES]cache.CacheEntry
            let count int = 0
            if (cache.store_action_get(store, &action_id[0], &entries[0],
                    cache.CACHE_ACTION_MAX_ENTRIES, &count) == 1) {
                let j int = 0
                for j < count {
                    if (idset_add(set, &entries[j].id[0]) != 0) {
                        admin_release_files(actions)
                        return -1
                    }
                    j += 1
                }
            }
        }
        i += 1
    }
    admin_release_files(actions)
    return 0
}

// admin_byte_text：把字节数写进 512 字节文本缓冲，返回可见行。
fn admin_byte_text(buf *u8, n int, value u64) int {
    n = support.append_i64(buf, n, value.to_type(i64))
    n = support.append_str(buf, n, " bytes")
    return n
}

