module build
import gen
import proj

// ============================================================================
// project_link.yh —— project.toml 平台字段与 [link] 库输入配置
//
// 清单约定（2026-10-21）：
//   [project].os/arch        必填；linux|darwin、arm64|x64|host
//   [link]                   公共组：组名 -> 具体库文件路径数组
//   [link-<os>-<arch>]       目标组：同名组整体替换公共组，新组追加
//   [link-options] 或其他 link-* 节名不属于当前 schema，直接报错。
//
// 本文件只做“清单 -> 项目快照”的语法/结构校验；库文件存在性、后缀、
// 格式、架构和内容摘要由 cmd/link_inputs.yh 在最终链接前处理。
// ============================================================================

// pl_target_common/...：PLinkGroup.target 的编码；与节名一一对应。
fn pl_target_common() int { return 0 }

// pl_os_from_name：把 project.os 字符串映射为 gen.TARGET_OS_*；host=0。
fn pl_os_from_name(off int, n int) int {
    let tk *gen.TaskCtx = gen.task()
    if (n == 4 && tk.np_data[off] == 'h'
        && tk.np_data[off + 1] == 'o'
        && tk.np_data[off + 2] == 's'
        && tk.np_data[off + 3] == 't') { return 0 }
    if (n == 5 && tk.np_data[off] == 'l'
        && tk.np_data[off + 1] == 'i'
        && tk.np_data[off + 2] == 'n'
        && tk.np_data[off + 3] == 'u'
        && tk.np_data[off + 4] == 'x') { return gen.TARGET_OS_LINUX }
    if (n == 6 && tk.np_data[off] == 'd'
        && tk.np_data[off + 1] == 'a'
        && tk.np_data[off + 2] == 'r'
        && tk.np_data[off + 3] == 'w'
        && tk.np_data[off + 4] == 'i'
        && tk.np_data[off + 5] == 'n') { return gen.TARGET_OS_DARWIN }
    return -1
}

// pl_arch_from_name：把 project.arch 字符串映射为 gen.TARGET_ARCH_*；host=0。
fn pl_arch_from_name(off int, n int) int {
    let tk *gen.TaskCtx = gen.task()
    if (n == 4 && tk.np_data[off] == 'h'
        && tk.np_data[off + 1] == 'o'
        && tk.np_data[off + 2] == 's'
        && tk.np_data[off + 3] == 't') { return 0 }
    if (n == 5 && tk.np_data[off] == 'a'
        && tk.np_data[off + 1] == 'r'
        && tk.np_data[off + 2] == 'm'
        && tk.np_data[off + 3] == '6'
        && tk.np_data[off + 4] == '4') { return gen.TARGET_ARCH_ARM64 }
    if (n == 3 && tk.np_data[off] == 'x'
        && tk.np_data[off + 1] == '6'
        && tk.np_data[off + 2] == '4') { return gen.TARGET_ARCH_X64 }
    return -1
}

// pl_bytes_eq：比较清单节名/池内字符串与 C 字符串。
fn pl_bytes_eq(off int, n int, text *char) int {
    let tk *gen.TaskCtx = gen.task()
    let i int = 0
    for i < n {
        if (text[i] == 0 || tk.np_data[off + i] != text[i].to_type(u8)) {
            return 0
        }
        i += 1
    }
    return text[n] == 0 ? 1 : 0
}

// pl_target_code_from_section：返回 0=公共 [link]，1..4=目标表，-1=非法
// link 节名，-2=与链接配置无关的节。
fn pl_target_code_from_section(off int, n int) int {
    if (pl_bytes_eq(off, n, "link") != 0) { return pl_target_common() }
    if (n < 5) { return -2 }
    if (!(pl_bytes_eq(off, 5, "link-") != 0)) { return -2 }
    if (pl_bytes_eq(off, n, "link-linux-arm64") != 0) { return 1 }
    if (pl_bytes_eq(off, n, "link-linux-x64") != 0) { return 2 }
    if (pl_bytes_eq(off, n, "link-darwin-arm64") != 0) { return 3 }
    if (pl_bytes_eq(off, n, "link-darwin-x64") != 0) { return 4 }
    return -1
}

// pl_group_push：向项目快照追加一个空组，返回组下标。
fn pl_group_push(pj int, name_off int, name_len int, target int,
    line int) int {
    if (proj.ctx().projs[pj].link_group_n == proj.ctx().projs[pj].link_group_cap) {
        let ncap int = proj.ctx().projs[pj].link_group_cap * 2
        if (ncap == 0) { ncap = 8 }
        let next *proj.PLinkGroup = malloc(
            (ncap * sizeof(proj.PLinkGroup)).to_type(u64)).to_type(*proj.PLinkGroup)
        if (next == 0) { return gen.fail("项目链接组表内存分配失败") }
        if (proj.ctx().projs[pj].link_group_n > 0) {
            memcpy(next, proj.ctx().projs[pj].link_groups,
                (proj.ctx().projs[pj].link_group_n * sizeof(proj.PLinkGroup)).to_type(u64))
        }
        if (proj.ctx().projs[pj].link_groups != 0) {
            free(proj.ctx().projs[pj].link_groups.to_type(*void))
        }
        proj.ctx().projs[pj].link_groups = next
        proj.ctx().projs[pj].link_group_cap = ncap
    }
    let idx int = proj.ctx().projs[pj].link_group_n
    let g *proj.PLinkGroup = &proj.ctx().projs[pj].link_groups[idx]
    g.name_off = name_off
    g.name_len = name_len
    g.target = target
    g.whole = 0
    g.line = line
    g.items = 0
    g.item_n = 0
    g.item_cap = 0
    proj.ctx().projs[pj].link_group_n += 1
    return idx
}

// pl_item_push：向组追加一个库文件声明路径。
fn pl_item_push(pj int, group int, orig_off int, orig_len int, line int) int {
    let g *proj.PLinkGroup = &proj.ctx().projs[pj].link_groups[group]
    if (g.item_n == g.item_cap) {
        let ncap int = g.item_cap * 2
        if (ncap == 0) { ncap = 8 }
        let next *proj.PLinkItem = malloc(
            (ncap * sizeof(proj.PLinkItem)).to_type(u64)).to_type(*proj.PLinkItem)
        if (next == 0) { return gen.fail("链接库项内存分配失败") }
        if (g.item_n > 0) {
            memcpy(next, g.items, (g.item_n * sizeof(proj.PLinkItem)).to_type(u64))
        }
        if (g.items != 0) { free(g.items.to_type(*void)) }
        g.items = next
        g.item_cap = ncap
    }
    g.items[g.item_n].orig_off = orig_off
    g.items[g.item_n].orig_len = orig_len
    g.items[g.item_n].line = line
    g.item_n += 1
    return 0
}

// pl_name_eq：比较池内组名。
fn pl_name_eq(aoff int, alen int, boff int, blen int) int {
    let tk *gen.TaskCtx = gen.task()
    if (alen != blen) { return 0 }
    let i int = 0
    for i < alen {
        if (tk.np_data[aoff + i] != tk.np_data[boff + i]) { return 0 }
        i += 1
    }
    return 1
}

// pl_find_group：在指定目标编码内按组名查找；没有返回 -1。
fn pl_find_group(pj int, target int, name_off int, name_len int) int {
    let i int = 0
    for i < proj.ctx().projs[pj].link_group_n {
        let g proj.PLinkGroup = proj.ctx().projs[pj].link_groups[i]
        if (g.target == target
            && pl_name_eq(g.name_off, g.name_len, name_off, name_len) != 0) {
            return i
        }
        i += 1
    }
    return -1
}

// pl_load_project_target：读取并校验 [project].os/arch，写入项目快照。
fn pl_load_project_target(pj int, sec int) int {
    let off int = 0
    let plen int = 0
    let got int = toml_sec_str(sec, "os", &off, &plen)
    if (got < 0) { return -1 }
    if (got == 0 || plen == 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[sec].line,
            "project.os 必填（linux|darwin|host）")
    }
    let os_code int = pl_os_from_name(off, plen)
    if (os_code < 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[sec].line,
            "project.os 只能是 linux、darwin 或 host")
    }
    got = toml_sec_str(sec, "arch", &off, &plen)
    if (got < 0) { return -1 }
    if (got == 0 || plen == 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[sec].line,
            "project.arch 必填（arm64|x64|host）")
    }
    let arch_code int = pl_arch_from_name(off, plen)
    if (arch_code < 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[sec].line,
            "project.arch 只能是 arm64、x64 或 host")
    }
    proj.ctx().projs[pj].os_code = os_code
    proj.ctx().projs[pj].arch_code = arch_code
    return 0
}

// pl_apply_project_target：未显式 --target 时，用项目 os/arch 作为默认目标。
fn pl_apply_project_target(pj int) int {
    if (proj.cfg().target_explicit != 0) { return 0 }
    if (gen.target_select_os_arch(proj.ctx().projs[pj].os_code,
        proj.ctx().projs[pj].arch_code) != 0) {
        return proj.diag(proj.ctx().projs[pj].root_off, 1,
            "project.os/arch 组合不受支持")
    }
    return 0
}

// pl_options_code_from_section：返回 0=公共 [link-options]，1..4=目标选项表，
// -1=非法 link-options 节名，-2=与选项无关的节。
fn pl_options_code_from_section(off int, n int) int {
    if (pl_bytes_eq(off, n, "link-options") != 0) { return 0 }
    if (n < 13) { return -2 }
    if (!(pl_bytes_eq(off, 13, "link-options-") != 0)) { return -2 }
    if (pl_bytes_eq(off, n, "link-options-linux-arm64") != 0) { return 1 }
    if (pl_bytes_eq(off, n, "link-options-linux-x64") != 0) { return 2 }
    if (pl_bytes_eq(off, n, "link-options-darwin-arm64") != 0) { return 3 }
    if (pl_bytes_eq(off, n, "link-options-darwin-x64") != 0) { return 4 }
    return -1
}

// pl_load_link_config：只在根项目装载 [link] 与 [link-<os>-<arch>]。
// 依赖项目的 [link] 按约定忽略；这里不读取，也不报 schema 错。
fn pl_load_link_config(pj int, is_root int) int {
    if (is_root == 0) { return 0 }
    let tk *gen.TaskCtx = gen.task()
    let si int = 0
    for si < toml_sec_n {
        let name_off int = toml_secs[si].name_off
        let name_len int = toml_secs[si].name_len
        let opt_target int = pl_options_code_from_section(name_off, name_len)
        if (opt_target != -2) {
            si += 1
            continue
        }
        let target int = pl_target_code_from_section(name_off, name_len)
        if (target == -2) {
            si += 1
            continue
        }
        if (target < 0) {
            let buf [256]u8
            let n int = 0
            n = gen.append_str(buf, n, "非法的链接节名: ")
            let k int = 0
            for k < name_len && n < 230 {
                buf[n] = tk.np_data[name_off + k]
                n += 1
                k += 1
            }
            let mo int = gen.tml_intern_str(buf, 0, n)
            if (mo < 0) { return -1 }
            return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[si].line,
                gen.np_cstr(mo))
        }
        let vi int = 0
        for vi < toml_secs[si].val_n {
            let val TomlVal = toml_secs[si].vals[vi]
            if (val.key_len <= 0 || val.key_len > 128) {
                return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                    "[link] 组名长度必须在 1..128 之间")
            }
            if (pl_find_group(pj, target, val.key_off, val.key_len) >= 0) {
                return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                    "[link] 重复的组名")
            }
            if (val.kind != 4 || val.arr_count < 0 || val.arr_first < 0
                || val.arr_first + val.arr_count > toml_array_n) {
                return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                    "[link] 组值必须是字符串数组")
            }
            let group int = pl_group_push(pj, val.key_off, val.key_len,
                target, val.line)
            if (group < 0) { return -1 }
            let ai int = 0
            for ai < val.arr_count {
                let item TomlArrayItem = toml_array_items[val.arr_first + ai]
                if (item.sval_len <= 0 || item.sval_len >= 1024) {
                    return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                        "[link] 库文件路径必须非空且小于 1024 字节")
                }
                if (pl_item_push(pj, group, item.sval_off,
                    item.sval_len, val.line) != 0) { return -1 }
                ai += 1
            }
            vi += 1
        }
        si += 1
    }
    // 第二遍：解析 [link-options] / [link-options-<os>-<arch>] 的 whole。
    si = 0
    for si < toml_sec_n {
        let name_off int = toml_secs[si].name_off
        let name_len int = toml_secs[si].name_len
        let opt_target int = pl_options_code_from_section(name_off, name_len)
        if (opt_target == -2) { si += 1; continue }
        if (opt_target < 0) {
            return proj.diag(proj.ctx().projs[pj].root_off, toml_secs[si].line,
                "非法的链接选项节名")
        }
        let vi2 int = 0
        for vi2 < toml_secs[si].val_n {
            let val TomlVal = toml_secs[si].vals[vi2]
            if (!(val.key_len == 5 && tk.np_data[val.key_off] == 'w'
                && tk.np_data[val.key_off + 1] == 'h'
                && tk.np_data[val.key_off + 2] == 'o'
                && tk.np_data[val.key_off + 3] == 'l'
                && tk.np_data[val.key_off + 4] == 'e')) {
                return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                    "[link-options] 只支持 whole 字段")
            }
            if (val.kind != 4 || val.arr_first < 0 || val.arr_count < 0
                || val.arr_first + val.arr_count > toml_array_n) {
                return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                    "[link-options].whole 必须是字符串数组")
            }
            let ai2 int = 0
            for ai2 < val.arr_count {
                let item TomlArrayItem = toml_array_items[val.arr_first + ai2]
                if (pl_group_name_ok(item.sval_off, item.sval_len) == 0) {
                    return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                        "[link-options].whole 组名非法")
                }
                let matched int = 0
                let gi int = 0
                for gi < proj.ctx().projs[pj].link_group_n {
                    let g *proj.PLinkGroup = &proj.ctx().projs[pj].link_groups[gi]
                    if (pl_name_eq(g.name_off, g.name_len,
                        item.sval_off, item.sval_len) != 0
                        && (opt_target == 0 || g.target == 0 || g.target == opt_target)) {
                        g.whole = 1
                        matched = 1
                    }
                    gi += 1
                }
                if (matched == 0) {
                    return proj.diag(proj.ctx().projs[pj].root_off, val.line,
                        "[link-options].whole 引用了不存在的组")
                }
                ai2 += 1
            }
            vi2 += 1
        }
        si += 1
    }
    return 0
}

// pl_group_name_ok：--link 组名与清单裸键使用同一字符集。
pub fn pl_group_name_ok(off int, n int) int {
    let tk *gen.TaskCtx = gen.task()
    if (n <= 0 || n > 128) { return 0 }
    let i int = 0
    for i < n {
        let b u8 = tk.np_data[off + i]
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_' || b == '-')) {
            return 0
        }
        i += 1
    }
    return 1
}
