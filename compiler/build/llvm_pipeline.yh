module build
import errors
import support
import check
import ir
import lower
import backend
import proj
import link

// llvm_emit_reason：把桥的诊断文本拼进带来源位置的诊断行并写 stderr。
// path/line/col 来自模块符号的来源记录；桥文本可能为空（分配失败等）。
fn llvm_emit_reason(unit *ir.IRModule, source int, offset int, reason *char) void {
    let buffer [2048]u8
    let n int = 0
    let path *char = "<LLVM 模块>"
    let line int = 1
    let col int = 1
    if (unit != 0 && source >= 0 && source < unit.source_count) {
        let input ir.IRModuleSource = unit.sources[source]
        path = input.path
        let i int = 0
        for i < offset && i < input.length {
            if (input.text[i] == '\n') { line += 1; col = 1 } else { col += 1 }
            i += 1
        }
    }
    n = support.append_str(&buffer[0], n, path)
    n = support.append_byte(&buffer[0], n, ':')
    n = support.append_int(&buffer[0], n, line)
    n = support.append_byte(&buffer[0], n, ':')
    n = support.append_int(&buffer[0], n, col)
    n = support.append_str(&buffer[0], n, ": 错误: LLVM 后端: ")
    if (reason != 0 && reason[0] != 0) {
        n = support.append_str_limit(&buffer[0], n, 1900, reason)
    } else {
        n = support.append_str(&buffer[0], n, "内嵌桥拒绝该模块（诊断缓冲为空）")
    }
    n = support.append_byte(&buffer[0], n, '\n')
    support.write_all(2, &buffer[0], n)
}

// llvm_emit_with_target：Linux 沿用 v1；Darwin 使用已校验会话配置调用带部署版本的 v2。
fn llvm_emit_with_target(text *char, length int, triple *char, opt_level int,
    kind int, path *char, reason *char) int {
    if (proj.cfg().target.os == support.TARGET_OS_DARWIN) {
        let min_os *char = link.cmd_darwin_min_os()
        if (min_os == 0) { return -1 }
        return backend.llvm_bridge_emit_v2(text, length, triple, min_os,
            opt_level, kind, path, reason)
    }
    return backend.llvm_bridge_emit(text, length, triple, opt_level,
        kind, path, reason)
}

// llvm_emit_verify_checked_snapshot：保留快照捕获原有的具体失败诊断。
fn llvm_emit_verify_checked_snapshot(unit *check.CheckedModule) int {
    let stage int = check.verify_checked_module(unit)
    if (stage == 0) { return 0 }
    if (stage == 1) { return errors.fail("受检模块快照表存储无效") }
    if (stage == 2) { return errors.fail("受检模块类型或函数签名快照校验失败") }
    if (stage == 3) { return errors.fail("受检模块字段类型快照校验失败") }
    if (stage == 4) { return errors.fail("受检模块函数参数签名快照校验失败") }
    if (stage == 5) { return errors.fail("受检模块类型别名快照校验失败") }
    if (stage == 6) { return errors.fail("受检模块符号类型快照校验失败") }
    if (stage == 7) { return errors.fail("受检模块文件快照校验失败") }
    if (stage == 8) { return errors.fail("受检模块表达式快照校验失败") }
    if (stage == 9) { return errors.fail("受检模块语句快照校验失败") }
    if (stage == 10) { return errors.fail("受检模块函数快照校验失败") }
    return errors.fail("受检模块快照校验失败")
}

// llvm_emit_add_deployment_metadata：为 Darwin LLVM 文本补充与桥接器一致的规范化最低系统版本。
fn llvm_emit_add_deployment_metadata(output *backend.LLVMOutput) int {
    if (proj.cfg().target.os != support.TARGET_OS_DARWIN) { return 0 }
    let min_os *char = link.cmd_darwin_min_os()
    if (min_os == 0) { return -1 }
    return backend.llvm_output_add_macos_min_os(output, min_os)
}

// llvm_prepare_module：已验证快照 → 模块 IR → LLVM 文本（含目标部署元数据）。
// 两个出参由调用方零初始化；成功返回 0 并交出独占所有权，失败释放候选并保持出参为零。
// 返回 lower_module 的 1（首片不支持，已带来源诊断）或 -1（内部错误）。
fn llvm_prepare_module(unit *check.CheckedModule, mod_ir *ir.IRModule,
    output *backend.LLVMOutput) int {
    return llvm_prepare_module_cached(unit, mod_ir, output, 0, 0, 0, 0)
}

// llvm_prepare_module_cached：LA3 函数级缓存版本；cache 为空时与无缓存路径相同。
fn llvm_prepare_module_cached(unit *check.CheckedModule, mod_ir *ir.IRModule,
    output *backend.LLVMOutput, cache_in *ir.IRFunctionCacheSet,
    cache_out *ir.IRFunctionCacheSet, env_key u64,
    lower_stats *lower.CheckedLowerStats) int {
    // PF2：lowering 段（含函数级 IR 缓存恢复）单独计时，失败也计入已花时间。
    let lowered int = lower.lower_module_cached(unit, mod_ir, cache_in, cache_out,
        env_key, lower_stats)
    // PL1：lowering 内部四段（prep/decl/build/verify）取自 lower 自己的计时，
    // 这里是唯一读点；stats 为空（--emit-llvm 文本路径）时不计。
    if (lower_stats != 0) {
    }
    if (lowered != 0) {
        // lower_module 已按首片契约写好带来源的拒绝诊断，这里不再重复。
        return lowered
    }
    // PF2：yh 侧构造 LLVM IR 文本单独计时（不含内嵌桥的解析/优化/发射）。
    let built int = backend.llvm_emit_module(mod_ir, &proj.cfg().target, output)
    if (built != 0) {
        ir.ir_module_release(mod_ir)
        return -1
    }
    let meta int = llvm_emit_add_deployment_metadata(output)
    if (meta != 0) {
        backend.llvm_output_release(output)
        ir.ir_module_release(mod_ir)
        return -1
    }
    return 0
}

// llvm_emit_write_text：写出审阅用 LLVM 文本；"-" 表示标准输出。
// 返回 0 成功、-1 写失败。单文件/文本专用路径把它视为致命，对象路径只报告。
fn llvm_emit_write_text(output *backend.LLVMOutput, text_path *char) int {
    if (output == 0 || text_path == 0) { return 0 }
    if (support.cstr_eq(text_path, "-") != 0) {
        return support.write_all(1, output.text, output.length) == 0 ? 0 : -1
    }
    let flags int = proj.cfg().host_target.os == support.TARGET_OS_DARWIN ? 0x601 : 0x241
    let fd int = open(text_path, flags, 0x1a4)
    if (fd < 0) {
        errors.fail_path("无法创建 LLVM 文本: ", text_path)
        return -1
    }
    let written int = 0
    for written < output.length {
        let step i64 = write(fd, output.text + written,
            (output.length - written).to_type(u64))
        if (step <= 0) {
            errors.fail_path("写入 LLVM 文本失败: ", text_path)
            close(fd)
            return -1
        }
        written += step.to_type(int)
    }
    close(fd)
    return 0
}

// llvm_emit_temp_path：生成桥的临时输出路径 <out>.tmp.<pid>。
// 返回 0 成功；路径超过固定缓冲时返回 -1（不截断成另一个合法文件名）。
fn llvm_emit_temp_path(buffer *u8, path *char) int {
    let n int = support.append_str_limit(buffer, 0, 1000, path)
    if (path[n] != 0) { return -1 }
    n = support.append_str(buffer, n, ".tmp.")
    n = support.append_int(buffer, n, getpid())
    buffer[n] = 0
    return 0
}

// llvm_emit_publish：调用内嵌桥写临时文件，校验目标格式后 rename 发布。
// kind：0 = 对象，1 = 汇编。成功返回 0；桥失败返回 1（reason 有效，可能为空）；
// 路径/机器格式/rename 失败返回 -1（已写诊断）。
fn llvm_emit_publish(output *backend.LLVMOutput, kind int, out_path *char,
    reason *char, opt_level int) int {
    let temporary [1024]u8
    if (llvm_emit_temp_path(&temporary[0], out_path) != 0) {
        return errors.fail_path("LLVM 产物路径过长: ", out_path)
    }
    unlink(support.arr_cstr(&temporary[0]))
    // PF2：内嵌桥段（LLVM 解析 / 优化 / 目标码生成 / 写对象）单独计时。
    let bridged int = llvm_emit_with_target(output.text.to_type(*char),
        output.length, proj.cfg().target.triple, opt_level, kind,
        support.arr_cstr(&temporary[0]), reason)
    if (bridged != 0) {
        unlink(support.arr_cstr(&temporary[0]))
        return 1
    }
    if (kind == 0 && link.mb_object_machine_matches(support.arr_cstr(&temporary[0])) == 0) {
        unlink(support.arr_cstr(&temporary[0]))
        return errors.fail_path("LLVM 桥发出的对象架构与 target 不符: ", out_path)
    }
    if (rename(support.arr_cstr(&temporary[0]), out_path) != 0) {
        unlink(support.arr_cstr(&temporary[0]))
        return errors.fail_path("无法发布 LLVM 产物: ", out_path)
    }
    return 0
}

// llvm_emit_module_to：把已由调用方校验且未修改的快照降低为模块 IR 并经内嵌桥发布产物。
// kind：0 = 目标文件（对象），1 = 汇编文本；out_path 为产物路径，text_path 非空时
// 额外写出 LLVM 文本（审阅/差分用，失败不致命），asm_path 非空时额外保留汇编
// （--emit-asm，失败判失败）。
// 返回 0 成功、-1 失败（诊断已写 stderr，且不发布任何产物）。
fn llvm_emit_module_to(unit *check.CheckedModule, kind int, out_path *char,
    text_path *char, asm_path *char, stats *LLVMEmitResult, opt_level int) int {
    return llvm_emit_module_to_cached(unit, kind, out_path, text_path, asm_path,
        stats, 0, 0, 0, 0, opt_level)
}

// llvm_emit_module_to_cached：LA3 项目 worker 使用的带函数缓存版本。
fn llvm_emit_module_to_cached(unit *check.CheckedModule, kind int, out_path *char,
    text_path *char, asm_path *char, stats *LLVMEmitResult,
    cache_in *ir.IRFunctionCacheSet, cache_out *ir.IRFunctionCacheSet,
    env_key u64, lower_stats *lower.CheckedLowerStats, opt_level int) int {
    let mod_ir ir.IRModule
    let output backend.LLVMOutput
    let prepared int = llvm_prepare_module_cached(unit, &mod_ir, &output,
        cache_in, cache_out, env_key, lower_stats)
    if (prepared != 0) { return -1 }
    // LLVM 文本是审阅产物：写失败只报告，不影响对象发布。
    llvm_emit_write_text(&output, text_path)
    let reason [backend.LLVM_BRIDGE_DIAG]u8
    let published int = llvm_emit_publish(&output, kind, out_path,
        (&reason[0]).to_type(*char), opt_level)
    if (published != 0) {
        if (published == 1) {
            // 桥失败：按模块第一个来源定位，便于把 LLVM 错误映射回 yh 源码。
            let source int = 0
            let offset int = 0
            if (mod_ir.symbol_count > 0) {
                source = mod_ir.symbols[0].source
                offset = mod_ir.symbols[0].offset
            }
            llvm_emit_reason(&mod_ir, source, offset, (&reason[0]).to_type(*char))
        }
        backend.llvm_output_release(&output)
        ir.ir_module_release(&mod_ir)
        return -1
    }
    // --emit-asm：对象发布成功后再用同一份 LLVM 文本让桥发一次汇编。桥一次
    // 只能出一种产物；这里只在显式请求时多付一次 codegen，换取缓存目录里的 .s。
    if (asm_path != 0 && kind == 0) {
        let asm_reason [backend.LLVM_BRIDGE_DIAG]u8
        let asm_published int = llvm_emit_publish(&output, 1, asm_path,
            (&asm_reason[0]).to_type(*char), opt_level)
        if (asm_published != 0) {
            if (asm_published == 1) {
                let asm_source int = 0
                let asm_offset int = 0
                if (mod_ir.symbol_count > 0) {
                    asm_source = mod_ir.symbols[0].source
                    asm_offset = mod_ir.symbols[0].offset
                }
                llvm_emit_reason(&mod_ir, asm_source, asm_offset,
                    (&asm_reason[0]).to_type(*char))
            }
            backend.llvm_output_release(&output)
            ir.ir_module_release(&mod_ir)
            return -1
        }
    }
    if (stats != 0) {
        stats.emitted = output.emitted
        stats.text_length = output.length
    }
    backend.llvm_output_release(&output)
    ir.ir_module_release(&mod_ir)
    return 0
}

// llvm_emit_text_only：只对已校验且未修改的快照做 lowering 与文本发射，不调用内嵌桥。
// 供 --emit-llvm 审阅形态使用（单文件写标准输出，项目写 .build/<target>/llvm/<tag>.ll）。
// 返回 0 成功、1 首片不支持（lowering 已给来源诊断）、-1 内部错误。
fn llvm_emit_text_only(unit *check.CheckedModule, text_path *char,
    stats *LLVMEmitResult) int {
    let mod_ir ir.IRModule
    let output backend.LLVMOutput
    let prepared int = llvm_prepare_module(unit, &mod_ir, &output)
    if (prepared != 0) { return prepared }
    let status int = llvm_emit_write_text(&output, text_path)
    if (stats != 0) {
        stats.emitted = output.emitted
        stats.text_length = output.length
    }
    backend.llvm_output_release(&output)
    ir.ir_module_release(&mod_ir)
    return status
}
