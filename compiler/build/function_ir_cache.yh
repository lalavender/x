module build
import errors
import support
import ir
import backend
import proj
import link
import cache
import libs.list


// firc_dir_path：算出模块的函数缓存目录 <build>/firc/<tag>。
fn firc_dir_path(m int, build_off int, build_len int, out *u8) int {
    let tag_off int = -1
    let tag_len int = 0
    if (proj.mod_tag(m, &tag_off, &tag_len) != 0) { return -1 }
    let n int = 0
    n = support.append_str(out, n, proj.pool_str(build_off))
    n = support.append_str(out, n, "/firc/")
    n = support.append_str(out, n, proj.pool_str(tag_off))
    out[n] = 0
    return 0
}

// firc_path：把目录、键与后缀拼成 <dir>/<key><suffix>。
fn firc_path(out *u8, dir *char, key *char, suffix *char) int {
    let n int = 0
    n = support.append_str_limit(out, n, 680, dir)
    if (out[n] != 0) { return -1 }
    n = support.append_byte(out, n, '/')
    n = support.append_str(out, n, key)
    n = support.append_str(out, n, suffix)
    out[n] = 0
    return 0
}

// firc_read：读入整个缓存文件；缺失或读取失败返回 0（按 miss 处理）。
// 成功返回 1 并把文件字节放进 out（list<u8>，调用方用 list.release 回收）；
// 超过缓存上限时拒绝。
fn firc_read(path *char, out *list.List) int {
    out[0] = list.make(sizeof(u8).to_type(u64))
    let fd int = open(path, 0)
    if (fd < 0) { return 0 }
    let limit int = 268435488
    if (list.reserve(out, 65536.to_type(u64)) != list.status_ok) {
        close(fd)
        return 0
    }
    for 1 {
        let length int = out.count.to_type(int)
        let capacity int = out.capacity.to_type(int)
        if (length == capacity) {
            let next_capacity int = capacity * 2
            if (next_capacity > limit) { list.release(out); close(fd); return 0 }
            if (list.reserve(out, next_capacity.to_type(u64)) != list.status_ok) {
                list.release(out); close(fd); return 0
            }
        }
        let got i64 = read(fd, out.data + length,
            (out.capacity.to_type(int) - length).to_type(u64))
        if (got < 0) { list.release(out); close(fd); return 0 }
        if (got == 0) { break }
        out.count += got.to_type(u64)
    }
    close(fd)
    return 1
}

// 装载上限只防失控：按编译器自身规模留足余量（实测单模块 28.7 MB、单记录 288 KB）。
const FIRC_RECORD_LIMIT int = 4194304
const FIRC_SET_LIMIT int = 268435456

// firc_role：check 记录用 OUTPUT_CHECK，IR 记录用 OUTPUT_IR。
fn firc_role(suffix *char) int {
    if (suffix == 0 || suffix[2] == 'c') { return cache.OUTPUT_CHECK }
    return cache.OUTPUT_IR
}

// firc_global_load：按函数 ActionID 从全局 action 读取记录内容并校验 OutputID。
// 1 = 命中，0 = miss/缓存关闭/损坏；命中时 out 为 list<u8>。
fn firc_global_load(key *char, role int, out *list.List) int {
    let store *cache.CacheStore = &bc().cache_store
    if (cache.store_enabled(store) == 0) { return 0 }
    let action_id [cache.CACHE_ID_SIZE]u8
    if (cache.id_parse_hex(key, &action_id[0]) != 0) { return 0 }
    let entries [4]cache.CacheEntry
    let count int = 0
    if (cache.store_action_get(store, &action_id[0], &entries[0], 4,
            &count) != 1) {
        if (bc().cache_debug != 0) {
            printf("[cache] function %s global miss\n", key)
        }
        return 0
    }
    let i int = 0
    for i < count {
        if (entries[i].role == role) {
            let hit int = cache.store_get_bytes(store, &entries[i].id[0], out)
            if (bc().cache_debug != 0) {
                printf("[cache] function %s global %s\n", key,
                    hit == 1 ? "hit" : "corrupt")
            }
            return hit
        }
        i += 1
    }
    return 0
}

// firc_global_publish：把记录内容发布到全局 outputs 与 action entry；失败静默。
fn firc_global_publish(key *char, role int, data *u8, size int) void {
    let store *cache.CacheStore = &bc().cache_store
    if (cache.store_enabled(store) == 0 || data == 0 || size <= 0) { return }
    let action_id [cache.CACHE_ID_SIZE]u8
    if (cache.id_parse_hex(key, &action_id[0]) != 0) { return }
    let entry cache.CacheEntry
    entry.role = role
    entry.size = 0
    let out_size u64 = 0
    if (cache.store_put_bytes(store, data, size, &entry.id[0],
            &out_size) != 0) { return }
    entry.size = out_size
    cache.store_action_put(store, &action_id[0], &entry, 1)
}

// firc_load_kind：按记录后缀/索引名读取缓存集合；损坏退化为空/部分集合。
fn firc_load_kind(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) int {
    let index_path [720]u8
    if (firc_path(&index_path[0], dir, index_name, "") != 0) { return 0 }
    let data list.List
    if (firc_read(support.arr_cstr(&index_path[0]), &data) == 0) { return 0 }
    let size int = data.count.to_type(int)
    let bytes *u8 = data.data
    let loaded_total int = 0
    let cursor int = 0
    for 1 {
        if (cursor >= size) { break }
        let line_end int = cursor
        for 1 {
            if (line_end >= size || bytes[line_end] == '\n') { break }
            line_end += 1
        }
        let line_len int = line_end - cursor
        if (line_len >= ir.IR_FUNCTION_CACHE_KEY_HEX) {
            let key [ir.IR_FUNCTION_CACHE_KEY_SIZE]u8
            let i int = 0
            for i < ir.IR_FUNCTION_CACHE_KEY_HEX {
                key[i] = bytes[cursor + i]
                i += 1
            }
            key[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
            if (ir.ir_fc_key_ok(support.arr_cstr(&key[0])) != 0) {
                let record_path [760]u8
                if (firc_path(&record_path[0], dir, support.arr_cstr(&key[0]), suffix) == 0) {
                    let record list.List
                    let have int = firc_read(support.arr_cstr(&record_path[0]), &record)
                    if (have == 0) {
                        // 本地记录缺失时查全局 content store；读出内容经
                        // OutputID 校验后再物化回本地，后续加载直接走本地。
                        if (firc_global_load(support.arr_cstr(&key[0]),
                                firc_role(suffix), &record) == 1) {
                            firc_write_atomic(support.arr_cstr(&record_path[0]),
                                record.data, record.count.to_type(int))
                            have = 1
                        }
                    }
                    if (have != 0) {
                        let record_size int = record.count.to_type(int)
                        // 旧的 16 MiB 总额会让大模块稳定丢掉约三成记录。
                        if (record_size > FIRC_RECORD_LIMIT
                            || loaded_total + record_size > FIRC_SET_LIMIT) {
                            list.release(&record)
                        } else if (ir.ir_function_cache_set_add(set,
                                support.arr_cstr(&key[0]), record.data,
                                record_size) != 0) {
                            list.release(&record)
                        } else {
                            // set_add 成功即接管存储；清 data 以免描述符二次释放。
                            record.data = 0
                            loaded_total += record_size
                        }
                    }
                }
            }
        }
        cursor = line_end + 1
    }
    list.release(&data)
    return 0
}

// firc_load：IR 函数缓存（.fir / index）。
fn firc_load(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_load_kind(dir, set, ".fir", "index")
}

// firc_check_load：函数 check 切片缓存（.fchk / index.check）。
fn firc_check_load(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_load_kind(dir, set, ".fchk", "index.check")
}

// firc_write_atomic：把一段字节写入 path；临时文件完整写完后 rename。
fn firc_write_atomic(path *char, data *u8, size int) int {
    let tmp [900]u8
    let n int = support.append_str_limit(&tmp[0], 0, 860, path)
    if (tmp[n] != 0) { return -1 }
    n = support.append_str(&tmp[0], n, ".tmp.")
    n = support.append_int(&tmp[0], n, getpid())
    tmp[n] = 0
    let fd int = proj.open_out(support.arr_cstr(&tmp[0]))
    if (fd < 0) { return -1 }
    if (support.write_all(fd, data, size) != 0 || close(fd) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return -1
    }
    if (rename(support.arr_cstr(&tmp[0]), path) != 0) {
        unlink(support.arr_cstr(&tmp[0]))
        return -1
    }
    return 0
}

// firc_recycle_old：按旧索引删除本轮不再使用的记录；索引外的孤儿文件不做目录枚举。
fn firc_recycle_old(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) void {
    let path [760]u8
    if (firc_path(&path[0], dir, index_name, "") != 0) { return }
    let data list.List
    if (firc_read(support.arr_cstr(&path[0]), &data) == 0) { return }
    let size int = data.count.to_type(int)
    let bytes *u8 = data.data
    let cursor int = 0
    for cursor + ir.IR_FUNCTION_CACHE_KEY_HEX <= size {
        let key [ir.IR_FUNCTION_CACHE_KEY_SIZE]u8
        let i int = 0
        for i < ir.IR_FUNCTION_CACHE_KEY_HEX { key[i] = bytes[cursor + i]; i += 1 }
        key[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
        if (ir.ir_fc_key_ok(support.arr_cstr(&key[0])) != 0
            && ir.ir_function_cache_set_find(set, support.arr_cstr(&key[0])) == 0
            && firc_path(&path[0], dir, support.arr_cstr(&key[0]), suffix) == 0) {
            unlink(support.arr_cstr(&path[0]))
        }
        cursor += ir.IR_FUNCTION_CACHE_KEY_HEX + 1
    }
    list.release(&data)
}

// firc_commit_kind：成功构建后提交记录与索引；写失败只警告，不改变构建结果。
fn firc_commit_kind(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) int {
    if (link.cmd_mkdirs(dir) != 0) {
        errors.fail_path("无法创建函数缓存目录: ", dir)
        return 0
    }
    let index_len int = set.count * (ir.IR_FUNCTION_CACHE_KEY_HEX + 1)
    let index *u8 = 0
    if (index_len > 0) {
        index = malloc(index_len.to_type(u64)).to_type(*u8)
        if (index == 0) {
            errors.fail_path("无法分配函数缓存索引: ", dir)
            return 0
        }
    }
    // 先按旧索引回收本轮不再使用的记录，再写新记录与索引。
    firc_recycle_old(dir, set, suffix, index_name)
    let cursor int = 0
    let i int = 0
    for i < set.count {
        let key *char = set.entries[i].key
        if (set.entries[i].data != 0) {
            let record_path [760]u8
            if (firc_path(&record_path[0], dir, key, suffix) != 0
                || firc_write_atomic(support.arr_cstr(&record_path[0]),
                    set.entries[i].data, set.entries[i].size) != 0) {
                errors.fail_path("无法写函数缓存记录: ", key)
            } else {
                firc_global_publish(key, firc_role(suffix),
                    set.entries[i].data, set.entries[i].size)
            }
        }
        let j int = 0
        for j < ir.IR_FUNCTION_CACHE_KEY_HEX {
            index[cursor] = key[j].to_type(u8)
            cursor += 1
            j += 1
        }
        index[cursor] = '\n'
        cursor += 1
        i += 1
    }
    let index_path [720]u8
    if (firc_path(&index_path[0], dir, index_name, "") != 0
        || firc_write_atomic(support.arr_cstr(&index_path[0]), index,
            index_len) != 0) {
        errors.fail_path("无法提交函数缓存索引: ", dir)
    }
    if (index != 0) { free(index.to_type(*void)) }
    return 0
}

// firc_commit：IR 函数缓存提交。
fn firc_commit(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_commit_kind(dir, set, ".fir", "index")
}

// firc_check_commit：函数 check 切片缓存提交。
fn firc_check_commit(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_commit_kind(dir, set, ".fchk", "index.check")
}

// firc_hash_text：把标签/目标字符串混入 FNV。
fn firc_hash_text(hash *u64, text *char) int {
    if (text == 0) { return -1 }
    let i int = 0
    for text[i] != 0 { proj.fnv(hash, text[i].to_type(u8)); i += 1 }
    proj.fnv(hash, 0)
    return 0
}

// firc_env_key：模块环境键：目标/优化/编译器/桥 + 本模块与依赖接口内容。
// 不含本模块函数体源码，因此单函数改动不会让其他函数失效；接口/CT/目标变化
// 会让全部函数保守失效。
fn firc_env_key_common(m int, build_off int, build_len int, out *u64,
    include_current int) int {
    out[0] = 0
    let h u64 = proj.hash_init()
    if (firc_hash_text(&h, "yh-firc-env-3") != 0
        || firc_hash_text(&h, proj.cfg().target.triple) != 0
        || firc_hash_text(&h, proj.cfg().target.data_layout) != 0
        || firc_hash_text(&h, proj.cfg().target.abi) != 0) { return -1 }
    proj.fnv(&h, proj.cfg().target.pointer_bits.to_type(u8))
    proj.fnv(&h, proj.cfg().target.little_endian.to_type(u8))
    proj.fnv(&h, proj.cfg().target.layout_version.to_type(u8))
    proj.fnv(&h, ('0' + proj.module_opt_level(m)).to_type(u8))
    proj.fnv(&h, ('0' + proj.cfg().trimpath).to_type(u8))
    let salt u64 = support.ctl().ir_cache_salt
    let si int = 0
    for si < 8 { proj.fnv(&h, ((salt >> (si * 8)) & 255).to_type(u8)); si += 1 }
    if (firc_hash_text(&h, backend.llvm_bridge_version()) != 0) { return -1 }
    // 本模块本轮接口（pub 签名、全局常量与 CT 正文）。check 缓存发生在
    // iface 发射之前，不能用本轮接口，改由函数键里的非函数声明 token 覆盖。
    if (include_current != 0) {
        let iface_path [700]u8
        if (proj.module_iface_path(m, build_off, build_len, bc().iface_suffix, &iface_path[0]) != 0
            || proj.hash_file(&h, support.arr_cstr(&iface_path[0])) != 0) { return -1 }
        let ct_path [700]u8
        if (proj.module_ctiface_path(m, build_off, build_len, bc().iface_suffix,
            &ct_path[0]) != 0
            || proj.hash_file(&h, support.arr_cstr(&ct_path[0])) != 0) { return -1 }
    }
    // 依赖接口由父进程在本轮 worker 启动前装载；直接复用其路径表。
    let di int = 0
    for di < bdep_count() {
        if (proj.hash_file(&h, proj.pool_str(bdep_at(di).ifoff)) != 0
            || proj.hash_file(&h, proj.pool_str(bdep_at(di).ctoff)) != 0) { return -1 }
        di += 1
    }
    out[0] = h
    return 0
}

// firc_env_key：项目函数缓存环境键（含本模块本轮接口）。
fn firc_env_key(m int, build_off int, build_len int, out *u64) int {
    return firc_env_key_common(m, build_off, build_len, out, 1)
}

