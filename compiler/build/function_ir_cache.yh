module build
import gen
import ir
import backend
import proj

// ============================================================================
// function_ir_cache.yh —— 函数级 IR 缓存的命令侧 I/O（LA3）
//
// 缓存目录：<build>/firc/<tag>/
//   index      每行一个 16 位十六进制键；只列本次构建实际参与缓存的函数
//   <key>.fir 函数缓存记录（32 字节外层头 + 迷你 IRModule）
//
// 装载失败、索引损坏或记录缺失都按 miss 处理，不影响构建；提交只在模块完整
// 成功后进行，逐记录写临时文件再 rename，最后原子替换 index。缓存写失败只
// 报告，不把只读/满盘环境变成编译失败。
// ============================================================================

// firc_dir_path：算出模块的函数缓存目录 <build>/firc/<tag>。
fn firc_dir_path(m int, build_off int, build_len int, out *u8) int {
    let tag_off int = -1
    let tag_len int = 0
    if (mb_mod_tag(m, &tag_off, &tag_len) != 0) { return -1 }
    let n int = 0
    n = gen.append_str(out, n, proj.pool_str(build_off))
    n = gen.append_str(out, n, "/firc/")
    n = gen.append_str(out, n, proj.pool_str(tag_off))
    out[n] = 0
    return 0
}

// firc_path：把目录、键与后缀拼成 <dir>/<key><suffix>。
fn firc_path(out *u8, dir *char, key *char, suffix *char) int {
    let n int = 0
    n = gen.append_str_limit(out, n, 680, dir)
    if (out[n] != 0) { return -1 }
    n = gen.append_byte(out, n, '/')
    n = gen.append_str(out, n, key)
    n = gen.append_str(out, n, suffix)
    out[n] = 0
    return 0
}

// firc_read：读入整个缓存文件；缺失或读取失败返回 0（按 miss 处理）。
// 成功返回 1 并交出 out_data/out_size 所有权；超过缓存上限时拒绝。
fn firc_read(path *char, out_data **u8, out_size *int) int {
    out_data[0] = 0; out_size[0] = 0
    let fd int = open(path, 0)
    if (fd < 0) { return 0 }
    let limit int = 268435488
    let capacity int = 65536
    let data *u8 = malloc(capacity.to_type(u64)).to_type(*u8)
    if (data == 0) { close(fd); return 0 }
    let length int = 0
    for 1 {
        if (length == capacity) {
            let next_capacity int = capacity * 2
            if (next_capacity > limit) { free(data.to_type(*void)); close(fd); return 0 }
            let next *u8 = malloc(next_capacity.to_type(u64)).to_type(*u8)
            if (next == 0) { free(data.to_type(*void)); close(fd); return 0 }
            memcpy(next, data, length.to_type(u64))
            free(data.to_type(*void))
            data = next; capacity = next_capacity
        }
        let got i64 = read(fd, data + length, (capacity - length).to_type(u64))
        if (got < 0) { free(data.to_type(*void)); close(fd); return 0 }
        if (got == 0) { break }
        length += got.to_type(int)
    }
    close(fd)
    out_data[0] = data; out_size[0] = length
    return 1
}

// 装载上限只防失控：按编译器自身规模留足余量（实测单模块 28.7 MB、单记录 288 KB）。
const FIRC_RECORD_LIMIT int = 4194304
const FIRC_SET_LIMIT int = 268435456

// firc_load_kind：按记录后缀/索引名读取缓存集合；损坏退化为空/部分集合。
fn firc_load_kind(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) int {
    let index_path [720]u8
    if (firc_path(&index_path[0], dir, index_name, "") != 0) { return 0 }
    let data *u8 = 0
    let size int = 0
    if (firc_read(gen.arr_cstr(&index_path[0]), &data, &size) == 0) { return 0 }
    let loaded_total int = 0
    let cursor int = 0
    for 1 {
        if (cursor >= size) { break }
        let line_end int = cursor
        for 1 {
            if (line_end >= size || data[line_end] == '\n') { break }
            line_end += 1
        }
        let line_len int = line_end - cursor
        if (line_len >= ir.IR_FUNCTION_CACHE_KEY_HEX) {
            let key [ir.IR_FUNCTION_CACHE_KEY_SIZE]u8
            let i int = 0
            for i < ir.IR_FUNCTION_CACHE_KEY_HEX {
                key[i] = data[cursor + i]
                i += 1
            }
            key[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
            if (ir.ir_fc_key_ok(gen.arr_cstr(&key[0])) != 0) {
                let record_path [760]u8
                if (firc_path(&record_path[0], dir, gen.arr_cstr(&key[0]), suffix) == 0) {
                    let record *u8 = 0
                    let record_size int = 0
                    if (firc_read(gen.arr_cstr(&record_path[0]), &record,
                            &record_size) != 0) {
                        // 旧的 16 MiB 总额会让大模块稳定丢掉约三成记录。
                        if (record_size > FIRC_RECORD_LIMIT
                            || loaded_total + record_size > FIRC_SET_LIMIT) {
                            free(record.to_type(*void))
                        } else if (ir.ir_function_cache_set_add(set, gen.arr_cstr(&key[0]),
                                record, record_size) != 0) {
                            free(record.to_type(*void))
                        } else {
                            loaded_total += record_size
                        }
                    }
                }
            }
        }
        cursor = line_end + 1
    }
    free(data.to_type(*void))
    return 0
}

// firc_load：IR 函数缓存（.fir / index）。
fn firc_load(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_load_kind(dir, set, ".fir", "index")
}

// firc_check_load：函数 check 切片缓存（.fchk / index.check）。
fn firc_check_load(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_load_kind(dir, set, ".fchk", "index.check")
}

// firc_write_atomic：把一段字节写入 path；临时文件完整写完后 rename。
fn firc_write_atomic(path *char, data *u8, size int) int {
    let tmp [900]u8
    let n int = gen.append_str_limit(&tmp[0], 0, 860, path)
    if (tmp[n] != 0) { return -1 }
    n = gen.append_str(&tmp[0], n, ".tmp.")
    n = gen.append_int(&tmp[0], n, getpid())
    tmp[n] = 0
    let fd int = mb_open_out(gen.arr_cstr(&tmp[0]))
    if (fd < 0) { return -1 }
    if (gen.write_all(fd, data, size) != 0 || close(fd) != 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        return -1
    }
    if (rename(gen.arr_cstr(&tmp[0]), path) != 0) {
        unlink(gen.arr_cstr(&tmp[0]))
        return -1
    }
    return 0
}

// firc_recycle_old：按旧索引删除本轮不再使用的记录；索引外的孤儿文件不做目录枚举。
fn firc_recycle_old(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) void {
    let path [760]u8
    if (firc_path(&path[0], dir, index_name, "") != 0) { return }
    let data *u8 = 0
    let size int = 0
    if (firc_read(gen.arr_cstr(&path[0]), &data, &size) == 0) { return }
    let cursor int = 0
    for cursor + ir.IR_FUNCTION_CACHE_KEY_HEX <= size {
        let key [ir.IR_FUNCTION_CACHE_KEY_SIZE]u8
        let i int = 0
        for i < ir.IR_FUNCTION_CACHE_KEY_HEX { key[i] = data[cursor + i]; i += 1 }
        key[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
        if (ir.ir_fc_key_ok(gen.arr_cstr(&key[0])) != 0
            && ir.ir_function_cache_set_find(set, gen.arr_cstr(&key[0])) == 0
            && firc_path(&path[0], dir, gen.arr_cstr(&key[0]), suffix) == 0) {
            unlink(gen.arr_cstr(&path[0]))
        }
        cursor += ir.IR_FUNCTION_CACHE_KEY_HEX + 1
    }
    free(data.to_type(*void))
}

// firc_commit_kind：成功构建后提交记录与索引；写失败只警告，不改变构建结果。
fn firc_commit_kind(dir *char, set *ir.IRFunctionCacheSet, suffix *char,
    index_name *char) int {
    if (cmd_mkdirs(dir) != 0) {
        gen.fail_path("无法创建函数缓存目录: ", dir)
        return 0
    }
    let index_len int = set.count * (ir.IR_FUNCTION_CACHE_KEY_HEX + 1)
    let index *u8 = 0
    if (index_len > 0) {
        index = malloc(index_len.to_type(u64)).to_type(*u8)
        if (index == 0) {
            gen.fail_path("无法分配函数缓存索引: ", dir)
            return 0
        }
    }
    // 先按旧索引回收本轮不再使用的记录，再写新记录与索引。
    firc_recycle_old(dir, set, suffix, index_name)
    let cursor int = 0
    let i int = 0
    for i < set.count {
        let key *char = set.entries[i].key
        if (set.entries[i].data != 0) {
            let record_path [760]u8
            if (firc_path(&record_path[0], dir, key, suffix) != 0
                || firc_write_atomic(gen.arr_cstr(&record_path[0]),
                    set.entries[i].data, set.entries[i].size) != 0) {
                gen.fail_path("无法写函数缓存记录: ", key)
            }
        }
        let j int = 0
        for j < ir.IR_FUNCTION_CACHE_KEY_HEX {
            index[cursor] = key[j].to_type(u8)
            cursor += 1
            j += 1
        }
        index[cursor] = '\n'
        cursor += 1
        i += 1
    }
    let index_path [720]u8
    if (firc_path(&index_path[0], dir, index_name, "") != 0
        || firc_write_atomic(gen.arr_cstr(&index_path[0]), index,
            index_len) != 0) {
        gen.fail_path("无法提交函数缓存索引: ", dir)
    }
    if (index != 0) { free(index.to_type(*void)) }
    return 0
}

// firc_commit：IR 函数缓存提交。
fn firc_commit(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_commit_kind(dir, set, ".fir", "index")
}

// firc_check_commit：函数 check 切片缓存提交。
fn firc_check_commit(dir *char, set *ir.IRFunctionCacheSet) int {
    return firc_commit_kind(dir, set, ".fchk", "index.check")
}

// firc_hash_text：把标签/目标字符串混入 FNV。
fn firc_hash_text(hash *u64, text *char) int {
    if (text == 0) { return -1 }
    let i int = 0
    for text[i] != 0 { mb_fnv(hash, text[i].to_type(u8)); i += 1 }
    mb_fnv(hash, 0)
    return 0
}

// firc_env_key：模块环境键：目标/优化/编译器/桥 + 本模块与依赖接口内容。
// 不含本模块函数体源码，因此单函数改动不会让其他函数失效；接口/CT/目标变化
// 会让全部函数保守失效。
fn firc_env_key_common(m int, build_off int, build_len int, out *u64,
    include_current int) int {
    let gs *gen.GenState = gen.G()
    out[0] = 0
    let h u64 = mb_hash_init()
    if (firc_hash_text(&h, "yh-firc-env-1") != 0
        || firc_hash_text(&h, gs.c_target.triple) != 0
        || firc_hash_text(&h, gs.c_target.data_layout) != 0
        || firc_hash_text(&h, gs.c_target.abi) != 0) { return -1 }
    mb_fnv(&h, gs.c_target.pointer_bits.to_type(u8))
    mb_fnv(&h, gs.c_target.little_endian.to_type(u8))
    mb_fnv(&h, gs.c_target.layout_version.to_type(u8))
    mb_fnv(&h, ('0' + gs.c_opt_level).to_type(u8))
    let salt u64 = gs.c_ir_cache_salt
    let si int = 0
    for si < 8 { mb_fnv(&h, ((salt >> (si * 8)) & 255).to_type(u8)); si += 1 }
    if (firc_hash_text(&h, backend.llvm_bridge_version()) != 0) { return -1 }
    // 本模块本轮接口（pub 签名、全局常量与 CT 正文）。check 缓存发生在
    // iface 发射之前，不能用本轮接口，改由函数键里的非函数声明 token 覆盖。
    if (include_current != 0) {
        let iface_path [700]u8
        if (mb_module_iface_path(m, build_off, build_len, &iface_path[0]) != 0
            || mb_hash_file(&h, gen.arr_cstr(&iface_path[0])) != 0) { return -1 }
        let ct_path [700]u8
        if (mb_module_ctiface_path(m, build_off, build_len, &ct_path[0]) != 0
            || mb_hash_file(&h, gen.arr_cstr(&ct_path[0])) != 0) { return -1 }
    }
    // 依赖接口由父进程在本轮 worker 启动前装载；直接复用其路径表。
    let di int = 0
    for di < mb_dep_n {
        if (mb_hash_file(&h, proj.pool_str(mb_dep_ifoff[di])) != 0
            || mb_hash_file(&h, proj.pool_str(mb_dep_ctoff[di])) != 0) { return -1 }        di += 1
    }
    out[0] = h
    return 0
}

// firc_env_key：项目函数缓存环境键（含本模块本轮接口）。
fn firc_env_key(m int, build_off int, build_len int, out *u64) int {
    return firc_env_key_common(m, build_off, build_len, out, 1)
}

