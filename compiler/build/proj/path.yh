module proj
import support

// ============================================================================
//
// 三部分：
//   1. 路径规范化与名字池落地（canon/pool_str/file_exists/diag）；
//   2. 环境与根项目登记（env_fetch/set_root_project/is_root_project）；
//   3. 前端窄口读（file/file_count/test_file_selected）。
//
// 窄口的意义：parse/ast/check 只需要"这个文件的声明槽、文件数、这个文件是否
// 属于本轮测试"，不应该看见整个项目模型。此前这些函数挂在 gen 上（gen 是
// proj 的下层，只能读自己那份表），表搬到 proj 后窄口随之落在这里。
// ============================================================================

// dep_opt_enabled：依赖项目是否按 O2 发射（缺省开，`YH_DEP_OPT=0` 关闭）。
// 依赖项目（标准库/第三方）在产物里是「整模块对象」，O0 会把整套未优化实现
// 带进每个程序（J6-L3 实测 fmt 版 hello：`__text` 35.7 KB → 12.5 KB）。
// 根项目（用户代码）不受影响，仍用命令行优化级，缺省 O0——自举与语料口径不变。
fn dep_opt_enabled() int {
    let off int = -1
    let olen int = 0
    if (env_fetch("YH_DEP_OPT", &off, &olen) != 0 || olen == 0) { return 1 }
    let first char = support.np_cstr(off)[0]
    if (first == '0' || first == 'n' || first == 'N'
        || first == 'f' || first == 'F') {
        return 0
    }
    return 1
}

