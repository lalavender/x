module build
import gen

// process.yh —— 编译器用显式 argv 启动宿主进程，不经过命令解释器。

// mb_can_fork：本机是否支持 fork 式进程隔离。Windows 没有 fork，模块 worker
// 退化为「在本进程里串行编译」（worker 入口自带会话重置，见 build_scheduler）。
// 这是启动 W2 的最小步骤；真正的 CreateProcess 重入（W2-4b）后续再做。
pub fn mb_can_fork() int {
    // 测试钩子：YH_NO_FORK=1 在 Linux/Darwin 上强制串行路径，用来验证 Windows
    // 宿主的构建流程（否则只有 Windows 机器能覆盖这段代码）。
    let off int = -1
    let len int = 0
    if (pj_env_fetch("YH_NO_FORK", &off, &len) == 0) {
        if (len == 1 && gen.task().np_data[off] == '1') { return 0 }
    }
    $if (windows) { return 0 }
    $else { return 1 }
}

// cmd_mkdir_if_missing：调用宿主 mkdir API；若目录已存在则确认它确为目录。
fn cmd_mkdir_if_missing(path *char) int {
    if (path == 0) {
        return -1
    }
    if (mkdir(path, 493) == 0) {
        return 0
    }
    let n int = strlen(path).to_type(int)
    if (n < 0 || n > 1096) {
        return -1
    }
    let probe [1100]u8
    let i int = 0
    for i < n {
        probe[i] = path[i].to_type(u8)
        i += 1
    }
    probe[n] = '/'
    probe[n + 1] = '.'
    probe[n + 2] = 0
    let fd int = open(gen.arr_cstr(probe), 0)
    if (fd < 0) {
        return -1
    }
    close(fd)
    return 0
}

// cmd_mkdirs：按路径分隔符逐段创建目录，实现构建所需的 mkdir -p 行为。
pub fn cmd_mkdirs(path *char) int {
    if (path == 0) {
        return -1
    }
    let n int = strlen(path).to_type(int)
    if (n <= 0 || n > 1096) {
        return -1
    }
    let buf [1100]u8
    let i int = 0
    for i < n {
        buf[i] = path[i].to_type(u8)
        i += 1
    }
    buf[n] = 0
    i = 1
    for i <= n {
        if (i == n || buf[i] == '/') {
            let saved u8 = buf[i]
            buf[i] = 0
            if (i > 0 && cmd_mkdir_if_missing(gen.arr_cstr(buf)) != 0) {
                return -1
            }
            buf[i] = saved
        }
        i += 1
    }
    return 0
}

// yh_win_spawn_capture：Windows 侧「运行 argv 并把 stdout 写到文件」的包装
// （compiler/llvm/windows_shim.c）。仅无 fork 宿主使用，其余平台不引用。
@[extern] fn yh_win_spawn_capture(argv **char, argc int, path *char) int

// cmd_process_status：把 waitpid 的状态字转换为普通退出码或信号退出码。
pub fn cmd_process_status(pid int) int {
    let status int = 0
    if (pid <= 0 || waitpid(pid, &status, 0) != pid) {
        return -1
    }
    if ((status & 127) == 0) {
        return (status >> 8) & 255
    }
    return 128 + (status & 127)
}

// cmd_process_run：用 argv 直接执行程序并等待它结束；失败返回 -1。
pub fn cmd_process_run(argv **char) int {
    if (argv == 0 || argv[0] == 0) {
        return -1
    }
    // Windows 没有 fork/exec：直接 CreateProcessA 并等待（yh run / C 源工具）。
    $if (windows) {
        let count int = 0
        for argv[count] != 0 { count += 1 }
        return yh_win_spawn_wait(argv, count)
    } $else {
        let pid int = fork()
        if (pid < 0) {
            return -1
        }
        if (pid == 0) {
            execvp(argv[0], argv)
            exit(127)
        }
        return cmd_process_status(pid)
    }
}

// cmd_process_capture：在不经过 shell 的前提下捕获子进程标准输出。
// capture_path 是本次调用专属的临时文件路径；函数负责创建、读取并删除它。
// 返回捕获字节数；命令失败、输出超出容量或文件操作失败时返回 -1。
pub fn cmd_process_capture(argv **char, capture_path *char,
    output *u8, capacity int) int {
    if (argv == 0 || argv[0] == 0 || capture_path == 0
        || output == 0 || capacity <= 0) {
        return -1
    }
    $if (windows) {
        let count int = 0
        for argv[count] != 0 { count += 1 }
        if (yh_win_spawn_capture(argv, count, capture_path) != 0) {
            unlink(capture_path)
            return -1
        }
    } $else {
        let pid int = fork()
        if (pid < 0) {
            return -1
        }
        if (pid == 0) {
            let flags int = 0x241
            if (gen.tg_host_darwin() != 0) {
                flags = 0x601
            }
            let out_fd int = open(capture_path, flags, 0x1a4)
            if (out_fd < 0) {
                exit(126)
            }
            if (dup2(out_fd, 1) < 0) {
                close(out_fd)
                exit(126)
            }
            close(out_fd)
            execvp(argv[0], argv)
            exit(127)
        }
        if (cmd_process_status(pid) != 0) {
            unlink(capture_path)
            return -1
        }
    }
    let in_fd int = open(capture_path, 0)
    if (in_fd < 0) {
        unlink(capture_path)
        return -1
    }
    let total int = 0
    let failed int = 0
    let chunk [512]u8
    for 1 {
        let got i64 = read(in_fd, (&chunk[0]).to_type(*u8), 512)
        if (got < 0) {
            failed = 1
            break
        }
        if (got == 0) {
            break
        }
        let count int = got.to_type(int)
        if (total + count >= capacity) {
            failed = 1
            break
        }
        let i int = 0
        for i < count {
            output[total + i] = chunk[i]
            i += 1
        }
        total += count
    }
    close(in_fd)
    unlink(capture_path)
    if (failed != 0) {
        return -1
    }
    output[total] = 0
    return total
}
