module gen;

// front_checked_begin：进入受检前端，独立于 check 开关禁止机器输出。
// 调用方必须在语义遍历前进入；已写出的旧缓冲不能靠丢弃来伪造零输出。
pub fn front_checked_begin() int {
    if (g_state.task.c_front_checked != 0 || g_state.task.o_len != 0
        || g_state.task.o_body_len != 0 || g_state.task.o_dlen != 0 || g_state.task.o_blen != 0) {
        return fail("内部错误：受检前端开始时已有旧汇编输出或阶段重复进入");
    }
    g_state.task.c_front_checked = 1;
    return 0;
}

// front_checked_verify：核对阶段仍在受检模式且四类旧缓冲长度为零。
// 此函数不清除污染；worker 捕获快照和后端交接前必须检验实际输出状态。
pub fn front_checked_verify() int {
    if (g_state.task.c_front_checked == 0 || g_state.task.o_len != 0
        || g_state.task.o_body_len != 0 || g_state.task.o_dlen != 0 || g_state.task.o_blen != 0) {
        return fail("内部错误：受检前端产生旧汇编或不在受检阶段");
    }
    return 0;
}

// front_checked_end：成功检验后退出阶段；失败保留禁发状态，不能继续旧后端。
// 后端消费快照的调用方自行决定退出时点，check 在语义完成时调用。
pub fn front_checked_end() int {
    if (front_checked_verify() != 0) { return -1; }
    g_state.task.c_front_checked = 0;
    return 0;
}
