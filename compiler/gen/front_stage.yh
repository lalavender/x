module gen
import support

// ============================================================================
// front_stage.yh —— 受检前端阶段的进入/校验/退出（LL12 后旧输出缓冲已删除）
//
// 阶段位 `c_front_checked` 仍住在 gen.TaskCtx（它是每任务状态，等 TaskCtx 拆迁
// 时一并归位）；本文件只提供唯一的进出入口，避免调用方各写一遍。
// 失败时保留禁发状态，不能继续旧后端。
// ============================================================================

// front_checked_begin：进入受检前端；重复进入报内部错误。
pub fn front_checked_begin() int {
    let tk *TaskCtx = task()
    if (tk.c_front_checked != 0) {
        return support.fail("内部错误：受检前端阶段重复进入")
    }
    tk.c_front_checked = 1
    return 0
}

// front_checked_verify：核对阶段仍在受检模式；0 = 仍在受检阶段。
pub fn front_checked_verify() int {
    if (task().c_front_checked == 0) {
        return support.fail("内部错误：不在受检阶段")
    }
    return 0
}

// front_checked_end：成功检验后退出阶段；失败保留禁发状态。
// 后端消费快照的调用方自行决定退出时点，check 在语义完成时调用。
pub fn front_checked_end() int {
    if (front_checked_verify() != 0) { return -1 }
    task().c_front_checked = 0
    return 0
}
