module gen

// ============================================================================
// argv.windows.yh —— Windows 下重建 UTF-8 argc/argv（VENC-2，2026-11-05）。
//
// 背景：自举编译器（以及任何链接 libcmt 的 Windows 程序）入口是 CRT 的
// mainCRTStartup，argv 经 __getmainargs → GetCommandLineA 按 ANSI 码页（ACP）
// 取得——英文 runner（ACP=1252）上中文参数在源头就变成 '?'，零 CRT 入口桩
// 的 GetCommandLineW 修复（llvm_windows_runtime_write_entry，同日 VENC）帮
// 不到它：`/alternatename:mainCRTStartup=__yh_zero_crt_start` 只在闭包里没有
// CRT 时生效（link/windows_link.yh 的双形态入口）。testkit `--filter 中文`
// 由此在 CI（1252）永不匹配、在本机（936/GBK）拿到 GBK 字节。
//
// 这里在 main 最前用 GetCommandLineW + WideCharToMultiByte(65001) 把命令行
// 统一重建为 UTF-8 argv：CRT 入口之后得到正确 UTF-8；零 CRT 入口（argv 已是
// UTF-8）重建为幂等直通。解析语义与零 CRT 桩一致：双引号成组、空格分隔、
// 连续空格忽略、引号本身不进入参数。任何一步失败时保持传入的 argc/argv
// 不变（ASCII 命令行仍然可用，与桩的 conv_fail 降级一致）。
// ============================================================================

@[extern] fn GetCommandLineW() *i16
@[extern] fn WideCharToMultiByte(code_page u32, flags u32, wide *i16, wide_len int, out *u8, out_cap int, default_char *void, used_default *void) int

let argv_line [32768]u8      // UTF-8 命令行整行（含程序名），原地压缩
let argv_vec [512]*char      // 参数指针表（argv_vec[count] 写 0 结尾）

// argv_utf8_rebuild：把入口层传入的 argc/argv 原地替换为 UTF-8 版本。
pub fn argv_utf8_rebuild(argc_out *int, argv_out ***char) void {
    let line *i16 = GetCommandLineW()
    let n int = WideCharToMultiByte(65001, 0, line, -1, &argv_line[0], 32767, 0, 0)
    if (n <= 0) { return }
    let i int = 0          // 读游标（argv_line 内）
    let o int = 0          // 写游标（丢引号后 o <= i 恒成立，压缩安全）
    let count int = 0      // 已记录的参数个数
    let in_quotes int = 0
    let started int = 0
    let done int = 0
    for done == 0 {
        let c int = argv_line[i].to_type(int)
        if (c == 0) {
            done = 1
        } else if (c == 34) {
            // 双引号：成组开关，本身不进入参数文本。
            in_quotes = 1 - in_quotes
            i += 1
        } else if (c == 32 && in_quotes == 0) {
            // 引号外的空格：参数分隔；连续空格只收一个终止符。
            if (started != 0) {
                argv_line[o] = 0
                o += 1
                started = 0
            }
            i += 1
        } else {
            if (started == 0) {
                argv_vec[count] = (&argv_line[o]).to_type(*char)
                count += 1
                started = 1
            }
            argv_line[o] = argv_line[i]
            o += 1
            i += 1
        }
    }
    if (started != 0) {
        argv_line[o] = 0
    }
    argv_vec[count] = 0
    argc_out[0] = count
    argv_out[0] = &argv_vec[0]
}
