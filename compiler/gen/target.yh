module gen
import support

// ============================================================================
// target.yh —— 结构体/联合体布局（过渡）
//
// 目标身份、TargetCfg、tg_* 查询与 ABI 常量已迁 support；本文件只保留
// tg_layout_struct，因为它直接读 TaskCtx 的类型/字段表。GEN2 起语义归 check
// 后，布局函数随类型表迁 check。
// ============================================================================

// tg_layout_struct：计算一个 struct/union 的字段布局。
// fields 是已登记的字段（type_id 已填），填写 offset 并把结果写入
// g_state.task.c_layout_size / g_state.task.c_layout_align（模型约定：多值返回走专用全局出参）。
// 规则：字段对齐 = 标量对齐 / 聚合对齐（递归查类型表）；
// union 所有字段 offset 为 0；struct 大小向上取整到自身对齐。
fn tg_layout_struct(first int, n int, is_union int) int {
    let off int = 0
    let maxal int = 1
    let maxsz int = 0
    let i int = 0
    for i < n {
        let ftid int = support.ms().fields[first + i].type_id
        let fsz int = support.ms().types[ftid].size
        let fal int = support.ms().types[ftid].align
        if (fal > maxal) {
            maxal = fal
        }
        if (is_union != 0) {
            support.ms().fields[first + i].offset = 0
        } else {
            // 向上取整到字段对齐
            let pad int = (0 - off) % fal
            if (pad < 0) {
                pad += fal
            }
            off += pad
            support.ms().fields[first + i].offset = off
            off += fsz
        }
        if (fsz > maxsz) {
            maxsz = fsz
        }
        i += 1
    }
    let size int = 0
    if (is_union != 0) {
        size = maxsz
    } else {
        size = off
    }
    // 结构体大小向上取整到自身对齐
    let rpad int = (0 - size) % maxal
    if (rpad < 0) {
        rpad += maxal
    }
    size += rpad
    g_state.task.c_layout_size = size
    g_state.task.c_layout_align = maxal
    return 0
}
