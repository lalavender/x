module gen

// ============================================================================
// target.yh —— 目标数据模型（多平台接入缝之一）
//
// 多平台架构（docs/03-design/yh-自举后端架构.md）把后端拆成三层：
//
//   前端语义 symbols.yh（平台无关）
//        │  只引用本文件的常量/布局函数，以及 emit 层的「抽象机原语」
//        ▼
//   目标数据模型 target.yh（本文件：字长/对齐/布局规则）
//        │  换平台第一步：提供新目标的数据模型
//        ▼
//   指令发射 emit_<isa>.yh（每目标一个文件：寄存器、栈帧、ABI、指令）
//
// 换目标平台需要提供的东西（契约）：
//   1. 数据模型：TG_* 常量 + tg_align_scalar/tg_layout_struct（本文件）；
//   2. 指令发射：emit_<isa>.yh 实现 symbols.yh 调用的全部 em_* 原语
//      （原语清单见 emit_arm64.yh 文件头）；
//   3. 段/符号/重定位方言与驱动汇编器的调用方式（构建脚本侧）。
// 当前目标：AArch64 Linux（GNU 汇编方言，LP64，小端）。
// ============================================================================

// —— 标量数据模型（字节） ——
const TG_PTR_SIZE int = 8      // 指针 8 字节（LP64）
const TG_INT_SIZE int = 4      // yh 的 int / i32 = 4 字节（默认整数类型）
const TG_CHAR_SIZE int = 1     // char / bool / i8 / u8 = 1 字节
const TG_SHORT_SIZE int = 2    // i16 / u16
pub const TG_LONG_SIZE int = 8     // i64 / u64
pub const TG_ENUM_SIZE int = 4     // enum 底层为 4 字节有符号整数

// —— 栈与调用约定（前端在几处需要知道的量化约束） ——
const TG_STACK_ALIGN int = 16  // sp 在调用点必须 16 字节对齐
const TG_ARG_REGS int = 8      // 整型/指针参数的寄存器个数（x0..x7）
const TG_VALUE_SLOT int = 16   // 值栈一个槽的字节数（保持 sp 对齐）

// —— 汇编方言（段/符号/取址写法的差异，AArch64 指令本身相同） ——
//
// 同一台 AArch64 上的两大方言：
//   GNU/Linux（as + gcc）：符号无前缀，取址写 `adrp/add :lo12:`，
//                           链接 libc 符号可直接 `adrp/add`（静态链接）。
//   Darwin（as + clang）： C 符号统一加 `_` 前缀，取址写
//                           `adrp/add @PAGE/@PAGEOFF`；自定义段/外部符号
//                           必须走 GOT：`adrp/ldr @GOTPAGE/@GOTPAGEOFF`。
// 由驱动按 -target 选择；指令发射器只查询下面的 tg_dialect_* 判定，
// 不硬编码方言字符串。
pub const TG_DIALECT_GNU int = 0     // AArch64 GNU/Linux（默认）
pub const TG_DIALECT_DARWIN int = 1  // AArch64 Darwin/Mach-O

// gen.cfg().dialect：当前汇编方言（由驱动在启动时设置）。放在模型层供发射器查询。

// tg_darwin：是否 Darwin 方言（符号加 `_`、取址用 @PAGE、外部走 GOT）。
pub fn tg_darwin() int {
    return (cfg().dialect == TG_DIALECT_DARWIN).to_type(int)
}

// target_arch_token：接口头行里的架构标记，与 project.arch 的写法一致。
// 头行架构必须随目标变化：此前两处写入端把它硬编码成 arm64，一旦接入
// x64 目标，头行会"说谎"，读取端又只比对字面量，等于失去目标校验。
pub fn target_arch_token() *char {
    if (cfg().target.arch == TARGET_ARCH_X64) {
        return "x64"
    }
    return "arm64"
}

// tg_host_darwin：**宿主**平台探测（进程实际运行的操作系统）——macOS 独有的
// 系统 plist（Linux 无此路径）。与 tg_darwin（输出目标方言）区分：
// open 旗标、目录类宿主文件操作按**宿主内核**语义取值，交叉目标
// （-target darwin）不得改变宿主文件操作（Linux 内核不认 Darwin 的
// O_CREAT 位值，0x601 在 Linux 上是 O_APPEND 组合）。
pub fn tg_host_darwin() int {
    let fd int = open("/System/Library/CoreServices/SystemVersion.plist", 0)
    if (fd >= 0) {
        close(fd)
        return 1
    }
    return 0
}

// tg_sym_prefix：符号汇编名前缀（Darwin 为 "_"，GNU 为空串）。
fn tg_sym_prefix() *char {
    if (cfg().dialect == TG_DIALECT_DARWIN) {
        return "_"
    }
    return ""
}

// —— 判型辅助（平台无关的位型事实，由数据模型推导） ——
// tg_is_2byte：2 字节标量。
fn tg_is_2byte(size int) int {
    return (size == TG_SHORT_SIZE).to_type(int)
}

// tg_is_8byte：8 字节标量（指针一律 8 字节）。
fn tg_is_8byte(size int) int {
    return (size == TG_LONG_SIZE).to_type(int)
}

// tg_align_scalar：标量对齐 = 大小（AArch64 基本类型规则）。
fn tg_align_scalar(size int) int {
    return size
}

// tg_layout_struct：计算一个 struct/union 的字段布局。
// fields 是已登记的字段（type_id 已填），填写 offset 并把结果写入
// g_state.task.c_layout_size / g_state.task.c_layout_align（模型约定：多值返回走专用全局出参）。
// 规则：字段对齐 = 标量对齐 / 聚合对齐（递归查类型表）；
// union 所有字段 offset 为 0；struct 大小向上取整到自身对齐。
fn tg_layout_struct(first int, n int, is_union int) int {
    let off int = 0
    let maxal int = 1
    let maxsz int = 0
    let i int = 0
    for i < n {
        let ftid int = g_state.task.t_fields[first + i].type_id
        let fsz int = g_state.task.t_types[ftid].size
        let fal int = g_state.task.t_types[ftid].align
        if (fal > maxal) {
            maxal = fal
        }
        if (is_union != 0) {
            g_state.task.t_fields[first + i].offset = 0
        } else {
            // 向上取整到字段对齐
            let pad int = (0 - off) % fal
            if (pad < 0) {
                pad += fal
            }
            off += pad
            g_state.task.t_fields[first + i].offset = off
            off += fsz
        }
        if (fsz > maxsz) {
            maxsz = fsz
        }
        i += 1
    }
    let size int = 0
    if (is_union != 0) {
        size = maxsz
    } else {
        size = off
    }
    // 结构体大小向上取整到自身对齐
    let rpad int = (0 - size) % maxal
    if (rpad < 0) {
        rpad += maxal
    }
    size += rpad
    g_state.task.c_layout_size = size
    g_state.task.c_layout_align = maxal
    return 0
}
