module gen;

// ============================================================================
// sem_expr.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_push_value(r *Res) int {
    if (g_state.c_compile == 0 || g_state.c_fold != 0) {
        return 0;
    }
    if (ty_is_float(r.type_id) != 0) {
        return em_push_fp(r.type_id);
    }
    return em_push();
}

// sem_fold_norm：把常量按目标整数类型截断，并对有符号值做符号扩展。
pub fn sem_fold_norm(tid int, value i64) i64 {
    let bits int = g_state.t_types[tid].size * 8;
    if (bits >= 64) { return value; }
    let mask u64 = (1.to_type(u64) << bits) - 1.to_type(u64);
    let raw u64 = value.to_type(u64) & mask;
    if (ty_is_signed(tid) != 0) {
        let sign u64 = 1.to_type(u64) << (bits - 1);
        if ((raw & sign) != 0) { return (raw | ~mask).to_type(i64); }
    }
    return raw.to_type(i64);
}

// sem_fold_float_convert：常量浮点转换（整数↔浮点、浮点↔浮点），结果写位模式。
// ponytail: 无符号整数目标按有符号截断，避免生成冻结子集之外的 fcvtzu；
// 需要超出 i64 范围的 u64 浮点常量时再扩汇编器子集。
fn sem_fold_float_convert(src_tid int, dst_tid int, bits i64) i64 {
    let src_fp int = ty_is_float(src_tid);
    let dst_fp int = ty_is_float(dst_tid);
    if (src_fp != 0) {
        let source f64 = fp64_from_bits(bits);
        if (dst_fp != 0) { return fp64_norm_bits(dst_tid, source); }
        return sem_fold_norm(dst_tid, source.to_type(i64));
    }
    if (dst_fp == 0) { return bits; }
    let widened f64 = 0.0;
    if (ty_is_signed(src_tid) != 0) {
        widened = bits.to_type(f64);
    } else {
        widened = bits.to_type(u64).to_type(f64);
    }
    return fp64_norm_bits(dst_tid, widened);
}

// sem_fold_float_binop：常量浮点算术与比较；值为 IEEE754 位模式，
// 算术结果按目标类型窄化，比较结果写 0/1。
fn sem_fold_float_binop(op int, tid int, left i64, right i64, result *i64) int {
    let a f64 = fp64_from_bits(left);
    let b f64 = fp64_from_bits(right);
    if (op == TK_EQEQ) { *result = (a == b).to_type(i64); return 0; }
    if (op == TK_NEQ) { *result = (a != b).to_type(i64); return 0; }
    if (op == TK_LT) { *result = (a < b).to_type(i64); return 0; }
    if (op == TK_LEQ) { *result = (a <= b).to_type(i64); return 0; }
    if (op == TK_GT) { *result = (a > b).to_type(i64); return 0; }
    if (op == TK_GEQ) { *result = (a >= b).to_type(i64); return 0; }
    let value f64 = 0.0;
    if (op == TK_PLUS) { value = a + b; }
    else if (op == TK_MINUS) { value = a - b; }
    else if (op == TK_STAR) { value = a * b; }
    else if (op == TK_SLASH) { value = a / b; }
    else { return sem_err("浮点不支持该运算"); }
    *result = fp64_norm_bits(tid, value);
    return 0;
}

// sem_fold_const_binop：按 yh 整数类型执行有边界的常量二元运算。
pub fn sem_fold_const_binop(op int, tid int, left i64, right i64, result *i64) int {
    if (ty_is_float(tid) != 0) {
        return sem_fold_float_binop(op, tid, left, right, result);
    }
    if (ty_is_integer(tid) == 0) { return sem_err("编译期算术运算要求整数"); }
    let bits int = g_state.t_types[tid].size * 8;
    let is_signed_ty int = ty_is_signed(tid);
    let a i64 = sem_fold_norm(tid, left);
    let b i64 = sem_fold_norm(tid, right);
    let is_cmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ).to_type(int);
    if (is_cmp != 0) {
        let yes int = 0;
        if (op == TK_EQEQ) { yes = (a == b).to_type(int); }
        else if (op == TK_NEQ) { yes = (a != b).to_type(int); }
        else if (is_signed_ty != 0 && op == TK_LT) { yes = (a < b).to_type(int); }
        else if (is_signed_ty != 0 && op == TK_LEQ) { yes = (a <= b).to_type(int); }
        else if (is_signed_ty != 0 && op == TK_GT) { yes = (a > b).to_type(int); }
        else if (is_signed_ty != 0 && op == TK_GEQ) { yes = (a >= b).to_type(int); }
        else {
            let ua u64 = a.to_type(u64);
            let ub u64 = b.to_type(u64);
            if (op == TK_LT) { yes = (ua < ub).to_type(int); }
            else if (op == TK_LEQ) { yes = (ua <= ub).to_type(int); }
            else if (op == TK_GT) { yes = (ua > ub).to_type(int); }
            else if (op == TK_GEQ) { yes = (ua >= ub).to_type(int); }
        }
        *result = yes.to_type(i64);
        return 0;
    }
    if (op == TK_LSHIFT || op == TK_RSHIFT) {
        if (right < 0 || right >= bits.to_type(i64)) {
            return sem_err("编译期移位超出位宽");
        }
        let count int = right.to_type(int);
        if (op == TK_RSHIFT) {
            if (is_signed_ty != 0) { *result = a >> count; }
            else { *result = (a.to_type(u64) >> count).to_type(i64); }
            return 0;
        }
        if (is_signed_ty != 0) {
            if (a < 0) { return sem_err("编译期整数运算溢出"); }
            let max_s i64 = 9223372036854775807;
            if (bits == 8) { max_s = 127; }
            else if (bits == 16) { max_s = 32767; }
            else if (bits == 32) { max_s = 2147483647; }
            if (a > (max_s >> count)) { return sem_err("编译期整数运算溢出"); }
            *result = a << count;
            return 0;
        }
        let max_u u64 = (-1).to_type(u64);
        if (bits == 8) { max_u = 255; }
        else if (bits == 16) { max_u = 65535; }
        else if (bits == 32) { max_u = 4294967295; }
        let ua u64 = a.to_type(u64);
        if (ua > (max_u >> count)) { return sem_err("编译期整数运算溢出"); }
        *result = sem_fold_norm(tid, (ua << count).to_type(i64));
        return 0;
    }
    if (op == TK_AMP || op == TK_PIPE || op == TK_CARET) {
        *result = sem_fold_norm(tid, fold_binop(op, a, b));
        return 0;
    }
    if (is_signed_ty != 0) {
        let max_s i64 = 9223372036854775807;
        if (bits == 8) { max_s = 127; }
        else if (bits == 16) { max_s = 32767; }
        else if (bits == 32) { max_s = 2147483647; }
        let min_s i64 = 0 - max_s - 1;
        if (op == TK_PLUS) {
            if ((b > 0 && a > max_s - b) || (b < 0 && a < min_s - b)) {
                return sem_err("编译期整数运算溢出");
            }
            *result = a + b;
        } else if (op == TK_MINUS) {
            if ((b < 0 && a > max_s + b) || (b > 0 && a < min_s + b)) {
                return sem_err("编译期整数运算溢出");
            }
            *result = a - b;
        } else if (op == TK_STAR) {
            if (a > 0 && ((b > 0 && a > max_s / b) || (b < 0 && b < min_s / a))) {
                return sem_err("编译期整数运算溢出");
            }
            if (a < 0 && ((b > 0 && a < min_s / b) || (b < 0 && a < max_s / b))) {
                return sem_err("编译期整数运算溢出");
            }
            *result = a * b;
        } else if (op == TK_SLASH || op == TK_PERCENT) {
            if (b == 0) { return sem_err("编译期除数不能为零"); }
            if (a == min_s && b == -1) { return sem_err("编译期整数运算溢出"); }
            if (op == TK_SLASH) { *result = a / b; }
            else { *result = a % b; }
        } else {
            return sem_err("编译期不支持该整数运算");
        }
        return 0;
    }
    let max_u u64 = (-1).to_type(u64);
    if (bits == 8) { max_u = 255; }
    else if (bits == 16) { max_u = 65535; }
    else if (bits == 32) { max_u = 4294967295; }
    let ua u64 = a.to_type(u64);
    let ub u64 = b.to_type(u64);
    if (op == TK_PLUS) {
        if (ua > max_u - ub) { return sem_err("编译期整数运算溢出"); }
        *result = sem_fold_norm(tid, (ua + ub).to_type(i64));
    } else if (op == TK_MINUS) {
        if (ua < ub) { return sem_err("编译期整数运算溢出"); }
        *result = sem_fold_norm(tid, (ua - ub).to_type(i64));
    } else if (op == TK_STAR) {
        if (ub != 0 && ua > max_u / ub) { return sem_err("编译期整数运算溢出"); }
        *result = sem_fold_norm(tid, (ua * ub).to_type(i64));
    } else if (op == TK_SLASH || op == TK_PERCENT) {
        if (ub == 0) { return sem_err("编译期除数不能为零"); }
        if (op == TK_SLASH) { *result = (ua / ub).to_type(i64); }
        else { *result = (ua % ub).to_type(i64); }
    } else {
        return sem_err("编译期不支持该整数运算");
    }
    return 0;
}

// sem_fold_const_unary：按目标类型执行常量一元运算，并允许最小值的直接负数字面量。
// 浮点取负走符号位翻转，避免生成冻结子集之外的 fneg。
pub fn sem_fold_const_unary(op int, tid int, value i64, is_lit int, result *i64) int {
    if (ty_is_float(tid) != 0) {
        if (op == TK_MINUS) {
            *result = value ^ (1.to_type(i64) << 63);
            return 0;
        }
        if (op == TK_PLUS) { *result = value; return 0; }
        return sem_err("浮点只支持一元 +/-");
    }
    if (ty_is_integer(tid) == 0) { return sem_err("编译期一元运算要求整数"); }
    let bits int = g_state.t_types[tid].size * 8;
    let is_signed_ty int = ty_is_signed(tid);
    let a i64 = sem_fold_norm(tid, value);
    if (op == TK_MINUS) {
        if (is_signed_ty != 0) {
            let max_s i64 = 9223372036854775807;
            if (bits == 8) { max_s = 127; }
            else if (bits == 16) { max_s = 32767; }
            else if (bits == 32) { max_s = 2147483647; }
            let min_s i64 = 0 - max_s - 1;
            if (a == min_s) {
                if (is_lit != 0 && bits < 64 && value == max_s + 1) {
                    *result = min_s;
                    return 0;
                }
                return sem_err("编译期整数运算溢出");
            }
            *result = 0 - a;
            return 0;
        }
        if (a != 0) { return sem_err("编译期整数运算溢出"); }
        *result = 0;
        return 0;
    }
    if (op == TK_PLUS) { *result = a; return 0; }
    if (op == TK_TILDE) { *result = sem_fold_norm(tid, ~a); return 0; }
    if (op == TK_BANG) { *result = (a == 0).to_type(i64); return 0; }
    *result = a;
    return 0;
}

pub fn sem_binop(op int, lhs *Res, rhs *Res) int {
    let tid int = 0;
    if (g_state.c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    // 运算数检查
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        // 指针只参与 ==/!=（与 0 或同型）
        if (g_state.t_types[lhs.type_id].kind == TY_PTR || g_state.t_types[rhs.type_id].kind == TY_PTR) {
            if (op != TK_EQEQ && op != TK_NEQ) {
                return sem_err("指针只支持 == / != 比较");
            }
            let ok int = 0;
            if (lhs.type_id == rhs.type_id) { ok = 1; }
            if (g_state.t_types[lhs.type_id].elem == TY_VOID) { ok = 1; }
            if (g_state.t_types[rhs.type_id].elem == TY_VOID) { ok = 1; }
            if (rhs.is_lit != 0 && rhs.is_const != 0 && rhs.ival == 0) { ok = 1; }
            if (lhs.is_lit != 0 && lhs.is_const != 0 && lhs.ival == 0) { ok = 1; }
            if (ok == 0) {
                return sem_err("指针比较类型不匹配");
            }
            sem_res_const(lhs, TY_BOOL, 0);
            if (g_state.c_fold == 0) {
                if (em_pop("x9") != 0) { return -1; }
                if (em_compare(op, TY_I64) != 0) { return -1; }
            }
            g_state.c_res_is_addr = 0;
            return 0;
        }
    }
    // 字面量适配：一侧是字面量时借用另一侧类型
    if (rhs.is_lit != 0 && ty_is_scalar(lhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(lhs.type_id, rhs.ival) != 0) {
            rhs.type_id = lhs.type_id;
        }
    }
    if (lhs.is_lit != 0 && ty_is_scalar(rhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(rhs.type_id, lhs.ival) != 0) {
            lhs.type_id = rhs.type_id;
        }
    }
    // 指针算术：p + i / p - i（按元素大小缩放下标）；指针比较另走分支
    let lk int = g_state.t_types[lhs.type_id].kind;
    let rk int = g_state.t_types[rhs.type_id].kind;
    if ((lk == TY_PTR && rk == TY_PTR) || lk == TY_ARRAY || rk == TY_ARRAY) {
        return sem_err("指针/数组不参与该运算");
    }
    if (lk == TY_PTR && ty_is_integer(rhs.type_id) != 0) {
        if (op == TK_PLUS || op == TK_MINUS) {
            if (g_state.c_fold != 0) {
                return sem_err("指针运算不是编译期常量");
            }
            if (em_pop("x9") != 0) { return -1; }
            if (em_scale_index(g_state.t_types[lhs.type_id].elem) != 0) { return -1; }
            if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
            g_state.c_res_is_addr = 1;   // 结果是地址（可再解引用/下标）
            return 0;
        }
        return sem_err("指针只支持 + / - 整数");
    }
    if (rk == TY_PTR && ty_is_integer(lhs.type_id) != 0 && op == TK_PLUS) {
        if (g_state.c_fold != 0) {
            return sem_err("指针运算不是编译期常量");
        }
        if (em_pop("x9") != 0) { return -1; }
        // x9 = 整数，x0 = 指针：交换后缩放
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (em_ins("mov\tx0, x9") != 0) { return -1; }
        if (em_ins("mov\tx9, x10") != 0) { return -1; }
        if (em_scale_index(g_state.t_types[rhs.type_id].elem) != 0) { return -1; }
        if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
        // 结果类型取指针一侧（此前漏设会让 `i + p` 被当成整数）
        lhs.type_id = rhs.type_id;
        g_state.c_res_is_addr = 1;
        return 0;
    }
    tid = sem_promote(lhs.type_id, rhs.type_id);
    if (ty_is_float(tid) != 0) {
        // 浮点二元/比较：折叠时直接按位模式求值，运行期左 d1、右 d0（值栈已按序压入）
        if (g_state.c_fold != 0) {
            if (lhs.is_const == 0 || rhs.is_const == 0) {
                return sem_err("这里需要编译期常量");
            }
            let value i64 = 0;
            if (sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) {
                return -1;
            }
            let fp_cmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT
                || op == TK_LEQ || op == TK_GT || op == TK_GEQ).to_type(int);
            if (fp_cmp != 0) {
                sem_res_const(lhs, TY_BOOL, value);
            } else {
                sem_res_const(lhs, tid, value);
                lhs.fval_bits = value;
            }
            return 0;
        }
        let iscmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT
                         || op == TK_LEQ || op == TK_GT || op == TK_GEQ).to_type(int);
        if (op != TK_PLUS && op != TK_MINUS && op != TK_STAR && op != TK_SLASH
            && iscmp == 0) {
            return sem_err("浮点不支持该运算");
        }
        if (iscmp != 0) {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_compare(op, tid) != 0) { return -1; }
            sem_res_const(lhs, TY_BOOL, 0);
        } else {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_binop(op, tid) != 0) { return -1; }
            sem_res_reset(lhs, tid);
        }
        lhs.is_const = 0;
        g_state.c_res_is_addr = 0;
        return 0;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持算术运算");
    }
    let is_cmp int = 0;
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        is_cmp = 1;
    }
    if (g_state.c_fold != 0) {
        if (lhs.is_const == 0 || rhs.is_const == 0) {
            return sem_err("这里需要编译期常量");
        }
        let value i64 = 0;
        if (sem_fold_const_binop(op, tid, lhs.ival, rhs.ival, &value) != 0) { return -1; }
        if (is_cmp != 0) {
            sem_res_const(lhs, TY_BOOL, value);
        } else {
            sem_res_const(lhs, tid, value);
            // 浮点常量同时保留位模式，供 const 初始化与浮点装载使用。
            if (ty_is_float(tid) != 0) { lhs.fval_bits = value; }
        }
        return 0;
    }
    if (is_cmp != 0) {
        if (em_pop("x9") != 0) { return -1; }
        if (em_compare(op, tid) != 0) { return -1; }
        sem_res_const(lhs, TY_BOOL, 0);
    } else {
        if (em_pop("x9") != 0) { return -1; }
        if (em_binop(op, tid) != 0) { return -1; }
        sem_res_reset(lhs, tid);
    }
    lhs.is_const = 0;
    g_state.c_res_is_addr = 0;
    return 0;
}

// sem_shortcircuit：检查逻辑左值；折叠时保存真值，运行时发射短路跳转。
pub fn sem_shortcircuit(op int, lhs *Res) int {
    if (g_state.c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (g_state.c_fold != 0) {
        if (ty_is_scalar(lhs.type_id) == 0 || ty_is_float(lhs.type_id) != 0) {
            return sem_err("逻辑运算要求非浮点标量");
        }
        if (lhs.is_const == 0) {
            return sem_err("逻辑运算要求编译期常量");
        }
        if (g_state.sc_sc_depth >= 64) {
            return sem_err("逻辑运算嵌套超过 64 层");
        }
        g_state.sc_sc_false_stk[g_state.sc_sc_depth] = (lhs.ival != 0).to_type(int);
        g_state.sc_sc_depth += 1;
        g_state.c_res_is_addr = 0;
        return sem_res_reset(lhs, TY_BOOL);
    }
    // 保存外层短路标签（嵌套 a&&b||c&&d 时内层不破坏外层）
    g_state.sc_sc_false_stk[g_state.sc_sc_depth] = g_state.sc_lbl_false;
    g_state.sc_sc_end_stk[g_state.sc_sc_depth] = g_state.sc_lbl_end;
    g_state.sc_sc_depth += 1;
    g_state.sc_lbl_false = em_new_label();
    g_state.sc_lbl_end = em_new_label();
    if (op == TK_ANDAND) {
        if (em_jz(g_state.sc_lbl_false) != 0) { return -1; }
    } else {
        if (em_jnz(g_state.sc_lbl_false) != 0) { return -1; }
    }
    sem_res_reset(lhs, TY_BOOL);
    g_state.c_res_is_addr = 0;
    return 0;
}

// sem_shortcircuit_end：合并折叠的左右真值，或补齐运行时短路分支并恢复外层标签。
pub fn sem_shortcircuit_end(op int, lhs *Res) int {
    if (g_state.c_compile == 0) {
        return 0;
    }
    if (g_state.c_fold != 0) {
        if (ty_is_scalar(lhs.type_id) == 0 || ty_is_float(lhs.type_id) != 0) {
            return sem_err("逻辑运算要求非浮点标量");
        }
        if (lhs.is_const == 0) {
            return sem_err("逻辑运算要求编译期常量");
        }
        g_state.sc_sc_depth -= 1;
        let left int = g_state.sc_sc_false_stk[g_state.sc_sc_depth];
        let right int = (lhs.ival != 0).to_type(int);
        let value int = 0;
        if (op == TK_ANDAND) { value = (left != 0 && right != 0).to_type(int); }
        else { value = (left != 0 || right != 0).to_type(int); }
        g_state.c_res_is_addr = 0;
        return sem_res_const(lhs, TY_BOOL, value.to_type(i64));
    }
    if (op == TK_ANDAND) {
        // 左真且右真 → 结果 1
        if (em_jz(g_state.sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_jmp(g_state.sc_lbl_end) != 0) { return -1; }
        if (em_label(g_state.sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_label(g_state.sc_lbl_end) != 0) { return -1; }
    } else {
        // || ：左或右为真 → 结果 1
        if (em_jnz(g_state.sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_jmp(g_state.sc_lbl_end) != 0) { return -1; }
        if (em_label(g_state.sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_label(g_state.sc_lbl_end) != 0) { return -1; }
    }
    lhs.is_const = 0;
    g_state.c_res_is_addr = 0;
    // 恢复外层短路标签（嵌套 a&&b||c&&d：内层用完即还）
    g_state.sc_sc_depth -= 1;
    g_state.sc_lbl_false = g_state.sc_sc_false_stk[g_state.sc_sc_depth];
    g_state.sc_lbl_end = g_state.sc_sc_end_stk[g_state.sc_sc_depth];
    return 0;
}

pub fn sem_ternary_cond(lhs *Res) int {
    if (g_state.c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (g_state.c_fold != 0) {
        return sem_err("三元不支持编译期折叠");
    }
    g_state.tn_lbl_else = em_new_label();
    g_state.tn_lbl_end = em_new_label();
    if (em_jz(g_state.tn_lbl_else) != 0) { return -1; }
    return 0;
}

pub fn sem_ternary_mid(lhs *Res) int {
    if (g_state.c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_jmp(g_state.tn_lbl_end) != 0) { return -1; }
    if (em_label(g_state.tn_lbl_else) != 0) { return -1; }
    return 0;
}

pub fn sem_ternary_end(lhs *Res) int {
    if (g_state.c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_label(g_state.tn_lbl_end) != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    g_state.c_res_is_addr = 0;
    return 0;
}

pub fn sem_unary(op int, operand *Res) int {
    if (g_state.c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    if (op == TK_STAR) {
        if (g_state.t_types[operand.type_id].kind != TY_PTR) {
            return sem_err("解引用的操作数必须是指针");
        }
        if (g_state.c_lvalue == 0 && g_state.c_fold == 0) {
            // x0 = 指针值（地址）→ 装入点值
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(g_state.t_types[operand.type_id].elem) != 0) { return -1; }
        }
        g_state.c_res_is_addr = 1;
        sem_res_reset(operand, g_state.t_types[operand.type_id].elem);
        operand.is_const = 0;
        return 0;
    }
    if (op == TK_AMP) {
        if (g_state.c_res_is_addr == 0) {
            return sem_err("取地址的操作数必须是左值");
        }
        let pt int = ty_ptr(operand.type_id);
        sem_res_reset(operand, pt);
        g_state.c_res_is_addr = 1;
        return 0;
    }
    if (operand.is_const != 0) {
        // 常量（含字面量）：折叠求值并保留字面量性（如 let n i8 = -100）
        if (ty_is_float(operand.type_id) != 0) {
            let fp_value i64 = 0;
            if (sem_fold_const_unary(op, operand.type_id, operand.ival,
                    operand.is_lit, &fp_value) != 0) { return -1; }
            operand.ival = fp_value;
            operand.fval_bits = fp_value;
            if (g_state.c_fold == 0) {
                if (em_mov_imm("x0", fp_value) != 0) { return -1; }
                if (em_ins("fmov\td0, x0") != 0) { return -1; }
            }
            return 0;
        }
        if (ty_is_integer(operand.type_id) != 0) {
            let value i64 = 0;
            if (sem_fold_const_unary(op, operand.type_id, operand.ival,
                    operand.is_lit, &value) != 0) { return -1; }
            operand.ival = value;
        } else {
            operand.ival = fold_unary(op, operand.ival);
        }
        operand.type_id = TY_I32;
        if (g_state.c_fold == 0) {
            if (em_mov_imm("x0", operand.ival) != 0) {
                return -1;
            }
        }
        return 0;
    }
    let tid int = operand.type_id;
    if (ty_is_float(tid) != 0) {
        if (op == TK_MINUS) {
            if (em_fp_neg(tid) != 0) { return -1; }
            sem_res_reset(operand, tid);
            g_state.c_res_is_addr = 0;
            return 0;
        }
        if (op == TK_PLUS) {
            return 0;
        }
        return sem_err("浮点只支持一元 +/-");
    }
    if (g_state.t_types[tid].kind == TY_BOOL) {
        tid = TY_I32;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持一元运算");
    }
    if (em_unary(op, tid) != 0) { return -1; }
    sem_res_reset(operand, tid);
    g_state.c_res_is_addr = 0;
    return 0;
}

pub fn sem_index(base *Res, idx *Res) int {
    if (g_state.c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (ty_is_integer(idx.type_id) == 0) {
        return sem_err("下标必须是整数");
    }
    let bk int = g_state.t_types[base.type_id].kind;
    let elem int = 0;
    if (bk == TY_PTR) {
        elem = g_state.t_types[base.type_id].elem;
    } else if (bk == TY_ARRAY) {
        elem = g_state.t_types[base.type_id].elem;
    } else if (bk == TY_SLICE) {
        elem = g_state.t_types[base.type_id].elem;
    } else {
        return sem_err("该类型不支持下标访问");
    }
    if (g_state.c_fold != 0) {
        return sem_err("下标访问不是编译期常量");
    }
    if (em_pop("x9") != 0) { return -1; }
    // lvalue 模式下指针变量的基址是「变量的地址」——先装入指针值
    if (bk == TY_PTR && g_state.c_lvalue != 0) {
        if (em_ins("mov\tx10, x9") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
    }
    // 切片：基址是切片数据指针（槽内偏移 8），需先取 data 字段
    if (bk == TY_SLICE) {
        if (em_ins("add\tx9, x9, #8") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x9]") != 0) { return -1; }
    }
    // 地址 = 基址(x9) + 下标(x0) * 元素大小
    let esz int = g_state.t_types[elem].size;
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        // 任意大小的聚合元素（如 20 字节的 Tok）：乘法缩放
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
    let ek int = g_state.t_types[elem].kind;
    if (ek == TY_STRUCT || ek == TY_UNION || ek == TY_ARRAY || ek == TY_SLICE) {
        // 聚合元素：保留地址语义（成员/下标链后续再加偏移）
        g_state.c_res_is_addr = 1;
    } else if (g_state.c_lvalue == 0) {
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (ty_is_float(elem) != 0) {
            // 浮点元素：装入浮点寄存器
            let fsfx *char = "d";
            if (g_state.t_types[elem].size == 4) { fsfx = "s"; }
            if (em_frag("\tldr\t") != 0) { return -1; }
            if (em_frag(fsfx) != 0) { return -1; }
            if (em_frag("0, [x10]\n") != 0) { return -1; }
        } else {
            if (em_load_sized(elem) != 0) { return -1; }
        }
        g_state.c_res_is_addr = 0;
    } else {
        g_state.c_res_is_addr = 1;
    }
    sem_res_reset(base, elem);
    return 0;
}

pub fn sem_slice(base *Res, sres *Res, eres *Res) int {
    if (g_state.c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (g_state.c_fold != 0) {
        return sem_err("切片表达式不是编译期常量");
    }
    let bk int = g_state.t_types[base.type_id].kind;
    if (bk != TY_ARRAY && bk != TY_SLICE) {
        return sem_err("切片表达式需要数组或切片");
    }
    if (ty_is_integer(sres.type_id) == 0 || ty_is_integer(eres.type_id) == 0) {
        return sem_err("切片下标必须是整数");
    }
    let elem int = g_state.t_types[base.type_id].elem;
    let esz int = g_state.t_types[elem].size;
    // x0 = end → x11 暂存；弹 start → x0；弹 base → x10
    if (em_ins("mov\tx11, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_pop("x10") != 0) { return -1; }
    // 切片基址取 data 字段（{len, data} 的偏移 8）
    if (bk == TY_SLICE) {
        if (em_ins("add\tx10, x10, #8") != 0) { return -1; }
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
    }
    // x9 = max(0, end - start)
    if (em_ins("sub\tx9, x11, x0") != 0) { return -1; }
    let l_pos int = em_new_label();
    if (em_frag("\tcmp\tx9, xzr\n\tb.gt\t") != 0) { return -1; }
    if (em_put_lbl(l_pos) != 0) { return -1; }
    if (em_frag("\n\tmov\tx9, xzr\n") != 0) { return -1; }
    if (em_label(l_pos) != 0) { return -1; }
    // x0 = start * 元素大小
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    // x0 = 数据指针 = 基址 + start*esz
    if (em_ins("add\tx0, x10, x0") != 0) { return -1; }
    // 构造 {len, data} 临时切片
    let soff int = em_alloc_local(TG_LONG_SIZE * 2);
    if (em_lea_local_to(soff) != 0) { return -1; }
    if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
    if (em_lea_local_down(soff) != 0) { return -1; }
    base.type_id = ty_slice(elem);
    base.is_lit = 0;
    base.is_const = 0;
    g_state.c_res_is_addr = 1;
    return 0;
}

pub fn sem_member(base *Res, name_start int, name_len int) int {
    if (g_state.c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    // 基底求值后的 x0 形态（进入本函数时 c_res_is_addr 尚未被改写）：
    // 1 = x0 是「存放基底的变量的地址」（如指针变量的 lvalue 引用、
    //     解引用未装载的 *p），指针基底需先 ldr 装入结构地址；
    // 0 = x0 已是基底值本身（函数调用返回的指针、RVALUE 已装载的变量），
    //     不得再间接一次——否则多解一层，字段访问落在野地址上。
    // 枚举基底：`EnumName.member` 里枚举类型名在模块模式下会被求值成枚举值
    //（类型名登记成常量符号，形态随 pass 变化），此时按成员名查符号表取成员常量。
    if (base.type_id >= 0 && g_state.t_types[base.type_id].kind == TY_ENUM) {
        let msym int = sym_lookup(name_start, name_len);
        if (msym < 0) {
            // 名字表里查不到时按名字反查枚举成员表（登记时快照名字与值，不经过符号表）：
            // 模块 worker 二次解析编译期正文时枚举成员符号不可见（实测）。
            let eidx int = em_find(name_start, name_len);
            if (eidx >= 0 && em_get_ready(eidx) != 0) {
                let evalue i64 = em_get_val(eidx);
                sem_res_const(base, base.type_id, evalue);
                if (g_state.c_compile != 0 && g_state.c_fold == 0
                    && em_mov_imm("x0", evalue) != 0) { return -1; }
                return 0;
            }
        }

        // 不校验成员符号的 type_id：模块模式下枚举成员登记时的类型上下文与基底
        // 枚举类型 id 不总一致；枚举成员注册在全局名字表里，同名成员本就不能共存。
        if (msym < 0 || (g_state.c_syms[msym].flags & F_ENUM_MEMBER) == 0) {
            // 模块模式：枚举类型名会被求值成枚举值，而此时成员符号在当前编译单元的
            // 名字表里已经查不到（实测），因此这里只能给出可操作的诊断。同模块顶层
            // 常量引用同一成员是正常的，推荐用常量中转。
            if (g_state.c_module_mode != 0) {
                return sem_err("模块模式下编译期正文里直接引用枚举成员暂不支持；请在同模块顶层用 `pub const X int = 枚举名.成员;` 中转后再引用");
            }
            return sem_err("枚举没有这个成员");
        }
        if (g_state.c_syms[msym].const_ready == 0) {
            return sem_err("编译期常量尚未就绪");
        }
        let value i64 = g_state.c_syms[msym].cval;
        sem_res_const(base, base.type_id, value);
        if (g_state.c_compile != 0 && g_state.c_fold == 0
            && em_mov_imm("x0", value) != 0) { return -1; }
        return 0;
    }
    let base_indirect int = g_state.c_res_is_addr;
    let bk int = g_state.t_types[base.type_id].kind;
    let stid int = 0;
    if (bk == TY_PTR) {
        stid = g_state.t_types[base.type_id].elem;
        if (g_state.t_types[stid].kind != TY_STRUCT && g_state.t_types[stid].kind != TY_UNION) {
            return sem_err("『.』的左侧不是结构体或结构体指针");
        }
    } else if (bk == TY_STRUCT || bk == TY_UNION) {
        stid = base.type_id;
    } else {
        return sem_err("『.』的左侧不是结构体或结构体指针");
    }
    if (ty_is_opaque(stid) != 0) {
        return sem_err("不透明 C 类型没有可访问字段");
    }
    // 字段查找
    let st int = g_state.t_types[stid].sub;
    let nf int = g_state.t_types[stid].len;
    let found int = -1;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (g_state.t_fields[f].name_len == name_len) {
            let match int = 1;
            let j int = 0;
            for j < name_len {
                if (g_state.np_data[g_state.t_fields[f].name_off + j] != g_state.c_src[name_start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = f;
                break;
            }
        }
        i += 1;
    }
    if (found < 0) {
        return sem_err("结构体没有该字段");
    }
    // pub struct 一等化：字段一律公开，跨模块访问不再有字段级限制
    // （类型的跨模块可见性仍由类型自身的 pub 决定）。
    if (g_state.c_fold != 0) {
        return sem_err("字段访问不是编译期常量");
    }
    let off int = g_state.t_fields[found].offset;
    if (bk == TY_PTR) {
        if (g_state.c_lvalue != 0 && base_indirect != 0) {
            // x0 = 指针变量的地址 → 装入指针值
            if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        }
        // x0 = 结构体地址；加字段偏移
    }
    if (off > 0) {
        if (off <= 4095) {
            if (em_frag("\tadd\tx0, x0, #") != 0) { return -1; }
            if (em_puti(off) != 0) { return -1; }
            if (em_frag("\n") != 0) { return -1; }
        } else {
            // 深结构体的字段偏移超出 add 的 12 位无符号立即数范围，借 x12 装偏移
            // （与 em_lea_local* 的深帧约定一致：调用方不依赖 x12 跨 lea 存活）。
            if (em_mov_imm("x12", off.to_type(i64)) != 0) { return -1; }
            if (em_ins("add\tx0, x0, x12") != 0) { return -1; }
        }
    }
    let ftid int = g_state.t_fields[found].type_id;
    if (g_state.c_lvalue == 0) {
        let fk int = g_state.t_types[ftid].kind;
        if (fk != TY_STRUCT && fk != TY_UNION && fk != TY_ARRAY && fk != TY_SLICE) {
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(ftid) != 0) { return -1; }
            g_state.c_res_is_addr = 0;
        } else {
            // 聚合字段：保持地址语义
            g_state.c_res_is_addr = 1;
        }
    } else {
        g_state.c_res_is_addr = 1;
    }
    sem_res_reset(base, ftid);
    return 0;
}

pub fn sem_sizeof(tid int, r *Res) int {
    sem_res_reset(r, TY_I32);
    if (g_state.c_compile == 0) {
        return 0;
    }
    if (ty_is_opaque(tid) != 0) {
        return sem_err("不透明 C 类型不能用于 sizeof");
    }
    if (g_state.t_types[tid].size < 0) {
        // typed CT 函数先保存 sizeof 的目标类型，等布局调度器完成依赖后再执行。
        if (g_state.c_ast_capture != 0 && g_state.c_pass == 2) {
            r.layout_type_id = tid;
            return 0;
        }
        return sem_err("sizeof 的类型布局尚未就绪");
    }
    r.is_const = 1;
    r.is_lit = 0;
    r.ival = g_state.t_types[tid].size.to_type(i64);
    if (g_state.c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn sem_len(r *Res) int {
    if (g_state.c_compile == 0) {
        r.type_id = 0;
        return 0;
    }
    let k int = g_state.t_types[r.type_id].kind;
    if (k == TY_ARRAY) {
        // 编译期折叠为常量并直接装 x0（同 sem_sizeof：折叠出的常量由
        // 这里物化，消费端不负责）。必须清 g_state.c_res_is_addr——实参（数组
        // 标识符）的聚合地址语义会残留，否则 x0 里的数组地址被当成
        // 结果（曾致 return len(arr) 返回地址而非长度）。
        g_state.c_res_is_addr = 0;
        sem_res_const(r, TY_I32, g_state.t_types[r.type_id].len.to_type(i64));
        if (g_state.c_fold == 0) {
            return em_mov_imm("x0", r.ival);
        }
        return 0;
    }
    if (k == TY_SLICE) {
        if (g_state.c_fold != 0) {
            return sem_err("切片长度不是编译期常量");
        }
        // 切片值在 x0（地址）；读 [x0] 的长度
        if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        sem_res_reset(r, TY_I32);
        g_state.c_res_is_addr = 0;
        return 0;
    }
    return sem_err("len 需要一个数组或切片");
}

pub fn sem_cast(operand *Res, tid int) int {
    if (g_state.c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    let ok int = g_state.t_types[tid].kind;
    if (ok == TY_VOID) {
        return sem_err("不能转换为 void");
    }
    let sk int = g_state.t_types[operand.type_id].kind;
    if (sk == TY_FN && ok == TY_FN
        && g_state.t_sig_abi[g_state.t_types[operand.type_id].sub] != g_state.t_sig_abi[g_state.t_types[tid].sub]) {
        return sem_err("函数类型转换不能改变 C/yh 调用约定");
    }
    let scalar_to_scalar int = 0;
    if (ty_is_scalar(tid) != 0 && ty_is_scalar(operand.type_id) != 0) {
        scalar_to_scalar = 1;
    }
    // 数组 → 切片视图：构造 {len, data} 临时聚合（ADR-0002 的规范化视图）
    if (sk == TY_ARRAY && ok == TY_SLICE) {
        if (g_state.t_types[operand.type_id].elem != g_state.t_types[tid].elem) {
            return sem_err("数组元素类型与目标切片不一致");
        }
        if (g_state.c_fold != 0) {
            return sem_err("数组转切片不是编译期常量");
        }
        let arrlen int = g_state.t_types[operand.type_id].len;
        // x0 = 数组地址（数组值即地址）
        let soff int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(soff) != 0) { return -1; }
        if (em_mov_imm("x9", arrlen.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(soff) != 0) { return -1; }
        operand.type_id = tid;
        operand.is_lit = 0;
        operand.is_const = 0;
        g_state.c_res_is_addr = 1;
        return 0;
    }
    if (scalar_to_scalar == 0) {
        return sem_err("该转换不支持（标量之间或指针/整数）");
    }
    // 编译期常量转换：浮点参与的转换写位模式，整数转换按目标宽度归一。
    if (g_state.c_fold != 0 && operand.is_const != 0) {
        if (ty_is_float(operand.type_id) != 0 || ty_is_float(tid) != 0) {
            let value i64 = sem_fold_float_convert(operand.type_id, tid, operand.ival);
            operand.ival = value;
            operand.fval_bits = value;
        } else {
            operand.ival = sem_fold_norm(tid, operand.ival);
        }
        operand.type_id = tid;
        g_state.c_res_is_addr = 0;
        return 0;
    }
    if (g_state.c_fold == 0 && g_state.c_res_is_addr == 0) {
        // 运行时转换
        let from_fp int = ty_is_float(operand.type_id);
        let to_fp int = ty_is_float(tid);
        if (to_fp != 0 && from_fp == 0) {
            let src_signed int = ty_is_signed(operand.type_id);
            if (em_int_to_fp(tid, src_signed) != 0) { return -1; }
        } else if (to_fp != 0 && from_fp != 0) {
            // 浮点宽度转换：f32<->f64（d0/s0 互转）
            if (g_state.t_types[operand.type_id].size != g_state.t_types[tid].size) {
                if (g_state.t_types[tid].size == 4) {
                    if (em_ins("fcvt\ts0, d0") != 0) { return -1; }
                } else {
                    if (em_ins("fcvt\td0, s0") != 0) { return -1; }
                }
            }
        } else if (to_fp == 0 && from_fp != 0) {
            let dst_signed int = ty_is_signed(tid);
            if (em_fp_to_int(operand.type_id, dst_signed) != 0) { return -1; }
        } else if (g_state.t_types[operand.type_id].size != g_state.t_types[tid].size
                   || ty_is_signed(operand.type_id) != ty_is_signed(tid)) {
            // 整数 → 整数：x0 中按源类型已扩展，需按目标宽度/符号性重新扩展。
            // 例如 i64 → int 必须截断到低 32 位并符号扩展，否则比较/运算会用
            // 到高位的残留值（曾导致 i64 的 int 视图比较结果错误）。
            let tsz int = g_state.t_types[tid].size;
            if (ty_is_signed(tid) != 0) {
                if (tsz == 4) {
                    if (em_ins("sxtw\tx0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("sxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("sxtb\tx0, w0") != 0) { return -1; }
                }
            } else {
                if (tsz == 4) {
                    // 零扩展：写 w0 即清零高 32 位
                    if (em_ins("mov\tw0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("uxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("uxtb\tx0, w0") != 0) { return -1; }
                }
            }
        }
        // 其余整数→整数（更宽或同宽同符号）已在 x0 中正确扩展，无需发码。
    }
    operand.type_id = tid;
    operand.is_lit = 0;
    g_state.c_res_is_addr = 0;
    return 0;
}
