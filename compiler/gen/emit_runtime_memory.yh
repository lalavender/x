module gen;

// emit_runtime_memory.yh：把基础字节/字符串运行时入口发射到当前目标对象。
// 符号由项目模块后缀隔离，所以多对象链接时不会互相定义同一入口。

// em_emit_runtime_memory_stub：为 memcpy/strlen 发射本地 AArch64 ABI 入口。
// memcpy 对齐无要求，优先用 32/16/8 字节块，剩余字节逐个复制；strlen
// 先扫描至对齐边界，再按机器字查零并回退逐字节确定 NUL 的准确位置。
pub fn em_emit_runtime_memory_stub(idx int) int {
    if (em_frag("\t.globl\t") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag(":\n") != 0) { return -1; }
    if ((g_state.c_syms[idx].flags & F_RUNTIME_MEMCPY) != 0) {
        let chunks int = em_new_label();
        let tail16 int = em_new_label();
        let tail8 int = em_new_label();
        let tail_bytes int = em_new_label();
        let bytes int = em_new_label();
        let done int = em_new_label();
        if (em_ins("mov\tx4, x0") != 0) { return -1; }
        if (em_ins("cmp\tx2, #32") != 0) { return -1; }
        if (em_frag("\tb.lo\t") != 0 || em_put_lbl(tail16) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(chunks) != 0) { return -1; }
        if (em_ins("ldp\tx3, x5, [x1], #16") != 0) { return -1; }
        if (em_ins("stp\tx3, x5, [x0], #16") != 0) { return -1; }
        if (em_ins("ldp\tx3, x5, [x1], #16") != 0) { return -1; }
        if (em_ins("stp\tx3, x5, [x0], #16") != 0) { return -1; }
        if (em_ins("sub\tx2, x2, #32") != 0) { return -1; }
        if (em_ins("cmp\tx2, #32") != 0) { return -1; }
        if (em_frag("\tb.hs\t") != 0 || em_put_lbl(chunks) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(tail16) != 0) { return -1; }
        if (em_ins("cmp\tx2, #16") != 0) { return -1; }
        if (em_frag("\tb.lo\t") != 0 || em_put_lbl(tail8) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("ldp\tx3, x5, [x1], #16") != 0) { return -1; }
        if (em_ins("stp\tx3, x5, [x0], #16") != 0) { return -1; }
        if (em_ins("sub\tx2, x2, #16") != 0) { return -1; }
        if (em_label(tail8) != 0) { return -1; }
        if (em_ins("cmp\tx2, #8") != 0) { return -1; }
        if (em_frag("\tb.lo\t") != 0 || em_put_lbl(tail_bytes) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("ldr\tx3, [x1], #8") != 0) { return -1; }
        if (em_ins("str\tx3, [x0], #8") != 0) { return -1; }
        if (em_ins("sub\tx2, x2, #8") != 0) { return -1; }
        if (em_label(tail_bytes) != 0) { return -1; }
        if (em_frag("\tcbz\tx2, ") != 0 || em_put_lbl(done) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(bytes) != 0) { return -1; }
        if (em_ins("ldrb\tw3, [x1], #1") != 0) { return -1; }
        if (em_ins("strb\tw3, [x0], #1") != 0) { return -1; }
        if (em_ins("subs\tx2, x2, #1") != 0) { return -1; }
        if (em_frag("\tb.ne\t") != 0 || em_put_lbl(bytes) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(done) != 0) { return -1; }
        if (em_ins("mov\tx0, x4") != 0) { return -1; }
        return em_ins("ret");
    }
    if ((g_state.c_syms[idx].flags & F_RUNTIME_STRLEN) != 0) {
        let align int = em_new_label();
        let init int = em_new_label();
        let words int = em_new_label();
        let fallback int = em_new_label();
        let bytes int = em_new_label();
        let done int = em_new_label();
        if (em_ins("mov\tx1, x0") != 0) { return -1; }
        if (em_ins("mov\tx0, #0") != 0) { return -1; }
        if (em_label(align) != 0) { return -1; }
        if (em_ins("and\tx2, x1, #7") != 0) { return -1; }
        if (em_frag("\tcbz\tx2, ") != 0 || em_put_lbl(init) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("ldrb\tw3, [x1], #1") != 0) { return -1; }
        if (em_frag("\tcbz\tw3, ") != 0 || em_put_lbl(done) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("add\tx0, x0, #1") != 0) { return -1; }
        if (em_frag("\tb\t") != 0 || em_put_lbl(align) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(init) != 0) { return -1; }
        if (em_ins("mov\tx3, #0x0101010101010101") != 0) { return -1; }
        if (em_ins("mov\tx4, #0x8080808080808080") != 0) { return -1; }
        if (em_label(words) != 0) { return -1; }
        if (em_ins("ldr\tx2, [x1], #8") != 0) { return -1; }
        if (em_ins("sub\tx5, x2, x3") != 0) { return -1; }
        if (em_ins("bic\tx5, x5, x2") != 0) { return -1; }
        if (em_ins("and\tx5, x5, x4") != 0) { return -1; }
        if (em_frag("\tcbnz\tx5, ") != 0 || em_put_lbl(fallback) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("add\tx0, x0, #8") != 0) { return -1; }
        if (em_frag("\tb\t") != 0 || em_put_lbl(words) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(fallback) != 0) { return -1; }
        if (em_ins("sub\tx1, x1, #8") != 0) { return -1; }
        if (em_ins("mov\tx5, #8") != 0) { return -1; }
        if (em_label(bytes) != 0) { return -1; }
        if (em_ins("ldrb\tw2, [x1], #1") != 0) { return -1; }
        if (em_frag("\tcbz\tw2, ") != 0 || em_put_lbl(done) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("add\tx0, x0, #1") != 0) { return -1; }
        if (em_ins("subs\tx5, x5, #1") != 0) { return -1; }
        if (em_frag("\tb.ne\t") != 0 || em_put_lbl(bytes) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_frag("\tb\t") != 0 || em_put_lbl(words) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(done) != 0) { return -1; }
        return em_ins("ret");
    }
    return fail("内部错误：未知运行时内建入口");
}

// em_emit_runtime_allocator_stub：用 mmap 与 munmap 提供 malloc/free。
// 映射起始处保存映射长度，用户指针偏移 16 字节并满足常用 ABI 对齐。
pub fn em_emit_runtime_allocator_stub(idx int) int {
    if (em_frag("\t.globl\t") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag(":\n") != 0) { return -1; }
    if ((g_state.c_syms[idx].flags & F_RUNTIME_MALLOC) != 0) {
        let failed int = em_new_label();
        let done int = em_new_label();
        if (em_ins("stp\tx19, x30, [sp, #-16]!") != 0) { return -1; }
        if (em_ins("mov\tx19, #1") != 0) { return -1; }
        if (em_ins("cmp\tx0, #0") != 0) { return -1; }
        if (em_ins("csel\tx19, x0, x19, ne") != 0) { return -1; }
        if (em_ins("adds\tx19, x19, #16") != 0) { return -1; }
        if (em_frag("\tb.cs\t") != 0 || em_put_lbl(failed) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("mov\tx0, #0") != 0) { return -1; }
        if (em_ins("mov\tx1, x19") != 0) { return -1; }
        if (em_ins("mov\tx2, #3") != 0) { return -1; }
        if (tg_darwin() != 0) {
            if (em_ins("mov\tx3, #0x1002") != 0) { return -1; }
            if (em_ins("mov\tx4, #-1") != 0) { return -1; }
            if (em_ins("mov\tx5, #0") != 0) { return -1; }
            if (em_ins("bl\t_mmap") != 0) { return -1; }
        } else {
            if (em_ins("mov\tx3, #0x22") != 0) { return -1; }
            if (em_ins("mov\tx4, #-1") != 0) { return -1; }
            if (em_ins("mov\tx5, #0") != 0) { return -1; }
            if (em_ins("mov\tx8, #222") != 0) { return -1; }
            if (em_ins("svc\t#0") != 0) { return -1; }
        }
        if (em_ins("cmp\tx0, #0") != 0) { return -1; }
        if (em_frag("\tb.lt\t") != 0 || em_put_lbl(failed) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("str\tx19, [x0]") != 0) { return -1; }
        if (em_ins("add\tx0, x0, #16") != 0) { return -1; }
        if (em_frag("\tb\t") != 0 || em_put_lbl(done) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(failed) != 0) { return -1; }
        if (em_ins("mov\tx0, #0") != 0) { return -1; }
        if (em_label(done) != 0) { return -1; }
        if (em_ins("ldp\tx19, x30, [sp], #16") != 0) { return -1; }
        return em_ins("ret");
    }
    if ((g_state.c_syms[idx].flags & F_RUNTIME_FREE) != 0) {
        let done int = em_new_label();
        if (em_ins("stp\tx19, x30, [sp, #-16]!") != 0) { return -1; }
        if (em_frag("\tcbz\tx0, ") != 0 || em_put_lbl(done) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("sub\tx19, x0, #16") != 0) { return -1; }
        if (em_ins("ldr\tx1, [x19]") != 0) { return -1; }
        if (em_ins("mov\tx0, x19") != 0) { return -1; }
        if (tg_darwin() != 0) {
            if (em_ins("bl\t_munmap") != 0) { return -1; }
        } else {
            if (em_ins("mov\tx8, #215") != 0) { return -1; }
            if (em_ins("svc\t#0") != 0) { return -1; }
        }
        if (em_label(done) != 0) { return -1; }
        if (em_ins("ldp\tx19, x30, [sp], #16") != 0) { return -1; }
        return em_ins("ret");
    }
    return fail("内部错误：未知运行时分配器入口");
}

// em_emit_runtime_printf_stub：发射不依赖 libc 的 arm64 格式化输出入口。
// 支持 %%、%d/%i/%u、%lld/%llu、%s、%c；字符串按 UTF-8 字节原样输出，
// 暂不实现宽度、精度、浮点格式和 locale。Darwin 裸变参从调用栈取，
// Linux AAPCS64 先取 x1-x7，再从入口 SP 读取溢出参数；输出经 OS write。
pub fn em_emit_runtime_printf_stub(idx int) int {
    let fmt_loop int = em_new_label();
    let parse_spec int = em_new_label();
    let trailing_percent int = em_new_label();
    let literal_percent int = em_new_label();
    let long_modifier int = em_new_label();
    let signed32 int = em_new_label();
    let unsigned32 int = em_new_label();
    let signed64 int = em_new_label();
    let unsigned64 int = em_new_label();
    let string_arg int = em_new_label();
    let string_loop int = em_new_label();
    let string_done int = em_new_label();
    let char_arg int = em_new_label();
    let unknown_spec int = em_new_label();
    let integer_signed int = em_new_label();
    let integer_digits int = em_new_label();
    let integer_digit_loop int = em_new_label();
    let integer_emit int = em_new_label();
    let integer_emit_loop int = em_new_label();
    let get_arg int = em_new_label();
    let arg_loaded int = em_new_label();
    let arg_ready int = em_new_label();
    let append_char int = em_new_label();
    let append_done int = em_new_label();
    let flush int = em_new_label();
    let flush_loop int = em_new_label();
    let flush_done int = em_new_label();
    let flush_error int = em_new_label();
    let finish int = em_new_label();
    let fail_label int = em_new_label();
    let epilogue int = em_new_label();

    if (em_frag("\t.globl\t") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0 || em_frag("\n") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0 || em_frag(":\n") != 0) { return -1; }
    // 保存被调用方寄存器，保留 256 字节输出缓冲、7 个 Linux 参数槽、
    // 32 字节十进制反转区和 flush/返回地址暂存区，栈始终 16 字节对齐。
    if (em_ins("stp\tx19, x20, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("stp\tx21, x22, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("stp\tx23, x24, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("stp\tx25, x26, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("stp\tx27, x28, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("stp\tx29, x30, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("sub\tsp, sp, #384") != 0) { return -1; }
    if (em_ins("mov\tx29, sp") != 0) { return -1; }
    if (em_ins("mov\tx19, x0") != 0) { return -1; }
    if (em_ins("mov\tx20, #0") != 0) { return -1; }
    if (em_ins("add\tx21, sp, #480") != 0) { return -1; }
    if (em_ins("add\tx22, sp, #256") != 0) { return -1; }
    if (em_ins("mov\tx23, sp") != 0) { return -1; }
    if (em_ins("mov\tx24, #0") != 0) { return -1; }
    if (em_ins("mov\tx25, #0") != 0) { return -1; }
    if (em_ins("add\tx26, sp, #320") != 0) { return -1; }
    if (tg_darwin() == 0) {
        if (em_ins("stp\tx1, x2, [x22]") != 0) { return -1; }
        if (em_ins("stp\tx3, x4, [x22, #16]") != 0) { return -1; }
        if (em_ins("stp\tx5, x6, [x22, #32]") != 0) { return -1; }
        if (em_ins("str\tx7, [x22, #48]") != 0) { return -1; }
    }

    if (em_label(fmt_loop) != 0) { return -1; }
    if (em_ins("ldrb\tw9, [x19], #1") != 0) { return -1; }
    if (em_frag("\tcbz\tw9, ") != 0 || em_put_lbl(finish) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw9, #37") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(parse_spec) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(parse_spec) != 0) { return -1; }
    if (em_ins("ldrb\tw10, [x19], #1") != 0) { return -1; }
    if (em_frag("\tcbz\tw10, ") != 0 || em_put_lbl(trailing_percent) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #37") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(literal_percent) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #100") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(signed32) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #105") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(signed32) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #117") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(unsigned32) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #115") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(string_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #99") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(char_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #108") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(long_modifier) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(unknown_spec) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(trailing_percent) != 0) { return -1; }
    if (em_ins("mov\tw9, #37") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(finish) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(literal_percent) != 0) { return -1; }
    if (em_ins("mov\tw9, #37") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(long_modifier) != 0) { return -1; }
    if (em_ins("ldrb\tw10, [x19], #1") != 0) { return -1; }
    if (em_ins("cmp\tw10, #108") != 0) { return -1; }
    if (em_frag("\tb.ne\t") != 0 || em_put_lbl(unknown_spec) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("ldrb\tw10, [x19], #1") != 0) { return -1; }
    if (em_ins("cmp\tw10, #100") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(signed64) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("cmp\tw10, #117") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(unsigned64) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(unknown_spec) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(signed32) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("sxtw\tx27, w27") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_signed) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(unsigned32) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("uxtw\tx27, w27") != 0) { return -1; }
    if (em_ins("mov\tx15, #0") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_digits) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(signed64) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_signed) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(unsigned64) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tx15, #0") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_digits) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(integer_signed) != 0) { return -1; }
    if (em_ins("mov\tx15, #0") != 0) { return -1; }
    if (em_ins("cmp\tx27, #0") != 0) { return -1; }
    if (em_frag("\tb.ge\t") != 0 || em_put_lbl(integer_digits) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tx15, #1") != 0) { return -1; }
    if (em_ins("neg\tx27, x27") != 0) { return -1; }

    if (em_label(integer_digits) != 0) { return -1; }
    if (em_ins("mov\tx11, x26") != 0) { return -1; }
    if (em_ins("add\tx11, x11, #32") != 0) { return -1; }
    if (em_ins("mov\tx14, #0") != 0) { return -1; }
    if (em_label(integer_digit_loop) != 0) { return -1; }
    if (em_ins("mov\tx9, #10") != 0) { return -1; }
    if (em_ins("udiv\tx10, x27, x9") != 0) { return -1; }
    if (em_ins("msub\tx13, x10, x9, x27") != 0) { return -1; }
    if (em_ins("add\tx13, x13, #48") != 0) { return -1; }
    if (em_ins("sub\tx11, x11, #1") != 0) { return -1; }
    if (em_ins("strb\tw13, [x11]") != 0) { return -1; }
    if (em_ins("mov\tx27, x10") != 0) { return -1; }
    if (em_ins("add\tx14, x14, #1") != 0) { return -1; }
    if (em_frag("\tcbnz\tx27, ") != 0 || em_put_lbl(integer_digit_loop) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tx27, x11") != 0) { return -1; }
    if (em_ins("mov\tx28, x14") != 0) { return -1; }
    if (em_ins("cmp\tx15, #0") != 0) { return -1; }
    if (em_frag("\tb.eq\t") != 0 || em_put_lbl(integer_emit) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tw9, #45") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(integer_emit) != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_emit_loop) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(integer_emit_loop) != 0) { return -1; }
    if (em_frag("\tcbz\tx28, ") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("ldrb\tw9, [x27], #1") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("sub\tx28, x28, #1") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(integer_emit_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(string_arg) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tcbz\tx27, ") != 0 || em_put_lbl(string_done) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(string_loop) != 0) { return -1; }
    if (em_ins("ldrb\tw9, [x27], #1") != 0) { return -1; }
    if (em_frag("\tcbz\tw9, ") != 0 || em_put_lbl(string_done) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(string_loop) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(string_done) != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(char_arg) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(get_arg) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tw9, w27") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    if (em_label(unknown_spec) != 0) { return -1; }
    if (em_ins("mov\tw27, w10") != 0) { return -1; }
    if (em_ins("mov\tw9, #37") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tw9, w27") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(append_char) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(fmt_loop) != 0
        || em_frag("\n") != 0) { return -1; }

    // 取下一个裸变参。Darwin 调用方把它们连续放在入口 SP；Linux
    // 把 x1-x7 暂存到 home area，超过七项后从入口 SP 的溢出区读取。
    if (em_label(get_arg) != 0) { return -1; }
    if (tg_darwin() != 0) {
        if (em_ins("ldr\tx27, [x21], #8") != 0) { return -1; }
    } else {
        if (em_ins("cmp\tx20, #7") != 0) { return -1; }
        if (em_frag("\tb.hs\t") != 0 || em_put_lbl(arg_loaded) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_ins("lsl\tx10, x20, #3") != 0) { return -1; }
        if (em_ins("ldr\tx27, [x22, x10]") != 0) { return -1; }
        if (em_frag("\tb\t") != 0 || em_put_lbl(arg_ready) != 0
            || em_frag("\n") != 0) { return -1; }
        if (em_label(arg_loaded) != 0) { return -1; }
        if (em_ins("sub\tx10, x20, #7") != 0) { return -1; }
        if (em_ins("lsl\tx10, x10, #3") != 0) { return -1; }
        if (em_ins("ldr\tx27, [x21, x10]") != 0) { return -1; }
    }
    if (em_label(arg_ready) != 0) { return -1; }
    if (em_ins("add\tx20, x20, #1") != 0) { return -1; }
    if (em_ins("ret") != 0) { return -1; }

    // 追加一个字节到缓冲区；满 256 字节时完整处理可能的短写。
    if (em_label(append_char) != 0) { return -1; }
    if (em_ins("strb\tw9, [x23, x24]") != 0) { return -1; }
    if (em_ins("add\tx24, x24, #1") != 0) { return -1; }
    if (em_ins("add\tx25, x25, #1") != 0) { return -1; }
    if (em_ins("cmp\tx24, #256") != 0) { return -1; }
    if (em_frag("\tb.lo\t") != 0 || em_put_lbl(append_done) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("str\tx30, [x29, #352]") != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(flush) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("ldr\tx30, [x29, #352]") != 0) { return -1; }
    if (em_frag("\tcbnz\tx0, ") != 0 || em_put_lbl(fail_label) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(append_done) != 0) { return -1; }
    if (em_ins("ret") != 0) { return -1; }

    // 把缓冲循环写到 stdout；处理 OS 短写，错误时 printf 返回 -1。
    if (em_label(flush) != 0) { return -1; }
    if (em_ins("str\tx30, [x29, #376]") != 0) { return -1; }
    if (em_frag("\tcbz\tx24, ") != 0 || em_put_lbl(flush_done) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("str\tx23, [x29, #360]") != 0) { return -1; }
    if (em_ins("str\tx24, [x29, #368]") != 0) { return -1; }
    if (em_label(flush_loop) != 0) { return -1; }
    if (em_ins("ldr\tx10, [x29, #368]") != 0) { return -1; }
    if (em_frag("\tcbz\tx10, ") != 0 || em_put_lbl(flush_done) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tx0, #1") != 0) { return -1; }
    if (em_ins("ldr\tx1, [x29, #360]") != 0) { return -1; }
    if (em_ins("mov\tx2, x10") != 0) { return -1; }
    if (tg_darwin() != 0) {
        if (em_ins("bl\t_write") != 0) { return -1; }
    } else {
        if (em_ins("mov\tx8, #64") != 0) { return -1; }
        if (em_ins("svc\t#0") != 0) { return -1; }
    }
    if (em_ins("cmp\tx0, #0") != 0) { return -1; }
    if (em_frag("\tb.le\t") != 0 || em_put_lbl(flush_error) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("ldr\tx10, [x29, #360]") != 0) { return -1; }
    if (em_ins("add\tx10, x10, x0") != 0) { return -1; }
    if (em_ins("str\tx10, [x29, #360]") != 0) { return -1; }
    if (em_ins("ldr\tx10, [x29, #368]") != 0) { return -1; }
    if (em_ins("sub\tx10, x10, x0") != 0) { return -1; }
    if (em_ins("str\tx10, [x29, #368]") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(flush_loop) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(flush_done) != 0) { return -1; }
    if (em_ins("mov\tx24, #0") != 0) { return -1; }
    if (em_ins("mov\tx0, #0") != 0) { return -1; }
    if (em_ins("ldr\tx30, [x29, #376]") != 0) { return -1; }
    if (em_ins("ret") != 0) { return -1; }
    if (em_label(flush_error) != 0) { return -1; }
    if (em_ins("mov\tx0, #-1") != 0) { return -1; }
    if (em_ins("ldr\tx30, [x29, #376]") != 0) { return -1; }
    if (em_ins("ret") != 0) { return -1; }

    if (em_label(finish) != 0) { return -1; }
    if (em_frag("\tbl\t") != 0 || em_put_lbl(flush) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_frag("\tcbnz\tx0, ") != 0 || em_put_lbl(fail_label) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_ins("mov\tx0, x25") != 0) { return -1; }
    if (em_frag("\tb\t") != 0 || em_put_lbl(epilogue) != 0
        || em_frag("\n") != 0) { return -1; }
    if (em_label(fail_label) != 0) { return -1; }
    if (em_ins("mov\tx0, #-1") != 0) { return -1; }
    if (em_label(epilogue) != 0) { return -1; }
    if (em_ins("add\tsp, sp, #384") != 0) { return -1; }
    if (em_ins("ldp\tx29, x30, [sp], #16") != 0) { return -1; }
    if (em_ins("ldp\tx27, x28, [sp], #16") != 0) { return -1; }
    if (em_ins("ldp\tx25, x26, [sp], #16") != 0) { return -1; }
    if (em_ins("ldp\tx23, x24, [sp], #16") != 0) { return -1; }
    if (em_ins("ldp\tx21, x22, [sp], #16") != 0) { return -1; }
    if (em_ins("ldp\tx19, x20, [sp], #16") != 0) { return -1; }
    return em_ins("ret");
}

// em_emit_runtime_stubs：只发射本模块实际调用或取址的自有运行时入口。
// prelude 仅登记符号与类型；延迟到所有函数完成后追加 stub，避免每个对象
// 无条件携带分配、格式化与字符串服务及其 OS 导入。
pub fn em_emit_runtime_stubs() int {
    let idx int = 0;
    for idx < g_state.c_sym_n {
        let flags int = g_state.c_syms[idx].flags;
        if ((flags & F_RUNTIME_USED) != 0) {
            if ((flags & F_RUNTIME_PRINTF) != 0) {
                if (em_emit_runtime_printf_stub(idx) != 0) { return -1; }
            } else if ((flags & (F_RUNTIME_MALLOC | F_RUNTIME_FREE)) != 0) {
                if (em_emit_runtime_allocator_stub(idx) != 0) { return -1; }
            } else if ((flags & (F_RUNTIME_MEMCPY | F_RUNTIME_STRLEN)) != 0) {
                if (em_emit_runtime_memory_stub(idx) != 0) { return -1; }
            } else {
                return fail("内部错误：未知运行时入口标记");
            }
        }
        idx += 1;
    }
    return 0;
}
