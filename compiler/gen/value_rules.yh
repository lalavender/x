module gen
import token
import support

// ============================================================================
// value_rules.yh —— 编译期值内核（F2-K2 之后 gen 只剩这一个文件）
//
// 内容：隐式转换判定 `sem_can_assign` + 两个常量折叠 `sem_fold_const_binop/
// unary`（含私有 `fold_binop`/`sem_fold_float_binop` 与诊断入口 `sem_err`）。
// 之所以留在这里而不迁 check：`comptime` 需要它们，而 `comptime → check`
// 会成环（`check → comptime` 已存在）。它们是唯一「带 token 位置诊断」的
// 纯值规则，ADR-0021 登记为「编译期值语义内核」。
//
// 纯值规则（浮点位模式、整数归一化、fp↔int 转换、sem_res_const、ty_is_*）
// 已迁 support/value_rules.yh，因为 comptime 也要用它们而不得 import gen。
// 这里只剩会发**带 token 位置诊断**的折叠函数：溢出/除零/类型不匹配要通过
// gen.sem_err 报出 `file:line:col`，必须留在拥有 token 游标的这一层。
// 明确不做：不读源码、不分配除折叠工作区以外的缓冲。
// ============================================================================




// sem_err：以当前 token 位置报错并返回 -1（= token.err_tok）。
// 值内核唯一的诊断出口；对其它模块不导出（外部一律直接用 token.err_tok）。
fn sem_err(msg *char) int {
    return token.err_tok(msg)
}

// sem_fold_float_binop：常量浮点算术与比较；值为 IEEE754 位模式，
// 算术结果按目标类型窄化，比较结果写 0/1。
fn sem_fold_float_binop(op int, tid int, left i64, right i64, result *i64) int {
    let a f64 = support.fp64_from_bits(left)
    let b f64 = support.fp64_from_bits(right)
    if (op == token.TK_EQEQ) { *result = (a == b).to_type(i64); return 0 }
    if (op == token.TK_NEQ) { *result = (a != b).to_type(i64); return 0 }
    // 初始宿主仍可能由旧种子发射 lt/le；显式有序守卫让第一代候选就遵守 NaN 契约。
    if (op == token.TK_LT) { *result = (a == a && b == b && a < b).to_type(i64); return 0 }
    if (op == token.TK_LEQ) { *result = (a == a && b == b && a <= b).to_type(i64); return 0 }
    if (op == token.TK_GT) { *result = (a > b).to_type(i64); return 0 }
    if (op == token.TK_GEQ) { *result = (a >= b).to_type(i64); return 0 }
    let value f64 = 0.0
    if (op == token.TK_PLUS) { value = a + b }
    else if (op == token.TK_MINUS) { value = a - b }
    else if (op == token.TK_STAR) { value = a * b }
    else if (op == token.TK_SLASH) { value = a / b }
    else { return sem_err("浮点不支持该运算") }
    *result = support.fp64_norm_bits(tid, value)
    return 0
}

// fold_binop：两个常量的二元运算（i64 位型；除零干净报错）。
fn fold_binop(op int, a i64, b i64) i64 {
    if (op == token.TK_PLUS) { return a + b }
    if (op == token.TK_MINUS) { return a - b }
    if (op == token.TK_STAR) { return a * b }
    if (op == token.TK_SLASH) {
        if (b == 0) {
            token.err_tok("常量除以零")
            return 0
        }
        return a / b
    }
    if (op == token.TK_PERCENT) {
        if (b == 0) {
            token.err_tok("常量模零")
            return 0
        }
        return a % b
    }
    if (op == token.TK_AMP) { return a & b }
    if (op == token.TK_PIPE) { return a | b }
    if (op == token.TK_CARET) { return a ^ b }
    if (op == token.TK_LSHIFT) { return a << b }
    if (op == token.TK_RSHIFT) { return a >> b }
    if (op == token.TK_EQEQ) { return (a == b).to_type(i64) }
    if (op == token.TK_NEQ) { return (a != b).to_type(i64) }
    if (op == token.TK_LT) { return (a < b).to_type(i64) }
    if (op == token.TK_LEQ) { return (a <= b).to_type(i64) }
    if (op == token.TK_GT) { return (a > b).to_type(i64) }
    if (op == token.TK_GEQ) { return (a >= b).to_type(i64) }
    return 0
}

// sem_fold_const_binop：按 yh 整数类型执行有边界的常量二元运算。
pub fn sem_fold_const_binop(op int, tid int, left i64, right i64, result *i64) int {
    if (support.ty_is_float(tid) != 0) {
        return sem_fold_float_binop(op, tid, left, right, result)
    }
    if (support.ty_is_integer(tid) == 0) { return sem_err("编译期算术运算要求整数") }
    let bits int = support.ms().types[tid].size * 8
    let is_signed_ty int = support.ty_is_signed(tid)
    let a i64 = support.sem_fold_norm(tid, left)
    let b i64 = support.sem_fold_norm(tid, right)
    let is_cmp int = (op == token.TK_EQEQ || op == token.TK_NEQ || op == token.TK_LT || op == token.TK_LEQ
        || op == token.TK_GT || op == token.TK_GEQ).to_type(int)
    if (is_cmp != 0) {
        let yes int = 0
        if (op == token.TK_EQEQ) { yes = (a == b).to_type(int) }
        else if (op == token.TK_NEQ) { yes = (a != b).to_type(int) }
        else if (is_signed_ty != 0 && op == token.TK_LT) { yes = (a < b).to_type(int) }
        else if (is_signed_ty != 0 && op == token.TK_LEQ) { yes = (a <= b).to_type(int) }
        else if (is_signed_ty != 0 && op == token.TK_GT) { yes = (a > b).to_type(int) }
        else if (is_signed_ty != 0 && op == token.TK_GEQ) { yes = (a >= b).to_type(int) }
        else {
            let ua u64 = a.to_type(u64)
            let ub u64 = b.to_type(u64)
            if (op == token.TK_LT) { yes = (ua < ub).to_type(int) }
            else if (op == token.TK_LEQ) { yes = (ua <= ub).to_type(int) }
            else if (op == token.TK_GT) { yes = (ua > ub).to_type(int) }
            else if (op == token.TK_GEQ) { yes = (ua >= ub).to_type(int) }
        }
        *result = yes.to_type(i64)
        return 0
    }
    if (op == token.TK_LSHIFT || op == token.TK_RSHIFT) {
        if (right < 0 || right >= bits.to_type(i64)) {
            return sem_err("编译期移位超出位宽")
        }
        let count int = right.to_type(int)
        if (op == token.TK_RSHIFT) {
            if (is_signed_ty != 0) { *result = a >> count }
            else { *result = (a.to_type(u64) >> count).to_type(i64) }
            return 0
        }
        if (is_signed_ty != 0) {
            if (a < 0) { return sem_err("编译期整数运算溢出") }
            let max_s i64 = 9223372036854775807
            if (bits == 8) { max_s = 127 }
            else if (bits == 16) { max_s = 32767 }
            else if (bits == 32) { max_s = 2147483647 }
            if (a > (max_s >> count)) { return sem_err("编译期整数运算溢出") }
            *result = a << count
            return 0
        }
        let max_u u64 = (-1).to_type(u64)
        if (bits == 8) { max_u = 255 }
        else if (bits == 16) { max_u = 65535 }
        else if (bits == 32) { max_u = 4294967295 }
        let ua u64 = a.to_type(u64)
        if (ua > (max_u >> count)) { return sem_err("编译期整数运算溢出") }
        *result = support.sem_fold_norm(tid, (ua << count).to_type(i64))
        return 0
    }
    if (op == token.TK_AMP || op == token.TK_PIPE || op == token.TK_CARET) {
        *result = support.sem_fold_norm(tid, fold_binop(op, a, b))
        return 0
    }
    if (is_signed_ty != 0) {
        let max_s i64 = 9223372036854775807
        if (bits == 8) { max_s = 127 }
        else if (bits == 16) { max_s = 32767 }
        else if (bits == 32) { max_s = 2147483647 }
        let min_s i64 = 0 - max_s - 1
        if (op == token.TK_PLUS) {
            if ((b > 0 && a > max_s - b) || (b < 0 && a < min_s - b)) {
                return sem_err("编译期整数运算溢出")
            }
            *result = a + b
        } else if (op == token.TK_MINUS) {
            if ((b < 0 && a > max_s + b) || (b > 0 && a < min_s + b)) {
                return sem_err("编译期整数运算溢出")
            }
            *result = a - b
        } else if (op == token.TK_STAR) {
            if (a > 0 && ((b > 0 && a > max_s / b) || (b < 0 && b < min_s / a))) {
                return sem_err("编译期整数运算溢出")
            }
            if (a < 0 && ((b > 0 && a < min_s / b) || (b < 0 && a < max_s / b))) {
                return sem_err("编译期整数运算溢出")
            }
            *result = a * b
        } else if (op == token.TK_SLASH || op == token.TK_PERCENT) {
            if (b == 0) { return sem_err("编译期除数不能为零") }
            if (a == min_s && b == -1) { return sem_err("编译期整数运算溢出") }
            if (op == token.TK_SLASH) { *result = a / b }
            else { *result = a % b }
        } else {
            return sem_err("编译期不支持该整数运算")
        }
        return 0
    }
    let max_u u64 = (-1).to_type(u64)
    if (bits == 8) { max_u = 255 }
    else if (bits == 16) { max_u = 65535 }
    else if (bits == 32) { max_u = 4294967295 }
    let ua u64 = a.to_type(u64)
    let ub u64 = b.to_type(u64)
    if (op == token.TK_PLUS) {
        if (ua > max_u - ub) { return sem_err("编译期整数运算溢出") }
        *result = support.sem_fold_norm(tid, (ua + ub).to_type(i64))
    } else if (op == token.TK_MINUS) {
        if (ua < ub) { return sem_err("编译期整数运算溢出") }
        *result = support.sem_fold_norm(tid, (ua - ub).to_type(i64))
    } else if (op == token.TK_STAR) {
        if (ub != 0 && ua > max_u / ub) { return sem_err("编译期整数运算溢出") }
        *result = support.sem_fold_norm(tid, (ua * ub).to_type(i64))
    } else if (op == token.TK_SLASH || op == token.TK_PERCENT) {
        if (ub == 0) { return sem_err("编译期除数不能为零") }
        if (op == token.TK_SLASH) { *result = (ua / ub).to_type(i64) }
        else { *result = (ua % ub).to_type(i64) }
    } else {
        return sem_err("编译期不支持该整数运算")
    }
    return 0
}

// sem_fold_const_unary：按目标类型执行常量一元运算，并允许最小值的直接负数字面量。
// 浮点取负走符号位翻转，避免生成冻结子集之外的 fneg。
pub fn sem_fold_const_unary(op int, tid int, value i64, is_lit int, result *i64) int {
    if (support.ty_is_float(tid) != 0) {
        if (op == token.TK_MINUS) {
            *result = value ^ (1.to_type(i64) << 63)
            return 0
        }
        if (op == token.TK_PLUS) { *result = value; return 0 }
        return sem_err("浮点只支持一元 +/-")
    }
    if (support.ty_is_integer(tid) == 0) { return sem_err("编译期一元运算要求整数") }
    let bits int = support.ms().types[tid].size * 8
    let is_signed_ty int = support.ty_is_signed(tid)
    let a i64 = support.sem_fold_norm(tid, value)
    if (op == token.TK_MINUS) {
        if (is_signed_ty != 0) {
            let max_s i64 = 9223372036854775807
            if (bits == 8) { max_s = 127 }
            else if (bits == 16) { max_s = 32767 }
            else if (bits == 32) { max_s = 2147483647 }
            let min_s i64 = 0 - max_s - 1
            if (a == min_s) {
                if (is_lit != 0 && bits < 64 && value == max_s + 1) {
                    *result = min_s
                    return 0
                }
                return sem_err("编译期整数运算溢出")
            }
            *result = 0 - a
            return 0
        }
        if (a != 0) { return sem_err("编译期整数运算溢出") }
        *result = 0
        return 0
    }
    if (op == token.TK_PLUS) { *result = a; return 0 }
    if (op == token.TK_TILDE) { *result = support.sem_fold_norm(tid, ~a); return 0 }
    if (op == token.TK_BANG) { *result = (a == 0).to_type(i64); return 0 }
    *result = a
    return 0
}

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。
pub fn sem_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    if (dst == src) {
        return 0
    }
    let dk int = support.ms().types[dst].kind
    let sk int = support.ms().types[src].kind
    // 聚合：同型已在上面通过；不同类型（含长度不同）一律拒绝
    if ((dk == support.TY_STRUCT || dk == support.TY_UNION || dk == support.TY_ARRAY || dk == support.TY_SLICE)
        && (sk == support.TY_STRUCT || sk == support.TY_UNION || sk == support.TY_ARRAY || sk == support.TY_SLICE)) {
        // 数组是结构化类型：编译期布局会为延迟长度表达式建立独立类型项，
        // 与同元素类型、同长度的既有数组项完全等价，按内容放行。
        if (dk == support.TY_ARRAY && sk == support.TY_ARRAY
            && support.ms().types[dst].elem == support.ms().types[src].elem
            && support.ms().types[dst].len == support.ms().types[src].len) {
            return 0
        }
        return sem_err("聚合类型不匹配（长度或元素类型不同）")
    }
    if (dk == support.TY_PTR) {
        // 字面量 0 = 空指针（最宽匹配，先判）
        if (is_lit != 0 && ival == 0) {
            return 0
        }
        if (sk == support.TY_PTR) {
            if (support.ms().types[dst].elem == support.TY_VOID || support.ms().types[src].elem == support.TY_VOID) {
                return 0
            }
            return sem_err("指针类型不匹配（需要 .to_type 显式转换）")
        }
        if (sk == support.TY_FN && support.ms().types[dst].elem == support.TY_VOID) {
            return 0
        }
        return sem_err("不能把非指针值赋给指针")
    }
    if (sk == support.TY_PTR) {
        return sem_err("不能把指针赋给非指针（用 .to_type）")
    }
    if (dk == support.TY_FN || sk == support.TY_FN) {
        if (dk == support.TY_FN && sk == support.TY_FN) {
            return sem_err("函数签名不匹配")
        }
        return sem_err("fn 值只能赋给同签名类型或 *void")
    }
    if (support.ty_is_float(dst) != 0 || support.ty_is_float(src) != 0) {
        if (dk == sk) {
            return 0
        }
        return sem_err("浮点与整数之间需要 .to_type 显式转换")
    }
    if (dk == support.TY_BOOL && sk != support.TY_BOOL) {
        return sem_err("整数不能隐式转为 bool（用 .to_type(bool)）")
    }
    if (sk == support.TY_BOOL && support.ty_is_integer(dst) == 0 && dk != support.TY_BOOL) {
        return sem_err("bool 不能隐式转为该类型")
    }
    if (support.ty_is_integer(dst) == 0 || support.ty_is_integer(src) == 0) {
        return sem_err("类型不匹配")
    }
    let dsz int = support.ms().types[dst].size
    let ssz int = support.ms().types[src].size
    if (is_lit != 0) {
        if (big != 0 && dk != support.TY_U64) {
            return sem_err("字面量超出目标类型可表示范围")
        }
        if (support.sem_lit_fits(dst, ival) != 0) {
            return 0
        }
        return sem_err("字面量超出目标类型可表示范围")
    }
    if (dsz > ssz) {
        return 0
    }
    if (dsz == ssz) {
        if (dk == sk) {
            return 0
        }
        if (dk == support.TY_ENUM || sk == support.TY_ENUM) {
            return 0
        }
        return sem_err("同宽整数之间需要 .to_type 显式转换")
    }
    return sem_err("不允许的隐式窄化（用 .to_type）")
}
