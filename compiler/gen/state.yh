module gen;

// ============================================================================
// state.yh —— gen 模块编译器全局状态包（pub let 废除 2026-10-02）
//
// GenState 把原先 208 个跨模块 pub let 可变全局收进单一结构体：语言规则
// 「let 不导出」后，可变状态的跨模块共享只能经指针进行。g_state 是模块
// 私有实例（BSS 零初始化），G() 返回其地址供 parse/cmd/backend 限定访问
// —— `gen.G().task.c_pos`；gen 模块内部直接写 `g_state.task.c_pos`。
// 非零初始值由 state_init() 在编译入口显式设置（原声明初始化器迁移）。
// ============================================================================

// 域分类（RS1c，2026-10-19，见 docs/02-plan/yh-R2收尾实施计划.md）：
// 每任务字段已**物理收敛**进 pub struct TaskCtx（g_state.task）——
// worker 主路径与将来线程池以 *TaskCtx 为任务私有上下文；GenState 只
// 保留进程级字段（构建配置/统计/项目索引/目标与 CLI）+ task 字段。
// 偏移变化说明：字段偏移进入机器码立即数，本步由固定点门（A==B）
// 保证自洽，不与上一代产物对比。

// GenState：编译器全局状态。字段全公开（pub struct 一等化）。
// TaskCtx：每任务（当前编译单元）的语义/发射工作状态（RS1c）。
// fork worker 下每个子进程持有一份（COW 继承）；R2c 线程化后由
// worker 线程私有持有（RS1d 改 *TaskCtx 显式传递）。
pub struct TaskCtx {

    c_src *u8; // 源文件字节（read_source 分配，进程生命期持有）
    c_src_len int; // 源字节长度
    lx_line int; // 词法扫描当前行号（1 基）
    lx_lstart int; // 当前行首字节下标（用于换算列号）
    c_toks *Tok; // token 数组首址（malloc）
    c_tok_n int; // 已存 token 数
    c_tok_cap int; // 已分配槽位数
    c_ir_reject_reason int; // 最近函数的拒绝阶段：1上下文、2签名、3绑定、4返回、5函数体、6语句表达式、7落底
    c_pos int; // 当前 token 下标（解析游标）
    c_spec int; // 推测解析深度：>0 时诊断静默且不计数
    c_ctx_block int; // 表达式块上下文：1 表示该表达式之后可能紧跟
    c_file_decls *PDecl; // 当前文件只读顶层声明索引（项目 worker）
    c_file_decl_n int; // 当前文件声明索引数量
    c_file_decl_i int; // 当前正解析声明的索引（函数签名跳过函数体用）
    c_file_indexed int; // 1 = 当前 token 表带项目扫描期声明索引
    c_errors int; // 已报告的错误数（推测解析不计入）
    c_path *char; // 当前源文件路径（借自 argv，不复制不释放）
    c_path_buf *u8; // [任务私有] worker 路径快照（堆分配倍增扩容），避免名字池扩容后诊断指针失效
    c_path_buf_cap int; // 路径快照缓冲容量；任务生命期持有不释放，进程退出统一回收
    c_ct_iface_mode int; // 1 = 正在读取 .s.ct，允许识别生成的来源映射注释
    c_ct_origin_active int; // 1 = 当前声明从 .s.ct 来源映射切换到定义源码
    c_ct_origin_line int; // 当前 CT 函数定义源码体起始行
    c_ct_origin_buf *u8; // [任务私有] .s.ct 来源映射解码路径（堆分配倍增扩容），独立于 sidecar 路径
    c_ct_origin_buf_cap int; // 来源映射路径缓冲容量；同样任务生命期持有
    c_diag_line_bias int; // err_lc/warn_lc 当前行号映射偏移
    c_compile int; // 0 = 纯语法模式（--syntax-check）；1 = 编译模式
    c_pass int; // 1 = 顶层扫描登记；2 = 函数体编译与全局初始化
    t_types *CType;
    t_type_n int;
    t_type_cap int;
    t_fields *SField;
    t_field_n int;
    t_field_cap int;
    t_sig_abi *int; // 调用约定，参与函数类型判等
    t_sig_acap int; // ABI 表容量
    c_type_abi int; // 当前解析的函数类型默认 ABI，签名结束后恢复
    t_sig_ret *int; // 返回类型
    t_sig_np *int; // 固定参数个数
    t_sig_vararg *int; // 1 = 末尾裸变参（仅 prelude）
    t_sig_first *int; // 参数类型池起始下标
    t_sig_params *int; // 参数类型池
    t_sig_n int;
    t_sig_rcap int;
    t_sig_ncap int;
    t_sig_vcap int;
    t_sig_fcap int;
    t_sigparam_n int;
    t_sigparam_cap int;
    t_names *TName;
    t_name_n int;
    t_name_cap int;
    c_syms *CSym;
    c_sym_n int;
    c_sym_cap int;
    c_scope_start *int; // 每层作用域进入时的符号表下标（64 层）
    c_scope_n int;
    c_fold int; // >0：表达式只做常量折叠，不发射代码
    c_ct_target_ctx int; // >0：当前正解析 $if 条件，目标标记按内建常量解析
    c_ct_diag_stmt int; // >0：当前完整表达式语句可消费编译期诊断结果
    c_ct_prepare_active int; // >0：当前正在 pass2a 前捕获 comptime 函数 typed IR
    c_ct_prepare_first int; // 当前待捕获编译期函数在文件 token 表中的起点
    c_ct_expand_depth int; // 当前错误/警告所在的编译期 for 展开深度
    c_ct_expand_values [32]int; // 外层到内层的编译期 for 当前迭代值
    c_em_suppress int; // >0：发射层整体静默（sizeof(expr) 求型用）
    c_check_only int; // 1：项目 check 模式，只做语义检查，不生成后端缓冲
    c_legacy_system int; // 1：兼容配置显式开放 system；默认独立配置不登记它
    c_ast_capture int; // 1：worker 同遍历记录表达式、语句和声明 AST
    c_ct_meta_bare int; // >0：允许裸元信息绑定作类型谓词实参（$is_type(f, T)）
    c_pub_agg_dep *PubAggDeferred; // 导入侧延迟执行的 pub $ 聚合常量登记表
    c_pub_agg_dep_n int;
    c_pub_agg_dep_cap int;
    c_active_file int; // 当前前端快照文件编号，AST 源映射使用
    c_stats_ast_nodes int; // 当前 worker 构造的表达式 AST 节点数
    c_stats_ast_refs int; // 当前 worker 保存的表达式符号引用数
    c_stats_stmt_nodes int; // 当前 worker 构造的语句 AST 节点数
    c_stats_ast_bindings int; // 当前 worker 捕获的参数与局部绑定数
    c_stats_ast_functions int; // 当前 worker 封存的函数级 AST 上下文数
    c_stats_decl_nodes int; // 当前 worker 构造的文件级声明 AST 节点数
    c_expect_tid int; // 数组/切片字面量的目标类型（let 初始化/赋值上下文）
    c_data_n int; // 匿名数据标签计数（字符串字面量）；0 保留为 NULL
    c_layout_size int; // tg_layout_struct 的多值返回出参（大小）
    c_layout_align int; // tg_layout_struct 的多值返回出参（对齐）
    o_out *u8; // .text 汇编缓冲
    o_len int;
    o_cap int;
    o_dat *u8; // .data 汇编缓冲（全局初始化与字符串）
    o_dlen int;
    o_dcap int;
    o_bss *u8; // .bss 汇编缓冲（零初始化全局）
    o_blen int;
    o_bcap int;
    o_body *u8; // 函数体缓冲：先发射体，帧大小确定后再组装配 prologue
    o_body_len int;
    o_body_cap int;
    c_in_body int; // 1 = em_put 写入函数体缓冲（否则写 .text）
    c_bss_syms *int; // 零初始化全局符号的 sym 下标清单（.bss）
    c_bss_n int;
    c_bss_cap int;
    c_lbl_n int; // 汇编标签计数器（跨函数递增即可）
    c_fn_ret int; // 当前函数返回类型
    c_fn_flags int; // 当前函数声明属性；旧发射与控制流检查共享
    c_fn_falls int; // 当前解析路径仍可能顺序落底
    c_expr_noreturn int; // 当前语句表达式中是否已执行 noreturn 调用
    c_fn_lbl int; // 当前函数收尾标签号
    c_fn_sym int; // 当前函数的符号下标（prologue 用名字）
    c_fp_off int; // 当前栈帧已分配字节数（局部/参数/临时累计）
    c_temp_off int; // 通用临时槽的 fp 距离（0 = 未分配）
    c_loop_brk int; // 当前循环 break 目标标签号
    c_loop_cnt int; // 当前循环 continue 目标标签号
    c_loop_depth int; // 循环嵌套深度（栈顶 = c_loop_brk/cnt）
    c_loop_break_seen *int; // 各循环是否含有 break，用于 noreturn 无限循环检查
    c_spill_reg *int; // 参数溢出记录（寄存器号），堆分配 16 项
    c_spill_off *int; // 参数溢出记录（槽偏移），堆分配 16 项
    c_spill_n int;
    c_spill_size *int; // 溢出槽的类型（浮点判定；0 = 整型/指针）
    c_fp_argn int; // 浮点参数计数（独立于整型寄存器序）
    c_lvalue int; // >0：解析赋值目标，地址型钩子发地址不发值
    c_res_is_addr int; // 刚解析的表达式在 x0 中留下的是地址（可赋值）
    c_call_abi *int; // 每层调用约定，聚合在求值时生成独立 C 副本
    c_call_direct *int; // 每层调用是否直接调用（callee 是裸函数名），堆分配 64 项
    c_enum_next int; // enum 成员的自动判别值
    c_args *Res; // 当前调用的实参 Res（堆分配 256 项，嵌套共享）
    c_argtys *int; // 当前调用的实参类型（堆分配 256 项）
    c_arg_n int; // 已收集的实参总数（嵌套调用以基线区分）
    c_call_base *int; // 每层调用的实参起始下标（堆分配 64 项）
    c_call_depth int; // 当前调用嵌套深度
    c_arg_agg *int; // 每个实参是否为聚合（堆分配 256 项）
    c_aggtype_n int; // 已登记的聚合类型数（上限 512，方案 §4）
    c_ret_agg int; // 当前函数返回聚合（x8 隐藏指针）
    c_ret_ptr_off int; // 当前函数保存 x8 入参指针的槽（0 = 未用）
    c_ret_agg_val int; // 1 = 本函数已为聚合返回准备好 x0
    c_ret_tmp_off int;
    c_fp_tmp_off int; // 浮点复合赋值的右值临时槽  // 调用聚合返回函数时的调用方缓冲槽
    c_scratch_base int; // 本函数已分配的临时聚合槽起点（诊断/调试用）
    c_lit_off int; // 结构体字面量临时槽（fp 距离）
    c_lit_tid int; // 结构体字面量目标类型
    c_lit_last_type int; // 字面量字段最近一次求值的类型/字面量性
    c_lit_last_lit int;
    c_lit_last_ival i64;
    c_lit_depth int; // 字面量嵌套深度
    c_lit_save_off *int; // 外层字面量槽（堆分配 32 项）
    c_lit_save_tid *int; // 外层字面量类型（堆分配 32 项）
    c_aggparam_indirect *int; // 1 表示源槽保存指针，0 表示源是栈内聚合
    c_cabi_cursor ABICursor; // 当前 C 函数入口的参数分类游标
    c_aggparam_n int; // 聚合参数入口拷贝任务数
    c_aggparam_src *int; // 指针槽（堆分配 64 项）
    c_aggparam_dst *int; // 体型槽（堆分配 64 项）
    c_aggparam_size *int; // 字节数（堆分配 64 项）
    c_cur_struct int; // 正在解析的 struct/union 类型编号
    t_cur_enum int; // 正在解析的 enum 类型编号
    c_decl_pub int; // 当前顶层声明是否带 pub
    c_decl_attrs int; // 当前顶层声明属性位（ATTR_*）
    c_name_form int; // 当前类型登记形态：0=type 别名 1=struct 2=union 3=enum
    np_data *u8;
    np_len int;
    np_cap int;
    c_fold_ival i64; // 最近一次数字字面量的位型值
    c_fold_big int; // 1 = 字面量超出 i64 正数域
    sc_lbl_false int;
    sc_lbl_end int;
    sc_sc_false_stk *int; // 嵌套短路标签或折叠左值保存栈（堆分配 64 项）
    sc_sc_end_stk *int;
    sc_sc_depth int;
    tn_lbl_else int;
    tn_lbl_end int;
    tn_else_stk *int; // 嵌套三元标签保存栈（堆分配 64 项）
    tn_end_stk *int;
    tn_depth int;
    c_glabels *GLabel; // goto 标签表（堆分配 128 项）
    c_glabel_n int;
    mod_has_module int; // 1 = 文件带 module 归属声明（模块模式）
    mod_name_off int; // 模块名名字池偏移（mod_has_module 时有效）
    mod_name_len int;
    mod_imports *ImportEnt; // 本文件导入表（堆分配，mod_import_push 扩容）
    mod_import_n int;
    mod_import_cap int;
    c_mods *ModInfo; // 当前编译单元已加载的导入模块
    c_mod_n int;
    c_mod_cap int;
    c_mod_home_next int; // 下一个模块编号（home 分配计数）
    c_iface_load int; // 1 = 正在加载接口文件（登记不发射、不进 bss）
    c_sym_sfx_off int; // 本模块符号后缀（__proj__mod）池偏移；单文件 -1
    c_sym_sfx_len int;
    mod_import_mod *int; // 与 mod_imports 平行：导入绑定的 ModInfo 下标
    mod_import_used *int; // 与 mod_imports 平行：本文件是否用到该导入
    t_home *int;
    t_home_cap int;
    c_fi_kind *int; // 0=数组/切片（按元素地址），1=区间（按下标）
    c_fi_cnt_off *int; // 循环计数槽（fp 距离）
    c_fi_len_off *int; // 长度槽（fp 距离）
    c_fi_data_off *int; // 数据/区间起点槽（fp 距离）
    c_fi_step_off *int; // 区间步长槽（+1/-1）
    c_fi_elem_off *int; // 元素/下标绑定槽（fp 距离，-1 未绑定）
    c_fi_idx_off *int; // 下标绑定槽（fp 距离，-1 未绑定）
    c_fi_depth int;
    c_end_tmp_off int; // 区间终点临时槽（for-in 区间用）
    c_brk_stk *int;
    c_cnt_stk *int;
    c_front_checked int; // 1：受检前端阶段，禁止旧 text/body/data/bss 输出。
}

// GenState：编译器全局状态（进程级）+ 任务私有上下文。字段全公开。
pub struct GenState {
    c_stats_enabled int; // 1 = 输出构建阶段计数（仅开发验收）
    c_front_cache int; // 1 = worker 保存项目源与 token 快照
    c_stats_lex int; // 本进程实际词法扫描次数
    c_stats_syntax int; // worker 声明索引中的顶层声明数量
    c_stats_index int; // 项目文件索引次数
    c_stats_pass1 int; // 模块声明遍历的文件数
    c_stats_globals int; // 模块全局初始化遍历的文件数
    c_stats_functions int; // 模块函数体遍历的文件数
    c_stats_ir_functions int; // 本次构建实际生成并校验的 SSA 函数数
    c_stats_ir_cache_hits int; // 通过输入键和校验器复用的函数 IR 数
    c_stats_ir_cache_misses int; // 本次重新降低并验证的函数 IR 数
    c_stats_checked_functions int; // 实际参与运行期 lowering 的受检函数数，不含 comptime
    c_stats_backend_emitted int; // 后端返回成功、确实替换旧汇编的函数数
    c_stats_ir_rejected int; // 前端 lowering 子集不支持的函数数
    c_stats_backend_rejected int; // SSA 已验证但机器后端不支持的函数数
    c_ir_cache_salt u64; // 父构建器传入的编译器二进制指纹
    c_stats_workers int; // 父构建器启动的模块 worker 数
    c_stats_asm int; // 实际调用外部汇编器的次数
    c_stats_link int; // 实际调用外部链接器的次数
    c_stats_compiler_hashes int; // 实际读取编译器二进制计算指纹的次数
    c_module_mode int; // 1 = 模块模式（--emit-module）；单文件恒 0
    c_is_entry_mod int; // 1 = 当前编译入口模块（main 不加后缀、须存在）
    p_projs *PProj;
    p_proj_n int;
    p_proj_cap int;
    p_mods *PMod;
    p_mod_n int;
    p_mod_cap int;
    p_files *PFile;
    p_file_n int;
    p_file_cap int;
    p_imp_file *int; // 所属文件下标
    p_imp_off *int; // 查找名（模块名）池偏移；点分导入取 MOD 段
    p_imp_len *int;
    p_imp_key_off *int; // 跨项目依赖键池偏移；同项目 -1
    p_imp_key_len *int;
    p_imp_alias_off *int; // 绑定名（别名）池偏移
    p_imp_alias_len *int;
    p_imp_line *int; // 导入声明位置（源文件内）
    p_imp_col *int;
    p_imp_mod *int; // 解析结果模块下标；-1 未解析
    p_imp_n int;
    p_imp_cap int;
    p_stdlib int; // 标准库项目下标（YH_STDLIB；-1 未设置）
    p_state *int; // 项目装载状态（0 未装载 1 装载中 2 完成）
    c_dialect int;
    c_target TargetInfo; // 当前输出目标；$if、源文件筛选、后端与缓存共用。
    c_host_target TargetInfo; // 编译器构建时固化的进程身份，不随 --target 改写。
    // —— LLVM 后端模式（LL3）——
    // gs.c_backend：0 = 旧机器发射（默认），1 = 内嵌 LLVM；由 CLI --backend 设置，
    // fork worker 继承。LLVM 模式下 worker 走「受检快照 → 模块 IR → LLVM 文本 → 桥」，
    // 不再产生任何旧汇编，也不允许回退。
    c_backend int;
    c_opt_level int; // LLVM 优化级别：0（默认 O0）或 2（显式 -O2）；其他值由 CLI 拒绝。
    c_emit_kind int; // 1 = LLVM 文本（.ll），0 = 目标文件（对象/汇编由目标决定）。
    c_emit_text_path *char; // 非空且 emit_kind=1 时把 LLVM 文本写入该路径（诊断/审阅用）。
    task TaskCtx; // [RS1c] 每任务工作状态：g_state.task.<字段>
}


// g_state：gen 模块私有状态实例（零初始化）。
let g_state GenState;

// G：返回编译器全局状态地址。parse/cmd/backend 经 gen.G() 限定访问。
pub fn G() *GenState {
    return &g_state;
}

// 字符串字面量的数据标签 → 原样字节（intern 池）映射：顶层或普通函数里的编译期
// 调用实参由前端直接求值，只剩数据标签号，编译期过程据此反查字面量字节。
// 独立全局表而非 GenState 字段：GenState 已大到让后端单条 add 的字段偏移越界。
// 每个编译单元最多登记 4096 项，表满时由调用方报告错误，不漏掉快照数据。
pub const DATA_STR_CAP int = 4096;
let c_data_str_n int = 0;
let c_data_str_lbl [DATA_STR_CAP]int;
let c_data_str_off [DATA_STR_CAP]int;
let c_data_str_len [DATA_STR_CAP]int;
let c_data_str_quoted [DATA_STR_CAP]int;

// data_str_add：登记字符串字面量的数据标签与原样字节，返回非零表示表满或分配失败。
// 字节 intern 进名字池（np_data），消费侧（ct_pool_adopt_label）按同一个池取字节。
pub fn data_str_add(lbl int, start int, slen int) int {
    if (c_data_str_n >= DATA_STR_CAP) { return -1; }
    let off int = name_intern(start, slen);
    if (off < 0) { return -1; }
    return data_str_add_entry(lbl, off, slen, 1);
}

// data_str_add_pool：直接登记已经位于名字池中的字节，不把池偏移误当源文件偏移。
pub fn data_str_add_pool(lbl int, off int, slen int) int {
    return data_str_add_entry(lbl, off, slen, 0);
}

// data_str_add_entry：登记池内字节，并标记其是否含有源码字符串引号与转义。
fn data_str_add_entry(lbl int, off int, slen int, quoted int) int {
    if (c_data_str_n >= DATA_STR_CAP || off < 0 || slen < 0
        || off > g_state.task.np_len || slen > g_state.task.np_len - off) { return -1; }
    c_data_str_lbl[c_data_str_n] = lbl;
    c_data_str_off[c_data_str_n] = off;
    c_data_str_len[c_data_str_n] = slen;
    c_data_str_quoted[c_data_str_n] = quoted;
    c_data_str_n += 1;
    return 0;
}

// data_str_lookup：按数据标签号查登记项；**命中返回非零**并写出名字池偏移与字节长度，
// 未命中返回 0（调用方 `if (data_str_lookup(...) != 0)` 以非零为命中）。
pub fn data_str_lookup(lbl int, off *int, slen *int, quoted *int) int {
    let i int = 0;
    for i < c_data_str_n {
        if (c_data_str_lbl[i] == lbl) {
            *off = c_data_str_off[i];
            *slen = c_data_str_len[i];
            *quoted = c_data_str_quoted[i];
            return 1;
        }
        i += 1;
    }
    return 0;
}

// 枚举成员登记表：模块 worker 会二次解析编译期正文，那时名字表里可能查不到枚举成员
// 符号（实测）。登记时快照名字池偏移与值，反查不经过符号表，绕开符号可见性问题。
// 独立全局数组（与 c_data_str_* 同理，避免撑大 GenState 字段偏移）。
let em_n int = 0;
let em_name_off [512]int;
let em_name_len [512]int;
let em_val [512]i64;
let em_ready [512]int;

// em_add：登记一个枚举成员（必须在成员的值与就绪位写完之后调用，否则快照到 0）。
pub fn em_add(sym int) int {
    if (em_n >= 512) { return -1; }
    em_name_off[em_n] = g_state.task.c_syms[sym].name_off;
    em_name_len[em_n] = g_state.task.c_syms[sym].name_len;
    em_val[em_n] = g_state.task.c_syms[sym].cval;
    em_ready[em_n] = g_state.task.c_syms[sym].const_ready;
    em_n += 1;
    return 0;
}

// em_update_value：延迟回填枚举成员值时同步表内快照（按名字池偏移匹配，不依赖符号下标）。
pub fn em_update_value(name_off int, val i64) void {
    let i int = 0;
    for i < em_n {
        if (em_name_off[i] == name_off) {
            em_val[i] = val;
            em_ready[i] = 1;
        }
        i += 1;
    }
}

// em_name_eq：比较登记项名字（名字池字节）与源码缓冲字节 [start,start+n)。
fn em_name_eq(idx int, src *u8, start int, n int) int {
    if (em_name_len[idx] != n) { return 0; }
    let off int = em_name_off[idx];
    let i int = 0;
    for i < n {
        let a int = g_state.task.np_data[off + i].to_type(int);
        let b int = src[start + i].to_type(int);
        if (a != b) { return 0; }
        i += 1;
    }
    return 1;
}

// em_find_src：按给定源码缓冲的名字字节反查登记项下标，找不到返回 -1。
// 编译期目标另有一份源码缓冲（frame.target.src），与前端 c_src 不一定同一个。
pub fn em_find_src(src *u8, start int, n int) int {
    let i int = 0;
    for i < em_n {
        if (em_name_eq(i, src, start, n) != 0) { return i; }
        i += 1;
    }
    return -1;
}

// em_find：按前端当前源文件（c_src）的名字字节反查登记项下标。
fn em_find(start int, n int) int {
    return em_find_src(g_state.task.c_src, start, n);
}

// sym_find_enum_member：在符号表里按名字找属于枚举类型 etid 的成员符号。
// 用于「成员名被同名形参/局部变量遮蔽」时仍能解析 `EnumName.member`：
// 词法作用域里的同名声明优先用于普通标识符，但 `.` 右侧的成员名总是枚举成员。
pub fn sym_find_enum_member(etid int, src *u8, start int, n int) int {
    let i int = 0;
    for i < g_state.task.c_sym_n {
        let candidate CSym = g_state.task.c_syms[i];
        if ((candidate.flags & F_ENUM_MEMBER) != 0 && candidate.type_id == etid
            && candidate.name_len == n) {
            let off int = candidate.name_off;
            let j int = 0;
            for j < n {
                if (g_state.task.np_data[off + j].to_type(int)
                    != src[start + j].to_type(int)) {
                    break;
                }
                j += 1;
            }
            if (j == n) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// em_get_val / em_get_ready：读取登记项的值与就绪位。
pub fn em_get_val(idx int) i64 {
    return em_val[idx];
}

pub fn em_get_ready(idx int) int {
    return em_ready[idx];
}

// state_init：恢复非零初始值（原 pub let 声明初始化器迁移而来）。
// 在每次编译会话开始（driver 入口与 worker 初始化）调用。
pub fn state_init() void {
    static_data_reset();
    g_state.task.lx_line = 1;
    g_state.task.c_file_decl_i = -1;
    g_state.task.c_active_file = -1;
    g_state.task.c_expect_tid = -1;
    g_state.task.c_data_n = 1;
    c_data_str_n = 0;
    em_n = 0;
    g_state.task.c_ct_target_ctx = 0;
    g_state.task.c_ct_diag_stmt = 0;
    g_state.task.mod_name_off = -1;
    g_state.task.c_sym_sfx_off = -1;
    g_state.p_stdlib = -1;
    g_state.c_dialect = TG_DIALECT_GNU;
    target_host_info(&g_state.c_host_target);
    g_state.c_target = g_state.c_host_target;
    if (g_state.c_target.os == TARGET_OS_DARWIN) { g_state.c_dialect = TG_DIALECT_DARWIN; }
    // LL11：Linux/x86_64 默认使用 LLVM 后端（旧 ARM64 发射不支持 x64）。
    if (g_state.c_host_target.os == TARGET_OS_LINUX
        && g_state.c_host_target.arch == TARGET_ARCH_X64) {
        g_state.c_backend = 1;
    }
    // F2-10：Darwin/ARM64 默认使用 LLVM 后端（内嵌固定桥与 lld）。
    if (g_state.c_host_target.os == TARGET_OS_DARWIN
        && g_state.c_host_target.arch == TARGET_ARCH_ARM64) {
        g_state.c_backend = 1;
    }
}
