module gen;

// ============================================================================
// buffer.yh —— 自举编译器：源文件读取、字节写出与诊断
//
// 职责（docs/02-plan/yh-自举实施方案-v2.md §3）：
//   * read_source：open/read/close 把完整源文件读进内存。处理短读、
//     NUL 字节与容量增长；EOF 时 read 返回 0、错误返回负数。
//   * write_all：write 循环处理短写；诊断一律写文件描述符 2。
//   * err_lc / fail：带位置与不带位置的诊断。诊断格式
//         <path>:<line>:<col>: 错误: <msg>
//     推测解析期间（g_state.c_spec > 0）诊断静默且不计数——试探失败由返回值
//     传递，真正失败由回退路径重新解析后报告。
// ============================================================================

// append_byte：向 buf 的 n 处写入一个字节，返回新的写入位置。
// 仅用于栈上小缓冲（诊断消息拼装），不做容量检查——调用方保证空间。
pub fn append_byte(buf *u8, n int, b u8) int {
    buf[n] = b;
    return n + 1;
}

// append_str：向 buf 追加一个 NUL 结尾字符串（不含结尾 NUL），返回新位置。
pub fn append_str(buf *u8, n int, s *char) int {
    let i int = 0;
    for s[i] != 0 {
        buf[n] = s[i].to_type(u8);
        n += 1;
        i += 1;
    }
    return n;
}

// set_source_path：把当前文件路径复制到固定缓冲区，避免可扩容字符串池搬迁后悬空。
pub fn set_source_path(path *char) int {
    if (path == 0) {
        return fail("源文件路径为空");
    }
    let n int = 0;
    for path[n] != 0 && n < 1023 {
        g_state.c_path_buffer[n] = path[n].to_type(u8);
        n += 1;
    }
    if (path[n] != 0) {
        return fail("源文件路径过长");
    }
    g_state.c_path_buffer[n] = 0;
    g_state.c_path = (&g_state.c_path_buffer[0]).to_type(*char);
    return 0;
}

// append_int：向 buf 追加十进制整数（含负号），返回新位置。
// 行号/列号规模远小于 2^31，不处理 INT_MIN 取负溢出。
pub fn append_int(buf *u8, n int, v int) int {
    if (v < 0) {
        buf[n] = '-';
        n += 1;
        v = -v;
    }
    // 逆序取位到 tmp，再反向拷入 buf
    let tmp [12]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    for k > 0 {
        k -= 1;
        buf[n] = tmp[k];
        n += 1;
    }
    return n;
}

// write_all：把 buf 前 n 个字节全部写到 fd。
// write 可能短写（返回实际写出字节数），循环推进直到写完；负返回视为错误。
pub fn write_all(fd int, buf *u8, n int) int {
    let done int = 0;
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64));
        if (w <= 0) {
            return -1;
        }
        done += w.to_type(int);
    }
    return 0;
}

// err_lc：报告一条带位置的错误（1 基行列），计一次错误并返回 -1。
// 推测解析期间静默：不打印、不计数，仅以返回值示意失败。
pub fn err_lc(line int, col int, msg *char) int {
    if (g_state.c_spec > 0) {
        return -1;
    }
    g_state.c_errors += 1;
    // 单缓冲拼装后一次写出，避免多条 write 交错
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, g_state.c_path);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, line);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, col);
    n = append_str(buf, n, ": 错误: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// fail：报告一条不带位置的编译器级错误（打开失败、内存不足等），返回 -1。
pub fn fail(msg *char) int {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, "yh: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// fail_path：报告与源文件路径相关的错误（如无法打开），返回 -1。
pub fn fail_path(msg *char, path *char) int {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, "yh: ");
    n = append_str(buf, n, msg);
    n = append_str(buf, n, path);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// cstr_eq：按字节比较两个 NUL 结尾字符串，相等返回 1。
// prelude 没有 strcmp，这里手写；仅用于命令行参数比对。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0;
    for 1 {
        if (a[i] != b[i]) {
            return 0;
        }
        if (a[i] == 0) {
            return 1;
        }
        i += 1;
    }
    return 0;
}

// arr_cstr：把字节缓冲当作 NUL 结尾 C 字符串取 *char。
// 注意：数组局部不可直接 `.to_type(*char)`（接收者语义不同），必须先
// 作参数传递完成退化（本函数的 buf 参数），再对指针做类型转换。
pub fn arr_cstr(buf *u8) *char {
    return buf.to_type(*char);
}

// ---------------------------------------------------------------------------
// 汇编输出缓冲：.text（g_state.o_out/g_state.o_len/g_state.o_cap）与 .data（g_state.o_dat/g_state.o_dlen/g_state.o_dcap）。
// 全部汇编先写入缓冲，编译成功后由 flush_output 一次性写到标准输出——
// 错误不会留下看似成功的部分汇编。
// ---------------------------------------------------------------------------

// out_grow：把 data/cap 指向的缓冲扩容到至少能容纳 need 字节。
// 成功返回 0，分配失败输出诊断并返回 -1。
pub fn out_grow(data **u8, n int, cap *int, need int) int {
    if (n < *cap) {
        return 0;
    }
    let ncap int = *cap * 2;
    if (ncap == 0) {
        ncap = 65536;
    }
    if (ncap < need) {
        ncap = need;
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
    if (nd == 0) {
        return fail("内存分配失败");
    }
    if (n > 0) {
        memcpy(nd, *data, n.to_type(u64));
    }
    free(*data);
    *data = nd;
    *cap = ncap;
    return 0;
}

// em_put：向 .text 缓冲追加一个字节。全部 .text 发射（frag/ins/puti/
// 标签号）都汇聚于此：sizeof 求型或项目 check-only 模式下整体静默，
// 单点闸门即可抑制整棵表达式求值的指令输出。
pub fn em_put(b u8) int {
    if (g_state.c_em_suppress > 0 || g_state.c_check_only != 0) {
        return 0;
    }
    // 函数体发射期间先进体缓冲（帧大小确定后再与 prologue 装配）
    if (g_state.c_in_body != 0) {
        if (out_grow(&g_state.o_body, g_state.o_body_len, &g_state.o_body_cap, g_state.o_body_len + 1) != 0) {
            return -1;
        }
        g_state.o_body[g_state.o_body_len] = b;
        g_state.o_body_len += 1;
        return 0;
    }
    if (out_grow(&g_state.o_out, g_state.o_len, &g_state.o_cap, g_state.o_len + 1) != 0) {
        return -1;
    }
    g_state.o_out[g_state.o_len] = b;
    g_state.o_len += 1;
    return 0;
}

// em_puts：向 .text 缓冲追加 NUL 结尾字符串（不含 NUL）。
pub fn em_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (em_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// em_puti：向 .text 缓冲追加十进制整数（指令操作数用）。
pub fn em_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    let neg int = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    if (neg != 0) {
        if (em_put('-') != 0) {
            return -1;
        }
    }
    for k > 0 {
        k -= 1;
        if (em_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// dat_put / dat_puts：向 .data 缓冲追加（全局数据发射用）。
pub fn dat_put(b u8) int {
    if (g_state.c_check_only != 0) {
        return 0;
    }
    if (out_grow(&g_state.o_dat, g_state.o_dlen, &g_state.o_dcap, g_state.o_dlen + 1) != 0) {
        return -1;
    }
    g_state.o_dat[g_state.o_dlen] = b;
    g_state.o_dlen += 1;
    return 0;
}

// dat_puts：向 .data 缓冲追加 NUL 结尾字符串。
pub fn dat_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (dat_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// dat_puti：向 .data 缓冲追加十进制整数。
pub fn dat_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    let neg int = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    if (neg != 0) {
        if (dat_put('-') != 0) {
            return -1;
        }
    }
    for k > 0 {
        k -= 1;
        if (dat_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// bss_put / bss_puts / bss_puti：向 .bss 缓冲追加。
pub fn bss_put(b u8) int {
    if (g_state.c_check_only != 0) {
        return 0;
    }
    if (out_grow(&g_state.o_bss, g_state.o_blen, &g_state.o_bcap, g_state.o_blen + 1) != 0) {
        return -1;
    }
    g_state.o_bss[g_state.o_blen] = b;
    g_state.o_blen += 1;
    return 0;
}

pub fn bss_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (bss_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

pub fn bss_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    for k > 0 {
        k -= 1;
        if (bss_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// flush_output：把 .text/.data/.bss 缓冲写到标准输出（文件描述符 1）。
// 段头（.data/.bss）在此处补写；成功返回 0。
pub fn flush_output() int {
    return flush_output_fd(1);
}

// flush_output_fd：把已发射的 .text/.data/.bss 写入指定文件描述符。
// 供 --emit-asm（fd=1，标准输出）与 -o（fd=临时汇编文件）共用。
pub fn flush_output_fd(fd int) int {
    if (write_all(fd, g_state.o_out, g_state.o_len) != 0) {
        return -1;
    }
    let hdr_data *char = "\n.data\n";
    let hdr_bss *char = "\n.bss\n";
    if (g_state.o_dlen > 0) {
        if (write_all(fd, hdr_data.to_type(*u8), 7) != 0) {
            return -1;
        }
        if (write_all(fd, g_state.o_dat, g_state.o_dlen) != 0) {
            return -1;
        }
    }
    if (g_state.o_blen > 0) {
        if (write_all(fd, hdr_bss.to_type(*u8), 6) != 0) {
            return -1;
        }
        if (write_all(fd, g_state.o_bss, g_state.o_blen) != 0) {
            return -1;
        }
    }
    return 0;
}

// read_source：读取完整源文件到 g_state.c_src / g_state.c_src_len。
// 流程：open（O_RDONLY=0）→ 循环 read 到倍增缓冲（read 返回 0 即 EOF，
// 负数即错误）→ close。缓冲初始 64 KiB，每次翻倍并整体拷贝；
// NUL 字节按普通字节保留，长度以累计字节数为准。
// 成功返回 0；任何一步失败释放资源、输出诊断并返回 -1。
pub fn read_source(path *char) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return fail_path("无法打开文件: ", path);
    }
    let cap int = 65536;
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (data == 0) {
        close(fd);
        return fail("内存分配失败");
    }
    let blen int = 0;
    for 1 {
        // 保证至少 64 KiB 余量再读（read 一次最多取 64 KiB）
        if (cap - blen < 65536) {
            let ncap int = cap * 2;
            let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
            if (nd == 0) {
                free(data);
                close(fd);
                return fail("内存分配失败");
            }
            memcpy(nd, data, blen.to_type(u64));
            free(data);
            data = nd;
            cap = ncap;
        }
        let n i64 = read(fd, data + blen, (cap - blen).to_type(u64));
        if (n < 0) {
            free(data);
            close(fd);
            return fail_path("读取失败: ", path);
        }
        if (n == 0) {
            break;
        }
        blen += n.to_type(int);
    }
    close(fd);
    g_state.c_src = data;
    g_state.c_src_len = blen;
    return 0;
}

// err_tok：以当前 token 的行列位置报错（解析器与语义共用；
// 自 parse_type.yh 迁入使 gen 无反向 import——ADR-0007 P3 解环）。

// err_tok：以当前 token 的行列位置报错，返回 -1。
pub fn err_tok(msg *char) int {
    return err_lc(g_state.c_toks[g_state.c_pos].line, g_state.c_toks[g_state.c_pos].col, msg);
}
