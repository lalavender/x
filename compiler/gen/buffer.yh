module gen

// ============================================================================
// buffer.yh —— 自举编译器：源文件读取、字节写出与诊断
//
// 职责（docs/02-plan/yh-自举实施方案-v2.md §3）：
//   * read_source：open/read/close 把完整源文件读进内存。处理短读、
//     NUL 字节与容量增长；EOF 时 read 返回 0、错误返回负数。
//   * write_all：write 循环处理短写；诊断一律写文件描述符 2。
//   * err_lc / fail：带位置与不带位置的诊断。诊断格式
//         <path>:<line>:<col>: 错误: <msg>
//     推测解析期间（g_state.task.c_spec > 0）诊断静默且不计数——试探失败由返回值
//     传递，真正失败由回退路径重新解析后报告。
// ============================================================================

// append_byte：向 buf 的 n 处写入一个字节，返回新的写入位置。
// 仅用于栈上小缓冲（诊断消息拼装），不做容量检查——调用方保证空间。
pub fn append_byte(buf *u8, n int, b u8) int {
    buf[n] = b
    return n + 1
}

// append_str：向 buf 追加一个 NUL 结尾字符串（不含结尾 NUL），返回新位置。
pub fn append_str(buf *u8, n int, s *char) int {
    let i int = 0
    for s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// cstr_len：C 字符串长度（不含结尾 NUL）。接口头行等固定前缀用它代替
// 手写的字节数常量，避免字面量与长度常量两处漂移。
pub fn cstr_len(s *char) int {
    let i int = 0
    for s[i] != 0 {
        i += 1
    }
    return i
}

// append_str_limit：向 buf 追加字符串，最多写到 limit 之前，返回新位置。
// 用于包含源代码消息的诊断拼装，避免长输入写出固定缓冲区边界。
pub fn append_str_limit(buf *u8, n int, limit int, s *char) int {
    let i int = 0
    for s[i] != 0 && n < limit {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    return n
}

// task_buf_reserve：任务私有缓冲的统一倍增扩容（RS1b）。
// 任务生命期持有、**不在任务内释放**（fork worker 下任务即进程，退出由
// OS 统一回收）——扩容后旧块不复用，需要跨扩容稳定的指针必须整体重写后
// 重新取。返回 0 表示分配失败；need 按「字节总数（含 NUL）」传入。
pub fn task_buf_reserve(buf **u8, cap *int, need int) *u8 {
    if (*buf != 0 && *cap >= need) {
        return *buf
    }
    let ncap int = *cap * 2
    if (ncap < need) {
        ncap = need
    }
    if (ncap < 256) {
        ncap = 256
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return 0
    }
    *buf = nd
    *cap = ncap
    return nd
}

// set_source_path：把当前文件路径复制进任务私有可扩容缓冲，避免可扩容
// 字符串池搬迁后 c_path 悬空。RS1b：原固定 [1024]u8 改为堆分配倍增扩容，
// 超长路径不再报「源文件路径过长」（实际路径长度只受内存限制）。
pub fn set_source_path(path *char) int {
    if (path == 0) {
        return fail("源文件路径为空")
    }
    let n int = 0
    for path[n] != 0 {
        n += 1
    }
    let buf *u8 = task_buf_reserve(&g_state.task.c_path_buf,
                                   &g_state.task.c_path_buf_cap, n + 1)
    if (buf == 0) {
        return fail("路径快照缓冲分配失败")
    }
    let i int = 0
    for i < n {
        buf[i] = path[i].to_type(u8)
        i += 1
    }
    buf[n] = 0
    g_state.task.c_path = buf.to_type(*char)
    return 0
}

// append_int：向 buf 追加十进制整数（含负号），返回新位置。
// 行号/列号规模远小于 2^31，不处理 INT_MIN 取负溢出。
pub fn append_int(buf *u8, n int, v int) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf
    let tmp [12]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// append_i64：向 buf 追加十进制 64 位整数（含负号），返回新位置。
// append_int 的实参是 32 位 int，超过 2^31 的值会被静默截断——构建统计里的
// 纳秒计时正好跨在这条线上（2.147 s 以上就翻负），故 64 位量一律走这里。
// 与 append_int 一样不处理 INT64_MIN 取负溢出。
pub fn append_i64(buf *u8, n int, v i64) int {
    if (v < 0) {
        buf[n] = '-'
        n += 1
        v = -v
    }
    // 逆序取位到 tmp，再反向拷入 buf（i64 最长 19 位数字 + 符号）
    let tmp [24]u8
    let k int = 0
    if (v == 0) {
        tmp[0] = '0'
        k = 1
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8)
        k += 1
        v = v / 10
    }
    for k > 0 {
        k -= 1
        buf[n] = tmp[k]
        n += 1
    }
    return n
}

// write_all：把 buf 前 n 个字节全部写到 fd。
// write 可能短写（返回实际写出字节数），循环推进直到写完；负返回视为错误。
pub fn write_all(fd int, buf *u8, n int) int {
    let done int = 0
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64))
        if (w <= 0) {
            return -1
        }
        done += w.to_type(int)
    }
    return 0
}

// alloc：统一分配入口（A0d）。
//
// 编译器在内存耗尽后无法继续：与其让调用方解引用空指针、在任意深处
// 无声崩溃，不如在这里写一条确定诊断并终止。这是编译器里**唯一**的
// 进程级退出点；新增分配一律走这里，不再逐点重复判空。
// 返回非 0 指针，调用方按需 `.to_type(*T)` 转换。
pub fn alloc(size u64) *u8 {
    let p *u8 = malloc(size).to_type(*u8)
    if (p == 0) {
        let msg *char = "yh: 内存不足，无法继续\n"
        write_all(2, msg.to_type(*u8), 32)
        exit(1)
    }
    return p
}

// append_ct_expand_trace：为展开体内诊断追加外层到内层的编译期循环值。
fn append_ct_expand_trace(buf *u8, n int, limit int) int {
    if (g_state.task.c_ct_expand_depth <= 0 || n >= limit - 600) { return n }
    n = append_str_limit(buf, n, limit, " [编译期展开值: ")
    let i int = 0
    for i < g_state.task.c_ct_expand_depth {
        if (i > 0) { n = append_str_limit(buf, n, limit, " -> ") }
        n = append_int(buf, n, g_state.task.c_ct_expand_values[i])
        i += 1
    }
    return append_str_limit(buf, n, limit, "]")
}

// err_lc：报告一条带位置的错误（1 基行列），计一次错误并返回 -1。
// 推测解析期间静默：不打印、不计数，仅以返回值示意失败。
pub fn err_lc(line int, col int, msg *char) int {
    if (g_state.task.c_spec > 0) {
        return -1
    }
    g_state.task.c_errors += 1
    // 单缓冲拼装后一次写出，避免多条 write 交错
    let buf [2048]u8
    let limit int = 2047
    let n int = 0
    n = append_str_limit(buf, n, limit, g_state.task.c_path)
    n = append_byte(buf, n, ':')
    n = append_int(buf, n, line + g_state.task.c_diag_line_bias)
    n = append_byte(buf, n, ':')
    n = append_int(buf, n, col)
    n = append_str_limit(buf, n, limit, ": 错误: ")
    n = append_str_limit(buf, n, limit, msg)
    n = append_ct_expand_trace(buf, n, limit)
    if (n < limit) { n = append_byte(buf, n, '\n') }
    else { buf[limit] = '\n'; n = limit + 1 }
    write_all(2, buf, n)
    return -1
}

// warn_lc：报告一条带位置的警告，不增加错误数；推测解析期间保持静默。
pub fn warn_lc(line int, col int, msg *char) int {
    if (g_state.task.c_spec > 0) { return 0 }
    let buf [2048]u8
    let limit int = 2047
    let n int = 0
    n = append_str_limit(buf, n, limit, g_state.task.c_path)
    n = append_byte(buf, n, ':')
    n = append_int(buf, n, line + g_state.task.c_diag_line_bias)
    n = append_byte(buf, n, ':')
    n = append_int(buf, n, col)
    n = append_str_limit(buf, n, limit, ": 警告: ")
    n = append_str_limit(buf, n, limit, msg)
    n = append_ct_expand_trace(buf, n, limit)
    if (n < limit) { n = append_byte(buf, n, '\n') }
    else { buf[limit] = '\n'; n = limit + 1 }
    return write_all(2, &buf[0], n)
}

// —— 容量受限追加（A0c2）——
//
// `append_str`/`append_byte` 不知道目标容量，写满即越界写栈。以下 *_cap 变体
// 把容量作为显式参数：写满即停止并保持 NUL 结尾，**绝不越界**。用于诊断拼装
// 这类"内容含用户输入、长度不可预估"的场景——截断的诊断仍可读，栈破坏不可。
// 约定：cap 是缓冲区总字节数，最多写 cap-1 字节。

// append_str_cap：容量受限追加字符串，返回新的长度（写满即止）。
pub fn append_str_cap(buf *u8, cap int, n int, s *char) int {
    let i int = 0
    for n < cap - 1 && s[i] != 0 {
        buf[n] = s[i].to_type(u8)
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// append_byte_cap：容量受限追加单字节。
pub fn append_byte_cap(buf *u8, cap int, n int, b u8) int {
    if (n >= cap - 1) { return n }
    buf[n] = b
    n += 1
    buf[n] = 0
    return n
}

// append_int_cap：容量受限追加十进制整数。
pub fn append_int_cap(buf *u8, cap int, n int, v int) int {
    let tmp [24]u8
    let m int = 0
    let x int = v
    if (x < 0) {
        n = append_byte_cap(buf, cap, n, '-')
        x = -x
    }
    if (x == 0) { return append_byte_cap(buf, cap, n, '0') }
    for x > 0 && m < 24 {
        tmp[m] = (x % 10 + 48).to_type(u8)
        m += 1
        x = x / 10
    }
    for m > 0 {
        m -= 1
        n = append_byte_cap(buf, cap, n, tmp[m])
    }
    return n
}

// append_np_cap：容量受限追加名字池片段（偏移 + 长度）。
pub fn append_np_cap(buf *u8, cap int, n int, off int, olen int) int {
    let tk *TaskCtx = task()
    let i int = 0
    for i < olen && n < cap - 1 {
        buf[n] = tk.np_data[off + i]
        n += 1
        i += 1
    }
    buf[n] = 0
    return n
}

// fail：报告一条不带位置的编译器级错误（打开失败、内存不足等），返回 -1。
pub fn fail(msg *char) int {
    let buf [512]u8
    let n int = 0
    n = append_str_cap(buf, 512, n, "yh: ")
    n = append_str_cap(buf, 512, n, msg)
    n = append_byte_cap(buf, 512, n, '\n')
    write_all(2, buf, n)
    return -1
}

// fail_path：报告与源文件路径相关的错误（如无法打开），返回 -1。
pub fn fail_path(msg *char, path *char) int {
    let buf [512]u8
    let n int = 0
    n = append_str_cap(buf, 512, n, "yh: ")
    n = append_str_cap(buf, 512, n, msg)
    n = append_str_cap(buf, 512, n, path)
    n = append_byte_cap(buf, 512, n, '\n')
    write_all(2, buf, n)
    return -1
}

// cstr_eq：按字节比较两个 NUL 结尾字符串，相等返回 1。
// prelude 没有 strcmp，这里手写；仅用于命令行参数比对。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0
    for 1 {
        if (a[i] != b[i]) {
            return 0
        }
        if (a[i] == 0) {
            return 1
        }
        i += 1
    }
    return 0
}

// arr_cstr：把字节缓冲当作 NUL 结尾 C 字符串取 *char。
// 注意：数组局部不可直接 `.to_type(*char)`（接收者语义不同），必须先
// 作参数传递完成退化（本函数的 buf 参数），再对指针做类型转换。
pub fn arr_cstr(buf *u8) *char {
    return buf.to_type(*char)
}

// ---------------------------------------------------------------------------
// 全部汇编先写入缓冲，编译成功后由 flush_output 一次性写到标准输出——
// 错误不会留下看似成功的部分汇编。
// ---------------------------------------------------------------------------

// out_grow：把 data/cap 指向的缓冲扩容到至少能容纳 need 字节。
// 成功返回 0，分配失败输出诊断并返回 -1。
pub fn out_grow(data **u8, n int, cap *int, need int) int {
    if (n < *cap) {
        return 0
    }
    let ncap int = *cap * 2
    if (ncap == 0) {
        ncap = 65536
    }
    if (ncap < need) {
        ncap = need
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
    if (nd == 0) {
        return fail("内存分配失败")
    }
    if (n > 0) {
        memcpy(nd, *data, n.to_type(u64))
    }
    free(*data)
    *data = nd
    *cap = ncap
    return 0
}

// read_source：读取完整源文件到 g_state.task.c_src / g_state.task.c_src_len。
// 流程：open（O_RDONLY=0）→ 循环 read 到倍增缓冲（read 返回 0 即 EOF，
// 负数即错误）→ close。缓冲初始 64 KiB，每次翻倍并整体拷贝；
// NUL 字节按普通字节保留，长度以累计字节数为准。
// 成功返回 0；任何一步失败释放资源、输出诊断并返回 -1。
pub fn read_source(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) {
        return fail_path("无法打开文件: ", path)
    }
    let cap int = 65536
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8)
    if (data == 0) {
        close(fd)
        return fail("内存分配失败")
    }
    let blen int = 0
    for 1 {
        // 保证至少 64 KiB 余量再读（read 一次最多取 64 KiB）
        if (cap - blen < 65536) {
            let ncap int = cap * 2
            let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8)
            if (nd == 0) {
                free(data)
                close(fd)
                return fail("内存分配失败")
            }
            memcpy(nd, data, blen.to_type(u64))
            free(data)
            data = nd
            cap = ncap
        }
        let n i64 = read(fd, data + blen, (cap - blen).to_type(u64))
        if (n < 0) {
            free(data)
            close(fd)
            return fail_path("读取失败: ", path)
        }
        if (n == 0) {
            break
        }
        blen += n.to_type(int)
    }
    close(fd)
    g_state.task.c_src = data
    g_state.task.c_src_len = blen
    return 0
}

// err_tok：以当前 token 的行列位置报错（解析器与语义共用；
// 自 parse_type.yh 迁入使 gen 无反向 import——ADR-0007 P3 解环）。

// err_tok：以当前 token 的行列位置报错，返回 -1。
pub fn err_tok(msg *char) int {
    return err_lc(g_state.task.c_toks[g_state.task.c_pos].line, g_state.task.c_toks[g_state.task.c_pos].col, msg)
}

// is_assign_op：k 是否为赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
// 自 parse_type.yh 迁入：ast 模块拆出后 parse 不再是 ast 的下层，
// 该判定由 gen 提供以保持模块图无环（与 err_tok 同一先例）。
pub fn is_assign_op(k int) int {
    return (k >= TK_ASSIGN && k <= TK_RSHIFTEQ).to_type(int)
}

// yh test 内建测试：纯函数的边界与成员集合。生产构建不登记这些测试。
test "hexval 十进制与十六进制" {
    $assert(hexval('0') == 0)
    $assert(hexval('9') == 9)
    $assert(hexval('a') == 10)
    $assert(hexval('f') == 15)
    $assert(hexval('A') == 10)
    $assert(hexval('F') == 15)
}

test "is_assign_op 边界" {
    $assert(is_assign_op(TK_ASSIGN) == 1)
    $assert(is_assign_op(TK_RSHIFTEQ) == 1)
    $assert(is_assign_op(TK_RANGE) == 0)
    $assert(is_assign_op(TK_PLUS) == 0)
    $assert(is_assign_op(TK_EQEQ) == 0)
}
