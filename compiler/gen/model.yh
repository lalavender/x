// —— goto 标签表（每函数重置） ——
pub struct GLabel {
    name_off int       // 名字池偏移
    name_len int
    lbl int            // 汇编标签号
    defined int        // 1 = 已见定义点
}

// —— 模块头（MOD-U1：文件身份与导入表） ——
// 单文件形态下的 FileID 就是 g_state.task.c_path 本身；多文件/项目身份在 MOD-U2/U3
// 引入模块索引时再扩展，这里只记录当前文件解析出的归属与导入。
pub struct ImportEnt {
    name_off int       // 查找名（模块名）名字池偏移；点分导入 KEY.MOD 时为 MOD
    name_len int
    proj_key_off int   // 跨项目导入 KEY.MOD 的依赖键池偏移；同项目 -1
    proj_key_len int
    alias_off int      // 绑定名（限定调用用的标识符）池偏移
    alias_len int
    line int           // 1 基行号（诊断用）
    col int            // 1 基列号
}

// ---------------------------------------------------------------------------
// 模块与项目（MOD-U2..U4）：编译期状态
//
// 分工：project.yh 负责清单/发现/索引/三层解析（构建器视角，字符串均
// intern 到名字池）；iface.yh 负责模块接口发射与加载；前端（sem/parse_*）
// 通过下面的 g_state.task.c_mods（已加载接口的命名空间）做限定名解析与 pub 检查。
// ---------------------------------------------------------------------------

// 导出接口的一个名字条目（iface.yh 加载接口时填写）。
pub struct ModNsEnt {
    name_off int       // 短名（源码名）名字池偏移
    name_len int
    sym int            // 值/函数/常量符号下标；纯类型名为 -1
    tid int            // 类型编号（类型名条目）；值条目 -1
}

// 一个已绑定导入模块（每份接口一条）。
pub struct ModInfo {
    bind_off int       // 绑定名（=模块名）池偏移
    bind_len int
    prefix_off int     // 接口头宣布的符号后缀（__proj__mod）池偏移
    prefix_len int
    home int           // 模块编号（g_state.task.t_home 归属标记用）
    ns *ModNsEnt       // 导出名字表（堆分配）
    ns_n int
    ns_cap int
}

// —— 模块模式编译开关 ——

// —— 类型归属（跨模块 pub 字段检查） ——
// 与 g_state.task.t_types 平行：>=0 = 该具名类型来自对应模块编号；-1 = 本地。

// —— 项目模型 ——
// 项目/模块/文件三张表与 link 输入的类型定义、唯一写者与窄口读都在 proj 模块
// （B1-1，2026-10-26）：`compiler/proj/proj_00_model.yh`。gen 不再拥有项目模型，
// 只保留前端任务态（TaskCtx）、统计与目标描述符。

// —— 循环 break/continue 目标栈（堆分配各 64 项） ——
// —— for-in 迭代状态（每循环一层） ——
