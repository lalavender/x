// —— 代码发射状态（每函数重置） ——

// —— 表达式求值上下文 ——
// —— 聚合按值 ABI（机制：调用点拷贝 + 指针传递） ——

// —— 名字池（symbols.yh 使用；名字统一 intern 到此池） ——

// —— 常量折叠工作区 ——

// —— 短路与三元的标签工作区（sem.yh） ——

// GLabel 已下沉 support/model.yh；此处保留同名别名。
pub type GLabel = support.GLabel

// —— 模块头（MOD-U1：文件身份与导入表） ——
// 单文件形态下的 FileID 就是 support.fc().c_path 本身；多文件/项目身份在 MOD-U2/U3
// 引入模块索引时再扩展，这里只记录当前文件解析出的归属与导入。
// ImportEnt 已下沉 support/file_scope.yh；此处保留同名别名。
pub type ImportEnt = support.ImportEnt

// ---------------------------------------------------------------------------
// 模块与项目（MOD-U2..U4）：编译期状态
//
// 分工：project.yh 负责清单/发现/索引/三层解析（构建器视角，字符串均
// intern 到名字池）；iface.yh 负责模块接口发射与加载；前端（sem/parse_*）
// 通过下面的 support.fs().mods（已加载接口的命名空间）做限定名解析与 pub 检查。
// ---------------------------------------------------------------------------

// 导出接口的一个名字条目（iface.yh 加载接口时填写）。
// ModNsEnt 已下沉 support/file_scope.yh；此处保留同名别名。
pub type ModNsEnt = support.ModNsEnt

// 一个已绑定导入模块（每份接口一条）。
// ModInfo 已下沉 support/file_scope.yh；此处保留同名别名。
pub type ModInfo = support.ModInfo

// —— 模块模式编译开关 ——

// —— 类型归属（跨模块 pub 字段检查） ——
// 与 support.ms().types 平行：>=0 = 该具名类型来自对应模块编号；-1 = 本地。

// —— 项目模型 ——
// 项目/模块/文件三张表与 link 输入的类型定义、唯一写者与窄口读都在 proj 模块
// （B1-1，2026-10-26）：`compiler/proj/proj_00_model.yh`。gen 不再拥有项目模型，
// 只保留前端任务态（TaskCtx）、统计与目标描述符。

// —— 循环 break/continue 目标栈（堆分配各 64 项） ——
// —— for-in 迭代状态（每循环一层） ——
