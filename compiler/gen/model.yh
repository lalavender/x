// ---------------------------------------------------------------------------
// B5 扩充：编译模式、类型/符号表、作用域、常量折叠与代码发射状态
//
// 分层约定（多平台架构见 docs/03-design/yh-架构设计.md）：
//   * symbols.yh —— 前端语义：类型表、符号/作用域、类型兼容、常量折叠。
//     平台无关，只允许引用 target.yh 的数据模型常量；代码发射在 backend/；
//   * target.yh  —— 目标数据模型：字长、对齐、类型布局规则（换目标先换它）；
//   * backend/   —— LLVM 发射：目标库、ABI 分类与运行时；LL12 后唯一后端。
// ---------------------------------------------------------------------------

// —— 编译模式与两遍扫描 ——

// —— 表达式求值结果描述符 ——
// 解析器边解析边做语义；每个表达式节点通过 *Res 出参返回类型与常量性。
// 约定：is_const=1 时 ival 有效（按 i64 位型；指针常量存数据标签号）。
// Res 已下沉 support/model.yh（多模块共享的语言模型）；此处保留同名别名。
pub type Res = support.Res

// —— 类型表 ——
// 内建类型占固定编号 0..12（TY_VOID..TY_F64），其后按需增长并按内容去重。
// CType 同上：定义在 support/model.yh，此处仅转发。
pub type CType = support.CType

// —— 结构体/联合体字段表 ——
// SField 同上。
pub type SField = support.SField

// PubAggDeferred 已下沉 support/model.yh；此处保留同名别名。
pub type PubAggDeferred = support.PubAggDeferred

// —— 函数签名表（FN 类型通过 sub 引用签名号） ——

// —— 类型名字空间（struct/union/enum/type 别名；仅顶层声明，无需作用域） ——
// TName 同上。
pub type TName = support.TName

// —— 值符号表与作用域 ——
// CSym 同上。
pub type CSym = support.CSym
// 作用域栈：stage0 每单元只允许一个全局数组，故全部表改为堆分配

