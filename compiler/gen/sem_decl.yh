module gen;

// ============================================================================
// sem_decl.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_fn_begin(idx int) int {
    g_state.task.c_fn_sym = idx;
    g_state.task.c_fn_flags = g_state.task.c_syms[idx].flags;
    g_state.task.c_fn_falls = 1;
    g_state.task.c_expr_noreturn = 0;
    g_state.task.c_fn_ret = g_state.task.t_types[g_state.task.c_syms[idx].type_id].elem;
    // LL12：标签、栈槽、序言与体缓冲等机器状态由 LLVM lowering 生成，
    // 语义层只保留类型事实与诊断状态。
    g_state.task.c_temp_off = 0;
    g_state.task.c_fp_tmp_off = 0;
    g_state.task.c_glabel_n = 0;
    g_state.task.c_spill_n = 0;
    g_state.task.c_aggparam_n = 0;
    g_state.task.c_fp_argn = 0;
    g_state.task.c_ret_ptr_off = 0;
    g_state.task.c_ret_agg_val = 0;
    abi_c_cursor_init(&g_state.task.c_cabi_cursor, tg_darwin());
    g_state.task.c_fp_off = 16;
    g_state.task.o_body_len = 0;
    g_state.task.c_in_body = 1;
    // 聚合返回：记录间接返回事实，返回缓冲地址由 lowering 处理。
    let rk int = g_state.task.t_types[g_state.task.c_fn_ret].kind;
    let indirect_ret int = 1;
    if ((g_state.task.c_fn_flags & F_CABI) != 0) {
        let result ABIArg;
        abi_c_result(g_state.task.c_fn_ret, &result);
        indirect_ret = result.indirect;
    }
    if (indirect_ret != 0 && (rk == TY_STRUCT || rk == TY_UNION
        || rk == TY_ARRAY || rk == TY_SLICE)) {
        g_state.task.c_ret_agg = 1;
    } else {
        g_state.task.c_ret_agg = 0;
    }
    scope_push();
    return 0;
}

pub fn sem_declare_param(start int, n int, tid int, regidx int) int {
    if (ty_has_opaque_value(tid) != 0) {
        return sem_err("不透明 C 类型只能通过指针传递");
    }
    // LL12：C ABI 的寄存器/栈分类由 LLVM lowering 处理，语义层只登记参数。
    let pk int = g_state.task.t_types[tid].kind;
    let is_agg int = ((pk == TY_ARRAY) || (pk == TY_STRUCT) || (pk == TY_UNION)
                      || (pk == TY_SLICE)).to_type(int);
    let idx int = sym_push(start, n, SYM_VAR, tid, F_PARAM);
    if (idx < 0) {
        return -1;
    }
    if (is_agg != 0) {
        // 聚合按值：形参持有调用方副本；独立副本与栈槽由 lowering 生成。
        g_state.task.c_syms[idx].flags |= F_AGGPARAM;
        g_state.task.c_aggparam_n += 1;
        return 0;
    }
    if (ty_is_float(tid) != 0) {
        // yh 内部函数的浮点参数上限由旧 ABI 约定决定；C 函数按 lowering 的
        // ABI 分类处理（HFA 逐成员占寄存器，不受此上限约束）。
        if ((g_state.task.c_fn_flags & F_CABI) == 0) {
            if (g_state.task.c_fp_argn >= TG_ARG_REGS) {
                return sem_err("过多的浮点参数暂不支持");
            }
            g_state.task.c_fp_argn += 1;
        }
        return 0;
    }
    return 0;
}

pub fn sem_fn_end() int {
    if (sem_glabels_verify() != 0) {
        return -1;
    }
    if ((g_state.task.c_fn_flags & F_NORETURN) != 0) {
        if (g_state.task.c_fn_ret != TY_VOID) {
            return sem_err("noreturn 函数必须返回 void");
        }
        if (g_state.task.c_fn_falls != 0) {
            return sem_err("noreturn 函数存在正常落底路径");
        }
    }
    // LL12：落底返回、prologue、聚合参数入口拷贝与 epilogue 由 lowering 生成。
    g_state.task.c_in_body = 0;
    scope_pop();
    return 0;
}

// sem_add_field：为 struct/union 登记一个字段（pass 1）。
// pub struct 一等化后字段一律公开，is_pub 恒 1（.s.i 接口按此发射）。
pub fn sem_add_field(stid int, start int, n int, ftid int) int {
    if (ty_has_opaque_value(ftid) != 0) {
        return sem_err("不透明 C 类型只能通过指针使用");
    }
    let fk int = g_state.task.t_types[ftid].kind;
    if ((ty_name_attrs(stid) & ATTR_EXTERN) != 0 && ty_c_layout(ftid) == 0) {
        return sem_err("extern struct/union 字段不是 C 兼容布局类型");
    }
    if ((fk == TY_STRUCT || fk == TY_UNION) && g_state.task.t_types[ftid].size == 0) {
        return sem_err("字段使用了不完整的类型");
    }
    if (g_state.task.t_field_n == g_state.task.t_field_cap) {
        let ncap int = g_state.task.t_field_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *SField = malloc((ncap * sizeof(SField)).to_type(u64)).to_type(*SField);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (g_state.task.t_field_n > 0) {
            memcpy(nd, g_state.task.t_fields, (g_state.task.t_field_n * sizeof(SField)).to_type(u64));
        }
        free(g_state.task.t_fields);
        g_state.task.t_fields = nd;
        g_state.task.t_field_cap = ncap;
    }
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    g_state.task.t_fields[g_state.task.t_field_n].name_off = off;
    g_state.task.t_fields[g_state.task.t_field_n].name_len = n;
    g_state.task.t_fields[g_state.task.t_field_n].type_id = ftid;
    g_state.task.t_fields[g_state.task.t_field_n].offset = 0;
    g_state.task.t_fields[g_state.task.t_field_n].is_pub = 1;
    g_state.task.t_field_n += 1;
    g_state.task.t_types[stid].len = g_state.task.t_field_n - g_state.task.t_types[stid].sub;
    return 0;
}

pub fn sem_struct_finish(stid int, is_union int) int {
    let sub int = g_state.task.t_types[stid].sub;
    let n int = g_state.task.t_types[stid].len;
    if (tg_layout_struct(sub, n, is_union) != 0) {
        return -1;
    }
    g_state.task.t_types[stid].size = g_state.task.c_layout_size;
    g_state.task.t_types[stid].align = g_state.task.c_layout_align;
    return 0;
}

fn sem_field_lookup(stid int, start int, n int) int {
    let st int = g_state.task.t_types[stid].sub;
    let nf int = g_state.task.t_types[stid].len;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (g_state.task.t_fields[f].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (g_state.task.np_data[g_state.task.t_fields[f].name_off + j] != g_state.task.c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return f;
            }
        }
        i += 1;
    }
    return -1;
}

// sem_check_main：校验程序入口返回 int，并接受无参数、argc/argv 或
// argc/argv/envp 三种形态；指针参数必须是 **char。
pub fn sem_check_main() int {
    let mname int = name_intern_lit("main");
    let i int = g_state.task.c_sym_n - 1;
    let found int = -1;
    for i >= 0 {
        if (g_state.task.c_syms[i].name_len == 4) {
            let match int = 1;
            let j int = 0;
            for j < 4 {
                if (g_state.task.np_data[g_state.task.c_syms[i].name_off + j] != g_state.task.np_data[mname + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = i;
                break;
            }
        }
        i -= 1;
    }
    if (found < 0) {
        return sem_err("缺少 main 函数");
    }
    if (g_state.task.c_syms[found].kind != SYM_FN) {
        return sem_err("main 必须是函数");
    }
    let sig int = g_state.task.t_types[g_state.task.c_syms[found].type_id].sub;
    let np int = g_state.task.t_sig_np[sig];
    let ret int = g_state.task.t_sig_ret[sig];
    if (ret != TY_I32) {
        return sem_err("main 必须返回 int");
    }
    if (np == 0) {
        return 0;
    }
    if (np == 2) {
        let p0 int = g_state.task.t_sig_params[g_state.task.t_sig_first[sig]];
        let p1 int = g_state.task.t_sig_params[g_state.task.t_sig_first[sig] + 1];
        let inner int = g_state.task.t_types[p1].elem;
        if (p0 == TY_I32 && g_state.task.t_types[p1].kind == TY_PTR
            && g_state.task.t_types[inner].kind == TY_PTR
            && g_state.task.t_types[g_state.task.t_types[inner].elem].kind == TY_CHAR) {
            return 0;
        }
    }
    if (np == 3) {
        let p0 int = g_state.task.t_sig_params[g_state.task.t_sig_first[sig]];
        let p1 int = g_state.task.t_sig_params[g_state.task.t_sig_first[sig] + 1];
        let p2 int = g_state.task.t_sig_params[g_state.task.t_sig_first[sig] + 2];
        let a1 int = g_state.task.t_types[p1].elem;
        let a2 int = g_state.task.t_types[p2].elem;
        if (p0 == TY_I32 && g_state.task.t_types[p1].kind == TY_PTR
            && g_state.task.t_types[a1].kind == TY_PTR && g_state.task.t_types[g_state.task.t_types[a1].elem].kind == TY_CHAR
            && g_state.task.t_types[p2].kind == TY_PTR
            && g_state.task.t_types[a2].kind == TY_PTR && g_state.task.t_types[g_state.task.t_types[a2].elem].kind == TY_CHAR) {
            return 0;
        }
    }
    return sem_err("main 签名必须是 ()、(argc int, argv **char) 或再带 envp **char");
}
