module gen

// target_resolve：严格解析当前支持的完整 triple，成功填出参，失败保持出参原值。
// LLVM 21.1.8 的布局已用固定版本 oracle 核对；这里查静态数据，check 不初始化 LLVM。
// Windows/x64 的 data_layout 是 2026-10-27 用本机 clang 21.1.8
// （`clang --target=x86_64-pc-windows-msvc -S -emit-llvm`）实测值，不要手抄别处。
pub fn target_resolve(triple *char, out *TargetInfo) int {
    let target TargetInfo
    target.pointer_bits = 64
    target.little_endian = 1
    target.layout_version = 1
    if (cstr_eq(triple, "x86_64-unknown-linux-gnu") != 0) {
        target.triple = "x86_64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_X64
        target.abi = "sysv-amd64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-unknown-linux-gnu") != 0) {
        target.triple = "aarch64-unknown-linux-gnu"
        target.os = TARGET_OS_LINUX
        target.arch = TARGET_ARCH_ARM64
        target.abi = "aapcs64"
        target.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-apple-darwin") != 0) {
        target.triple = "x86_64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_X64
        target.abi = "darwin-amd64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (cstr_eq(triple, "aarch64-apple-darwin") != 0) {
        target.triple = "aarch64-apple-darwin"
        target.os = TARGET_OS_DARWIN
        target.arch = TARGET_ARCH_ARM64
        target.abi = "darwin-aapcs64"
        target.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (cstr_eq(triple, "x86_64-pc-windows-msvc") != 0) {
        // 首版 Windows 只接 x64 + MSVC ABI（零 CRT 路线，见方案 §3 D1/D2）。
        target.triple = "x86_64-pc-windows-msvc"
        target.os = TARGET_OS_WINDOWS
        target.arch = TARGET_ARCH_X64
        target.abi = "win64-msvc"
        target.data_layout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else { return -1 }
    out[0] = target
    return 0
}

// target_host_info：构建编译器时选择并固化进程身份，运行时输出 --target 不改变这些分支。
// 启动种子只需认识已有 arm64/darwin 标记；生成原生 x64 编译器时自动选择其 $else。
pub fn target_host_info(out *TargetInfo) int {
    $if (darwin) {
        $if (arm64) { return target_resolve("aarch64-apple-darwin", out) }
        $else { return target_resolve("x86_64-apple-darwin", out) }
    } $else $if (windows) {
        // Windows 宿主（W2-1）：首版只接 x64；arm64 宿主留给矩阵收尾阶段。
        $if (arm64) { return -1 }
        $else { return target_resolve("x86_64-pc-windows-msvc", out) }
    } $else {
        $if (arm64) { return target_resolve("aarch64-unknown-linux-gnu", out) }
        $else { return target_resolve("x86_64-unknown-linux-gnu", out) }
    }
}

// target_select：只更新输出目标及过渡期旧汇编方言，不能写宿主身份。
pub fn target_select(triple *char) int {
    let target TargetInfo
    if (target_resolve(triple, &target) != 0) { return -1 }
    cfg().target = target
    cfg().dialect = target.os == TARGET_OS_DARWIN ? TG_DIALECT_DARWIN : TG_DIALECT_GNU
    return 0
}

// target_select_os_arch：按项目清单的 os/arch 选择目标；0 表示使用宿主身份。
// 只允许已支持的 Linux/Darwin × ARM64/x64 与 Windows × x64 组合。
pub fn target_select_os_arch(os int, arch int) int {
    if (os == 0) { os = cfg().host_target.os }
    if (arch == 0) { arch = cfg().host_target.arch }
    if (os == TARGET_OS_LINUX) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-unknown-linux-gnu") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-unknown-linux-gnu") }
        return -1
    }
    if (os == TARGET_OS_DARWIN) {
        if (arch == TARGET_ARCH_ARM64) { return target_select("aarch64-apple-darwin") }
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-apple-darwin") }
        return -1
    }
    // Windows：首版只有 x64；ARM64 留给矩阵收尾阶段（方案 §8 W3）。
    if (os == TARGET_OS_WINDOWS) {
        if (arch == TARGET_ARCH_X64) { return target_select("x86_64-pc-windows-msvc") }
        return -1
    }
    return -1
}

// target_matches_host：当前输出目标是否与编译器宿主平台一致。
pub fn target_matches_host() int {
    if (cfg().target.os != cfg().host_target.os) { return 0 }
    if (cfg().target.arch != cfg().host_target.arch) { return 0 }
    return 1
}
