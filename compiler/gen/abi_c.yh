module gen;

// C ABI 的位置分类。分类器只读显式的值描述与目标游标，不依赖发射状态。
const CABI_GPR int = 0;
const CABI_FPR int = 1;
pub const CABI_STACK int = 2;
const CABI_VOID int = 3;

// ABIValue 描述已完成 C 布局的值。fp_count=1 表示浮点标量；聚合非零时
// 表示 HFA，fp_size 为同构元素宽度。普通聚合的 fp_count 必须为零。
pub struct ABIValue {
    size int;
    align int;
    aggregate int;
    fp_size int;
    fp_count int;
}

// ABICursor 保存一份签名分配到当前参数前的状态。Darwin 的栈参数使用
// 自然大小与对齐，Linux 的每个槽至少八字节；最终调用区统一十六字节对齐。
pub struct ABICursor {
    gpr int;
    fpr int;
    stack int;
    darwin int;
}

// ABIArg 是单个逻辑参数/返回值的位置计划。寄存器片连续；stack 是调用时
// SP 起的字节偏移；indirect 表示按调用方副本地址传参或按 x8 返回。
pub struct ABIArg {
    kind int;
    reg int;
    count int;
    stack int;
    indirect int;
    size int;
    fp_size int;
}

// abi_c_cursor_init：开始一份独立签名分类，调用方显式指定目标平台。
pub fn abi_c_cursor_init(c *ABICursor, darwin int) void {
    c.gpr = 0;
    c.fpr = 0;
    c.stack = 0;
    c.darwin = darwin;
}

// abi_c_place：按 AAPCS64/Apple arm64 固定参数规则分配一个值。
// HFA 先于大聚合处理；HFA/GPR 聚合均不拆分到寄存器与栈。
pub fn abi_c_place(v *ABIValue, c *ABICursor, out *ABIArg) void {
    out.kind = CABI_VOID;
    out.reg = 0;
    out.count = 0;
    out.stack = 0;
    out.indirect = 0;
    out.size = v.size;
    out.fp_size = v.fp_size;
    if (v.size == 0) { return; }
    let size int = v.size;
    let align int = v.align;
    if (v.fp_count > 0) {
        if (c.fpr + v.fp_count <= 8) {
            out.kind = CABI_FPR;
            out.reg = c.fpr;
            out.count = v.fp_count;
            c.fpr += v.fp_count;
            return;
        }
        c.fpr = 8;
    } else {
        if (v.aggregate != 0 && size > 16) {
            out.indirect = 1;
            size = 8;
            align = 8;
        }
        let count int = (size + 7) / 8;
        if (align >= 16 && c.darwin == 0) { c.gpr = (c.gpr + 1) / 2 * 2; }
        if (c.gpr + count <= 8) {
            out.kind = CABI_GPR;
            out.reg = c.gpr;
            out.count = count;
            c.gpr += count;
            return;
        }
        c.gpr = 8;
    }
    if (c.darwin == 0) {
        if (align < 8) { align = 8; }
        size = (size + 7) / 8 * 8;
    }
    c.stack = (c.stack + align - 1) / align * align;
    out.kind = CABI_STACK;
    out.stack = c.stack;
    c.stack += size;
}

// abi_c_hfa：递归识别 f32/f64 同构聚合，返回 base_size*8+元素数；零为非 HFA。
// 联合体按最大成员元素数分类；结构体按元素数相加，数组按长度相乘。
fn abi_c_hfa(tid int) int {
    let t CType = g_state.task.t_types[tid];
    if (t.kind == TY_F32 || t.kind == TY_F64) { return t.size * 8 + 1; }
    if (t.kind == TY_ARRAY) {
        let elem int = abi_c_hfa(t.elem);
        let count int = (elem % 8) * t.len;
        if (elem == 0 || count < 1 || count > 4) { return 0; }
        return elem / 8 * 8 + count;
    }
    if (t.kind != TY_STRUCT && t.kind != TY_UNION) { return 0; }
    let base int = 0;
    let count int = 0;
    let i int = 0;
    for i < t.len {
        let part int = abi_c_hfa(g_state.task.t_fields[t.sub + i].type_id);
        if (part == 0) { return 0; }
        if (base == 0) { base = part / 8; }
        if (base != part / 8) { return 0; }
        if (t.kind == TY_UNION) {
            if (part % 8 > count) { count = part % 8; }
        } else {
            count += part % 8;
        }
        if (count > 4) { return 0; }
        i += 1;
    }
    if (count == 0 || t.size != base * count) { return 0; }
    return base * 8 + count;
}

// abi_c_describe：把前端类型布局转换为共享分类器输入，不进行任何发射。
fn abi_c_describe(tid int, out *ABIValue) void {
    let t CType = g_state.task.t_types[tid];
    out.size = t.size;
    out.align = t.align;
    out.aggregate = (t.kind == TY_STRUCT || t.kind == TY_UNION).to_type(int);
    out.fp_size = 0;
    out.fp_count = 0;
    let hfa int = abi_c_hfa(tid);
    if (hfa != 0) {
        out.fp_size = hfa / 8;
        out.fp_count = hfa % 8;
    }
}

// abi_c_result：返回位置等同于首个参数的位置，普通大聚合的地址改用 x8。
fn abi_c_result(tid int, out *ABIArg) void {
    let value ABIValue;
    abi_c_describe(tid, &value);
    let cursor ABICursor;
    abi_c_cursor_init(&cursor, tg_darwin());
    abi_c_place(&value, &cursor, out);
    if (out.indirect != 0) { out.reg = 8; }
}

// abi_c_signature：为固定参数生成调用、入口共用的位置计划，返回对齐后的栈大小。
fn abi_c_signature(sig int, args *ABIArg, result *ABIArg) int {
    let cursor ABICursor;
    abi_c_cursor_init(&cursor, tg_darwin());
    let i int = 0;
    for i < g_state.task.t_sig_np[sig] {
        let value ABIValue;
        abi_c_describe(g_state.task.t_sig_params[g_state.task.t_sig_first[sig] + i], &value);
        abi_c_place(&value, &cursor, &args[i]);
        i += 1;
    }
    abi_c_result(g_state.task.t_sig_ret[sig], result);
    return (cursor.stack + 15) / 16 * 16;
}
