module gen
import token
import support

// ============================================================================
// symbols.yh —— 前端语义（一）：名字池、类型表、符号/作用域、类型兼容
//
// 平台无关层（多平台架构见 docs/03-design/yh-架构设计.md §3、§6.9）：只引用
// target.yh 的数据模型；代码发射在 backend/ 的 LLVM 层，本文件不含 ISA 细节。
//
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// 类型/符号常量集中在 model.yh（先声明后使用）。
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// ============================================================================
// 类型表
// ============================================================================

// sem_err：带当前 token 位置的语义错误（返回 -1 便于链式返回）。
// token 游标与 err_tok 在 token 模块，gen 只转发语义层惯用名。
pub fn sem_err(msg *char) int {
    return token.err_tok(msg)
}

// intvec_grow：int 数组统一扩容。
fn intvec_grow(vec **int, n int, cap *int) int {
    if (n < *cap) {
        return 0
    }
    let ncap int = *cap * 2
    if (ncap == 0) {
        ncap = 64
    }
    let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
    if (nd == 0) {
        return support.fail("内存分配失败")
    }
    if (n > 0) {
        memcpy(nd, *vec, (n * sizeof(int)).to_type(u64))
    }
    free(*vec)
    *vec = nd
    *cap = ncap
    return 0
}

// ty_push：向类型表追加条目，返回新类型编号。
// ms().home 平行数组同步增长（类型归属：-1 本地 / >=0 模块编号）。
pub fn ty_push(kind int, size int, align int, elem int, n int, sub int) int {
    return support.model_type_push(kind, size, align, elem, n, sub)
}

// ty_register_builtins：登记 0..12 号内建类型（固定编号，勿改顺序）。
pub fn ty_register_builtins() int {
    ty_push(TY_VOID, 0, 0, -1, -1, -1)
    ty_push(TY_BOOL, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1)
    ty_push(TY_CHAR, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1)
    ty_push(TY_I8, 1, 1, -1, -1, -1)
    ty_push(TY_I16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1)
    ty_push(TY_I32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1)
    ty_push(TY_I64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1)
    ty_push(TY_U8, 1, 1, -1, -1, -1)
    ty_push(TY_U16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1)
    ty_push(TY_U32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1)
    ty_push(TY_U64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1)
    ty_push(TY_F32, 4, 4, -1, -1, -1)
    ty_push(TY_F64, 8, 8, -1, -1, -1)
    return 0
}

// ty_push_agg：登记聚合类型并检查登记上限。
// 与方案 §4 一致：保留 512 的聚合类型登记上限，超限必须干净报错，
// 不能越界（对应 tests/yh-run/fail/12-wraps-too-many.yh）。
pub fn ty_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    return support.model_type_push_agg(kind, size, align, elem, n, sub)
}

// ty_ptr：指向 elem 的指针类型（按内容去重）。
pub fn ty_ptr(elem int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == TY_PTR && support.ms().types[i].elem == elem) {
            return i
        }
        i += 1
    }
    return ty_push(TY_PTR, TG_PTR_SIZE, TG_PTR_SIZE, elem, -1, -1)
}

// ty_array：[len] elem 定长数组类型（按内容去重）。
pub fn ty_array(elem int, alen int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == TY_ARRAY && support.ms().types[i].elem == elem && support.ms().types[i].len == alen) {
            return i
        }
        i += 1
    }
    let esz int = support.ms().types[elem].size
    let eal int = support.ms().types[elem].align
    if (eal < 1) {
        eal = 1
    }
    let size int = esz * alen
    let rpad int = (0 - size) % eal
    if (rpad < 0) {
        rpad += eal
    }
    size += rpad
    return ty_push_agg(TY_ARRAY, size, eal, elem, alen, -1)
}

// ty_slice：切片类型 []T = {u64 长度, T *数据}（16 字节聚合视图）。
// 去重按元素类型；元素类型参与同型判断（ADR-0001/0002）。
pub fn ty_slice(elem int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == TY_SLICE && support.ms().types[i].elem == elem) {
            return i
        }
        i += 1
    }
    return ty_push(TY_SLICE, TG_LONG_SIZE * 2, TG_LONG_SIZE, elem, -1, -1)
}

// ty_sig_add：追加签名（返回/参数数/变参标志），返回签名号。
// ms().sig_first 由调用方在登记参数后填池内起始下标。
fn ty_sig_add(ret int, np int, vararg int) int {
    if (intvec_grow(&support.ms().sig_ret, support.ms().sig_n, &support.ms().sig_rcap) != 0) { return -1 }
    if (intvec_grow(&support.ms().sig_np, support.ms().sig_n, &support.ms().sig_ncap) != 0) { return -1 }
    if (intvec_grow(&support.ms().sig_vararg, support.ms().sig_n, &support.ms().sig_vcap) != 0) { return -1 }
    if (intvec_grow(&support.ms().sig_first, support.ms().sig_n, &support.ms().sig_fcap) != 0) { return -1 }
    if (intvec_grow(&support.ms().sig_abi, support.ms().sig_n, &support.ms().sig_acap) != 0) { return -1 }
    support.ms().sig_abi[support.ms().sig_n] = ABI_YH
    support.ms().sig_ret[support.ms().sig_n] = ret
    support.ms().sig_np[support.ms().sig_n] = np
    support.ms().sig_vararg[support.ms().sig_n] = vararg
    support.ms().sig_n += 1
    return support.ms().sig_n - 1
}

// ty_sig_param：向参数类型池追加一个参数类型。
pub fn ty_sig_param(tid int) int {
    if (intvec_grow(&support.ms().sig_params, support.ms().sigparam_n, &support.ms().sigparam_cap) != 0) {
        return -1
    }
    support.ms().sig_params[support.ms().sigparam_n] = tid
    support.ms().sigparam_n += 1
    return 0
}

// ty_fn：函数类型（签名按内容去重：返回 + 参数个数 + 逐个参数类型）。
// ty_fn_abi：按调用约定、返回与完整参数签名去重，禁止 C/yh 函数值混用。
pub fn ty_fn_abi(ret int, first int, np int, vararg int, abi int) int {
    let i int = 0
    for i < support.ms().type_n {
        if (support.ms().types[i].kind == TY_FN) {
            let s int = support.ms().types[i].sub
            if (support.ms().sig_abi[s] == abi && support.ms().sig_ret[s] == ret && support.ms().sig_np[s] == np && support.ms().sig_vararg[s] == vararg) {
                let match int = 1
                let j int = 0
                for j < np {
                    if (support.ms().sig_params[support.ms().sig_first[s] + j] != support.ms().sig_params[first + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    return i
                }
            }
        }
        i += 1
    }
    let ns int = ty_sig_add(ret, np, vararg)
    if (ns < 0) { return -1 }
    support.ms().sig_abi[ns] = abi
    support.ms().sig_first[ns] = first
    return ty_push(TY_FN, TG_PTR_SIZE, TG_PTR_SIZE, ret, np, ns)
}

// ty_fn：构造普通 yh 函数类型，保留原有内部调用接口。
pub fn ty_fn(ret int, first int, np int, vararg int) int {
    return ty_fn_abi(ret, first, np, vararg, ABI_YH)
}

// ty_is_scalar：可放进寄存器的标量（整数/浮点/指针/fn）。
pub fn ty_is_scalar(tid int) int {
    let k int = support.ms().types[tid].kind
    if (k == TY_PTR || k == TY_FN) {
        return 1
    }
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE || k == TY_VOID) {
        return 0
    }
    return 1
}

// ============================================================================
// 名字空间与符号表
// ============================================================================

// ty_lookup_name：按名字查类型。找不到返回 -1。
pub fn ty_lookup_name(start int, n int) int {
    let i int = support.ms().name_n - 1
    for i >= 0 {
        if (support.ms().names[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.ms().names[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return support.ms().names[i].type_id
            }
        }
        i -= 1
    }
    return -1
}

// ty_declare_name：登记类型名字（重复定义报错，含首次声明位置）。
// is_pub/form 取自调用方设置的全局（support.fc().c_decl_pub / support.ms().name_form）。
pub fn ty_declare_name(off int, n int, tid int) int {
    let prev int = ty_lookup_name_off(off, n)
    if (prev >= 0) {
        // 找到先前登记项的位置一并报告
        let pi int = support.ms().name_n - 1
        for pi >= 0 {
            if (support.ms().names[pi].name_len == n
                && support.pool_ctx().data[support.ms().names[pi].name_off] == support.pool_ctx().data[off]) {
                let match int = 1
                let j int = 1
                for j < n {
                    if (support.pool_ctx().data[support.ms().names[pi].name_off + j] != support.pool_ctx().data[off + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    break
                }
            }
            pi -= 1
        }
        if (pi >= 0 && support.diag().spec == 0) {
            let buf [128]u8
            let bn int = 0
            bn = support.append_str(buf, bn, "类型重定义（首次声明于 ")
            bn = support.append_int(buf, bn, support.ms().names[pi].def_line)
            bn = support.append_byte(buf, bn, ':')
            bn = support.append_int(buf, bn, support.ms().names[pi].def_col)
            bn = support.append_str(buf, bn, "）")
            let mo int = support.tml_intern_str(buf, 0, bn)
            if (mo < 0) {
                return -1
            }
            return token.err_tok(support.np_cstr(mo))
        }
        return token.err_tok("类型重定义")
    }
    if (support.ms().name_n == support.ms().name_cap) {
        let ncap int = support.ms().name_cap * 2
        if (ncap == 0) {
            ncap = 64
        }
        let nd *TName = malloc((ncap * sizeof(TName)).to_type(u64)).to_type(*TName)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (support.ms().name_n > 0) {
            memcpy(nd, support.ms().names, (support.ms().name_n * sizeof(TName)).to_type(u64))
        }
        free(support.ms().names)
        support.ms().names = nd
        support.ms().name_cap = ncap
    }
    support.ms().names[support.ms().name_n].name_off = off
    support.ms().names[support.ms().name_n].name_len = n
    support.ms().names[support.ms().name_n].type_id = tid
    support.ms().names[support.ms().name_n].is_pub = support.fc().c_decl_pub
    support.ms().names[support.ms().name_n].form = support.ms().name_form
    support.ms().names[support.ms().name_n].attrs = support.fc().c_decl_attrs
    support.ms().names[support.ms().name_n].def_line = token.ctx().tokens[token.ctx().pos].line
    support.ms().names[support.ms().name_n].def_col = token.ctx().tokens[token.ctx().pos].col
    support.ms().name_n += 1
    return 0
}

// ty_name_attrs：合并同一底层类型的具名别名属性，保留 C/opaque 类型身份。
pub fn ty_name_attrs(tid int) int {
    let attrs int = 0
    let i int = 0
    for i < support.ms().name_n {
        if (support.ms().names[i].type_id == tid) {
            attrs |= support.ms().names[i].attrs
        }
        i += 1
    }
    return attrs
}

// ty_add_name_attrs：为刚登记的具名类型补充解析结束后才能确定的属性。
pub fn ty_add_name_attrs(tid int, attrs int) int {
    let found int = 0
    let i int = 0
    for i < support.ms().name_n {
        if (support.ms().names[i].type_id == tid) {
            support.ms().names[i].attrs |= attrs
            found = 1
        }
        i += 1
    }
    if (found == 0) { return support.fail("内部错误：类型属性找不到具名类型") }
    return 0
}

// ty_is_opaque：判断底层类型是否由 extern 空 struct/union 声明为不透明类型。
pub fn ty_is_opaque(tid int) int {
    return ((ty_name_attrs(tid) & ATTR_OPAQUE) != 0).to_type(int)
}

// ty_has_opaque_value：数组/切片等复合值不得把不透明 C 对象按值存储。
pub fn ty_has_opaque_value(tid int) int {
    if (ty_is_opaque(tid) != 0) { return 1 }
    let kind int = support.ms().types[tid].kind
    if (kind == TY_ARRAY || kind == TY_SLICE) {
        return ty_has_opaque_value(support.ms().types[tid].elem)
    }
    return 0
}

// ty_cabi_scalar：可在 C ABI 固定参数与返回值中按值传递的标量。
fn ty_cabi_scalar(tid int) int {
    let kind int = support.ms().types[tid].kind
    if (kind >= TY_BOOL && kind <= TY_F64) { return 1 }
    if (kind == TY_PTR) { return 1 }
    if (kind == TY_ENUM && (ty_name_attrs(tid) & ATTR_EXTERN) != 0) { return 1 }
    return 0
}

// ty_cabi_param：允许 C 标量、具备共享布局的聚合及完整 C 函数指针。
// 顶层数组不按值传递；切片和不透明值始终拒绝，数组仅可作为聚合字段。
pub fn ty_cabi_param(tid int) int {
    if (ty_cabi_scalar(tid) != 0) { return 1 }
    let kind int = support.ms().types[tid].kind
    if (kind == TY_STRUCT || kind == TY_UNION) { return ty_c_layout(tid) }
    if (kind != TY_FN) { return 0 }
    let sig int = support.ms().types[tid].sub
    if (support.ms().sig_abi[sig] != ABI_C || support.ms().sig_vararg[sig] != 0) { return 0 }
    let ret int = support.ms().sig_ret[sig]
    if (ret != TY_VOID && ty_cabi_param(ret) == 0) { return 0 }
    let i int = 0
    for i < support.ms().sig_np[sig] {
        if (ty_cabi_param(support.ms().sig_params[support.ms().sig_first[sig] + i]) == 0) { return 0 }
        i += 1
    }
    return 1
}

// ty_c_layout：判断值布局可否直接嵌入 extern struct/union 的 C 共享布局。
pub fn ty_c_layout(tid int) int {
    let kind int = support.ms().types[tid].kind
    if (kind >= TY_BOOL && kind <= TY_F64) { return 1 }
    if (kind == TY_PTR) { return 1 }
    if (kind == TY_FN) { return ty_cabi_param(tid) }
    if (kind == TY_ARRAY) { return ty_c_layout(support.ms().types[tid].elem) }
    if (kind == TY_ENUM) {
        return ((ty_name_attrs(tid) & ATTR_EXTERN) != 0).to_type(int)
    }
    if (kind == TY_STRUCT || kind == TY_UNION) {
        return ((ty_name_attrs(tid) & (ATTR_EXTERN | ATTR_OPAQUE)) == ATTR_EXTERN).to_type(int)
    }
    return 0
}

// ty_lookup_name_off：按池偏移查类型名（登记去重用）。
fn ty_lookup_name_off(off int, n int) int {
    let i int = support.ms().name_n - 1
    for i >= 0 {
        if (support.ms().names[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.ms().names[i].name_off + j] != support.pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return support.ms().names[i].type_id
            }
        }
        i -= 1
    }
    return -1
}

// sym_push：登记符号（名字先 intern 进池）。返回符号下标。
// 模块模式下对全局声明做重复检查（同模块重复顶层声明报两个位置）；
// 单文件模式行为不变（不检查）。
pub fn sym_push(start int, n int, kind int, tid int, flags int) int {
    let off int = support.name_intern(start, n)
    if (off < 0) {
        return -1
    }
    if (support.cfg().module_mode != 0 && (flags & F_GLOBAL) != 0 && (flags & F_EXTERN) == 0) {
        // 模块模式：全局（含 enum 成员）重名报错；首次位置一并报告
        let di int = 0
        for di < support.ms().sym_n {
            if ((support.ms().syms[di].flags & F_GLOBAL) != 0 && support.ms().syms[di].name_len == n
                && support.pool_ctx().data[support.ms().syms[di].name_off] == support.pool_ctx().data[off]) {
                let match int = 1
                let j int = 1
                for j < n {
                    if (support.pool_ctx().data[support.ms().syms[di].name_off + j] != support.pool_ctx().data[off + j]) {
                        match = 0
                        break
                    }
                    j += 1
                }
                if (match != 0) {
                    if (support.diag().spec == 0) {
                        let buf [128]u8
                        let bn int = 0
                        bn = support.append_str(buf, bn, "重复的顶层声明（首次声明于 ")
                        bn = support.append_int(buf, bn, support.ms().syms[di].def_line)
                        bn = support.append_byte(buf, bn, ':')
                        bn = support.append_int(buf, bn, support.ms().syms[di].def_col)
                        bn = support.append_str(buf, bn, "）")
                        let mo int = support.tml_intern_str(buf, 0, bn)
                        if (mo < 0) {
                            return -1
                        }
                        return token.err_tok(support.np_cstr(mo))
                    }
                    return -1
                }
            }
            di += 1
        }
    }
    if (support.ms().sym_n == support.ms().sym_cap) {
        let ncap int = support.ms().sym_cap * 2
        if (ncap == 0) {
            ncap = 256
        }
        let nd *CSym = malloc((ncap * sizeof(CSym)).to_type(u64)).to_type(*CSym)
        if (nd == 0) {
            support.fail("内存分配失败")
            return -1
        }
        if (support.ms().sym_n > 0) {
            memcpy(nd, support.ms().syms, (support.ms().sym_n * sizeof(CSym)).to_type(u64))
        }
        free(support.ms().syms)
        support.ms().syms = nd
        support.ms().sym_cap = ncap
    }
    support.ms().syms[support.ms().sym_n].name_off = off
    support.ms().syms[support.ms().sym_n].name_len = n
    support.ms().syms[support.ms().sym_n].kind = kind
    support.ms().syms[support.ms().sym_n].type_id = tid
    support.ms().syms[support.ms().sym_n].offset = 0
    support.ms().syms[support.ms().sym_n].flags = flags
    support.ms().syms[support.ms().sym_n].cval = 0
    support.ms().syms[support.ms().sym_n].const_ready = 0
    support.ms().syms[support.ms().sym_n].const_expr_off = -1
    support.ms().syms[support.ms().sym_n].const_expr_len = 0
    support.ms().syms[support.ms().sym_n].const_expr_kind = 0
    support.ms().syms[support.ms().sym_n].def_line = token.ctx().tokens[token.ctx().pos].line
    support.ms().syms[support.ms().sym_n].def_col = token.ctx().tokens[token.ctx().pos].col
    support.ms().syms[support.ms().sym_n].ast_binding_row = -1
    support.ms().sym_n += 1
    return support.ms().sym_n - 1
}

// sym_push_lit：以池内已有名字登记符号（prelude 用）。
fn sym_push_lit(off int, n int, kind int, tid int, flags int) int {
    let tmp int = support.ms().sym_n
    let idx int = sym_push(0, 0, kind, tid, flags)
    if (idx < 0) {
        return -1
    }
    support.ms().syms[idx].name_off = off
    support.ms().syms[idx].name_len = n
    return idx
}

// sym_push_pool：以名字池中已有的名字登记符号（函数 check 缓存导入用）。
// 不做全局重名检查；调用方负责只对函数局部符号使用。
pub fn sym_push_pool(off int, n int, kind int, tid int, flags int) int {
    let idx int = sym_push_lit(off, n, kind, tid, flags)
    return idx
}




// scope_push / scope_pop：进入/退出块作用域（退出即截断符号）。
pub fn scope_push() int {
    support.ms().scope_start[support.ms().scope_n] = support.ms().sym_n
    support.ms().scope_n += 1
    return 0
}

pub fn scope_pop() int {
    support.ms().scope_n -= 1
    support.ms().sym_n = support.ms().scope_start[support.ms().scope_n]
    return 0
}

// ============================================================================
// 常量折叠辅助
// ============================================================================

// fold_binop：两个常量的二元运算（i64 位型；除零干净报错）。
fn fold_binop(op int, a i64, b i64) i64 {
    if (op == TK_PLUS) { return a + b }
    if (op == TK_MINUS) { return a - b }
    if (op == TK_STAR) { return a * b }
    if (op == TK_SLASH) {
        if (b == 0) {
            token.err_tok("常量除以零")
            return 0
        }
        return a / b
    }
    if (op == TK_PERCENT) {
        if (b == 0) {
            token.err_tok("常量模零")
            return 0
        }
        return a % b
    }
    if (op == TK_AMP) { return a & b }
    if (op == TK_PIPE) { return a | b }
    if (op == TK_CARET) { return a ^ b }
    if (op == TK_LSHIFT) { return a << b }
    if (op == TK_RSHIFT) { return a >> b }
    if (op == TK_EQEQ) { return (a == b).to_type(i64) }
    if (op == TK_NEQ) { return (a != b).to_type(i64) }
    if (op == TK_LT) { return (a < b).to_type(i64) }
    if (op == TK_LEQ) { return (a <= b).to_type(i64) }
    if (op == TK_GT) { return (a > b).to_type(i64) }
    if (op == TK_GEQ) { return (a >= b).to_type(i64) }
    return 0
}

// fold_unary：对常量做一元运算。
pub fn fold_unary(op int, a i64) i64 {
    if (op == TK_MINUS) { return -a }
    if (op == TK_PLUS) { return a }
    if (op == TK_TILDE) { return ~a }
    if (op == TK_BANG) { return (a == 0).to_type(i64) }
    return a
}

// sem_parse_number：解析数字字面量文本（十六/二/八/十进制与下划线），
// 结果写 support.fc().c_fold_ival（位型）与 support.fc().c_fold_big（超出 i64 正数域标志）。

pub fn sem_parse_number(start int, n int) int {
    let i int = start
    let end int = start + n
    let v i64 = 0
    let big int = 0
    let base i64 = 10
    if (support.src_ctx().data[i] == '0' && i + 1 < end) {
        let p2 u8 = support.src_ctx().data[i + 1]
        if (p2 == 'x' || p2 == 'X') { base = 16; i += 2 }
        if (p2 == 'b' || p2 == 'B') { base = 2; i += 2 }
        if (p2 == 'o' || p2 == 'O') { base = 8; i += 2 }
    }
    for i < end {
        let b u8 = support.src_ctx().data[i]
        if (b == '_') {
            i += 1
            continue
        }
        let d i64 = 0
        if (b >= '0' && b <= '9') {
            d = (b - '0').to_type(i64)
        } else if (b >= 'a' && b <= 'f') {
            d = ((b - 'a') + 10).to_type(i64)
        } else if (b >= 'A' && b <= 'F') {
            d = ((b - 'A') + 10).to_type(i64)
        } else {
            return token.err_tok("数字字面量含非法字符")
        }
        v = v * base + d
        if (v < 0) {
            big = 1
        }
        i += 1
    }
    support.fc().c_fold_ival = v
    support.fc().c_fold_big = big
    return 0
}

// ============================================================================
// 类型兼容
// ============================================================================

// sym_declared_before：符号声明点是否早于位置 (line, col)（同文件比较）。
// 用于保持「普通全局 const 按声明顺序求值」的既有规则：只有声明在前的常量
// 才允许在布局子遍提前求值，前向引用仍报「编译期常量尚未就绪」。
pub fn sym_declared_before(sym int, line int, col int) int {
    if (sym < 0 || sym >= support.ms().sym_n) { return 0 }
    let dl int = support.ms().syms[sym].def_line
    let dc int = support.ms().syms[sym].def_col
    if (dl < line) { return 1 }
    if (dl == line && dc < col) { return 1 }
    return 0
}

// sem_lit_fits：字面量位型值是否落在整数类型可表示范围内。
// ast 的 SSA 降低用它做**字面量适配**（与 sem_binop 同判据），故为 pub。
pub fn sem_lit_fits(tid int, v i64) int {
    let k int = support.ms().types[tid].kind
    if (k == TY_U8) { return ((v >= 0) && (v <= 255)).to_type(int) }
    if (k == TY_U16) { return ((v >= 0) && (v <= 65535)).to_type(int) }
    if (k == TY_U32) { return ((v >= 0) && (v <= 4294967295)).to_type(int) }
    if (k == TY_U64) { return 1 }
    if (k == TY_I8) { return ((v >= -128) && (v <= 127)).to_type(int) }
    if (k == TY_I16) { return ((v >= -32768) && (v <= 32767)).to_type(int) }
    if (k == TY_I32 || k == TY_ENUM) {
        return ((v >= -2147483648) && (v <= 2147483647)).to_type(int)
    }
    if (k == TY_I64) { return 1 }
    if (k == TY_CHAR) { return ((v >= 0) && (v <= 255)).to_type(int) }
    if (k == TY_BOOL) { return ((v == 0) || (v == 1)).to_type(int) }
    return 1
}

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。
pub fn sem_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    if (dst == src) {
        return 0
    }
    let dk int = support.ms().types[dst].kind
    let sk int = support.ms().types[src].kind
    // 聚合：同型已在上面通过；不同类型（含长度不同）一律拒绝
    if ((dk == TY_STRUCT || dk == TY_UNION || dk == TY_ARRAY || dk == TY_SLICE)
        && (sk == TY_STRUCT || sk == TY_UNION || sk == TY_ARRAY || sk == TY_SLICE)) {
        // 数组是结构化类型：编译期布局会为延迟长度表达式建立独立类型项，
        // 与同元素类型、同长度的既有数组项完全等价，按内容放行。
        if (dk == TY_ARRAY && sk == TY_ARRAY
            && support.ms().types[dst].elem == support.ms().types[src].elem
            && support.ms().types[dst].len == support.ms().types[src].len) {
            return 0
        }
        return sem_err("聚合类型不匹配（长度或元素类型不同）")
    }
    if (dk == TY_PTR) {
        // 字面量 0 = 空指针（最宽匹配，先判）
        if (is_lit != 0 && ival == 0) {
            return 0
        }
        if (sk == TY_PTR) {
            if (support.ms().types[dst].elem == TY_VOID || support.ms().types[src].elem == TY_VOID) {
                return 0
            }
            return sem_err("指针类型不匹配（需要 .to_type 显式转换）")
        }
        if (sk == TY_FN && support.ms().types[dst].elem == TY_VOID) {
            return 0
        }
        return sem_err("不能把非指针值赋给指针")
    }
    if (sk == TY_PTR) {
        return sem_err("不能把指针赋给非指针（用 .to_type）")
    }
    if (dk == TY_FN || sk == TY_FN) {
        if (dk == TY_FN && sk == TY_FN) {
            return sem_err("函数签名不匹配")
        }
        return sem_err("fn 值只能赋给同签名类型或 *void")
    }
    if (support.ty_is_float(dst) != 0 || support.ty_is_float(src) != 0) {
        if (dk == sk) {
            return 0
        }
        return sem_err("浮点与整数之间需要 .to_type 显式转换")
    }
    if (dk == TY_BOOL && sk != TY_BOOL) {
        return sem_err("整数不能隐式转为 bool（用 .to_type(bool)）")
    }
    if (sk == TY_BOOL && support.ty_is_integer(dst) == 0 && dk != TY_BOOL) {
        return sem_err("bool 不能隐式转为该类型")
    }
    if (support.ty_is_integer(dst) == 0 || support.ty_is_integer(src) == 0) {
        return sem_err("类型不匹配")
    }
    let dsz int = support.ms().types[dst].size
    let ssz int = support.ms().types[src].size
    if (is_lit != 0) {
        if (big != 0 && dk != TY_U64) {
            return sem_err("字面量超出目标类型可表示范围")
        }
        if (sem_lit_fits(dst, ival) != 0) {
            return 0
        }
        return sem_err("字面量超出目标类型可表示范围")
    }
    if (dsz > ssz) {
        return 0
    }
    if (dsz == ssz) {
        if (dk == sk) {
            return 0
        }
        if (dk == TY_ENUM || sk == TY_ENUM) {
            return 0
        }
        return sem_err("同宽整数之间需要 .to_type 显式转换")
    }
    return sem_err("不允许的隐式窄化（用 .to_type）")
}

// sem_promote：二元运算公共类型（常规算术转换子集）。
pub fn sem_promote(a int, b int) int {
    if (a == b) {
        return a
    }
    let ak int = support.ms().types[a].kind
    let bk int = support.ms().types[b].kind
    if (ak == TY_BOOL) { a = TY_I32 }
    if (bk == TY_BOOL) { b = TY_I32 }
    if (ak == TY_CHAR) { a = TY_I32 }
    if (bk == TY_CHAR) { b = TY_I32 }
    if (ak == TY_ENUM) { a = TY_I32 }
    if (bk == TY_ENUM) { b = TY_I32 }
    if (a == b) {
        return a
    }
    if (support.ty_is_float(a) != 0 && support.ty_is_float(b) != 0) {
        if (support.ms().types[a].size >= support.ms().types[b].size) {
            return a
        }
        return b
    }
    if (support.ty_is_float(a) != 0 || support.ty_is_float(b) != 0) {
        // 调用方已先行拒绝；此处返回较大一方兜底
        if (support.ms().types[a].size >= support.ms().types[b].size) {
            return a
        }
        return b
    }
    let asz int = support.ms().types[a].size
    let bsz int = support.ms().types[b].size
    let aus int = (support.ty_is_signed(a) == 0).to_type(int)
    let bus int = (support.ty_is_signed(b) == 0).to_type(int)
    let size int = asz
    if (bsz > size) {
        size = bsz
    }
    let uns int = aus | bus
    if (size == 1) {
        if (uns != 0) { return TY_U8 }
        return TY_I8
    }
    if (size == 2) {
        if (uns != 0) { return TY_U16 }
        return TY_I16
    }
    if (size == 4) {
        if (uns != 0) { return TY_U32 }
        return TY_I32
    }
    if (uns != 0) { return TY_U64 }
    return TY_I64
}

// ============================================================================
// prelude 登记
// ============================================================================

// sem_init_tables：为全部堆分配的全局表分配空间（编译模式启动时调用一次）。
// stage0 每个编译单元只允许一个全局数组字面量，因此这些表统一走堆。
pub fn sem_init_tables() int {
    let n4 u64 = (4 * 64).to_type(u64)
    support.ms().scope_start = support.alloc(n4).to_type(*int)
    support.fc().c_brk_stk = support.alloc(n4).to_type(*int)
    support.fc().c_cnt_stk = support.alloc(n4).to_type(*int)
    support.fc().c_loop_break_seen = support.alloc(n4).to_type(*int)
    support.fc().c_glabels = support.alloc((sizeof(GLabel) * 128).to_type(u64)).to_type(*GLabel)
    support.fc().c_args = support.alloc((sizeof(Res) * 256).to_type(u64)).to_type(*Res)
    support.fc().c_argtys = support.alloc((4 * 256).to_type(u64)).to_type(*int)
    support.fc().c_spill_reg = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_spill_off = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_spill_size = support.alloc((4 * 16).to_type(u64)).to_type(*int)
    support.fc().c_call_base = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_call_abi = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_call_direct = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_arg_agg = support.alloc((4 * 256).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_indirect = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_src = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_dst = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_aggparam_size = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_lit_save_off = support.alloc((4 * 32).to_type(u64)).to_type(*int)
    support.fc().c_lit_save_tid = support.alloc((4 * 32).to_type(u64)).to_type(*int)
    support.fc().c_fi_kind = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_cnt_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_len_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_data_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_step_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_elem_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_fi_idx_off = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().c_bss_syms = support.alloc((4 * 4096).to_type(u64)).to_type(*int)
    support.fc().sc_sc_false_stk = support.alloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().sc_sc_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().tn_else_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    support.fc().tn_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int)
    if (support.ms().scope_start == 0 || support.fc().c_brk_stk == 0 || support.fc().c_cnt_stk == 0
        || support.fc().c_loop_break_seen == 0
        || support.fc().c_glabels == 0 || support.fc().c_args == 0 || support.fc().c_argtys == 0
        || support.fc().c_spill_reg == 0 || support.fc().c_spill_off == 0 || support.fc().c_spill_size == 0
        || support.fc().c_call_base == 0
        || support.fc().c_call_abi == 0 || support.fc().c_call_direct == 0 || support.fc().c_arg_agg == 0
        || support.fc().c_aggparam_indirect == 0 || support.fc().c_aggparam_src == 0 || support.fc().c_aggparam_dst == 0 || support.fc().c_aggparam_size == 0
        || support.fc().c_lit_save_off == 0 || support.fc().c_lit_save_tid == 0
        || support.fc().c_fi_kind == 0 || support.fc().c_fi_cnt_off == 0 || support.fc().c_fi_len_off == 0
        || support.fc().c_fi_data_off == 0 || support.fc().c_fi_step_off == 0
        || support.fc().c_fi_elem_off == 0 || support.fc().c_fi_idx_off == 0
        || support.fc().c_bss_syms == 0
        || support.fc().sc_sc_false_stk == 0 || support.fc().sc_sc_end_stk == 0
        || support.fc().tn_else_stk == 0 || support.fc().tn_end_stk == 0) {
        return support.fail("内存分配失败")
    }
    return 0
}

// prelude_add：登记一个 prelude 外部函数（名字进池；签名进签名表）。
// 供 builtin 模块的 sem_register_prelude 使用；gen 只提供符号表原语，不认识
// 具体内置函数名。
pub fn prelude_add(name *char, ret int, np int, vararg int) int {
    let n int = 0
    for name[n] != 0 {
        n += 1
    }
    let off int = support.name_intern_lit(name)
    if (off < 0) {
        return -1
    }
    let ftid int = ty_fn(ret, support.ms().sigparam_n - np, np, vararg)
    return sym_push_lit(off, n, SYM_FN, ftid, F_EXTERN | F_PUB)
}

// mod_ns_lookup：模块命名空间查条目（want_type=1 查类型名；
// 自 parse/iface.yh 迁入使 parse_type/parse_expr 可直接调用——P3 解环）。

// mod_ns_lookup：模块命名空间查条目下标。want_type=1 查类型名，否则查值。
pub fn mod_ns_lookup(mi int, start int, n int, want_type int) int {
    let i int = 0
    for i < support.fs().mods[mi].ns_n {
        if (support.fs().mods[mi].ns[i].name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.fs().mods[mi].ns[i].name_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (want_type != 0) {
                    if (support.fs().mods[mi].ns[i].tid >= 0) {
                        return i
                    }
                    return -1
                }
                if (support.fs().mods[mi].ns[i].sym >= 0) {
                    return i
                }
                return -1
            }
        }
        i += 1
    }
    return -1
}

// mod_file_binding：当前文件导入表查绑定名（读 gen 的导入表全局；
// 自 parse/parse_expr.yh 迁入供 sizeof_starts_type 限定类型判定——P3）。

// mod_file_binding：当前文件导入表中查绑定名，返回 ModInfo 下标；无 -1。
pub fn mod_file_binding(start int, n int) int {
    if (support.fs().import_mod == 0) {
        return -1
    }
    // 按绑定名（别名）匹配：限定调用的第一段标识符是别名
    let i int = 0
    for i < support.fs().import_n {
        if (support.fs().import_mod[i] >= 0 && support.fs().imports[i].alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[support.fs().imports[i].alias_off + j] != support.src_ctx().data[start + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return support.fs().import_mod[i]
            }
        }
        i += 1
    }
    return -1
}

// mod_import_find：按绑定名（别名）在文件导入表里查找模块；找不到返回 -1。
// 供插值降级定位 fmt 的导入绑定，不依赖源码中的 token 位置。
pub fn mod_import_find(name *char, n int) int {
    if (support.fs().import_mod == 0) {
        return -1
    }
    let i int = 0
    for i < support.fs().import_n {
        let ent ImportEnt = support.fs().imports[i]
        if (support.fs().import_mod[i] >= 0 && ent.alias_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[ent.alias_off + j] != name[j].to_type(u8)) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                return support.fs().import_mod[i]
            }
        }
        i += 1
    }
    return -1
}

// mod_ns_lookup_pool：按名字池中的名字查模块导出；语义同 mod_ns_lookup。
// 供编译器合成的 fmt 调用使用（名字不来自源码 token）。
pub fn mod_ns_lookup_pool(mi int, off int, n int, want_type int) int {
    if (mi < 0 || mi >= support.fs().mod_n) {
        return -1
    }
    let i int = 0
    for i < support.fs().mods[mi].ns_n {
        let ent ModNsEnt = support.fs().mods[mi].ns[i]
        if (ent.name_len == n) {
            let match int = 1
            let j int = 0
            for j < n {
                if (support.pool_ctx().data[ent.name_off + j] != support.pool_ctx().data[off + j]) {
                    match = 0
                    break
                }
                j += 1
            }
            if (match != 0) {
                if (want_type != 0) {
                    return ent.tid >= 0 ? i : -1
                }
                return ent.sym >= 0 ? i : -1
            }
        }
        i += 1
    }
    return -1
}
