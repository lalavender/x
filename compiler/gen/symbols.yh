module gen;

// ============================================================================
// symbols.yh —— 前端语义（一）：名字池、类型表、符号/作用域、类型兼容
//
// 平台无关层（多平台架构见 docs/03-design/yh-自举后端架构.md）：只引用
// target.yh 的数据模型，调用 emit 层的 em_* 抽象机原语；不含任何 ISA 细节。
//
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// 类型/符号常量集中在 model.yh（先声明后使用）。
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// np_cstr：名字池内偏移 → NUL 结尾 C 字符串（池内字节本就带 NUL）。
pub fn np_cstr(off int) *char {
    return (np_data + off).to_type(*char);
}

// name_intern：把 [start,len) 的名字字节复制进名字池，返回池内偏移。
// 池里字节带 NUL 结尾（便于调试，不参与比较）。
pub fn name_intern(start int, n int) int {
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = c_src[start + i];
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off;
}

// name_intern_lit：登记编译器内置名字（如 prelude 符号名），返回池偏移。
pub fn name_intern_lit(s *char) int {
    let n int = 0;
    for s[n] != 0 {
        n += 1;
    }
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off2 int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = s[i].to_type(u8);
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off2;
}

// ============================================================================
// 类型表
// ============================================================================

// sem_err：带当前 token 位置的语义错误（返回 -1 便于链式返回）。
pub fn sem_err(msg *char) int {
    return err_tok(msg);
}

// intvec_grow：int 数组统一扩容。
pub fn intvec_grow(vec **int, n int, cap *int) int {
    if (n < *cap) {
        return 0;
    }
    let ncap int = *cap * 2;
    if (ncap == 0) {
        ncap = 64;
    }
    let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
    if (nd == 0) {
        return fail("内存分配失败");
    }
    if (n > 0) {
        memcpy(nd, *vec, (n * sizeof(int)).to_type(u64));
    }
    free(*vec);
    *vec = nd;
    *cap = ncap;
    return 0;
}

// ty_push：向类型表追加条目，返回新类型编号。
// t_home 平行数组同步增长（类型归属：-1 本地 / >=0 模块编号）。
pub fn ty_push(kind int, size int, align int, elem int, n int, sub int) int {
    if (t_type_n == t_type_cap) {
        let ncap int = t_type_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *CType = malloc((ncap * sizeof(CType)).to_type(u64)).to_type(*CType);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (t_type_n > 0) {
            memcpy(nd, t_types, (t_type_n * sizeof(CType)).to_type(u64));
        }
        free(t_types);
        t_types = nd;
        let nh *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nh == 0) {
            return fail("内存分配失败");
        }
        if (t_home_cap > 0) {
            memcpy(nh, t_home, (t_home_cap * sizeof(int)).to_type(u64));
        }
        if (t_home_cap > 0) {
            free(t_home);
        }
        t_home = nh;
        // 新扩容区间填 -1（本地）
        let hi int = t_home_cap;
        for hi < ncap {
            t_home[hi] = -1;
            hi += 1;
        }
        t_home_cap = ncap;
        t_type_cap = ncap;
    }
    t_types[t_type_n].kind = kind;
    t_types[t_type_n].size = size;
    t_types[t_type_n].align = align;
    t_types[t_type_n].elem = elem;
    t_types[t_type_n].len = n;
    t_types[t_type_n].sub = sub;
    t_type_n += 1;
    return t_type_n - 1;
}

// ty_register_builtins：登记 0..12 号内建类型（固定编号，勿改顺序）。
pub fn ty_register_builtins() int {
    ty_push(TY_VOID, 0, 0, -1, -1, -1);
    ty_push(TY_BOOL, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1);
    ty_push(TY_CHAR, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1);
    ty_push(TY_I8, 1, 1, -1, -1, -1);
    ty_push(TY_I16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1);
    ty_push(TY_I32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1);
    ty_push(TY_I64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1);
    ty_push(TY_U8, 1, 1, -1, -1, -1);
    ty_push(TY_U16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1);
    ty_push(TY_U32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1);
    ty_push(TY_U64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1);
    ty_push(TY_F32, 4, 4, -1, -1, -1);
    ty_push(TY_F64, 8, 8, -1, -1, -1);
    return 0;
}

// ty_push_agg：登记聚合类型并检查登记上限。
// 与方案 §4 一致：保留 512 的聚合类型登记上限，超限必须干净报错，
// 不能越界（对应 tests/yh-run/fail/12-wraps-too-many.yh）。
pub fn ty_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    if (c_aggtype_n >= 512) {
        return sem_err("聚合类型登记过多（上限 512）");
    }
    c_aggtype_n += 1;
    return ty_push(kind, size, align, elem, n, sub);
}

// ty_ptr：指向 elem 的指针类型（按内容去重）。
pub fn ty_ptr(elem int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_PTR && t_types[i].elem == elem) {
            return i;
        }
        i += 1;
    }
    return ty_push(TY_PTR, TG_PTR_SIZE, TG_PTR_SIZE, elem, -1, -1);
}

// ty_array：[len] elem 定长数组类型（按内容去重）。
pub fn ty_array(elem int, alen int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_ARRAY && t_types[i].elem == elem && t_types[i].len == alen) {
            return i;
        }
        i += 1;
    }
    let esz int = t_types[elem].size;
    let eal int = t_types[elem].align;
    if (eal < 1) {
        eal = 1;
    }
    let size int = esz * alen;
    let rpad int = (0 - size) % eal;
    if (rpad < 0) {
        rpad += eal;
    }
    size += rpad;
    return ty_push_agg(TY_ARRAY, size, eal, elem, alen, -1);
}

// ty_slice：切片类型 []T = {u64 长度, T *数据}（16 字节聚合视图）。
// 去重按元素类型；元素类型参与同型判断（ADR-0001/0002）。
pub fn ty_slice(elem int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_SLICE && t_types[i].elem == elem) {
            return i;
        }
        i += 1;
    }
    return ty_push(TY_SLICE, TG_LONG_SIZE * 2, TG_LONG_SIZE, elem, -1, -1);
}

// ty_sig_add：追加签名（返回/参数数/变参标志），返回签名号。
// t_sig_first 由调用方在登记参数后填池内起始下标。
pub fn ty_sig_add(ret int, np int, vararg int) int {
    if (intvec_grow(&t_sig_ret, t_sig_n, &t_sig_rcap) != 0) { return -1; }
    if (intvec_grow(&t_sig_np, t_sig_n, &t_sig_ncap) != 0) { return -1; }
    if (intvec_grow(&t_sig_vararg, t_sig_n, &t_sig_vcap) != 0) { return -1; }
    if (intvec_grow(&t_sig_first, t_sig_n, &t_sig_fcap) != 0) { return -1; }
    t_sig_ret[t_sig_n] = ret;
    t_sig_np[t_sig_n] = np;
    t_sig_vararg[t_sig_n] = vararg;
    t_sig_n += 1;
    return t_sig_n - 1;
}

// ty_sig_param：向参数类型池追加一个参数类型。
pub fn ty_sig_param(tid int) int {
    if (intvec_grow(&t_sig_params, t_sigparam_n, &t_sigparam_cap) != 0) {
        return -1;
    }
    t_sig_params[t_sigparam_n] = tid;
    t_sigparam_n += 1;
    return 0;
}

// ty_fn：函数类型（签名按内容去重：返回 + 参数个数 + 逐个参数类型）。
pub fn ty_fn(ret int, first int, np int, vararg int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_FN) {
            let s int = t_types[i].sub;
            if (t_sig_ret[s] == ret && t_sig_np[s] == np && t_sig_vararg[s] == vararg) {
                let match int = 1;
                let j int = 0;
                for j < np {
                    if (t_sig_params[t_sig_first[s] + j] != t_sig_params[first + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    return i;
                }
            }
        }
        i += 1;
    }
    let ns int = ty_sig_add(ret, np, vararg);
    t_sig_first[ns] = first;
    return ty_push(TY_FN, TG_PTR_SIZE, TG_PTR_SIZE, ret, np, ns);
}

// ty_is_integer：整数类（含 bool/char/enum）。
pub fn ty_is_integer(tid int) int {
    let k int = t_types[tid].kind;
    if (k >= TY_BOOL && k <= TY_U64) {
        return 1;
    }
    return (k == TY_ENUM).to_type(int);
}

// ty_is_signed：有符号整数类。
pub fn ty_is_signed(tid int) int {
    let k int = t_types[tid].kind;
    return ((k >= TY_CHAR && k <= TY_I64) || k == TY_ENUM).to_type(int);
}

// ty_is_float：浮点类。
pub fn ty_is_float(tid int) int {
    let k int = t_types[tid].kind;
    return ((k == TY_F32) || (k == TY_F64)).to_type(int);
}

// ty_is_scalar：可放进寄存器的标量（整数/浮点/指针/fn）。
pub fn ty_is_scalar(tid int) int {
    let k int = t_types[tid].kind;
    if (k == TY_PTR || k == TY_FN) {
        return 1;
    }
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE || k == TY_VOID) {
        return 0;
    }
    return 1;
}

// ty_name_text：类型可读名（诊断用）。
pub fn ty_name_text(tid int) *char {
    let k int = t_types[tid].kind;
    if (k == TY_VOID) { return "void"; }
    if (k == TY_BOOL) { return "bool"; }
    if (k == TY_CHAR) { return "char"; }
    if (k == TY_I8) { return "i8"; }
    if (k == TY_I16) { return "i16"; }
    if (k == TY_I32) { return "int"; }
    if (k == TY_I64) { return "i64"; }
    if (k == TY_U8) { return "u8"; }
    if (k == TY_U16) { return "u16"; }
    if (k == TY_U32) { return "u32"; }
    if (k == TY_U64) { return "u64"; }
    if (k == TY_F32) { return "f32"; }
    if (k == TY_F64) { return "f64"; }
    if (k == TY_PTR) { return "指针"; }
    if (k == TY_ARRAY) { return "数组"; }
    if (k == TY_SLICE) { return "切片"; }
    if (k == TY_STRUCT) { return "struct"; }
    if (k == TY_UNION) { return "union"; }
    if (k == TY_ENUM) { return "enum"; }
    if (k == TY_FN) { return "fn"; }
    return "?";
}

// ============================================================================
// 名字空间与符号表
// ============================================================================

// ty_lookup_name：按名字查类型。找不到返回 -1。
pub fn ty_lookup_name(start int, n int) int {
    let i int = t_name_n - 1;
    for i >= 0 {
        if (t_names[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_names[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return t_names[i].type_id;
            }
        }
        i -= 1;
    }
    return -1;
}

// ty_declare_name：登记类型名字（重复定义报错，含首次声明位置）。
// is_pub/form 取自调用方设置的全局（c_decl_pub / c_name_form）。
pub fn ty_declare_name(off int, n int, tid int) int {
    let prev int = ty_lookup_name_off(off, n);
    if (prev >= 0) {
        // 找到先前登记项的位置一并报告
        let pi int = t_name_n - 1;
        for pi >= 0 {
            if (t_names[pi].name_len == n
                && np_data[t_names[pi].name_off] == np_data[off]) {
                let match int = 1;
                let j int = 1;
                for j < n {
                    if (np_data[t_names[pi].name_off + j] != np_data[off + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    break;
                }
            }
            pi -= 1;
        }
        if (pi >= 0 && c_spec == 0) {
            let buf [128]u8;
            let bn int = 0;
            bn = append_str(buf, bn, "类型重定义（首次声明于 ");
            bn = append_int(buf, bn, t_names[pi].def_line);
            bn = append_byte(buf, bn, ':');
            bn = append_int(buf, bn, t_names[pi].def_col);
            bn = append_str(buf, bn, "）");
            let mo int = tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            return err_tok(np_cstr(mo));
        }
        return err_tok("类型重定义");
    }
    if (t_name_n == t_name_cap) {
        let ncap int = t_name_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *TName = malloc((ncap * sizeof(TName)).to_type(u64)).to_type(*TName);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (t_name_n > 0) {
            memcpy(nd, t_names, (t_name_n * sizeof(TName)).to_type(u64));
        }
        free(t_names);
        t_names = nd;
        t_name_cap = ncap;
    }
    t_names[t_name_n].name_off = off;
    t_names[t_name_n].name_len = n;
    t_names[t_name_n].type_id = tid;
    t_names[t_name_n].is_pub = c_decl_pub;
    t_names[t_name_n].form = c_name_form;
    t_names[t_name_n].def_line = c_toks[c_pos].line;
    t_names[t_name_n].def_col = c_toks[c_pos].col;
    t_name_n += 1;
    return 0;
}

// ty_lookup_name_off：按池偏移查类型名（登记去重用）。
pub fn ty_lookup_name_off(off int, n int) int {
    let i int = t_name_n - 1;
    for i >= 0 {
        if (t_names[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_names[i].name_off + j] != np_data[off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return t_names[i].type_id;
            }
        }
        i -= 1;
    }
    return -1;
}

// sym_push：登记符号（名字先 intern 进池）。返回符号下标。
// 模块模式下对全局声明做重复检查（同模块重复顶层声明报两个位置）；
// 单文件模式行为不变（不检查）。
pub fn sym_push(start int, n int, kind int, tid int, flags int) int {
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    if (c_module_mode != 0 && (flags & F_GLOBAL) != 0 && (flags & F_EXTERN) == 0) {
        // 模块模式：全局（含 enum 成员）重名报错；首次位置一并报告
        let di int = 0;
        for di < c_sym_n {
            if ((c_syms[di].flags & F_GLOBAL) != 0 && c_syms[di].name_len == n
                && np_data[c_syms[di].name_off] == np_data[off]) {
                let match int = 1;
                let j int = 1;
                for j < n {
                    if (np_data[c_syms[di].name_off + j] != np_data[off + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    if (c_spec == 0) {
                        let buf [128]u8;
                        let bn int = 0;
                        bn = append_str(buf, bn, "重复的顶层声明（首次声明于 ");
                        bn = append_int(buf, bn, c_syms[di].def_line);
                        bn = append_byte(buf, bn, ':');
                        bn = append_int(buf, bn, c_syms[di].def_col);
                        bn = append_str(buf, bn, "）");
                        let mo int = tml_intern_str(buf, 0, bn);
                        if (mo < 0) {
                            return -1;
                        }
                        return err_tok(np_cstr(mo));
                    }
                    return -1;
                }
            }
            di += 1;
        }
    }
    if (c_sym_n == c_sym_cap) {
        let ncap int = c_sym_cap * 2;
        if (ncap == 0) {
            ncap = 256;
        }
        let nd *CSym = malloc((ncap * sizeof(CSym)).to_type(u64)).to_type(*CSym);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (c_sym_n > 0) {
            memcpy(nd, c_syms, (c_sym_n * sizeof(CSym)).to_type(u64));
        }
        free(c_syms);
        c_syms = nd;
        c_sym_cap = ncap;
    }
    c_syms[c_sym_n].name_off = off;
    c_syms[c_sym_n].name_len = n;
    c_syms[c_sym_n].kind = kind;
    c_syms[c_sym_n].type_id = tid;
    c_syms[c_sym_n].offset = 0;
    c_syms[c_sym_n].flags = flags;
    c_syms[c_sym_n].cval = 0;
    c_syms[c_sym_n].def_line = c_toks[c_pos].line;
    c_syms[c_sym_n].def_col = c_toks[c_pos].col;
    c_syms[c_sym_n].ast_binding_row = -1;
    c_sym_n += 1;
    return c_sym_n - 1;
}

// sym_push_lit：以池内已有名字登记符号（prelude 用）。
pub fn sym_push_lit(off int, n int, kind int, tid int, flags int) int {
    let tmp int = c_sym_n;
    let idx int = sym_push(0, 0, kind, tid, flags);
    if (idx < 0) {
        return -1;
    }
    c_syms[idx].name_off = off;
    c_syms[idx].name_len = n;
    return idx;
}

// sym_lookup_off：按名字池偏移查符号（池对池比较，供构建器诊断用）。
// 只查全局层（c_scope_start[0] 以下）。找不到返回 -1。
pub fn sym_lookup_off(off int, n int) int {
    let i int = c_sym_n - 1;
    for i >= 0 {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != np_data[off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i -= 1;
    }
    return -1;
}

// sym_lookup：当前作用域链内查找（符号按名字池比较）。找不到返回 -1。
pub fn sym_lookup(start int, n int) int {
    let i int = c_sym_n - 1;
    for i >= 0 {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i -= 1;
    }
    return -1;
}

// scope_push / scope_pop：进入/退出块作用域（退出即截断符号）。
pub fn scope_push() int {
    c_scope_start[c_scope_n] = c_sym_n;
    c_scope_n += 1;
    return 0;
}

pub fn scope_pop() int {
    c_scope_n -= 1;
    c_sym_n = c_scope_start[c_scope_n];
    return 0;
}

// ============================================================================
// 常量折叠辅助
// ============================================================================

// fold_binop：两个常量的二元运算（i64 位型；除零干净报错）。
pub fn fold_binop(op int, a i64, b i64) i64 {
    if (op == TK_PLUS) { return a + b; }
    if (op == TK_MINUS) { return a - b; }
    if (op == TK_STAR) { return a * b; }
    if (op == TK_SLASH) {
        if (b == 0) {
            err_tok("常量除以零");
            return 0;
        }
        return a / b;
    }
    if (op == TK_PERCENT) {
        if (b == 0) {
            err_tok("常量模零");
            return 0;
        }
        return a % b;
    }
    if (op == TK_AMP) { return a & b; }
    if (op == TK_PIPE) { return a | b; }
    if (op == TK_CARET) { return a ^ b; }
    if (op == TK_LSHIFT) { return a << b; }
    if (op == TK_RSHIFT) { return a >> b; }
    if (op == TK_EQEQ) { return (a == b).to_type(i64); }
    if (op == TK_NEQ) { return (a != b).to_type(i64); }
    if (op == TK_LT) { return (a < b).to_type(i64); }
    if (op == TK_LEQ) { return (a <= b).to_type(i64); }
    if (op == TK_GT) { return (a > b).to_type(i64); }
    if (op == TK_GEQ) { return (a >= b).to_type(i64); }
    return 0;
}

// fold_unary：对常量做一元运算。
pub fn fold_unary(op int, a i64) i64 {
    if (op == TK_MINUS) { return -a; }
    if (op == TK_PLUS) { return a; }
    if (op == TK_TILDE) { return ~a; }
    if (op == TK_BANG) { return (a == 0).to_type(i64); }
    return a;
}

// sem_parse_number：解析数字字面量文本（十六/二/八/十进制与下划线），
// 结果写 c_fold_ival（位型）与 c_fold_big（超出 i64 正数域标志）。

pub fn sem_parse_number(start int, n int) int {
    let i int = start;
    let end int = start + n;
    let v i64 = 0;
    let big int = 0;
    let base i64 = 10;
    if (c_src[i] == '0' && i + 1 < end) {
        let p2 u8 = c_src[i + 1];
        if (p2 == 'x' || p2 == 'X') { base = 16; i += 2; }
        if (p2 == 'b' || p2 == 'B') { base = 2; i += 2; }
        if (p2 == 'o' || p2 == 'O') { base = 8; i += 2; }
    }
    for i < end {
        let b u8 = c_src[i];
        if (b == '_') {
            i += 1;
            continue;
        }
        let d i64 = 0;
        if (b >= '0' && b <= '9') {
            d = (b - '0').to_type(i64);
        } else if (b >= 'a' && b <= 'f') {
            d = ((b - 'a') + 10).to_type(i64);
        } else if (b >= 'A' && b <= 'F') {
            d = ((b - 'A') + 10).to_type(i64);
        } else {
            return err_tok("数字字面量含非法字符");
        }
        v = v * base + d;
        if (v < 0) {
            big = 1;
        }
        i += 1;
    }
    c_fold_ival = v;
    c_fold_big = big;
    return 0;
}

// ============================================================================
// 类型兼容
// ============================================================================

// sem_lit_fits：字面量位型值是否落在整数类型可表示范围内。
pub fn sem_lit_fits(tid int, v i64) int {
    let k int = t_types[tid].kind;
    if (k == TY_U8) { return ((v >= 0) && (v <= 255)).to_type(int); }
    if (k == TY_U16) { return ((v >= 0) && (v <= 65535)).to_type(int); }
    if (k == TY_U32) { return ((v >= 0) && (v <= 4294967295)).to_type(int); }
    if (k == TY_U64) { return 1; }
    if (k == TY_I8) { return ((v >= -128) && (v <= 127)).to_type(int); }
    if (k == TY_I16) { return ((v >= -32768) && (v <= 32767)).to_type(int); }
    if (k == TY_I32 || k == TY_ENUM) {
        return ((v >= -2147483648) && (v <= 2147483647)).to_type(int);
    }
    if (k == TY_I64) { return 1; }
    if (k == TY_CHAR) { return ((v >= 0) && (v <= 255)).to_type(int); }
    if (k == TY_BOOL) { return ((v == 0) || (v == 1)).to_type(int); }
    return 1;
}

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。
pub fn sem_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    if (dst == src) {
        return 0;
    }
    let dk int = t_types[dst].kind;
    let sk int = t_types[src].kind;
    // 聚合：同型已在上面通过；不同类型（含长度不同）一律拒绝
    if ((dk == TY_STRUCT || dk == TY_UNION || dk == TY_ARRAY || dk == TY_SLICE)
        && (sk == TY_STRUCT || sk == TY_UNION || sk == TY_ARRAY || sk == TY_SLICE)) {
        return sem_err("聚合类型不匹配（长度或元素类型不同）");
    }
    if (dk == TY_PTR) {
        // 字面量 0 = 空指针（最宽匹配，先判）
        if (is_lit != 0 && ival == 0) {
            return 0;
        }
        if (sk == TY_PTR) {
            if (t_types[dst].elem == TY_VOID || t_types[src].elem == TY_VOID) {
                return 0;
            }
            return sem_err("指针类型不匹配（需要 .to_type 显式转换）");
        }
        if (sk == TY_FN && t_types[dst].elem == TY_VOID) {
            return 0;
        }
        return sem_err("不能把非指针值赋给指针");
    }
    if (sk == TY_PTR) {
        return sem_err("不能把指针赋给非指针（用 .to_type）");
    }
    if (dk == TY_FN || sk == TY_FN) {
        if (dk == TY_FN && sk == TY_FN) {
            return sem_err("函数签名不匹配");
        }
        return sem_err("fn 值只能赋给同签名类型或 *void");
    }
    if (ty_is_float(dst) != 0 || ty_is_float(src) != 0) {
        if (dk == sk) {
            return 0;
        }
        return sem_err("浮点与整数之间需要 .to_type 显式转换");
    }
    if (dk == TY_BOOL && sk != TY_BOOL) {
        return sem_err("整数不能隐式转为 bool（用 .to_type(bool)）");
    }
    if (sk == TY_BOOL && ty_is_integer(dst) == 0 && dk != TY_BOOL) {
        return sem_err("bool 不能隐式转为该类型");
    }
    if (ty_is_integer(dst) == 0 || ty_is_integer(src) == 0) {
        return sem_err("类型不匹配");
    }
    let dsz int = t_types[dst].size;
    let ssz int = t_types[src].size;
    if (is_lit != 0) {
        if (big != 0 && dk != TY_U64) {
            return sem_err("字面量超出目标类型可表示范围");
        }
        if (sem_lit_fits(dst, ival) != 0) {
            return 0;
        }
        return sem_err("字面量超出目标类型可表示范围");
    }
    if (dsz > ssz) {
        return 0;
    }
    if (dsz == ssz) {
        if (dk == sk) {
            return 0;
        }
        if (dk == TY_ENUM || sk == TY_ENUM) {
            return 0;
        }
        return sem_err("同宽整数之间需要 .to_type 显式转换");
    }
    return sem_err("不允许的隐式窄化（用 .to_type）");
}

// sem_promote：二元运算公共类型（常规算术转换子集）。
pub fn sem_promote(a int, b int) int {
    if (a == b) {
        return a;
    }
    let ak int = t_types[a].kind;
    let bk int = t_types[b].kind;
    if (ak == TY_BOOL) { a = TY_I32; }
    if (bk == TY_BOOL) { b = TY_I32; }
    if (ak == TY_CHAR) { a = TY_I32; }
    if (bk == TY_CHAR) { b = TY_I32; }
    if (ak == TY_ENUM) { a = TY_I32; }
    if (bk == TY_ENUM) { b = TY_I32; }
    if (a == b) {
        return a;
    }
    if (ty_is_float(a) != 0 && ty_is_float(b) != 0) {
        if (t_types[a].size >= t_types[b].size) {
            return a;
        }
        return b;
    }
    if (ty_is_float(a) != 0 || ty_is_float(b) != 0) {
        // 调用方已先行拒绝；此处返回较大一方兜底
        if (t_types[a].size >= t_types[b].size) {
            return a;
        }
        return b;
    }
    let asz int = t_types[a].size;
    let bsz int = t_types[b].size;
    let aus int = (ty_is_signed(a) == 0).to_type(int);
    let bus int = (ty_is_signed(b) == 0).to_type(int);
    let size int = asz;
    if (bsz > size) {
        size = bsz;
    }
    let uns int = aus | bus;
    if (size == 1) {
        if (uns != 0) { return TY_U8; }
        return TY_I8;
    }
    if (size == 2) {
        if (uns != 0) { return TY_U16; }
        return TY_I16;
    }
    if (size == 4) {
        if (uns != 0) { return TY_U32; }
        return TY_I32;
    }
    if (uns != 0) { return TY_U64; }
    return TY_I64;
}

// ============================================================================
// prelude 登记
// ============================================================================

// sem_init_tables：为全部堆分配的全局表分配空间（编译模式启动时调用一次）。
// stage0 每个编译单元只允许一个全局数组字面量，因此这些表统一走堆。
pub fn sem_init_tables() int {
    let n4 u64 = (4 * 64).to_type(u64);
    c_scope_start = malloc(n4).to_type(*int);
    c_brk_stk = malloc(n4).to_type(*int);
    c_cnt_stk = malloc(n4).to_type(*int);
    c_glabels = malloc((sizeof(GLabel) * 128).to_type(u64)).to_type(*GLabel);
    c_args = malloc((sizeof(Res) * 256).to_type(u64)).to_type(*Res);
    c_argtys = malloc((4 * 256).to_type(u64)).to_type(*int);
    c_spill_reg = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_spill_off = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_spill_size = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_call_base = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_call_direct = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_arg_agg = malloc((4 * 256).to_type(u64)).to_type(*int);
    c_aggparam_src = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_aggparam_dst = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_aggparam_size = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_lit_save_off = malloc((4 * 32).to_type(u64)).to_type(*int);
    c_lit_save_tid = malloc((4 * 32).to_type(u64)).to_type(*int);
    c_fi_kind = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_cnt_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_len_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_data_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_step_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_elem_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_idx_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_bss_syms = malloc((4 * 4096).to_type(u64)).to_type(*int);
    sc_sc_false_stk = malloc((4 * 64).to_type(u64)).to_type(*int);
    sc_sc_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int);
    if (c_scope_start == 0 || c_brk_stk == 0 || c_cnt_stk == 0
        || c_glabels == 0 || c_args == 0 || c_argtys == 0
        || c_spill_reg == 0 || c_spill_off == 0 || c_spill_size == 0
        || c_call_base == 0
        || c_call_direct == 0 || c_arg_agg == 0
        || c_aggparam_src == 0 || c_aggparam_dst == 0 || c_aggparam_size == 0
        || c_lit_save_off == 0 || c_lit_save_tid == 0
        || c_fi_kind == 0 || c_fi_cnt_off == 0 || c_fi_len_off == 0
        || c_fi_data_off == 0 || c_fi_step_off == 0
        || c_fi_elem_off == 0 || c_fi_idx_off == 0
        || c_bss_syms == 0
        || sc_sc_false_stk == 0 || sc_sc_end_stk == 0) {
        return fail("内存分配失败");
    }
    return 0;
}

// prelude_add：登记一个 prelude 外部函数（名字进池；签名进签名表）。
pub fn prelude_add(name *char, ret int, np int, vararg int) int {
    let n int = 0;
    for name[n] != 0 {
        n += 1;
    }
    let off int = name_intern_lit(name);
    if (off < 0) {
        return -1;
    }
    let ftid int = ty_fn(ret, t_sigparam_n - np, np, vararg);
    return sym_push_lit(off, n, SYM_FN, ftid, F_EXTERN | F_PUB);
}

// prelude_add_linux_syscall6：Linux arm64 的六参数系统调用入口；调用点由后端
// 发射 svc 指令，因此不生成外部符号引用。
pub fn prelude_add_linux_syscall6() int {
    let i int = 0;
    for i < 7 {
        ty_sig_param(TY_U64);
        i += 1;
    }
    let idx int = prelude_add("linux_syscall6", TY_I64, 7, 0);
    if (idx < 0) {
        return -1;
    }
    c_syms[idx].flags = F_PUB | F_INTRINSIC | F_LINUX_SYSCALL;
    return idx;
}

// sem_register_prelude：登记编译器和程序使用的外部接口（语义边界 §7）。
// 签名参数类型先按序入池，再以池起始下标建函数类型。
pub fn sem_register_prelude() int {
    let t_pvoid int = ty_ptr(TY_VOID);
    let t_pchar int = ty_ptr(TY_CHAR);
    // printf(fmt *char, ...) int —— 本地格式化运行时，支持整数/字符串/字符。
    ty_sig_param(t_pchar);
    let printf_idx int = prelude_add("printf", TY_I32, 1, 1);
    if (printf_idx < 0) { return -1; }
    c_syms[printf_idx].flags = F_PUB | F_INTRINSIC | F_RUNTIME_PRINTF;
    // malloc(size u64) *void，由 yh 运行时直接通过 OS 内存映射实现。
    ty_sig_param(TY_U64);
    let malloc_idx int = prelude_add("malloc", t_pvoid, 1, 0);
    if (malloc_idx < 0) { return -1; }
    c_syms[malloc_idx].flags = F_PUB | F_INTRINSIC | F_RUNTIME_MALLOC;
    // free(p *void) void，由映射头部记录尺寸后直接解除映射。
    ty_sig_param(t_pvoid);
    let free_idx int = prelude_add("free", TY_VOID, 1, 0);
    if (free_idx < 0) { return -1; }
    c_syms[free_idx].flags = F_PUB | F_INTRINSIC | F_RUNTIME_FREE;
    // memcpy(dst *void, src *void, n u64) *void，由 yh 本地运行时实现。
    ty_sig_param(t_pvoid);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    let memcpy_idx int = prelude_add("memcpy", t_pvoid, 3, 0);
    if (memcpy_idx < 0) { return -1; }
    c_syms[memcpy_idx].flags = F_PUB | F_INTRINSIC | F_RUNTIME_MEMCPY;
    // strlen(s *char) u64，由 yh 本地运行时实现。
    ty_sig_param(t_pchar);
    let strlen_idx int = prelude_add("strlen", TY_U64, 1, 0);
    if (strlen_idx < 0) { return -1; }
    c_syms[strlen_idx].flags = F_PUB | F_INTRINSIC | F_RUNTIME_STRLEN;
    // exit(code int) void
    ty_sig_param(TY_I32);
    prelude_add("exit", TY_VOID, 1, 0);
    // open(path *char, flags int, ...) int —— 裸变参
    ty_sig_param(t_pchar);
    ty_sig_param(TY_I32);
    prelude_add("open", TY_I32, 2, 1);
    // close(fd int) int
    ty_sig_param(TY_I32);
    prelude_add("close", TY_I32, 1, 0);
    // mkdir(path *char, mode int) int —— 创建一个目录，不递归创建父目录。
    ty_sig_param(t_pchar);
    ty_sig_param(TY_I32);
    prelude_add("mkdir", TY_I32, 2, 0);
    // read(fd int, buf *void, count u64) i64
    ty_sig_param(TY_I32);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    prelude_add("read", TY_I64, 3, 0);
    // write(fd int, buf *void, count u64) i64
    ty_sig_param(TY_I32);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    prelude_add("write", TY_I64, 3, 0);
    // system(cmd *char) int 仅由明确启用的兼容配置提供。
    if (c_legacy_system != 0) {
        ty_sig_param(t_pchar);
        prelude_add("system", TY_I32, 1, 0);
    }
    // unlink(path *char) int —— 清理 -o 模式的临时汇编文件
    ty_sig_param(t_pchar);
    prelude_add("unlink", TY_I32, 1, 0);
    // fork/execv/waitpid：过渡期直接启动模块 worker，不经过 shell。
    prelude_add("fork", TY_I32, 0, 0);
    ty_sig_param(t_pchar);
    ty_sig_param(ty_ptr(t_pchar));
    prelude_add("execv", TY_I32, 2, 0);
    ty_sig_param(t_pchar);
    ty_sig_param(ty_ptr(t_pchar));
    prelude_add("execvp", TY_I32, 2, 0);
    // dup2(oldfd int, newfd int) int —— 子进程输出重定向的 POSIX 接口。
    ty_sig_param(TY_I32);
    ty_sig_param(TY_I32);
    prelude_add("dup2", TY_I32, 2, 0);
    ty_sig_param(TY_I32);
    ty_sig_param(ty_ptr(TY_I32));
    ty_sig_param(TY_I32);
    prelude_add("waitpid", TY_I32, 3, 0);
    // getpid/rename/usleep/kill：原子发布接口和调度进程 worker。
    prelude_add("getpid", TY_I32, 0, 0);
    ty_sig_param(t_pchar);
    ty_sig_param(t_pchar);
    prelude_add("rename", TY_I32, 2, 0);
    ty_sig_param(TY_I32);
    prelude_add("usleep", TY_I32, 1, 0);
    ty_sig_param(TY_I32);
    ty_sig_param(TY_I32);
    prelude_add("kill", TY_I32, 2, 0);
    if (tg_darwin() == 0) {
        let syscall_idx int = prelude_add_linux_syscall6();
        if (syscall_idx < 0 || em_emit_linux_syscall_stub(syscall_idx) != 0) {
            return -1;
        }
    }
    if (tg_darwin() != 0) {
        // clock_gettime 是编译器 --stats 使用的单调时钟 OS API。
        ty_sig_param(TY_I32);
        ty_sig_param(t_pvoid);
        if (prelude_add("clock_gettime", TY_I32, 2, 0) < 0) {
            return -1;
        }
        ty_sig_param(TY_I32);
        ty_sig_param(ty_ptr(TY_VOID));
        ty_sig_param(ty_ptr(TY_VOID));
        ty_sig_param(TY_U64);
        ty_sig_param(TY_U64);
        prelude_add("getattrlistbulk", TY_I32, 5, 0);
    }
    return 0;
}

// tml_intern_str：把任意缓冲字节 intern 进名字池（mod.toml/项目路径/
// 诊断消息用；自 cmd/toml.yh 迁入使 parse 可直接调用——ADR-0007 P3）。

// tml_intern_str：与 tml_intern 相同，但从 t_buf（任意缓冲）取字节。
pub fn tml_intern_str(buf *u8, start int, n int) int {
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = buf[start + i];
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off;
}

// mod_ns_lookup：模块命名空间查条目（want_type=1 查类型名；
// 自 parse/iface.yh 迁入使 parse_type/parse_expr 可直接调用——P3 解环）。

// mod_ns_lookup：模块命名空间查条目下标。want_type=1 查类型名，否则查值。
pub fn mod_ns_lookup(mi int, start int, n int, want_type int) int {
    let i int = 0;
    for i < c_mods[mi].ns_n {
        if (c_mods[mi].ns[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_mods[mi].ns[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                if (want_type != 0) {
                    if (c_mods[mi].ns[i].tid >= 0) {
                        return i;
                    }
                    return -1;
                }
                if (c_mods[mi].ns[i].sym >= 0) {
                    return i;
                }
                return -1;
            }
        }
        i += 1;
    }
    return -1;
}

// mod_file_binding：当前文件导入表查绑定名（读 gen 的导入表全局；
// 自 parse/parse_expr.yh 迁入供 sizeof_starts_type 限定类型判定——P3）。

// mod_file_binding：当前文件导入表中查绑定名，返回 ModInfo 下标；无 -1。
pub fn mod_file_binding(start int, n int) int {
    if (mod_import_mod == 0) {
        return -1;
    }
    // 按绑定名（别名）匹配：限定调用的第一段标识符是别名
    let i int = 0;
    for i < mod_import_n {
        if (mod_import_mod[i] >= 0 && mod_imports[i].alias_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[mod_imports[i].alias_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return mod_import_mod[i];
            }
        }
        i += 1;
    }
    return -1;
}
