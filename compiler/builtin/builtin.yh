module builtin
import check
import types

import table
// ============================================================================
// prelude.yh —— 内置（prelude）函数登记表
//
// 本模块只负责「哪些名字在未导入任何模块时可见」这一层：函数名、返回/参数
// 类型、变参形态与运行时标志。符号表/类型表本身仍由 gen 提供，本模块通过
// check.prelude_add 追加条目，不实现任何运行时函数体。
//
// 分层：builtin 只 import gen，不 import lex/parse/ast/check/comptime/ir/
// backend；gen 不 import builtin。入口（cmd/driver、cmd/llvm_emit、
// cmd/module_worker）在 check.ty_register_builtins() 与 check.scope_push() 之后
// 调用 builtin.sem_register_prelude()，登记顺序与历史行为保持一致。
//
// 运行时函数体在 backend/llvm_runtime.yh（内存/printf/Linux syscall）与
// backend/llvm_apple_runtime.yh（Darwin 入口）中按需发射；本文件只登记符号
// 与 F_* 标志，二者靠符号名/fn 标志对接，不要在这里写 IR。
// ============================================================================

// prelude_add_linux_syscall6：Linux arm64 的六参数系统调用入口；调用点由后端
// 发射 svc 指令，因此不生成外部符号引用。
fn prelude_add_linux_syscall6() int {
    let i int = 0
    for i < 7 {
        table.ty_sig_param(types.TY_U64)
        i += 1
    }
    let idx int = check.prelude_add("linux_syscall6", types.TY_I64, 7, 0)
    if (idx < 0) {
        return -1
    }
    table.ms().syms[idx].flags = table.F_PUB | table.F_INTRINSIC | table.F_LINUX_SYSCALL
    return idx
}

