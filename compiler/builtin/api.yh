module builtin

import check
import support
// ============================================================================
// api.yh —— builtin 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

pub fn register_builtins(){

}

pub fn register_type(){

}

// sem_register_prelude：登记编译器和程序使用的外部接口（语义边界 §7）。
// 签名参数类型先按序入池，再以池起始下标建函数类型。
// front_prepare：受检前端的公共装配——类型表内置类型 + 全局作用域 + 前导库符号。
//
// 这段三元组原先在 llvm_emit（单文件）与 module_worker（模块）各写一遍，
// 且 worker 侧漏检了 `ty_register_builtins` 的返回值。收敛到这里后调用方只需
// 判一次返回码；`sem_init_tables` 仍由调用方先行——它必须跟在每模块标志
// （c_module_mode / c_is_entry_mod / 符号后缀）之后，不能一并前置。
pub fn front_prepare() int {
    if (check.ty_register_builtins() != 0) { return -1 }
    if (support.scope_push() != 0) { return -1 }
    return sem_register_prelude()
}

pub fn sem_register_prelude() int {
    let t_pvoid int = check.ty_ptr(support.TY_VOID)
    let t_pchar int = check.ty_ptr(support.TY_CHAR)
    
    // printf(fmt *char, ...) int —— 本地格式化运行时，支持整数/字符串/字符。
    check.ty_sig_param(t_pchar)
    let printf_idx int = check.prelude_add("printf", support.TY_I32, 1, 1)
    if (printf_idx < 0) { return -1 }
    support.ms().syms[printf_idx].flags = support.F_PUB | support.F_INTRINSIC | support.F_RUNTIME_PRINTF
    
    // yh test 的运行时断言入口：测试模块按 prelude 裸符号调用，测试入口模块
    // 生成同名 C ABI 定义；生产程序不引用它，不进入链接。
    check.ty_sig_param(support.TY_BOOL)
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(t_pchar)
    check.prelude_add("__yh_test_assert", support.TY_VOID, 4, 0)
    
    // malloc(size u64) *void，由 yh 运行时直接通过 OS 内存映射实现。
    check.ty_sig_param(support.TY_U64)
    let malloc_idx int = check.prelude_add("malloc", t_pvoid, 1, 0)
    if (malloc_idx < 0) { return -1 }
    support.ms().syms[malloc_idx].flags = support.F_PUB | support.F_INTRINSIC | support.F_RUNTIME_MALLOC
    
    // free(p *void) void，由映射头部记录尺寸后直接解除映射。
    check.ty_sig_param(t_pvoid)
    let free_idx int = check.prelude_add("free", support.TY_VOID, 1, 0)
    if (free_idx < 0) { return -1 }
    support.ms().syms[free_idx].flags = support.F_PUB | support.F_INTRINSIC | support.F_RUNTIME_FREE
    
    // memcpy(dst *void, src *void, n u64) *void，由 yh 本地运行时实现。
    check.ty_sig_param(t_pvoid)
    check.ty_sig_param(t_pvoid)
    check.ty_sig_param(support.TY_U64)
    let memcpy_idx int = check.prelude_add("memcpy", t_pvoid, 3, 0)
    if (memcpy_idx < 0) { return -1 }
    support.ms().syms[memcpy_idx].flags = support.F_PUB | support.F_INTRINSIC | support.F_RUNTIME_MEMCPY

    // strlen(s *char) u64，由 yh 本地运行时实现。
    check.ty_sig_param(t_pchar)
    let strlen_idx int = check.prelude_add("strlen", support.TY_U64, 1, 0)
    if (strlen_idx < 0) { return -1 }
    support.ms().syms[strlen_idx].flags = support.F_PUB | support.F_INTRINSIC | support.F_RUNTIME_STRLEN

    // exit(code int) void
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("exit", support.TY_VOID, 1, 0)

    // open(path *char, flags int, ...) int —— 裸变参
    check.ty_sig_param(t_pchar)
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("open", support.TY_I32, 2, 1)

    // close(fd int) int
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("close", support.TY_I32, 1, 0)

    // mkdir(path *char, mode int) int —— 创建一个目录，不递归创建父目录。
    check.ty_sig_param(t_pchar)
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("mkdir", support.TY_I32, 2, 0)


    // read(fd int, buf *void, count u64) i64
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(t_pvoid)
    check.ty_sig_param(support.TY_U64)
    check.prelude_add("read", support.TY_I64, 3, 0)

    // write(fd int, buf *void, count u64) i64
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(t_pvoid)
    check.ty_sig_param(support.TY_U64)
    check.prelude_add("write", support.TY_I64, 3, 0)


    // system(cmd *char) int 仅由明确启用的兼容配置提供。
    if (support.session().legacy_system != 0) {
        check.ty_sig_param(t_pchar)
        check.prelude_add("system", support.TY_I32, 1, 0)
    }

    // unlink(path *char) int —— 清理 -o 模式的临时汇编文件
    check.ty_sig_param(t_pchar)
    check.prelude_add("unlink", support.TY_I32, 1, 0)

    // fork/execv/waitpid：过渡期直接启动模块 worker，不经过 shell。
    check.prelude_add("fork", support.TY_I32, 0, 0)
    check.ty_sig_param(t_pchar)
    check.ty_sig_param(check.ty_ptr(t_pchar))
    check.prelude_add("execv", support.TY_I32, 2, 0)
    check.ty_sig_param(t_pchar)
    check.ty_sig_param(check.ty_ptr(t_pchar))
    check.prelude_add("execvp", support.TY_I32, 2, 0)

    // dup2(oldfd int, newfd int) int —— 子进程输出重定向的 POSIX 接口。
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("dup2", support.TY_I32, 2, 0)
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(check.ty_ptr(support.TY_I32))
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("waitpid", support.TY_I32, 3, 0)

    // getpid/rename/usleep/kill：原子发布接口和调度进程 worker。
    check.prelude_add("getpid", support.TY_I32, 0, 0)
    check.ty_sig_param(t_pchar)
    check.ty_sig_param(t_pchar)
    check.prelude_add("rename", support.TY_I32, 2, 0)
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("usleep", support.TY_I32, 1, 0)
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(support.TY_I32)
    check.prelude_add("kill", support.TY_I32, 2, 0)
    if (support.tg_darwin() == 0) {
        // LL12：Linux syscall 入口由 LLVM 运行时提供（backend/llvm_runtime.yh
        // 的 linux_syscall6），旧汇编桩不再发射。
        if (prelude_add_linux_syscall6() < 0) {
            return -1
        }
    }

    // clock_gettime 是编译器 --stats 使用的单调时钟 OS API，libs/time 也
    // 引用它；Darwin 经 libSystem、Linux 经 glibc 解析（POSIX 公共接口），
    // 两种目标都登记。getattrlistbulk 是 Darwin 专用目录 API，保持限定。
    check.ty_sig_param(support.TY_I32)
    check.ty_sig_param(t_pvoid)
    if (check.prelude_add("clock_gettime", support.TY_I32, 2, 0) < 0) {
        return -1
    }
    if (support.tg_darwin() != 0) {
        check.ty_sig_param(support.TY_I32)
        check.ty_sig_param(check.ty_ptr(support.TY_VOID))
        check.ty_sig_param(check.ty_ptr(support.TY_VOID))
        check.ty_sig_param(support.TY_U64)
        check.ty_sig_param(support.TY_U64)
        check.prelude_add("getattrlistbulk", support.TY_I32, 5, 0)
    }
    return 0
}
