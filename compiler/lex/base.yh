module lex

// ============================================================================
// base.yh —— 词法扫描的每任务游标
//
// 只放词法器自己的行列位置：`line` 是当前 1 基行号，`lstart` 是当前行首字节
// 下标（用于把字节偏移换算成列号）。词法器写、诊断读；不属于语义模型，
// 因此不留在 support.FrontCtx（链 B：按所有者拆状态）。
// ============================================================================

// LexCtx：词法游标（模块级单例，worker 进程内一份）。
pub struct LexCtx {
    line int // 当前 1 基行号
    lstart int // 当前行首字节下标
}

// g_lex：词法游标单例。
let g_lex LexCtx

// ctx：词法游标窄口。
pub fn ctx() *LexCtx {
    return &g_lex
}

// reset：开始扫描新文件前把游标复位（行号 1、行首 0）。
pub fn reset() void {
    g_lex.line = 1
    g_lex.lstart = 0
}
