module lower
import ast
import ir

// ============================================================================
// module_snapshot_lower_selftest.yh —— check 切片与 lowering 的离线等价性探针
//
// 从 module_snapshot_check_slice.yh 移出（2026-10-25 B3-1）：探针要调
// lower_module，而 lowering 将独立成 lower 模块，探针必须跟着 lowering 走，
// 否则 ast 会反向依赖 lower。本文件只放探针，不参与生产构建路径，唯一调用方
// 是 tests/modules/projects/llvmlower/main/main.yh。
//
// 语义不变：先冷降 unit，再清空 AST arena、从函数切片重建快照并再次 lowering，
// 比较两次模块身份。0 一致、1 不一致、-1 内部错误。
// ============================================================================

// checked_slice_self_test：C2 离线探针。先冷降 unit，再清空 AST arena、
// 从函数切片重建快照并再次 lowering，比较两次模块身份。
// 0 一致、1 不一致、-1 内部错误。不改变生产构建路径。
pub fn checked_slice_self_test(unit *ast.CheckedModule) int {
    if (unit == 0 || unit.storage == 0) { return -1 }
    let store *ast.CheckedStorage = unit.storage.to_type(*ast.CheckedStorage)
    let n int = store.function_n
    if (n <= 0) { return -1 }
    let datas **u8 = malloc((n * 8).to_type(u64)).to_type(**u8)
    let sizes *int = malloc((n * sizeof(int)).to_type(u64)).to_type(*int)
    if (datas == 0 || sizes == 0) {
        if (datas != 0) { free(datas.to_type(*void)) }
        if (sizes != 0) { free(sizes.to_type(*void)) }
        return -1
    }
    let i int = 0
    for i < n { datas[i] = 0.to_type(*u8); sizes[i] = 0; i += 1 }
    let result int = 0
    let first ir.IRModule
    if (lower_module(unit, &first) != 0) { result = -1 }
    i = 0
    for i < n && result == 0 {
        if (ast.checked_slice_capture(unit, i, &datas[i], &sizes[i]) != 0) {
            result = -1
        }
        i += 1
    }
    let second ast.CheckedModule
    if (result == 0) {
        if (ast.checked_decl_restore(unit) != 0) {
            result = -1
        } else {
            i = 0
            for i < n && result == 0 {
                let imported int = -1
                if (ast.checked_slice_import(datas[i], sizes[i], -1, &imported) != 0) {
                    result = -1
                }
                i += 1
            }
        }
    }
    if (result == 0 && ast.checked_module_capture(&second) != 0) { result = -1 }
    let third ir.IRModule
    if (result == 0 && lower_module(&second, &third) != 0) { result = -1 }
    if (result == 0) {
        let id1 [33]u8
        let id2 [33]u8
        if (ir.ir_module_identity(&first, &id1[0], 33) != 32
            || ir.ir_module_identity(&third, &id2[0], 33) != 32) {
            result = -1
        } else {
            i = 0
            for i < 32 {
                if (id1[i] != id2[i]) { result = 1; break }
                i += 1
            }
        }
    }
    if (result == 0) { ir.ir_module_release(&third) }
    if (result == 0) { ir.ir_module_release(&first) }
    if (result == 0) { ast.checked_module_release(&second) }
    i = 0
    for i < n {
        if (datas[i] != 0) { free(datas[i].to_type(*void)) }
        i += 1
    }
    free(datas.to_type(*void))
    free(sizes.to_type(*void))
    return result
}
