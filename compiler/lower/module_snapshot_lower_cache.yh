module lower
import token
import check
import types
import support
import table
import ast
import proj
import cache

// ============================================================================
// module_snapshot_lower_cache.yh —— 函数级缓存键（LA3）
//
// 键只由可跨进程复现的事实组成：
//   * schema 标签与 action 种类（cache.Key）；
//   * 模块环境键（依赖接口、目标、O 级别、编译器身份，由 cmd 计算）；
//   * 目标 key/指针位宽/布局版本/ABI；
//   * 声明面布局/签名事实、源码级 const 值；
//   * 本模块非函数声明 token 流与本函数 token 流。
//
// C0（2026-11-06）：与 ast/module_snapshot_check_key.yh 共用 cache.Key 序列，
// 键从 FNV 16 位十六进制迁移到 SHA-256 64 位十六进制。不混 arena 类型编号；
// 类型只混 kind/size/align，避免检查顺序影响键。
// ============================================================================

// checked_store_mix_type：按受检存储的类型表混入 ABI 事实。
fn checked_store_mix_type(store *check.CheckedStorage, key *cache.Key, tid int) int {
    if (store == 0 || tid < 0 || tid >= store.type_n) {
        return cache.key_mix_type_facts(key, 0, 0, 0, 0)
    }
    let ty types.CType = store.types[tid]
    return cache.key_mix_type_facts(key, 1, ty.kind, ty.size, ty.align)
}

// checked_mix_type：混入一个类型编号的 ABI 事实；非法编号按缺失处理。
fn checked_mix_type(l *CheckedLower, key *cache.Key, tid int) int {
    if (l == 0) { return cache.key_mix_type_facts(key, 0, 0, 0, 0) }
    return checked_store_mix_type(l.store, key, tid)
}

// checked_mix_signature：混入函数签名事实（返回/参数 ABI、变参、签名种类）。
fn checked_mix_signature(l *CheckedLower, key *cache.Key, sig int) int {
    if (l == 0 || sig < 0 || sig >= l.store.sig_n) { return 0 }
    if (checked_mix_type(l, key, l.store.sig_ret[sig]) != 0) { return -1 }
    if (cache.key_mix_int(key, l.store.sig_np[sig]) != 0) { return -1 }
    if (cache.key_mix_int(key, l.store.sig_vararg[sig]) != 0) { return -1 }
    if (cache.key_mix_int(key, l.store.sig_abi[sig]) != 0) { return -1 }
    let pi int = 0
    for pi < l.store.sig_np[sig] {
        if (checked_mix_type(l, key,
                l.store.sig_params[l.store.sig_first[sig] + pi]) != 0) { return -1 }
        pi += 1
    }
    return 0
}

// checked_cache_mix_tokens：把一段 token 范围（种类+长度+源字节）混入键。
fn checked_cache_mix_tokens(l *CheckedLower, file_id int, first int, after int,
    key *cache.Key) int {
    if (l == 0 || file_id < 0 || file_id >= l.store.file_n) { return -1 }
    let file proj.PFile = l.store.files[file_id]
    if (file.source == 0 || file.tokens == 0) { return -1 }
    return cache.key_mix_tokens(key, file.source, file.source_len, file.tokens,
        file.token_n, first, after)
}

// checked_cache_layout：把「声明面」的布局与签名事实混入函数键。
// IR 侧逐声明混 kind：aggregate 混类型事实，函数混签名事实；check 侧在
// pass2b 前只能用整张类型/签名表，两者 action 种类不同。函数体内的 lazy
// 类型不参与 IR 键，避免键依赖检查顺序。
fn checked_cache_layout(l *CheckedLower, key *cache.Key) int {
    let i int = 0
    for i < l.store.declaration_n {
        let decl ast.AstDecl = l.store.declarations[i]
        let kind int = decl.kind
        if (cache.key_mix_int(key, kind) != 0) { return -1 }
        if (kind == token.TK_STRUCT || kind == token.TK_UNION || kind == token.TK_ENUM) {
            if (decl.sym_id >= 0 && decl.sym_id < l.store.symbol_n) {
                if (checked_mix_type(l, key,
                        l.store.symbols[decl.sym_id].type_id) != 0) { return -1 }
            }
        } else if (kind == token.TK_FN) {
            if (decl.type_id >= 0 && decl.type_id < l.store.type_n) {
                let fty types.CType = l.store.types[decl.type_id]
                if (checked_mix_signature(l, key, fty.sub) != 0) { return -1 }
            }
        }
        i += 1
    }
    return 0
}

// checked_cache_module_facts：混入本模块非函数声明（全局/常量/类型）的 token 流。
fn checked_cache_module_facts(l *CheckedLower, key *cache.Key) int {
    let i int = 0
    for i < l.store.declaration_n {
        let decl ast.AstDecl = l.store.declarations[i]
        if (decl.kind != token.TK_FN) {
            if (checked_cache_mix_tokens(l, decl.file_id, decl.first, decl.after,
                    key) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_cache_symbol_facts：把源码级 const 的常量值/标志混入函数键。
// 类型只混 ABI 事实，不混 arena 类型编号。
fn checked_cache_symbol_facts(store *check.CheckedStorage, key *cache.Key) int {
    let i int = 0
    for i < store.declaration_n {
        let decl ast.AstDecl = store.declarations[i]
        if (decl.kind == token.TK_CONST && decl.sym_id >= 0
            && decl.sym_id < store.symbol_n) {
            let sym table.CSym = store.symbols[decl.sym_id]
            if (cache.key_mix_int(key, sym.kind) != 0) { return -1 }
            if (checked_store_mix_type(store, key, sym.type_id) != 0) {
                return -1
            }
            if (cache.key_mix_int(key, sym.flags) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.cval.to_type(int)) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.const_ready) != 0) { return -1 }
            if (cache.key_mix_int(key, sym.const_expr_kind) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_function_key：为快照中的一个函数生成 64 位十六进制缓存键。
// 成功写 out[0..64) 与结尾零并返回 0；token 范围无效返回 -1（该函数跳过缓存）。
fn checked_function_key(l *CheckedLower, function_index int, env_key u64,
    out *u8) int {
    if (l == 0 || out == 0 || function_index < 0
        || function_index >= l.store.function_n) { return -1 }
    let ctx check.CheckedFunction = l.store.functions[function_index]
    if (ctx.file_id < 0 || ctx.file_id >= l.store.file_n) { return -1 }
    let file proj.PFile = l.store.files[ctx.file_id]
    if (file.source == 0 || file.tokens == 0 || ctx.token_first < 0
        || ctx.token_after <= ctx.token_first || ctx.token_after > file.token_n) {
        return -1
    }
    let key cache.Key
    let rel_path [1024]u8
    if (proj.file_rel_path(ctx.file_id, &rel_path[0], 1024) < 0) { return -1 }
    let inputs cache.CacheInputs
    inputs.target_key = l.cache_target_key
    inputs.pointer_bits = l.cache_pointer_bits
    inputs.layout_version = l.cache_layout_version
    inputs.abi = l.cache_abi
    inputs.opt_level = l.cache_opt
    inputs.trimpath = l.cache_trimpath
    if (cache.key_init_function(&key, cache.ACTION_IR, env_key,
            &inputs, support.arr_cstr(&rel_path[0])) != 0) { return -1 }
    if (checked_cache_layout(l, &key) != 0) { return -1 }
    if (checked_cache_symbol_facts(l.store, &key) != 0) { return -1 }
    if (checked_cache_module_facts(l, &key) != 0) { return -1 }
    // 数据标签（字符串/静态数据）是模块级绝对计数，IR 记录按标签号引用它们。
    // 本模块增删或改写任何字面量都会让后续标签漂移；混入当前标签总数，
    // 布局一变本模块全部函数记录保守失效，避免旧记录引用错位的字面量。
    if (cache.key_mix_int(&key, support.data_label()) != 0) { return -1 }
    if (checked_cache_mix_tokens(l, ctx.file_id, ctx.token_first,
            ctx.token_after, &key) != 0) { return -1 }
    return cache.key_finish_hex(&key, out)
}
