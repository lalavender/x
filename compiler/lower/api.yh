module lower

import ir
import check
// ============================================================================
// api.yh —— lower 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// AstIRCalls：单函数 lowering 私有的调用、实参和稳定符号缓冲。
pub struct AstIRCalls {
    calls *ir.IRCall
    call_count int
    call_cap int
    args *ir.IRCallArg
    arg_count int
    arg_cap int
    symbols *u8
    symbol_size int
    symbol_cap int
}

// CheckedLowerStats：一次缓存化 lowering 的可见计数与四段耗时，由 cmd 汇总到 --stats。
// hits/misses 只统计可缓存函数；lowered 是实际调用 checked_lower_function 的函数数。
// prep/decl/build/verify 是 lowering 内部的互斥分段（PL1）：
//   prep   —— 表分配与 canonical 类型/来源映射建立
//   decl   —— 函数签名、全局符号与静态数据登记到 IRModule
//   build  —— 逐函数函数体构造（含函数级 IR 缓存查询/恢复/捕获）
//   verify —— ir_module_verify 模块一致性校验
// 四段之和 ≤ 调用方测得的 time_lower_ns（差额是构造器初始化与释放）。
pub struct CheckedLowerStats {
    hits int
    misses int
    lowered int
    prep_ns u64
    decl_ns u64
    build_ns u64
    verify_ns u64
    // build 内部再分四段（PL1b）：符号名构造与线性查找、函数级缓存键/查表/合并、
    // 真正调用 checked_lower_function、以及未命中后的 IR 缓存序列化（capture）。
    // 四者之和 ≤ build_ns（差额是循环控制与释放）。
    lookup_ns u64
    cache_ns u64
    fn_ns u64
    capture_ns u64
}

// lower_module：无缓存入口，行为与 LA2b 完全相同；项目 worker 使用
// lower_module_cached 接入函数级 IR 复用。
pub fn lower_module(unit *check.CheckedModule, out *ir.IRModule) int {
    return lower_module_impl(unit, out, 0, 0, 0, 0)
}

// lower_module_cached：带函数级缓存的 lowering 入口。
// cache_in/cache_out 由 cmd 装载与提交；env_key 由模块接口/目标/编译器环境算出。
// stats 非空时写回 hits/misses/lowered，供 worker 汇总到 --stats。
// 0 成功，1 首片不支持并带来源诊断，-1 内部错误；失败释放候选且保持零初始化 out 不变。
pub fn lower_module_cached(unit *check.CheckedModule, out *ir.IRModule,
    cache_in *ir.IRFunctionCacheSet, cache_out *ir.IRFunctionCacheSet,
    env_key u64, stats *CheckedLowerStats) int {
    if (stats != 0) {
        stats.hits = 0; stats.misses = 0; stats.lowered = 0
        stats.prep_ns = 0; stats.decl_ns = 0; stats.build_ns = 0; stats.verify_ns = 0
        stats.lookup_ns = 0; stats.cache_ns = 0; stats.fn_ns = 0
        stats.capture_ns = 0
    }
    let result int = lower_module_impl(unit, out, cache_in, cache_out, env_key, stats)
    return result
}

// checked_slice_self_test：C2 离线探针。先冷降 unit，再清空 AST arena、
// 从函数切片重建快照并再次 lowering，比较两次模块身份。
// 0 一致、1 不一致、-1 内部错误。不改变生产构建路径。
pub fn checked_slice_self_test(unit *check.CheckedModule) int {
    if (unit == 0 || unit.storage == 0) { return -1 }
    let store *check.CheckedStorage = unit.storage.to_type(*check.CheckedStorage)
    let n int = store.function_n
    if (n <= 0) { return -1 }
    let datas **u8 = malloc((n * 8).to_type(u64)).to_type(**u8)
    let sizes *int = malloc((n * sizeof(int)).to_type(u64)).to_type(*int)
    if (datas == 0 || sizes == 0) {
        if (datas != 0) { free(datas.to_type(*void)) }
        if (sizes != 0) { free(sizes.to_type(*void)) }
        return -1
    }
    let i int = 0
    for i < n { datas[i] = 0.to_type(*u8); sizes[i] = 0; i += 1 }
    let result int = 0
    let first ir.IRModule
    if (lower_module(unit, &first) != 0) { result = -1 }
    i = 0
    for i < n && result == 0 {
        // 测试前端没有 pass2b 钩子，捕获前显式记录 v3 守卫所需的模块表规模。
        check.checked_slice_snapshot(store.functions[i].decl_row)
        let captured int = check.checked_slice_capture(unit, i, &datas[i], &sizes[i])
        if (captured != 0) { result = -1 }
        i += 1
    }
    let second check.CheckedModule
    if (result == 0) {
        if (check.checked_decl_restore(unit) != 0) {
            result = -1
        } else {
            i = 0
            for i < n && result == 0 {
                let imported int = -1
                if (check.checked_slice_import(datas[i], sizes[i], -1, &imported) != 0) {
                    result = -1
                }
                i += 1
            }
        }
    }
    if (result == 0 && check.checked_module_capture(&second) != 0) { result = -1 }
    let third ir.IRModule
    if (result == 0 && lower_module(&second, &third) != 0) { result = -1 }
    if (result == 0) {
        let id1 [33]u8
        let id2 [33]u8
        if (ir.ir_module_identity(&first, &id1[0], 33) != 32
            || ir.ir_module_identity(&third, &id2[0], 33) != 32) {
            result = -1
        } else {
            i = 0
            for i < 32 {
                if (id1[i] != id2[i]) { result = 1; break }
                i += 1
            }
        }
    }
    if (result == 0) { ir.ir_module_release(&third) }
    if (result == 0) { ir.ir_module_release(&first) }
    if (result == 0) { check.checked_module_release(&second) }
    i = 0
    for i < n {
        if (datas[i] != 0) { free(datas[i].to_type(*void)) }
        i += 1
    }
    free(datas.to_type(*void))
    free(sizes.to_type(*void))
    return result
}
