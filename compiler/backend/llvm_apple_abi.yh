module backend
import support
import ir

const LLVM_APPLE_ABI_DIRECT int = 1
const LLVM_APPLE_ABI_INDIRECT int = 2
const LLVM_APPLE_ABI_HFA_UNSUPPORTED int = 3
const LLVM_APPLE_ABI_HFA int = 4

// 本文件的分类器同时服务 Darwin/ARM64 与 Linux/AArch64：固定参数、HFA 与
// ≤16 字节直接/大聚合间接规则同属 AAPCS64；平台差异（变参、运行时、链接）
// 由 llvm_call.yh 与 llvm_runtime.yh 分支处理。
//
// LLVMAppleABIInfo：保存 AAPCS64 聚合分类结果，尺寸来自模块的源布局。
struct LLVMAppleABIInfo {
    kind int
    size int
    align int
    return_bits int
    tail_bits int
    hfa_type_kind int
    hfa_count int
}

// llvm_apple_abi_is_aggregate：判断只有结构与联合才参与 Apple 按值聚合 ABI。
fn llvm_apple_abi_is_aggregate(kind int) int {
    return kind == ir.IR_MODULE_TY_STRUCT || kind == ir.IR_MODULE_TY_UNION ? 1 : 0
}

// llvm_apple_hfa_walk：递归识别同一浮点基型组成的 HFA；非 HFA 子树返回 0。
//
// Apple 的 HFA 分类对联合体同样生效：联合体的全部成员共用同一块存储，
// 只要每个成员本身都是同一浮点基型的 HFA（或浮点叶子），该联合体就是
// HFA（例：`union { double scalar; double values[2]; }` 是 2×double HFA）。
// 联合体成员在内存中互相重叠，因此计数取各成员计数的最大值而不是求和；
// 这与结构的逐字段求和不同。漏掉 union 会把 16 字节浮点联合体误判成
// 整数直接聚合，C↔YH 互调时值会落到整数寄存器而读到错误字段。
fn llvm_apple_hfa_walk(unit *ir.IRModule, type_id int, float_kind *int,
    count *int, depth int) int {
    if (unit == 0 || type_id < 0 || type_id >= unit.type_count || depth > 64) { return -1 }
    let ty ir.IRModuleType = unit.types[type_id]
    if (ty.kind == ir.IR_TY_F32 || ty.kind == ir.IR_TY_F64) {
        if (float_kind[0] == 0) { float_kind[0] = ty.kind }
        else if (float_kind[0] != ty.kind) { return 0 }
        count[0] += 1
        return 1
    }
    if (ty.kind == ir.IR_MODULE_TY_UNION) {
        let i int = 0
        let widest int = 0
        for i < ty.field_count {
            let child_kind int = 0
            let child_count int = 0
            let child_status int = llvm_apple_hfa_walk(unit, ty.fields[i].type_id,
                &child_kind, &child_count, depth + 1)
            if (child_status < 0) { return -1 }
            if (child_status == 0) { return 0 }
            if (float_kind[0] == 0) { float_kind[0] = child_kind }
            else if (float_kind[0] != child_kind) { return 0 }
            if (child_count > widest) { widest = child_count }
            i += 1
        }
        if (widest == 0) { return 0 }
        count[0] += widest
        return 1
    }
    if (ty.kind == ir.IR_MODULE_TY_STRUCT || ty.kind == ir.IR_MODULE_TY_ARRAY) {
        let field_count int = ty.kind == ir.IR_MODULE_TY_ARRAY ? ty.count : ty.field_count
        let i int = 0
        for i < field_count {
            let child_type int = ty.kind == ir.IR_MODULE_TY_ARRAY ?
                ty.elem : ty.fields[i].type_id
            let child_kind int = 0
            let child_count int = 0
            let child_status int = llvm_apple_hfa_walk(unit, child_type,
                &child_kind, &child_count, depth + 1)
            if (child_status < 0) { return -1 }
            if (child_status == 0) { return 0 }
            if (float_kind[0] == 0) { float_kind[0] = child_kind }
            else if (float_kind[0] != child_kind) { return 0 }
            count[0] += child_count
            i += 1
        }
        return count[0] > 0 ? 1 : 0
    }
    return 0
}

// llvm_apple_abi_classify：按 Apple 规则区分直接整数聚合、间接大聚合和未实现 HFA。
fn llvm_apple_abi_classify(unit *ir.IRModule, type_id int,
    out *LLVMAppleABIInfo) int {
    if (unit == 0 || out == 0 || type_id < 0 || type_id >= unit.type_count) { return -1 }
    let ty ir.IRModuleType = unit.types[type_id]
    if (llvm_apple_abi_is_aggregate(ty.kind) == 0 || ty.size <= 0 || ty.align <= 0) { return -1 }
    let empty LLVMAppleABIInfo
    out[0] = empty
    out.size = ty.size
    out.align = ty.align
    let hfa_kind int = 0
    let hfa_count int = 0
    let hfa_status int = llvm_apple_hfa_walk(unit, type_id, &hfa_kind, &hfa_count, 0)
    if (hfa_status < 0) { return -1 }
    if (hfa_status != 0 && hfa_count > 0 && hfa_count <= 4) {
        out.kind = LLVM_APPLE_ABI_HFA
        out.hfa_type_kind = hfa_kind
        out.hfa_count = hfa_count
        return 0
    }
    if (ty.size <= 16) {
        out.kind = LLVM_APPLE_ABI_DIRECT
        out.return_bits = ty.size <= 8 ? ty.size * 8 : 128
        out.tail_bits = ty.size <= 8 ? 0 : (ty.size - 8) * 8
        return 0
    }
    out.kind = LLVM_APPLE_ABI_INDIRECT
    return 0
}

// llvm_apple_abi_supported：只开放当前已实现的非 HFA Apple C 聚合形状。
fn llvm_apple_abi_supported(unit *ir.IRModule, type_id int) int {
    let info LLVMAppleABIInfo
    return llvm_apple_abi_classify(unit, type_id, &info) == 0 &&
        info.kind != LLVM_APPLE_ABI_HFA_UNSUPPORTED ? 1 : 0
}

// llvm_apple_abi_write_hfa_type：输出 LLVM 参数数组或平铺结果结构，元素数取自递归分类。
fn llvm_apple_abi_write_hfa_type(info *LLVMAppleABIInfo,
    out *LLVMOutput, return_mode int) void {
    if (return_mode != 0) { llvm_byte(out, '{') }
    else {
        llvm_byte(out, '['); llvm_number(out, info.hfa_count.to_type(u64))
        llvm_text(out, " x ")
        llvm_text(out, info.hfa_type_kind == ir.IR_TY_F32 ? "float" : "double")
        llvm_byte(out, ']')
        return
    }
    let i int = 0
    for i < info.hfa_count {
        if (return_mode != 0 && i > 0) { llvm_text(out, ", ") }
        llvm_text(out, info.hfa_type_kind == ir.IR_TY_F32 ? "float" : "double")
        i += 1
    }
    if (return_mode != 0) { llvm_byte(out, '}') }
    else { llvm_byte(out, ']') }
}

// llvm_apple_abi_write_bytes_type：输出 opaque-pointer sret 属性所需的字节数组类型。
fn llvm_apple_abi_write_bytes_type(info *LLVMAppleABIInfo, out *LLVMOutput) void {
    llvm_byte(out, '['); llvm_number(out, info.size.to_type(u64))
    llvm_text(out, " x i8]")
}

// llvm_apple_abi_write_return_type：输出 Darwin 直接聚合的 iN 或双字寄存器元组。
fn llvm_apple_abi_write_return_type(info *LLVMAppleABIInfo, out *LLVMOutput) void {
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        llvm_apple_abi_write_hfa_type(info, out, 1)
    } else if (info.size <= 8) {
        llvm_byte(out, 'i'); llvm_number(out, info.return_bits.to_type(u64))
    } else { llvm_text(out, "[2 x i64]") }
}

// llvm_apple_abi_write_value_type：输出 Darwin 参数侧单 X 寄存器或两 X 寄存器元组。
fn llvm_apple_abi_write_value_type(info *LLVMAppleABIInfo, out *LLVMOutput) void {
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        llvm_apple_abi_write_hfa_type(info, out, 0)
    } else if (info.size <= 8) { llvm_text(out, "i64") }
    else { llvm_text(out, "[2 x i64]") }
}

// llvm_apple_abi_signature：声明与定义共用 Apple 聚合签名，返回、参数均按源布局分类。
fn llvm_apple_abi_signature(unit *ir.IRModule, symbol *ir.IRModuleSymbol,
    out *LLVMOutput, definition int) void {
    let result ir.IRModuleType = unit.types[symbol.type_id]
    let aggregate_return int = llvm_apple_abi_is_aggregate(result.kind)
    let result_info LLVMAppleABIInfo
    let memory_return int = 0
    if (aggregate_return != 0) {
        llvm_apple_abi_classify(unit, symbol.type_id, &result_info)
        memory_return = result_info.kind == LLVM_APPLE_ABI_INDIRECT ? 1 : 0
    }
    if (memory_return != 0) { llvm_text(out, "void") }
    else if (aggregate_return != 0) { llvm_apple_abi_write_return_type(&result_info, out) }
    else {
        let result_attr int = llvm_abi_attr_kind(unit, symbol.abi, result.kind)
        if (result_attr == 1) { llvm_text(out, "signext ") }
        else if (result_attr == 2) { llvm_text(out, "zeroext ") }
        llvm_abi_type(out, symbol.abi, result.kind, result.bits)
    }
    llvm_text(out, " @"); llvm_string(out, symbol.name); llvm_byte(out, '(')
    let physical int = 0
    if (memory_return != 0) {
        llvm_text(out, "ptr sret("); llvm_apple_abi_write_bytes_type(&result_info, out)
        llvm_text(out, ") align "); llvm_number(out, result_info.align.to_type(u64))
        if (definition != 0) { llvm_text(out, " %p0") }
        physical = 1
    }
    let i int = 0
    for i < symbol.param_count {
        let ty ir.IRModuleType = unit.types[symbol.params[i]]
        if (physical > 0) { llvm_text(out, ", ") }
        if (llvm_apple_abi_is_aggregate(ty.kind) != 0) {
            let info LLVMAppleABIInfo
            llvm_apple_abi_classify(unit, symbol.params[i], &info)
            if (info.kind == LLVM_APPLE_ABI_INDIRECT) { llvm_text(out, "ptr") }
            else { llvm_apple_abi_write_value_type(&info, out) }
        } else {
            llvm_abi_type(out, symbol.abi, ty.kind, ty.bits)
            let attr int = llvm_abi_attr_kind(unit, symbol.abi, ty.kind)
            if (attr == 1) { llvm_text(out, " signext") }
            else if (attr == 2) { llvm_text(out, " zeroext") }
        }
        if (definition != 0) { llvm_text(out, " %p"); llvm_number(out, physical.to_type(u64)) }
        physical += 1
        i += 1
    }
    if (symbol.variadic == 1) {
        if (physical > 0) { llvm_text(out, ", ") }
        llvm_text(out, "...")
    }
    llvm_byte(out, ')')
}

// llvm_apple_abi_is_memory_return：只有超过 16 字节的聚合使用独立 sret 指针。
fn llvm_apple_abi_is_memory_return(unit *ir.IRModule, symbol *ir.IRModuleSymbol) int {
    if (symbol.abi != support.ABI_C
        || llvm_apple_abi_is_aggregate(unit.types[symbol.type_id].kind) == 0) { return 0 }
    let info LLVMAppleABIInfo
    if (llvm_apple_abi_classify(unit, symbol.type_id, &info) != 0) { return 0 }
    return info.kind == LLVM_APPLE_ABI_INDIRECT ? 1 : 0
}

// llvm_apple_abi_param_physical：Apple 聚合各占一个物理参数，只有 indirect sret 前移编号。
fn llvm_apple_abi_param_physical(unit *ir.IRModule,
    symbol *ir.IRModuleSymbol, logical int) int {
    if (logical < 0 || logical >= symbol.param_count) { return -1 }
    return llvm_apple_abi_is_memory_return(unit, symbol) + logical
}

// llvm_apple_abi_store_temp：把一个物理参数片存进聚合局部副本，偏移保持字节精确。
fn llvm_apple_abi_store_temp(out *LLVMOutput, base int, base_is_temp int,
    offset int, bits int, value int, next *int) void {
    let address int = base
    if (offset > 0) {
        address = llvm_new_temp(out, next)
        llvm_text(out, "getelementptr i8, ptr ")
        if (base_is_temp != 0) { llvm_temp(out, base) } else { llvm_value(out, base) }
        llvm_text(out, ", i64 "); llvm_number(out, offset.to_type(u64)); llvm_byte(out, '\n')
    }
    let stored int = value
    if (bits < 64) {
        stored = llvm_new_temp(out, next)
        llvm_text(out, "trunc i64 "); llvm_temp(out, value)
        llvm_text(out, " to i"); llvm_number(out, bits.to_type(u64)); llvm_byte(out, '\n')
    }
    llvm_text(out, "  store i"); llvm_number(out, bits.to_type(u64)); llvm_byte(out, ' ')
    llvm_temp(out, stored); llvm_text(out, ", ptr ")
    if (offset > 0) { llvm_temp(out, address) }
    else if (base_is_temp != 0) { llvm_temp(out, address) }
    else { llvm_value(out, address) }
    llvm_text(out, ", align 1\n")
}

// llvm_apple_abi_store_hfa_field：把单个 HFA 浮点成员写到 YH 聚合字节缓冲的源布局偏移。
fn llvm_apple_abi_store_hfa_field(out *LLVMOutput, buffer int,
    offset int, kind int, value int, next *int) void {
    let address int = buffer
    if (offset > 0) {
        address = llvm_new_temp(out, next)
        llvm_text(out, "getelementptr i8, ptr %v"); llvm_number(out, buffer.to_type(u64))
        llvm_text(out, ", i64 "); llvm_number(out, offset.to_type(u64)); llvm_byte(out, '\n')
    }
    llvm_text(out, "  store "); llvm_type(out, kind, kind == ir.IR_TY_F32 ? 32 : 64)
    llvm_text(out, " %t"); llvm_number(out, value.to_type(u64)); llvm_text(out, ", ptr ")
    if (offset > 0) { llvm_temp(out, address) }
    else { llvm_value(out, address) }
    llvm_text(out, ", align 1\n")
}

// llvm_apple_abi_store_hfa_param_walk：递归从 HFA LLVM 参数数组中拆元素并还原结构体内存。
fn llvm_apple_abi_store_hfa_param_walk(unit *ir.IRModule, type_id int,
    base int, buffer int, physical int, info *LLVMAppleABIInfo,
    index *int, next *int, out *LLVMOutput, depth int) int {
    if (depth > 64 || type_id < 0 || type_id >= unit.type_count) { return -1 }
    let ty ir.IRModuleType = unit.types[type_id]
    if (ty.kind == ir.IR_TY_F32 || ty.kind == ir.IR_TY_F64) {
        let value int = llvm_new_temp(out, next)
        llvm_text(out, "extractvalue ")
        llvm_apple_abi_write_hfa_type(info, out, 0)
        llvm_text(out, " %p"); llvm_number(out, physical.to_type(u64))
        llvm_text(out, ", "); llvm_number(out, index[0].to_type(u64)); llvm_byte(out, '\n')
        llvm_apple_abi_store_hfa_field(out, buffer, base, ty.kind, value, next)
        index[0] += 1
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_UNION) {
        // 联合体成员全部从偏移 0 开始、内存重叠：只能沿其中最宽的成员读写，
        // 否则会把同一块存储重复写入/读出多份元素。分类器对联合体取的是
        // 各成员 HFA 元素数的最大值，这里选宽度最大的成员与之对齐。
        let best int = -1
        let best_size int = -1
        let field int = 0
        for field < ty.field_count {
            let child_type int = ty.fields[field].type_id
            if (child_type < 0 || child_type >= unit.type_count) { return -1 }
            let child ir.IRModuleType = unit.types[child_type]
            if (child.size > best_size) {
                best_size = child.size
                best = child_type
            }
            field += 1
        }
        if (best < 0) { return -1 }
        return llvm_apple_abi_store_hfa_param_walk(unit, best, base, buffer,
            physical, info, index, next, out, depth + 1)
    }
    if (ty.kind == ir.IR_MODULE_TY_STRUCT) {
        let field int = 0
        for field < ty.field_count {
            let item ir.IRModuleField = ty.fields[field]
            if (llvm_apple_abi_store_hfa_param_walk(unit, item.type_id,
                base + item.offset, buffer, physical, info, index, next, out, depth + 1) != 0) {
                return -1
            }
            field += 1
        }
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_ARRAY) {
        let elem ir.IRModuleType = unit.types[ty.elem]
        let item int = 0
        for item < ty.count {
            if (llvm_apple_abi_store_hfa_param_walk(unit, ty.elem,
                base + item * elem.size, buffer, physical, info, index, next, out, depth + 1) != 0) {
                return -1
            }
            item += 1
        }
        return 0
    }
    return -1
}

// llvm_apple_abi_load_hfa_walk：从 YH 聚合地址加载浮点叶子并逐项组装 HFA 参数/返回值。
fn llvm_apple_abi_load_hfa_walk(unit *ir.IRModule, type_id int,
    base int, pointer int, info *LLVMAppleABIInfo, return_mode int,
    index *int, aggregate_value *int, next *int, out *LLVMOutput, depth int) int {
    if (depth > 64 || type_id < 0 || type_id >= unit.type_count) { return -1 }
    let ty ir.IRModuleType = unit.types[type_id]
    if (ty.kind == ir.IR_TY_F32 || ty.kind == ir.IR_TY_F64) {
        let address int = pointer
        if (base > 0) {
            address = llvm_new_temp(out, next)
            llvm_text(out, "getelementptr i8, ptr %v"); llvm_number(out, pointer.to_type(u64))
            llvm_text(out, ", i64 "); llvm_number(out, base.to_type(u64)); llvm_byte(out, '\n')
        }
        let value int = llvm_new_temp(out, next)
        llvm_text(out, "load "); llvm_type(out, ty.kind, ty.kind == ir.IR_TY_F32 ? 32 : 64)
        llvm_text(out, ", ptr ")
        if (base > 0) { llvm_temp(out, address) } else { llvm_value(out, address) }
        llvm_text(out, ", align 1\n")
        let combined int = llvm_new_temp(out, next)
        llvm_text(out, "insertvalue ")
        llvm_apple_abi_write_hfa_type(info, out, return_mode)
        if (index[0] == 0) { llvm_text(out, " poison, ") }
        else { llvm_byte(out, ' '); llvm_temp(out, aggregate_value[0]); llvm_text(out, ", ") }
        llvm_type(out, ty.kind, ty.kind == ir.IR_TY_F32 ? 32 : 64)
        llvm_byte(out, ' '); llvm_temp(out, value); llvm_text(out, ", ")
        llvm_number(out, index[0].to_type(u64)); llvm_byte(out, '\n')
        aggregate_value[0] = combined
        index[0] += 1
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_UNION) {
        // 联合体成员内存重叠：只沿最宽成员读取一遗，与分类器的「取最大元素数」一致。
        let best int = -1
        let best_size int = -1
        let field int = 0
        for field < ty.field_count {
            let child_type int = ty.fields[field].type_id
            if (child_type < 0 || child_type >= unit.type_count) { return -1 }
            let child ir.IRModuleType = unit.types[child_type]
            if (child.size > best_size) {
                best_size = child.size
                best = child_type
            }
            field += 1
        }
        if (best < 0) { return -1 }
        return llvm_apple_abi_load_hfa_walk(unit, best, base, pointer, info,
            return_mode, index, aggregate_value, next, out, depth + 1)
    }
    if (ty.kind == ir.IR_MODULE_TY_STRUCT) {
        let field int = 0
        for field < ty.field_count {
            let item ir.IRModuleField = ty.fields[field]
            if (llvm_apple_abi_load_hfa_walk(unit, item.type_id,
                base + item.offset, pointer, info, return_mode, index,
                aggregate_value, next, out, depth + 1) != 0) { return -1 }
            field += 1
        }
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_ARRAY) {
        let elem ir.IRModuleType = unit.types[ty.elem]
        let item int = 0
        for item < ty.count {
            if (llvm_apple_abi_load_hfa_walk(unit, ty.elem,
                base + item * elem.size, pointer, info, return_mode, index,
                aggregate_value, next, out, depth + 1) != 0) { return -1 }
            item += 1
        }
        return 0
    }
    return -1
}

// llvm_apple_abi_store_hfa_result_walk：从 HFA 返回元组逐项取值并写回 YH 结果缓冲。
fn llvm_apple_abi_store_hfa_result_walk(unit *ir.IRModule, type_id int,
    base int, buffer int, result_value int, info *LLVMAppleABIInfo,
    index *int, next *int, out *LLVMOutput, depth int) int {
    if (depth > 64 || type_id < 0 || type_id >= unit.type_count) { return -1 }
    let ty ir.IRModuleType = unit.types[type_id]
    if (ty.kind == ir.IR_TY_F32 || ty.kind == ir.IR_TY_F64) {
        let value int = llvm_new_temp(out, next)
        llvm_text(out, "extractvalue ")
        llvm_apple_abi_write_hfa_type(info, out, 1)
        llvm_text(out, " %t"); llvm_number(out, result_value.to_type(u64))
        llvm_text(out, ", "); llvm_number(out, index[0].to_type(u64)); llvm_byte(out, '\n')
        llvm_apple_abi_store_hfa_field(out, buffer, base, ty.kind, value, next)
        index[0] += 1
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_UNION) {
        // 联合体成员内存重叠：只沿最宽成员写入一份，与分类器/参数恢复一致。
        let best int = -1
        let best_size int = -1
        let field int = 0
        for field < ty.field_count {
            let child_type int = ty.fields[field].type_id
            if (child_type < 0 || child_type >= unit.type_count) { return -1 }
            let child ir.IRModuleType = unit.types[child_type]
            if (child.size > best_size) {
                best_size = child.size
                best = child_type
            }
            field += 1
        }
        if (best < 0) { return -1 }
        return llvm_apple_abi_store_hfa_result_walk(unit, best, base, buffer,
            result_value, info, index, next, out, depth + 1)
    }
    if (ty.kind == ir.IR_MODULE_TY_STRUCT) {
        let field int = 0
        for field < ty.field_count {
            let item ir.IRModuleField = ty.fields[field]
            if (llvm_apple_abi_store_hfa_result_walk(unit, item.type_id,
                base + item.offset, buffer, result_value, info, index,
                next, out, depth + 1) != 0) { return -1 }
            field += 1
        }
        return 0
    }
    if (ty.kind == ir.IR_MODULE_TY_ARRAY) {
        let elem ir.IRModuleType = unit.types[ty.elem]
        let item int = 0
        for item < ty.count {
            if (llvm_apple_abi_store_hfa_result_walk(unit, ty.elem,
                base + item * elem.size, buffer, result_value, info, index,
                next, out, depth + 1) != 0) { return -1 }
            item += 1
        }
        return 0
    }
    return -1
}

// llvm_apple_abi_param：将 Darwin C ABI 参数恢复成 YH IR 使用的聚合地址或物理编号。
fn llvm_apple_abi_param(unit *ir.IRModule, symbol *ir.IRModuleSymbol,
    out *LLVMOutput, inst *ir.IRInst, next *int, physical_out *int) int {
    let logical int = inst.imm.to_type(int)
    let aggregate_return int = llvm_apple_abi_is_aggregate(unit.types[symbol.type_id].kind)
    let memory_return int = llvm_apple_abi_is_memory_return(unit, symbol)
    if (logical == 0 && aggregate_return != 0) {
        if (memory_return != 0) {
            llvm_text(out, "  %v"); llvm_number(out, inst.result_id.to_type(u64))
            llvm_text(out, " = getelementptr i8, ptr %p0, i64 0\n")
        } else {
            llvm_abi_alloc_bytes(out, inst.result_id, unit.types[symbol.type_id])
        }
        return 1
    }
    let param int = logical - aggregate_return
    if (param < 0 || param >= symbol.param_count) { return 0 }
    let type_id int = symbol.params[param]
    let ty ir.IRModuleType = unit.types[type_id]
    if (llvm_apple_abi_is_aggregate(ty.kind) == 0) { return 0 }
    let info LLVMAppleABIInfo
    if (llvm_apple_abi_classify(unit, type_id, &info) != 0
        || info.kind == LLVM_APPLE_ABI_HFA_UNSUPPORTED) { return 0 }
    let physical int = llvm_apple_abi_param_physical(unit, symbol, param)
    if (physical < 0) { return 0 }
    physical_out[0] = physical
    if (info.kind == LLVM_APPLE_ABI_INDIRECT) {
        llvm_text(out, "  %v"); llvm_number(out, inst.result_id.to_type(u64))
        llvm_text(out, " = getelementptr i8, ptr %p")
        llvm_number(out, physical.to_type(u64)); llvm_text(out, ", i64 0\n")
        return 1
    }
    llvm_abi_alloc_bytes(out, inst.result_id, ty)
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        let index int = 0
        return llvm_apple_abi_store_hfa_param_walk(unit, type_id, 0,
            inst.result_id, physical, &info, &index, next, out, 0) == 0 ? 1 : 0
    }
    if (info.size <= 8) {
        let value int = physical
        if (info.return_bits < 64) {
            value = llvm_new_temp(out, next)
            llvm_text(out, "trunc i64 %p"); llvm_number(out, physical.to_type(u64))
            llvm_text(out, " to i"); llvm_number(out, info.return_bits.to_type(u64))
            llvm_byte(out, '\n')
        }
        llvm_text(out, "  store i"); llvm_number(out, info.return_bits.to_type(u64))
        llvm_byte(out, ' ')
        if (info.return_bits < 64) { llvm_temp(out, value) }
        else { llvm_text(out, "%p"); llvm_number(out, physical.to_type(u64)) }
        llvm_text(out, ", ptr %v"); llvm_number(out, inst.result_id.to_type(u64))
        llvm_text(out, ", align 1\n")
        return 1
    }
    let first int = llvm_new_temp(out, next)
    llvm_text(out, "extractvalue [2 x i64] %p"); llvm_number(out, physical.to_type(u64))
    llvm_text(out, ", 0\n")
    llvm_text(out, "  store i64 "); llvm_temp(out, first); llvm_text(out, ", ptr %v")
    llvm_number(out, inst.result_id.to_type(u64)); llvm_text(out, ", align 1\n")
    let second int = llvm_new_temp(out, next)
    llvm_text(out, "extractvalue [2 x i64] %p"); llvm_number(out, physical.to_type(u64))
    llvm_text(out, ", 1\n")
    llvm_apple_abi_store_temp(out, inst.result_id, 0, 8, info.tail_bits, second, next)
    return 1
}

// llvm_apple_abi_load_word：从聚合实参按 ABI 所需位宽加载并零扩展至一个 X 寄存器。
fn llvm_apple_abi_load_word(out *LLVMOutput, pointer int, pointer_is_temp int,
    offset int, bits int, next *int) int {
    let address int = pointer
    if (offset > 0) {
        address = llvm_new_temp(out, next)
        llvm_text(out, "getelementptr i8, ptr ")
        if (pointer_is_temp != 0) { llvm_temp(out, pointer) } else { llvm_value(out, pointer) }
        llvm_text(out, ", i64 "); llvm_number(out, offset.to_type(u64)); llvm_byte(out, '\n')
    }
    let loaded int = llvm_new_temp(out, next)
    llvm_text(out, "load i"); llvm_number(out, bits.to_type(u64)); llvm_text(out, ", ptr ")
    if (offset > 0 || pointer_is_temp != 0) { llvm_temp(out, address) }
    else { llvm_value(out, address) }
    llvm_text(out, ", align 1\n")
    if (bits == 64) { return loaded }
    let extended int = llvm_new_temp(out, next)
    llvm_text(out, "zext i"); llvm_number(out, bits.to_type(u64)); llvm_byte(out, ' ')
    llvm_temp(out, loaded); llvm_text(out, " to i64\n")
    return extended
}

// llvm_apple_abi_emit_direct_argument：读取 YH 聚合缓冲并形成 Apple 物理参数值。
fn llvm_apple_abi_emit_direct_argument(unit *ir.IRModule, type_id int,
    out *LLVMOutput, pointer int, info *LLVMAppleABIInfo, next *int) int {
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        let index int = 0
        let value int = -1
        if (llvm_apple_abi_load_hfa_walk(unit, type_id, 0, pointer, info, 0,
            &index, &value, next, out, 0) != 0) { return -1 }
        return value
    }
    let first int = llvm_apple_abi_load_word(out, pointer, 0, 0,
        info.size <= 8 ? info.return_bits : 64, next)
    if (info.size <= 8) { return first }
    let second int = llvm_apple_abi_load_word(out, pointer, 0, 8, info.tail_bits, next)
    let aggregate int = llvm_new_temp(out, next)
    llvm_text(out, "insertvalue [2 x i64] poison, i64 "); llvm_temp(out, first)
    llvm_text(out, ", 0\n")
    let complete int = llvm_new_temp(out, next)
    llvm_text(out, "insertvalue [2 x i64] "); llvm_temp(out, aggregate)
    llvm_text(out, ", i64 "); llvm_temp(out, second); llvm_text(out, ", 1\n")
    return complete
}

// llvm_apple_abi_write_result：把 Apple 直接返回值还原写入 YH 聚合结果缓冲。
fn llvm_apple_abi_write_result(unit *ir.IRModule, type_id int,
    out *LLVMOutput, pointer int, info *LLVMAppleABIInfo,
    call_result int, next *int) void {
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        let index int = 0
        if (llvm_apple_abi_store_hfa_result_walk(unit, type_id, 0,
            pointer, call_result, info, &index, next, out, 0) != 0) { out.failed = 1 }
        return
    }
    if (info.size <= 8) {
        llvm_text(out, "  store i"); llvm_number(out, info.return_bits.to_type(u64))
        llvm_text(out, " %t"); llvm_number(out, call_result.to_type(u64))
        llvm_text(out, ", ptr %v"); llvm_number(out, pointer.to_type(u64))
        llvm_text(out, ", align 1\n"); return
    }
    let first int = llvm_new_temp(out, next)
    llvm_text(out, "extractvalue [2 x i64] %t"); llvm_number(out, call_result.to_type(u64))
    llvm_text(out, ", 0\n  store i64 "); llvm_temp(out, first)
    llvm_text(out, ", ptr %v"); llvm_number(out, pointer.to_type(u64))
    llvm_text(out, ", align 1\n")
    let second int = llvm_new_temp(out, next)
    llvm_text(out, "extractvalue [2 x i64] %t"); llvm_number(out, call_result.to_type(u64))
    llvm_text(out, ", 1\n")
    llvm_apple_abi_store_temp(out, pointer, 0, 8, info.tail_bits, second, next)
}

// llvm_apple_abi_emit_call：按 Apple 聚合 ABI 发射 C 调用、标量伴随参数与结果副本。
fn llvm_apple_abi_emit_call(unit *ir.IRModule, out *LLVMOutput,
    body *ir.IRFunction, inst *ir.IRInst, call *ir.IRCall,
    symbol *ir.IRModuleSymbol, next *int) void {
    let result_type int = symbol.type_id
    let result ir.IRModuleType = unit.types[result_type]
    let aggregate_return int = llvm_apple_abi_is_aggregate(result.kind)
    let result_info LLVMAppleABIInfo
    if (aggregate_return != 0) { llvm_apple_abi_classify(unit, result_type, &result_info) }
    let hidden int = aggregate_return
    let output_buffer int = hidden != 0 ? body.call_args[call.arg_first].value : -1
    let memory_return int = aggregate_return != 0 &&
        result_info.kind == LLVM_APPLE_ABI_INDIRECT ? 1 : 0
    let bool_result int = inst.result_type >= 0 && result.kind == ir.IR_TY_BOOL ? 1 : 0
    let bool_values *int = 0
    let aggregate_values *int = 0
    let aggregate_copies *int = 0
    let map_count int = symbol.param_count > 0 ? symbol.param_count : 1
    bool_values = malloc((map_count * sizeof(int)).to_type(u64)).to_type(*int)
    aggregate_values = malloc((map_count * sizeof(int)).to_type(u64)).to_type(*int)
    aggregate_copies = malloc((map_count * sizeof(int)).to_type(u64)).to_type(*int)
    if (bool_values == 0 || aggregate_values == 0 || aggregate_copies == 0) {
        if (bool_values != 0) { free(bool_values.to_type(*void)) }
        if (aggregate_values != 0) { free(aggregate_values.to_type(*void)) }
        if (aggregate_copies != 0) { free(aggregate_copies.to_type(*void)) }
        out.failed = 1; return
    }
    let arg int = 0
    for arg < symbol.param_count {
        bool_values[arg] = -1; aggregate_values[arg] = -1; aggregate_copies[arg] = -1
        arg += 1
    }
    let bool_result_temp int = -1
    arg = 0
    for arg < symbol.param_count {
        let type_id int = symbol.params[arg]
        let ty ir.IRModuleType = unit.types[type_id]
        let argument ir.IRCallArg = body.call_args[call.arg_first + arg + hidden]
        if (ty.kind == ir.IR_TY_BOOL) {
            bool_values[arg] = llvm_new_temp(out, next)
            llvm_text(out, "icmp ne i8 "); llvm_value(out, argument.value)
            llvm_text(out, ", 0\n")
        } else if (llvm_apple_abi_is_aggregate(ty.kind) != 0) {
            let info LLVMAppleABIInfo
            llvm_apple_abi_classify(unit, type_id, &info)
            if (info.kind == LLVM_APPLE_ABI_DIRECT || info.kind == LLVM_APPLE_ABI_HFA) {
                aggregate_values[arg] = llvm_apple_abi_emit_direct_argument(unit,
                    type_id, out, argument.value, &info, next)
            } else {
                let copy int = llvm_new_temp(out, next)
                llvm_text(out, "alloca ["); llvm_number(out, info.size.to_type(u64))
                llvm_text(out, " x i8], align "); llvm_number(out, info.align.to_type(u64))
                llvm_byte(out, '\n')
                aggregate_copies[arg] = copy
                llvm_text(out, "  call void @llvm.memmove.p0.p0.i64(ptr %t")
                llvm_number(out, copy.to_type(u64)); llvm_text(out, ", ptr %v")
                llvm_number(out, argument.value.to_type(u64)); llvm_text(out, ", i64 ")
                llvm_number(out, info.size.to_type(u64)); llvm_text(out, ", i1 false)\n")
            }
        }
        arg += 1
    }
    if (bool_result != 0) { bool_result_temp = llvm_new_temp(out, next) }
    else if (aggregate_return != 0 && memory_return == 0) {
        bool_result_temp = llvm_new_temp(out, next)
    } else if (aggregate_return == 0 && inst.result_id >= 0) {
        llvm_text(out, "  "); llvm_value(out, inst.result_id); llvm_text(out, " = ")
    }
    llvm_text(out, "call ")
    if (memory_return != 0) { llvm_text(out, "void") }
    else if (aggregate_return != 0) { llvm_apple_abi_write_return_type(&result_info, out) }
    else if (inst.result_type < 0) { llvm_text(out, "void") }
    else {
        let attr int = llvm_abi_attr_kind(unit, call.abi, result.kind)
        if (attr == 1) { llvm_text(out, "signext ") }
        else if (attr == 2) { llvm_text(out, "zeroext ") }
        llvm_abi_type(out, call.abi, result.kind, result.bits)
    }
    if (call.callee_value >= 0) {
        llvm_byte(out, ' '); llvm_value(out, call.callee_value)
    } else {
        llvm_text(out, " @"); llvm_quote(out,
            body.call_symbols + call.symbol_first, call.symbol_len)
    }
    llvm_byte(out, '(')
    let physical int = 0
    if (memory_return != 0) {
        llvm_text(out, "ptr sret("); llvm_apple_abi_write_bytes_type(&result_info, out)
        llvm_text(out, ") align "); llvm_number(out, result_info.align.to_type(u64))
        llvm_byte(out, ' '); llvm_value(out, output_buffer); physical = 1
    }
    arg = 0
    for arg < symbol.param_count {
        let type_id int = symbol.params[arg]
        let ty ir.IRModuleType = unit.types[type_id]
        let argument ir.IRCallArg = body.call_args[call.arg_first + arg + hidden]
        if (physical > 0) { llvm_text(out, ", ") }
        if (llvm_apple_abi_is_aggregate(ty.kind) != 0) {
            let info LLVMAppleABIInfo
            llvm_apple_abi_classify(unit, type_id, &info)
            if (info.kind == LLVM_APPLE_ABI_INDIRECT) {
                llvm_text(out, "ptr %t"); llvm_number(out, aggregate_copies[arg].to_type(u64))
            } else {
                llvm_apple_abi_write_value_type(&info, out); llvm_text(out, " %t")
                llvm_number(out, aggregate_values[arg].to_type(u64))
            }
        } else {
            llvm_abi_type(out, call.abi, ty.kind, ty.bits)
            let attr int = llvm_abi_attr_kind(unit, call.abi, ty.kind)
            if (attr == 1) { llvm_text(out, " signext") }
            else if (attr == 2) { llvm_text(out, " zeroext") }
            llvm_byte(out, ' ')
            if (ty.kind == ir.IR_TY_BOOL) { llvm_temp(out, bool_values[arg]) }
            else { llvm_value(out, argument.value) }
        }
        physical += 1
        arg += 1
    }
    llvm_text(out, ")\n")
    if (aggregate_return != 0 && memory_return == 0) {
        llvm_apple_abi_write_result(unit, result_type, out, output_buffer,
            &result_info, bool_result_temp, next)
    } else if (bool_result != 0) {
        llvm_text(out, "  "); llvm_value(out, inst.result_id); llvm_text(out, " = zext i1 %t")
        llvm_number(out, bool_result_temp.to_type(u64)); llvm_text(out, " to i8\n")
    }
    free(bool_values.to_type(*void))
    free(aggregate_values.to_type(*void))
    free(aggregate_copies.to_type(*void))
}

// llvm_apple_abi_return：把 C 函数体聚合结果按 Apple 直接返回或 sret 形式输出。
fn llvm_apple_abi_return(unit *ir.IRModule, symbol *ir.IRModuleSymbol,
    body *ir.IRFunction, out *LLVMOutput, next *int) int {
    if (symbol.abi != support.ABI_C
        || llvm_apple_abi_is_aggregate(unit.types[symbol.type_id].kind) == 0) { return 0 }
    let info LLVMAppleABIInfo
    if (llvm_apple_abi_classify(unit, symbol.type_id, &info) != 0
        || info.kind == LLVM_APPLE_ABI_HFA_UNSUPPORTED) { return 0 }
    if (info.kind == LLVM_APPLE_ABI_INDIRECT) { llvm_text(out, "  ret void\n"); return 1 }
    let buffer int = -1
    let i int = 0
    for i < body.inst_count {
        let inst ir.IRInst = body.insts[i]
        if (inst.op == ir.IR_OP_PARAM && inst.imm == 0) { buffer = inst.result_id; break }
        i += 1
    }
    if (buffer < 0) { out.failed = 1; return 1 }
    if (info.kind == LLVM_APPLE_ABI_HFA) {
        let index int = 0
        let value int = -1
        if (llvm_apple_abi_load_hfa_walk(unit, symbol.type_id, 0,
            buffer, &info, 1, &index, &value, next, out, 0) != 0) {
            out.failed = 1; return 1
        }
        llvm_text(out, "  ret "); llvm_apple_abi_write_hfa_type(&info, out, 1)
        llvm_text(out, " %t"); llvm_number(out, value.to_type(u64)); llvm_byte(out, '\n')
        return 1
    }
    if (info.size <= 8) {
        let value int = llvm_new_temp(out, next)
        llvm_text(out, "load i"); llvm_number(out, info.return_bits.to_type(u64))
        llvm_text(out, ", ptr %v"); llvm_number(out, buffer.to_type(u64))
        llvm_text(out, ", align 1\n  ret i")
        llvm_number(out, info.return_bits.to_type(u64)); llvm_text(out, " %t")
        llvm_number(out, value.to_type(u64)); llvm_byte(out, '\n')
        return 1
    }
    let first int = llvm_apple_abi_load_word(out, buffer, 0, 0, 64, next)
    let second int = llvm_apple_abi_load_word(out, buffer, 0, 8, info.tail_bits, next)
    let aggregate int = llvm_new_temp(out, next)
    llvm_text(out, "insertvalue [2 x i64] poison, i64 %t")
    llvm_number(out, first.to_type(u64)); llvm_text(out, ", 0\n")
    let complete int = llvm_new_temp(out, next)
    llvm_text(out, "insertvalue [2 x i64] %t"); llvm_number(out, aggregate.to_type(u64))
    llvm_text(out, ", i64 %t"); llvm_number(out, second.to_type(u64)); llvm_text(out, ", 1\n")
    llvm_text(out, "  ret [2 x i64] %t"); llvm_number(out, complete.to_type(u64)); llvm_byte(out, '\n')
    return 1
}
