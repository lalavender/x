module backend;

// ============================================================================
// llvm_bind.linux.yh —— 内嵌 LLVM 静态桥的 C ABI 声明（Linux 目标）
//
// 符号由 compiler/llvm/bridge.c、lld_bridge.cpp 编译出的归档提供，构建时经 tools/llvm-host.py
// 生成的链接包装器静态链入 yh 自身。契约见 llvm_bridge.yh 头部注释与
// compiler/llvm/bridge.h（改动必须三处同步）。
//
// 文件名后缀 `.linux` 由 cmd/project_index.yh 的 pj_source_target_match 按目标
// OS 筛选：Darwin 目标不会编入本文件，改用 llvm_bind.darwin.yh 的同一套 extern 声明。
// ============================================================================

@[extern] fn yh_llvm_version() *char;
@[extern] fn yh_llvm_emit(text *char, length u64, triple *char, opt_level int, kind int,
    output *char, diagnostic *char, capacity u64) int;
@[extern] fn yh_llvm_emit_v2(text *char, length u64, triple *char, min_os *char,
    opt_level int, kind int, output *char, diagnostic *char, capacity u64) int;
@[extern] fn yh_lld_link(argv **char, argc int, diagnostic *char, capacity u64) int;
@[extern] fn yh_lld_link_driver(output *char, objects **char, object_count int,
    extra_args **char, extra_count int, diagnostic *char, capacity u64) int;
@[extern] fn yh_lld_link_identity() *char;
@[extern] fn yh_lld_default_file_count() int;
@[extern] fn yh_lld_default_file(index int) *char;
@[extern] fn yh_lld_default_library_count() int;
@[extern] fn yh_lld_default_library(index int) *char;
@[extern] fn yh_lld_selfhost_flag_count() int;
@[extern] fn yh_lld_selfhost_flag(index int) *char;
@[extern] fn yh_lld_resolve_library(name *char, path *char, capacity u64) int;
