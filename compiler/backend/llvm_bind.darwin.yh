module backend;

// ============================================================================
// llvm_bind.darwin.yh —— 内嵌 LLVM 静态桥的桩定义（Darwin 目标）
//
// 固定 LLVM SDK 只发布 Linux 宿主（tools/llvm-host.py 的 hosts 表只有
// linux-x86_64 与 linux-aarch64），macOS 上没有可链接的桥归档。这里提供返回
// 失败的桩，让 yh 能在 macOS 上完成自举链接；该宿主的 LLVM 后端不可用
// （`--backend llvm` 会得到桥的失败诊断），旧机器后端路径完全不受影响。
//
// 文件名后缀 `.darwin` 由 cmd/project_index.yh 的 pj_source_target_match 按目标
// OS 筛选：Linux 目标不会编入本文件，改用 llvm_bind.linux.yh 的 @[extern] 声明。
// ============================================================================

// yh_llvm_version：Darwin 上没有桥，返回明确的不可用标记而不是空串，
// 便于 `yh version`/诊断区分「未链入」与「版本未知」。
fn yh_llvm_version() *char { return "unavailable-on-darwin"; }

// yh_llvm_emit：桩，永远失败；调用方（llvm_bridge_emit）据此返回 -1 并带诊断。
fn yh_llvm_emit(text *char, length u64, triple *char, opt_level int, kind int,
    output *char, diagnostic *char, capacity u64) int {
    return -1;
}

// yh_lld_link_driver：桩，永远失败；Darwin 的链接走宿主 clang，不经过内嵌 lld。
fn yh_lld_link_driver(output *char, objects **char, object_count int,
    extra_args **char, extra_count int, diagnostic *char, capacity u64) int {
    return -1;
}

// yh_lld_link_identity：返回空串表示「没有内嵌 lld」。
fn yh_lld_link_identity() *char { return ""; }

// yh_lld_default_file_count：没有默认启动文件模板。
fn yh_lld_default_file_count() int { return 0; }

// yh_lld_default_file：没有默认启动文件，返回空串。
fn yh_lld_default_file(index int) *char { return ""; }

// yh_lld_default_library_count：没有默认库模板。
fn yh_lld_default_library_count() int { return 0; }

// yh_lld_default_library：没有默认库，返回空串。
fn yh_lld_default_library(index int) *char { return ""; }

// yh_lld_resolve_library：没有内嵌 lld，无法解析库文件。
fn yh_lld_resolve_library(name *char, path *char, capacity u64) int {
    return -1;
}
