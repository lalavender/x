module backend
import gen
import ir

// ============================================================================
// llvm_runtime.yh —— yh 自有内存与 Linux x64 运行时的 LLVM IR 发射（LL8）
//
// 本片提供 memcpy/memset/strlen，聚合副本另按需提供 memmove，供 LL5 复制/清零与
// 字节内存的 lowering 复用。入口与用户函数同模块发射，不依赖尚未完成的
// 指针/聚合 lowering，也不调用任何外部 LLVM 工具。
//
// 契约（与 yh prelude、目标 C ABI 一致；均为逐字节实现，按未知对齐处理）：
//   memcpy(dst *void, src *void, n u64) *void
//     复制 n 字节并返回 dst；dst 与 src 区域不得重叠（与 C memcpy 相同，
//     编译器的聚合副本改用允许重叠的 memmove，不改变用户 memcpy 契约）。
//   memmove(dst *void, src *void, n u64) *void
//     允许重叠；目标在源之后时逆向复制，其余前向，同址/零长度直接返回。
//   memset(dst *void, value int, n u64) *void
//     用 value 的低 8 位填充 n 字节并返回 dst。
//   strlen(s *char) u64
//     返回 s 到首个 NUL 的字节数，不含 NUL；s 必须已终止。
//
// 发射形态：weak 定义 + llvm.used 标记。
//   * weak：多模块各带一份时不产生重复定义，链接器任选一份；用户同名强定义
//     优先。模块若已有同名符号（声明或定义）则本片不发射该入口，避免 IR 重名。
//   * llvm.used：阻止 O2 的 GlobalDCE 删除未被引用的弱定义，保证 O0/O2 产物
//     都带入口（LL8a 验收要求）。
//   * optnone + noinline + nobuiltin：阻止 loop-idiom 把逐字节循环改写成对自身
//     memcpy/memset 的 libcall，避免自递归；代价是入口保持低优化，LL8b 用
//     yh/IR 迁移运行时后再评估优化与对齐。
// ============================================================================

// llvm_runtime_named：模块符号表里是否已有该名称（声明或定义都算），
// 用于让用户定义优先并避免与 helper 定义重名。
fn llvm_runtime_named(unit *ir.IRModule, name *char) int {
    let i int = 0
    for i < unit.symbol_count {
        if (gen.cstr_eq(unit.symbols[i].name, name) != 0) { return 1 }
        i += 1
    }
    return 0
}

// llvm_runtime_defined：同名声明可以由弱运行时定义满足；强定义仍由用户优先。
fn llvm_runtime_defined(unit *ir.IRModule, name *char) int {
    let i int = 0
    for i < unit.symbol_count {
        if (unit.symbols[i].defined != 0
            && gen.cstr_eq(unit.symbols[i].name, name) != 0) { return 1 }
        i += 1
    }
    return 0
}

// llvm_runtime_supplies_symbol：声明循环需跳过即将由本模块 helper 满足的裸符号。
pub fn llvm_runtime_supplies_symbol(unit *ir.IRModule, name *char) int {
    if (llvm_runtime_defined(unit, name) != 0) { return 0 }
    if (gen.cstr_eq(name, "memcpy") != 0 || gen.cstr_eq(name, "memset") != 0
        || gen.cstr_eq(name, "strlen") != 0) { return 1 }
    if (gen.cstr_eq(name, "memmove") != 0) { return llvm_runtime_aggregate_copy(unit) }
    if (gen.cstr_eq(name, "__yh_runtime_malloc") != 0
        || gen.cstr_eq(name, "__yh_runtime_free") != 0
        || gen.cstr_eq(name, "printf") != 0 || gen.cstr_eq(name, "linux_syscall6") != 0) {
        return 1
    }
    // Windows/x64 零 CRT：write/read/exit/_Exit 也由本模块的 Windows 运行时定义，
    // 声明阶段必须跳过它们——LLVM 不允许同名 declare + define（2026-10-27 W1-3b）。
    if (gen.cstr_eq(unit.target.abi, "win64-msvc") != 0) {
        // 只列「运行时真的给出定义」的名字：LLVM 不允许同名 declare + define。
        // exit/_Exit 由链接期 /alternatename 解析到 ExitProcess，因此仍按普通
        // 外部符号声明（否则调用点会缺声明）。
        if (gen.cstr_eq(name, "write") != 0 || gen.cstr_eq(name, "read") != 0
            || gen.cstr_eq(name, "open") != 0 || gen.cstr_eq(name, "close") != 0
            || gen.cstr_eq(name, "mkdir") != 0 || gen.cstr_eq(name, "unlink") != 0
            || gen.cstr_eq(name, "rename") != 0
            || gen.cstr_eq(name, "getpid") != 0 || gen.cstr_eq(name, "getppid") != 0) {
            return 1
        }
    }
    // yh test 断言运行时：由本模块发射弱定义（见 llvm_runtime_write_test_assert）。
    if (gen.cstr_eq(name, "__yh_test_assert") != 0) { return 1 }
    return 0
}

// llvm_runtime_aggregate_copy：只要实际函数含聚合副本，目标码就可能调用 memmove。
// 预检同名用户符号与按需发射 helper 共用这个判断，不能在两处采用不同边界。
fn llvm_runtime_aggregate_copy(unit *ir.IRModule) int {
    let i int = 0
    for i < unit.function_count {
        let j int = 0
        for j < unit.functions[i].body.inst_count {
            if (unit.functions[i].body.insts[j].op == ir.IR_OP_MEMCPY) { return 1 }
            j += 1
        }
        i += 1
    }
    return 0
}

// llvm_runtime_weak_signature：发射 weak 定义签名。
// ELF/Mach-O 的 weak 定义会被链接器自然合并；COFF 的 weak 是「带备用符号的
// 弱外部」，同名多份会被 lld-link 判成 duplicate symbol。因此 Windows 目标
// 额外发射 `$<name> = comdat any` 并把函数挂到同名 COMDAT，多模块各自携带
// 的运行时在链接时只保留一份。
fn llvm_runtime_weak_signature(out *LLVMOutput, name *char, hidden int,
    win64 int, signature *char) void {
    if (win64 != 0) {
        llvm_text(out, "$")
        llvm_text(out, name)
        llvm_text(out, " = comdat any\n")
    }
    llvm_text(out, "define weak ")
    if (hidden != 0) { llvm_text(out, "hidden ") }
    llvm_text(out, signature)
    if (win64 != 0) {
        llvm_text(out, " comdat($")
        llvm_text(out, name)
        llvm_text(out, ")")
    }
    llvm_text(out, " {\n")
}

// llvm_runtime_write_memcpy：按目标发射 memcpy 定义；n==0 直接返回，复制按字节推进。
fn llvm_runtime_write_memcpy(out *LLVMOutput, hidden int, win64 int) void {
    llvm_runtime_weak_signature(out, "memcpy", hidden, win64,
        "ptr @memcpy(ptr %dst, ptr %src, i64 %n) noinline nounwind optnone nobuiltin")
    llvm_text(out, "entry:\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %done, label %loop\n")
    llvm_text(out, "loop:\n  %i = phi i64 [ 0, %entry ], [ %next, %loop ]\n")
    llvm_text(out, "  %d = getelementptr i8, ptr %dst, i64 %i\n")
    llvm_text(out, "  %s = getelementptr i8, ptr %src, i64 %i\n")
    llvm_text(out, "  %byte = load i8, ptr %s, align 1\n")
    llvm_text(out, "  store i8 %byte, ptr %d, align 1\n")
    llvm_text(out, "  %next = add i64 %i, 1\n  %more = icmp ult i64 %next, %n\n")
    llvm_text(out, "  br i1 %more, label %loop, label %done\n")
    llvm_text(out, "done:\n  ret ptr %dst\n}\n\n")
}

// llvm_runtime_write_memmove：大聚合的 LLVM intrinsic 可能降为 libcall；提供不
// 依赖 libc 的前后向字节循环。禁止循环惯用法重新生成对自身的递归调用。
fn llvm_runtime_write_memmove(out *LLVMOutput, hidden int, win64 int) void {
    llvm_runtime_weak_signature(out, "memmove", hidden, win64,
        "ptr @memmove(ptr %dst, ptr %src, i64 %n) noinline nounwind optnone nobuiltin")
    llvm_text(out, "entry:\n  %empty = icmp eq i64 %n, 0\n  %same = icmp eq ptr %dst, %src\n")
    llvm_text(out, "  %skip = or i1 %empty, %same\n  br i1 %skip, label %done, label %direction\n")
    llvm_text(out, "direction:\n  %backward = icmp ugt ptr %dst, %src\n")
    llvm_text(out, "  br i1 %backward, label %reverse, label %forward\n")
    llvm_text(out, "forward:\n  %i = phi i64 [ 0, %direction ], [ %next, %forward ]\n")
    llvm_text(out, "  %fd = getelementptr i8, ptr %dst, i64 %i\n  %fs = getelementptr i8, ptr %src, i64 %i\n")
    llvm_text(out, "  %fb = load i8, ptr %fs, align 1\n  store i8 %fb, ptr %fd, align 1\n")
    llvm_text(out, "  %next = add i64 %i, 1\n  %fmore = icmp ult i64 %next, %n\n")
    llvm_text(out, "  br i1 %fmore, label %forward, label %done\n")
    llvm_text(out, "reverse:\n  %j = phi i64 [ %n, %direction ], [ %previous, %reverse ]\n")
    llvm_text(out, "  %previous = sub i64 %j, 1\n")
    llvm_text(out, "  %rd = getelementptr i8, ptr %dst, i64 %previous\n  %rs = getelementptr i8, ptr %src, i64 %previous\n")
    llvm_text(out, "  %rb = load i8, ptr %rs, align 1\n  store i8 %rb, ptr %rd, align 1\n")
    llvm_text(out, "  %rmore = icmp ne i64 %previous, 0\n  br i1 %rmore, label %reverse, label %done\n")
    llvm_text(out, "done:\n  ret ptr %dst\n}\n\n")
}

// llvm_runtime_write_memset：按目标发射 memset 定义；value 截断为低 8 位并逐字节填充。
fn llvm_runtime_write_memset(out *LLVMOutput, hidden int, win64 int) void {
    llvm_runtime_weak_signature(out, "memset", hidden, win64,
        "ptr @memset(ptr %dst, i32 %value, i64 %n) noinline nounwind optnone nobuiltin")
    llvm_text(out, "entry:\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %done, label %loop\n")
    llvm_text(out, "loop:\n  %i = phi i64 [ 0, %entry ], [ %next, %loop ]\n")
    llvm_text(out, "  %d = getelementptr i8, ptr %dst, i64 %i\n")
    llvm_text(out, "  %byte = trunc i32 %value to i8\n")
    llvm_text(out, "  store i8 %byte, ptr %d, align 1\n")
    llvm_text(out, "  %next = add i64 %i, 1\n  %more = icmp ult i64 %next, %n\n")
    llvm_text(out, "  br i1 %more, label %loop, label %done\n")
    llvm_text(out, "done:\n  ret ptr %dst\n}\n\n")
}

// llvm_runtime_write_strlen：按目标发射 strlen 定义；loop 携带当前下标，scan 只推进计数。
fn llvm_runtime_write_strlen(out *LLVMOutput, hidden int, win64 int) void {
    llvm_runtime_weak_signature(out, "strlen", hidden, win64,
        "i64 @strlen(ptr %s) noinline nounwind optnone nobuiltin")
    llvm_text(out, "entry:\n  br label %loop\n")
    llvm_text(out, "loop:\n  %i = phi i64 [ 0, %entry ], [ %next, %scan ]\n")
    llvm_text(out, "  %p = getelementptr i8, ptr %s, i64 %i\n")
    llvm_text(out, "  %byte = load i8, ptr %p, align 1\n")
    llvm_text(out, "  %nul = icmp eq i8 %byte, 0\n")
    llvm_text(out, "  br i1 %nul, label %done, label %scan\n")
    llvm_text(out, "scan:\n  %next = add i64 %i, 1\n  br label %loop\n")
    llvm_text(out, "done:\n  ret i64 %i\n}\n")
}

// llvm_runtime_write_syscall：Linux syscall ABI。x86_64 用 rax/rdi/rsi/rdx/r10/r8/r9，
// AArch64 用 x8 传号、x0..x5 传参并以 svc #0 进入内核。
fn llvm_runtime_write_syscall(out *LLVMOutput, arm64 int) void {
    llvm_text(out, "define weak i64 @linux_syscall6(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) noinline nounwind optnone nobuiltin {\n")
    if (arm64 != 0) {
        llvm_text(out, "entry:\n  %result = call i64 asm sideeffect \"svc #0\", \"={x0},{x8},0,{x1},{x2},{x3},{x4},{x5},~{memory}\"(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5)\n")
    } else {
        llvm_text(out, "entry:\n  %result = call i64 asm sideeffect \"syscall\", \"={rax},0,{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\"(i64 %nr, i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5)\n")
    }
    llvm_text(out, "  ret i64 %result\n}\n\n")
}

// llvm_runtime_write_malloc：映射 payload+16 字节，前 8 字节记录 munmap 长度，用户指针保持 16 字节对齐。
// mmap 号在 x86_64 为 9、AArch64 为 222，其余 PROT/MAP 常量一致。
fn llvm_runtime_write_malloc(out *LLVMOutput, arm64 int) void {
    llvm_text(out, "define weak ptr @__yh_runtime_malloc(i64 %size) noinline nounwind optnone nobuiltin {\nentry:\n")
    llvm_text(out, "  %overflow = icmp ugt i64 %size, -17\n  br i1 %overflow, label %fail, label %prepare\nprepare:\n")
    llvm_text(out, "  %zero = icmp eq i64 %size, 0\n  %payload = select i1 %zero, i64 1, i64 %size\n")
    llvm_text(out, "  %total = add i64 %payload, 16\n  %raw = call i64 @linux_syscall6(i64 ")
    llvm_number(out, arm64 != 0 ? 222 : 9)
    llvm_text(out, ", i64 0, i64 %total, i64 3, i64 34, i64 -1, i64 0)\n")
    llvm_text(out, "  %error = icmp slt i64 %raw, 0\n  br i1 %error, label %fail, label %success\nsuccess:\n")
    llvm_text(out, "  %base = inttoptr i64 %raw to ptr\n  store i64 %total, ptr %base, align 8\n")
    llvm_text(out, "  %user = getelementptr i8, ptr %base, i64 16\n  ret ptr %user\nfail:\n  ret ptr null\n}\n\n")
}

// llvm_runtime_write_free：NULL 无操作；其他指针回到 16 字节头部并解除映射。
// munmap 号在 x86_64 为 11、AArch64 为 215。
fn llvm_runtime_write_free(out *LLVMOutput, arm64 int) void {
    llvm_text(out, "define weak void @__yh_runtime_free(ptr %user) noinline nounwind optnone nobuiltin {\nentry:\n")
    llvm_text(out, "  %null = icmp eq ptr %user, null\n  br i1 %null, label %done, label %release\nrelease:\n")
    llvm_text(out, "  %base = getelementptr i8, ptr %user, i64 -16\n  %size = load i64, ptr %base, align 8\n")
    llvm_text(out, "  %address = ptrtoint ptr %base to i64\n")
    llvm_text(out, "  %ignored = call i64 @linux_syscall6(i64 ")
    llvm_number(out, arm64 != 0 ? 215 : 11)
    llvm_text(out, ", i64 %address, i64 %size, i64 0, i64 0, i64 0, i64 0)\n  br label %done\n")
    llvm_text(out, "done:\n  ret void\n}\n\n")
}

// llvm_runtime_write_printf_support：Linux/Darwin 的 printf 辅助（syscall 短写循环 +
// 跨平台 emit/整数格式化）。Windows 只用后一半：短写改由 WriteFile 实现
// （backend/llvm_windows_runtime.yh），不共享这里的前半。
fn llvm_runtime_write_printf_support(out *LLVMOutput, arm64 int) void {
    llvm_runtime_write_printf_write_syscall(out, arm64)
    llvm_runtime_write_printf_emit(out)
}

// llvm_runtime_write_printf_write_syscall：按 syscall 短写循环输出，并累计成功字节数。
// write 号在 x86_64 为 1、AArch64 为 64。
fn llvm_runtime_write_printf_write_syscall(out *LLVMOutput, arm64 int) void {
    llvm_text(out, "define internal i64 @yh_printf_write(ptr %data, i64 %len) noinline nounwind optnone nobuiltin {\nentry:\n")
    llvm_text(out, "  %empty = icmp eq i64 %len, 0\n  br i1 %empty, label %done, label %loop\nloop:\n")
    llvm_text(out, "  %written = phi i64 [ 0, %entry ], [ %next, %advance ]\n")
    llvm_text(out, "  %cursor = getelementptr i8, ptr %data, i64 %written\n  %left = sub i64 %len, %written\n")
    llvm_text(out, "  %address = ptrtoint ptr %cursor to i64\n  %chunk = call i64 @linux_syscall6(i64 ")
    llvm_number(out, arm64 != 0 ? 64 : 1)
    llvm_text(out, ", i64 1, i64 %address, i64 %left, i64 0, i64 0, i64 0)\n")
    llvm_text(out, "  %failed = icmp sle i64 %chunk, 0\n  br i1 %failed, label %error, label %advance\nadvance:\n")
    llvm_text(out, "  %next = add i64 %written, %chunk\n  %complete = icmp uge i64 %next, %len\n")
    llvm_text(out, "  br i1 %complete, label %done, label %loop\ndone:\n  ret i64 %len\nerror:\n  ret i64 -1\n}\n\n")
}

// llvm_runtime_write_printf_emit：平台无关的输出管道与十进制整数格式化（依 @yh_printf_write）。
fn llvm_runtime_write_printf_emit(out *LLVMOutput) void {
    llvm_text(out, "define internal i32 @yh_printf_emit(ptr %data, i64 %len, ptr %count) noinline nounwind optnone nobuiltin {\nentry:\n")
    llvm_text(out, "  %result = call i64 @yh_printf_write(ptr %data, i64 %len)\n  %failed = icmp slt i64 %result, 0\n")
    llvm_text(out, "  br i1 %failed, label %error, label %account\naccount:\n  %old = load i64, ptr %count, align 8\n")
    llvm_text(out, "  %total = add i64 %old, %result\n  store i64 %total, ptr %count, align 8\n  ret i32 0\nerror:\n  ret i32 -1\n}\n\n")
    llvm_runtime_write_printf_integer(out)
}

// llvm_runtime_write_printf_integer：发射跨平台共用的十进制整数格式化 helper。
fn llvm_runtime_write_printf_integer(out *LLVMOutput) void {
    llvm_text(out, "define internal i64 @yh_printf_integer(i64 %value, i1 %signed) noinline nounwind optnone nobuiltin {\nentry:\n")
    llvm_text(out, "  %buffer = alloca [32 x i8], align 1\n  %negative_value = icmp slt i64 %value, 0\n")
    llvm_text(out, "  %negative = and i1 %signed, %negative_value\n  %magnitude_neg = sub i64 0, %value\n")
    llvm_text(out, "  %magnitude = select i1 %negative, i64 %magnitude_neg, i64 %value\n  br label %digits\ndigits:\n")
    llvm_text(out, "  %index = phi i64 [ 31, %entry ], [ %previous, %next_digit ]\n")
    llvm_text(out, "  %number = phi i64 [ %magnitude, %entry ], [ %quotient, %next_digit ]\n")
    llvm_text(out, "  %remainder = urem i64 %number, 10\n  %quotient = udiv i64 %number, 10\n")
    llvm_text(out, "  %digit = trunc i64 %remainder to i8\n  %ascii = add i8 %digit, 48\n")
    llvm_text(out, "  %slot = getelementptr i8, ptr %buffer, i64 %index\n  store i8 %ascii, ptr %slot, align 1\n")
    llvm_text(out, "  %more = icmp ne i64 %quotient, 0\n  br i1 %more, label %next_digit, label %select_sign\nnext_digit:\n")
    llvm_text(out, "  %previous = sub i64 %index, 1\n  br label %digits\nselect_sign:\n")
    llvm_text(out, "  %digits_start = getelementptr i8, ptr %buffer, i64 %index\n  %digits_len = sub i64 32, %index\n")
    llvm_text(out, "  %signed_length = add i64 %digits_len, 1\n")
    llvm_text(out, "  br i1 %negative, label %with_sign, label %without_sign\nwith_sign:\n")
    llvm_text(out, "  %sign_index = sub i64 %index, 1\n  %sign_ptr = getelementptr i8, ptr %buffer, i64 %sign_index\n")
    llvm_text(out, "  store i8 45, ptr %sign_ptr, align 1\n  br label %write\nwithout_sign:\n  br label %write\nwrite:\n")
    llvm_text(out, "  %start = phi ptr [ %sign_ptr, %with_sign ], [ %digits_start, %without_sign ]\n")
    llvm_text(out, "  %length = phi i64 [ %signed_length, %with_sign ], [ %digits_len, %without_sign ]\n")
    llvm_text(out, "  %result = call i64 @yh_printf_write(ptr %start, i64 %length)\n  ret i64 %result\n}\n\n")
}

// llvm_runtime_write_va_helper：统一取下一个 8 字节变参槽。
// x86_64/Darwin 的 va_list 是线性游标，直接用 va_arg 取 i64；Linux/AArch64 的
// va_list 是 {stack, gr_top, vr_top, gr_offs, vr_offs} 结构，LLVM 的 va_arg 指令
// 不展开寄存器保存区，必须按 AAPCS64 的 gr_offs 规则显式取寄存器槽或栈槽。
// 返回 i64 位型；调用方按格式再用 trunc/inttoptr 解释成 i32/指针。
fn llvm_runtime_write_va_helper(out *LLVMOutput, arm64 int) void {
    llvm_text(out, "define internal i64 @yh_va_next(ptr %args) noinline nounwind optnone nobuiltin {\nentry:\n")
    if (arm64 != 0) {
        llvm_text(out, "  %offs_ptr = getelementptr i8, ptr %args, i64 24\n  %offs = load i32, ptr %offs_ptr, align 4\n")
        llvm_text(out, "  %stacked = icmp sge i32 %offs, 0\n  br i1 %stacked, label %stack, label %reg\nreg:\n")
        llvm_text(out, "  %next_offs = add i32 %offs, 8\n  store i32 %next_offs, ptr %offs_ptr, align 4\n")
        llvm_text(out, "  %still_reg = icmp sle i32 %next_offs, 0\n  br i1 %still_reg, label %from_reg, label %stack\nfrom_reg:\n")
        llvm_text(out, "  %gr_top_ptr = getelementptr i8, ptr %args, i64 8\n  %gr_top = load ptr, ptr %gr_top_ptr, align 8\n")
        llvm_text(out, "  %old_offs = sext i32 %offs to i64\n  %slot = getelementptr i8, ptr %gr_top, i64 %old_offs\n")
        llvm_text(out, "  %reg_value = load i64, ptr %slot, align 8\n  ret i64 %reg_value\nstack:\n")
        llvm_text(out, "  %stack_ptr = getelementptr i8, ptr %args, i64 0\n  %cursor = load ptr, ptr %stack_ptr, align 8\n")
        llvm_text(out, "  %next = getelementptr i8, ptr %cursor, i64 8\n  store ptr %next, ptr %stack_ptr, align 8\n")
        llvm_text(out, "  %stack_value = load i64, ptr %cursor, align 8\n  ret i64 %stack_value\n}\n\n")
    } else {
        llvm_text(out, "  %value = va_arg ptr %args, i64\n  ret i64 %value\n}\n\n")
    }
}

// llvm_runtime_write_printf：支持现行格式集合；格式字符串和 %s 都按 UTF-8 字节输出。
// arm64 同时选择 32 字节 Linux va_list 与显式寄存器槽/栈槽读取。
fn llvm_runtime_write_printf(out *LLVMOutput, hidden int, arm64 int, win64 int) void {
    llvm_text(out, "declare void @llvm.va_start(ptr)\ndeclare void @llvm.va_end(ptr)\n\n")
    llvm_runtime_write_va_helper(out, arm64)
    llvm_runtime_weak_signature(out, "printf", hidden, win64,
        "i32 @printf(ptr %fmt, ...) noinline nounwind optnone nobuiltin")
    llvm_text(out, "entry:\n")
    llvm_text(out, "  %args = alloca ["); llvm_number(out, arm64 != 0 ? 32 : 24)
    llvm_text(out, " x i8], align 8\n  %count = alloca i64, align 8\n")
    llvm_text(out, "  %character = alloca [1 x i8], align 1\n  %unknown = alloca [2 x i8], align 1\n")
    llvm_text(out, "  store i64 0, ptr %count, align 8\n  call void @llvm.va_start(ptr %args)\n  br label %scan\nscan:\n")
    llvm_text(out, "  %index = phi i64 [ 0, %entry ], [ %cursor, %span_done ], [ %resume, %account_integer_bytes ], [ %resume_string, %emit_string ], [ %resume_char, %emit_char ], [ %resume_percent, %emit_percent_next ], [ %resume_unknown, %emit_unknown ]\n")
    llvm_text(out, "  %format_byte_ptr = getelementptr i8, ptr %fmt, i64 %index\n  %format_byte = load i8, ptr %format_byte_ptr, align 1\n")
    llvm_text(out, "  %end = icmp eq i8 %format_byte, 0\n  br i1 %end, label %finish, label %classify\nclassify:\n")
    llvm_text(out, "  %is_percent = icmp eq i8 %format_byte, 37\n  br i1 %is_percent, label %parse, label %literal\nliteral:\n  br label %find_literal\nfind_literal:\n")
    llvm_text(out, "  %cursor = phi i64 [ %index, %literal ], [ %next_cursor, %find_next ]\n")
    llvm_text(out, "  %literal_ptr = getelementptr i8, ptr %fmt, i64 %cursor\n  %literal_byte = load i8, ptr %literal_ptr, align 1\n")
    llvm_text(out, "  %literal_end = icmp eq i8 %literal_byte, 0\n  %literal_percent = icmp eq i8 %literal_byte, 37\n")
    llvm_text(out, "  %literal_stop = or i1 %literal_end, %literal_percent\n  br i1 %literal_stop, label %emit_span, label %find_next\nfind_next:\n")
    llvm_text(out, "  %next_cursor = add i64 %cursor, 1\n  br label %find_literal\nemit_span:\n")
    llvm_text(out, "  %span_length = sub i64 %cursor, %index\n  %span_data = getelementptr i8, ptr %fmt, i64 %index\n")
    llvm_text(out, "  %span_status = call i32 @yh_printf_emit(ptr %span_data, i64 %span_length, ptr %count)\n")
    llvm_text(out, "  %span_failed = icmp slt i32 %span_status, 0\n  br i1 %span_failed, label %error, label %span_done\nspan_done:\n  br label %scan\n")
    llvm_text(out, "parse:\n  %spec_index = add i64 %index, 1\n  %spec_ptr = getelementptr i8, ptr %fmt, i64 %spec_index\n")
    llvm_text(out, "  %spec = load i8, ptr %spec_ptr, align 1\n  %trailing = icmp eq i8 %spec, 0\n")
    llvm_text(out, "  br i1 %trailing, label %trailing_percent, label %classify_spec\ntrailing_percent:\n")
    llvm_text(out, "  store i8 37, ptr %character, align 1\n  %trail_status = call i32 @yh_printf_emit(ptr %character, i64 1, ptr %count)\n")
    llvm_text(out, "  %trail_failed = icmp slt i32 %trail_status, 0\n  br i1 %trail_failed, label %error, label %finish\nclassify_spec:\n")
    llvm_text(out, "  %spec_pct = icmp eq i8 %spec, 37\n  %spec_d = icmp eq i8 %spec, 100\n")
    llvm_text(out, "  %spec_i = icmp eq i8 %spec, 105\n  %spec_u = icmp eq i8 %spec, 117\n")
    llvm_text(out, "  %spec_s = icmp eq i8 %spec, 115\n  %spec_c = icmp eq i8 %spec, 99\n  %spec_l = icmp eq i8 %spec, 108\n")
    llvm_text(out, "  br i1 %spec_pct, label %emit_percent, label %check_d\ncheck_d:\n  br i1 %spec_d, label %signed32, label %check_i\n")
    llvm_text(out, "check_i:\n  br i1 %spec_i, label %signed32, label %check_u\ncheck_u:\n  br i1 %spec_u, label %unsigned32, label %check_s\n")
    llvm_text(out, "check_s:\n  br i1 %spec_s, label %string_arg, label %check_c\ncheck_c:\n  br i1 %spec_c, label %char_arg, label %check_l\n")
    llvm_text(out, "check_l:\n  br i1 %spec_l, label %long_modifier, label %unknown_spec\nemit_percent:\n")
    llvm_text(out, "  store i8 37, ptr %character, align 1\n  %percent_status = call i32 @yh_printf_emit(ptr %character, i64 1, ptr %count)\n")
    llvm_text(out, "  %percent_failed = icmp slt i32 %percent_status, 0\n  br i1 %percent_failed, label %error, label %emit_percent_next\nemit_percent_next:\n")
    llvm_text(out, "  %resume_percent = add i64 %index, 2\n  br label %scan\nlong_modifier:\n  %long_index = add i64 %index, 2\n")
    llvm_text(out, "  %long_ptr = getelementptr i8, ptr %fmt, i64 %long_index\n  %long_byte = load i8, ptr %long_ptr, align 1\n")
    llvm_text(out, "  %is_long_long = icmp eq i8 %long_byte, 108\n  br i1 %is_long_long, label %long_type, label %unknown_long\nlong_type:\n")
    llvm_text(out, "  %type_index = add i64 %index, 3\n  %type_ptr = getelementptr i8, ptr %fmt, i64 %type_index\n")
    llvm_text(out, "  %long_type_byte = load i8, ptr %type_ptr, align 1\n  %long_d = icmp eq i8 %long_type_byte, 100\n")
    llvm_text(out, "  %long_u = icmp eq i8 %long_type_byte, 117\n  br i1 %long_d, label %signed64, label %check_long_u\n")
    llvm_text(out, "check_long_u:\n  br i1 %long_u, label %unsigned64, label %unknown_long\n")
    llvm_text(out, "signed32:\n  %signed_raw = call i64 @yh_va_next(ptr %args)\n  %signed_arg = trunc i64 %signed_raw to i32\n  %signed_wide = sext i32 %signed_arg to i64\n")
    llvm_text(out, "  %signed_written = call i64 @yh_printf_integer(i64 %signed_wide, i1 true)\n")
    llvm_text(out, "  %signed_resume = add i64 %index, 2\n  br label %account_integer\nunsigned32:\n")
    llvm_text(out, "  %unsigned_raw = call i64 @yh_va_next(ptr %args)\n  %unsigned_arg = trunc i64 %unsigned_raw to i32\n  %unsigned_wide = zext i32 %unsigned_arg to i64\n")
    llvm_text(out, "  %unsigned_written = call i64 @yh_printf_integer(i64 %unsigned_wide, i1 false)\n")
    llvm_text(out, "  %unsigned_resume = add i64 %index, 2\n  br label %account_integer\nsigned64:\n")
    llvm_text(out, "  %signed64_arg = call i64 @yh_va_next(ptr %args)\n  %signed64_written = call i64 @yh_printf_integer(i64 %signed64_arg, i1 true)\n")
    llvm_text(out, "  %signed64_resume = add i64 %index, 4\n  br label %account_integer\nunsigned64:\n")
    llvm_text(out, "  %unsigned64_arg = call i64 @yh_va_next(ptr %args)\n  %unsigned64_written = call i64 @yh_printf_integer(i64 %unsigned64_arg, i1 false)\n")
    llvm_text(out, "  %unsigned64_resume = add i64 %index, 4\n  br label %account_integer\naccount_integer:\n")
    llvm_text(out, "  %written = phi i64 [ %signed_written, %signed32 ], [ %unsigned_written, %unsigned32 ], [ %signed64_written, %signed64 ], [ %unsigned64_written, %unsigned64 ]\n")
    llvm_text(out, "  %resume = phi i64 [ %signed_resume, %signed32 ], [ %unsigned_resume, %unsigned32 ], [ %signed64_resume, %signed64 ], [ %unsigned64_resume, %unsigned64 ]\n")
    llvm_text(out, "  %integer_failed = icmp slt i64 %written, 0\n  br i1 %integer_failed, label %error, label %account_integer_bytes\naccount_integer_bytes:\n")
    llvm_text(out, "  %old_count = load i64, ptr %count, align 8\n  %new_count = add i64 %old_count, %written\n")
    llvm_text(out, "  store i64 %new_count, ptr %count, align 8\n  br label %scan\nstring_arg:\n")
    llvm_text(out, "  %string_bits = call i64 @yh_va_next(ptr %args)\n  %string_value = inttoptr i64 %string_bits to ptr\n  %string_null = icmp eq ptr %string_value, null\n")
    llvm_text(out, "  br i1 %string_null, label %empty_string, label %measure_string\nempty_string:\n  br label %string_length\nmeasure_string:\n")
    llvm_text(out, "  %measured = call i64 @strlen(ptr %string_value)\n  br label %string_length\nstring_length:\n")
    llvm_text(out, "  %string_size = phi i64 [ 0, %empty_string ], [ %measured, %measure_string ]\n")
    llvm_text(out, "  %string_status = call i32 @yh_printf_emit(ptr %string_value, i64 %string_size, ptr %count)\n")
    llvm_text(out, "  %string_failed = icmp slt i32 %string_status, 0\n  br i1 %string_failed, label %error, label %emit_string\nemit_string:\n")
    llvm_text(out, "  %resume_string = add i64 %index, 2\n  br label %scan\nchar_arg:\n  %char_raw = call i64 @yh_va_next(ptr %args)\n  %char_value = trunc i64 %char_raw to i32\n")
    llvm_text(out, "  %char_byte = trunc i32 %char_value to i8\n  store i8 %char_byte, ptr %character, align 1\n")
    llvm_text(out, "  %char_status = call i32 @yh_printf_emit(ptr %character, i64 1, ptr %count)\n")
    llvm_text(out, "  %char_failed = icmp slt i32 %char_status, 0\n  br i1 %char_failed, label %error, label %emit_char\nemit_char:\n")
    llvm_text(out, "  %resume_char = add i64 %index, 2\n  br label %scan\n")
    llvm_text(out, "unknown_spec:\n  store i8 37, ptr %unknown, align 1\n")
    llvm_text(out, "  %unknown_second = getelementptr i8, ptr %unknown, i64 1\n  store i8 %spec, ptr %unknown_second, align 1\n")
    llvm_text(out, "  %unknown_status = call i32 @yh_printf_emit(ptr %unknown, i64 2, ptr %count)\n")
    llvm_text(out, "  %unknown_failed = icmp slt i32 %unknown_status, 0\n  br i1 %unknown_failed, label %error, label %emit_unknown\nunknown_long:\n")
    llvm_text(out, "  store i8 37, ptr %unknown, align 1\n  %long_second = getelementptr i8, ptr %unknown, i64 1\n")
    llvm_text(out, "  store i8 108, ptr %long_second, align 1\n  %unknown_long_status = call i32 @yh_printf_emit(ptr %unknown, i64 2, ptr %count)\n")
    llvm_text(out, "  %unknown_long_failed = icmp slt i32 %unknown_long_status, 0\n  br i1 %unknown_long_failed, label %error, label %emit_unknown\nemit_unknown:\n")
    llvm_text(out, "  %resume_unknown = add i64 %index, 2\n  br label %scan\n")
    llvm_text(out, "error:\n  call void @llvm.va_end(ptr %args)\n  ret i32 -1\nfinish:\n")
    llvm_text(out, "  call void @llvm.va_end(ptr %args)\n  %final_count = load i64, ptr %count, align 8\n")
    llvm_text(out, "  %result = trunc i64 %final_count to i32\n  ret i32 %result\n}\n\n")
}

// llvm_runtime_write_test_assert：发射 yh test 断言运行时弱定义。
// 条件为假时向 fd 3 写 12 字节失败记录（'Y' 'H' 'T' 'F' + line + col，
// 小端 i32），随后 exit(1)；条件为真直接返回。记录通道与 stdout/stderr 分离，
// 父进程据此同时得到失败位置与「未被断言捕获的退出」的区别。
fn llvm_runtime_write_test_assert(unit *ir.IRModule, out *LLVMOutput,
    win64 int) void {
    // 模块里可能已引用 write/exit（用户测试体调用它们）。Darwin 的 printf 运行时
    // 支持本身会声明 @write；Windows 运行时由 support 发射 write 定义；Linux 版
    // printf 走 syscall、不声明它，因此仅在「三边都没有」时补声明，避免
    // declare + define 同名冲突。
    let darwin_write int = 0
    if (gen.cstr_eq(unit.target.abi, "darwin-aapcs64") != 0
        && llvm_runtime_named(unit, "printf") != 0) {
        darwin_write = 1
    }
    if (llvm_runtime_named(unit, "write") == 0 && darwin_write == 0 && win64 == 0) {
        llvm_text(out, "declare i64 @write(i32, ptr, i64)\n")
    }
    if (llvm_runtime_named(unit, "exit") == 0) {
        llvm_text(out, "declare void @exit(i32)\n")
    }
    // 记录布局（72 字节）：0..3 magic，4..7 line，8..11 col，12..71 消息
    // （NUL 填充，最长 60 字节）。条件为假时写记录并 exit(1)。
    llvm_runtime_weak_signature(out, "__yh_test_assert", 0, win64,
        "void @__yh_test_assert(i8 %cond, i32 %line, i32 %col, ptr %msg) noinline nounwind optnone")
    llvm_text(out, "entry:\n  %failed = icmp eq i8 %cond, 0\n")
    llvm_text(out, "  br i1 %failed, label %report, label %done\n")
    llvm_text(out, "report:\n  %rec = alloca [72 x i8], align 4\n")
    // 0x46544859 = 'Y' 'H' 'T' 'F'（小端字节序）
    llvm_text(out, "  store i32 1179928665, ptr %rec, align 4\n")
    llvm_text(out, "  %lp = getelementptr i8, ptr %rec, i64 4\n")
    llvm_text(out, "  store i32 %line, ptr %lp, align 4\n")
    llvm_text(out, "  %cp = getelementptr i8, ptr %rec, i64 8\n")
    llvm_text(out, "  store i32 %col, ptr %cp, align 4\n")
    // 先清零消息区，保证短消息之后不会暴露未初始化字节。
    llvm_text(out, "  br label %zero\n")
    llvm_text(out, "zero:\n  %zk = phi i64 [ 0, %report ], [ %zkn, %zero ]\n")
    llvm_text(out, "  %zoff = add i64 12, %zk\n")
    llvm_text(out, "  %zp = getelementptr i8, ptr %rec, i64 %zoff\n")
    llvm_text(out, "  store i8 0, ptr %zp, align 1\n")
    llvm_text(out, "  %zkn = add i64 %zk, 1\n  %zmore = icmp ult i64 %zkn, 60\n")
    llvm_text(out, "  br i1 %zmore, label %zero, label %copystart\n")
    llvm_text(out, "copystart:\n  %hasmsg = icmp ne ptr %msg, null\n")
    llvm_text(out, "  br i1 %hasmsg, label %copy, label %emit\n")
    llvm_text(out, "copy:\n  %mk = phi i64 [ 0, %copystart ], [ %mkn, %body ]\n")
    llvm_text(out, "  %mp = getelementptr i8, ptr %msg, i64 %mk\n")
    llvm_text(out, "  %mc = load i8, ptr %mp, align 1\n")
    llvm_text(out, "  %mend = icmp eq i8 %mc, 0\n")
    llvm_text(out, "  br i1 %mend, label %emit, label %body\n")
    llvm_text(out, "body:\n  %moff = add i64 12, %mk\n")
    llvm_text(out, "  %dp = getelementptr i8, ptr %rec, i64 %moff\n")
    llvm_text(out, "  store i8 %mc, ptr %dp, align 1\n")
    // 消息最多拷 59 字节；拷满后看第 60 字节是否为 NUL，决定「已截断」标记。
    llvm_text(out, "  %mkn = add i64 %mk, 1\n  %mmore = icmp ult i64 %mkn, 59\n")
    llvm_text(out, "  br i1 %mmore, label %copy, label %trunc\n")
    llvm_text(out, "trunc:\n  %tailp = getelementptr i8, ptr %msg, i64 59\n")
    llvm_text(out, "  %tail = load i8, ptr %tailp, align 1\n")
    llvm_text(out, "  %more_bytes = icmp ne i8 %tail, 0\n")
    llvm_text(out, "  %mark = select i1 %more_bytes, i8 30, i8 0\n")
    llvm_text(out, "  %markp = getelementptr i8, ptr %rec, i64 71\n")
    llvm_text(out, "  store i8 %mark, ptr %markp, align 1\n")
    llvm_text(out, "  br label %emit\n")
    llvm_text(out, "emit:\n  %w = call i64 @write(i32 3, ptr %rec, i64 72)\n")
    llvm_text(out, "  call void @exit(i32 1)\n  unreachable\ndone:\n  ret void\n}\n\n")
}

// llvm_runtime_memory_text：补齐模块引用的运行时入口并保留 LL8a 内存 helper。
// 只有模块未定义的标准入口才生成弱定义；llvm.used 阻止 O2 删除未直接引用的 helper。
pub fn llvm_runtime_memory_text(unit *ir.IRModule, out *LLVMOutput) void {
    let darwin int = gen.cstr_eq(unit.target.abi, "darwin-aapcs64") != 0 ? 1 : 0
    let arm64 int = gen.cstr_eq(unit.target.abi, "aapcs64") != 0 ? 1 : 0
    // Windows/x64 不走 syscall：malloc/printf/write 全部经 Win32 API（W1-3）。
    let win64 int = gen.cstr_eq(unit.target.abi, "win64-msvc") != 0 ? 1 : 0
    let emit_memcpy int = (llvm_runtime_defined(unit, "memcpy") == 0).to_type(int)
    let emit_memset int = (llvm_runtime_defined(unit, "memset") == 0).to_type(int)
    let emit_strlen int = (llvm_runtime_defined(unit, "strlen") == 0).to_type(int)
    let emit_move int = llvm_runtime_defined(unit, "memmove") == 0 ?
        llvm_runtime_aggregate_copy(unit) : 0
    let emit_malloc int = (llvm_runtime_named(unit, "__yh_runtime_malloc") != 0
        && llvm_runtime_defined(unit, "__yh_runtime_malloc") == 0).to_type(int)
    let emit_free int = (llvm_runtime_named(unit, "__yh_runtime_free") != 0
        && llvm_runtime_defined(unit, "__yh_runtime_free") == 0).to_type(int)
    let emit_printf int = (llvm_runtime_named(unit, "printf") != 0
        && llvm_runtime_defined(unit, "printf") == 0).to_type(int)
    let needs_syscall int = darwin == 0 && win64 == 0 && (emit_malloc != 0 || emit_free != 0
        || emit_printf != 0 || llvm_runtime_named(unit, "linux_syscall6") != 0) ? 1 : 0
    let emit_syscall int = (needs_syscall != 0
        && llvm_runtime_defined(unit, "linux_syscall6") == 0).to_type(int)
    let emit_test_assert int = (llvm_runtime_named(unit, "__yh_test_assert") != 0
        && llvm_runtime_defined(unit, "__yh_test_assert") == 0).to_type(int)
    let emitted int = emit_syscall + emit_malloc + emit_free + emit_printf +
        emit_memcpy + emit_memset + emit_strlen + emit_move + emit_test_assert
    if (emitted == 0) { return }
    llvm_byte(out, '\n')
    if (darwin != 0) {
        llvm_apple_runtime_write_support(unit, out, emit_malloc, emit_free, emit_printf)
    } else if (win64 != 0) {
        // W1-3：HeapAlloc/WriteFile 版运行时；同时按需补 write/exit 薄层，
        // 让 yh test 的断言记录（fd 3 → 标准错误）不需要另写一套发射。
        llvm_windows_runtime_write_support(unit, out, emit_malloc, emit_free,
            emit_printf, emit_test_assert)
    } else {
        if (emit_syscall != 0) { llvm_runtime_write_syscall(out, arm64) }
        if (emit_malloc != 0) { llvm_runtime_write_malloc(out, arm64) }
        if (emit_free != 0) { llvm_runtime_write_free(out, arm64) }
        if (emit_printf != 0) { llvm_runtime_write_printf_support(out, arm64) }
    }
    if (emit_printf != 0) { llvm_runtime_write_printf(out, darwin, arm64, win64) }
    if (emit_memcpy != 0) { llvm_runtime_write_memcpy(out, darwin, win64) }
    if (emit_memset != 0) { llvm_runtime_write_memset(out, darwin, win64) }
    if (emit_strlen != 0) { llvm_runtime_write_strlen(out, darwin, win64) }
    if (emit_move != 0) { llvm_runtime_write_memmove(out, darwin, win64) }
    if (emit_test_assert != 0) { llvm_runtime_write_test_assert(unit, out, win64) }
    llvm_text(out, "\n@llvm.used = appending global [")
    llvm_number(out, emitted.to_type(u64))
    llvm_text(out, " x ptr] [")
    let first int = 1
    if (emit_syscall != 0) { llvm_text(out, "ptr @linux_syscall6"); first = 0 }
    if (emit_malloc != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @__yh_runtime_malloc"); first = 0
    }
    if (emit_free != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @__yh_runtime_free"); first = 0
    }
    if (emit_printf != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @printf"); first = 0
    }
    if (emit_move != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @memmove"); first = 0
    }
    if (emit_memcpy != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @memcpy"); first = 0
    }
    if (emit_memset != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @memset"); first = 0
    }
    if (emit_test_assert != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @__yh_test_assert"); first = 0
    }
    if (emit_strlen != 0) {
        if (first == 0) { llvm_text(out, ", ") }
        llvm_text(out, "ptr @strlen")
    }
    llvm_text(out, "], section \"llvm.metadata\"\n")
}
