module backend;
import gen;
import ir;

// arm64 后端首片直接消费经 verifier 校验的 typed SSA。
// 每个 SSA 值暂用独立栈槽，phi 在 CFG 边块中完成并行复制；此实现先建立
// 后端契约与端到端语义，不提前引入寄存器分配器。

// arm64_type_supported：当前简单后端只接受整数和布尔值。
fn arm64_type_supported(f *ir.IRFunction, tid int) int {
    if (tid < 0 || tid >= f.type_count || f.types == 0) { return 0; }
    let kind int = f.types[tid].kind;
    return kind == ir.IR_TY_BOOL || kind == ir.IR_TY_I8
        || kind == ir.IR_TY_I16 || kind == ir.IR_TY_I32
        || kind == ir.IR_TY_I64 || kind == ir.IR_TY_U8
        || kind == ir.IR_TY_U16 || kind == ir.IR_TY_U32
        || kind == ir.IR_TY_U64 ? 1 : 0;
}

// arm64_compare_cc：根据 SSA 操作与整数符号选择 AArch64 条件码。
fn arm64_compare_cc(f *ir.IRFunction, inst *ir.IRInst) *char {
    if (inst.op == ir.IR_OP_EQ) { return "eq"; }
    if (inst.op == ir.IR_OP_NE) { return "ne"; }
    let tid int = ir.ir_find_value_type(f, inst.a);
    if (tid < 0 || tid >= f.type_count) { return 0; }
    let is_signed int = (f.types[tid].kind >= ir.IR_TY_I8
        && f.types[tid].kind <= ir.IR_TY_I64).to_type(int);
    if (inst.op == ir.IR_OP_LT) { return is_signed != 0 ? "lt" : "lo"; }
    if (inst.op == ir.IR_OP_LE) { return is_signed != 0 ? "le" : "ls"; }
    if (inst.op == ir.IR_OP_GT) { return is_signed != 0 ? "gt" : "hi"; }
    if (inst.op == ir.IR_OP_GE) { return is_signed != 0 ? "ge" : "hs"; }
    return 0;
}

// arm64_function_supported：预检全部指令和终结符，避免发射到一半才发现后端缺项。
// void 返回与零指令的空函数同样受支持；前者不读返回值，后者只保留调用约定框架。
pub fn arm64_function_supported(f *ir.IRFunction) int {
    if (f == 0 || f.blocks == 0 || f.block_count < 1
        || (f.inst_count > 0 && f.insts == 0)
        || f.value_count < 0 || f.inst_count < 0
        || f.ret_type < 0 || f.ret_type >= f.type_count
        || (arm64_type_supported(f, f.ret_type) == 0
            && f.types[f.ret_type].kind != ir.IR_TY_VOID)) {
        return 0;
    }
    let i int = 0;
    for i < f.inst_count {
        let inst ir.IRInst = f.insts[i];
        if (inst.op != ir.IR_OP_CONST && inst.op != ir.IR_OP_PARAM
            && inst.op != ir.IR_OP_ADD && inst.op != ir.IR_OP_SUB
            && inst.op != ir.IR_OP_MUL && inst.op != ir.IR_OP_EQ
            && inst.op != ir.IR_OP_NE && inst.op != ir.IR_OP_LT
            && inst.op != ir.IR_OP_LE && inst.op != ir.IR_OP_GT
            && inst.op != ir.IR_OP_GE && inst.op != ir.IR_OP_DIV
            && inst.op != ir.IR_OP_REM && inst.op != ir.IR_OP_BAND
            && inst.op != ir.IR_OP_BOR && inst.op != ir.IR_OP_BXOR
            && inst.op != ir.IR_OP_SHL && inst.op != ir.IR_OP_SHR
            && inst.op != ir.IR_OP_PHI && inst.op != ir.IR_OP_COPY
            && inst.op != ir.IR_OP_CALL && inst.op != ir.IR_OP_CAST) {
            return 0;
        }
        if (inst.op == ir.IR_OP_CALL) {
            if (arm64_call_supported(f, &inst) == 0) { return 0; }
        } else if (arm64_type_supported(f, inst.result_type) == 0) { return 0; }
        i += 1;
    }
    let b int = 0;
    for b < f.block_count {
        let term int = f.blocks[b].term;
        if (term != ir.IR_TERM_BR && term != ir.IR_TERM_COND_BR
            && term != ir.IR_TERM_RET) {
            return 0;
        }
        b += 1;
    }
    return 1;
}

// arm64_slot_addr：把 SSA 值槽地址放入 x11，槽相对 fp 向下增长。
fn arm64_slot_addr(value int) int {
    if (value < 0) { return -1; }
    let offset int = 16 + value * 16;
    if (offset <= 4095) {
        if (gen.em_frag("\tsub\tx11, x29, #") != 0
            || gen.em_puti(offset) != 0 || gen.em_frag("\n") != 0) {
            return -1;
        }
        return 0;
    }
    if (gen.em_mov_imm("x11", offset.to_type(i64)) != 0) { return -1; }
    return gen.em_ins("sub\tx11, x29, x11");
}

// arm64_load_value：从 SSA 值对应的独立栈槽读取到指定通用寄存器。
fn arm64_load_value(f *ir.IRFunction, value int, reg *char) int {
    if (value < 0 || value >= f.value_count
        || arm64_slot_addr(value) != 0) { return -1; }
    if (gen.em_frag("\tldr\t") != 0 || gen.em_frag(reg) != 0) { return -1; }
    return gen.em_frag(", [x11]\n");
}

// arm64_store_value：把指定寄存器保存到 SSA 值的独立栈槽。
fn arm64_store_value(f *ir.IRFunction, value int, reg *char) int {
    if (value < 0 || value >= f.value_count
        || arm64_slot_addr(value) != 0) { return -1; }
    if (gen.em_frag("\tstr\t") != 0 || gen.em_frag(reg) != 0) { return -1; }
    return gen.em_frag(", [x11]\n");
}

// arm64_normalize：按 SSA 整数位宽规范化 x0，维持窄整数扩展语义。
fn arm64_normalize(f *ir.IRFunction, tid int) int {
    if (tid < 0 || tid >= f.type_count) { return -1; }
    let kind int = f.types[tid].kind;
    if (kind == ir.IR_TY_I8) { return gen.em_ins("sxtb\tx0, w0"); }
    if (kind == ir.IR_TY_I16) { return gen.em_ins("sxth\tx0, w0"); }
    if (kind == ir.IR_TY_I32) { return gen.em_ins("sxtw\tx0, w0"); }
    if (kind == ir.IR_TY_U8) { return gen.em_ins("uxtb\tw0, w0"); }
    if (kind == ir.IR_TY_U16) { return gen.em_ins("uxth\tw0, w0"); }
    if (kind == ir.IR_TY_U32) { return gen.em_ins("mov\tw0, w0"); }
    if (kind == ir.IR_TY_BOOL) { return gen.em_ins("and\tw0, w0, #1"); }
    return 0;
}

// arm64_emit_param：按 AAPCS64 整数参数位置取得值并保存到 SSA 槽。
fn arm64_emit_param(f *ir.IRFunction, inst *ir.IRInst) int {
    let index int = inst.imm.to_type(int);
    if (index < 0) { return -1; }
    if (index < 8) {
        if (gen.em_frag("\tmov\tx0, x") != 0
            || gen.em_puti(index) != 0 || gen.em_frag("\n") != 0) {
            return -1;
        }
    } else {
        let offset int = 16 + (index - 8) * 8;
        if (f.abi == gen.ABI_C) {
            // 前导 PARAM 指令就是完整签名，按共享分类器累计到当前参数。
            let cursor gen.ABICursor;
            gen.abi_c_cursor_init(&cursor, (f.target_id == gen.TG_DIALECT_DARWIN + 1).to_type(int));
            let pi int = 0;
            let loc gen.ABIArg;
            for pi <= index {
                let value gen.ABIValue;
                arm64_abi_value(f, f.insts[pi].result_type, gen.ABI_C, &value);
                gen.abi_c_place(&value, &cursor, &loc);
                pi += 1;
            }
            offset = 16 + loc.stack;
            let size int = loc.size;
            let kind int = f.types[inst.result_type].kind;
            let signed_value int = (kind >= ir.IR_TY_I8 && kind <= ir.IR_TY_I64).to_type(int);
            let op *char = "ldr";
            let suffix *char = size == 8 ? "x0" : "w0";
            if (size == 1) { op = "ldrb"; }
            if (size == 2) { op = "ldrh"; }
            if (signed_value != 0 && size < 8) {
                suffix = "x0";
                if (size == 1) { op = "ldrsb"; }
                if (size == 2) { op = "ldrsh"; }
                if (size == 4) { op = "ldrsw"; }
            }
            if (gen.em_mov_imm("x11", offset.to_type(i64)) != 0
                || gen.em_ins("add\tx11, x29, x11") != 0
                || gen.em_frag("\t") != 0 || gen.em_frag(op) != 0
                || gen.em_frag("\t") != 0 || gen.em_frag(suffix) != 0
                || gen.em_frag(", [x11]\n") != 0) { return -1; }
            if (arm64_normalize(f, inst.result_type) != 0) { return -1; }
            return arm64_store_value(f, inst.result_id, "x0");
        }
        if (offset <= 32760) {
            if (gen.em_frag("\tldr\tx0, [x29, #") != 0
                || gen.em_puti(offset) != 0 || gen.em_frag("]\n") != 0) {
                return -1;
            }
        } else {
            if (gen.em_mov_imm("x11", offset.to_type(i64)) != 0
                || gen.em_ins("add\tx11, x29, x11") != 0
                || gen.em_ins("ldr\tx0, [x11]") != 0) { return -1; }
        }
    }
    if (arm64_normalize(f, inst.result_type) != 0) { return -1; }
    return arm64_store_value(f, inst.result_id, "x0");
}

// arm64_emit_inst：发射一条非控制流 SSA 指令；phi 值由前驱边发射。
fn arm64_emit_inst(f *ir.IRFunction, inst *ir.IRInst) int {
    if (inst.op == ir.IR_OP_PHI) { return 0; }
    if (inst.op == ir.IR_OP_PARAM) { return arm64_emit_param(f, inst); }
    if (inst.op == ir.IR_OP_CALL) { return arm64_emit_call(f, inst); }
    if (inst.op == ir.IR_OP_CONST) {
        if (gen.em_mov_imm("x0", inst.imm) != 0
            || arm64_normalize(f, inst.result_type) != 0) { return -1; }
        return arm64_store_value(f, inst.result_id, "x0");
    }
    if (inst.op == ir.IR_OP_COPY) {
        if (arm64_load_value(f, inst.a, "x0") != 0) { return -1; }
        return arm64_store_value(f, inst.result_id, "x0");
    }
    if (inst.op == ir.IR_OP_CAST) {
        if (arm64_load_value(f, inst.a, "x0") != 0
            || arm64_normalize(f, inst.result_type) != 0) { return -1; }
        return arm64_store_value(f, inst.result_id, "x0");
    }
    if (inst.op == ir.IR_OP_ADD || inst.op == ir.IR_OP_SUB
        || inst.op == ir.IR_OP_MUL || inst.op == ir.IR_OP_EQ
        || inst.op == ir.IR_OP_NE || inst.op == ir.IR_OP_LT
        || inst.op == ir.IR_OP_LE || inst.op == ir.IR_OP_GT
        || inst.op == ir.IR_OP_GE || inst.op == ir.IR_OP_DIV
        || inst.op == ir.IR_OP_REM || inst.op == ir.IR_OP_BAND
        || inst.op == ir.IR_OP_BOR || inst.op == ir.IR_OP_BXOR
        || inst.op == ir.IR_OP_SHL || inst.op == ir.IR_OP_SHR) {
        if (arm64_load_value(f, inst.a, "x9") != 0
            || arm64_load_value(f, inst.b, "x10") != 0) { return -1; }
        if (inst.op == ir.IR_OP_EQ || inst.op == ir.IR_OP_NE
            || inst.op == ir.IR_OP_LT || inst.op == ir.IR_OP_LE
            || inst.op == ir.IR_OP_GT || inst.op == ir.IR_OP_GE) {
            let cc *char = arm64_compare_cc(f, inst);
            if (cc == 0 || gen.em_ins("cmp\tx9, x10") != 0
                || gen.em_frag("\tcset\tx0, ") != 0
                || gen.em_frag(cc) != 0 || gen.em_frag("\n") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_ADD) {
            if (gen.em_ins("add\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_SUB) {
            if (gen.em_ins("sub\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_MUL) {
            if (gen.em_ins("mul\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_DIV || inst.op == ir.IR_OP_REM) {
            let operand_type int = ir.ir_find_value_type(f, inst.a);
            if (operand_type < 0) { return -1; }
            let is_signed int = (f.types[operand_type].kind >= ir.IR_TY_I8
                && f.types[operand_type].kind <= ir.IR_TY_I64).to_type(int);
            if (inst.op == ir.IR_OP_DIV) {
                if (is_signed != 0 && gen.em_ins("sdiv\tx0, x9, x10") != 0) { return -1; }
                if (is_signed == 0 && gen.em_ins("udiv\tx0, x9, x10") != 0) { return -1; }
            } else {
                if (is_signed != 0 && gen.em_ins("sdiv\tx11, x9, x10") != 0) { return -1; }
                if (is_signed == 0 && gen.em_ins("udiv\tx11, x9, x10") != 0) { return -1; }
                if (gen.em_ins("msub\tx0, x11, x10, x9") != 0) { return -1; }
            }
        } else if (inst.op == ir.IR_OP_BAND) {
            if (gen.em_ins("and\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_BOR) {
            if (gen.em_ins("orr\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_BXOR) {
            if (gen.em_ins("eor\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_SHL) {
            if (gen.em_ins("lslv\tx0, x9, x10") != 0) { return -1; }
        } else if (inst.op == ir.IR_OP_SHR) {
            let operand_type2 int = ir.ir_find_value_type(f, inst.a);
            if (operand_type2 < 0) { return -1; }
            let is_signed2 int = (f.types[operand_type2].kind >= ir.IR_TY_I8
                && f.types[operand_type2].kind <= ir.IR_TY_I64).to_type(int);
            if (is_signed2 != 0 && gen.em_ins("asrv\tx0, x9, x10") != 0) { return -1; }
            if (is_signed2 == 0 && gen.em_ins("lsrv\tx0, x9, x10") != 0) { return -1; }
        } else { return -1; }
        if (arm64_normalize(f, inst.result_type) != 0) { return -1; }
        return arm64_store_value(f, inst.result_id, "x0");
    }
    return -1;
}

// arm64_emit_phi_edge：在 CFG 边上并行复制目标块的 phi 输入。
fn arm64_emit_phi_edge(f *ir.IRFunction, from int, to int) int {
    let block ir.IRBlock = f.blocks[to];
    let i int = block.first_inst;
    let after int = block.first_inst + block.inst_count;
    for i < after {
        let inst ir.IRInst = f.insts[i];
        if (inst.op != ir.IR_OP_PHI) { break; }
        if (inst.aux < 0 || inst.aux >= f.phi_count) { return -1; }
        let phi ir.IRPhi = f.phis[inst.aux];
        let found int = -1;
        let pi int = phi.first;
        let pa int = phi.first + phi.count;
        for pi < pa {
            if (f.phi_inputs[pi].pred == from) {
                found = f.phi_inputs[pi].value;
                break;
            }
            pi += 1;
        }
        if (found < 0 || arm64_load_value(f, found, "x9") != 0
            || arm64_store_value(f, inst.result_id, "x9") != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// arm64_emit_function：按块发射函数体、分支边复制块和共享返回尾声。
fn arm64_emit_function(f *ir.IRFunction, sym int, blocks *int,
    edges *int, epilogue int) int {
    let gs *gen.GenState = gen.G();
    let frame int = f.value_count * 16;
    if (gen.em_frag("\t.p2align 2\n") != 0) { return -1; }
    if ((gs.c_syms[sym].flags & (gen.F_PUB | gen.F_CABI)) != 0) {
        if (gen.em_frag("\t.globl\t") != 0
            || gen.em_put_sym_name(sym) != 0 || gen.em_frag("\n") != 0) {
            return -1;
        }
    }
    if (gen.em_put_sym_name(sym) != 0 || gen.em_frag(":\n") != 0
        || gen.em_ins("stp\tx29, x30, [sp, #-16]!") != 0
        || gen.em_ins("mov\tx29, sp") != 0) { return -1; }
    if (frame > 0) {
        if (frame <= 4095) {
            if (gen.em_frag("\tsub\tsp, sp, #") != 0
                || gen.em_puti(frame) != 0 || gen.em_frag("\n") != 0) { return -1; }
        } else if (gen.em_mov_imm("x9", frame.to_type(i64)) != 0
            || gen.em_ins("sub\tsp, sp, x9") != 0) { return -1; }
    }
    let b int = 0;
    for b < f.block_count {
        if (gen.em_label(blocks[b]) != 0) { return -1; }
        let block ir.IRBlock = f.blocks[b];
        let i int = block.first_inst;
        let after int = block.first_inst + block.inst_count;
        for i < after {
            if (arm64_emit_inst(f, &f.insts[i]) != 0) { return -1; }
            i += 1;
        }
        if (block.term == ir.IR_TERM_BR) {
            if (gen.em_frag("\tb\t") != 0
                || gen.em_put_lbl(edges[b * 2]) != 0
                || gen.em_frag("\n") != 0) { return -1; }
        } else if (block.term == ir.IR_TERM_COND_BR) {
            if (arm64_load_value(f, block.term_value, "x9") != 0
                || gen.em_frag("\tcbnz\tx9, ") != 0
                || gen.em_put_lbl(edges[b * 2]) != 0
                || gen.em_frag("\n\tb\t") != 0
                || gen.em_put_lbl(edges[b * 2 + 1]) != 0
                || gen.em_frag("\n") != 0) { return -1; }
        } else if (block.term == ir.IR_TERM_RET) {
            if (block.term_value >= 0) {
                if (arm64_load_value(f, block.term_value, "x0") != 0) { return -1; }
            } else if (gen.em_ins("mov\tx0, xzr") != 0) { return -1; }
            if (gen.em_frag("\tb\t") != 0
                || gen.em_put_lbl(epilogue) != 0
                || gen.em_frag("\n") != 0) { return -1; }
        } else if (block.term == ir.IR_TERM_UNREACHABLE) {
            if (gen.em_ins("brk\t#0") != 0) { return -1; }
        } else { return -1; }
        b += 1;
    }
    b = 0;
    for b < f.block_count {
        let edge int = 0;
        for edge < 2 {
            let to int = f.blocks[b].succ0;
            if (edge == 1) { to = f.blocks[b].succ1; }
            if (to >= 0) {
                if (gen.em_label(edges[b * 2 + edge]) != 0
                    || arm64_emit_phi_edge(f, b, to) != 0
                    || gen.em_frag("\tb\t") != 0
                    || gen.em_put_lbl(blocks[to]) != 0
                    || gen.em_frag("\n") != 0) { return -1; }
            }
            edge += 1;
        }
        b += 1;
    }
    if (gen.em_label(epilogue) != 0
        || gen.em_ins("mov\tsp, x29") != 0
        || gen.em_ins("ldp\tx29, x30, [sp], #16") != 0
        || gen.em_ins("ret") != 0 || gen.em_frag("\n") != 0) { return -1; }
    return 0;
}

// arm64_emit_replace：新后端成功发射后，以其汇编替换旧函数的文本范围。
// 返回 1 表示 IR 有尚未支持的能力，0 表示完成替换，-1 表示致命错误。
pub fn arm64_emit_replace(f *ir.IRFunction, sym int, first int,
    after int, shift *int, delta *int) int {
    let gs *gen.GenState = gen.G();
    delta[0] = 0;
    if (arm64_function_supported(f) == 0) { return 1; }
    if (sym < 0 || sym >= gs.c_sym_n || first < 0 || after < first
        || after > gs.o_len || gs.c_in_body != 0 || gs.c_check_only != 0) {
        return gen.fail("内部错误：SSA 后端函数输出范围无效");
    }
    let block_labels *int = malloc((f.block_count * sizeof(int)).to_type(u64)).to_type(*int);
    let edge_labels *int = malloc((f.block_count * 2 * sizeof(int)).to_type(u64)).to_type(*int);
    if (block_labels == 0 || edge_labels == 0) {
        if (block_labels != 0) { free(block_labels.to_type(*void)); }
        if (edge_labels != 0) { free(edge_labels.to_type(*void)); }
        return gen.fail("SSA 后端标签表分配失败");
    }
    let b int = 0;
    for b < f.block_count {
        block_labels[b] = gen.em_new_label();
        edge_labels[b * 2] = -1;
        edge_labels[b * 2 + 1] = -1;
        if (f.blocks[b].succ0 >= 0) { edge_labels[b * 2] = gen.em_new_label(); }
        if (f.blocks[b].succ1 >= 0) { edge_labels[b * 2 + 1] = gen.em_new_label(); }
        b += 1;
    }
    let epilogue int = gen.em_new_label();
    let old_total int = gs.o_len;
    if (arm64_emit_function(f, sym, block_labels, edge_labels, epilogue) != 0) {
        free(block_labels.to_type(*void));
        free(edge_labels.to_type(*void));
        return gen.fail("SSA arm64 指令发射失败");
    }
    let generated_end int = gs.o_len;
    let old_size int = after - first;
    let new_size int = generated_end - old_total;
    let suffix_size int = old_total - after;
    let replacement *u8 = malloc(new_size.to_type(u64)).to_type(*u8);
    if (replacement == 0) {
        free(block_labels.to_type(*void));
        free(edge_labels.to_type(*void));
        return gen.fail("SSA 汇编替换缓冲分配失败");
    }
    let copied int = 0;
    for copied < new_size {
        replacement[copied] = gs.o_out[old_total + copied];
        copied += 1;
    }
    let suffix_src int = after;
    let suffix_dst int = first + new_size;
    if (suffix_dst > suffix_src) {
        copied = suffix_size;
        for copied > 0 {
            copied -= 1;
            gs.o_out[suffix_dst + copied] = gs.o_out[suffix_src + copied];
        }
    } else {
        copied = 0;
        for copied < suffix_size {
            gs.o_out[suffix_dst + copied] = gs.o_out[suffix_src + copied];
            copied += 1;
        }
    }
    copied = 0;
    for copied < new_size {
        gs.o_out[first + copied] = replacement[copied];
        copied += 1;
    }
    free(replacement.to_type(*void));
    gs.o_len = old_total - old_size + new_size;
    delta[0] = new_size - old_size;
    shift[0] += delta[0];
    free(block_labels.to_type(*void));
    free(edge_labels.to_type(*void));
    return 0;
}
