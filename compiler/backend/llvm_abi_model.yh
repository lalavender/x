module backend

// LLVMSourceMap：LLVM 文本行区间对应模块自有来源位置；数字索引没有借用指针。
pub struct LLVMSourceMap {
    line int
    end_line int
    source int
    offset int
    symbol int
}

// LLVMOutput：独占 NUL 结尾文本及映射数组；成功后由调用方 release，失败不改变出参。
pub struct LLVMOutput {
    text *u8
    length int
    capacity int
    maps *LLVMSourceMap
    map_count int
    map_capacity int
    emitted int
    line int
    failed int
}
