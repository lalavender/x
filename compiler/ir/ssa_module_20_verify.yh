module ir

// ir_module_table_ok：核对公开表计数与容量；未分配表只能保持零计数/零容量。
fn ir_module_table_ok(data *void, count int, capacity int, item_size int) int {
    if (count < 0 || capacity < count || capacity > IR_SERIAL_MAX_ITEMS
        || capacity > IR_SERIAL_MAX_BYTES / item_size) { return 0 }
    if (capacity == 0) { return count == 0 && data == 0 }
    return data != 0
}

// ir_module_align_ok：模块布局只接受非零二次幂对齐，并保持字节计数在既有 IR 上限内。
fn ir_module_align_ok(align int) int {
    return align > 0 && align <= IR_SERIAL_MAX_BYTES && (align & (align - 1)) == 0
}

// ir_module_loc_ok：来源必须指向模块独占的源码；允许位置恰好位于文件末尾。
fn ir_module_loc_ok(unit *IRModule, source int, offset int) int {
    return source >= 0 && source < unit.source_count && offset >= 0 && offset <= unit.sources[source].length
}

// ir_module_type_ref_ok：模块类型引用不接受函数私有类型、前端编号或指针地址。
fn ir_module_type_ref_ok(unit *IRModule, type_id int) int {
    return type_id >= 0 && type_id < unit.type_count
}

// ir_module_aggregate_kind：识别 yh-llvm-v1 通过显式地址传递的模块聚合布局。
fn ir_module_aggregate_kind(kind int) int {
    return (kind >= IR_MODULE_TY_STRUCT && kind <= IR_MODULE_TY_SLICE).to_type(int)
}

// ir_module_scalar_layout：逐类核对标量/指针布局；void 仅用于签名，不能作为对象或参数。
fn ir_module_scalar_layout(unit *IRModule, value *IRModuleType) int {
    if (value.field_count != 0 || value.count != 0 || value.abi != 0 || value.variadic != 0) { return 0 }
    if (value.kind == IR_TY_VOID) {
        return value.bits == 0 && value.size == 0 && value.align == 1 && value.elem == -1
    }
    if (value.kind == IR_TY_PTR) {
        return value.bits == unit.target.pointer_bits && value.size == unit.target.pointer_bits / 8 &&
            value.align == value.size && ir_module_type_ref_ok(unit, value.elem) != 0
    }
    if (value.elem != -1) { return 0 }
    let bits int = 0
    if (value.kind == IR_TY_BOOL || value.kind == IR_TY_I8 || value.kind == IR_TY_U8) { bits = 8 }
    else if (value.kind == IR_TY_I16 || value.kind == IR_TY_U16) { bits = 16 }
    else if (value.kind == IR_TY_I32 || value.kind == IR_TY_U32 || value.kind == IR_TY_F32) { bits = 32 }
    else if (value.kind == IR_TY_I64 || value.kind == IR_TY_U64 || value.kind == IR_TY_F64) { bits = 64 }
    return bits > 0 && value.bits == bits && value.size == bits / 8 && value.align == bits / 8
}

// ir_module_verify_type：核对布局和所有字段引用；聚合布局精确保留正常对齐、顺序和尾部填充。
fn ir_module_verify_type(unit *IRModule, value *IRModuleType) int {
    if (ir_module_str_len(value.name) < 0 || value.kind < IR_TY_VOID || value.kind > IR_MODULE_TY_FUNCTION
        || value.size < 0 || value.size > IR_SERIAL_MAX_BYTES || ir_module_align_ok(value.align) == 0
        || value.field_count < 0 || value.field_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleField)
        || value.field_count > 0 && value.fields == 0 || value.field_count == 0 && value.fields != 0) { return -1 }
    if (value.kind <= IR_TY_PTR) { return ir_module_scalar_layout(unit, value) != 0 ? 0 : -1 }
    if (value.bits != 0 || value.count < 0) { return -1 }
    if (value.kind == IR_MODULE_TY_FUNCTION) {
        if (value.size != unit.target.pointer_bits / 8 || value.align != unit.target.pointer_bits / 8
            || value.count != 0 || ir_module_type_ref_ok(unit, value.elem) == 0
            || value.abi < 0 || value.abi > IR_ABI_YH_LLVM_V1
            || value.variadic < 0 || value.variadic > 2) { return -1 }
        let i int = 0
        for i < value.field_count {
            let field IRModuleField = value.fields[i]
            if (ir_module_type_ref_ok(unit, field.type_id) == 0 || field.offset != 0
                || unit.types[field.type_id].kind == IR_TY_VOID
                ) { return -1 }
            i += 1
        }
        return 0
    }
    if (value.abi != 0 || value.variadic != 0) { return -1 }
    if (value.kind == IR_MODULE_TY_ARRAY || value.kind == IR_MODULE_TY_SLICE) {
        if (ir_module_type_ref_ok(unit, value.elem) == 0 || value.field_count != 0
            || unit.types[value.elem].kind == IR_TY_VOID) { return -1 }
        let elem IRModuleType = unit.types[value.elem]
        if (value.kind == IR_MODULE_TY_SLICE) {
            return value.count == 0 && value.size == 16 && value.align == 8 ? 0 : -1
        }
        if (elem.size != 0 && value.count > IR_SERIAL_MAX_BYTES / elem.size) { return -1 }
        return value.size == value.count * elem.size && value.align == elem.align ? 0 : -1
    }
    if (value.elem != -1 || value.count != 0) { return -1 }
    let end int = 0
    let max_align int = 1
    let i int = 0
    for i < value.field_count {
        let field IRModuleField = value.fields[i]
        if (ir_module_type_ref_ok(unit, field.type_id) == 0) { return -1 }
        let child IRModuleType = unit.types[field.type_id]
        if (child.kind == IR_TY_VOID || child.size < 0
            || ir_module_align_ok(child.align) == 0 || field.offset < 0 || field.offset > value.size
            || child.size > value.size - field.offset || field.offset % child.align != 0) { return -1 }
        if (child.align > max_align) { max_align = child.align }
        if (value.kind == IR_MODULE_TY_UNION) {
            if (field.offset != 0) { return -1 }
            if (child.size > end) { end = child.size }
        } else {
            let aligned int = (end + child.align - 1) / child.align * child.align
            if (field.offset != aligned) { return -1 }
            end = field.offset + child.size
        }
        i += 1
    }
    if (end > IR_SERIAL_MAX_BYTES - max_align + 1) { return -1 }
    let size int = (end + max_align - 1) / max_align * max_align
    return value.align == max_align && value.size == size ? 0 : -1
}

// ir_module_layout_visit：拒绝按值布局环，指针、切片和函数签名终止递归，允许合法递归指针。
// ponytail: 布局 DFS 深度最多 256；若实用语料需要更深嵌套，改用显式遍历栈。
fn ir_module_layout_visit(unit *IRModule, id int, colors *u8, depth int) int {
    if (depth > 256 || colors[id] == 1) { return -1 }
    if (colors[id] == 2) { return 0 }
    colors[id] = 1
    let value IRModuleType = unit.types[id]
    if (value.kind == IR_MODULE_TY_ARRAY) {
        if (ir_module_layout_visit(unit, value.elem, colors, depth + 1) != 0) { return -1 }
    } else if (value.kind == IR_MODULE_TY_STRUCT || value.kind == IR_MODULE_TY_UNION) {
        let i int = 0
        for i < value.field_count {
            if (ir_module_layout_visit(unit, value.fields[i].type_id, colors, depth + 1) != 0) { return -1 }
            i += 1
        }
    }
    colors[id] = 2
    return 0
}

// ir_module_pointer_slot：在已验证布局中寻找精确的指针槽；不把整数填充区当成指针初始化。
fn ir_module_pointer_slot(unit *IRModule, id int, offset int, depth int) int {
    if (depth > 256 || offset < 0) { return 0 }
    let value IRModuleType = unit.types[id]
    if (value.kind == IR_TY_PTR) { return offset == 0 }
    if (value.kind == IR_MODULE_TY_FUNCTION) { return offset == 0 }
    if (value.kind == IR_MODULE_TY_SLICE) { return offset == 8 }
    if (value.kind == IR_MODULE_TY_ARRAY) {
        let elem IRModuleType = unit.types[value.elem]
        if (elem.size <= 0 || offset >= value.size) { return 0 }
        return ir_module_pointer_slot(unit, value.elem, offset % elem.size, depth + 1)
    }
    if (value.kind == IR_MODULE_TY_STRUCT || value.kind == IR_MODULE_TY_UNION) {
        let i int = 0
        for i < value.field_count {
            let field IRModuleField = value.fields[i]
            let child IRModuleType = unit.types[field.type_id]
            if (offset >= field.offset && offset - field.offset < child.size
                && ir_module_pointer_slot(unit, field.type_id, offset - field.offset, depth + 1) != 0) { return 1 }
            i += 1
        }
    }
    return 0
}

// ir_module_verify_symbol：核对签名、来源、链接和定义状态；重复逻辑名统一在模块表中拒绝。
fn ir_module_verify_symbol(unit *IRModule, value *IRModuleSymbol) int {
    let n int = ir_module_str_len(value.name)
    if (n <= 0 || ir_module_type_ref_ok(unit, value.type_id) == 0
        || value.linkage < IR_MODULE_LINK_PRIVATE || value.linkage > IR_MODULE_LINK_EXTERNAL
        || value.defined < 0 || value.defined > 1 || value.mutable < 0 || value.mutable > 1
        || value.abi < 0 || value.abi > IR_ABI_YH_LLVM_V1 || value.variadic < 0 || value.variadic > 2
        || value.no_return < 0 || value.no_return > 1
        || value.param_count < 0 || value.param_count > IR_SERIAL_MAX_BYTES / sizeof(int)
        || value.param_count > 0 && value.params == 0 || value.param_count == 0 && value.params != 0
        || ir_module_loc_ok(unit, value.source, value.offset) == 0
        || value.defined == 0 && value.linkage == IR_MODULE_LINK_PRIVATE) { return -1 }
    let i int = 0
    for i < n { if (ir_call_symbol_byte_ok(value.name[i].to_type(u8)) == 0) { return -1 } i += 1 }
    if (value.kind == IR_MODULE_SYMBOL_GLOBAL) {
        return unit.types[value.type_id].kind != IR_TY_VOID && value.param_count == 0 &&
            value.abi == 0 && value.variadic == 0 && value.no_return == 0 ? 0 : -1
    }
    if (value.kind != IR_MODULE_SYMBOL_FUNCTION || value.mutable != 0) { return -1 }
    if (value.no_return != 0 && unit.types[value.type_id].kind != IR_TY_VOID) { return -1 }
    i = 0
    for i < value.param_count {
        if (ir_module_type_ref_ok(unit, value.params[i]) == 0
            || unit.types[value.params[i]].kind == IR_TY_VOID
            ) { return -1 }
        i += 1
    }
    return 0
}

// ir_module_verify_global：核对实体/类型的大小与对齐、指针槽、目标符号、零占位和不重叠重定位。
fn ir_module_verify_global(unit *IRModule, value *IRModuleGlobal) int {
    if (value.symbol < 0 || value.symbol >= unit.symbol_count || value.size < 0
        || value.size > IR_SERIAL_MAX_BYTES || value.size > 0 && value.data == 0
        || value.size == 0 && value.data != 0 || ir_module_align_ok(value.align) == 0
        || value.reloc_count < 0 || value.reloc_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleReloc)
        || value.reloc_count > 0 && value.relocs == 0 || value.reloc_count == 0 && value.relocs != 0) { return -1 }
    let symbol IRModuleSymbol = unit.symbols[value.symbol]
    let ty IRModuleType = unit.types[symbol.type_id]
    if (symbol.kind != IR_MODULE_SYMBOL_GLOBAL || symbol.defined != 1
        || value.size != ty.size || value.align < ty.align) { return -1 }
    let i int = 0
    for i < value.reloc_count {
        let relocation IRModuleReloc = value.relocs[i]
        if (relocation.offset < 0 || relocation.offset > value.size
            || relocation.width != unit.target.pointer_bits / 8
            || relocation.width > value.size - relocation.offset
            || relocation.symbol < 0 || relocation.symbol >= unit.symbol_count
            || ir_module_pointer_slot(unit, symbol.type_id, relocation.offset, 0) == 0) { return -1 }
        let byte int = 0
        for byte < relocation.width {
            if (value.data[relocation.offset + byte] != 0) { return -1 }
            byte += 1
        }
        let j int = 0
        for j < i {
            let previous IRModuleReloc = value.relocs[j]
            if (relocation.offset < previous.offset + previous.width
                && previous.offset < relocation.offset + relocation.width) { return -1 }
            j += 1
        }
        i += 1
    }
    return 0
}

// ir_module_call_symbol：把函数自有调用名字节解析到模块逻辑符号表；不借用旧汇编前缀规则。
fn ir_module_call_symbol(unit *IRModule, body *IRFunction, call *IRCall) int {
    let i int = 0
    for i < unit.symbol_count {
        if (ir_module_str_len(unit.symbols[i].name) == call.symbol_len) {
            let j int = 0
            for j < call.symbol_len && unit.symbols[i].name[j].to_type(u8) ==
                body.call_symbols[call.symbol_first + j] { j += 1 }
            if (j == call.symbol_len) { return i }
        }
        i += 1
    }
    return -1
}

// ir_module_function_type_same：核对函数值类型与直接函数符号的完整 ABI 签名。
fn ir_module_function_type_same(unit *IRModule, symbol *IRModuleSymbol, type_id int) int {
    if (symbol.kind != IR_MODULE_SYMBOL_FUNCTION || type_id < 0 || type_id >= unit.type_count) { return 0 }
    let signature IRModuleType = unit.types[type_id]
    if (signature.kind != IR_MODULE_TY_FUNCTION || signature.elem != symbol.type_id
        || signature.abi != symbol.abi || signature.variadic != symbol.variadic
        || signature.field_count != symbol.param_count) { return 0 }
    let i int = 0
    for i < symbol.param_count {
        if (signature.fields[i].type_id != symbol.params[i]) { return 0 }
        i += 1
    }
    return 1
}

// ir_module_noreturn_body_ok：noreturn 定义不能从入口到达 RET；不可达续块不影响契约。
fn ir_module_noreturn_body_ok(value *IRModuleFunction) int {
    let count int = value.body.block_count
    if (count <= 0) { return 0 }
    let reachable *u8 = malloc(count.to_type(u64)).to_type(*u8)
    let queue *int = malloc((count * sizeof(int)).to_type(u64)).to_type(*int)
    if (reachable == 0 || queue == 0) {
        if (reachable != 0) { free(reachable) }
        if (queue != 0) { free(queue) }
        return 0
    }
    let i int = 0
    for i < count { reachable[i] = 0; i += 1 }
    reachable[0] = 1; queue[0] = 0
    let head int = 0
    let tail int = 1
    for head < tail {
        let block IRBlock = value.body.blocks[queue[head]]
        if (block.succ0 >= 0 && reachable[block.succ0] == 0) {
            reachable[block.succ0] = 1; queue[tail] = block.succ0; tail += 1
        }
        if (block.succ1 >= 0 && reachable[block.succ1] == 0) {
            reachable[block.succ1] = 1; queue[tail] = block.succ1; tail += 1
        }
        head += 1
    }
    let valid int = 1
    i = 0
    for i < count {
        if (reachable[i] != 0 && value.body.blocks[i].term == IR_TERM_RET) { valid = 0 }
        i += 1
    }
    free(reachable); free(queue)
    return valid
}

// ir_module_verify_function：复用 SSA verifier，再校验目标、模块映射、定义签名、调用闭包与来源。
fn ir_module_verify_function(unit *IRModule, value *IRModuleFunction) int {
    if (value.symbol < 0 || value.symbol >= unit.symbol_count || value.body.target_id != unit.target.key
        || value.type_map_count != value.body.type_count || value.type_map_count <= 0 || value.type_map == 0
        || value.loc_count != value.body.inst_count || value.loc_count < 0
        || value.loc_count > 0 && value.locs == 0 || value.loc_count == 0 && value.locs != 0) { return -1 }
    if (ir_verify(&value.body) != 0) { return -1 }
    let symbol IRModuleSymbol = unit.symbols[value.symbol]
    if (symbol.kind != IR_MODULE_SYMBOL_FUNCTION || symbol.defined != 1 || symbol.abi != value.body.abi) { return -1 }
    let i int = 0
    for i < value.type_map_count {
        let id int = value.type_map[i]
        if (ir_module_type_ref_ok(unit, id) == 0) { return -1 }
        let local IRType = value.body.types[i]
        let ty IRModuleType = unit.types[id]
        if (local.kind == IR_TY_FN_PTR) {
            // 函数指针的 ABI 签名由使用点 FUNCTION 元数据核对；SSA 槽仍映射到通用指针。
            if (ty.kind != IR_TY_PTR || local.bits != ty.bits) { return -1 }
        } else if (local.kind >= IR_TY_PTR) {
            // 模块层指针统一 IR_TY_PTR，元素经 type_map 精确对照。
            if (ty.kind != IR_TY_PTR || local.bits != ty.bits
                || value.type_map[local.elem] != ty.elem) { return -1 }
        } else if (local.kind != ty.kind || local.bits != ty.bits) {
            return -1
        }
        i += 1
    }
    let result_type IRModuleType = unit.types[symbol.type_id]
    if (symbol.no_return != 0 && ir_module_noreturn_body_ok(value) == 0) { return -1 }
    let aggregate_return int = (symbol.abi == IR_ABI_YH_LLVM_V1 || symbol.abi == 1) &&
        ir_module_aggregate_kind(result_type.kind) != 0 ? 1 : 0
    if (aggregate_return != 0) {
        if (value.body.types[value.body.ret_type].kind != IR_TY_VOID) { return -1 }
    } else if (result_type.kind == IR_MODULE_TY_FUNCTION) {
        if (value.body.types[value.body.ret_type].kind != IR_TY_FN_PTR) { return -1 }
    } else if (value.type_map[value.body.ret_type] != symbol.type_id) { return -1 }
    let param_count int = 0
    // 已有 verifier 保证 PARAM 只在入口且连续，这里按真实指令核对模块签名。
    i = 0
    for i < value.body.inst_count {
        let inst IRInst = value.body.insts[i]
        if (ir_module_loc_ok(unit, value.locs[i].source, value.locs[i].offset) == 0) { return -1 }
        if (inst.op == IR_OP_PARAM) {
            let expected_params int = symbol.param_count + aggregate_return
            if (inst.imm < 0 || inst.imm >= expected_params) { return -1 }
            if (aggregate_return != 0 && inst.imm == 0) {
                if (value.body.types[inst.result_type].kind != IR_TY_PTR) { return -1 }
            } else {
                let logical int = inst.imm.to_type(int) - aggregate_return
                let expected IRModuleType = unit.types[symbol.params[logical]]
                if ((symbol.abi == IR_ABI_YH_LLVM_V1 || symbol.abi == 1)
                    && ir_module_aggregate_kind(expected.kind) != 0) {
                    if (value.body.types[inst.result_type].kind != IR_TY_PTR) { return -1 }
                } else if (expected.kind == IR_MODULE_TY_FUNCTION) {
                    if (value.body.types[inst.result_type].kind != IR_TY_FN_PTR) { return -1 }
                } else if (value.type_map[inst.result_type] != symbol.params[logical]) { return -1 }
            }
            param_count += 1
        }
        if (inst.op == IR_OP_GLOB_ADDR) {
            // 全局取址必须指向本模块已定义的全局符号，且结果经映射后是指针。
            if (inst.imm < 0 || inst.imm >= unit.symbol_count.to_type(i64)) { return -1 }
            let target IRModuleSymbol = unit.symbols[inst.imm.to_type(int)]
            if (target.kind != IR_MODULE_SYMBOL_GLOBAL || target.defined != 1
                || inst.result_type < 0
                || unit.types[value.type_map[inst.result_type]].kind != IR_TY_PTR) { return -1 }
        }
        if (inst.op == IR_OP_FN_ADDR) {
            if (inst.imm < 0 || inst.imm >= unit.symbol_count || inst.aux < 0
                || inst.aux >= unit.type_count || inst.result_type < 0
                || value.body.types[inst.result_type].kind != IR_TY_FN_PTR
                || ir_module_function_type_same(unit, &unit.symbols[inst.imm], inst.aux) == 0) { return -1 }
        }
        if (inst.op == IR_OP_CALL) {
            let call IRCall = value.body.calls[inst.aux]
            if (call.callee_value >= 0) {
                if (call.signature_type < 0 || call.signature_type >= unit.type_count) { return -1 }
                let signature IRModuleType = unit.types[call.signature_type]
                if (signature.kind != IR_MODULE_TY_FUNCTION || signature.abi != call.abi) { return -1 }
                let callee_type int = ir_find_value_type(&value.body, call.callee_value)
                let return_type IRModuleType = unit.types[signature.elem]
                let aggregate_return int = (signature.abi == IR_ABI_YH_LLVM_V1 || signature.abi == 1) &&
                    ir_module_aggregate_kind(return_type.kind) != 0 ? 1 : 0
                if (callee_type < 0 || value.body.types[callee_type].kind != IR_TY_FN_PTR
                    || signature.variadic == 1
                        && call.arg_count < signature.field_count + aggregate_return
                    || signature.variadic != 1
                        && call.arg_count != signature.field_count + aggregate_return) { return -1 }
                if (aggregate_return != 0) {
                    if (value.body.types[value.body.call_args[call.arg_first].type_id].kind != IR_TY_PTR
                        || inst.result_type != -1) { return -1 }
                } else if (return_type.kind == IR_TY_VOID) {
                    if (inst.result_type != -1) { return -1 }
                } else if (return_type.kind == IR_MODULE_TY_FUNCTION) {
                    if (inst.result_type < 0
                        || value.body.types[inst.result_type].kind != IR_TY_FN_PTR) { return -1 }
                } else if (inst.result_type < 0 || value.type_map[inst.result_type] != signature.elem) { return -1 }
                let arg int = 0
                for arg < signature.field_count {
                    let actual int = value.body.call_args[call.arg_first + arg + aggregate_return].type_id
                    let expected IRModuleType = unit.types[signature.fields[arg].type_id]
                    if ((signature.abi == IR_ABI_YH_LLVM_V1 || signature.abi == 1)
                        && ir_module_aggregate_kind(expected.kind) != 0) {
                        if (value.body.types[actual].kind != IR_TY_PTR) { return -1 }
                    } else if (expected.kind == IR_MODULE_TY_FUNCTION) {
                        if (value.body.types[actual].kind != IR_TY_FN_PTR) { return -1 }
                    } else if (value.type_map[actual] != signature.fields[arg].type_id) { return -1 }
                    arg += 1
                }
                arg = signature.field_count + aggregate_return
                for arg < call.arg_count {
                    let actual int = value.body.call_args[call.arg_first + arg].type_id
                    let kind int = value.body.types[actual].kind
                    if (ir_scalar_type(kind) == 0
                        && (kind < IR_TY_PTR || kind > IR_TY_PTR_LAST)
                        && kind != IR_TY_FN_PTR) { return -1 }
                    arg += 1
                }
                i += 1
                continue
            }
            let called int = ir_module_call_symbol(unit, &value.body, &call)
            if (called < 0) { return -1 }
            let signature IRModuleSymbol = unit.symbols[called]
            let ret_type IRModuleType = unit.types[signature.type_id]
            let hidden_result int = (signature.abi == IR_ABI_YH_LLVM_V1 || signature.abi == 1) &&
                ir_module_aggregate_kind(ret_type.kind) != 0 ? 1 : 0
            if (signature.kind != IR_MODULE_SYMBOL_FUNCTION || call.abi != signature.abi
                || signature.variadic == 1
                    && call.arg_count < signature.param_count + hidden_result
                || signature.variadic != 1
                    && call.arg_count != signature.param_count + hidden_result) { return -1 }
            if (hidden_result != 0
                && value.body.types[value.body.call_args[call.arg_first].type_id].kind != IR_TY_PTR) { return -1 }
            let arg int = 0
            for arg < signature.param_count {
                let actual_id int = value.body.call_args[call.arg_first + arg + hidden_result].type_id
                let expected IRModuleType = unit.types[signature.params[arg]]
                if ((signature.abi == IR_ABI_YH_LLVM_V1 || signature.abi == 1)
                    && ir_module_aggregate_kind(expected.kind) != 0) {
                    if (value.body.types[actual_id].kind != IR_TY_PTR) { return -1 }
                } else if (expected.kind == IR_MODULE_TY_FUNCTION) {
                    if (value.body.types[actual_id].kind != IR_TY_FN_PTR) { return -1 }
                } else if (value.type_map[actual_id] != signature.params[arg]) { return -1 }
                arg += 1
            }
            arg = signature.param_count + hidden_result
            for arg < call.arg_count {
                let actual int = value.body.call_args[call.arg_first + arg].type_id
                let kind int = value.body.types[actual].kind
                if (ir_scalar_type(kind) == 0
                    && (kind < IR_TY_PTR || kind > IR_TY_PTR_LAST)
                    && kind != IR_TY_FN_PTR) { return -1 }
                arg += 1
            }
            if (hidden_result != 0) {
                if (inst.result_type != -1) { return -1 }
            } else if (ret_type.kind == IR_TY_VOID) {
                if (inst.result_type != -1) { return -1 }
            } else if (ret_type.kind == IR_MODULE_TY_FUNCTION) {
                if (inst.result_type < 0
                    || value.body.types[inst.result_type].kind != IR_TY_FN_PTR) { return -1 }
            } else if (inst.result_type < 0 || value.type_map[inst.result_type] != signature.type_id) { return -1 }
        }
        i += 1
    }
    return param_count == symbol.param_count + aggregate_return ? 0 : -1
}

// ir_module_verify：封闭完整模块的目标、来源、布局、唯一逻辑符号、数据实体与函数 IR。
// 返回 0 或 -1；验证不改变模块内容，不初始化 LLVM，也不访问 gen/旧机器输出。
// ir_module_verify_symbol_names：用开放寻址哈希表检查符号名唯一性。
// 语义与原先的两两比较完全一致（同名即拒绝），复杂度从 O(n²) 次字符串比较
// 降到期望 O(n)；哈希碰撞时仍做完整字符串比较，不靠哈希值下结论。
// 返回 0 表示唯一，-1 表示重名或内存不足。
fn ir_module_verify_symbol_names(unit *IRModule) int {
    let n int = unit.symbol_count
    if (n < 2) { return 0 }
    let table_n int = 2
    for table_n < n * 2 {
        if (table_n > 1073741824) { break }
        table_n *= 2
    }
    let slots *int = malloc((table_n * sizeof(int)).to_type(u64)).to_type(*int)
    if (slots == 0) { return -1 }
    let k int = 0
    for k < table_n { slots[k] = 0; k += 1 }
    let mask u64 = (table_n - 1).to_type(u64)
    let i int = 0
    for i < n {
        let h u64 = 0
        if (ir_module_fnv_text(IR_MODULE_FNV_BASIS, unit.symbols[i].name, &h) != 0) {
            free(slots.to_type(*void))
            return -1
        }
        let pos u64 = h & mask
        let placed int = 0
        for placed == 0 {
            let slot int = slots[pos.to_type(int)]
            if (slot == 0) {
                slots[pos.to_type(int)] = i + 1
                placed = 1
            } else if (ir_module_str_eq(unit.symbols[i].name,
                    unit.symbols[slot - 1].name) != 0) {
                free(slots.to_type(*void))
                return -1
            } else {
                // 线性探测；表容量 >= 2n 且最多 n 个元素，必然有空位。
                pos = (pos + 1) & mask
            }
        }
        i += 1
    }
    free(slots.to_type(*void))
    return 0
}

// ir_module_sealed：只检查模块头结构（非空、版本匹配），不做任何遍历。
// 给「生产者已完整 verify、消费方只需拒绝半初始化模块」的路径用（如后端发射）。
pub fn ir_module_sealed(unit *IRModule) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION) { return 0 }
    return 1
}

pub fn ir_module_verify(unit *IRModule) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || ir_module_target_ok(&unit.target) == 0
        || ir_module_table_ok(unit.sources.to_type(*void), unit.source_count, unit.source_capacity, sizeof(IRModuleSource)) == 0
        || ir_module_table_ok(unit.types.to_type(*void), unit.type_count, unit.type_capacity, sizeof(IRModuleType)) == 0
        || ir_module_table_ok(unit.symbols.to_type(*void), unit.symbol_count, unit.symbol_capacity, sizeof(IRModuleSymbol)) == 0
        || ir_module_table_ok(unit.globals.to_type(*void), unit.global_count, unit.global_capacity, sizeof(IRModuleGlobal)) == 0
        || ir_module_table_ok(unit.functions.to_type(*void), unit.function_count, unit.function_capacity, sizeof(IRModuleFunction)) == 0) { return -1 }
    let i int = 0
    for i < unit.source_count {
        let source IRModuleSource = unit.sources[i]
        if (ir_module_str_len(source.path) <= 0 || source.length < 0 || source.length > IR_SERIAL_MAX_BYTES
            || source.length > 0 && source.text == 0 || source.length == 0 && source.text != 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.type_count { if (ir_module_verify_type(unit, &unit.types[i]) != 0) { return -1 } i += 1 }
    let colors *u8 = 0
    if (unit.type_count > 0) {
        colors = malloc(unit.type_count.to_type(u64)).to_type(*u8)
        if (colors == 0) { return -1 }
    }
    i = 0
    for i < unit.type_count { colors[i] = 0; i += 1 }
    i = 0
    for i < unit.type_count {
        if (ir_module_layout_visit(unit, i, colors, 0) != 0) { free(colors); return -1 }
        i += 1
    }
    if (colors != 0) { free(colors) }
    i = 0
    for i < unit.symbol_count {
        if (ir_module_verify_symbol(unit, &unit.symbols[i]) != 0) { return -1 }
        i += 1
    }
    // PL1d：符号名唯一性改用哈希表。原来的两两比较是 O(n²) 次字符串比较，
    // 真实模块有几百到上千个符号（含依赖），verify 因此成为 lowering 里的大项
    // （冷编 18.8%），且「每函数成本」随模块变大而涨（PL2 的超线性来源之一）。
    if (ir_module_verify_symbol_names(unit) != 0) { return -1 }
    i = 0
    for i < unit.global_count { if (ir_module_verify_global(unit, &unit.globals[i]) != 0) { return -1 } i += 1 }
    i = 0
    for i < unit.function_count { if (ir_module_verify_function(unit, &unit.functions[i]) != 0) { return -1 } i += 1 }
    // 每个定义恰有一个实体，每个声明没有实体；同时排除重复 body/global 绑定。
    // PL1d：按符号下标一次计数（O(符号+全局+函数)），不再对每个符号各扫一遍全局与函数。
    let entity *int = 0
    if (unit.symbol_count > 0) {
        entity = malloc((unit.symbol_count * sizeof(int)).to_type(u64)).to_type(*int)
        if (entity == 0) { return -1 }
        i = 0
        for i < unit.symbol_count { entity[i] = 0; i += 1 }
    }
    i = 0
    for i < unit.global_count {
        let owner int = unit.globals[i].symbol
        if (owner < 0 || owner >= unit.symbol_count) {
            free(entity.to_type(*void)); return -1
        }
        entity[owner] += 1
        i += 1
    }
    i = 0
    for i < unit.function_count {
        let owner int = unit.functions[i].symbol
        if (owner < 0 || owner >= unit.symbol_count) {
            free(entity.to_type(*void)); return -1
        }
        entity[owner] += 1
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        let ok int = entity[i] == unit.symbols[i].defined
        i += 1
        if (ok == 0) { free(entity.to_type(*void)); return -1 }
    }
    free(entity.to_type(*void))
    return 0
}
