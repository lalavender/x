module ir;

// 模块类型扩展复用 IR_TY_* 标量编码；所有 elem/field/type_id 都是模块 types 表下标。
pub const IR_MODULE_TY_STRUCT int = 13;
pub const IR_MODULE_TY_UNION int = 14;
pub const IR_MODULE_TY_ARRAY int = 15;
pub const IR_MODULE_TY_SLICE int = 16;
pub const IR_MODULE_TY_FUNCTION int = 17;
pub const IR_MODULE_SYMBOL_FUNCTION int = 1;
pub const IR_MODULE_SYMBOL_GLOBAL int = 2;
pub const IR_MODULE_LINK_PRIVATE int = 0;
pub const IR_MODULE_LINK_EXTERNAL int = 1;
// LLVM 首版 yh 内部调用约定；不同 ABI 版本不能合并到同一模块符号。
pub const IR_ABI_YH_LLVM_V1 int = 2;
const IR_MODULE_VERSION int = 3;

// IRModuleTarget：模块独占完整目标字符串；key 只校验函数表一致性，不能替代完整身份。
// key 固定为 Linux arm64=1、Linux x64=2、Darwin arm64=3、Darwin x64=4。
pub struct IRModuleTarget {
    triple *char;
    data_layout *char;
    abi *char;
    pointer_bits int;
    little_endian int;
    layout_version int;
    key int;
}

// IRModuleSource：独占路径与源码字节，位置使用 [0,length] 内的字节偏移，允许文件末尾。
pub struct IRModuleSource {
    path *char;
    text *u8;
    length int;
}

// IRModuleLoc：指向模块自有来源表；不保存 lexer/token/GenState 的临时指针。
pub struct IRModuleLoc {
    source int;
    offset int;
}

// IRModuleField：聚合字段的模块类型身份和字节偏移；函数类型的参数字段 offset 必须为零。
pub struct IRModuleField {
    type_id int;
    offset int;
}

// IRModuleType：独占名义类型名和字段表；布局来自受检语义，verifier 核对大小、对齐和引用。
// ARRAY 的 count 是元素数，SLICE 的 elem 是元素类型；FUNCTION 的 elem 是返回类型，
// fields 是参数类型，abi/variadic 保存签名；指针允许引用尚未加入的聚合，最终统一检查。
pub struct IRModuleType {
    name *char;
    kind int;
    bits int;
    size int;
    align int;
    elem int;
    count int;
    fields *IRModuleField;
    field_count int;
    abi int;
    variadic int;
}

// IRModuleSymbol：独占逻辑名称及参数类型表；不包含 Darwin 汇编前缀。
// FUNCTION 的 type_id 是返回类型，GLOBAL 的 type_id 是对象类型；defined 必须对应一个实体。
// source/offset 是声明或定义位置；C ABI=1、yh ABI=0，variadic 表示固定参数之后的实参。
pub struct IRModuleSymbol {
    name *char;
    kind int;
    type_id int;
    params *int;
    param_count int;
    abi int;
    variadic int;
    no_return int;
    linkage int;
    defined int;
    mutable int;
    source int;
    offset int;
}

// IRModuleReloc：初始化中的有类型指针槽；symbol 引用逻辑符号表，addend 是符号地址加数。
// width 是字节数，必须等于目标指针大小；对应原始数据槽必须为零，不能混入旧汇编文本。
pub struct IRModuleReloc {
    offset int;
    width int;
    symbol int;
    addend i64;
}

// IRModuleGlobal：独占完整初始化字节与重定位表；size/align 和符号对象类型须一致。
pub struct IRModuleGlobal {
    symbol int;
    data *u8;
    size int;
    align int;
    relocs *IRModuleReloc;
    reloc_count int;
}

// IRModuleFunction：独占函数 IR 及显式类型映射；body 仍使用函数私有类型下标。
// type_map 将每个私有类型映射到模块 types；locs 为每条指令保存模块来源位置。
pub struct IRModuleFunction {
    symbol int;
    body IRFunction;
    type_map *int;
    type_map_count int;
    locs *IRModuleLoc;
    loc_count int;
}

// IRModule：完整、可独立消费的模块容器；所有指针均独占，自有子表由 release 递归释放。
// 只能通过增建接口创建；容量字段属于所有权边界，增建不借用前端表或进程全局状态。
pub struct IRModule {
    version int;
    target IRModuleTarget;
    sources *IRModuleSource;
    source_count int;
    source_capacity int;
    types *IRModuleType;
    type_count int;
    type_capacity int;
    symbols *IRModuleSymbol;
    symbol_count int;
    symbol_capacity int;
    globals *IRModuleGlobal;
    global_count int;
    global_capacity int;
    functions *IRModuleFunction;
    function_count int;
    function_capacity int;
}

// ir_module_str_len：有界读取 C 字符串；空指针或缺少终止符返回 -1。
fn ir_module_str_len(value *char) int {
    if (value == 0) { return -1; }
    let n int = 0;
    for n < IR_SERIAL_MAX_BYTES {
        if (value[n] == 0) { return n; }
        n += 1;
    }
    return -1;
}

// ir_module_str_eq：比较两个已终止字符串；目标/逻辑名称不接受空指针。
fn ir_module_str_eq(a *char, b *char) int {
    let n int = ir_module_str_len(a);
    if (n < 0 || n != ir_module_str_len(b)) { return 0; }
    let i int = 0;
    for i < n {
        if (a[i] != b[i]) { return 0; }
        i += 1;
    }
    return 1;
}

// ir_module_target_expected：仅查四个已锁定的静态身份，临时出参借用常量，未知 triple 失败。
fn ir_module_target_expected(triple *char, out *IRModuleTarget) int {
    out.pointer_bits = 64; out.little_endian = 1; out.layout_version = 1;
    if (ir_module_str_eq(triple, "aarch64-unknown-linux-gnu") != 0) {
        out.triple = "aarch64-unknown-linux-gnu"; out.key = 1; out.abi = "aapcs64";
        out.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32";
    } else if (ir_module_str_eq(triple, "x86_64-unknown-linux-gnu") != 0) {
        out.triple = "x86_64-unknown-linux-gnu"; out.key = 2; out.abi = "sysv-amd64";
        out.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
    } else if (ir_module_str_eq(triple, "aarch64-apple-darwin") != 0) {
        out.triple = "aarch64-apple-darwin"; out.key = 3; out.abi = "darwin-aapcs64";
        out.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32";
    } else if (ir_module_str_eq(triple, "x86_64-apple-darwin") != 0) {
        out.triple = "x86_64-apple-darwin"; out.key = 4; out.abi = "darwin-amd64";
        out.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
    } else { return -1; }
    return 0;
}

// ir_module_target_ok：核对完整元数据和规范 key，不能仅凭位宽/方言接受另一个目标。
fn ir_module_target_ok(target *IRModuleTarget) int {
    let expected IRModuleTarget;
    if (target == 0 || ir_module_target_expected(target.triple, &expected) != 0) { return 0; }
    return target.key == expected.key && target.pointer_bits == expected.pointer_bits
        && target.little_endian == expected.little_endian && target.layout_version == expected.layout_version
        && ir_module_str_eq(target.data_layout, expected.data_layout) != 0
        && ir_module_str_eq(target.abi, expected.abi) != 0;
}
