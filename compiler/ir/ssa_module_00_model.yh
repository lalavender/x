module ir

const IR_MODULE_VERSION int = 3

// ir_module_str_len：有界读取 C 字符串；空指针或缺少终止符返回 -1。
fn ir_module_str_len(value *char) int {
    if (value == 0) { return -1 }
    let n int = 0
    for n < IR_SERIAL_MAX_BYTES {
        if (value[n] == 0) { return n }
        n += 1
    }
    return -1
}

// ir_module_str_eq：比较两个已终止字符串；目标/逻辑名称不接受空指针。
fn ir_module_str_eq(a *char, b *char) int {
    let n int = ir_module_str_len(a)
    if (n < 0 || n != ir_module_str_len(b)) { return 0 }
    let i int = 0
    for i < n {
        if (a[i] != b[i]) { return 0 }
        i += 1
    }
    return 1
}

// ir_module_target_expected：仅查已锁定的静态身份（5 个），临时出参借用常量，未知 triple 失败。
// 注意：这里是**第二份**目标身份表（另一份在 gen/target_info.yh）。新增目标必须两处同时加，
// 否则 lowering 会在 ir_module_init/verifier 处静默失败（2026-10-27 W1-1 踩过）。
fn ir_module_target_expected(triple *char, out *IRModuleTarget) int {
    out.pointer_bits = 64; out.little_endian = 1; out.layout_version = 1
    if (ir_module_str_eq(triple, "aarch64-unknown-linux-gnu") != 0) {
        out.triple = "aarch64-unknown-linux-gnu"; out.key = 1; out.abi = "aapcs64"
        out.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (ir_module_str_eq(triple, "x86_64-unknown-linux-gnu") != 0) {
        out.triple = "x86_64-unknown-linux-gnu"; out.key = 2; out.abi = "sysv-amd64"
        out.data_layout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (ir_module_str_eq(triple, "aarch64-apple-darwin") != 0) {
        out.triple = "aarch64-apple-darwin"; out.key = 3; out.abi = "darwin-aapcs64"
        out.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
    } else if (ir_module_str_eq(triple, "x86_64-apple-darwin") != 0) {
        out.triple = "x86_64-apple-darwin"; out.key = 4; out.abi = "darwin-amd64"
        out.data_layout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else if (ir_module_str_eq(triple, "x86_64-pc-windows-msvc") != 0) {
        // 首版 Windows/x64：MSVC ABI + PE/COFF；data_layout 与 gen/target_info.yh 一致。
        out.triple = "x86_64-pc-windows-msvc"; out.key = 5; out.abi = "win64-msvc"
        out.data_layout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    } else { return -1 }
    return 0
}

// ir_module_target_ok：核对完整元数据和规范 key，不能仅凭位宽/方言接受另一个目标。
fn ir_module_target_ok(target *IRModuleTarget) int {
    let expected IRModuleTarget
    if (target == 0 || ir_module_target_expected(target.triple, &expected) != 0) { return 0 }
    return target.key == expected.key && target.pointer_bits == expected.pointer_bits &&
        target.little_endian == expected.little_endian && target.layout_version == expected.layout_version &&
        ir_module_str_eq(target.data_layout, expected.data_layout) != 0 &&
        ir_module_str_eq(target.abi, expected.abi) != 0
}
