module ir

// ============================================================================
// ssa_module_50_function_rebind.yh —— 函数缓存记录合并回当前模块（LA3）
//
// capture 产生一个只含单函数及贡献闭包的迷你 IRModule；本文件在命中时：
//   1. 反序列化迷你模块并核对目标/环境/函数身份；
//   2. 类型按结构复用或补建，得到 mini 类型 → 当前类型映射；
//   3. 符号按名字复用或补建，全局实体按符号与内容复用或补建；
//   4. 把函数体里的模块下标重绑为当前下标，再交给 ir_module_add_function。
//
// 返回值：0 成功；1 记录损坏/不兼容（调用方按 miss 重新 lowering）；
// -1 内部错误或分配失败（调用方停止，不把内部错误当 miss 掩盖）。
// 递归/前向类型闭包在 capture 阶段已跳过，这里只处理依赖后序的类型表。
// ============================================================================

// ir_fc_target_same：完整目标身份必须一致，不能只比 key。
fn ir_fc_target_same(a *IRModuleTarget, b *IRModuleTarget) int {
    if (a.key != b.key || a.pointer_bits != b.pointer_bits
        || a.little_endian != b.little_endian
        || a.layout_version != b.layout_version) { return 0 }
    if (ir_module_str_eq(a.triple, b.triple) == 0
        || ir_module_str_eq(a.data_layout, b.data_layout) == 0
        || ir_module_str_eq(a.abi, b.abi) == 0) { return 0 }
    return 1
}

// ir_fc_type_equiv：比较 mini 类型与当前类型；mini 依赖经 type_map 映射。
fn ir_fc_type_equiv(unit *IRModule, current int, mini *IRModule, candidate int,
    type_map *int) int {
    if (current < 0 || current >= unit.type_count || candidate < 0
        || candidate >= mini.type_count) { return 0 }
    let a IRModuleType = unit.types[current]
    let b IRModuleType = mini.types[candidate]
    if (ir_module_str_eq(a.name, b.name) == 0 || a.kind != b.kind
        || a.bits != b.bits || a.size != b.size || a.align != b.align
        || a.count != b.count || a.abi != b.abi || a.variadic != b.variadic
        || a.field_count != b.field_count) { return 0 }
    if (b.elem >= 0) {
        if (type_map[b.elem] < 0 || type_map[b.elem] != a.elem) { return 0 }
    } else if (a.elem >= 0) { return 0 }
    let i int = 0
    for i < b.field_count {
        if (type_map[b.fields[i].type_id] < 0
            || type_map[b.fields[i].type_id] != a.fields[i].type_id
            || b.fields[i].offset != a.fields[i].offset) { return 0 }
        i += 1
    }
    return 1
}

// —— PL1f2：一次合并用的目标模块索引 ——
//
// merge 原先对每条记录的每个类型都线性扫目标模块的类型表（结构等价比较），
// 对每个符号再线性扫符号表；单函数改动的 204 条记录因此是 O(记录 × 模块规模 ×
// 闭包规模)。索引把「目标模块侧」的扫描降到一次建表，之后按哈希探测、命中再
// 用原有比较函数确认，语义不变（哈希只用来缩小候选，不做最终判断）。
struct IRMergeIndex {
    symbol_slots *int // 名字哈希 → symbol+1；0 表示空
    symbol_cap int
    type_slots *int // 结构键 → type+1；0 表示空
    type_cap int
}

// ir_merge_cap：开放寻址表容量：≥ 2n 的 2 的幂，最小 8；超限返回 0。
fn ir_merge_cap(count int) int {
    let cap int = 8
    for cap < count * 2 {
        if (cap > 1073741824) { return 0 }
        cap *= 2
    }
    return cap
}

// ir_fc_key_u64：把 64 位值并入结构键（FNV-1a）。
fn ir_fc_key_u64(state u64, value u64) u64 {
    return (state ^ value) * IR_MODULE_FNV_PRIME
}

// ir_fc_key_text：把名字并入结构键；失败时保持原状态（保守退化）。
fn ir_fc_key_text(state u64, text *char) u64 {
    let h u64 = 0
    if (ir_module_fnv_text(state, text, &h) != 0) { return state }
    return h
}

// ir_fc_target_type_key：目标类型自身的结构键。字段与等价比较覆盖的范围一致：
// 名字、kind/bits/size/align/count/abi/variadic、field_count、elem、字段(类型,偏移)。
fn ir_fc_target_type_key(unit *IRModule, index int) u64 {
    let t IRModuleType = unit.types[index]
    let h u64 = IR_MODULE_FNV_BASIS
    h = ir_fc_key_text(h, t.name)
    h = ir_fc_key_u64(h, t.kind.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.bits.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.size.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.align.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.count.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.abi.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.variadic.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, (t.elem + 1).to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.field_count.to_type(i64).to_type(u64))
    let fi int = 0
    for fi < t.field_count {
        h = ir_fc_key_u64(h, t.fields[fi].type_id.to_type(i64).to_type(u64))
        h = ir_fc_key_u64(h, t.fields[fi].offset.to_type(i64).to_type(u64))
        fi += 1
    }
    return h
}

// ir_fc_mini_type_key：迷你类型的结构键——依赖项先经 type_map 映射成目标下标，
// 这样键与目标类型的键同构。有未映射依赖时返回 -1（调用方退化为线性扫描）。
fn ir_fc_mini_type_key(mini *IRModule, candidate int, type_map *int,
    out *u64) int {
    if (out == 0 || candidate < 0 || candidate >= mini.type_count) { return -1 }
    let t IRModuleType = mini.types[candidate]
    let h u64 = IR_MODULE_FNV_BASIS
    h = ir_fc_key_text(h, t.name)
    h = ir_fc_key_u64(h, t.kind.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.bits.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.size.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.align.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.count.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.abi.to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.variadic.to_type(i64).to_type(u64))
    let elem int = t.elem
    if (elem >= 0) {
        if (elem >= mini.type_count || type_map[elem] < 0) { return -1 }
        elem = type_map[elem]
    }
    h = ir_fc_key_u64(h, (elem + 1).to_type(i64).to_type(u64))
    h = ir_fc_key_u64(h, t.field_count.to_type(i64).to_type(u64))
    let fi int = 0
    for fi < t.field_count {
        let field_type int = t.fields[fi].type_id
        if (field_type < 0 || field_type >= mini.type_count
            || type_map[field_type] < 0) { return -1 }
        h = ir_fc_key_u64(h, type_map[field_type].to_type(i64).to_type(u64))
        h = ir_fc_key_u64(h, t.fields[fi].offset.to_type(i64).to_type(u64))
        fi += 1
    }
    out[0] = h
    return 0
}

// ir_merge_index_open：为目标模块建符号/类型索引；规模太小则保持关闭（cap=0）。
fn ir_merge_index_open(idx *IRMergeIndex, unit *IRModule) int {
    idx.symbol_slots = 0; idx.symbol_cap = 0
    idx.type_slots = 0; idx.type_cap = 0
    if (unit.symbol_count + unit.type_count <= 64) { return 0 }
    let cap int = ir_merge_cap(unit.symbol_count)
    if (cap == 0) { return -1 }
    idx.symbol_cap = cap
    idx.symbol_slots = malloc((cap * sizeof(int)).to_type(u64)).to_type(*int)
    if (idx.symbol_slots == 0) { return -1 }
    let i int = 0
    for i < cap { idx.symbol_slots[i] = 0; i += 1 }
    let mask u64 = (cap - 1).to_type(u64)
    i = 0
    for i < unit.symbol_count {
        let h u64 = 0
        if (ir_module_fnv_text(IR_MODULE_FNV_BASIS, unit.symbols[i].name, &h) != 0) {
            return -1
        }
        let pos u64 = h & mask
        let placed int = 0
        for placed == 0 {
            if (idx.symbol_slots[pos.to_type(int)] == 0) {
                idx.symbol_slots[pos.to_type(int)] = i + 1
                placed = 1
            } else {
                pos = (pos + 1) & mask
            }
        }
        i += 1
    }
    cap = ir_merge_cap(unit.type_count)
    if (cap == 0) { return -1 }
    idx.type_cap = cap
    idx.type_slots = malloc((cap * sizeof(int)).to_type(u64)).to_type(*int)
    if (idx.type_slots == 0) { return -1 }
    i = 0
    for i < cap { idx.type_slots[i] = 0; i += 1 }
    let tmask u64 = (cap - 1).to_type(u64)
    i = 0
    for i < unit.type_count {
        let h u64 = ir_fc_target_type_key(unit, i)
        let pos u64 = h & tmask
        let placed int = 0
        for placed == 0 {
            if (idx.type_slots[pos.to_type(int)] == 0) {
                idx.type_slots[pos.to_type(int)] = i + 1
                placed = 1
            } else {
                pos = (pos + 1) & tmask
            }
        }
        i += 1
    }
    return 0
}

// ir_merge_index_close：释放索引；对未打开（cap=0）的索引安全。
fn ir_merge_index_close(idx *IRMergeIndex) void {
    if (idx.symbol_slots != 0) { free(idx.symbol_slots.to_type(*void)) }
    if (idx.type_slots != 0) { free(idx.type_slots.to_type(*void)) }
    idx.symbol_slots = 0; idx.symbol_cap = 0
    idx.type_slots = 0; idx.type_cap = 0
}

// ir_fc_find_type：在模块类型表中查找结构等价的类型；找不到返回 -1。
fn ir_fc_find_type(unit *IRModule, mini *IRModule, candidate int,
    type_map *int) int {
    let i int = 0
    for i < unit.type_count {
        if (ir_fc_type_equiv(unit, i, mini, candidate, type_map) != 0) { return i }
        i += 1
    }
    return -1
}

// ir_fc_index_find_type：走索引的类型查找；键不可算（依赖未映射）时退化为线性。
// 命中仍用 ir_fc_type_equiv 确认，索引只缩小候选范围。
fn ir_fc_index_find_type(idx *IRMergeIndex, unit *IRModule, mini *IRModule,
    candidate int, type_map *int) int {
    if (idx.type_cap == 0) {
        return ir_fc_find_type(unit, mini, candidate, type_map)
    }
    let key u64 = 0
    if (ir_fc_mini_type_key(mini, candidate, type_map, &key) != 0) {
        return ir_fc_find_type(unit, mini, candidate, type_map)
    }
    let mask u64 = (idx.type_cap - 1).to_type(u64)
    let pos u64 = key & mask
    let probe int = 0
    for probe < idx.type_cap {
        let slot int = idx.type_slots[pos.to_type(int)]
        if (slot == 0) { return -1 }
        if (ir_fc_type_equiv(unit, slot - 1, mini, candidate, type_map) != 0) {
            return slot - 1
        }
        pos = (pos + 1) & mask
        probe += 1
    }
    return -1
}

// ir_fc_index_find_symbol：走索引的符号名查找；索引关闭时退化为线性。
fn ir_fc_index_find_symbol(idx *IRMergeIndex, unit *IRModule, name *char) int {
    if (idx.symbol_cap == 0) { return ir_fc_find_symbol_name(unit, name) }
    let h u64 = 0
    if (ir_module_fnv_text(IR_MODULE_FNV_BASIS, name, &h) != 0) {
        return ir_fc_find_symbol_name(unit, name)
    }
    let mask u64 = (idx.symbol_cap - 1).to_type(u64)
    let pos u64 = h & mask
    let probe int = 0
    for probe < idx.symbol_cap {
        let slot int = idx.symbol_slots[pos.to_type(int)]
        if (slot == 0) { return -1 }
        if (ir_module_str_eq(unit.symbols[slot - 1].name, name) != 0) {
            return slot - 1
        }
        pos = (pos + 1) & mask
        probe += 1
    }
    return -1
}

// ir_fc_find_symbol_name：按名字查找当前模块符号；找不到返回 -1。
fn ir_fc_find_symbol_name(unit *IRModule, name *char) int {
    let i int = 0
    for i < unit.symbol_count {
        if (ir_module_str_eq(unit.symbols[i].name, name) != 0) { return i }
        i += 1
    }
    return -1
}

// ir_fc_find_global：按符号查找当前模块全局实体；找不到返回 -1。
fn ir_fc_find_global(unit *IRModule, symbol int) int {
    let i int = 0
    for i < unit.global_count {
        if (unit.globals[i].symbol == symbol) { return i }
        i += 1
    }
    return -1
}

// ir_fc_symbol_compatible：比较 mini 符号与当前同名符号；声明可以合并到定义。
fn ir_fc_symbol_compatible(unit *IRModule, current int, mini *IRModule,
    candidate int, type_map *int) int {
    if (current < 0 || current >= unit.symbol_count || candidate < 0
        || candidate >= mini.symbol_count) { return 0 }
    let a IRModuleSymbol = unit.symbols[current]
    let b IRModuleSymbol = mini.symbols[candidate]
    if (a.kind != b.kind || a.abi != b.abi || a.variadic != b.variadic
        || a.no_return != b.no_return || a.mutable != b.mutable
        || a.param_count != b.param_count) { return 0 }
    // 签名类型按结构比较而非编号：当前模块可能有多个结构等价但编号不同的类型
    // （聚合类型不去重），用编号比较会把合法记录误判为不兼容（实测 compiler/gen
    // 201 个函数中有 61 个因此 miss）。
    if (type_map[b.type_id] < 0) { return 0 }
    if (type_map[b.type_id] != a.type_id
        && ir_fc_type_equiv(unit, a.type_id, mini, b.type_id, type_map) == 0) {
        return 0
    }
    let i int = 0
    for i < b.param_count {
        if (type_map[b.params[i]] < 0) { return 0 }
        if (type_map[b.params[i]] != a.params[i]
            && ir_fc_type_equiv(unit, a.params[i], mini, b.params[i],
                type_map) == 0) {
            return 0
        }
        i += 1
    }
    // mini 的声明（defined=0）可以合并到当前定义；mini 的定义必须能在当前找到定义，
    // 但函数定义只能由当前函数体提交，其他函数在 capture 时已降为声明。
    if (b.defined != 0) {
        if (a.defined == 0 && b.kind == IR_MODULE_SYMBOL_FUNCTION) { return 0 }
        if (a.defined != 0 && a.linkage != b.linkage) { return 0 }
    }
    return 1
}

// ir_fc_global_equiv：比较已有全局实体与新记录的数据/对齐/重定位闭包。
fn ir_fc_global_equiv(unit *IRModule, current int, mini *IRModule,
    candidate int, symbol_map *int) int {
    let a IRModuleGlobal = unit.globals[current]
    let b IRModuleGlobal = mini.globals[candidate]
    if (a.size != b.size || a.align != b.align || a.reloc_count != b.reloc_count) {
        return 0
    }
    let i int = 0
    for i < b.size {
        if (a.data[i] != b.data[i]) { return 0 }
        i += 1
    }
    i = 0
    for i < b.reloc_count {
        let x IRModuleReloc = a.relocs[i]
        let y IRModuleReloc = b.relocs[i]
        if (x.offset != y.offset || x.width != y.width || x.addend != y.addend
            || symbol_map[y.symbol] < 0 || symbol_map[y.symbol] != x.symbol) {
            return 0
        }
        i += 1
    }
    return 1
}

