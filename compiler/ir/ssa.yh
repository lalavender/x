module ir

// ============================================================================
// ssa.yh —— yh 首版 typed SSA 的数据模型与基础结构校验
//
// 这里先定义目标隔离的函数级 SSA 单元，供后续 CheckedFunction 转换和后端
// 消费。数组由构造阶段批量分配，节点间只存整数 ID，避免逐节点堆分配。
// 本版校验值定义、类型、基本块范围、终结指令、phi 前驱集合及可达块的
// SSA 支配关系；完整指令类型/副作用规则将在 SSA 构造器接入时扩充。
// 此模块不依赖 gen 或平台代码。
// ============================================================================

// ir_type_ok：确认类型索引在函数私有类型表内，且指针元素引用有效。
fn ir_type_ok(f *IRFunction, tid int) int {
    if (tid < 0 || tid >= f.type_count || f.types == 0) {
        return 0
    }
    let t IRType = f.types[tid]
    if (t.kind < IR_TY_VOID || t.kind > IR_TY_LAST) {
        return 0
    }
    if (t.kind == IR_TY_FN_PTR) {
        return t.bits == 64 && t.elem == -1
    }
    if (t.kind == IR_TY_VOID) {
        return t.bits == 0 && t.elem == -1
    }
    if (t.kind == IR_TY_PTR) {
        // 通用指针（含旧 SSA 路径的 *元素 编码）只要求元素引用有效。
        return t.elem >= 0 && t.elem < f.type_count && t.elem != tid && t.bits > 0
    }
    if (t.kind > IR_TY_PTR && t.kind <= IR_TY_PTR_LAST) {
        // canonical 指针：elem 必须等于 kind 减 IR_TY_PTR。
        return t.elem == t.kind - IR_TY_PTR && t.elem >= 0 && t.elem < f.type_count &&
            t.bits > 0
    }
    if (t.elem != -1) {
        return 0
    }
    if (t.kind == IR_TY_I8 || t.kind == IR_TY_U8) { return t.bits == 8 }
    if (t.kind == IR_TY_I16 || t.kind == IR_TY_U16) { return t.bits == 16 }
    if (t.kind == IR_TY_I32 || t.kind == IR_TY_U32 || t.kind == IR_TY_F32) { return t.bits == 32 }
    if (t.kind == IR_TY_I64 || t.kind == IR_TY_U64 || t.kind == IR_TY_F64) { return t.bits == 64 }
    // 源 bool 是无符号字节值；条件/逻辑结果单独归一为 0/1，不能丢弃显式转换的高位。
    if (t.kind == IR_TY_BOOL) { return t.bits == 8 }
    return 0
}

// ir_is_pred：判断 from 是否通过任一终结边到达 to。
fn ir_is_pred(f *IRFunction, from int, to int) int {
    let b IRBlock = f.blocks[from]
    return b.succ0 == to || b.succ1 == to
}

// ir_verify_inst：校验单条指令的编码、结果定义与输入值是否存在。
fn ir_verify_inst(f *IRFunction, inst *IRInst, saw_non_phi int) int {
    let has_result int = inst.op != IR_OP_STORE && inst.op != IR_OP_MEMCPY &&
        inst.op != IR_OP_MEMSET &&
        (inst.op != IR_OP_CALL || inst.result_id >= 0)
    if (inst.op < IR_OP_CONST || inst.op > IR_OP_MEMSET) {
        return -1
    }
    if (inst.op != IR_OP_CONST && inst.op != IR_OP_PARAM && inst.op != IR_OP_ADDR
        && inst.op != IR_OP_ALLOCA && inst.op != IR_OP_GEP && inst.op != IR_OP_MEMCPY
        && inst.op != IR_OP_MEMSET
        && inst.op != IR_OP_GLOB_ADDR && inst.op != IR_OP_FN_ADDR && inst.imm != 0) {
        return -1
    }
    if (inst.op == IR_OP_PHI && saw_non_phi != 0) {
        return -1
    }
    if (has_result != 0) {
        if (inst.result_id < 0 || inst.result_id >= f.value_count || ir_type_ok(f, inst.result_type) == 0
            || f.types[inst.result_type].kind == IR_TY_VOID) {
            return -1
        }
        if (ir_find_value_type(f, inst.result_id) != inst.result_type) {
            return -1
        }
    } else if (inst.result_id != -1 || inst.result_type != -1) {
        return -1
    }
    if (inst.op == IR_OP_CONST) {
        return inst.a == -1 && inst.b == -1 && inst.aux == -1 ? 0 : -1
    }
    if (inst.op == IR_OP_PARAM) {
        return inst.imm >= 0 && inst.a == -1 && inst.b == -1 && inst.aux == -1 ? 0 : -1
    }
    if (inst.op == IR_OP_ADDR) {
        // 绑定 ID 必须非负；结果已验证为 canonical 指针（禁止 void 分配）。
        if (inst.imm < 0 || inst.a != -1 || inst.b != -1 || inst.aux != -1) { return -1 }
        return 0
    }
    if (inst.op == IR_OP_ALLOCA) {
        // 字节数与对齐必须为正；结果只要求是指针（元素可为 void）。
        if (inst.imm <= 0 || inst.aux <= 0 || inst.a != -1 || inst.b != -1) { return -1 }
        return f.types[inst.result_type].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_GEP) {
        // 基指针必须存在；动态偏移必须是 u64 值，常量偏移必须非负。
        if (inst.a < 0 || inst.aux != -1) { return -1 }
        let base_type int = ir_find_value_type(f, inst.a)
        if (base_type < 0 || f.types[base_type].kind < IR_TY_PTR) { return -1 }
        if (inst.b >= 0) {
            return ir_find_value_type(f, inst.b) == IR_TY_U64 ? 0 : -1
        }
        return inst.imm >= 0 ? 0 : -1
    }
    if (inst.op == IR_OP_MEMCPY) {
        // 两个指针与正字节数；无结果（has_result 已保证 result_id/type 为 -1）。
        if (inst.imm <= 0 || inst.aux != -1 || inst.a < 0 || inst.b < 0) { return -1 }
        let at int = ir_find_value_type(f, inst.a)
        let bt int = ir_find_value_type(f, inst.b)
        if (at < 0 || bt < 0 || f.types[at].kind < IR_TY_PTR || f.types[bt].kind < IR_TY_PTR) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_MEMSET) {
        // 默认初始化只允许清零真实存储区，长度必须为正且没有源指针。
        if (inst.imm <= 0 || inst.aux != -1 || inst.a < 0 || inst.b != -1) { return -1 }
        let at int = ir_find_value_type(f, inst.a)
        return at >= 0 && f.types[at].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_GLOB_ADDR) {
        // 模块符号下标必须非负（种类由模块 verifier 核对）；结果只要求是指针。
        if (inst.imm < 0 || inst.a != -1 || inst.b != -1 || inst.aux != -1) { return -1 }
        return f.types[inst.result_type].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_FN_ADDR) {
        return inst.imm >= 0 && inst.aux >= 0 && inst.a == -1 && inst.b == -1 &&
            f.types[inst.result_type].kind == IR_TY_FN_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_FNEG) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1
            || inst.result_type != ir_find_value_type(f, inst.a)) { return -1 }
        return ir_float_type(f.types[inst.result_type].kind) != 0 ? 0 : -1
    }
    if (inst.op == IR_OP_CALL) {
        if (inst.a != -1 || inst.b != -1 || inst.aux < 0 || inst.aux >= f.call_count) {
            return -1
        }
        if (has_result == 0 && (inst.result_id != -1 || inst.result_type != -1)) {
            return -1
        }
        return ir_verify_call(f, inst)
    }
    if (inst.op == IR_OP_COPY) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1
            || ir_find_value_type(f, inst.a) != inst.result_type) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_CAST) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1) { return -1 }
        let source_type int = ir_find_value_type(f, inst.a)
        if (source_type < 0) { return -1 }
        let from_kind int = f.types[source_type].kind
        let to_kind int = f.types[inst.result_type].kind
        let from_ptr int = ((from_kind >= IR_TY_PTR && from_kind <= IR_TY_PTR_LAST)
            || from_kind == IR_TY_FN_PTR).to_type(int)
        let to_ptr int = ((to_kind >= IR_TY_PTR && to_kind <= IR_TY_PTR_LAST)
            || to_kind == IR_TY_FN_PTR).to_type(int)
        if (from_ptr != 0 && to_ptr != 0
            || from_ptr != 0 && ir_integer_type(to_kind) != 0
            || to_ptr != 0 && ir_integer_type(from_kind) != 0) { return 0 }
        return ir_scalar_type(from_kind) != 0 && ir_scalar_type(to_kind) != 0 ? 0 : -1
    }
    if (inst.op == IR_OP_PHI) {
        if (inst.a != -1 || inst.b != -1 || inst.aux < 0 || inst.aux >= f.phi_count) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_STORE) {
        if (inst.aux != -1 || ir_find_value_type(f, inst.a) < 0 || ir_find_value_type(f, inst.b) < 0) {
            return -1
        }
        let at int = ir_find_value_type(f, inst.a)
        let bt int = ir_find_value_type(f, inst.b)
        if (f.types[at].kind < IR_TY_PTR
            || f.types[at].elem != bt && !(f.types[at].elem == IR_TY_VOID
                && f.types[bt].kind == IR_TY_FN_PTR)) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_LOAD) {
        if (inst.b != -1 || inst.aux != -1) {
            return -1
        }
        let at int = ir_find_value_type(f, inst.a)
        if (at < 0 || f.types[at].kind < IR_TY_PTR
            || f.types[at].elem != inst.result_type && !(f.types[at].elem == IR_TY_VOID
                && f.types[inst.result_type].kind == IR_TY_FN_PTR)) {
            return -1
        }
        return 0
    }
    if (inst.aux != -1) {
        return -1
    }
    let at2 int = ir_find_value_type(f, inst.a)
    let bt2 int = ir_find_value_type(f, inst.b)
    if (at2 < 0 || bt2 < 0 || at2 != bt2) {
        return -1
    }
    if (inst.op == IR_OP_EQ || inst.op == IR_OP_NE
        || inst.op == IR_OP_LT || inst.op == IR_OP_LE
        || inst.op == IR_OP_GT || inst.op == IR_OP_GE) {
        if (f.types[inst.result_type].kind != IR_TY_BOOL) {
            return -1
        }
        if (inst.op != IR_OP_EQ && inst.op != IR_OP_NE) {
            let operand_kind int = f.types[at2].kind
            if (ir_integer_type(operand_kind) == 0 && ir_float_type(operand_kind) == 0) {
                return -1
            }
        }
        return 0
    }
    if (at2 != inst.result_type || f.types[at2].kind == IR_TY_PTR
        || f.types[at2].kind == IR_TY_VOID || f.types[at2].kind == IR_TY_BOOL) {
        return -1
    }
    let operand_kind int = f.types[at2].kind
    if (ir_float_type(operand_kind) != 0) {
        // IEEE 浮点只允许基础算术；位运算、余数和移位仍是整数专属操作。
        return inst.op == IR_OP_ADD || inst.op == IR_OP_SUB ||
            inst.op == IR_OP_MUL || inst.op == IR_OP_DIV ? 0 : -1
    }
    return ir_integer_type(operand_kind) != 0 ? 0 : -1
}

// ir_verify_phi：要求 phi 对每个 CFG 前驱恰有一个同类型输入。
fn ir_verify_phi(f *IRFunction, block_id int, inst *IRInst) int {
    let phi IRPhi = f.phis[inst.aux]
    if (phi.first < 0 || phi.count < 0 || phi.first + phi.count > f.phi_input_count
        || f.phi_inputs == 0 && phi.count > 0) {
        return -1
    }
    let pred_count int = 0
    let p int = 0
    for p < f.block_count {
        if (ir_is_pred(f, p, block_id) != 0) {
            pred_count += 1
        }
        p += 1
    }
    if (pred_count != phi.count) {
        return -1
    }
    let i int = 0
    for i < phi.count {
        let input IRPhiInput = f.phi_inputs[phi.first + i]
        if (input.pred < 0 || input.pred >= f.block_count || ir_is_pred(f, input.pred, block_id) == 0
            || ir_find_value_type(f, input.value) != inst.result_type) {
            return -1
        }
        let j int = i + 1
        for j < phi.count {
            if (f.phi_inputs[phi.first + j].pred == input.pred) {
                return -1
            }
            j += 1
        }
        i += 1
    }
    return 0
}

// ir_verify_term：检查终结形式、边界和返回值类型。
fn ir_verify_term(f *IRFunction, b *IRBlock) int {
    if (b.term == IR_TERM_BR) {
        return b.term_value == -1 && b.succ0 >= 0 && b.succ0 < f.block_count && b.succ1 == -1 ? 0 : -1
    }
    if (b.term == IR_TERM_COND_BR) {
        if (b.succ0 < 0 || b.succ0 >= f.block_count || b.succ1 < 0 || b.succ1 >= f.block_count
            || b.succ0 == b.succ1) {
            return -1
        }
        let ct int = ir_find_value_type(f, b.term_value)
        if (ct < 0 || f.types[ct].kind != IR_TY_BOOL) {
            return -1
        }
        return 0
    }
    if (b.term == IR_TERM_RET) {
        if (b.succ0 != -1 || b.succ1 != -1) {
            return -1
        }
        if (f.types[f.ret_type].kind == IR_TY_VOID) {
            return b.term_value == -1 ? 0 : -1
        }
        return ir_find_value_type(f, b.term_value) == f.ret_type ? 0 : -1
    }
    if (b.term == IR_TERM_UNREACHABLE) {
        return b.term_value == -1 && b.succ0 == -1 && b.succ1 == -1 ? 0 : -1
    }
    return -1
}

// ir_find_value_position：查找值定义所在的基本块与块内指令下标。
// 调用方须先完成指令范围和结果 ID 唯一性检查。
fn ir_find_value_position(f *IRFunction, value int, block_out *int, inst_out *int) int {
    if (f == 0 || block_out == 0 || inst_out == 0 || value < 0) {
        return -1
    }
    let found int = 0
    let b int = 0
    for b < f.block_count {
        let block IRBlock = f.blocks[b]
        let j int = 0
        for j < block.inst_count {
            let index int = block.first_inst + j
            if (f.insts[index].result_id == value) {
                if (found != 0) {
                    return -1
                }
                *block_out = b
                *inst_out = j
                found = 1
            }
            j += 1
        }
        b += 1
    }
    return found != 0 ? 0 : -1
}

// ir_use_dominates：确认定义在普通指令位置或 phi 边上可用。
// phi 的 use 点是对应前驱块末尾；普通终结 use 的 inst_index 等于块指令数。
fn ir_use_dominates(f *IRFunction, value int, use_block int, inst_index int, edge_pred int,
    dom *u8, reachable *u8) int {
    let def_block int = -1
    let def_inst int = -1
    if (ir_find_value_position(f, value, &def_block, &def_inst) != 0) {
        return 0
    }
    if (edge_pred >= 0) {
        if (def_block == edge_pred || reachable[edge_pred] == 0) {
            return 1
        }
        if (reachable[def_block] == 0) {
            return 0
        }
        return dom[edge_pred * f.block_count + def_block] != 0 ? 1 : 0
    }
    if (def_block == use_block) {
        return def_inst < inst_index ? 1 : 0
    }
    if (reachable[use_block] == 0) {
        return 1
    }
    if (reachable[def_block] == 0) {
        return 0
    }
    return dom[use_block * f.block_count + def_block] != 0 ? 1 : 0
}

// ir_verify_dominance：计算入口可达块的支配矩阵并检查所有 SSA use。
// 不可达块不影响可执行路径；其跨块 use 只做定义存在与类型检查。
fn ir_verify_dominance(f *IRFunction) int {
    let n int = f.block_count
    let reachable *u8 = malloc(n.to_type(u64)).to_type(*u8)
    let queue *int = malloc((n * sizeof(int)).to_type(u64)).to_type(*int)
    let dom *u8 = malloc((n * n).to_type(u64)).to_type(*u8)
    let row *u8 = malloc(n.to_type(u64)).to_type(*u8)
    if (reachable == 0 || queue == 0 || dom == 0 || row == 0) {
        if (reachable != 0) { free(reachable) }
        if (queue != 0) { free(queue) }
        if (dom != 0) { free(dom) }
        if (row != 0) { free(row) }
        return -1
    }
    let i int = 0
    for i < n {
        reachable[i] = 0
        i += 1
    }
    reachable[0] = 1
    queue[0] = 0
    let head int = 0
    let tail int = 1
    for head < tail {
        let current int = queue[head]
        let block IRBlock = f.blocks[current]
        if (block.succ0 >= 0 && reachable[block.succ0] == 0) {
            reachable[block.succ0] = 1
            queue[tail] = block.succ0
            tail += 1
        }
        if (block.succ1 >= 0 && reachable[block.succ1] == 0) {
            reachable[block.succ1] = 1
            queue[tail] = block.succ1
            tail += 1
        }
        head += 1
    }
    let b int = 0
    for b < n {
        let d int = 0
        for d < n {
            dom[b * n + d] = reachable[d]
            d += 1
        }
        if (reachable[b] == 0) {
            let z int = 0
            for z < n {
                dom[b * n + z] = 0
                z += 1
            }
            dom[b * n + b] = 1
        }
        b += 1
    }
    let entry_col int = 0
    for entry_col < n {
        dom[entry_col] = 0
        entry_col += 1
    }
    dom[0] = 1
    let changed int = 1
    for changed != 0 {
        changed = 0
        let block_id int = 1
        for block_id < n {
            if (reachable[block_id] != 0) {
                let d2 int = 0
                for d2 < n {
                    row[d2] = reachable[d2]
                    d2 += 1
                }
                let pred int = 0
                for pred < n {
                    if (reachable[pred] != 0 && ir_is_pred(f, pred, block_id) != 0) {
                        let col int = 0
                        for col < n {
                            if (dom[pred * n + col] == 0) {
                                row[col] = 0
                            }
                            col += 1
                        }
                    }
                    pred += 1
                }
                row[block_id] = 1
                let col2 int = 0
                for col2 < n {
                    if (dom[block_id * n + col2] != row[col2]) {
                        dom[block_id * n + col2] = row[col2]
                        changed = 1
                    }
                    col2 += 1
                }
            }
            block_id += 1
        }
    }
    let valid int = 1
    let use_block int = 0
    for use_block < n && valid != 0 {
        let block IRBlock = f.blocks[use_block]
        let j int = 0
        for j < block.inst_count && valid != 0 {
            let inst IRInst = f.insts[block.first_inst + j]
            if (inst.op == IR_OP_PHI) {
                let phi IRPhi = f.phis[inst.aux]
                let k int = 0
                for k < phi.count && valid != 0 {
                    let input IRPhiInput = f.phi_inputs[phi.first + k]
                    if (ir_use_dominates(f, input.value, use_block, j, input.pred, dom, reachable) == 0) {
                        valid = 0
                    }
                    k += 1
                }
            } else {
                if (inst.a >= 0 && ir_use_dominates(f, inst.a, use_block, j, -1, dom, reachable) == 0) {
                    valid = 0
                }
                if (inst.b >= 0 && ir_use_dominates(f, inst.b, use_block, j, -1, dom, reachable) == 0) {
                    valid = 0
                }
                if (inst.op == IR_OP_CALL) {
                    let call IRCall = f.calls[inst.aux]
                    if (call.callee_value >= 0
                        && ir_use_dominates(f, call.callee_value, use_block, j, -1, dom, reachable) == 0) {
                        valid = 0
                    }
                    let arg int = 0
                    for arg < call.arg_count && valid != 0 {
                        let value int = f.call_args[call.arg_first + arg].value
                        if (ir_use_dominates(f, value, use_block, j, -1, dom, reachable) == 0) {
                            valid = 0
                        }
                        arg += 1
                    }
                }
            }
            j += 1
        }
        if (block.term_value >= 0
            && ir_use_dominates(f, block.term_value, use_block, block.inst_count, -1, dom, reachable) == 0) {
            valid = 0
        }
        use_block += 1
    }
    free(reachable)
    free(queue)
    free(dom)
    free(row)
    return valid != 0 ? 0 : -1
}

