module ir

// ============================================================================
// ssa.yh —— yh 首版 typed SSA 的数据模型与基础结构校验
//
// 这里先定义目标隔离的函数级 SSA 单元，供后续 CheckedFunction 转换和后端
// 消费。数组由构造阶段批量分配，节点间只存整数 ID，避免逐节点堆分配。
// 本版校验值定义、类型、基本块范围、终结指令、phi 前驱集合及可达块的
// SSA 支配关系；完整指令类型/副作用规则将在 SSA 构造器接入时扩充。
// 此模块不依赖 gen 或平台代码。
// ============================================================================

// IR 数据类型种类。type_id 是函数私有 types 表中的索引，不是目标寄存器。
pub const IR_TY_VOID int = 0
pub const IR_TY_BOOL int = 1
pub const IR_TY_I8 int = 2
pub const IR_TY_I16 int = 3
pub const IR_TY_I32 int = 4
pub const IR_TY_I64 int = 5
pub const IR_TY_U8 int = 6
pub const IR_TY_U16 int = 7
pub const IR_TY_U32 int = 8
pub const IR_TY_U64 int = 9
pub const IR_TY_F32 int = 10
pub const IR_TY_F64 int = 11
pub const IR_TY_PTR int = 12
// 指针类型按所指元素编码：canonical 下标 = IR_TY_PTR + 元素 kind，
// elem 必须等于下标减 IR_TY_PTR；IR_TY_PTR（12）即 *void。
// 指针区间同时容纳受检源指针和其存储地址类型，支持最多四层源指针的寻址。
pub const IR_TY_PTR_LAST int = 72
// 函数值在 SSA 中也是 opaque ptr，但单独编号以便类型映射不混淆数据指针。
pub const IR_TY_FN_PTR int = 73
pub const IR_TY_LAST int = 73

// 指令种类。参数由入口块前导 PARAM 定义；控制流只放在 IRBlock 的终结字段中。
pub const IR_OP_CONST int = 1
pub const IR_OP_ADD int = 2
pub const IR_OP_SUB int = 3
pub const IR_OP_MUL int = 4
pub const IR_OP_EQ int = 5
pub const IR_OP_PHI int = 6
pub const IR_OP_LOAD int = 7
pub const IR_OP_STORE int = 8
pub const IR_OP_COPY int = 9
pub const IR_OP_PARAM int = 10
pub const IR_OP_NE int = 11
pub const IR_OP_LT int = 12
pub const IR_OP_LE int = 13
pub const IR_OP_GT int = 14
pub const IR_OP_GE int = 15
pub const IR_OP_DIV int = 16
pub const IR_OP_REM int = 17
pub const IR_OP_BAND int = 18
pub const IR_OP_BOR int = 19
pub const IR_OP_BXOR int = 20
pub const IR_OP_SHL int = 21
pub const IR_OP_SHR int = 22
pub const IR_OP_CALL int = 23
pub const IR_OP_CAST int = 24
// 局部存储取址：imm 是函数内稳定绑定 ID，结果是指向绑定类型的 canonical 指针。
// 每个绑定在入口块只发一条；LLVM 后端把它降为 alloca。
pub const IR_OP_ADDR int = 25
// ALLOCA：按字节分配局部存储（imm=字节数，aux=对齐，均必须为正）；结果是指针。
// 语义是「本函数调用内可复用的常量大小临时槽」：后端把全函数的 ALLOCA 统一
// 提到入口块只发一次，因此 lowering 不得用它表达按迭代/按分支增长的存储。
pub const IR_OP_ALLOCA int = 26
// GEP：基址加字节偏移（a=基指针；b=动态偏移 u64 值，b<0 时用常量 imm）；结果是指针。
pub const IR_OP_GEP int = 27
// MEMCPY：编译器聚合副本，按字节复制并允许重叠（memmove 语义）；
// a=目的指针，b=源指针，imm=字节数，无结果；区别于用户显式 memcpy。
pub const IR_OP_MEMCPY int = 28
// GLOB_ADDR：模块全局对象取址（imm=模块符号下标，函数私有 verifier 只查非负，
// 符号种类/定义状态由模块 verifier 封闭）；结果是指针。
pub const IR_OP_GLOB_ADDR int = 29
// FN_ADDR：模块函数取址（imm=模块符号下标，aux=其完整函数类型模块下标）。
pub const IR_OP_FN_ADDR int = 30
// FNEG：按 IEEE 位级符号翻转浮点值，必须保留正负零和 NaN payload。
pub const IR_OP_FNEG int = 31
// MEMSET：默认初始化的局部存储按字节清零；a=目的指针，imm=正字节数。
pub const IR_OP_MEMSET int = 32

// 基本块终结种类。每个块恰有一个终结操作。
pub const IR_TERM_BR int = 1
pub const IR_TERM_COND_BR int = 2
pub const IR_TERM_RET int = 3
pub const IR_TERM_UNREACHABLE int = 4

// SSA 类型定义，ptr 的 elem 是所指元素的类型索引，其余类型 elem 必须为 -1。
pub struct IRType {
    kind int       // IR_TY_* 类型种类
    elem int       // 指针指向类型；非指针类型为 -1
    bits int       // 有效位宽，供目标数据模型解释
}

// 普通 SSA 指令。结果指令给 result_id/result_type，store 使用 -1 表示无结果。
pub struct IRInst {
    op int             // IR_OP_* 指令种类
    result_id int      // 定义的 SSA 值编号；无结果时为 -1
    result_type int    // 结果类型索引；无结果时为 -1
    a int              // 第一输入值编号；该指令不使用时为 -1
    b int              // 第二输入值编号；该指令不使用时为 -1
    imm i64            // CONST 位型、PARAM 序号、ALLOCA/GEP/MEMCPY/MEMSET 的大小或偏移
    aux int            // PHI 的输入表索引或 CALL 的调用表索引；其他指令为 -1
}

// phi 的一条边输入，以前驱块和值编号组成。
pub struct IRPhiInput {
    pred int           // 提供该值的 CFG 前驱块
    value int          // 在前驱边上取得的 SSA 值编号
}

// phi 输入片段。每个 phi 独占一段连续输入。
pub struct IRPhi {
    first int          // inputs 表的起始下标
    count int          // 前驱输入数
}

// 直接调用的稳定目标与变长实参片段；符号名已包含目标平台前缀和模块限定。
pub struct IRCall {
    abi int            // 0=yh、1=C；固定参数调用约定必须显式保存
    callee_value int   // -1 表示直接符号调用，否则是间接调用的函数值 SSA 编号
    signature_type int // 间接调用的模块 FUNCTION 类型下标；直接调用为 -1
    symbol_first int   // IRFunction.call_symbols 的起始字节
    symbol_len int     // 完整汇编符号名长度，不含结尾零字节
    arg_first int      // IRFunction.call_args 的起始下标
    arg_count int      // 实参数量，源码顺序与 ABI 传参顺序一致
}

// 调用实参的 SSA 值和已检查类型；verifier 同时检查定义与类型一致。
pub struct IRCallArg {
    value int          // 调用点之前定义的 SSA 值
    type_id int        // 该调用点要求的参数类型
}

// CFG 基本块，普通指令在 function.insts 中按块连续存放。
pub struct IRBlock {
    id int                 // 块编号，必须与 blocks 下标相同
    first_inst int         // 普通指令首下标
    inst_count int         // 普通指令数
    term int               // IR_TERM_* 终结种类
    term_value int         // 条件/返回值编号；不使用时为 -1
    succ0 int              // 第一后继；无后继时为 -1
    succ1 int              // 条件分支第二后继，否则为 -1
}

// 一个函数的完整 SSA 容器；target_id 参与缓存隔离，禁止跨目标误复用。
pub struct IRFunction {
    abi int                // 函数入口调用约定，随 IR 与缓存保存
    target_id int          // 目标数据模型/ABI 的稳定编号
    ret_type int           // 返回类型索引
    types *IRType          // 函数私有类型表
    type_count int         // 类型表长度
    insts *IRInst          // 按基本块排列的指令表
    inst_count int         // 指令表长度
    phis *IRPhi            // phi 输入片段表
    phi_count int          // phi 输入片段数量
    phi_inputs *IRPhiInput // 所有 phi 的前驱输入
    phi_input_count int    // phi 输入总数
    calls *IRCall          // 按 CALL 指令顺序排列的直接调用表
    call_count int         // 调用表长度
    call_args *IRCallArg   // 所有调用的变长实参
    call_arg_count int     // 实参总数
    call_symbols *u8      // 各调用的稳定目标符号名，连续字节
    call_symbol_size int   // 符号名字节总数
    blocks *IRBlock        // 函数 CFG，blocks[0] 为入口
    block_count int        // CFG 基本块数量
    value_count int        // 值编号上界；void CALL/STORE 不定义值，编号可稀疏
}

// ir_type_ok：确认类型索引在函数私有类型表内，且指针元素引用有效。
fn ir_type_ok(f *IRFunction, tid int) int {
    if (tid < 0 || tid >= f.type_count || f.types == 0) {
        return 0
    }
    let t IRType = f.types[tid]
    if (t.kind < IR_TY_VOID || t.kind > IR_TY_LAST) {
        return 0
    }
    if (t.kind == IR_TY_FN_PTR) {
        return t.bits == 64 && t.elem == -1
    }
    if (t.kind == IR_TY_VOID) {
        return t.bits == 0 && t.elem == -1
    }
    if (t.kind == IR_TY_PTR) {
        // 通用指针（含旧 SSA 路径的 *元素 编码）只要求元素引用有效。
        return t.elem >= 0 && t.elem < f.type_count && t.elem != tid && t.bits > 0
    }
    if (t.kind > IR_TY_PTR && t.kind <= IR_TY_PTR_LAST) {
        // canonical 指针：elem 必须等于 kind 减 IR_TY_PTR。
        return t.elem == t.kind - IR_TY_PTR && t.elem >= 0 && t.elem < f.type_count &&
            t.bits > 0
    }
    if (t.elem != -1) {
        return 0
    }
    if (t.kind == IR_TY_I8 || t.kind == IR_TY_U8) { return t.bits == 8 }
    if (t.kind == IR_TY_I16 || t.kind == IR_TY_U16) { return t.bits == 16 }
    if (t.kind == IR_TY_I32 || t.kind == IR_TY_U32 || t.kind == IR_TY_F32) { return t.bits == 32 }
    if (t.kind == IR_TY_I64 || t.kind == IR_TY_U64 || t.kind == IR_TY_F64) { return t.bits == 64 }
    // 源 bool 是无符号字节值；条件/逻辑结果单独归一为 0/1，不能丢弃显式转换的高位。
    if (t.kind == IR_TY_BOOL) { return t.bits == 8 }
    return 0
}

// ir_find_value_type：查找 SSA 值的有效定义，未定义、重定义或坏类型返回 -1。
pub fn ir_find_value_type(f *IRFunction, value int) int {
    if (f == 0 || value < 0 || f.inst_count < 0 || f.inst_count > 0 && f.insts == 0 || f.types == 0) {
        return -1
    }
    let found int = -1
    let i int = 0
    for i < f.inst_count {
        if (f.insts[i].result_id == value) {
            if (found >= 0) {
                return -1
            }
            let tid int = f.insts[i].result_type
            if (tid < 0 || tid >= f.type_count || f.types[tid].kind == IR_TY_VOID) {
                return -1
            }
            found = tid
        }
        i += 1
    }
    return found
}

// ir_is_pred：判断 from 是否通过任一终结边到达 to。
fn ir_is_pred(f *IRFunction, from int, to int) int {
    let b IRBlock = f.blocks[from]
    return b.succ0 == to || b.succ1 == to
}

// ir_verify_inst：校验单条指令的编码、结果定义与输入值是否存在。
fn ir_verify_inst(f *IRFunction, inst *IRInst, saw_non_phi int) int {
    let has_result int = inst.op != IR_OP_STORE && inst.op != IR_OP_MEMCPY &&
        inst.op != IR_OP_MEMSET &&
        (inst.op != IR_OP_CALL || inst.result_id >= 0)
    if (inst.op < IR_OP_CONST || inst.op > IR_OP_MEMSET) {
        return -1
    }
    if (inst.op != IR_OP_CONST && inst.op != IR_OP_PARAM && inst.op != IR_OP_ADDR
        && inst.op != IR_OP_ALLOCA && inst.op != IR_OP_GEP && inst.op != IR_OP_MEMCPY
        && inst.op != IR_OP_MEMSET
        && inst.op != IR_OP_GLOB_ADDR && inst.op != IR_OP_FN_ADDR && inst.imm != 0) {
        return -1
    }
    if (inst.op == IR_OP_PHI && saw_non_phi != 0) {
        return -1
    }
    if (has_result != 0) {
        if (inst.result_id < 0 || inst.result_id >= f.value_count || ir_type_ok(f, inst.result_type) == 0
            || f.types[inst.result_type].kind == IR_TY_VOID) {
            return -1
        }
        if (ir_find_value_type(f, inst.result_id) != inst.result_type) {
            return -1
        }
    } else if (inst.result_id != -1 || inst.result_type != -1) {
        return -1
    }
    if (inst.op == IR_OP_CONST) {
        return inst.a == -1 && inst.b == -1 && inst.aux == -1 ? 0 : -1
    }
    if (inst.op == IR_OP_PARAM) {
        return inst.imm >= 0 && inst.a == -1 && inst.b == -1 && inst.aux == -1 ? 0 : -1
    }
    if (inst.op == IR_OP_ADDR) {
        // 绑定 ID 必须非负；结果已验证为 canonical 指针（禁止 void 分配）。
        if (inst.imm < 0 || inst.a != -1 || inst.b != -1 || inst.aux != -1) { return -1 }
        return 0
    }
    if (inst.op == IR_OP_ALLOCA) {
        // 字节数与对齐必须为正；结果只要求是指针（元素可为 void）。
        if (inst.imm <= 0 || inst.aux <= 0 || inst.a != -1 || inst.b != -1) { return -1 }
        return f.types[inst.result_type].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_GEP) {
        // 基指针必须存在；动态偏移必须是 u64 值，常量偏移必须非负。
        if (inst.a < 0 || inst.aux != -1) { return -1 }
        let base_type int = ir_find_value_type(f, inst.a)
        if (base_type < 0 || f.types[base_type].kind < IR_TY_PTR) { return -1 }
        if (inst.b >= 0) {
            return ir_find_value_type(f, inst.b) == IR_TY_U64 ? 0 : -1
        }
        return inst.imm >= 0 ? 0 : -1
    }
    if (inst.op == IR_OP_MEMCPY) {
        // 两个指针与正字节数；无结果（has_result 已保证 result_id/type 为 -1）。
        if (inst.imm <= 0 || inst.aux != -1 || inst.a < 0 || inst.b < 0) { return -1 }
        let at int = ir_find_value_type(f, inst.a)
        let bt int = ir_find_value_type(f, inst.b)
        if (at < 0 || bt < 0 || f.types[at].kind < IR_TY_PTR || f.types[bt].kind < IR_TY_PTR) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_MEMSET) {
        // 默认初始化只允许清零真实存储区，长度必须为正且没有源指针。
        if (inst.imm <= 0 || inst.aux != -1 || inst.a < 0 || inst.b != -1) { return -1 }
        let at int = ir_find_value_type(f, inst.a)
        return at >= 0 && f.types[at].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_GLOB_ADDR) {
        // 模块符号下标必须非负（种类由模块 verifier 核对）；结果只要求是指针。
        if (inst.imm < 0 || inst.a != -1 || inst.b != -1 || inst.aux != -1) { return -1 }
        return f.types[inst.result_type].kind >= IR_TY_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_FN_ADDR) {
        return inst.imm >= 0 && inst.aux >= 0 && inst.a == -1 && inst.b == -1 &&
            f.types[inst.result_type].kind == IR_TY_FN_PTR ? 0 : -1
    }
    if (inst.op == IR_OP_FNEG) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1
            || inst.result_type != ir_find_value_type(f, inst.a)) { return -1 }
        return ir_float_type(f.types[inst.result_type].kind) != 0 ? 0 : -1
    }
    if (inst.op == IR_OP_CALL) {
        if (inst.a != -1 || inst.b != -1 || inst.aux < 0 || inst.aux >= f.call_count) {
            return -1
        }
        if (has_result == 0 && (inst.result_id != -1 || inst.result_type != -1)) {
            return -1
        }
        return ir_verify_call(f, inst)
    }
    if (inst.op == IR_OP_COPY) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1
            || ir_find_value_type(f, inst.a) != inst.result_type) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_CAST) {
        if (inst.a < 0 || inst.b != -1 || inst.aux != -1) { return -1 }
        let source_type int = ir_find_value_type(f, inst.a)
        if (source_type < 0) { return -1 }
        let from_kind int = f.types[source_type].kind
        let to_kind int = f.types[inst.result_type].kind
        let from_ptr int = ((from_kind >= IR_TY_PTR && from_kind <= IR_TY_PTR_LAST)
            || from_kind == IR_TY_FN_PTR).to_type(int)
        let to_ptr int = ((to_kind >= IR_TY_PTR && to_kind <= IR_TY_PTR_LAST)
            || to_kind == IR_TY_FN_PTR).to_type(int)
        if (from_ptr != 0 && to_ptr != 0
            || from_ptr != 0 && ir_integer_type(to_kind) != 0
            || to_ptr != 0 && ir_integer_type(from_kind) != 0) { return 0 }
        return ir_scalar_type(from_kind) != 0 && ir_scalar_type(to_kind) != 0 ? 0 : -1
    }
    if (inst.op == IR_OP_PHI) {
        if (inst.a != -1 || inst.b != -1 || inst.aux < 0 || inst.aux >= f.phi_count) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_STORE) {
        if (inst.aux != -1 || ir_find_value_type(f, inst.a) < 0 || ir_find_value_type(f, inst.b) < 0) {
            return -1
        }
        let at int = ir_find_value_type(f, inst.a)
        let bt int = ir_find_value_type(f, inst.b)
        if (f.types[at].kind < IR_TY_PTR
            || f.types[at].elem != bt && !(f.types[at].elem == IR_TY_VOID
                && f.types[bt].kind == IR_TY_FN_PTR)) {
            return -1
        }
        return 0
    }
    if (inst.op == IR_OP_LOAD) {
        if (inst.b != -1 || inst.aux != -1) {
            return -1
        }
        let at int = ir_find_value_type(f, inst.a)
        if (at < 0 || f.types[at].kind < IR_TY_PTR
            || f.types[at].elem != inst.result_type && !(f.types[at].elem == IR_TY_VOID
                && f.types[inst.result_type].kind == IR_TY_FN_PTR)) {
            return -1
        }
        return 0
    }
    if (inst.aux != -1) {
        return -1
    }
    let at2 int = ir_find_value_type(f, inst.a)
    let bt2 int = ir_find_value_type(f, inst.b)
    if (at2 < 0 || bt2 < 0 || at2 != bt2) {
        return -1
    }
    if (inst.op == IR_OP_EQ || inst.op == IR_OP_NE
        || inst.op == IR_OP_LT || inst.op == IR_OP_LE
        || inst.op == IR_OP_GT || inst.op == IR_OP_GE) {
        if (f.types[inst.result_type].kind != IR_TY_BOOL) {
            return -1
        }
        if (inst.op != IR_OP_EQ && inst.op != IR_OP_NE) {
            let operand_kind int = f.types[at2].kind
            if (ir_integer_type(operand_kind) == 0 && ir_float_type(operand_kind) == 0) {
                return -1
            }
        }
        return 0
    }
    if (at2 != inst.result_type || f.types[at2].kind == IR_TY_PTR
        || f.types[at2].kind == IR_TY_VOID || f.types[at2].kind == IR_TY_BOOL) {
        return -1
    }
    let operand_kind int = f.types[at2].kind
    if (ir_float_type(operand_kind) != 0) {
        // IEEE 浮点只允许基础算术；位运算、余数和移位仍是整数专属操作。
        return inst.op == IR_OP_ADD || inst.op == IR_OP_SUB ||
            inst.op == IR_OP_MUL || inst.op == IR_OP_DIV ? 0 : -1
    }
    return ir_integer_type(operand_kind) != 0 ? 0 : -1
}

// ir_verify_phi：要求 phi 对每个 CFG 前驱恰有一个同类型输入。
fn ir_verify_phi(f *IRFunction, block_id int, inst *IRInst) int {
    let phi IRPhi = f.phis[inst.aux]
    if (phi.first < 0 || phi.count < 0 || phi.first + phi.count > f.phi_input_count
        || f.phi_inputs == 0 && phi.count > 0) {
        return -1
    }
    let pred_count int = 0
    let p int = 0
    for p < f.block_count {
        if (ir_is_pred(f, p, block_id) != 0) {
            pred_count += 1
        }
        p += 1
    }
    if (pred_count != phi.count) {
        return -1
    }
    let i int = 0
    for i < phi.count {
        let input IRPhiInput = f.phi_inputs[phi.first + i]
        if (input.pred < 0 || input.pred >= f.block_count || ir_is_pred(f, input.pred, block_id) == 0
            || ir_find_value_type(f, input.value) != inst.result_type) {
            return -1
        }
        let j int = i + 1
        for j < phi.count {
            if (f.phi_inputs[phi.first + j].pred == input.pred) {
                return -1
            }
            j += 1
        }
        i += 1
    }
    return 0
}

// ir_verify_term：检查终结形式、边界和返回值类型。
fn ir_verify_term(f *IRFunction, b *IRBlock) int {
    if (b.term == IR_TERM_BR) {
        return b.term_value == -1 && b.succ0 >= 0 && b.succ0 < f.block_count && b.succ1 == -1 ? 0 : -1
    }
    if (b.term == IR_TERM_COND_BR) {
        if (b.succ0 < 0 || b.succ0 >= f.block_count || b.succ1 < 0 || b.succ1 >= f.block_count
            || b.succ0 == b.succ1) {
            return -1
        }
        let ct int = ir_find_value_type(f, b.term_value)
        if (ct < 0 || f.types[ct].kind != IR_TY_BOOL) {
            return -1
        }
        return 0
    }
    if (b.term == IR_TERM_RET) {
        if (b.succ0 != -1 || b.succ1 != -1) {
            return -1
        }
        if (f.types[f.ret_type].kind == IR_TY_VOID) {
            return b.term_value == -1 ? 0 : -1
        }
        return ir_find_value_type(f, b.term_value) == f.ret_type ? 0 : -1
    }
    if (b.term == IR_TERM_UNREACHABLE) {
        return b.term_value == -1 && b.succ0 == -1 && b.succ1 == -1 ? 0 : -1
    }
    return -1
}

// ir_find_value_position：查找值定义所在的基本块与块内指令下标。
// 调用方须先完成指令范围和结果 ID 唯一性检查。
fn ir_find_value_position(f *IRFunction, value int, block_out *int, inst_out *int) int {
    if (f == 0 || block_out == 0 || inst_out == 0 || value < 0) {
        return -1
    }
    let found int = 0
    let b int = 0
    for b < f.block_count {
        let block IRBlock = f.blocks[b]
        let j int = 0
        for j < block.inst_count {
            let index int = block.first_inst + j
            if (f.insts[index].result_id == value) {
                if (found != 0) {
                    return -1
                }
                *block_out = b
                *inst_out = j
                found = 1
            }
            j += 1
        }
        b += 1
    }
    return found != 0 ? 0 : -1
}

// ir_use_dominates：确认定义在普通指令位置或 phi 边上可用。
// phi 的 use 点是对应前驱块末尾；普通终结 use 的 inst_index 等于块指令数。
fn ir_use_dominates(f *IRFunction, value int, use_block int, inst_index int, edge_pred int,
    dom *u8, reachable *u8) int {
    let def_block int = -1
    let def_inst int = -1
    if (ir_find_value_position(f, value, &def_block, &def_inst) != 0) {
        return 0
    }
    if (edge_pred >= 0) {
        if (def_block == edge_pred || reachable[edge_pred] == 0) {
            return 1
        }
        if (reachable[def_block] == 0) {
            return 0
        }
        return dom[edge_pred * f.block_count + def_block] != 0 ? 1 : 0
    }
    if (def_block == use_block) {
        return def_inst < inst_index ? 1 : 0
    }
    if (reachable[use_block] == 0) {
        return 1
    }
    if (reachable[def_block] == 0) {
        return 0
    }
    return dom[use_block * f.block_count + def_block] != 0 ? 1 : 0
}

// ir_verify_dominance：计算入口可达块的支配矩阵并检查所有 SSA use。
// 不可达块不影响可执行路径；其跨块 use 只做定义存在与类型检查。
fn ir_verify_dominance(f *IRFunction) int {
    let n int = f.block_count
    let reachable *u8 = malloc(n.to_type(u64)).to_type(*u8)
    let queue *int = malloc((n * sizeof(int)).to_type(u64)).to_type(*int)
    let dom *u8 = malloc((n * n).to_type(u64)).to_type(*u8)
    let row *u8 = malloc(n.to_type(u64)).to_type(*u8)
    if (reachable == 0 || queue == 0 || dom == 0 || row == 0) {
        if (reachable != 0) { free(reachable) }
        if (queue != 0) { free(queue) }
        if (dom != 0) { free(dom) }
        if (row != 0) { free(row) }
        return -1
    }
    let i int = 0
    for i < n {
        reachable[i] = 0
        i += 1
    }
    reachable[0] = 1
    queue[0] = 0
    let head int = 0
    let tail int = 1
    for head < tail {
        let current int = queue[head]
        let block IRBlock = f.blocks[current]
        if (block.succ0 >= 0 && reachable[block.succ0] == 0) {
            reachable[block.succ0] = 1
            queue[tail] = block.succ0
            tail += 1
        }
        if (block.succ1 >= 0 && reachable[block.succ1] == 0) {
            reachable[block.succ1] = 1
            queue[tail] = block.succ1
            tail += 1
        }
        head += 1
    }
    let b int = 0
    for b < n {
        let d int = 0
        for d < n {
            dom[b * n + d] = reachable[d]
            d += 1
        }
        if (reachable[b] == 0) {
            let z int = 0
            for z < n {
                dom[b * n + z] = 0
                z += 1
            }
            dom[b * n + b] = 1
        }
        b += 1
    }
    let entry_col int = 0
    for entry_col < n {
        dom[entry_col] = 0
        entry_col += 1
    }
    dom[0] = 1
    let changed int = 1
    for changed != 0 {
        changed = 0
        let block_id int = 1
        for block_id < n {
            if (reachable[block_id] != 0) {
                let d2 int = 0
                for d2 < n {
                    row[d2] = reachable[d2]
                    d2 += 1
                }
                let pred int = 0
                for pred < n {
                    if (reachable[pred] != 0 && ir_is_pred(f, pred, block_id) != 0) {
                        let col int = 0
                        for col < n {
                            if (dom[pred * n + col] == 0) {
                                row[col] = 0
                            }
                            col += 1
                        }
                    }
                    pred += 1
                }
                row[block_id] = 1
                let col2 int = 0
                for col2 < n {
                    if (dom[block_id * n + col2] != row[col2]) {
                        dom[block_id * n + col2] = row[col2]
                        changed = 1
                    }
                    col2 += 1
                }
            }
            block_id += 1
        }
    }
    let valid int = 1
    let use_block int = 0
    for use_block < n && valid != 0 {
        let block IRBlock = f.blocks[use_block]
        let j int = 0
        for j < block.inst_count && valid != 0 {
            let inst IRInst = f.insts[block.first_inst + j]
            if (inst.op == IR_OP_PHI) {
                let phi IRPhi = f.phis[inst.aux]
                let k int = 0
                for k < phi.count && valid != 0 {
                    let input IRPhiInput = f.phi_inputs[phi.first + k]
                    if (ir_use_dominates(f, input.value, use_block, j, input.pred, dom, reachable) == 0) {
                        valid = 0
                    }
                    k += 1
                }
            } else {
                if (inst.a >= 0 && ir_use_dominates(f, inst.a, use_block, j, -1, dom, reachable) == 0) {
                    valid = 0
                }
                if (inst.b >= 0 && ir_use_dominates(f, inst.b, use_block, j, -1, dom, reachable) == 0) {
                    valid = 0
                }
                if (inst.op == IR_OP_CALL) {
                    let call IRCall = f.calls[inst.aux]
                    if (call.callee_value >= 0
                        && ir_use_dominates(f, call.callee_value, use_block, j, -1, dom, reachable) == 0) {
                        valid = 0
                    }
                    let arg int = 0
                    for arg < call.arg_count && valid != 0 {
                        let value int = f.call_args[call.arg_first + arg].value
                        if (ir_use_dominates(f, value, use_block, j, -1, dom, reachable) == 0) {
                            valid = 0
                        }
                        arg += 1
                    }
                }
            }
            j += 1
        }
        if (block.term_value >= 0
            && ir_use_dominates(f, block.term_value, use_block, block.inst_count, -1, dom, reachable) == 0) {
            valid = 0
        }
        use_block += 1
    }
    free(reachable)
    free(queue)
    free(dom)
    free(row)
    return valid != 0 ? 0 : -1
}

// ir_verify：校验 SSA 容器的结构、值唯一性、操作数支配/类型与 phi 前驱完整性。
// 返回 0 表示通过，-1 表示结构或类型不合法；输入所有数组均由调用方持有。
pub fn ir_verify(f *IRFunction) int {
    if (f == 0 || f.abi < 0 || f.abi > IR_ABI_YH_LLVM_V1 || f.target_id < 0 || f.block_count <= 0 || f.blocks == 0 || f.inst_count < 0
        || f.value_count < 0 || f.type_count <= 0 || f.types == 0 || f.phi_count < 0
        || f.phi_input_count < 0 || f.call_count < 0 || f.call_arg_count < 0
        || f.call_symbol_size < 0 || f.ret_type < 0 || f.ret_type >= f.type_count
        || ir_type_ok(f, f.ret_type) == 0) {
        return -1
    }
    if (f.inst_count > 0 && f.insts == 0 || f.phi_count > 0 && f.phis == 0
        || f.call_count > 0 && f.calls == 0 || f.call_arg_count > 0 && f.call_args == 0
        || f.call_symbol_size > 0 && f.call_symbols == 0) {
        return -1
    }
    if (ir_verify_call_table(f) != 0) { return -1 }
    // 参数由入口块前导 PARAM 指令声明，编号从零连续递增；这让函数
    // 签名随 IR 一起序列化，同时不另加一份并行的参数表。
    let entry IRBlock = f.blocks[0]
    if (entry.id != 0 || entry.first_inst != 0 || entry.inst_count < 0
        || entry.inst_count > f.inst_count) {
        return -1
    }
    let param_start int = 0
    for param_start < entry.inst_count &&
        f.insts[entry.first_inst + param_start].op == IR_OP_PHI {
        param_start += 1
    }
    let param_count int = 0
    for param_start + param_count < entry.inst_count &&
        f.insts[entry.first_inst + param_start + param_count].op == IR_OP_PARAM {
        if (f.insts[entry.first_inst + param_start + param_count].imm != param_count) {
            return -1
        }
        param_count += 1
    }
    let t int = 0
    for t < f.type_count {
        if (ir_type_ok(f, t) == 0) {
            return -1
        }
        t += 1
    }
    let used int = 0
    let call_index int = 0
    let b int = 0
    // 块的指令区间允许与编号顺序不同（构造器按需创建合流块），
    // 但必须互不重叠且恰好覆盖 [0, inst_count)；用覆盖标记逐块校验。
    let covered *u8 = malloc((f.inst_count + 1).to_type(u64)).to_type(*u8)
    if (covered == 0) { return -1 }
    // 值编号唯一性用位图检查：块区间允许乱序，前缀扫描会把当前指令
    // 误判为重复；位图对任意布局都正确且是 O(n)。
    let seen_ids *u8 = malloc((f.value_count + 1).to_type(u64)).to_type(*u8)
    if (seen_ids == 0) { free(covered); return -1 }
    let cover_i int = 0
    for cover_i <= f.inst_count {
        covered[cover_i] = 0
        cover_i += 1
    }
    let seen_i int = 0
    for seen_i <= f.value_count {
        seen_ids[seen_i] = 0
        seen_i += 1
    }
    let cover_ok int = 1
    for b < f.block_count {
        let block IRBlock = f.blocks[b]
        if (block.id != b || block.first_inst < 0 || block.inst_count < 0
            || block.first_inst + block.inst_count > f.inst_count
            || ir_verify_term(f, &block) != 0) {
            cover_ok = 0
        }
        if (cover_ok != 0) {
            let cover_j int = 0
            for cover_j < block.inst_count {
                if (covered[block.first_inst + cover_j] != 0) { cover_ok = 0; break }
                covered[block.first_inst + cover_j] = 1
                cover_j += 1
            }
        }
        if (cover_ok == 0) { free(covered); free(seen_ids); return -1 }
        let j int = 0
        let saw_non_phi int = 0
        for j < block.inst_count {
            let inst *IRInst = &f.insts[block.first_inst + j]
            if (inst.op == IR_OP_PARAM
                && (b != 0 || j < param_start || j >= param_start + param_count
                    || inst.imm != j - param_start)) {
                free(covered)
                free(seen_ids)
                return -1
            }
            if (inst.op != IR_OP_PHI) {
                saw_non_phi = 1
            }
            if (ir_verify_inst(f, inst, saw_non_phi) != 0) {
                free(covered)
                free(seen_ids)
                return -1
            }
            if (inst.op == IR_OP_PHI && ir_verify_phi(f, b, inst) != 0) {
                free(covered)
                free(seen_ids)
                return -1
            }
            if (inst.result_id >= 0) {
                if (seen_ids[inst.result_id] != 0) {
                    free(covered)
                    free(seen_ids)
                    return -1
                }
                seen_ids[inst.result_id] = 1
            }
            j += 1
        }
        used += block.inst_count
        b += 1
    }
    free(covered)
    free(seen_ids)
    if (used != f.inst_count) {
        return -1
    }
    // 无结果指令（void CALL、STORE）不定义值，值编号允许稀疏；
    // value_count 只须覆盖每个已定义值的编号上界。
    let defs int = 0
    let i int = 0
    for i < f.inst_count {
        // 调用表按线性指令数组追加。块编号允许与指令范围乱序，不能据其枚举顺序验调用编号。
        if (f.insts[i].op == IR_OP_CALL) {
            if (f.insts[i].aux != call_index) { return -1 }
            call_index += 1
        }
        if (f.insts[i].result_id >= 0) {
            defs += 1
        }
        i += 1
    }
    if (defs > f.value_count || call_index != f.call_count) {
        return -1
    }
    let dom_result int = ir_verify_dominance(f)
    if (dom_result != 0) { }
    return dom_result
}

// ir_integer_type：判断类型是否能按定宽整数规则参与默认常量折叠。
pub fn ir_integer_type(kind int) int {
    return kind >= IR_TY_I8 && kind <= IR_TY_U64 ? 1 : 0
}

// ir_float_type：判断类型是否为受支持的 IEEE 单精度或双精度标量。
pub fn ir_float_type(kind int) int {
    return kind == IR_TY_F32 || kind == IR_TY_F64 ? 1 : 0
}

// ir_const_type：整数与布尔常量可以安全参与本阶段的位型简化。
pub fn ir_const_type(kind int) int {
    return ir_integer_type(kind) != 0 || kind == IR_TY_BOOL ? 1 : 0
}

// ir_scalar_type：标量值可参与显式数值转换；bool 保留源级一字节语义。
pub fn ir_scalar_type(kind int) int {
    return ir_const_type(kind) != 0 || ir_float_type(kind) != 0 ? 1 : 0
}

