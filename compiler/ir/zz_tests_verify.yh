module ir

// ============================================================================
// zz_tests_verify.yh —— IR 校验/简化的语言内测试（YT4-P6）
//
// 只在 `yh test ir` 中执行；生产构建不登记测试符号、不发射测试体。
// 来源是 tests/modules/projects/irverify 的 6 个 check_*；断言只调 ir 的
// pub API。旧夹具的编号 return N 只表示失败点，这里统一改成
// `$assert(false, "旧断言 N"); return;`，控制流与检查顺序不变。
// 文件名 zz_ 前缀：ir 的类型/常量在 ssa_* 文件里，必须排在之后。
// ============================================================================

test "check_phi" {
    let types [2]IRType;
    types[0].kind = IR_TY_BOOL;
    types[0].elem = -1;
    types[0].bits = 8;
    types[1].kind = IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;

    let insts [4]IRInst;
    insts[0].op = IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].aux = -1;
    insts[1].op = IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].aux = -1;
    insts[1].imm = 11;
    insts[2].op = IR_OP_CONST;
    insts[2].result_id = 2;
    insts[2].result_type = 1;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].aux = -1;
    insts[2].imm = 22;
    insts[3].op = IR_OP_PHI;
    insts[3].result_id = 3;
    insts[3].result_type = 1;
    insts[3].a = -1;
    insts[3].b = -1;
    insts[3].aux = 0;

    let phis [1]IRPhi;
    phis[0].first = 0;
    phis[0].count = 2;
    let inputs [2]IRPhiInput;
    inputs[0].pred = 1;
    inputs[0].value = 1;
    inputs[1].pred = 2;
    inputs[1].value = 2;

    let blocks [4]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 1;
    blocks[0].term = IR_TERM_COND_BR;
    blocks[0].term_value = 0;
    blocks[0].succ0 = 1;
    blocks[0].succ1 = 2;
    blocks[1].id = 1;
    blocks[1].first_inst = 1;
    blocks[1].inst_count = 1;
    blocks[1].term = IR_TERM_BR;
    blocks[1].term_value = -1;
    blocks[1].succ0 = 3;
    blocks[1].succ1 = -1;
    blocks[2].id = 2;
    blocks[2].first_inst = 2;
    blocks[2].inst_count = 1;
    blocks[2].term = IR_TERM_BR;
    blocks[2].term_value = -1;
    blocks[2].succ0 = 3;
    blocks[2].succ1 = -1;
    blocks[3].id = 3;
    blocks[3].first_inst = 3;
    blocks[3].inst_count = 1;
    blocks[3].term = IR_TERM_RET;
    blocks[3].term_value = 3;
    blocks[3].succ0 = -1;
    blocks[3].succ1 = -1;

    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 4;
    f.phis = &phis[0];
    f.phi_count = 1;
    f.phi_inputs = &inputs[0];
    f.phi_input_count = 2;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 4;
    f.value_count = 4;

    if (ir_verify(&f) != 0) {
        $assert(false, "旧断言 1"); return;
    }
    // 一位 bool 属于旧语义模型；新 verifier 必须拒绝，不能误读旧缓存。
    types[0].bits = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 8"); return; }
    types[0].bits = 8;
    inputs[1].pred = 1;
    if (ir_verify(&f) == 0) {
        $assert(false, "旧断言 2"); return;
    }
    inputs[1].pred = 2;
    inputs[1].value = 0;
    if (ir_verify(&f) == 0) {
        $assert(false, "旧断言 3"); return;
    }
    inputs[1].value = 2;
    insts[0].result_type = 99;
    if (ir_verify(&f) == 0) {
        $assert(false, "旧断言 4"); return;
    }
    insts[0].result_type = 0;
    inputs[1].value = 1;
    if (ir_verify(&f) == 0) {
        $assert(false, "旧断言 5"); return;
    }
    inputs[1].value = 2;
    insts[1].a = 0;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 6"); return; }
    insts[1].a = -1;
    insts[3].imm = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 7"); return; }
}

// check_simplify：确认常量算术与相同输入 phi 会被低成本规范化。
test "check_simplify" {
    let types [2]IRType;
    types[0].kind = IR_TY_BOOL;
    types[0].elem = -1;
    types[0].bits = 8;
    types[1].kind = IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;

    let insts [5]IRInst;
    insts[0].op = IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].aux = -1;
    insts[0].imm = 1;
    insts[1].op = IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].aux = -1;
    insts[1].imm = -10;
    insts[2].op = IR_OP_CONST;
    insts[2].result_id = 2;
    insts[2].result_type = 1;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].aux = -1;
    insts[2].imm = 40;
    insts[3].op = IR_OP_ADD;
    insts[3].result_id = 3;
    insts[3].result_type = 1;
    insts[3].a = 1;
    insts[3].b = 2;
    insts[3].aux = -1;
    insts[4].op = IR_OP_PHI;
    insts[4].result_id = 4;
    insts[4].result_type = 1;
    insts[4].a = -1;
    insts[4].b = -1;
    insts[4].aux = 0;

    let phis [1]IRPhi;
    phis[0].first = 0;
    phis[0].count = 2;
    let inputs [2]IRPhiInput;
    inputs[0].pred = 1;
    inputs[0].value = 3;
    inputs[1].pred = 2;
    inputs[1].value = 3;

    let blocks [4]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 4;
    blocks[0].term = IR_TERM_COND_BR;
    blocks[0].term_value = 0;
    blocks[0].succ0 = 1;
    blocks[0].succ1 = 2;
    blocks[1].id = 1;
    blocks[1].first_inst = 4;
    blocks[1].inst_count = 0;
    blocks[1].term = IR_TERM_BR;
    blocks[1].term_value = -1;
    blocks[1].succ0 = 3;
    blocks[1].succ1 = -1;
    blocks[2].id = 2;
    blocks[2].first_inst = 4;
    blocks[2].inst_count = 0;
    blocks[2].term = IR_TERM_BR;
    blocks[2].term_value = -1;
    blocks[2].succ0 = 3;
    blocks[2].succ1 = -1;
    blocks[3].id = 3;
    blocks[3].first_inst = 4;
    blocks[3].inst_count = 1;
    blocks[3].term = IR_TERM_RET;
    blocks[3].term_value = 4;
    blocks[3].succ0 = -1;
    blocks[3].succ1 = -1;

    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 5;
    f.phis = &phis[0];
    f.phi_count = 1;
    f.phi_inputs = &inputs[0];
    f.phi_input_count = 2;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 4;
    f.value_count = 5;

    if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }
    insts[3].aux = 0;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 23"); return; }
    insts[3].aux = -1;
    // 2026-10-24：`ir_simplify` 已删除（ADR-0014 把通用优化交给 LLVM，
    // 该函数在生产路径无调用点）。此用例只保留 verify/序列化契约。
    if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }

    let size int = ir_serialized_size(&f);
    if (size <= 0) { $assert(false, "旧断言 9"); return; }
    let bytes *u8 = malloc(size.to_type(u64)).to_type(*u8);
    let copy *u8 = malloc(size.to_type(u64)).to_type(*u8);
    if (bytes == 0 || copy == 0) {
        if (bytes != 0) { free(bytes); }
        if (copy != 0) { free(copy); }
        $assert(false, "旧断言 10"); return;
    }
    if (ir_serialize(&f, bytes, size) != size) { $assert(false, "旧断言 11"); return; }
    if (ir_serialize(&f, bytes, size - 1) != -1) { $assert(false, "旧断言 22"); return; }

    let decoded IRFunction;
    decoded.types = 0;
    decoded.insts = 0;
    decoded.phis = 0;
    decoded.phi_inputs = 0;
    decoded.calls = 0;
    decoded.call_args = 0;
    decoded.call_symbols = 0;
    decoded.blocks = 0;
    if (ir_deserialize(&decoded, bytes, size, f.target_id) != 0) { $assert(false, "旧断言 12"); return; }
    if (ir_verify(&decoded) != 0 || decoded.target_id != f.target_id
        || decoded.ret_type != f.ret_type || decoded.value_count != f.value_count
        || decoded.inst_count != f.inst_count || decoded.block_count != f.block_count) {
        $assert(false, "旧断言 13"); return;
    }
    // 未化简的 IR 原样往返：ADD 与未解析的 phi 都必须保真（此前这里断言的是
    // ir_simplify 就地改写后的 CONST 30 / term_value 3）。
    if (decoded.insts[1].imm != -10 || decoded.insts[3].op != IR_OP_ADD
        || decoded.blocks[3].term_value != 4 || decoded.phi_inputs[1].value != 3) {
        $assert(false, "旧断言 14"); return;
    }
    if (ir_serialize(&decoded, copy, size) != size) { $assert(false, "旧断言 15"); return; }
    let i int = 0;
    for i < size {
        if (bytes[i] != copy[i]) { $assert(false, "旧断言 16"); return; }
        i += 1;
    }

    let bad_target IRFunction;
    bad_target.types = 0;
    bad_target.insts = 0;
    bad_target.phis = 0;
    bad_target.phi_inputs = 0;
    bad_target.calls = 0;
    bad_target.call_args = 0;
    bad_target.call_symbols = 0;
    bad_target.blocks = 0;
    if (ir_deserialize(&bad_target, bytes, size, f.target_id + 1) == 0) { $assert(false, "旧断言 17"); return; }
    let bad_version IRFunction;
    bad_version.types = 0;
    bad_version.insts = 0;
    bad_version.phis = 0;
    bad_version.phi_inputs = 0;
    bad_version.calls = 0;
    bad_version.call_args = 0;
    bad_version.call_symbols = 0;
    bad_version.blocks = 0;
    bytes[8] = (IR_SERIAL_VERSION + 1).to_type(u8);
    if (ir_deserialize(&bad_version, bytes, size, f.target_id) == 0) { $assert(false, "旧断言 18"); return; }
    bytes[8] = IR_SERIAL_VERSION.to_type(u8);
    let bad_length IRFunction;
    bad_length.types = 0;
    bad_length.insts = 0;
    bad_length.phis = 0;
    bad_length.phi_inputs = 0;
    bad_length.calls = 0;
    bad_length.call_args = 0;
    bad_length.call_symbols = 0;
    bad_length.blocks = 0;
    if (ir_deserialize(&bad_length, bytes, size - 1, f.target_id) == 0) { $assert(false, "旧断言 19"); return; }

    let bad_ir IRFunction;
    bad_ir.types = 0;
    bad_ir.insts = 0;
    bad_ir.phis = 0;
    bad_ir.phi_inputs = 0;
    bad_ir.calls = 0;
    bad_ir.call_args = 0;
    bad_ir.call_symbols = 0;
    bad_ir.blocks = 0;
    let term_byte u8 = bytes[512];
    bytes[512] = 255;
    if (ir_deserialize(&bad_ir, bytes, size, f.target_id) == 0) { $assert(false, "旧断言 20"); return; }
    if (bad_ir.types != 0 || bad_ir.insts != 0 || bad_ir.blocks != 0) { $assert(false, "旧断言 21"); return; }
    bytes[512] = term_byte;

    ir_function_release(&decoded);
    free(bytes);
    free(copy);
}

// check_memory_fields：确认 load/store 只能使用各自声明的操作数字段。
test "check_memory_fields" {
    let types [3]IRType;
    types[0].kind = IR_TY_VOID;
    types[0].elem = -1;
    types[0].bits = 0;
    types[1].kind = IR_TY_I32;
    types[1].elem = -1;
    types[1].bits = 32;
    types[2].kind = IR_TY_PTR;
    types[2].elem = 1;
    types[2].bits = 64;

    let insts [4]IRInst;
    insts[0].op = IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 2;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 4096;
    insts[0].aux = -1;
    insts[1].op = IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 1;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 7;
    insts[1].aux = -1;
    insts[2].op = IR_OP_STORE;
    insts[2].result_id = -1;
    insts[2].result_type = -1;
    insts[2].a = 0;
    insts[2].b = 1;
    insts[2].aux = -1;
    insts[3].op = IR_OP_LOAD;
    insts[3].result_id = 2;
    insts[3].result_type = 1;
    insts[3].a = 0;
    insts[3].b = -1;
    insts[3].aux = -1;

    let blocks [1]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 4;
    blocks[0].term = IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;

    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 1;
    f.types = &types[0];
    f.type_count = 3;
    f.insts = &insts[0];
    f.inst_count = 4;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }

    insts[3].b = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 2"); return; }
    insts[3].b = -1;
    insts[3].aux = 0;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 3"); return; }
    insts[3].aux = -1;
    insts[2].aux = 0;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 5"); return; }
    insts[2].aux = -1;
    insts[2].imm = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 4"); return; }
}

// check_param_prologue：参数编号必须从零连续，且只能出现在入口块前导区。
test "check_param_prologue" {
    let types [1]IRType;
    types[0].kind = IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    let insts [1]IRInst;
    insts[0].op = IR_OP_PARAM;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 0;
    insts[0].aux = -1;
    let blocks [1]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 1;
    blocks[0].term = IR_TERM_RET;
    blocks[0].term_value = 0;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 1;
    f.insts = &insts[0];
    f.inst_count = 1;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 1;
    if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }
    insts[0].imm = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 2"); return; }
    insts[0].imm = 0;
    insts[0].a = 0;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 3"); return; }
}

// check_integer_op_types：整数运算允许同型值并拒绝混合宽度；浮点仅允许基础算术。
test "check_integer_op_types" {
    let types [3]IRType;
    types[0].kind = IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    types[1].kind = IR_TY_U32;
    types[1].elem = -1;
    types[1].bits = 32;
    types[2].kind = IR_TY_F64;
    types[2].elem = -1;
    types[2].bits = 64;
    let insts [3]IRInst;
    insts[0].op = IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 21;
    insts[0].aux = -1;
    insts[1].op = IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 0;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 3;
    insts[1].aux = -1;
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    insts[2].a = 0;
    insts[2].b = 1;
    insts[2].aux = -1;
    let blocks [1]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 3;
    blocks[0].term = IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 3;
    f.insts = &insts[0];
    f.inst_count = 3;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    let ops [7]int;
    ops[0] = IR_OP_DIV;
    ops[1] = IR_OP_REM;
    ops[2] = IR_OP_BAND;
    ops[3] = IR_OP_BOR;
    ops[4] = IR_OP_BXOR;
    ops[5] = IR_OP_SHL;
    ops[6] = IR_OP_SHR;
    let i int = 0;
    for i < 7 {
        insts[2].op = ops[i];
        if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }
        insts[1].result_type = 1;
        if (ir_verify(&f) == 0) { $assert(false, "旧断言 2"); return; }
        insts[1].result_type = 0;
        insts[0].result_type = 2;
        insts[1].result_type = 2;
        insts[2].result_type = 2;
        f.ret_type = 2;
        if (ops[i] == IR_OP_DIV) {
            if (ir_verify(&f) != 0) { $assert(false, "旧断言 3"); return; }
        } else if (ir_verify(&f) == 0) { $assert(false, "旧断言 3"); return; }
        insts[0].result_type = 0;
        insts[1].result_type = 0;
        insts[2].result_type = 0;
        f.ret_type = 0;
        i += 1;
    }
}

// check_direct_call_ir：验证带稳定符号和变长实参的直接调用编码与 SSA 使用点。
test "check_direct_call_ir" {
    let types [2]IRType;
    types[0].kind = IR_TY_I32;
    types[0].elem = -1;
    types[0].bits = 32;
    types[1].kind = IR_TY_U32;
    types[1].elem = -1;
    types[1].bits = 32;
    let insts [4]IRInst;
    insts[0].op = IR_OP_CONST;
    insts[0].result_id = 0;
    insts[0].result_type = 0;
    insts[0].a = -1;
    insts[0].b = -1;
    insts[0].imm = 4;
    insts[0].aux = -1;
    insts[1].op = IR_OP_CONST;
    insts[1].result_id = 1;
    insts[1].result_type = 0;
    insts[1].a = -1;
    insts[1].b = -1;
    insts[1].imm = 5;
    insts[1].aux = -1;
    insts[2].op = IR_OP_CALL;
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    insts[2].a = -1;
    insts[2].b = -1;
    insts[2].imm = 0;
    insts[2].aux = 0;
    let calls [2]IRCall;
    calls[0].abi = 1;
    calls[0].callee_value = -1;
    calls[0].signature_type = -1;
    calls[0].symbol_first = 0;
    calls[0].symbol_len = 4;
    calls[0].arg_first = 0;
    calls[0].arg_count = 2;
    let args [2]IRCallArg;
    args[0].value = 0;
    args[0].type_id = 0;
    args[1].value = 1;
    args[1].type_id = 0;
    let symbols [5]u8;
    symbols[0] = '_';
    symbols[1] = 's';
    symbols[2] = 'u';
    symbols[3] = 'm';
    symbols[4] = 'x';
    let blocks [1]IRBlock;
    blocks[0].id = 0;
    blocks[0].first_inst = 0;
    blocks[0].inst_count = 3;
    blocks[0].term = IR_TERM_RET;
    blocks[0].term_value = 2;
    blocks[0].succ0 = -1;
    blocks[0].succ1 = -1;
    let f IRFunction;
    f.abi = 0;
    f.target_id = 1;
    f.ret_type = 0;
    f.types = &types[0];
    f.type_count = 2;
    f.insts = &insts[0];
    f.inst_count = 3;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = &calls[0];
    f.call_count = 1;
    f.call_args = &args[0];
    f.call_arg_count = 2;
    f.call_symbols = &symbols[0];
    f.call_symbol_size = 4;
    f.blocks = &blocks[0];
    f.block_count = 1;
    f.value_count = 3;
    // CALL 编号仍必须线性唯一；改变块枚举检查位置不能放过重复或无引用的调用记录。
    insts[3] = insts[2];
    insts[3].result_id = 3;
    f.inst_count = 4;
    f.value_count = 4;
    blocks[0].inst_count = 4;
    blocks[0].term_value = 3;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 10"); return; }
    f.inst_count = 3;
    f.value_count = 3;
    blocks[0].inst_count = 3;
    blocks[0].term_value = 2;
    calls[1].abi = 1;
    calls[1].callee_value = -1;
    calls[1].signature_type = -1;
    calls[1].symbol_first = 4;
    calls[1].symbol_len = 1;
    calls[1].arg_first = 2;
    calls[1].arg_count = 0;
    f.call_count = 2;
    f.call_symbol_size = 5;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 11"); return; }
    f.call_count = 1;
    f.call_symbol_size = 4;
    if (ir_verify(&f) != 0) { $assert(false, "旧断言 1"); return; }
    f.abi = 9;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 11"); return; }
    f.abi = 0;
    calls[0].abi = 9;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 12"); return; }
    calls[0].abi = 1;
    args[1].type_id = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 2"); return; }
    args[1].type_id = 0;
    args[1].value = 2;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 3"); return; }
    args[1].value = 1;
    symbols[0] = ';';
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 4"); return; }
    symbols[0] = '_';
    calls[0].arg_count = 1;
    if (ir_verify(&f) == 0) { $assert(false, "旧断言 5"); return; }
    calls[0].arg_count = 2;
    insts[2].result_id = -1;
    insts[2].result_type = -1;
    blocks[0].term_value = 0;
    f.value_count = 2;
    if (ir_verify(&f) != 0) { $assert(false, "旧断言 10"); return; }
    insts[2].result_id = 2;
    insts[2].result_type = 0;
    blocks[0].term_value = 2;
    f.value_count = 3;
    let bytes [512]u8;
    let size int = ir_serialized_size(&f);
    if (size <= 0 || size > 512 || ir_serialize(&f, &bytes[0], 512) != size) { $assert(false, "旧断言 6"); return; }
    let decoded IRFunction;
    decoded.types = 0;
    decoded.insts = 0;
    decoded.phis = 0;
    decoded.phi_inputs = 0;
    decoded.calls = 0;
    decoded.call_args = 0;
    decoded.call_symbols = 0;
    decoded.blocks = 0;
    if (ir_deserialize(&decoded, &bytes[0], size, 1) != 0) { $assert(false, "旧断言 7"); return; }
    let valid int = decoded.abi == 0 && decoded.calls[0].abi == 1 && decoded.call_count == 1 && decoded.call_arg_count == 2 &&
        decoded.call_symbol_size == 4 && decoded.call_symbols[0] == '_' &&
        decoded.call_args[1].value == 1 && decoded.insts[2].op == IR_OP_CALL;
    ir_function_release(&decoded);
    if (valid == 0) { $assert(false, "旧断言 8"); return; }
    // 破坏稳定格式 magic，避免依赖函数体随字段扩展而变化的固定字节偏移。
    bytes[0] = bytes[0] ^ 1;
    if (ir_deserialize(&decoded, &bytes[0], size, 1) == 0) { $assert(false, "旧断言 9"); return; }
}

