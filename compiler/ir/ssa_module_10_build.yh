module ir

// ir_module_copy：复制一个有界字节区间；零长不分配，失败返回空指针。
fn ir_module_copy(data *void, size int) *void {
    if (size <= 0 || size > IR_SERIAL_MAX_BYTES || data == 0) { return 0 }
    let copy *void = malloc(size.to_type(u64))
    if (copy != 0) { memcpy(copy, data, size.to_type(u64)) }
    return copy
}

// ir_module_copy_str：创建自有 C 字符串，包括空字符串；失败不取得输入所有权。
fn ir_module_copy_str(value *char) *char {
    let n int = ir_module_str_len(value)
    if (n < 0 || n >= IR_SERIAL_MAX_BYTES) { return 0 }
    return ir_module_copy(value.to_type(*void), n + 1).to_type(*char)
}

// ir_module_reserve：为五个真实可增长表共用扩容；仅搬移表项，子项独占指针保持所有权。
// 容量按倍数增长且受现有 IR 规模上限约束，失败时不释放旧表或改写容量。
fn ir_module_reserve(data *void, count int, capacity *int, item_size int) *void {
    if (count < 0 || count >= IR_SERIAL_MAX_ITEMS || capacity[0] < count || item_size <= 0) { return 0 }
    if (count < capacity[0]) { return data }
    let next int = capacity[0] * 2
    if (next == 0) { next = 8 }
    if (next > IR_SERIAL_MAX_ITEMS || next > IR_SERIAL_MAX_BYTES / item_size) { return 0 }
    let result *void = malloc((next * item_size).to_type(u64))
    if (result == 0) { return 0 }
    if (count > 0) { memcpy(result, data, (count * item_size).to_type(u64)) }
    if (data != 0) { free(data) }
    capacity[0] = next
    return result
}

// ir_module_init：out 必须为零初始化或已 release；输入字符串全部复制，key 从完整 triple 推导。
// 失败清理部分分配；成功产生可增建的空模块，不要求 LLVM、gen 或平台探测。
pub fn ir_module_init(out *IRModule, target *IRModuleTarget) int {
    if (out == 0 || target == 0 || out.version != 0 || out.sources != 0 || out.types != 0
        || out.symbols != 0 || out.globals != 0 || out.functions != 0 || out.target.triple != 0
        || out.target.data_layout != 0 || out.target.abi != 0) { return -1 }
    let expected IRModuleTarget
    if (ir_module_target_expected(target.triple, &expected) != 0) { return -1 }
    let checked IRModuleTarget = target[0]
    checked.key = expected.key
    if (ir_module_target_ok(&checked) == 0) { return -1 }
    out.target = checked
    out.target.triple = ir_module_copy_str(target.triple)
    out.target.data_layout = ir_module_copy_str(target.data_layout)
    out.target.abi = ir_module_copy_str(target.abi)
    if (out.target.triple == 0 || out.target.data_layout == 0 || out.target.abi == 0) {
        ir_module_release(out); return -1
    }
    out.version = IR_MODULE_VERSION
    return 0
}

// ir_module_add_source：深拷贝路径和源码，返回新来源下标或 -1；调用者可立即释放输入。
pub fn ir_module_add_source(unit *IRModule, path *char, text *u8, length int) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || ir_module_str_len(path) <= 0
        || length < 0 || length > IR_SERIAL_MAX_BYTES || length > 0 && text == 0) { return -1 }
    let item IRModuleSource
    item.path = ir_module_copy_str(path)
    item.text = ir_module_copy(text.to_type(*void), length).to_type(*u8)
    item.length = length
    if (item.path == 0 || length > 0 && item.text == 0) {
        if (item.path != 0) { free(item.path) }
        if (item.text != 0) { free(item.text) }
        return -1
    }
    let next *IRModuleSource = ir_module_reserve(unit.sources.to_type(*void), unit.source_count,
        &unit.source_capacity, sizeof(IRModuleSource)).to_type(*IRModuleSource)
    if (next == 0) { free(item.path); if (item.text != 0) { free(item.text) } return -1 }
    unit.sources = next; unit.sources[unit.source_count] = item
    unit.source_count += 1
    return unit.source_count - 1
}

// ir_module_type_same：比较两个类型的内容（布局 + 字段 + 签名），名字单独比。
//
// IR 层的类型是结构性的：lowering 用空名字登记数组/指针/切片/函数类型，
// 同一布局会在每个函数里被重复登记（实测 compiler/build 的 907 个类型里
// 有 706 个是重复）。去重后类型编号不再虚高，函数缓存合并时的编号比对
// 也不会退化成结构比较。
fn ir_module_type_same(a *IRModuleType, b *IRModuleType) int {
    if (a.kind != b.kind || a.bits != b.bits || a.size != b.size
        || a.align != b.align || a.elem != b.elem || a.count != b.count
        || a.field_count != b.field_count || a.abi != b.abi
        || a.variadic != b.variadic) { return 0 }
    let i int = 0
    for i < a.field_count {
        if (a.fields[i].type_id != b.fields[i].type_id
            || a.fields[i].offset != b.fields[i].offset) { return 0 }
        i += 1
    }
    return 1
}

// ir_module_add_type：复制布局描述、名义名称和字段；允许前向类型引用，最终由 verifier 封闭。
// 同内容（名字 + 布局 + 字段）已存在时直接返回既有编号，不再追加。
pub fn ir_module_add_type(unit *IRModule, name *char, value *IRModuleType,
    fields *IRModuleField, count int) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || value == 0
        || count < 0 || count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleField)
        || count > 0 && fields == 0) { return -1 }
    let existing int = 0
    for existing < unit.type_count {
        if (ir_module_type_same(&unit.types[existing], value) != 0
            && ir_module_str_eq(unit.types[existing].name, name) != 0) {
            return existing
        }
        existing += 1
    }
    let item IRModuleType = value[0]
    item.name = ir_module_copy_str(name)
    item.fields = ir_module_copy(fields.to_type(*void), count * sizeof(IRModuleField)).to_type(*IRModuleField)
    item.field_count = count
    if (item.name == 0 || count > 0 && item.fields == 0) {
        if (item.name != 0) { free(item.name) }
        if (item.fields != 0) { free(item.fields) }
        return -1
    }
    let next *IRModuleType = ir_module_reserve(unit.types.to_type(*void), unit.type_count,
        &unit.type_capacity, sizeof(IRModuleType)).to_type(*IRModuleType)
    if (next == 0) { free(item.name); if (item.fields != 0) { free(item.fields) } return -1 }
    unit.types = next; unit.types[unit.type_count] = item; unit.type_count += 1
    return unit.type_count - 1
}

// ir_module_symbol_same：合并同名声明之前比较完整签名、可变性和 linkage；来源不影响签名。
fn ir_module_symbol_same(a *IRModuleSymbol, b *IRModuleSymbol, params *int, count int) int {
    if (a.kind != b.kind || a.type_id != b.type_id || a.abi != b.abi || a.variadic != b.variadic
        || a.no_return != b.no_return
        || a.linkage != b.linkage || a.mutable != b.mutable || a.param_count != count) { return 0 }
    let i int = 0
    for i < count { if (a.params[i] != params[i]) { return 0 } i += 1 }
    return 1
}

// ir_module_add_symbol：复制逻辑名和参数类型；一致声明可合并，声明→定义更新来源，双重定义拒绝。
// 返回唯一逻辑符号下标；不写汇编名字、不保存前端绑定号。
pub fn ir_module_add_symbol(unit *IRModule, name *char, value *IRModuleSymbol,
    params *int, count int) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || value == 0 || ir_module_str_len(name) <= 0
        || count < 0 || count > IR_SERIAL_MAX_BYTES / sizeof(int) || count > 0 && params == 0) { return -1 }
    let i int = 0
    for i < unit.symbol_count {
        if (ir_module_str_eq(unit.symbols[i].name, name) != 0) {
            if (ir_module_symbol_same(&unit.symbols[i], value, params, count) == 0
                || unit.symbols[i].defined != 0 && value.defined != 0) { return -1 }
            if (value.defined != 0) {
                unit.symbols[i].defined = value.defined
                unit.symbols[i].source = value.source; unit.symbols[i].offset = value.offset
            }
            return i
        }
        i += 1
    }
    let item IRModuleSymbol = value[0]
    item.name = ir_module_copy_str(name)
    item.params = ir_module_copy(params.to_type(*void), count * sizeof(int)).to_type(*int)
    item.param_count = count
    if (item.name == 0 || count > 0 && item.params == 0) {
        if (item.name != 0) { free(item.name) }
        if (item.params != 0) { free(item.params) }
        return -1
    }
    let next *IRModuleSymbol = ir_module_reserve(unit.symbols.to_type(*void), unit.symbol_count,
        &unit.symbol_capacity, sizeof(IRModuleSymbol)).to_type(*IRModuleSymbol)
    if (next == 0) { free(item.name); if (item.params != 0) { free(item.params) } return -1 }
    unit.symbols = next; unit.symbols[unit.symbol_count] = item; unit.symbol_count += 1
    return unit.symbol_count - 1
}

// ir_module_add_global：复制完整初始化与指针重定位，返回数据实体下标；类型一致性由 verifier 检查。
pub fn ir_module_add_global(unit *IRModule, symbol int, data *u8, size int, align int,
    relocs *IRModuleReloc, count int) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || size < 0 || size > IR_SERIAL_MAX_BYTES
        || size > 0 && data == 0 || count < 0 || count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleReloc)
        || count > 0 && relocs == 0) { return -1 }
    let item IRModuleGlobal
    item.symbol = symbol; item.size = size; item.align = align; item.reloc_count = count
    item.data = ir_module_copy(data.to_type(*void), size).to_type(*u8)
    item.relocs = ir_module_copy(relocs.to_type(*void), count * sizeof(IRModuleReloc)).to_type(*IRModuleReloc)
    if (size > 0 && item.data == 0 || count > 0 && item.relocs == 0) {
        if (item.data != 0) { free(item.data) } if (item.relocs != 0) { free(item.relocs) } return -1
    }
    let next *IRModuleGlobal = ir_module_reserve(unit.globals.to_type(*void), unit.global_count,
        &unit.global_capacity, sizeof(IRModuleGlobal)).to_type(*IRModuleGlobal)
    if (next == 0) {
        if (item.data != 0) { free(item.data) } if (item.relocs != 0) { free(item.relocs) } return -1
    }
    unit.globals = next; unit.globals[unit.global_count] = item; unit.global_count += 1
    return unit.global_count - 1
}

// ir_module_add_function：用既有稳定编码深拷贝全部 SSA 表，复制私有→模块类型映射与指令来源。
// locs 为空时以逻辑符号的来源填充每条指令；输入不转移所有权，失败释放部分副本。
pub fn ir_module_add_function(unit *IRModule, symbol int, body *IRFunction,
    type_map *int, locs *IRModuleLoc) int {
    if (unit == 0 || unit.version != IR_MODULE_VERSION || body == 0 || type_map == 0
        || symbol < 0 || symbol >= unit.symbol_count || body.target_id != unit.target.key) { return -1 }
    let size int = ir_serialized_size(body)
    if (size < 0) { return -1 }
    let data *u8 = malloc(size.to_type(u64)).to_type(*u8)
    if (data == 0) { return -1 }
    let item IRModuleFunction
    item.symbol = symbol
    let ok int = ir_serialize(body, data, size)
    if (ok == size) { ok = ir_deserialize(&item.body, data, size, unit.target.key) }
    else { ok = -1 }
    free(data)
    if (ok != 0) { return -1 }
    item.type_map_count = body.type_count
    item.type_map = ir_module_copy(type_map.to_type(*void), body.type_count * sizeof(int)).to_type(*int)
    item.loc_count = body.inst_count
    if (body.inst_count > 0) {
        item.locs = malloc((body.inst_count * sizeof(IRModuleLoc)).to_type(u64)).to_type(*IRModuleLoc)
    }
    if (item.type_map == 0 || body.inst_count > 0 && item.locs == 0) {
        ir_function_release(&item.body)
        if (item.type_map != 0) { free(item.type_map) } if (item.locs != 0) { free(item.locs) } return -1
    }
    let i int = 0
    for i < body.inst_count {
        if (locs != 0) { item.locs[i] = locs[i] }
        else { item.locs[i].source = unit.symbols[symbol].source; item.locs[i].offset = unit.symbols[symbol].offset }
        i += 1
    }
    let next *IRModuleFunction = ir_module_reserve(unit.functions.to_type(*void), unit.function_count,
        &unit.function_capacity, sizeof(IRModuleFunction)).to_type(*IRModuleFunction)
    if (next == 0) {
        ir_function_release(&item.body); free(item.type_map); if (item.locs != 0) { free(item.locs) } return -1
    }
    unit.functions = next; unit.functions[unit.function_count] = item; unit.function_count += 1
    return unit.function_count - 1
}

// ir_module_release：仅释放增建接口产生的独占表；清空全部指针/计数/身份，重复调用安全。
pub fn ir_module_release(unit *IRModule) void {
    if (unit == 0) { return }
    let i int = 0
    for i < unit.source_count {
        free(unit.sources[i].path); if (unit.sources[i].text != 0) { free(unit.sources[i].text) } i += 1
    }
    i = 0
    for i < unit.type_count {
        free(unit.types[i].name); if (unit.types[i].fields != 0) { free(unit.types[i].fields) } i += 1
    }
    i = 0
    for i < unit.symbol_count {
        free(unit.symbols[i].name); if (unit.symbols[i].params != 0) { free(unit.symbols[i].params) } i += 1
    }
    i = 0
    for i < unit.global_count {
        if (unit.globals[i].data != 0) { free(unit.globals[i].data) }
        if (unit.globals[i].relocs != 0) { free(unit.globals[i].relocs) } i += 1
    }
    i = 0
    for i < unit.function_count {
        ir_function_release(&unit.functions[i].body); free(unit.functions[i].type_map)
        if (unit.functions[i].locs != 0) { free(unit.functions[i].locs) } i += 1
    }
    if (unit.sources != 0) { free(unit.sources) } if (unit.types != 0) { free(unit.types) }
    if (unit.symbols != 0) { free(unit.symbols) } if (unit.globals != 0) { free(unit.globals) }
    if (unit.functions != 0) { free(unit.functions) }
    if (unit.target.triple != 0) { free(unit.target.triple) }
    if (unit.target.data_layout != 0) { free(unit.target.data_layout) }
    if (unit.target.abi != 0) { free(unit.target.abi) }
    unit.version = 0; unit.target.triple = 0; unit.target.data_layout = 0; unit.target.abi = 0
    unit.target.pointer_bits = 0; unit.target.little_endian = 0; unit.target.layout_version = 0; unit.target.key = 0
    unit.sources = 0; unit.source_count = 0; unit.source_capacity = 0
    unit.types = 0; unit.type_count = 0; unit.type_capacity = 0
    unit.symbols = 0; unit.symbol_count = 0; unit.symbol_capacity = 0
    unit.globals = 0; unit.global_count = 0; unit.global_capacity = 0
    unit.functions = 0; unit.function_count = 0; unit.function_capacity = 0
}
