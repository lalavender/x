module ir

// ir_module_copy：复制一个有界字节区间；零长不分配，失败返回空指针。
fn ir_module_copy(data *void, size int) *void {
    if (size <= 0 || size > IR_SERIAL_MAX_BYTES || data == 0) { return 0 }
    let copy *void = malloc(size.to_type(u64))
    if (copy != 0) { memcpy(copy, data, size.to_type(u64)) }
    return copy
}

// ir_module_copy_str：创建自有 C 字符串，包括空字符串；失败不取得输入所有权。
fn ir_module_copy_str(value *char) *char {
    let n int = ir_module_str_len(value)
    if (n < 0 || n >= IR_SERIAL_MAX_BYTES) { return 0 }
    return ir_module_copy(value.to_type(*void), n + 1).to_type(*char)
}

// ir_module_reserve：为五个真实可增长表共用扩容；仅搬移表项，子项独占指针保持所有权。
// 容量按倍数增长且受现有 IR 规模上限约束，失败时不释放旧表或改写容量。
fn ir_module_reserve(data *void, count int, capacity *int, item_size int) *void {
    if (count < 0 || count >= IR_SERIAL_MAX_ITEMS || capacity[0] < count || item_size <= 0) { return 0 }
    if (count < capacity[0]) { return data }
    let next int = capacity[0] * 2
    if (next == 0) { next = 8 }
    if (next > IR_SERIAL_MAX_ITEMS || next > IR_SERIAL_MAX_BYTES / item_size) { return 0 }
    let result *void = malloc((next * item_size).to_type(u64))
    if (result == 0) { return 0 }
    if (count > 0) { memcpy(result, data, (count * item_size).to_type(u64)) }
    if (data != 0) { free(data) }
    capacity[0] = next
    return result
}

// ir_module_type_same：比较两个类型的内容（布局 + 字段 + 签名），名字单独比。
//
// IR 层的类型是结构性的：lowering 用空名字登记数组/指针/切片/函数类型，
// 同一布局会在每个函数里被重复登记（实测 compiler/build 的 907 个类型里
// 有 706 个是重复）。去重后类型编号不再虚高，函数缓存合并时的编号比对
// 也不会退化成结构比较。
fn ir_module_type_same(a *IRModuleType, b *IRModuleType) int {
    if (a.kind != b.kind || a.bits != b.bits || a.size != b.size
        || a.align != b.align || a.elem != b.elem || a.count != b.count
        || a.field_count != b.field_count || a.abi != b.abi
        || a.variadic != b.variadic) { return 0 }
    let i int = 0
    for i < a.field_count {
        if (a.fields[i].type_id != b.fields[i].type_id
            || a.fields[i].offset != b.fields[i].offset) { return 0 }
        i += 1
    }
    return 1
}

// ir_module_symbol_same：合并同名声明之前比较完整签名、可变性和 linkage；来源不影响签名。
fn ir_module_symbol_same(a *IRModuleSymbol, b *IRModuleSymbol, params *int, count int) int {
    if (a.kind != b.kind || a.type_id != b.type_id || a.abi != b.abi || a.variadic != b.variadic
        || a.no_return != b.no_return
        || a.linkage != b.linkage || a.mutable != b.mutable || a.param_count != count) { return 0 }
    let i int = 0
    for i < count { if (a.params[i] != params[i]) { return 0 } i += 1 }
    return 1
}

