module ir

const IR_SERIAL_MAGIC u64 = 0x3141535352494859
const IR_SERIAL_MAX_ITEMS int = 1048576
const IR_SERIAL_MAX_BLOCKS int = 4096
const IR_SERIAL_MAX_BYTES int = 67108864

// 写入一个小端 64 位字；格式中的所有标量都占八字节。
fn ir_serial_put_u64(out *u8, cursor *int, value u64) void {
    let i int = 0
    for i < 8 {
        out[*cursor + i] = ((value >> (i * 8)) & 255).to_type(u8)
        i += 1
    }
    *cursor = *cursor + 8
}

// 写入 int 的二进制位型，负数按二进制补码保存。
fn ir_serial_put_int(out *u8, cursor *int, value int) void {
    ir_serial_put_u64(out, cursor, value.to_type(i64).to_type(u64))
}

// 读取一个小端 64 位字；调用前必须验证剩余输入至少八字节。
fn ir_serial_get_u64(data *u8, cursor *int) u64 {
    let value u64 = 0
    let i int = 0
    for i < 8 {
        value = value | (data[*cursor + i].to_type(u64) << (i * 8))
        i += 1
    }
    *cursor = *cursor + 8
    return value
}

// 读取 int 的补码位型；调用方会先排除需保持非负的头字段溢出。
fn ir_serial_get_int(data *u8, cursor *int) int {
    return ir_serial_get_u64(data, cursor).to_type(i64).to_type(int)
}

// 根据各数组长度计算固定格式长度，并限制反序列化可分配的规模。
fn ir_serial_size_counts(type_count int, inst_count int, phi_count int,
    phi_input_count int, call_count int, call_arg_count int,
    call_symbol_size int, block_count int, value_count int) int {
    if (type_count <= 0 || type_count > IR_SERIAL_MAX_ITEMS || inst_count < 0
        || inst_count > IR_SERIAL_MAX_ITEMS || phi_count < 0 || phi_count > IR_SERIAL_MAX_ITEMS
        || phi_input_count < 0 || phi_input_count > IR_SERIAL_MAX_ITEMS
        || call_count < 0 || call_count > IR_SERIAL_MAX_ITEMS
        || call_arg_count < 0 || call_arg_count > IR_SERIAL_MAX_ITEMS
        || call_symbol_size < 0 || call_symbol_size > IR_SERIAL_MAX_BYTES
        || block_count <= 0
        || block_count > IR_SERIAL_MAX_BLOCKS || value_count < 0 || value_count > IR_SERIAL_MAX_ITEMS) {
        return -1
    }
    let words int = 14 + type_count * 3 + inst_count * 7 + phi_count * 2 +
        phi_input_count * 2 + call_count * 7 + call_arg_count * 2 +
        (call_symbol_size + 7) / 8 + block_count * 7
    if (words > IR_SERIAL_MAX_BYTES / 8) { return -1 }
    return words * 8
}

// 确认非负头字段可安全转成当前 64 位 int。
fn ir_serial_header_int_ok(value u64) int {
    return value <= 0x7FFFFFFFFFFFFFFF ? 1 : 0
}

