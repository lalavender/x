module ir;

// IR 序列化格式版本。格式只写逻辑字段，不依赖宿主结构体布局或指针。
pub const IR_SERIAL_VERSION int = 4;
const IR_SERIAL_MAGIC u64 = 0x3141535352494859;
const IR_SERIAL_MAX_ITEMS int = 1048576;
const IR_SERIAL_MAX_BLOCKS int = 4096;
const IR_SERIAL_MAX_BYTES int = 67108864;

// 写入一个小端 64 位字；格式中的所有标量都占八字节。
fn ir_serial_put_u64(out *u8, cursor *int, value u64) void {
    let i int = 0;
    for i < 8 {
        out[*cursor + i] = ((value >> (i * 8)) & 255).to_type(u8);
        i += 1;
    }
    *cursor = *cursor + 8;
}

// 写入 int 的二进制位型，负数按二进制补码保存。
fn ir_serial_put_int(out *u8, cursor *int, value int) void {
    ir_serial_put_u64(out, cursor, value.to_type(i64).to_type(u64));
}

// 读取一个小端 64 位字；调用前必须验证剩余输入至少八字节。
fn ir_serial_get_u64(data *u8, cursor *int) u64 {
    let value u64 = 0;
    let i int = 0;
    for i < 8 {
        value = value | (data[*cursor + i].to_type(u64) << (i * 8));
        i += 1;
    }
    *cursor = *cursor + 8;
    return value;
}

// 读取 int 的补码位型；调用方会先排除需保持非负的头字段溢出。
fn ir_serial_get_int(data *u8, cursor *int) int {
    return ir_serial_get_u64(data, cursor).to_type(i64).to_type(int);
}

// 根据各数组长度计算固定格式长度，并限制反序列化可分配的规模。
fn ir_serial_size_counts(type_count int, inst_count int, phi_count int,
    phi_input_count int, call_count int, call_arg_count int,
    call_symbol_size int, block_count int, value_count int) int {
    if (type_count <= 0 || type_count > IR_SERIAL_MAX_ITEMS || inst_count < 0
        || inst_count > IR_SERIAL_MAX_ITEMS || phi_count < 0 || phi_count > IR_SERIAL_MAX_ITEMS
        || phi_input_count < 0 || phi_input_count > IR_SERIAL_MAX_ITEMS
        || call_count < 0 || call_count > IR_SERIAL_MAX_ITEMS
        || call_arg_count < 0 || call_arg_count > IR_SERIAL_MAX_ITEMS
        || call_symbol_size < 0 || call_symbol_size > IR_SERIAL_MAX_BYTES
        || block_count <= 0
        || block_count > IR_SERIAL_MAX_BLOCKS || value_count < 0 || value_count > IR_SERIAL_MAX_ITEMS) {
        return -1;
    }
    let words int = 13 + type_count * 3 + inst_count * 7 + phi_count * 2
        + phi_input_count * 2 + call_count * 4 + call_arg_count * 2
        + (call_symbol_size + 7) / 8 + block_count * 7;
    if (words > IR_SERIAL_MAX_BYTES / 8) { return -1; }
    return words * 8;
}

// 返回有效函数的稳定编码长度；无效 IR 或超限输入返回 -1。
pub fn ir_serialized_size(f *IRFunction) int {
    if (f == 0 || f.target_id < 0) {
        return -1;
    }
    let size int = ir_serial_size_counts(f.type_count, f.inst_count, f.phi_count,
        f.phi_input_count, f.call_count, f.call_arg_count,
        f.call_symbol_size, f.block_count, f.value_count);
    if (size < 0 || ir_verify(f) != 0) { return -1; }
    return size;
}

// 将通过 verifier 的函数写入调用方缓冲区，返回实际长度或 -1。
pub fn ir_serialize(f *IRFunction, out *u8, capacity int) int {
    let size int = ir_serialized_size(f);
    if (size < 0 || out == 0 || capacity < size) { return -1; }
    let cursor int = 0;
    ir_serial_put_u64(out, &cursor, IR_SERIAL_MAGIC);
    ir_serial_put_u64(out, &cursor, IR_SERIAL_VERSION.to_type(u64));
    ir_serial_put_int(out, &cursor, f.target_id);
    ir_serial_put_int(out, &cursor, f.ret_type);
    ir_serial_put_int(out, &cursor, f.type_count);
    ir_serial_put_int(out, &cursor, f.inst_count);
    ir_serial_put_int(out, &cursor, f.phi_count);
    ir_serial_put_int(out, &cursor, f.phi_input_count);
    ir_serial_put_int(out, &cursor, f.call_count);
    ir_serial_put_int(out, &cursor, f.call_arg_count);
    ir_serial_put_int(out, &cursor, f.call_symbol_size);
    ir_serial_put_int(out, &cursor, f.block_count);
    ir_serial_put_int(out, &cursor, f.value_count);

    let i int = 0;
    for i < f.type_count {
        ir_serial_put_int(out, &cursor, f.types[i].kind);
        ir_serial_put_int(out, &cursor, f.types[i].elem);
        ir_serial_put_int(out, &cursor, f.types[i].bits);
        i += 1;
    }
    i = 0;
    for i < f.inst_count {
        let inst IRInst = f.insts[i];
        ir_serial_put_int(out, &cursor, inst.op);
        ir_serial_put_int(out, &cursor, inst.result_id);
        ir_serial_put_int(out, &cursor, inst.result_type);
        ir_serial_put_int(out, &cursor, inst.a);
        ir_serial_put_int(out, &cursor, inst.b);
        ir_serial_put_u64(out, &cursor, inst.imm.to_type(u64));
        ir_serial_put_int(out, &cursor, inst.aux);
        i += 1;
    }
    i = 0;
    for i < f.phi_count {
        ir_serial_put_int(out, &cursor, f.phis[i].first);
        ir_serial_put_int(out, &cursor, f.phis[i].count);
        i += 1;
    }
    i = 0;
    for i < f.phi_input_count {
        ir_serial_put_int(out, &cursor, f.phi_inputs[i].pred);
        ir_serial_put_int(out, &cursor, f.phi_inputs[i].value);
        i += 1;
    }
    i = 0;
    for i < f.call_count {
        ir_serial_put_int(out, &cursor, f.calls[i].symbol_first);
        ir_serial_put_int(out, &cursor, f.calls[i].symbol_len);
        ir_serial_put_int(out, &cursor, f.calls[i].arg_first);
        ir_serial_put_int(out, &cursor, f.calls[i].arg_count);
        i += 1;
    }
    i = 0;
    for i < f.call_arg_count {
        ir_serial_put_int(out, &cursor, f.call_args[i].value);
        ir_serial_put_int(out, &cursor, f.call_args[i].type_id);
        i += 1;
    }
    i = 0;
    for i < f.call_symbol_size {
        out[cursor] = f.call_symbols[i];
        cursor += 1;
        i += 1;
    }
    for cursor % 8 != 0 {
        out[cursor] = 0;
        cursor += 1;
    }
    i = 0;
    for i < f.block_count {
        let block IRBlock = f.blocks[i];
        ir_serial_put_int(out, &cursor, block.id);
        ir_serial_put_int(out, &cursor, block.first_inst);
        ir_serial_put_int(out, &cursor, block.inst_count);
        ir_serial_put_int(out, &cursor, block.term);
        ir_serial_put_int(out, &cursor, block.term_value);
        ir_serial_put_int(out, &cursor, block.succ0);
        ir_serial_put_int(out, &cursor, block.succ1);
        i += 1;
    }
    return cursor == size ? cursor : -1;
}

// 释放 ir_deserialize 所拥有的数组，并将函数重置为空状态。
pub fn ir_function_release(f *IRFunction) void {
    if (f == 0) { return; }
    if (f.types != 0) { free(f.types); }
    if (f.insts != 0) { free(f.insts); }
    if (f.phis != 0) { free(f.phis); }
    if (f.phi_inputs != 0) { free(f.phi_inputs); }
    if (f.calls != 0) { free(f.calls); }
    if (f.call_args != 0) { free(f.call_args); }
    if (f.call_symbols != 0) { free(f.call_symbols); }
    if (f.blocks != 0) { free(f.blocks); }
    f.target_id = -1;
    f.ret_type = -1;
    f.types = 0;
    f.type_count = 0;
    f.insts = 0;
    f.inst_count = 0;
    f.phis = 0;
    f.phi_count = 0;
    f.phi_inputs = 0;
    f.phi_input_count = 0;
    f.calls = 0;
    f.call_count = 0;
    f.call_args = 0;
    f.call_arg_count = 0;
    f.call_symbols = 0;
    f.call_symbol_size = 0;
    f.blocks = 0;
    f.block_count = 0;
    f.value_count = 0;
}

// 确认非负头字段可安全转成当前 64 位 int。
fn ir_serial_header_int_ok(value u64) int {
    return value <= 0x7FFFFFFFFFFFFFFF ? 1 : 0;
}

// 从指定目标的稳定字节流创建 IR；失败时释放部分分配并重置 out。
// out 的指针字段必须为零；成功后由 ir_function_release 释放。
pub fn ir_deserialize(out *IRFunction, data *u8, length int, expected_target int) int {
    if (out == 0 || data == 0 || length < 104 || expected_target < 0
        || out.types != 0 || out.insts != 0 || out.phis != 0
        || out.phi_inputs != 0 || out.calls != 0 || out.call_args != 0
        || out.call_symbols != 0 || out.blocks != 0) {
        return -1;
    }
    ir_function_release(out);
    let cursor int = 0;
    if (ir_serial_get_u64(data, &cursor) != IR_SERIAL_MAGIC
        || ir_serial_get_u64(data, &cursor) != IR_SERIAL_VERSION.to_type(u64)) {
        return -1;
    }
    let target_raw u64 = ir_serial_get_u64(data, &cursor);
    let ret_raw u64 = ir_serial_get_u64(data, &cursor);
    let types_raw u64 = ir_serial_get_u64(data, &cursor);
    let insts_raw u64 = ir_serial_get_u64(data, &cursor);
    let phis_raw u64 = ir_serial_get_u64(data, &cursor);
    let inputs_raw u64 = ir_serial_get_u64(data, &cursor);
    let calls_raw u64 = ir_serial_get_u64(data, &cursor);
    let args_raw u64 = ir_serial_get_u64(data, &cursor);
    let symbols_raw u64 = ir_serial_get_u64(data, &cursor);
    let blocks_raw u64 = ir_serial_get_u64(data, &cursor);
    let values_raw u64 = ir_serial_get_u64(data, &cursor);
    if (ir_serial_header_int_ok(target_raw) == 0 || ir_serial_header_int_ok(ret_raw) == 0
        || ir_serial_header_int_ok(types_raw) == 0 || ir_serial_header_int_ok(insts_raw) == 0
        || ir_serial_header_int_ok(phis_raw) == 0 || ir_serial_header_int_ok(inputs_raw) == 0
        || ir_serial_header_int_ok(calls_raw) == 0 || ir_serial_header_int_ok(args_raw) == 0
        || ir_serial_header_int_ok(symbols_raw) == 0
        || ir_serial_header_int_ok(blocks_raw) == 0 || ir_serial_header_int_ok(values_raw) == 0) {
        return -1;
    }
    let target int = target_raw.to_type(int);
    let ret_type int = ret_raw.to_type(int);
    let type_count int = types_raw.to_type(int);
    let inst_count int = insts_raw.to_type(int);
    let phi_count int = phis_raw.to_type(int);
    let phi_input_count int = inputs_raw.to_type(int);
    let call_count int = calls_raw.to_type(int);
    let call_arg_count int = args_raw.to_type(int);
    let call_symbol_size int = symbols_raw.to_type(int);
    let block_count int = blocks_raw.to_type(int);
    let value_count int = values_raw.to_type(int);
    let size int = ir_serial_size_counts(type_count, inst_count, phi_count,
        phi_input_count, call_count, call_arg_count, call_symbol_size,
        block_count, value_count);
    if (target != expected_target || size != length) { return -1; }

    out.target_id = target;
    out.ret_type = ret_type;
    out.type_count = type_count;
    out.inst_count = inst_count;
    out.phi_count = phi_count;
    out.phi_input_count = phi_input_count;
    out.call_count = call_count;
    out.call_arg_count = call_arg_count;
    out.call_symbol_size = call_symbol_size;
    out.block_count = block_count;
    out.value_count = value_count;
    out.types = malloc((type_count * sizeof(IRType)).to_type(u64)).to_type(*IRType);
    if (out.types == 0) { ir_function_release(out); return -1; }
    if (inst_count > 0) {
        out.insts = malloc((inst_count * sizeof(IRInst)).to_type(u64)).to_type(*IRInst);
        if (out.insts == 0) { ir_function_release(out); return -1; }
    }
    if (phi_count > 0) {
        out.phis = malloc((phi_count * sizeof(IRPhi)).to_type(u64)).to_type(*IRPhi);
        if (out.phis == 0) { ir_function_release(out); return -1; }
    }
    if (phi_input_count > 0) {
        out.phi_inputs = malloc((phi_input_count * sizeof(IRPhiInput)).to_type(u64)).to_type(*IRPhiInput);
        if (out.phi_inputs == 0) { ir_function_release(out); return -1; }
    }
    if (call_count > 0) {
        out.calls = malloc((call_count * sizeof(IRCall)).to_type(u64)).to_type(*IRCall);
        if (out.calls == 0) { ir_function_release(out); return -1; }
    }
    if (call_arg_count > 0) {
        out.call_args = malloc((call_arg_count * sizeof(IRCallArg)).to_type(u64)).to_type(*IRCallArg);
        if (out.call_args == 0) { ir_function_release(out); return -1; }
    }
    if (call_symbol_size > 0) {
        out.call_symbols = malloc(call_symbol_size.to_type(u64)).to_type(*u8);
        if (out.call_symbols == 0) { ir_function_release(out); return -1; }
    }
    out.blocks = malloc((block_count * sizeof(IRBlock)).to_type(u64)).to_type(*IRBlock);
    if (out.blocks == 0) { ir_function_release(out); return -1; }

    let i int = 0;
    for i < type_count {
        out.types[i].kind = ir_serial_get_int(data, &cursor);
        out.types[i].elem = ir_serial_get_int(data, &cursor);
        out.types[i].bits = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < inst_count {
        out.insts[i].op = ir_serial_get_int(data, &cursor);
        out.insts[i].result_id = ir_serial_get_int(data, &cursor);
        out.insts[i].result_type = ir_serial_get_int(data, &cursor);
        out.insts[i].a = ir_serial_get_int(data, &cursor);
        out.insts[i].b = ir_serial_get_int(data, &cursor);
        out.insts[i].imm = ir_serial_get_u64(data, &cursor).to_type(i64);
        out.insts[i].aux = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < phi_count {
        out.phis[i].first = ir_serial_get_int(data, &cursor);
        out.phis[i].count = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < phi_input_count {
        out.phi_inputs[i].pred = ir_serial_get_int(data, &cursor);
        out.phi_inputs[i].value = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < call_count {
        out.calls[i].symbol_first = ir_serial_get_int(data, &cursor);
        out.calls[i].symbol_len = ir_serial_get_int(data, &cursor);
        out.calls[i].arg_first = ir_serial_get_int(data, &cursor);
        out.calls[i].arg_count = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < call_arg_count {
        out.call_args[i].value = ir_serial_get_int(data, &cursor);
        out.call_args[i].type_id = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    i = 0;
    for i < call_symbol_size {
        out.call_symbols[i] = data[cursor];
        cursor += 1;
        i += 1;
    }
    for cursor % 8 != 0 {
        if (data[cursor] != 0) { ir_function_release(out); return -1; }
        cursor += 1;
    }
    i = 0;
    for i < block_count {
        out.blocks[i].id = ir_serial_get_int(data, &cursor);
        out.blocks[i].first_inst = ir_serial_get_int(data, &cursor);
        out.blocks[i].inst_count = ir_serial_get_int(data, &cursor);
        out.blocks[i].term = ir_serial_get_int(data, &cursor);
        out.blocks[i].term_value = ir_serial_get_int(data, &cursor);
        out.blocks[i].succ0 = ir_serial_get_int(data, &cursor);
        out.blocks[i].succ1 = ir_serial_get_int(data, &cursor);
        i += 1;
    }
    if (cursor != length || ir_verify(out) != 0) {
        ir_function_release(out);
        return -1;
    }
    return 0;
}
