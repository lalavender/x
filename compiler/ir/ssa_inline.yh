module ir

// ir_inline_candidate_ok：限定为单块、无调用的固定整数标量函数。
// 其余形态由调用者保留普通 CALL，避免把控制流和副作用移入新框架。
pub fn ir_inline_candidate_ok(f *IRFunction) int {
    if (f == 0 || ir_verify(f) != 0 || f.block_count != 1 || f.phi_count != 0
        || f.call_count != 0 || f.call_arg_count != 0 || f.call_symbol_size != 0
        || f.inst_count > 32 || ir_integer_type(f.types[f.ret_type].kind) == 0) {
        return 0
    }
    let block IRBlock = f.blocks[0]
    if (block.term != IR_TERM_RET || block.term_value < 0) { return 0 }
    let ret_type int = ir_find_value_type(f, block.term_value)
    if (ret_type != f.ret_type) { return 0 }
    let i int = 0
    let saw_body int = 0
    for i < block.inst_count {
        let inst IRInst = f.insts[block.first_inst + i]
        if (inst.op == IR_OP_PARAM) {
            if (saw_body != 0) { return 0 }
        } else {
            saw_body = 1
            if (inst.op != IR_OP_CONST && inst.op != IR_OP_COPY
                && inst.op != IR_OP_ADD && inst.op != IR_OP_SUB
                && inst.op != IR_OP_MUL && inst.op != IR_OP_DIV
                && inst.op != IR_OP_REM && inst.op != IR_OP_BAND
                && inst.op != IR_OP_BOR && inst.op != IR_OP_BXOR
                && inst.op != IR_OP_SHL && inst.op != IR_OP_SHR
                && inst.op != IR_OP_EQ && inst.op != IR_OP_NE
                && inst.op != IR_OP_LT && inst.op != IR_OP_LE
                && inst.op != IR_OP_GT && inst.op != IR_OP_GE) {
                return 0
            }
            if (inst.result_id >= 0
                && ir_integer_type(f.types[inst.result_type].kind) == 0) {
                return 0
            }
        }
        i += 1
    }
    return 1
}

// ir_inline_symbol_equal：按长度和字节比较缓存中的完整调用符号。
fn ir_inline_symbol_equal(f *IRFunction, call *IRCall,
    symbol *u8, symbol_len int) int {
    if (call.symbol_len != symbol_len) { return 0 }
    let i int = 0
    for i < symbol_len {
        if (f.call_symbols[call.symbol_first + i] != symbol[i]) { return 0 }
        i += 1
    }
    return 1
}

// ir_inline_append_copy：追加用于把形参直接返回映射到原 CALL 结果编号的 COPY。
fn ir_inline_append_copy(out *IRInst, next *int, result_id int,
    result_type int, value int) int {
    if (result_id < 0 || result_type < 0 || value < 0) { return -1 }
    out[next[0]].op = IR_OP_COPY
    out[next[0]].result_id = result_id
    out[next[0]].result_type = result_type
    out[next[0]].a = value
    out[next[0]].b = -1
    out[next[0]].imm = 0
    out[next[0]].aux = -1
    next[0] += 1
    return 0
}

// ir_inline_one：把匹配 target 的标量直接调用替换为 callee 的纯 SSA 指令。
// 返回展开调用数；形态或签名不符返回 0，IR/内存错误返回 -1。
pub fn ir_inline_one(f *IRFunction, callee *IRFunction,
    target *u8, target_len int) int {
    if (f == 0 || callee == 0 || target == 0 || target_len <= 0
        || ir_inline_candidate_ok(callee) == 0 || ir_verify(f) != 0) {
        return 0
    }
    let entry IRBlock = callee.blocks[0]
    let param_count int = 0
    for param_count < entry.inst_count &&
        callee.insts[entry.first_inst + param_count].op == IR_OP_PARAM {
        param_count += 1
    }
    let matches int = 0
    let i int = 0
    for i < f.inst_count {
        let inst IRInst = f.insts[i]
        if (inst.op == IR_OP_CALL) {
            let call IRCall = f.calls[inst.aux]
            if (ir_inline_symbol_equal(f, &call, target, target_len) != 0) {
                if (inst.result_id < 0 || inst.result_type != callee.ret_type
                    || call.abi != callee.abi || call.arg_count != param_count) { return 0 }
                let pi int = 0
                for pi < param_count {
                    let param IRInst = callee.insts[entry.first_inst + pi]
                    let arg IRCallArg = f.call_args[call.arg_first + pi]
                    if (arg.type_id != param.result_type) { return 0 }
                    pi += 1
                }
                matches += 1
            }
        }
        i += 1
    }
    if (matches == 0) { return 0 }
    if (f.inst_count > 1048576 - matches * (callee.inst_count + 1)
        || f.value_count > 1048576 - matches * callee.inst_count) {
        return -1
    }
    let inst_cap int = f.inst_count + matches * (callee.inst_count + 1)
    let new_insts *IRInst = malloc((inst_cap * sizeof(IRInst)).to_type(u64)) .
        to_type(*IRInst)
    let new_blocks *IRBlock = malloc((f.block_count * sizeof(IRBlock)).to_type(u64)) .
        to_type(*IRBlock)
    let new_calls *IRCall = 0
    let new_args *IRCallArg = 0
    let new_symbols *u8 = 0
    let map_count int = callee.value_count > 0 ? callee.value_count : 1
    let value_map *int = malloc((map_count * sizeof(int)).to_type(u64)).to_type(*int)
    if (f.call_count > 0) {
        new_calls = malloc((f.call_count * sizeof(IRCall)).to_type(u64)).to_type(*IRCall)
    }
    if (f.call_arg_count > 0) {
        new_args = malloc((f.call_arg_count * sizeof(IRCallArg)).to_type(u64)) .
            to_type(*IRCallArg)
    }
    if (f.call_symbol_size > 0) {
        new_symbols = malloc(f.call_symbol_size.to_type(u64)).to_type(*u8)
    }
    if (new_insts == 0 || new_blocks == 0 || value_map == 0
        || f.call_count > 0 && new_calls == 0
        || f.call_arg_count > 0 && new_args == 0
        || f.call_symbol_size > 0 && new_symbols == 0) {
        if (new_insts != 0) { free(new_insts) }
        if (new_blocks != 0) { free(new_blocks) }
        if (value_map != 0) { free(value_map) }
        if (new_calls != 0) { free(new_calls) }
        if (new_args != 0) { free(new_args) }
        if (new_symbols != 0) { free(new_symbols) }
        return -1
    }
    let mi int = 0
    for mi < map_count { value_map[mi] = -1; mi += 1 }
    let new_inst_n int = 0
    let new_call_n int = 0
    let new_arg_n int = 0
    let new_symbol_n int = 0
    let next_value int = f.value_count
    let inlined int = 0
    let bi int = 0
    for bi < f.block_count {
        let block IRBlock = f.blocks[bi]
        new_blocks[bi] = block
        new_blocks[bi].first_inst = new_inst_n
        let ii int = 0
        for ii < block.inst_count {
            let inst IRInst = f.insts[block.first_inst + ii]
            if (inst.op != IR_OP_CALL) {
                new_insts[new_inst_n] = inst
                new_inst_n += 1
                ii += 1
                continue
            }
            let old_call IRCall = f.calls[inst.aux]
            if (ir_inline_symbol_equal(f, &old_call, target, target_len) == 0) {
                let call IRCall = old_call
                call.symbol_first = new_symbol_n
                call.arg_first = new_arg_n
                let ai int = 0
                for ai < old_call.arg_count {
                    new_args[new_arg_n] = f.call_args[old_call.arg_first + ai]
                    new_arg_n += 1
                    ai += 1
                }
                let si int = 0
                for si < old_call.symbol_len {
                    new_symbols[new_symbol_n] = f.call_symbols[old_call.symbol_first + si]
                    new_symbol_n += 1
                    si += 1
                }
                new_calls[new_call_n] = call
                inst.aux = new_call_n
                new_call_n += 1
                new_insts[new_inst_n] = inst
                new_inst_n += 1
                ii += 1
                continue
            }

            let call IRCall = old_call
            let pi2 int = 0
            for pi2 < param_count {
                let param IRInst = callee.insts[entry.first_inst + pi2]
                value_map[param.result_id] = f.call_args[call.arg_first + pi2].value
                pi2 += 1
            }
            let return_defined int = 0
            let ci int = 0
            for ci < entry.inst_count {
                let source IRInst = callee.insts[entry.first_inst + ci]
                if (source.op == IR_OP_PARAM) {
                    ci += 1
                    continue
                }
                let clone IRInst = source
                if (source.a >= 0) {
                    if (source.a >= map_count || value_map[source.a] < 0) {
                        free(new_insts); free(new_blocks); free(value_map)
                        if (new_calls != 0) { free(new_calls) }
                        if (new_args != 0) { free(new_args) }
                        if (new_symbols != 0) { free(new_symbols) }
                        return -1
                    }
                    clone.a = value_map[source.a]
                }
                if (source.b >= 0) {
                    if (source.b >= map_count || value_map[source.b] < 0) {
                        free(new_insts); free(new_blocks); free(value_map)
                        if (new_calls != 0) { free(new_calls) }
                        if (new_args != 0) { free(new_args) }
                        if (new_symbols != 0) { free(new_symbols) }
                        return -1
                    }
                    clone.b = value_map[source.b]
                }
                if (source.result_id >= 0) {
                    if (source.result_id == entry.term_value) {
                        clone.result_id = inst.result_id
                        return_defined = 1
                    } else {
                        clone.result_id = next_value
                        next_value += 1
                    }
                    value_map[source.result_id] = clone.result_id
                }
                new_insts[new_inst_n] = clone
                new_inst_n += 1
                ci += 1
            }
            if (return_defined == 0) {
                if (entry.term_value < 0 || entry.term_value >= map_count
                    || ir_inline_append_copy(new_insts, &new_inst_n,
                        inst.result_id, inst.result_type,
                        value_map[entry.term_value]) != 0) {
                    free(new_insts); free(new_blocks); free(value_map)
                    if (new_calls != 0) { free(new_calls) }
                    if (new_args != 0) { free(new_args) }
                    if (new_symbols != 0) { free(new_symbols) }
                    return -1
                }
            }
            inlined += 1
            ii += 1
        }
        new_blocks[bi].inst_count = new_inst_n - new_blocks[bi].first_inst
        bi += 1
    }
    free(value_map)
    if (inlined != matches || ir_verify_call_table(f) != 0) {
        free(new_insts); free(new_blocks)
        if (new_calls != 0) { free(new_calls) }
        if (new_args != 0) { free(new_args) }
        if (new_symbols != 0) { free(new_symbols) }
        return -1
    }
    if (f.insts != 0) { free(f.insts) }
    if (f.blocks != 0) { free(f.blocks) }
    if (f.calls != 0) { free(f.calls) }
    if (f.call_args != 0) { free(f.call_args) }
    if (f.call_symbols != 0) { free(f.call_symbols) }
    f.insts = new_insts
    f.inst_count = new_inst_n
    f.blocks = new_blocks
    f.calls = new_calls
    f.call_count = new_call_n
    f.call_args = new_args
    f.call_arg_count = new_arg_n
    f.call_symbols = new_symbols
    f.call_symbol_size = new_symbol_n
    f.value_count = next_value
    return inlined
}
