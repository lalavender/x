module ir

// ============================================================================
// ssa_module_30_serialize.yh —— IRModule 的模块级序列化、反序列化与身份摘要
//
// 为什么需要它：LL2 的模块 IR 目前只在内存里成立。跨进程缓存、并行 worker 与
// 「失败不发布」都需要把 IRModule 变成可寻址、可比对、可校验的字节串，并给出
// 与路径/进程无关的稳定身份键（LL9 的输入）。本文件提供四个入口：
// ir_module_serialized_size / ir_module_serialize / ir_module_deserialize /
// ir_module_identity。函数体不另立格式，直接复用 ssa_serialize.yh 的
// ir_serialize / ir_deserialize 稳定编码，模块格式只负责模块自己的表。
//
// —— 字节布局（所有标量为小端 64 位字；不写宿主结构体布局，不写指针值）——
//
//   [固定头 26 字 = 208 字节]（字 0..25）
//     magic（"YHIRMOD1" 的字节序化常量）、序列化格式版本、内存模块版本、
//     目标 key、指针位宽、字节序、布局版本、
//     triple/data_layout/abi 长度（含结尾零）、
//     来源数、类型数、符号数、全局实体数、函数数、
//     字段项总数、形参项总数、重定位项总数、类型映射项总数、指令来源项总数、
//     来源路径字节总数、来源源码字节总数、类型名字节总数、符号名字节总数、
//     全局初始化字节总数、函数体编码字节总数。
//
//   [定长表区]（长度只由上面的计数决定，反序列化可一次做完边界检查）
//     来源描述 2 字/项：path_size、length
//     类型描述 10 字/项：name_size、kind、bits、size、align、elem、count、abi、
//                        variadic、field_count
//     字段项   2 字/项：type_id、offset
//     符号描述 12 字/项：name_size、kind、type_id、param_count、abi、variadic、
//                        no_return、linkage、defined、mutable、source、offset
//     形参项 1 字/项，全局描述 4 字/项（symbol、size、align、reloc_count），
//     重定位项 4 字/项（offset、width、symbol、addend 的 i64 位型），
//     函数描述 4 字/项（symbol、type_map_count、loc_count、body_size），
//     映射项 1 字/项，位置项 2 字/项（source、offset）。
//   同一张表的「描述符」整体在前、「子项」整体在后（例：全部类型描述符，再全部字段项）。
//
//   [变长 blob 区]（逐项紧排、不补齐；长度来自描述符，顺序固定）
//     triple、data_layout、abi；来源路径（含结尾零）、来源源码正文（不含结尾零）；
//     类型名、符号名（均含结尾零）；全局初始化字节；函数体（ir_serialize 编码）。
//
// —— 拒绝策略与安全性 ——
// magic/两个版本字不符、计数或长度越界、描述符长度之和与头部总数不符、名字缺
// 结尾零或含内部零、总长与调用方给出的 size 不等、ir_module_verify 不通过，一律
// 返回 -1；本文件不做任何「就地修补」。写入先算大小再写：容量不足时返回 -1 且
// 一个字节都不写。读取先看固定头，确认定长区完整落在 size 内，然后才分配与读取；
// 变长区在读完描述符后用「描述符之和 == 头部总数」封口，越界读不可能发生。
// 所有权：反序列化产生的全部指针归 out 独占，失败时释放全部部分分配并把 out
// 恢复为零初始化；out 进入时必须已是零初始化（与 ir_module_init 同契约）。
//
// —— 身份摘要 ——
// ir_module_identity 输出 32 个十六进制字符（+ 结尾零，共 33 字节），由两段 64 位
// FNV-1a 组成：前 16 位覆盖格式版本与全部目标身份字段（内存模块版本、目标 key、
// 指针位宽、字节序、布局版本、完整 triple、data_layout、abi），后 16 位覆盖整段
// 序列化字节。选 FNV-1a 的理由：算法自包含（不依赖 libc 的 md5/sha，也不引入外部
// 依赖）、实现不到 20 行、offset basis 与 prime 都能用十进制字面量逐位核对、对小
// 输入分布稳定；它是缓存键与变更检测工具，不是密码学哈希，不作为安全边界。
// 身份里不含函数私有 type_id、前端符号槽或任何指针地址：私有 type_id 只作为函数体
// 稳定编码的一部分出现，且经 type_map 显式映射到模块类型下标；序列化不写进程地址。
// ============================================================================

// 固定头字数（含 magic 与两个版本字）。
const IR_MODULE_SERIAL_HEAD_WORDS int = 26
// 头的数组部分字数（key 到 function_body_bytes）。
const IR_MODULE_HEADER_WORDS int = 23
// 定长表各类记录的字数。
const IR_MODULE_SOURCE_WORDS int = 2
const IR_MODULE_TYPE_WORDS int = 10
const IR_MODULE_FIELD_WORDS int = 2
const IR_MODULE_SYMBOL_WORDS int = 12
const IR_MODULE_PARAM_WORDS int = 1
const IR_MODULE_GLOBAL_WORDS int = 4
const IR_MODULE_RELOC_WORDS int = 4
const IR_MODULE_FUNCTION_WORDS int = 4
const IR_MODULE_MAP_WORDS int = 1
const IR_MODULE_LOC_WORDS int = 2
// 函数体最短编码，与 ir_serial_size_counts 的下界一致；更短一律视为截断。
const IR_MODULE_BODY_MIN int = 112
// 单次序列化允许的总字节上限；单项上限沿用 IR_SERIAL_MAX_BYTES。
const IR_MODULE_SERIAL_MAX_TOTAL int = 268435456
// magic：小端写出后即 "YHIRMOD1"，与函数级 "YHIRSSA1" 互不混淆。
const IR_MODULE_SERIAL_MAGIC u64 = 0x31444F4D52494859
// FNV-1a 64 的 offset basis 与 prime，十进制写全，便于与参考实现逐位核对。
const IR_MODULE_FNV_BASIS u64 = 14695981039346656037
const IR_MODULE_FNV_PRIME u64 = 1099511628211

// IRModulePlan：序列化布局的唯一真源，全部字段都是纯数值、不持有所有权。
// 写入路径由模块内容算出它；读取路径先由固定头填出计数与四个长度，
// 读完定长表后核对描述符之和，最后按内容重算一次作为「规范编码」封口。
struct IRModulePlan {
    triple_size int            // triple 字节数（含结尾零）
    data_layout_size int       // data_layout 字节数（含结尾零）
    abi_size int               // abi 字节数（含结尾零）
    source_count int           // 来源表项数
    type_count int             // 类型表项数
    symbol_count int           // 符号表项数
    global_count int           // 全局实体表项数
    function_count int         // 函数表项数
    type_field_total int       // 全部类型的字段项总数
    symbol_param_total int     // 全部符号的形参项总数
    global_reloc_total int     // 全部全局实体的重定位项总数
    function_map_total int     // 全部函数的类型映射项总数
    function_loc_total int     // 全部函数的指令来源项总数
    source_path_bytes int      // 全部来源路径字节数（含结尾零）
    source_text_bytes int      // 全部来源源码字节数
    type_name_bytes int        // 全部类型名字节数（含结尾零）
    symbol_name_bytes int      // 全部符号名字节数（含结尾零）
    global_data_bytes int      // 全部全局初始化字节数
    function_body_bytes int    // 全部函数体编码字节数
    fixed_bytes int            // 固定头 + 定长表区字节数
    blob_bytes int             // 变长 blob 区字节数
    total_bytes int            // 完整字节串长度
}

// IRModuleBlobSizes：反序列化第二阶段（变长区）需要的逐项长度暂存。
// 只被 ir_module_deserialize 使用，不进入 IRModule 所有权，用完即释放。
struct IRModuleBlobSizes {
    path *int                  // 来源路径长度，source_count 项
    name *int                  // 类型名长度，type_count 项
    symbol *int                // 符号名长度，symbol_count 项
    body *int                  // 函数体编码长度，function_count 项
}
// ir_module_text_size：C 字符串的序列化长度（含结尾零）；空指针或超限返回 -1。
fn ir_module_text_size(text *char) int {
    let n int = ir_module_str_len(text)
    if (n < 0 || n + 1 > IR_SERIAL_MAX_BYTES) { return -1 }
    return n + 1
}

// ir_module_word_int：把字节流里的 64 位字切成 int 位型；负数保留补码位型。
fn ir_module_word_int(value u64) int {
    return value.to_type(i64).to_type(int)
}

// ir_module_alloc_zero：分配一段内存并逐字节清零；size 为 0 时不分配。
// 清零是所有权契约的一部分：任何中途失败都能直接交给 release 递归释放。
fn ir_module_alloc_zero(size int) *void {
    if (size <= 0 || size > IR_MODULE_SERIAL_MAX_TOTAL) { return 0 }
    let block *void = malloc(size.to_type(u64))
    if (block == 0) { return 0 }
    let bytes *u8 = block.to_type(*u8)
    let i int = 0
    for i < size { bytes[i] = 0; i += 1 }
    return block
}

// ir_module_plan_fixed：由计数与长度算出定长区/变长区/总长，并集中执行上限校验。
// 写入与读取两条路径共用它，保证「先算后写」与「读完再核对」用的是同一套算术；
// 计数上限同时满足 ir_module_table_ok 对容量的约束。
fn ir_module_plan_fixed(plan *IRModulePlan) int {
    if (plan == 0
        || plan.triple_size < 1 || plan.triple_size > IR_SERIAL_MAX_BYTES
        || plan.data_layout_size < 1 || plan.data_layout_size > IR_SERIAL_MAX_BYTES
        || plan.abi_size < 1 || plan.abi_size > IR_SERIAL_MAX_BYTES
        || plan.source_count < 0 || plan.source_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleSource)
        || plan.type_count < 0 || plan.type_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleType)
        || plan.symbol_count < 0 || plan.symbol_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleSymbol)
        || plan.global_count < 0 || plan.global_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleGlobal)
        || plan.function_count < 0 || plan.function_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleFunction)
        || plan.type_field_total < 0 || plan.type_field_total > IR_SERIAL_MAX_BYTES / sizeof(IRModuleField)
        || plan.symbol_param_total < 0 || plan.symbol_param_total > IR_SERIAL_MAX_BYTES / sizeof(int)
        || plan.global_reloc_total < 0 || plan.global_reloc_total > IR_SERIAL_MAX_BYTES / sizeof(IRModuleReloc)
        || plan.function_map_total < 0 || plan.function_map_total > IR_SERIAL_MAX_BYTES / sizeof(int)
        || plan.function_loc_total < 0 || plan.function_loc_total > IR_SERIAL_MAX_BYTES / sizeof(IRModuleLoc)
        || plan.source_path_bytes < 0 || plan.source_path_bytes > IR_SERIAL_MAX_BYTES
        || plan.source_text_bytes < 0 || plan.source_text_bytes > IR_SERIAL_MAX_BYTES
        || plan.type_name_bytes < 0 || plan.type_name_bytes > IR_SERIAL_MAX_BYTES
        || plan.symbol_name_bytes < 0 || plan.symbol_name_bytes > IR_SERIAL_MAX_BYTES
        || plan.global_data_bytes < 0 || plan.global_data_bytes > IR_SERIAL_MAX_BYTES
        || plan.function_body_bytes < 0 || plan.function_body_bytes > IR_SERIAL_MAX_BYTES) { return -1 }
    let fixed int = IR_MODULE_SERIAL_HEAD_WORDS * 8 +
        plan.source_count * IR_MODULE_SOURCE_WORDS * 8 +
        plan.type_count * IR_MODULE_TYPE_WORDS * 8 +
        plan.type_field_total * IR_MODULE_FIELD_WORDS * 8 +
        plan.symbol_count * IR_MODULE_SYMBOL_WORDS * 8 +
        plan.symbol_param_total * IR_MODULE_PARAM_WORDS * 8 +
        plan.global_count * IR_MODULE_GLOBAL_WORDS * 8 +
        plan.global_reloc_total * IR_MODULE_RELOC_WORDS * 8 +
        plan.function_count * IR_MODULE_FUNCTION_WORDS * 8 +
        plan.function_map_total * IR_MODULE_MAP_WORDS * 8 +
        plan.function_loc_total * IR_MODULE_LOC_WORDS * 8
    let blobs int = plan.triple_size + plan.data_layout_size + plan.abi_size +
        plan.source_path_bytes + plan.source_text_bytes + plan.type_name_bytes +
        plan.symbol_name_bytes + plan.global_data_bytes + plan.function_body_bytes
    if (blobs < 0 || blobs > IR_MODULE_SERIAL_MAX_TOTAL
        || fixed > IR_MODULE_SERIAL_MAX_TOTAL - blobs) { return -1 }
    plan.fixed_bytes = fixed
    plan.blob_bytes = blobs
    plan.total_bytes = fixed + blobs
    return 0
}

// ir_module_plan：按模块实际内容算出全部规模。只做规模检查（含每个函数体的
// 稳定编码长度），语义合法性由 ir_module_verify 单独负责。
fn ir_module_plan(unit *IRModule, plan *IRModulePlan) int {
    if (unit == 0 || plan == 0) { return -1 }
    plan.triple_size = ir_module_text_size(unit.target.triple)
    plan.data_layout_size = ir_module_text_size(unit.target.data_layout)
    plan.abi_size = ir_module_text_size(unit.target.abi)
    plan.source_count = unit.source_count
    plan.type_count = unit.type_count
    plan.symbol_count = unit.symbol_count
    plan.global_count = unit.global_count
    plan.function_count = unit.function_count
    plan.type_field_total = 0; plan.type_name_bytes = 0
    let i int = 0
    for i < unit.type_count {
        let name int = ir_module_text_size(unit.types[i].name)
        if (name < 0) { return -1 }
        plan.type_name_bytes += name
        plan.type_field_total += unit.types[i].field_count
        i += 1
    }
    plan.symbol_param_total = 0; plan.symbol_name_bytes = 0
    i = 0
    for i < unit.symbol_count {
        let name int = ir_module_text_size(unit.symbols[i].name)
        if (name < 0) { return -1 }
        plan.symbol_name_bytes += name
        plan.symbol_param_total += unit.symbols[i].param_count
        i += 1
    }
    plan.source_path_bytes = 0; plan.source_text_bytes = 0
    i = 0
    for i < unit.source_count {
        let path int = ir_module_text_size(unit.sources[i].path)
        if (path < 0 || unit.sources[i].length < 0
            || unit.sources[i].length > IR_SERIAL_MAX_BYTES) { return -1 }
        plan.source_path_bytes += path
        plan.source_text_bytes += unit.sources[i].length
        i += 1
    }
    plan.global_data_bytes = 0; plan.global_reloc_total = 0
    i = 0
    for i < unit.global_count {
        if (unit.globals[i].size < 0 || unit.globals[i].size > IR_SERIAL_MAX_BYTES) { return -1 }
        plan.global_data_bytes += unit.globals[i].size
        plan.global_reloc_total += unit.globals[i].reloc_count
        i += 1
    }
    plan.function_body_bytes = 0; plan.function_map_total = 0; plan.function_loc_total = 0
    i = 0
    for i < unit.function_count {
        let body int = ir_serialized_size(&unit.functions[i].body)
        if (body < IR_MODULE_BODY_MIN) { return -1 }
        plan.function_body_bytes += body
        plan.function_map_total += unit.functions[i].type_map_count
        plan.function_loc_total += unit.functions[i].loc_count
        i += 1
    }
    return ir_module_plan_fixed(plan)
}

// ir_module_prepare：序列化前统一入口——先跑完整 verifier，再算布局。
// size/serialize/identity 三个入口共享同一道「只序列化合法模块」的门。
fn ir_module_prepare(unit *IRModule, plan *IRModulePlan) int {
    if (unit == 0 || plan == 0 || ir_module_verify(unit) != 0) { return -1 }
    return ir_module_plan(unit, plan)
}

// ir_module_put_u64：写入一个小端 64 位字。
fn ir_module_put_u64(out *u8, cursor *int, value u64) void {
    let i int = 0
    for i < 8 {
        out[*cursor + i] = ((value >> (i * 8)) & 255).to_type(u8)
        i += 1
    }
    *cursor = *cursor + 8
}

// ir_module_put_int：写入 int 的二进制补码位型，负数按位型原样保存。
fn ir_module_put_int(out *u8, cursor *int, value int) void {
    ir_module_put_u64(out, cursor, value.to_type(i64).to_type(u64))
}

// ir_module_put_blob：写 n 字节原始数据；n 为 0 时不写且允许空指针。
fn ir_module_put_blob(out *u8, cursor *int, data *u8, size int) int {
    if (size < 0 || size > IR_SERIAL_MAX_BYTES || size > 0 && data == 0) { return -1 }
    if (size > 0) { memcpy(&out[*cursor], data.to_type(*void), size.to_type(u64)) }
    *cursor += size
    return 0
}

// ir_module_put_text：写入含结尾零的 C 字符串；空指针或未终止字符串返回 -1。
fn ir_module_put_text(out *u8, cursor *int, text *char) int {
    let n int = ir_module_str_len(text)
    if (n < 0 || n + 1 > IR_SERIAL_MAX_BYTES) { return -1 }
    memcpy(&out[*cursor], text.to_type(*void), (n + 1).to_type(u64))
    *cursor += n + 1
    return 0
}

// ir_module_write_fixed：写固定头与全部定长表。调用前已按同一份 plan 校验容量，
// 因此这里不再重复边界检查；名字/路径长度重新取自模块内容，异常即整体失败。
fn ir_module_write_fixed(unit *IRModule, plan *IRModulePlan, out *u8, cursor *int) int {
    ir_module_put_u64(out, cursor, IR_MODULE_SERIAL_MAGIC)
    ir_module_put_u64(out, cursor, IR_MODULE_SERIAL_VERSION.to_type(u64))
    ir_module_put_u64(out, cursor, IR_MODULE_VERSION.to_type(u64))
    ir_module_put_int(out, cursor, unit.target.key)
    ir_module_put_int(out, cursor, unit.target.pointer_bits)
    ir_module_put_int(out, cursor, unit.target.little_endian)
    ir_module_put_int(out, cursor, unit.target.layout_version)
    ir_module_put_int(out, cursor, plan.triple_size)
    ir_module_put_int(out, cursor, plan.data_layout_size)
    ir_module_put_int(out, cursor, plan.abi_size)
    ir_module_put_int(out, cursor, plan.source_count)
    ir_module_put_int(out, cursor, plan.type_count)
    ir_module_put_int(out, cursor, plan.symbol_count)
    ir_module_put_int(out, cursor, plan.global_count)
    ir_module_put_int(out, cursor, plan.function_count)
    ir_module_put_int(out, cursor, plan.type_field_total)
    ir_module_put_int(out, cursor, plan.symbol_param_total)
    ir_module_put_int(out, cursor, plan.global_reloc_total)
    ir_module_put_int(out, cursor, plan.function_map_total)
    ir_module_put_int(out, cursor, plan.function_loc_total)
    ir_module_put_int(out, cursor, plan.source_path_bytes)
    ir_module_put_int(out, cursor, plan.source_text_bytes)
    ir_module_put_int(out, cursor, plan.type_name_bytes)
    ir_module_put_int(out, cursor, plan.symbol_name_bytes)
    ir_module_put_int(out, cursor, plan.global_data_bytes)
    ir_module_put_int(out, cursor, plan.function_body_bytes)
    let i int = 0
    for i < unit.source_count {
        let path int = ir_module_text_size(unit.sources[i].path)
        if (path < 1) { return -1 }
        ir_module_put_int(out, cursor, path)
        ir_module_put_int(out, cursor, unit.sources[i].length)
        i += 1
    }
    i = 0
    for i < unit.type_count {
        let name int = ir_module_text_size(unit.types[i].name)
        if (name < 1) { return -1 }
        ir_module_put_int(out, cursor, name)
        ir_module_put_int(out, cursor, unit.types[i].kind)
        ir_module_put_int(out, cursor, unit.types[i].bits)
        ir_module_put_int(out, cursor, unit.types[i].size)
        ir_module_put_int(out, cursor, unit.types[i].align)
        ir_module_put_int(out, cursor, unit.types[i].elem)
        ir_module_put_int(out, cursor, unit.types[i].count)
        ir_module_put_int(out, cursor, unit.types[i].abi)
        ir_module_put_int(out, cursor, unit.types[i].variadic)
        ir_module_put_int(out, cursor, unit.types[i].field_count)
        i += 1
    }
    i = 0
    for i < unit.type_count {
        let j int = 0
        for j < unit.types[i].field_count {
            ir_module_put_int(out, cursor, unit.types[i].fields[j].type_id)
            ir_module_put_int(out, cursor, unit.types[i].fields[j].offset)
            j += 1
        }
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        let name int = ir_module_text_size(unit.symbols[i].name)
        if (name < 1) { return -1 }
        ir_module_put_int(out, cursor, name)
        ir_module_put_int(out, cursor, unit.symbols[i].kind)
        ir_module_put_int(out, cursor, unit.symbols[i].type_id)
        ir_module_put_int(out, cursor, unit.symbols[i].param_count)
        ir_module_put_int(out, cursor, unit.symbols[i].abi)
        ir_module_put_int(out, cursor, unit.symbols[i].variadic)
        ir_module_put_int(out, cursor, unit.symbols[i].no_return)
        ir_module_put_int(out, cursor, unit.symbols[i].linkage)
        ir_module_put_int(out, cursor, unit.symbols[i].defined)
        ir_module_put_int(out, cursor, unit.symbols[i].mutable)
        ir_module_put_int(out, cursor, unit.symbols[i].source)
        ir_module_put_int(out, cursor, unit.symbols[i].offset)
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        let j int = 0
        for j < unit.symbols[i].param_count {
            ir_module_put_int(out, cursor, unit.symbols[i].params[j])
            j += 1
        }
        i += 1
    }
    i = 0
    for i < unit.global_count {
        ir_module_put_int(out, cursor, unit.globals[i].symbol)
        ir_module_put_int(out, cursor, unit.globals[i].size)
        ir_module_put_int(out, cursor, unit.globals[i].align)
        ir_module_put_int(out, cursor, unit.globals[i].reloc_count)
        i += 1
    }
    i = 0
    for i < unit.global_count {
        let j int = 0
        for j < unit.globals[i].reloc_count {
            ir_module_put_int(out, cursor, unit.globals[i].relocs[j].offset)
            ir_module_put_int(out, cursor, unit.globals[i].relocs[j].width)
            ir_module_put_int(out, cursor, unit.globals[i].relocs[j].symbol)
            ir_module_put_u64(out, cursor, unit.globals[i].relocs[j].addend.to_type(u64))
            j += 1
        }
        i += 1
    }
    i = 0
    for i < unit.function_count {
        let body int = ir_serialized_size(&unit.functions[i].body)
        if (body < IR_MODULE_BODY_MIN) { return -1 }
        ir_module_put_int(out, cursor, unit.functions[i].symbol)
        ir_module_put_int(out, cursor, unit.functions[i].type_map_count)
        ir_module_put_int(out, cursor, unit.functions[i].loc_count)
        ir_module_put_int(out, cursor, body)
        i += 1
    }
    i = 0
    for i < unit.function_count {
        let j int = 0
        for j < unit.functions[i].type_map_count {
            ir_module_put_int(out, cursor, unit.functions[i].type_map[j])
            j += 1
        }
        i += 1
    }
    i = 0
    for i < unit.function_count {
        let j int = 0
        for j < unit.functions[i].loc_count {
            ir_module_put_int(out, cursor, unit.functions[i].locs[j].source)
            ir_module_put_int(out, cursor, unit.functions[i].locs[j].offset)
            j += 1
        }
        i += 1
    }
    return 0
}

// ir_module_write_blobs：按固定顺序写变长区（逐项紧排，不补齐）。
fn ir_module_write_blobs(unit *IRModule, out *u8, cursor *int) int {
    if (ir_module_put_text(out, cursor, unit.target.triple) != 0
        || ir_module_put_text(out, cursor, unit.target.data_layout) != 0
        || ir_module_put_text(out, cursor, unit.target.abi) != 0) { return -1 }
    let i int = 0
    for i < unit.source_count {
        if (ir_module_put_text(out, cursor, unit.sources[i].path) != 0
            || ir_module_put_blob(out, cursor, unit.sources[i].text, unit.sources[i].length) != 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.type_count {
        if (ir_module_put_text(out, cursor, unit.types[i].name) != 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        if (ir_module_put_text(out, cursor, unit.symbols[i].name) != 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.global_count {
        if (ir_module_put_blob(out, cursor, unit.globals[i].data, unit.globals[i].size) != 0) { return -1 }
        i += 1
    }
    // 函数体直接写进输出缓冲：容量已按 plan 校验过，无需临时分配。
    i = 0
    for i < unit.function_count {
        let body int = ir_serialized_size(&unit.functions[i].body)
        if (body < IR_MODULE_BODY_MIN
            || ir_serialize(&unit.functions[i].body, &out[*cursor], body) != body) { return -1 }
        *cursor += body
        i += 1
    }
    return 0
}

// ir_module_serialize_alloc_mode：verify=1 走 prepare（先校后算），
// verify=0 只算布局；两条路径的编码字节完全一致。
fn ir_module_serialize_alloc_mode(unit *IRModule, verify int,
    out_data **u8, out_size *int) int {
    if (unit == 0 || out_data == 0 || out_size == 0) { return -1 }
    out_data[0] = 0; out_size[0] = 0
    let plan IRModulePlan
    let prepared int = 0
    if (verify != 0) {
        prepared = ir_module_prepare(unit, &plan)
    } else if (ir_module_plan(unit, &plan) != 0) {
        prepared = -1
    }
    if (prepared != 0 || plan.total_bytes <= 0) { return -1 }
    let data *u8 = ir_module_alloc_zero(plan.total_bytes).to_type(*u8)
    if (data == 0) { return -1 }
    let cursor int = 0
    if (ir_module_write_fixed(unit, &plan, data, &cursor) != 0
        || ir_module_write_blobs(unit, data, &cursor) != 0
        || cursor != plan.total_bytes) {
        free(data.to_type(*void))
        return -1
    }
    out_data[0] = data
    out_size[0] = plan.total_bytes
    return 0
}

// ir_module_get_u64：读取一个小端 64 位字；调用方保证剩余输入足够。
fn ir_module_get_u64(data *u8, cursor *int) u64 {
    let value u64 = 0
    let i int = 0
    for i < 8 {
        value = value | (data[*cursor + i].to_type(u64) << (i * 8))
        i += 1
    }
    *cursor = *cursor + 8
    return value
}

// ir_module_get_int：读取 int 的补码位型；越界值以负数形式出现，由范围检查拒绝。
fn ir_module_get_int(data *u8, cursor *int) int {
    return ir_module_word_int(ir_module_get_u64(data, cursor))
}

// ir_module_read_blob：按给定长度复制一段原始字节，返回自有缓冲或空指针。
// want 为 0 时合法地返回空指针；调用方据此判断 want > 0 时的失败。
fn ir_module_read_blob(data *u8, size int, cursor *int, want int) *u8 {
    if (data == 0 || cursor == 0 || want < 0 || want > IR_SERIAL_MAX_BYTES
        || *cursor < 0 || *cursor > size || want > size - *cursor) { return 0 }
    if (want == 0) { return 0 }
    let block *u8 = ir_module_alloc_zero(want).to_type(*u8)
    if (block == 0) { return 0 }
    memcpy(block.to_type(*void), &data[*cursor], want.to_type(u64))
    *cursor += want
    return block
}

// ir_module_read_text：读取一个含结尾零的名字/路径，返回自有 C 字符串。
// 要求第一个零字节恰好落在 blob 末字节：内部零或缺少终止符都视为非法编码。
fn ir_module_read_text(data *u8, size int, cursor *int, want int) *char {
    if (want < 1 || want > IR_SERIAL_MAX_BYTES) { return 0 }
    let block *u8 = ir_module_read_blob(data, size, cursor, want)
    if (block == 0) { return 0 }
    let n int = 0
    for n < want {
        if (block[n] == 0) { break }
        n += 1
    }
    if (n != want - 1) { free(block); return 0 }
    return block.to_type(*char)
}

// ir_module_blob_sizes_open：为四类变长 blob 分配长度暂存；部分失败由 close 清理。
fn ir_module_blob_sizes_open(sizes *IRModuleBlobSizes, unit *IRModule) int {
    if (sizes == 0 || unit == 0) { return -1 }
    if (unit.source_count > 0) {
        sizes.path = ir_module_alloc_zero(unit.source_count * sizeof(int)).to_type(*int)
        if (sizes.path == 0) { return -1 }
    }
    if (unit.type_count > 0) {
        sizes.name = ir_module_alloc_zero(unit.type_count * sizeof(int)).to_type(*int)
        if (sizes.name == 0) { return -1 }
    }
    if (unit.symbol_count > 0) {
        sizes.symbol = ir_module_alloc_zero(unit.symbol_count * sizeof(int)).to_type(*int)
        if (sizes.symbol == 0) { return -1 }
    }
    if (unit.function_count > 0) {
        sizes.body = ir_module_alloc_zero(unit.function_count * sizeof(int)).to_type(*int)
        if (sizes.body == 0) { return -1 }
    }
    return 0
}
// ir_module_blob_sizes_close：释放长度暂存并置空；允许部分分配与重复调用。
fn ir_module_blob_sizes_close(sizes *IRModuleBlobSizes) void {
    if (sizes == 0) { return }
    if (sizes.path != 0) { free(sizes.path) }
    if (sizes.name != 0) { free(sizes.name) }
    if (sizes.symbol != 0) { free(sizes.symbol) }
    if (sizes.body != 0) { free(sizes.body) }
    sizes.path = 0; sizes.name = 0; sizes.symbol = 0; sizes.body = 0
}

// ir_module_alloc_tables：按头部计数分配五张主表并清零，同时写入计数与容量。
// 计数与指针必须同时生效：ir_module_release 依赖「count > 0 则表已分配且已清零」。
fn ir_module_alloc_tables(unit *IRModule, plan *IRModulePlan) int {
    if (unit == 0 || plan == 0) { return -1 }
    if (plan.source_count > 0) {
        unit.sources = ir_module_alloc_zero(plan.source_count * sizeof(IRModuleSource)).to_type(*IRModuleSource)
        if (unit.sources == 0) { return -1 }
    }
    unit.source_count = plan.source_count; unit.source_capacity = plan.source_count
    if (plan.type_count > 0) {
        unit.types = ir_module_alloc_zero(plan.type_count * sizeof(IRModuleType)).to_type(*IRModuleType)
        if (unit.types == 0) { return -1 }
    }
    unit.type_count = plan.type_count; unit.type_capacity = plan.type_count
    if (plan.symbol_count > 0) {
        unit.symbols = ir_module_alloc_zero(plan.symbol_count * sizeof(IRModuleSymbol)).to_type(*IRModuleSymbol)
        if (unit.symbols == 0) { return -1 }
    }
    unit.symbol_count = plan.symbol_count; unit.symbol_capacity = plan.symbol_count
    if (plan.global_count > 0) {
        unit.globals = ir_module_alloc_zero(plan.global_count * sizeof(IRModuleGlobal)).to_type(*IRModuleGlobal)
        if (unit.globals == 0) { return -1 }
    }
    unit.global_count = plan.global_count; unit.global_capacity = plan.global_count
    if (plan.function_count > 0) {
        unit.functions = ir_module_alloc_zero(plan.function_count * sizeof(IRModuleFunction)).to_type(*IRModuleFunction)
        if (unit.functions == 0) { return -1 }
    }
    unit.function_count = plan.function_count; unit.function_capacity = plan.function_count
    return 0
}

// ir_module_read_fixed：读固定头之后的全部定长表（含子项表），并把变长 blob 的
// 逐项长度写进 sizes。进入本函数前已确认 fixed_bytes <= size，因此定长读取不会越界；
// 单项计数一定不大于对应总数，而总数已在 plan_fixed 里通过上限校验，故分配也不会溢出。
// 结束时核对「描述符之和 == 头部变长总数」，封死变长区的边界。
fn ir_module_read_fixed(unit *IRModule, sizes *IRModuleBlobSizes, plan *IRModulePlan,
    data *u8, cursor *int) int {
    if (unit == 0 || sizes == 0 || plan == 0 || data == 0 || cursor == 0) { return -1 }
    let path_total int = 0; let text_total int = 0; let name_total int = 0
    let symbol_total int = 0; let data_total int = 0; let body_total int = 0
    let i int = 0
    // 来源描述：路径长度 + 源码长度；空源码合法（text 保持空指针）。
    for i < unit.source_count {
        let path_size int = ir_module_get_int(data, cursor)
        let length int = ir_module_get_int(data, cursor)
        if (path_size < 1 || path_size > IR_SERIAL_MAX_BYTES
            || length < 0 || length > IR_SERIAL_MAX_BYTES) { return -1 }
        unit.sources[i].length = length
        sizes.path[i] = path_size
        path_total += path_size
        text_total += length
        i += 1
    }
    // 类型描述：名字长度与九项布局字段；字段表下标留给 verify 检查。
    i = 0
    for i < unit.type_count {
        let name_size int = ir_module_get_int(data, cursor)
        unit.types[i].kind = ir_module_get_int(data, cursor)
        unit.types[i].bits = ir_module_get_int(data, cursor)
        unit.types[i].size = ir_module_get_int(data, cursor)
        unit.types[i].align = ir_module_get_int(data, cursor)
        unit.types[i].elem = ir_module_get_int(data, cursor)
        unit.types[i].count = ir_module_get_int(data, cursor)
        unit.types[i].abi = ir_module_get_int(data, cursor)
        unit.types[i].variadic = ir_module_get_int(data, cursor)
        unit.types[i].field_count = ir_module_get_int(data, cursor)
        if (name_size < 1 || name_size > IR_SERIAL_MAX_BYTES
            || unit.types[i].size < 0 || unit.types[i].size > IR_SERIAL_MAX_BYTES
            || unit.types[i].field_count < 0
            || unit.types[i].field_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleField)) { return -1 }
        sizes.name[i] = name_size
        name_total += name_size
        i += 1
    }
    // 字段项：按类型顺序连续存放，与写入侧的两趟循环一致。
    i = 0
    for i < unit.type_count {
        if (unit.types[i].field_count > 0) {
            unit.types[i].fields = ir_module_alloc_zero(
                unit.types[i].field_count * sizeof(IRModuleField)).to_type(*IRModuleField)
            if (unit.types[i].fields == 0) { return -1 }
        }
        let j int = 0
        for j < unit.types[i].field_count {
            unit.types[i].fields[j].type_id = ir_module_get_int(data, cursor)
            unit.types[i].fields[j].offset = ir_module_get_int(data, cursor)
            j += 1
        }
        i += 1
    }
    // 符号描述：名字长度与签名/链接/来源字段。
    i = 0
    for i < unit.symbol_count {
        let name_size int = ir_module_get_int(data, cursor)
        unit.symbols[i].kind = ir_module_get_int(data, cursor)
        unit.symbols[i].type_id = ir_module_get_int(data, cursor)
        unit.symbols[i].param_count = ir_module_get_int(data, cursor)
        unit.symbols[i].abi = ir_module_get_int(data, cursor)
        unit.symbols[i].variadic = ir_module_get_int(data, cursor)
        unit.symbols[i].no_return = ir_module_get_int(data, cursor)
        unit.symbols[i].linkage = ir_module_get_int(data, cursor)
        unit.symbols[i].defined = ir_module_get_int(data, cursor)
        unit.symbols[i].mutable = ir_module_get_int(data, cursor)
        unit.symbols[i].source = ir_module_get_int(data, cursor)
        unit.symbols[i].offset = ir_module_get_int(data, cursor)
        if (name_size < 1 || name_size > IR_SERIAL_MAX_BYTES
            || unit.symbols[i].param_count < 0
            || unit.symbols[i].param_count > IR_SERIAL_MAX_BYTES / sizeof(int)) { return -1 }
        sizes.symbol[i] = name_size
        symbol_total += name_size
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        if (unit.symbols[i].param_count > 0) {
            unit.symbols[i].params = ir_module_alloc_zero(
                unit.symbols[i].param_count * sizeof(int)).to_type(*int)
            if (unit.symbols[i].params == 0) { return -1 }
        }
        let j int = 0
        for j < unit.symbols[i].param_count {
            unit.symbols[i].params[j] = ir_module_get_int(data, cursor)
            j += 1
        }
        i += 1
    }
    // 全局描述：符号下标、大小、对齐与重定位项数。
    i = 0
    for i < unit.global_count {
        unit.globals[i].symbol = ir_module_get_int(data, cursor)
        unit.globals[i].size = ir_module_get_int(data, cursor)
        unit.globals[i].align = ir_module_get_int(data, cursor)
        unit.globals[i].reloc_count = ir_module_get_int(data, cursor)
        if (unit.globals[i].size < 0 || unit.globals[i].size > IR_SERIAL_MAX_BYTES
            || unit.globals[i].reloc_count < 0
            || unit.globals[i].reloc_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleReloc)) { return -1 }
        data_total += unit.globals[i].size
        i += 1
    }
    i = 0
    for i < unit.global_count {
        if (unit.globals[i].reloc_count > 0) {
            unit.globals[i].relocs = ir_module_alloc_zero(
                unit.globals[i].reloc_count * sizeof(IRModuleReloc)).to_type(*IRModuleReloc)
            if (unit.globals[i].relocs == 0) { return -1 }
        }
        let j int = 0
        for j < unit.globals[i].reloc_count {
            unit.globals[i].relocs[j].offset = ir_module_get_int(data, cursor)
            unit.globals[i].relocs[j].width = ir_module_get_int(data, cursor)
            unit.globals[i].relocs[j].symbol = ir_module_get_int(data, cursor)
            unit.globals[i].relocs[j].addend = ir_module_get_u64(data, cursor).to_type(i64)
            j += 1
        }
        i += 1
    }
    // 函数描述：符号下标、映射项数、来源项数与函数体编码长度。
    i = 0
    for i < unit.function_count {
        unit.functions[i].symbol = ir_module_get_int(data, cursor)
        unit.functions[i].type_map_count = ir_module_get_int(data, cursor)
        unit.functions[i].loc_count = ir_module_get_int(data, cursor)
        let body_size int = ir_module_get_int(data, cursor)
        if (unit.functions[i].type_map_count < 0
            || unit.functions[i].type_map_count > IR_SERIAL_MAX_BYTES / sizeof(int)
            || unit.functions[i].loc_count < 0
            || unit.functions[i].loc_count > IR_SERIAL_MAX_BYTES / sizeof(IRModuleLoc)
            || body_size < IR_MODULE_BODY_MIN || body_size > IR_SERIAL_MAX_BYTES) { return -1 }
        sizes.body[i] = body_size
        body_total += body_size
        i += 1
    }
    i = 0
    for i < unit.function_count {
        if (unit.functions[i].type_map_count > 0) {
            unit.functions[i].type_map = ir_module_alloc_zero(
                unit.functions[i].type_map_count * sizeof(int)).to_type(*int)
            if (unit.functions[i].type_map == 0) { return -1 }
        }
        let j int = 0
        for j < unit.functions[i].type_map_count {
            unit.functions[i].type_map[j] = ir_module_get_int(data, cursor)
            j += 1
        }
        i += 1
    }
    i = 0
    for i < unit.function_count {
        if (unit.functions[i].loc_count > 0) {
            unit.functions[i].locs = ir_module_alloc_zero(
                unit.functions[i].loc_count * sizeof(IRModuleLoc)).to_type(*IRModuleLoc)
            if (unit.functions[i].locs == 0) { return -1 }
        }
        let j int = 0
        for j < unit.functions[i].loc_count {
            unit.functions[i].locs[j].source = ir_module_get_int(data, cursor)
            unit.functions[i].locs[j].offset = ir_module_get_int(data, cursor)
            j += 1
        }
        i += 1
    }
    // 描述符之和必须与头部记录的总数完全一致，之后才能安全读变长区。
    let total int = plan.triple_size + plan.data_layout_size + plan.abi_size +
        path_total + text_total + name_total + symbol_total + data_total + body_total
    return total == plan.blob_bytes ? 0 : -1
}

// ir_module_read_blobs：按固定顺序读变长区，产生 out 独占的字符串、源码、
// 初始化字节与函数体。每个 blob 之前都做一次边界检查，越界立即失败。
fn ir_module_read_blobs(unit *IRModule, sizes *IRModuleBlobSizes, plan *IRModulePlan,
    data *u8, size int, cursor *int) int {
    if (unit == 0 || sizes == 0 || plan == 0 || data == 0 || cursor == 0) { return -1 }
    unit.target.triple = ir_module_read_text(data, size, cursor, plan.triple_size)
    unit.target.data_layout = ir_module_read_text(data, size, cursor, plan.data_layout_size)
    unit.target.abi = ir_module_read_text(data, size, cursor, plan.abi_size)
    if (unit.target.triple == 0 || unit.target.data_layout == 0 || unit.target.abi == 0) { return -1 }
    let i int = 0
    for i < unit.source_count {
        unit.sources[i].path = ir_module_read_text(data, size, cursor, sizes.path[i])
        if (unit.sources[i].path == 0) { return -1 }
        if (unit.sources[i].length > 0) {
            unit.sources[i].text = ir_module_read_blob(data, size, cursor, unit.sources[i].length)
            if (unit.sources[i].text == 0) { return -1 }
        }
        i += 1
    }
    i = 0
    for i < unit.type_count {
        unit.types[i].name = ir_module_read_text(data, size, cursor, sizes.name[i])
        if (unit.types[i].name == 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.symbol_count {
        unit.symbols[i].name = ir_module_read_text(data, size, cursor, sizes.symbol[i])
        if (unit.symbols[i].name == 0) { return -1 }
        i += 1
    }
    i = 0
    for i < unit.global_count {
        if (unit.globals[i].size > 0) {
            unit.globals[i].data = ir_module_read_blob(data, size, cursor, unit.globals[i].size)
            if (unit.globals[i].data == 0) { return -1 }
        }
        i += 1
    }
    // 函数体交给函数级反序列化器，目标键沿用模块自身的目标；它自带完整校验。
    i = 0
    for i < unit.function_count {
        let body int = sizes.body[i]
        if (*cursor < 0 || *cursor > size || body > size - *cursor) { return -1 }
        if (ir_deserialize(&unit.functions[i].body, &data[*cursor], body, unit.target.key) != 0) { return -1 }
        *cursor += body
        i += 1
    }
    return 0
}

// ir_module_canonical：读完字节流后按内容重算布局，确认编码是规范形式且总长一致。
// 名字长度已逐个核对过（第一个零字节必须落在末字节），这里再做一次整体封口。
fn ir_module_canonical(unit *IRModule, size int) int {
    let content IRModulePlan
    if (ir_module_plan(unit, &content) != 0) { return -1 }
    return content.total_bytes == size ? 0 : -1
}

// ir_module_deserialize_mode：verify=1 时在结构校验后再跑语义 verify。
fn ir_module_deserialize_mode(out *IRModule, data *u8, size int, verify int) int {
    if (out == 0 || data == 0 || size < IR_MODULE_SERIAL_HEAD_WORDS * 8) { return -1 }
    if (out.version != 0 || out.sources != 0 || out.types != 0 || out.symbols != 0
        || out.globals != 0 || out.functions != 0 || out.target.triple != 0
        || out.target.data_layout != 0 || out.target.abi != 0
        || out.source_count != 0 || out.type_count != 0 || out.symbol_count != 0
        || out.global_count != 0 || out.function_count != 0) { return -1 }
    let plan IRModulePlan
    let sizes IRModuleBlobSizes
    let cursor int = IR_MODULE_SERIAL_HEAD_WORDS * 8
    let step int = ir_module_read_header(out, data, size, &plan)
    if (step == 0) { step = ir_module_alloc_tables(out, &plan) }
    if (step == 0) { step = ir_module_blob_sizes_open(&sizes, out) }
    if (step == 0) { step = ir_module_read_fixed(out, &sizes, &plan, data, &cursor) }
    if (step == 0) { step = ir_module_read_blobs(out, &sizes, &plan, data, size, &cursor) }
    if (step == 0 && cursor != size) { step = -1 }
    if (step == 0) { step = ir_module_canonical(out, size) }
    if (step == 0 && verify != 0) { step = ir_module_verify(out) }
    ir_module_blob_sizes_close(&sizes)
    if (step != 0) { ir_module_release(out); return -1 }
    return 0
}

// ir_module_read_header：读固定头，填目标标量与 plan，并做统一规模校验。
// 版本字必须严格相等；所有计数/长度按 int 读出，负数（含 64 位字溢出）由
// plan_fixed 的范围检查拒绝；定长区必须完整落在 size 内。
fn ir_module_read_header(unit *IRModule, data *u8, size int, plan *IRModulePlan) int {
    if (unit == 0 || data == 0 || plan == 0 || size < IR_MODULE_SERIAL_HEAD_WORDS * 8) { return -1 }
    let cursor int = 0
    if (ir_module_get_u64(data, &cursor) != IR_MODULE_SERIAL_MAGIC
        || ir_module_get_u64(data, &cursor) != IR_MODULE_SERIAL_VERSION.to_type(u64)
        || ir_module_get_u64(data, &cursor) != IR_MODULE_VERSION.to_type(u64)) { return -1 }
    let words [23]u64
    let i int = 0
    for i < IR_MODULE_HEADER_WORDS { words[i] = ir_module_get_u64(data, &cursor); i += 1 }
    unit.target.key = ir_module_word_int(words[0])
    unit.target.pointer_bits = ir_module_word_int(words[1])
    unit.target.little_endian = ir_module_word_int(words[2])
    unit.target.layout_version = ir_module_word_int(words[3])
    plan.triple_size = ir_module_word_int(words[4])
    plan.data_layout_size = ir_module_word_int(words[5])
    plan.abi_size = ir_module_word_int(words[6])
    plan.source_count = ir_module_word_int(words[7])
    plan.type_count = ir_module_word_int(words[8])
    plan.symbol_count = ir_module_word_int(words[9])
    plan.global_count = ir_module_word_int(words[10])
    plan.function_count = ir_module_word_int(words[11])
    plan.type_field_total = ir_module_word_int(words[12])
    plan.symbol_param_total = ir_module_word_int(words[13])
    plan.global_reloc_total = ir_module_word_int(words[14])
    plan.function_map_total = ir_module_word_int(words[15])
    plan.function_loc_total = ir_module_word_int(words[16])
    plan.source_path_bytes = ir_module_word_int(words[17])
    plan.source_text_bytes = ir_module_word_int(words[18])
    plan.type_name_bytes = ir_module_word_int(words[19])
    plan.symbol_name_bytes = ir_module_word_int(words[20])
    plan.global_data_bytes = ir_module_word_int(words[21])
    plan.function_body_bytes = ir_module_word_int(words[22])
    if (ir_module_plan_fixed(plan) != 0) { return -1 }
    if (plan.fixed_bytes > size || plan.total_bytes != size) { return -1 }
    unit.version = IR_MODULE_VERSION
    return 0
}

// ir_module_fnv_byte：把一个字节并入 FNV-1a 64 状态。
fn ir_module_fnv_byte(state u64, value u8) u64 {
    return (state ^ value.to_type(u64)) * IR_MODULE_FNV_PRIME
}

// ir_module_fnv_u64：按小端字节序并入一个 64 位值，使身份与宿主字节序无关。
fn ir_module_fnv_u64(state u64, value u64) u64 {
    let h u64 = state
    let i int = 0
    for i < 8 {
        h = ir_module_fnv_byte(h, ((value >> (i * 8)) & 255).to_type(u8))
        i += 1
    }
    return h
}

// ir_module_fnv_bytes：并入一段字节；size 为 0 时状态不变。
fn ir_module_fnv_bytes(state u64, data *u8, size int) u64 {
    let h u64 = state
    let i int = 0
    for i < size { h = ir_module_fnv_byte(h, data[i]); i += 1 }
    return h
}

// ir_module_fnv_text：先并入长度（含结尾零）再并入字节，避免拼接歧义。
fn ir_module_fnv_text(state u64, text *char, result *u64) int {
    if (result == 0) { return -1 }
    let n int = ir_module_str_len(text)
    if (n < 0) { return -1 }
    let h u64 = ir_module_fnv_u64(state, (n + 1).to_type(u64))
    let i int = 0
    for i <= n { h = ir_module_fnv_byte(h, text[i].to_type(u8)); i += 1 }
    *result = h
    return 0
}

// ir_module_identity_head：把格式版本与全部目标身份字段并入哈希。
// 覆盖字段：序列化格式版本、内存模块版本、目标 key、指针位宽、字节序、
// 布局版本、完整 triple、data_layout、abi。全部取自模块自身，不含函数私有
// type_id、前端符号槽、文件路径或任何进程地址。
fn ir_module_identity_head(unit *IRModule, result *u64) int {
    if (unit == 0 || result == 0) { return -1 }
    let h u64 = IR_MODULE_FNV_BASIS
    h = ir_module_fnv_u64(h, IR_MODULE_SERIAL_VERSION.to_type(i64).to_type(u64))
    h = ir_module_fnv_u64(h, IR_MODULE_VERSION.to_type(i64).to_type(u64))
    h = ir_module_fnv_u64(h, unit.target.key.to_type(i64).to_type(u64))
    h = ir_module_fnv_u64(h, unit.target.pointer_bits.to_type(i64).to_type(u64))
    h = ir_module_fnv_u64(h, unit.target.little_endian.to_type(i64).to_type(u64))
    h = ir_module_fnv_u64(h, unit.target.layout_version.to_type(i64).to_type(u64))
    let next u64 = 0
    if (ir_module_fnv_text(h, unit.target.triple, &next) != 0) { return -1 }
    h = next
    if (ir_module_fnv_text(h, unit.target.data_layout, &next) != 0) { return -1 }
    h = next
    if (ir_module_fnv_text(h, unit.target.abi, &next) != 0) { return -1 }
    *result = next
    return 0
}

// ir_module_hex_digits：把 64 位值写成 16 个小写十六进制字符（高位在前）。
fn ir_module_hex_digits(value u64, out *u8) void {
    let i int = 0
    for i < 16 {
        let nibble int = ((value >> ((15 - i) * 4)) & 15).to_type(int)
        if (nibble < 10) { out[i] = ('0' + nibble).to_type(u8) }
        else { out[i] = ('a' + nibble - 10).to_type(u8) }
        i += 1
    }
}

