module proj
import gen

// ============================================================================
// proj_20_path.yh —— 路径、环境与窄口读（B1-1，2026-10-26）
//
// 三部分：
//   1. 路径规范化与名字池落地（canon/pool_str/file_exists/diag）；
//   2. 环境与根项目登记（env_fetch/set_root_project/is_root_project）；
//   3. 前端窄口读（file/file_count/test_file_selected）。
//
// 窄口的意义：parse/ast/check 只需要"这个文件的声明槽、文件数、这个文件是否
// 属于本轮测试"，不应该看见整个项目模型。此前这些函数挂在 gen 上（gen 是
// proj 的下层，只能读自己那份表），表搬到 proj 后窄口随之落在这里。
// ============================================================================

// pool_str：把名字池偏移转换成 C 字符串指针（池字节保证 NUL 结尾）。
pub fn pool_str(off int) *char {
    return (gen.task().np_data + off).to_type(*char)
}

// env_fetch：在 OS 传入的 envp 中精确匹配 name= 前缀，并把值 intern 到
// 编译器字符串池。name 以 NUL 结尾；off/olen 返回值的池偏移和字节长度；
// 变量缺失时成功返回空字符串，参数无效或字符串池分配失败时返回 -1。
pub fn env_fetch(name *char, off *int, olen *int) int {
    if (name == 0 || off == 0 || olen == 0) {
        return -1
    }
    let key_len int = 0
    for name[key_len] != 0 {
        key_len += 1
    }
    let rowi int = 0
    for g_proj.envp != 0 && g_proj.envp[rowi] != 0 {
        let row *char = g_proj.envp[rowi]
        let j int = 0
        for j < key_len && row[j] == name[j] {
            j += 1
        }
        if (j == key_len && row[j] == '=') {
            let value *char = (row + j + 1).to_type(*char)
            let value_len int = 0
            for value[value_len] != 0 {
                value_len += 1
            }
            let value_off int = gen.tml_intern_str(value.to_type(*u8), 0, value_len)
            if (value_off < 0) {
                return -1
            }
            off[0] = value_off
            olen[0] = value_len
            return 0
        }
        rowi += 1
    }
    let empty [1]u8
    empty[0] = 0
    let empty_off int = gen.tml_intern_str(empty, 0, 0)
    if (empty_off < 0) {
        return -1
    }
    off[0] = empty_off
    olen[0] = 0
    return 0
}

// file_exists：路径是否可打开（项目发现期的轻量存在性检查）。
pub fn file_exists(path *char) int {
    let fd int = open(path, 0)
    if (fd < 0) {
        return 0
    }
    close(fd)
    return 1
}

// set_root_project：命令在装载根项目前登记根路径。
// 依赖项目递归装载时保持根路径不变，供 project_link 只对根项目解析 [link]。
pub fn set_root_project(off int, plen int) void {
    g_proj.root_off = off
    g_proj.root_len = plen
}

// dep_opt_enabled：依赖项目是否按 O2 发射（缺省开，`YH_DEP_OPT=0` 关闭）。
// 依赖项目（标准库/第三方）在产物里是「整模块对象」，O0 会把整套未优化实现
// 带进每个程序（J6-L3 实测 fmt 版 hello：`__text` 35.7 KB → 12.5 KB）。
// 根项目（用户代码）不受影响，仍用命令行优化级，缺省 O0——自举与语料口径不变。
fn dep_opt_enabled() int {
    let off int = -1
    let olen int = 0
    if (env_fetch("YH_DEP_OPT", &off, &olen) != 0 || olen == 0) { return 1 }
    let first char = gen.np_cstr(off)[0]
    if (first == '0' || first == 'n' || first == 'N'
        || first == 'f' || first == 'F') {
        return 0
    }
    return 1
}

// module_opt_level：模块代码生成优化级（合入 J6-L3）。
// 依赖项目取 2；根项目取命令行优化级。对象发射、模块 manifest 键与函数 IR
// 环境键共用本判定，避免多处漂移。
pub fn module_opt_level(m int) int {
    let level int = cfg().opt_level
    if (dep_opt_enabled() == 0) { return level }
    if (m < 0 || m >= ctx().mod_n) { return level }
    let owner int = ctx().mods[m].proj
    if (owner < 0 || owner >= ctx().proj_n) { return level }
    if (is_root_project(ctx().projs[owner].root_off, ctx().projs[owner].root_len) == 0) {
        return 2
    }
    return level
}

// is_root_project：当前装载的是不是命令根项目。
pub fn is_root_project(off int, plen int) int {
    if (g_proj.root_off < 0) { return 0 }
    if (g_proj.root_len != plen) { return 0 }
    let i int = 0
    for i < plen {
        if (gen.task().np_data[g_proj.root_off + i] != gen.task().np_data[off + i]) { return 0 }
        i += 1
    }
    return 1
}

// canon：把 base（池内串）与 rel（NUL 串）连接并规范化，intern 后经
// out_off/out_len 显式返回；成功返回 0，路径过长或分配失败返回 -1。
//
// B1-2（2026-10-26）取消了原来的隐式出参（ProjectCtx.canon_off/len）：
// 那对字段既是 canon 的结果、又被 mb_mod_tag 当模块标签的暂存槽，父子进程共享
// 同名槽位容易读到上一步的值（症状是路径串位而不崩）。现在结果只经调用方的
// 局部量返回，谁调用谁负责。
pub fn canon(base_off int, base_len int, rel *char,
    out_off *int, out_len *int) int {
    // 组装原始串到临时堆缓冲（路径有 1024 上限，超出报错）
    let raw [1024]u8
    let rn int = 0
    let use_rel_only int = 0
    if (rel[0] == '/') {
        use_rel_only = 1
    }
    // Windows 绝对路径是 `C:/dir`（无反斜杠前缀）：盘符前缀同样不拼 base，
    // 否则单文件测试的 `source = "C:/..."` 会被拼到临时项目根后面。
    if (use_rel_only == 0 && gen.tg_host_windows() != 0 && rel[1] == ':'
        && ((rel[0] >= 'a' && rel[0] <= 'z') || (rel[0] >= 'A' && rel[0] <= 'Z'))) {
        use_rel_only = 1
    }
    if (use_rel_only == 0) {
        let i int = 0
        for i < base_len {
            raw[rn] = gen.task().np_data[base_off + i]
            rn += 1
            i += 1
        }
        if (rn > 0 && raw[rn - 1] != '/') {
            raw[rn] = '/'
            rn += 1
        }
    }
    let j int = 0
    for rel[j] != 0 {
        raw[rn] = rel[j].to_type(u8)
        rn += 1
        j += 1
        if (rn >= 1023) {
            return gen.fail("路径过长")
        }
    }
    raw[rn] = 0
    // 段栈规范化
    let segs [128][256]u8  // 每段最长 255
    let seg_len [128]int
    let sn int = 0
    let i2 int = 0
    for i2 < rn {
        // 跳过多余斜杠
        for i2 < rn && raw[i2] == '/' {
            i2 += 1
        }
        let s int = i2
        for i2 < rn && raw[i2] != '/' {
            i2 += 1
        }
        let sl int = i2 - s
        if (sl == 0) {
            break
        }
        if (sl == 1 && raw[s] == '.') {
            continue
        }
        if (sl == 2 && raw[s] == '.' && raw[s + 1] == '.') {
            // 顶端是普通段才弹出；否则保留 ".."（相对路径上越 cwd）
            if (sn > 0 && !(seg_len[sn - 1] == 2 && segs[sn - 1][0] == '.' && segs[sn - 1][1] == '.')) {
                sn -= 1
                continue
            }
        }
        if (sn >= 128 || sl > 255) {
            return gen.fail("路径过长")
        }
        let k int = 0
        for k < sl {
            segs[sn][k] = raw[s + k]
            k += 1
        }
        seg_len[sn] = sl
        sn += 1
    }
    // 重新拼接入池
    let tmp [1024]u8
    let tn int = 0
    // 空段栈：绝对路径为根 '/'；相对路径（如 "." 折叠后）为本目录 "."。
    if (sn == 0) {
        if (rn > 0 && raw[0] == '/') {
            tmp[0] = '/'
            tn = 1
        } else {
            tmp[0] = '.'
            let o int = gen.tml_intern_str(tmp, 0, 1)
            if (o < 0) {
                return -1
            }
            out_off[0] = o
            out_len[0] = 1
            return 0
        }
    }
    if (rn > 0 && raw[0] == '/') {
        tmp[0] = '/'
        tn = 1
    }
    let si int = 0
    for si < sn {
        if (tn > 0 && tmp[tn - 1] != '/') {
            tmp[tn] = '/'
            tn += 1
        }
        let k2 int = 0
        for k2 < seg_len[si] {
            tmp[tn] = segs[si][k2]
            tn += 1
            k2 += 1
        }
        si += 1
    }
    tmp[tn] = 0
    out_off[0] = gen.tml_intern_str(tmp, 0, tn)
    out_len[0] = tn
    if (out_off[0] < 0) {
        return -1
    }
    return 0
}

// diag：项目清单诊断（project.toml 行号 + 消息），返回 -1 供调用方传播。
pub fn diag(root_off int, line int, msg *char) int {
    let buf [1024]u8
    let n int = 0
    n = gen.append_str(buf, n, pool_str(root_off))
    n = gen.append_str(buf, n, "/project.toml:")
    n = gen.append_int(buf, n, line)
    n = gen.append_str(buf, n, ": 错误: ")
    n = gen.append_str(buf, n, msg)
    n = gen.append_byte(buf, n, '\n')
    gen.write_all(2, buf, n)
    gen.task().c_errors += 1
    return -1
}

// file：按文件下标取只读文件表项（前端窄口）。
pub fn file(i int) *PFile {
    return &g_proj.files[i]
}

// file_count：本轮构建的源文件数（前端窄口）。
pub fn file_count() int {
    return g_proj.file_n
}

// file_rel_path：把文件相对其所属项目根的规范路径写入 out（NUL 结尾）。
// 源文件在项目根之外（单文件测试等）时退回绝对路径，保证键仍可区分。
// 返回字节长度，参数/容量非法返回 -1。路径统一用 '/' 分隔。
pub fn file_rel_path(fi int, out *u8, capacity int) int {
    if (out == 0 || capacity <= 1 || fi < 0 || fi >= g_proj.file_n) { return -1 }
    let tk *gen.TaskCtx = gen.task()
    let file PFile = g_proj.files[fi]
    let pj int = -1
    if (file.mod >= 0 && file.mod < g_proj.mod_n) {
        pj = g_proj.mods[file.mod].proj
    }
    let start int = 0
    if (pj >= 0 && pj < g_proj.proj_n) {
        let root_off int = g_proj.projs[pj].root_off
        let root_len int = g_proj.projs[pj].root_len
        if (root_len > 0 && file.path_len >= root_len) {
            let same int = 1
            let i int = 0
            for i < root_len {
                if (tk.np_data[file.path_off + i] != tk.np_data[root_off + i]) {
                    same = 0
                    break
                }
                i += 1
            }
            if (same != 0) {
                let root_slash int = (root_len > 0
                    && tk.np_data[root_off + root_len - 1] == '/') ? 1 : 0
                if (file.path_len == root_len || root_slash != 0) {
                    start = root_len
                } else if (tk.np_data[file.path_off + root_len] == '/') {
                    start = root_len + 1
                }
            }
        }
    }
    let n int = 0
    let i int = start
    for i < file.path_len {
        if (n + 1 >= capacity) { return -1 }
        out[n] = tk.np_data[file.path_off + i]
        n += 1
        i += 1
    }
    out[n] = 0
    return n
}

// file_locs_path：写入 locs/IR source_filename 使用的路径。
// 默认保留绝对路径（诊断可定位）；`--trimpath` 时用项目相对路径，使不同目录
// 的同一源码产生相同的 LLVM 文本/来源表。返回字节长度，失败 -1。
pub fn file_locs_path(fi int, out *u8, capacity int) int {
    if (out == 0 || capacity <= 1 || fi < 0 || fi >= g_proj.file_n) { return -1 }
    if (cfg().trimpath != 0) {
        return file_rel_path(fi, out, capacity)
    }
    let tk *gen.TaskCtx = gen.task()
    let file PFile = g_proj.files[fi]
    if (file.path_len + 1 > capacity) { return -1 }
    let i int = 0
    for i < file.path_len {
        out[i] = tk.np_data[file.path_off + i]
        i += 1
    }
    out[file.path_len] = 0
    return file.path_len
}

// test_file_selected：该文件是否属于本轮 yh test 要检查的目标（已应用模块/
// 文件过滤）。把"测试执行器的选择条件"收在一处，前端只问"这个文件要不要
// 登记测试声明"，不必知道 `--filter` 的存在。依赖与标准库里的 test 声明
// 一律返回 0：它们不会走测试体解析，登记了就会留下没有函数体的受检声明。
pub fn test_file_selected(fi int) int {
    if (gen.task().c_test_mode == 0 || g_proj.test_project < 0) { return 0 }
    if (fi < 0 || fi >= g_proj.file_n) { return 0 }
    let m int = g_proj.files[fi].mod
    if (m < 0 || m >= g_proj.mod_n) { return 0 }
    if (g_proj.mods[m].proj != g_proj.test_project) { return 0 }
    if (g_proj.test_mod_filter >= 0 && g_proj.test_mod_filter != m) { return 0 }
    if (g_proj.test_file_filter >= 0 && g_proj.test_file_filter != fi) { return 0 }
    return 1
}
