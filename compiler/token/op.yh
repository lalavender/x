module token

// ============================================================================
// op.yh —— token 种类的纯判定
//
// 只做 token 区间/类别的纯函数判断，不读状态、不诊断。
// is_assign_op 供解析器与 check 判断赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
// ============================================================================

// is_assign_op：k 是否为赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
pub fn is_assign_op(k int) int {
    return (k >= TK_ASSIGN && k <= TK_RSHIFTEQ).to_type(int)
}

// yh test 内建测试：赋值运算符区间边界。生产构建不登记。
test "is_assign_op 边界" {
    $assert(is_assign_op(TK_ASSIGN) == 1)
    $assert(is_assign_op(TK_RSHIFTEQ) == 1)
    $assert(is_assign_op(TK_RANGE) == 0)
    $assert(is_assign_op(TK_PLUS) == 0)
    $assert(is_assign_op(TK_EQEQ) == 0)
}
