module token

// 从 compiler/token/op.yh 迁出的 yh test 块（pub 声明已迁 api.yh）。

test "is_assign_op 边界" {
    $assert(is_assign_op(TK_ASSIGN) == 1)
    $assert(is_assign_op(TK_RSHIFTEQ) == 1)
    $assert(is_assign_op(TK_RANGE) == 0)
    $assert(is_assign_op(TK_PLUS) == 0)
    $assert(is_assign_op(TK_EQEQ) == 0)
}
