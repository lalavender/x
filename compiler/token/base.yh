module token
import support

// ============================================================================
// base.yh —— 词法/语法共享词汇：token 种类、Tok、PDecl
//
// token 不复制字符串：start/len 引用源码字节区间，line/col 是 1 基位置。
// 本文件只放词汇、声明索引与 TokenCtx；词法器写 token，解析器读游标。
// `err_tok` 暂留 gen（等 DiagCtx 迁 support 后再搬）。`gen` 暂时保留同名
// type/const 别名，调用面不动。
// ============================================================================

// token 种类常量
//
// 编号分组（范围判断依赖该布局，勿随意调换）：
//   0..4    特殊：EOF、标识符、数字、字符串、字符字面量
//   5..15   标点（括号、花括号、方括号、分号、逗号、点、问号、冒号）
//   16..40  语言关键字；TK_AS=39、TK_TO_TYPE=40 恰为组尾——
//           「成员名」判断使用 16..39（to_type 不放开学成员名）
//   41      已移除的 C 关键字（保留字，仅成员位置放开）
//   42..43  模块关键字 module/import（MOD-U1，仅文件头，不作成员名）
//   45      test（YT0；成员位置放开，见 is_member_name）
//   50..63  内建类型名（连续区间，is_type_start 依赖）
//   64..    运算符：算术/位运算、逻辑、移位、比较、赋值（含复合）、区间、变参
// ---------------------------------------------------------------------------

// ---- 特殊 token（0..4） ----
pub const TOK_EOF int = 0      // 文件结束（词法器在末尾补一个，位置指向源尾）
pub const TOK_IDENT int = 1    // 标识符
pub const TOK_NUMBER int = 2   // 数字字面量（整数或浮点，值校验交给语义）
pub const TOK_STRING int = 3   // 字符串字面量（含首尾引号的原样字节区间）
pub const TOK_CHAR int = 4     // 字符字面量（含首尾单引号）

// ---- 字符串插值内部 token（200+；只由词法扩展器产生，用户源码不可写出） ----
pub const TOK_INTERP_BEGIN int = 200      // 插值字面量开始（开引号）
pub const TOK_INTERP_TEXT int = 201       // 字面文本块（不含引号，转义保留）
pub const TOK_INTERP_EXPR_BEGIN int = 202 // `${`
pub const TOK_INTERP_EXPR_END int = 203   // 表达式结束（`:` 或 `}` 前）
pub const TOK_INTERP_SPEC int = 204       // 格式说明符原文（不含冒号）
pub const TOK_INTERP_END int = 205        // 插值字面量结束（闭引号）

// ---- 标点（5..15） ----
pub const TK_LPAREN int = 5        // (
pub const TK_RPAREN int = 6        // )
pub const TK_LBRACE int = 7        // {
pub const TK_RBRACE int = 8        // }
pub const TK_LBRACKET int = 9      // [
pub const TK_RBRACKET int = 10     // ]
pub const TK_SEMI int = 11         // ;
pub const TK_COMMA int = 12        // ,
pub const TK_DOT int = 13          // .
pub const TK_QUEST int = 14        // ?
pub const TK_COLON int = 15        // :

// ---- 语言关键字（16..40，与 docs/yh.g4 的保留字一致） ----
pub const TK_PUB int = 16
pub const TK_LET int = 17
pub const TK_CONST int = 18
pub const TK_FN int = 19
pub const TK_TYPE int = 20
pub const TK_STRUCT int = 21
pub const TK_UNION int = 22
pub const TK_ENUM int = 23
pub const TK_IF int = 24
pub const TK_ELSE int = 25
pub const TK_SWITCH int = 26
pub const TK_CASE int = 27
pub const TK_DEFAULT int = 28
pub const TK_FOR int = 29
pub const TK_IN int = 30
pub const TK_RETURN int = 31
pub const TK_BREAK int = 32
pub const TK_CONTINUE int = 33
pub const TK_GOTO int = 34
pub const TK_TRUE int = 35
pub const TK_FALSE int = 36
pub const TK_SIZEOF int = 37
pub const TK_LEN int = 38
pub const TK_AS int = 39           // 旧转换写法，已移除；仍可作成员名
pub const TK_TO_TYPE int = 40      // 后缀转换专用字；不作成员名

// ---- 已移除的 C 关键字（41）：全部归并为一类保留字 ----
// while do unsigned signed short long float double typedef extern static
// register auto inline volatile restrict
// 它们不能作标识符（rejected/05），但成员位置放开（memberName）。
pub const TK_RESERVED int = 41

// ---- 模块关键字（42..43，MOD-U1） ----
// 仅在文件头（module 声明 → import 声明 → 业务声明）出现；不作标识符、
// 不放开成员名（is_member_name 的区间判断不覆盖 42..43）。
pub const TK_MODULE int = 42   // module —— 文件头模块归属声明
pub const TK_IMPORT int = 43   // import —— 文件头导入声明
pub const TK_AT int = 44       // @ —— 顶层属性列表
pub const TK_TEST int = 45     // test —— 顶层测试声明（YT0）
pub const TK_DOLLAR int = 97   // $ —— 显式编译期函数调用前缀

// ---- 内建类型名（50..63，连续区间） ----
pub const TK_INT int = 50
pub const TK_I8 int = 51
pub const TK_I16 int = 52
pub const TK_I32 int = 53
pub const TK_I64 int = 54
pub const TK_U8 int = 55
pub const TK_U16 int = 56
pub const TK_U32 int = 57
pub const TK_U64 int = 58
pub const TK_F32 int = 59
pub const TK_F64 int = 60
pub const TK_BOOL int = 61
pub const TK_CHAR int = 62
pub const TK_VOID int = 63

// ---- 运算符（64..，含多字符运算符） ----
pub const TK_PLUS int = 64         // +
pub const TK_MINUS int = 65        // -
pub const TK_STAR int = 66         // *
pub const TK_SLASH int = 67        // /
pub const TK_PERCENT int = 68      // %
pub const TK_AMP int = 69          // &
pub const TK_PIPE int = 70         // |
pub const TK_CARET int = 71        // ^
pub const TK_TILDE int = 72        // ~
pub const TK_BANG int = 73         // !
pub const TK_LT int = 74           // <
pub const TK_GT int = 75           // >
pub const TK_EQEQ int = 76         // ==
pub const TK_NEQ int = 77          // !=
pub const TK_LEQ int = 78          // <=
pub const TK_GEQ int = 79          // >=
pub const TK_ANDAND int = 80       // &&
pub const TK_OROR int = 81         // ||
pub const TK_LSHIFT int = 82       // <<
pub const TK_RSHIFT int = 83       // >>
pub const TK_ASSIGN int = 84       // =
pub const TK_PLUSEQ int = 85       // +=
pub const TK_MINUSEQ int = 86      // -=
pub const TK_STAREQ int = 87       // *=
pub const TK_SLASHEQ int = 88      // /=
pub const TK_PERCENTEQ int = 89    // %=
pub const TK_AMPEQ int = 90        // &=
pub const TK_PIPEEQ int = 91       // |=
pub const TK_CARETEQ int = 92      // ^=
pub const TK_LSHIFTEQ int = 93     // <<=
pub const TK_RSHIFTEQ int = 94     // >>=
pub const TK_RANGE int = 95        // ..
pub const TK_ELLIPSIS int = 96     // ...

// ---- 顶层属性位（解析期间使用） ----
// ATTR_* 的唯一来源在 support/model.yh（support 不能 import token，故方向是
// token → support）；这里保留同名别名，词法层与调用方都按 token.ATTR_* 用。
pub const ATTR_EXTERN int = support.ATTR_EXTERN
pub const ATTR_INLINE int = support.ATTR_INLINE
pub const ATTR_NORETURN int = support.ATTR_NORETURN
pub const ATTR_OPAQUE int = support.ATTR_OPAQUE
pub const ATTR_COMPTIME int = support.ATTR_COMPTIME

// ---------------------------------------------------------------------------
// 数据结构
// ---------------------------------------------------------------------------

// Tok：单个 token 的全部信息。
// token 不复制字符串，start/len 直接引用 support.fc().c_src 的字节区间；line/col 为
// 1 基位置（col 按 token 首字节相对行首的字节偏移 + 1 计）。
pub struct Tok {
    kind int       // 种类（上方常量之一）
    start int      // 在 support.fc().c_src 中的起始字节下标
    len int        // 字节长度（EOF 为 0）
    line int       // 1 基行号
    col int        // 1 基列号（字节偏移）
}

// PDecl：单个顶层声明的紧凑语法索引，范围为 token 下标 [start,end)。
// 仅提供跳转边界与声明种类，不包含表达式树或语义绑定。
pub struct PDecl {
    start int      // 可选 pub 修饰符或声明关键字的 token 下标
    end int        // 声明结束后的第一个 token 下标
    kind int       // let/const/fn/type/struct/union/enum 等关键字 token
    keyword int    // 声明关键字 token 下标（属性前缀与 pub 之后）
    line int       // 声明首 token 的 1 基源行
    col int        // 声明首 token 的 1 基源列
    test_sym int   // 测试模式下 test 体函数符号；生产构建与普通声明为 -1
}

// TokenCtx：本任务（当前编译单元）的 token 数组与解析游标。
// 数组由词法器 token.push 倍增扩容；pos 是解析器的当前 token 下标。
// 生命周期跟随任务，跨文件复位时由调用方把 count/pos 置 0，不释放旧数组。
pub struct TokenCtx {
    tokens *Tok // token 数组首址（malloc；容量满时倍增）
    count int // 已存 token 数（含 EOF）
    cap int // 已分配槽位数
    pos int // 当前 token 下标（解析游标）
}
