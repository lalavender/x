pub const TK_ANDAND int = support.TK_ANDAND

pub const TK_OROR int = support.TK_OROR

pub const TK_LSHIFT int = support.TK_LSHIFT

pub const TK_RSHIFT int = support.TK_RSHIFT

pub const TK_ASSIGN int = support.TK_ASSIGN

