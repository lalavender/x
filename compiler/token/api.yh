// ---- 顶层属性位（解析期间使用） ----
// ATTR_* 的唯一来源在 support/model.yh（support 不能 import token，故方向是
// token → support）；这里保留同名别名，词法层与调用方都按 token.ATTR_* 用。
pub const ATTR_EXTERN int = support.ATTR_EXTERN

pub const ATTR_INLINE int = support.ATTR_INLINE

pub const ATTR_NORETURN int = support.ATTR_NORETURN

pub const ATTR_OPAQUE int = support.ATTR_OPAQUE

pub const ATTR_COMPTIME int = support.ATTR_COMPTIME

// Tok：单个 token 的全部信息。
// token 不复制字符串，start/len 直接引用 support.fc().c_src 的字节区间；line/col 为
// 1 基位置（col 按 token 首字节相对行首的字节偏移 + 1 计）。
pub struct Tok {
    kind int       // 种类（上方常量之一）
    start int      // 在 support.fc().c_src 中的起始字节下标
    len int        // 字节长度（EOF 为 0）
    line int       // 1 基行号
    col int        // 1 基列号（字节偏移）
}

// PDecl：单个顶层声明的紧凑语法索引，范围为 token 下标 [start,end)。
// 仅提供跳转边界与声明种类，不包含表达式树或语义绑定。
pub struct PDecl {
    start int      // 可选 pub 修饰符或声明关键字的 token 下标
    end int        // 声明结束后的第一个 token 下标
    kind int       // let/const/fn/type/struct/union/enum 等关键字 token
    keyword int    // 声明关键字 token 下标（属性前缀与 pub 之后）
    line int       // 声明首 token 的 1 基源行
    col int        // 声明首 token 的 1 基源列
    test_sym int   // 测试模式下 test 体函数符号；生产构建与普通声明为 -1
}

// TokenCtx：本任务（当前编译单元）的 token 数组与解析游标。
// 数组由词法器 token.push 倍增扩容；pos 是解析器的当前 token 下标。
// 生命周期跟随任务，跨文件复位时由调用方把 count/pos 置 0，不释放旧数组。
pub struct TokenCtx {
    tokens *Tok // token 数组首址（malloc；容量满时倍增）
    count int // 已存 token 数（含 EOF）
    cap int // 已分配槽位数
    pos int // 当前 token 下标（解析游标）
}

// is_assign_op：k 是否为赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
pub fn is_assign_op(k int) int {
    return (k >= TK_ASSIGN && k <= TK_RSHIFTEQ).to_type(int)
}

// ctx：返回当前任务的 token 上下文；调用方直接读写公开字段。
pub fn ctx() *TokenCtx {
    return &g_tokens
}

// push：向 token 表追加一个 token，容量满时倍增扩容。
// 成功返回 0；内存分配失败输出诊断并返回 -1。扩容后旧数组释放。
pub fn push(kind int, start int, n int, line int, col int) int {
    let tk *TokenCtx = ctx()
    if (tk.count == tk.cap) {
        let ncap int = tk.cap * 2
        if (ncap == 0) {
            ncap = 1024
        }
        let nd *Tok = malloc((ncap * sizeof(Tok)).to_type(u64)).to_type(*Tok)
        if (nd == 0) {
            return support.fail("内存分配失败")
        }
        if (tk.count > 0) {
            memcpy(nd, tk.tokens, (tk.count * sizeof(Tok)).to_type(u64))
        }
        free(tk.tokens)
        tk.tokens = nd
        tk.cap = ncap
    }
    tk.tokens[tk.count].kind = kind
    tk.tokens[tk.count].start = start
    tk.tokens[tk.count].len = n
    tk.tokens[tk.count].line = line
    tk.tokens[tk.count].col = col
    tk.count += 1
    return 0
}

// err_tok：以当前 token 的行列位置报错，返回 -1。
// 调用方必须保证 pos 落在 [0,count)；pos 由解析器维护。
pub fn err_tok(msg *char) int {
    let tk *TokenCtx = ctx()
    return support.err_lc(tk.tokens[tk.pos].line, tk.tokens[tk.pos].col, msg)
}
