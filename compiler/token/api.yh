pub const TK_MINUSEQ int = support.TK_MINUSEQ

pub const TK_STAREQ int = support.TK_STAREQ

pub const TK_SLASHEQ int = support.TK_SLASHEQ

pub const TK_PERCENTEQ int = support.TK_PERCENTEQ

pub const TK_AMPEQ int = support.TK_AMPEQ

pub const TK_PIPEEQ int = support.TK_PIPEEQ

pub const TK_CARETEQ int = support.TK_CARETEQ

pub const TK_LSHIFTEQ int = support.TK_LSHIFTEQ

