// ---- 顶层属性位（解析期间使用） ----
// ATTR_* 的唯一来源在 support/api.yh（support 不能 import token，故方向是
// token → support）；这里保留同名别名，词法层与调用方都按 token.ATTR_* 用。
pub const ATTR_EXTERN int = support.ATTR_EXTERN

pub const ATTR_INLINE int = support.ATTR_INLINE

pub const ATTR_NORETURN int = support.ATTR_NORETURN

pub const ATTR_OPAQUE int = support.ATTR_OPAQUE

pub const ATTR_COMPTIME int = support.ATTR_COMPTIME

// Tok：单个 token 的全部信息。
// token 不复制字符串，start/len 直接引用 support.fc().c_src 的字节区间；line/col 为
// 1 基位置（col 按 token 首字节相对行首的字节偏移 + 1 计）。
pub struct Tok {
    kind int       // 种类（上方常量之一）
    start int      // 在 support.fc().c_src 中的起始字节下标
    len int        // 字节长度（EOF 为 0）
    line int       // 1 基行号
    col int        // 1 基列号（字节偏移）
}

// PDecl：单个顶层声明的紧凑语法索引，范围为 token 下标 [start,end)。
// 仅提供跳转边界与声明种类，不包含表达式树或语义绑定。
pub struct PDecl {
    start int      // 可选 pub 修饰符或声明关键字的 token 下标
    end int        // 声明结束后的第一个 token 下标
    kind int       // let/const/fn/type/struct/union/enum 等关键字 token
    keyword int    // 声明关键字 token 下标（属性前缀与 pub 之后）
    line int       // 声明首 token 的 1 基源行
    col int        // 声明首 token 的 1 基源列
    test_sym int   // 测试模式下 test 体函数符号；生产构建与普通声明为 -1
}

// TokenCtx：本任务（当前编译单元）的 token 数组与解析游标。
// 数组由词法器 token.push 倍增扩容；pos 是解析器的当前 token 下标。
// 生命周期跟随任务，跨文件复位时由调用方把 count/pos 置 0，不释放旧数组。
pub struct TokenCtx {
    tokens *Tok // token 数组首址（malloc；容量满时倍增）
    count int // 已存 token 数（含 EOF）
    cap int // 已分配槽位数
    pos int // 当前 token 下标（解析游标）
}

// is_assign_op：k 是否为赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
pub fn is_assign_op(k int) int {
    return (k >= TK_ASSIGN && k <= TK_RSHIFTEQ).to_type(int)
}

// ctx：返回当前任务的 token 上下文；调用方直接读写公开字段。
pub fn ctx() *TokenCtx {
    return &g_tokens
}

// push：向 token 表追加一个 token，容量满时倍增扩容。
// 成功返回 0；内存分配失败输出诊断并返回 -1。扩容后旧数组释放。
pub fn push(kind int, start int, n int, line int, col int) int {
    let tk *TokenCtx = ctx()
    if (tk.count == tk.cap) {
        let ncap int = tk.cap * 2
        if (ncap == 0) {
            ncap = 1024
        }
        let nd *Tok = malloc((ncap * sizeof(Tok)).to_type(u64)).to_type(*Tok)
        if (nd == 0) {
            return errors.fail("内存分配失败")
        }
        if (tk.count > 0) {
            memcpy(nd, tk.tokens, (tk.count * sizeof(Tok)).to_type(u64))
        }
        free(tk.tokens)
        tk.tokens = nd
        tk.cap = ncap
    }
    tk.tokens[tk.count].kind = kind
    tk.tokens[tk.count].start = start
    tk.tokens[tk.count].len = n
    tk.tokens[tk.count].line = line
    tk.tokens[tk.count].col = col
    tk.count += 1
    return 0
}

// err_tok：以当前 token 的行列位置与字节宽度报错，返回 -1。
// 调用方必须保证 pos 落在 [0,count)；pos 由解析器维护。宽度取 tok.len，
// 让源码片段的下划线覆盖整个 token（EOF 的 len 为 0，按 1 字节渲染）。
pub fn err_tok(msg *char) int {
    return err_at(ctx().pos, msg)
}

// real_index：把 token 下标夹到有效范围，并跳过词法器合成为「长度 0」的
// 隐式终结符与 EOF，回指最近的真实 token。
// 换行补入的隐式 `;` 起点正好落在行尾之后，若诊断落在它上面，caret 会显示
// 在「行尾 +1」；这些合成 token 不是源码里的真实构造，不该被指。
pub fn real_index(index int) int {
    let tk *TokenCtx = ctx()
    let i int = index
    if (i >= tk.count) { i = tk.count - 1 }
    if (i < 0) { i = 0 }
    for i > 0 && tk.tokens[i].len <= 0 {
        i -= 1
    }
    return i
}

// err_at：以指定 token 的位置与宽度报错，返回 -1。
// 用于「解析完一段构造、游标已前进」的调用点：传回构造的首 token，
// 而不是让 err_tok 指向其后的 `)`/`{`/行尾。下标越界时回退到当前 token；
// 合成 token 按 real_index 回指最近的真实 token。
pub fn err_at(index int, msg *char) int {
    let tk *TokenCtx = ctx()
    if (tk.count <= 0) { return errors.err_span(0, 1, 1, msg) }
    let i int = real_index(index)
    let t *Tok = &tk.tokens[i]
    return errors.err_span(t.line, t.col, t.len, msg)
}

// err_at_note：同 err_at，另带一条「说明:」行（修复建议）。
pub fn err_at_note(index int, msg *char, note *char) int {
    let tk *TokenCtx = ctx()
    if (tk.count <= 0) { return errors.err_span_note(0, 1, 1, msg, note) }
    let i int = real_index(index)
    let t *Tok = &tk.tokens[i]
    return errors.err_span_note(t.line, t.col, t.len, msg, note)
}

// err_tok_note：同 err_tok，另带一条「说明:」行（修复建议）。
pub fn err_tok_note(msg *char, note *char) int {
    return err_at_note(ctx().pos, msg, note)
}

// err_range：以 token 下标半开区间 [first, after) 作为出错构造报错，返回 -1。
// 跨度取首个 token 起点到最后一个 token 终点，并夹到同一行内（跨行构造只
// 下划线首行，见诊断规范 §4.2）。
pub fn err_range(first int, after int, msg *char) int {
    let tk *TokenCtx = ctx()
    let f int = first
    let a int = after
    if (f < 0) { f = 0 }
    if (f >= tk.count) { f = tk.count - 1 }
    if (f < 0) { f = 0 }
    if (a <= f) { return err_at(f, msg) }
    if (a > tk.count) { a = tk.count }
    // 尾端同样跳过合成 token（隐式 `;`/EOF），否则宽度会白吃到行尾之外
    let j int = real_index(a - 1)
    if (j < f) { j = f }
    let t *Tok = &tk.tokens[f]
    let last *Tok = &tk.tokens[j]
    let width int = last.start + last.len - t.start
    if (width <= 0) { width = t.len }
    // 夹到行内：跨度不得越过首 token 所在行的行尾
    let src *u8 = support.src_ctx().data
    let slen int = support.src_ctx().length
    let line_end int = t.start
    for line_end < slen && src[line_end] != '\n' {
        line_end += 1
    }
    if (t.start + width > line_end) { width = line_end - t.start }
    return errors.err_span(t.line, t.col, width, msg)
}
// err_call_span：从调用构造首 token 到 `after`（不含）的整段跨度，允许跨行。
// 与 err_range 的差别是**不把跨度夹到首 token 所在行行尾**：多行调用的实参
// 列表会在后续行逐行下划线（渲染见 errors/render.yh 的 fmt_snippet）。单行时
// 与 err_range 等价；after <= first 时退化为 err_at。
pub fn err_call_span(first int, after int, msg *char) int {
    let tk *TokenCtx = ctx()
    let f int = first
    if (f < 0) { f = 0 }
    if (f >= tk.count) { f = tk.count - 1 }
    if (f < 0) { f = 0 }
    let a int = after
    if (a > tk.count) { a = tk.count }
    if (a <= f) { return err_at(f, msg) }
    let j int = real_index(a - 1)
    if (j < f) { j = f }
    let t *Tok = &tk.tokens[f]
    let last *Tok = &tk.tokens[j]
    let width int = last.start + last.len - t.start
    if (width <= 0) { width = t.len }
    return errors.err_span(t.line, t.col, width, msg)
}


// index_at_offset：按源字节偏移找 token 下标。
// 优先返回覆盖该偏移的 token；没有覆盖时返回起点不晚于该偏移的最后一个
// token（构造尾部/空白处）；都找不到返回 0。语义错误只拿到名字的
// (start,len) 源区间时用它换回 token，从而得到真实行列与宽度。
pub fn index_at_offset(off int) int {
    let tk *TokenCtx = ctx()
    if (tk.count <= 0) { return 0 }
    let i int = 0
    let best int = 0
    for i < tk.count {
        let t *Tok = &tk.tokens[i]
        if (off >= t.start && off < t.start + t.len) {
            return i
        }
        if (t.start <= off) { best = i }
        i += 1
    }
    return best
}
