// ============================================================================
// parse_decl.yh —— 自举编译器：顶层声明与源文件入口（两遍驱动）
//
// 覆盖 docs/yh.g4 的 sourceFile / topLevelDecl / topLevelDeclBody，以及
// letDecl、constDecl、fnDecl、paramList、param、typeDecl、structDecl、
// unionDecl、fieldDecl、enumDecl、enumItem。
//
// 两遍模型（语义边界 §1）：
//   pass 1（c_pass==1）  登记类型/字段/函数签名/全局名字，函数体与全局
//                        初始化表达式整块跳过（token 扫描）；
//   pass 2a              仅处理顶层 let/const：折叠初始化并发射数据；
//   pass 2b              仅处理 fn：逐个编译函数体。
// 语法模式（c_compile==0）单遍消费到 EOF，行为与 G1 一致。
//
// 编译模式的限制（B5 子集，B7 解除）：切片、for-in、结构体字面量作值、
// 结构体按值传参/返回/拷贝、类型化变参、用户裸变参、浮点运算。
// ============================================================================

// skip_to_decl_end：pass 1 跳过一条顶层声明的剩余 token。
// 以深度 0 处的 ';' 或 '}'（fn/struct/enum 体收尾）为界。
fn skip_to_decl_end() int {
    let depth int = 0;
    for p_cur() != TOK_EOF {
        let k int = p_cur();
        p_adv();
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
            continue;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            if (depth == 0) {
                return 0;
            }
            depth -= 1;
            if (depth == 0 && k == TK_RBRACE) {
                return 0;
            }
            continue;
        }
        if (k == TK_SEMI && depth == 0) {
            return 0;
        }
    }
    return 0;
}

// skip_init：pass 1 跳过一个绑定初始化表达式（到深度 0 的 ',' 或 ';'）。
fn skip_init() int {
    let depth int = 0;
    for 1 {
        let k int = p_cur();
        if (k == TOK_EOF) {
            return 0;
        }
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            depth -= 1;
        }
        if (depth == 0 && (k == TK_COMMA || k == TK_SEMI)) {
            return 0;
        }
        p_adv();
    }
    return 0;
}

// parse_source：全量解析（语法模式与 pass 1 用）。
fn parse_source() int {
    for p_cur() != TOK_EOF {
        if (parse_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

// at_top_decl_start：当前 token 是否为顶层声明的开始（pub 关键字由
// 调用方先消费）。
fn at_top_decl_start(k int) int {
    if (k == TK_LET || k == TK_CONST || k == TK_FN || k == TK_TYPE
        || k == TK_STRUCT || k == TK_UNION || k == TK_ENUM) {
        return 1;
    }
    return 0;
}

// skip_top_decl：pass 2 子遍跳过当前声明，停在下一个顶层声明关键字。
// 调用前提：当前 token 不是本子遍要处理的声明（至少消费一个 token）。
fn skip_top_decl() int {
    let depth int = 0;
    let consumed int = 0;
    for p_cur() != TOK_EOF {
        let k int = p_cur();
        if (consumed > 0 && depth == 0 && at_top_decl_start(k) != 0) {
            return 0;
        }
        p_adv();
        consumed = 1;
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
            continue;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            if (depth > 0) {
                depth -= 1;
            }
            continue;
        }
        if (k == TK_SEMI && depth == 0) {
            return 0;
        }
    }
    return 0;
}

// parse_source_globals：pass 2a——只处理顶层 let/const（源码顺序）。
fn parse_source_globals() int {
    for p_cur() != TOK_EOF {
        if (p_cur() == TK_PUB) {
            c_decl_pub = 1;
            p_adv();
            if (p_cur() == TK_LET) {
                if (parse_let_decl(1) != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            if (p_cur() == TK_CONST) {
                if (parse_const_decl(1) != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            // pub + 其他：回退处理
            if (skip_top_decl() != 0) {
                return -1;
            }
            continue;
        }
        c_decl_pub = 0;
        if (p_cur() == TK_LET) {
            if (parse_let_decl(1) != 0) {
                return -1;
            }
            continue;
        }
        if (p_cur() == TK_CONST) {
            if (parse_const_decl(1) != 0) {
                return -1;
            }
            continue;
        }
        if (skip_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_source_fns：pass 2b——只处理 fn（源码顺序）。
fn parse_source_fns() int {
    for p_cur() != TOK_EOF {
        if (p_cur() == TK_PUB) {
            c_decl_pub = 1;
            p_adv();
            if (p_cur() == TK_FN) {
                if (parse_fn_decl() != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            if (skip_top_decl() != 0) {
                return -1;
            }
            continue;
        }
        c_decl_pub = 0;
        if (p_cur() == TK_FN) {
            if (parse_fn_decl() != 0) {
                return -1;
            }
            continue;
        }
        if (skip_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_top_decl：单个顶层声明（语法模式与 pass 1 用）。
fn parse_top_decl() int {
    c_decl_pub = 0;
    if (p_cur() == TK_PUB) {
        c_decl_pub = 1;
        p_adv();
    }
    let k int = p_cur();
    if (k == TK_LET) {
        if (c_compile != 0 && c_pass == 2) {
            // pass 2 全量遍不走这里（globals/fns 子遍分工）
            return parse_let_decl(1);
        }
        return parse_let_decl(1);
    }
    if (k == TK_CONST) {
        return parse_const_decl(1);
    }
    if (k == TK_FN) {
        return parse_fn_decl();
    }
    if (k == TK_TYPE) {
        return parse_type_decl();
    }
    if (k == TK_STRUCT || k == TK_UNION) {
        return parse_struct_decl();
    }
    if (k == TK_ENUM) {
        return parse_enum_decl();
    }
    return err_tok("此处需要一个顶层声明");
}

// ---- 绑定与初始化 ----

// parse_binding：名字 + 必需类型 + 可选初值。kind：SYM_VAR / SYM_CONST。
// global=1 为顶层绑定（pass1 登记 / pass2 折叠发射），global=0 为局部。
// 通过 c_bind_idx 返回涉及的符号下标（无则为 -1）。
let c_bind_idx int = -1;

fn parse_binding(global int, kind int) int {
    c_bind_idx = -1;
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个变量名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    let tid int = parse_type_ref();
    if (tid < 0) {
        return -1;
    }
    if (c_compile == 0) {
        // 语法模式：只看初值形态
        if (p_cur() == TK_ASSIGN) {
            p_adv();
            let r Res;
            if (parse_expr_iso(&r) != 0) {
                return -1;
            }
        }
        return 0;
    }
    // 编译模式
    let idx int = -1;
    if (c_pass == 1) {
        // 顶层登记
        if (t_types[tid].kind == TY_ARRAY || t_types[tid].kind == TY_SLICE) {
            return sem_err("全局数组/切片将在 B7 支持");
        }
        let fl int = F_GLOBAL;
        if (c_decl_pub != 0) {
            fl |= F_PUB;
        }
        idx = sym_push(start, n, kind, tid, fl);
        if (idx < 0) {
            return -1;
        }
    } else if (global != 0) {
        idx = sym_lookup(start, n);
        if (idx < 0) {
            return sem_err("内部错误：全局符号丢失");
        }
    } else {
        // 局部
        if (sem_check_duplicate(start, n) != 0) {
            return -1;
        }
        if (kind == SYM_CONST) {
            idx = sym_push(start, n, SYM_CONST, tid, 0);
        } else {
            idx = sem_declare_local(start, n, tid);
        }
        if (idx < 0) {
            return -1;
        }
    }
    c_bind_idx = idx;
    if (p_cur() == TK_ASSIGN) {
        p_adv();
        if (c_pass == 1) {
            return skip_init();
        }
        if (global != 0) {
            return parse_global_init(idx, tid, kind);
        }
        return parse_local_init(idx, tid, kind);
    }
    // 无初值
    if (c_compile != 0 && kind == SYM_CONST) {
        return sem_err("const 必须带初值");
    }
    if (c_compile != 0 && c_pass == 2 && global != 0 && kind == SYM_VAR) {
        // 零初始化全局 → .bss
        return sem_global_zero(idx, tid);
    }
    return 0;
}

// parse_global_init：全局初始化（pass 2a，常量折叠 + 数据发射）。
fn parse_global_init(idx int, tid int, kind int) int {
    // 结构体/聚合字面量直初始化：B5 不支持全局聚合
    let fk int = t_types[tid].kind;
    if (fk == TY_STRUCT || fk == TY_UNION) {
        return sem_err("全局结构体将在 B7 支持");
    }
    c_fold += 1;
    let r Res;
    let rr int = parse_expr_iso(&r);
    c_fold -= 1;
    if (rr != 0) {
        return -1;
    }
    if (r.is_const == 0) {
        return sem_err("全局初始化必须是编译期常量");
    }
    if (sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1;
    }
    if (kind == SYM_CONST) {
        c_syms[idx].cval = r.ival;
        if (fk == TY_PTR) {
            c_syms[idx].flags |= F_ADDR;
        }
        return 0;
    }
    // 全局变量：指针的 0 是 NULL（.xword 0）；标签号 ≥ 1 才是字符串地址
    if (fk == TY_PTR) {
        if (r.ival == 0) {
            if (c_bss_n >= 4096) {
                return sem_err("零初始化全局过多");
            }
            c_syms[idx].offset = c_bss_n;
            c_bss_syms[c_bss_n] = idx;
            c_bss_n += 1;
            return 0;
        }
        if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
            return -1;
        }
        if (dat_puts(".xword\t.LD") != 0) {
            return -1;
        }
        if (dat_puti(r.ival.to_type(int)) != 0) {
            return -1;
        }
        return dat_put('\n');
    }
    if (r.ival == 0) {
        if (c_bss_n >= 4096) {
            return sem_err("零初始化全局过多");
        }
        c_syms[idx].offset = c_bss_n;
        c_bss_syms[c_bss_n] = idx;
        c_bss_n += 1;
        return 0;
    }
    if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
        return -1;
    }
    return em_data_scalar(tid, r.ival);
}

// sem_global_zero：零初始化全局登记进 .bss 清单。
fn sem_global_zero(idx int, tid int) int {
    if (c_bss_n >= 4096) {
        return sem_err("零初始化全局过多");
    }
    c_syms[idx].offset = c_bss_n;
    c_bss_syms[c_bss_n] = idx;
    c_bss_n += 1;
    return 0;
}

// parse_local_init：局部初始化（运行时求值；结构体字面量直初始化）。
fn parse_local_init(idx int, tid int, kind int) int {
    if (kind == SYM_CONST) {
        c_fold += 1;
        let cr Res;
        let crr int = parse_expr_iso(&cr);
        c_fold -= 1;
        if (crr != 0) {
            return -1;
        }
        if (cr.is_const == 0) {
            return sem_err("const 初始化必须是编译期常量");
        }
        if (sem_can_assign(tid, cr.type_id, cr.is_lit, cr.ival, cr.lit_big) != 0) {
            return -1;
        }
        c_syms[idx].cval = cr.ival;
        if (t_types[tid].kind == TY_PTR) {
            c_syms[idx].flags |= F_ADDR;
        }
        return 0;
    }
    let r Res;
    if (parse_expr_iso(&r) != 0) {
        return -1;
    }
    if (sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1;
    }
    return sem_store_local_value(idx, tid);
}


// ---- 顶层声明各形态 ----

// parse_let_decl：'let' binding (',' binding)* ';'。global=1 顶层。
fn parse_let_decl(global int) int {
    p_adv();
    for 1 {
        if (parse_binding(global, SYM_VAR) != 0) {
            return -1;
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            continue;
        }
        break;
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

// parse_const_decl：'const' IDENT typeRef '=' expr ';'。
fn parse_const_decl(global int) int {
    p_adv();
    for 1 {
        if (parse_binding(global, SYM_CONST) != 0) {
            return -1;
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            continue;
        }
        break;
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

// parse_fn_decl：'fn' IDENT '(' params ')' typeRef? body。
// pass 1：登记签名并跳过函数体；pass 2：编译函数体。
fn parse_fn_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个函数名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (p_expect(TK_LPAREN, "期望 '('") != 0) {
        return -1;
    }
    // 参数类型收集（两遍都要）
    let ptypes [64]int;
    let np int = 0;
    let vararg int = 0;
    let is_variadic_seen int = 0;
    let pnames [64]int;
    let pname_lens [64]int;
    if (p_cur() != TK_RPAREN) {
        for 1 {
            if (p_cur() == TK_ELLIPSIS) {
                p_adv();
                vararg = 1;
                if (c_compile != 0) {
                    return sem_err("用户源码不允许裸变参（仅 prelude）");
                }
                break;
            }
            if (p_cur() != TOK_IDENT) {
                return err_tok("此处需要一个参数名");
            }
            let ps int = c_toks[c_pos].start;
            let pn int = c_toks[c_pos].len;
            p_adv();
            let ptid int = 0;
            if (p_cur() == TK_ELLIPSIS) {
                // 类型化变参 name ... T：体内类型为 []T（打包为切片）
                p_adv();
                ptid = parse_type_ref();
                if (ptid < 0) {
                    return -1;
                }
                if (c_compile != 0) {
                    if (is_variadic_seen != 0) {
                        return sem_err("类型化变参至多一个且在末尾");
                    }
                    is_variadic_seen = 1;
                    ptid = ty_slice(ptid);
                }
            } else {
                ptid = parse_type_ref();
                if (ptid < 0) {
                    return -1;
                }
            }
            if (np >= 64) {
                return err_tok("参数过多");
            }
            pnames[np] = ps;
            pname_lens[np] = pn;
            ptypes[np] = ptid;
            np += 1;
            if (p_cur() == TK_COMMA) {
                p_adv();
                continue;
            }
            break;
        }
    }
    if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
        return -1;
    }
    let ret int = TY_VOID;
    if (is_type_start(p_cur()) != 0) {
        let rt int = parse_type_ref();
        if (rt < 0) {
            return -1;
        }
        ret = rt;
    }
    if (c_compile == 0) {
        // 语法模式：必须带函数体（rejected/12）
        return parse_block();
    }
    // 编译模式
    if (c_pass == 1) {
        // 登记函数符号与签名
        if (sym_lookup(start, n) >= 0) {
            return sem_err("顶层符号重定义");
        }
        let first int = t_sigparam_n;
        let i int = 0;
        for i < np {
            ty_sig_param(ptypes[i]);
            i += 1;
        }
        let sig_np int = np;
        let sig_va int = vararg;
        if (is_variadic_seen != 0) {
            sig_np = np - 1;
            sig_va = 2;
        }
        let ftid int = ty_fn(ret, first, sig_np, sig_va);
        let fl int = F_GLOBAL;
        if (c_decl_pub != 0) {
            fl |= F_PUB;
        }
        let idx int = sym_push(start, n, SYM_FN, ftid, fl);
        if (idx < 0) {
            return -1;
        }
        // main 的 ELF 符号保持 GLOBAL（crt1 引用），无论是否书写 pub
        if (n == 4 && c_src[start] == 'm' && c_src[start + 1] == 'a'
            && c_src[start + 2] == 'i' && c_src[start + 3] == 'n') {
            c_syms[idx].flags |= F_PUB;
        }
        // 跳过函数体
        if (p_cur() != TK_LBRACE) {
            return err_tok("fn 必须带函数体");
        }
        return skip_to_decl_end();
    }
    // pass 2：编译函数体
    let fidx int = sym_lookup(start, n);
    if (fidx < 0) {
        return sem_err("内部错误：函数符号丢失");
    }
    if (sem_fn_begin(fidx) != 0) {
        return -1;
    }
    let fi int = 0;
    for fi < np {
        if (sem_check_duplicate(pnames[fi], pname_lens[fi]) != 0) {
            return -1;
        }
        if (sem_declare_param(pnames[fi], pname_lens[fi], ptypes[fi], fi) != 0) {
            return -1;
        }
        fi += 1;
    }
    if (parse_block() != 0) {
        return -1;
    }
    if (sem_fn_end() != 0) {
        return -1;
    }
    return 0;
}

// parse_type_decl：'type' IDENT '=' typeRef ';'（pass1 登记 / pass2 跳过）。
fn parse_type_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (p_expect(TK_ASSIGN, "期望 '='") != 0) {
        return -1;
    }
    let tid int = parse_type_ref();
    if (tid < 0) {
        return -1;
    }
    if (p_expect(TK_SEMI, "期望 ';'") != 0) {
        return -1;
    }
    if (c_compile != 0 && c_pass == 1) {
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        return ty_declare_name(off, n, tid);
    }
    return 0;
}

// parse_struct_decl：'struct'/'union' IDENT '{' field* '}'。
fn parse_struct_decl() int {
    let is_union int = (p_cur() == TK_UNION).to_type(int);
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (c_compile != 0 && c_pass == 1) {
        // 预登记名字（自引用指针字段需要）
        let stid int = ty_push(TY_STRUCT, 0, 0, -1, 0, t_field_n);
        if (stid < 0) {
            return -1;
        }
        if (is_union != 0) {
            t_types[stid].kind = TY_UNION;
        }
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        if (ty_declare_name(off, n, stid) != 0) {
            return -1;
        }
        c_cur_struct = stid;
    }
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    for p_cur() != TK_RBRACE && p_cur() != TOK_EOF {
        if (is_member_name(p_cur()) == 0) {
            return err_tok("此处需要一个字段名");
        }
        let fstart int = c_toks[c_pos].start;
        let fn2 int = c_toks[c_pos].len;
        p_adv();
        let ftid int = parse_type_ref();
        if (ftid < 0) {
            return -1;
        }
        if (p_expect(TK_SEMI, "期望 ';'") != 0) {
            return -1;
        }
        if (c_compile != 0 && c_pass == 1) {
            if (sem_add_field(c_cur_struct, fstart, fn2, ftid) != 0) {
                return -1;
            }
        }
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (c_compile != 0 && c_pass == 1) {
        return sem_struct_finish(c_cur_struct, is_union);
    }
    return 0;
}

// parse_enum_decl：'enum' IDENT '{' item* '}'。
fn parse_enum_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个枚举类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (c_compile != 0 && c_pass == 1) {
        let etid int = ty_push(TY_ENUM, TG_ENUM_SIZE, 4, -1, -1, -1);
        if (etid < 0) {
            return -1;
        }
        t_cur_enum = etid;
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        if (ty_declare_name(off, n, etid) != 0) {
            return -1;
        }
        c_enum_next = 0;
    }
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    for p_cur() != TK_RBRACE && p_cur() != TOK_EOF {
        if (p_cur() != TOK_IDENT) {
            return err_tok("此处需要一个枚举成员名");
        }
        let istart int = c_toks[c_pos].start;
        let in2 int = c_toks[c_pos].len;
        p_adv();
        let has_val int = 0;
        let v Res;
        if (p_cur() == TK_ASSIGN) {
            p_adv();
            has_val = 1;
            if (c_compile != 0) {
                c_fold += 1;
            }
            let r int = parse_expr_iso(&v);
            if (c_compile != 0) {
                c_fold -= 1;
            }
            if (r != 0) {
                return -1;
            }
        }
        if (p_expect(TK_SEMI, "期望 ';'") != 0) {
            return -1;
        }
        if (c_compile != 0 && c_pass == 1) {
            let val i64 = c_enum_next.to_type(i64);
            if (has_val != 0) {
                if (v.is_const == 0) {
                    return sem_err("枚举判别值必须是编译期常量");
                }
                val = v.ival;
            }
            let idx int = sym_push(istart, in2, SYM_CONST, t_cur_enum, F_GLOBAL);
            if (idx < 0) {
                return -1;
            }
            c_syms[idx].cval = val;
            c_enum_next = val.to_type(int) + 1;
        }
    }
    return p_expect(TK_RBRACE, "期望 '}'");
}
