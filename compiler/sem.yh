// ============================================================================
// sem.yh —— 前端语义（二）：表达式/语句/声明语义钩子与两遍编译驱动
//
// 解析器（parse_*.yh）在消费 token 的同时调用本文件的 sem_* 钩子：
//   * c_compile == 0（--syntax-check）→ 钩子全部短路，行为与 G1 纯语法
//     模式完全一致；
//   * c_fold > 0 → 表达式只做常量折叠（全局初始化/const/数组长度/case 值）；
//   * 否则 → 类型检查 + 调用 emit_arm64 的 em_* 原语发码（结果留 x0）。
//
// 赋值目标协议：c_lvalue 置位后解析 LHS，地址型钩子把地址留在 x0 并
// 置 c_res_is_addr；随后 sem_stash_lvalue 把地址存入函数级临时槽，
// RHS 求值后由 sem_assign 经临时槽完成取改存（地址只计算一次）。
// ============================================================================

// sem_res_reset：把结果描述符置为「非 const 普通值」。
fn sem_res_reset(r *Res, tid int) int {
    r.type_id = tid;
    r.is_const = 0;
    r.ival = 0;
    r.sym = -1;
    r.is_lit = 0;
    r.lit_big = 0;
    r.fval_bits = 0;
    return 0;
}

// sem_res_const：常量结果。
fn sem_res_const(r *Res, tid int, v i64) int {
    r.type_id = tid;
    r.is_const = 1;
    r.ival = v;
    r.sym = -1;
    r.is_lit = 0;
    r.lit_big = 0;
    return 0;
}

// sem_res_copy：逐字段复制结果描述符（编译器源码避免结构体按值拷贝）。
fn sem_res_copy(dst *Res, src *Res) int {
    dst.type_id = src.type_id;
    dst.is_const = src.is_const;
    dst.ival = src.ival;
    dst.sym = src.sym;
    dst.is_lit = src.is_lit;
    dst.lit_big = src.lit_big;
    dst.fval_bits = src.fval_bits;
    return 0;
}

// ============================================================================
// 表达式钩子
// ============================================================================

// sem_number：数字字面量（类型 int，参与字面量窄化检查）。
fn sem_number(start int, n int, r *Res) int {
    sem_res_reset(r, TY_I32);
    if (c_compile == 0) {
        return 0;
    }
    r.is_lit = 1;
    r.is_const = 1;
    // 浮点字面量（含 '.' 或指数）按 f64 处理
    if (sem_num_is_float(start, n) != 0) {
        r.type_id = TY_F64;
        let bits i64 = sem_parse_float_bits(start, n);
        r.fval_bits = bits;
        if (c_fold == 0) {
            if (em_mov_imm("x0", bits) != 0) { return -1; }
            if (em_ins("fmov\td0, x0") != 0) { return -1; }
        }
        return 0;
    }
    if (sem_parse_number(start, n) != 0) {
        return -1;
    }
    r.ival = c_fold_ival;
    r.lit_big = c_fold_big;
    if (c_fold == 0) {
        // 作为运行时值使用：装入 x0（常量传播留给后续优化）
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

// fp64_bits：把 f64 的位型读成 i64（借内存别名，避免引入联合体）。
fn fp64_bits(v f64) i64 {
    let holder *f64 = malloc(8).to_type(*f64);
    holder[0] = v;
    let pb *i64 = holder.to_type(*i64);
    let r i64 = pb[0];
    free(holder.to_type(*void));
    return r;
}

// sem_num_is_float：// sem_num_is_float：数字文本是否含 '.' 或 'e'/'E'（浮点字面量）。
fn sem_num_is_float(start int, n int) int {
    let i int = 0;
    for i < n {
        let b u8 = c_src[start + i];
        if (b == '.' || b == 'e' || b == 'E') {
            // 前缀 0x/0o/0b 中的 x/o/b 不算
            return 1;
        }
        i += 1;
    }
    return 0;
}

// sem_parse_float_bits：把十进制浮点字面量解析为 IEEE754 f64 位型。
// 仅做整数与小数部分（不使用 libc 的 strtod）：value = intpart + frac/10^k，
// 再乘 10^exp。精度足以支撑测试与常见常量。
fn sem_parse_float_bits(start int, n int) i64 {
    let i int = start;
    let end int = start + n;
    let mant f64 = 0.0;
    let frac_scale f64 = 1.0;
    let in_frac int = 0;
    let exp int = 0;
    let exp_neg int = 0;
    for i < end {
        let b u8 = c_src[i];
        if (b == '_') {
            i += 1;
            continue;
        }
        if (b >= '0' && b <= '9') {
            if (in_frac == 0) {
                mant = mant * 10.0 + (b - '0').to_type(f64);
            } else {
                frac_scale = frac_scale * 10.0;
                mant = mant + (b - '0').to_type(f64) / frac_scale;
            }
            i += 1;
            continue;
        }
        if (b == '.') {
            in_frac = 1;
            i += 1;
            continue;
        }
        if (b == 'e' || b == 'E') {
            i += 1;
            if (i < end && c_src[i] == '-') {
                exp_neg = 1;
                i += 1;
            } else if (i < end && c_src[i] == '+') {
                i += 1;
            }
            for i < end && c_src[i] >= '0' && c_src[i] <= '9' {
                exp = exp * 10 + (c_src[i] - '0').to_type(int);
                i += 1;
            }
            break;
        }
        i += 1;
    }
    let k int = 0;
    let factor f64 = 1.0;
    for k < exp {
        factor = factor * 10.0;
        k += 1;
    }
    if (exp_neg != 0) {
        mant = mant / factor;
    } else {
        mant = mant * factor;
    }
    return fp64_bits(mant);
}

// sem_string：字符串字面量 → *char（.data 匿名 NUL 结尾数组）。
fn sem_string(start int, slen int, r *Res) int {
    sem_res_reset(r, ty_ptr(TY_CHAR));
    if (c_compile == 0) {
        return 0;
    }
    let lbl int = em_data_string(start, slen);
    if (lbl < 0) {
        return -1;
    }
    r.is_const = 1;
    r.ival = lbl.to_type(i64);
    if (c_fold == 0) {
        // 作为值使用：装入字符串地址
        if (em_load_data_label(lbl) != 0) {
            return -1;
        }
    }
    return 0;
}

// sem_char：字符字面量 → char 常量。
fn sem_char(start int, clen int, r *Res) int {
    sem_res_reset(r, TY_CHAR);
    if (c_compile == 0) {
        return 0;
    }
    // 解码单一字符/转义单元（start+1 起）
    let b u8 = c_src[start + 1];
    let v int = b.to_type(int);
    if (b == '\\') {
        let e u8 = c_src[start + 2];
        v = 0;
        if (e == 'n') { v = 10; }
        if (e == 'r') { v = 13; }
        if (e == 't') { v = 9; }
        if (e == '0') { v = 0; }
        if (e == 'a') { v = 7; }
        if (e == 'b') { v = 8; }
        if (e == 'f') { v = 12; }
        if (e == 'v') { v = 11; }
        if (e == '\'') { v = 39; }
        if (e == '"') { v = 34; }
        if (e == '\\') { v = 92; }
        if (e == 'x') {
            v = hexval(c_src[start + 3]) * 16 + hexval(c_src[start + 4]);
        }
    }
    r.is_const = 1;
    r.is_lit = 1;
    r.ival = v.to_type(i64);
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

// sem_bool：true/false → bool 常量。
fn sem_bool(v int, r *Res) int {
    sem_res_const(r, TY_BOOL, v.to_type(i64));
    if (c_compile == 0) {
        return 0;
    }
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

// sem_ident：名字引用（变量读 / 常量 / fn 地址 / 数组退化 / 结构体地址）。
fn sem_ident(start int, n int, r *Res) int {
    sem_res_reset(r, 0);
    if (c_compile == 0) {
        return 0;
    }
    let idx int = sym_lookup(start, n);
    if (idx < 0) {
        return sem_err("引用了未声明的名字");
    }
    r.sym = idx;
    r.type_id = c_syms[idx].type_id;
    let kind int = c_syms[idx].kind;
    if (kind == SYM_CONST) {
        r.is_const = 1;
        r.ival = c_syms[idx].cval;
        if ((c_syms[idx].flags & F_ADDR) != 0) {
            // 指针常量：值是数据标签
            if (c_fold == 0) {
                if (em_load_data_label(c_syms[idx].cval.to_type(int)) != 0) {
                    return -1;
                }
            }
            return 0;
        }
        if (c_fold == 0) {
            if (em_mov_imm("x0", c_syms[idx].cval) != 0) {
                return -1;
            }
        }
        return 0;
    }
    if (kind == SYM_FN) {
        if (c_fold != 0) {
            return sem_err("函数引用不是编译期常量");
        }
        if (c_lvalue == 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    // 变量
    if (c_fold != 0) {
        return sem_err("变量不是编译期常量");
    }
    let tid int = c_syms[idx].type_id;
    let k int = t_types[tid].kind;
    let global int = ((c_syms[idx].flags & F_GLOBAL) != 0).to_type(int);
    if (k == TY_ARRAY || k == TY_STRUCT || k == TY_UNION || k == TY_SLICE) {
        // 聚合：值语义即地址（数组退化 / 结构体以地址使用）
        if (global != 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        } else {
            if (em_lea_local(c_syms[idx].offset) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    if (c_lvalue != 0) {
        if (global != 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        } else {
            if (em_lea_local(c_syms[idx].offset) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    if (ty_is_float(tid) != 0) {
        if (global != 0) {
            if (em_lea_global(idx) != 0) { return -1; }
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (t_types[tid].size == 4) {
                if (em_ins("ldr\ts0, [x10]") != 0) { return -1; }
            } else {
                if (em_ins("ldr\td0, [x10]") != 0) { return -1; }
            }
        } else {
            if (em_fp_load_local(c_syms[idx].offset, tid) != 0) { return -1; }
        }
        c_res_is_addr = 0;
        return 0;
    }
    if (global != 0) {
        if (em_load_global(idx, tid) != 0) {
            return -1;
        }
    } else {
        if (em_load_local(c_syms[idx].offset, tid) != 0) {
            return -1;
        }
    }
    c_res_is_addr = 0;
    return 0;
}

// sem_push_value：二元运算/调用的左操作数压栈（fold 模式空操作）。
fn sem_push_value(r *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (ty_is_float(r.type_id) != 0) {
        return em_push_fp(r.type_id);
    }
    return em_push();
}

// sem_binop：二元运算（除 &&/||/三元，那些由解析器经标签短路实现）。
fn sem_binop(op int, lhs *Res, rhs *Res) int {
    let tid int = 0;
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    // 运算数检查
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        // 指针只参与 ==/!=（与 0 或同型）
        if (t_types[lhs.type_id].kind == TY_PTR || t_types[rhs.type_id].kind == TY_PTR) {
            if (op != TK_EQEQ && op != TK_NEQ) {
                return sem_err("指针只支持 == / != 比较");
            }
            let ok int = 0;
            if (lhs.type_id == rhs.type_id) { ok = 1; }
            if (t_types[lhs.type_id].elem == TY_VOID) { ok = 1; }
            if (t_types[rhs.type_id].elem == TY_VOID) { ok = 1; }
            if (rhs.is_lit != 0 && rhs.is_const != 0 && rhs.ival == 0) { ok = 1; }
            if (lhs.is_lit != 0 && lhs.is_const != 0 && lhs.ival == 0) { ok = 1; }
            if (ok == 0) {
                return sem_err("指针比较类型不匹配");
            }
            sem_res_const(lhs, TY_BOOL, 0);
            if (c_fold == 0) {
                if (em_pop("x9") != 0) { return -1; }
                if (em_compare(op, TY_I64) != 0) { return -1; }
            }
            c_res_is_addr = 0;
            return 0;
        }
    }
    // 字面量适配：一侧是字面量时借用另一侧类型
    if (rhs.is_lit != 0 && ty_is_scalar(lhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(lhs.type_id, rhs.ival) != 0) {
            rhs.type_id = lhs.type_id;
        }
    }
    if (lhs.is_lit != 0 && ty_is_scalar(rhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(rhs.type_id, lhs.ival) != 0) {
            lhs.type_id = rhs.type_id;
        }
    }
    // 指针算术：p + i / p - i（按元素大小缩放下标）；指针比较另走分支
    let lk int = t_types[lhs.type_id].kind;
    let rk int = t_types[rhs.type_id].kind;
    if ((lk == TY_PTR && rk == TY_PTR) || lk == TY_ARRAY || rk == TY_ARRAY) {
        return sem_err("指针/数组不参与该运算");
    }
    if (lk == TY_PTR && ty_is_integer(rhs.type_id) != 0) {
        if (op == TK_PLUS || op == TK_MINUS) {
            if (c_fold != 0) {
                return sem_err("指针运算不是编译期常量");
            }
            if (em_pop("x9") != 0) { return -1; }
            if (em_scale_index(t_types[lhs.type_id].elem) != 0) { return -1; }
            if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
            c_res_is_addr = 1;   // 结果是地址（可再解引用/下标）
            return 0;
        }
        return sem_err("指针只支持 + / - 整数");
    }
    if (rk == TY_PTR && ty_is_integer(lhs.type_id) != 0 && op == TK_PLUS) {
        if (c_fold != 0) {
            return sem_err("指针运算不是编译期常量");
        }
        if (em_pop("x9") != 0) { return -1; }
        // x9 = 整数，x0 = 指针：交换后缩放
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (em_ins("mov\tx0, x9") != 0) { return -1; }
        if (em_ins("mov\tx9, x10") != 0) { return -1; }
        if (em_scale_index(t_types[rhs.type_id].elem) != 0) { return -1; }
        if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
        c_res_is_addr = 1;
        return 0;
    }
    tid = sem_promote(lhs.type_id, rhs.type_id);
    if (ty_is_float(tid) != 0) {
        // 浮点二元/比较：左 d1、右 d0（值栈已按序压入）
        if (c_fold != 0) {
            return sem_err("浮点常量折叠暂不支持");
        }
        let iscmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT
                         || op == TK_LEQ || op == TK_GT || op == TK_GEQ).to_type(int);
        if (op != TK_PLUS && op != TK_MINUS && op != TK_STAR && op != TK_SLASH
            && iscmp == 0) {
            return sem_err("浮点不支持该运算");
        }
        if (iscmp != 0) {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_compare(op, tid) != 0) { return -1; }
            sem_res_const(lhs, TY_BOOL, 0);
        } else {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_binop(op, tid) != 0) { return -1; }
            sem_res_reset(lhs, tid);
        }
        lhs.is_const = 0;
        c_res_is_addr = 0;
        return 0;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持算术运算");
    }
    let is_cmp int = 0;
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        is_cmp = 1;
    }
    if (c_fold != 0) {
        if (lhs.is_const == 0 || rhs.is_const == 0) {
            return sem_err("这里需要编译期常量");
        }
        if (is_cmp != 0) {
            let v i64 = fold_binop(op, lhs.ival, rhs.ival);
            sem_res_const(lhs, TY_BOOL, v);
        } else {
            let v2 i64 = fold_binop(op, lhs.ival, rhs.ival);
            sem_res_const(lhs, tid, v2);
        }
        return 0;
    }
    if (is_cmp != 0) {
        if (em_pop("x9") != 0) { return -1; }
        if (em_compare(op, tid) != 0) { return -1; }
        sem_res_const(lhs, TY_BOOL, 0);
    } else {
        if (em_pop("x9") != 0) { return -1; }
        if (em_binop(op, tid) != 0) { return -1; }
        sem_res_reset(lhs, tid);
    }
    lhs.is_const = 0;
    c_res_is_addr = 0;
    return 0;
}

// sem_shortcircuit：&& / ||（短路标签法；both 非空由解析器保证）。
// 进入时左操作数已求值（x0）且已压栈保护；返回 then-branch 的标签对。
// 解析器随后求值右操作数并调用 sem_shortcircuit_end。
fn sem_shortcircuit(op int, lhs *Res) int {
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("逻辑运算不支持编译期折叠");
    }
    // 保存外层短路标签（嵌套 a&&b||c&&d 时内层不破坏外层）
    sc_sc_false_stk[sc_sc_depth] = sc_lbl_false;
    sc_sc_end_stk[sc_sc_depth] = sc_lbl_end;
    sc_sc_depth += 1;
    sc_lbl_false = em_new_label();
    sc_lbl_end = em_new_label();
    if (op == TK_ANDAND) {
        if (em_jz(sc_lbl_false) != 0) { return -1; }
    } else {
        if (em_jnz(sc_lbl_false) != 0) { return -1; }
    }
    sem_res_reset(lhs, TY_BOOL);
    c_res_is_addr = 0;
    return 0;
}

// sem_shortcircuit_end：右操作数求值完毕（x0 = 右值），发射真/假路径。
fn sem_shortcircuit_end(op int, lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (op == TK_ANDAND) {
        // 左真且右真 → 结果 1
        if (em_jz(sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_jmp(sc_lbl_end) != 0) { return -1; }
        if (em_label(sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_label(sc_lbl_end) != 0) { return -1; }
    } else {
        // || ：左或右为真 → 结果 1
        if (em_jnz(sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_jmp(sc_lbl_end) != 0) { return -1; }
        if (em_label(sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_label(sc_lbl_end) != 0) { return -1; }
    }
    lhs.is_const = 0;
    c_res_is_addr = 0;
    // 恢复外层短路标签（嵌套 a&&b||c&&d：内层用完即还）
    sc_sc_depth -= 1;
    sc_lbl_false = sc_sc_false_stk[sc_sc_depth];
    sc_lbl_end = sc_sc_end_stk[sc_sc_depth];
    return 0;
}

// sem_ternary_a / sem_ternary_b：三元条件两支的汇合（结果在值栈汇合）。
fn sem_ternary_cond(lhs *Res) int {
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("三元不支持编译期折叠");
    }
    tn_lbl_else = em_new_label();
    tn_lbl_end = em_new_label();
    if (em_jz(tn_lbl_else) != 0) { return -1; }
    return 0;
}

fn sem_ternary_mid(lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_jmp(tn_lbl_end) != 0) { return -1; }
    if (em_label(tn_lbl_else) != 0) { return -1; }
    return 0;
}

fn sem_ternary_end(lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_label(tn_lbl_end) != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    c_res_is_addr = 0;
    return 0;
}

// sem_unary：一元运算（BANG/MINUS/PLUS/TILDE 值域；STAR 解引用；
// AMP 取地址——操作数已按 c_lvalue 解析出地址）。
fn sem_unary(op int, operand *Res) int {
    if (c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    if (op == TK_STAR) {
        if (t_types[operand.type_id].kind != TY_PTR) {
            return sem_err("解引用的操作数必须是指针");
        }
        if (c_lvalue == 0 && c_fold == 0) {
            // x0 = 指针值（地址）→ 装入点值
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(t_types[operand.type_id].elem) != 0) { return -1; }
        }
        c_res_is_addr = 1;
        sem_res_reset(operand, t_types[operand.type_id].elem);
        operand.is_const = 0;
        return 0;
    }
    if (op == TK_AMP) {
        if (c_res_is_addr == 0) {
            return sem_err("取地址的操作数必须是左值");
        }
        let pt int = ty_ptr(operand.type_id);
        sem_res_reset(operand, pt);
        c_res_is_addr = 1;
        return 0;
    }
    if (operand.is_const != 0) {
        // 常量（含字面量）：折叠求值并保留字面量性（如 let n i8 = -100）
        operand.ival = fold_unary(op, operand.ival);
        operand.type_id = TY_I32;
        if (c_fold == 0) {
            if (em_mov_imm("x0", operand.ival) != 0) {
                return -1;
            }
        }
        return 0;
    }
    let tid int = operand.type_id;
    if (ty_is_float(tid) != 0) {
        if (op == TK_MINUS) {
            if (em_fp_neg(tid) != 0) { return -1; }
            sem_res_reset(operand, tid);
            c_res_is_addr = 0;
            return 0;
        }
        if (op == TK_PLUS) {
            return 0;
        }
        return sem_err("浮点只支持一元 +/-");
    }
    if (t_types[tid].kind == TY_BOOL) {
        tid = TY_I32;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持一元运算");
    }
    if (em_unary(op, tid) != 0) { return -1; }
    sem_res_reset(operand, tid);
    c_res_is_addr = 0;
    return 0;
}

// sem_index：下标 p[i] / arr[i]（进入前：基址在栈顶，x0 = 下标）。
fn sem_index(base *Res, idx *Res) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (ty_is_integer(idx.type_id) == 0) {
        return sem_err("下标必须是整数");
    }
    let bk int = t_types[base.type_id].kind;
    let elem int = 0;
    if (bk == TY_PTR) {
        elem = t_types[base.type_id].elem;
    } else if (bk == TY_ARRAY) {
        elem = t_types[base.type_id].elem;
    } else if (bk == TY_SLICE) {
        elem = t_types[base.type_id].elem;
    } else {
        return sem_err("该类型不支持下标访问");
    }
    if (c_fold != 0) {
        return sem_err("下标访问不是编译期常量");
    }
    if (em_pop("x9") != 0) { return -1; }
    // lvalue 模式下指针变量的基址是「变量的地址」——先装入指针值
    if (bk == TY_PTR && c_lvalue != 0) {
        if (em_ins("mov\tx10, x9") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
    }
    // 切片：基址是切片数据指针（槽内偏移 8），需先取 data 字段
    if (bk == TY_SLICE) {
        if (em_ins("add\tx9, x9, #8") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x9]") != 0) { return -1; }
    }
    // 地址 = 基址(x9) + 下标(x0) * 元素大小
    let esz int = t_types[elem].size;
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        // 任意大小的聚合元素（如 20 字节的 Tok）：乘法缩放
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
    let ek int = t_types[elem].kind;
    if (ek == TY_STRUCT || ek == TY_UNION || ek == TY_ARRAY || ek == TY_SLICE) {
        // 聚合元素：保留地址语义（成员/下标链后续再加偏移）
        c_res_is_addr = 1;
    } else if (c_lvalue == 0) {
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (ty_is_float(elem) != 0) {
            // 浮点元素：装入浮点寄存器
            let fsfx *char = "d";
            if (t_types[elem].size == 4) { fsfx = "s"; }
            if (em_frag("\tldr\t") != 0) { return -1; }
            if (em_frag(fsfx) != 0) { return -1; }
            if (em_frag("0, [x10]\n") != 0) { return -1; }
        } else {
            if (em_load_sized(elem) != 0) { return -1; }
        }
        c_res_is_addr = 0;
    } else {
        c_res_is_addr = 1;
    }
    sem_res_reset(base, elem);
    return 0;
}

// sem_slice：切片表达式 base[start..end]（左闭右开）→ []T 视图。
// 值栈：base（先压）、start（后压）；x0 = end。无边界检查（ADR-0001）：
// 长度 = max(0, end - start)，数据 = 基址 + start*元素大小，不拷贝元素。
// 结果为 {len, data} 16 字节临时切片（值语义即地址，与 to_type([]T) 一致）。
fn sem_slice(base *Res, sres *Res, eres *Res) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("切片表达式不是编译期常量");
    }
    let bk int = t_types[base.type_id].kind;
    if (bk != TY_ARRAY && bk != TY_SLICE) {
        return sem_err("切片表达式需要数组或切片");
    }
    if (ty_is_integer(sres.type_id) == 0 || ty_is_integer(eres.type_id) == 0) {
        return sem_err("切片下标必须是整数");
    }
    let elem int = t_types[base.type_id].elem;
    let esz int = t_types[elem].size;
    // x0 = end → x11 暂存；弹 start → x0；弹 base → x10
    if (em_ins("mov\tx11, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_pop("x10") != 0) { return -1; }
    // 切片基址取 data 字段（{len, data} 的偏移 8）
    if (bk == TY_SLICE) {
        if (em_ins("add\tx10, x10, #8") != 0) { return -1; }
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
    }
    // x9 = max(0, end - start)
    if (em_ins("sub\tx9, x11, x0") != 0) { return -1; }
    let l_pos int = em_new_label();
    if (em_frag("\tcmp\tx9, xzr\n\tb.gt\t") != 0) { return -1; }
    if (em_put_lbl(l_pos) != 0) { return -1; }
    if (em_frag("\n\tmov\tx9, xzr\n") != 0) { return -1; }
    if (em_label(l_pos) != 0) { return -1; }
    // x0 = start * 元素大小
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    // x0 = 数据指针 = 基址 + start*esz
    if (em_ins("add\tx0, x10, x0") != 0) { return -1; }
    // 构造 {len, data} 临时切片
    let soff int = em_alloc_local(TG_LONG_SIZE * 2);
    if (em_lea_local_to(soff) != 0) { return -1; }
    if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
    if (em_lea_local_down(soff) != 0) { return -1; }
    base.type_id = ty_slice(elem);
    base.is_lit = 0;
    base.is_const = 0;
    c_res_is_addr = 1;
    return 0;
}

// sem_member：成员访问 base.name（指针自动解引用）。
fn sem_member(base *Res, name_start int, name_len int) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    let bk int = t_types[base.type_id].kind;
    let stid int = 0;
    if (bk == TY_PTR) {
        stid = t_types[base.type_id].elem;
        if (t_types[stid].kind != TY_STRUCT && t_types[stid].kind != TY_UNION) {
            return sem_err("『.』的左侧不是结构体或结构体指针");
        }
    } else if (bk == TY_STRUCT || bk == TY_UNION) {
        stid = base.type_id;
    } else {
        return sem_err("『.』的左侧不是结构体或结构体指针");
    }
    // 字段查找
    let st int = t_types[stid].sub;
    let nf int = t_types[stid].len;
    let found int = -1;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (t_fields[f].name_len == name_len) {
            let match int = 1;
            let j int = 0;
            for j < name_len {
                if (np_data[t_fields[f].name_off + j] != c_src[name_start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = f;
                break;
            }
        }
        i += 1;
    }
    if (found < 0) {
        return sem_err("结构体没有该字段");
    }
    if (c_fold != 0) {
        return sem_err("字段访问不是编译期常量");
    }
    let off int = t_fields[found].offset;
    if (bk == TY_PTR) {
        if (c_lvalue != 0) {
            // x0 = 指针变量的地址 → 装入指针值
            if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        }
        // x0 = 结构体地址；加字段偏移
    }
    if (off > 0) {
        if (em_frag("\tadd\tx0, x0, #") != 0) { return -1; }
        if (em_puti(off) != 0) { return -1; }
        if (em_frag("\n") != 0) { return -1; }
    }
    let ftid int = t_fields[found].type_id;
    if (c_lvalue == 0) {
        let fk int = t_types[ftid].kind;
        if (fk != TY_STRUCT && fk != TY_UNION && fk != TY_ARRAY && fk != TY_SLICE) {
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(ftid) != 0) { return -1; }
            c_res_is_addr = 0;
        } else {
            // 聚合字段：保持地址语义
            c_res_is_addr = 1;
        }
    } else {
        c_res_is_addr = 1;
    }
    sem_res_reset(base, ftid);
    return 0;
}

// sem_sizeof：sizeof(T) → int 常量。
fn sem_sizeof(tid int, r *Res) int {
    sem_res_reset(r, TY_I32);
    if (c_compile == 0) {
        return 0;
    }
    r.is_const = 1;
    r.is_lit = 0;
    r.ival = t_types[tid].size.to_type(i64);
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

// sem_len：len(e) —— 数组返回编译期长度；切片读 len 字段（偏移 0）。
fn sem_len(r *Res) int {
    if (c_compile == 0) {
        r.type_id = 0;
        return 0;
    }
    let k int = t_types[r.type_id].kind;
    if (k == TY_ARRAY) {
        // 编译期折叠为常量并直接装 x0（同 sem_sizeof：折叠出的常量由
        // 这里物化，消费端不负责）。必须清 c_res_is_addr——实参（数组
        // 标识符）的聚合地址语义会残留，否则 x0 里的数组地址被当成
        // 结果（曾致 return len(arr) 返回地址而非长度）。
        c_res_is_addr = 0;
        sem_res_const(r, TY_I32, t_types[r.type_id].len.to_type(i64));
        if (c_fold == 0) {
            return em_mov_imm("x0", r.ival);
        }
        return 0;
    }
    if (k == TY_SLICE) {
        if (c_fold != 0) {
            return sem_err("切片长度不是编译期常量");
        }
        // 切片值在 x0（地址）；读 [x0] 的长度
        if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        sem_res_reset(r, TY_I32);
        c_res_is_addr = 0;
        return 0;
    }
    return sem_err("len 需要一个数组或切片");
}

// sem_cast：.to_type(T) —— 标量间位型重解释；寄存器值无需变换。
fn sem_cast(operand *Res, tid int) int {
    if (c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    let ok int = t_types[tid].kind;
    if (ok == TY_VOID) {
        return sem_err("不能转换为 void");
    }
    let sk int = t_types[operand.type_id].kind;
    let scalar_to_scalar int = 0;
    if (ty_is_scalar(tid) != 0 && ty_is_scalar(operand.type_id) != 0) {
        scalar_to_scalar = 1;
    }
    // 数组 → 切片视图：构造 {len, data} 临时聚合（ADR-0002 的规范化视图）
    if (sk == TY_ARRAY && ok == TY_SLICE) {
        if (t_types[operand.type_id].elem != t_types[tid].elem) {
            return sem_err("数组元素类型与目标切片不一致");
        }
        if (c_fold != 0) {
            return sem_err("数组转切片不是编译期常量");
        }
        let arrlen int = t_types[operand.type_id].len;
        // x0 = 数组地址（数组值即地址）
        let soff int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(soff) != 0) { return -1; }
        if (em_mov_imm("x9", arrlen.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(soff) != 0) { return -1; }
        operand.type_id = tid;
        operand.is_lit = 0;
        operand.is_const = 0;
        c_res_is_addr = 1;
        return 0;
    }
    if (scalar_to_scalar == 0) {
        return sem_err("该转换不支持（标量之间或指针/整数）");
    }
    if (c_fold == 0 && c_res_is_addr == 0) {
        // 运行时转换
        let from_fp int = ty_is_float(operand.type_id);
        let to_fp int = ty_is_float(tid);
        if (to_fp != 0 && from_fp == 0) {
            let src_signed int = ty_is_signed(operand.type_id);
            if (em_int_to_fp(tid, src_signed) != 0) { return -1; }
        } else if (to_fp != 0 && from_fp != 0) {
            // 浮点宽度转换：f32<->f64（d0/s0 互转）
            if (t_types[operand.type_id].size != t_types[tid].size) {
                if (t_types[tid].size == 4) {
                    if (em_ins("fcvt\ts0, d0") != 0) { return -1; }
                } else {
                    if (em_ins("fcvt\td0, s0") != 0) { return -1; }
                }
            }
        } else if (to_fp == 0 && from_fp != 0) {
            let dst_signed int = ty_is_signed(tid);
            if (em_fp_to_int(operand.type_id, dst_signed) != 0) { return -1; }
        } else if (t_types[operand.type_id].size != t_types[tid].size
                   || ty_is_signed(operand.type_id) != ty_is_signed(tid)) {
            // 整数 → 整数：x0 中按源类型已扩展，需按目标宽度/符号性重新扩展。
            // 例如 i64 → int 必须截断到低 32 位并符号扩展，否则比较/运算会用
            // 到高位的残留值（曾导致 i64 的 int 视图比较结果错误）。
            let tsz int = t_types[tid].size;
            if (ty_is_signed(tid) != 0) {
                if (tsz == 4) {
                    if (em_ins("sxtw\tx0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("sxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("sxtb\tx0, w0") != 0) { return -1; }
                }
            } else {
                if (tsz == 4) {
                    // 零扩展：写 w0 即清零高 32 位
                    if (em_ins("mov\tw0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("uxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("uxtb\tx0, w0") != 0) { return -1; }
                }
            }
        }
        // 其余整数→整数（更宽或同宽同符号）已在 x0 中正确扩展，无需发码。
    }
    operand.type_id = tid;
    operand.is_lit = 0;
    c_res_is_addr = 0;
    return 0;
}

// ---- 调用 ----

// sem_call_begin：进入实参表前调用。直接调用（裸函数名）返回 1 且不发码；
// 间接调用把 callee 值压栈并返回 0。
fn sem_call_begin(callee *Res) int {
    if (c_compile == 0) {
        return 1;
    }
    // 嵌套调用：记录本层实参基线与直接调用标志（内层不污染外层）
    if (c_call_depth >= 64) {
        return sem_err("调用嵌套过深");
    }
    c_call_base[c_call_depth] = c_arg_n;
    c_call_direct[c_call_depth] = 0;
    c_call_depth += 1;
    if (callee.sym >= 0) {
        if (c_syms[callee.sym].kind == SYM_FN) {
            c_call_direct[c_call_depth - 1] = 1;
            return 1;
        }
    }
    if (c_fold != 0) {
        return sem_err("函数调用不是编译期常量");
    }
    if (em_push() != 0) { return -1; }
    return 0;
}

// sem_push_arg：一个实参求值完毕（结果在 x0，浮点在 d0），压栈并记录类型。
// 浮点实参的值在 d0，必须走浮点压栈；否则会把 x0 里的无关值（例如刚装入
// 的 callee 地址）当成实参压栈。
fn sem_push_arg(r *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_arg_n >= 256) {
        return sem_err("实参过多");
    }
    sem_res_copy(&c_args[c_arg_n], r);
    c_argtys[c_arg_n] = r.type_id;
    c_arg_n += 1;
    if (c_fold != 0) {
        return 0;
    }
    return sem_push_value(r);
}

// sem_call：实参表结束，完成类型检查与调用发射。
fn sem_call(callee *Res, r *Res) int {
    if (c_compile == 0) {
        sem_res_reset(r, 0);
        return 0;
    }
    if (t_types[callee.type_id].kind != TY_FN) {
        return sem_err("被调用的表达式不是函数");
    }
    c_call_depth -= 1;
    let base int = c_call_base[c_call_depth];
    let direct int = c_call_direct[c_call_depth];
    let sig int = t_types[callee.type_id].sub;
    let np int = t_sig_np[sig];
    let vararg int = t_sig_vararg[sig];
    let ret int = t_sig_ret[sig];
    let na int = c_arg_n - base;
    // vararg==2：类型化变参（末尾打包为切片）；==1：裸 C 变参（仅 prelude）
    if (vararg == 2) {
        if (na < np) {
            return sem_err("实参个数少于固定参数");
        }
    } else if (na < np || (na > np && vararg == 0)) {
        return sem_err("实参个数与函数签名不符");
    }
    // 实参类型检查
    let first int = t_sig_first[sig];
    let i int = 0;
    for i < na {
        let want int = 0;
        if (i < np) {
            want = t_sig_params[first + i];
        } else {
            want = -1;
        }
        if (want >= 0) {
            // 数组实参按指针形参退化
            let wat int = c_args[base + i].type_id;
            if (t_types[wat].kind == TY_ARRAY && t_types[want].kind == TY_PTR) {
                if (t_types[wat].elem != t_types[want].elem && t_types[want].elem != TY_VOID) {
                    return sem_err("数组元素类型与指针形参不匹配");
                }
                i += 1;
                continue;
            }
            // 切片实参按切片形参（同元素类型；长度不参与相容判断）
            if (t_types[wat].kind == TY_SLICE && t_types[want].kind == TY_SLICE) {
                if (t_types[wat].elem != t_types[want].elem && t_types[want].elem != TY_VOID) {
                    return sem_err("切片元素类型不匹配");
                }
                i += 1;
                continue;
            }
            if (sem_can_assign(want, wat, c_args[base + i].is_lit, c_args[base + i].ival, c_args[base + i].lit_big) != 0) {
                return -1;
            }
        } else if (vararg == 2) {
            // 类型化变参：尾部实参类型须与元素类型相容
            let velem_t int = t_types[t_sig_params[first + np]].elem;
            if (sem_can_assign(velem_t, c_args[base + i].type_id, c_args[base + i].is_lit, c_args[base + i].ival, c_args[base + i].lit_big) != 0) {
                return -1;
            }
        } else {
            // 裸变参位置：整数/指针按 C 提升进寄存器
            let at2 int = c_args[base + i].type_id;
            let k2 int = t_types[at2].kind;
            if (ty_is_float(at2) != 0) {
                return sem_err("裸变参的浮点实参将在 B7 支持");
            }
            if (k2 == TY_STRUCT || k2 == TY_UNION || k2 == TY_ARRAY || k2 == TY_SLICE) {
                return sem_err("聚合类型不能传给裸变参");
            }
        }
        i += 1;
    }
    if (c_fold != 0) {
        return sem_err("函数调用不是编译期常量");
    }
    // 类型化变参：把尾部实参（已逐个压栈）打包为一个切片参数
    let na2 int = na;
    if (vararg == 2) {
        let velem int = t_types[t_sig_params[first + np]].elem;
        let vslice int = t_sig_params[first + np];
        let vcount int = na - np;
        // 值栈上从底到顶依次是 a0..a_{na-1}；尾部 vcount 个是变参。
        // 先把尾部逐个弹出写入临时数组（逆序弹出，正序写入）。
        let esz int = t_types[velem].size;
        let arr_off int = em_alloc_local(esz * vcount);
        // 值栈顶是最后一个实参：逐个弹出并按倒序写入数组（元素 0 在最低地址）
        let vi int = vcount - 1;
        for vi >= 0 {
            if (em_pop("x0") != 0) { return -1; }
            // 元素 vi 的地址：向下偏移 = arr_off - vi*esz
            if (em_lea_local_to(arr_off - vi * esz) != 0) { return -1; }
            if (em_store_sized(velem) != 0) { return -1; }
            vi -= 1;
        }
        // 构造切片 {len, data} 于临时槽
        let sl_off int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(sl_off) != 0) { return -1; }
        if (em_mov_imm("x9", vcount.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_lea_local_down(arr_off) != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(sl_off) != 0) { return -1; }
        if (em_push() != 0) { return -1; }
        na2 = np + 1;
    }
    // 发射：栈实参 → 寄存器实参 → callee → bl/blr → 清理
    // Darwin 变参约定（Mach-O/AAPCS 变体）：裸 C 变参函数（prelude 的
    // printf/open，vararg==1）的**可变部分一律按 8 字节对齐放在栈上**
    // （[sp+0], [sp+8], …），不占用 x1..x7；命名参数照常进寄存器。
    // 与 stage0（src/targets/arm64-gen.c 的 arm64_pcs_aux）保持一致。
    let darwin_var int = 0;
    if (tg_darwin() != 0 && vararg == 1 && na2 > np) {
        darwin_var = 1;
    }
    let nstack int = 0;
    if (darwin_var != 0) {
        // 命名参数之外的实参全部走栈
        nstack = na2 - np;
    } else if (na2 > TG_ARG_REGS) {
        nstack = na2 - TG_ARG_REGS;
    }
    // 栈实参搬运（两段式）：值栈顶是最后一个实参，栈实参恰为顶部
    // nstack 项。第一段：弹入帧内暂存槽（fp 负偏移固定槽，不受值栈
    // 弹压影响）；第二段在寄存器实参装载完成后、bl 之前回压进调用点
    // 栈区（8 字节间距 = AAPCS64 与 stage0，被调方按
    // [fp+16+(k-8)*8] 读取）。不能先 sub sp 开区再弹：弹到的是栈区
    // 槽而非实参；也不能边弹边压：寄存器装载的弹栈会把已压栈区弹穿
    // （2026-09-29 参数错位缺陷，被加法交换律语料掩盖）。
    let area_bytes int = (nstack * 8 + 15) / 16 * 16;
    let stk_off int = 0;
    if (nstack > 0) {
        stk_off = em_alloc_local(8 * nstack);
        let stk_lo int = na2 - nstack;
        let saj int = na2 - 1;
        for saj >= stk_lo {
            let rel int = 8 * (saj - stk_lo);
            if (ty_is_float(c_args[base + saj].type_id) != 0) {
                // 浮点实参值在浮点通路（sem_push_value → em_push_fp），
                // 弹出须走浮点寄存器
                let fsfx *char = "d";
                if (t_types[c_args[base + saj].type_id].size == 4) {
                    fsfx = "s";
                }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_lea_local_to(stk_off - rel) != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
            } else {
                // 弹到 x11：em_lea_local_to 偏移超 255 时用 movz x9 拼址，
                // 会覆盖 x9（2026-09-29 深帧下暂存槽写入立即数的根因）
                if (em_pop("x11") != 0) { return -1; }
                if (em_lea_local_to(stk_off - rel) != 0) { return -1; }
                if (em_ins("str\tx11, [x10]") != 0) { return -1; }
            }
            saj -= 1;
        }
    }
    // 寄存器实参：整型 a8→x7…a1→x0；浮点独立计数进 d0..d7
    // 注意：值栈顶是最后一个实参，浮点与整型需分别按各自序号搬运。
    // 这里按「从后往前」弹出：先整型（逆序到 x7..x0），再浮点。
    // 由于浮点与整型寄存器独立，正确做法是先按顺序取各自第 k 个。
    // 简化且正确的实现：逐个弹出到临时数组，再按类型分配到寄存器。
    // —— 为控制改动面，这里要求「浮点实参全部位于尾部」时用专用路径。
    // 进寄存器的实参个数：Darwin 变参时只有命名参数进寄存器，可变部分已上栈。
    let regn int = na2;
    if (darwin_var != 0) {
        regn = np;
    }
    // 计算寄存器实参中的浮点个数
    let nfp int = 0;
    let k int = base;
    for k < base + regn {
        if (ty_is_float(c_args[k].type_id) != 0) {
            nfp += 1;
        }
        k += 1;
    }
    if (nfp == 0) {
        let j int = TG_ARG_REGS - 1;
        for j >= 0 {
            if (j < regn) {
                if (em_call_arg_to_reg(j) != 0) { return -1; }
            }
            j -= 1;
        }
    } else {
        // 混合：弹出到临时槽（逆序），再按各自序号装寄存器。
        // 浮点实参压栈时值在 d0，弹出必须按元素类型选 x0 或 d0。
        let tmp_off int = em_alloc_local(16 * regn);
        let tb int = regn - 1;
        for tb >= 0 {
            if (em_lea_local_to(tmp_off - 16 * tb) != 0) { return -1; }
            if (ty_is_float(c_args[base + tb].type_id) != 0) {
                let psfx *char = "d";
                if (t_types[c_args[base + tb].type_id].size == 4) { psfx = "s"; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(psfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(psfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
            } else {
                if (em_pop("x0") != 0) { return -1; }
                if (em_ins("str\tx0, [x10]") != 0) { return -1; }
            }
            tb -= 1;
        }
        let xi int = 0;
        let di int = 0;
        let tf int = 0;
        for tf < regn {
            let at int = c_args[base + tf].type_id;
            if (ty_is_float(at) != 0) {
                if (di < TG_ARG_REGS) {
                    let fsuffix *char = "d";
                    if (t_types[at].size == 4) { fsuffix = "s"; }
                    if (em_lea_local_to(tmp_off - 16 * tf) != 0) { return -1; }
                    if (em_frag("\tldr\t") != 0) { return -1; }
                    if (em_frag(fsuffix) != 0) { return -1; }
                    if (em_puti(di) != 0) { return -1; }
                    if (em_frag(", [x10]\n") != 0) { return -1; }
                }
                di += 1;
            } else {
                if (xi < TG_ARG_REGS) {
                    if (em_lea_local_to(tmp_off - 16 * tf) != 0) { return -1; }
                    if (em_frag("\tldr\t") != 0) { return -1; }
                    if (em_frag(em_spill_reg_name(xi)) != 0) { return -1; }
                    if (em_frag(", [x10]\n") != 0) { return -1; }
                }
                xi += 1;
            }
            tf += 1;
        }
    }
    // 间接调用的目标地址在值栈顶：必须在开调用点栈区之前弹出（否则弹到
    // 栈区槽而非实参），暂存帧内槽，bl 前再装回 x10。
    let callee_off int = 0;
    if (direct == 0) {
        callee_off = em_alloc_local(TG_PTR_SIZE);
        if (em_pop("x9") != 0) { return -1; }
        if (em_lea_local_to(callee_off) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    }
    // 栈实参第二段：bl 之前把暂存槽写进调用点栈区。整块开区（area_bytes
    // 为 16 的倍数，sp 全程保持 16 字节对齐）后按 8 字节偏移写入——第 9 参
    // （Darwin 变参为第一个可变实参）在 [sp+0]，其后每参 +8，与 AAPCS64 及
    // stage0（arm64-gen.c 的 C.14：size < 8 补足 8 字节槽）一致。写入用
    // x9/d0 中转，不碰已装载的 x0..x7/d0..d7。
    if (nstack > 0) {
        if (em_call_stack_alloc(area_bytes) != 0) { return -1; }
        let stk_lo2 int = na2 - nstack;
        let pb int = na2 - 1;
        for pb >= stk_lo2 {
            let rel2 int = 8 * (pb - stk_lo2);
            if (ty_is_float(c_args[base + pb].type_id) != 0) {
                let pfsfx *char = "d";
                if (t_types[c_args[base + pb].type_id].size == 4) {
                    pfsfx = "s";
                }
                if (em_lea_local_to(stk_off - rel2) != 0) { return -1; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(pfsfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
                if (em_call_stack_store_fp(pfsfx, rel2) != 0) { return -1; }
            } else {
                if (em_lea_local_to(stk_off - rel2) != 0) { return -1; }
                if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
                if (em_call_stack_store(rel2) != 0) { return -1; }
            }
            pb -= 1;
        }
    }
    // 聚合返回：把调用方缓冲地址放进 x8（隐藏返回指针，AAPCS64）
    let retk int = t_types[ret].kind;
    if (retk == TY_STRUCT || retk == TY_UNION || retk == TY_ARRAY || retk == TY_SLICE) {
        // 经 x10 中转，避免覆盖已搬运到 x0..x7 的实参
        let buf int = em_alloc_local(t_types[ret].size);
        if (em_lea_local_to(buf) != 0) { return -1; }
        if (em_ins("mov\tx8, x10") != 0) { return -1; }
        c_ret_tmp_off = buf;
    }
    if (direct != 0) {
        if (em_call_direct(callee.sym) != 0) { return -1; }
    } else {
        if (em_lea_local_to(callee_off) != 0) { return -1; }
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        if (em_call_indirect() != 0) { return -1; }
    }
    if (em_call_cleanup_bytes(area_bytes) != 0) { return -1; }
    c_arg_n = base;
    sem_res_reset(r, ret);
    if (ty_is_float(ret) != 0) {
        // 浮点返回已在 d0/s0
        c_res_is_addr = 0;
        return 0;
    }
    if (retk == TY_STRUCT || retk == TY_UNION || retk == TY_ARRAY || retk == TY_SLICE) {
        // 聚合返回：结果地址 = 调用方缓冲
        if (em_lea_local_down(c_ret_tmp_off) != 0) { return -1; }
        c_res_is_addr = 1;
        return 0;
    }
    c_res_is_addr = 0;
    return 0;
}

// sem_return_value：return 语句的值已在 x0（或聚合地址在 x0）。
// 聚合返回：把源拷贝进 x8 缓冲，并把缓冲地址留在 x0；标量直接返回。
fn sem_return_value(r *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_ret_agg != 0) {
        // x0 = 聚合源地址；x1 = x8 缓冲；拷贝 size 字节
        if (em_push() != 0) { return -1; }
        if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        if (em_ins("mov\tx1, x0") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        if (em_copy_block(t_types[c_fn_ret].size) != 0) { return -1; }
        if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        c_ret_agg_val = 1;
    }
    if (em_jmp(c_fn_lbl) != 0) {
        return -1;
    }
    return 0;
}

// sem_lit_field_lookup：结构体字面量字段名查找（复用 sem_field_lookup）。
fn sem_lit_field_lookup(tid int, start int, n int) int {
    return sem_field_lookup(tid, start, n);
}

// sem_struct_lit_begin：结构体字面量作值。分配临时槽并把地址压栈
// 供字段写入；返回是否命名式（由调用方解析）。成功返回临时槽的 fp 距离。
fn sem_struct_lit_begin(tid int, named int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_lit_depth >= 32) {
        return sem_err("结构体字面量嵌套过深");
    }
    let off int = em_alloc_local(t_types[tid].size);
    // 保存外层字面量的定位状态，供嵌套字面量结束后恢复
    c_lit_save_off[c_lit_depth] = c_lit_off;
    c_lit_save_tid[c_lit_depth] = c_lit_tid;
    c_lit_depth += 1;
    c_lit_off = off;
    c_lit_tid = tid;
    return off;
}

// sem_struct_lit_field：写入结构体字面量的一个字段（值在 x0）。
fn sem_struct_lit_field(tid int, fidx int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let ftid int = t_fields[fidx].type_id;
    let foff int = t_fields[fidx].offset;
    let fk int = t_types[ftid].kind;
    if (sem_can_assign(ftid, c_lit_last_type, c_lit_last_lit, c_lit_last_ival, 0) != 0) {
        return -1;
    }
    if (fk == TY_STRUCT || fk == TY_UNION || fk == TY_ARRAY || fk == TY_SLICE) {
        // 聚合字段：x0 = 源聚合地址 → 块拷贝进字段位置
        if (em_push() != 0) { return -1; }
        if (em_lea_local_to(c_lit_off - foff) != 0) { return -1; }
        if (em_ins("mov\tx1, x10") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        return em_copy_block(t_types[ftid].size);
    }
    // 槽起点 = fp - c_lit_off；字段地址 = 起点 + foff → 向下偏移 = off - foff
    if (em_lea_local_to(c_lit_off - foff) != 0) { return -1; }
    return em_store_sized(ftid);
}

// sem_struct_lit_end：字面量结束，把聚合地址留在 x0。
fn sem_struct_lit_end(tid int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    // 把本层槽地址留在 x0，并恢复外层字面量的定位状态。
    // begin 时 save[d] 记录的是「进入本层前的值」，end 读 save[d] 恢复。
    let my_off int = c_lit_off;
    c_lit_depth -= 1;
    c_lit_off = c_lit_save_off[c_lit_depth];
    c_lit_tid = c_lit_save_tid[c_lit_depth];
    return em_lea_local(my_off);
}

// ============================================================================
// for-in 迭代
// ============================================================================
//
// 三种迭代源统一为「长度 + 取第 i 项」：
//   数组/切片：data 指针 + 元素大小缩放下标，取元素地址；
//   区间 a..b：步长 +1（a<b）或 -1（a>b），第 i 项是 a+i*step（值为下标）。
// 绑定（元素/下标）是每轮的值拷贝（语义边界 §8）：绑定槽每轮写入。

// sem_forin_begin：迭代源求值完毕（x0）。it 是迭代对象/区间起点的 Res。
// end_res 为区间终点 Res（非区间传 0 值）。返回 0/-1。绑定槽偏移由
// 调用方经 c_fi_elem_off/c_fi_idx_off 记录。
// sem_forin_begin：迭代源求值完毕（x0）。is_range=1 时 x0 是区间起点，
// 终点在 c_end_tmp_off 槽。返回 0/-1。
fn sem_forin_begin(it *Res, is_range int, end_res *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_fi_depth >= 64) {
        return sem_err("for-in 嵌套过深");
    }
    let d int = c_fi_depth;
    c_fi_cnt_off[d] = em_alloc_local(8);
    c_fi_len_off[d] = em_alloc_local(8);
    c_fi_data_off[d] = em_alloc_local(8);
    c_fi_step_off[d] = em_alloc_local(8);
    c_fi_elem_off[d] = -1;
    c_fi_idx_off[d] = -1;
    if (is_range != 0) {
        c_fi_kind[d] = 1;
        // x0 = 起点。先存 data 槽（起点），再与终点比较定步长与长度。
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        // x11 = 终点（从临时槽）。用 x11 而非 x9：深帧下
        // em_lea_local_to 拼地址走 movz x9，会覆盖 x9 里的终点，
        // 区间长度被算成「槽偏移 - 起点」（run/27：长度 287 而非 4，
        // range_sum 累加成 37128——小帧时 lea 走 sub x10 不触雷，
        // 故 mini 复现全过）
        if (em_lea_local_to(c_end_tmp_off) != 0) { return -1; }
        if (em_ins("ldr\tx11, [x10]") != 0) { return -1; }
        // x0 = 起点
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        // 长度 = max(0, 终点 - 起点)：x11 = 终点-起点；若 <0 置 0
        if (em_ins("sub\tx11, x11, x0") != 0) { return -1; }
        let l_pos int = em_new_label();
        if (em_frag("\tcbnz\tx11, ") != 0) { return -1; }
        if (em_put_lbl(l_pos) != 0) { return -1; }
        if (em_frag("\n") != 0) { return -1; }
        // x11 == 0：空区间，长度 0（保持 x11=0 即可）
        if (em_label(l_pos) != 0) { return -1; }
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
        // 步长恒 +1（左闭右开区间）。先取地址再装常量：深帧 lea 的
        // movz x9 不能落在步长已入 x9 之后（同数组 len 的教训）
        if (em_lea_local_to(c_fi_step_off[d]) != 0) { return -1; }
        if (em_ins("mov\tx9, #1") != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
        if (em_ins("str\txzr, [x10]") != 0) { return -1; }
        c_fi_depth += 1;
        return 0;
    }
    // 数组/切片
    c_fi_kind[d] = 0;
    let k int = t_types[it.type_id].kind;
    if (k == TY_ARRAY) {
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        // 先取地址再装 len：深帧 lea 的 movz x9 不能落在 len 已入 x9 之后
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_mov_imm("x9", t_types[it.type_id].len.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    } else if (k == TY_SLICE) {
        if (em_ins("mov\tx8, x0") != 0) { return -1; }
        if (em_ins("ldr\tx11, [x8]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
        if (em_ins("ldr\tx11, [x8, #8]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
    } else {
        return sem_err("for-in 需要数组、切片或区间");
    }
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("str\txzr, [x10]") != 0) { return -1; }
    c_fi_depth += 1;
    return 0;
}

// sem_forin_elem_size：当前迭代元素的字节大小（区间为 8）。
fn sem_forin_elem_type(it *Res, is_range int) int {
    if (is_range != 0) {
        // 区间迭代绑定是默认整数类型 int（与 stage0 一致，便于 int 变量累加）
        return TY_I32;
    }
    return t_types[it.type_id].elem;
}

// sem_forin_bind：注册本轮绑定槽（元素/下标），返回 0。
fn sem_forin_set_bind(elem_off int, idx_off int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_fi_depth == 0) {
        return sem_err("内部错误：for-in 状态缺失");
    }
    c_fi_elem_off[c_fi_depth - 1] = elem_off;
    c_fi_idx_off[c_fi_depth - 1] = idx_off;
    return 0;
}

// sem_forin_check：循环条件：count < len 则进入；否则跳到 end。
fn sem_forin_check(lbl_end int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx1, [x10]") != 0) { return -1; }
    if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx2, [x10]") != 0) { return -1; }
    if (em_ins("cmp\tx1, x2") != 0) { return -1; }
    if (em_frag("\tb.ge\t") != 0) { return -1; }
    if (em_put_lbl(lbl_end) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    return 0;
}

// sem_forin_load：把第 i 项的值装入 x0 并写入绑定槽（元素/下标）。
// it 提供元素类型；is_range 时值为下标。
fn sem_forin_load(it *Res, is_range int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (is_range != 0) {
        // 下标 = count；值 = 起点 + count*step
        if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        if (c_fi_idx_off[d] >= 0) {
            if (em_lea_local_to(c_fi_idx_off[d]) != 0) { return -1; }
            if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        }
        if (c_fi_elem_off[d] >= 0) {
            // x0 = count（下标）；值 = 起点 + count
            if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
            if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
            if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        }
        return 0;
    }
    // 数组/切片：值 = data[count]
    let elem int = t_types[it.type_id].elem;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
    if (c_fi_idx_off[d] >= 0) {
        if (em_lea_local_to(c_fi_idx_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    }
    // 缩放下标 → data + i*size
    let esz int = t_types[elem].size;
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        if (em_mov_imm("x9", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x9") != 0) { return -1; }
    }
    if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
    if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
    if (c_fi_elem_off[d] >= 0) {
        let ek int = t_types[elem].kind;
        if (ek == TY_STRUCT || ek == TY_UNION || ek == TY_ARRAY || ek == TY_SLICE) {
            // 聚合元素：块拷贝进绑定槽。x0 = 元素地址（add 的结果），
            // 先取绑定槽地址（x10）再拷贝——深帧 lea 的 movz x9 不碰
            // x0，此序天然安全；原「mov x9, x0 保地址」会被 lea 覆盖
            // （copy_block 源错）
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_ins("mov\tx1, x10") != 0) { return -1; }
            if (em_copy_block(t_types[elem].size) != 0) { return -1; }
        } else {
            // 标量元素：x10 = 元素地址，load 到 x0 后存绑定槽
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(elem) != 0) { return -1; }
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_store_sized(elem) != 0) { return -1; }
        }
    }
    return 0;
}

// sem_forin_step：count++ 并回跳。
fn sem_forin_step(lbl_cond int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
    if (em_ins("add\tx0, x0, #1") != 0) { return -1; }
    if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    return em_jmp(lbl_cond);
}

// sem_forin_end：退出迭代层。
fn sem_forin_end() int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    c_fi_depth -= 1;
    return 0;
}

// ============================================================================
// 赋值
// ============================================================================

// sem_stash_lvalue：把 LHS 地址存入函数级临时槽（RHS 求值前保护）。
fn sem_stash_lvalue() int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_temp_off == 0) {
        c_temp_off = em_alloc_local(8);
    }
    // 先保护 x0 中的左值地址，再取临时槽地址，最后写入
    if (em_push() != 0) { return -1; }
    if (em_lea_local(c_temp_off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    return 0;
}

// sem_assign：完成赋值（RHS 值在栈顶；LHS 地址在临时槽）。
fn sem_assign(op int, lres *Res, rres *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("赋值不是编译期常量");
    }
    if (em_lea_local(c_temp_off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (ty_is_float(lres.type_id) != 0) {
        // 浮点赋值：值在 d0/s0
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        if (op == TK_ASSIGN) {
            let fs *char = "d";
            if (t_types[lres.type_id].size == 4) { fs = "s"; }
            if (em_frag("\tstr\t") != 0) { return -1; }
            if (em_frag(fs) != 0) { return -1; }
            if (em_frag("0, [x10]\n") != 0) { return -1; }
            return 0;
        }
        // 复合赋值：右值（d0）存入专用临时槽；目标地址进 x10；旧值读入 d1；
        // 右值弹回 d0；运算后经 x10 存回。
        let fs2 *char = "d";
        if (t_types[lres.type_id].size == 4) { fs2 = "s"; }
        if (c_fp_tmp_off == 0) {
            c_fp_tmp_off = em_alloc_local(8);
        }
        if (em_lea_local_to(c_fp_tmp_off) != 0) { return -1; }
        if (em_frag("\tstr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        if (em_pop("x10") != 0) { return -1; }
        if (em_frag("\tldr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("1, [x10]\n") != 0) { return -1; }
        if (em_ins("str\tx10, [sp, #-16]!") != 0) { return -1; }
        if (em_lea_local_to(c_fp_tmp_off) != 0) { return -1; }
        if (em_frag("\tldr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        if (em_pop("x10") != 0) { return -1; }
        let fb int = op;
        if (op == TK_PLUSEQ) { fb = TK_PLUS; }
        if (op == TK_MINUSEQ) { fb = TK_MINUS; }
        if (op == TK_STAREQ) { fb = TK_STAR; }
        if (op == TK_SLASHEQ) { fb = TK_SLASH; }
        if (em_fp_binop(fb, lres.type_id) != 0) { return -1; }
        if (em_frag("\tstr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        return 0;
    }
    if (op == TK_ASSIGN) {
        if (em_pop("x0") != 0) { return -1; }
        // x10 先取回暂存的目标地址再存（临时槽里存的是地址，不是目标）
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        // 聚合同型赋值 = 逐字节块拷贝（语义边界 §：数组同型赋值为值
        // 复制）。聚合的值语义即对象地址：x0 是源对象地址，x10 是目标
        // 地址；此前误走标量 store 只写前 8 字节。
        let lk int = t_types[lres.type_id].kind;
        if (lk == TY_STRUCT || lk == TY_UNION || lk == TY_ARRAY || lk == TY_SLICE) {
            if (em_ins("mov\tx1, x10") != 0) { return -1; }
            return em_copy_block(t_types[lres.type_id].size);
        }
        return em_store_sized(lres.type_id);
    }
    // 复合赋值：x10 先取回暂存的左值地址，再读值运算后经 x10 存回
    if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
    if (em_load_sized(lres.type_id) != 0) { return -1; }
    if (em_ins("mov\tx9, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    let tid int = sem_promote(lres.type_id, rres.type_id);
    let base int = op;
    if (op == TK_PLUSEQ) { base = TK_PLUS; }
    if (op == TK_MINUSEQ) { base = TK_MINUS; }
    if (op == TK_STAREQ) { base = TK_STAR; }
    if (op == TK_SLASHEQ) { base = TK_SLASH; }
    if (op == TK_PERCENTEQ) { base = TK_PERCENT; }
    if (op == TK_AMPEQ) { base = TK_AMP; }
    if (op == TK_PIPEEQ) { base = TK_PIPE; }
    if (op == TK_CARETEQ) { base = TK_CARET; }
    if (op == TK_LSHIFTEQ) { base = TK_LSHIFT; }
    if (op == TK_RSHIFTEQ) { base = TK_RSHIFT; }
    if (em_binop(base, tid) != 0) { return -1; }
    return em_store_sized(lres.type_id);
}

// ============================================================================
// 声明与语句
// ============================================================================

// sem_declare_local：声明局部标量/聚合（分配槽并零初始化）。返回 sym 下标。
fn sem_declare_local(start int, n int, tid int) int {
    let size int = t_types[tid].size;
    let idx int = sym_push(start, n, SYM_VAR, tid, 0);
    if (idx < 0) {
        return -1;
    }
    let off int = em_alloc_local(size);
    c_syms[idx].offset = off;
    // 零初始化（标量直接清零；聚合逐字节循环）
    if (size == 0) {
        return idx;
    }
    if (size <= 8) {
        if (em_lea_local(off) != 0) { return -1; }
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        let zk *char = "strb\twzr, [x10]";
        if (size == 2) { zk = "strh\twzr, [x10]"; }
        if (size == 4) { zk = "str\twzr, [x10]"; }
        if (size == 8) { zk = "str\txzr, [x10]"; }
        if (em_ins(zk) != 0) { return -1; }
        return idx;
    }
    // 聚合清零循环：x9 = 剩余字节，x10 = 游标。先取槽地址再装计数器：
    // 深帧 lea 的 movz x9 会覆盖计数器（清零长度错/死循环）
    let lz int = em_new_label();
    let ld int = em_new_label();
    if (em_lea_local(off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_mov_imm("x9", size.to_type(i64)) != 0) { return -1; }
    if (em_label(lz) != 0) { return -1; }
    if (em_frag("\tcbz\tx9, ") != 0) { return -1; }
    if (em_put_lbl(ld) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    if (em_ins("strb\twzr, [x10], #1") != 0) { return -1; }
    if (em_ins("sub\tx9, x9, #1") != 0) { return -1; }
    if (em_jmp(lz) != 0) { return -1; }
    if (em_label(ld) != 0) { return -1; }
    return idx;
}

// sem_store_local_value：x0 的值存入局部（let 初始化）。
fn sem_store_local_value(idx int, tid int) int {
    if (c_compile == 0) {
        return 0;
    }
    let k int = t_types[tid].kind;
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE) {
        // 聚合初始化：x0 = 源聚合地址 → 块拷贝进局部槽
        let off int = c_syms[idx].offset;
        if (em_push() != 0) { return -1; }
        if (em_lea_local_down(off) != 0) { return -1; }
        if (em_ins("mov\tx1, x0") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        return em_copy_block(t_types[tid].size);
    }
    if (ty_is_float(tid) != 0) {
        return em_fp_store_local(c_syms[idx].offset, tid);
    }
    let soff int = c_syms[idx].offset;
    if (soff <= 255) {
        if (em_frag("\tstr\t") != 0) { return -1; }
        // 按大小选寄存器与助记符
        let size int = t_types[tid].size;
        if (size == 8) {
            if (em_puts("x0, [x29, #-") != 0) { return -1; }
        } else if (size == 4) {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        } else if (size == 2) {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        } else {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        }
        if (em_puti(soff) != 0) { return -1; }
        return em_frag("]\n");
    }
    // 偏移超出未缩放立即数范围：地址写 x10（不覆盖 x0 中的待存值）
    if (em_lea_local_to(soff) != 0) { return -1; }
    return em_store_sized(tid);
}

// sem_check_duplicate：同一作用域重复声明检查。
fn sem_check_duplicate(start int, n int) int {
    let i int = c_sym_n - 1;
    for i >= c_scope_start[c_scope_n - 1] {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return sem_err("同一作用域内重复声明");
            }
        }
        i -= 1;
    }
    return 0;
}

// ============================================================================
// goto 标签
// ============================================================================

// sem_goto：goto 名字标签。
fn sem_goto(start int, n int) int {
    if (c_compile == 0) {
        return 0;
    }
    // 已定义？
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_glabels[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return em_jmp(c_glabels[i].lbl);
            }
        }
        i += 1;
    }
    // 前向引用：登记
    if (c_glabel_n >= 128) {
        return sem_err("goto 标签过多");
    }
    let off int = name_intern(start, n);
    c_glabels[c_glabel_n].name_off = off;
    c_glabels[c_glabel_n].name_len = n;
    let lbl int = em_new_label();
    c_glabels[c_glabel_n].lbl = lbl;
    c_glabels[c_glabel_n].defined = 0;
    c_glabel_n += 1;
    return em_jmp(lbl);
}

// sem_deflabel：定义名字标签（label: 语句）。
fn sem_deflabel(start int, n int) int {
    if (c_compile == 0) {
        return 0;
    }
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_glabels[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                if (c_glabels[i].defined != 0) {
                    return sem_err("标签重定义");
                }
                c_glabels[i].defined = 1;
                return em_label(c_glabels[i].lbl);
            }
        }
        i += 1;
    }
    if (c_glabel_n >= 128) {
        return sem_err("goto 标签过多");
    }
    let off int = name_intern(start, n);
    c_glabels[c_glabel_n].name_off = off;
    c_glabels[c_glabel_n].name_len = n;
    let lbl int = em_new_label();
    c_glabels[c_glabel_n].lbl = lbl;
    c_glabels[c_glabel_n].defined = 1;
    c_glabel_n += 1;
    return em_label(lbl);
}

// sem_glabels_verify：函数结束前校验全部标签已定义。
fn sem_glabels_verify() int {
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].defined == 0) {
            return sem_err("goto 了未定义的标签");
        }
        i += 1;
    }
    c_glabel_n = 0;
    return 0;
}

// ============================================================================
// 循环栈
// ============================================================================

// sem_loop_push：进入循环体（brk/cnt 标签入栈）。
fn sem_loop_push(brk int, cnt int) int {
    if (c_loop_depth >= 64) {
        return sem_err("循环嵌套过深");
    }
    c_brk_stk[c_loop_depth] = brk;
    c_cnt_stk[c_loop_depth] = cnt;
    c_loop_depth += 1;
    c_loop_brk = brk;
    c_loop_cnt = cnt;
    return 0;
}

// sem_loop_pop：退出循环体。
fn sem_loop_pop() int {
    c_loop_depth -= 1;
    if (c_loop_depth > 0) {
        c_loop_brk = c_brk_stk[c_loop_depth - 1];
        c_loop_cnt = c_cnt_stk[c_loop_depth - 1];
    }
    return 0;
}

// sem_break / sem_continue。
fn sem_break() int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_loop_depth == 0) {
        return sem_err("break 不在循环内");
    }
    return em_jmp(c_loop_brk);
}

fn sem_continue() int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_loop_depth == 0) {
        return sem_err("continue 不在循环内");
    }
    return em_jmp(c_loop_cnt);
}

// ============================================================================
// 函数定义与结构体布局（由 parse_decl.yh 调用）
// ============================================================================

// sem_fn_begin：进入函数体编译（体先进缓冲；fn 作用域压栈）。
fn sem_fn_begin(idx int) int {
    c_fn_sym = idx;
    c_fn_ret = t_types[c_syms[idx].type_id].elem;
    c_fn_lbl = em_new_label();
    c_temp_off = 0;
    c_glabel_n = 0;
    c_spill_n = 0;
    c_aggparam_n = 0;
    c_fp_argn = 0;
    c_ret_ptr_off = 0;
    // prologue 的 fp/lr 对占 16 字节，槽偏移从 16 起算
    c_fp_off = 16;
    o_body_len = 0;
    c_in_body = 1;
    // 聚合返回：入口保存 x8（调用方给的返回缓冲地址）
    let rk int = t_types[c_fn_ret].kind;
    if (rk == TY_STRUCT || rk == TY_UNION || rk == TY_ARRAY || rk == TY_SLICE) {
        c_ret_agg = 1;
        c_ret_ptr_off = em_alloc_local(TG_PTR_SIZE);
        // 入口把 x8（调用方返回缓冲）存进槽：函数体在缓冲中发射时会用到
        if (em_save_hidden_ret(c_ret_ptr_off) != 0) {
            return -1;
        }
    } else {
        c_ret_agg = 0;
    }
    scope_push();
    return 0;
}

// sem_declare_param：声明参数。前 8 个记入溢出表（prologue 统一发射）；
// 更多参数位于调用方栈区（地址 = fp + 16 + 8*(regidx-8)，AAPCS64 栈实参
// 8 字节槽，与 stage0 的 arm64-gen.c C.14 一致），编码为负偏移
// （em_lea_local 以 add 处理）。
fn sem_declare_param(start int, n int, tid int, regidx int) int {
    let pk int = t_types[tid].kind;
    let is_agg int = ((pk == TY_ARRAY) || (pk == TY_STRUCT) || (pk == TY_UNION)
                      || (pk == TY_SLICE)).to_type(int);
    let size int = t_types[tid].size;
    let idx int = sym_push(start, n, SYM_VAR, tid, F_PARAM);
    if (idx < 0) {
        return -1;
    }
    if (is_agg != 0) {
        // 聚合按值：参数槽存「指向调用方副本的指针」，入口处再拷进本帧
        // 的独立存储。拷贝让形参修改不影响调用方（ADR-0001 可观察行为），
        // 也让递归各层持有各自副本。
        let pslot int = 0;
        if (regidx < TG_ARG_REGS) {
            pslot = em_alloc_local(TG_PTR_SIZE);
            c_spill_reg[c_spill_n] = regidx;
            c_spill_off[c_spill_n] = pslot;
            c_spill_size[c_spill_n] = 0;
            c_spill_n += 1;
        } else {
            // 栈实参第 (regidx-8) 个槽存指针
            // 栈实参 8 字节间距（AAPCS64/调用方回压一致）
            pslot = 0 - (16 + 8 * (regidx - TG_ARG_REGS));
        }
        let body int = em_alloc_local(size);
        c_syms[idx].offset = body;
        c_syms[idx].flags |= F_AGGPARAM;
        // 记录「指针槽 → 体型槽」的入口拷贝任务，prologue 之后执行
        c_aggparam_src[c_aggparam_n] = pslot;
        c_aggparam_dst[c_aggparam_n] = body;
        c_aggparam_size[c_aggparam_n] = size;
        c_aggparam_n += 1;
        return 0;
    }
    if (ty_is_float(tid) != 0) {
        // 浮点参数：前 8 个进 d0-d7（负数标记 + 浮点槽溢出）
        if (c_fp_argn < TG_ARG_REGS) {
            let off int = em_alloc_local(size);
            c_syms[idx].offset = off;
            c_spill_reg[c_spill_n] = 0 - (c_fp_argn + 1);
            c_spill_off[c_spill_n] = off;
            c_spill_size[c_spill_n] = tid;
            c_spill_n += 1;
            c_fp_argn += 1;
            return 0;
        }
        // 超出：栈传（这里简化拒绝，B7 用例不涉及）
        return sem_err("过多的浮点参数暂不支持");
    }
    if (regidx < TG_ARG_REGS) {
        let ioff int = em_alloc_local(size);
        c_syms[idx].offset = ioff;
        c_spill_reg[c_spill_n] = regidx;
        c_spill_off[c_spill_n] = ioff;
        c_spill_size[c_spill_n] = 0;
        c_spill_n += 1;
        return 0;
    }
    // AAPCS：调用方栈实参区在 sp_at_call+0 起（每参 8 字节槽）；
    // callee 的 fp = sp_at_call-16
    c_syms[idx].offset = 0 - (16 + 8 * (regidx - TG_ARG_REGS));
    return 0;
}

// sem_fn_end：函数体结束。装配顺序：prologue（含帧分配与参数溢出）→
// 函数体 → epilogue。落底路径对非 void 返回 0。
fn sem_fn_end() int {
    if (sem_glabels_verify() != 0) {
        return -1;
    }
    // 落底返回：聚合返回函数以 x0 = 聚合地址（调用方缓冲或本帧临时）；
    // 标量返回 0。显式 return 已在各分支把值放好。
    if (c_ret_agg != 0) {
        if (c_ret_agg_val != 0) {
            if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        } else {
            if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        }
    } else if (c_fn_ret != TY_VOID) {
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
    }
    c_in_body = 0;
    if (em_prologue(c_fn_sym) != 0) {
        return -1;
    }
    // 聚合参数入口拷贝：x10 = 指针槽内容（调用方副本地址），
    // 逐字节拷进本帧体型槽
    let ai int = 0;
    for ai < c_aggparam_n {
        if (em_lea_local_to(c_aggparam_src[ai]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        if (em_lea_local_to(c_aggparam_dst[ai]) != 0) { return -1; }
        if (em_ins("mov\tx1, x10") != 0) { return -1; }
        if (em_copy_block(c_aggparam_size[ai]) != 0) { return -1; }
        ai += 1;
    }
    // 聚合参数指针槽本身不再需要，但槽已在静态帧内，无需回收
    if (em_copy_body() != 0) {
        return -1;
    }
    if (em_epilogue() != 0) {
        return -1;
    }
    scope_pop();
    return 0;
}

// sem_add_field：为当前 struct/union 追加字段（pass 1）。
fn sem_add_field(stid int, start int, n int, ftid int) int {
    let fk int = t_types[ftid].kind;
    if ((fk == TY_STRUCT || fk == TY_UNION) && t_types[ftid].size == 0) {
        return sem_err("字段使用了不完整的类型");
    }
    if (t_field_n == t_field_cap) {
        let ncap int = t_field_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *SField = malloc((ncap * sizeof(SField)).to_type(u64)).to_type(*SField);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (t_field_n > 0) {
            memcpy(nd, t_fields, (t_field_n * sizeof(SField)).to_type(u64));
        }
        free(t_fields);
        t_fields = nd;
        t_field_cap = ncap;
    }
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    t_fields[t_field_n].name_off = off;
    t_fields[t_field_n].name_len = n;
    t_fields[t_field_n].type_id = ftid;
    t_fields[t_field_n].offset = 0;
    t_field_n += 1;
    t_types[stid].len = t_field_n - t_types[stid].sub;
    return 0;
}

// sem_struct_finish：布局计算（tg_layout_struct）并回填大小/对齐。
fn sem_struct_finish(stid int, is_union int) int {
    let sub int = t_types[stid].sub;
    let n int = t_types[stid].len;
    if (tg_layout_struct(sub, n, is_union) != 0) {
        return -1;
    }
    t_types[stid].size = c_layout_size;
    t_types[stid].align = c_layout_align;
    return 0;
}

// sem_field_lookup：按名字查结构体字段，返回字段表下标（-1 无）。
fn sem_field_lookup(stid int, start int, n int) int {
    let st int = t_types[stid].sub;
    let nf int = t_types[stid].len;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (t_fields[f].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_fields[f].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return f;
            }
        }
        i += 1;
    }
    return -1;
}

// ============================================================================
// 两遍编译驱动
// ============================================================================

// sem_check_main：main 存在且签名为 () int 或 (argc int, argv **char) int。
fn sem_check_main() int {
    let mname int = name_intern_lit("main");
    let i int = c_sym_n - 1;
    let found int = -1;
    for i >= 0 {
        if (c_syms[i].name_len == 4) {
            let match int = 1;
            let j int = 0;
            for j < 4 {
                if (np_data[c_syms[i].name_off + j] != np_data[mname + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = i;
                break;
            }
        }
        i -= 1;
    }
    if (found < 0) {
        return sem_err("缺少 main 函数");
    }
    if (c_syms[found].kind != SYM_FN) {
        return sem_err("main 必须是函数");
    }
    let sig int = t_types[c_syms[found].type_id].sub;
    let np int = t_sig_np[sig];
    let ret int = t_sig_ret[sig];
    if (ret != TY_I32) {
        return sem_err("main 必须返回 int");
    }
    if (np == 0) {
        return 0;
    }
    if (np == 2) {
        let p0 int = t_sig_params[t_sig_first[sig]];
        let p1 int = t_sig_params[t_sig_first[sig] + 1];
        let inner int = t_types[p1].elem;
        if (p0 == TY_I32 && t_types[p1].kind == TY_PTR
            && t_types[inner].kind == TY_PTR
            && t_types[t_types[inner].elem].kind == TY_CHAR) {
            return 0;
        }
    }
    return sem_err("main 签名必须是 () 或 (argc int, argv **char)");
}

// sem_compile：编译模式总驱动（读源与词法已由 driver 完成）。
// pass1 顶层扫描 → main 检查 → pass2a 全局初始化（源码顺序）→
// pass2b 函数体逐个编译。全部通过后输出 .text/.data/.bss。
fn sem_compile() int {
    // pass 1：登记类型、函数签名与全局名字
    c_pos = 0;
    c_pass = 1;
    if (parse_source() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    if (sem_check_main() != 0) {
        return -1;
    }
    // pass 2a：全局 let/const 初始化（引用先声明规则由此保证）
    c_pos = 0;
    c_pass = 2;
    if (em_puts("\n") != 0) {
        return -1;
    }
    if (parse_source_globals() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // pass 2b：函数体
    c_pos = 0;
    if (parse_source_fns() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // 发射 .bss：零初始化全局（清单在 pass 2a 收集）
    let i int = 0;
    for i < c_bss_n {
        let bi int = c_bss_syms[i];
        if (em_bss_symbol(bi, t_types[c_syms[bi].type_id].size, t_types[c_syms[bi].type_id].align) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}
