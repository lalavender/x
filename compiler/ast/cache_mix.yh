module ast

// ============================================================================
// cache_mix.yh —— 函数缓存键的 FNV-1a 64 原语（唯一实现）
//
// check 键（module_snapshot_check_key.yh，pass2b 前）与 IR 键
// （module_snapshot_lower_cache.yh，lowering 后）必须对同一函数得到同一
// 16 位十六进制键，因此混入原语只能有一份：任何一侧私自改序列都会让
// check 缓存与 IR 缓存对同一函数算出不同键，命中率静默归零。
//
// 2026-10-25 B3-1：从 module_snapshot_lower_cache.yh 下沉到本文件并改为 pub。
// 理由是该文件属于 lowering，而 check 键必须在 lowering 之前可用；下沉后
// ast 不再依赖 lowering 侧的符号，lower 侧改为引用 ast 的这三个原语。
// ============================================================================

// checked_cache_mix_byte：FNV-1a 64 混入一个字节。
pub fn checked_cache_mix_byte(hash *u64, byte u8) void {
    hash[0] = hash[0] ^ byte.to_type(u64)
    hash[0] = hash[0] * 1099511628211
}

// checked_cache_mix_int：把 int 的补码位型按小端八字节混入。
pub fn checked_cache_mix_int(hash *u64, value int) void {
    let bits u64 = value.to_type(i64).to_type(u64)
    let i int = 0
    for i < 8 {
        checked_cache_mix_byte(hash, ((bits >> (i * 8)) & 255).to_type(u8))
        i += 1
    }
}

// checked_cache_mix_text：混入已终止字符串（不含结尾零）。
pub fn checked_cache_mix_text(hash *u64, text *char) int {
    if (text == 0) { return -1 }
    let i int = 0
    for text[i] != 0 {
        checked_cache_mix_byte(hash, text[i].to_type(u8))
        i += 1
    }
    return 0
}
