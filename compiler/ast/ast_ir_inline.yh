module ast;
import gen;
import ir;

// AstIRInlineEntry：保存本模块简单 inline 函数的稳定 SSA 编码。
struct AstIRInlineEntry {
    sym_id int;
    data *u8;
    length int;
}

let ast_ir_inline_entries *AstIRInlineEntry = 0;
let ast_ir_inline_count int = 0;
let ast_ir_inline_cap int = 0;

// ast_ir_inline_reset：释放本模块内联候选编码，避免跨 worker 状态泄漏。
fn ast_ir_inline_reset() void {
    let i int = 0;
    for i < ast_ir_inline_count {
        if (ast_ir_inline_entries[i].data != 0) {
            free(ast_ir_inline_entries[i].data);
        }
        i += 1;
    }
    if (ast_ir_inline_entries != 0) { free(ast_ir_inline_entries); }
    ast_ir_inline_entries = 0;
    ast_ir_inline_count = 0;
    ast_ir_inline_cap = 0;
}

// ast_ir_inline_find：按当前模块符号槽查找已登记的纯 SSA 候选。
fn ast_ir_inline_find(sym_id int) int {
    let i int = 0;
    for i < ast_ir_inline_count {
        if (ast_ir_inline_entries[i].sym_id == sym_id) { return i; }
        i += 1;
    }
    return -1;
}

// ast_ir_inline_register：保存已通过候选限制的 SSA；不合适的形态静默回退。
fn ast_ir_inline_register(sym_id int, f *ir.IRFunction) int {
    if (sym_id < 0 || f == 0 || ir.ir_inline_candidate_ok(f) == 0
        || ast_ir_inline_find(sym_id) >= 0) { return 0; }
    let length int = ir.ir_serialized_size(f);
    if (length <= 0) { return -1; }
    let data *u8 = malloc(length.to_type(u64)).to_type(*u8);
    if (data == 0 || ir.ir_serialize(f, data, length) != length) {
        if (data != 0) { free(data); }
        return -1;
    }
    if (ast_ir_inline_count == ast_ir_inline_cap) {
        let ncap int = ast_ir_inline_cap == 0 ? 8 : ast_ir_inline_cap * 2;
        let next *AstIRInlineEntry = malloc(
            (ncap * sizeof(AstIRInlineEntry)).to_type(u64)).to_type(*AstIRInlineEntry);
        if (next == 0) { free(data); return -1; }
        if (ast_ir_inline_count > 0) {
            memcpy(next, ast_ir_inline_entries,
                (ast_ir_inline_count * sizeof(AstIRInlineEntry)).to_type(u64));
        }
        if (ast_ir_inline_entries != 0) { free(ast_ir_inline_entries); }
        ast_ir_inline_entries = next;
        ast_ir_inline_cap = ncap;
    }
    let row int = ast_ir_inline_count;
    ast_ir_inline_entries[row].sym_id = sym_id;
    ast_ir_inline_entries[row].data = data;
    ast_ir_inline_entries[row].length = length;
    ast_ir_inline_count += 1;
    return 0;
}

// ast_ir_inline_symbol：按调用 lowering 规则构造完整目标名供 SSA 精确匹配。
fn ast_ir_inline_symbol(base *AstExpr, out *u8) int {
    let gs *gen.GenState = gen.G();
    let n int = 0;
    if (gen.tg_darwin() != 0) {
        out[n] = '_';
        n += 1;
    }
    let i int = 0;
    for i < base.sym_name_len {
        out[n] = gs.np_data[base.sym_name_off + i];
        n += 1;
        i += 1;
    }
    if (ast_ir_call_has_suffix(base) != 0) {
        i = 0;
        for i < gs.c_sym_sfx_len {
            out[n] = gs.np_data[gs.c_sym_sfx_off + i];
            n += 1;
            i += 1;
        }
    }
    return n;
}

// ast_ir_inline_apply：只展开本模块私有直接调用，缺函数体时保留普通调用。
fn ast_ir_inline_apply(ctx *AstFunctionContext, f *ir.IRFunction) int {
    let total int = 0;
    let expr_id int = ctx.expr_first;
    for expr_id < ctx.expr_after {
        let node AstExpr = ast_expr_nodes[expr_id];
        if (node.kind == AST_EXPR_CALL && node.child0 >= ctx.expr_first
            && node.child0 < ctx.expr_after) {
            let base *AstExpr = &ast_expr_nodes[node.child0];
            if (base.sym_kind == gen.SYM_FN
                && (base.sym_flags & gen.F_INLINE) != 0
                && (base.sym_flags & gen.F_PUB) == 0) {
                let row int = ast_ir_inline_find(base.sym_id);
                if (row >= 0) {
                    let callee ir.IRFunction;
                    callee.types = 0;
                    callee.insts = 0;
                    callee.phis = 0;
                    callee.phi_inputs = 0;
                    callee.calls = 0;
                    callee.call_args = 0;
                    callee.call_symbols = 0;
                    callee.blocks = 0;
                    if (ir.ir_deserialize(&callee,
                        ast_ir_inline_entries[row].data,
                        ast_ir_inline_entries[row].length, f.target_id) != 0) {
                        return gen.fail("内部错误：inline SSA 候选解码失败");
                    }
                    let target [1024]u8;
                    let target_len int = ast_ir_inline_symbol(base, target);
                    let expanded int = ir.ir_inline_one(f, &callee,
                        target, target_len);
                    ir.ir_function_release(&callee);
                    if (expanded < 0) {
                        return gen.fail("inline SSA 展开失败");
                    }
                    total += expanded;
                }
            }
        }
        expr_id += 1;
    }
    return total;
}
