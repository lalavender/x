module ast;
import gen;
import ir;

// ast_ir_comptime_for_restore：恢复循环体词法绑定的值，避免它们逃出模板作用域。
fn ast_ir_comptime_for_restore(b *AstIRBuilder, binding_row int,
    binding_after int, saved_values *int) void {
    let row int = binding_row;
    for row < binding_after {
        let binding AstBinding = ast_bindings[row];
        b.local_values[binding.id] = saved_values[row - binding_row];
        row += 1;
    }
}

// ast_ir_b_comptime_for：按编译期半开区间反复降低单份 typed AST 模板。
fn ast_ir_b_comptime_for(b *AstIRBuilder, ctx *AstFunctionContext,
    stmt_id int) int {
    let template int = ast_comptime_for_find_stmt(stmt_id);
    if (template < 0) { return -2; }
    let binding_row int = -1;
    let binding_after int = -1;
    let body_stmt int = -1;
    let low i64 = 0;
    let high i64 = 0;
    if (ast_comptime_for_info(template, &binding_row, &binding_after,
        &body_stmt, &low, &high) != 0
        || binding_row < ctx.binding_first || binding_after > ctx.binding_after
        || body_stmt < ctx.stmt_first || body_stmt >= ctx.stmt_after
        || ast_stmt_nodes[stmt_id].first_child != body_stmt) { return -2; }
    let loop_binding AstBinding = ast_bindings[binding_row];
    if (loop_binding.id != b.param_count + b.local_count
        || loop_binding.id < 0 || loop_binding.id >= b.binding_count) { return -2; }
    let slot_count int = binding_after - binding_row;
    let saved_values *int = malloc((slot_count * sizeof(int)).to_type(u64)).to_type(*int);
    if (saved_values == 0) { return gen.fail("编译期 AST 模板 lowering 快照分配失败"); }
    let row int = binding_row;
    for row < binding_after {
        let binding AstBinding = ast_bindings[row];
        if (binding.id < 0 || binding.id >= b.binding_count
            || row < ctx.binding_first || row >= ctx.binding_after) {
            free(saved_values.to_type(*void));
            return -2;
        }
        saved_values[row - binding_row] = b.local_values[binding.id];
        row += 1;
    }
    let outer_local_count int = b.local_count;
    let body_local_start int = outer_local_count + 1;
    let body_local_after int = -1;
    let value i64 = low;
    for value < high {
        row = binding_row;
        for row < binding_after {
            let binding AstBinding = ast_bindings[row];
            b.local_values[binding.id] = saved_values[row - binding_row];
            row += 1;
        }
        b.local_count = body_local_start;
        let constant int = ast_ir_b_add_inst(b, ir.IR_OP_CONST,
            ir.IR_TY_I32, -1, -1, value);
        if (constant < 0) {
            ast_ir_comptime_for_restore(b, binding_row, binding_after, saved_values);
            b.local_count = outer_local_count;
            free(saved_values.to_type(*void));
            return gen.fail("编译期 `$for` 模板迭代常量生成失败");
        }
        b.local_values[loop_binding.id] = constant;
        let status int = ast_ir_b_stmts(b, ctx,
            ast_stmt_nodes[body_stmt].first_child);
        if (status == 1) {
            if (body_local_after < 0) {
                body_local_after = b.local_count;
            } else if (body_local_after != b.local_count) {
                ast_ir_comptime_for_restore(b, binding_row, binding_after, saved_values);
                b.local_count = outer_local_count;
                free(saved_values.to_type(*void));
                return gen.fail("内部错误：编译期 `$for` AST 模板绑定布局不稳定");
            }
            value += 1;
            continue;
        }
        ast_ir_comptime_for_restore(b, binding_row, binding_after, saved_values);
        b.local_count = outer_local_count;
        free(saved_values.to_type(*void));
        return status;
    }
    ast_ir_comptime_for_restore(b, binding_row, binding_after, saved_values);
    b.local_count = body_local_after;
    free(saved_values.to_type(*void));
    return 1;
}
