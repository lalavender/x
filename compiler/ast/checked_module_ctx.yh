module ast;
import ir;

// ============================================================================
// checked_module_ctx.yh —— 纯快照 lowering 的可变上下文
//
// 本文件只声明纯快照 lowering（compiler/ast/checked_module_lower.yh）的两个
// 共享上下文类型。受检快照本身（CheckedString/CheckedStorage）在
// checked_module.yh 声明；模块要求类型先声明后使用、并按文件名字典序编译，
// 因此本文件排在 checked_module.yh 之后、checked_module_lower.yh 之前，
// 且两个结构体之间不允许互相引用（CheckedFlow 只引用 lowering 的构造器
// 指针，跨对象关系由调用方显式传参给出）。
// ============================================================================

// CheckedFlow：循环与合流状态，生命周期不超过一次 lower_module。
// carry_* 由循环发现趟填充、真实趟消费；break_* 按发现趟站点数预分配。
// 不持有 GenState、旧汇编缓冲或语义表指针，也不写回受检快照。
struct CheckedFlow {
    builder *AstIRBuilder;   // 当前函数的纯 SSA 构造器（由 CheckedLower 提供）
    flow_carry *int;         // 循环携带绑定的稳定绑定 ID（源码顺序、已去重）
    flow_carry_count int;
    flow_carry_cap int;
    flow_carry_phis *int;    // 真实趟：各携带绑定在循环头的 phi 指令编号
    flow_break_blocks *int;  // 真实趟：各 break 站点所在块
    flow_break_vals *int;    // 真实趟：break 站点的携带值快照（行×站点）
    flow_continue_done int;  // 真实趟：已创建的 continue 边数
    flow_break_done int;     // 真实趟：已创建的 break 边数
    flow_break_target int;   // 退出块；-1 = 不在循环内
    flow_continue_target int; // 循环头块；-1 = 不在循环内
}

// CheckedLower：单函数纯快照降低的可变上下文；所有语义读取经 store，不装回 GenState。
// builder 复用既有纯 SSA 缓冲/块/phi helper；映射与输出由本次 lower_module 独占。
struct CheckedLower {
    store *CheckedStorage;   // 只读受检快照；本上下文不取得所有权
    output *ir.IRModule;     // 本次 lower_module 独占的模块构造器
    flow *CheckedFlow;       // 循环/合流状态；由 lower_module 栈上持有
    function CheckedFunction; // 当前函数在快照中的 AST 范围
    builder AstIRBuilder;    // 纯 SSA 构造器（既有 helper，不读 GenState）
    source_map *int;         // 快照文件 → 模块来源下标；无源码为 -1
    source_type_map *int;    // 快照类型 → canonical IR 类型映射；不支持为 -1
    private_type_map *int;   // canonical IR 类型 → 模块类型下标
    function_binding_first int; // 本函数绑定在快照绑定表中的起始行
    function_binding_count int; // 本函数绑定数（参数在前）
    taken *u8;                  // 按模块绑定表行的取址标记；1 = 需要内存驻留
    storage *int;               // 按模块绑定表行的存储指针 + 1；0 = 未分配/未取址
    function_break_sites int;   // 发现趟结论：循环体 break 站点数
    local_count int;         // 已按顺序遍历的 let 数（绑定编号顺序校验）
    last_token int;          // 最近处理的 token，用于失败诊断定位
    reason *char;            // 首片不支持时的稳定原因文本
}
