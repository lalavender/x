module ast;
import ir;

// ============================================================================
// checked_module_ctx.yh —— 纯快照 lowering 的可变上下文
//
// 本文件声明纯快照 lowering（compiler/ast/checked_module_lower.yh）的三个
// 共享上下文类型（CheckedLoop/CheckedFlow/CheckedLower）。受检快照本身
// （CheckedString/CheckedStorage）在 checked_module.yh 声明；模块要求类型
// 先声明后使用、并按文件名字典序编译，因此本文件排在 checked_module.yh
// 之后、checked_module_lower.yh 之前。CheckedFlow 只引用 lowering 的构造器
// 指针与循环栈数组，跨对象关系由调用方显式传参给出。
// ============================================================================

// CheckedLoop：一层循环的携带绑定与 break/continue 状态；嵌套时按深度共存。
// carry 保存被赋值绑定的稳定 ID（去重、源码顺序），发现趟填充、真实趟消费；
// break 快照按「行 × 携带绑定」展开，break_capacity 是发现趟确定的站点数。
struct CheckedLoop {
    carry *int;
    carry_count int;
    carry_cap int;
    carry_phis *int;         // 真实趟：各携带绑定在循环头的 phi 指令编号
    break_blocks *int;       // 真实趟：各 break 站点所在块
    break_vals *int;         // 真实趟：break 站点的携带值快照（行×站点）
    break_capacity int;      // 发现趟结论：本层 break 站点容量上限
    continue_done int;       // 真实趟：已创建的 continue 边数
    break_done int;          // 真实趟：已创建的 break 边数
    break_target int;        // 退出块；-1 = 本层未开放
    continue_target int;     // 循环头块；-1 = 本层未开放
    stmt_id int;             // 本层 for 语句 ID；用于排除循环体内声明的绑定
}

// CHECKED_LOOP_MAX：循环嵌套上限；超出时带来源拒绝而不是无限增长。
const CHECKED_LOOP_MAX int = 16;

// CheckedFlow：嵌套循环栈与当前函数的纯 SSA 构造器。loops 由 lower_module
// 分配，只有 [0, loop_depth) 有效，栈顶是当前最内层循环。
struct CheckedFlow {
    builder *AstIRBuilder;   // 当前函数的纯 SSA 构造器（由 CheckedLower 提供）
    loops *CheckedLoop;      // 嵌套循环栈，容量 CHECKED_LOOP_MAX
    loop_depth int;          // 已开放的循环层数
}

// CheckedLabel：当前函数的 goto 标签 → 基本块映射；名字用源码字节区间标识。
// 只在含 goto/label 的函数里使用；函数降低前重置 label_count。
struct CheckedLabel {
    file_id int;
    start int;
    length int;
    block int;
}

// CheckedLower：单函数纯快照降低的可变上下文；所有语义读取经 store，不装回 GenState。
// builder 复用既有纯 SSA 缓冲/块/phi helper；映射与输出由本次 lower_module 独占。
struct CheckedLower {
    store *CheckedStorage;   // 只读受检快照；本上下文不取得所有权
    output *ir.IRModule;     // 本次 lower_module 独占的模块构造器
    flow *CheckedFlow;       // 循环/合流状态；由 lower_module 栈上持有
    function CheckedFunction; // 当前函数在快照中的 AST 范围
    builder AstIRBuilder;    // 纯 SSA 构造器（既有 helper，不读 GenState）
    source_map *int;         // 快照文件 → 模块来源下标；无源码为 -1
    source_type_map *int;    // 快照类型 → canonical IR 类型映射；不支持为 -1
    private_type_map *int;   // canonical IR 类型 → 模块类型下标
    function_binding_first int; // 本函数绑定在快照绑定表中的起始行
    function_binding_count int; // 本函数绑定数（参数在前）
    taken *u8;                  // 按模块绑定表行的取址标记；1 = 需要内存驻留
    storage *int;               // 按模块绑定表行的存储指针 + 1；0 = 未分配/未取址
    slice_storage *int;      // 切片字面量表达式 → 后备数组存储指针 + 1；按表达式编号
    labels *CheckedLabel;    // 当前函数 goto 标签 → 块表；逐函数重置计数
    label_count int;
    label_cap int;
    has_goto int;            // 当前函数含 goto/label：全部绑定内存驻留
    local_count int;         // 已按顺序遍历的 let 数（绑定编号顺序校验）
    last_token int;          // 最近处理的 token，用于失败诊断定位
    reason *char;            // 首片不支持时的稳定原因文本
}
