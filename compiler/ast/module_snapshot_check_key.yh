module ast
import gen
import ir

// ============================================================================
// module_snapshot_check_key.yh —— pass2b 前的函数 check 键（LA3.3 C3）
//
// 检查缓存必须在 parse/语义遍历之前判断能否跳过函数体。此时只有 GenState 的
// PFile/token/类型/签名/声明表，没有 CheckedStorage；本文件用与
// module_snapshot_lower_cache.yh 相同的哈希序列计算键，保证 check 缓存与 IR
// 缓存对同一函数得到同一 16 位十六进制键。
// ============================================================================

// checked_gen_mix_tokens：把 GenState 文件中的 token 范围混入哈希。
fn checked_gen_mix_tokens(file_id int, first int, after int, hash *u64) int {
    let gs *gen.GenState = gen.G()
    if (file_id < 0 || file_id >= gs.p_file_n || first < 0 || after <= first) {
        return -1
    }
    let file gen.PFile = gs.p_files[file_id]
    if (file.source == 0 || file.tokens == 0 || after > file.token_n) { return -1 }
    let i int = first
    for i < after {
        let tok gen.Tok = file.tokens[i]
        if (tok.start < 0 || tok.len < 0 || tok.start + tok.len > file.source_len) {
            return -1
        }
        checked_cache_mix_int(hash, tok.kind)
        let j int = 0
        for j < tok.len {
            checked_cache_mix_byte(hash, file.source[tok.start + j])
            j += 1
        }
        i += 1
    }
    return 0
}

// checked_gen_layout：混入 GenState 的类型/字段/签名布局。
fn checked_gen_layout(hash *u64) void {
    let gs *gen.GenState = gen.G()
    checked_cache_mix_int(hash, gs.task.t_type_n)
    let i int = 0
    for i < gs.task.t_type_n {
        let ty gen.CType = gs.task.t_types[i]
        checked_cache_mix_int(hash, ty.kind)
        checked_cache_mix_int(hash, ty.size)
        checked_cache_mix_int(hash, ty.align)
        checked_cache_mix_int(hash, ty.elem)
        checked_cache_mix_int(hash, ty.len)
        checked_cache_mix_int(hash, ty.sub)
        i += 1
    }
    checked_cache_mix_int(hash, gs.task.t_field_n)
    i = 0
    for i < gs.task.t_field_n {
        let field gen.SField = gs.task.t_fields[i]
        checked_cache_mix_int(hash, field.name_len)
        checked_cache_mix_int(hash, field.type_id)
        checked_cache_mix_int(hash, field.offset)
        i += 1
    }
    checked_cache_mix_int(hash, gs.task.t_sig_n)
    i = 0
    for i < gs.task.t_sig_n {
        checked_cache_mix_int(hash, gs.task.t_sig_abi[i])
        checked_cache_mix_int(hash, gs.task.t_sig_ret[i])
        checked_cache_mix_int(hash, gs.task.t_sig_np[i])
        checked_cache_mix_int(hash, gs.task.t_sig_vararg[i])
        checked_cache_mix_int(hash, gs.task.t_sig_first[i])
        i += 1
    }
    checked_cache_mix_int(hash, gs.task.t_sigparam_n)
    i = 0
    for i < gs.task.t_sigparam_n {
        checked_cache_mix_int(hash, gs.task.t_sig_params[i])
        i += 1
    }
}

// checked_gen_symbol_facts：pass2b 前混入源码级 const 的常量值，覆盖依赖 CT
// 对本模块 const 的折叠结果（例如 ANSWER）；匿名/运行时符号不参与。
fn checked_gen_symbol_facts(hash *u64) void {
    let gs *gen.GenState = gen.G()
    let i int = 0
    for i < ast_decl_count {
        let decl AstDecl = ast_decl_nodes[i]
        if (decl.kind == gen.TK_CONST && decl.sym_id >= 0
            && decl.sym_id < gs.task.c_sym_n) {
            let sym gen.CSym = gs.task.c_syms[decl.sym_id]
            checked_cache_mix_int(hash, sym.kind)
            checked_cache_mix_int(hash, sym.type_id)
            checked_cache_mix_int(hash, sym.flags)
            checked_cache_mix_int(hash, sym.cval.to_type(int))
            checked_cache_mix_int(hash, sym.const_ready)
            checked_cache_mix_int(hash, sym.const_expr_kind)
        }
        i += 1
    }
}

// checked_gen_decl_facts：混入非函数声明 token 流；函数体不进入其他函数的键。
fn checked_gen_decl_facts(hash *u64) int {
    let i int = 0
    for i < ast_decl_count {
        let decl AstDecl = ast_decl_nodes[i]
        if (decl.kind != gen.TK_FN) {
            if (checked_gen_mix_tokens(decl.file_id, decl.first, decl.after,
                    hash) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_pdecl_decl_row：把文件内 PDecl 下标映射为 ast_decl_nodes 行。
pub fn checked_pdecl_decl_row(file_id int, pdecl_index int) int {
    if (file_id < 0 || file_id >= ast_decl_file_cap || ast_decl_file_first == 0
        || ast_decl_file_first[file_id] < 0) { return -1 }
    let row int = ast_decl_file_first[file_id] + pdecl_index
    if (row < 0 || row >= ast_decl_count
        || ast_decl_nodes[row].file_id != file_id
        || ast_decl_nodes[row].decl_index != pdecl_index) { return -1 }
    return row
}

// checked_gen_function_key：pass2b 前的函数 check 键；成功返回 0 并写 out。
pub fn checked_gen_function_key(decl_row int, out *u8) int {
    let gs *gen.GenState = gen.G()
    if (out == 0 || decl_row < 0 || decl_row >= ast_decl_count) { return -1 }
    let decl AstDecl = ast_decl_nodes[decl_row]
    if (decl.kind != gen.TK_FN || decl.file_id < 0 || decl.file_id >= gs.p_file_n) {
        return -1
    }
    let file gen.PFile = gs.p_files[decl.file_id]
    let path *char = (gs.task.np_data + file.path_off).to_type(*char)
    let target_key int = ir.ir_target_key(gs.c_target.triple)
    if (target_key < 0) { return -1 }
    let hash u64 = 14695981039346656037
    let tag *char = "yh-firc-1"
    if (checked_cache_mix_text(&hash, tag) != 0) { return -1 }
    checked_cache_mix_int(&hash, checked_check_cache_env.to_type(int))
    checked_cache_mix_int(&hash, target_key)
    checked_cache_mix_int(&hash, gs.c_target.pointer_bits)
    checked_cache_mix_int(&hash, gs.c_target.layout_version)
    if (checked_cache_mix_text(&hash, gs.c_target.abi) != 0) { return -1 }
    if (checked_cache_mix_text(&hash, path) != 0) { return -1 }
    checked_gen_layout(&hash)
    checked_gen_symbol_facts(&hash)
    if (checked_gen_decl_facts(&hash) != 0) { return -1 }
    if (checked_gen_mix_tokens(decl.file_id, decl.first, decl.after, &hash) != 0) {
        return -1
    }
    let digits *char = "0123456789abcdef"
    let shift int = 60
    let i int = 0
    for i < ir.IR_FUNCTION_CACHE_KEY_HEX {
        out[i] = digits[((hash >> shift) & 15).to_type(int)].to_type(u8)
        shift -= 4
        i += 1
    }
    out[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
    return 0
}
