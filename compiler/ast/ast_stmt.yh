module ast
import errors

// ============================================================================
// ast_stmt.yh —— check worker 的语句树与表达式根关联
//
// 语句节点在进入旧解析器前建立，解析完后补齐 token 终点；父节点通过
// 首子/末子/兄弟索引关联，表达式通过独立链表关联。这样语法结构与旧
// 语义钩子并行记录，后续迁移可逐类替换消费方，而不依赖汇编发射结果。
// ============================================================================

let ast_stmt_nodes *AstStmt = 0
let ast_stmt_count int = 0
let ast_stmt_cap int = 0
let ast_stmt_exprs *AstStmtExpr = 0
let ast_stmt_expr_count int = 0
let ast_stmt_expr_cap int = 0
let ast_bindings *AstBinding = 0
let ast_binding_count int = 0
let ast_binding_cap int = 0
let ast_comptime_fors *AstComptimeFor = 0
let ast_comptime_for_count int = 0
let ast_comptime_for_cap int = 0
let ast_binding_local_next int = 0
let ast_stmt_current int = -1
let ast_stmt_root_first int = -1
let ast_stmt_root_last int = -1

// ast_comptime_for_find_stmt：按语句 wrapper 查找区间模板，缺失返回 -1。
fn ast_comptime_for_find_stmt(stmt_id int) int {
    let i int = 0
    for i < ast_comptime_for_count {
        if (ast_comptime_fors[i].stmt_id == stmt_id) { return i }
        i += 1
    }
    return -1
}

// ast_stmt_grow_nodes：扩容语句节点连续表并保留现有节点索引。
fn ast_stmt_grow_nodes() int {
    let ncap int = ast_stmt_cap * 2
    if (ncap == 0) { ncap = 64 }
    let next *AstStmt = malloc((ncap * sizeof(AstStmt)).to_type(u64)).to_type(*AstStmt)
    if (next == 0) {
        return errors.fail("语句 AST 内存分配失败")
    }
    if (ast_stmt_count > 0) {
        memcpy(next, ast_stmt_nodes, (ast_stmt_count * sizeof(AstStmt)).to_type(u64))
    }
    if (ast_stmt_nodes != 0) {
        free(ast_stmt_nodes.to_type(*void))
    }
    ast_stmt_nodes = next
    ast_stmt_cap = ncap
    return 0
}

// ast_stmt_grow_exprs：扩容语句到表达式的边表并保留边编号。
fn ast_stmt_grow_exprs() int {
    let ncap int = ast_stmt_expr_cap * 2
    if (ncap == 0) { ncap = 64 }
    let next *AstStmtExpr = malloc((ncap * sizeof(AstStmtExpr)).to_type(u64)).to_type(*AstStmtExpr)
    if (next == 0) {
        return errors.fail("语句表达式边内存分配失败")
    }
    if (ast_stmt_expr_count > 0) {
        memcpy(next, ast_stmt_exprs,
            (ast_stmt_expr_count * sizeof(AstStmtExpr)).to_type(u64))
    }
    if (ast_stmt_exprs != 0) {
        free(ast_stmt_exprs.to_type(*void))
    }
    ast_stmt_exprs = next
    ast_stmt_expr_cap = ncap
    return 0
}

