module ast
import proj

// g_store：当前任务的声明索引游标（零初始化）。
let g_store AstStore

// ============================================================================
// ast_decl.yh —— 从已建顶层声明索引发布文件级声明 AST
//
// PDecl 已提供单文件内稳定的 token 范围。此处把它提升为项目 worker 的
// 只读 AST 节点，并在函数体解析后补上 body_stmt；不再次扫描源码 token。
// ============================================================================

let ast_decl_nodes *AstDecl = 0
let ast_decl_count int = 0
let ast_decl_cap int = 0
let ast_decl_file_first *int = 0
let ast_decl_file_cap int = 0

// ast_decl_test_active：该文件是否属于 yh test 的目标项目。
// 依赖/标准库里的 test 声明不登记函数符号，绑定阶段必须跳过它们。
fn ast_decl_test_active(fi int) int {
    // 选择条件由 proj.test_file_selected 统一判定：前端不感知 --filter。
    return proj.test_file_selected(fi)
}

