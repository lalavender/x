module ast;
import gen;
import ir;

// ast_ir_cache.yh —— 目标隔离的函数 SSA 缓存键、读取与写入。

// ast_ir_hash_byte：按 FNV-1a 更新函数缓存键的一个字节。
fn ast_ir_hash_byte(hash *u64, value u8) void {
    hash[0] = hash[0] ^ value.to_type(u64);
    hash[0] = hash[0] * 1099511628211;
}

// ast_ir_hash_init：返回 FNV-1a 64 位初始值。
fn ast_ir_hash_init() u64 {
    let hi u64 = 3421674724;
    let lo u64 = 2216829733;
    return (hi << 32) | lo;
}

// ast_ir_hash_int：按固定小端八字节把整数混入函数缓存键。
fn ast_ir_hash_int(hash *u64, value i64) void {
    let raw u64 = value.to_type(u64);
    let i int = 0;
    for i < 8 {
        ast_ir_hash_byte(hash, ((raw >> (i * 8)) & 255).to_type(u8));
        i += 1;
    }
}

// ast_ir_hash_expr：混入单个函数表达式节点的 lowering 相关语义事实。
fn ast_ir_hash_expr(hash *u64, ctx *AstFunctionContext, expr_id int) void {
    let gs *gen.GenState = gen.G();
    if (expr_id < ctx.expr_first || expr_id >= ctx.expr_after) { return; }
    let expr AstExpr = ast_expr_nodes[expr_id];
    ast_ir_hash_int(hash, expr.kind.to_type(i64));
    ast_ir_hash_int(hash, expr.op.to_type(i64));
    ast_ir_hash_int(hash, ast_ir_type(expr.type_id).to_type(i64));
    ast_ir_hash_int(hash, expr.const_bits);
    if (expr.sym_kind == gen.SYM_FN && expr.sym_name_off >= 0
        && expr.sym_name_len > 0 && expr.sym_name_off + expr.sym_name_len <= gs.np_len) {
        ast_ir_hash_int(hash, expr.sym_flags.to_type(i64));
        ast_ir_hash_int(hash, expr.sym_name_len.to_type(i64));
        let ni int = 0;
        for ni < expr.sym_name_len {
            ast_ir_hash_byte(hash, gs.np_data[expr.sym_name_off + ni]);
            ni += 1;
        }
        if (expr.sym_type_id >= 0 && expr.sym_type_id < gs.t_type_n
            && gs.t_types[expr.sym_type_id].kind == gen.TY_FN) {
            let sig int = gs.t_types[expr.sym_type_id].sub;
            if (sig >= 0 && sig < gs.t_sig_n) {
                ast_ir_hash_int(hash, gs.t_sig_abi[sig].to_type(i64));
                ast_ir_hash_int(hash, gs.t_sig_ret[sig].to_type(i64));
                ast_ir_hash_int(hash, gs.t_sig_np[sig].to_type(i64));
                ast_ir_hash_int(hash, gs.t_sig_vararg[sig].to_type(i64));
                let ai int = 0;
                for ai < gs.t_sig_np[sig] {
                    let tid int = gs.t_sig_params[gs.t_sig_first[sig] + ai];
                    ast_ir_hash_int(hash, ast_ir_type(tid).to_type(i64));
                    if (tid >= 0 && tid < gs.t_type_n) {
                        ast_ir_hash_int(hash, gs.t_types[tid].size.to_type(i64));
                        ast_ir_hash_int(hash, gs.t_types[tid].align.to_type(i64));
                    }
                    ai += 1;
                }
            }
        }
    }
    if (expr.binding_row >= ctx.binding_first
        && expr.binding_row < ctx.binding_after) {
        let binding AstBinding = ast_bindings[expr.binding_row];
        ast_ir_hash_int(hash, binding.id.to_type(i64));
        ast_ir_hash_int(hash, binding.is_param.to_type(i64));
        ast_ir_hash_int(hash, binding.sym_kind.to_type(i64));
        ast_ir_hash_int(hash, ast_ir_type(binding.sym_type_id).to_type(i64));
    }
    if (expr.type_id >= 0 && expr.type_id < gs.t_type_n) {
        let typ gen.CType = gs.t_types[expr.type_id];
        ast_ir_hash_int(hash, typ.kind.to_type(i64));
        ast_ir_hash_int(hash, typ.size.to_type(i64));
        ast_ir_hash_int(hash, typ.align.to_type(i64));
    }
}

// ast_ir_hash_inline_dependencies：把本模块私有 inline 目标的完整声明源码
// 纳入调用方缓存键；接口函数没有函数体时仍按普通调用处理。
fn ast_ir_hash_inline_dependencies(hash *u64, ctx *AstFunctionContext) void {
    let gs *gen.GenState = gen.G();
    let expr_id int = ctx.expr_first;
    for expr_id < ctx.expr_after {
        let expr AstExpr = ast_expr_nodes[expr_id];
        if (expr.kind == AST_EXPR_CALL && expr.child0 >= ctx.expr_first
            && expr.child0 < ctx.expr_after) {
            let base AstExpr = ast_expr_nodes[expr.child0];
            if (base.sym_kind == gen.SYM_FN
                && (base.sym_flags & gen.F_INLINE) != 0
                && (base.sym_flags & gen.F_PUB) == 0) {
                let fi int = 0;
                for fi < ast_function_count {
                    let target AstFunctionContext = ast_function_nodes[fi];
                    if (target.decl_row >= 0 && target.decl_row < ast_decl_count
                        && ast_decl_nodes[target.decl_row].sym_id == base.sym_id) {
                        let decl AstDecl = ast_decl_nodes[target.decl_row];
                        if (target.file_id >= 0 && target.file_id < gs.p_file_n
                            && gs.p_files[target.file_id].source != 0
                            && gs.p_files[target.file_id].tokens != 0
                            && decl.first >= 0 && decl.after > decl.first
                            && decl.after <= gs.p_files[target.file_id].token_n) {
                            let file gen.PFile = gs.p_files[target.file_id];
                            let first gen.Tok = file.tokens[decl.first];
                            let last gen.Tok = file.tokens[decl.after - 1];
                            let start int = first.start;
                            let end int = last.start + last.len;
                            ast_ir_hash_byte(hash, 'I');
                            ast_ir_hash_int(hash, (end - start).to_type(i64));
                            let byte int = start;
                            for byte < end {
                                ast_ir_hash_byte(hash, file.source[byte]);
                                byte += 1;
                            }
                        }
                        break;
                    }
                    fi += 1;
                }
            }
        }
        expr_id += 1;
    }
}

// ast_ir_cache_key：混入编译器、目标、函数源码与受检类型事实。
fn ast_ir_cache_key(ctx *AstFunctionContext, decl *AstDecl, sig int,
    ret_type int, compiler_salt u64) u64 {
    let gs *gen.GenState = gen.G();
    let hash u64 = ast_ir_hash_init();
    let version *char = "yh-ssa-function-cache-v13";
    let vi int = 0;
    for version[vi] != 0 {
        ast_ir_hash_byte(&hash, version[vi].to_type(u8));
        vi += 1;
    }
    ast_ir_hash_int(&hash, compiler_salt.to_type(i64));
    ast_ir_hash_int(&hash, (gs.c_dialect + 1).to_type(i64));
    ast_ir_hash_int(&hash, gs.c_legacy_system.to_type(i64));
    ast_ir_hash_int(&hash, gs.c_module_mode.to_type(i64));
    ast_ir_hash_int(&hash, gs.c_is_entry_mod.to_type(i64));
    ast_ir_hash_int(&hash, gs.c_sym_sfx_len.to_type(i64));
    let sfx_i int = 0;
    for sfx_i < gs.c_sym_sfx_len {
        ast_ir_hash_byte(&hash, gs.np_data[gs.c_sym_sfx_off + sfx_i]);
        sfx_i += 1;
    }
    ast_ir_hash_int(&hash, ret_type.to_type(i64));
    ast_ir_hash_int(&hash, gs.t_sig_abi[sig].to_type(i64));
    ast_ir_hash_int(&hash, gs.t_sig_np[sig].to_type(i64));
    ast_ir_hash_int(&hash, gs.t_sig_vararg[sig].to_type(i64));
    let pi int = 0;
    for pi < gs.t_sig_np[sig] {
        let param_type int = gs.t_sig_params[gs.t_sig_first[sig] + pi];
        ast_ir_hash_int(&hash, ast_ir_type(param_type).to_type(i64));
        if (param_type >= 0 && param_type < gs.t_type_n) {
            let typ gen.CType = gs.t_types[param_type];
            ast_ir_hash_int(&hash, typ.kind.to_type(i64));
            ast_ir_hash_int(&hash, typ.size.to_type(i64));
            ast_ir_hash_int(&hash, typ.align.to_type(i64));
        }
        pi += 1;
    }
    if (decl.file_id < 0 || decl.file_id >= gs.p_file_n) { return 0; }
    let file gen.PFile = gs.p_files[decl.file_id];
    if (file.source == 0 || file.tokens == 0 || decl.first < 0
        || decl.after <= decl.first || decl.after > file.token_n) { return 0; }
    let path_i int = 0;
    for path_i < gs.p_files[decl.file_id].path_len {
        ast_ir_hash_byte(&hash,
            gs.np_data[gs.p_files[decl.file_id].path_off + path_i]);
        path_i += 1;
    }
    let first_tok gen.Tok = file.tokens[decl.first];
    let last_tok gen.Tok = file.tokens[decl.after - 1];
    let source_end int = last_tok.start + last_tok.len;
    if (first_tok.start < 0 || source_end < first_tok.start
        || source_end > file.source_len) { return 0; }
    let si int = first_tok.start;
    for si < source_end {
        ast_ir_hash_byte(&hash, file.source[si]);
        si += 1;
    }
    let expr_i int = ctx.expr_first;
    for expr_i < ctx.expr_after {
        ast_ir_hash_expr(&hash, ctx, expr_i);
        expr_i += 1;
    }
    ast_ir_hash_inline_dependencies(&hash, ctx);
    let binding_i int = ctx.binding_first;
    for binding_i < ctx.binding_after {
        let binding AstBinding = ast_bindings[binding_i];
        ast_ir_hash_int(&hash, binding.id.to_type(i64));
        ast_ir_hash_int(&hash, binding.is_param.to_type(i64));
        ast_ir_hash_int(&hash, binding.sym_kind.to_type(i64));
        ast_ir_hash_int(&hash, ast_ir_type(binding.sym_type_id).to_type(i64));
        if (binding.sym_type_id >= 0 && binding.sym_type_id < gs.t_type_n) {
            let typ gen.CType = gs.t_types[binding.sym_type_id];
            ast_ir_hash_int(&hash, typ.kind.to_type(i64));
            ast_ir_hash_int(&hash, typ.size.to_type(i64));
            ast_ir_hash_int(&hash, typ.align.to_type(i64));
        }
        binding_i += 1;
    }
    return hash;
}

// ast_ir_cache_hex：把缓存键转成固定 16 位小写十六进制文件名片段。
fn ast_ir_cache_hex(value u64, out *u8) void {
    let digits *char = "0123456789abcdef";
    let shift int = 60;
    let i int = 0;
    for shift >= 0 {
        out[i] = digits[((value >> shift) & 15).to_type(int)].to_type(u8);
        shift -= 4;
        i += 1;
    }
}

// ast_ir_cache_path：按内容键组装函数 IR 缓存路径。
fn ast_ir_cache_path(dir *char, key u64, out *u8) int {
    let n int = 0;
    n = gen.append_str(out, n, dir);
    n = gen.append_str(out, n, "/ssa-");
    ast_ir_cache_hex(key, out + n);
    n += 16;
    n = gen.append_str(out, n, ".ir");
    out[n] = 0;
    return n;
}

// ast_ir_cache_read：校验缓存包络与 IR verifier 后返回 1；未命中返回 0。
fn ast_ir_cache_read(path *char, key u64, out *ir.IRFunction) int {
    let gs *gen.GenState = gen.G();
    let fd int = open(path, 0);
    if (fd < 0) { return 0; }
    let cap int = 4096;
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (data == 0) { close(fd); return 0; }
    let length int = 0;
    let valid int = 1;
    for 1 {
        if (length == cap) {
            if (cap >= 67108880) { valid = 0; break; }
            let next_cap int = cap * 2;
            if (next_cap > 67108880) { next_cap = 67108880; }
            let next *u8 = malloc(next_cap.to_type(u64)).to_type(*u8);
            if (next == 0) { valid = 0; break; }
            memcpy(next, data, length.to_type(u64));
            free(data);
            data = next;
            cap = next_cap;
        }
        let got i64 = read(fd, data + length, (cap - length).to_type(u64));
        if (got < 0) { valid = 0; break; }
        if (got == 0) { break; }
        length += got.to_type(int);
    }
    close(fd);
    if (valid == 0 || length < 16) {
        free(data);
        return 0;
    }
    let saved_key u64 = 0;
    let saved_hash u64 = 0;
    let i int = 0;
    for i < 8 {
        saved_key = saved_key | (data[i].to_type(u64) << (i * 8));
        saved_hash = saved_hash | (data[8 + i].to_type(u64) << (i * 8));
        i += 1;
    }
    let actual_hash u64 = ast_ir_hash_init();
    i = 16;
    for i < length {
        ast_ir_hash_byte(&actual_hash, data[i]);
        i += 1;
    }
    out.abi = 0;
    out.target_id = -1;
    out.ret_type = -1;
    out.types = 0;
    out.type_count = 0;
    out.insts = 0;
    out.inst_count = 0;
    out.phis = 0;
    out.phi_count = 0;
    out.phi_inputs = 0;
    out.phi_input_count = 0;
    out.calls = 0;
    out.call_count = 0;
    out.call_args = 0;
    out.call_arg_count = 0;
    out.call_symbols = 0;
    out.call_symbol_size = 0;
    out.blocks = 0;
    out.block_count = 0;
    out.value_count = 0;
    let hit int = 0;
    if (saved_key == key && saved_hash == actual_hash
        && ir.ir_deserialize(out, data + 16, length - 16, gs.c_dialect + 1) == 0) {
        hit = 1;
    }
    free(data);
    return hit;
}

// ast_ir_cache_write：保存已验证的 SSA；缓存写入失败不改变本次构建结果。
fn ast_ir_cache_write(path *char, key u64, f *ir.IRFunction) void {
    let size int = ir.ir_serialized_size(f);
    if (size < 0 || size > 67108864 - 16) { return; }
    let data *u8 = malloc((size + 16).to_type(u64)).to_type(*u8);
    if (data == 0) { return; }
    let i int = 0;
    for i < 8 {
        data[i] = ((key >> (i * 8)) & 255).to_type(u8);
        i += 1;
    }
    if (ir.ir_serialize(f, data + 16, size) != size) {
        free(data);
        return;
    }
    let hash u64 = ast_ir_hash_init();
    i = 16;
    for i < size + 16 {
        ast_ir_hash_byte(&hash, data[i]);
        i += 1;
    }
    i = 0;
    for i < 8 {
        data[8 + i] = ((hash >> (i * 8)) & 255).to_type(u8);
        i += 1;
    }
    let flags int = 0x241;
    if (gen.tg_host_darwin() != 0) { flags = 0x601; }
    let fd int = open(path, flags, 0x1a4);
    if (fd >= 0) {
        let write_result int = gen.write_all(fd, data, size + 16);
        let close_result int = close(fd);
        if (write_result != 0 || close_result != 0) {
            unlink(path);
        }
    }
    free(data);
}
