module ast
import token
import support
import comptime

// AstFunctionContext：已检查函数的只读 arena 切片，也是后续函数级任务的稳定输入。
pub struct AstFunctionContext {
    file_id int              // SourceStore 文件编号
    owner_decl int           // 文件内 PDecl 编号
    decl_row int             // AstDecl 行号
    token_first int          // 函数声明在文件 token 表中的起点
    token_after int          // 函数声明 token 半开区间终点
    expr_first int           // 本函数表达式 arena 起点
    expr_after int           // 本函数表达式 arena 半开区间终点
    stmt_first int           // 本函数语句 arena 起点
    stmt_after int           // 本函数语句 arena 半开区间终点
    edge_first int           // 本函数语句表达式边起点
    edge_after int           // 本函数语句表达式边半开区间终点
    binding_first int        // 本函数参数和局部绑定起点
    binding_after int        // 本函数绑定 arena 半开区间终点
    body_stmt int            // 函数体根语句节点
    asm_first int            // 旧发射器为该函数写入 .text 的起点
    asm_after int             // 旧发射器为该函数写入 .text 的终点
}

let ast_function_nodes *AstFunctionContext = 0
let ast_function_count int = 0
let ast_function_cap int = 0

let ast_function_active int = 0
let ast_function_file int = -1
let ast_function_owner int = -1
let ast_function_expr_first int = 0
let ast_function_stmt_first int = 0
let ast_function_edge_first int = 0
let ast_function_binding_first int = 0
let ast_function_asm_first int = 0

// ast_function_reset：释放当前模块收集的函数上下文并清除未完成捕获状态。
pub fn ast_function_reset() void {
    if (ast_function_nodes != 0) {
        free(ast_function_nodes.to_type(*void))
    }
    ast_function_nodes = 0
    ast_function_count = 0
    ast_function_cap = 0
    ast_function_active = 0
    ast_function_file = -1
    ast_function_owner = -1
    ast_function_expr_first = 0
    ast_function_stmt_first = 0
    ast_function_edge_first = 0
    ast_function_binding_first = 0
    ast_function_asm_first = 0
    support.session().stats_ast_functions = 0
}

// ast_function_find_decl：查找文件声明身份对应的 AST 行；缺失时返回 -1。
fn ast_function_find_decl(file_id int, owner_decl int) int {
    if (file_id < 0 || file_id >= ast_decl_file_cap || owner_decl < 0
        || ast_decl_file_first == 0 || ast_decl_file_first[file_id] < 0) {
        return -1
    }
    let row int = ast_decl_file_first[file_id] + owner_decl
    if (row < 0 || row >= ast_decl_count
        || ast_decl_nodes[row].file_id != file_id
        || ast_decl_nodes[row].decl_index != owner_decl) {
        return -1
    }
    return row
}

// ast_function_begin：在函数语义遍历前记录各 arena 的私有起点。
pub fn ast_function_begin(file_id int, owner_decl int) int {
    if (support.session().ast_capture == 0) { return 0 }
    if (ast_function_active != 0 || file_id != support.session().active_file
        || owner_decl != store().file_decl_i) {
        return support.fail("内部错误：函数 AST 上下文嵌套或归属错误")
    }
    let decl_row int = ast_function_find_decl(file_id, owner_decl)
    if (decl_row < 0 && support.fc().c_ct_prepare_active != 0
        && store().file_indexed == 0) {
        // 单文件编译没有项目级 AstDecl；编译期准备过程用合成文件/声明身份。
    } else if (decl_row < 0
        || (ast_decl_nodes[decl_row].kind != token.TK_FN
            && ast_decl_nodes[decl_row].kind != token.TK_TEST)
        || ast_decl_nodes[decl_row].body_stmt >= 0) {
        return support.fail("内部错误：函数 AST 上下文没有待解析的函数声明")
    }
    ast_function_active = 1
    ast_function_file = file_id
    ast_function_owner = owner_decl
    ast_function_expr_first = ast_expr_count
    ast_function_stmt_first = ast_stmt_count
    ast_function_edge_first = ast_stmt_expr_count
    ast_function_binding_first = ast_binding_count
    ast_function_asm_first = 0
    return 0
}

// ast_function_end：在函数通过语义遍历后封存只读 arena 范围。
pub fn ast_function_end() int {
    if (support.session().ast_capture == 0) { return 0 }
    if (ast_function_active == 0 || ast_function_file != support.session().active_file
        || ast_function_owner != store().file_decl_i) {
        return support.fail("内部错误：函数 AST 上下文结束位置错误")
    }
    let decl_row int = ast_function_find_decl(ast_function_file, ast_function_owner)
    let synthetic int = (decl_row < 0 && support.fc().c_ct_prepare_active != 0
        && store().file_indexed == 0).to_type(int)
    if (synthetic == 0 && (decl_row < 0
        || ast_decl_nodes[decl_row].body_stmt < ast_function_stmt_first
        || ast_decl_nodes[decl_row].body_stmt >= ast_stmt_count)) {
        return support.fail("内部错误：函数 AST 上下文缺少函数体根")
    }
    if (synthetic != 0 && (ast_function_stmt_first >= ast_stmt_count
        || ast_stmt_nodes[ast_function_stmt_first].kind != AST_STMT_BLOCK)) {
        return support.fail("内部错误：单文件编译期 AST 缺少函数体根")
    }
    if (ast_function_count == ast_function_cap) {
        let ncap int = ast_function_cap * 2
        if (ncap == 0) { ncap = 32 }
        let next *AstFunctionContext = malloc(
            (ncap * sizeof(AstFunctionContext)).to_type(u64)).to_type(*AstFunctionContext)
        if (next == 0) { return support.fail("函数 AST 上下文分配失败") }
        if (ast_function_count > 0) {
            memcpy(next, ast_function_nodes,
                (ast_function_count * sizeof(AstFunctionContext)).to_type(u64))
        }
        if (ast_function_nodes != 0) {
            free(ast_function_nodes.to_type(*void))
        }
        ast_function_nodes = next
        ast_function_cap = ncap
    }
    let row int = ast_function_count
    ast_function_nodes[row].file_id = ast_function_file
    ast_function_nodes[row].owner_decl = ast_function_owner
    ast_function_nodes[row].decl_row = decl_row
    ast_function_nodes[row].token_first = synthetic != 0 ?
        support.fc().c_ct_prepare_first : ast_decl_nodes[decl_row].first
    ast_function_nodes[row].token_after = synthetic != 0 ?
        token.ctx().pos : ast_decl_nodes[decl_row].after
    ast_function_nodes[row].expr_first = ast_function_expr_first
    ast_function_nodes[row].expr_after = ast_expr_count
    ast_function_nodes[row].stmt_first = ast_function_stmt_first
    ast_function_nodes[row].stmt_after = ast_stmt_count
    ast_function_nodes[row].edge_first = ast_function_edge_first
    ast_function_nodes[row].edge_after = ast_stmt_expr_count
    ast_function_nodes[row].binding_first = ast_function_binding_first
    ast_function_nodes[row].binding_after = ast_binding_count
    ast_function_nodes[row].body_stmt = synthetic != 0 ?
        ast_function_stmt_first : ast_decl_nodes[decl_row].body_stmt
    ast_function_nodes[row].asm_first = ast_function_asm_first
    ast_function_nodes[row].asm_after = 0
    ast_function_count += 1
    support.session().stats_ast_functions += 1
    ast_function_active = 0
    ast_function_file = -1
    ast_function_owner = -1
    return 0
}

// ast_function_ct_export：把刚封存的编译期函数 AST 切片导入 comptime 私有 arena。
pub fn ast_function_ct_export(sym_id int) int {
    if (ast_function_count <= 0) {
        return support.fail("内部错误：编译期函数 AST 上下文缺失")
    }
    if (sizeof(AstExpr) != sizeof(comptime.CtExpr)
        || sizeof(AstStmt) != sizeof(comptime.CtStmt)
        || sizeof(AstStmtExpr) != sizeof(comptime.CtEdge)
        || sizeof(AstBinding) != sizeof(comptime.CtBinding)) {
        return support.fail("内部错误：编译期 IR 与前端 AST 布局不一致")
    }
    let ctx AstFunctionContext = ast_function_nodes[ast_function_count - 1]
    return comptime.ct_ir_import(sym_id,
        ast_expr_nodes.to_type(*comptime.CtExpr), ctx.expr_first,
        ctx.expr_after - ctx.expr_first,
        ast_stmt_nodes.to_type(*comptime.CtStmt), ctx.stmt_first,
        ctx.stmt_after - ctx.stmt_first,
        ast_stmt_exprs.to_type(*comptime.CtEdge), ctx.edge_first,
        ctx.edge_after - ctx.edge_first,
        ast_bindings.to_type(*comptime.CtBinding), ctx.binding_first,
        ctx.binding_after - ctx.binding_first, ctx.body_stmt)
}
