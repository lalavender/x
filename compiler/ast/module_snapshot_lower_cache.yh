module ast
import gen
import ir

// ============================================================================
// module_snapshot_lower_cache.yh —— 函数级缓存键（LA3）
//
// 键只由可跨进程复现的事实组成：
//   * 编译器/格式 schema 标签；
//   * 模块环境键（依赖接口、目标、O 级别、编译器身份，由 cmd 计算）；
//   * 目标 key/指针位宽/布局版本/ABI；
//   * 函数声明的 token 流（词法器不保留注释/空白，天然忽略注释变化）。
//
// 不把其他函数体或整模块源码混入每个函数键；函数体改动只改自己的 token 流。
// token 下标、字符串标签等瞬时 arena ID 不进入键。
// ============================================================================

// checked_cache_mix_byte：FNV-1a 64 混入一个字节。
fn checked_cache_mix_byte(hash *u64, byte u8) void {
    hash[0] = hash[0] ^ byte.to_type(u64)
    hash[0] = hash[0] * 1099511628211
}

// checked_cache_mix_int：把 int 的补码位型按小端八字节混入。
fn checked_cache_mix_int(hash *u64, value int) void {
    let bits u64 = value.to_type(i64).to_type(u64)
    let i int = 0
    for i < 8 {
        checked_cache_mix_byte(hash, ((bits >> (i * 8)) & 255).to_type(u8))
        i += 1
    }
}

// checked_cache_mix_text：混入已终止字符串（不含结尾零）。
fn checked_cache_mix_text(hash *u64, text *char) int {
    if (text == 0) { return -1 }
    let i int = 0
    for text[i] != 0 {
        checked_cache_mix_byte(hash, text[i].to_type(u8))
        i += 1
    }
    return 0
}


// checked_cache_mix_tokens：把一段 token 范围（种类+源字节）混入哈希。
// 词法器不保留注释/空白，因此注释、空行与缩进变化不会改变函数键。
fn checked_cache_mix_tokens(l *CheckedLower, file_id int, first int, after int,
    hash *u64) int {
    if (file_id < 0 || file_id >= l.store.file_n || first < 0 || after <= first) {
        return -1
    }
    let file gen.PFile = l.store.files[file_id]
    if (file.source == 0 || file.tokens == 0 || after > file.token_n) { return -1 }
    let i int = first
    for i < after {
        let tok gen.Tok = file.tokens[i]
        if (tok.start < 0 || tok.len < 0 || tok.start + tok.len > file.source_len) {
            return -1
        }
        checked_cache_mix_int(hash, tok.kind)
        let j int = 0
        for j < tok.len {
            checked_cache_mix_byte(hash, file.source[tok.start + j])
            j += 1
        }
        i += 1
    }
    return 0
}

// checked_cache_layout：把布局/签名事实混入函数键。任何类型或 ABI 变化都会
// 保守地让全部函数失效；这比遗漏私有结构体布局依赖更安全。
fn checked_cache_layout(l *CheckedLower, hash *u64) void {
    checked_cache_mix_int(hash, l.store.type_n)
    let i int = 0
    for i < l.store.type_n {
        let ty gen.CType = l.store.types[i]
        checked_cache_mix_int(hash, ty.kind)
        checked_cache_mix_int(hash, ty.size)
        checked_cache_mix_int(hash, ty.align)
        checked_cache_mix_int(hash, ty.elem)
        checked_cache_mix_int(hash, ty.len)
        checked_cache_mix_int(hash, ty.sub)
        i += 1
    }
    checked_cache_mix_int(hash, l.store.field_n)
    i = 0
    for i < l.store.field_n {
        let field gen.SField = l.store.fields[i]
        checked_cache_mix_int(hash, field.name_len)
        checked_cache_mix_int(hash, field.type_id)
        checked_cache_mix_int(hash, field.offset)
        i += 1
    }
    checked_cache_mix_int(hash, l.store.sig_n)
    i = 0
    for i < l.store.sig_n {
        checked_cache_mix_int(hash, l.store.sig_abi[i])
        checked_cache_mix_int(hash, l.store.sig_ret[i])
        checked_cache_mix_int(hash, l.store.sig_np[i])
        checked_cache_mix_int(hash, l.store.sig_vararg[i])
        checked_cache_mix_int(hash, l.store.sig_first[i])
        i += 1
    }
    checked_cache_mix_int(hash, l.store.sig_param_n)
    i = 0
    for i < l.store.sig_param_n {
        checked_cache_mix_int(hash, l.store.sig_params[i])
        i += 1
    }
}

// checked_cache_module_facts：混入本模块非函数声明（全局/常量/类型）的 token 流。
// 运行期函数体不进入这里，因此单函数修改不会让其他函数失效；私有常量值变化
// 仍会让读取它的函数保守 miss。
fn checked_cache_module_facts(l *CheckedLower, hash *u64) int {
    let i int = 0
    for i < l.store.declaration_n {
        let decl AstDecl = l.store.declarations[i]
        if (decl.kind != gen.TK_FN) {
            if (checked_cache_mix_tokens(l, decl.file_id, decl.first, decl.after,
                    hash) != 0) { return -1 }
        }
        i += 1
    }
    return 0
}

// checked_cache_symbol_facts：把源码级 const 的常量值/标志混入函数键。
// 依赖 CT 变化会改变本模块 const 的 cval；匿名数据/函数符号不参与，避免
// pass2b 新增的静态数据标签让键在冷/热构建间漂移。
fn checked_cache_symbol_facts(store *CheckedStorage, hash *u64) void {
    let i int = 0
    for i < store.declaration_n {
        let decl AstDecl = store.declarations[i]
        if (decl.kind == gen.TK_CONST && decl.sym_id >= 0 && decl.sym_id < store.symbol_n) {
            let sym gen.CSym = store.symbols[decl.sym_id]
            checked_cache_mix_int(hash, sym.kind)
            checked_cache_mix_int(hash, sym.type_id)
            checked_cache_mix_int(hash, sym.flags)
            checked_cache_mix_int(hash, sym.cval.to_type(int))
            checked_cache_mix_int(hash, sym.const_ready)
            checked_cache_mix_int(hash, sym.const_expr_kind)
        }
        i += 1
    }
}

// checked_function_key：为快照中的一个函数生成 16 位十六进制缓存键。
// 成功写 out[0..16] 与结尾零并返回 0；token 范围无效返回 -1（该函数跳过缓存）。
fn checked_function_key(l *CheckedLower, function_index int, env_key u64,
    out *u8) int {
    if (l == 0 || out == 0 || function_index < 0
        || function_index >= l.store.function_n) { return -1 }
    let ctx CheckedFunction = l.store.functions[function_index]
    if (ctx.file_id < 0 || ctx.file_id >= l.store.file_n) { return -1 }
    let file gen.PFile = l.store.files[ctx.file_id]
    if (file.source == 0 || file.tokens == 0 || ctx.token_first < 0
        || ctx.token_after <= ctx.token_first || ctx.token_after > file.token_n) {
        return -1
    }
    let hash u64 = 14695981039346656037
    let tag *char = "yh-firc-1"
    if (checked_cache_mix_text(&hash, tag) != 0) { return -1 }
    checked_cache_mix_int(&hash, env_key.to_type(int))
    checked_cache_mix_int(&hash, l.cache_target_key)
    checked_cache_mix_int(&hash, l.cache_pointer_bits)
    checked_cache_mix_int(&hash, l.cache_layout_version)
    if (checked_cache_mix_text(&hash, l.cache_abi) != 0) { return -1 }
    // 源路径进入键：项目搬移后不复用旧路径的 locs。
    let path *char = (l.store.names + file.path_off).to_type(*char)
    if (checked_cache_mix_text(&hash, path) != 0) { return -1 }
    checked_cache_layout(l, &hash)
    checked_cache_symbol_facts(l.store, &hash)
    if (checked_cache_module_facts(l, &hash) != 0) { return -1 }
    if (checked_cache_mix_tokens(l, ctx.file_id, ctx.token_first,
            ctx.token_after, &hash) != 0) { return -1 }
    let digits *char = "0123456789abcdef"
    let shift int = 60
    let i int = 0
    for i < ir.IR_FUNCTION_CACHE_KEY_HEX {
        out[i] = digits[((hash >> shift) & 15).to_type(int)].to_type(u8)
        shift -= 4
        i += 1
    }
    out[ir.IR_FUNCTION_CACHE_KEY_HEX] = 0
    return 0
}
