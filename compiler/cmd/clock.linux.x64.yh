module main

// CmdTimespec：Linux x86_64 clock_gettime syscall 返回的 64 位秒与纳秒。
struct CmdTimespec {
    sec i64
    nsec i64
}

// cmd_clock_ns：通过 x86_64 syscall 228 读取 CLOCK_MONOTONIC 并换算成纳秒。
fn cmd_clock_ns() u64 {
    let stamp CmdTimespec
    let result i64 = linux_syscall6(228.to_type(u64), 1.to_type(u64),
        (&stamp).to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64))
    if (result != 0 || stamp.sec < 0 || stamp.nsec < 0
        || stamp.nsec >= 1000000000) {
        return 0
    }
    return stamp.sec.to_type(u64) * 1000000000.to_type(u64) +
        stamp.nsec.to_type(u64)
}
