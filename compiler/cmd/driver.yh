module main;
import gen;
import lex;
import parse;

// ============================================================================
// driver.yh —— 自举编译器：命令行入口
//
// 输出接口（docs/02-plan/yh-自举实施方案-v2.md §3）：
//     yh --syntax-check <file.yh>   纯语法检查：合法静默退出 0，
//                                   非法输出诊断并以非零码退出
//     yh --emit-asm <file.yh>       发射 AArch64 Linux 汇编到标准输出
//                                   （GNU 语法，经 as/gcc 生成可执行）
//     yh -o <out> <file.yh>         编译并链接为可执行文件（兼容 stage0
//                                   的命令行形态）。实现方式：把汇编写到
//                                   临时文件，调用外部 gcc 汇编/链接，成功后
//                                   删除临时文件。
//
// 退出码：0 成功；1 源文件语法/语义错误或读入失败；2 用法错误。
// 诊断一律写文件描述符 2；汇编只写缓冲、编译成功后一次性写目标，
// 错误不会留下看似成功的部分产物。
// ============================================================================

// drv_write_asm：把已发射的汇编写入 asm_path（O_WRONLY|O_CREAT|O_TRUNC，
// 权限 0644）。返回 0 成功。open 旗标按实际宿主内核取值，不随输出 --target 改变。
fn drv_write_asm(asm_path *char) int {
    let fl int = 0x241;
    if (gen.tg_host_darwin() != 0) {
        fl = 0x601;
    }
    let fd int = open(asm_path, fl, 0x1a4);
    if (fd < 0) {
        return gen.fail("无法创建临时汇编文件");
    }
    if (gen.flush_output_fd(fd) != 0) {
        close(fd);
        return -1;
    }
    if (close(fd) != 0) {
        return gen.fail("写临时汇编文件失败");
    }
    return 0;
}

// run_emit_asm_to：发射汇编到指定文件，再调用外部工具链链接为可执行。
// obj_path 为最终输出文件，asm_path 为临时汇编文件（调用后删除）。
// LLVM 后端（--backend llvm）走 llvm_emit_single_file：对象经内嵌桥产出，
// 再交给宿主 cc 链接；不产生旧汇编，也不做回退。
fn run_emit_asm_to(asm_path *char, obj_path *char) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_backend != 0) {
        let rc int = llvm_emit_single_file(gs.c_path, obj_path, 0,
            gs.c_emit_text_path, 1);
        if (rc == 0) { mb_print_stats(); }
        return rc;
    }
    if (lex.lex_all() != 0) {
        return 1;
    }
    gs.c_compile = 1;
    gen.ty_register_builtins();
    gen.scope_push();
    if (gen.sem_register_prelude() != 0) {
        return 1;
    }
    if (sem_compile() != 0) {
        return 1;
    }
    if (gs.c_errors > 0) {
        return 1;
    }
    if (drv_write_asm(asm_path) != 0) {
        return 1;
    }
    // 将每个参数单独传给宿主进程，路径中的空格和引号保持原样。
    let args [6]*char;
    if (gen.tg_darwin() != 0) {
        args[0] = "clang";
        args[1] = "-o";
        args[2] = obj_path;
        args[3] = asm_path;
        args[4] = 0.to_type(*char);
    } else {
        args[0] = "gcc";
        args[1] = "-no-pie";
        args[2] = "-o";
        args[3] = obj_path;
        args[4] = asm_path;
        args[5] = 0.to_type(*char);
    }
    let rc int = cmd_process_run(&args[0]);
    unlink(asm_path);
    if (rc != 0) {
        return gen.fail_path("链接失败: ", obj_path);
    }
    return 0;
}


// usage：输出用法说明（文件描述符 2）。逐行写入：单行最长约 80 字节，
// 远小于 256 缓冲；不可改回整段拼接——用法行会持续增加，总长曾超出
// 512 字节固定缓冲导致栈溢出。
fn usage() void {
    let buf [256]u8;
    let n int = 0;
    n = gen.append_str(buf, 0, "用法: yh --syntax-check <file.yh>\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh --emit-asm <file.yh>\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh -o <out> <file.yh>\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh build [-o out] [module] [--stats] 项目构建\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh check <file.yh>       检查单文件语义，不要求 main\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh check [module]         检查项目语义，不生成后端产物\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      --legacy-system          显式启用兼容 shell system(cmd) 接口\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      --target <triple>         选择完整输出目标（旧后端仅 AArch64）\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh run                       构建并运行 main 模块\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh version                   显示当前项目名与版本\n");
    gen.write_all(2, buf, n);
    n = gen.append_str(buf, 0, "      yh list [--resolve name]     列出模块/解释导入绑定\n");
    gen.write_all(2, buf, n);
}

// run_syntax_check：--syntax-check 路径（纯语法，G1 行为）。
fn run_syntax_check() int {
    let gs *gen.GenState = gen.G();
    if (lex.lex_all() != 0) {
        return 1;
    }
    if (parse.parse_source() != 0) {
        return 1;
    }
    if (gs.c_errors > 0) {
        return 1;
    }
    return 0;
}

// drv_is_yh_source：判断命令行参数是否以用户源文件后缀 .yh 结尾。
fn drv_is_yh_source(path *char) int {
    if (path == 0) { return 0; }
    let n int = 0;
    for path[n] != 0 { n += 1; }
    return n >= 3 && path[n - 3] == '.'
        && path[n - 2] == 'y' && path[n - 1] == 'h' ? 1 : 0;
}

// run_file_check：对单个源文件执行无后端语义检查。先装载源与语义表，再词法分析，
// 然后复用现有声明、全局初始化和函数体检查遍历；库文件不要求定义 main，
// 检查失败时保留原诊断，成功时只输出检查结果，不创建汇编或对象文件。
fn run_file_check(source_path *char) int {
    let gs *gen.GenState = gen.G();
    gs.c_check_only = 1;
    gs.c_path = source_path;
    if (gen.front_checked_begin() != 0) { return 1; }
    if (gen.read_source(source_path) != 0 || gen.sem_init_tables() != 0) {
        return 1;
    }
    if (lex.lex_all() != 0) {
        return 1;
    }
    gs.c_compile = 1;
    gen.ty_register_builtins();
    gen.scope_push();
    if (gen.sem_register_prelude() != 0 || sem_compile() != 0
        || gs.c_errors > 0) {
        return 1;
    }
    let output [32]u8;
    if (gen.front_checked_end() != 0) { return 1; }
    let n int = gen.append_str(output, 0, "检查通过\n");
    return gen.write_all(1, output, n) == 0 ? 0 : 1;
}

// run_emit_asm：--emit-asm 路径（两遍语义 + AArch64 发射）。
// LLVM 后端下改为把当前目标的汇编文本写到标准输出（经内嵌桥，kind=1）；
// --emit-llvm 时改为把 LLVM 文本写到标准输出（不调用桥、不产生对象）。
fn run_emit_asm() int {
    let gs *gen.GenState = gen.G();
    if (gs.c_backend != 0) {
        let rc int = 0;
        if (gs.c_emit_kind == 1) {
            rc = llvm_emit_single_file(gs.c_path, 0.to_type(*char), 0, "-", 0);
        } else {
            rc = llvm_emit_single_file(gs.c_path, "-", 1, 0, 0);
        }
        if (rc == 0) { mb_print_stats(); }
        return rc;
    }
    if (lex.lex_all() != 0) {
        return 1;
    }
    gs.c_compile = 1;
    gen.ty_register_builtins();
    // 全局作用域（第 0 层），随后登记 prelude 外部函数
    gen.scope_push();
    if (gen.sem_register_prelude() != 0) {
        return 1;
    }
    if (sem_compile() != 0) {
        return 1;
    }
    if (gs.c_errors > 0) {
        return 1;
    }
    if (gen.flush_output() != 0) {
        return 1;
    }
    return 0;
}

// main：解析命令行并驱动「读源 → 词法 → （语法 | 编译）」流水线。
// 形态：
//   yh --syntax-check <file.yh>      （argc==3）
//   yh --emit-asm <file.yh>          （argc==3）
// drv_scan_target：扫描完整 --target 或旧 -target 别名，以及 LLVM 后端的
// --backend/-O0/-O2/--emit-llvm 选项；未知目标或未知后端返回 -1，不静默回退。
// 旧别名明确表示 AArch64 Unix；其余参数保持原顺序，返回不含程序名的参数个数。
fn drv_scan_target(argc int, argv **char, out **char) int {
    let gs *gen.GenState = gen.G();
    let n int = 0;
    let i int = 1;
    for i < argc {
        if (gen.cstr_eq(argv[i], "-target") != 0 || gen.cstr_eq(argv[i], "--target") != 0) {
            if (i + 1 >= argc) { gen.fail("缺少目标 triple"); return -1; }
            let target *char = argv[i + 1];
            if (gen.cstr_eq(argv[i], "-target") != 0) {
                if (gen.cstr_eq(target, "darwin") != 0 || gen.cstr_eq(target, "macho") != 0
                    || gen.cstr_eq(target, "macos") != 0) { target = "aarch64-apple-darwin"; }
                else if (gen.cstr_eq(target, "gnu") != 0 || gen.cstr_eq(target, "linux") != 0
                    || gen.cstr_eq(target, "elf") != 0) { target = "aarch64-unknown-linux-gnu"; }
            }
            if (gen.target_select(target) != 0) { gen.fail("不支持的目标 triple"); return -1; }
            i += 2;
        } else if (gen.cstr_eq(argv[i], "--backend") != 0) {
            if (i + 1 >= argc) { gen.fail("缺少后端名（legacy|llvm）"); return -1; }
            if (gen.cstr_eq(argv[i + 1], "legacy") != 0) { gs.c_backend = 0; }
            else if (gen.cstr_eq(argv[i + 1], "llvm") != 0) { gs.c_backend = 1; }
            else { gen.fail("不支持的后端（只接受 legacy 或 llvm）"); return -1; }
            i += 2;
        } else if (gen.cstr_eq(argv[i], "-O0") != 0) {
            gs.c_opt_level = 0;
            i += 1;
        } else if (gen.cstr_eq(argv[i], "-O2") != 0) {
            gs.c_opt_level = 2;
            i += 1;
        } else if (gen.cstr_eq(argv[i], "--emit-llvm") != 0) {
            // 只写 LLVM 文本（每模块一个 .ll），供审阅/差分；不产生目标文件。
            gs.c_emit_kind = 1;
            i += 1;
        } else if (gen.cstr_eq(argv[i], "--stats") != 0) {
            gs.c_stats_enabled = 1;
            i += 1;
        } else if (gen.cstr_eq(argv[i], "--legacy-system") != 0) {
            gs.c_legacy_system = 1;
            i += 1;
        } else {
            out[n] = argv[i];
            n += 1;
            i += 1;
        }
    }
    return n;
}

// main：解析命令行并驱动「读源 → 词法 → （语法 | 编译）」流水线。
// 形态（-target <dialect> 可出现在任意位置，默认 gnu）：
//   yh --syntax-check <file.yh>
//   yh --emit-asm <file.yh>
//   yh [-target darwin] -o <out> <file.yh>
pub fn main(argc int, argv **char, envp **char) int {
    let gs *gen.GenState = gen.G();
    // 编译会话入口：恢复 GenState 非零初始值（原 pub let 初始化器迁移）
    gen.state_init();
    // 自身路径（项目构建的子进程再入用）
    c_argv0 = argv[0];
    // 直接读取操作系统传入的环境向量，避免调用 printenv 等宿主工具。
    pj_envp = envp;
    // 先摘除 -target，得到规整后的参数序列（av[0..n-1]）。用固定容量栈数组：
    // 命令行参数个数有上限（64 足够）。
    let av [64]*char;
    let n int = drv_scan_target(argc, argv, av);
    if (n < 0) { return 2; }
    let mode int = 0;
    let needs_o int = 0;
    // 缺省身份已由 state_init 从编译器构建目标取得，不能用物理宿主 uname 或文件系统改写。
    // —— 项目命令（MOD-U2..U5，在单文件分派之前） ——
    if (n >= 1 && gen.cstr_eq(av[0], "build") != 0) {
        if (gen.target_legacy_ready() != 0) { return 1; }
        return mb_cmd_build(av, n);
    }
    if (n >= 1 && gen.cstr_eq(av[0], "check") != 0) {
        if (n == 2 && drv_is_yh_source(av[1]) != 0) {
            return run_file_check(av[1]);
        }
        gs.c_check_only = 1;
        return mb_cmd_build(av, n);
    }
    if (n >= 1 && gen.cstr_eq(av[0], "run") != 0) {
        if (gen.target_legacy_ready() != 0) { return 1; }
        return mb_cmd_run();
    }
    if (n >= 1 && gen.cstr_eq(av[0], "version") != 0) {
        return mb_print_version(0);
    }
    if (n >= 1 && gen.cstr_eq(av[0], "list") != 0) {
        return mb_cmd_list(av, n);
    }
    if ((n >= 6 && n <= 12) && gen.cstr_eq(av[0], "--emit-module") != 0
        && gen.cstr_eq(av[4], "-o") != 0) {
        // 内部子命令：--emit-module <mod> <提供方根> <主根> -o <out.s>
        let cache_salt u64 = 0;
        let fi int = 6;
        for fi < n {
            if (gen.cstr_eq(av[fi], "--stats") != 0) {
                gs.c_stats_enabled = 1;
            } else if (gen.cstr_eq(av[fi], "--check-only") != 0) {
                gs.c_check_only = 1;
            } else if (gen.cstr_eq(av[fi], "--ir-key") != 0 && fi + 1 < n) {
                if (mb_parse_hex(av[fi + 1], &cache_salt) != 0) {
                    usage();
                    return 2;
                }
                fi += 1;
            } else if (gen.cstr_eq(av[fi], "--iface-suffix") != 0 && fi + 1 < n) {
                mb_iface_suffix = av[fi + 1];
                fi += 1;
            } else {
                usage();
                return 2;
            }
            fi += 1;
        }
        let mlen int = 0;
        if (gs.c_check_only == 0 && gen.target_legacy_ready() != 0) { return 1; }
        let rlen int = 0;
        let blen int = 0;
        let mo int = mb_intern_arg(av[1], &mlen);
        let ro int = mb_intern_arg(av[2], &rlen);
        let bo int = mb_intern_arg(av[3], &blen);
        if (mo < 0 || ro < 0 || bo < 0) {
            return 1;
        }
        return mb_emit_module(mo, mlen, ro, rlen, bo, blen, av[5], cache_salt);
    }
    let src_idx int = 1;
    let out_idx int = 1;
    // -o 两种形态（后者与 stage0 的 `yh <file> -o <out>` 接口一致，
    // tests/yh-run/check.py 按该顺序调用）：
    //   av = ["-o", <out>, <src>]  或  av = [<src>, "-o", <out>]，共 3 个
    if (n == 3 && gen.cstr_eq(av[0], "-o") != 0) {
        mode = 3;
        needs_o = 1;
        src_idx = 2;
        out_idx = 1;
    }
    if (needs_o == 0 && n == 3 && gen.cstr_eq(av[1], "-o") != 0) {
        mode = 3;
        needs_o = 1;
        src_idx = 0;
        out_idx = 2;
    }
    if (needs_o == 0) {
        if (n != 2) {
            usage();
            if (n == 0) {
                // 裸 yh：顺带显示当前项目版本（不在项目内则静默）
                mb_print_version(1);
            }
            return 2;
        }
        if (gen.cstr_eq(av[0], "--syntax-check") != 0) {
            mode = 1;
        }
        if (gen.cstr_eq(av[0], "--emit-asm") != 0) {
            mode = 2;
        }
        if (mode == 0) {
            usage();
            return 2;
        }
    }
    if (mode != 1 && gen.target_legacy_ready() != 0) { return 1; }
    gs.c_path = av[src_idx];
    if (gen.read_source(gs.c_path) != 0) {
        return 1;
    }
    // 各模式都会用到堆分配的全局表（作用域栈等）
    if (gen.sem_init_tables() != 0) {
        return 1;
    }
    if (mode == 1) {
        return run_syntax_check();
    }
    if (mode == 3) {
        // 临时汇编文件：<out>.yh-tmp.s（与输出同目录，避免跨文件系统）
        let abuf *u8 = malloc(512.to_type(u64)).to_type(*u8);
        if (abuf == 0) {
            return gen.fail("内存分配失败");
        }
        let an int = 0;
        an = gen.append_str(abuf, an, av[out_idx]);
        an = gen.append_str(abuf, an, ".yh-tmp.s");
        return run_emit_asm_to(abuf.to_type(*char), av[out_idx]);
    }
    return run_emit_asm();
}
