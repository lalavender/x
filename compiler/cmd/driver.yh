module main
import gen
import build
import proj

// ============================================================================
// driver.yh —— 命令行入口：只做 argv → 请求的映射
//
// 输出接口（docs/02-plan/yh-自举实施方案-v2.md §3）：
//     yh --syntax-check <file.yh>   纯语法检查：合法静默退出 0，
//                                   非法输出诊断并以非零码退出
//     yh --emit-asm <file.yh>       发射当前目标汇编到标准输出
//                                   （经 LLVM 后端；GNU 语法，按目标汇编器处理）
//     yh -o <out> <file.yh>         编译并链接为可执行文件
//
// 执行一律委托 api.yh（A3）：本文件不直接调用前端、后端或构建实现。
// 退出码：0 成功；1 源文件语法/语义错误或读入失败；2 用法错误。
// ============================================================================

// usage：输出用法说明（文件描述符 2）。逐行写入：单行最长约 80 字节，
// 远小于 256 缓冲；不可改回整段拼接——用法行会持续增加，总长曾超出
// 512 字节固定缓冲导致栈溢出。
fn usage() void {
    let buf [256]u8
    let n int = 0
    n = gen.append_str(buf, 0, "用法: yh --syntax-check <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh --emit-asm <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh -o <out> <file.yh>\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh build [-o out] [module] [--link 组名]... [--stats] 项目构建\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh check <file.yh>       检查单文件语义，不要求 main\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh check [module]         检查项目语义，不生成后端产物\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      --legacy-system          显式启用兼容 shell system(cmd) 接口\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      --target <triple>         选择完整输出目标（LLVM）\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh run [--link 组名]...      构建并运行 main 模块\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh version                   显示当前项目名与版本\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh version --contracts       显示产物契约版本（key=value）\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh list [--resolve name]     列出模块/解释导入绑定\n")
    gen.write_all(2, buf, n)
    n = gen.append_str(buf, 0, "      yh test [模块|源文件] [--list] [--no-run] [--filter 子串] [--timeout 秒] [--emit-llvm]\n")
    gen.write_all(2, buf, n)
}

// drv_is_yh_source：判断命令行参数是否以用户源文件后缀 .yh 结尾。
fn drv_is_yh_source(path *char) int {
    if (path == 0) { return 0 }
    let n int = 0
    for path[n] != 0 { n += 1 }
    return n >= 3 && path[n - 3] == '.' &&
        path[n - 2] == 'y' && path[n - 1] == 'h' ? 1 : 0
}

// drv_has_link_option：检查参数表里是否出现 --link；用于不支持它的命令。
fn drv_has_link_option(av **char, an int) int {
    let i int = 0
    for i < an {
        if (gen.cstr_eq(av[i], "--link") != 0) { return 1 }
        let p *char = av[i]
        if (p[0] == '-' && p[1] == '-' && p[2] == 'l' && p[3] == 'i'
            && p[4] == 'n' && p[5] == 'k' && p[6] == '=') { return 1 }
        i += 1
    }
    return 0
}

// drv_scan_target：扫描完整 --target 或旧 -target 别名，以及 LLVM 后端的
// --backend/-O0/-O2/--emit-llvm 选项；未知目标或未知后端返回 -1，不静默回退。
// 旧别名明确表示 AArch64 Unix；其余参数保持原顺序，返回不含程序名的参数个数。
fn drv_scan_target(argc int, argv **char, out **char) int {
    let gs *gen.GenState = gen.G()
    let n int = 0
    let i int = 1
    for i < argc {
        if (gen.cstr_eq(argv[i], "-target") != 0 || gen.cstr_eq(argv[i], "--target") != 0) {
            if (i + 1 >= argc) { gen.fail("缺少目标 triple"); return -1 }
            let target *char = argv[i + 1]
            // LL12：简写别名（linux/gnu/elf/darwin/macho/macos，隐含 AArch64）
            // 已移除；`-target` 与 `--target` 都只接受完整三元组。
            if (gen.cstr_eq(target, "linux") != 0 || gen.cstr_eq(target, "gnu") != 0
                || gen.cstr_eq(target, "elf") != 0 || gen.cstr_eq(target, "darwin") != 0
                || gen.cstr_eq(target, "macho") != 0 || gen.cstr_eq(target, "macos") != 0) {
                gen.fail("-target 需要完整三元组（如 aarch64-apple-darwin）；linux/darwin 等简写别名已随 LL12 移除")
                return -1
            }
            if (gen.target_select(target) != 0) { gen.fail("不支持的目标 triple"); return -1 }
            proj.cfg().target_explicit = 1
            i += 2
        } else if (gen.cstr_eq(argv[i], "--backend") != 0) {
            if (i + 1 >= argc) { gen.fail("缺少后端名（llvm）"); return -1 }
            if (gen.cstr_eq(argv[i + 1], "legacy") != 0) {
                gen.fail("legacy 后端已在 LL12 退役；LLVM 是唯一代码生成后端")
                return -1
            }
            if (gen.cstr_eq(argv[i + 1], "llvm") == 0) {
                gen.fail("不支持的后端（只接受 llvm）")
                return -1
            }
            i += 2
        } else if (gen.cstr_eq(argv[i], "-O0") != 0) {
            proj.cfg().opt_level = 0
            i += 1
        } else if (gen.cstr_eq(argv[i], "-O2") != 0) {
            proj.cfg().opt_level = 2
            i += 1
        } else if (gen.cstr_eq(argv[i], "--emit-llvm") != 0) {
            // 只写 LLVM 文本（每模块一个 .ll），供审阅/差分；不产生目标文件。
            proj.cfg().emit_kind = 1
            i += 1
        } else if (gen.cstr_eq(argv[i], "--stats") != 0) {
            gs.c_stats_enabled = 1
            i += 1
        } else if (gen.cstr_eq(argv[i], "--legacy-system") != 0) {
            gs.task.c_legacy_system = 1
            i += 1
        } else {
            out[n] = argv[i]
            n += 1
            i += 1
        }
    }
    return n
}

// main：解析命令行并交给 api.yh 执行。
// 形态（--target <triple> 可出现在任意位置）：
//   yh --syntax-check <file.yh>
//   yh --emit-asm <file.yh>
//   yh --target aarch64-apple-darwin -o <out> <file.yh>
pub fn main(argc int, argv **char, envp **char) int {
    let gs *gen.GenState = gen.G()
    // 编译会话入口：恢复 GenState 与项目模型的非零初始值（原 pub let 初始化器迁移）
    gen.state_init()
    proj.init()
    // 目标/配置的存储归 proj（B1-2）：gen 只持指针，必须先绑定再读目标。
    gen.bind_cfg(proj.cfg())
    // 自身路径（项目构建的子进程再入用）
    build.mb_set_argv0(argv[0])
    // 直接读取操作系统传入的环境向量，避免调用 printenv 等宿主工具。
    proj.ctx().envp = envp
    // 先摘除 -target，得到规整后的参数序列（av[0..n-1]）。
    let av [64]*char
    let n int = drv_scan_target(argc, argv, av)
    if (n < 0) { return 2 }

    // —— 项目命令（在单文件分派之前） ——
    if (n >= 1 && gen.cstr_eq(av[0], "build") != 0) {
        let rc int = api_build(av, n)
        if (rc == 2) { usage() }
        return rc
    }
    if (n >= 1 && gen.cstr_eq(av[0], "check") != 0) {
        if (n == 2 && drv_is_yh_source(av[1]) != 0) {
            return api_single_file(av[1], API_CHECK, 0)
        }
        gs.task.c_check_only = 1
        let rc int = api_build(av, n)
        if (rc == 2) { usage() }
        return rc
    }
    if (n >= 1 && gen.cstr_eq(av[0], "run") != 0) {
        return api_run(av, n)
    }
    if (n >= 1 && gen.cstr_eq(av[0], "version") != 0) {
        if (drv_has_link_option(av, n) != 0) {
            gen.fail("version 不支持 --link")
            return 2
        }
        return api_version(av, n)
    }
    if (n >= 1 && gen.cstr_eq(av[0], "list") != 0) {
        return api_list(av, n)
    }
    if (n >= 1 && gen.cstr_eq(av[0], "test") != 0) {
        let rc int = api_test(av, n)
        if (rc == 2) { usage() }
        return rc
    }
    // 内部子命令：--emit-module <mod> <提供方根> <主根> -o <asm 目录>
    if ((n >= 6 && n <= 12) && gen.cstr_eq(av[0], "--emit-module") != 0
        && gen.cstr_eq(av[4], "-o") != 0) {
        let rc int = api_emit_module(av, n)
        if (rc == 2) { usage() }
        return rc
    }

    // —— 单文件形态 ——
    let src_idx int = 1
    let out_idx int = 1
    let mode int = 0
    // -o 两种形态（后者与 stage0 的 `yh <file> -o <out>` 接口一致，
    // tests/yh-run/check.py 按该顺序调用）：
    //   av = ["-o", <out>, <src>]  或  av = [<src>, "-o", <out>]，共 3 个
    if (n == 3 && gen.cstr_eq(av[0], "-o") != 0) {
        mode = 3
        src_idx = 2
        out_idx = 1
    } else if (n == 3 && gen.cstr_eq(av[1], "-o") != 0) {
        mode = 3
        src_idx = 0
        out_idx = 2
    }
    if (mode == 0) {
        if (n != 2) {
            usage()
            if (n == 0) {
                // 裸 yh：顺带显示当前项目版本（不在项目内则静默）
                build.mb_print_version(1)
            }
            return 2
        }
        if (gen.cstr_eq(av[0], "--syntax-check") != 0) {
            mode = 1
        } else if (gen.cstr_eq(av[0], "--emit-asm") != 0) {
            mode = 2
        }
        if (mode == 0) {
            usage()
            return 2
        }
    }
    if (mode == 1) {
        return api_single_file(av[src_idx], API_SYNTAX, 0)
    }
    if (mode == 3) {
        return api_single_file(av[src_idx], API_EXE, av[out_idx])
    }
    if (proj.cfg().emit_kind == 1) {
        return api_single_file(av[src_idx], API_LLVM_TEXT, 0)
    }
    return api_single_file(av[src_idx], API_ASM, 0)
}
