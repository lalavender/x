module main
import gen
import build
import proj
import cmdline

// ============================================================================
// driver.yh —— 命令行入口：只做 argv → 请求的映射
//
// 输出接口（docs/02-plan/yh-自举实施方案-v2.md §3）：
//     yh --syntax-check <file.yh>   纯语法检查：合法静默退出 0，
//                                   非法输出诊断并以非零码退出
//     yh --emit-asm <file.yh>       发射当前目标汇编到标准输出
//                                   （经 LLVM 后端；GNU 语法，按目标汇编器处理）
//     yh -o <out> <file.yh>         编译并链接为可执行文件
//
// 执行一律委托 api.yh（A3）：本文件不直接调用前端、后端或构建实现。
// 退出码：0 成功；1 源文件语法/语义错误或读入失败；2 用法错误。
//
// CLI-R（2026-10-27）：argv 的声明与解析在 cmdline 模块（libs/cli），本文件只做
// 「请求 → 全局状态 → 分派」。豁免：内部子进程协议 `--emit-module` 仍按位置手写
// 识别（私有 ABI，不进用户 help，见文档 §4.3）。
// ============================================================================

// main：解析命令行并交给 api.yh 执行。
// 形态（全局选项在子命令前后都能写，由 cli 的 inherit 保证）：
//   yh build|check|run|test|list|version [...]
//   yh --syntax-check <file.yh> / --emit-asm <file.yh> / [-o <out>] <file.yh>
pub fn main(argc int, argv **char, envp **char) int {
    let gs *gen.TaskCtx = gen.task()
    // 编译会话入口：恢复 GenState 与项目模型的非零初始值（原 pub let 初始化器迁移）
    gen.state_init()
    proj.init()
    // 目标/配置的存储归 proj（B1-2）：gen 只持指针，必须先绑定再读目标。
    gen.bind_cfg(proj.cfg())
    // 自身路径（项目构建的子进程再入用）
    build.mb_set_argv0(argv[0])
    // 直接读取操作系统传入的环境向量，避免调用 printenv 等宿主工具。
    proj.ctx().envp = envp

    // 内部子进程协议：`--emit-module <mod> <prov> <root> -o <dir> [...]`（豁免 cli）。
    if (argc >= 7 && argc <= 13 && gen.cstr_eq(argv[1], "--emit-module") != 0
        && gen.cstr_eq(argv[5], "-o") != 0) {
        return api_emit_module(argv + 1, argc - 1)
    }

    // 裸 yh：完整帮助 + 当前项目版本，退出 2（保持旧契约）。
    if (argc <= 1) {
        cmdline.print_bare_help(2)
        build.mb_print_version(1)
        return 2
    }

    let req cmdline.CliRequest
    let message [1024]char
    let status int = cmdline.parse_request(argc, argv, &req, &message[0], 1024)
    if (status != 0) {
        if (message[0] != 0) {
            gen.fail(&message[0])
        }
        cmdline.print_usage(&req, 2)
        cmdline.release_request(&req)
        return status
    }
    // help/version 控制请求：正文写 stdout，退出 0。
    if (req.command == cmdline.CLI_CONTROL) {
        cmdline.print_control(&req, 1)
        cmdline.release_request(&req)
        return 0
    }

    // 全局选项落进 GenState（诊断文本与旧手写扫描一致）。
    if (req.backend != 0) {
        if (gen.cstr_eq(req.backend, "legacy") != 0) {
            gen.fail("legacy 后端已在 LL12 退役；LLVM 是唯一代码生成后端")
            cmdline.release_request(&req)
            return 2
        }
        if (gen.cstr_eq(req.backend, "llvm") == 0) {
            gen.fail("不支持的后端（只接受 llvm）")
            cmdline.release_request(&req)
            return 2
        }
    }
    if (req.target != 0) {
        if (cmdline.is_removed_target_alias(req.target) != 0) {
            gen.fail("-target 需要完整三元组（如 aarch64-apple-darwin）；linux/darwin 等简写别名已随 LL12 移除")
            cmdline.release_request(&req)
            return 2
        }
        if (gen.target_select(req.target) != 0) {
            gen.fail("不支持的目标 triple")
            cmdline.release_request(&req)
            return 2
        }
        proj.cfg().target_explicit = 1
    }
    proj.cfg().opt_level = req.opt_level
    if (req.emit_llvm != 0) {
        proj.cfg().emit_kind = 1
    }
    if (req.stats != 0) {
        gen.stats().enabled = 1
    }
    if (req.legacy_system != 0) {
        gs.c_legacy_system = 1
    }

    if (req.command == cmdline.CLI_FILE) {
        let form int = API_ASM
        if (req.file_mode == cmdline.CLIFILE_SYNTAX) {
            form = API_SYNTAX
        } else if (req.file_mode == cmdline.CLIFILE_EXE) {
            form = API_EXE
        } else if (proj.cfg().emit_kind == 1) {
            form = API_LLVM_TEXT
        }
        let out_path *char = 0
        if (form == API_EXE) {
            out_path = req.out
        }
        let rc int = api_single_file(req.src, form, out_path)
        cmdline.release_request(&req)
        return rc
    }
    if (req.command == cmdline.CLI_CHECK && req.has_src != 0
        && cmdline.is_yh_source(req.src) != 0) {
        let rc int = api_single_file(req.src, API_CHECK, 0)
        cmdline.release_request(&req)
        return rc
    }
    if (req.command == cmdline.CLI_BUILD || req.command == cmdline.CLI_CHECK) {
        if (req.command == cmdline.CLI_CHECK) {
            gs.c_check_only = 1
        }
        let rc int = api_build(&req)
        if (rc == 2) {
            cmdline.print_usage(&req, 2)
        }
        cmdline.release_request(&req)
        return rc
    }
    if (req.command == cmdline.CLI_RUN) {
        let rc int = api_run(&req)
        cmdline.release_request(&req)
        return rc
    }
    if (req.command == cmdline.CLI_TEST) {
        if (req.timeout_secs < 1 || req.timeout_secs > 3600) {
            gen.fail("--timeout 需要 1..3600 之间的秒数")
            cmdline.print_usage(&req, 2)
            cmdline.release_request(&req)
            return 2
        }
        let rc int = api_test(&req)
        if (rc == 2) {
            cmdline.print_usage(&req, 2)
        }
        cmdline.release_request(&req)
        return rc
    }
    if (req.command == cmdline.CLI_LIST) {
        let rc int = api_list(&req)
        cmdline.release_request(&req)
        return rc
    }
    let rc int = api_version(&req)
    cmdline.release_request(&req)
    return rc
}
