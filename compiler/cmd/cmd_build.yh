module main
import gen
import build
import cmdline

// ============================================================================
// cmd_build.yh —— yh build / yh check（项目态）（P1 一命令一文件）。
// check 项目态与 build 共享 build.mb_cmd_build 实现，仅差 c_check_only
// 标志（由本文件置位）。用法错误（返回 2）时补印用法后原码返回。
// ============================================================================

// api_build：yh build。
fn api_build(req *cmdline.CliRequest) int {
    let rc int = build.mb_cmd_build(req.out, req.src, req.has_src,
        req.links[0..req.link_count])
    if (rc == 2) {
        cmdline.print_usage(req, 2)
    }
    return rc
}

// api_check_project：yh check [module]（项目态检查；源文件形态走 cmd_single）。
fn api_check_project(req *cmdline.CliRequest) int {
    let gs *gen.TaskCtx = gen.task()
    gs.c_check_only = 1
    let rc int = build.mb_cmd_build(req.out, req.src, req.has_src,
        req.links[0..req.link_count])
    if (rc == 2) {
        cmdline.print_usage(req, 2)
    }
    return rc
}
