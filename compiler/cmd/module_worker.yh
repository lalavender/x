module main;
import gen;
import parse;
import comptime;
import ast;

// module_worker.yh：在 fork 继承的项目快照上初始化私有语义状态并编译单个模块。

// mb_emit_indexed_module：复用父进程已扫描的项目、词法 token 与顶层声明索引，
// 只在当前子进程建立语义表、检查模块并写出汇编和本轮私有接口。
fn mb_emit_indexed_module(m int, main_off int, main_len int,
    out_s *char, ir_cache_salt u64) int {
    let gs *gen.GenState = gen.G();
    comptime.ct_reset();
    gs.c_front_cache = 1;
    gs.c_ast_capture = 0;
    gs.c_ir_cache_salt = ir_cache_salt;
    gs.c_errors = 0;
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (m < 0 || m >= gs.p_mod_n
        || pj_mod_suffix(gs.p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    gs.c_module_mode = 1;
    gs.c_is_entry_mod = gs.p_mods[m].is_entry;
    gs.c_sym_sfx_off = sfx_off;
    gs.c_sym_sfx_len = sfx_len;
    if (gen.sem_init_tables() != 0) {
        return -1;
    }
    gen.ty_register_builtins();
    gen.scope_push();
    if (gen.sem_register_prelude() != 0) {
        return -1;
    }
    let build_off int = mb_build_dir(main_off, main_len);
    if (build_off < 0) {
        return -1;
    }
    let build_len int = pj_canon_len;
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1;
    }
    let di int = 0;
    for di < mb_dep_n {
        if (gen.set_source_path(pj_pool_str(mb_dep_ifoff[di])) != 0) {
            return -1;
        }
        if (parse.iface_load(pj_pool_str(mb_dep_ifoff[di]),
                mb_dep_bind[di], mb_dep_bindlen[di]) < 0) {
            return -1;
        }
        di += 1;
    }
    gs.c_ast_capture = 1;
    ast.ast_expr_reset();
    ast.ast_stmt_reset();
    ast.ast_decl_reset();
    ast.ast_function_reset();
    let cti int = 0;
    for cti < mb_dep_n {
        if (gen.set_source_path(pj_pool_str(mb_dep_ctoff[cti])) != 0
            || parse.iface_ct_load(pj_pool_str(mb_dep_ctoff[cti]),
                mb_dep_base + cti) != 0) {
            return -1;
        }
        cti += 1;
    }
    // .s.ct 闭包加载完成后执行导入侧延迟的 pub $ 聚合常量初始化式
    // （调用目标隐藏符号此刻已登记；.s.i 先于 .s.ct 加载，见
    // parse_global_init.yh 的 pub_agg_deferred_run）。
    if (parse.pub_agg_deferred_run() != 0) {
        return -1;
    }
    let afi int = 0;
    for afi < gs.p_mods[m].file_n {
        let decl_fi int = gs.p_mods[m].files[afi];
        if (mb_restore_front_file(pj_pool_str(gs.p_files[decl_fi].path_off),
                decl_fi) != 0 || mb_file_head_bind(decl_fi) != 0
            || parse.decl_index_file(decl_fi) != 0
            || mb_restore_front_file(pj_pool_str(gs.p_files[decl_fi].path_off),
                decl_fi) != 0 || ast.ast_decl_add_file(decl_fi) != 0) {
            return -1;
        }
        afi += 1;
    }
    let sym_base int = gs.c_sym_n;
    let tname_base int = gs.t_name_n;
    gs.c_compile = 1;
    gs.c_pass = 1;
    let fi int = 0;
    for fi < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi];
        if (mb_pass1_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id) != 0) {
            return -1;
        }
        fi += 1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    let bind_i int = 0;
    for bind_i < gs.p_mods[m].file_n {
        let bind_fi int = gs.p_mods[m].files[bind_i];
        if (mb_restore_front_file(pj_pool_str(gs.p_files[bind_fi].path_off),
                bind_fi) != 0 || ast.ast_decl_bind_file(bind_fi) != 0) {
            return -1;
        }
        bind_i += 1;
    }
    if (mb_check_binding_clash(m) != 0) {
        return -1;
    }
    if (gs.c_is_entry_mod != 0 && gen.sem_check_main() != 0) {
        return -1;
    }
    gs.c_pass = 2;
    let fi_ct int = 0;
    for fi_ct < gs.p_mods[m].file_n {
        let file_ct int = gs.p_mods[m].files[fi_ct];
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_ct].path_off),
                file_ct, 2) != 0) { return -1; }
        fi_ct += 1;
    }
    if (gs.c_errors > 0) { return -1; }
    let fi_ct_layout int = 0;
    for fi_ct_layout < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi_ct_layout];
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 3) != 0) { return -1; }
        fi_ct_layout += 1;
    }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count()
            + comptime.ct_layout_expr_pending_count()
            + comptime.ct_layout_pending_count();
        if (pending_before == 0) { break; }
        let fi_layout_eval int = 0;
        for fi_layout_eval < gs.p_mods[m].file_n {
            let file_id int = gs.p_mods[m].files[fi_layout_eval];
            if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                    file_id, 4) != 0) { return -1; }
            if (mb_restore_front_file(pj_pool_str(gs.p_files[file_id].path_off),
                    file_id) != 0 || mb_file_head_bind(file_id) != 0
                || parse.parse_source_ct_layout_exprs() != 0) { return -1; }
            fi_layout_eval += 1;
        }
        if (comptime.ct_layout_advance() < 0) { return -1; }
        let pending_after int = comptime.ct_value_pending_count()
            + comptime.ct_layout_expr_pending_count()
            + comptime.ct_layout_pending_count();
        if (pending_after == 0) { break; }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic();
            } else {
                comptime.ct_value_stuck_diagnostic();
            }
            return -1;
        }
    }
    if (comptime.ct_layout_resolve() != 0 || gs.c_errors > 0) { return -1; }
    // 延迟的枚举判别值：此时编译期函数正文已捕获，可以真实求值。
    if (parse.ct_enum_pending_run() != 0) { return -1; }
    let fi2 int = 0;
    for fi2 < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi2];
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 1) != 0) {
            return -1;
        }
        fi2 += 1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    let ctpath [700]u8;
    let ipath [700]u8;
    if (mb_module_ctiface_path(m, build_off, build_len, ctpath) != 0
        || parse.iface_ct_emit(gen.arr_cstr(ctpath), sym_base) != 0
        || mb_module_iface_path(m, build_off, build_len, ipath) != 0
        || parse.iface_emit(gen.arr_cstr(ipath), sym_base, tname_base) != 0) {
        return -1;
    }
    let fi3 int = 0;
    for fi3 < gs.p_mods[m].file_n {
        let file_id int = gs.p_mods[m].files[fi3];
        if (mb_pass2_file(pj_pool_str(gs.p_files[file_id].path_off),
                file_id, 0) != 0) {
            return -1;
        }
        fi3 += 1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    if (ast.ast_expr_verify() != 0) {
        return gen.fail("内部错误：表达式 AST 校验失败");
    }
    if (ast.ast_stmt_verify() != 0) {
        return gen.fail("内部错误：语句 AST 校验失败");
    }
    if (ast.ast_decl_verify() != 0) {
        return gen.fail("内部错误：顶层声明 AST 校验失败");
    }
    if (ast.ast_function_verify() != 0) {
        return gen.fail("内部错误：函数 AST 上下文校验失败");
    }
    if (gs.c_check_only == 0) {
        if (pj_canon(build_off, build_len, "ir") != 0) { return -1; }
        let ir_cache_dir [620]u8;
        let irn int = 0;
        irn = gen.append_str(ir_cache_dir, irn, pj_pool_str(pj_canon_off));
        ir_cache_dir[irn] = 0;
        if (ast.ast_ir_lower_module(gen.arr_cstr(ir_cache_dir),
                gs.c_ir_cache_salt) != 0) {
            return -1;
        }
    }
    let bi int = 0;
    for bi < gs.c_bss_n {
        let bidx int = gs.c_bss_syms[bi];
        if (gen.em_bss_symbol(bidx, gs.t_types[gs.c_syms[bidx].type_id].size,
                gs.t_types[gs.c_syms[bidx].type_id].align) != 0) {
            return -1;
        }
        bi += 1;
    }
    if (gs.c_check_only == 0 && gen.em_emit_runtime_stubs() != 0) {
        return -1;
    }
    if (gs.c_check_only == 0 && drv_write_asm(out_s) != 0) {
        return -1;
    }
    mb_print_stats();
    return 0;
}
