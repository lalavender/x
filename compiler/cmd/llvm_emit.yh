module main;
import gen;
import lex;
import parse;
import comptime;
import ast;
import ir;
import backend;

// ============================================================================
// llvm_emit.yh —— LLVM 后端发射的驱动侧共用入口（LL3）
//
// 单文件路径（--emit-asm / -o）与项目 worker 都走这里，保证两条入口行为一致：
//   受检快照（CheckedModule）→ 模块 IR（ir.IRModule）→ LLVM 文本（backend.LLVMOutput）
//   → 内嵌静态桥（backend.llvm_bridge_emit）→ 目标文件或汇编。
//
// 约束（与实施方案 LL3 一致）：
//   * 不调用任何外部 LLVM 工具（clang/llc/opt/llvm-as），只经内嵌桥；
//   * 形态不支持时带真实来源诊断并**停止发布产物**，绝不回退旧 ARM64 发射；
//   * 目标身份由 GenState 的 TargetInfo 提供，模块 IR 与桥各自再校验一次。
// ============================================================================

// llvm_emit_result：一次 LLVM 发射的产物统计，供 --stats 与门禁核对覆盖。
// emitted 是模块内实际发射的函数定义数，为 0 说明 lowering 拒绝或模块为空。
pub struct LLVMEmitResult {
    emitted int;
    text_length int;
}

// llvm_emit_reason：把桥的诊断文本拼进带来源位置的诊断行并写 stderr。
// path/line/col 来自模块符号的来源记录；桥文本可能为空（分配失败等）。
fn llvm_emit_reason(unit *ir.IRModule, source int, offset int, reason *char) void {
    let buffer [2048]u8;
    let n int = 0;
    let path *char = "<LLVM 模块>";
    let line int = 1;
    let col int = 1;
    if (unit != 0 && source >= 0 && source < unit.source_count) {
        let input ir.IRModuleSource = unit.sources[source];
        path = input.path;
        let i int = 0;
        for i < offset && i < input.length {
            if (input.text[i] == '\n') { line += 1; col = 1; } else { col += 1; }
            i += 1;
        }
    }
    n = gen.append_str(&buffer[0], n, path);
    n = gen.append_byte(&buffer[0], n, ':');
    n = gen.append_int(&buffer[0], n, line);
    n = gen.append_byte(&buffer[0], n, ':');
    n = gen.append_int(&buffer[0], n, col);
    n = gen.append_str(&buffer[0], n, ": 错误: LLVM 后端: ");
    if (reason != 0 && reason[0] != 0) {
        n = gen.append_str_limit(&buffer[0], n, 1900, reason);
    } else {
        n = gen.append_str(&buffer[0], n, "内嵌桥拒绝该模块（诊断缓冲为空）");
    }
    n = gen.append_byte(&buffer[0], n, '\n');
    gen.write_all(2, &buffer[0], n);
}

// llvm_emit_module_to：把受检快照降低为模块 IR 并经内嵌桥发布产物。
// kind：0 = 目标文件（对象），1 = 汇编文本；out_path 为产物路径，text_path 非空时
// 额外写出 LLVM 文本（审阅/差分用，失败不致命）。
// 返回 0 成功、-1 失败（诊断已写 stderr，且不发布任何产物）。
fn llvm_emit_module_to(unit *ast.CheckedModule, kind int, out_path *char,
    text_path *char, stats *LLVMEmitResult) int {
    let gs *gen.GenState = gen.G();
    let mod_ir ir.IRModule;
    let lowered int = ast.lower_module(unit, &mod_ir);
    if (lowered != 0) {
        // lower_module 已按首片契约写好带来源的拒绝诊断，这里不再重复。
        return -1;
    }
    let output backend.LLVMOutput;
    if (backend.llvm_emit_module(&mod_ir, &gs.c_target, &output) != 0) {
        ir.ir_module_release(&mod_ir);
        return -1;
    }
    if (text_path != 0) {
        // LLVM 文本是审阅产物：写失败只报告，不影响对象发布；"-" 表示写标准输出。
        if (gen.cstr_eq(text_path, "-") != 0) {
            gen.write_all(1, output.text, output.length);
        } else {
            let text_fd int = open(text_path, gs.c_host_target.os == gen.TARGET_OS_DARWIN ? 0x601 : 0x241, 0x1a4);
            if (text_fd < 0) {
                gen.fail_path("无法创建 LLVM 文本: ", text_path);
            } else {
                let written int = 0;
                let length int = output.length;
                for written < length {
                    let step i64 = write(text_fd, output.text + written,
                        (length - written).to_type(u64));
                    if (step <= 0) {
                        gen.fail_path("写入 LLVM 文本失败: ", text_path);
                        break;
                    }
                    written += step.to_type(int);
                }
                close(text_fd);
            }
        }
    }
    let reason [backend.LLVM_BRIDGE_DIAG]u8;
    if (backend.llvm_bridge_emit(output.text.to_type(*char), output.length,
            gs.c_target.triple, gs.c_opt_level, kind, out_path,
            (&reason[0]).to_type(*char)) != 0) {
        // 桥失败：按模块第一个来源定位，便于把 LLVM 错误映射回 yh 源码。
        let source int = 0;
        let offset int = 0;
        if (mod_ir.symbol_count > 0) {
            source = mod_ir.symbols[0].source;
            offset = mod_ir.symbols[0].offset;
        }
        llvm_emit_reason(&mod_ir, source, offset, (&reason[0]).to_type(*char));
        backend.llvm_output_release(&output);
        ir.ir_module_release(&mod_ir);
        return -1;
    }
    if (stats != 0) {
        stats.emitted = output.emitted;
        stats.text_length = output.length;
    }
    backend.llvm_output_release(&output);
    ir.ir_module_release(&mod_ir);
    return 0;
}

// ============================================================================
// 单文件受检前端（LL3）
//
// 单文件路径（`yh --backend llvm -o out file.yh`）必须走到与项目 worker 相同的
// 受检形态，才能交出 CheckedModule 快照。这里采用与项目 worker 一致的
// 「已索引文件」形态：只有这一形态会给顶层声明编号，AST 捕获的
// ast_function_begin / ast_decl_attach_body 依赖该编号；旧单文件形态该编号恒为 -1。
// 语义两遍的调用顺序与 cmd/compile.yh 的 sem_compile 相同，唯一差别是 AST 捕获
// 由调用方预先打开（c_ast_capture = 1），因此 sem_compile 的「临开临关 + 清空
// arena」整段被跳过，arena 能活到快照生成之后。
// ============================================================================

// mb_llvm_file_begin：为单文件建立 PFile 只读快照并切到已索引形态。
// 路径同时进入 set_source_path 的固定缓冲（解析期诊断）与名字池（PFile.path_off，
// 快照与 lowering 诊断）。返回 0 成功，非 0 表示重复会话/路径过长/分配失败。
fn mb_llvm_file_begin(path *char) int {
    let gs *gen.GenState = gen.G();
    if (gs.p_files != 0) { return 1; }
    if (gen.set_source_path(path) != 0) { return 1; }
    let path_len int = 0;
    for path[path_len] != 0 { path_len += 1; }
    let path_off int = gen.tml_intern_str(path.to_type(*u8), 0, path_len);
    if (path_off < 0) { return 1; }
    let files *gen.PFile = malloc(sizeof(gen.PFile).to_type(u64)).to_type(*gen.PFile);
    if (files == 0) { return 1; }
    let file gen.PFile;
    file.path_off = path_off;
    file.path_len = path_len;
    file.mod = -1;
    file.line = 0;
    file.source = gs.c_src;
    file.source_len = gs.c_src_len;
    file.tokens = gs.c_toks;
    file.token_n = gs.c_tok_n;
    file.decls = 0;
    file.decl_n = 0;
    files[0] = file;
    gs.p_files = files;
    gs.p_file_n = 1;
    gs.p_file_cap = 1;
    gs.c_active_file = 0;
    gs.c_file_decl_i = -1;
    gs.c_file_indexed = 1;
    // 文件头与顶层声明索引：decl_index_file 之后逐条设置 c_file_decl_i。
    if (parse.mod_parse_head() != 0 || parse.decl_index_file(0) != 0) { return 1; }
    gs.c_pos = 0;
    gs.c_file_decl_i = -1;
    gs.c_file_decls = gs.p_files[0].decls;
    gs.c_file_decl_n = gs.p_files[0].decl_n;
    // 捕获开关与四个 arena 必须在语义遍历前打开：arena 要活到快照生成之后。
    gs.c_ast_capture = 1;
    ast.ast_expr_reset();
    ast.ast_stmt_reset();
    ast.ast_decl_reset();
    ast.ast_function_reset();
    return ast.ast_decl_add_file(0) == 0 ? 0 : 1;
}

// mb_llvm_semantics：单文件受检语义两遍，顺序与 cmd/compile.yh 的 sem_compile 一致。
// 返回 0 成功；任一遍失败或产生诊断（c_errors > 0）返回非 0。
fn mb_llvm_semantics() int {
    let gs *gen.GenState = gen.G();
    comptime.ct_reset();
    gs.c_pass = 1;
    gs.c_pos = 0;
    if (parse.parse_indexed_decls(0) != 0 || gs.c_errors > 0) { return 1; }
    gs.c_pos = 0;
    if (ast.ast_decl_bind_file(0) != 0) { return 1; }
    gs.c_pass = 2;
    gs.c_pos = 0;
    if (parse.parse_source_ct_fns() != 0 || gs.c_errors > 0) { return 1; }
    if (parse.parse_source_ct_layout_register() != 0) { return 1; }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count()
            + comptime.ct_layout_expr_pending_count()
            + comptime.ct_layout_pending_count();
        if (pending_before == 0) { break; }
        if (parse.parse_source_ct_layout_consts() != 0) { return 1; }
        if (parse.parse_source_ct_layout_exprs() != 0) { return 1; }
        if (comptime.ct_layout_advance() < 0) { return 1; }
        let pending_after int = comptime.ct_value_pending_count()
            + comptime.ct_layout_expr_pending_count()
            + comptime.ct_layout_pending_count();
        if (pending_after == 0) { break; }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic();
            } else {
                comptime.ct_value_stuck_diagnostic();
            }
            return 1;
        }
    }
    if (comptime.ct_layout_resolve() != 0 || gs.c_errors > 0) { return 1; }
    if (parse.ct_enum_pending_run() != 0) { return 1; }
    gs.c_pos = 0;
    if (parse.parse_source_globals() != 0 || gs.c_errors > 0) { return 1; }
    gs.c_pos = 0;
    if (parse.parse_source_fns() != 0 || gs.c_errors > 0) { return 1; }
    if (ast.ast_expr_verify() != 0 || ast.ast_stmt_verify() != 0
        || ast.ast_decl_verify() != 0 || ast.ast_function_verify() != 0) { return 1; }
    return 0;
}

// llvm_emit_text_only：只做 lowering 与 LLVM 文本发射，不调用内嵌桥。
// 供 --emit-llvm 审阅形态使用（单文件写标准输出，项目写 .build/llvm/<tag>.ll）。
// 返回 0 成功、1 首片不支持（lowering 已给来源诊断）、-1 内部错误。
fn llvm_emit_text_only(unit *ast.CheckedModule, text_path *char,
    stats *LLVMEmitResult) int {
    let gs *gen.GenState = gen.G();
    let mod_ir ir.IRModule;
    let lowered int = ast.lower_module(unit, &mod_ir);
    if (lowered != 0) { return 1; }
    let output backend.LLVMOutput;
    if (backend.llvm_emit_module(&mod_ir, &gs.c_target, &output) != 0) {
        ir.ir_module_release(&mod_ir);
        return -1;
    }
    let status int = 0;
    if (text_path != 0 && gen.cstr_eq(text_path, "-") != 0) {
        if (gen.write_all(1, output.text, output.length) != 0) { status = -1; }
    } else if (text_path != 0) {
        let fd int = open(text_path, 0x241, 0x1a4);
        if (fd < 0) {
            gen.fail_path("无法创建 LLVM 文本: ", text_path);
            status = -1;
        } else {
            let written int = 0;
            for written < output.length {
                let step i64 = write(fd, output.text + written,
                    (output.length - written).to_type(u64));
                if (step <= 0) {
                    gen.fail_path("写入 LLVM 文本失败: ", text_path);
                    status = -1;
                    break;
                }
                written += step.to_type(int);
            }
            close(fd);
        }
    }
    if (stats != 0) {
        stats.emitted = output.emitted;
        stats.text_length = output.length;
    }
    backend.llvm_output_release(&output);
    ir.ir_module_release(&mod_ir);
    return status;
}

// llvm_emit_single_file：单文件入口（--emit-asm / -o）在 LLVM 模式下的实现。
// 调用方必须已完成会话初始化（state_init + 读源 + 语义表）并打开受检前端；
// 本函数负责词法、单文件 PFile/声明索引、两遍语义、快照捕获与产物发布。
// link 非 0：产物是**可执行文件**（对象先写临时文件再交给宿主 cc 链接）；
// link 为 0：产物是**对象文件**（kind=0）或汇编文本（kind=1）。
// text_path 非空时额外写出 LLVM 文本（"-" = 标准输出）。
// 返回 0 成功、1 源/形态错误、-1 内部或桥失败。
fn llvm_emit_single_file(source_path *char, out_path *char, kind int,
    text_path *char, link int) int {
    let gs *gen.GenState = gen.G();
    // 受检前端必须在任何语义遍历之前进入：进入时拒绝已有旧输出，退出前核对
    // text/body/data/bss 四缓冲为零。单文件路径的调用方只做过读源与建表。
    if (gen.front_checked_begin() != 0) { return 1; }
    if (lex.lex_all() != 0) { return 1; }
    if (mb_llvm_file_begin(source_path) != 0) { return 1; }
    gs.c_compile = 1;
    if (gen.ty_register_builtins() != 0 || gen.scope_push() != 0
        || gen.sem_register_prelude() != 0) { return 1; }
    if (mb_llvm_semantics() != 0) { return 1; }
    if (gen.front_checked_verify() != 0) { return 1; }
    let checked ast.CheckedModule;
    if (ast.checked_module_capture(&checked) != 0) { return -1; }
    if (gen.front_checked_end() != 0) { return 1; }
    // 链接形态先把对象写到 <out>.yh-tmp.o，避免与最终可执行文件同名。
    let object [620]u8;
    let on int = 0;
    let emit_path *char = out_path;
    if (link != 0) {
        on = gen.append_str(&object[0], on, out_path);
        on = gen.append_str(&object[0], on, ".yh-tmp.o");
        object[on] = 0;
        emit_path = gen.arr_cstr(&object[0]);
    }
    // out_path 为空 = 只写 LLVM 文本（--emit-llvm 单文件形态），不调用桥。
    if (emit_path == 0) {
        let stats_only LLVMEmitResult;
        let text_rc int = llvm_emit_text_only(&checked, text_path, &stats_only);
        ast.checked_module_release(&checked);
        return text_rc;
    }
    let stats LLVMEmitResult;
    // "--emit-asm" 形态：桥只按路径发布，因此先写临时文件再回显到标准输出。
    if (gen.cstr_eq(out_path, "-") != 0) {
        let temporary [64]u8;
        let tn int = gen.append_str(&temporary[0], 0, "/tmp/yh-llvm-asm-");
        tn = gen.append_int(&temporary[0], tn, getpid());
        tn = gen.append_str(&temporary[0], tn, ".s");
        temporary[tn] = 0;
        let asm int = llvm_emit_module_to(&checked, kind, gen.arr_cstr(&temporary[0]),
            text_path, &stats);
        ast.checked_module_release(&checked);
        if (asm != 0) {
            unlink(gen.arr_cstr(&temporary[0]));
            return -1;
        }
        let fd int = open(gen.arr_cstr(&temporary[0]), 0x0, 0);
        if (fd < 0) {
            unlink(gen.arr_cstr(&temporary[0]));
            return gen.fail("无法读回 LLVM 汇编产物");
        }
        let chunk [4096]u8;
        for 1 {
            let got i64 = read(fd, (&chunk[0]).to_type(*u8), 4096);
            if (got <= 0) { break; }
            if (gen.write_all(1, (&chunk[0]).to_type(*u8), got.to_type(int)) != 0) {
                close(fd);
                unlink(gen.arr_cstr(&temporary[0]));
                return gen.fail("写入 LLVM 汇编到标准输出失败");
            }
        }
        close(fd);
        unlink(gen.arr_cstr(&temporary[0]));
        return 0;
    }
    let emitted int = llvm_emit_module_to(&checked, kind, emit_path, text_path, &stats);
    ast.checked_module_release(&checked);
    if (emitted != 0) {
        if (link != 0) { unlink(gen.arr_cstr(&object[0])); }
        else { unlink(out_path); }
        return -1;
    }
    if (link == 0) { return 0; }
    // 链接沿用旧路径的宿主工具选择：Darwin 用 clang，其余用 cc。
    let args [8]*char;
    if (gs.c_target.os == gen.TARGET_OS_DARWIN) {
        args[0] = "clang";
        args[1] = "-o";
        args[2] = out_path;
        args[3] = gen.arr_cstr(&object[0]);
        args[4] = 0.to_type(*char);
    } else {
        args[0] = "gcc";
        args[1] = "-no-pie";
        args[2] = "-o";
        args[3] = out_path;
        args[4] = gen.arr_cstr(&object[0]);
        args[5] = 0.to_type(*char);
    }
    let rc int = cmd_process_run(&args[0]);
    unlink(gen.arr_cstr(&object[0]));
    if (rc != 0) {
        return gen.fail_path("LLVM 产物链接失败: ", out_path);
    }
    return 0;
}
