module main
import gen
import parse
import backend

// ============================================================================
// module_build.yh —— 项目构建管线（MOD-U4/U5）
//
// 命令（设计 §11）：
//   yh build [-o out] [module] [--stats] 项目构建；stats 只输出阶段计数
//   yh check [module]           项目语义检查，不生成后端产物
//   yh run                       构建并运行清单 entry
//   yh list [--resolve name]     列出模块/解释导入绑定（project.yh）
//   yh --emit-module M ROOT -o ASMDIR （内部）把模块 M 编译为按文件汇编
//        目录（每文件一个 .s + <tag>.stub.s 运行时桩对象，RS3b 起）
//
// 构建流程：装载项目与依赖 → 绑定导入 → topo 排序（环报完整链）→
// 依赖就绪时由有界 fork worker 并行编译；worker 继承父进程只读项目快照，
// 再加载已发布接口 → 两遍编译模块文件 → 产出
// 按文件汇编（asm/<tag>/<file>.s + <tag>.stub.s）与接口 .s.i（pub 符号
// GLOBAL、private LOCAL 且发 hidden 可见性、符号带 __proj__mod 后缀）
// → mb_link 逐文件汇编成 obj/<tag>/<file>.o → 一次链接全部 .o。
//
// 缓存（U5）：解析不缓存（每轮重解析——重绑定由构造保证）；对象缓存
// 按 manifest 内容哈希：后缀+entry+各源文件内容+各依赖接口内容+版本
// 标记，命中且 .s/.i 存在则跳过重编译；发射确定性（G3 已证）保证
// 冷热构建一致。接口加载时校验头行（版本/架构），损坏或不兼容的
// 接口干净拒绝，不回退低层。
//
// 过渡宿主能力：外部进程都通过显式 argv 启动；目录枚举和环境读取
// 暂时调用独立宿主工具，R3 后续会迁入自有 OS 适配层。
// ============================================================================

// c_argv0：自身可执行路径（argv[0] 借用，不复制），用于编译器指纹。
let c_argv0 *char = 0
let mb_iface_suffix *char = 0
let mb_compiler_fingerprint u64 = 0
let mb_compiler_fingerprint_ready int = 0
let mb_stats_build_start_ns u64 = 0
let mb_stats_project_ns u64 = 0
let mb_stats_schedule_ns u64 = 0
let mb_stats_object_ns u64 = 0
let mb_stats_link_ns u64 = 0

// mb_mix_compiler_fingerprint：每进程读取一次编译器二进制，后续模块只混入指纹。
fn mb_mix_compiler_fingerprint(h *u64) int {
    let gs *gen.GenState = gen.G()
    if (mb_compiler_fingerprint_ready == 0) {
        mb_compiler_fingerprint = mb_hash_init()
        let binary *char = c_argv0
        if (mb_self_path != 0) {
            binary = mb_self_path
        }
        if (mb_hash_file(&mb_compiler_fingerprint, binary) != 0) {
            return -1
        }
        mb_compiler_fingerprint_ready = 1
        if (gs.c_stats_enabled != 0) {
            gs.c_stats_compiler_hashes += 1
        }
    }
    let shift int = 0
    for shift < 64 {
        mb_fnv(h, ((mb_compiler_fingerprint >> shift) & 255).to_type(u8))
        shift += 8
    }
    return 0
}

// mb_parse_hex：把恰好 16 位十六进制指纹解析为 u64；非法输入返回 -1。
fn mb_parse_hex(text *char, value *u64) int {
    let result u64 = 0
    let i int = 0
    for i < 16 {
        let c u8 = text[i].to_type(u8)
        let digit int = -1
        if (c >= '0' && c <= '9') { digit = c - '0' }
        if (c >= 'a' && c <= 'f') { digit = c - 'a' + 10 }
        if (c >= 'A' && c <= 'F') { digit = c - 'A' + 10 }
        if (digit < 0) { return -1 }
        result = (result << 4) | digit.to_type(u64)
        i += 1
    }
    if (text[16] != 0) { return -1 }
    value[0] = result
    return 0
}

// mb_hash_init：返回缓存指纹 v2 的 FNV 初始值，使旧版缓存自然失效。
fn mb_hash_init() u64 {
    let hi u64 = 3421674725
    let lo u64 = 2216829733
    return (hi << 32) | lo
}

// mb_fnv：把一个字节混入 FNV-1a 64 位哈希。
fn mb_fnv(h *u64, b u8) void {
    h[0] = h[0] ^ b.to_type(u64)
    h[0] = h[0] * 1099511628211
}

// mb_hash_file：按对齐的 64 位读取混入文件内容，尾部不足八字节按字节处理。
// read_source 使用 malloc 对齐缓冲；支持的 Darwin/Linux arm64 与 x64 主机均为小端。
// 读取失败返回 -1。
fn mb_hash_file(h *u64, path *char) int {
    let gs *gen.GenState = gen.G()
    if (gen.read_source(path) != 0) {
        return -1
    }
    let i int = 0
    let words *u64 = gs.task.c_src.to_type(*u64)
    for i + 8 <= gs.task.c_src_len {
        let word u64 = words[i / 8]
        h[0] = h[0] ^ word
        h[0] = h[0] * 1099511628211
        i += 8
    }
    for i < gs.task.c_src_len {
        h[0] = h[0] ^ gs.task.c_src[i].to_type(u64)
        h[0] = h[0] * 1099511628211
        i += 1
    }
    return 0
}

// mb_build_dir：构建目录 = <root>/.build/targets/<triple>/llvm/O<n>；
// check 模式用 <root>/.build/check（LL12：不再有旧后端目录）。
fn mb_build_dir(root_off int, root_len int) int {
    let gs *gen.GenState = gen.G()
    if (gs.task.c_check_only != 0) {
        if (pj_canon(root_off, root_len, ".build/check") != 0) {
            return -1
        }
        return pj_canon_off
    }
    let target_dir [256]u8
    let n int = gen.append_str(&target_dir[0], 0, ".build/targets/")
    n = gen.append_str(&target_dir[0], n, gs.c_target.triple)
    n = gen.append_str(&target_dir[0], n, "/llvm/O")
    n = gen.append_int(&target_dir[0], n, gs.c_opt_level)
    target_dir[n] = 0
    if (pj_canon(root_off, root_len, (&target_dir[0]).to_type(*char)) != 0) {
        return -1
    }
    return pj_canon_off
}

// mb_default_binary_path：默认可执行文件留在项目 .build 根目录，中间缓存
// 按目标与优化级别隔离（LL12：唯一后端）。
fn mb_default_binary_path(root_off int, root_len int, build_off int,
    project int, out *u8) int {
    let gs *gen.GenState = gen.G()
    if (pj_canon(root_off, root_len, ".build") != 0) { return -1 }
    let dir_off int = pj_canon_off
    let n int = gen.append_str(out, 0, pj_pool_str(dir_off))
    n = gen.append_byte(out, n, '/')
    n = append_bytes_np(out, n, gs.p_projs[project].name_off,
        gs.p_projs[project].name_len)
    out[n] = 0
    return n
}

// mb_sub_dir：.build 下子目录路径（asm/obj/iface/manifest），intern 后返回。
fn mb_sub_dir(build_off int, build_len int, sub *char) int {
    if (pj_canon(build_off, build_len, sub) != 0) {
        return -1
    }
    return pj_canon_off
}

// mb_mkdir：确保构建目录存在。
fn mb_mkdir(dir *char) int {
    // 建 .build 六子目录（asm/obj/iface/manifest/ir/llvm）
    let subs [6]*char
    subs[0] = "asm"
    subs[1] = "obj"
    subs[2] = "iface"
    subs[3] = "manifest"
    subs[4] = "ir"
    subs[5] = "llvm"
    if (cmd_mkdirs(dir) != 0) {
        return gen.fail_path("无法创建构建目录: ", dir)
    }
    let k int = 0
    for k < 6 {
        let path [1100]u8
        let n int = gen.append_str(path, 0, dir)
        n = gen.append_byte(path, n, '/')
        n = gen.append_str(path, n, subs[k])
        path[n] = 0
        if (cmd_mkdirs(gen.arr_cstr(path)) != 0) {
            return gen.fail_path("无法创建构建目录: ", dir)
        }
        k += 1
    }
    return 0
}

// mb_dep_*：模块导入的去重清单（按解析结果模块下标去重）。
// bind/bindlen = 绑定名（诊断用）；ifoff = 接口路径；mod = 解析模块下标；
// mi = 该模块接口加载后的 ModInfo 下标（mb_emit_module 填写）。
let mb_dep_bind *int = 0
let mb_dep_bindlen *int = 0
let mb_dep_ifoff *int = 0
let mb_dep_ctoff *int = 0
let mb_dep_mod *int = 0
let mb_dep_mi *int = 0
let mb_dep_n int = 0
let mb_dep_cap int = 0
let mb_dep_base int = 0    // 本模块接口加载前 c_mod_n 基线

// mb_mod_tag：模块产物的唯一文件名标签 <sanitize(proj)>-<module>。
// 同名模块可能来自不同项目（KEY.MOD 导入），文件名必须含项目。
fn mb_mod_tag(m int, off *int, olen *int) int {
    let gs *gen.GenState = gen.G()
    let tmp [512]u8
    let n int = 0
    let i int = 0
    for i < gs.p_projs[gs.p_mods[m].proj].name_len {
        let b u8 = gs.task.np_data[gs.p_projs[gs.p_mods[m].proj].name_off + i]
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_')) {
            b = '_'
        }
        tmp[n] = b
        n += 1
        i += 1
    }
    tmp[n] = '-'
    n += 1
    i = 0
    for i < gs.p_mods[m].name_len {
        let b2 u8 = gs.task.np_data[gs.p_mods[m].name_off + i]
        if (!((b2 >= 'a' && b2 <= 'z') || (b2 >= 'A' && b2 <= 'Z')
            || (b2 >= '0' && b2 <= '9') || b2 == '_')) {
            b2 = '_'
        }
        tmp[n] = b2
        n += 1
        i += 1
    }
    tmp[n] = 0
    off[0] = gen.tml_intern_str(tmp, 0, n)
    olen[0] = n
    if (off[0] < 0) {
        return -1
    }
    return 0
}

// mb_asm_stem_base：把源文件路径（池偏移）的基名（去 .yh 后缀）清洗为
// 安全的文件名词干。非 [A-Za-z0-9_] 字节替换为 '_'（与 mb_mod_tag 同一套
// 清洗规则），超过 120 字节截断。返回干长度（>= 0）。
fn mb_asm_stem_base(path_off int, out *u8) int {
    let gs *gen.GenState = gen.G()
    let path *char = pj_pool_str(path_off)
    let start int = 0
    let n int = 0
    for path[n] != 0 {
        if (path[n] == '/') { start = n + 1 }
        n += 1
    }
    let end int = n
    if (end - start >= 3 && path[end - 3] == '.' && path[end - 2] == 'y'
        && path[end - 1] == 'h') {
        end -= 3
    }
    let bn int = 0
    let i int = start
    for i < end && bn < 120 {
        let b u8 = path[i].to_type(u8)
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_')) {
            b = '_'
        }
        out[bn] = b
        bn += 1
        i += 1
    }
    if (bn == 0) {
        out[0] = '_'
        bn = 1
    }
    return bn
}

// mb_asm_stems：一次性派生模块全部源文件的按文件对象名词干（RS3b）。
// stems 为 file_n × 160 字节缓冲（第 i 个文件名干在 stems + i*160，NUL 结尾），
// lens[i] 为长度。清洗后重名（如 a-b.yh 与 a_b.yh）时追加 _2/_3 保证唯一；
// 保留名 <tag>.stub（运行时桩对象）同样避开。与此前已派生名逐一比较，
// 因此三个及以上连环重名也稳定。worker 写 asm/<tag>/<stem>.s、mb_link 读
// obj/<tag>/<stem>.o，两边由同一函数派生才能对上。
fn mb_asm_stems(m int, stems *u8, lens *int) int {
    let gs *gen.GenState = gen.G()
    // 保留名：<tag>.stub
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) { return -1 }
    let tag_off int = pj_canon_off
    let tag_len int = pj_canon_len
    let reserved [160]u8
    let rn int = 0
    let ti int = 0
    for ti < tag_len {
        reserved[rn] = gs.task.np_data[tag_off + ti]
        rn += 1
        ti += 1
    }
    let dot *char = ".stub"
    let di int = 0
    for dot[di] != 0 {
        reserved[rn] = dot[di].to_type(u8)
        rn += 1
        di += 1
    }
    let idx int = 0
    for idx < gs.p_mods[m].file_n {
        let fi int = gs.p_mods[m].files[idx]
        let base [160]u8
        let bn int = mb_asm_stem_base(gs.p_files[fi].path_off, &base[0])
        if (bn < 0) { return -1 }
        let cand [160]u8
        let cn int = bn
        let ci int = 0
        for ci < bn {
            cand[ci] = base[ci]
            ci += 1
        }
        // 候选名：base，重名时 base_2、base_3……
        let k int = 2
        for k < 1000 {
            cn = bn
            ci = 0
            for ci < bn {
                cand[ci] = base[ci]
                ci += 1
            }
            if (k > 2) {
                cand[cn] = '_'
                cn += 1
                let digits [8]u8
                let dn int = 0
                let v int = k - 1
                for v > 0 {
                    digits[dn] = ((v % 10) + 48).to_type(u8)
                    dn += 1
                    v /= 10
                }
                for dn > 0 {
                    dn -= 1
                    cand[cn] = digits[dn]
                    cn += 1
                }
            }
            let clash int = 0
            if (cn == rn) {
                let same int = 1
                let t int = 0
                for t < cn {
                    if (cand[t] != reserved[t]) {
                        same = 0
                        break
                    }
                    t += 1
                }
                if (same != 0) { clash = 1 }
            }
            let j int = 0
            for j < idx && clash == 0 {
                let other *u8 = stems + (j * 160)
                if (lens[j] == cn) {
                    let same2 int = 1
                    let t2 int = 0
                    for t2 < cn {
                        if (other[t2] != cand[t2]) {
                            same2 = 0
                            break
                        }
                        t2 += 1
                    }
                    if (same2 != 0) { clash = 1 }
                }
                j += 1
            }
            if (clash == 0) { break }
            k += 1
        }
        if (k >= 1000) {
            return gen.fail("内部错误：无法派生唯一的汇编文件名")
        }
        let dst *u8 = stems + (idx * 160)
        let c2 int = 0
        for c2 < cn {
            dst[c2] = cand[c2]
            c2 += 1
        }
        dst[cn] = 0
        lens[idx] = cn
        idx += 1
    }
    return 0
}

// mb_module_obj_row：枚举一个模块的按文件对象行（RS3b：N 个文件 + 1 个运行时桩）。
// row_k < file_n → 第 row_k 个源文件对象（内部调 mb_asm_stems 派生文件名干，
// 与 worker 写侧同一函数保证一致）；row_k == file_n → 桩对象（<tag>.stub）。
// spath = <build>/asm/<tag>/<stem>.s，opath = <build>/obj/<tag>/<stem>.o，
// mpath = 同目录 .manifest（对象缓存）；不需要的路径传 0。
fn mb_module_obj_row(m int, build_off int, build_len int, row_k int,
    spath *u8, opath *u8, mpath *u8) int {
    let gs *gen.GenState = gen.G()
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1
    }
    let tag_off int = pj_canon_off
    let tag_len int = pj_canon_len
    let stem [160]u8
    let sn int = 0
    if (row_k < gs.p_mods[m].file_n) {
        let stems *u8 = malloc((gs.p_mods[m].file_n * 160).to_type(u64)).to_type(*u8)
        let lens *int = malloc((gs.p_mods[m].file_n * sizeof(int)).to_type(u64)).to_type(*int)
        if (stems == 0 || lens == 0) {
            if (stems != 0) { free(stems.to_type(*void)) }
            if (lens != 0) { free(lens.to_type(*void)) }
            return gen.fail("内存分配失败")
        }
        let ok int = mb_asm_stems(m, stems, lens)
        if (ok == 0) {
            sn = lens[row_k]
            let src *u8 = stems + (row_k * 160)
            let si int = 0
            for si < sn {
                stem[si] = src[si]
                si += 1
            }
        }
        free(stems.to_type(*void))
        free(lens.to_type(*void))
        if (ok != 0) { return -1 }
    } else {
        // 桩对象名词干 = <tag>.stub
        let ti int = 0
        for ti < tag_len {
            stem[ti] = gs.task.np_data[tag_off + ti]
            ti += 1
        }
        let dot *char = ".stub"
        let di int = 0
        for dot[di] != 0 {
            stem[ti] = dot[di].to_type(u8)
            ti += 1
            di += 1
        }
        sn = ti
    }
    if (spath != 0) {
        let pn int = 0
        pn = gen.append_str(spath, pn, pj_pool_str(build_off))
        pn = gen.append_str(spath, pn, "/asm/")
        pn = gen.append_str(spath, pn, pj_pool_str(tag_off))
        pn = gen.append_byte(spath, pn, '/')
        let si2 int = 0
        for si2 < sn {
            spath[pn] = stem[si2]
            pn += 1
            si2 += 1
        }
        pn = gen.append_str(spath, pn, ".s")
        spath[pn] = 0
    }
    if (opath != 0 || mpath != 0) {
        let on int = 0
        if (opath != 0) {
            on = gen.append_str(opath, on, pj_pool_str(build_off))
            on = gen.append_str(opath, on, "/obj/")
            on = gen.append_str(opath, on, pj_pool_str(tag_off))
            on = gen.append_byte(opath, on, '/')
        }
        let si3 int = 0
        for si3 < sn {
            if (opath != 0) { opath[on] = stem[si3]; on += 1 }
            si3 += 1
        }
        if (opath != 0) {
            on = gen.append_str(opath, on, ".o")
            opath[on] = 0
        }
        if (mpath != 0) {
            let mn int = 0
            mn = gen.append_str(mpath, mn, pj_pool_str(build_off))
            mn = gen.append_str(mpath, mn, "/obj/")
            mn = gen.append_str(mpath, mn, pj_pool_str(tag_off))
            mn = gen.append_byte(mpath, mn, '/')
            let si4 int = 0
            for si4 < sn {
                mpath[mn] = stem[si4]
                mn += 1
                si4 += 1
            }
            mn = gen.append_str(mpath, mn, ".manifest")
            mpath[mn] = 0
        }
    }
    return 0
}

// mb_check_clear_ifaces：删除本轮 check 生成的临时模块接口。
// check 使用独立构建目录，不覆盖正式构建缓存；依赖接口保留到全部模块检查结束。
fn mb_check_clear_ifaces(build_off int, build_len int, count int) void {
    let ci int = 0
    for ci < count {
        let m int = pj_order[ci]
        let path [700]u8
        if (mb_module_iface_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        if (mb_module_ctiface_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        // 清除升级前留下的无后缀 check 接口。
        if (mb_module_iface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        if (mb_module_ctiface_plain_path(m, build_off, build_len, path) == 0) {
            unlink(gen.arr_cstr(path))
        }
        ci += 1
    }
}

// mb_dep_push：按解析结果模块下标去重后追加一条依赖接口记录。
// 返回 1 = 新追加，0 = 已存在，-1 = 内存失败。
fn mb_dep_push(target int, bind_off int, bind_len int) int {
    let k int = 0
    for k < mb_dep_n {
        if (mb_dep_mod[k] == target) {
            return 0
        }
        k += 1
    }
    if (mb_dep_n == mb_dep_cap) {
        let ncap int = mb_dep_cap * 2
        if (ncap == 0) {
            ncap = 8
        }
        let na *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (na == 0) {
            return gen.fail("内存分配失败")
        }
        if (mb_dep_n > 0) {
            memcpy(na, mb_dep_bind, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_bind)
        mb_dep_bind = na
        let nb *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nb == 0) {
            return gen.fail("内存分配失败")
        }
        if (mb_dep_n > 0) {
            memcpy(nb, mb_dep_bindlen, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_bindlen)
        mb_dep_bindlen = nb
        let nc *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nc == 0) {
            return gen.fail("内存分配失败")
        }
        if (mb_dep_n > 0) {
            memcpy(nc, mb_dep_ifoff, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_ifoff)
        mb_dep_ifoff = nc
        let nct *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (nct == 0) { return gen.fail("内存分配失败") }
        if (mb_dep_n > 0) {
            memcpy(nct, mb_dep_ctoff, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_ctoff)
        mb_dep_ctoff = nct
        let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndm == 0) {
            return gen.fail("内存分配失败")
        }
        if (mb_dep_n > 0) {
            memcpy(ndm, mb_dep_mod, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_mod)
        mb_dep_mod = ndm
        let ndi *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int)
        if (ndi == 0) {
            return gen.fail("内存分配失败")
        }
        if (mb_dep_n > 0) {
            memcpy(ndi, mb_dep_mi, (mb_dep_n * sizeof(int)).to_type(u64))
        }
        free(mb_dep_mi)
        mb_dep_mi = ndi
        mb_dep_cap = ncap
    }
    mb_dep_bind[mb_dep_n] = bind_off
    mb_dep_bindlen[mb_dep_n] = bind_len
    mb_dep_mod[mb_dep_n] = target
    mb_dep_mi[mb_dep_n] = -1
    mb_dep_ifoff[mb_dep_n] = -1
    mb_dep_ctoff[mb_dep_n] = -1
    mb_dep_n += 1
    return 1
}

// mb_dep_order_rank：模块在本轮拓扑序 pj_order 中的位置；不在则 -1。
fn mb_dep_order_rank(m int) int {
    let i int = 0
    for i < pj_order_n {
        if (pj_order[i] == m) {
            return i
        }
        i += 1
    }
    return -1
}

// mb_module_iface_deps：收集模块 M 依赖的全部接口（接口路径 =
// <build>/iface/<tag>.s.i），分四步：
//   1. 直接导入（绑定名 = 源码导入别名）；
//   2. 传递闭包——导出结构体的字段可引用外模块类型的 mangle 名，读接口
//      正文前必须先登记被依赖方接口，因此依赖的依赖也要加载；导入环已在
//      解析期拒绝，此处按不动点扩充终止。传递依赖没有源码别名，绑定名
//      取目标模块的 mangle 后缀（全局唯一，不与显式导入冲突）；
//   3. 按本轮拓扑序排序——mangle 类型名要求提供方接口先于引用方登记；
//   4. 统一构造接口路径（本轮会话接口优先于持久缓存）。
fn mb_module_iface_deps(m int, build_off int, build_len int) int {
    let gs *gen.GenState = gen.G()
    mb_dep_n = 0
    let fi int = 0
    for fi < gs.p_mods[m].file_n {
        let f int = gs.p_mods[m].files[fi]
        let ii int = 0
        for ii < gs.p_imp_n {
            if (gs.p_imp_file[ii] != f || gs.p_imp_mod[ii] < 0) {
                ii += 1
                continue
            }
            if (mb_dep_push(gs.p_imp_mod[ii], gs.p_imp_off[ii],
                    gs.p_imp_len[ii]) < 0) {
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    let changed int = 1
    for changed != 0 {
        changed = 0
        let ei int = 0
        for ei < mb_dep_n {
            let em int = mb_dep_mod[ei]
            let efi int = 0
            for efi < gs.p_mods[em].file_n {
                let ef int = gs.p_mods[em].files[efi]
                let eii int = 0
                for eii < gs.p_imp_n {
                    if (gs.p_imp_file[eii] != ef || gs.p_imp_mod[eii] < 0) {
                        eii += 1
                        continue
                    }
                    let so int = -1
                    let sl int = 0
                    if (pj_mod_suffix(gs.p_mods[gs.p_imp_mod[eii]].proj,
                            gs.p_imp_mod[eii], &so, &sl) != 0) {
                        return -1
                    }
                    let pr int = mb_dep_push(gs.p_imp_mod[eii], so, sl)
                    if (pr < 0) {
                        return -1
                    }
                    if (pr == 1) {
                        changed = 1
                    }
                    eii += 1
                }
                efi += 1
            }
            ei += 1
        }
    }
    let si int = 0
    for si < mb_dep_n {
        let best int = si
        let bv int = mb_dep_order_rank(mb_dep_mod[si])
        if (bv < 0) {
            return gen.fail("内部错误：依赖模块不在拓扑序中")
        }
        let sj int = si + 1
        for sj < mb_dep_n {
            let rv int = mb_dep_order_rank(mb_dep_mod[sj])
            if (rv < 0) {
                return gen.fail("内部错误：依赖模块不在拓扑序中")
            }
            if (rv < bv) {
                best = sj
                bv = rv
            }
            sj += 1
        }
        if (best != si) {
            let t1 int = mb_dep_bind[si]
            mb_dep_bind[si] = mb_dep_bind[best]
            mb_dep_bind[best] = t1
            let t2 int = mb_dep_bindlen[si]
            mb_dep_bindlen[si] = mb_dep_bindlen[best]
            mb_dep_bindlen[best] = t2
            let t3 int = mb_dep_ifoff[si]
            mb_dep_ifoff[si] = mb_dep_ifoff[best]
            mb_dep_ifoff[best] = t3
            let tct int = mb_dep_ctoff[si]
            mb_dep_ctoff[si] = mb_dep_ctoff[best]
            mb_dep_ctoff[best] = tct
            let t4 int = mb_dep_mod[si]
            mb_dep_mod[si] = mb_dep_mod[best]
            mb_dep_mod[best] = t4
            let t5 int = mb_dep_mi[si]
            mb_dep_mi[si] = mb_dep_mi[best]
            mb_dep_mi[best] = t5
        }
        si += 1
    }
    let di int = 0
    for di < mb_dep_n {
        if (mb_mod_tag(mb_dep_mod[di], &pj_canon_off, &pj_canon_len) != 0) {
            return -1
        }
        let pbuf [760]u8
        let pn int = 0
        pn = gen.append_str(pbuf, pn, pj_pool_str(build_off))
        pn = gen.append_str(pbuf, pn, "/iface/")
        pn = gen.append_str(pbuf, pn, pj_pool_str(pj_canon_off))
        pn = gen.append_str(pbuf, pn, ".s.i")
        pbuf[pn] = 0
        let chosen *char = gen.arr_cstr(pbuf)
        let iface_session int = 0
        if (mb_iface_suffix != 0) {
            let session [760]u8
            let sn int = 0
            sn = gen.append_str(session, sn, gen.arr_cstr(pbuf))
            sn = gen.append_str(session, sn, mb_iface_suffix)
            session[sn] = 0
            let ready [760]u8
            let rn int = gen.append_str(&ready[0], 0, gen.arr_cstr(pbuf))
            rn = gen.append_str(&ready[0], rn, ".ready")
            rn = gen.append_str(&ready[0], rn, mb_iface_suffix)
            ready[rn] = 0
            if (pj_file_exists(gen.arr_cstr(&ready[0])) != 0
                && pj_file_exists(gen.arr_cstr(session)) != 0) {
                iface_session = 1
                pn = sn
                let k int = 0
                for k <= sn {
                    pbuf[k] = session[k]
                    k += 1
                }
            }
        }
        let po int = gen.tml_intern_str(chosen.to_type(*u8), 0, pn)
        if (po < 0) {
            return -1
        }
        mb_dep_ifoff[di] = po
        let ctpath [1000]u8
        if (mb_module_ctiface_plain_path(mb_dep_mod[di], build_off,
                build_len, ctpath) != 0) { return -1 }
        let ctn int = strlen(gen.arr_cstr(ctpath)).to_type(int)
        if (mb_iface_suffix != 0 && iface_session != 0) {
            let session_ct [1000]u8
            let csn int = gen.append_str(session_ct, 0,
                gen.arr_cstr(ctpath))
            csn = gen.append_str(session_ct, csn, mb_iface_suffix)
            session_ct[csn] = 0
            ctn = csn
            let k2 int = 0
            for k2 <= csn {
                ctpath[k2] = session_ct[k2]
                k2 += 1
            }
        }
        let cto int = gen.tml_intern_str(ctpath, 0, ctn)
        if (cto < 0) { return -1 }
        mb_dep_ctoff[di] = cto
        di += 1
    }
    return mb_dep_n
}

// mb_open_out：以宿主平台正确的旗标打开输出文件（覆盖写；交叉目标不影响
// 宿主文件操作，见 gen.tg_host_darwin）。
fn mb_open_out(path *char) int {
    let flg int = 0x241
    if (gen.tg_host_darwin() != 0) {
        flg = 0x601
    }
    return open(path, flg, 0x1a4)
}

// mb_compile_start：检查模块缓存；命中返回 1，否则启动 worker 并返回 0。
// root_off/len：项目根（调用方捕获的池偏移；函数内部 canon 会改写全局
// 游标，故由调用方先取好）。
fn mb_compile_start(m int, root_off int, root_len int, build_off int,
    build_len int, pid_out *int, key_out *u8) int {
    let gs *gen.GenState = gen.G()
    let sfx_off int = -1
    let sfx_len int = 0
    if (pj_mod_suffix(gs.p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1
    }
    let is_entry int = gs.p_mods[m].is_entry
    // 产物目录 = .build/asm/<tag>/（tag 含项目，防同名冲突；RS3b 起每模块
    // 一个目录，内含每文件 .s 与 <tag>.stub.s 运行时桩对象）
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1
    }
    let tag_off int = pj_canon_off
    if (pj_canon(build_off, build_len, "asm") != 0) {
        return -1
    }
    let asmdir [900]u8
    let an int = 0
    an = gen.append_str(asmdir, an, pj_pool_str(pj_canon_off))
    an = gen.append_byte(asmdir, an, '/')
    an = gen.append_str(asmdir, an, pj_pool_str(tag_off))
    asmdir[an] = 0
    let cache_artifact [1000]u8
    let artifact_path *char = 0
    let ignored_text [700]u8
    if (mb_llvm_module_paths(m, root_off, root_len, &cache_artifact[0],
            &ignored_text[0]) != 0) { return -1 }
    artifact_path = gen.arr_cstr(&cache_artifact[0])
    if (pj_canon(build_off, build_len, "iface") != 0) {
        return -1
    }
    let ipath [600]u8
    let in2 int = 0
    in2 = gen.append_str(ipath, in2, pj_pool_str(pj_canon_off))
    in2 = gen.append_byte(ipath, in2, '/')
    in2 = gen.append_str(ipath, in2, pj_pool_str(tag_off))
    in2 = gen.append_str(ipath, in2, ".s.i")
    ipath[in2] = 0
    let ctpath [600]u8
    let ctn int = 0
    ctn = gen.append_str(ctpath, ctn, pj_pool_str(pj_canon_off))
    ctn = gen.append_byte(ctpath, ctn, '/')
    ctn = gen.append_str(ctpath, ctn, pj_pool_str(tag_off))
    ctn = gen.append_str(ctpath, ctn, ".s.ct")
    ctpath[ctn] = 0
    let session_ipath [700]u8
    if (mb_module_iface_path(m, build_off, build_len, session_ipath) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(session_ipath))
    let session_ctpath [700]u8
    if (mb_module_ctiface_path(m, build_off, build_len, session_ctpath) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(session_ctpath))
    let session_ready [700]u8
    if (mb_module_ready_path(m, build_off, build_len, &session_ready[0]) != 0) {
        return -1
    }
    unlink(gen.arr_cstr(&session_ready[0]))
    if (pj_canon(build_off, build_len, "manifest") != 0) {
        return -1
    }
    let mpath [600]u8
    let mn int = 0
    mn = gen.append_str(mpath, mn, pj_pool_str(pj_canon_off))
    mn = gen.append_byte(mpath, mn, '/')
    mn = gen.append_str(mpath, mn, pj_pool_str(tag_off))
    mn = gen.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    // check 不读取或更新正式构建 manifest 与缓存。
    if (gs.task.c_check_only != 0) {
        if (mb_spawn_indexed_module(m, root_off, root_len,
                gen.arr_cstr(asmdir), 0, pid_out) != 0) {
            return gen.fail("无法启动项目检查 worker")
        }
        gs.c_stats_workers += 1
        return 0
    }
    // —— manifest 哈希（U5）——
    let h u64 = mb_hash_init()
    let hi int = 0
    for hi < sfx_len {
        mb_fnv(&h, gs.task.np_data[sfx_off + hi])
        hi += 1
    }
    mb_fnv(&h, ('0' + is_entry).to_type(u8))
    mb_fnv(&h, '\n')
    mb_fnv(&h, ('0' + gs.task.c_legacy_system).to_type(u8))
    mb_fnv(&h, '\n')
    let triple_i int = 0
        for gs.c_target.triple[triple_i] != 0 {
            mb_fnv(&h, gs.c_target.triple[triple_i].to_type(u8))
            triple_i += 1
        }
        mb_fnv(&h, 0)
        triple_i = 0
        for gs.c_target.data_layout[triple_i] != 0 {
            mb_fnv(&h, gs.c_target.data_layout[triple_i].to_type(u8))
            triple_i += 1
        }
        mb_fnv(&h, 0)
        triple_i = 0
        for gs.c_target.abi[triple_i] != 0 {
            mb_fnv(&h, gs.c_target.abi[triple_i].to_type(u8))
            triple_i += 1
        }
        mb_fnv(&h, ('0' + gs.c_opt_level).to_type(u8))
        let bridge_version *char = backend.llvm_bridge_version()
        triple_i = 0
        for bridge_version[triple_i] != 0 {
            mb_fnv(&h, bridge_version[triple_i].to_type(u8))
            triple_i += 1
        }
        let bridge_abi *char = "yh-llvm-bridge-abi1"
        triple_i = 0
        for bridge_abi[triple_i] != 0 {
            mb_fnv(&h, bridge_abi[triple_i].to_type(u8))
            triple_i += 1
        }
        if (gs.c_target.os == gen.TARGET_OS_DARWIN) {
            let min_os *char = cmd_darwin_min_os()
            if (min_os == 0) { return -1 }
            mb_fnv(&h, 0)
            triple_i = 0
            for min_os[triple_i] != 0 {
                mb_fnv(&h, min_os[triple_i].to_type(u8))
                triple_i += 1
            }
            mb_fnv(&h, 0)
            // Darwin 对象由桥按目标强制 PIC（见 llvm/bridge.c）；把重定位模式
            // 显式写入对象键，避免将来引入非 PIC 变体时旧对象误命中。
            mb_fnv(&h, 'P')
            mb_fnv(&h, 'I')
            mb_fnv(&h, 'C')
        }
    let fi int = 0
    for fi < gs.p_mods[m].file_n {
        if (mb_hash_file(&h, pj_pool_str(gs.p_files[gs.p_mods[m].files[fi]].path_off)) != 0) {
            return -1
        }
        fi += 1
    }
    // 依赖接口内容（解析结果变化 → 接口路径变化 → 哈希变化）
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1
    }
    let di int = 0
    for di < mb_dep_n {
        if (pj_file_exists(pj_pool_str(mb_dep_ifoff[di])) == 0
            || pj_file_exists(pj_pool_str(mb_dep_ctoff[di])) == 0) {
            // 依赖接口缺失：视为需要重编译
            di = mb_dep_n + 1
            break
        }
        if (mb_hash_file(&h, pj_pool_str(mb_dep_ifoff[di])) != 0
            || mb_hash_file(&h, pj_pool_str(mb_dep_ctoff[di])) != 0) {
            return -1
        }        di += 1
    }
    let deps_ok int = 1
    if (di == mb_dep_n + 1) {
        deps_ok = 0
    }
    // 编译器身份：对自身二进制 FNV（滚动代次下热缓存必需）
    if (mb_mix_compiler_fingerprint(&h) != 0) {
        return -1
    }
    // 版本标记
    let tag *char = "yh-iface-cache-3-ct"
    let ti int = 0
    for tag[ti] != 0 {
        mb_fnv(&h, tag[ti].to_type(u8))
        ti += 1
    }
    // 期望 manifest（十六进制串）
    let want [16]u8
    let wn int = 0
    let digits *char = "0123456789abcdef"
    let shift int = 60
    for shift >= 0 {
        want[wn] = digits[((h >> shift) & 15).to_type(int)].to_type(u8)
        wn += 1
        shift -= 4
    }
    // 缓存命中：三个产物齐全且 manifest 字节一致
    if (deps_ok != 0 && pj_file_exists(artifact_path) != 0
        && pj_file_exists(gen.arr_cstr(ipath)) != 0
        && pj_file_exists(gen.arr_cstr(ctpath)) != 0
        && pj_file_exists(gen.arr_cstr(mpath)) != 0) {
        let manifest_len int = 64
        if (gen.read_source(gen.arr_cstr(mpath)) == 0
            && gs.task.c_src_len == manifest_len) {
            let saved_manifest [64]u8
            let si int = 0
            for si < manifest_len { saved_manifest[si] = gs.task.c_src[si]; si += 1 }
            let same int = 1
            let ci int = 0
            for ci < wn {
                if (saved_manifest[ci] != want[ci]) {
                    same = 0
                    break
                }
                ci += 1
            }
            if (same != 0) {
                let object_hash u64 = mb_hash_init()
                let object_digest [16]u8
                if (mb_hash_file(&object_hash, artifact_path) != 0
                    || mb_object_machine_matches(artifact_path) == 0) {
                    same = 0
                } else {
                    mb_hash_hex(object_hash, object_digest)
                    ci = 0
                    for ci < 16 {
                        if (saved_manifest[16 + ci] != object_digest[ci]) {
                            same = 0
                            break
                        }
                        ci += 1
                    }
                }
                let iface_paths [2]*char
                iface_paths[0] = gen.arr_cstr(ipath)
                iface_paths[1] = gen.arr_cstr(ctpath)
                let fi2 int = 0
                for fi2 < 2 && same != 0 {
                    let iface_hash u64 = mb_hash_init()
                    let iface_digest [16]u8
                    if (mb_hash_file(&iface_hash, iface_paths[fi2]) != 0) {
                        same = 0
                    } else {
                        mb_hash_hex(iface_hash, iface_digest)
                        ci = 0
                        for ci < 16 {
                            if (saved_manifest[32 + fi2 * 16 + ci]
                                != iface_digest[ci]) {
                                same = 0
                                break
                            }
                            ci += 1
                        }
                    }
                    fi2 += 1
                }
            }
            if (same != 0) {
                pj_out_s("  [缓存] ")
                pj_out_np(gs.p_mods[m].name_off, gs.p_mods[m].name_len)
                pj_out_s("\n")
                return 1
            }
        }
    }
    // 缓存键随 worker 状态保存，只有完整编译成功后父进程才提交 manifest。
    let ki int = 0
    for ki < wn {
        key_out[ki] = want[ki]
        ki += 1
    }
    // —— 子进程编译（提供方项目根 + 主项目根） ——
    if (mb_spawn_indexed_module(m, root_off, root_len, gen.arr_cstr(asmdir),
            mb_compiler_fingerprint, pid_out) != 0) {
        return gen.fail("无法启动模块编译 worker")
    }
    gs.c_stats_workers += 1
    return 0
}

// mb_manifest_commit：worker 完整成功后原子提交模块缓存键。
fn mb_manifest_commit(m int, build_off int, build_len int, key *u8) int {
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1
    }
    let tag_off int = pj_canon_off
    if (pj_canon(build_off, build_len, "manifest") != 0) {
        return -1
    }
    let mpath [600]u8
    let mn int = 0
    mn = gen.append_str(mpath, mn, pj_pool_str(pj_canon_off))
    mn = gen.append_byte(mpath, mn, '/')
    mn = gen.append_str(mpath, mn, pj_pool_str(tag_off))
    mn = gen.append_str(mpath, mn, ".manifest")
    mpath[mn] = 0
    let tmp [700]u8
    let tn int = 0
    tn = gen.append_str(tmp, tn, gen.arr_cstr(mpath))
    tn = gen.append_str(tmp, tn, ".tmp.")
    tn = gen.append_int(tmp, tn, getpid())
    tmp[tn] = 0
    let fd int = mb_open_out(gen.arr_cstr(tmp))
    if (fd < 0) {
        return gen.fail_path("无法写 manifest: ", gen.arr_cstr(mpath))
    }
    let manifest_data [64]u8
    let manifest_len int = 16
    let ki int = 0
    for ki < 16 { manifest_data[ki] = key[ki]; ki += 1 }
    let object [700]u8
        let on int = gen.append_str(&object[0], 0, pj_pool_str(build_off))
        on = gen.append_str(&object[0], on, "/obj/")
        on = gen.append_str(&object[0], on, pj_pool_str(tag_off))
        on = gen.append_str(&object[0], on, ".o")
        object[on] = 0
        if (mb_object_machine_matches(gen.arr_cstr(&object[0])) == 0) {
            close(fd)
            unlink(gen.arr_cstr(tmp))
            return gen.fail("LLVM 对象缺失或目标架构错误，拒绝提交缓存")
        }
        let object_hash u64 = mb_hash_init()
        if (mb_hash_file(&object_hash, gen.arr_cstr(&object[0])) != 0) {
            close(fd)
            unlink(gen.arr_cstr(tmp))
            return -1
        }
        mb_hash_hex(object_hash, &manifest_data[16])
        let iface_path [2][700]u8
        let suffix *char = ".s.i"
        let fi2 int = 0
        for fi2 < 2 {
            if (fi2 == 1) { suffix = ".s.ct" }
            let in2 int = gen.append_str(&iface_path[fi2][0], 0,
                pj_pool_str(build_off))
            in2 = gen.append_str(&iface_path[fi2][0], in2, "/iface/")
            in2 = gen.append_str(&iface_path[fi2][0], in2,
                pj_pool_str(tag_off))
            in2 = gen.append_str(&iface_path[fi2][0], in2, suffix)
            iface_path[fi2][in2] = 0
            let iface_hash u64 = mb_hash_init()
            if (pj_file_exists(gen.arr_cstr(&iface_path[fi2][0])) == 0
                || mb_hash_file(&iface_hash,
                    gen.arr_cstr(&iface_path[fi2][0])) != 0) {
                close(fd)
                unlink(gen.arr_cstr(tmp))
                return gen.fail("LLVM 模块接口缺失，拒绝提交缓存")
            }
            mb_hash_hex(iface_hash, &manifest_data[32 + fi2 * 16])
            fi2 += 1
        }
        manifest_len = 64
    let rc int = gen.write_all(fd, &manifest_data[0], manifest_len)
    close(fd)
    if (rc != 0 || rename(gen.arr_cstr(tmp), gen.arr_cstr(mpath)) != 0) {
        unlink(gen.arr_cstr(tmp))
        return gen.fail_path("无法提交 manifest: ", gen.arr_cstr(mpath))
    }
    return 0
}

// mb_module_iface_plain_path：返回持久接口路径，不附加本轮后缀。
fn mb_module_iface_plain_path(m int, build_off int, build_len int,
    out *u8) int {
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
        return -1
    }
    let tag_off int = pj_canon_off
    if (pj_canon(build_off, build_len, "iface") != 0) {
        return -1
    }
    let n int = 0
    n = gen.append_str(out, n, pj_pool_str(pj_canon_off))
    n = gen.append_byte(out, n, '/')
    n = gen.append_str(out, n, pj_pool_str(tag_off))
    n = gen.append_str(out, n, ".s.i")
    out[n] = 0
    return 0
}

// mb_module_iface_path：返回本轮接口路径；后缀隔离并发构建会话。
fn mb_module_iface_path(m int, build_off int, build_len int, out *u8) int {
    let plain [700]u8
    if (mb_module_iface_plain_path(m, build_off, build_len, plain) != 0) {
        return -1
    }
    let n int = 0
    n = gen.append_str(out, n, gen.arr_cstr(plain))
    if (mb_iface_suffix != 0) {
        n = gen.append_str(out, n, mb_iface_suffix)
    }
    out[n] = 0
    return 0
}

// mb_module_ctiface_plain_path：返回持久 CT 正文接口路径。
fn mb_module_ctiface_plain_path(m int, build_off int, build_len int,
    out *u8) int {
    if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) { return -1 }
    let tag_off int = pj_canon_off
    if (pj_canon(build_off, build_len, "iface") != 0) { return -1 }
    let n int = 0
    n = gen.append_str(out, n, pj_pool_str(pj_canon_off))
    n = gen.append_byte(out, n, '/')
    n = gen.append_str(out, n, pj_pool_str(tag_off))
    n = gen.append_str(out, n, ".s.ct")
    out[n] = 0
    return 0
}

// mb_module_ctiface_path：返回带本轮会话后缀的 CT 正文接口路径。
fn mb_module_ctiface_path(m int, build_off int, build_len int,
    out *u8) int {
    let plain [700]u8
    if (mb_module_ctiface_plain_path(m, build_off, build_len, plain) != 0) {
        return -1
    }
    let n int = 0
    n = gen.append_str(out, n, gen.arr_cstr(plain))
    if (mb_iface_suffix != 0) {
        n = gen.append_str(out, n, mb_iface_suffix)
    }
    out[n] = 0
    return 0
}

// mb_module_ready_path：本轮接口就绪标记 <tag>.s.i.ready[suffix]。
// worker 先写 .s.ct、再写 .s.i、最后写 ready；父调度器只认 ready。
fn mb_module_ready_path(m int, build_off int, build_len int, out *u8) int {
    let plain [700]u8
    if (mb_module_iface_plain_path(m, build_off, build_len, plain) != 0) {
        return -1
    }
    let n int = 0
    n = gen.append_str(out, n, gen.arr_cstr(plain))
    n = gen.append_str(out, n, ".ready")
    if (mb_iface_suffix != 0) {
        n = gen.append_str(out, n, mb_iface_suffix)
    }
    out[n] = 0
    return 0
}

// mb_iface_write_ready：原子写就绪标记；内容只用于存在性，不参与身份。
fn mb_iface_write_ready(path *char) int {
    let tmp [800]u8
    let n int = 0
    n = gen.append_str(tmp, n, path)
    n = gen.append_str(tmp, n, ".tmp.")
    n = gen.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = mb_open_out(gen.arr_cstr(tmp))
    if (fd < 0) { return -1 }
    let data u8 = 49
    let wr int = gen.write_all(fd, &data, 1)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(gen.arr_cstr(tmp), path) != 0) {
        unlink(gen.arr_cstr(tmp))
        return -1
    }
    return 0
}

// mb_iface_ct_same：比较本轮 session CT 接口与持久 CT 接口内容。
// 返回 1 相同（允许早期启动），0 不同/缺失（等待依赖完成）。
fn mb_iface_ct_same(m int, build_off int, build_len int) int {
    let gs *gen.GenState = gen.G()
    let session [700]u8
    let plain [700]u8
    if (mb_module_ctiface_path(m, build_off, build_len, session) != 0
        || mb_module_ctiface_plain_path(m, build_off, build_len, plain) != 0) {
        return 0
    }
    // 没有 CT 正文（文件缺失/空）时不存在旧 CT 可复用，允许早期启动。
    if (pj_file_exists(gen.arr_cstr(session)) == 0) { return 1 }
    if (gen.read_source(gen.arr_cstr(session)) != 0) { return 0 }
    if (gs.task.c_src_len == 0) { return 1 }
    // 首次构建没有持久 CT，不存在可复用的旧值；session ready 已是新接口。
    if (pj_file_exists(gen.arr_cstr(plain)) == 0) { return 1 }
    if (gen.read_source(gen.arr_cstr(plain)) != 0) { return 0 }
    if (gs.task.c_src_len == 0) { return 0 }
    let hs u64 = mb_hash_init()
    let hp u64 = mb_hash_init()
    if (mb_hash_file(&hs, gen.arr_cstr(session)) != 0
        || mb_hash_file(&hp, gen.arr_cstr(plain)) != 0) { return 0 }
    return hs == hp ? 1 : 0
}

// mb_iface_copy_file：完整读取源接口，经同目录暂存后原子发布到目标路径。
fn mb_iface_copy_file(src *char, dst *char) int {
    let gs *gen.GenState = gen.G()
    if (gen.read_source(src) != 0) {
        return -1
    }
    let tmp [800]u8
    let n int = 0
    n = gen.append_str(tmp, n, dst)
    n = gen.append_str(tmp, n, ".tmp.")
    n = gen.append_int(tmp, n, getpid())
    tmp[n] = 0
    let fd int = mb_open_out(gen.arr_cstr(tmp))
    if (fd < 0) {
        return -1
    }
    let wr int = gen.write_all(fd, gs.task.c_src, gs.task.c_src_len)
    let cr int = close(fd)
    if (wr != 0 || cr != 0 || rename(gen.arr_cstr(tmp), dst) != 0) {
        unlink(gen.arr_cstr(tmp))
        return -1
    }
    return 0
}

// —— 子进程：--emit-module M ROOT -o out.s ——

// mb_file_head_bind：解析当前文件头并绑定导入（编译前每文件调用）。
// 先重置文件级导入表——pass 2 会对同一文件再次解析文件头。
fn mb_file_head_bind(fi int) int {
    let gs *gen.GenState = gen.G()
    // 绑定不再按名匹配：cmd 侧持有扫描期的解析结果（p_imp），按声明位置
    // （line/col）对应后把 ModInfo 下标直接写入 mod_import_mod。
    // 支持别名与跨项目 KEY.MOD 导入（解析结果与名字解耦）。
    parse.mod_reset_file()
    if (parse.mod_parse_head() != 0) {
        return -1
    }
    let i int = 0
    for i < gs.task.mod_import_n {
        let found int = -1
        let ii int = 0
        for ii < gs.p_imp_n {
            if (gs.p_imp_file[ii] == fi
                && gs.p_imp_line[ii] == gs.task.mod_imports[i].line
                && gs.p_imp_col[ii] == gs.task.mod_imports[i].col) {
                found = ii
                break
            }
            ii += 1
        }
        if (found < 0) {
            return gen.err_lc(gs.task.mod_imports[i].line, gs.task.mod_imports[i].col,
                "内部错误：导入与扫描记录不对应")
        }
        let target int = gs.p_imp_mod[found]
        let mi int = -1
        let di int = 0
        for di < mb_dep_n {
            if (mb_dep_mod[di] == target) {
                mi = mb_dep_base + di
                break
            }
            di += 1
        }
        if (mi < 0) {
            return gen.err_lc(gs.task.mod_imports[i].line, gs.task.mod_imports[i].col,
                "内部错误：导入的接口未加载")
        }
        gs.task.mod_import_mod[i] = mi
        gs.task.mod_import_used[i] = 0
        // 导入可只在全局初始化器中使用，而模块文件会在全局遍历与
        // 函数遍历之间重新绑定头部；按 token 快照保留整文件的限定引用。
        let ti int = 0
        for ti + 1 < gs.task.c_tok_n {
            if (gs.task.c_toks[ti].kind == gen.TOK_IDENT
                && gs.task.c_toks[ti].len == gs.task.mod_imports[i].alias_len
                && gs.task.c_toks[ti + 1].kind == gen.TK_DOT) {
                let same int = 1
                let j int = 0
                for j < gs.task.mod_imports[i].alias_len {
                    if (gs.task.c_src[gs.task.c_toks[ti].start + j]
                        != gs.task.np_data[gs.task.mod_imports[i].alias_off + j]) {
                        same = 0
                        break
                    }
                    j += 1
                }
                if (same != 0) {
                    gs.task.mod_import_used[i] = 1
                    break
                }
            }
            ti += 1
        }
        i += 1
    }
    return 0
}

// mb_pass1_file：pass 1 从只读词法快照登记一个源文件（含头解析与绑定）。
fn mb_pass1_file(path *char, fi int) int {
    let gs *gen.GenState = gen.G()
    if (gs.c_stats_enabled != 0) {
        gs.c_stats_pass1 += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    return parse.parse_indexed_decls(0)
}

// mb_restore_front_file：将当前解析器切换到项目索引时保存的只读快照。
fn mb_restore_front_file(path *char, fi int) int {
    let gs *gen.GenState = gen.G()
    if (gs.c_front_cache == 0 || gs.p_files[fi].source == 0
        || gs.p_files[fi].tokens == 0) {
        return gen.fail("内部错误：模块 worker 缺少前端文件快照")
    }
    gs.task.c_src = gs.p_files[fi].source
    gs.task.c_src_len = gs.p_files[fi].source_len
    gs.task.c_toks = gs.p_files[fi].tokens
    gs.task.c_tok_n = gs.p_files[fi].token_n
    gs.task.c_tok_cap = gs.p_files[fi].token_n
    gs.task.c_file_decls = gs.p_files[fi].decls
    gs.task.c_file_decl_n = gs.p_files[fi].decl_n
    gs.task.c_file_decl_i = -1
    gs.task.c_file_indexed = 1
    gs.task.c_active_file = fi
    gs.task.c_pos = 0
    if (gen.set_source_path(path) != 0) {
        return -1
    }
    gs.task.c_spec = 0
    gs.task.c_ctx_block = 0
    return 0
}

// mb_pass2_file：复用模块文件快照执行全局、CT 捕获/布局常量子遍或函数子遍。
// 1 全局初始化，2 CT 正文捕获，3 布局请求登记，4 布局 const 求值，0 普通函数。
fn mb_pass2_file(path *char, fi int, is_globals int) int {
    let gs *gen.GenState = gen.G()
    if (is_globals == 1 && gs.c_stats_enabled != 0) {
        gs.c_stats_globals += 1
    }
    if (is_globals == 0 && gs.c_stats_enabled != 0) {
        gs.c_stats_functions += 1
    }
    if (mb_restore_front_file(path, fi) != 0) {
        return -1
    }
    if (mb_file_head_bind(fi) != 0) {
        return -1
    }
    if (is_globals != 0) {
        if (is_globals == 2) {
            if (parse.parse_source_ct_fns() != 0) { return -1 }
        } else if (is_globals == 3) {
            if (parse.parse_source_ct_layout_register() != 0) { return -1 }
        } else if (is_globals == 4) {
            if (parse.parse_source_ct_layout_consts() != 0) { return -1 }
        } else if (parse.parse_source_globals() != 0) {
            return -1
        }
    } else {
        if (parse.parse_source_fns() != 0) {
            return -1
        }
        // 未使用导入检查（U3）：本文件编译完后仍为零使用的导入报错
        let i int = 0
        for i < gs.task.mod_import_n {
            if (gs.task.mod_import_used[i] == 0) {
                return gen.err_lc(gs.task.mod_imports[i].line, gs.task.mod_imports[i].col,
                    "导入未使用（同文件没有任何限定名引用）")
            }
            i += 1
        }
    }
    return 0
}

// mb_check_binding_clash：导入名与本模块顶层声明重名检查（pass1 后）。
// 遍历模块全部文件的导入，逐个查全局符号表。
fn mb_check_binding_clash(m int) int {
    let gs *gen.GenState = gen.G()
    let fi int = 0
    for fi < gs.p_mods[m].file_n {
        let f int = gs.p_mods[m].files[fi]
        let ii int = 0
        for ii < gs.p_imp_n {
            if (gs.p_imp_file[ii] != f) {
                ii += 1
                continue
            }
            let idx int = gen.sym_lookup_off(gs.p_imp_off[ii], gs.p_imp_len[ii])
            if (idx >= 0 && (gs.task.c_syms[idx].flags & gen.F_GLOBAL) != 0
                && (gs.task.c_syms[idx].flags & gen.F_EXTERN) == 0) {
                let buf [192]u8
                let n int = 0
                n = gen.append_int(buf, n, gs.task.c_syms[idx].def_line)
                n = gen.append_byte(buf, n, ':')
                n = gen.append_int(buf, n, gs.task.c_syms[idx].def_col)
                n = gen.append_str(buf, n, ": 顶层声明与导入名冲突（导入名 ")
                n = append_bytes_np(buf, n, gs.p_imp_off[ii], gs.p_imp_len[ii])
                n = gen.append_str(buf, n, "）")
                let mo int = gen.tml_intern_str(buf, 0, n)
                if (mo < 0) {
                    return -1
                }
                gs.task.c_errors += 1
                let out [256]u8
                let on int = 0
                on = gen.append_str(out, on, pj_pool_str(gs.p_files[f].path_off))
                on = gen.append_byte(out, on, ':')
                on = append_bytes_np(out, on, mo, n)
                on = gen.append_byte(out, on, '\n')
                gen.write_all(2, out, on)
                return -1
            }
            ii += 1
        }
        fi += 1
    }
    return 0
}

// mb_emit_module：子进程入口——编译一个模块为按文件汇编 + 接口；check-only
// 复用语义遍历并只写本轮依赖需要的临时接口。
// prov_root：模块提供方项目根（在其中查找模块）；main_root：主项目根
// （构建目录基准，接口路径与父进程一致）；out_dir：按文件汇编目录
// <build>/asm/<tag>（RS3b）。
fn mb_emit_module(mod_off int, mod_len int, prov_off int, prov_len int,
    main_off int, main_len int, out_dir *char, ir_cache_salt u64) int {
    let gs *gen.GenState = gen.G()
    gs.c_front_cache = 1
    gs.task.c_ast_capture = 0
    gs.c_ir_cache_salt = ir_cache_salt
    if (mb_load_stdlib() != 0) {
        return -1
    }
    let proj int = pj_load_project(prov_off, prov_len)
    if (proj < 0) {
        return -1
    }
    if (pj_bind_imports() != 0) {
        return -1
    }
    let m int = pj_mod_in_proj(proj, mod_off, mod_len)
    if (m < 0) {
        return gen.fail("内部错误：模块不在索引中")
    }
    return mb_emit_indexed_module(m, main_off, main_len, out_dir, ir_cache_salt)
}

// —— 父进程：build / run ——

// mb_print_stats：开发验收时输出当前进程的阶段计数；默认构建保持静默。
fn mb_print_stats() void {
    let gs *gen.GenState = gen.G()
    if (gs.c_stats_enabled == 0) {
        return
    }
    let buf [1024]u8
    let n int = 0
    n = gen.append_str(buf, n, "yh-stats lex=")
    n = gen.append_int(buf, n, gs.c_stats_lex)
    n = gen.append_str(buf, n, " syntax=")
    n = gen.append_int(buf, n, gs.c_stats_syntax)
    n = gen.append_str(buf, n, " index=")
    n = gen.append_int(buf, n, gs.c_stats_index)
    n = gen.append_str(buf, n, " pass1=")
    n = gen.append_int(buf, n, gs.c_stats_pass1)
    n = gen.append_str(buf, n, " globals=")
    n = gen.append_int(buf, n, gs.c_stats_globals)
    n = gen.append_str(buf, n, " functions=")
    n = gen.append_int(buf, n, gs.c_stats_functions)
    n = gen.append_str(buf, n, " ir_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_functions)
    n = gen.append_str(buf, n, " ir_cache_hits=")
    n = gen.append_int(buf, n, gs.c_stats_ir_cache_hits)
    n = gen.append_str(buf, n, " ir_cache_misses=")
    n = gen.append_int(buf, n, gs.c_stats_ir_cache_misses)
    n = gen.append_str(buf, n, " ir_lowered=")
    n = gen.append_int(buf, n, gs.c_stats_ir_lowered)
    n = gen.append_str(buf, n, " ast_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_nodes)
    n = gen.append_str(buf, n, " stmt_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_stmt_nodes)
    n = gen.append_str(buf, n, " decl_nodes=")
    n = gen.append_int(buf, n, gs.task.c_stats_decl_nodes)
    n = gen.append_str(buf, n, " ast_refs=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_refs)
    n = gen.append_str(buf, n, " ast_bindings=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_bindings)
    n = gen.append_str(buf, n, " ast_functions=")
    n = gen.append_int(buf, n, gs.task.c_stats_ast_functions)
    n = gen.append_str(buf, n, " workers=")
    n = gen.append_int(buf, n, gs.c_stats_workers)
    n = gen.append_str(buf, n, " workers_peak=")
    n = gen.append_int(buf, n, mb_sched_peak)
    n = gen.append_str(buf, n, " iface_early=")
    n = gen.append_int(buf, n, mb_sched_iface_early)
    n = gen.append_str(buf, n, " asm=")
    n = gen.append_int(buf, n, gs.c_stats_asm)
    n = gen.append_str(buf, n, " link=")
    n = gen.append_int(buf, n, gs.c_stats_link)
    n = gen.append_str(buf, n, " compiler_hashes=")
    n = gen.append_int(buf, n, gs.c_stats_compiler_hashes)
    n = gen.append_str(buf, n, " time_project_ns=")
    n = gen.append_i64(buf, n, mb_stats_project_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_schedule_ns=")
    n = gen.append_i64(buf, n, mb_stats_schedule_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_object_ns=")
    n = gen.append_i64(buf, n, mb_stats_object_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_link_ns=")
    n = gen.append_i64(buf, n, mb_stats_link_ns.to_type(i64))
    n = gen.append_str(buf, n, " time_total_ns=")
    let total_ns u64 = 0
    if (mb_stats_build_start_ns != 0) {
        let now u64 = cmd_clock_ns()
        if (now >= mb_stats_build_start_ns) {
            total_ns = now - mb_stats_build_start_ns
        }
    }
    n = gen.append_i64(buf, n, total_ns.to_type(i64))
    // 新覆盖字段追加在原统计行尾，保留已有性能工具的字段顺序和含义。
    n = gen.append_str(buf, n, " checked_functions=")
    n = gen.append_int(buf, n, gs.c_stats_checked_functions)
    n = gen.append_str(buf, n, " backend_emitted_functions=")
    n = gen.append_int(buf, n, gs.c_stats_backend_emitted)
    n = gen.append_str(buf, n, " rejected_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_rejected)
    n = gen.append_str(buf, n, " backend_rejected_functions=")
    n = gen.append_int(buf, n, gs.c_stats_backend_rejected)
    n = gen.append_str(buf, n, " fallback_functions=")
    n = gen.append_int(buf, n, gs.c_stats_ir_rejected + gs.c_stats_backend_rejected)
    n = gen.append_str(buf, n, " check_cache_hits=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_hits)
    n = gen.append_str(buf, n, " check_cache_misses=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_misses)
    n = gen.append_str(buf, n, " check_skipped=")
    n = gen.append_int(buf, n, gs.c_stats_check_cache_skipped)
    n = gen.append_byte(buf, n, '\n')
    gen.write_all(2, buf, n)
}

// mb_intern_arg：命令行参数字符串入名字池，返回偏移（长度出参）。
fn mb_intern_arg(s *char, olen *int) int {
    let sl int = 0
    for s[sl] != 0 {
        sl += 1
    }
    olen[0] = sl
    return gen.tml_intern_str(s.to_type(*u8), 0, sl)
}

// mb_try_default_stdlib：尝试 dir+suffix 下的标准库项目。
// 返回 1 表示已装载，0 表示该候选不存在，-1 表示候选存在但装载失败。
// 只接受带 project.toml 的目录；不猜测库名，也不把任意模块目录当标准库。
fn mb_try_default_stdlib(dir *char, suffix *char) int {
    let gs *gen.GenState = gen.G()
    let path [1200]u8
    let n int = 0
    n = gen.append_str(path, n, dir)
    n = gen.append_str(path, n, suffix)
    path[n] = 0
    if (pj_canon(0, 0, gen.arr_cstr(path)) != 0) {
        return 0
    }
    let cand_off int = pj_canon_off
    let cand_len int = pj_canon_len
    let manifest [1200]u8
    let mn int = 0
    let i int = 0
    for i < cand_len {
        manifest[mn] = gs.task.np_data[cand_off + i]
        mn += 1
        i += 1
    }
    mn = gen.append_str(manifest, mn, "/project.toml")
    manifest[mn] = 0
    if (pj_file_exists(gen.arr_cstr(manifest)) == 0) {
        return 0
    }
    let loaded int = pj_load_project(cand_off, cand_len)
    if (loaded < 0) {
        return -1
    }
    gs.p_stdlib = loaded
    return 1
}

// mb_load_default_stdlib：按可执行文件附近布局查找标准库。
// 依次尝试 <exe_dir>/libs（仓库构建）、<exe_dir>/../libs（bin 下种子）
// 与 <exe_dir>/../share/yh/libs（安装布局）。找不到时保持无标准库层；
// 找到但项目损坏时返回 -1，不静默回退到其它候选。
fn mb_load_default_stdlib() int {
    let gs *gen.GenState = gen.G()
    if (mb_resolve_self_path() != 0) {
        return 0
    }
    let self_len int = strlen(mb_self_path).to_type(int)
    let cut int = self_len
    for cut > 0 && mb_self_path[cut - 1] != '/' {
        cut -= 1
    }
    let dir [1200]u8
    let dn int = 0
    if (cut > 1) {
        let i int = 0
        for i < cut - 1 {
            dir[dn] = mb_self_path[i].to_type(u8)
            dn += 1
            i += 1
        }
    } else if (cut == 1) {
        dir[0] = '/'
        dn = 1
    } else {
        dir[0] = '.'
        dn = 1
    }
    dir[dn] = 0
    let found int = mb_try_default_stdlib(gen.arr_cstr(dir), "/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(gen.arr_cstr(dir), "/../libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    found = mb_try_default_stdlib(gen.arr_cstr(dir), "/../share/yh/libs")
    if (found != 0) {
        return found < 0 ? -1 : 0
    }
    gs.p_stdlib = -1
    return 0
}

// mb_load_stdlib：装载 YH_STDLIB 指定的标准库项目。
// YH_STDLIB 非空时优先且失败不回退；为空/未设置时按可执行文件附近布局
// 查找默认标准库（仓库 <root>/libs、bin 种子相邻 libs 或安装 share/yh/libs）。
fn mb_load_stdlib() int {
    let gs *gen.GenState = gen.G()
    if (gs.p_stdlib >= 0) {
        return 0
    }
    let off int = -1
    let olen int = 0
    if (pj_env_fetch("YH_STDLIB", &off, &olen) < 0) {
        return -1
    }
    if (olen == 0) {
        return mb_load_default_stdlib()
    }
    if (pj_canon(0, 0, pj_pool_str(off)) != 0) {
        return -1
    }
    let s int = pj_load_project(pj_canon_off, pj_canon_len)
    if (s < 0) {
        return -1
    }
    gs.p_stdlib = s
    return 0
}

// pj_topo_multi：库模式——从项目每个模块出发收集依赖序。
fn pj_topo_multi(proj int) int {
    let gs *gen.GenState = gen.G()
    if (pj_topo(gs.p_projs[proj].mods[0]) < 0) {
        return -1
    }
    let i int = 1
    for i < gs.p_projs[proj].mod_n {
        if (pj_mark[gs.p_projs[proj].mods[i]] != 2) {
            if (pj_dfs(gs.p_projs[proj].mods[i]) != 0) {
                return -1
            }
        }
        i += 1
    }
    return pj_order_n
}

// mb_cmd_build：构建项目；可选 --stats 输出当前构建与模块 worker 计数。
// argc/argv 已剥离程序名；由 build/check 命令共用。
fn mb_cmd_build(av **char, an int) int {
    let gs *gen.GenState = gen.G()
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    let out_arg *char = 0
    let mod_arg_off int = -1
    let mod_arg_len int = 0
    let mod_arg_n int = 0
    li_select_reset()
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--stats") != 0) {
            gs.c_stats_enabled = 1
            i += 1
            continue
        }
        if (gen.cstr_eq(av[i], "--link") != 0) {
            if (i + 1 >= an || av[i + 1][0] == 0) {
                usage()
                gen.fail("--link 需要一个组名")
                return 2
            }
            let link_arg *char = av[i + 1]
            let ll int = 0
            for link_arg[ll] != 0 { ll += 1 }
            let lo int = gen.tml_intern_str(link_arg.to_type(*u8), 0, ll)
            if (lo < 0) { return -1 }
            if (pl_group_name_ok(lo, ll) == 0) {
                usage()
                gen.fail("--link 组名只能包含字母、数字、_、-")
                return 2
            }
            if (li_select_add(lo, ll) != 0) { return -1 }
            i += 2
            continue
        }
        if (gen.cstr_eq(av[i], "-o") != 0) {
            if (i + 1 >= an) {
                usage()
                gen.fail("-o 需要一个输出路径")
                return 2
            }
            out_arg = av[i + 1]
            i += 2
            continue
        }
        if (av[i][0] == '-') {
            usage()
            gen.fail_path("未知的项目构建选项: ", av[i])
            return 2
        }
        // 模块参数：只允许一个，避免最后一个静默覆盖。
        let sl int = 0
        for av[i][sl] != 0 { sl += 1 }
        let mo int = gen.tml_intern_str(av[i].to_type(*u8), 0, sl)
        if (mo < 0) { return -1 }
        if (mod_arg_n > 0) {
            usage()
            gen.fail("yh build 只能指定一个模块")
            return 2
        }
        mod_arg_off = mo
        mod_arg_len = sl
        mod_arg_n += 1
        i += 1
    }
    if (gs.task.c_check_only != 0 && li_select_count() > 0) {
        usage()
        gen.fail("yh check 不支持 --link")
        return 2
    }
    mb_stats_build_start_ns = 0
    mb_stats_project_ns = 0
    mb_stats_schedule_ns = 0
    mb_stats_object_ns = 0
    mb_stats_link_ns = 0
    if (gs.c_stats_enabled != 0) {
        mb_stats_build_start_ns = cmd_clock_ns()
    }
    gs.task.c_path = "yh"
    // 父进程建立可继承的只读前端快照，fork worker 不再重扫项目源码。
    gs.c_front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root int = pj_find_root(0)
    if (root < 0) {
        return 1
    }
    // 捕获根路径（后续 canon 调用会改写全局游标）
    let root_off int = pj_canon_off
    let root_len int = pj_canon_len
    pj_set_root_project(root_off, root_len)
    let proj int = pj_load_project(root_off, root_len)
    if (proj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    // 构建根：显式模块参数 > 名为 main 的入口模块 > 库模式
    let rootmod int = -1
    if (mod_arg_off >= 0) {
        rootmod = pj_mod_in_proj(proj, mod_arg_off, mod_arg_len)
        if (rootmod < 0) {
            let buf [128]u8
            let n int = 0
            n = gen.append_str(buf, n, "本项目没有模块: ")
            n = append_bytes_np(buf, n, mod_arg_off, mod_arg_len)
            let mo4 int = gen.tml_intern_str(buf, 0, n)
            if (mo4 < 0) {
                return -1
            }
            return gen.fail(gen.np_cstr(mo4))
        }
    } else {
        rootmod = pj_entry_mod(proj)
    }
    if (rootmod < 0 && li_select_count() > 0) {
        usage()
        gen.fail("库项目没有可链接产物，--link 不适用")
        return 2
    }
    // topo（依赖序）
    let count int = 0
    if (rootmod >= 0) {
        count = pj_topo(rootmod)
        if (count < 0) {
            return 1
        }
    } else {
        count = pj_topo_multi(proj)
        if (count < 0) {
            return 1
        }
    }
    // 构建目录
    let build_off int = mb_build_dir(root_off, root_len)
    if (build_off < 0) {
        return 1
    }
    let build_len int = pj_canon_len
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1
    }
    if (gs.c_stats_enabled != 0) {
        mb_stats_project_ns = cmd_clock_ns() - mb_stats_build_start_ns
    }
    let schedule_start_ns u64 = 0
    if (gs.c_stats_enabled != 0) {
        schedule_start_ns = cmd_clock_ns()
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        if (gs.task.c_check_only != 0) {
            mb_check_clear_ifaces(build_off, build_len, count)
        }
        return 1
    }
    if (gs.c_stats_enabled != 0) {
        mb_stats_schedule_ns = cmd_clock_ns() - schedule_start_ns
    }
    if (gs.task.c_check_only != 0) {
        mb_check_clear_ifaces(build_off, build_len, count)
        pj_out_s("检查通过: ")
        pj_out_np(gs.p_projs[proj].name_off, gs.p_projs[proj].name_len)
        pj_out_s("\n")
        mb_print_stats()
        return 0
    }
    // 链接（有入口时）
    if (rootmod >= 0) {
        let outbuf [620]u8
        let on int = 0
        if (out_arg != 0) {
            on = gen.append_str(outbuf, on, out_arg)
        } else {
            // 无 -o：产物名取清单 project.name
            if (mb_default_binary_path(root_off, root_len, build_off,
                    proj, &outbuf[0]) < 0) { return 1 }
            on = 0
            for outbuf[on] != 0 { on += 1 }
        }
        outbuf[on] = 0
        if (mb_link(gen.arr_cstr(outbuf), build_off, build_len, count, proj) != 0) {
            return 1
        }
        pj_out_s("构建完成: ")
        pj_out_s(gen.arr_cstr(outbuf))
        pj_out_s("\n")
        mb_print_stats()
        return 0
    }
    pj_out_s("库构建完成（模块对象与接口在 ")
    pj_out_np(build_off, build_len)
    pj_out_s("）\n")
    mb_print_stats()
    return 0
}

// mb_cmd_run：yh run——构建清单 entry 并运行，返回程序退出码。
// 支持与 build 相同的 --link 组选择；跨目标在本机运行前明确拒绝。
fn mb_cmd_run(av **char, an int) int {
    let gs *gen.GenState = gen.G()
    if (mb_resolve_self_path() != 0) {
        return 1
    }
    li_select_reset()
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--stats") != 0) {
            gs.c_stats_enabled = 1
            i += 1
            continue
        }
        if (gen.cstr_eq(av[i], "--link") != 0) {
            if (i + 1 >= an || av[i + 1][0] == 0) {
                usage()
                gen.fail("--link 需要一个组名")
                return 2
            }
            let link_arg *char = av[i + 1]
            let ll int = 0
            for link_arg[ll] != 0 { ll += 1 }
            let lo int = gen.tml_intern_str(link_arg.to_type(*u8), 0, ll)
            if (lo < 0) { return -1 }
            if (pl_group_name_ok(lo, ll) == 0) {
                usage()
                gen.fail("--link 组名只能包含字母、数字、_、-")
                return 2
            }
            if (li_select_add(lo, ll) != 0) { return -1 }
            i += 2
            continue
        }
        usage()
        gen.fail_path("yh run 未知参数: ", av[i])
        return 2
    }
    gs.task.c_path = "yh"
    gs.c_front_cache = 1
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root int = pj_find_root(0)
    if (root < 0) {
        return 1
    }
    let root_off int = pj_canon_off
    let root_len int = pj_canon_len
    pj_set_root_project(root_off, root_len)
    let proj int = pj_load_project(root_off, root_len)
    if (proj < 0) {
        return 1
    }
    if (gen.target_matches_host() == 0) {
        return gen.fail("yh run 的目标平台必须与宿主一致；跨目标请用 yh build")
    }
    if (pj_entry_mod(proj) < 0) {
        return gen.fail("库项目没有入口，无法 run（需要一个 module main;）")
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    let rootmod int = pj_entry_mod(proj)
    let count int = pj_topo(rootmod)
    if (count < 0) {
        return 1
    }
    let build_off int = mb_build_dir(root_off, root_len)
    if (build_off < 0) {
        return 1
    }
    let build_len int = pj_canon_len
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1
    }
    if (mb_schedule_modules(count, root_off, root_len, build_off, build_len) != 0) {
        return 1
    }
    let binbuf [620]u8
    let bn int = mb_default_binary_path(root_off, root_len, build_off,
        proj, &binbuf[0])
    if (bn < 0) { return 1 }
    if (mb_link(gen.arr_cstr(binbuf), build_off, build_len, count, proj) != 0) {
        return 1
    }
    if (li_apply_runtime_env() != 0) { return 1 }
    // 运行（继承 stdout/stderr；退出码由 waitpid 状态字解码）。
    let args [2]*char
    args[0] = gen.arr_cstr(binbuf)
    args[1] = 0.to_type(*char)
    let rc int = cmd_process_run(&args[0])
    return rc < 0 ? 1 : rc
}

// mb_print_version：打印当前项目的 name 与 version（清单 project.version
// 缺省时标注未声明）。quiet=1 时找不到项目静默返回（usage 顺手显示）。
fn mb_print_version(quiet int) int {
    let gs *gen.GenState = gen.G()
    let root int = pj_find_root(quiet)
    if (root < 0) {
        return 1
    }
    let root_off int = pj_canon_off
    let root_len int = pj_canon_len
    let proj int = pj_load_project(root_off, root_len)
    if (proj < 0) {
        return 1
    }
    pj_out_np(gs.p_projs[proj].name_off, gs.p_projs[proj].name_len)
    if (gs.p_projs[proj].ver_off >= 0) {
        pj_out_s(" ")
        pj_out_np(gs.p_projs[proj].ver_off, gs.p_projs[proj].ver_len)
    } else {
        pj_out_s(" (未声明 version)")
    }
    pj_out_s("\n")
    return 0
}

// mb_cmd_list：yh list [--resolve name]。
fn mb_cmd_list(av **char, an int) int {
    let gs *gen.GenState = gen.G()
    let resolve_off int = -1
    let resolve_len int = 0
    let has_resolve int = 0
    let i int = 1
    for i < an {
        if (gen.cstr_eq(av[i], "--link") != 0) {
            usage()
            gen.fail("yh list 不支持 --link")
            return 2
        }
        if (gen.cstr_eq(av[i], "--resolve") != 0 && i + 1 < an) {
            let sl int = 0
            for av[i + 1][sl] != 0 {
                sl += 1
            }
            let mo int = gen.tml_intern_str(av[i + 1].to_type(*u8), 0, sl)
            if (mo < 0) {
                return -1
            }
            resolve_off = mo
            resolve_len = sl
            has_resolve = 1
            i += 2
            continue
        }
        usage()
        return 2
    }
    gs.task.c_path = "yh"
    if (mb_load_stdlib() != 0) {
        return 1
    }
    let root int = pj_find_root(0)
    if (root < 0) {
        return 1
    }
    let root_off int = pj_canon_off
    let root_len int = pj_canon_len
    pj_set_root_project(root_off, root_len)
    let proj int = pj_load_project(root_off, root_len)
    if (proj < 0) {
        return 1
    }
    if (pj_bind_imports() != 0) {
        return 1
    }
    return pj_cmd_list(proj, resolve_off, resolve_len, has_resolve)
}
