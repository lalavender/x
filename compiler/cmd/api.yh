module main
import gen
import proj
import testkit
import build
import ast
import lex
import parse

// ============================================================================
// api.yh —— 编译器调用面（A3）：driver 只做 argv → 请求映射，执行都在这里。
//   单文件：api_single_file(path, form, out)  语法/检查/汇编/LLVM 文本/可执行
//   项目：  api_build / api_run / api_test / api_list / api_version
//   内部：  api_emit_module（--emit-module 子进程协议）
// 契约：返回 0 成功、1 源/语义错误、2 用法错误、-1 内部或桥失败；诊断写 fd 2；
// 单文件各形态共用 api_open_source 前奏与 build.llvm_check_single_file 受检前端。
// 项目命令委托 build/main 侧实现——A2c 搬迁时只改本文件的前缀。
// ============================================================================

// —— 单文件形态 ——
const API_SYNTAX int = 1      // 只做词法/语法检查
const API_CHECK int = 2       // 完整前端检查，不要求 main
const API_ASM int = 3         // 目标汇编到标准输出
const API_LLVM_TEXT int = 4   // LLVM 文本到标准输出（--emit-llvm）
const API_EXE int = 5         // 编译并链接为可执行文件

// api_open_source：单文件形态共用前奏——登记路径、读源、建语义表。
// 调用方必须先执行 gen.state_init() + proj.init() + gen.bind_cfg(proj.cfg())
// （driver 入口已做，目标/配置的存储自 B1-2 起在 proj）。
fn api_open_source(path *char) int {
    let gs *gen.TaskCtx = gen.task()
    gs.c_path = path
    if (gen.read_source(path) != 0) {
        return 1
    }
    if (gen.sem_init_tables() != 0) {
        return 1
    }
    return 0
}

// api_single_file：单文件所有形态的唯一入口。
// out_path 仅在 API_EXE 时使用；其余形态传 0。
fn api_single_file(path *char, form int, out_path *char) int {
    let gs *gen.TaskCtx = gen.task()
    if (api_open_source(path) != 0) {
        return 1
    }
    if (form == API_SYNTAX) {
        if (lex.lex_all() != 0) { return 1 }
        if (parse.parse_source() != 0) { return 1 }
        if (gs.c_errors > 0) { return 1 }
        return 0
    }
    if (form == API_CHECK) {
        // 库文件不要求 main；失败保留受检前端写的原诊断。
        gs.c_check_only = 1
        let checked ast.CheckedModule
        let status int = build.llvm_check_single_file(path, 0, &checked)
        if (status != 0) { return status }
        ast.checked_module_release(&checked)
        let output [32]u8
        let n int = gen.append_str(output, 0, "检查通过\n")
        return gen.write_all(1, output, n) == 0 ? 0 : 1
    }
    let rc int = 0
    if (form == API_ASM) {
        // 汇编：out="-"、kind=1，由桥产出汇编文本再回显。
        rc = build.llvm_emit_single_file(path, "-", 1, 0, 0)
    } else if (form == API_LLVM_TEXT) {
        // 只写 LLVM 文本：out 为空 = 不发布产物，text="-" 写标准输出。
        rc = build.llvm_emit_single_file(path, 0.to_type(*char), 0, "-", 0)
    } else if (form == API_EXE) {
        rc = build.llvm_emit_single_file(path, out_path, 0, proj.cfg().emit_text_path, 1)
    } else {
        return 2
    }
    if (rc == 0) { build.mb_print_stats() }
    return rc
}

// —— 项目命令 ——

// api_build：yh build / yh check [module]（后者由 driver 置 c_check_only）。
pub fn api_build(av **char, n int) int {
    return build.mb_cmd_build(av, n)
}

// api_run：构建后运行 main 模块。
pub fn api_run(av **char, n int) int {
    return build.mb_cmd_run(av, n)
}

// api_test：语言内测试执行器。
pub fn api_test(av **char, n int) int {
    return testkit.mb_run_test_command(av, n)
}

// api_list：列出模块或解释导入绑定。
pub fn api_list(av **char, n int) int {
    return build.mb_cmd_list(av, n)
}

// api_version：项目版本，或 `--contracts` 的契约版本集合（不要求项目）。
pub fn api_version(av **char, n int) int {
    if (n == 2 && gen.cstr_eq(av[1], "--contracts") != 0) {
        return build.mb_print_contracts()
    }
    return build.mb_print_version(0)
}

// api_emit_module：内部子进程协议 `--emit-module <mod> <prov> <root> -o <dir>`。
// 参数已由 driver 规整为 av[1..5]，其余选项在 av[6..n)。
pub fn api_emit_module(av **char, n int) int {
    let gs *gen.TaskCtx = gen.task()
    let cache_salt u64 = 0
    let fi int = 6
    for fi < n {
        if (gen.cstr_eq(av[fi], "--stats") != 0) {
            gen.stats().enabled = 1
        } else if (gen.cstr_eq(av[fi], "--check-only") != 0) {
            gs.c_check_only = 1
        } else if (gen.cstr_eq(av[fi], "--ir-key") != 0 && fi + 1 < n) {
            if (build.mb_parse_hex(av[fi + 1], &cache_salt) != 0) {
                return 2
            }
            fi += 1
        } else if (gen.cstr_eq(av[fi], "--iface-suffix") != 0 && fi + 1 < n) {
            build.mb_set_iface_suffix(av[fi + 1])
            fi += 1
        } else {
            return 2
        }
        fi += 1
    }
    let mlen int = 0
    let rlen int = 0
    let blen int = 0
    let mo int = build.mb_intern_arg(av[1], &mlen)
    let ro int = build.mb_intern_arg(av[2], &rlen)
    let bo int = build.mb_intern_arg(av[3], &blen)
    if (mo < 0 || ro < 0 || bo < 0) {
        return 1
    }
    return build.mb_emit_module(mo, mlen, ro, rlen, bo, blen, av[5], cache_salt)
}
