module main;
import gen;
import lex;
import parse;

// ============================================================================
// project_index.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn pj_load_project(root_off int, root_len int) int {
    let gs *gen.GenState = gen.G();
    // 依赖环 / 重复装载
    let known int = pj_proj_find_root(root_off, root_len);
    if (known >= 0) {
        if (gs.p_state[known] == 1) {
            pj_proj_diag(root_off, 0, "依赖环：项目正在装载中");
            return -1;
        }
        return known;
    }
    let me int = pj_proj_push(root_off, root_len);
    if (me < 0) {
        return -1;
    }
    // p_state 平行扩容
    let nst *int = malloc((gs.p_proj_cap * sizeof(int)).to_type(u64)).to_type(*int);
    if (nst == 0) {
        return gen.fail("内存分配失败");
    }
    if (gs.p_proj_n > 0) {
        memcpy(nst, gs.p_state, ((gs.p_proj_n - 1) * sizeof(int)).to_type(u64));
    }
    free(gs.p_state);
    gs.p_state = nst;
    gs.p_state[me] = 1;
    // 读清单
    let mpath [1024]u8;
    let mn int = 0;
    mn = gen.append_str(mpath, mn, pj_pool_str(root_off));
    mn = gen.append_str(mpath, mn, "/project.toml");
    mpath[mn] = 0;
    if (gen.read_source(gen.arr_cstr(mpath)) != 0) {
        return -1;
    }
    t_src = gs.c_src;
    t_len = gs.c_src_len;
    t_pos = 0;
    t_line = 1;
    t_file = gen.arr_cstr(mpath);
    toml_sec_n = 0;
    if (tml_parse() != 0) {
        return -1;
    }
    // schema：[project]
    let sec int = toml_find_sec("project");
    if (sec < 0) {
        return pj_proj_diag(root_off, 1, "缺少 [project] 节");
    }
    let so int = 0;
    let sl int = 0;
    let got int = toml_sec_str(sec, "name", &so, &sl);
    if (got < 0) {
        return -1;
    }
    if (got == 0 || sl == 0) {
        return pj_proj_diag(root_off, toml_secs[sec].line, "project.name 必填且非空");
    }
    // name 必须是标识符：产物名与接口 tag 都由它派生，不允许分隔符
    let nb0 u8 = gs.np_data[so];
    if (!((nb0 >= 'a' && nb0 <= 'z') || (nb0 >= 'A' && nb0 <= 'Z') || nb0 == '_')) {
        return pj_proj_diag(root_off, toml_secs[sec].line,
            "project.name 必须是标识符（字母或下划线开头）");
    }
    let nk int = 0;
    for nk < sl {
        let cb u8 = gs.np_data[so + nk];
        if (!((cb >= 'a' && cb <= 'z') || (cb >= 'A' && cb <= 'Z')
            || (cb >= '0' && cb <= '9') || cb == '_')) {
            return pj_proj_diag(root_off, toml_secs[sec].line,
                "project.name 只能是字母、数字与下划线");
        }
        nk += 1;
    }
    gs.p_projs[me].name_off = so;
    gs.p_projs[me].name_len = sl;
    // source（默认 src）
    got = toml_sec_str(sec, "source", &so, &sl);
    if (got < 0) {
        return -1;
    }
    let srcname *char = "src";
    if (got == 1) {
        srcname = pj_pool_str(so);
    }
    if (pj_canon(root_off, root_len, srcname) != 0) {
        return -1;
    }
    gs.p_projs[me].src_off = pj_canon_off;
    gs.p_projs[me].src_len = pj_canon_len;
    // version（可选，仅供 yh version 展示）
    got = toml_sec_str(sec, "version", &so, &sl);
    if (got < 0) {
        return -1;
    }
    if (got == 1) {
        gs.p_projs[me].ver_off = so;
        gs.p_projs[me].ver_len = sl;
    }
    // [project] 未知字段检查
    let vi int = 0;
    for vi < toml_secs[sec].val_n {
        let vo int = toml_secs[sec].vals[vi].key_off;
        let vl int = toml_secs[sec].vals[vi].key_len;
        let okf int = 0;
        if (vl == 4 && gs.np_data[vo] == 'n' && gs.np_data[vo + 1] == 'a'
            && gs.np_data[vo + 2] == 'm' && gs.np_data[vo + 3] == 'e') { okf = 1; }
        if (vl == 7 && gs.np_data[vo] == 'v' && gs.np_data[vo + 1] == 'e'
            && gs.np_data[vo + 2] == 'r' && gs.np_data[vo + 3] == 's'
            && gs.np_data[vo + 4] == 'i' && gs.np_data[vo + 5] == 'o'
            && gs.np_data[vo + 6] == 'n') { okf = 1; }
        if (vl == 6 && gs.np_data[vo] == 's' && gs.np_data[vo + 1] == 'o'
            && gs.np_data[vo + 2] == 'u' && gs.np_data[vo + 3] == 'r'
            && gs.np_data[vo + 4] == 'c' && gs.np_data[vo + 5] == 'e') { okf = 1; }
        if (vl == 6 && gs.np_data[vo] == 'a' && gs.np_data[vo + 1] == 'u'
            && gs.np_data[vo + 2] == 't' && gs.np_data[vo + 3] == 'h'
            && gs.np_data[vo + 4] == 'o' && gs.np_data[vo + 5] == 'r') { okf = 1; }
        if (okf == 0) {
            let buf [64]u8;
            let bn int = 0;
            bn = gen.append_str(buf, bn, "project 未知字段: ");
            let k int = 0;
            for k < vl {
                buf[bn] = gs.np_data[vo + k];
                bn += 1;
                k += 1;
            }
            let mo int = gen.tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            return pj_proj_diag(root_off, toml_secs[sec].vals[vi].line, gen.np_cstr(mo));
        }
        vi += 1;
    }
    // [dependencies]：先整表快照——递归装载会重置 toml_secs（全局解析区）
    let dsec int = toml_find_sec("dependencies");
    let snap_key_off [64]int;
    let snap_key_len [64]int;
    let snap_path_off [64]int;
    let snap_line [64]int;
    let snap_n int = 0;
    if (dsec >= 0) {
        for snap_n < toml_secs[dsec].val_n && snap_n < 64 {
            snap_key_off[snap_n] = toml_secs[dsec].vals[snap_n].key_off;
            snap_key_len[snap_n] = toml_secs[dsec].vals[snap_n].key_len;
            snap_path_off[snap_n] = toml_secs[dsec].vals[snap_n].path_off;
            snap_line[snap_n] = toml_secs[dsec].vals[snap_n].line;
            snap_n += 1;
        }
    }
    if (dsec >= 0) {
        let di int = 0;
            for di < snap_n {
                    // 快照依赖条目：递归装载会重置 toml_secs（全局解析区）
            let key_off int = snap_key_off[di];
            let key_len int = snap_key_len[di];
            let dep_line int = snap_line[di];
            if (snap_path_off[di] < 0) {
                return pj_proj_diag(root_off, dep_line,
                    "依赖必须是 { path = \"...\" } 表");
            }
            let path_off int = snap_path_off[di];
            // 依赖项目根 = 规范化(root + path)
            if (pj_canon(root_off, root_len, pj_pool_str(path_off)) != 0) {
                return -1;
            }
            let dep int = pj_load_project(pj_canon_off, pj_canon_len);
            if (dep < 0) {
                return -1;
            }
            // 登记依赖
            if (gs.p_projs[me].dep_n == gs.p_projs[me].dep_cap) {
                let ncap int = gs.p_projs[me].dep_cap * 2;
                if (ncap == 0) {
                    ncap = 8;
                }
                let nd *gen.PDep = malloc((ncap * sizeof(gen.PDep)).to_type(u64)).to_type(*gen.PDep);
                if (nd == 0) {
                    return gen.fail("内存分配失败");
                }
                if (gs.p_projs[me].dep_n > 0) {
                    memcpy(nd, gs.p_projs[me].deps, (gs.p_projs[me].dep_n * sizeof(gen.PDep)).to_type(u64));
                }
                free(gs.p_projs[me].deps);
                gs.p_projs[me].deps = nd;
                gs.p_projs[me].dep_cap = ncap;
            }
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].key_off = key_off;
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].key_len = key_len;
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].proj = dep;
            gs.p_projs[me].deps[gs.p_projs[me].dep_n].line = dep_line;
            gs.p_projs[me].dep_n += 1;
            di += 1;
        }
    }
    // 扫描源码根
    if (pj_scan_source(gs.p_projs[me].src_off, gs.p_projs[me].src_len, me) != 0) {
        return -1;
    }
    // 入口模块：模块名为 main 的那个（模块名与目录名无关；同名模块跨目录
    // 合并为一个，故至多命中一次）
    let mi int = 0;
    for mi < gs.p_projs[me].mod_n {
        let um int = gs.p_projs[me].mods[mi];
        if (gs.p_mods[um].name_len == 4
            && gs.np_data[gs.p_mods[um].name_off] == 'm'
            && gs.np_data[gs.p_mods[um].name_off + 1] == 'a'
            && gs.np_data[gs.p_mods[um].name_off + 2] == 'i'
            && gs.np_data[gs.p_mods[um].name_off + 3] == 'n') {
            gs.p_mods[um].is_entry = 1;
            break;
        }
        mi += 1;
    }
    gs.p_state[me] = 2;
    return me;
}

pub fn pj_scan_source(dir_off int, dir_len int, proj int) int {
    let entries *PJDirEntry = 0.to_type(*PJDirEntry);
    let es_n int = 0;
    let es_cap int = 0;
    if (pj_os_dir_list(pj_pool_str(dir_off), &entries, &es_n, &es_cap) != 0) {
        if (entries != 0) { free(entries.to_type(*void)); }
        return -1;
    }
    pj_dir_sort(entries, es_n);
    let e int = 0;
    for e < es_n {
        if (pj_scan_entry(dir_off, dir_len, entries[e].name_off,
            entries[e].name_len, entries[e].is_dir, proj) != 0) {
            free(entries.to_type(*void));
            return -1;
        }
        e += 1;
    }
    if (entries != 0) { free(entries.to_type(*void)); }
    return 0;
}

// pj_dir_less：按文件名字节序排序，保证跨宿主扫描与构建顺序稳定。
pub fn pj_dir_less(a PJDirEntry, b PJDirEntry) int {
    let gs *gen.GenState = gen.G();
    let n int = a.name_len;
    if (b.name_len < n) { n = b.name_len; }
    let i int = 0;
    for i < n {
        let av int = gs.np_data[a.name_off + i].to_type(int);
        let bv int = gs.np_data[b.name_off + i].to_type(int);
        if (av < bv) { return 1; }
        if (av > bv) { return 0; }
        i += 1;
    }
    return (a.name_len < b.name_len).to_type(int);
}

// pj_dir_sort：按小目录常见情况原地插入排序，不另申请排序缓冲。
pub fn pj_dir_sort(entries *PJDirEntry, n int) int {
    let i int = 1;
    for i < n {
        let item PJDirEntry = entries[i];
        let j int = i;
        for j > 0 && pj_dir_less(item, entries[j - 1]) != 0 {
            entries[j] = entries[j - 1];
            j -= 1;
        }
        entries[j] = item;
        i += 1;
    }
    return 0;
}

pub fn pj_scan_entry(dir_off int, dir_len int, name_start int, name_len int, is_dir int, proj int) int {
    let gs *gen.GenState = gen.G();
    if (is_dir != 0) {
        // 子目录相对路径：<dir>/<name>，规范化后递归
        let nm [300]u8;
        let nn int = 0;
        let k2 int = 0;
        for k2 < name_len {
            nm[nn] = gs.np_data[name_start + k2];
            nn += 1;
            k2 += 1;
        }
        nm[nn] = 0;
        if (pj_canon(dir_off, dir_len, gen.arr_cstr(nm)) != 0) {
            return -1;
        }
        let sub_off int = pj_canon_off;
        let sub_len int = pj_canon_len;
        // 嵌套项目边界：含 mod.toml 的子目录属于另一项目，不进入
        let probe [1100]u8;
        let pn int = 0;
        pn = gen.append_str(probe, pn, pj_pool_str(sub_off));
        pn = gen.append_str(probe, pn, "/project.toml");
        probe[pn] = 0;
        if (pj_file_exists(gen.arr_cstr(probe)) != 0) {
            return 0;
        }
        return pj_scan_source(sub_off, sub_len, proj);
    }
    if (pj_source_target_match(name_start, name_len) == 0) {
        return 0;
    }
    // .yh 后缀检查
    if (name_len < 3 || gs.np_data[name_start + name_len - 3] != '.'
        || gs.np_data[name_start + name_len - 2] != 'y' || gs.np_data[name_start + name_len - 1] != 'h') {
        return 0;
    }
    // 完整路径 = <dir>/<name>
    let full [1100]u8;
    let flen2 int = 0;
    flen2 = gen.append_str(full, flen2, pj_pool_str(dir_off));
    full[flen2] = '/';
    flen2 += 1;
    let k int = 0;
    for k < name_len {
        full[flen2] = gs.np_data[name_start + k];
        flen2 += 1;
        k += 1;
    }
    full[flen2] = 0;
    // 读文件并解析模块头（诊断指向被扫文件）
    let save_path *char = gs.c_path;
    gs.c_path = gen.arr_cstr(full);
    let r int = pj_index_file(gen.arr_cstr(full), proj);
    gs.c_path = save_path;
    return r;
}

// pj_source_target_match：平台文件仍使用唯一的 .yh 后缀；仅当当前输出目标
// 与文件名中的 .darwin.yh/.linux.yh 匹配时纳入项目。普通 .yh 不受影响。
pub fn pj_source_target_match(name_start int, name_len int) int {
    let gs *gen.GenState = gen.G();
    if (name_len >= 10) {
        let off int = name_start + name_len - 10;
        if (gs.np_data[off] == '.' && gs.np_data[off + 1] == 'd'
            && gs.np_data[off + 2] == 'a' && gs.np_data[off + 3] == 'r'
            && gs.np_data[off + 4] == 'w' && gs.np_data[off + 5] == 'i'
            && gs.np_data[off + 6] == 'n' && gs.np_data[off + 7] == '.'
            && gs.np_data[off + 8] == 'y' && gs.np_data[off + 9] == 'h') {
            return gen.tg_darwin();
        }
    }
    if (name_len >= 9) {
        let off int = name_start + name_len - 9;
        if (gs.np_data[off] == '.' && gs.np_data[off + 1] == 'l'
            && gs.np_data[off + 2] == 'i' && gs.np_data[off + 3] == 'n'
            && gs.np_data[off + 4] == 'u' && gs.np_data[off + 5] == 'x'
            && gs.np_data[off + 6] == '.' && gs.np_data[off + 7] == 'y'
            && gs.np_data[off + 8] == 'h') {
            return 1 - gen.tg_darwin();
        }
    }
    return 1;
}

pub fn pj_index_file(path *char, proj int) int {
    let gs *gen.GenState = gen.G();
    if (gs.c_stats_enabled != 0) {
        gs.c_stats_index += 1;
    }
    if (gen.read_source(path) != 0) {
        return -1;
    }
    gs.c_tok_n = 0;
    gs.c_pos = 0;
    gs.c_errors = 0;
    if (lex.lex_all() != 0) {
        return -1;
    }
    parse.mod_reset_file();
    if (parse.mod_parse_head() != 0) {
        return -1;
    }
    if (gs.mod_has_module == 0) {
        // 源码根内的文件必须声明模块（旧单文件形态不属于项目源码根）
        gs.c_errors += 1;
        let buf [256]u8;
        let n int = 0;
        n = gen.append_str(buf, n, gs.c_path);
        n = gen.append_str(buf, n, ":1:1: 错误: 项目源码内的文件必须以 module 声明开头\n");
        gen.write_all(2, buf, n);
        return -1;
    }
    // 查找/创建模块
    let mod int = -1;
    let mi int = 0;
    for mi < gs.p_mod_n {
        if (gs.p_mods[mi].proj == proj && gs.p_mods[mi].name_len == gs.mod_name_len
            && gs.np_data[gs.p_mods[mi].name_off] == gs.np_data[gs.mod_name_off]) {
            let match int = 1;
            let j int = 1;
            for j < gs.mod_name_len {
                if (gs.np_data[gs.p_mods[mi].name_off + j] != gs.np_data[gs.mod_name_off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                mod = mi;
                break;
            }
        }
        mi += 1;
    }
    if (mod < 0) {
        mod = pj_mod_push(gs.mod_name_off, gs.mod_name_len, proj);
        if (mod < 0) {
            return -1;
        }
        if (pj_proj_add_mod(proj, mod) != 0) {
            return -1;
        }
    }
    // 登记文件（路径 intern）
    let plen int = 0;
    for path[plen] != 0 {
        plen += 1;
    }
    let poff int = gen.tml_intern_str(path.to_type(*u8), 0, plen);
    if (poff < 0) {
        return -1;
    }
    let fidx int = pj_file_push(poff, plen, mod);
    if (fidx < 0) {
        return -1;
    }
    if (gs.c_front_cache != 0) {
        let toks *gen.Tok = malloc((gs.c_tok_n * sizeof(gen.Tok)).to_type(u64)).to_type(*gen.Tok);
        if (toks == 0) {
            return gen.fail("内存分配失败");
        }
        memcpy(toks, gs.c_toks, (gs.c_tok_n * sizeof(gen.Tok)).to_type(u64));
        gs.p_files[fidx].source = gs.c_src;
        gs.p_files[fidx].source_len = gs.c_src_len;
        gs.p_files[fidx].tokens = toks;
        gs.p_files[fidx].token_n = gs.c_tok_n;
    }
    if (pj_mod_add_file(mod, fidx) != 0) {
        return -1;
    }
    // 目录唯一模块检查：同目录内只允许一个模块（用户规划）
    let di int = 0;
    for di < gs.p_file_n {
        let dn int = gs.p_files[di].path_len;
        let dl int = pj_dir_prefix_len(gs.p_files[di].path_off, dn);
        let nl int = pj_dir_prefix_len(poff, plen);
        if (dl == nl && pj_same_np(gs.p_files[di].path_off, dl, poff, dl)
            && gs.p_files[di].mod != mod) {
            let buf [512]u8;
            let bn int = 0;
            bn = gen.append_str(buf, bn, "同目录存在另一个模块（每目录一个模块）: ");
            bn = append_bytes_np(buf, bn, gs.p_mods[mod].name_off, gs.p_mods[mod].name_len);
            bn = gen.append_str(buf, bn, " 与 ");
            bn = append_bytes_np(buf, bn, gs.p_mods[gs.p_files[di].mod].name_off,
                gs.p_mods[gs.p_files[di].mod].name_len);
            let mo int = gen.tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            gs.c_errors += 1;
            let out [600]u8;
            let on int = 0;
            on = gen.append_str(out, on, gen.np_cstr(mo));
            on = gen.append_byte(out, on, '\n');
            gen.write_all(2, out, on);
            return -1;
        }
        di += 1;
    }
    // 导入记录
    let ii int = 0;
    for ii < gs.mod_import_n {
        if (pj_imp_push(fidx, gs.mod_imports[ii].name_off, gs.mod_imports[ii].name_len,
            gs.mod_imports[ii].proj_key_off, gs.mod_imports[ii].proj_key_len,
            gs.mod_imports[ii].alias_off, gs.mod_imports[ii].alias_len,
            gs.mod_imports[ii].line, gs.mod_imports[ii].col) != 0) {
            return -1;
        }
        ii += 1;
    }
    return 0;
}

// pj_dir_prefix_len：路径的目录前缀长度（最后一个 '/' 之前；无 '/' 为 0）。
pub fn pj_dir_prefix_len(off int, plen int) int {
    let gs *gen.GenState = gen.G();
    let last int = -1;
    let i int = 0;
    for i < plen {
        if (gs.np_data[off + i] == '/') {
            last = i;
        }
        i += 1;
    }
    if (last < 0) {
        return 0;
    }
    return last;
}

// pj_same_np：名字池两段字节相等。
pub fn pj_same_np(o1 int, l1 int, o2 int, l2 int) int {
    let gs *gen.GenState = gen.G();
    if (l1 != l2) {
        return 0;
    }
    let j int = 0;
    for j < l1 {
        if (gs.np_data[o1 + j] != gs.np_data[o2 + j]) {
            return 0;
        }
        j += 1;
    }
    return 1;
}
