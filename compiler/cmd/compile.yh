module main;
import gen;
import parse;

// ============================================================================
// compile.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_compile() int {
    let gs *gen.GenState = gen.G();
    // pass 1：登记类型、函数签名与全局名字
    gs.c_pos = 0;
    gs.c_pass = 1;
    if (parse.parse_source() != 0) {
        return -1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    if (gs.c_check_only == 0 && gen.sem_check_main() != 0) {
        return -1;
    }
    // pass 2a：全局 let/const 初始化（引用先声明规则由此保证）
    gs.c_pos = 0;
    gs.c_pass = 2;
    if (gen.em_puts("\n") != 0) {
        return -1;
    }
    if (parse.parse_source_globals() != 0) {
        return -1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    // pass 2b：函数体
    gs.c_pos = 0;
    if (parse.parse_source_fns() != 0) {
        return -1;
    }
    if (gs.c_errors > 0) {
        return -1;
    }
    if (gs.c_check_only != 0) {
        return 0;
    }
    // 发射 .bss：零初始化全局（清单在 pass 2a 收集）
    let i int = 0;
    for i < gs.c_bss_n {
        let bi int = gs.c_bss_syms[i];
        if (gen.em_bss_symbol(bi, gs.t_types[gs.c_syms[bi].type_id].size, gs.t_types[gs.c_syms[bi].type_id].align) != 0) {
            return -1;
        }
        i += 1;
    }
    if (gen.em_emit_runtime_stubs() != 0) {
        return -1;
    }
    return 0;
}
