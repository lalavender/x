module main
import gen
import parse
import comptime
import ast

// ============================================================================
// compile.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

fn sem_compile() int {
    let gs *gen.GenState = gen.G()
    comptime.ct_reset()
    // pass 1：登记类型、函数签名与全局名字
    gs.task.c_pos = 0
    gs.task.c_pass = 1
    if (parse.parse_source() != 0) {
        return -1
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    if (gs.task.c_check_only == 0 && gen.sem_check_main() != 0) {
        return -1
    }
    // 编译期函数先完成 typed IR 捕获，供紧随其后的全局常量初始化调用。
    let saved_capture int = gs.task.c_ast_capture
    if (gs.task.c_ast_capture == 0) {
        ast.ast_expr_reset()
        ast.ast_stmt_reset()
        ast.ast_decl_reset()
        ast.ast_function_reset()
        gs.task.c_ast_capture = 1
    }
    gs.task.c_pass = 2
    gs.task.c_pos = 0
    if (parse.parse_source_ct_fns() != 0 || gs.task.c_errors > 0) {
        gs.task.c_ast_capture = saved_capture
        return -1
    }
    if (saved_capture == 0) {
        gs.task.c_ast_capture = 0
        ast.ast_expr_reset()
        ast.ast_stmt_reset()
        ast.ast_decl_reset()
        ast.ast_function_reset()
    }
    if (parse.parse_source_ct_layout_register() != 0) {
        return -1
    }
    for 1 {
        let pending_before int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_before == 0) { break }
        if (parse.parse_source_ct_layout_consts() != 0) { return -1 }
        if (parse.parse_source_ct_layout_exprs() != 0) { return -1 }
        if (comptime.ct_layout_advance() < 0) { return -1 }
        let pending_after int = comptime.ct_value_pending_count() +
            comptime.ct_layout_expr_pending_count() +
            comptime.ct_layout_pending_count()
        if (pending_after == 0) { break }
        if (pending_after >= pending_before) {
            if (comptime.ct_layout_pending_count() > 0) {
                comptime.ct_layout_stuck_diagnostic()
            } else {
                comptime.ct_value_stuck_diagnostic()
            }
            return -1
        }
    }
    if (comptime.ct_layout_resolve() != 0 || gs.task.c_errors > 0) {
        return -1
    }
    // 延迟的枚举判别值：此时编译期函数正文已捕获，可以真实求值。
    if (parse.ct_enum_pending_run() != 0) {
        return -1
    }
    // pass 2a：全局 let/const 初始化（引用先声明规则由此保证）
    gs.task.c_pos = 0
    gs.task.c_pass = 2
    if (parse.parse_source_globals() != 0) {
        return -1
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    // pass 2b：函数体
    gs.task.c_pos = 0
    if (parse.parse_source_fns() != 0) {
        return -1
    }
    if (gs.task.c_errors > 0) {
        return -1
    }
    if (gs.task.c_check_only != 0) {
        return 0
    }
    // LL12：旧后端的 .bss 与运行期桩发射已删除；LLVM 路径由受检快照与
    // 模块 IR 承担数据布局，本函数只保留两遍语义与编译期求值。
    return 0
}
