module main;
import gen;
import parse;

// ============================================================================
// compile.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_compile() int {
    // pass 1：登记类型、函数签名与全局名字
    gen.c_pos = 0;
    gen.c_pass = 1;
    if (parse.parse_source() != 0) {
        return -1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    if (gen.sem_check_main() != 0) {
        return -1;
    }
    // pass 2a：全局 let/const 初始化（引用先声明规则由此保证）
    gen.c_pos = 0;
    gen.c_pass = 2;
    if (gen.em_puts("\n") != 0) {
        return -1;
    }
    if (parse.parse_source_globals() != 0) {
        return -1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    // pass 2b：函数体
    gen.c_pos = 0;
    if (parse.parse_source_fns() != 0) {
        return -1;
    }
    if (gen.c_errors > 0) {
        return -1;
    }
    // 发射 .bss：零初始化全局（清单在 pass 2a 收集）
    let i int = 0;
    for i < gen.c_bss_n {
        let bi int = gen.c_bss_syms[i];
        if (gen.em_bss_symbol(bi, gen.t_types[gen.c_syms[bi].type_id].size, gen.t_types[gen.c_syms[bi].type_id].align) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

