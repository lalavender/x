module main;

// CmdTimespec：Linux arm64 clock_gettime syscall 使用的 64 位时间结构。
pub struct CmdTimespec {
    sec i64;
    nsec i64;
}

// cmd_clock_ns：通过 Linux arm64 clock_gettime syscall 读取单调纳秒计数。
pub fn cmd_clock_ns() u64 {
    let stamp CmdTimespec;
    let result i64 = linux_syscall6(113.to_type(u64), 1.to_type(u64),
        (&stamp).to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64));
    if (result != 0 || stamp.sec < 0 || stamp.nsec < 0
        || stamp.nsec >= 1000000000) {
        return 0;
    }
    return stamp.sec.to_type(u64) * 1000000000.to_type(u64)
        + stamp.nsec.to_type(u64);
}
