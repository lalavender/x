module main;
import gen;

// process.yh —— 编译器用显式 argv 启动宿主进程，不经过命令解释器。

// cmd_mkdir_if_missing：调用宿主 mkdir API；若目录已存在则确认它确为目录。
fn cmd_mkdir_if_missing(path *char) int {
    if (path == 0) {
        return -1;
    }
    if (mkdir(path, 493) == 0) {
        return 0;
    }
    let n int = strlen(path).to_type(int);
    if (n < 0 || n > 1096) {
        return -1;
    }
    let probe [1100]u8;
    let i int = 0;
    for i < n {
        probe[i] = path[i].to_type(u8);
        i += 1;
    }
    probe[n] = '/';
    probe[n + 1] = '.';
    probe[n + 2] = 0;
    let fd int = open(gen.arr_cstr(probe), 0);
    if (fd < 0) {
        return -1;
    }
    close(fd);
    return 0;
}

// cmd_mkdirs：按路径分隔符逐段创建目录，实现构建所需的 mkdir -p 行为。
fn cmd_mkdirs(path *char) int {
    if (path == 0) {
        return -1;
    }
    let n int = strlen(path).to_type(int);
    if (n <= 0 || n > 1096) {
        return -1;
    }
    let buf [1100]u8;
    let i int = 0;
    for i < n {
        buf[i] = path[i].to_type(u8);
        i += 1;
    }
    buf[n] = 0;
    i = 1;
    for i <= n {
        if (i == n || buf[i] == '/') {
            let saved u8 = buf[i];
            buf[i] = 0;
            if (i > 0 && cmd_mkdir_if_missing(gen.arr_cstr(buf)) != 0) {
                return -1;
            }
            buf[i] = saved;
        }
        i += 1;
    }
    return 0;
}

// cmd_process_status：把 waitpid 的状态字转换为普通退出码或信号退出码。
fn cmd_process_status(pid int) int {
    let status int = 0;
    if (pid <= 0 || waitpid(pid, &status, 0) != pid) {
        return -1;
    }
    if ((status & 127) == 0) {
        return (status >> 8) & 255;
    }
    return 128 + (status & 127);
}

// cmd_process_run：用 argv 直接执行程序并等待它结束；失败返回 -1。
fn cmd_process_run(argv **char) int {
    if (argv == 0 || argv[0] == 0) {
        return -1;
    }
    let pid int = fork();
    if (pid < 0) {
        return -1;
    }
    if (pid == 0) {
        execvp(argv[0], argv);
        exit(127);
    }
    return cmd_process_status(pid);
}

// cmd_process_capture：在不经过 shell 的前提下捕获子进程标准输出。
// capture_path 是本次调用专属的临时文件路径；函数负责创建、读取并删除它。
// 返回捕获字节数；命令失败、输出超出容量或文件操作失败时返回 -1。
fn cmd_process_capture(argv **char, capture_path *char,
    output *u8, capacity int) int {
    if (argv == 0 || argv[0] == 0 || capture_path == 0
        || output == 0 || capacity <= 0) {
        return -1;
    }
    let pid int = fork();
    if (pid < 0) {
        return -1;
    }
    if (pid == 0) {
        let flags int = 0x241;
        if (gen.tg_host_darwin() != 0) {
            flags = 0x601;
        }
        let out_fd int = open(capture_path, flags, 0x1a4);
        if (out_fd < 0) {
            exit(126);
        }
        if (dup2(out_fd, 1) < 0) {
            close(out_fd);
            exit(126);
        }
        close(out_fd);
        execvp(argv[0], argv);
        exit(127);
    }
    if (cmd_process_status(pid) != 0) {
        unlink(capture_path);
        return -1;
    }
    let in_fd int = open(capture_path, 0);
    if (in_fd < 0) {
        unlink(capture_path);
        return -1;
    }
    let total int = 0;
    let failed int = 0;
    let chunk [512]u8;
    for 1 {
        let got i64 = read(in_fd, (&chunk[0]).to_type(*u8), 512);
        if (got < 0) {
            failed = 1;
            break;
        }
        if (got == 0) {
            break;
        }
        let count int = got.to_type(int);
        if (total + count >= capacity) {
            failed = 1;
            break;
        }
        let i int = 0;
        for i < count {
            output[total + i] = chunk[i];
            i += 1;
        }
        total += count;
    }
    close(in_fd);
    unlink(capture_path);
    if (failed != 0) {
        return -1;
    }
    output[total] = 0;
    return total;
}
