module cmd;
import gen;

// ============================================================================
// project_state.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// 固定临时文件（进程内互斥使用；并发编译器的已知边界，见 ADR-0007 种子说明）。
pub let pj_scratch *char = "/tmp/yh-proj-scratch.txt";

// ls 输出独立缓冲容量（pj_run_ls 经 out_grow 扩容 pj_ls_buf 用）。
pub let pj_ls_cap int = 0;

pub fn pj_pool_str(off int) *char {
    return (gen.np_data + off).to_type(*char);
}

pub fn pj_shell_quote(buf *u8, n int, path *char) int {
    buf[n] = '\'';
    n += 1;
    let i int = 0;
    for path[i] != 0 {
        if (path[i] == '\'') {
            buf[n] = '\'';
            buf[n + 1] = '\\';
            buf[n + 2] = '\'';
            buf[n + 3] = '\'';
            n += 4;
        } else {
            buf[n] = path[i].to_type(u8);
            n += 1;
        }
        i += 1;
    }
    buf[n] = '\'';
    return n + 1;
}


// pj_run_ls：列出目录条目到临时文件，读入独立缓冲 pj_ls_buf。
// 每行一个条目；目录条目带尾部 '/'（ls -1p）。返回 0；失败 -1。
pub let pj_ls_buf *u8 = 0;
pub let pj_ls_len int = 0;
pub fn pj_run_ls(dir *char) int {
    let cmd [1024]u8;
    let n int = 0;
    n = gen.append_str(cmd, n, "/bin/ls -1p ");
    n = pj_shell_quote(cmd, n, dir);
    n = gen.append_str(cmd, n, " > ");
    n = gen.append_str(cmd, n, pj_scratch);
    cmd[n] = 0;
    let rc int = system(gen.arr_cstr(cmd));
    if (rc != 0) {
        return gen.fail_path("无法列出目录: ", dir);
    }
    if (gen.read_source(pj_scratch) != 0) {
        return -1;
    }
    // 拷出独立缓冲：后续 read_source（读 .yh/mod.toml）会覆盖 c_src
    if (gen.out_grow(&pj_ls_buf, pj_ls_len, &pj_ls_cap, gen.c_src_len + 1) != 0) {
        return -1;
    }
    memcpy(pj_ls_buf, gen.c_src, gen.c_src_len.to_type(u64));
    pj_ls_len = gen.c_src_len;
    return 0;
}

pub fn pj_env_fetch(name *char, off *int, olen *int) int {
    // shell 内建 echo 展开变量（不依赖外部命令的 PATH）
    let cmd [256]u8;
    let n int = 0;
    n = gen.append_str(cmd, n, "echo \"");
    n = gen.append_str(cmd, n, "$");
    n = gen.append_str(cmd, n, name);
    n = gen.append_str(cmd, n, "\" > ");
    n = gen.append_str(cmd, n, pj_scratch);
    cmd[n] = 0;
    system(gen.arr_cstr(cmd));
    if (gen.read_source(pj_scratch) != 0) {
        return -1;
    }
    // 去掉尾部换行
    let e int = gen.c_src_len;
    if (e > 0 && gen.c_src[e - 1] == '\n') {
        e -= 1;
    }
    if (e > 0 && gen.c_src[e - 1] == '\r') {
        e -= 1;
    }
    let o int = gen.tml_intern_str(gen.c_src, 0, e);
    if (o < 0) {
        return -1;
    }
    off[0] = o;
    olen[0] = e;
    return 0;
}

pub fn pj_file_exists(path *char) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return 0;
    }
    close(fd);
    return 1;
}


// —— 路径规范化（去重用）：段栈处理，消解 . / .. / 重复斜杠。 ——

// pj_canon：把 base（池内串）与 rel（NUL 串）连接并规范化，intern 后
// 经全局出参 pj_canon_off/len 返回。rel 以 '/' 开头时仅用 rel。
pub let pj_canon_off int = -1;
pub let pj_canon_len int = 0;
pub fn pj_canon(base_off int, base_len int, rel *char) int {
    // 组装原始串到临时堆缓冲（路径有 1024 上限，超出报错）
    let raw [1024]u8;
    let rn int = 0;
    let use_rel_only int = 0;
    if (rel[0] == '/') {
        use_rel_only = 1;
    }
    if (use_rel_only == 0) {
        let i int = 0;
        for i < base_len {
            raw[rn] = gen.np_data[base_off + i];
            rn += 1;
            i += 1;
        }
        if (rn > 0 && raw[rn - 1] != '/') {
            raw[rn] = '/';
            rn += 1;
        }
    }
    let j int = 0;
    for rel[j] != 0 {
        raw[rn] = rel[j].to_type(u8);
        rn += 1;
        j += 1;
        if (rn >= 1023) {
            return gen.fail("路径过长");
        }
    }
    raw[rn] = 0;
    // 段栈规范化
    let segs [128][256]u8;  // 每段最长 255
    let seg_len [128]int;
    let sn int = 0;
    let i2 int = 0;
    for i2 < rn {
        // 跳过多余斜杠
        for i2 < rn && raw[i2] == '/' {
            i2 += 1;
        }
        let s int = i2;
        for i2 < rn && raw[i2] != '/' {
            i2 += 1;
        }
        let sl int = i2 - s;
        if (sl == 0) {
            break;
        }
        if (sl == 1 && raw[s] == '.') {
            continue;
        }
        if (sl == 2 && raw[s] == '.' && raw[s + 1] == '.') {
            // 顶端是普通段才弹出；否则保留 ".."（相对路径上越 cwd）
            if (sn > 0 && !(seg_len[sn - 1] == 2 && segs[sn - 1][0] == '.' && segs[sn - 1][1] == '.')) {
                sn -= 1;
                continue;
            }
        }
        if (sn >= 128 || sl > 255) {
            return gen.fail("路径过长");
        }
        let k int = 0;
        for k < sl {
            segs[sn][k] = raw[s + k];
            k += 1;
        }
        seg_len[sn] = sl;
        sn += 1;
    }
    // 重新拼接入池
    let tmp [1024]u8;
    let tn int = 0;
    // 空段栈：绝对路径为根 '/'；相对路径（如 "." 折叠后）为本目录 "."。
    // 契约与其他路径一致：结果写 pj_canon_off/len，成功返回 0。
    if (sn == 0) {
        if (rn > 0 && raw[0] == '/') {
            tmp[0] = '/';
            tn = 1;
        } else {
            tmp[0] = '.';
            let o int = gen.tml_intern_str(tmp, 0, 1);
            if (o < 0) {
                return -1;
            }
            pj_canon_off = o;
            pj_canon_len = 1;
            return 0;
        }
    }
    if (rn > 0 && raw[0] == '/') {
        tmp[0] = '/';
        tn = 1;
    }
    let si int = 0;
    for si < sn {
        if (tn > 0 && tmp[tn - 1] != '/') {
            tmp[tn] = '/';
            tn += 1;
        }
        let k2 int = 0;
        for k2 < seg_len[si] {
            tmp[tn] = segs[si][k2];
            tn += 1;
            k2 += 1;
        }
        si += 1;
    }
    tmp[tn] = 0;
    pj_canon_off = gen.tml_intern_str(tmp, 0, tn);
    pj_canon_len = tn;
    if (pj_canon_off < 0) {
        return -1;
    }
    return 0;
}

pub fn pj_proj_push(root_off int, root_len int) int {
    if (gen.p_proj_n == gen.p_proj_cap) {
        let ncap int = gen.p_proj_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *gen.PProj = malloc((ncap * sizeof(gen.PProj)).to_type(u64)).to_type(*gen.PProj);
        if (nd == 0) {
            gen.fail("内存分配失败");
            return -1;
        }
        if (gen.p_proj_n > 0) {
            memcpy(nd, gen.p_projs, (gen.p_proj_n * sizeof(gen.PProj)).to_type(u64));
        }
        free(gen.p_projs);
        gen.p_projs = nd;
        gen.p_proj_cap = ncap;
    }
    gen.p_projs[gen.p_proj_n].root_off = root_off;
    gen.p_projs[gen.p_proj_n].root_len = root_len;
    gen.p_projs[gen.p_proj_n].name_off = -1;
    gen.p_projs[gen.p_proj_n].name_len = 0;
    gen.p_projs[gen.p_proj_n].src_off = -1;
    gen.p_projs[gen.p_proj_n].src_len = 0;
    gen.p_projs[gen.p_proj_n].entry_off = -1;
    gen.p_projs[gen.p_proj_n].entry_len = 0;
    gen.p_projs[gen.p_proj_n].deps = 0;
    gen.p_projs[gen.p_proj_n].dep_n = 0;
    gen.p_projs[gen.p_proj_n].dep_cap = 0;
    gen.p_projs[gen.p_proj_n].mods = 0;
    gen.p_projs[gen.p_proj_n].mod_n = 0;
    gen.p_projs[gen.p_proj_n].mod_cap = 0;
    gen.p_proj_n += 1;
    return gen.p_proj_n - 1;
}

pub fn pj_proj_find_root(root_off int, root_len int) int {
    let i int = 0;
    for i < gen.p_proj_n {
        if (gen.p_projs[i].root_len == root_len
            && gen.np_data[gen.p_projs[i].root_off] == gen.np_data[root_off]) {
            let match int = 1;
            let j int = 1;
            for j < root_len {
                if (gen.np_data[gen.p_projs[i].root_off + j] != gen.np_data[root_off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

pub fn pj_mod_push(name_off int, name_len int, proj int) int {
    if (gen.p_mod_n == gen.p_mod_cap) {
        let ncap int = gen.p_mod_cap * 2;
        if (ncap == 0) {
            ncap = 16;
        }
        let nd *gen.PMod = malloc((ncap * sizeof(gen.PMod)).to_type(u64)).to_type(*gen.PMod);
        if (nd == 0) {
            gen.fail("内存分配失败");
            return -1;
        }
        if (gen.p_mod_n > 0) {
            memcpy(nd, gen.p_mods, (gen.p_mod_n * sizeof(gen.PMod)).to_type(u64));
        }
        free(gen.p_mods);
        gen.p_mods = nd;
        gen.p_mod_cap = ncap;
    }
    gen.p_mods[gen.p_mod_n].name_off = name_off;
    gen.p_mods[gen.p_mod_n].name_len = name_len;
    gen.p_mods[gen.p_mod_n].proj = proj;
    gen.p_mods[gen.p_mod_n].files = 0;
    gen.p_mods[gen.p_mod_n].file_n = 0;
    gen.p_mods[gen.p_mod_n].file_cap = 0;
    gen.p_mods[gen.p_mod_n].is_entry = 0;
    gen.p_mod_n += 1;
    return gen.p_mod_n - 1;
}

pub fn pj_proj_add_mod(proj int, mod int) int {
    if (gen.p_projs[proj].mod_n == gen.p_projs[proj].mod_cap) {
        let ncap int = gen.p_projs[proj].mod_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_projs[proj].mod_n > 0) {
            memcpy(nd, gen.p_projs[proj].mods, (gen.p_projs[proj].mod_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_projs[proj].mods);
        gen.p_projs[proj].mods = nd;
        gen.p_projs[proj].mod_cap = ncap;
    }
    gen.p_projs[proj].mods[gen.p_projs[proj].mod_n] = mod;
    gen.p_projs[proj].mod_n += 1;
    return 0;
}

