    }
    gen.p_mods[mod].files[gen.p_mods[mod].file_n] = file;
    gen.p_mods[mod].file_n += 1;
    return 0;
}

pub fn pj_file_push(path_off int, path_len int, mod int) int {
    if (gen.p_file_n == gen.p_file_cap) {
        let ncap int = gen.p_file_cap * 2;
        if (ncap == 0) {
            ncap = 32;
        }
        let nd *gen.PFile = malloc((ncap * sizeof(gen.PFile)).to_type(u64)).to_type(*gen.PFile);
        if (nd == 0) {
            gen.fail("内存分配失败");
            return -1;
        }
        if (gen.p_file_n > 0) {
            memcpy(nd, gen.p_files, (gen.p_file_n * sizeof(gen.PFile)).to_type(u64));
        }
        free(gen.p_files);
        gen.p_files = nd;
        gen.p_file_cap = ncap;
    }
    gen.p_files[gen.p_file_n].path_off = path_off;
    gen.p_files[gen.p_file_n].path_len = path_len;
    gen.p_files[gen.p_file_n].mod = mod;
    gen.p_file_n += 1;
    return gen.p_file_n - 1;
}

pub fn pj_imp_push(file int, off int, olen int, line int, col int) int {
    if (gen.p_imp_n == gen.p_imp_cap) {
        let ncap int = gen.p_imp_cap * 2;
        if (ncap == 0) {
            ncap = 32;
        }
        let base int = ncap;
        let nd *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd, gen.p_imp_file, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_file);
        gen.p_imp_file = nd;
        let nd2 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd2 == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd2, gen.p_imp_off, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_off);
        gen.p_imp_off = nd2;
        let nd3 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd3 == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd3, gen.p_imp_len, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_len);
        gen.p_imp_len = nd3;
        let nd4 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd4 == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd4, gen.p_imp_line, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_line);
        gen.p_imp_line = nd4;
        let nd5 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd5 == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd5, gen.p_imp_col, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_col);
        gen.p_imp_col = nd5;
        let nd6 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd6 == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_imp_n > 0) {
            memcpy(nd6, gen.p_imp_mod, (gen.p_imp_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_imp_mod);
        gen.p_imp_mod = nd6;
        gen.p_imp_cap = ncap;
    }
    gen.p_imp_file[gen.p_imp_n] = file;
    gen.p_imp_off[gen.p_imp_n] = off;
    gen.p_imp_len[gen.p_imp_n] = olen;
    gen.p_imp_line[gen.p_imp_n] = line;
    gen.p_imp_col[gen.p_imp_n] = col;
    gen.p_imp_mod[gen.p_imp_n] = -1;
    gen.p_imp_n += 1;
    return 0;
}

pub fn pj_proj_diag(root_off int, line int, msg *char) int {
    let buf [1024]u8;
    let n int = 0;
    n = gen.append_str(buf, n, pj_pool_str(root_off));
    n = gen.append_str(buf, n, "/mod.toml:");
    n = gen.append_int(buf, n, line);
    n = gen.append_str(buf, n, ": 错误: ");
    n = gen.append_str(buf, n, msg);
    n = gen.append_byte(buf, n, '\n');
    gen.write_all(2, buf, n);
    gen.c_errors += 1;
    return -1;
}

