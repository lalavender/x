}

pub fn pj_proj_add_mod(proj int, mod int) int {
    if (gen.p_projs[proj].mod_n == gen.p_projs[proj].mod_cap) {
        let ncap int = gen.p_projs[proj].mod_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return gen.fail("内存分配失败");
        }
        if (gen.p_projs[proj].mod_n > 0) {
            memcpy(nd, gen.p_projs[proj].mods, (gen.p_projs[proj].mod_n * sizeof(int)).to_type(u64));
        }
        free(gen.p_projs[proj].mods);
        gen.p_projs[proj].mods = nd;
        gen.p_projs[proj].mod_cap = ncap;
    }
    gen.p_projs[proj].mods[gen.p_projs[proj].mod_n] = mod;
    gen.p_projs[proj].mod_n += 1;
    return 0;
}

