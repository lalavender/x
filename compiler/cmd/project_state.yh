            memcpy(nd, gen.p_files, (gen.p_file_n * sizeof(gen.PFile)).to_type(u64));
        }
        free(gen.p_files);
        gen.p_files = nd;
        gen.p_file_cap = ncap;
    }
    gen.p_files[gen.p_file_n].path_off = path_off;
    gen.p_files[gen.p_file_n].path_len = path_len;
