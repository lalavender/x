module main
import link

// ============================================================================
// cmd_lld_link.yh —— 内部子进程协议 `--lld-link <响应文件>`（P1 一命令一文件）。
// Windows 无 fork 宿主的 COFF 链接 worker；响应文件每行一个 argv，由
// link/windows_link.yh 的 mb_coff_write_rsp 写出。私有 ABI，不进用户 help。
// ============================================================================

// api_lld_link：薄壳委托 link 的 COFF 子进程链接实现。
fn api_lld_link(response_path *char) int {
    return link.mb_coff_link_child(response_path)
}
