module main

// ============================================================================
// argv.yh —— UTF-8 argc/argv 重建的平台无关入口（2026-11-10 自 support 迁入，
// ADR-0025）。实现见同目录 argv.<平台>.yh 的 argv_utf8_rebuild_impl；只有 main
// 入口在解析命令行前调用一次。
//
// 平台实现与入口桩同在 `main` 模块（2026-11-17 收回 0.0.14 期的 `yh_argv_impl`
// 拆分）：`argv.windows.yh` 用 `@[extern]` 声明 GetCommandLineW /
// WideCharToMultiByte，零 CRT 入口桩（`llvm_windows_runtime_write_entry`）也会
// declare 这两个符号；拆分当时是为了绕开 0.0.14 种子「入口桩无条件 declare」。
// 现在入口桩按 `llvm_runtime_declared(unit, …)` 判重（`backend/api.yh`），同模块
// 不再触发 `invalid redefinition of function`。
// ============================================================================

// argv_utf8_rebuild：把入口层传入的 argc/argv 原地替换为 UTF-8 版本。
fn argv_utf8_rebuild(argc_out *int, argv_out ***char) {
    argv_utf8_rebuild_impl(argc_out, argv_out)
}
