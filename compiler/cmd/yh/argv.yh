module main

// ============================================================================
// argv.yh —— UTF-8 argc/argv 重建的平台无关入口（2026-11-10 自 support 迁入，
// ADR-0025）。实现见 argv.<平台>.yh 的 argv_utf8_rebuild_impl；只有 main 入口
// 在解析命令行前调用一次。
// ============================================================================

// argv_utf8_rebuild：把入口层传入的 argc/argv 原地替换为 UTF-8 版本。
fn argv_utf8_rebuild(argc_out *int, argv_out ***char) {
    argv_utf8_rebuild_impl(argc_out, argv_out)
}
