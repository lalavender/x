module main
import support
import testkit

// ============================================================================
// cmd_test.yh —— yh test：语言内测试执行器（P1 一命令一文件）。
// --timeout 范围校验由 driver 迁入本文件（命令自己的参数守自己的合法性）。
// ============================================================================

// api_test：发现、构建并逐例执行测试；--list 只列身份不执行。
fn api_test(req *CliRequest) int {
    if (req.timeout_secs < 1 || req.timeout_secs > 3600) {
        support.fail("--timeout 需要 1..3600 之间的秒数")
        print_usage(req, 2)
        return 2
    }
    return testkit.mb_run_test_command(req.src, req.has_src, req.filter,
        req.timeout_secs * 1000, req.list_mode, req.no_run)
}
