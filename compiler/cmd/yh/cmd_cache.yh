module main
import build

// ============================================================================
// cmd_cache.yh —— yh cache <info|clean|trim|verify>（C6）。
// 缓存命令不要求 project.toml；根路径/上限仍由 YH_CACHE* 决定。
// ============================================================================

// api_cache：把 cache 动作交给 build 的缓存运维实现。
fn api_cache(req *CliRequest) int {
    return build.mb_cache_command(req.src)
}
