module main
import build

// ============================================================================
// cmd_run.yh —— yh run：构建并运行 main 模块（P1 一命令一文件）。
// ============================================================================

// api_run：构建后运行 main 模块。
fn api_run(req *CliRequest) int {
    return build.cmd_run(req.links[0..req.link_count])
}
