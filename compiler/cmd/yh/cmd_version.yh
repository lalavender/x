module main
import build

// ============================================================================
// cmd_version.yh —— yh version / --contracts（P1 一命令一文件）。
// ============================================================================

// api_version：项目版本，或 `--contracts` 的契约版本集合（不要求项目）。
fn api_version(req *CliRequest) int {
    if (req.contracts != 0) {
        return build.mb_print_contracts()
    }
    return build.mb_print_version(0)
}
