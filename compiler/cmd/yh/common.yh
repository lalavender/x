module main
import lex
import support
import check
import build
import proj
import errors
import libs.os

// ============================================================================
// common.yh —— cmd 模块共享前奏（A3；P1 一命令一文件，2026-11-05）。
//
// 退出码契约（全部命令遵守）：0 成功；1 源文件语法/语义错误或读入失败；
// 2 用法错误；-1 内部或桥失败；诊断写 fd 2。
//
// 命令文件划分（一命令一文件，见 docs/03-design/yh-架构设计.md §6.4）：
//     cmd_build.yh  cmd_run.yh  cmd_test.yh  cmd_version.yh
//     cmd_single.yh  cmd_emit_module.yh  cmd_lld_link.yh
// driver.yh 只做「argv → 请求 → 分派」；本文件提供各命令共用的会话前奏
// 与单文件形态常量。cmd 模块导出面只有 main（api_*/cmd_* 均模块私有）。
// ============================================================================

// —— 单文件形态（api_single_file 的 form 参数）——
const API_SYNTAX int = 1      // 只做词法/语法检查
const API_CHECK int = 2       // 完整前端检查，不要求 main
const API_ASM int = 3         // 目标汇编到标准输出
const API_LLVM_TEXT int = 4   // LLVM 文本到标准输出（--emit-llvm）
const API_EXE int = 5         // 编译并链接为可执行文件

// cmd_session_init：编译会话前奏，所有命令入口共用。
// 次序固定：恢复 GenState 非零初始值（原 pub let 初始化器迁移）→ 项目模型
// 初始化 → 目标/配置绑定（存储归 proj（B1-2）：gen 只持指针，必须先绑定
// 再读目标）→ 自身路径（项目构建的子进程再入用）→ 环境向量直接取自
// 操作系统传入值（避免调用 printenv 等宿主工具）。
fn cmd_session_init(argv0 *char, envp **char) void {
    support.session_reset()
    lex.reset()
    proj.init()
    support.bind_cfg(proj.cfg())
    build.mb_set_argv0(argv0)
    proj.ctx().envp = envp
    cmd_diag_setup()
}

// cmd_env_value：读环境变量的值（NUL 串）；不存在或为空返回 0。
// 值由 proj.env_fetch 快照进名字池，这里只借用指针，不复制、不分配。
fn cmd_env_value(name *char) *char {
    let off int = 0
    let len int = 0
    if (proj.env_fetch(name, &off, &len) != 0 || len <= 0) { return 0 }
    return proj.pool_str(off)
}

// cmd_env_is：环境变量存在且取值逐字节等于 want 时返回 1，否则 0。
fn cmd_env_is(name *char, want *char) int {
    let value *char = cmd_env_value(name)
    if (value == 0) { return 0 }
    let i int = 0
    for want[i] != 0 {
        if (value[i] != want[i]) { return 0 }
        i += 1
    }
    return (value[i] == 0).to_type(int)
}

// cmd_diag_setup：诊断渲染开关，进程内一次。
//   * plain：YH_DIAG_PLAIN 非空 → 只输出单行头（内部保险）；
//   * 颜色：YH_DIAG_COLOR=always|never 覆盖 > NO_COLOR > isatty(2)；
//   * 版本：登记给 ICE 行；worker 子进程走同一入口，自动继承。
fn cmd_diag_setup() void {
    errors.set_version(YH_VERSION_TEXT)
    if (cmd_env_value("YH_DIAG_PLAIN") != 0) {
        errors.set_plain(1)
    }
    let color int = -1
    if (cmd_env_is("YH_DIAG_COLOR", "always") != 0) { color = 1 }
    if (cmd_env_is("YH_DIAG_COLOR", "never") != 0) { color = 0 }
    if (color < 0) {
        if (cmd_env_value("NO_COLOR") != 0) {
            color = 0
        } else if (os.is_terminal(2) != 0) {
            color = 1
        } else {
            color = 0
        }
    }
    errors.set_color(color)
}

// api_open_source：单文件形态共用前奏——登记路径、读源、建语义表。
// 调用方必须已执行 cmd_session_init（driver 入口已做）。
fn api_open_source(path *char) int {
    support.src_ctx().path = path
    if (support.read_source(path) != 0) {
        return 1
    }
    if (check.sem_init_tables() != 0) {
        return 1
    }
    // F4：CT 执行器读的是类型表的「槽」，任务初始化时绑定一次即可对扩容免疫。
    check.ct_facts_sync()
    return 0
}
