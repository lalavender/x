module main
import build

// ============================================================================
// cmd_list.yh —— yh list [--resolve name]（P1 一命令一文件）。
// ============================================================================

// api_list：列出模块或解释导入绑定。
fn api_list(req *CliRequest) int {
    return build.mb_cmd_list(req.resolve, req.has_resolve)
}
