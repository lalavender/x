module main

// ============================================================================
// console.yh —— 控制台 UTF-8 初始化的平台无关入口（2026-11-10 自 support 迁入，
// ADR-0025）。实现见 console.<平台>.yh 的 console_utf8_init_impl；只有 main
// 入口在输出前调用一次。
// ============================================================================

// console_utf8_init：Windows 下把控制台码页切到 65001；其他平台为空实现。
fn console_utf8_init() {
    console_utf8_init_impl()
}
