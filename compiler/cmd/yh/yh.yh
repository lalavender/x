module main
import support
import build
import proj


fn init(){
    // 控制台 UTF-8（VENC）：Windows 下切 65001 码页，诊断/帮助的中文才
    // 不乱码；其他平台为空实现。必须在任何输出之前。
    support.console_utf8_init()

}

fn main(argc int, argv **char, envp **char) int {

    // 初始化
    init()
    
    let rargc int = argc
    let rargv **char = argv
    support.argv_utf8_rebuild(&rargc, &rargv)
    // 编译会话前奏：恢复 GenState、初始化项目模型、绑定目标/配置、
    // 记录自身路径与操作系统环境向量（见 common.yh cmd_session_init）。
    cmd_session_init(rargv[0], envp)

    // 内部子进程协议：`--emit-module <mod> <prov> <root> -o <dir> [...]`（豁免 cli）。
    // 上界 23（= 去掉程序名后的 22 项）：可选参数最多 --iface-suffix、--ir-key、
    // --check-only、--test-mode、--extra-file/--scan-file、--no-firc（4 个值参数 +
    // 5 个开关）；Windows 无 fork 的模块子进程会把这些全带上，旧的 13 会误判。
    if (rargc >= 7 && rargc <= 23 && support.cstr_eq(rargv[1], "--emit-module") != 0
        && support.cstr_eq(rargv[5], "-o") != 0) {
        return api_emit_module(rargv + 1, rargc - 1)
    }
    // 内部子进程协议：`--lld-link <响应文件>`（Windows 无 fork 的 COFF 链接
    // worker；响应文件每行一个 argv，由 link/windows_link.yh 写出）。
    if (rargc == 3 && support.cstr_eq(rargv[1], "--lld-link") != 0) {
        return api_lld_link(rargv[2])
    }

    
    if (rargc <= 1) {
        // 裸调用是用法错误（与 0.0.13 及之前一致）：打印完整用法后返回 2，
        // 脚本据此能区分「没给参数」与「构建成功」。
        print_bare_help(2)
        build.mb_print_version(1)
        return 2
    }

    let req CliRequest
    let message [1024]char
    let status int = parse_request(rargc, rargv, &req, &message[0], 1024)
    if (status != 0) {
        if (message[0] != 0) {
            support.fail(&message[0])
        }
        print_usage(&req, 2)
        release_request(&req)
        return status
    }
    // help/version 控制请求：正文写 stdout，退出 0。
    if (req.command == CLI_CONTROL) {
        print_control(&req, 1)
        release_request(&req)
        return 0
    }

    // —— 全局选项落进状态（诊断文本与旧手写扫描一致）——
    if (req.backend != 0) {
        if (support.cstr_eq(req.backend, "legacy") != 0) {
            support.fail("legacy 后端已在 LL12 退役；LLVM 是唯一代码生成后端")
            release_request(&req)
            return 2
        }
        if (support.cstr_eq(req.backend, "llvm") == 0) {
            support.fail("不支持的后端（只接受 llvm）")
            release_request(&req)
            return 2
        }
    }
    if (req.target != 0) {
        if (is_removed_target_alias(req.target) != 0) {
            support.fail("-target 需要完整三元组（如 aarch64-apple-darwin）；linux/darwin 等简写别名已随 LL12 移除")
            release_request(&req)
            return 2
        }
        if (support.target_select(req.target) != 0) {
            support.fail("不支持的目标 triple")
            release_request(&req)
            return 2
        }
        proj.cfg().target_explicit = 1
    }
    proj.cfg().opt_level = req.opt_level
    proj.cfg().trimpath = req.trimpath
    if (req.emit_llvm != 0) {
        proj.cfg().emit_kind = 1
    }
    if (req.emit_asm != 0) {
        proj.cfg().emit_asm = 1
    }
    if (req.legacy_system != 0) {
            support.session().legacy_system = 1
    }

    // —— 按命令分派（一命令一文件；req 生命周期归 driver，统一释放）——
    let rc int = 0
    if (req.command == CLI_FILE) {
        rc = api_single_file_request(&req)
    } else if (req.command == CLI_CHECK && req.has_src != 0
        && is_yh_source(req.src) != 0) {
        // yh check <file.yh>：源文件形态，走单文件检查。
        rc = api_check_source(req.src)
    } else if (req.command == CLI_CHECK) {
        // yh check [module]：项目态检查。
        rc = api_check_project(&req)
    } else if (req.command == CLI_BUILD) {
        rc = api_build(&req)
    } else if (req.command == CLI_RUN) {
        rc = api_run(&req)
    } else if (req.command == CLI_TEST) {
        rc = api_test(&req)
    } else if (req.command == CLI_CACHE) {
        rc = api_cache(&req)
    } else if (req.command == CLI_INIT) {
        rc = api_init(&req)
    } else {
        rc = api_version(&req)
    }
    release_request(&req)
    return rc
}
