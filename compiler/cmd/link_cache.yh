module main;
import gen;

// mb_hash_hex：把 64 位内容指纹格式化为固定长度十六进制串。
fn mb_hash_hex(h u64, out *u8) int {
    let digits *char = "0123456789abcdef";
    let n int = 0;
    let shift int = 60;
    for shift >= 0 {
        out[n] = digits[((h >> shift) & 15).to_type(int)].to_type(u8);
        n += 1;
        shift -= 4;
    }
    return n;
}

// mb_write_manifest：写缓存键；写失败时不保留可被误认的旧键。
fn mb_write_manifest(path *char, data *u8, data_len int) int {
    let fd int = mb_open_out(path);
    if (fd < 0) {
        return gen.fail_path("无法写缓存 manifest: ", path);
    }
    if (gen.write_all(fd, data, data_len) != 0) {
        close(fd);
        unlink(path);
        return -1;
    }
    if (close(fd) != 0) {
        unlink(path);
        return gen.fail_path("关闭缓存 manifest 失败: ", path);
    }
    return 0;
}

// mb_c_project_order：前序收集根项目及其本地依赖，去重并保持清单顺序。
fn mb_c_project_order(proj int, projects *int, count *int, capacity int) int {
    let gs *gen.GenState = gen.G();
    if (proj < 0 || proj >= gs.p_proj_n) { return -1; }
    let i int = 0;
    for i < count[0] {
        if (projects[i] == proj) { return 0; }
        i += 1;
    }
    if (count[0] >= capacity) { return gen.fail("C 项目依赖数量超出限制"); }
    projects[count[0]] = proj;
    count[0] += 1;
    let dep int = 0;
    for dep < gs.p_projs[proj].dep_n {
        let child int = gs.p_projs[proj].deps[dep].proj;
        if (mb_c_project_order(child, projects, count, capacity) != 0) { return -1; }
        dep += 1;
    }
    return 0;
}

// mb_c_obj_path：生成当前 build 目录下某个 C 源文件对应的对象路径。
fn mb_c_obj_path(build_off int, project int, source_index int, out *u8) int {
    let n int = 0;
    n = gen.append_str(out, n, pj_pool_str(build_off));
    n = gen.append_str(out, n, "/obj/c-");
    n = gen.append_int(out, n, project);
    n = gen.append_byte(out, n, '-');
    n = gen.append_int(out, n, source_index);
    n = gen.append_str(out, n, ".o");
    out[n] = 0;
    return n;
}

// mb_c_compile_sources：每次 build/run 重编可达项目的 C 源，避免漏掉头文件变化。
fn mb_c_compile_sources(projects *int, project_count int,
    build_off int, cc *char) int {
    let gs *gen.GenState = gen.G();
    let pi int = 0;
    for pi < project_count {
        let proj int = projects[pi];
        let si int = 0;
        for si < gs.p_projs[proj].c_source_n {
            let out [700]u8;
            mb_c_obj_path(build_off, proj, si, out);
            unlink(gen.arr_cstr(out));
            let args [6]*char;
            args[0] = cc;
            args[1] = "-c";
            args[2] = pj_pool_str(gs.p_projs[proj].c_sources[si].path_off);
            args[3] = "-o";
            args[4] = gen.arr_cstr(out);
            args[5] = 0.to_type(*char);
            if (cmd_process_run(&args[0]) != 0) {
                return gen.fail_path("C 源文件编译失败: ", args[2]);
            }
            si += 1;
        }
        pi += 1;
    }
    return 0;
}

// mb_c_input_hash：把 C 对象内容、输入路径和系统库名纳入最终链接缓存键。
fn mb_c_input_hash(hash *u64, projects *int, project_count int,
    build_off int) int {
    let gs *gen.GenState = gen.G();
    let pi int = 0;
    for pi < project_count {
        let proj int = projects[pi];
        let si int = 0;
        for si < gs.p_projs[proj].c_source_n {
            let object [700]u8;
            mb_c_obj_path(build_off, proj, si, object);
            if (mb_hash_file(hash, gen.arr_cstr(object)) != 0) { return -1; }
            let path_off int = gs.p_projs[proj].c_sources[si].path_off;
            let path_len int = gs.p_projs[proj].c_sources[si].path_len;
            let j int = 0;
            for j < path_len { mb_fnv(hash, gs.np_data[path_off + j]); j += 1; }
            mb_fnv(hash, 0);
            si += 1;
        }
        let oi int = 0;
        for oi < gs.p_projs[proj].c_object_n {
            let input gen.PInput = gs.p_projs[proj].c_objects[oi];
            if (mb_hash_file(hash, pj_pool_str(input.path_off)) != 0) { return -1; }
            let j2 int = 0;
            for j2 < input.path_len { mb_fnv(hash, gs.np_data[input.path_off + j2]); j2 += 1; }
            mb_fnv(hash, 0);
            oi += 1;
        }
        let li int = 0;
        for li < gs.p_projs[proj].c_lib_n {
            let lib gen.PInput = gs.p_projs[proj].c_libs[li];
            let j3 int = 0;
            for j3 < lib.path_len { mb_fnv(hash, gs.np_data[lib.path_off + j3]); j3 += 1; }
            mb_fnv(hash, 255);
            li += 1;
        }
        pi += 1;
    }
    return 0;
}

// mb_link：把模块汇编与可达项目 C 输入转对象并链接，缓存键覆盖全部对象。
// mb_asm_tool：决定把模块 .s 变成 .o 用哪个工具。
//
// 返回 1 表示用自研汇编器 yh_link，并把它的路径写进 candidate（调用方给的
// 定长缓冲）；返回 0 表示回落系统 cc（darwin 上 clang，其余 gcc）。
//
// 查找顺序：
//   1. 环境变量 YH_LINK——显式指定，优先级最高。
//   2. PATH 上的 yh_link——把两个可执行文件都装进 bin 目录时自然命中；
//      门禁脚本也靠这一条把 wrapper 插到 PATH 前面来观测真实进程调用。
//   3. 编译器可执行文件同目录下的 yh_link——`yh` 与 `yh_link` 放在一起但
//      目录不在 PATH 上时仍然能自动用上。
//
// yh_link 的汇编子集与本编译器的发射方言一一对应（@PAGE/@PAGEOFF、_ 前缀
// 符号），所以两边可以互换；对不上时应该让 yh_link 报错而不是静默用 cc，
// 因此这里只按「文件在不在」判断，不做能力探测。
fn mb_asm_tool(candidate *u8) int {
    let gs *gen.GenState = gen.G();
    let env_off int = -1;
    let env_len int = 0;
    if (pj_env_fetch("YH_LINK", &env_off, &env_len) != 0) {
        return 0;
    }
    if (env_len > 0 && gs.np_data[env_off] != 0) {
        let n int = 0;
        let k int = 0;
        for k < env_len {
            candidate[n] = gs.np_data[env_off + k];
            n += 1;
            k += 1;
        }
        candidate[n] = 0;
        if (pj_file_exists(gen.arr_cstr(candidate)) != 0) {
            return 1;
        }
        return 0;
    }
    if (mb_path_find("yh_link", candidate) != 0) {
        return 1;
    }
    // 与 c_argv0 同目录的 yh_link
    let slash int = -1;
    let i int = 0;
    for c_argv0[i] != 0 {
        if (c_argv0[i] == '/') {
            slash = i;
        }
        i += 1;
    }
    let n int = 0;
    let k int = 0;
    for k <= slash {
        candidate[n] = c_argv0[k].to_type(u8);
        n += 1;
        k += 1;
    }
    n = gen.append_str(candidate, n, "yh_link");
    candidate[n] = 0;
    if (pj_file_exists(gen.arr_cstr(candidate)) != 0) {
        return 1;
    }
    return 0;
}

// mb_path_find：在 PATH 上查找名为 name 的文件。找到返回 1 并把**绝对路径**
// 写进 candidate（调用方给的定长缓冲）；找不到返回 0。
// 空目录项按 POSIX 惯例解释为当前目录。
fn mb_path_find(name *char, candidate *u8) int {
    let gs *gen.GenState = gen.G();
    let path_off int = -1;
    let path_len int = 0;
    if (pj_env_fetch("PATH", &path_off, &path_len) != 0) {
        return 0;
    }
    let start int = 0;
    let end int = 0;
    for end <= path_len {
        if (end == path_len || gs.np_data[path_off + end] == ':') {
            let n int = 0;
            if (end == start) {
                n = gen.append_str(candidate, n, ".");
            } else {
                let k int = start;
                for k < end {
                    candidate[n] = gs.np_data[path_off + k];
                    n += 1;
                    k += 1;
                }
            }
            n = gen.append_byte(candidate, n, '/');
            n = gen.append_str(candidate, n, name);
            candidate[n] = 0;
            if (pj_file_exists(gen.arr_cstr(candidate)) != 0) {
                return 1;
            }
            start = end + 1;
        }
        end += 1;
    }
    return 0;
}

fn mb_link(out_path *char, build_off int, build_len int,
    count int, root_proj int) int {
    let gs *gen.GenState = gen.G();
    let object_start_ns u64 = 0;
    if (gs.c_stats_enabled != 0) {
        object_start_ns = cmd_clock_ns();
    }
    // 两步链接（用户规划：.build/asm → .build/obj → 链接）
    let cc *char = "gcc";
    if (gen.tg_darwin() != 0) {
        cc = "clang";
    }
    let project_capacity int = gs.p_proj_n > 0 ? gs.p_proj_n : 1;
    let c_projects *int = malloc((project_capacity * sizeof(int)).to_type(u64))
        .to_type(*int);
    if (c_projects == 0) { return gen.fail("C 项目顺序表内存分配失败"); }
    let c_project_n int = 0;
    if (mb_c_project_order(root_proj, c_projects, &c_project_n,
        project_capacity) != 0) { return -1; }
    let c_object_n int = 0;
    let c_lib_n int = 0;
    let cpi int = 0;
    for cpi < c_project_n {
        let cproj int = c_projects[cpi];
        c_object_n += gs.p_projs[cproj].c_source_n + gs.p_projs[cproj].c_object_n;
        c_lib_n += gs.p_projs[cproj].c_lib_n;
        cpi += 1;
    }
    if (mb_c_compile_sources(c_projects, c_project_n, build_off, cc) != 0) {
        return -1;
    }
    // 步骤 1：逐模块汇编为 .o
    let i int = 0;
    for i < count {
        let m int = pj_order[i];
        if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
            return -1;
        }
        let spath [600]u8;
        let sn int = 0;
        sn = gen.append_str(spath, sn, pj_pool_str(build_off));
        sn = gen.append_str(spath, sn, "/asm/");
        sn = gen.append_str(spath, sn, pj_pool_str(pj_canon_off));
        sn = gen.append_str(spath, sn, ".s");
        spath[sn] = 0;
        let opath [600]u8;
        let on2 int = 0;
        on2 = gen.append_str(opath, on2, pj_pool_str(build_off));
        on2 = gen.append_str(opath, on2, "/obj/");
        on2 = gen.append_str(opath, on2, pj_pool_str(pj_canon_off));
        on2 = gen.append_str(opath, on2, ".o");
        opath[on2] = 0;
        let obj_manifest [620]u8;
        let omn int = 0;
        omn = gen.append_str(obj_manifest, omn, pj_pool_str(build_off));
        omn = gen.append_str(obj_manifest, omn, "/obj/");
        omn = gen.append_str(obj_manifest, omn, pj_pool_str(pj_canon_off));
        omn = gen.append_str(obj_manifest, omn, ".manifest");
        obj_manifest[omn] = 0;
        let h u64 = mb_hash_init();
        if (mb_hash_file(&h, gen.arr_cstr(spath)) != 0) {
            return -1;
        }
        let ci int = 0;
        for cc[ci] != 0 {
            mb_fnv(&h, cc[ci].to_type(u8));
            ci += 1;
        }
        // 键里带上真实命令前缀：换工具链（cc ↔ yh_link）必然换键，
        // 否则会拿 cc 产出的旧对象当命中。
        let tool_buf [1200]u8;
        tool_buf[0] = 0;
        let use_yh int = mb_asm_tool(&tool_buf[0]);
        let cmd0 *char = cc;
        if (use_yh != 0) {
            cmd0 = gen.arr_cstr(&tool_buf[0]);
        }
        let ci2 int = 0;
        for cmd0[ci2] != 0 {
            mb_fnv(&h, cmd0[ci2].to_type(u8));
            ci2 += 1;
        }
        let flags *char = " -c";
        if (use_yh != 0) {
            flags = " asm";
        }
        let fi int = 0;
        for flags[fi] != 0 {
            mb_fnv(&h, flags[fi].to_type(u8));
            fi += 1;
        }
        if (gen.tg_darwin() != 0) {
            mb_fnv(&h, 'D');
        } else {
            mb_fnv(&h, 'L');
        }
        let want [16]u8;
        mb_hash_hex(h, want);
        let object_hit int = 0;
        if (pj_file_exists(gen.arr_cstr(opath)) != 0
            && pj_file_exists(gen.arr_cstr(obj_manifest)) != 0
            && gen.read_source(gen.arr_cstr(obj_manifest)) == 0 && gs.c_src_len == 32) {
            let key_matches int = 1;
            let k int = 0;
            for k < 16 {
                if (gs.c_src[k] != want[k]) {
                    key_matches = 0;
                    break;
                }
                k += 1;
            }
            let saved_object [16]u8;
            let k2 int = 0;
            for k2 < 16 {
                saved_object[k2] = gs.c_src[16 + k2];
                k2 += 1;
            }
            let hobj u64 = mb_hash_init();
            if (key_matches != 0 && mb_hash_file(&hobj, gen.arr_cstr(opath)) == 0) {
                let object_key [16]u8;
                mb_hash_hex(hobj, object_key);
                object_hit = 1;
                let k3 int = 0;
                for k3 < 16 {
                    if (saved_object[k3] != object_key[k3]) {
                        object_hit = 0;
                        break;
                    }
                    k3 += 1;
                }
            }
        }
        if (object_hit == 0) {
            unlink(gen.arr_cstr(obj_manifest));
            let args [8]*char;
            if (use_yh != 0) {
                // yh_link asm -t darwin -o <obj> <src>（Linux 目标不带 -t，
                // yh_link 的默认目标就是 ELF64）
                args[0] = gen.arr_cstr(&tool_buf[0]);
                args[1] = "asm";
                if (gen.tg_darwin() != 0) {
                    args[2] = "-t";
                    args[3] = "darwin";
                    args[4] = "-o";
                    args[5] = gen.arr_cstr(opath);
                    args[6] = gen.arr_cstr(spath);
                    args[7] = 0.to_type(*char);
                } else {
                    args[2] = "-o";
                    args[3] = gen.arr_cstr(opath);
                    args[4] = gen.arr_cstr(spath);
                    args[5] = 0.to_type(*char);
                }
            } else {
                args[0] = cc;
                args[1] = "-c";
                args[2] = gen.arr_cstr(spath);
                args[3] = "-o";
                args[4] = gen.arr_cstr(opath);
                args[5] = 0.to_type(*char);
            }
            if (gs.c_stats_enabled != 0) {
                gs.c_stats_asm += 1;
            }
            if (cmd_process_run(&args[0]) != 0) {
                return gen.fail_path("汇编失败: ", gen.arr_cstr(spath));
            }
            let object_hash u64 = mb_hash_init();
            if (mb_hash_file(&object_hash, gen.arr_cstr(opath)) != 0) {
                return -1;
            }
            let object_saved [32]u8;
            mb_hash_hex(h, object_saved);
            mb_hash_hex(object_hash, &object_saved[16]);
            if (mb_write_manifest(gen.arr_cstr(obj_manifest), object_saved, 32) != 0) {
                return -1;
            }
        }
        i += 1;
    }
    let link_start_ns u64 = 0;
    if (gs.c_stats_enabled != 0) {
        mb_stats_object_ns = cmd_clock_ns() - object_start_ns;
        link_start_ns = cmd_clock_ns();
    }
    // 最终链接键包括目标、参数、输出路径、模块顺序与全部对象内容。
    let hlink u64 = mb_hash_init();
    let cci int = 0;
    for cc[cci] != 0 {
        mb_fnv(&hlink, cc[cci].to_type(u8));
        cci += 1;
    }
    let link_flags *char = " -no-pie -o";
    if (gen.tg_darwin() != 0) {
        link_flags = " -o";
        mb_fnv(&hlink, 'D');
    } else {
        mb_fnv(&hlink, 'L');
    }
    mb_fnv(&hlink, ('0' + gs.c_legacy_system).to_type(u8));
    let lfi int = 0;
    for link_flags[lfi] != 0 {
        mb_fnv(&hlink, link_flags[lfi].to_type(u8));
        lfi += 1;
    }
    let oi int = 0;
    for out_path[oi] != 0 {
        mb_fnv(&hlink, out_path[oi].to_type(u8));
        oi += 1;
    }
    i = 0;
    for i < count {
        let m int = pj_order[i];
        if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
            return -1;
        }
        let tagoff int = pj_canon_off;
        let taglen int = pj_canon_len;
        let ti int = 0;
        for ti < taglen {
            mb_fnv(&hlink, gs.np_data[tagoff + ti]);
            ti += 1;
        }
        let opath [600]u8;
        let on3 int = 0;
        on3 = gen.append_str(opath, on3, pj_pool_str(build_off));
        on3 = gen.append_str(opath, on3, "/obj/");
        on3 = gen.append_str(opath, on3, pj_pool_str(tagoff));
        on3 = gen.append_str(opath, on3, ".o");
        opath[on3] = 0;
        if (mb_hash_file(&hlink, gen.arr_cstr(opath)) != 0) {
            return -1;
        }
        i += 1;
    }
    if (mb_c_input_hash(&hlink, c_projects, c_project_n, build_off) != 0) {
        return -1;
    }
    let link_want [16]u8;
    mb_hash_hex(hlink, link_want);
    let link_manifest [620]u8;
    let lmn int = 0;
    lmn = gen.append_str(link_manifest, lmn, pj_pool_str(build_off));
    lmn = gen.append_str(link_manifest, lmn, "/manifest/link.manifest");
    link_manifest[lmn] = 0;
    // manifest 同时校验输出文件内容，避免跳过被用户覆盖的产物。
    let link_hit int = 0;
    if (pj_file_exists(out_path) != 0 && pj_file_exists(gen.arr_cstr(link_manifest)) != 0
        && gen.read_source(gen.arr_cstr(link_manifest)) == 0 && gs.c_src_len == 32) {
        let key_matches int = 1;
        let sk int = 0;
        for sk < 16 {
            if (gs.c_src[sk] != link_want[sk]) {
                key_matches = 0;
                break;
            }
            sk += 1;
        }
        let saved_output [16]u8;
        let sk2 int = 0;
        for sk2 < 16 {
            saved_output[sk2] = gs.c_src[16 + sk2];
            sk2 += 1;
        }
        let hout u64 = mb_hash_init();
        if (key_matches != 0 && mb_hash_file(&hout, out_path) == 0) {
            let output_key [16]u8;
            mb_hash_hex(hout, output_key);
            let j int = 0;
            link_hit = 1;
            for j < 16 {
                if (saved_output[j] != output_key[j]) {
                    link_hit = 0;
                    break;
                }
                j += 1;
            }
        }
    }
    if (link_hit != 0) {
        if (gs.c_stats_enabled != 0) {
            mb_stats_link_ns = cmd_clock_ns() - link_start_ns;
        }
        return 0;
    }
    unlink(gen.arr_cstr(link_manifest));
    // 步骤 2：链接全部 .o
    let argc int = count + c_object_n + c_lib_n + 8;
    let args **char = malloc((argc * sizeof(*char)).to_type(u64)).to_type(**char);
    let paths *u8 = malloc(((count > 0 ? count : 1) * 620).to_type(u64)).to_type(*u8);
    let cpaths *u8 = malloc(((c_object_n > 0 ? c_object_n : 1) * 700).to_type(u64)).to_type(*u8);
    let libpaths *u8 = malloc(((c_lib_n > 0 ? c_lib_n : 1) * 128).to_type(u64)).to_type(*u8);
    if (args == 0 || paths == 0 || cpaths == 0 || libpaths == 0) {
        if (args != 0) { free(args.to_type(*void)); }
        if (paths != 0) { free(paths.to_type(*void)); }
        if (cpaths != 0) { free(cpaths.to_type(*void)); }
        if (libpaths != 0) { free(libpaths.to_type(*void)); }
        return gen.fail("链接 argv 缓冲分配失败");
    }
    let next_arg int = 0;
    args[next_arg] = cc;
    next_arg += 1;
    if (gen.tg_darwin() == 0) {
        args[next_arg] = "-no-pie";
        next_arg += 1;
    }
    args[next_arg] = "-o";
    next_arg += 1;
    args[next_arg] = out_path;
    next_arg += 1;
    i = 0;
    for i < count {
        let m int = pj_order[i];
        if (mb_mod_tag(m, &pj_canon_off, &pj_canon_len) != 0) {
            free(args.to_type(*void));
            free(paths.to_type(*void));
            free(cpaths.to_type(*void));
            free(libpaths.to_type(*void));
            return -1;
        }
        let row *u8 = paths + (i * 620);
        let n int = 0;
        n = gen.append_str(row, n, pj_pool_str(build_off));
        n = gen.append_str(row, n, "/obj/");
        n = gen.append_str(row, n, pj_pool_str(pj_canon_off));
        n = gen.append_str(row, n, ".o");
        row[n] = 0;
        args[next_arg] = row.to_type(*char);
        next_arg += 1;
        i += 1;
    }
    let cp int = 0;
    let cpath_i int = 0;
    for cp < c_project_n {
        let cproj int = c_projects[cp];
        let si2 int = 0;
        for si2 < gs.p_projs[cproj].c_source_n {
            let row2 *u8 = cpaths + (cpath_i * 700);
            mb_c_obj_path(build_off, cproj, si2, row2);
            args[next_arg] = row2.to_type(*char);
            next_arg += 1;
            cpath_i += 1;
            si2 += 1;
        }
        let oi2 int = 0;
        for oi2 < gs.p_projs[cproj].c_object_n {
            args[next_arg] = pj_pool_str(gs.p_projs[cproj].c_objects[oi2].path_off);
            next_arg += 1;
            oi2 += 1;
        }
        cp += 1;
    }
    cp = 0;
    let libpath_i int = 0;
    for cp < c_project_n {
        let cproj2 int = c_projects[cp];
        let li2 int = 0;
        for li2 < gs.p_projs[cproj2].c_lib_n {
            let lib gen.PInput = gs.p_projs[cproj2].c_libs[li2];
            let row3 *u8 = libpaths + (libpath_i * 128);
            let ln int = gen.append_str(row3, 0, "-l");
            ln = append_bytes_np(row3, ln, lib.path_off, lib.path_len);
            row3[ln] = 0;
            args[next_arg] = row3.to_type(*char);
            next_arg += 1;
            libpath_i += 1;
            li2 += 1;
        }
        cp += 1;
    }
    // Linux：glibc 把数学函数放在独立的 libm 里，libs/math 与标准库用到
    // cos/pow 等；Darwin 的 libSystem 已包含（宿主链接命令按宿主平台取）。
    if (gen.tg_host_darwin() == 0) {
        args[next_arg] = "-lm";
        next_arg += 1;
    }
    args[next_arg] = 0.to_type(*char);
    if (gs.c_stats_enabled != 0) {
        gs.c_stats_link += 1;
    }
    let link_rc int = cmd_process_run(&args[0]);
    free(args.to_type(*void));
    free(paths.to_type(*void));
    free(cpaths.to_type(*void));
    free(libpaths.to_type(*void));
    if (link_rc != 0) {
        return gen.fail_path("链接失败: ", out_path);
    }
    let final_hash u64 = mb_hash_init();
    if (mb_hash_file(&final_hash, out_path) != 0) {
        return -1;
    }
    let link_saved [32]u8;
    mb_hash_hex(hlink, link_saved);
    mb_hash_hex(final_hash, &link_saved[16]);
    if (mb_write_manifest(gen.arr_cstr(link_manifest), link_saved, 32) != 0) {
        return -1;
    }
    if (gs.c_stats_enabled != 0) {
        mb_stats_link_ns = cmd_clock_ns() - link_start_ns;
    }
    return 0;
}
