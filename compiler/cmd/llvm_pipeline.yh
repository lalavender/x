module main
import gen
import ast
import check
import ir
import backend

// ============================================================================
// llvm_pipeline.yh —— 已验证受检快照到 LLVM 文本/对象/汇编的共用驱动（LA1a）
//
// 单文件入口（cmd/llvm_emit.yh）与项目 worker（cmd/module_worker.yh）都必须
// 经过这里的同一条路径：
//   受检快照（CheckedModule）→ 模块 IR（ir.IRModule）→ LLVM 文本
//   → 内嵌静态桥（backend.llvm_bridge_emit）→ 临时文件 → 校验 → 原子发布。
//
// 边界（实施方案 LA1a）：
//   * 快照由调用方独占并在返回后释放；本文件只借用且不修改快照；
//   * 成功时交出独占的模块 IR/LLVMOutput，失败时释放候选并保持出参为零；
//   * 统计只在真正完成发射后累计一次；
//   * 正式对象只在完整写完后 rename 发布，失败不留下看似成功的产物；
//   * 不恢复旧机器发射，不调用外部 LLVM 工具。
// ============================================================================

// llvm_emit_reason：把桥的诊断文本拼进带来源位置的诊断行并写 stderr。
// path/line/col 来自模块符号的来源记录；桥文本可能为空（分配失败等）。
fn llvm_emit_reason(unit *ir.IRModule, source int, offset int, reason *char) void {
    let buffer [2048]u8
    let n int = 0
    let path *char = "<LLVM 模块>"
    let line int = 1
    let col int = 1
    if (unit != 0 && source >= 0 && source < unit.source_count) {
        let input ir.IRModuleSource = unit.sources[source]
        path = input.path
        let i int = 0
        for i < offset && i < input.length {
            if (input.text[i] == '\n') { line += 1; col = 1 } else { col += 1 }
            i += 1
        }
    }
    n = gen.append_str(&buffer[0], n, path)
    n = gen.append_byte(&buffer[0], n, ':')
    n = gen.append_int(&buffer[0], n, line)
    n = gen.append_byte(&buffer[0], n, ':')
    n = gen.append_int(&buffer[0], n, col)
    n = gen.append_str(&buffer[0], n, ": 错误: LLVM 后端: ")
    if (reason != 0 && reason[0] != 0) {
        n = gen.append_str_limit(&buffer[0], n, 1900, reason)
    } else {
        n = gen.append_str(&buffer[0], n, "内嵌桥拒绝该模块（诊断缓冲为空）")
    }
    n = gen.append_byte(&buffer[0], n, '\n')
    gen.write_all(2, &buffer[0], n)
}

// llvm_emit_with_target：Linux 沿用 v1；Darwin 使用已校验会话配置调用带部署版本的 v2。
fn llvm_emit_with_target(text *char, length int, triple *char, opt_level int,
    kind int, path *char, reason *char) int {
    if (gen.G().c_target.os == gen.TARGET_OS_DARWIN) {
        let min_os *char = cmd_darwin_min_os()
        if (min_os == 0) { return -1 }
        return backend.llvm_bridge_emit_v2(text, length, triple, min_os,
            opt_level, kind, path, reason)
    }
    return backend.llvm_bridge_emit(text, length, triple, opt_level,
        kind, path, reason)
}

// llvm_emit_verify_checked_snapshot：保留快照捕获原有的具体失败诊断。
fn llvm_emit_verify_checked_snapshot(unit *ast.CheckedModule) int {
    let stage int = check.verify_checked_module(unit)
    if (stage == 0) { return 0 }
    if (stage == 1) { return gen.fail("受检模块快照表存储无效") }
    if (stage == 2) { return gen.fail("受检模块类型或函数签名快照校验失败") }
    if (stage == 3) { return gen.fail("受检模块字段类型快照校验失败") }
    if (stage == 4) { return gen.fail("受检模块函数参数签名快照校验失败") }
    if (stage == 5) { return gen.fail("受检模块类型别名快照校验失败") }
    if (stage == 6) { return gen.fail("受检模块符号类型快照校验失败") }
    if (stage == 7) { return gen.fail("受检模块文件快照校验失败") }
    if (stage == 8) { return gen.fail("受检模块表达式快照校验失败") }
    if (stage == 9) { return gen.fail("受检模块语句快照校验失败") }
    if (stage == 10) { return gen.fail("受检模块函数快照校验失败") }
    return gen.fail("受检模块快照校验失败")
}

// llvm_emit_add_deployment_metadata：为 Darwin LLVM 文本补充与桥接器一致的规范化最低系统版本。
fn llvm_emit_add_deployment_metadata(output *backend.LLVMOutput) int {
    if (gen.G().c_target.os != gen.TARGET_OS_DARWIN) { return 0 }
    let min_os *char = cmd_darwin_min_os()
    if (min_os == 0) { return -1 }
    return backend.llvm_output_add_macos_min_os(output, min_os)
}

// llvm_prepare_module：已验证快照 → 模块 IR → LLVM 文本（含目标部署元数据）。
// 两个出参由调用方零初始化；成功返回 0 并交出独占所有权，失败释放候选并保持出参为零。
// 返回 lower_module 的 1（首片不支持，已带来源诊断）或 -1（内部错误）。
fn llvm_prepare_module(unit *ast.CheckedModule, mod_ir *ir.IRModule,
    output *backend.LLVMOutput) int {
    return llvm_prepare_module_cached(unit, mod_ir, output, 0, 0, 0, 0)
}

// llvm_prepare_module_cached：LA3 函数级缓存版本；cache 为空时与无缓存路径相同。
fn llvm_prepare_module_cached(unit *ast.CheckedModule, mod_ir *ir.IRModule,
    output *backend.LLVMOutput, cache_in *ir.IRFunctionCacheSet,
    cache_out *ir.IRFunctionCacheSet, env_key u64,
    lower_stats *ast.CheckedLowerStats) int {
    let gs *gen.GenState = gen.G()
    let lowered int = ast.lower_module_cached(unit, mod_ir, cache_in, cache_out,
        env_key, lower_stats)
    if (lowered != 0) {
        // lower_module 已按首片契约写好带来源的拒绝诊断，这里不再重复。
        return lowered
    }
    gs.c_stats_checked_functions += mod_ir.function_count
    if (backend.llvm_emit_module(mod_ir, &gs.c_target, output) != 0) {
        ir.ir_module_release(mod_ir)
        return -1
    }
    if (llvm_emit_add_deployment_metadata(output) != 0) {
        backend.llvm_output_release(output)
        ir.ir_module_release(mod_ir)
        return -1
    }
    return 0
}

// llvm_emit_write_text：写出审阅用 LLVM 文本；"-" 表示标准输出。
// 返回 0 成功、-1 写失败。单文件/文本专用路径把它视为致命，对象路径只报告。
fn llvm_emit_write_text(output *backend.LLVMOutput, text_path *char) int {
    if (output == 0 || text_path == 0) { return 0 }
    let gs *gen.GenState = gen.G()
    if (gen.cstr_eq(text_path, "-") != 0) {
        return gen.write_all(1, output.text, output.length) == 0 ? 0 : -1
    }
    let flags int = gs.c_host_target.os == gen.TARGET_OS_DARWIN ? 0x601 : 0x241
    let fd int = open(text_path, flags, 0x1a4)
    if (fd < 0) {
        gen.fail_path("无法创建 LLVM 文本: ", text_path)
        return -1
    }
    let written int = 0
    for written < output.length {
        let step i64 = write(fd, output.text + written,
            (output.length - written).to_type(u64))
        if (step <= 0) {
            gen.fail_path("写入 LLVM 文本失败: ", text_path)
            close(fd)
            return -1
        }
        written += step.to_type(int)
    }
    close(fd)
    return 0
}

// llvm_emit_temp_path：生成桥的临时输出路径 <out>.tmp.<pid>。
// 返回 0 成功；路径超过固定缓冲时返回 -1（不截断成另一个合法文件名）。
fn llvm_emit_temp_path(buffer *u8, path *char) int {
    let n int = gen.append_str_limit(buffer, 0, 1000, path)
    if (path[n] != 0) { return -1 }
    n = gen.append_str(buffer, n, ".tmp.")
    n = gen.append_int(buffer, n, getpid())
    buffer[n] = 0
    return 0
}

// llvm_emit_publish：调用内嵌桥写临时文件，校验目标格式后 rename 发布。
// kind：0 = 对象，1 = 汇编。成功返回 0；桥失败返回 1（reason 有效，可能为空）；
// 路径/机器格式/rename 失败返回 -1（已写诊断）。
fn llvm_emit_publish(output *backend.LLVMOutput, kind int, out_path *char,
    reason *char) int {
    let gs *gen.GenState = gen.G()
    let temporary [1024]u8
    if (llvm_emit_temp_path(&temporary[0], out_path) != 0) {
        return gen.fail_path("LLVM 产物路径过长: ", out_path)
    }
    unlink(gen.arr_cstr(&temporary[0]))
    if (llvm_emit_with_target(output.text.to_type(*char), output.length,
            gs.c_target.triple, gs.c_opt_level, kind,
            gen.arr_cstr(&temporary[0]), reason) != 0) {
        unlink(gen.arr_cstr(&temporary[0]))
        return 1
    }
    if (kind == 0 && mb_object_machine_matches(gen.arr_cstr(&temporary[0])) == 0) {
        unlink(gen.arr_cstr(&temporary[0]))
        return gen.fail_path("LLVM 桥发出的对象架构与 target 不符: ", out_path)
    }
    if (rename(gen.arr_cstr(&temporary[0]), out_path) != 0) {
        unlink(gen.arr_cstr(&temporary[0]))
        return gen.fail_path("无法发布 LLVM 产物: ", out_path)
    }
    return 0
}

// llvm_emit_module_to：把已由调用方校验且未修改的快照降低为模块 IR 并经内嵌桥发布产物。
// kind：0 = 目标文件（对象），1 = 汇编文本；out_path 为产物路径，text_path 非空时
// 额外写出 LLVM 文本（审阅/差分用，失败不致命）。
// 返回 0 成功、-1 失败（诊断已写 stderr，且不发布任何产物）。
fn llvm_emit_module_to(unit *ast.CheckedModule, kind int, out_path *char,
    text_path *char, stats *LLVMEmitResult) int {
    return llvm_emit_module_to_cached(unit, kind, out_path, text_path, stats,
        0, 0, 0, 0)
}

// llvm_emit_module_to_cached：LA3 项目 worker 使用的带函数缓存版本。
fn llvm_emit_module_to_cached(unit *ast.CheckedModule, kind int, out_path *char,
    text_path *char, stats *LLVMEmitResult, cache_in *ir.IRFunctionCacheSet,
    cache_out *ir.IRFunctionCacheSet, env_key u64,
    lower_stats *ast.CheckedLowerStats) int {
    let gs *gen.GenState = gen.G()
    let mod_ir ir.IRModule
    let output backend.LLVMOutput
    let prepared int = llvm_prepare_module_cached(unit, &mod_ir, &output,
        cache_in, cache_out, env_key, lower_stats)
    if (prepared != 0) { return -1 }
    // LLVM 文本是审阅产物：写失败只报告，不影响对象发布。
    llvm_emit_write_text(&output, text_path)
    let reason [backend.LLVM_BRIDGE_DIAG]u8
    let published int = llvm_emit_publish(&output, kind, out_path,
        (&reason[0]).to_type(*char))
    if (published != 0) {
        if (published == 1) {
            // 桥失败：按模块第一个来源定位，便于把 LLVM 错误映射回 yh 源码。
            let source int = 0
            let offset int = 0
            if (mod_ir.symbol_count > 0) {
                source = mod_ir.symbols[0].source
                offset = mod_ir.symbols[0].offset
            }
            llvm_emit_reason(&mod_ir, source, offset, (&reason[0]).to_type(*char))
        }
        backend.llvm_output_release(&output)
        ir.ir_module_release(&mod_ir)
        return -1
    }
    if (stats != 0) {
        stats.emitted = output.emitted
        stats.text_length = output.length
    }
    gs.c_stats_backend_emitted += output.emitted
    backend.llvm_output_release(&output)
    ir.ir_module_release(&mod_ir)
    return 0
}

// llvm_emit_text_only：只对已校验且未修改的快照做 lowering 与文本发射，不调用内嵌桥。
// 供 --emit-llvm 审阅形态使用（单文件写标准输出，项目写 .build/<target>/llvm/<tag>.ll）。
// 返回 0 成功、1 首片不支持（lowering 已给来源诊断）、-1 内部错误。
fn llvm_emit_text_only(unit *ast.CheckedModule, text_path *char,
    stats *LLVMEmitResult) int {
    let gs *gen.GenState = gen.G()
    let mod_ir ir.IRModule
    let output backend.LLVMOutput
    let prepared int = llvm_prepare_module(unit, &mod_ir, &output)
    if (prepared != 0) { return prepared }
    let status int = llvm_emit_write_text(&output, text_path)
    if (stats != 0) {
        stats.emitted = output.emitted
        stats.text_length = output.length
    }
    gs.c_stats_backend_emitted += output.emitted
    backend.llvm_output_release(&output)
    ir.ir_module_release(&mod_ir)
    return status
}
