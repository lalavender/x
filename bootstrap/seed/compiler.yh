// ============================================================================
// buffer.yh —— 自举编译器：源文件读取、字节写出与诊断
//
// 职责（docs/02-plan/yh-自举实施方案-v2.md §3）：
//   * read_source：open/read/close 把完整源文件读进内存。处理短读、
//     NUL 字节与容量增长；EOF 时 read 返回 0、错误返回负数。
//   * write_all：write 循环处理短写；诊断一律写文件描述符 2。
//   * err_lc / fail：带位置与不带位置的诊断。诊断格式
//         <path>:<line>:<col>: 错误: <msg>
//     推测解析期间（c_spec > 0）诊断静默且不计数——试探失败由返回值
//     传递，真正失败由回退路径重新解析后报告。
// ============================================================================

// append_byte：向 buf 的 n 处写入一个字节，返回新的写入位置。
// 仅用于栈上小缓冲（诊断消息拼装），不做容量检查——调用方保证空间。
pub fn append_byte(buf *u8, n int, b u8) int {
    buf[n] = b;
    return n + 1;
}

// append_str：向 buf 追加一个 NUL 结尾字符串（不含结尾 NUL），返回新位置。
pub fn append_str(buf *u8, n int, s *char) int {
    let i int = 0;
    for s[i] != 0 {
        buf[n] = s[i].to_type(u8);
        n += 1;
        i += 1;
    }
    return n;
}

// append_int：向 buf 追加十进制整数（含负号），返回新位置。
// 行号/列号规模远小于 2^31，不处理 INT_MIN 取负溢出。
pub fn append_int(buf *u8, n int, v int) int {
    if (v < 0) {
        buf[n] = '-';
        n += 1;
        v = -v;
    }
    // 逆序取位到 tmp，再反向拷入 buf
    let tmp [12]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    for k > 0 {
        k -= 1;
        buf[n] = tmp[k];
        n += 1;
    }
    return n;
}

// write_all：把 buf 前 n 个字节全部写到 fd。
// write 可能短写（返回实际写出字节数），循环推进直到写完；负返回视为错误。
pub fn write_all(fd int, buf *u8, n int) int {
    let done int = 0;
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64));
        if (w <= 0) {
            return -1;
        }
        done += w.to_type(int);
    }
    return 0;
}

// err_lc：报告一条带位置的错误（1 基行列），计一次错误并返回 -1。
// 推测解析期间静默：不打印、不计数，仅以返回值示意失败。
pub fn err_lc(line int, col int, msg *char) int {
    if (c_spec > 0) {
        return -1;
    }
    c_errors += 1;
    // 单缓冲拼装后一次写出，避免多条 write 交错
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, c_path);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, line);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, col);
    n = append_str(buf, n, ": 错误: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// fail：报告一条不带位置的编译器级错误（打开失败、内存不足等），返回 -1。
pub fn fail(msg *char) int {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, "yh: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// fail_path：报告与源文件路径相关的错误（如无法打开），返回 -1。
pub fn fail_path(msg *char, path *char) int {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, "yh: ");
    n = append_str(buf, n, msg);
    n = append_str(buf, n, path);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// cstr_eq：按字节比较两个 NUL 结尾字符串，相等返回 1。
// prelude 没有 strcmp，这里手写；仅用于命令行参数比对。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0;
    for 1 {
        if (a[i] != b[i]) {
            return 0;
        }
        if (a[i] == 0) {
            return 1;
        }
        i += 1;
    }
    return 0;
}

// arr_cstr：把字节缓冲当作 NUL 结尾 C 字符串取 *char。
// 注意：数组局部不可直接 `.to_type(*char)`（接收者语义不同），必须先
// 作参数传递完成退化（本函数的 buf 参数），再对指针做类型转换。
pub fn arr_cstr(buf *u8) *char {
    return buf.to_type(*char);
}

// ---------------------------------------------------------------------------
// 汇编输出缓冲：.text（o_out/o_len/o_cap）与 .data（o_dat/o_dlen/o_dcap）。
// 全部汇编先写入缓冲，编译成功后由 flush_output 一次性写到标准输出——
// 错误不会留下看似成功的部分汇编。
// ---------------------------------------------------------------------------

// out_grow：把 data/cap 指向的缓冲扩容到至少能容纳 need 字节。
// 成功返回 0，分配失败输出诊断并返回 -1。
pub fn out_grow(data **u8, n int, cap *int, need int) int {
    if (n < *cap) {
        return 0;
    }
    let ncap int = *cap * 2;
    if (ncap == 0) {
        ncap = 65536;
    }
    if (ncap < need) {
        ncap = need;
    }
    let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
    if (nd == 0) {
        return fail("内存分配失败");
    }
    if (n > 0) {
        memcpy(nd, *data, n.to_type(u64));
    }
    free(*data);
    *data = nd;
    *cap = ncap;
    return 0;
}

// em_put：向 .text 缓冲追加一个字节。全部 .text 发射（frag/ins/puti/
// 标签号）都汇聚于此：c_em_suppress > 0 时整体静默（sizeof(expr)
// 只求型不发码），单点闸门即可抑制整棵表达式求值的指令输出。
pub fn em_put(b u8) int {
    if (c_em_suppress > 0) {
        return 0;
    }
    // 函数体发射期间先进体缓冲（帧大小确定后再与 prologue 装配）
    if (c_in_body != 0) {
        if (out_grow(&o_body, o_body_len, &o_body_cap, o_body_len + 1) != 0) {
            return -1;
        }
        o_body[o_body_len] = b;
        o_body_len += 1;
        return 0;
    }
    if (out_grow(&o_out, o_len, &o_cap, o_len + 1) != 0) {
        return -1;
    }
    o_out[o_len] = b;
    o_len += 1;
    return 0;
}

// em_puts：向 .text 缓冲追加 NUL 结尾字符串（不含 NUL）。
pub fn em_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (em_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// em_puti：向 .text 缓冲追加十进制整数（指令操作数用）。
pub fn em_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    let neg int = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    if (neg != 0) {
        if (em_put('-') != 0) {
            return -1;
        }
    }
    for k > 0 {
        k -= 1;
        if (em_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// dat_put / dat_puts：向 .data 缓冲追加（全局数据发射用）。
pub fn dat_put(b u8) int {
    if (out_grow(&o_dat, o_dlen, &o_dcap, o_dlen + 1) != 0) {
        return -1;
    }
    o_dat[o_dlen] = b;
    o_dlen += 1;
    return 0;
}

// dat_puts：向 .data 缓冲追加 NUL 结尾字符串。
pub fn dat_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (dat_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// dat_puti：向 .data 缓冲追加十进制整数。
pub fn dat_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    let neg int = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    if (neg != 0) {
        if (dat_put('-') != 0) {
            return -1;
        }
    }
    for k > 0 {
        k -= 1;
        if (dat_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// bss_put / bss_puts / bss_puti：向 .bss 缓冲追加。
pub fn bss_put(b u8) int {
    if (out_grow(&o_bss, o_blen, &o_bcap, o_blen + 1) != 0) {
        return -1;
    }
    o_bss[o_blen] = b;
    o_blen += 1;
    return 0;
}

pub fn bss_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (bss_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

pub fn bss_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    for k > 0 {
        k -= 1;
        if (bss_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// flush_output：把 .text/.data/.bss 缓冲写到标准输出（文件描述符 1）。
// 段头（.data/.bss）在此处补写；成功返回 0。
pub fn flush_output() int {
    return flush_output_fd(1);
}

// flush_output_fd：把已发射的 .text/.data/.bss 写入指定文件描述符。
// 供 --emit-asm（fd=1，标准输出）与 -o（fd=临时汇编文件）共用。
pub fn flush_output_fd(fd int) int {
    if (write_all(fd, o_out, o_len) != 0) {
        return -1;
    }
    let hdr_data *char = "\n.data\n";
    let hdr_bss *char = "\n.bss\n";
    if (o_dlen > 0) {
        if (write_all(fd, hdr_data.to_type(*u8), 7) != 0) {
            return -1;
        }
        if (write_all(fd, o_dat, o_dlen) != 0) {
            return -1;
        }
    }
    if (o_blen > 0) {
        if (write_all(fd, hdr_bss.to_type(*u8), 6) != 0) {
            return -1;
        }
        if (write_all(fd, o_bss, o_blen) != 0) {
            return -1;
        }
    }
    return 0;
}

// read_source：读取完整源文件到 c_src / c_src_len。
// 流程：open（O_RDONLY=0）→ 循环 read 到倍增缓冲（read 返回 0 即 EOF，
// 负数即错误）→ close。缓冲初始 64 KiB，每次翻倍并整体拷贝；
// NUL 字节按普通字节保留，长度以累计字节数为准。
// 成功返回 0；任何一步失败释放资源、输出诊断并返回 -1。
pub fn read_source(path *char) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return fail_path("无法打开文件: ", path);
    }
    let cap int = 65536;
    let data *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (data == 0) {
        close(fd);
        return fail("内存分配失败");
    }
    let blen int = 0;
    for 1 {
        // 保证至少 64 KiB 余量再读（read 一次最多取 64 KiB）
        if (cap - blen < 65536) {
            let ncap int = cap * 2;
            let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
            if (nd == 0) {
                free(data);
                close(fd);
                return fail("内存分配失败");
            }
            memcpy(nd, data, blen.to_type(u64));
            free(data);
            data = nd;
            cap = ncap;
        }
        let n i64 = read(fd, data + blen, (cap - blen).to_type(u64));
        if (n < 0) {
            free(data);
            close(fd);
            return fail_path("读取失败: ", path);
        }
        if (n == 0) {
            break;
        }
        blen += n.to_type(int);
    }
    close(fd);
    c_src = data;
    c_src_len = blen;
    return 0;
}

// err_tok：以当前 token 的行列位置报错（解析器与语义共用；
// 自 parse_type.yh 迁入使 gen 无反向 import——ADR-0007 P3 解环）。

// err_tok：以当前 token 的行列位置报错，返回 -1。
pub fn err_tok(msg *char) int {
    return err_lc(c_toks[c_pos].line, c_toks[c_pos].col, msg);
}


// ============================================================================
// lexer.yh —— 自举编译器：字节词法器
//
// 把 c_src 一次性扫描为 token 表（c_toks）。对齐 docs/yh.g4 的词法规则：
//   * 注释（// 与块注释）与空白直接跳过，不产生 token；
//   * 标识符 [A-Za-z_][A-Za-z0-9_]*，命中保留字表则给对应关键字种类；
//   * 数字：0x/0X 十六进制、0b/0B 二进制、0o/0O 八进制、十进制（可带
//     小数与指数）；下划线必须夹在两个数字之间，前缀后无数字时按
//     ANTLR 参考回退为十进制 '0'（后续字节重新分词）；
//   * 字符串/字符字面量：转义集合 \n \r \t \0 \a \b \f \v \' \" \\ 与
//     \xNN；未知转义、未终结、字符串内换行都是词法错误；
//   * 运算符最长匹配（<<= >>= ... 优先于 <<= 之前的两字符与单字符）；
//     不存在 ++ -- -> 等token（rejected/15/16 依赖）。
//
// token 不复制字符串，start/len 引用 c_src；行号列号由主循环维护
//（只有主循环跨越换行），token 扫描内部不会遇到换行（字符串/字符中
// 出现换行直接报错）。
// ============================================================================

// is_ident_start：标识符首字符（字母或下划线）。
pub fn is_ident_start(b u8) int {
    if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_') {
        return 1;
    }
    return 0;
}

// is_digit：十进制数字。
pub fn is_digit(b u8) int {
    return (b >= '0' && b <= '9').to_type(int);
}

// is_hex_digit：十六进制数字。
pub fn is_hex_digit(b u8) int {
    if (is_digit(b)) {
        return 1;
    }
    if (b >= 'a' && b <= 'f') {
        return 1;
    }
    if (b >= 'A' && b <= 'F') {
        return 1;
    }
    return 0;
}

// lex_bytes_eq：比较 c_src[start..start+n) 与字面量 lit 的前 n 个字节。
// 保留字识别用；lit 是编译进本编译器的短字面量。
pub fn lex_bytes_eq(start int, lit *char, n int) int {
    let i int = 0;
    for i < n {
        if (c_src[start + i] != lit[i].to_type(u8)) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// err_here：以字节下标 i 换算行列（行号由主循环维护）报告词法错误。
// 返回 -1 便于调用方链式返回。
pub fn err_here(i int, msg *char) int {
    return err_lc(lx_line, i - lx_lstart + 1, msg);
}

// kw_kind：保留字查表。参数是标识符在 c_src 中的区间。
// 按首字符分桶 + 定长字节比较；返回 token 种类，非保留字返回 0。
// 三组：语言关键字（TK_PUB..TK_TO_TYPE）、已移除关键字（TK_RESERVED）、
// 内建类型名（TK_INT..TK_VOID）。
pub fn kw_kind(start int, n int) int {
    let b u8 = c_src[start];
    if (b == 'a') {
        if (n == 2 && lex_bytes_eq(start, "as", 2)) { return TK_AS; }
        if (n == 4 && lex_bytes_eq(start, "auto", 4)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'b') {
        if (n == 4 && lex_bytes_eq(start, "bool", 4)) { return TK_BOOL; }
        if (n == 5 && lex_bytes_eq(start, "break", 5)) { return TK_BREAK; }
        return 0;
    }
    if (b == 'c') {
        if (n == 4 && lex_bytes_eq(start, "case", 4)) { return TK_CASE; }
        if (n == 4 && lex_bytes_eq(start, "char", 4)) { return TK_CHAR; }
        if (n == 5 && lex_bytes_eq(start, "const", 5)) { return TK_CONST; }
        if (n == 8 && lex_bytes_eq(start, "continue", 8)) { return TK_CONTINUE; }
        return 0;
    }
    if (b == 'd') {
        if (n == 2 && lex_bytes_eq(start, "do", 2)) { return TK_RESERVED; }
        if (n == 6 && lex_bytes_eq(start, "double", 6)) { return TK_RESERVED; }
        if (n == 7 && lex_bytes_eq(start, "default", 7)) { return TK_DEFAULT; }
        return 0;
    }
    if (b == 'e') {
        if (n == 4 && lex_bytes_eq(start, "else", 4)) { return TK_ELSE; }
        if (n == 4 && lex_bytes_eq(start, "enum", 4)) { return TK_ENUM; }
        if (n == 6 && lex_bytes_eq(start, "extern", 6)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'f') {
        if (n == 2 && lex_bytes_eq(start, "fn", 2)) { return TK_FN; }
        if (n == 3 && lex_bytes_eq(start, "f32", 3)) { return TK_F32; }
        if (n == 3 && lex_bytes_eq(start, "f64", 3)) { return TK_F64; }
        if (n == 3 && lex_bytes_eq(start, "for", 3)) { return TK_FOR; }
        if (n == 5 && lex_bytes_eq(start, "false", 5)) { return TK_FALSE; }
        if (n == 5 && lex_bytes_eq(start, "float", 5)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'g') {
        if (n == 4 && lex_bytes_eq(start, "goto", 4)) { return TK_GOTO; }
        return 0;
    }
    if (b == 'i') {
        if (n == 6 && lex_bytes_eq(start, "import", 6)) { return TK_IMPORT; }
        if (n == 2) {
            if (lex_bytes_eq(start, "i8", 2)) { return TK_I8; }
            if (lex_bytes_eq(start, "if", 2)) { return TK_IF; }
            if (lex_bytes_eq(start, "in", 2)) { return TK_IN; }
            return 0;
        }
        if (n == 3) {
            if (lex_bytes_eq(start, "i16", 3)) { return TK_I16; }
            if (lex_bytes_eq(start, "i32", 3)) { return TK_I32; }
            if (lex_bytes_eq(start, "i64", 3)) { return TK_I64; }
            if (lex_bytes_eq(start, "int", 3)) { return TK_INT; }
            return 0;
        }
        if (n == 6 && lex_bytes_eq(start, "inline", 6)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'l') {
        if (n == 3) {
            if (lex_bytes_eq(start, "let", 3)) { return TK_LET; }
            if (lex_bytes_eq(start, "len", 3)) { return TK_LEN; }
            return 0;
        }
        if (n == 4 && lex_bytes_eq(start, "long", 4)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'm') {
        if (n == 6 && lex_bytes_eq(start, "module", 6)) { return TK_MODULE; }
        return 0;
    }
    if (b == 'p') {
        if (n == 3 && lex_bytes_eq(start, "pub", 3)) { return TK_PUB; }
        return 0;
    }
    if (b == 'r') {
        if (n == 6 && lex_bytes_eq(start, "return", 6)) { return TK_RETURN; }
        if (n == 8 && lex_bytes_eq(start, "register", 8)) { return TK_RESERVED; }
        if (n == 8 && lex_bytes_eq(start, "restrict", 8)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 's') {
        if (n == 5 && lex_bytes_eq(start, "short", 5)) { return TK_RESERVED; }
        if (n == 6) {
            if (lex_bytes_eq(start, "signed", 6)) { return TK_RESERVED; }
            if (lex_bytes_eq(start, "sizeof", 6)) { return TK_SIZEOF; }
            if (lex_bytes_eq(start, "static", 6)) { return TK_RESERVED; }
            if (lex_bytes_eq(start, "struct", 6)) { return TK_STRUCT; }
            if (lex_bytes_eq(start, "switch", 6)) { return TK_SWITCH; }
            return 0;
        }
        return 0;
    }
    if (b == 't') {
        if (n == 4) {
            if (lex_bytes_eq(start, "true", 4)) { return TK_TRUE; }
            if (lex_bytes_eq(start, "type", 4)) { return TK_TYPE; }
            return 0;
        }
        if (n == 7) {
            if (lex_bytes_eq(start, "to_type", 7)) { return TK_TO_TYPE; }
            if (lex_bytes_eq(start, "typedef", 7)) { return TK_RESERVED; }
            return 0;
        }
        return 0;
    }
    if (b == 'u') {
        if (n == 2) {
            if (lex_bytes_eq(start, "u8", 2)) { return TK_U8; }
            return 0;
        }
        if (n == 3) {
            if (lex_bytes_eq(start, "u16", 3)) { return TK_U16; }
            if (lex_bytes_eq(start, "u32", 3)) { return TK_U32; }
            if (lex_bytes_eq(start, "u64", 3)) { return TK_U64; }
            return 0;
        }
        if (n == 5 && lex_bytes_eq(start, "union", 5)) { return TK_UNION; }
        if (n == 8 && lex_bytes_eq(start, "unsigned", 8)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'v') {
        if (n == 4 && lex_bytes_eq(start, "void", 4)) { return TK_VOID; }
        if (n == 8 && lex_bytes_eq(start, "volatile", 8)) { return TK_RESERVED; }
        return 0;
    }
    if (b == 'w') {
        if (n == 5 && lex_bytes_eq(start, "while", 5)) { return TK_RESERVED; }
        return 0;
    }
    return 0;
}

// tok_push：向 token 表追加一个 token，必要时倍增扩容。
// 成功返回 0，内存分配失败输出诊断并返回 -1。
pub fn tok_push(kind int, start int, n int, line int, col int) int {
    if (c_tok_n == c_tok_cap) {
        let ncap int = c_tok_cap * 2;
        if (ncap == 0) {
            ncap = 1024;
        }
        let nd *Tok = malloc((ncap * sizeof(Tok)).to_type(u64)).to_type(*Tok);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (c_tok_n > 0) {
            memcpy(nd, c_toks, (c_tok_n * sizeof(Tok)).to_type(u64));
        }
        free(c_toks);
        c_toks = nd;
        c_tok_cap = ncap;
    }
    c_toks[c_tok_n].kind = kind;
    c_toks[c_tok_n].start = start;
    c_toks[c_tok_n].len = n;
    c_toks[c_tok_n].line = line;
    c_toks[c_tok_n].col = col;
    c_tok_n += 1;
    return 0;
}

// lex_ident：扫描标识符（首字符已验证），查保留字表后入表。
// 返回扫描结束下标；token 表满失败返回 -1。
pub fn lex_ident(i int) int {
    let start int = i;
    i += 1;
    for i < c_src_len {
        let b u8 = c_src[i];
        if (is_ident_start(b) || is_digit(b)) {
            i += 1;
            continue;
        }
        break;
    }
    let kind int = kw_kind(start, i - start);
    if (kind == 0) {
        kind = TOK_IDENT;
    }
    if (tok_push(kind, start, i - start, lx_line, start - lx_lstart + 1) != 0) {
        return -1;
    }
    return i;
}

// radix_ok：b 是否是 mode（16/2/8）进制下的合法数字。
pub fn radix_ok(b u8, mode int) int {
    if (mode == 16) {
        return is_hex_digit(b);
    }
    if (mode == 2) {
        return (b == '0' || b == '1').to_type(int);
    }
    return (b >= '0' && b <= '7').to_type(int);
}

// radix_scan：扫描带前缀的进制数字序列：digit ([_]? digit)*。
// pos 指向第一个数字位；无数字返回 -1（调用方回退为十进制 '0'）。
// 返回序列结束下标。
pub fn radix_scan(pos int, mode int) int {
    if (pos >= c_src_len || radix_ok(c_src[pos], mode) == 0) {
        return -1;
    }
    pos += 1;
    for pos < c_src_len {
        let b u8 = c_src[pos];
        if (radix_ok(b, mode) != 0) {
            pos += 1;
            continue;
        }
        // 下划线必须夹在两个数字之间，否则终止（后续按 IDENT 等分词）
        if (b == '_' && pos + 1 < c_src_len && radix_ok(c_src[pos + 1], mode) != 0) {
            pos += 2;
            continue;
        }
        break;
    }
    return pos;
}

// dec_scan：扫描十进制数字序列 [0-9] ([_]? [0-9])*。
// pos 指向第一个数字；返回序列结束下标（不含未匹配的后缀）。
pub fn dec_scan(pos int) int {
    pos += 1;
    for pos < c_src_len {
        let b u8 = c_src[pos];
        if (is_digit(b)) {
            pos += 1;
            continue;
        }
        if (b == '_' && pos + 1 < c_src_len && is_digit(c_src[pos + 1])) {
            pos += 2;
            continue;
        }
        break;
    }
    return pos;
}

// lex_number：扫描数字字面量（首字符已验证是数字）。
// 形态：0x/0X/0b/0B/0o/0O 前缀进制；十进制整数，可带小数（'.' 后必须
// 紧跟数字，因此 0..n 的 '0' 不会被误读为浮点）与指数（e/E [+-]? 数字）。
// 前缀后无数字时回退为只取 '0'（与 ANTLR 参考一致）。
// 返回扫描结束下标；失败返回 -1。
pub fn lex_number(i int) int {
    let start int = i;
    let b u8 = c_src[i];
    if (b == '0' && i + 1 < c_src_len) {
        let p2 u8 = c_src[i + 1];
        let mode int = 0;
        if (p2 == 'x' || p2 == 'X') { mode = 16; }
        if (p2 == 'b' || p2 == 'B') { mode = 2; }
        if (p2 == 'o' || p2 == 'O') { mode = 8; }
        if (mode != 0) {
            let j int = radix_scan(i + 2, mode);
            if (j < 0) {
                // 0x/0b/0o 后无数字：只取 '0'，其余字节下轮重新分词
                if (tok_push(TOK_NUMBER, start, 1, lx_line, start - lx_lstart + 1) != 0) {
                    return -1;
                }
                return start + 1;
            }
            if (tok_push(TOK_NUMBER, start, j - start, lx_line, start - lx_lstart + 1) != 0) {
                return -1;
            }
            return j;
        }
    }
    // 十进制：整数部分（首字符保证是数字）
    let j2 int = dec_scan(i);
    // 小数部分：'.' 后必须紧跟数字
    if (j2 < c_src_len && c_src[j2] == '.' && j2 + 1 < c_src_len && is_digit(c_src[j2 + 1])) {
        j2 = dec_scan(j2 + 1);
    }
    // 指数部分：e/E 后（可选正负号）必须紧跟数字，否则不消费
    if (j2 < c_src_len && (c_src[j2] == 'e' || c_src[j2] == 'E')) {
        let k int = j2 + 1;
        if (k < c_src_len && (c_src[k] == '+' || c_src[k] == '-')) {
            k += 1;
        }
        if (k < c_src_len && is_digit(c_src[k])) {
            j2 = dec_scan(k);
        }
    }
    if (tok_push(TOK_NUMBER, start, j2 - start, lx_line, start - lx_lstart + 1) != 0) {
        return -1;
    }
    return j2;
}

// lex_escape：扫描 c_src[i] 处的转义序列（i 指向反斜杠）。
// 合法集合：\n \r \t \0 \a \b \f \v \' \" \\ 与 \xNN（两位十六进制）。
// 返回序列之后的下标；未知/不完整转义报告词法错误并返回 -1。
pub fn lex_escape(i int) int {
    if (i + 1 >= c_src_len) {
        return err_here(i, "转义序列不完整");
    }
    let b u8 = c_src[i + 1];
    if (b == 'n' || b == 'r' || b == 't' || b == '0' || b == 'a' || b == 'b'
        || b == 'f' || b == 'v' || b == '\'' || b == '"' || b == '\\') {
        return i + 2;
    }
    if (b == 'x' && i + 3 < c_src_len && is_hex_digit(c_src[i + 2]) && is_hex_digit(c_src[i + 3])) {
        return i + 4;
    }
    return err_here(i, "未知转义序列");
}

// lex_string：扫描字符串字面量（i 指向开头双引号）。
// 内部不允许裸换行（\n 与 \r），转义交给 lex_escape。
// 返回结束下标（闭引号之后）；失败返回 -1。
pub fn lex_string(i int) int {
    let start int = i;
    i += 1;
    for 1 {
        if (i >= c_src_len) {
            return err_here(start, "字符串未终结");
        }
        let b u8 = c_src[i];
        if (b == '"') {
            if (tok_push(TOK_STRING, start, i + 1 - start, lx_line, start - lx_lstart + 1) != 0) {
                return -1;
            }
            return i + 1;
        }
        if (b == '\\') {
            let r int = lex_escape(i);
            if (r < 0) {
                return -1;
            }
            i = r;
            continue;
        }
        if (b == '\n' || b == '\r') {
            return err_here(i, "字符串中不允许换行");
        }
        i += 1;
    }
    return -1;
}

// lex_char：扫描字符字面量（i 指向开头单引号）。
// 引号内恰好一个「字符或一个转义单元」；其余情形报错。
// 返回结束下标（闭引号之后）；失败返回 -1。
pub fn lex_char(i int) int {
    let start int = i;
    i += 1;
    if (i >= c_src_len) {
        return err_here(start, "字符字面量未终结");
    }
    let b u8 = c_src[i];
    if (b == '\\') {
        let r int = lex_escape(i);
        if (r < 0) {
            return -1;
        }
        i = r;
    } else {
        if (b == '\'' || b == '\n' || b == '\r') {
            return err_here(i, "非法的字符字面量");
        }
        i += 1;
    }
    if (i >= c_src_len || c_src[i] != '\'') {
        return err_here(start, "字符字面量只能包含单个字符");
    }
    if (tok_push(TOK_CHAR, start, i + 1 - start, lx_line, start - lx_lstart + 1) != 0) {
        return -1;
    }
    return i + 1;
}

// lex_op：扫描运算符/标点（注释已在主循环处理，注释前缀不会进入此处）。
// 最长匹配：先试三字符（<<= >>= ...），再两字符，最后单字符。
// 返回结束下标；无匹配（非法字符，如 #）报告词法错误并返回 -1。
pub fn lex_op(i int) int {
    let start int = i;
    let b u8 = c_src[i];
    let b1 u8 = 0;
    if (i + 1 < c_src_len) {
        b1 = c_src[i + 1];
    }
    let b2 u8 = 0;
    if (i + 2 < c_src_len) {
        b2 = c_src[i + 2];
    }
    let kind int = 0;
    let n int = 0;
    if (b == '<' && b1 == '<' && b2 == '=') { kind = TK_LSHIFTEQ; n = 3; }
    else if (b == '>' && b1 == '>' && b2 == '=') { kind = TK_RSHIFTEQ; n = 3; }
    else if (b == '.' && b1 == '.' && b2 == '.') { kind = TK_ELLIPSIS; n = 3; }
    else if (b == '=' && b1 == '=') { kind = TK_EQEQ; n = 2; }
    else if (b == '!' && b1 == '=') { kind = TK_NEQ; n = 2; }
    else if (b == '<' && b1 == '=') { kind = TK_LEQ; n = 2; }
    else if (b == '>' && b1 == '=') { kind = TK_GEQ; n = 2; }
    else if (b == '&' && b1 == '&') { kind = TK_ANDAND; n = 2; }
    else if (b == '|' && b1 == '|') { kind = TK_OROR; n = 2; }
    else if (b == '<' && b1 == '<') { kind = TK_LSHIFT; n = 2; }
    else if (b == '>' && b1 == '>') { kind = TK_RSHIFT; n = 2; }
    else if (b == '+' && b1 == '=') { kind = TK_PLUSEQ; n = 2; }
    else if (b == '-' && b1 == '=') { kind = TK_MINUSEQ; n = 2; }
    else if (b == '*' && b1 == '=') { kind = TK_STAREQ; n = 2; }
    else if (b == '/' && b1 == '=') { kind = TK_SLASHEQ; n = 2; }
    else if (b == '%' && b1 == '=') { kind = TK_PERCENTEQ; n = 2; }
    else if (b == '&' && b1 == '=') { kind = TK_AMPEQ; n = 2; }
    else if (b == '|' && b1 == '=') { kind = TK_PIPEEQ; n = 2; }
    else if (b == '^' && b1 == '=') { kind = TK_CARETEQ; n = 2; }
    else if (b == '.' && b1 == '.') { kind = TK_RANGE; n = 2; }
    else if (b == '+') { kind = TK_PLUS; n = 1; }
    else if (b == '-') { kind = TK_MINUS; n = 1; }
    else if (b == '*') { kind = TK_STAR; n = 1; }
    else if (b == '/') { kind = TK_SLASH; n = 1; }
    else if (b == '%') { kind = TK_PERCENT; n = 1; }
    else if (b == '&') { kind = TK_AMP; n = 1; }
    else if (b == '|') { kind = TK_PIPE; n = 1; }
    else if (b == '^') { kind = TK_CARET; n = 1; }
    else if (b == '~') { kind = TK_TILDE; n = 1; }
    else if (b == '!') { kind = TK_BANG; n = 1; }
    else if (b == '<') { kind = TK_LT; n = 1; }
    else if (b == '>') { kind = TK_GT; n = 1; }
    else if (b == '=') { kind = TK_ASSIGN; n = 1; }
    else if (b == '?') { kind = TK_QUEST; n = 1; }
    else if (b == ':') { kind = TK_COLON; n = 1; }
    else if (b == ';') { kind = TK_SEMI; n = 1; }
    else if (b == ',') { kind = TK_COMMA; n = 1; }
    else if (b == '.') { kind = TK_DOT; n = 1; }
    else if (b == '(') { kind = TK_LPAREN; n = 1; }
    else if (b == ')') { kind = TK_RPAREN; n = 1; }
    else if (b == '[') { kind = TK_LBRACKET; n = 1; }
    else if (b == ']') { kind = TK_RBRACKET; n = 1; }
    else if (b == '{') { kind = TK_LBRACE; n = 1; }
    else if (b == '}') { kind = TK_RBRACE; n = 1; }
    else {
        return err_here(i, "非法字符");
    }
    if (tok_push(kind, start, n, lx_line, start - lx_lstart + 1) != 0) {
        return -1;
    }
    return start + n;
}

// lex_all：主循环。逐字节跳过空白与注释（跨行时维护行号/行首下标），
// 按首字符分发到各扫描器；最后补一个 EOF token（位置指向源尾）。
// 成功返回 0；任何词法错误返回 -1（诊断已输出）。
pub fn lex_all() int {
    // 行号复位：一次进程可能多次词法（接口加载/多文件编译）
    lx_line = 1;
    lx_lstart = 0;
    let i int = 0;
    for 1 {
        // —— 空白与注释 ——
        for i < c_src_len {
            let b u8 = c_src[i];
            // WS：空格、\t、\r、\f、\v（\f=12、\v=11）
            if (b == ' ' || b == '\t' || b == '\r' || b == 12 || b == 11) {
                i += 1;
                continue;
            }
            if (b == '\n') {
                i += 1;
                lx_line += 1;
                lx_lstart = i;
                continue;
            }
            // 行注释：到行尾为止（不消费换行，交由上方分支统一处理）
            if (b == '/' && i + 1 < c_src_len && c_src[i + 1] == '/') {
                for i < c_src_len && c_src[i] != '\n' {
                    i += 1;
                }
                continue;
            }
            // 块注释：非嵌套，扫描到 '*/'；内部换行维护行号
            if (b == '/' && i + 1 < c_src_len && c_src[i + 1] == '*') {
                i += 2;
                let closed int = 0;
                for i < c_src_len {
                    if (c_src[i] == '\n') {
                        i += 1;
                        lx_line += 1;
                        lx_lstart = i;
                        continue;
                    }
                    if (c_src[i] == '*' && i + 1 < c_src_len && c_src[i + 1] == '/') {
                        i += 2;
                        closed = 1;
                        break;
                    }
                    i += 1;
                }
                if (closed == 0) {
                    return err_here(i, "块注释未终结");
                }
                continue;
            }
            break;
        }
        if (i >= c_src_len) {
            break;
        }
        // —— token 分发 ——
        let b2 u8 = c_src[i];
        if (is_ident_start(b2)) {
            i = lex_ident(i);
        } else if (is_digit(b2)) {
            i = lex_number(i);
        } else if (b2 == '"') {
            i = lex_string(i);
        } else if (b2 == '\'') {
            i = lex_char(i);
        } else {
            i = lex_op(i);
        }
        if (i < 0) {
            return -1;
        }
    }
    // 文件尾 EOF token：kind/位置固定，供解析器判定「消费到 EOF」
    if (tok_push(TOK_EOF, c_src_len, 0, lx_line, c_src_len - lx_lstart + 1) != 0) {
        return -1;
    }
    return 0;
}

// ============================================================================
// target.yh —— 目标数据模型（多平台接入缝之一）
//
// 多平台架构（docs/03-design/yh-自举后端架构.md）把后端拆成三层：
//
//   前端语义 symbols.yh（平台无关）
//        │  只引用本文件的常量/布局函数，以及 emit 层的「抽象机原语」
//        ▼
//   目标数据模型 target.yh（本文件：字长/对齐/布局规则）
//        │  换平台第一步：提供新目标的数据模型
//        ▼
//   指令发射 emit_<isa>.yh（每目标一个文件：寄存器、栈帧、ABI、指令）
//
// 换目标平台需要提供的东西（契约）：
//   1. 数据模型：TG_* 常量 + tg_align_scalar/tg_layout_struct（本文件）；
//   2. 指令发射：emit_<isa>.yh 实现 symbols.yh 调用的全部 em_* 原语
//      （原语清单见 emit_arm64.yh 文件头）；
//   3. 段/符号/重定位方言与驱动汇编器的调用方式（构建脚本侧）。
// 当前目标：AArch64 Linux（GNU 汇编方言，LP64，小端）。
// ============================================================================

// —— 标量数据模型（字节） ——
pub const TG_PTR_SIZE int = 8;      // 指针 8 字节（LP64）
pub const TG_INT_SIZE int = 4;      // yh 的 int / i32 = 4 字节（默认整数类型）
pub const TG_CHAR_SIZE int = 1;     // char / bool / i8 / u8 = 1 字节
pub const TG_SHORT_SIZE int = 2;    // i16 / u16
pub const TG_LONG_SIZE int = 8;     // i64 / u64
pub const TG_ENUM_SIZE int = 4;     // enum 底层为 4 字节有符号整数

// —— 栈与调用约定（前端在几处需要知道的量化约束） ——
pub const TG_STACK_ALIGN int = 16;  // sp 在调用点必须 16 字节对齐
pub const TG_ARG_REGS int = 8;      // 整型/指针参数的寄存器个数（x0..x7）
pub const TG_VALUE_SLOT int = 16;   // 值栈一个槽的字节数（保持 sp 对齐）

// —— 汇编方言（段/符号/取址写法的差异，AArch64 指令本身相同） ——
//
// 同一台 AArch64 上的两大方言：
//   GNU/Linux（as + gcc）：符号无前缀，取址写 `adrp/add :lo12:`，
//                           链接 libc 符号可直接 `adrp/add`（静态链接）。
//   Darwin（as + clang）： C 符号统一加 `_` 前缀，取址写
//                           `adrp/add @PAGE/@PAGEOFF`；自定义段/外部符号
//                           必须走 GOT：`adrp/ldr @GOTPAGE/@GOTPAGEOFF`。
// 由驱动按 -target 选择；指令发射器只查询下面的 tg_dialect_* 判定，
// 不硬编码方言字符串。
pub const TG_DIALECT_GNU int = 0;     // AArch64 GNU/Linux（默认）
pub const TG_DIALECT_DARWIN int = 1;  // AArch64 Darwin/Mach-O

// c_dialect：当前汇编方言（由驱动在启动时设置）。放在模型层供发射器查询。
pub let c_dialect int = TG_DIALECT_GNU;

// tg_darwin：是否 Darwin 方言（符号加 `_`、取址用 @PAGE、外部走 GOT）。
pub fn tg_darwin() int {
    return (c_dialect == TG_DIALECT_DARWIN).to_type(int);
}

// tg_sym_prefix：符号汇编名前缀（Darwin 为 "_"，GNU 为空串）。
pub fn tg_sym_prefix() *char {
    if (c_dialect == TG_DIALECT_DARWIN) {
        return "_";
    }
    return "";
}

// —— 判型辅助（平台无关的位型事实，由数据模型推导） ——
// tg_is_2byte：2 字节标量。
pub fn tg_is_2byte(size int) int {
    return (size == TG_SHORT_SIZE).to_type(int);
}

// tg_is_8byte：8 字节标量（指针一律 8 字节）。
pub fn tg_is_8byte(size int) int {
    return (size == TG_LONG_SIZE).to_type(int);
}

// tg_align_scalar：标量对齐 = 大小（AArch64 基本类型规则）。
pub fn tg_align_scalar(size int) int {
    return size;
}

// tg_layout_struct：计算一个 struct/union 的字段布局。
// fields 是已登记的字段（type_id 已填），填写 offset 并把结果写入
// c_layout_size / c_layout_align（模型约定：多值返回走专用全局出参）。
// 规则：字段对齐 = 标量对齐 / 聚合对齐（递归查类型表）；
// union 所有字段 offset 为 0；struct 大小向上取整到自身对齐。
pub fn tg_layout_struct(first int, n int, is_union int) int {
    let off int = 0;
    let maxal int = 1;
    let maxsz int = 0;
    let i int = 0;
    for i < n {
        let ftid int = t_fields[first + i].type_id;
        let fsz int = t_types[ftid].size;
        let fal int = t_types[ftid].align;
        if (fal > maxal) {
            maxal = fal;
        }
        if (is_union != 0) {
            t_fields[first + i].offset = 0;
        } else {
            // 向上取整到字段对齐
            let pad int = (0 - off) % fal;
            if (pad < 0) {
                pad += fal;
            }
            off += pad;
            t_fields[first + i].offset = off;
            off += fsz;
        }
        if (fsz > maxsz) {
            maxsz = fsz;
        }
        i += 1;
    }
    let size int = 0;
    if (is_union != 0) {
        size = maxsz;
    } else {
        size = off;
    }
    // 结构体大小向上取整到自身对齐
    let rpad int = (0 - size) % maxal;
    if (rpad < 0) {
        rpad += maxal;
    }
    size += rpad;
    c_layout_size = size;
    c_layout_align = maxal;
    return 0;
}

// ============================================================================
// parse_type.yh —— 自举编译器：类型引用解析与解析器共用工具
//
// 覆盖 docs/yh.g4 的 typeRef / fnType / typeRefList / builtinType。
// 语法模式（c_compile == 0）只消费 token 并返回 0（G1 行为不变）；
// 编译模式返回类型表编号（≥0，错误 -1），并按需构建/去重类型条目。
//
// fn 类型的参数类型先收集到本帧局部数组再统一入池——嵌套 fn 类型
//（fn(fn(int) int) int）各自入池互不串扰。
// ============================================================================

// p_cur：当前 token 种类。
pub fn p_cur() int {
    return c_toks[c_pos].kind;
}

// p_peek：向前看第 k 个 token 的种类；越过表尾按 EOF 处理。
pub fn p_peek(k int) int {
    if (c_pos + k < c_tok_n) {
        return c_toks[c_pos + k].kind;
    }
    return TOK_EOF;
}

// p_adv：游标前进一个 token；EOF 处不动。
pub fn p_adv() void {
    if (c_toks[c_pos].kind != TOK_EOF) {
        c_pos += 1;
    }
}

// p_expect：当前 token 必须是 kind，是则消费并返回 0，否则报错返回 -1。
pub fn p_expect(kind int, what *char) int {
    if (p_cur() == kind) {
        p_adv();
        return 0;
    }
    return err_tok(what);
}

// is_assign_op：k 是否为赋值运算符（TK_ASSIGN..TK_RSHIFTEQ 连号）。
pub fn is_assign_op(k int) int {
    return (k >= TK_ASSIGN && k <= TK_RSHIFTEQ).to_type(int);
}

// is_member_name：k 是否可作「成员名」（成员位置放开保留字，to_type 除外）。
pub fn is_member_name(k int) int {
    if (k == TOK_IDENT) {
        return 1;
    }
    if (k >= TK_PUB && k <= TK_AS) {
        return 1;
    }
    if (k == TK_RESERVED) {
        return 1;
    }
    if (k >= TK_INT && k <= TK_VOID) {
        return 1;
    }
    return 0;
}

// is_type_start：k 是否可作为类型引用起始（返回类型省略判定用）。
pub fn is_type_start(k int) int {
    if (k == TK_STAR || k == TK_LBRACKET || k == TK_FN || k == TOK_IDENT) {
        return 1;
    }
    return (k >= TK_INT && k <= TK_VOID).to_type(int);
}

// sizeof_starts_type：sizeof('(' 后当前 token 是否为「类型」形态。
// 用于区分 sizeof(T) 与 sizeof(expr)：内建类型、[、fn 直接判定；
// 连续 * 后跟已登记类型名判为指针类型（如 sizeof(*P)）；IDENT 仅当
// 已登记为类型名才走类型路径（否则是表达式，如 sizeof(x)、sizeof(*p)）。
pub fn sizeof_starts_type() int {
    let k int = p_cur();
    let off int = 0;
    for k == TK_STAR {
        off += 1;
        k = p_peek(off);
    }
    if (k == TK_LBRACKET || k == TK_FN) {
        return 1;
    }
    if (k >= TK_INT && k <= TK_VOID) {
        return 1;
    }
    if (k == TOK_IDENT) {
        let tid int = ty_lookup_name(c_toks[c_pos].start, c_toks[c_pos].len);
        if (tid >= 0) {
            return 1;
        }
        // 模块限定类型 m.T（P3）：绑定名在导入表且命名空间导出该类型名
        if (p_peek(1) == TK_DOT && p_peek(2) == TOK_IDENT) {
            let qb int = mod_file_binding(c_toks[c_pos].start, c_toks[c_pos].len);
            if (qb >= 0 && mod_ns_lookup(qb, c_toks[c_pos + 2].start,
                c_toks[c_pos + 2].len, 1) >= 0) {
                return 1;
            }
        }
    }
    return 0;
}

// tk_to_builtin：内建类型 token → 类型编号（编译模式）。
pub fn tk_to_builtin(k int) int {
    if (k == TK_INT) { return TY_I32; }
    if (k == TK_I8) { return TY_I8; }
    if (k == TK_I16) { return TY_I16; }
    if (k == TK_I32) { return TY_I32; }
    if (k == TK_I64) { return TY_I64; }
    if (k == TK_U8) { return TY_U8; }
    if (k == TK_U16) { return TY_U16; }
    if (k == TK_U32) { return TY_U32; }
    if (k == TK_U64) { return TY_U64; }
    if (k == TK_F32) { return TY_F32; }
    if (k == TK_F64) { return TY_F64; }
    if (k == TK_BOOL) { return TY_BOOL; }
    if (k == TK_CHAR) { return TY_CHAR; }
    return TY_VOID;
}

// parse_type_ref：类型引用。返回类型编号（语法模式返回 0），错误 -1。
//   '*' typeRef | '[' expr? ']' typeRef | 'fn' '(' typeRefList? ')' typeRef?
//   | builtinType | IDENT
pub fn parse_type_ref() int {
    let k int = p_cur();
    if (k == TK_STAR) {
        p_adv();
        let e int = parse_type_ref();
        if (e < 0) {
            return -1;
        }
        if (c_compile == 0) {
            return 0;
        }
        return ty_ptr(e);
    }
    if (k == TK_LBRACKET) {
        p_adv();
        let alen int = -1;
        if (p_cur() != TK_RBRACKET) {
            let r Res;
            if (c_compile != 0) {
                c_fold += 1;
                let rr int = parse_expr(&r);
                c_fold -= 1;
                if (rr != 0) {
                    return -1;
                }
                if (r.is_const == 0) {
                    return sem_err("数组长度必须是编译期常量");
                }
                if (r.ival <= 0) {
                    return sem_err("数组长度必须为正");
                }
                if (r.ival > 2147483647) {
                    return sem_err("数组长度超出限制");
                }
                alen = r.ival.to_type(int);
            } else {
                if (parse_expr(&r) != 0) {
                    return -1;
                }
            }
        }
        if (p_expect(TK_RBRACKET, "期望 ']'") != 0) {
            return -1;
        }
        let e2 int = parse_type_ref();
        if (e2 < 0) {
            return -1;
        }
        if (c_compile == 0) {
            return 0;
        }
        if (alen < 0) {
            return ty_slice(e2);
        }
        return ty_array(e2, alen);
    }
    if (k == TK_FN) {
        p_adv();
        if (p_expect(TK_LPAREN, "期望 '('") != 0) {
            return -1;
        }
        // 参数类型收集到本帧数组（递归安全），全部解析后统一入池
        let pts [32]int;
        let np int = 0;
        if (p_cur() != TK_RPAREN) {
            for 1 {
                let pt int = parse_type_ref();
                if (pt < 0) {
                    return -1;
                }
                if (c_compile != 0) {
                    if (np >= 32) {
                        return sem_err("fn 类型参数过多");
                    }
                    pts[np] = pt;
                    np += 1;
                }
                if (p_cur() == TK_COMMA) {
                    p_adv();
                    continue;
                }
                break;
            }
        }
        if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
            return -1;
        }
        let ret int = TY_VOID;
        if (is_type_start(p_cur()) != 0) {
            let rt int = parse_type_ref();
            if (rt < 0) {
                return -1;
            }
            ret = rt;
        }
        if (c_compile == 0) {
            return 0;
        }
        let first int = t_sigparam_n;
        let i int = 0;
        for i < np {
            ty_sig_param(pts[i]);
            i += 1;
        }
        return ty_fn(ret, first, np, 0);
    }
    if (k >= TK_INT && k <= TK_VOID) {
        p_adv();
        if (c_compile == 0) {
            return 0;
        }
        return tk_to_builtin(k);
    }
    if (k == TOK_IDENT) {
        let start int = c_toks[c_pos].start;
        let n int = c_toks[c_pos].len;
        p_adv();
        // 限定类型 m.T（U3/U4）：编译模式查导入绑定的模块命名空间；
        // 单段点链（更长链不支持，干净拒绝）；语法模式仅消费。
        if (p_cur() == TK_DOT) {
            p_adv();
            if (p_cur() != TOK_IDENT) {
                return err_tok("限定类型 '.' 后需要一个类型名");
            }
            let tstart int = c_toks[c_pos].start;
            let tlen int = c_toks[c_pos].len;
            let tline int = c_toks[c_pos].line;
            let tcol int = c_toks[c_pos].col;
            p_adv();
            if (p_cur() == TK_DOT) {
                return err_tok("限定类型只支持一层（m.T）");
            }
            if (c_compile == 0) {
                return 0;
            }
            if (c_module_mode == 0) {
                return sem_err("限定类型只在模块模式可用");
            }
            let qb int = mod_file_binding(start, n);
            if (qb < 0) {
                return err_lc(tline, tcol, "点号左侧不是导入的模块名");
            }
            let qe int = mod_ns_lookup(qb, tstart, tlen, 1);
            if (qe < 0) {
                return err_lc(tline, tcol, "模块没有导出该类型");
            }
            let qi int = 0;
            for qi < mod_import_n {
                if (mod_import_mod[qi] == qb) {
                    mod_import_used[qi] = 1;
                    break;
                }
                qi += 1;
            }
            return c_mods[qb].ns[qe].tid;
        }
        if (c_compile == 0) {
            return 0;
        }
        let tid int = ty_lookup_name(start, n);
        if (tid < 0) {
            return sem_err("未知类型（类型必须先定义）");
        }
        return tid;
    }
    return err_tok("此处需要一个类型");
}

// ============================================================================
// symbols.yh —— 前端语义（一）：名字池、类型表、符号/作用域、类型兼容
//
// 平台无关层（多平台架构见 docs/03-design/yh-自举后端架构.md）：只引用
// target.yh 的数据模型，调用 emit 层的 em_* 抽象机原语；不含任何 ISA 细节。
//
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// 类型/符号常量集中在 model.yh（先声明后使用）。
// 名字池：所有符号/类型/字段名字统一 intern 到可增长字节池（名字不复制
// 到各表，表内只存池偏移与长度），extern 符号与用户符号同池同比较。
// ============================================================================

// np_cstr：名字池内偏移 → NUL 结尾 C 字符串（池内字节本就带 NUL）。
pub fn np_cstr(off int) *char {
    return (np_data + off).to_type(*char);
}

// name_intern：把 [start,len) 的名字字节复制进名字池，返回池内偏移。
// 池里字节带 NUL 结尾（便于调试，不参与比较）。
pub fn name_intern(start int, n int) int {
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = c_src[start + i];
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off;
}

// name_intern_lit：登记编译器内置名字（如 prelude 符号名），返回池偏移。
pub fn name_intern_lit(s *char) int {
    let n int = 0;
    for s[n] != 0 {
        n += 1;
    }
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off2 int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = s[i].to_type(u8);
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off2;
}

// ============================================================================
// 类型表
// ============================================================================

// sem_err：带当前 token 位置的语义错误（返回 -1 便于链式返回）。
pub fn sem_err(msg *char) int {
    return err_tok(msg);
}

// intvec_grow：int 数组统一扩容。
pub fn intvec_grow(vec **int, n int, cap *int) int {
    if (n < *cap) {
        return 0;
    }
    let ncap int = *cap * 2;
    if (ncap == 0) {
        ncap = 64;
    }
    let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
    if (nd == 0) {
        return fail("内存分配失败");
    }
    if (n > 0) {
        memcpy(nd, *vec, (n * sizeof(int)).to_type(u64));
    }
    free(*vec);
    *vec = nd;
    *cap = ncap;
    return 0;
}

// ty_push：向类型表追加条目，返回新类型编号。
// t_home 平行数组同步增长（类型归属：-1 本地 / >=0 模块编号）。
pub fn ty_push(kind int, size int, align int, elem int, n int, sub int) int {
    if (t_type_n == t_type_cap) {
        let ncap int = t_type_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *CType = malloc((ncap * sizeof(CType)).to_type(u64)).to_type(*CType);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (t_type_n > 0) {
            memcpy(nd, t_types, (t_type_n * sizeof(CType)).to_type(u64));
        }
        free(t_types);
        t_types = nd;
        let nh *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nh == 0) {
            return fail("内存分配失败");
        }
        if (t_home_cap > 0) {
            memcpy(nh, t_home, (t_home_cap * sizeof(int)).to_type(u64));
        }
        if (t_home_cap > 0) {
            free(t_home);
        }
        t_home = nh;
        // 新扩容区间填 -1（本地）
        let hi int = t_home_cap;
        for hi < ncap {
            t_home[hi] = -1;
            hi += 1;
        }
        t_home_cap = ncap;
        t_type_cap = ncap;
    }
    t_types[t_type_n].kind = kind;
    t_types[t_type_n].size = size;
    t_types[t_type_n].align = align;
    t_types[t_type_n].elem = elem;
    t_types[t_type_n].len = n;
    t_types[t_type_n].sub = sub;
    t_type_n += 1;
    return t_type_n - 1;
}

// ty_register_builtins：登记 0..12 号内建类型（固定编号，勿改顺序）。
pub fn ty_register_builtins() int {
    ty_push(TY_VOID, 0, 0, -1, -1, -1);
    ty_push(TY_BOOL, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1);
    ty_push(TY_CHAR, TG_CHAR_SIZE, TG_CHAR_SIZE, -1, -1, -1);
    ty_push(TY_I8, 1, 1, -1, -1, -1);
    ty_push(TY_I16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1);
    ty_push(TY_I32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1);
    ty_push(TY_I64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1);
    ty_push(TY_U8, 1, 1, -1, -1, -1);
    ty_push(TY_U16, TG_SHORT_SIZE, TG_SHORT_SIZE, -1, -1, -1);
    ty_push(TY_U32, TG_INT_SIZE, TG_INT_SIZE, -1, -1, -1);
    ty_push(TY_U64, TG_LONG_SIZE, TG_LONG_SIZE, -1, -1, -1);
    ty_push(TY_F32, 4, 4, -1, -1, -1);
    ty_push(TY_F64, 8, 8, -1, -1, -1);
    return 0;
}

// ty_push_agg：登记聚合类型并检查登记上限。
// 与方案 §4 一致：保留 512 的聚合类型登记上限，超限必须干净报错，
// 不能越界（对应 tests/yh-run/fail/12-wraps-too-many.yh）。
pub fn ty_push_agg(kind int, size int, align int, elem int, n int, sub int) int {
    if (c_aggtype_n >= 512) {
        return sem_err("聚合类型登记过多（上限 512）");
    }
    c_aggtype_n += 1;
    return ty_push(kind, size, align, elem, n, sub);
}

// ty_ptr：指向 elem 的指针类型（按内容去重）。
pub fn ty_ptr(elem int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_PTR && t_types[i].elem == elem) {
            return i;
        }
        i += 1;
    }
    return ty_push(TY_PTR, TG_PTR_SIZE, TG_PTR_SIZE, elem, -1, -1);
}

// ty_array：[len] elem 定长数组类型（按内容去重）。
pub fn ty_array(elem int, alen int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_ARRAY && t_types[i].elem == elem && t_types[i].len == alen) {
            return i;
        }
        i += 1;
    }
    let esz int = t_types[elem].size;
    let eal int = t_types[elem].align;
    if (eal < 1) {
        eal = 1;
    }
    let size int = esz * alen;
    let rpad int = (0 - size) % eal;
    if (rpad < 0) {
        rpad += eal;
    }
    size += rpad;
    return ty_push_agg(TY_ARRAY, size, eal, elem, alen, -1);
}

// ty_slice：切片类型 []T = {u64 长度, T *数据}（16 字节聚合视图）。
// 去重按元素类型；元素类型参与同型判断（ADR-0001/0002）。
pub fn ty_slice(elem int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_SLICE && t_types[i].elem == elem) {
            return i;
        }
        i += 1;
    }
    return ty_push(TY_SLICE, TG_LONG_SIZE * 2, TG_LONG_SIZE, elem, -1, -1);
}

// ty_sig_add：追加签名（返回/参数数/变参标志），返回签名号。
// t_sig_first 由调用方在登记参数后填池内起始下标。
pub fn ty_sig_add(ret int, np int, vararg int) int {
    if (intvec_grow(&t_sig_ret, t_sig_n, &t_sig_rcap) != 0) { return -1; }
    if (intvec_grow(&t_sig_np, t_sig_n, &t_sig_ncap) != 0) { return -1; }
    if (intvec_grow(&t_sig_vararg, t_sig_n, &t_sig_vcap) != 0) { return -1; }
    if (intvec_grow(&t_sig_first, t_sig_n, &t_sig_fcap) != 0) { return -1; }
    t_sig_ret[t_sig_n] = ret;
    t_sig_np[t_sig_n] = np;
    t_sig_vararg[t_sig_n] = vararg;
    t_sig_n += 1;
    return t_sig_n - 1;
}

// ty_sig_param：向参数类型池追加一个参数类型。
pub fn ty_sig_param(tid int) int {
    if (intvec_grow(&t_sig_params, t_sigparam_n, &t_sigparam_cap) != 0) {
        return -1;
    }
    t_sig_params[t_sigparam_n] = tid;
    t_sigparam_n += 1;
    return 0;
}

// ty_fn：函数类型（签名按内容去重：返回 + 参数个数 + 逐个参数类型）。
pub fn ty_fn(ret int, first int, np int, vararg int) int {
    let i int = 0;
    for i < t_type_n {
        if (t_types[i].kind == TY_FN) {
            let s int = t_types[i].sub;
            if (t_sig_ret[s] == ret && t_sig_np[s] == np && t_sig_vararg[s] == vararg) {
                let match int = 1;
                let j int = 0;
                for j < np {
                    if (t_sig_params[t_sig_first[s] + j] != t_sig_params[first + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    return i;
                }
            }
        }
        i += 1;
    }
    let ns int = ty_sig_add(ret, np, vararg);
    t_sig_first[ns] = first;
    return ty_push(TY_FN, TG_PTR_SIZE, TG_PTR_SIZE, ret, np, ns);
}

// ty_is_integer：整数类（含 bool/char/enum）。
pub fn ty_is_integer(tid int) int {
    let k int = t_types[tid].kind;
    if (k >= TY_BOOL && k <= TY_U64) {
        return 1;
    }
    return (k == TY_ENUM).to_type(int);
}

// ty_is_signed：有符号整数类。
pub fn ty_is_signed(tid int) int {
    let k int = t_types[tid].kind;
    return ((k >= TY_CHAR && k <= TY_I64) || k == TY_ENUM).to_type(int);
}

// ty_is_float：浮点类。
pub fn ty_is_float(tid int) int {
    let k int = t_types[tid].kind;
    return ((k == TY_F32) || (k == TY_F64)).to_type(int);
}

// ty_is_scalar：可放进寄存器的标量（整数/浮点/指针/fn）。
pub fn ty_is_scalar(tid int) int {
    let k int = t_types[tid].kind;
    if (k == TY_PTR || k == TY_FN) {
        return 1;
    }
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE || k == TY_VOID) {
        return 0;
    }
    return 1;
}

// ty_name_text：类型可读名（诊断用）。
pub fn ty_name_text(tid int) *char {
    let k int = t_types[tid].kind;
    if (k == TY_VOID) { return "void"; }
    if (k == TY_BOOL) { return "bool"; }
    if (k == TY_CHAR) { return "char"; }
    if (k == TY_I8) { return "i8"; }
    if (k == TY_I16) { return "i16"; }
    if (k == TY_I32) { return "int"; }
    if (k == TY_I64) { return "i64"; }
    if (k == TY_U8) { return "u8"; }
    if (k == TY_U16) { return "u16"; }
    if (k == TY_U32) { return "u32"; }
    if (k == TY_U64) { return "u64"; }
    if (k == TY_F32) { return "f32"; }
    if (k == TY_F64) { return "f64"; }
    if (k == TY_PTR) { return "指针"; }
    if (k == TY_ARRAY) { return "数组"; }
    if (k == TY_SLICE) { return "切片"; }
    if (k == TY_STRUCT) { return "struct"; }
    if (k == TY_UNION) { return "union"; }
    if (k == TY_ENUM) { return "enum"; }
    if (k == TY_FN) { return "fn"; }
    return "?";
}

// ============================================================================
// 名字空间与符号表
// ============================================================================

// ty_lookup_name：按名字查类型。找不到返回 -1。
pub fn ty_lookup_name(start int, n int) int {
    let i int = t_name_n - 1;
    for i >= 0 {
        if (t_names[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_names[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return t_names[i].type_id;
            }
        }
        i -= 1;
    }
    return -1;
}

// ty_declare_name：登记类型名字（重复定义报错，含首次声明位置）。
// is_pub/form 取自调用方设置的全局（c_decl_pub / c_name_form）。
pub fn ty_declare_name(off int, n int, tid int) int {
    let prev int = ty_lookup_name_off(off, n);
    if (prev >= 0) {
        // 找到先前登记项的位置一并报告
        let pi int = t_name_n - 1;
        for pi >= 0 {
            if (t_names[pi].name_len == n
                && np_data[t_names[pi].name_off] == np_data[off]) {
                let match int = 1;
                let j int = 1;
                for j < n {
                    if (np_data[t_names[pi].name_off + j] != np_data[off + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    break;
                }
            }
            pi -= 1;
        }
        if (pi >= 0 && c_spec == 0) {
            let buf [128]u8;
            let bn int = 0;
            bn = append_str(buf, bn, "类型重定义（首次声明于 ");
            bn = append_int(buf, bn, t_names[pi].def_line);
            bn = append_byte(buf, bn, ':');
            bn = append_int(buf, bn, t_names[pi].def_col);
            bn = append_str(buf, bn, "）");
            let mo int = tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            return err_tok(np_cstr(mo));
        }
        return err_tok("类型重定义");
    }
    if (t_name_n == t_name_cap) {
        let ncap int = t_name_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *TName = malloc((ncap * sizeof(TName)).to_type(u64)).to_type(*TName);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (t_name_n > 0) {
            memcpy(nd, t_names, (t_name_n * sizeof(TName)).to_type(u64));
        }
        free(t_names);
        t_names = nd;
        t_name_cap = ncap;
    }
    t_names[t_name_n].name_off = off;
    t_names[t_name_n].name_len = n;
    t_names[t_name_n].type_id = tid;
    t_names[t_name_n].is_pub = c_decl_pub;
    t_names[t_name_n].form = c_name_form;
    t_names[t_name_n].def_line = c_toks[c_pos].line;
    t_names[t_name_n].def_col = c_toks[c_pos].col;
    t_name_n += 1;
    return 0;
}

// ty_lookup_name_off：按池偏移查类型名（登记去重用）。
pub fn ty_lookup_name_off(off int, n int) int {
    let i int = t_name_n - 1;
    for i >= 0 {
        if (t_names[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_names[i].name_off + j] != np_data[off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return t_names[i].type_id;
            }
        }
        i -= 1;
    }
    return -1;
}

// sym_push：登记符号（名字先 intern 进池）。返回符号下标。
// 模块模式下对全局声明做重复检查（同模块重复顶层声明报两个位置）；
// 单文件模式行为不变（不检查）。
pub fn sym_push(start int, n int, kind int, tid int, flags int) int {
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    if (c_module_mode != 0 && (flags & F_GLOBAL) != 0 && (flags & F_EXTERN) == 0) {
        // 模块模式：全局（含 enum 成员）重名报错；首次位置一并报告
        let di int = 0;
        for di < c_sym_n {
            if ((c_syms[di].flags & F_GLOBAL) != 0 && c_syms[di].name_len == n
                && np_data[c_syms[di].name_off] == np_data[off]) {
                let match int = 1;
                let j int = 1;
                for j < n {
                    if (np_data[c_syms[di].name_off + j] != np_data[off + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    if (c_spec == 0) {
                        let buf [128]u8;
                        let bn int = 0;
                        bn = append_str(buf, bn, "重复的顶层声明（首次声明于 ");
                        bn = append_int(buf, bn, c_syms[di].def_line);
                        bn = append_byte(buf, bn, ':');
                        bn = append_int(buf, bn, c_syms[di].def_col);
                        bn = append_str(buf, bn, "）");
                        let mo int = tml_intern_str(buf, 0, bn);
                        if (mo < 0) {
                            return -1;
                        }
                        return err_tok(np_cstr(mo));
                    }
                    return -1;
                }
            }
            di += 1;
        }
    }
    if (c_sym_n == c_sym_cap) {
        let ncap int = c_sym_cap * 2;
        if (ncap == 0) {
            ncap = 256;
        }
        let nd *CSym = malloc((ncap * sizeof(CSym)).to_type(u64)).to_type(*CSym);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (c_sym_n > 0) {
            memcpy(nd, c_syms, (c_sym_n * sizeof(CSym)).to_type(u64));
        }
        free(c_syms);
        c_syms = nd;
        c_sym_cap = ncap;
    }
    c_syms[c_sym_n].name_off = off;
    c_syms[c_sym_n].name_len = n;
    c_syms[c_sym_n].kind = kind;
    c_syms[c_sym_n].type_id = tid;
    c_syms[c_sym_n].offset = 0;
    c_syms[c_sym_n].flags = flags;
    c_syms[c_sym_n].cval = 0;
    c_syms[c_sym_n].def_line = c_toks[c_pos].line;
    c_syms[c_sym_n].def_col = c_toks[c_pos].col;
    c_sym_n += 1;
    return c_sym_n - 1;
}

// sym_push_lit：以池内已有名字登记符号（prelude 用）。
pub fn sym_push_lit(off int, n int, kind int, tid int, flags int) int {
    let tmp int = c_sym_n;
    let idx int = sym_push(0, 0, kind, tid, flags);
    if (idx < 0) {
        return -1;
    }
    c_syms[idx].name_off = off;
    c_syms[idx].name_len = n;
    return idx;
}

// sym_lookup_off：按名字池偏移查符号（池对池比较，供构建器诊断用）。
// 只查全局层（c_scope_start[0] 以下）。找不到返回 -1。
pub fn sym_lookup_off(off int, n int) int {
    let i int = c_sym_n - 1;
    for i >= 0 {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != np_data[off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i -= 1;
    }
    return -1;
}

// sym_lookup：当前作用域链内查找（符号按名字池比较）。找不到返回 -1。
pub fn sym_lookup(start int, n int) int {
    let i int = c_sym_n - 1;
    for i >= 0 {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i -= 1;
    }
    return -1;
}

// scope_push / scope_pop：进入/退出块作用域（退出即截断符号）。
pub fn scope_push() int {
    c_scope_start[c_scope_n] = c_sym_n;
    c_scope_n += 1;
    return 0;
}

pub fn scope_pop() int {
    c_scope_n -= 1;
    c_sym_n = c_scope_start[c_scope_n];
    return 0;
}

// ============================================================================
// 常量折叠辅助
// ============================================================================

// fold_binop：两个常量的二元运算（i64 位型；除零干净报错）。
pub fn fold_binop(op int, a i64, b i64) i64 {
    if (op == TK_PLUS) { return a + b; }
    if (op == TK_MINUS) { return a - b; }
    if (op == TK_STAR) { return a * b; }
    if (op == TK_SLASH) {
        if (b == 0) {
            err_tok("常量除以零");
            return 0;
        }
        return a / b;
    }
    if (op == TK_PERCENT) {
        if (b == 0) {
            err_tok("常量模零");
            return 0;
        }
        return a % b;
    }
    if (op == TK_AMP) { return a & b; }
    if (op == TK_PIPE) { return a | b; }
    if (op == TK_CARET) { return a ^ b; }
    if (op == TK_LSHIFT) { return a << b; }
    if (op == TK_RSHIFT) { return a >> b; }
    if (op == TK_EQEQ) { return (a == b).to_type(i64); }
    if (op == TK_NEQ) { return (a != b).to_type(i64); }
    if (op == TK_LT) { return (a < b).to_type(i64); }
    if (op == TK_LEQ) { return (a <= b).to_type(i64); }
    if (op == TK_GT) { return (a > b).to_type(i64); }
    if (op == TK_GEQ) { return (a >= b).to_type(i64); }
    return 0;
}

// fold_unary：对常量做一元运算。
pub fn fold_unary(op int, a i64) i64 {
    if (op == TK_MINUS) { return -a; }
    if (op == TK_PLUS) { return a; }
    if (op == TK_TILDE) { return ~a; }
    if (op == TK_BANG) { return (a == 0).to_type(i64); }
    return a;
}

// sem_parse_number：解析数字字面量文本（十六/二/八/十进制与下划线），
// 结果写 c_fold_ival（位型）与 c_fold_big（超出 i64 正数域标志）。

pub fn sem_parse_number(start int, n int) int {
    let i int = start;
    let end int = start + n;
    let v i64 = 0;
    let big int = 0;
    let base i64 = 10;
    if (c_src[i] == '0' && i + 1 < end) {
        let p2 u8 = c_src[i + 1];
        if (p2 == 'x' || p2 == 'X') { base = 16; i += 2; }
        if (p2 == 'b' || p2 == 'B') { base = 2; i += 2; }
        if (p2 == 'o' || p2 == 'O') { base = 8; i += 2; }
    }
    for i < end {
        let b u8 = c_src[i];
        if (b == '_') {
            i += 1;
            continue;
        }
        let d i64 = 0;
        if (b >= '0' && b <= '9') {
            d = (b - '0').to_type(i64);
        } else if (b >= 'a' && b <= 'f') {
            d = ((b - 'a') + 10).to_type(i64);
        } else if (b >= 'A' && b <= 'F') {
            d = ((b - 'A') + 10).to_type(i64);
        } else {
            return err_tok("数字字面量含非法字符");
        }
        v = v * base + d;
        if (v < 0) {
            big = 1;
        }
        i += 1;
    }
    c_fold_ival = v;
    c_fold_big = big;
    return 0;
}

// ============================================================================
// 类型兼容
// ============================================================================

// sem_lit_fits：字面量位型值是否落在整数类型可表示范围内。
pub fn sem_lit_fits(tid int, v i64) int {
    let k int = t_types[tid].kind;
    if (k == TY_U8) { return ((v >= 0) && (v <= 255)).to_type(int); }
    if (k == TY_U16) { return ((v >= 0) && (v <= 65535)).to_type(int); }
    if (k == TY_U32) { return ((v >= 0) && (v <= 4294967295)).to_type(int); }
    if (k == TY_U64) { return 1; }
    if (k == TY_I8) { return ((v >= -128) && (v <= 127)).to_type(int); }
    if (k == TY_I16) { return ((v >= -32768) && (v <= 32767)).to_type(int); }
    if (k == TY_I32 || k == TY_ENUM) {
        return ((v >= -2147483648) && (v <= 2147483647)).to_type(int);
    }
    if (k == TY_I64) { return 1; }
    if (k == TY_CHAR) { return ((v >= 0) && (v <= 255)).to_type(int); }
    if (k == TY_BOOL) { return ((v == 0) || (v == 1)).to_type(int); }
    return 1;
}

// sem_can_assign：检查 src 能否赋给 dst。通过返回 0，拒绝返回 -1（已报错）。
// is_lit/ival/big 描述右值字面量性（非字面量传 0）：允许同型；整数字面量
// 可表示时的隐式窄化；值保持的整数加宽；字面量 0 → 指针；T* → *void；
// fn 值 → 同签名 fn 类型 / *void。
pub fn sem_can_assign(dst int, src int, is_lit int, ival i64, big int) int {
    if (dst == src) {
        return 0;
    }
    let dk int = t_types[dst].kind;
    let sk int = t_types[src].kind;
    // 聚合：同型已在上面通过；不同类型（含长度不同）一律拒绝
    if ((dk == TY_STRUCT || dk == TY_UNION || dk == TY_ARRAY || dk == TY_SLICE)
        && (sk == TY_STRUCT || sk == TY_UNION || sk == TY_ARRAY || sk == TY_SLICE)) {
        return sem_err("聚合类型不匹配（长度或元素类型不同）");
    }
    if (dk == TY_PTR) {
        // 字面量 0 = 空指针（最宽匹配，先判）
        if (is_lit != 0 && ival == 0) {
            return 0;
        }
        if (sk == TY_PTR) {
            if (t_types[dst].elem == TY_VOID || t_types[src].elem == TY_VOID) {
                return 0;
            }
            return sem_err("指针类型不匹配（需要 .to_type 显式转换）");
        }
        if (sk == TY_FN && t_types[dst].elem == TY_VOID) {
            return 0;
        }
        return sem_err("不能把非指针值赋给指针");
    }
    if (sk == TY_PTR) {
        return sem_err("不能把指针赋给非指针（用 .to_type）");
    }
    if (dk == TY_FN || sk == TY_FN) {
        if (dk == TY_FN && sk == TY_FN) {
            return sem_err("函数签名不匹配");
        }
        return sem_err("fn 值只能赋给同签名类型或 *void");
    }
    if (ty_is_float(dst) != 0 || ty_is_float(src) != 0) {
        if (dk == sk) {
            return 0;
        }
        return sem_err("浮点与整数之间需要 .to_type 显式转换");
    }
    if (dk == TY_BOOL && sk != TY_BOOL) {
        return sem_err("整数不能隐式转为 bool（用 .to_type(bool)）");
    }
    if (sk == TY_BOOL && ty_is_integer(dst) == 0 && dk != TY_BOOL) {
        return sem_err("bool 不能隐式转为该类型");
    }
    if (ty_is_integer(dst) == 0 || ty_is_integer(src) == 0) {
        return sem_err("类型不匹配");
    }
    let dsz int = t_types[dst].size;
    let ssz int = t_types[src].size;
    if (is_lit != 0) {
        if (big != 0 && dk != TY_U64) {
            return sem_err("字面量超出目标类型可表示范围");
        }
        if (sem_lit_fits(dst, ival) != 0) {
            return 0;
        }
        return sem_err("字面量超出目标类型可表示范围");
    }
    if (dsz > ssz) {
        return 0;
    }
    if (dsz == ssz) {
        if (dk == sk) {
            return 0;
        }
        if (dk == TY_ENUM || sk == TY_ENUM) {
            return 0;
        }
        return sem_err("同宽整数之间需要 .to_type 显式转换");
    }
    return sem_err("不允许的隐式窄化（用 .to_type）");
}

// sem_promote：二元运算公共类型（常规算术转换子集）。
pub fn sem_promote(a int, b int) int {
    if (a == b) {
        return a;
    }
    let ak int = t_types[a].kind;
    let bk int = t_types[b].kind;
    if (ak == TY_BOOL) { a = TY_I32; }
    if (bk == TY_BOOL) { b = TY_I32; }
    if (ak == TY_CHAR) { a = TY_I32; }
    if (bk == TY_CHAR) { b = TY_I32; }
    if (ak == TY_ENUM) { a = TY_I32; }
    if (bk == TY_ENUM) { b = TY_I32; }
    if (a == b) {
        return a;
    }
    if (ty_is_float(a) != 0 && ty_is_float(b) != 0) {
        if (t_types[a].size >= t_types[b].size) {
            return a;
        }
        return b;
    }
    if (ty_is_float(a) != 0 || ty_is_float(b) != 0) {
        // 调用方已先行拒绝；此处返回较大一方兜底
        if (t_types[a].size >= t_types[b].size) {
            return a;
        }
        return b;
    }
    let asz int = t_types[a].size;
    let bsz int = t_types[b].size;
    let aus int = (ty_is_signed(a) == 0).to_type(int);
    let bus int = (ty_is_signed(b) == 0).to_type(int);
    let size int = asz;
    if (bsz > size) {
        size = bsz;
    }
    let uns int = aus | bus;
    if (size == 1) {
        if (uns != 0) { return TY_U8; }
        return TY_I8;
    }
    if (size == 2) {
        if (uns != 0) { return TY_U16; }
        return TY_I16;
    }
    if (size == 4) {
        if (uns != 0) { return TY_U32; }
        return TY_I32;
    }
    if (uns != 0) { return TY_U64; }
    return TY_I64;
}

// ============================================================================
// prelude 登记
// ============================================================================

// sem_init_tables：为全部堆分配的全局表分配空间（编译模式启动时调用一次）。
// stage0 每个编译单元只允许一个全局数组字面量，因此这些表统一走堆。
pub fn sem_init_tables() int {
    let n4 u64 = (4 * 64).to_type(u64);
    c_scope_start = malloc(n4).to_type(*int);
    c_brk_stk = malloc(n4).to_type(*int);
    c_cnt_stk = malloc(n4).to_type(*int);
    c_glabels = malloc((sizeof(GLabel) * 128).to_type(u64)).to_type(*GLabel);
    c_args = malloc((sizeof(Res) * 256).to_type(u64)).to_type(*Res);
    c_argtys = malloc((4 * 256).to_type(u64)).to_type(*int);
    c_spill_reg = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_spill_off = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_spill_size = malloc((4 * 16).to_type(u64)).to_type(*int);
    c_call_base = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_call_direct = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_arg_agg = malloc((4 * 256).to_type(u64)).to_type(*int);
    c_aggparam_src = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_aggparam_dst = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_aggparam_size = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_lit_save_off = malloc((4 * 32).to_type(u64)).to_type(*int);
    c_lit_save_tid = malloc((4 * 32).to_type(u64)).to_type(*int);
    c_fi_kind = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_cnt_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_len_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_data_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_step_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_elem_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_fi_idx_off = malloc((4 * 64).to_type(u64)).to_type(*int);
    c_bss_syms = malloc((4 * 4096).to_type(u64)).to_type(*int);
    sc_sc_false_stk = malloc((4 * 64).to_type(u64)).to_type(*int);
    sc_sc_end_stk = malloc((4 * 64).to_type(u64)).to_type(*int);
    if (c_scope_start == 0 || c_brk_stk == 0 || c_cnt_stk == 0
        || c_glabels == 0 || c_args == 0 || c_argtys == 0
        || c_spill_reg == 0 || c_spill_off == 0 || c_spill_size == 0
        || c_call_base == 0
        || c_call_direct == 0 || c_arg_agg == 0
        || c_aggparam_src == 0 || c_aggparam_dst == 0 || c_aggparam_size == 0
        || c_lit_save_off == 0 || c_lit_save_tid == 0
        || c_fi_kind == 0 || c_fi_cnt_off == 0 || c_fi_len_off == 0
        || c_fi_data_off == 0 || c_fi_step_off == 0
        || c_fi_elem_off == 0 || c_fi_idx_off == 0
        || c_bss_syms == 0
        || sc_sc_false_stk == 0 || sc_sc_end_stk == 0) {
        return fail("内存分配失败");
    }
    return 0;
}

// prelude_add：登记一个 prelude 外部函数（名字进池；签名进签名表）。
pub fn prelude_add(name *char, ret int, np int, vararg int) int {
    let n int = 0;
    for name[n] != 0 {
        n += 1;
    }
    let off int = name_intern_lit(name);
    if (off < 0) {
        return -1;
    }
    let ftid int = ty_fn(ret, t_sigparam_n - np, np, vararg);
    return sym_push_lit(off, n, SYM_FN, ftid, F_EXTERN | F_PUB);
}

// sem_register_prelude：登记 prelude 的 10 个外部函数（语义边界 §7）。
// 签名参数类型先按序入池，再以池起始下标建函数类型。
pub fn sem_register_prelude() int {
    let t_pvoid int = ty_ptr(TY_VOID);
    let t_pchar int = ty_ptr(TY_CHAR);
    // printf(fmt *char, ...) int —— 裸变参
    ty_sig_param(t_pchar);
    prelude_add("printf", TY_I32, 1, 1);
    // malloc(size u64) *void
    ty_sig_param(TY_U64);
    prelude_add("malloc", t_pvoid, 1, 0);
    // free(p *void) void
    ty_sig_param(t_pvoid);
    prelude_add("free", TY_VOID, 1, 0);
    // memcpy(dst *void, src *void, n u64) *void
    ty_sig_param(t_pvoid);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    prelude_add("memcpy", t_pvoid, 3, 0);
    // strlen(s *char) u64
    ty_sig_param(t_pchar);
    prelude_add("strlen", TY_U64, 1, 0);
    // exit(code int) void
    ty_sig_param(TY_I32);
    prelude_add("exit", TY_VOID, 1, 0);
    // open(path *char, flags int, ...) int —— 裸变参
    ty_sig_param(t_pchar);
    ty_sig_param(TY_I32);
    prelude_add("open", TY_I32, 2, 1);
    // close(fd int) int
    ty_sig_param(TY_I32);
    prelude_add("close", TY_I32, 1, 0);
    // read(fd int, buf *void, count u64) i64
    ty_sig_param(TY_I32);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    prelude_add("read", TY_I64, 3, 0);
    // write(fd int, buf *void, count u64) i64
    ty_sig_param(TY_I32);
    ty_sig_param(t_pvoid);
    ty_sig_param(TY_U64);
    prelude_add("write", TY_I64, 3, 0);
    // system(cmd *char) int —— 供 -o 模式调用外部汇编器/链接器
    ty_sig_param(t_pchar);
    prelude_add("system", TY_I32, 1, 0);
    // unlink(path *char) int —— 清理 -o 模式的临时汇编文件
    ty_sig_param(t_pchar);
    prelude_add("unlink", TY_I32, 1, 0);
    return 0;
}

// tml_intern_str：把任意缓冲字节 intern 进名字池（mod.toml/项目路径/
// 诊断消息用；自 cmd/toml.yh 迁入使 parse 可直接调用——ADR-0007 P3）。

// tml_intern_str：与 tml_intern 相同，但从 t_buf（任意缓冲）取字节。
pub fn tml_intern_str(buf *u8, start int, n int) int {
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    let off int = np_len;
    let i int = 0;
    for i < n {
        np_data[np_len] = buf[start + i];
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off;
}

// mod_ns_lookup：模块命名空间查条目（want_type=1 查类型名；
// 自 parse/iface.yh 迁入使 parse_type/parse_expr 可直接调用——P3 解环）。

// mod_ns_lookup：模块命名空间查条目下标。want_type=1 查类型名，否则查值。
pub fn mod_ns_lookup(mi int, start int, n int, want_type int) int {
    let i int = 0;
    for i < c_mods[mi].ns_n {
        if (c_mods[mi].ns[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_mods[mi].ns[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                if (want_type != 0) {
                    if (c_mods[mi].ns[i].tid >= 0) {
                        return i;
                    }
                    return -1;
                }
                if (c_mods[mi].ns[i].sym >= 0) {
                    return i;
                }
                return -1;
            }
        }
        i += 1;
    }
    return -1;
}

// mod_file_binding：当前文件导入表查绑定名（读 gen 的导入表全局；
// 自 parse/parse_expr.yh 迁入供 sizeof_starts_type 限定类型判定——P3）。

// mod_file_binding：当前文件导入表中查绑定名，返回 ModInfo 下标；无 -1。
pub fn mod_file_binding(start int, n int) int {
    if (mod_import_mod == 0) {
        return -1;
    }
    let i int = 0;
    for i < mod_import_n {
        if (mod_import_mod[i] >= 0 && mod_imports[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[mod_imports[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return mod_import_mod[i];
            }
        }
        i += 1;
    }
    return -1;
}


// ============================================================================
// emit_arm64.yh —— AArch64（GNU 汇编方言）指令发射器
//
// 多平台接入缝之二：本文件实现前端（symbols.yh / sem.yh / parse_*.yh）
// 依赖的全部 em_* 「抽象机原语」。换目标 = 提供新 target.yh 数据模型 +
// 新 emit_<isa>.yh（同名原语），前端零改动。
//
// 原语契约（前端可见的抽象机）：
//   值表达     所有「产生值」的原语结果一律留在 x0；
//   值栈       em_push 把 x0 压栈（16 字节槽，保持 sp 16 对齐），
//              em_pop 弹出到指定寄存器；
//   二元运算   x9 = 左操作数，x0 = 右操作数，结果回 x0；
//   地址       地址型原语（取地址/退化/成员/下标）把地址留在 x0；
//   标签       em_new_label 取号，em_label 定义，em_jmp/em_jz 跳转；
//   调用       实参经值栈搬运（前 8 个进 x0..x7，其余进调用点栈区）；
//   过程       em_prologue/em_alloc_local/em_finish_fn 管理栈帧。
//
// 栈帧模型：无静态帧大小——prologue 只保存 fp/lr（16 字节）；每个局部/
// 参数/临时在声明点 sub sp 一个 16 字节对齐的槽，用 fp 负偏移访问；
// 值栈在 sp 之下动态生长，任何调用点 sp 保持 16 对齐。
//
// 输出组织：.text 进入 o_out；全局初始化与字符串进入 o_dat（.data 段）；
// 零初始化全局进入 o_bss（.bss 段）。编译成功后由 flush_output 一次写出。
// ============================================================================

// —— 行发射（frag = 无换行片段；ins = 完整指令行） ——

// em_frag：向 .text 追加字符串片段。
pub fn em_frag(s *char) int {
    return em_puts(s);
}

// em_ins：完整指令行。
pub fn em_ins(s *char) int {
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(s) != 0) { return -1; }
    return em_frag("\n");
}

// em_new_label：分配一个局部标签号。
pub fn em_new_label() int {
    c_lbl_n += 1;
    return c_lbl_n - 1;
}

// em_put_lbl：输出 ".L<n>" 标签名。
pub fn em_put_lbl(n int) int {
    if (em_frag(".L") != 0) { return -1; }
    return em_puti(n);
}

// em_label：定义局部标签。
pub fn em_label(n int) int {
    if (em_put_lbl(n) != 0) { return -1; }
    return em_frag(":\n");
}

// em_jmp：无条件跳转。
pub fn em_jmp(n int) int {
    if (em_frag("\tb\t") != 0) { return -1; }
    if (em_put_lbl(n) != 0) { return -1; }
    return em_frag("\n");
}

// em_jz：x0 为零跳转（条件为假）。
pub fn em_jz(n int) int {
    if (em_frag("\tcbz\tx0, ") != 0) { return -1; }
    if (em_put_lbl(n) != 0) { return -1; }
    return em_frag("\n");
}

// em_jnz：x0 非零跳转（条件为真）。
pub fn em_jnz(n int) int {
    if (em_frag("\tcbnz\tx0, ") != 0) { return -1; }
    if (em_put_lbl(n) != 0) { return -1; }
    return em_frag("\n");
}

// em_beq：相等条件跳转（cmp 之后的 Z 标志）。
pub fn em_beq(n int) int {
    if (em_frag("\tbeq\t") != 0) { return -1; }
    if (em_put_lbl(n) != 0) { return -1; }
    return em_frag("\n");
}

// em_scale_index：把 x0 中的下标按元素类型大小缩放（地址算术用）。
pub fn em_scale_index(elem_tid int) int {
    let esz int = t_types[elem_tid].size;
    if (esz == 1) {
        return 0;
    }
    if (esz == 2) {
        return em_ins("lsl\tx0, x0, #1");
    }
    if (esz == 4) {
        return em_ins("lsl\tx0, x0, #2");
    }
    return em_ins("lsl\tx0, x0, #3");
}

// em_mov_imm：装载 64 位立即数到寄存器（movz/movk 组合）。
pub fn em_mov_imm(reg *char, v i64) int {
    if (v == 0) {
        if (em_frag("\tmov\t") != 0) { return -1; }
        if (em_frag(reg) != 0) { return -1; }
        return em_frag(", xzr\n");
    }
    let h0 int = (v & 0xFFFF).to_type(int);
    let h1 int = ((v >> 16) & 0xFFFF).to_type(int);
    let h2 int = ((v >> 32) & 0xFFFF).to_type(int);
    let h3 int = ((v >> 48) & 0xFFFF).to_type(int);
    let hs [3]int;
    hs[0] = h1;
    hs[1] = h2;
    hs[2] = h3;
    if (em_frag("\tmovz\t") != 0) { return -1; }
    if (em_frag(reg) != 0) { return -1; }
    if (em_frag(", #") != 0) { return -1; }
    if (em_puti(h0) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    let shift int = 16;
    let i int = 0;
    for i < 3 {
        if (hs[i] != 0) {
            if (em_frag("\tmovk\t") != 0) { return -1; }
            if (em_frag(reg) != 0) { return -1; }
            if (em_frag(", #") != 0) { return -1; }
            if (em_puti(hs[i]) != 0) { return -1; }
            if (em_frag(", lsl #") != 0) { return -1; }
            if (em_puti(shift) != 0) { return -1; }
            if (em_frag("\n") != 0) { return -1; }
        }
        shift += 16;
        i += 1;
    }
    return 0;
}

// em_push：x0 压值栈。
pub fn em_push() int {
    return em_ins("str\tx0, [sp, #-16]!");
}

// em_pop：值栈弹出到寄存器。
pub fn em_pop(reg *char) int {
    if (em_frag("\tldr\t") != 0) { return -1; }
    if (em_frag(reg) != 0) { return -1; }
    return em_frag(", [sp], #16\n");
}

// em_load_sized：按类型从 x10 地址装入 x0（有符号小类型符号扩展）。
pub fn em_load_sized(tid int) int {
    // 浮点装入 d0/s0（消费方按浮点值约定使用）
    if (ty_is_float(tid) != 0) {
        if (t_types[tid].size == 4) {
            return em_ins("ldr\ts0, [x10]");
        }
        return em_ins("ldr\td0, [x10]");
    }
    let size int = t_types[tid].size;
    if (size == 8) {
        return em_ins("ldr\tx0, [x10]");
    }
    if (size == 4) {
        if (ty_is_signed(tid) != 0) {
            return em_ins("ldrsw\tx0, [x10]");
        }
        return em_ins("ldr\tw0, [x10]");
    }
    if (size == 2) {
        if (ty_is_signed(tid) != 0) {
            return em_ins("ldrsh\tx0, [x10]");
        }
        return em_ins("ldrh\tw0, [x10]");
    }
    if (ty_is_signed(tid) != 0) {
        return em_ins("ldrsb\tx0, [x10]");
    }
    return em_ins("ldrb\tw0, [x10]");
}

// em_store_sized：x0 → [x10] 按类型存（低字节自然截断）。
pub fn em_store_sized(tid int) int {
    // 浮点值在 s0/d0（与值栈约定一致），不能用 x0 存
    if (ty_is_float(tid) != 0) {
        if (t_types[tid].size == 4) {
            return em_ins("str\ts0, [x10]");
        }
        return em_ins("str\td0, [x10]");
    }
    let size int = t_types[tid].size;
    if (size == 8) {
        return em_ins("str\tx0, [x10]");
    }
    if (size == 4) {
        return em_ins("str\tw0, [x10]");
    }
    if (size == 2) {
        return em_ins("strh\tw0, [x10]");
    }
    return em_ins("strb\tw0, [x10]");
}

// ---- 局部变量（fp 负偏移） ----
//
// 深帧（偏移 > 255）寻址需一条寄存器装立即数。该临时**专用 x12**：
// x9/x10/x11 在调用方常持有活跃值（lea_local_to 的结果、栈实参暂存、
// copy_block 源），曾被临时借用导致一族「小帧正常、深帧即坏」的缺陷
// （区间长度算成槽偏移、切片 data 写错等，2026-09-29 差分压测定位）。
// 调用方任何地方都不得依赖 x12 跨 lea 存活。

// em_lea_local：局部/临时槽地址 → x0。off ≥ 0 为 fp 之下的局部
//（fp - off）；off < 0 为调用方栈区参数（fp - off = fp + |off|）。
pub fn em_lea_local(off int) int {
    if (off >= 0) {
        return em_lea_local_down(off);
    }
    let up int = 0 - off;
    if (up <= 255) {
        if (em_frag("\tadd\tx0, x29, #") != 0) { return -1; }
        if (em_puti(up) != 0) { return -1; }
        return em_frag("\n");
    }
    if (em_mov_imm("x12", up.to_type(i64)) != 0) { return -1; }
    return em_ins("add\tx0, x29, x12");
}

// em_lea_local_down：fp 之下槽的地址（fp - off）→ x0。
pub fn em_lea_local_down(off int) int {
    if (off <= 255) {
        if (em_frag("\tsub\tx0, x29, #") != 0) { return -1; }
        if (em_puti(off) != 0) { return -1; }
        return em_frag("\n");
    }
    if (em_mov_imm("x12", off.to_type(i64)) != 0) { return -1; }
    return em_ins("sub\tx0, x29, x12");
}

// em_lea_local_to：局部槽地址 → x10（不触碰 x0，保存值用）。
pub fn em_lea_local_to(off int) int {
    if (off >= 0) {
        return em_lea_local_to_down(off);
    }
    let up int = 0 - off;
    if (up <= 255) {
        if (em_frag("\tadd\tx10, x29, #") != 0) { return -1; }
        if (em_puti(up) != 0) { return -1; }
        return em_frag("\n");
    }
    if (em_mov_imm("x12", up.to_type(i64)) != 0) { return -1; }
    return em_ins("add\tx10, x29, x12");
}

// em_lea_local_to_down：fp 之下槽的地址 → x10。
pub fn em_lea_local_to_down(off int) int {
    if (off <= 255) {
        if (em_frag("\tsub\tx10, x29, #") != 0) { return -1; }
        if (em_puti(off) != 0) { return -1; }
        return em_frag("\n");
    }
    if (em_mov_imm("x12", off.to_type(i64)) != 0) { return -1; }
    return em_ins("sub\tx10, x29, x12");
}

// em_spill_reg_name：第 n 个参数寄存器名。
pub fn em_spill_reg_name(n int) *char {
    if (n == 0) { return "x0"; }
    if (n == 1) { return "x1"; }
    if (n == 2) { return "x2"; }
    if (n == 3) { return "x3"; }
    if (n == 4) { return "x4"; }
    if (n == 5) { return "x5"; }
    if (n == 6) { return "x6"; }
    return "x7";
}

// em_load_local：装入局部标量（x10 暂存地址）。
pub fn em_load_local(off int, tid int) int {
    if (em_lea_local(off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    return em_load_sized(tid);
}

// em_store_local：值栈顶弹出存入局部（x10 暂存地址，值在栈顶）。
pub fn em_store_local(off int, tid int) int {
    if (em_lea_local(off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    return em_store_sized(tid);
}

// ---- 符号名与全局地址 ----

// em_put_sym_name：输出符号汇编名到 .text（名字池逐字节）。
// Darwin 方言先写 "_" 前缀（C 符号约定），GNU 无前缀。
// em_sym_qualify：模块模式下把符号后缀（__proj__mod）追加到名字之后。
// 豁免：extern 符号（prelude/libc 与已带后缀的导入符号）；入口模块的
// main（crt 引用裸名）。单文件模式恒不追加。
pub fn em_sym_qualify(idx int) int {
    if (c_module_mode == 0 || c_sym_sfx_len == 0) {
        return 0;
    }
    if ((c_syms[idx].flags & F_EXTERN) != 0) {
        return 0;
    }
    if (c_is_entry_mod != 0 && c_syms[idx].name_len == 4
        && np_data[c_syms[idx].name_off] == 'm' && np_data[c_syms[idx].name_off + 1] == 'a'
        && np_data[c_syms[idx].name_off + 2] == 'i' && np_data[c_syms[idx].name_off + 3] == 'n') {
        return 0;
    }
    let i int = 0;
    for i < c_sym_sfx_len {
        if (em_put(np_data[c_sym_sfx_off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// dat_sym_qualify / bss_sym_qualify：同 em_sym_qualify，写 .data/.bss 缓冲。
pub fn dat_sym_qualify(idx int) int {
    if (c_module_mode == 0 || c_sym_sfx_len == 0) {
        return 0;
    }
    if ((c_syms[idx].flags & F_EXTERN) != 0) {
        return 0;
    }
    if (c_is_entry_mod != 0 && c_syms[idx].name_len == 4
        && np_data[c_syms[idx].name_off] == 'm' && np_data[c_syms[idx].name_off + 1] == 'a'
        && np_data[c_syms[idx].name_off + 2] == 'i' && np_data[c_syms[idx].name_off + 3] == 'n') {
        return 0;
    }
    let i int = 0;
    for i < c_sym_sfx_len {
        if (dat_put(np_data[c_sym_sfx_off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

pub fn bss_sym_qualify(idx int) int {
    if (c_module_mode == 0 || c_sym_sfx_len == 0) {
        return 0;
    }
    if ((c_syms[idx].flags & F_EXTERN) != 0) {
        return 0;
    }
    if (c_is_entry_mod != 0 && c_syms[idx].name_len == 4
        && np_data[c_syms[idx].name_off] == 'm' && np_data[c_syms[idx].name_off + 1] == 'a'
        && np_data[c_syms[idx].name_off + 2] == 'i' && np_data[c_syms[idx].name_off + 3] == 'n') {
        return 0;
    }
    let i int = 0;
    for i < c_sym_sfx_len {
        if (bss_put(np_data[c_sym_sfx_off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

pub fn em_put_sym_name(idx int) int {
    if (em_frag(tg_sym_prefix()) != 0) { return -1; }
    let n int = c_syms[idx].name_len;
    let off int = c_syms[idx].name_off;
    let i int = 0;
    for i < n {
        if (em_put(np_data[off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return em_sym_qualify(idx);
}

// dat_put_sym_name：输出符号汇编名到 .data/.bss 缓冲。
pub fn dat_put_sym_name(idx int) int {
    if (dat_puts(tg_sym_prefix()) != 0) { return -1; }
    let n int = c_syms[idx].name_len;
    let off int = c_syms[idx].name_off;
    let i int = 0;
    for i < n {
        if (dat_put(np_data[off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return dat_sym_qualify(idx);
}

// em_lea_global：全局符号地址 → x0。
//   GNU/Linux：`adrp x0, sym` + `add x0, x0, :lo12:sym`（静态链接，直接取址）。
//   Darwin：外部（prelude/libc）符号必须经 GOT（Mach-O 不支持外部符号直接
//   页偏移寻址），写 `adrp x0, sym@GOTPAGE` + `ldr x0, [x0, sym@GOTPAGEOFF]`；
//   本编译单元内定义的符号用 `adrp/add @PAGE/@PAGEOFF`。
//   prelude 符号的标志位含 F_EXTERN（见 symbols.yh），据此区分。
pub fn em_lea_global(idx int) int {
    if (tg_darwin() != 0) {
        if ((c_syms[idx].flags & F_EXTERN) != 0) {
            if (em_frag("\tadrp\tx0, ") != 0) { return -1; }
            if (em_put_sym_name(idx) != 0) { return -1; }
            if (em_frag("@GOTPAGE\n\tldr\tx0, [x0, ") != 0) { return -1; }
            if (em_put_sym_name(idx) != 0) { return -1; }
            return em_frag("@GOTPAGEOFF]\n");
        }
        if (em_frag("\tadrp\tx0, ") != 0) { return -1; }
        if (em_put_sym_name(idx) != 0) { return -1; }
        if (em_frag("@PAGE\n\tadd\tx0, x0, ") != 0) { return -1; }
        if (em_put_sym_name(idx) != 0) { return -1; }
        return em_frag("@PAGEOFF\n");
    }
    if (em_frag("\tadrp\tx0, ") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag("\n\tadd\tx0, x0, :lo12:") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    return em_frag("\n");
}

// em_load_global：装入全局标量。
pub fn em_load_global(idx int, tid int) int {
    if (em_lea_global(idx) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    return em_load_sized(tid);
}

// em_store_global：值栈顶弹出存入全局。
pub fn em_store_global(idx int, tid int) int {
    if (em_lea_global(idx) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    return em_store_sized(tid);
}

// em_load_data_label：数据标签地址 → x0（字符串/指针常量用）。
// GNU 用 `adrp/add :lo12:.LD<n>`；Darwin 用 `adrp/add @PAGE/@PAGEOFF`。
pub fn em_load_data_label(lbl int) int {
    if (tg_darwin() != 0) {
        if (em_frag("\tadrp\tx0, .LD") != 0) { return -1; }
        if (em_puti(lbl) != 0) { return -1; }
        if (em_frag("@PAGE\n\tadd\tx0, x0, .LD") != 0) { return -1; }
        if (em_puti(lbl) != 0) { return -1; }
        if (em_frag("@PAGEOFF\n") != 0) { return -1; }
        return 0;
    }
    if (em_frag("\tadrp\tx0, .LD") != 0) { return -1; }
    if (em_puti(lbl) != 0) { return -1; }
    if (em_frag("\n\tadd\tx0, x0, :lo12:.LD") != 0) { return -1; }
    if (em_puti(lbl) != 0) { return -1; }
    return em_frag("\n");
}

// ---- 聚合按值原语（调用点拷贝 + 指针传递） ----
//
// 约定：聚合值在 x0 中是一个地址（指向调用方/被调用方持有的存储）。
// 传递时按指针进寄存器/栈；被调用方把指针存进参数槽，访问字段时先
// 装入指针再加偏移（语义等价于独立的数组/结构体值）。

// em_copy_block：把 x0 指向的 n 字节拷到 x1 指向处（不重叠即可，
// 实现用简单字节循环；x9/x10/x11 为临时）。
pub fn em_copy_block(n int) int {
    if (em_mov_imm("x9", n.to_type(i64)) != 0) { return -1; }
    let lloop int = em_new_label();
    let ldone int = em_new_label();
    if (em_label(lloop) != 0) { return -1; }
    if (em_frag("\tcbz\tx9, ") != 0) { return -1; }
    if (em_put_lbl(ldone) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    if (em_ins("ldrb\tw10, [x0], #1") != 0) { return -1; }
    if (em_ins("strb\tw10, [x1], #1") != 0) { return -1; }
    if (em_ins("sub\tx9, x9, #1") != 0) { return -1; }
    if (em_jmp(lloop) != 0) { return -1; }
    if (em_label(ldone) != 0) { return -1; }
    return 0;
}

// em_lea_scratch：为聚合临时分配一个 16 字节对齐的槽，返回 fp 距离。
pub fn em_lea_scratch(size int) int {
    return em_alloc_local(size);
}

// em_agg_arg_copy：x0 = 聚合源地址；拷贝 size 字节到新临时，返回新地址。
pub fn em_agg_arg_copy(size int) int {
    if (em_push() != 0) { return -1; }
    let off int = em_alloc_local(size);
    if (em_lea_local(off) != 0) { return -1; }
    if (em_ins("mov\tx1, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_copy_block(size) != 0) { return -1; }
    return em_lea_local(off);
}

// em_push_agg_ptr：把 x0 中的聚合地址按指针压值栈。
pub fn em_push_agg_ptr() int {
    return em_push();
}

// em_save_hidden_ret：函数入口把 x8（聚合返回缓冲）存入槽 off。
pub fn em_save_hidden_ret(off int) int {
    if (em_lea_local_to(off) != 0) { return -1; }
    if (em_ins("str\tx8, [x10]") != 0) { return -1; }
    return 0;
}

// em_load_hidden_ret：把聚合返回缓冲地址装入 x0。
pub fn em_load_hidden_ret(off int) int {
    if (em_lea_local_to(off) != 0) { return -1; }
    if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
    return 0;
}

// ---- 浮点原语（f32/f64；AArch64 浮点寄存器 s0-s31 / d0-d31） ----
//
// 约定：浮点值在 d0（f64）或 s0（f32）；二元运算左操作数在 d1、右在 d0，
// 结果回 d0；与整型/指针共用值栈（每个槽 16 字节，浮点占用低 8 字节）。

// em_fp_name：按类型返回浮点寄存器名（f64→d0/d1，f32→s0/s1）。
pub fn em_fp_name(tid int, which int) *char {
    let is64 int = (t_types[tid].size == 8).to_type(int);
    if (which == 0) {
        if (is64 != 0) { return "d0"; }
        return "s0";
    }
    if (is64 != 0) { return "d1"; }
    return "s1";
}

// em_push_fp：把浮点结果寄存器压值栈。
pub fn em_push_fp(tid int) int {
    if (em_frag("\tstr\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    return em_frag(", [sp, #-16]!\n");
}

// em_pop_fp：弹出到指定浮点寄存器。
pub fn em_pop_fp(tid int, which int) int {
    if (em_frag("\tldr\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, which)) != 0) { return -1; }
    return em_frag(", [sp], #16\n");
}

// em_fp_binop：d1 与 d0 的浮点二元运算（结果 d0）。op 为 TK_*。
// GNU as 用操作数寄存器名区分宽度（d0/s0），助记符本身无 .d/.s 后缀。
pub fn em_fp_binop(op int, tid int) int {
    let mnem *char = "fadd";
    if (op == TK_MINUS) { mnem = "fsub"; }
    if (op == TK_STAR) { mnem = "fmul"; }
    if (op == TK_SLASH) { mnem = "fdiv"; }
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(mnem) != 0) { return -1; }
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    if (em_frag(", ") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 1)) != 0) { return -1; }
    if (em_frag(", ") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    return em_frag("\n");
}

// em_fp_compare：d1 与 d0 的比较 → x0 = 0/1（bool）。
pub fn em_fp_compare(op int, tid int) int {
    if (em_frag("\tfcmp\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 1)) != 0) { return -1; }
    if (em_frag(", ") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    // 条件码：eq/ne/gt/ge/lt/le 直接用浮点语义
    let cc *char = "eq";
    if (op == TK_EQEQ) { cc = "eq"; }
    if (op == TK_NEQ) { cc = "ne"; }
    if (op == TK_LT) { cc = "lt"; }
    if (op == TK_LEQ) { cc = "le"; }
    if (op == TK_GT) { cc = "gt"; }
    if (op == TK_GEQ) { cc = "ge"; }
    if (em_frag("\tcset\tx0, ") != 0) { return -1; }
    if (em_frag(cc) != 0) { return -1; }
    return em_frag("\n");
}

// em_fp_neg：d0 取负。
pub fn em_fp_neg(tid int) int {
    if (em_frag("\tfneg\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    if (em_frag(", ") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    return em_frag("\n");
}

// em_fp_load_local：从 fp-off 装入浮点值到 d0/s0。
pub fn em_fp_load_local(off int, tid int) int {
    if (em_lea_local_to(off) != 0) { return -1; }
    let suffix *char = "d";
    if (t_types[tid].size == 4) { suffix = "s"; }
    if (em_frag("\tldr\t") != 0) { return -1; }
    if (em_frag(suffix) != 0) { return -1; }
    if (em_frag("0, [x10]") != 0) { return -1; }
    return em_frag("\n");
}

// em_fp_store_local：d0/s0 存入 fp-off。
pub fn em_fp_store_local(off int, tid int) int {
    if (em_lea_local_to(off) != 0) { return -1; }
    let suffix *char = "d";
    if (t_types[tid].size == 4) { suffix = "s"; }
    if (em_frag("\tstr\t") != 0) { return -1; }
    if (em_frag(suffix) != 0) { return -1; }
    if (em_frag("0, [x10]") != 0) { return -1; }
    return em_frag("\n");
}

// em_int_to_fp：x0 中的整型 → 浮点 d0/s0（宽度由目标寄存器名区分）。
pub fn em_int_to_fp(tid int, src_signed int) int {
    let mnem *char = "scvtf";
    if (src_signed == 0) { mnem = "ucvtf"; }
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(mnem) != 0) { return -1; }
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(em_fp_name(tid, 0)) != 0) { return -1; }
    return em_frag(", x0\n");
}

// em_fp_to_int：d0/s0 → x0（向零截断，有符号）。
pub fn em_fp_to_int(src_tid int, dst_signed int) int {
    let mnem *char = "fcvtzs";
    if (dst_signed == 0) { mnem = "fcvtzu"; }
    if (em_frag("\t") != 0) { return -1; }
    if (em_frag(mnem) != 0) { return -1; }
    if (em_frag("\tx0, ") != 0) { return -1; }
    if (em_frag(em_fp_name(src_tid, 0)) != 0) { return -1; }
    return em_frag("\n");
}

// ---- 二元与一元运算 ----

// em_binop：x9 = 左，x0 = 右 → x0。tid 为公共结果类型。
pub fn em_binop(op int, tid int) int {
    if (op == TK_PLUS) { return em_ins("add\tx0, x9, x0"); }
    if (op == TK_MINUS) { return em_ins("sub\tx0, x9, x0"); }
    if (op == TK_STAR) { return em_ins("mul\tx0, x9, x0"); }
    if (op == TK_SLASH) {
        if (ty_is_signed(tid) != 0) {
            return em_ins("sdiv\tx0, x9, x0");
        }
        return em_ins("udiv\tx0, x9, x0");
    }
    if (op == TK_PERCENT) {
        // 商用 x11（不与调用约定中的间接目标 x10 冲突——复合赋值经
        // x10 持有目标地址，取模的商若写 x10 会破坏它）
        if (ty_is_signed(tid) != 0) {
            if (em_ins("sdiv\tx11, x9, x0") != 0) { return -1; }
        } else {
            if (em_ins("udiv\tx11, x9, x0") != 0) { return -1; }
        }
        return em_ins("msub\tx0, x11, x0, x9");
    }
    if (op == TK_AMP) { return em_ins("and\tx0, x9, x0"); }
    if (op == TK_PIPE) { return em_ins("orr\tx0, x9, x0"); }
    if (op == TK_CARET) { return em_ins("eor\tx0, x9, x0"); }
    if (op == TK_LSHIFT) { return em_ins("lslv\tx0, x9, x0"); }
    if (op == TK_RSHIFT) {
        if (ty_is_signed(tid) != 0) {
            return em_ins("asrv\tx0, x9, x0");
        }
        return em_ins("lsrv\tx0, x9, x0");
    }
    return sem_err("内部错误：未知二元运算");
}

// em_compare：x9 = 左，x0 = 右 → x0 = 0/1（bool）。
pub fn em_compare(op int, tid int) int {
    if (em_ins("cmp\tx9, x0") != 0) { return -1; }
    let cc *char = "ne";
    if (op == TK_EQEQ) { cc = "eq"; }
    if (op == TK_NEQ) { cc = "ne"; }
    if (op == TK_LT) {
        if (ty_is_signed(tid) != 0) { cc = "lt"; } else { cc = "lo"; }
    }
    if (op == TK_LEQ) {
        if (ty_is_signed(tid) != 0) { cc = "le"; } else { cc = "ls"; }
    }
    if (op == TK_GT) {
        if (ty_is_signed(tid) != 0) { cc = "gt"; } else { cc = "hi"; }
    }
    if (op == TK_GEQ) {
        if (ty_is_signed(tid) != 0) { cc = "ge"; } else { cc = "hs"; }
    }
    if (em_frag("\tcset\tx0, ") != 0) { return -1; }
    if (em_frag(cc) != 0) { return -1; }
    return em_frag("\n");
}

// em_unary：一元运算（操作数在 x0）。
pub fn em_unary(op int, tid int) int {
    if (op == TK_MINUS) { return em_ins("neg\tx0, x0"); }
    if (op == TK_PLUS) { return 0; }
    if (op == TK_TILDE) { return em_ins("mvn\tx0, x0"); }
    if (op == TK_BANG) {
        if (em_ins("cmp\tx0, 0") != 0) { return -1; }
        return em_ins("cset\tx0, eq");
    }
    return sem_err("内部错误：未知一元运算");
}

// ---- 过程与调用 ----

// em_prologue：装配函数开头（函数体已在缓冲中，帧大小确定后调用）。
// pub 修饰为 .globl；帧大小一次 sub；随后溢出寄存器实参。
pub fn em_prologue(idx int) int {
    if ((c_syms[idx].flags & F_PUB) != 0) {
        if (em_frag("\t.globl\t") != 0) { return -1; }
        if (em_put_sym_name(idx) != 0) { return -1; }
        if (em_frag("\n") != 0) { return -1; }
    }
    if (em_put_sym_name(idx) != 0) { return -1; }
    if (em_frag(":\n") != 0) { return -1; }
    if (em_ins("stp\tx29, x30, [sp, #-16]!") != 0) { return -1; }
    if (em_ins("mov\tx29, sp") != 0) { return -1; }
    if (c_fp_off > 0) {
        if (c_fp_off <= 4095) {
            if (em_frag("\tsub\tsp, sp, #") != 0) { return -1; }
            if (em_puti(c_fp_off) != 0) { return -1; }
            if (em_frag("\n") != 0) { return -1; }
        } else {
            if (em_mov_imm("x9", c_fp_off.to_type(i64)) != 0) { return -1; }
            if (em_ins("sub\tsp, sp, x9") != 0) { return -1; }
        }
    }
    // 溢出寄存器实参到各自槽位（负数标记 = 浮点寄存器）
    let i int = 0;
    for i < c_spill_n {
        if (em_lea_local_to_down(c_spill_off[i]) != 0) { return -1; }
        if (c_spill_reg[i] < 0) {
            let tid int = c_spill_size[i];
            let suffix *char = "d";
            if (t_types[tid].size == 4) { suffix = "s"; }
            let regno int = 0 - c_spill_reg[i] - 1;
            if (em_frag("\tstr\t") != 0) { return -1; }
            if (em_frag(suffix) != 0) { return -1; }
            if (em_puti(regno) != 0) { return -1; }
            if (em_frag(", [x10]\n") != 0) { return -1; }
        } else {
            if (em_frag("\tstr\t") != 0) { return -1; }
            if (em_frag(em_spill_reg_name(c_spill_reg[i])) != 0) { return -1; }
            if (em_frag(", [x10]\n") != 0) { return -1; }
        }
        i += 1;
    }
    return 0;
}

// em_copy_body：体缓冲逐字节转入 .text。
pub fn em_copy_body() int {
    let i int = 0;
    for i < o_body_len {
        if (out_grow(&o_out, o_len, &o_cap, o_len + 1) != 0) {
            return -1;
        }
        o_out[o_len] = o_body[i];
        o_len += 1;
        i += 1;
    }
    return 0;
}

// em_epilogue：共享收尾。sp 恢复必须在标签之后——显式 return 与
// 落底路径都汇聚到标签，二者都需要恢复 sp。
pub fn em_epilogue() int {
    if (em_label(c_fn_lbl) != 0) { return -1; }
    if (em_ins("mov\tsp, x29") != 0) { return -1; }
    if (em_ins("ldp\tx29, x30, [sp], #16") != 0) { return -1; }
    if (em_ins("ret") != 0) { return -1; }
    return em_frag("\n");
}

// em_alloc_local：登记一个 16 字节对齐的槽（静态帧，不发射代码），
// 返回距 fp 的字节距离（地址 = fp - off）。
pub fn em_alloc_local(size int) int {
    let n int = (size + TG_STACK_ALIGN - 1) / TG_STACK_ALIGN * TG_STACK_ALIGN;
    if (n == 0) {
        n = TG_STACK_ALIGN;
    }
    c_fp_off += n;
    return c_fp_off;
}

// em_call_direct：直接调用。
pub fn em_call_direct(idx int) int {
    if (em_frag("\tbl\t") != 0) { return -1; }
    if (em_put_sym_name(idx) != 0) { return -1; }
    return em_frag("\n");
}

// em_call_indirect：间接调用（目标在 x10）。
pub fn em_call_indirect() int {
    return em_ins("blr\tx10");
}

// em_call_arg_to_reg：值栈顶实参弹入第 n 个参数寄存器（n = 0..7 → x0..x7）。
pub fn em_call_arg_to_reg(n int) int {
    let reg *char = "x0";
    if (n == 1) { reg = "x1"; }
    if (n == 2) { reg = "x2"; }
    if (n == 3) { reg = "x3"; }
    if (n == 4) { reg = "x4"; }
    if (n == 5) { reg = "x5"; }
    if (n == 6) { reg = "x6"; }
    if (n == 7) { reg = "x7"; }
    return em_pop(reg);
}

// em_call_cleanup_bytes：调用后回收调用点栈区（area_bytes 字节，
// 已按 16 对齐取整）。调用点栈区由「弹栈-回压」直接形成，无需先开区。
pub fn em_call_cleanup_bytes(bytes int) int {
    if (bytes <= 0) {
        return 0;
    }
    if (em_frag("\tadd\tsp, sp, #") != 0) { return -1; }
    if (em_puti(bytes) != 0) { return -1; }
    return em_frag("\n");
}

// em_call_stack_alloc：调用点栈区一次性开足 bytes 字节（须为 16 的倍数）。
// 必须「整块开区 + 偏移写入」，不能逐槽 8 字节 pre-index 压栈：AArch64 要求
// sp 参与访存时 16 字节对齐，逐槽压栈会让 sp 变成 8 字节对齐并触发
// alignment fault（Linux/Darwin 均报 SIGBUS）。
pub fn em_call_stack_alloc(bytes int) int {
    if (bytes <= 0) {
        return 0;
    }
    if (em_frag("\tsub\tsp, sp, #") != 0) { return -1; }
    if (em_puti(bytes) != 0) { return -1; }
    return em_frag("\n");
}

// em_call_stack_store：x9 写入调用点栈区第 off 字节（8 的倍数；sp 保持对齐）。
pub fn em_call_stack_store(off int) int {
    if (em_frag("\tstr\tx9, [sp, #") != 0) { return -1; }
    if (em_puti(off) != 0) { return -1; }
    return em_frag("]\n");
}

// em_call_stack_store_fp：浮点寄存器（sfx = "s"/"d"）写入调用点栈区第 off 字节。
pub fn em_call_stack_store_fp(sfx *char, off int) int {
    if (em_frag("\tstr\t") != 0) { return -1; }
    if (em_frag(sfx) != 0) { return -1; }
    if (em_frag("0, [sp, #") != 0) { return -1; }
    if (em_puti(off) != 0) { return -1; }
    return em_frag("]\n");
}

// ---- 数据段发射 ----

// hexval：单个十六进制字符 → 数值。
pub fn hexval(b u8) int {
    if (b >= '0' && b <= '9') {
        return (b - '0').to_type(int);
    }
    if (b >= 'a' && b <= 'f') {
        return ((b - 'a') + 10).to_type(int);
    }
    return ((b - 'A') + 10).to_type(int);
}

// dat_puthex：以 0x 十六进制输出 i64 位型值（任意宽度数据单元通用）。
pub fn dat_puthex(v i64) int {
    let digits [16]u8;
    let i int = 0;
    for i < 16 {
        digits[i] = '0';
        i += 1;
    }
    let hv u64 = 0;
    if (v < 0) {
        hv = v.to_type(u64);
    } else {
        hv = v.to_type(u64);
    }
    let pos int = 15;
    for pos >= 0 {
        let d int = (hv & 0xF).to_type(int);
        let ch u8 = '0';
        if (d < 10) {
            ch = (d + 48).to_type(u8);
        } else {
            ch = ((d - 10) + 97).to_type(u8);
        }
        digits[pos] = ch;
        hv = hv >> 4;
        pos -= 1;
    }
    if (dat_puts("0x") != 0) { return -1; }
    i = 0;
    for i < 16 {
        if (dat_put(digits[i]) != 0) { return -1; }
        i += 1;
    }
    return 0;
}

// em_data_string：解码字符串字面量写入 .data（NUL 结尾），返回标签号。
// 数据标签用独立前缀 .LD 与独立计数器，避免与代码标签同名冲突。
pub fn em_data_string(start int, slen int) int {
    let lbl int = c_data_n;
    c_data_n += 1;
    return em_data_string_body(start, slen, lbl);
}

// em_data_string_body：以预分配标签号发射字符串内容（.LD<lbl>: + 逐字节
// .byte）。供 em_data_string 与全局聚合初始化（先领号发指针引用、后补
// 内容，保证变量数据布局不被字符串内容打断）共用。
pub fn em_data_string_body(start int, slen int, lbl int) int {
    if (dat_puts(".LD") != 0) { return -1; }
    if (dat_puti(lbl) != 0) { return -1; }
    if (dat_put(':') != 0) { return -1; }
    if (dat_put('\n') != 0) { return -1; }
    let i int = start + 1;
    let end int = start + slen - 1;
    for i < end {
        let b u8 = c_src[i];
        if (b == '\\') {
            let e u8 = c_src[i + 1];
            let out int = 0;
            if (e == 'n') { out = 10; }
            if (e == 'r') { out = 13; }
            if (e == 't') { out = 9; }
            if (e == '0') { out = 0; }
            if (e == 'a') { out = 7; }
            if (e == 'b') { out = 8; }
            if (e == 'f') { out = 12; }
            if (e == 'v') { out = 11; }
            if (e == '\'') { out = 39; }
            if (e == '"') { out = 34; }
            if (e == '\\') { out = 92; }
            if (e == 'x') {
                out = hexval(c_src[i + 2]) * 16 + hexval(c_src[i + 3]);
                i += 4;
            } else {
                i += 2;
            }
            if (dat_puts(".byte\t") != 0) { return -1; }
            if (dat_puthex(out.to_type(i64)) != 0) { return -1; }
            if (dat_put('\n') != 0) { return -1; }
            continue;
        }
        i += 1;
        if (dat_puts(".byte\t") != 0) { return -1; }
        if (dat_puthex(b.to_type(i64)) != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
    }
    if (dat_puts(".byte\t0\n") != 0) {
        return -1;
    }
    return lbl;
}

// em_data_scalar：常量值按类型写入 .data。
pub fn em_data_scalar(tid int, v i64) int {
    let size int = t_types[tid].size;
    let unit *char = ".byte\t";
    if (size == 8) { unit = ".xword\t"; }
    if (size == 4) { unit = ".word\t"; }
    if (size == 2) { unit = ".hword\t"; }
    if (dat_puts(unit) != 0) { return -1; }
    if (dat_puthex(v) != 0) { return -1; }
    return dat_put('\n');
}

// em_data_symbol_header：全局数据符号头（.data 段内：对齐 + pub + 标签）。
pub fn em_data_symbol_header(idx int, align int) int {
    if (dat_puts(".balign\t") != 0) { return -1; }
    if (dat_puti(align) != 0) { return -1; }
    if (dat_put('\n') != 0) { return -1; }
    if ((c_syms[idx].flags & F_PUB) != 0) {
        if (dat_puts(".globl\t") != 0) { return -1; }
        if (dat_put_sym_name(idx) != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
    }
    if (dat_put_sym_name(idx) != 0) { return -1; }
    return dat_puts(":\n");
}

// bss_put_sym_name：.bss 缓冲输出符号名（Darwin 加 "_" 前缀）。
pub fn bss_put_sym_name(idx int) int {
    if (bss_puts(tg_sym_prefix()) != 0) { return -1; }
    let n int = c_syms[idx].name_len;
    let off int = c_syms[idx].name_off;
    let i int = 0;
    for i < n {
        if (bss_put(np_data[off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return bss_sym_qualify(idx);
}

// em_bss_symbol：.bss 输出零初始化全局（.balign + 标签 + .skip size）。
pub fn em_bss_symbol(idx int, size int, align int) int {
    if (bss_puts(".balign\t") != 0) { return -1; }
    if (bss_puti(align) != 0) { return -1; }
    if (bss_put('\n') != 0) { return -1; }
    if ((c_syms[idx].flags & F_PUB) != 0) {
        if (bss_puts(".globl\t") != 0) { return -1; }
        if (bss_put_sym_name(idx) != 0) { return -1; }
        if (bss_put('\n') != 0) { return -1; }
    }
    if (bss_put_sym_name(idx) != 0) { return -1; }
    if (bss_puts(":\n.skip\t") != 0) { return -1; }
    if (bss_puti(size) != 0) { return -1; }
    return bss_put('\n');
}

// ============================================================================
// sem_value.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_res_reset(r *Res, tid int) int {
    r.type_id = tid;
    r.is_const = 0;
    r.ival = 0;
    r.sym = -1;
    r.is_lit = 0;
    r.lit_big = 0;
    r.fval_bits = 0;
    return 0;
}

pub fn sem_res_const(r *Res, tid int, v i64) int {
    r.type_id = tid;
    r.is_const = 1;
    r.ival = v;
    r.sym = -1;
    r.is_lit = 0;
    r.lit_big = 0;
    return 0;
}

pub fn sem_res_copy(dst *Res, src *Res) int {
    dst.type_id = src.type_id;
    dst.is_const = src.is_const;
    dst.ival = src.ival;
    dst.sym = src.sym;
    dst.is_lit = src.is_lit;
    dst.lit_big = src.lit_big;
    dst.fval_bits = src.fval_bits;
    return 0;
}

pub fn sem_number(start int, n int, r *Res) int {
    sem_res_reset(r, TY_I32);
    if (c_compile == 0) {
        return 0;
    }
    r.is_lit = 1;
    r.is_const = 1;
    // 浮点字面量（含 '.' 或指数）按 f64 处理
    if (sem_num_is_float(start, n) != 0) {
        r.type_id = TY_F64;
        let bits i64 = sem_parse_float_bits(start, n);
        r.fval_bits = bits;
        if (c_fold == 0) {
            if (em_mov_imm("x0", bits) != 0) { return -1; }
            if (em_ins("fmov\td0, x0") != 0) { return -1; }
        }
        return 0;
    }
    if (sem_parse_number(start, n) != 0) {
        return -1;
    }
    r.ival = c_fold_ival;
    r.lit_big = c_fold_big;
    if (c_fold == 0) {
        // 作为运行时值使用：装入 x0（常量传播留给后续优化）
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn fp64_bits(v f64) i64 {
    let holder *f64 = malloc(8).to_type(*f64);
    holder[0] = v;
    let pb *i64 = holder.to_type(*i64);
    let r i64 = pb[0];
    free(holder.to_type(*void));
    return r;
}

pub fn sem_num_is_float(start int, n int) int {
    let i int = 0;
    for i < n {
        let b u8 = c_src[start + i];
        if (b == '.' || b == 'e' || b == 'E') {
            // 前缀 0x/0o/0b 中的 x/o/b 不算
            return 1;
        }
        i += 1;
    }
    return 0;
}

pub fn sem_parse_float_bits(start int, n int) i64 {
    let i int = start;
    let end int = start + n;
    let mant f64 = 0.0;
    let frac_scale f64 = 1.0;
    let in_frac int = 0;
    let exp int = 0;
    let exp_neg int = 0;
    for i < end {
        let b u8 = c_src[i];
        if (b == '_') {
            i += 1;
            continue;
        }
        if (b >= '0' && b <= '9') {
            if (in_frac == 0) {
                mant = mant * 10.0 + (b - '0').to_type(f64);
            } else {
                frac_scale = frac_scale * 10.0;
                mant = mant + (b - '0').to_type(f64) / frac_scale;
            }
            i += 1;
            continue;
        }
        if (b == '.') {
            in_frac = 1;
            i += 1;
            continue;
        }
        if (b == 'e' || b == 'E') {
            i += 1;
            if (i < end && c_src[i] == '-') {
                exp_neg = 1;
                i += 1;
            } else if (i < end && c_src[i] == '+') {
                i += 1;
            }
            for i < end && c_src[i] >= '0' && c_src[i] <= '9' {
                exp = exp * 10 + (c_src[i] - '0').to_type(int);
                i += 1;
            }
            break;
        }
        i += 1;
    }
    let k int = 0;
    let factor f64 = 1.0;
    for k < exp {
        factor = factor * 10.0;
        k += 1;
    }
    if (exp_neg != 0) {
        mant = mant / factor;
    } else {
        mant = mant * factor;
    }
    return fp64_bits(mant);
}

pub fn sem_string(start int, slen int, r *Res) int {
    sem_res_reset(r, ty_ptr(TY_CHAR));
    if (c_compile == 0) {
        return 0;
    }
    let lbl int = em_data_string(start, slen);
    if (lbl < 0) {
        return -1;
    }
    r.is_const = 1;
    r.ival = lbl.to_type(i64);
    if (c_fold == 0) {
        // 作为值使用：装入字符串地址
        if (em_load_data_label(lbl) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn sem_char(start int, clen int, r *Res) int {
    sem_res_reset(r, TY_CHAR);
    if (c_compile == 0) {
        return 0;
    }
    // 解码单一字符/转义单元（start+1 起）
    let b u8 = c_src[start + 1];
    let v int = b.to_type(int);
    if (b == '\\') {
        let e u8 = c_src[start + 2];
        v = 0;
        if (e == 'n') { v = 10; }
        if (e == 'r') { v = 13; }
        if (e == 't') { v = 9; }
        if (e == '0') { v = 0; }
        if (e == 'a') { v = 7; }
        if (e == 'b') { v = 8; }
        if (e == 'f') { v = 12; }
        if (e == 'v') { v = 11; }
        if (e == '\'') { v = 39; }
        if (e == '"') { v = 34; }
        if (e == '\\') { v = 92; }
        if (e == 'x') {
            v = hexval(c_src[start + 3]) * 16 + hexval(c_src[start + 4]);
        }
    }
    r.is_const = 1;
    r.is_lit = 1;
    r.ival = v.to_type(i64);
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn sem_bool(v int, r *Res) int {
    sem_res_const(r, TY_BOOL, v.to_type(i64));
    if (c_compile == 0) {
        return 0;
    }
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn sem_ident(start int, n int, r *Res) int {
    sem_res_reset(r, 0);
    if (c_compile == 0) {
        return 0;
    }
    let idx int = sym_lookup(start, n);
    if (idx < 0) {
        return sem_err("引用了未声明的名字");
    }
    return sem_ident_val(idx, r);
}

pub fn sem_ident_val(idx int, r *Res) int {
    r.sym = idx;
    r.type_id = c_syms[idx].type_id;
    let kind int = c_syms[idx].kind;
    if (kind == SYM_CONST) {
        r.is_const = 1;
        r.ival = c_syms[idx].cval;
        if ((c_syms[idx].flags & F_ADDR) != 0) {
            // 指针常量：值是数据标签
            if (c_fold == 0) {
                if (em_load_data_label(c_syms[idx].cval.to_type(int)) != 0) {
                    return -1;
                }
            }
            return 0;
        }
        if (c_fold == 0) {
            if (em_mov_imm("x0", c_syms[idx].cval) != 0) {
                return -1;
            }
        }
        return 0;
    }
    if (kind == SYM_FN) {
        if (c_fold != 0) {
            return sem_err("函数引用不是编译期常量");
        }
        if (c_lvalue == 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    // 变量
    if (c_fold != 0) {
        return sem_err("变量不是编译期常量");
    }
    let tid int = c_syms[idx].type_id;
    let k int = t_types[tid].kind;
    let global int = ((c_syms[idx].flags & F_GLOBAL) != 0).to_type(int);
    if (k == TY_ARRAY || k == TY_STRUCT || k == TY_UNION || k == TY_SLICE) {
        // 聚合：值语义即地址（数组退化 / 结构体以地址使用）
        if (global != 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        } else {
            if (em_lea_local(c_syms[idx].offset) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    if (c_lvalue != 0) {
        if (global != 0) {
            if (em_lea_global(idx) != 0) {
                return -1;
            }
        } else {
            if (em_lea_local(c_syms[idx].offset) != 0) {
                return -1;
            }
        }
        c_res_is_addr = 1;
        return 0;
    }
    if (ty_is_float(tid) != 0) {
        if (global != 0) {
            if (em_lea_global(idx) != 0) { return -1; }
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (t_types[tid].size == 4) {
                if (em_ins("ldr\ts0, [x10]") != 0) { return -1; }
            } else {
                if (em_ins("ldr\td0, [x10]") != 0) { return -1; }
            }
        } else {
            if (em_fp_load_local(c_syms[idx].offset, tid) != 0) { return -1; }
        }
        c_res_is_addr = 0;
        return 0;
    }
    if (global != 0) {
        if (em_load_global(idx, tid) != 0) {
            return -1;
        }
    } else {
        if (em_load_local(c_syms[idx].offset, tid) != 0) {
            return -1;
        }
    }
    c_res_is_addr = 0;
    return 0;
}


// ============================================================================
// sem_expr.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_push_value(r *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (ty_is_float(r.type_id) != 0) {
        return em_push_fp(r.type_id);
    }
    return em_push();
}

pub fn sem_binop(op int, lhs *Res, rhs *Res) int {
    let tid int = 0;
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    // 运算数检查
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        // 指针只参与 ==/!=（与 0 或同型）
        if (t_types[lhs.type_id].kind == TY_PTR || t_types[rhs.type_id].kind == TY_PTR) {
            if (op != TK_EQEQ && op != TK_NEQ) {
                return sem_err("指针只支持 == / != 比较");
            }
            let ok int = 0;
            if (lhs.type_id == rhs.type_id) { ok = 1; }
            if (t_types[lhs.type_id].elem == TY_VOID) { ok = 1; }
            if (t_types[rhs.type_id].elem == TY_VOID) { ok = 1; }
            if (rhs.is_lit != 0 && rhs.is_const != 0 && rhs.ival == 0) { ok = 1; }
            if (lhs.is_lit != 0 && lhs.is_const != 0 && lhs.ival == 0) { ok = 1; }
            if (ok == 0) {
                return sem_err("指针比较类型不匹配");
            }
            sem_res_const(lhs, TY_BOOL, 0);
            if (c_fold == 0) {
                if (em_pop("x9") != 0) { return -1; }
                if (em_compare(op, TY_I64) != 0) { return -1; }
            }
            c_res_is_addr = 0;
            return 0;
        }
    }
    // 字面量适配：一侧是字面量时借用另一侧类型
    if (rhs.is_lit != 0 && ty_is_scalar(lhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(lhs.type_id, rhs.ival) != 0) {
            rhs.type_id = lhs.type_id;
        }
    }
    if (lhs.is_lit != 0 && ty_is_scalar(rhs.type_id) != 0
        && ty_is_integer(lhs.type_id) != 0 && ty_is_integer(rhs.type_id) != 0) {
        if (sem_lit_fits(rhs.type_id, lhs.ival) != 0) {
            lhs.type_id = rhs.type_id;
        }
    }
    // 指针算术：p + i / p - i（按元素大小缩放下标）；指针比较另走分支
    let lk int = t_types[lhs.type_id].kind;
    let rk int = t_types[rhs.type_id].kind;
    if ((lk == TY_PTR && rk == TY_PTR) || lk == TY_ARRAY || rk == TY_ARRAY) {
        return sem_err("指针/数组不参与该运算");
    }
    if (lk == TY_PTR && ty_is_integer(rhs.type_id) != 0) {
        if (op == TK_PLUS || op == TK_MINUS) {
            if (c_fold != 0) {
                return sem_err("指针运算不是编译期常量");
            }
            if (em_pop("x9") != 0) { return -1; }
            if (em_scale_index(t_types[lhs.type_id].elem) != 0) { return -1; }
            if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
            c_res_is_addr = 1;   // 结果是地址（可再解引用/下标）
            return 0;
        }
        return sem_err("指针只支持 + / - 整数");
    }
    if (rk == TY_PTR && ty_is_integer(lhs.type_id) != 0 && op == TK_PLUS) {
        if (c_fold != 0) {
            return sem_err("指针运算不是编译期常量");
        }
        if (em_pop("x9") != 0) { return -1; }
        // x9 = 整数，x0 = 指针：交换后缩放
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (em_ins("mov\tx0, x9") != 0) { return -1; }
        if (em_ins("mov\tx9, x10") != 0) { return -1; }
        if (em_scale_index(t_types[rhs.type_id].elem) != 0) { return -1; }
        if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
        c_res_is_addr = 1;
        return 0;
    }
    tid = sem_promote(lhs.type_id, rhs.type_id);
    if (ty_is_float(tid) != 0) {
        // 浮点二元/比较：左 d1、右 d0（值栈已按序压入）
        if (c_fold != 0) {
            return sem_err("浮点常量折叠暂不支持");
        }
        let iscmp int = (op == TK_EQEQ || op == TK_NEQ || op == TK_LT
                         || op == TK_LEQ || op == TK_GT || op == TK_GEQ).to_type(int);
        if (op != TK_PLUS && op != TK_MINUS && op != TK_STAR && op != TK_SLASH
            && iscmp == 0) {
            return sem_err("浮点不支持该运算");
        }
        if (iscmp != 0) {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_compare(op, tid) != 0) { return -1; }
            sem_res_const(lhs, TY_BOOL, 0);
        } else {
            if (em_pop_fp(tid, 1) != 0) { return -1; }
            if (em_fp_binop(op, tid) != 0) { return -1; }
            sem_res_reset(lhs, tid);
        }
        lhs.is_const = 0;
        c_res_is_addr = 0;
        return 0;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持算术运算");
    }
    let is_cmp int = 0;
    if (op == TK_EQEQ || op == TK_NEQ || op == TK_LT || op == TK_LEQ
        || op == TK_GT || op == TK_GEQ) {
        is_cmp = 1;
    }
    if (c_fold != 0) {
        if (lhs.is_const == 0 || rhs.is_const == 0) {
            return sem_err("这里需要编译期常量");
        }
        if (is_cmp != 0) {
            let v i64 = fold_binop(op, lhs.ival, rhs.ival);
            sem_res_const(lhs, TY_BOOL, v);
        } else {
            let v2 i64 = fold_binop(op, lhs.ival, rhs.ival);
            sem_res_const(lhs, tid, v2);
        }
        return 0;
    }
    if (is_cmp != 0) {
        if (em_pop("x9") != 0) { return -1; }
        if (em_compare(op, tid) != 0) { return -1; }
        sem_res_const(lhs, TY_BOOL, 0);
    } else {
        if (em_pop("x9") != 0) { return -1; }
        if (em_binop(op, tid) != 0) { return -1; }
        sem_res_reset(lhs, tid);
    }
    lhs.is_const = 0;
    c_res_is_addr = 0;
    return 0;
}

pub fn sem_shortcircuit(op int, lhs *Res) int {
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("逻辑运算不支持编译期折叠");
    }
    // 保存外层短路标签（嵌套 a&&b||c&&d 时内层不破坏外层）
    sc_sc_false_stk[sc_sc_depth] = sc_lbl_false;
    sc_sc_end_stk[sc_sc_depth] = sc_lbl_end;
    sc_sc_depth += 1;
    sc_lbl_false = em_new_label();
    sc_lbl_end = em_new_label();
    if (op == TK_ANDAND) {
        if (em_jz(sc_lbl_false) != 0) { return -1; }
    } else {
        if (em_jnz(sc_lbl_false) != 0) { return -1; }
    }
    sem_res_reset(lhs, TY_BOOL);
    c_res_is_addr = 0;
    return 0;
}

pub fn sem_shortcircuit_end(op int, lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (op == TK_ANDAND) {
        // 左真且右真 → 结果 1
        if (em_jz(sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_jmp(sc_lbl_end) != 0) { return -1; }
        if (em_label(sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_label(sc_lbl_end) != 0) { return -1; }
    } else {
        // || ：左或右为真 → 结果 1
        if (em_jnz(sc_lbl_false) != 0) { return -1; }
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        if (em_jmp(sc_lbl_end) != 0) { return -1; }
        if (em_label(sc_lbl_false) != 0) { return -1; }
        if (em_ins("movz\tx0, #1") != 0) { return -1; }
        if (em_label(sc_lbl_end) != 0) { return -1; }
    }
    lhs.is_const = 0;
    c_res_is_addr = 0;
    // 恢复外层短路标签（嵌套 a&&b||c&&d：内层用完即还）
    sc_sc_depth -= 1;
    sc_lbl_false = sc_sc_false_stk[sc_sc_depth];
    sc_lbl_end = sc_sc_end_stk[sc_sc_depth];
    return 0;
}

pub fn sem_ternary_cond(lhs *Res) int {
    if (c_compile == 0) {
        lhs.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("三元不支持编译期折叠");
    }
    tn_lbl_else = em_new_label();
    tn_lbl_end = em_new_label();
    if (em_jz(tn_lbl_else) != 0) { return -1; }
    return 0;
}

pub fn sem_ternary_mid(lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_jmp(tn_lbl_end) != 0) { return -1; }
    if (em_label(tn_lbl_else) != 0) { return -1; }
    return 0;
}

pub fn sem_ternary_end(lhs *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (em_push() != 0) { return -1; }
    if (em_label(tn_lbl_end) != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    c_res_is_addr = 0;
    return 0;
}

pub fn sem_unary(op int, operand *Res) int {
    if (c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    if (op == TK_STAR) {
        if (t_types[operand.type_id].kind != TY_PTR) {
            return sem_err("解引用的操作数必须是指针");
        }
        if (c_lvalue == 0 && c_fold == 0) {
            // x0 = 指针值（地址）→ 装入点值
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(t_types[operand.type_id].elem) != 0) { return -1; }
        }
        c_res_is_addr = 1;
        sem_res_reset(operand, t_types[operand.type_id].elem);
        operand.is_const = 0;
        return 0;
    }
    if (op == TK_AMP) {
        if (c_res_is_addr == 0) {
            return sem_err("取地址的操作数必须是左值");
        }
        let pt int = ty_ptr(operand.type_id);
        sem_res_reset(operand, pt);
        c_res_is_addr = 1;
        return 0;
    }
    if (operand.is_const != 0) {
        // 常量（含字面量）：折叠求值并保留字面量性（如 let n i8 = -100）
        operand.ival = fold_unary(op, operand.ival);
        operand.type_id = TY_I32;
        if (c_fold == 0) {
            if (em_mov_imm("x0", operand.ival) != 0) {
                return -1;
            }
        }
        return 0;
    }
    let tid int = operand.type_id;
    if (ty_is_float(tid) != 0) {
        if (op == TK_MINUS) {
            if (em_fp_neg(tid) != 0) { return -1; }
            sem_res_reset(operand, tid);
            c_res_is_addr = 0;
            return 0;
        }
        if (op == TK_PLUS) {
            return 0;
        }
        return sem_err("浮点只支持一元 +/-");
    }
    if (t_types[tid].kind == TY_BOOL) {
        tid = TY_I32;
    }
    if (ty_is_scalar(tid) == 0) {
        return sem_err("该类型不支持一元运算");
    }
    if (em_unary(op, tid) != 0) { return -1; }
    sem_res_reset(operand, tid);
    c_res_is_addr = 0;
    return 0;
}

pub fn sem_index(base *Res, idx *Res) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (ty_is_integer(idx.type_id) == 0) {
        return sem_err("下标必须是整数");
    }
    let bk int = t_types[base.type_id].kind;
    let elem int = 0;
    if (bk == TY_PTR) {
        elem = t_types[base.type_id].elem;
    } else if (bk == TY_ARRAY) {
        elem = t_types[base.type_id].elem;
    } else if (bk == TY_SLICE) {
        elem = t_types[base.type_id].elem;
    } else {
        return sem_err("该类型不支持下标访问");
    }
    if (c_fold != 0) {
        return sem_err("下标访问不是编译期常量");
    }
    if (em_pop("x9") != 0) { return -1; }
    // lvalue 模式下指针变量的基址是「变量的地址」——先装入指针值
    if (bk == TY_PTR && c_lvalue != 0) {
        if (em_ins("mov\tx10, x9") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
    }
    // 切片：基址是切片数据指针（槽内偏移 8），需先取 data 字段
    if (bk == TY_SLICE) {
        if (em_ins("add\tx9, x9, #8") != 0) { return -1; }
        if (em_ins("ldr\tx9, [x9]") != 0) { return -1; }
    }
    // 地址 = 基址(x9) + 下标(x0) * 元素大小
    let esz int = t_types[elem].size;
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        // 任意大小的聚合元素（如 20 字节的 Tok）：乘法缩放
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
    let ek int = t_types[elem].kind;
    if (ek == TY_STRUCT || ek == TY_UNION || ek == TY_ARRAY || ek == TY_SLICE) {
        // 聚合元素：保留地址语义（成员/下标链后续再加偏移）
        c_res_is_addr = 1;
    } else if (c_lvalue == 0) {
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        if (ty_is_float(elem) != 0) {
            // 浮点元素：装入浮点寄存器
            let fsfx *char = "d";
            if (t_types[elem].size == 4) { fsfx = "s"; }
            if (em_frag("\tldr\t") != 0) { return -1; }
            if (em_frag(fsfx) != 0) { return -1; }
            if (em_frag("0, [x10]\n") != 0) { return -1; }
        } else {
            if (em_load_sized(elem) != 0) { return -1; }
        }
        c_res_is_addr = 0;
    } else {
        c_res_is_addr = 1;
    }
    sem_res_reset(base, elem);
    return 0;
}

pub fn sem_slice(base *Res, sres *Res, eres *Res) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("切片表达式不是编译期常量");
    }
    let bk int = t_types[base.type_id].kind;
    if (bk != TY_ARRAY && bk != TY_SLICE) {
        return sem_err("切片表达式需要数组或切片");
    }
    if (ty_is_integer(sres.type_id) == 0 || ty_is_integer(eres.type_id) == 0) {
        return sem_err("切片下标必须是整数");
    }
    let elem int = t_types[base.type_id].elem;
    let esz int = t_types[elem].size;
    // x0 = end → x11 暂存；弹 start → x0；弹 base → x10
    if (em_ins("mov\tx11, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_pop("x10") != 0) { return -1; }
    // 切片基址取 data 字段（{len, data} 的偏移 8）
    if (bk == TY_SLICE) {
        if (em_ins("add\tx10, x10, #8") != 0) { return -1; }
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
    }
    // x9 = max(0, end - start)
    if (em_ins("sub\tx9, x11, x0") != 0) { return -1; }
    let l_pos int = em_new_label();
    if (em_frag("\tcmp\tx9, xzr\n\tb.gt\t") != 0) { return -1; }
    if (em_put_lbl(l_pos) != 0) { return -1; }
    if (em_frag("\n\tmov\tx9, xzr\n") != 0) { return -1; }
    if (em_label(l_pos) != 0) { return -1; }
    // x0 = start * 元素大小
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        if (em_mov_imm("x11", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x11") != 0) { return -1; }
    }
    // x0 = 数据指针 = 基址 + start*esz
    if (em_ins("add\tx0, x10, x0") != 0) { return -1; }
    // 构造 {len, data} 临时切片
    let soff int = em_alloc_local(TG_LONG_SIZE * 2);
    if (em_lea_local_to(soff) != 0) { return -1; }
    if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
    if (em_lea_local_down(soff) != 0) { return -1; }
    base.type_id = ty_slice(elem);
    base.is_lit = 0;
    base.is_const = 0;
    c_res_is_addr = 1;
    return 0;
}

pub fn sem_member(base *Res, name_start int, name_len int) int {
    if (c_compile == 0) {
        base.type_id = 0;
        return 0;
    }
    let bk int = t_types[base.type_id].kind;
    let stid int = 0;
    if (bk == TY_PTR) {
        stid = t_types[base.type_id].elem;
        if (t_types[stid].kind != TY_STRUCT && t_types[stid].kind != TY_UNION) {
            return sem_err("『.』的左侧不是结构体或结构体指针");
        }
    } else if (bk == TY_STRUCT || bk == TY_UNION) {
        stid = base.type_id;
    } else {
        return sem_err("『.』的左侧不是结构体或结构体指针");
    }
    // 字段查找
    let st int = t_types[stid].sub;
    let nf int = t_types[stid].len;
    let found int = -1;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (t_fields[f].name_len == name_len) {
            let match int = 1;
            let j int = 0;
            for j < name_len {
                if (np_data[t_fields[f].name_off + j] != c_src[name_start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = f;
                break;
            }
        }
        i += 1;
    }
    if (found < 0) {
        return sem_err("结构体没有该字段");
    }
    // 跨模块 pub 检查（U3）：外部模块类型的私有字段不可访问
    if (c_module_mode != 0 && t_home[stid] >= 0 && t_fields[found].is_pub == 0) {
        return sem_err("跨模块不能访问私有字段（声明处未加 pub）");
    }
    if (c_fold != 0) {
        return sem_err("字段访问不是编译期常量");
    }
    let off int = t_fields[found].offset;
    if (bk == TY_PTR) {
        if (c_lvalue != 0) {
            // x0 = 指针变量的地址 → 装入指针值
            if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        }
        // x0 = 结构体地址；加字段偏移
    }
    if (off > 0) {
        if (em_frag("\tadd\tx0, x0, #") != 0) { return -1; }
        if (em_puti(off) != 0) { return -1; }
        if (em_frag("\n") != 0) { return -1; }
    }
    let ftid int = t_fields[found].type_id;
    if (c_lvalue == 0) {
        let fk int = t_types[ftid].kind;
        if (fk != TY_STRUCT && fk != TY_UNION && fk != TY_ARRAY && fk != TY_SLICE) {
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(ftid) != 0) { return -1; }
            c_res_is_addr = 0;
        } else {
            // 聚合字段：保持地址语义
            c_res_is_addr = 1;
        }
    } else {
        c_res_is_addr = 1;
    }
    sem_res_reset(base, ftid);
    return 0;
}

pub fn sem_sizeof(tid int, r *Res) int {
    sem_res_reset(r, TY_I32);
    if (c_compile == 0) {
        return 0;
    }
    r.is_const = 1;
    r.is_lit = 0;
    r.ival = t_types[tid].size.to_type(i64);
    if (c_fold == 0) {
        if (em_mov_imm("x0", r.ival) != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn sem_len(r *Res) int {
    if (c_compile == 0) {
        r.type_id = 0;
        return 0;
    }
    let k int = t_types[r.type_id].kind;
    if (k == TY_ARRAY) {
        // 编译期折叠为常量并直接装 x0（同 sem_sizeof：折叠出的常量由
        // 这里物化，消费端不负责）。必须清 c_res_is_addr——实参（数组
        // 标识符）的聚合地址语义会残留，否则 x0 里的数组地址被当成
        // 结果（曾致 return len(arr) 返回地址而非长度）。
        c_res_is_addr = 0;
        sem_res_const(r, TY_I32, t_types[r.type_id].len.to_type(i64));
        if (c_fold == 0) {
            return em_mov_imm("x0", r.ival);
        }
        return 0;
    }
    if (k == TY_SLICE) {
        if (c_fold != 0) {
            return sem_err("切片长度不是编译期常量");
        }
        // 切片值在 x0（地址）；读 [x0] 的长度
        if (em_ins("ldr\tx0, [x0]") != 0) { return -1; }
        sem_res_reset(r, TY_I32);
        c_res_is_addr = 0;
        return 0;
    }
    return sem_err("len 需要一个数组或切片");
}

pub fn sem_cast(operand *Res, tid int) int {
    if (c_compile == 0) {
        operand.type_id = 0;
        return 0;
    }
    let ok int = t_types[tid].kind;
    if (ok == TY_VOID) {
        return sem_err("不能转换为 void");
    }
    let sk int = t_types[operand.type_id].kind;
    let scalar_to_scalar int = 0;
    if (ty_is_scalar(tid) != 0 && ty_is_scalar(operand.type_id) != 0) {
        scalar_to_scalar = 1;
    }
    // 数组 → 切片视图：构造 {len, data} 临时聚合（ADR-0002 的规范化视图）
    if (sk == TY_ARRAY && ok == TY_SLICE) {
        if (t_types[operand.type_id].elem != t_types[tid].elem) {
            return sem_err("数组元素类型与目标切片不一致");
        }
        if (c_fold != 0) {
            return sem_err("数组转切片不是编译期常量");
        }
        let arrlen int = t_types[operand.type_id].len;
        // x0 = 数组地址（数组值即地址）
        let soff int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(soff) != 0) { return -1; }
        if (em_mov_imm("x9", arrlen.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(soff) != 0) { return -1; }
        operand.type_id = tid;
        operand.is_lit = 0;
        operand.is_const = 0;
        c_res_is_addr = 1;
        return 0;
    }
    if (scalar_to_scalar == 0) {
        return sem_err("该转换不支持（标量之间或指针/整数）");
    }
    if (c_fold == 0 && c_res_is_addr == 0) {
        // 运行时转换
        let from_fp int = ty_is_float(operand.type_id);
        let to_fp int = ty_is_float(tid);
        if (to_fp != 0 && from_fp == 0) {
            let src_signed int = ty_is_signed(operand.type_id);
            if (em_int_to_fp(tid, src_signed) != 0) { return -1; }
        } else if (to_fp != 0 && from_fp != 0) {
            // 浮点宽度转换：f32<->f64（d0/s0 互转）
            if (t_types[operand.type_id].size != t_types[tid].size) {
                if (t_types[tid].size == 4) {
                    if (em_ins("fcvt\ts0, d0") != 0) { return -1; }
                } else {
                    if (em_ins("fcvt\td0, s0") != 0) { return -1; }
                }
            }
        } else if (to_fp == 0 && from_fp != 0) {
            let dst_signed int = ty_is_signed(tid);
            if (em_fp_to_int(operand.type_id, dst_signed) != 0) { return -1; }
        } else if (t_types[operand.type_id].size != t_types[tid].size
                   || ty_is_signed(operand.type_id) != ty_is_signed(tid)) {
            // 整数 → 整数：x0 中按源类型已扩展，需按目标宽度/符号性重新扩展。
            // 例如 i64 → int 必须截断到低 32 位并符号扩展，否则比较/运算会用
            // 到高位的残留值（曾导致 i64 的 int 视图比较结果错误）。
            let tsz int = t_types[tid].size;
            if (ty_is_signed(tid) != 0) {
                if (tsz == 4) {
                    if (em_ins("sxtw\tx0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("sxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("sxtb\tx0, w0") != 0) { return -1; }
                }
            } else {
                if (tsz == 4) {
                    // 零扩展：写 w0 即清零高 32 位
                    if (em_ins("mov\tw0, w0") != 0) { return -1; }
                } else if (tsz == 2) {
                    if (em_ins("uxth\tx0, w0") != 0) { return -1; }
                } else if (tsz == 1) {
                    if (em_ins("uxtb\tx0, w0") != 0) { return -1; }
                }
            }
        }
        // 其余整数→整数（更宽或同宽同符号）已在 x0 中正确扩展，无需发码。
    }
    operand.type_id = tid;
    operand.is_lit = 0;
    c_res_is_addr = 0;
    return 0;
}


// ============================================================================
// sem_call_literal.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_call_begin(callee *Res) int {
    if (c_compile == 0) {
        return 1;
    }
    // 嵌套调用：记录本层实参基线与直接调用标志（内层不污染外层）
    if (c_call_depth >= 64) {
        return sem_err("调用嵌套过深");
    }
    c_call_base[c_call_depth] = c_arg_n;
    c_call_direct[c_call_depth] = 0;
    c_call_depth += 1;
    if (callee.sym >= 0) {
        if (c_syms[callee.sym].kind == SYM_FN) {
            c_call_direct[c_call_depth - 1] = 1;
            return 1;
        }
    }
    if (c_fold != 0) {
        return sem_err("函数调用不是编译期常量");
    }
    if (em_push() != 0) { return -1; }
    return 0;
}

pub fn sem_push_arg(r *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_arg_n >= 256) {
        return sem_err("实参过多");
    }
    sem_res_copy(&c_args[c_arg_n], r);
    c_argtys[c_arg_n] = r.type_id;
    c_arg_n += 1;
    if (c_fold != 0) {
        return 0;
    }
    return sem_push_value(r);
}

pub fn sem_call(callee *Res, r *Res) int {
    if (c_compile == 0) {
        sem_res_reset(r, 0);
        return 0;
    }
    if (t_types[callee.type_id].kind != TY_FN) {
        return sem_err("被调用的表达式不是函数");
    }
    c_call_depth -= 1;
    let base int = c_call_base[c_call_depth];
    let direct int = c_call_direct[c_call_depth];
    let sig int = t_types[callee.type_id].sub;
    let np int = t_sig_np[sig];
    let vararg int = t_sig_vararg[sig];
    let ret int = t_sig_ret[sig];
    let na int = c_arg_n - base;
    // vararg==2：类型化变参（末尾打包为切片）；==1：裸 C 变参（仅 prelude）
    if (vararg == 2) {
        if (na < np) {
            return sem_err("实参个数少于固定参数");
        }
    } else if (na < np || (na > np && vararg == 0)) {
        return sem_err("实参个数与函数签名不符");
    }
    // 实参类型检查
    let first int = t_sig_first[sig];
    let i int = 0;
    for i < na {
        let want int = 0;
        if (i < np) {
            want = t_sig_params[first + i];
        } else {
            want = -1;
        }
        if (want >= 0) {
            // 数组实参按指针形参退化
            let wat int = c_args[base + i].type_id;
            if (t_types[wat].kind == TY_ARRAY && t_types[want].kind == TY_PTR) {
                if (t_types[wat].elem != t_types[want].elem && t_types[want].elem != TY_VOID) {
                    return sem_err("数组元素类型与指针形参不匹配");
                }
                i += 1;
                continue;
            }
            // 切片实参按切片形参（同元素类型；长度不参与相容判断）
            if (t_types[wat].kind == TY_SLICE && t_types[want].kind == TY_SLICE) {
                if (t_types[wat].elem != t_types[want].elem && t_types[want].elem != TY_VOID) {
                    return sem_err("切片元素类型不匹配");
                }
                i += 1;
                continue;
            }
            if (sem_can_assign(want, wat, c_args[base + i].is_lit, c_args[base + i].ival, c_args[base + i].lit_big) != 0) {
                return -1;
            }
        } else if (vararg == 2) {
            // 类型化变参：尾部实参类型须与元素类型相容
            let velem_t int = t_types[t_sig_params[first + np]].elem;
            if (sem_can_assign(velem_t, c_args[base + i].type_id, c_args[base + i].is_lit, c_args[base + i].ival, c_args[base + i].lit_big) != 0) {
                return -1;
            }
        } else {
            // 裸变参位置：整数/指针按 C 提升进寄存器
            let at2 int = c_args[base + i].type_id;
            let k2 int = t_types[at2].kind;
            if (ty_is_float(at2) != 0) {
                return sem_err("裸变参的浮点实参将在 B7 支持");
            }
            if (k2 == TY_STRUCT || k2 == TY_UNION || k2 == TY_ARRAY || k2 == TY_SLICE) {
                return sem_err("聚合类型不能传给裸变参");
            }
        }
        i += 1;
    }
    if (c_fold != 0) {
        return sem_err("函数调用不是编译期常量");
    }
    // 类型化变参：把尾部实参（已逐个压栈）打包为一个切片参数
    let na2 int = na;
    if (vararg == 2) {
        let velem int = t_types[t_sig_params[first + np]].elem;
        let vslice int = t_sig_params[first + np];
        let vcount int = na - np;
        // 值栈上从底到顶依次是 a0..a_{na-1}；尾部 vcount 个是变参。
        // 先把尾部逐个弹出写入临时数组（逆序弹出，正序写入）。
        let esz int = t_types[velem].size;
        let arr_off int = em_alloc_local(esz * vcount);
        // 值栈顶是最后一个实参：逐个弹出并按倒序写入数组（元素 0 在最低地址）
        let vi int = vcount - 1;
        for vi >= 0 {
            // 浮点实参在 FP 栈（em_push_fp 压入），弹出与存储都走 d0/s0
            if (ty_is_float(velem) != 0) {
                let vfx *char = "d";
                if (esz == 4) { vfx = "s"; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(vfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_lea_local_to(arr_off - vi * esz) != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(vfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
                vi -= 1;
                continue;
            }
            if (em_pop("x0") != 0) { return -1; }
            // 元素 vi 的地址：向下偏移 = arr_off - vi*esz
            if (em_lea_local_to(arr_off - vi * esz) != 0) { return -1; }
            if (em_store_sized(velem) != 0) { return -1; }
            vi -= 1;
        }
        // 构造切片 {len, data} 于临时槽
        let sl_off int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(sl_off) != 0) { return -1; }
        if (em_mov_imm("x9", vcount.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_lea_local_down(arr_off) != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(sl_off) != 0) { return -1; }
        if (em_push() != 0) { return -1; }
        na2 = np + 1;
    }
    // 发射：栈实参 → 寄存器实参 → callee → bl/blr → 清理
    // Darwin 变参约定（Mach-O/AAPCS 变体）：裸 C 变参函数（prelude 的
    // printf/open，vararg==1）的**可变部分一律按 8 字节对齐放在栈上**
    // （[sp+0], [sp+8], …），不占用 x1..x7；命名参数照常进寄存器。
    // 与 stage0（src/targets/arm64-gen.c 的 arm64_pcs_aux）保持一致。
    let darwin_var int = 0;
    if (tg_darwin() != 0 && vararg == 1 && na2 > np) {
        darwin_var = 1;
    }
    let nstack int = 0;
    if (darwin_var != 0) {
        // 命名参数之外的实参全部走栈
        nstack = na2 - np;
    } else if (na2 > TG_ARG_REGS) {
        nstack = na2 - TG_ARG_REGS;
    }
    // 栈实参搬运（两段式）：值栈顶是最后一个实参，栈实参恰为顶部
    // nstack 项。第一段：弹入帧内暂存槽（fp 负偏移固定槽，不受值栈
    // 弹压影响）；第二段在寄存器实参装载完成后、bl 之前回压进调用点
    // 栈区（8 字节间距 = AAPCS64 与 stage0，被调方按
    // [fp+16+(k-8)*8] 读取）。不能先 sub sp 开区再弹：弹到的是栈区
    // 槽而非实参；也不能边弹边压：寄存器装载的弹栈会把已压栈区弹穿
    // （2026-09-29 参数错位缺陷，被加法交换律语料掩盖）。
    let area_bytes int = (nstack * 8 + 15) / 16 * 16;
    let stk_off int = 0;
    if (nstack > 0) {
        stk_off = em_alloc_local(8 * nstack);
        let stk_lo int = na2 - nstack;
        let saj int = na2 - 1;
        for saj >= stk_lo {
            let rel int = 8 * (saj - stk_lo);
            if (ty_is_float(c_args[base + saj].type_id) != 0) {
                // 浮点实参值在浮点通路（sem_push_value → em_push_fp），
                // 弹出须走浮点寄存器
                let fsfx *char = "d";
                if (t_types[c_args[base + saj].type_id].size == 4) {
                    fsfx = "s";
                }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_lea_local_to(stk_off - rel) != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
            } else {
                // 弹到 x11：em_lea_local_to 偏移超 255 时用 movz x9 拼址，
                // 会覆盖 x9（2026-09-29 深帧下暂存槽写入立即数的根因）
                if (em_pop("x11") != 0) { return -1; }
                if (em_lea_local_to(stk_off - rel) != 0) { return -1; }
                if (em_ins("str\tx11, [x10]") != 0) { return -1; }
            }
            saj -= 1;
        }
    }
    // 寄存器实参：整型 a8→x7…a1→x0；浮点独立计数进 d0..d7
    // 注意：值栈顶是最后一个实参，浮点与整型需分别按各自序号搬运。
    // 这里按「从后往前」弹出：先整型（逆序到 x7..x0），再浮点。
    // 由于浮点与整型寄存器独立，正确做法是先按顺序取各自第 k 个。
    // 简化且正确的实现：逐个弹出到临时数组，再按类型分配到寄存器。
    // —— 为控制改动面，这里要求「浮点实参全部位于尾部」时用专用路径。
    // 进寄存器的实参个数：Darwin 变参时只有命名参数进寄存器，可变部分已上栈。
    let regn int = na2;
    if (darwin_var != 0) {
        regn = np;
    }
    // 计算寄存器实参中的浮点个数
    let nfp int = 0;
    let k int = base;
    for k < base + regn {
        if (ty_is_float(c_args[k].type_id) != 0) {
            nfp += 1;
        }
        k += 1;
    }
    if (nfp == 0) {
        let j int = TG_ARG_REGS - 1;
        for j >= 0 {
            if (j < regn) {
                if (em_call_arg_to_reg(j) != 0) { return -1; }
            }
            j -= 1;
        }
    } else {
        // 混合：弹出到临时槽（逆序），再按各自序号装寄存器。
        // 浮点实参压栈时值在 d0，弹出必须按元素类型选 x0 或 d0。
        let tmp_off int = em_alloc_local(16 * regn);
        let tb int = regn - 1;
        for tb >= 0 {
            if (em_lea_local_to(tmp_off - 16 * tb) != 0) { return -1; }
            if (ty_is_float(c_args[base + tb].type_id) != 0) {
                let psfx *char = "d";
                if (t_types[c_args[base + tb].type_id].size == 4) { psfx = "s"; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(psfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(psfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
            } else {
                if (em_pop("x0") != 0) { return -1; }
                if (em_ins("str\tx0, [x10]") != 0) { return -1; }
            }
            tb -= 1;
        }
        let xi int = 0;
        let di int = 0;
        let tf int = 0;
        for tf < regn {
            let at int = c_args[base + tf].type_id;
            if (ty_is_float(at) != 0) {
                if (di < TG_ARG_REGS) {
                    let fsuffix *char = "d";
                    if (t_types[at].size == 4) { fsuffix = "s"; }
                    if (em_lea_local_to(tmp_off - 16 * tf) != 0) { return -1; }
                    if (em_frag("\tldr\t") != 0) { return -1; }
                    if (em_frag(fsuffix) != 0) { return -1; }
                    if (em_puti(di) != 0) { return -1; }
                    if (em_frag(", [x10]\n") != 0) { return -1; }
                }
                di += 1;
            } else {
                if (xi < TG_ARG_REGS) {
                    if (em_lea_local_to(tmp_off - 16 * tf) != 0) { return -1; }
                    if (em_frag("\tldr\t") != 0) { return -1; }
                    if (em_frag(em_spill_reg_name(xi)) != 0) { return -1; }
                    if (em_frag(", [x10]\n") != 0) { return -1; }
                }
                xi += 1;
            }
            tf += 1;
        }
    }
    // 间接调用的目标地址在值栈顶：必须在开调用点栈区之前弹出（否则弹到
    // 栈区槽而非实参），暂存帧内槽，bl 前再装回 x10。
    let callee_off int = 0;
    if (direct == 0) {
        callee_off = em_alloc_local(TG_PTR_SIZE);
        if (em_pop("x9") != 0) { return -1; }
        if (em_lea_local_to(callee_off) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    }
    // 栈实参第二段：bl 之前把暂存槽写进调用点栈区。整块开区（area_bytes
    // 为 16 的倍数，sp 全程保持 16 字节对齐）后按 8 字节偏移写入——第 9 参
    // （Darwin 变参为第一个可变实参）在 [sp+0]，其后每参 +8，与 AAPCS64 及
    // stage0（arm64-gen.c 的 C.14：size < 8 补足 8 字节槽）一致。写入用
    // x9/d0 中转，不碰已装载的 x0..x7/d0..d7。
    if (nstack > 0) {
        if (em_call_stack_alloc(area_bytes) != 0) { return -1; }
        let stk_lo2 int = na2 - nstack;
        let pb int = na2 - 1;
        for pb >= stk_lo2 {
            let rel2 int = 8 * (pb - stk_lo2);
            if (ty_is_float(c_args[base + pb].type_id) != 0) {
                let pfsfx *char = "d";
                if (t_types[c_args[base + pb].type_id].size == 4) {
                    pfsfx = "s";
                }
                if (em_lea_local_to(stk_off - rel2) != 0) { return -1; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(pfsfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
                if (em_call_stack_store_fp(pfsfx, rel2) != 0) { return -1; }
            } else {
                if (em_lea_local_to(stk_off - rel2) != 0) { return -1; }
                if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
                if (em_call_stack_store(rel2) != 0) { return -1; }
            }
            pb -= 1;
        }
    }
    // 聚合返回：把调用方缓冲地址放进 x8（隐藏返回指针，AAPCS64）
    let retk int = t_types[ret].kind;
    if (retk == TY_STRUCT || retk == TY_UNION || retk == TY_ARRAY || retk == TY_SLICE) {
        // 经 x10 中转，避免覆盖已搬运到 x0..x7 的实参
        let buf int = em_alloc_local(t_types[ret].size);
        if (em_lea_local_to(buf) != 0) { return -1; }
        if (em_ins("mov\tx8, x10") != 0) { return -1; }
        c_ret_tmp_off = buf;
    }
    if (direct != 0) {
        if (em_call_direct(callee.sym) != 0) { return -1; }
    } else {
        if (em_lea_local_to(callee_off) != 0) { return -1; }
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        if (em_call_indirect() != 0) { return -1; }
    }
    if (em_call_cleanup_bytes(area_bytes) != 0) { return -1; }
    c_arg_n = base;
    sem_res_reset(r, ret);
    if (ty_is_float(ret) != 0) {
        // 浮点返回已在 d0/s0
        c_res_is_addr = 0;
        return 0;
    }
    if (retk == TY_STRUCT || retk == TY_UNION || retk == TY_ARRAY || retk == TY_SLICE) {
        // 聚合返回：结果地址 = 调用方缓冲
        if (em_lea_local_down(c_ret_tmp_off) != 0) { return -1; }
        c_res_is_addr = 1;
        return 0;
    }
    c_res_is_addr = 0;
    return 0;
}

pub fn sem_return_value(r *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_ret_agg != 0) {
        // x0 = 聚合源地址；x1 = x8 缓冲；拷贝 size 字节
        if (em_push() != 0) { return -1; }
        if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        if (em_ins("mov\tx1, x0") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        if (em_copy_block(t_types[c_fn_ret].size) != 0) { return -1; }
        if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        c_ret_agg_val = 1;
    }
    if (em_jmp(c_fn_lbl) != 0) {
        return -1;
    }
    return 0;
}

pub fn sem_lit_field_lookup(tid int, start int, n int) int {
    return sem_field_lookup(tid, start, n);
}

pub fn sem_struct_lit_begin(tid int, named int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    // 跨模块构造检查（U3）：位置式写全部字段——含私有字段即拒绝；
    // 命名式在字段名解析处逐字段检查（省略字段按零初始化）。
    if (c_module_mode != 0 && t_home[tid] >= 0 && named == 0) {
        let st int = t_types[tid].sub;
        let nf int = t_types[tid].len;
        let i int = 0;
        for i < nf {
            if (t_fields[st + i].is_pub == 0) {
                return sem_err("跨模块不允许位置式构造含私有字段的类型");
            }
            i += 1;
        }
    }
    if (c_lit_depth >= 32) {
        return sem_err("结构体字面量嵌套过深");
    }
    let off int = em_alloc_local(t_types[tid].size);
    // 保存外层字面量的定位状态，供嵌套字面量结束后恢复
    c_lit_save_off[c_lit_depth] = c_lit_off;
    c_lit_save_tid[c_lit_depth] = c_lit_tid;
    c_lit_depth += 1;
    c_lit_off = off;
    c_lit_tid = tid;
    return off;
}

pub fn sem_struct_lit_field(tid int, fidx int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let ftid int = t_fields[fidx].type_id;
    let foff int = t_fields[fidx].offset;
    let fk int = t_types[ftid].kind;
    if (sem_can_assign(ftid, c_lit_last_type, c_lit_last_lit, c_lit_last_ival, 0) != 0) {
        return -1;
    }
    if (fk == TY_STRUCT || fk == TY_UNION || fk == TY_ARRAY || fk == TY_SLICE) {
        // 聚合字段：x0 = 源聚合地址 → 块拷贝进字段位置
        if (em_push() != 0) { return -1; }
        if (em_lea_local_to(c_lit_off - foff) != 0) { return -1; }
        if (em_ins("mov\tx1, x10") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        return em_copy_block(t_types[ftid].size);
    }
    // 槽起点 = fp - c_lit_off；字段地址 = 起点 + foff → 向下偏移 = off - foff
    if (em_lea_local_to(c_lit_off - foff) != 0) { return -1; }
    return em_store_sized(ftid);
}

pub fn sem_struct_lit_end(tid int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    // 把本层槽地址留在 x0，并恢复外层字面量的定位状态。
    // begin 时 save[d] 记录的是「进入本层前的值」，end 读 save[d] 恢复。
    let my_off int = c_lit_off;
    c_lit_depth -= 1;
    c_lit_off = c_lit_save_off[c_lit_depth];
    c_lit_tid = c_lit_save_tid[c_lit_depth];
    return em_lea_local(my_off);
}


// ============================================================================
// sem_flow.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_forin_begin(it *Res, is_range int, end_res *Res) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_fi_depth >= 64) {
        return sem_err("for-in 嵌套过深");
    }
    let d int = c_fi_depth;
    c_fi_cnt_off[d] = em_alloc_local(8);
    c_fi_len_off[d] = em_alloc_local(8);
    c_fi_data_off[d] = em_alloc_local(8);
    c_fi_step_off[d] = em_alloc_local(8);
    c_fi_elem_off[d] = -1;
    c_fi_idx_off[d] = -1;
    if (is_range != 0) {
        c_fi_kind[d] = 1;
        // x0 = 起点。先存 data 槽（起点），再与终点比较定步长与长度。
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        // x11 = 终点（从临时槽）。用 x11 而非 x9：深帧下
        // em_lea_local_to 拼地址走 movz x9，会覆盖 x9 里的终点，
        // 区间长度被算成「槽偏移 - 起点」（run/27：长度 287 而非 4，
        // range_sum 累加成 37128——小帧时 lea 走 sub x10 不触雷，
        // 故 mini 复现全过）
        if (em_lea_local_to(c_end_tmp_off) != 0) { return -1; }
        if (em_ins("ldr\tx11, [x10]") != 0) { return -1; }
        // x0 = 起点
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        // 长度 = max(0, 终点 - 起点)：x11 = 终点-起点；若 <0 置 0
        if (em_ins("sub\tx11, x11, x0") != 0) { return -1; }
        let l_pos int = em_new_label();
        if (em_frag("\tcbnz\tx11, ") != 0) { return -1; }
        if (em_put_lbl(l_pos) != 0) { return -1; }
        if (em_frag("\n") != 0) { return -1; }
        // x11 == 0：空区间，长度 0（保持 x11=0 即可）
        if (em_label(l_pos) != 0) { return -1; }
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
        // 步长恒 +1（左闭右开区间）。先取地址再装常量：深帧 lea 的
        // movz x9 不能落在步长已入 x9 之后（同数组 len 的教训）
        if (em_lea_local_to(c_fi_step_off[d]) != 0) { return -1; }
        if (em_ins("mov\tx9, #1") != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
        if (em_ins("str\txzr, [x10]") != 0) { return -1; }
        c_fi_depth += 1;
        return 0;
    }
    // 数组/切片
    c_fi_kind[d] = 0;
    let k int = t_types[it.type_id].kind;
    if (k == TY_ARRAY) {
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        // 先取地址再装 len：深帧 lea 的 movz x9 不能落在 len 已入 x9 之后
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_mov_imm("x9", t_types[it.type_id].len.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
    } else if (k == TY_SLICE) {
        if (em_ins("mov\tx8, x0") != 0) { return -1; }
        if (em_ins("ldr\tx11, [x8]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
        if (em_ins("ldr\tx11, [x8, #8]") != 0) { return -1; }
        if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
        if (em_ins("str\tx11, [x10]") != 0) { return -1; }
    } else {
        return sem_err("for-in 需要数组、切片或区间");
    }
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("str\txzr, [x10]") != 0) { return -1; }
    c_fi_depth += 1;
    return 0;
}

pub fn sem_forin_elem_type(it *Res, is_range int) int {
    if (is_range != 0) {
        // 区间迭代绑定是默认整数类型 int（与 stage0 一致，便于 int 变量累加）
        return TY_I32;
    }
    return t_types[it.type_id].elem;
}

pub fn sem_forin_set_bind(elem_off int, idx_off int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_fi_depth == 0) {
        return sem_err("内部错误：for-in 状态缺失");
    }
    c_fi_elem_off[c_fi_depth - 1] = elem_off;
    c_fi_idx_off[c_fi_depth - 1] = idx_off;
    return 0;
}

pub fn sem_forin_check(lbl_end int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx1, [x10]") != 0) { return -1; }
    if (em_lea_local_to(c_fi_len_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx2, [x10]") != 0) { return -1; }
    if (em_ins("cmp\tx1, x2") != 0) { return -1; }
    if (em_frag("\tb.ge\t") != 0) { return -1; }
    if (em_put_lbl(lbl_end) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    return 0;
}

pub fn sem_forin_load(it *Res, is_range int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (is_range != 0) {
        // 下标 = count；值 = 起点 + count*step
        if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        if (c_fi_idx_off[d] >= 0) {
            if (em_lea_local_to(c_fi_idx_off[d]) != 0) { return -1; }
            if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        }
        if (c_fi_elem_off[d] >= 0) {
            // x0 = count（下标）；值 = 起点 + count
            if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
            if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
            if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_ins("str\tx0, [x10]") != 0) { return -1; }
        }
        return 0;
    }
    // 数组/切片：值 = data[count]
    let elem int = t_types[it.type_id].elem;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
    if (c_fi_idx_off[d] >= 0) {
        if (em_lea_local_to(c_fi_idx_off[d]) != 0) { return -1; }
        if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    }
    // 缩放下标 → data + i*size
    let esz int = t_types[elem].size;
    if (esz == 2) {
        if (em_ins("lsl\tx0, x0, #1") != 0) { return -1; }
    } else if (esz == 4) {
        if (em_ins("lsl\tx0, x0, #2") != 0) { return -1; }
    } else if (esz == 8) {
        if (em_ins("lsl\tx0, x0, #3") != 0) { return -1; }
    } else if (esz != 1) {
        if (em_mov_imm("x9", esz.to_type(i64)) != 0) { return -1; }
        if (em_ins("mul\tx0, x0, x9") != 0) { return -1; }
    }
    if (em_lea_local_to(c_fi_data_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx9, [x10]") != 0) { return -1; }
    if (em_ins("add\tx0, x9, x0") != 0) { return -1; }
    if (c_fi_elem_off[d] >= 0) {
        let ek int = t_types[elem].kind;
        if (ek == TY_STRUCT || ek == TY_UNION || ek == TY_ARRAY || ek == TY_SLICE) {
            // 聚合元素：块拷贝进绑定槽。x0 = 元素地址（add 的结果），
            // 先取绑定槽地址（x10）再拷贝——深帧 lea 的 movz x9 不碰
            // x0，此序天然安全；原「mov x9, x0 保地址」会被 lea 覆盖
            // （copy_block 源错）
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_ins("mov\tx1, x10") != 0) { return -1; }
            if (em_copy_block(t_types[elem].size) != 0) { return -1; }
        } else {
            // 标量元素：x10 = 元素地址，load 到 x0 后存绑定槽
            if (em_ins("mov\tx10, x0") != 0) { return -1; }
            if (em_load_sized(elem) != 0) { return -1; }
            if (em_lea_local_to(c_fi_elem_off[d]) != 0) { return -1; }
            if (em_store_sized(elem) != 0) { return -1; }
        }
    }
    return 0;
}

pub fn sem_forin_step(lbl_cond int) int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    let d int = c_fi_depth - 1;
    if (em_lea_local_to(c_fi_cnt_off[d]) != 0) { return -1; }
    if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
    if (em_ins("add\tx0, x0, #1") != 0) { return -1; }
    if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    return em_jmp(lbl_cond);
}

pub fn sem_forin_end() int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    c_fi_depth -= 1;
    return 0;
}

pub fn sem_stash_lvalue() int {
    if (c_compile == 0 || c_fold != 0) {
        return 0;
    }
    if (c_temp_off == 0) {
        c_temp_off = em_alloc_local(8);
    }
    // 先保护 x0 中的左值地址，再取临时槽地址，最后写入
    if (em_push() != 0) { return -1; }
    if (em_lea_local(c_temp_off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    if (em_ins("str\tx0, [x10]") != 0) { return -1; }
    return 0;
}

pub fn sem_assign(op int, lres *Res, rres *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_fold != 0) {
        return sem_err("赋值不是编译期常量");
    }
    if (em_lea_local(c_temp_off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (ty_is_float(lres.type_id) != 0) {
        // 浮点赋值：值在 d0/s0
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        if (op == TK_ASSIGN) {
            let fs *char = "d";
            if (t_types[lres.type_id].size == 4) { fs = "s"; }
            if (em_frag("\tstr\t") != 0) { return -1; }
            if (em_frag(fs) != 0) { return -1; }
            if (em_frag("0, [x10]\n") != 0) { return -1; }
            return 0;
        }
        // 复合赋值：右值（d0）存入专用临时槽；目标地址进出 x10 各两次
        //（每次 em_lea_local_to 都会覆盖 x10，目标地址先压栈保护、用后
        // 弹回；压/弹必须成对，此前弹空栈导致 d1 从垃圾地址装入）。
        let fs2 *char = "d";
        if (t_types[lres.type_id].size == 4) { fs2 = "s"; }
        if (c_fp_tmp_off == 0) {
            c_fp_tmp_off = em_alloc_local(8);
        }
        if (em_ins("str\tx10, [sp, #-16]!") != 0) { return -1; }
        if (em_lea_local_to(c_fp_tmp_off) != 0) { return -1; }
        if (em_frag("\tstr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        if (em_pop("x10") != 0) { return -1; }
        if (em_frag("\tldr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("1, [x10]\n") != 0) { return -1; }
        if (em_ins("str\tx10, [sp, #-16]!") != 0) { return -1; }
        if (em_lea_local_to(c_fp_tmp_off) != 0) { return -1; }
        if (em_frag("\tldr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        if (em_pop("x10") != 0) { return -1; }
        let fb int = op;
        if (op == TK_PLUSEQ) { fb = TK_PLUS; }
        if (op == TK_MINUSEQ) { fb = TK_MINUS; }
        if (op == TK_STAREQ) { fb = TK_STAR; }
        if (op == TK_SLASHEQ) { fb = TK_SLASH; }
        if (em_fp_binop(fb, lres.type_id) != 0) { return -1; }
        if (em_frag("\tstr\t") != 0) { return -1; }
        if (em_frag(fs2) != 0) { return -1; }
        if (em_frag("0, [x10]\n") != 0) { return -1; }
        return 0;
    }
    if (op == TK_ASSIGN) {
        if (em_pop("x0") != 0) { return -1; }
        // x10 先取回暂存的目标地址再存（临时槽里存的是地址，不是目标）
        if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
        // 聚合同型赋值 = 逐字节块拷贝（语义边界 §：数组同型赋值为值
        // 复制）。聚合的值语义即对象地址：x0 是源对象地址，x10 是目标
        // 地址；此前误走标量 store 只写前 8 字节。
        let lk int = t_types[lres.type_id].kind;
        if (lk == TY_STRUCT || lk == TY_UNION || lk == TY_ARRAY || lk == TY_SLICE) {
            if (em_ins("mov\tx1, x10") != 0) { return -1; }
            return em_copy_block(t_types[lres.type_id].size);
        }
        return em_store_sized(lres.type_id);
    }
    // 复合赋值：x10 先取回暂存的左值地址，再读值运算后经 x10 存回
    if (em_ins("ldr\tx10, [x10]") != 0) { return -1; }
    if (em_load_sized(lres.type_id) != 0) { return -1; }
    if (em_ins("mov\tx9, x0") != 0) { return -1; }
    if (em_pop("x0") != 0) { return -1; }
    let tid int = sem_promote(lres.type_id, rres.type_id);
    let base int = op;
    if (op == TK_PLUSEQ) { base = TK_PLUS; }
    if (op == TK_MINUSEQ) { base = TK_MINUS; }
    if (op == TK_STAREQ) { base = TK_STAR; }
    if (op == TK_SLASHEQ) { base = TK_SLASH; }
    if (op == TK_PERCENTEQ) { base = TK_PERCENT; }
    if (op == TK_AMPEQ) { base = TK_AMP; }
    if (op == TK_PIPEEQ) { base = TK_PIPE; }
    if (op == TK_CARETEQ) { base = TK_CARET; }
    if (op == TK_LSHIFTEQ) { base = TK_LSHIFT; }
    if (op == TK_RSHIFTEQ) { base = TK_RSHIFT; }
    if (em_binop(base, tid) != 0) { return -1; }
    return em_store_sized(lres.type_id);
}

pub fn sem_declare_local(start int, n int, tid int) int {
    let size int = t_types[tid].size;
    let idx int = sym_push(start, n, SYM_VAR, tid, 0);
    if (idx < 0) {
        return -1;
    }
    let off int = em_alloc_local(size);
    c_syms[idx].offset = off;
    // 零初始化（标量直接清零；聚合逐字节循环）
    if (size == 0) {
        return idx;
    }
    if (size <= 8) {
        if (em_lea_local(off) != 0) { return -1; }
        if (em_ins("mov\tx10, x0") != 0) { return -1; }
        let zk *char = "strb\twzr, [x10]";
        if (size == 2) { zk = "strh\twzr, [x10]"; }
        if (size == 4) { zk = "str\twzr, [x10]"; }
        if (size == 8) { zk = "str\txzr, [x10]"; }
        if (em_ins(zk) != 0) { return -1; }
        return idx;
    }
    // 聚合清零循环：x9 = 剩余字节，x10 = 游标。先取槽地址再装计数器：
    // 深帧 lea 的 movz x9 会覆盖计数器（清零长度错/死循环）
    let lz int = em_new_label();
    let ld int = em_new_label();
    if (em_lea_local(off) != 0) { return -1; }
    if (em_ins("mov\tx10, x0") != 0) { return -1; }
    if (em_mov_imm("x9", size.to_type(i64)) != 0) { return -1; }
    if (em_label(lz) != 0) { return -1; }
    if (em_frag("\tcbz\tx9, ") != 0) { return -1; }
    if (em_put_lbl(ld) != 0) { return -1; }
    if (em_frag("\n") != 0) { return -1; }
    if (em_ins("strb\twzr, [x10], #1") != 0) { return -1; }
    if (em_ins("sub\tx9, x9, #1") != 0) { return -1; }
    if (em_jmp(lz) != 0) { return -1; }
    if (em_label(ld) != 0) { return -1; }
    return idx;
}

pub fn sem_store_local_value(idx int, tid int) int {
    if (c_compile == 0) {
        return 0;
    }
    let k int = t_types[tid].kind;
    if (k == TY_STRUCT || k == TY_UNION || k == TY_ARRAY || k == TY_SLICE) {
        // 聚合初始化：x0 = 源聚合地址 → 块拷贝进局部槽
        let off int = c_syms[idx].offset;
        if (em_push() != 0) { return -1; }
        if (em_lea_local_down(off) != 0) { return -1; }
        if (em_ins("mov\tx1, x0") != 0) { return -1; }
        if (em_pop("x0") != 0) { return -1; }
        return em_copy_block(t_types[tid].size);
    }
    if (ty_is_float(tid) != 0) {
        return em_fp_store_local(c_syms[idx].offset, tid);
    }
    let soff int = c_syms[idx].offset;
    if (soff <= 255) {
        if (em_frag("\tstr\t") != 0) { return -1; }
        // 按大小选寄存器与助记符
        let size int = t_types[tid].size;
        if (size == 8) {
            if (em_puts("x0, [x29, #-") != 0) { return -1; }
        } else if (size == 4) {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        } else if (size == 2) {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        } else {
            if (em_puts("w0, [x29, #-") != 0) { return -1; }
        }
        if (em_puti(soff) != 0) { return -1; }
        return em_frag("]\n");
    }
    // 偏移超出未缩放立即数范围：地址写 x10（不覆盖 x0 中的待存值）
    if (em_lea_local_to(soff) != 0) { return -1; }
    return em_store_sized(tid);
}

pub fn sem_check_duplicate(start int, n int) int {
    let i int = c_sym_n - 1;
    for i >= c_scope_start[c_scope_n - 1] {
        if (c_syms[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_syms[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return sem_err("同一作用域内重复声明");
            }
        }
        i -= 1;
    }
    return 0;
}

pub fn sem_goto(start int, n int) int {
    if (c_compile == 0) {
        return 0;
    }
    // 已定义？
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_glabels[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return em_jmp(c_glabels[i].lbl);
            }
        }
        i += 1;
    }
    // 前向引用：登记
    if (c_glabel_n >= 128) {
        return sem_err("goto 标签过多");
    }
    let off int = name_intern(start, n);
    c_glabels[c_glabel_n].name_off = off;
    c_glabels[c_glabel_n].name_len = n;
    let lbl int = em_new_label();
    c_glabels[c_glabel_n].lbl = lbl;
    c_glabels[c_glabel_n].defined = 0;
    c_glabel_n += 1;
    return em_jmp(lbl);
}

pub fn sem_deflabel(start int, n int) int {
    if (c_compile == 0) {
        return 0;
    }
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[c_glabels[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                if (c_glabels[i].defined != 0) {
                    return sem_err("标签重定义");
                }
                c_glabels[i].defined = 1;
                return em_label(c_glabels[i].lbl);
            }
        }
        i += 1;
    }
    if (c_glabel_n >= 128) {
        return sem_err("goto 标签过多");
    }
    let off int = name_intern(start, n);
    c_glabels[c_glabel_n].name_off = off;
    c_glabels[c_glabel_n].name_len = n;
    let lbl int = em_new_label();
    c_glabels[c_glabel_n].lbl = lbl;
    c_glabels[c_glabel_n].defined = 1;
    c_glabel_n += 1;
    return em_label(lbl);
}

pub fn sem_glabels_verify() int {
    let i int = 0;
    for i < c_glabel_n {
        if (c_glabels[i].defined == 0) {
            return sem_err("goto 了未定义的标签");
        }
        i += 1;
    }
    c_glabel_n = 0;
    return 0;
}

pub fn sem_loop_push(brk int, cnt int) int {
    if (c_loop_depth >= 64) {
        return sem_err("循环嵌套过深");
    }
    c_brk_stk[c_loop_depth] = brk;
    c_cnt_stk[c_loop_depth] = cnt;
    c_loop_depth += 1;
    c_loop_brk = brk;
    c_loop_cnt = cnt;
    return 0;
}

pub fn sem_loop_pop() int {
    c_loop_depth -= 1;
    if (c_loop_depth > 0) {
        c_loop_brk = c_brk_stk[c_loop_depth - 1];
        c_loop_cnt = c_cnt_stk[c_loop_depth - 1];
    }
    return 0;
}

pub fn sem_break() int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_loop_depth == 0) {
        return sem_err("break 不在循环内");
    }
    return em_jmp(c_loop_brk);
}

pub fn sem_continue() int {
    if (c_compile == 0) {
        return 0;
    }
    if (c_loop_depth == 0) {
        return sem_err("continue 不在循环内");
    }
    return em_jmp(c_loop_cnt);
}


// ============================================================================
// sem_decl.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_fn_begin(idx int) int {
    c_fn_sym = idx;
    c_fn_ret = t_types[c_syms[idx].type_id].elem;
    c_fn_lbl = em_new_label();
    c_temp_off = 0;
    c_glabel_n = 0;
    c_spill_n = 0;
    c_aggparam_n = 0;
    c_fp_argn = 0;
    c_ret_ptr_off = 0;
    // prologue 的 fp/lr 对占 16 字节，槽偏移从 16 起算
    c_fp_off = 16;
    o_body_len = 0;
    c_in_body = 1;
    // 聚合返回：入口保存 x8（调用方给的返回缓冲地址）
    let rk int = t_types[c_fn_ret].kind;
    if (rk == TY_STRUCT || rk == TY_UNION || rk == TY_ARRAY || rk == TY_SLICE) {
        c_ret_agg = 1;
        c_ret_ptr_off = em_alloc_local(TG_PTR_SIZE);
        // 入口把 x8（调用方返回缓冲）存进槽：函数体在缓冲中发射时会用到
        if (em_save_hidden_ret(c_ret_ptr_off) != 0) {
            return -1;
        }
    } else {
        c_ret_agg = 0;
    }
    scope_push();
    return 0;
}

pub fn sem_declare_param(start int, n int, tid int, regidx int) int {
    let pk int = t_types[tid].kind;
    let is_agg int = ((pk == TY_ARRAY) || (pk == TY_STRUCT) || (pk == TY_UNION)
                      || (pk == TY_SLICE)).to_type(int);
    let size int = t_types[tid].size;
    let idx int = sym_push(start, n, SYM_VAR, tid, F_PARAM);
    if (idx < 0) {
        return -1;
    }
    if (is_agg != 0) {
        // 聚合按值：参数槽存「指向调用方副本的指针」，入口处再拷进本帧
        // 的独立存储。拷贝让形参修改不影响调用方（ADR-0001 可观察行为），
        // 也让递归各层持有各自副本。
        let pslot int = 0;
        if (regidx < TG_ARG_REGS) {
            pslot = em_alloc_local(TG_PTR_SIZE);
            c_spill_reg[c_spill_n] = regidx;
            c_spill_off[c_spill_n] = pslot;
            c_spill_size[c_spill_n] = 0;
            c_spill_n += 1;
        } else {
            // 栈实参第 (regidx-8) 个槽存指针
            // 栈实参 8 字节间距（AAPCS64/调用方回压一致）
            pslot = 0 - (16 + 8 * (regidx - TG_ARG_REGS));
        }
        let body int = em_alloc_local(size);
        c_syms[idx].offset = body;
        c_syms[idx].flags |= F_AGGPARAM;
        // 记录「指针槽 → 体型槽」的入口拷贝任务，prologue 之后执行
        c_aggparam_src[c_aggparam_n] = pslot;
        c_aggparam_dst[c_aggparam_n] = body;
        c_aggparam_size[c_aggparam_n] = size;
        c_aggparam_n += 1;
        return 0;
    }
    if (ty_is_float(tid) != 0) {
        // 浮点参数：前 8 个进 d0-d7（负数标记 + 浮点槽溢出）
        if (c_fp_argn < TG_ARG_REGS) {
            let off int = em_alloc_local(size);
            c_syms[idx].offset = off;
            c_spill_reg[c_spill_n] = 0 - (c_fp_argn + 1);
            c_spill_off[c_spill_n] = off;
            c_spill_size[c_spill_n] = tid;
            c_spill_n += 1;
            c_fp_argn += 1;
            return 0;
        }
        // 超出：栈传（这里简化拒绝，B7 用例不涉及）
        return sem_err("过多的浮点参数暂不支持");
    }
    if (regidx < TG_ARG_REGS) {
        let ioff int = em_alloc_local(size);
        c_syms[idx].offset = ioff;
        c_spill_reg[c_spill_n] = regidx;
        c_spill_off[c_spill_n] = ioff;
        c_spill_size[c_spill_n] = 0;
        c_spill_n += 1;
        return 0;
    }
    // AAPCS：调用方栈实参区在 sp_at_call+0 起（每参 8 字节槽）；
    // callee 的 fp = sp_at_call-16
    c_syms[idx].offset = 0 - (16 + 8 * (regidx - TG_ARG_REGS));
    return 0;
}

pub fn sem_fn_end() int {
    if (sem_glabels_verify() != 0) {
        return -1;
    }
    // 落底返回：聚合返回函数以 x0 = 聚合地址（调用方缓冲或本帧临时）；
    // 标量返回 0。显式 return 已在各分支把值放好。
    if (c_ret_agg != 0) {
        if (c_ret_agg_val != 0) {
            if (em_load_hidden_ret(c_ret_ptr_off) != 0) { return -1; }
        } else {
            if (em_ins("mov\tx0, xzr") != 0) { return -1; }
        }
    } else if (c_fn_ret != TY_VOID) {
        if (em_ins("mov\tx0, xzr") != 0) { return -1; }
    }
    c_in_body = 0;
    if (em_prologue(c_fn_sym) != 0) {
        return -1;
    }
    // 聚合参数入口拷贝：x10 = 指针槽内容（调用方副本地址），
    // 逐字节拷进本帧体型槽
    let ai int = 0;
    for ai < c_aggparam_n {
        if (em_lea_local_to(c_aggparam_src[ai]) != 0) { return -1; }
        if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
        if (em_lea_local_to(c_aggparam_dst[ai]) != 0) { return -1; }
        if (em_ins("mov\tx1, x10") != 0) { return -1; }
        if (em_copy_block(c_aggparam_size[ai]) != 0) { return -1; }
        ai += 1;
    }
    // 聚合参数指针槽本身不再需要，但槽已在静态帧内，无需回收
    if (em_copy_body() != 0) {
        return -1;
    }
    if (em_epilogue() != 0) {
        return -1;
    }
    scope_pop();
    return 0;
}

pub fn sem_add_field(stid int, start int, n int, ftid int, is_pub int) int {
    let fk int = t_types[ftid].kind;
    if ((fk == TY_STRUCT || fk == TY_UNION) && t_types[ftid].size == 0) {
        return sem_err("字段使用了不完整的类型");
    }
    if (t_field_n == t_field_cap) {
        let ncap int = t_field_cap * 2;
        if (ncap == 0) {
            ncap = 64;
        }
        let nd *SField = malloc((ncap * sizeof(SField)).to_type(u64)).to_type(*SField);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (t_field_n > 0) {
            memcpy(nd, t_fields, (t_field_n * sizeof(SField)).to_type(u64));
        }
        free(t_fields);
        t_fields = nd;
        t_field_cap = ncap;
    }
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    t_fields[t_field_n].name_off = off;
    t_fields[t_field_n].name_len = n;
    t_fields[t_field_n].type_id = ftid;
    t_fields[t_field_n].offset = 0;
    t_fields[t_field_n].is_pub = is_pub;
    t_field_n += 1;
    t_types[stid].len = t_field_n - t_types[stid].sub;
    return 0;
}

pub fn sem_struct_finish(stid int, is_union int) int {
    let sub int = t_types[stid].sub;
    let n int = t_types[stid].len;
    if (tg_layout_struct(sub, n, is_union) != 0) {
        return -1;
    }
    t_types[stid].size = c_layout_size;
    t_types[stid].align = c_layout_align;
    return 0;
}

pub fn sem_field_lookup(stid int, start int, n int) int {
    let st int = t_types[stid].sub;
    let nf int = t_types[stid].len;
    let i int = 0;
    for i < nf {
        let f int = st + i;
        if (t_fields[f].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[t_fields[f].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return f;
            }
        }
        i += 1;
    }
    return -1;
}

pub fn sem_check_main() int {
    let mname int = name_intern_lit("main");
    let i int = c_sym_n - 1;
    let found int = -1;
    for i >= 0 {
        if (c_syms[i].name_len == 4) {
            let match int = 1;
            let j int = 0;
            for j < 4 {
                if (np_data[c_syms[i].name_off + j] != np_data[mname + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                found = i;
                break;
            }
        }
        i -= 1;
    }
    if (found < 0) {
        return sem_err("缺少 main 函数");
    }
    if (c_syms[found].kind != SYM_FN) {
        return sem_err("main 必须是函数");
    }
    let sig int = t_types[c_syms[found].type_id].sub;
    let np int = t_sig_np[sig];
    let ret int = t_sig_ret[sig];
    if (ret != TY_I32) {
        return sem_err("main 必须返回 int");
    }
    if (np == 0) {
        return 0;
    }
    if (np == 2) {
        let p0 int = t_sig_params[t_sig_first[sig]];
        let p1 int = t_sig_params[t_sig_first[sig] + 1];
        let inner int = t_types[p1].elem;
        if (p0 == TY_I32 && t_types[p1].kind == TY_PTR
            && t_types[inner].kind == TY_PTR
            && t_types[t_types[inner].elem].kind == TY_CHAR) {
            return 0;
        }
    }
    return sem_err("main 签名必须是 () 或 (argc int, argv **char)");
}


// ============================================================================
// parse_expr.yh —— 自举编译器：表达式解析（语义钩子集成）
//
// 覆盖 docs/yh.g4 表达式优先级链（低 → 高）：
//   三元 ?: → || → && → | → ^ → & → ==/!= → 比较 → 移位 → 加减
//   → 乘除模 → 一元 → 后缀（调用/下标/.to_type/.成员） → 基本表达式。
//
// 语义协议：每个解析函数把结果通过 *Res 出参返回（类型/常量性/字面量
// 标记）；编译模式同时发码（结果留 x0）。c_fold>0 时只折叠。
// &&/|| 与三元由解析器配合 sem_* 钩子用标签短路实现。
//
// 「结构体字面量 vs 块」消解与 G1 相同：块跟随上下文（for/switch/case
// 头部）先试探 structInitBody 且配对 '}' 后必须紧跟 '{'，否则回退为块；
// 编译模式中结构体字面量作为值使用统一拒绝（B5 仅支持 let 直接初始化）。
// ============================================================================

// parse_expr：表达式入口（= 条件表达式层）。
pub fn parse_expr(res *Res) int {
    return parse_ternary(res);
}

// parse_array_literal：数组/切片字面量 '[' e1, e2, ... ']'。
// 目标类型取自 c_expect_tid（let 初始化/赋值上下文预先设置）；无上下文
// 干净拒绝。数组要求元素个数与长度一致；切片按元素个数建 {len, data}
// 视图。元素先逐个求值压栈，再逆序弹入临时数组（与类型化变参打包同法）。
pub fn parse_array_literal(res *Res) int {
    let tid int = c_expect_tid;
    c_expect_tid = -1;
    if (c_compile == 0) {
        // 语法模式：只消费元素 token
        if (p_cur() != TK_RBRACKET) {
            for 1 {
                let d Res;
                if (parse_expr_iso(&d) != 0) {
                    return -1;
                }
                if (p_cur() == TK_COMMA) {
                    p_adv();
                    if (p_cur() == TK_RBRACKET) { break; }
                    continue;
                }
                break;
            }
        }
        return p_expect(TK_RBRACKET, "期望 ']'");
    }
    if (tid < 0) {
        return sem_err("数组/切片字面量需要目标类型上下文（let 初始化或同型赋值）");
    }
    let fk int = t_types[tid].kind;
    if (fk != TY_ARRAY && fk != TY_SLICE) {
        return sem_err("数组/切片字面量的目标必须是数组或切片类型");
    }
    let elem int = t_types[tid].elem;
    let esz int = t_types[elem].size;
    // 解析元素并逐个压栈
    let count int = 0;
    if (p_cur() != TK_RBRACKET) {
        for 1 {
            let e Res;
            let save_lv int = c_lvalue;
            c_lvalue = 0;
            let er int = parse_expr_iso(&e);
            c_lvalue = save_lv;
            if (er != 0) {
                return -1;
            }
            if (sem_can_assign(elem, e.type_id, e.is_lit, e.ival, e.lit_big) != 0) {
                return -1;
            }
            if (sem_push_value(&e) != 0) {
                return -1;
            }
            count += 1;
            if (p_cur() == TK_COMMA) {
                p_adv();
                if (p_cur() == TK_RBRACKET) { break; }
                continue;
            }
            break;
        }
    }
    if (p_expect(TK_RBRACKET, "期望 ']'") != 0) {
        return -1;
    }
    if (fk == TY_ARRAY && count != t_types[tid].len) {
        return sem_err("数组字面量元素个数与数组长度不一致");
    }
    if (c_fold != 0) {
        return sem_err("数组/切片字面量不是编译期常量");
    }
    // 临时数组：逆序弹栈写入（值栈顶是最后一个元素）
    let asize int = esz * count;
    let aoff int = 0;
    if (asize > 0) {
        aoff = em_alloc_local(asize);
        let i int = count - 1;
        for i >= 0 {
            // 弹出第 i 个元素并写入 aoff + i*esz
            if (ty_is_float(elem) != 0) {
                let fsfx *char = "d";
                if (esz == 4) { fsfx = "s"; }
                if (em_frag("\tldr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [sp], #16\n") != 0) { return -1; }
                if (em_lea_local_to(aoff - i * esz) != 0) { return -1; }
                if (em_frag("\tstr\t") != 0) { return -1; }
                if (em_frag(fsfx) != 0) { return -1; }
                if (em_frag("0, [x10]\n") != 0) { return -1; }
            } else {
                if (em_pop("x0") != 0) { return -1; }
                if (em_lea_local_to(aoff - i * esz) != 0) { return -1; }
                if (em_store_sized(elem) != 0) { return -1; }
            }
            i -= 1;
        }
    }
    // 结果：数组 → 临时数组地址（数组值语义即地址）；
    //       切片 → {count, &临时} 视图（16 字节临时）
    if (fk == TY_ARRAY) {
        if (em_lea_local(aoff) != 0) {
            return -1;
        }
    } else {
        let voff int = em_alloc_local(TG_LONG_SIZE * 2);
        if (em_lea_local_to(voff) != 0) { return -1; }
        if (em_mov_imm("x9", count.to_type(i64)) != 0) { return -1; }
        if (em_ins("str\tx9, [x10]") != 0) { return -1; }
        if (em_lea_local(aoff) != 0) { return -1; }
        if (em_ins("str\tx0, [x10, #8]") != 0) { return -1; }
        if (em_lea_local_down(voff) != 0) { return -1; }
    }
    sem_res_reset(res, tid);
    res.is_lit = 0;
    res.is_const = 0;
    c_res_is_addr = 1;
    return 0;
}

// parse_expr_iso：隔离上下文——「IDENT {」恒按结构体字面量处理。
pub fn parse_expr_iso(res *Res) int {
    let save int = c_ctx_block;
    c_ctx_block = 0;
    let r int = parse_expr(res);
    c_ctx_block = save;
    return r;
}

// parse_expr_blockctx：块跟随上下文——for/switch/case 头部表达式。
pub fn parse_expr_blockctx(res *Res) int {
    let save int = c_ctx_block;
    c_ctx_block = 1;
    let r int = parse_expr(res);
    c_ctx_block = save;
    return r;
}

// parse_ternary：cond ? a : b（右结合；两支经值栈汇合）。
pub fn parse_ternary(res *Res) int {
    if (parse_logical_or(res) != 0) {
        return -1;
    }
    if (p_cur() == TK_QUEST) {
        p_adv();
        if (sem_ternary_cond(res) != 0) {
            return -1;
        }
        let mid Res;
        if (parse_expr(&mid) != 0) {
            return -1;
        }
        if (p_expect(TK_COLON, "期望 ':'") != 0) {
            return -1;
        }
        if (sem_ternary_mid(res) != 0) {
            return -1;
        }
        if (parse_expr(res) != 0) {
            return -1;
        }
        if (sem_ternary_end(res) != 0) {
            return -1;
        }
        sem_res_copy(res, &mid);
        c_res_is_addr = 0;
    }
    return 0;
}

// parse_logical_or：a || b（短路）。
pub fn parse_logical_or(res *Res) int {
    if (parse_logical_and(res) != 0) {
        return -1;
    }
    for p_cur() == TK_OROR {
        p_adv();
        if (sem_shortcircuit(TK_OROR, res) != 0) {
            return -1;
        }
        if (parse_logical_and(res) != 0) {
            return -1;
        }
        if (sem_shortcircuit_end(TK_OROR, res) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_logical_and：a && b（短路）。
pub fn parse_logical_and(res *Res) int {
    if (parse_bit_or(res) != 0) {
        return -1;
    }
    for p_cur() == TK_ANDAND {
        p_adv();
        if (sem_shortcircuit(TK_ANDAND, res) != 0) {
            return -1;
        }
        if (parse_bit_or(res) != 0) {
            return -1;
        }
        if (sem_shortcircuit_end(TK_ANDAND, res) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_bit_or：a | b。
pub fn parse_bit_or(res *Res) int {
    if (parse_bit_xor(res) != 0) {
        return -1;
    }
    for p_cur() == TK_PIPE {
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_bit_xor(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(TK_PIPE, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_bit_xor：a ^ b。
pub fn parse_bit_xor(res *Res) int {
    if (parse_bit_and(res) != 0) {
        return -1;
    }
    for p_cur() == TK_CARET {
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_bit_and(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(TK_CARET, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_bit_and：a & b。
pub fn parse_bit_and(res *Res) int {
    if (parse_equality(res) != 0) {
        return -1;
    }
    for p_cur() == TK_AMP {
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_equality(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(TK_AMP, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_equality：a == b、a != b。
pub fn parse_equality(res *Res) int {
    if (parse_relational(res) != 0) {
        return -1;
    }
    for p_cur() == TK_EQEQ || p_cur() == TK_NEQ {
        let op int = p_cur();
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_relational(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(op, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_relational：a < b、<=、>、>=。
pub fn parse_relational(res *Res) int {
    if (parse_shift(res) != 0) {
        return -1;
    }
    for p_cur() == TK_LT || p_cur() == TK_LEQ || p_cur() == TK_GT || p_cur() == TK_GEQ {
        let op int = p_cur();
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_shift(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(op, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_shift：a << b、a >> b。
pub fn parse_shift(res *Res) int {
    if (parse_additive(res) != 0) {
        return -1;
    }
    for p_cur() == TK_LSHIFT || p_cur() == TK_RSHIFT {
        let op int = p_cur();
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_additive(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(op, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_additive：a + b、a - b（含指针 ± 整数）。
pub fn parse_additive(res *Res) int {
    if (parse_multiplicative(res) != 0) {
        return -1;
    }
    for p_cur() == TK_PLUS || p_cur() == TK_MINUS {
        let op int = p_cur();
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_multiplicative(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(op, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_multiplicative：a * b、a / b、a % b。
pub fn parse_multiplicative(res *Res) int {
    if (parse_unary(res) != 0) {
        return -1;
    }
    for p_cur() == TK_STAR || p_cur() == TK_SLASH || p_cur() == TK_PERCENT {
        let op int = p_cur();
        p_adv();
        let rhs Res;
        if (sem_push_value(res) != 0) { return -1; }
        if (parse_unary(&rhs) != 0) {
            return -1;
        }
        if (sem_binop(op, res, &rhs) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_unary：一元运算（可嵌套；后缀优先于一元）。
// AMP 取地址：操作数按 lvalue 解析出地址；STAR 解引用：操作数恒按值
// 解析（得到指针值），结果作为地址参与外层（c_lvalue 语义由钩子处理）。
pub fn parse_unary(res *Res) int {
    let k int = p_cur();
    if (k == TK_MINUS || k == TK_PLUS || k == TK_BANG || k == TK_TILDE) {
        p_adv();
        if (parse_unary(res) != 0) {
            return -1;
        }
        return sem_unary(k, res);
    }
    if (k == TK_STAR) {
        p_adv();
        let save int = c_lvalue;
        c_lvalue = 0;
        let r int = parse_unary(res);
        c_lvalue = save;
        if (r != 0) {
            return -1;
        }
        return sem_unary(TK_STAR, res);
    }
    if (k == TK_AMP) {
        p_adv();
        let save2 int = c_lvalue;
        c_lvalue += 1;
        let r2 int = parse_unary(res);
        c_lvalue = save2;
        if (r2 != 0) {
            return -1;
        }
        return sem_unary(TK_AMP, res);
    }
    return parse_postfix(res);
}

// parse_postfix：后缀链：调用、下标、.to_type(T)、.成员。
pub fn parse_postfix(res *Res) int {
    if (parse_primary(res) != 0) {
        return -1;
    }
    for 1 {
        let k int = p_cur();
        if (k == TK_LPAREN) {
            // 调用：实参表为行内列表，不允许尾逗号
            p_adv();
            let direct int = sem_call_begin(res);
            if (direct < 0) {
                return -1;
            }
            // 直接调用：以形参类型作为实参数组/切片字面量的目标上下文。
            // 仅编译模式：语法模式 t_types 未初始化（NULL），不可访问；
            // 且须校验 FN 类型，否则非函数被调者的 sub（字段表起点）
            // 会被误当签名号。
            let sig int = -1;
            let np int = 0;
            if (direct == 1 && c_compile != 0 && res.type_id >= 0) {
                if (t_types[res.type_id].kind == TY_FN) {
                    sig = t_types[res.type_id].sub;
                    np = t_sig_np[sig];
                }
            }
            let argi int = 0;
            if (p_cur() != TK_RPAREN) {
                for 1 {
                    let arg Res;
                    let save_exp2 int = c_expect_tid;
                    if (sig >= 0 && argi < np) {
                        c_expect_tid = t_sig_params[t_sig_first[sig] + argi];
                    }
                    let pr int = parse_expr_iso(&arg);
                    c_expect_tid = save_exp2;
                    if (pr != 0) {
                        return -1;
                    }
                    argi += 1;
                    if (sem_push_arg(&arg) != 0) {
                        return -1;
                    }
                    if (p_cur() == TK_COMMA) {
                        p_adv();
                        continue;
                    }
                    break;
                }
            }
            if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
                return -1;
            }
            if (sem_call(res, res) != 0) {
                return -1;
            }
            continue;
        }
        if (k == TK_LBRACKET) {
            // 下标 / 切片表达式：基址压栈 → 首个下标表达式（恒为值，
            // 清 c_lvalue）→ 遇 '..' 为切片形态（再解析终点），否则普通下标
            p_adv();
            if (sem_push_value(res) != 0) { return -1; }
            let idx Res;
            let save_lv int = c_lvalue;
            c_lvalue = 0;
            let ir int = parse_expr(&idx);
            c_lvalue = save_lv;
            if (ir != 0) {
                return -1;
            }
            if (p_cur() == TK_RANGE) {
                // base[start..end]：start 压栈后解析 end（值在 x0）
                p_adv();
                if (sem_push_value(&idx) != 0) { return -1; }
                let eidx Res;
                c_lvalue = 0;
                let er int = parse_expr(&eidx);
                c_lvalue = save_lv;
                if (er != 0) {
                    return -1;
                }
                if (p_expect(TK_RBRACKET, "期望 ']'") != 0) {
                    return -1;
                }
                if (sem_slice(res, &idx, &eidx) != 0) {
                    return -1;
                }
                continue;
            }
            if (p_expect(TK_RBRACKET, "期望 ']'") != 0) {
                return -1;
            }
            if (sem_index(res, &idx) != 0) {
                return -1;
            }
            continue;
        }
        if (k == TK_DOT) {
            p_adv();
            if (p_cur() == TK_TO_TYPE) {
                // .to_type(T)：参数是类型引用而非表达式
                p_adv();
                if (p_expect(TK_LPAREN, "期望 '('") != 0) {
                    return -1;
                }
                let tid int = parse_type_ref();
                if (tid < 0) {
                    return -1;
                }
                if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
                    return -1;
                }
                if (sem_cast(res, tid) != 0) {
                    return -1;
                }
                continue;
            }
            if (is_member_name(p_cur()) != 0) {
                let start int = c_toks[c_pos].start;
                let n int = c_toks[c_pos].len;
                p_adv();
                if (sem_member(res, start, n) != 0) {
                    return -1;
                }
                continue;
            }
            return err_tok("'.' 之后需要一个成员名");
        }
        break;
    }
    return 0;
}

// parse_primary：基本表达式。进入时重置地址标记。
pub fn parse_primary(res *Res) int {
    c_res_is_addr = 0;
    let k int = p_cur();
    // 当前 token 的源区间（各字面量分支共用；stage0 同级块禁同名局部）
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    if (k == TOK_NUMBER) {
        p_adv();
        return sem_number(start, n, res);
    }
    if (k == TOK_STRING) {
        p_adv();
        return sem_string(start, n, res);
    }
    if (k == TOK_CHAR) {
        p_adv();
        return sem_char(start, n, res);
    }
    if (k == TK_TRUE) {
        p_adv();
        return sem_bool(1, res);
    }
    if (k == TK_FALSE) {
        p_adv();
        return sem_bool(0, res);
    }
    if (k == TK_LPAREN) {
        p_adv();
        if (parse_expr_iso(res) != 0) {
            return -1;
        }
        return p_expect(TK_RPAREN, "期望 ')'");
    }
    if (k == TK_SIZEOF) {
        p_adv();
        if (p_expect(TK_LPAREN, "期望 '('") != 0) {
            return -1;
        }
        if (sizeof_starts_type() != 0) {
            // sizeof(T)：编译期类型大小
            let tid int = parse_type_ref();
            if (tid < 0) {
                return -1;
            }
            if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
                return -1;
            }
            return sem_sizeof(tid, res);
        }
        // sizeof(expr)：发射层静默求型（表达式不求值、不发码），
        // 取结果类型的大小。同型名的场景类型优先。
        c_em_suppress += 1;
        let er Res;
        let ererr int = parse_expr_iso(&er);
        c_em_suppress -= 1;
        if (ererr != 0) {
            return -1;
        }
        if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
            return -1;
        }
        return sem_sizeof(er.type_id, res);
    }
    if (k == TK_LEN) {
        p_adv();
        if (p_expect(TK_LPAREN, "期望 '('") != 0) {
            return -1;
        }
        if (parse_expr_iso(res) != 0) {
            return -1;
        }
        if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
            return -1;
        }
        return sem_len(res);
    }
    if (k == TK_LBRACKET) {
        // 数组/切片字面量（目标类型来自 let 初始化/赋值上下文）
        p_adv();
        return parse_array_literal(res);
    }
    if (k == TOK_IDENT) {
        return parse_ident_primary(res);
    }
    return err_tok("此处需要一个表达式");
}

// parse_ident_primary：标识符作为基本表达式（含结构体字面量决策与
// 模块限定名分派）。
pub fn parse_ident_primary(res *Res) int {
    // 注意：stage0 中 if/while 体不开新词法作用域，同名局部必须提升到函数级
    let istart int = c_toks[c_pos].start;
    let ilen int = c_toks[c_pos].len;
    // 模块限定名（编译模式）：名字解析失败且是当前文件的导入绑定
    //（局部声明按词法作用域遮蔽导入）。语法模式不解析（U1 行为）。
    if (c_compile != 0 && c_module_mode != 0 && p_peek(1) == TK_DOT && p_peek(2) == TOK_IDENT) {
        if (sym_lookup(istart, ilen) < 0) {
            let b int = mod_file_binding(istart, ilen);
            if (b >= 0) {
                // m.T { …：限定结构体字面量（仅非块跟随上下文）
                if (p_peek(3) == TK_LBRACE && c_ctx_block == 0) {
                    return parse_module_struct_lit(res, b);
                }
                return parse_module_qualified(res, b, 0);
            }
        }
    }
    if (p_peek(1) == TK_LBRACE) {
        if (c_ctx_block != 0) {
            if (try_struct_init() == 0) {
                return parse_struct_init_forced(res);
            }
            // 回退：该 '{' 是 for/switch/case 体，标识符保持裸形式
            p_adv();
            return sem_ident(istart, ilen, res);
        }
        return parse_struct_init_forced(res);
    }
    p_adv();
    return sem_ident(istart, ilen, res);
}

// parse_module_qualified：m.member 的模块成员访问（消费 m . member）。
// 命名空间命中后按普通名字求值（跨模块符号已带后缀且为外部引用）；
// 未使用的导入在此标记。want_type=0。
pub fn parse_module_qualified(res *Res, mi int, unused int) int {
    p_adv(); // 绑定名
    p_adv(); // '.'
    let mstart int = c_toks[c_pos].start;
    let mlen int = c_toks[c_pos].len;
    let mline int = c_toks[c_pos].line;
    let mcol int = c_toks[c_pos].col;
    p_adv();
    let e int = mod_ns_lookup(mi, mstart, mlen, 0);
    if (e < 0) {
        return err_lc(mline, mcol, "模块没有导出该名字（或它是类型名不能作值）");
    }
    // 标记导入已使用（未使用导入检查在文件编译完后做）
    let i int = 0;
    for i < mod_import_n {
        if (mod_import_mod[i] == mi) {
            mod_import_used[i] = 1;
            break;
        }
        i += 1;
    }
    return sem_ident_val(c_mods[mi].ns[e].sym, res);
}

// parse_module_struct_lit：m.T { … } 限定结构体字面量（消费 m . T）。
// tid 来自接口命名空间；构造检查与本地类型一致（跨模块私有字段拒绝）。
pub fn parse_module_struct_lit(res *Res, mi int) int {
    p_adv();
    p_adv();
    let tstart int = c_toks[c_pos].start;
    let tlen int = c_toks[c_pos].len;
    let tline int = c_toks[c_pos].line;
    let tcol int = c_toks[c_pos].col;
    p_adv();
    let e int = mod_ns_lookup(mi, tstart, tlen, 1);
    if (e < 0) {
        return err_lc(tline, tcol, "模块没有导出该类型");
    }
    let tid int = c_mods[mi].ns[e].tid;
    let i int = 0;
    for i < mod_import_n {
        if (mod_import_mod[i] == mi) {
            mod_import_used[i] = 1;
            break;
        }
        i += 1;
    }
    return parse_struct_init_tid(tid, res);
}

// try_struct_init：试探「IDENT { structInitBody }」成立且其后紧跟 '{'。
pub fn try_struct_init() int {
    let save int = c_pos;
    let save_fold int = c_fold;
    let save_lit_off int = c_lit_off;
    let save_fp int = c_fp_off;
    c_spec += 1;
    // 试探期只做语法判定：禁发码、禁分配槽（c_fold>0 让语义钩子短路）
    if (c_compile != 0) {
        c_fold += 1;
    }
    let dummy Res;
    let r int = parse_struct_init_forced(&dummy);
    let ok int = 0;
    if (r == 0 && p_cur() == TK_LBRACE) {
        ok = 1;
    }
    if (c_compile != 0) {
        c_fold -= 1;
    }
    c_spec -= 1;
    c_pos = save;
    c_fold = save_fold;
    c_lit_off = save_lit_off;
    c_fp_off = save_fp;
    if (ok == 1) {
        return 0;
    }
    return -1;
}

// parse_struct_init_forced：结构体字面量：IDENT '{' body '}'。
// 编译模式：作为值使用统一拒绝（B5 只支持 let 直接初始化路径）。
pub fn parse_struct_init_forced(res *Res) int {
    // 结构体字面量：IDENT '{' body '}'
    // 语法模式只消费 token；编译模式在临时槽构造聚合值，地址留 x0。
    let start int = c_toks[c_pos].start;
    let nlen int = c_toks[c_pos].len;
    p_adv();
    let tid int = 0;
    if (c_compile != 0) {
        if (c_fold != 0) {
            return sem_err("结构体字面量不是编译期常量");
        }
        tid = ty_lookup_name(start, nlen);
        if (tid < 0) {
            return sem_err("未知类型（结构体字面量）");
        }
        let tk int = t_types[tid].kind;
        if (tk != TY_STRUCT && tk != TY_UNION) {
            return sem_err("结构体字面量需要一个 struct/union 类型名");
        }
    }
    return parse_struct_init_tid(tid, res);
}

// parse_struct_init_tid：按给定类型构造结构体字面量（'{ … }' 由本函数
// 消费；本地路径与模块限定路径共用）。
pub fn parse_struct_init_tid(tid int, res *Res) int {
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    if (c_compile != 0) {
        let named int = 0;
        if (is_member_name(p_cur()) != 0 && p_peek(1) == TK_COLON) {
            named = 1;
        }
        if (sem_struct_lit_begin(tid, named) < 0) {
            return -1;
        }
    }
    if (parse_struct_init_body() != 0) {
        return -1;
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (c_compile != 0) {
        if (sem_struct_lit_end(tid) != 0) {
            return -1;
        }
        sem_res_reset(res, tid);
    }
    return 0;
}

// parse_struct_init_body：字面量体（'{' 与 '}' 由调用方处理）。
// 强制非空；首元素第二个 token 为 ':' 即命名式；不得混写；允许尾逗号。
pub fn parse_struct_init_body() int {
    if (p_cur() == TK_RBRACE) {
        return err_tok("结构体字面量不能为空");
    }
    let named int = 0;
    if (is_member_name(p_cur()) != 0 && p_peek(1) == TK_COLON) {
        named = 1;
    }
    let fv Res;
    let fpos int = 0;
    for 1 {
        let fidx int = -1;
        if (named != 0) {
            if (is_member_name(p_cur()) == 0) {
                return err_tok("命名式字面量需要字段名");
            }
            if (c_compile != 0 && c_fold == 0) {
                let fs int = c_toks[c_pos].start;
                let fl int = c_toks[c_pos].len;
                fidx = sem_lit_field_lookup(c_lit_tid, fs, fl);
                if (fidx < 0) {
                    return sem_err("结构体没有该字段");
                }
                // 跨模块命名式构造只可填写 pub 字段（省略的按零初始化）
                if (c_module_mode != 0 && t_home[c_lit_tid] >= 0 && t_fields[fidx].is_pub == 0) {
                    return sem_err("跨模块不能初始化私有字段（声明处未加 pub）");
                }
            }
            p_adv();
            if (p_expect(TK_COLON, "期望 ':'") != 0) {
                return -1;
            }
            if (parse_expr_iso(&fv) != 0) {
                return -1;
            }
        } else {
            if (c_compile != 0 && c_fold == 0) {
                if (fpos >= t_types[c_lit_tid].len) {
                    return sem_err("位置式字面量字段过多");
                }
                fidx = t_types[c_lit_tid].sub + fpos;
                fpos += 1;
            }
            if (parse_expr_iso(&fv) != 0) {
                return -1;
            }
        }
        if (c_compile != 0 && c_fold == 0) {
            c_lit_last_type = fv.type_id;
            c_lit_last_lit = fv.is_lit;
            c_lit_last_ival = fv.ival;
            if (sem_struct_lit_field(c_lit_tid, fidx) != 0) {
                return -1;
            }
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            if (p_cur() == TK_RBRACE) {
                break;
            }
            continue;
        }
        break;
    }
    return 0;
}

// ============================================================================
// parse_stmt.yh —— 自举编译器：语句解析（语义钩子集成）
//
// 覆盖 docs/yh.g4 的 stmt 及其分支。语句边界由显式 ';' 钉死；以块收尾
// 的语句不带尾分号；标签必须后随被标记的语句。
//
// 赋值语句的 LHS 识别：进入表达式语句前先做一次 token 级扫描——在深度
// 0、';' 之前出现赋值运算符即赋值语句（g4：exprStmt 是唯一的赋值位置）。
// LHS 以 lvalue 模式解析出地址并存入临时槽（地址只计算一次），RHS 求值
// 后由 sem_assign 完成取改存。
//
// 编译模式的控制流全部落到 em_* 标签原语：if/else 与三元同构；for 的
// 三种形态统一为「条件标签 + 体 + 回跳」；switch 用比较链（无 fallthrough，
// 控制值存专用槽，case 值要求编译期常量）。
// ============================================================================

// scan_assign_ahead：从当前 token 扫描到 ';'，返回深度 0 处首个赋值
// 运算符的 token 种类；无则返回 0。括号/花括号/方括号内不视为顶层。
pub fn scan_assign_ahead() int {
    let i int = c_pos;
    let depth int = 0;
    for i < c_tok_n {
        let k int = c_toks[i].kind;
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            depth -= 1;
        }
        if (depth <= 0 && is_assign_op(k) != 0) {
            return k;
        }
        if (depth == 0 && (k == TK_SEMI || k == TOK_EOF)) {
            return 0;
        }
        i += 1;
    }
    return 0;
}

// sem_check_cond：条件上下文类型检查（标量且非浮点）。
pub fn sem_check_cond(r *Res) int {
    if (c_compile == 0) {
        return 0;
    }
    if (ty_is_scalar(r.type_id) == 0) {
        return sem_err("条件必须是标量");
    }
    if (ty_is_float(r.type_id) != 0) {
        return sem_err("浮点不能作条件（用 != 0 比较）");
    }
    return 0;
}

// parse_block：'{' stmt* '}'。
pub fn parse_block() int {
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    scope_push();
    for p_cur() != TK_RBRACE && p_cur() != TOK_EOF {
        if (parse_stmt() != 0) {
            return -1;
        }
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    scope_pop();
    return 0;
}

// parse_stmt：语句分发。
pub fn parse_stmt() int {
    let k int = p_cur();
    if (k == TK_LBRACE) {
        return parse_block();
    }
    if (k == TK_STRUCT || k == TK_UNION || k == TK_ENUM || k == TK_TYPE) {
        // 函数体内嵌套类型声明：登记布局与顶层一致（类型表全局可见）
        c_nested_type = 1;
        let tdr int = 0;
        if (k == TK_STRUCT || k == TK_UNION) {
            tdr = parse_struct_decl();
        } else if (k == TK_ENUM) {
            tdr = parse_enum_decl();
        } else {
            tdr = parse_type_decl();
        }
        c_nested_type = 0;
        return tdr;
    }
    if (k == TK_LET) {
        return parse_let_decl(0);
    }
    if (k == TK_CONST) {
        return parse_const_decl(0);
    }
    if (k == TK_IF) {
        return parse_if();
    }
    if (k == TK_FOR) {
        return parse_for();
    }
    if (k == TK_SWITCH) {
        return parse_switch();
    }
    if (k == TK_RETURN) {
        return parse_return();
    }
    if (k == TK_BREAK || k == TK_CONTINUE) {
        p_adv();
        let br int = 0;
        if (k == TK_BREAK) {
            br = sem_break();
        } else {
            br = sem_continue();
        }
        if (br != 0) {
            return -1;
        }
        return p_expect(TK_SEMI, "期望 ';'");
    }
    if (k == TK_GOTO) {
        p_adv();
        if (p_cur() != TOK_IDENT) {
            return err_tok("goto 后需要标签名");
        }
        let gstart int = c_toks[c_pos].start;
        let glen int = c_toks[c_pos].len;
        p_adv();
        if (sem_goto(gstart, glen) != 0) {
            return -1;
        }
        return p_expect(TK_SEMI, "期望 ';'");
    }
    // 标签语句：IDENT ':' stmt
    if (k == TOK_IDENT && p_peek(1) == TK_COLON) {
        let lstart int = c_toks[c_pos].start;
        let llen int = c_toks[c_pos].len;
        p_adv();
        p_adv();
        if (sem_deflabel(lstart, llen) != 0) {
            return -1;
        }
        return parse_stmt();
    }
    // 表达式语句 / 单目标赋值
    let aop int = scan_assign_ahead();
    if (aop != 0) {
        let lres Res;
        let save int = c_lvalue;
        c_lvalue += 1;
        let r int = parse_expr(&lres);
        c_lvalue = save;
        if (r != 0) {
            return -1;
        }
        if (c_compile != 0 && c_res_is_addr == 0) {
            return sem_err("赋值目标必须是可寻址的表达式");
        }
        // 消费赋值运算符
        p_adv();
        if (sem_stash_lvalue() != 0) {
            return -1;
        }
        // RHS 恒为值上下文（清 c_lvalue，避免 s[i] 被取地址）；
        // 数组/切片字面量以左值类型为目标类型上下文
        let rres Res;
        let save_lv2 int = c_lvalue;
        c_lvalue = 0;
        let save_exp int = c_expect_tid;
        c_expect_tid = lres.type_id;
        let rr int = parse_expr(&rres);
        c_expect_tid = save_exp;
        c_lvalue = save_lv2;
        if (rr != 0) {
            return -1;
        }
        if (c_compile != 0) {
            if (sem_can_assign(lres.type_id, rres.type_id, rres.is_lit, rres.ival, rres.lit_big) != 0) {
                return -1;
            }
            // RHS 值压栈，供 sem_assign 弹出（与 sem_assign 的取改存协议配套）
            if (em_push() != 0) {
                return -1;
            }
            if (sem_assign(aop, &lres, &rres) != 0) {
                return -1;
            }
        }
        return p_expect(TK_SEMI, "期望 ';'");
    }
    let res Res;
    if (parse_expr(&res) != 0) {
        return -1;
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

// parse_return：'return' expr? ';'。返回类型检查与收尾跳转由 sem 层管理。
pub fn parse_return() int {
    p_adv();
    if (c_compile != 0) {
        if (c_fn_ret == TY_VOID && p_cur() != TK_SEMI) {
            return sem_err("void 函数不能返回值");
        }
        if (c_fn_ret != TY_VOID && p_cur() == TK_SEMI) {
            return sem_err("非 void 函数必须返回值");
        }
    }
    if (p_cur() != TK_SEMI) {
        let r Res;
        if (parse_expr(&r) != 0) {
            return -1;
        }
        if (c_compile != 0) {
            if (sem_can_assign(c_fn_ret, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
                return -1;
            }
            if (sem_return_value(&r) != 0) {
                return -1;
            }
        }
    } else {
        if (c_compile != 0) {
            if (em_jmp(c_fn_lbl) != 0) {
                return -1;
            }
        }
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

// parse_if：'if' '(' expr ')' block ('else' (ifStmt | block))?。
pub fn parse_if() int {
    p_adv();
    if (p_expect(TK_LPAREN, "if 条件必须带括号") != 0) {
        return -1;
    }
    let cond Res;
    if (parse_expr_iso(&cond) != 0) {
        return -1;
    }
    if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
        return -1;
    }
    if (sem_check_cond(&cond) != 0) {
        return -1;
    }
    let lbl_else int = 0;
    let lbl_end int = 0;
    if (c_compile != 0) {
        lbl_else = em_new_label();
        if (em_jz(lbl_else) != 0) {
            return -1;
        }
    }
    if (parse_block() != 0) {
        return -1;
    }
    if (p_cur() == TK_ELSE) {
        p_adv();
        if (c_compile != 0) {
            lbl_end = em_new_label();
            if (em_jmp(lbl_end) != 0) {
                return -1;
            }
            if (em_label(lbl_else) != 0) {
                return -1;
            }
        }
        if (p_cur() == TK_IF) {
            if (parse_if() != 0) {
                return -1;
            }
        } else {
            if (parse_block() != 0) {
                return -1;
            }
        }
        if (c_compile != 0) {
            if (em_label(lbl_end) != 0) {
                return -1;
            }
        }
        return 0;
    }
    if (c_compile != 0) {
        if (em_label(lbl_else) != 0) {
            return -1;
        }
    }
    return 0;
}

// parse_for：三种形态（无限 / 条件 / for-in）。
pub fn parse_for() int {
    p_adv();
    if (p_cur() == TK_LBRACE) {
        // 无限循环
        let ibrk int = em_new_label();
        let iend int = em_new_label();
        if (c_compile != 0) {
            if (sem_loop_push(iend, ibrk) != 0) {
                return -1;
            }
            if (em_label(ibrk) != 0) {
                return -1;
            }
        }
        if (parse_block() != 0) {
            return -1;
        }
        if (c_compile != 0) {
            if (em_jmp(ibrk) != 0) {
                return -1;
            }
            if (em_label(iend) != 0) {
                return -1;
            }
            sem_loop_pop();
        }
        return 0;
    }
    if (p_cur() == TOK_IDENT) {
        // for-in 形态：语法全保留；编译模式 B7 提供
        let is_in int = 0;
        if (p_peek(1) == TK_IN) {
            is_in = 1;
        }
        if (p_peek(1) == TK_COMMA && p_peek(2) == TOK_IDENT && p_peek(3) == TK_IN) {
            is_in = 1;
        }
        if (is_in != 0) {
            // 解析绑定：for v in ...  或 for i, v in ...
            let idx_start int = -1;
            let idx_len int = -1;
            let elem_start int = -1;
            let elem_len int = -1;
            if (p_peek(1) == TK_IN) {
                // 只有元素绑定
                elem_start = c_toks[c_pos].start;
                elem_len = c_toks[c_pos].len;
                p_adv();
                p_adv();
            } else {
                // 下标 + 元素绑定
                idx_start = c_toks[c_pos].start;
                idx_len = c_toks[c_pos].len;
                p_adv();
                p_adv();
                elem_start = c_toks[c_pos].start;
                elem_len = c_toks[c_pos].len;
                p_adv();
                p_adv();
            }
            let it Res;
            if (parse_expr_blockctx(&it) != 0) {
                return -1;
            }
            let is_range int = 0;
            let end_res Res;
            let start_off int = 0;
            if (p_cur() == TK_RANGE) {
                is_range = 1;
                // 起点（x0）先存槽，再求终点
                if (c_compile != 0) {
                    start_off = em_alloc_local(8);
                    if (em_lea_local_to(start_off) != 0) { return -1; }
                    if (em_ins("str\tx0, [x10]") != 0) { return -1; }
                }
                p_adv();
                if (parse_expr_blockctx(&end_res) != 0) {
                    return -1;
                }
            }
            if (c_compile == 0) {
                return parse_block();
            }
            // 编译模式：建立迭代层
            if (is_range != 0) {
                if (sem_check_cond(&it) != 0) { return -1; }
                if (sem_check_cond(&end_res) != 0) { return -1; }
                // 终点（x0）存临时槽
                c_end_tmp_off = em_alloc_local(8);
                if (em_lea_local_to(c_end_tmp_off) != 0) { return -1; }
                if (em_ins("str\tx0, [x10]") != 0) { return -1; }
            }
            let lcond int = em_new_label();
            let lend int = em_new_label();
            if (sem_loop_push(lend, lcond) != 0) { return -1; }
            scope_push();
            if (is_range != 0) {
                // 起点从槽读回 x0，然后启动区间迭代
                if (em_lea_local_to(start_off) != 0) { return -1; }
                if (em_ins("ldr\tx0, [x10]") != 0) { return -1; }
                if (sem_forin_begin(&it, 1, &end_res) != 0) { return -1; }
            } else {
                if (sem_forin_begin(&it, 0, &end_res) != 0) { return -1; }
            }
            // 绑定声明为局部（值拷贝）
            let eoff int = -1;
            let ioff int = -1;
            if (elem_start >= 0) {
                let etid int = sem_forin_elem_type(&it, is_range);
                let esym int = sem_declare_local(elem_start, elem_len, etid);
                if (esym < 0) { return -1; }
                eoff = c_syms[esym].offset;
            }
            if (idx_start >= 0) {
                let isym int = sem_declare_local(idx_start, idx_len, TY_I32);
                if (isym < 0) { return -1; }
                ioff = c_syms[isym].offset;
            }
            if (sem_forin_set_bind(eoff, ioff) != 0) { return -1; }
            if (em_label(lcond) != 0) { return -1; }
            if (sem_forin_check(lend) != 0) { return -1; }
            if (sem_forin_load(&it, is_range) != 0) { return -1; }
            if (parse_block() != 0) { return -1; }
            if (sem_forin_step(lcond) != 0) { return -1; }
            if (em_label(lend) != 0) { return -1; }
            scope_pop();
            sem_forin_end();
            sem_loop_pop();
            return 0;
        }
    }
    // 条件循环
    let lbl_cond int = em_new_label();
    let lbl_end int = em_new_label();
    if (c_compile != 0) {
        if (sem_loop_push(lbl_end, lbl_cond) != 0) {
            return -1;
        }
        if (em_label(lbl_cond) != 0) {
            return -1;
        }
    }
    let cond Res;
    if (parse_expr_blockctx(&cond) != 0) {
        return -1;
    }
    if (c_compile != 0) {
        if (sem_check_cond(&cond) != 0) {
            return -1;
        }
        if (em_jz(lbl_end) != 0) {
            return -1;
        }
    }
    if (parse_block() != 0) {
        return -1;
    }
    if (c_compile != 0) {
        if (em_jmp(lbl_cond) != 0) {
            return -1;
        }
        if (em_label(lbl_end) != 0) {
            return -1;
        }
        sem_loop_pop();
    }
    return 0;
}

// parse_switch：'switch' expr '{' case 块* '}'。
// 控制值存专用槽；case 值要求编译期常量；无 fallthrough。
// 发射结构（每个 case）：
//   [比较值 v_i: ctrl==v_i → 跳 body]… 全不匹配 → 跳过块体到 next
//   body: 块体 → 跳 end
//   next:（下一个 case 的比较链开始处）
// default 分支的块体无条件执行（排在源码位置）。
pub fn parse_switch() int {
    p_adv();
    let ctrl Res;
    if (parse_expr_blockctx(&ctrl) != 0) {
        return -1;
    }
    let slot int = 0;
    if (c_compile != 0) {
        if (ty_is_integer(ctrl.type_id) == 0) {
            return sem_err("switch 控制值必须是整数");
        }
        slot = em_alloc_local(8);
        if (em_lea_local_to(slot) != 0) {
            return -1;
        }
        if (em_ins("str\tx0, [x10]") != 0) {
            return -1;
        }
    }
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    let lbl_end int = em_new_label();
    let ncases int = 0;
    for p_cur() == TK_CASE || p_cur() == TK_DEFAULT {
        let body_lbl int = em_new_label();
        let skip_lbl int = em_new_label();
        let is_case int = (p_cur() == TK_CASE).to_type(int);
        if (is_case != 0) {
            p_adv();
            for 1 {
                let cv Res;
                if (c_compile != 0) {
                    c_fold += 1;
                }
                let r int = parse_expr_blockctx(&cv);
                if (c_compile != 0) {
                    c_fold -= 1;
                }
                if (r != 0) {
                    return -1;
                }
                if (c_compile != 0) {
                    if (cv.is_const == 0) {
                        return sem_err("case 值必须是编译期常量");
                    }
                    ncases += 1;
                    if (ncases > 512) {
                        return sem_err("switch 分支过多（上限 512 个 case 值）");
                    }
                    // 控制值 → x0，与常量比较；命中跳 body
                    if (em_lea_local_to(slot) != 0) {
                        return -1;
                    }
                    if (em_ins("ldr\tx0, [x10]") != 0) {
                        return -1;
                    }
                    let v int = cv.ival.to_type(int);
                    if (v >= 0 && v <= 4095) {
                        if (em_frag("\tcmp\tx0, #") != 0) {
                            return -1;
                        }
                        if (em_puti(v) != 0) {
                            return -1;
                        }
                        if (em_frag("\n") != 0) {
                            return -1;
                        }
                    } else {
                        if (em_mov_imm("x10", cv.ival) != 0) {
                            return -1;
                        }
                        if (em_ins("cmp\tx0, x10") != 0) {
                            return -1;
                        }
                    }
                    if (em_beq(body_lbl) != 0) {
                        return -1;
                    }
                }
                if (p_cur() == TK_COMMA) {
                    p_adv();
                    continue;
                }
                break;
            }
            // 本 case 的值全部未命中 → 跳过块体
            if (c_compile != 0) {
                if (em_jmp(skip_lbl) != 0) {
                    return -1;
                }
                if (em_label(body_lbl) != 0) {
                    return -1;
                }
            }
        } else {
            p_adv();
        }
        if (parse_block() != 0) {
            return -1;
        }
        if (c_compile != 0) {
            if (em_jmp(lbl_end) != 0) {
                return -1;
            }
            if (is_case != 0) {
                if (em_label(skip_lbl) != 0) {
                    return -1;
                }
            }
        }
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (c_compile != 0) {
        if (em_label(lbl_end) != 0) {
            return -1;
        }
    }
    return 0;
}

// ============================================================================
// parse_decl.yh —— 自举编译器：顶层声明与源文件入口（两遍驱动）
//
// 覆盖 docs/yh.g4 的 sourceFile / topLevelDecl / topLevelDeclBody，以及
// letDecl、constDecl、fnDecl、paramList、param、typeDecl、structDecl、
// unionDecl、fieldDecl、enumDecl、enumItem。
//
// 两遍模型（语义边界 §1）：
//   pass 1（c_pass==1）  登记类型/字段/函数签名/全局名字，函数体与全局
//                        初始化表达式整块跳过（token 扫描）；
//   pass 2a              仅处理顶层 let/const：折叠初始化并发射数据；
//   pass 2b              仅处理 fn：逐个编译函数体。
// 语法模式（c_compile==0）单遍消费到 EOF，行为与 G1 一致。
//
// 编译模式的限制（B5 子集，B7 解除）：切片、for-in、结构体字面量作值、
// 结构体按值传参/返回/拷贝、类型化变参、用户裸变参、浮点运算。
// ============================================================================

// skip_to_decl_end：pass 1 跳过一条顶层声明的剩余 token。
// 以深度 0 处的 ';' 或 '}'（fn/struct/enum 体收尾）为界。

pub fn skip_to_decl_end() int {
    let depth int = 0;
    for p_cur() != TOK_EOF {
        let k int = p_cur();
        p_adv();
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
            continue;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            if (depth == 0) {
                return 0;
            }
            depth -= 1;
            if (depth == 0 && k == TK_RBRACE) {
                return 0;
            }
            continue;
        }
        if (k == TK_SEMI && depth == 0) {
            return 0;
        }
    }
    return 0;
}

pub fn skip_init() int {
    let depth int = 0;
    for 1 {
        let k int = p_cur();
        if (k == TOK_EOF) {
            return 0;
        }
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            depth -= 1;
        }
        if (depth == 0 && (k == TK_COMMA || k == TK_SEMI)) {
            return 0;
        }
        p_adv();
    }
    return 0;
}

pub fn parse_source() int {
    if (mod_parse_head() != 0) {
        return -1;
    }
    for p_cur() != TOK_EOF {
        if (p_cur() == TK_MODULE) {
            return err_tok("module 声明必须在文件头部且只能出现一次");
        }
        if (p_cur() == TK_IMPORT) {
            return err_tok("import 声明必须在文件头部（module 之后、业务声明之前）");
        }
        if (parse_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn at_top_decl_start(k int) int {
    if (k == TK_LET || k == TK_CONST || k == TK_FN || k == TK_TYPE
        || k == TK_STRUCT || k == TK_UNION || k == TK_ENUM) {
        return 1;
    }
    return 0;
}

pub fn skip_top_decl() int {
    let depth int = 0;
    let consumed int = 0;
    for p_cur() != TOK_EOF {
        let k int = p_cur();
        if (consumed > 0 && depth == 0 && at_top_decl_start(k) != 0) {
            return 0;
        }
        p_adv();
        consumed = 1;
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_LBRACE) {
            depth += 1;
            continue;
        }
        if (k == TK_RPAREN || k == TK_RBRACKET || k == TK_RBRACE) {
            if (depth > 0) {
                depth -= 1;
            }
            continue;
        }
        if (k == TK_SEMI && depth == 0) {
            return 0;
        }
    }
    return 0;
}

pub fn parse_source_globals() int {
    mod_skip_head();
    for p_cur() != TOK_EOF {
        if (p_cur() == TK_PUB) {
            c_decl_pub = 1;
            p_adv();
            if (p_cur() == TK_LET) {
                if (parse_let_decl(1) != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            if (p_cur() == TK_CONST) {
                if (parse_const_decl(1) != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            // pub + 其他：回退处理
            if (skip_top_decl() != 0) {
                return -1;
            }
            continue;
        }
        c_decl_pub = 0;
        if (p_cur() == TK_LET) {
            if (parse_let_decl(1) != 0) {
                return -1;
            }
            continue;
        }
        if (p_cur() == TK_CONST) {
            if (parse_const_decl(1) != 0) {
                return -1;
            }
            continue;
        }
        if (skip_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn parse_source_fns() int {
    mod_skip_head();
    for p_cur() != TOK_EOF {
        if (p_cur() == TK_PUB) {
            c_decl_pub = 1;
            p_adv();
            if (p_cur() == TK_FN) {
                if (parse_fn_decl() != 0) {
                    return -1;
                }
                c_decl_pub = 0;
                continue;
            }
            if (skip_top_decl() != 0) {
                return -1;
            }
            continue;
        }
        c_decl_pub = 0;
        if (p_cur() == TK_FN) {
            if (parse_fn_decl() != 0) {
                return -1;
            }
            continue;
        }
        if (skip_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

pub fn parse_top_decl() int {
    c_decl_pub = 0;
    if (p_cur() == TK_PUB) {
        c_decl_pub = 1;
        p_adv();
    }
    let k int = p_cur();
    if (k == TK_LET) {
        if (c_compile != 0 && c_pass == 2) {
            // pass 2 全量遍不走这里（globals/fns 子遍分工）
            return parse_let_decl(1);
        }
        return parse_let_decl(1);
    }
    if (k == TK_CONST) {
        return parse_const_decl(1);
    }
    if (k == TK_FN) {
        return parse_fn_decl();
    }
    if (k == TK_TYPE) {
        return parse_type_decl();
    }
    if (k == TK_STRUCT || k == TK_UNION) {
        return parse_struct_decl();
    }
    if (k == TK_ENUM) {
        return parse_enum_decl();
    }
    return err_tok("此处需要一个顶层声明");
}

pub fn parse_local_init(idx int, tid int, kind int) int {
    if (kind == SYM_CONST) {
        c_fold += 1;
        let cr Res;
        let crr int = parse_expr_iso(&cr);
        c_fold -= 1;
        if (crr != 0) {
            return -1;
        }
        if (cr.is_const == 0) {
            return sem_err("const 初始化必须是编译期常量");
        }
        if (sem_can_assign(tid, cr.type_id, cr.is_lit, cr.ival, cr.lit_big) != 0) {
            return -1;
        }
        c_syms[idx].cval = cr.ival;
        if (t_types[tid].kind == TY_PTR) {
            c_syms[idx].flags |= F_ADDR;
        }
        return 0;
    }
    let r Res;
    // 数组/切片字面量依赖目标类型上下文
    let save_exp int = c_expect_tid;
    c_expect_tid = tid;
    let prr int = parse_expr_iso(&r);
    c_expect_tid = save_exp;
    if (prr != 0) {
        return -1;
    }
    if (sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1;
    }
    return sem_store_local_value(idx, tid);
}

pub fn parse_let_decl(global int) int {
    p_adv();
    for 1 {
        if (parse_binding(global, SYM_VAR) != 0) {
            return -1;
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            continue;
        }
        break;
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

pub fn parse_const_decl(global int) int {
    p_adv();
    for 1 {
        if (parse_binding(global, SYM_CONST) != 0) {
            return -1;
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            continue;
        }
        break;
    }
    return p_expect(TK_SEMI, "期望 ';'");
}

pub fn parse_fn_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个函数名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (p_expect(TK_LPAREN, "期望 '('") != 0) {
        return -1;
    }
    // 参数类型收集（两遍都要）
    let ptypes [64]int;
    let np int = 0;
    let vararg int = 0;
    let is_variadic_seen int = 0;
    let pnames [64]int;
    let pname_lens [64]int;
    if (p_cur() != TK_RPAREN) {
        for 1 {
            if (p_cur() == TK_ELLIPSIS) {
                p_adv();
                vararg = 1;
                if (c_compile != 0) {
                    return sem_err("用户源码不允许裸变参（仅 prelude）");
                }
                break;
            }
            if (p_cur() != TOK_IDENT) {
                return err_tok("此处需要一个参数名");
            }
            let ps int = c_toks[c_pos].start;
            let pn int = c_toks[c_pos].len;
            p_adv();
            let ptid int = 0;
            if (p_cur() == TK_ELLIPSIS) {
                // 类型化变参 name ... T：体内类型为 []T（打包为切片）
                p_adv();
                ptid = parse_type_ref();
                if (ptid < 0) {
                    return -1;
                }
                if (c_compile != 0) {
                    if (is_variadic_seen != 0) {
                        return sem_err("类型化变参至多一个且在末尾");
                    }
                    is_variadic_seen = 1;
                    ptid = ty_slice(ptid);
                }
            } else {
                ptid = parse_type_ref();
                if (ptid < 0) {
                    return -1;
                }
            }
            if (np >= 64) {
                return err_tok("参数过多");
            }
            pnames[np] = ps;
            pname_lens[np] = pn;
            ptypes[np] = ptid;
            np += 1;
            if (p_cur() == TK_COMMA) {
                p_adv();
                continue;
            }
            break;
        }
    }
    if (p_expect(TK_RPAREN, "期望 ')'") != 0) {
        return -1;
    }
    let ret int = TY_VOID;
    if (is_type_start(p_cur()) != 0) {
        let rt int = parse_type_ref();
        if (rt < 0) {
            return -1;
        }
        ret = rt;
    }
    if (c_compile == 0) {
        // 语法模式：必须带函数体（rejected/12）
        return parse_block();
    }
    // 编译模式
    if (c_pass == 1) {
        // 登记函数符号与签名（重复时报告首次声明位置）
        let prev int = sym_lookup(start, n);
        if (prev >= 0) {
            let buf [128]u8;
            let bn int = 0;
            bn = append_str(buf, bn, "顶层符号重定义（首次声明于 ");
            bn = append_int(buf, bn, c_syms[prev].def_line);
            bn = append_byte(buf, bn, ':');
            bn = append_int(buf, bn, c_syms[prev].def_col);
            bn = append_str(buf, bn, "）");
            let mo int = tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            return sem_err(np_cstr(mo));
        }
        let first int = t_sigparam_n;
        let i int = 0;
        for i < np {
            ty_sig_param(ptypes[i]);
            i += 1;
        }
        let sig_np int = np;
        let sig_va int = vararg;
        if (is_variadic_seen != 0) {
            sig_np = np - 1;
            sig_va = 2;
        }
        let ftid int = ty_fn(ret, first, sig_np, sig_va);
        let fl int = F_GLOBAL;
        if (c_decl_pub != 0) {
            fl |= F_PUB;
        }
        let idx int = sym_push(start, n, SYM_FN, ftid, fl);
        if (idx < 0) {
            return -1;
        }
        // main 的 ELF 符号保持 GLOBAL（crt1 引用），无论是否书写 pub。
        // 模块模式下仅入口模块的 main 裸名导出；其他模块的 main 是
        // 普通符号（按 pub 修饰决定绑定，符号名带模块后缀）。
        if (n == 4 && c_src[start] == 'm' && c_src[start + 1] == 'a'
            && c_src[start + 2] == 'i' && c_src[start + 3] == 'n'
            && (c_module_mode == 0 || c_is_entry_mod != 0)) {
            c_syms[idx].flags |= F_PUB;
        }
        // 跳过函数体
        if (p_cur() != TK_LBRACE) {
            return err_tok("fn 必须带函数体");
        }
        return skip_to_decl_end();
    }
    // pass 2：编译函数体
    let fidx int = sym_lookup(start, n);
    if (fidx < 0) {
        return sem_err("内部错误：函数符号丢失");
    }
    if (sem_fn_begin(fidx) != 0) {
        return -1;
    }
    let fi int = 0;
    // AAPCS64 整型与浮点参数寄存器各自独立计数：整型进 x0..x7、浮点进
    // d0..d7。因此给每个参数定位寄存器时，必须用「它在本类型中的序号」
    // 而非形参表中的位置（否则 `scale(v f64, k int)` 的 k 会错误地读 x1）。
    let ipos int = 0;
    let fpos int = 0;
    for fi < np {
        if (sem_check_duplicate(pnames[fi], pname_lens[fi]) != 0) {
            return -1;
        }
        let apos int = ipos;
        if (ty_is_float(ptypes[fi]) != 0) {
            apos = fpos;
            fpos += 1;
        } else {
            ipos += 1;
        }
        if (sem_declare_param(pnames[fi], pname_lens[fi], ptypes[fi], apos) != 0) {
            return -1;
        }
        fi += 1;
    }
    if (parse_block() != 0) {
        return -1;
    }
    if (sem_fn_end() != 0) {
        return -1;
    }
    return 0;
}

pub fn parse_type_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (p_expect(TK_ASSIGN, "期望 '='") != 0) {
        return -1;
    }
    let tid int = parse_type_ref();
    if (tid < 0) {
        return -1;
    }
    if (p_expect(TK_SEMI, "期望 ';'") != 0) {
        return -1;
    }
    if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        c_name_form = 0;
        return ty_declare_name(off, n, tid);
    }
    return 0;
}

pub fn parse_struct_decl() int {
    let is_union int = (p_cur() == TK_UNION).to_type(int);
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
        // 预登记名字（自引用指针字段需要）；嵌套声明在 pass 2 同样登记
        let stid int = ty_push(TY_STRUCT, 0, 0, -1, 0, t_field_n);
        if (stid < 0) {
            return -1;
        }
        if (is_union != 0) {
            t_types[stid].kind = TY_UNION;
        }
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        c_name_form = is_union + 1;
        if (ty_declare_name(off, n, stid) != 0) {
            return -1;
        }
        c_cur_struct = stid;
    }
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    for p_cur() != TK_RBRACE && p_cur() != TOK_EOF {
        // pub 字段前缀（MOD-U1）：可见性登记，布局与访问不做区分
        let fpub int = 0;
        if (p_cur() == TK_PUB) {
            fpub = 1;
            p_adv();
        }
        if (is_member_name(p_cur()) == 0) {
            return err_tok("此处需要一个字段名");
        }
        let fstart int = c_toks[c_pos].start;
        let fn2 int = c_toks[c_pos].len;
        p_adv();
        let ftid int = parse_type_ref();
        if (ftid < 0) {
            return -1;
        }
        if (p_expect(TK_SEMI, "期望 ';'") != 0) {
            return -1;
        }
        if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
            if (sem_add_field(c_cur_struct, fstart, fn2, ftid, fpub) != 0) {
                return -1;
            }
        }
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
        return sem_struct_finish(c_cur_struct, is_union);
    }
    return 0;
}

pub fn parse_enum_decl() int {
    p_adv();
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个枚举类型名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
        let etid int = ty_push(TY_ENUM, TG_ENUM_SIZE, 4, -1, -1, -1);
        if (etid < 0) {
            return -1;
        }
        t_cur_enum = etid;
        let off int = name_intern(start, n);
        if (off < 0) {
            return -1;
        }
        c_name_form = 3;
        if (ty_declare_name(off, n, etid) != 0) {
            return -1;
        }
        c_enum_next = 0;
    }
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    for p_cur() != TK_RBRACE && p_cur() != TOK_EOF {
        if (p_cur() != TOK_IDENT) {
            return err_tok("此处需要一个枚举成员名");
        }
        let istart int = c_toks[c_pos].start;
        let in2 int = c_toks[c_pos].len;
        p_adv();
        let has_val int = 0;
        let v Res;
        if (p_cur() == TK_ASSIGN) {
            p_adv();
            has_val = 1;
            if (c_compile != 0) {
                c_fold += 1;
            }
            let r int = parse_expr_iso(&v);
            if (c_compile != 0) {
                c_fold -= 1;
            }
            if (r != 0) {
                return -1;
            }
        }
        if (p_expect(TK_SEMI, "期望 ';'") != 0) {
            return -1;
        }
        if (c_compile != 0 && (c_pass == 1 || c_nested_type != 0)) {
            let val i64 = c_enum_next.to_type(i64);
            if (has_val != 0) {
                if (v.is_const == 0) {
                    return sem_err("枚举判别值必须是编译期常量");
                }
                val = v.ival;
            }
            let idx int = sym_push(istart, in2, SYM_CONST, t_cur_enum, F_GLOBAL);
            if (idx < 0) {
                return -1;
            }
            c_syms[idx].cval = val;
            c_enum_next = val.to_type(int) + 1;
        }
    }
    return p_expect(TK_RBRACE, "期望 '}'");
}


// ============================================================================
// parse_global_init.yh —— 绑定与全局初始化
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================


// ---- 绑定与初始化 ----

// parse_binding：名字 + 必需类型 + 可选初值。kind：SYM_VAR / SYM_CONST。
// global=1 为顶层绑定（pass1 登记 / pass2 折叠发射），global=0 为局部。
// 通过 c_bind_idx 返回涉及的符号下标（无则为 -1）。
pub let c_bind_idx int = -1;
pub fn parse_binding(global int, kind int) int {
    c_bind_idx = -1;
    if (p_cur() != TOK_IDENT) {
        return err_tok("此处需要一个变量名");
    }
    let start int = c_toks[c_pos].start;
    let n int = c_toks[c_pos].len;
    p_adv();
    let tid int = parse_type_ref();
    if (tid < 0) {
        return -1;
    }
    if (c_compile == 0) {
        // 语法模式：只看初值形态
        if (p_cur() == TK_ASSIGN) {
            p_adv();
            let r Res;
            if (parse_expr_iso(&r) != 0) {
                return -1;
            }
        }
        return 0;
    }
    // 编译模式
    let idx int = -1;
    if (c_pass == 1) {
        // 顶层登记：标量/聚合（结构体/数组/切片）一律登记名字与类型；
        // 零初始化聚合在 pass 2 走 .bss，带初始化器的聚合走
        // parse_global_init 的数据发射。
        let fl int = F_GLOBAL;
        if (c_decl_pub != 0) {
            fl |= F_PUB;
        }
        idx = sym_push(start, n, kind, tid, fl);
        if (idx < 0) {
            return -1;
        }
    } else if (global != 0) {
        idx = sym_lookup(start, n);
        if (idx < 0) {
            return sem_err("内部错误：全局符号丢失");
        }
    } else {
        // 局部
        if (sem_check_duplicate(start, n) != 0) {
            return -1;
        }
        if (kind == SYM_CONST) {
            idx = sym_push(start, n, SYM_CONST, tid, 0);
        } else {
            idx = sem_declare_local(start, n, tid);
        }
        if (idx < 0) {
            return -1;
        }
    }
    c_bind_idx = idx;
    if (p_cur() == TK_ASSIGN) {
        p_adv();
        if (c_pass == 1) {
            return skip_init();
        }
        if (global != 0) {
            return parse_global_init(idx, tid, kind);
        }
        return parse_local_init(idx, tid, kind);
    }
    // 无初值
    if (c_compile != 0 && kind == SYM_CONST) {
        return sem_err("const 必须带初值");
    }
    if (c_compile != 0 && c_pass == 2 && global != 0 && kind == SYM_VAR) {
        // 零初始化全局 → .bss
        return sem_global_zero(idx, tid);
    }
    return 0;
}

pub fn parse_global_init(idx int, tid int, kind int) int {
    let fk int = t_types[tid].kind;
    if (fk == TY_STRUCT) {
        if (kind == SYM_CONST) {
            return sem_err("const 不支持聚合类型");
        }
        return parse_global_struct_init(idx, tid);
    }
    if (fk == TY_UNION) {
        return sem_err("union 全局初始化暂不支持");
    }
    if (fk == TY_ARRAY || fk == TY_SLICE) {
        if (p_cur() != TK_LBRACKET) {
            return sem_err("全局数组/切片初始化仅支持字面量（零初始化可用）");
        }
        if (kind == SYM_CONST) {
            return sem_err("const 不支持聚合类型");
        }
        return parse_global_array_init(idx, tid, fk);
    }
    c_fold += 1;
    let r Res;
    let rr int = parse_expr_iso(&r);
    c_fold -= 1;
    if (rr != 0) {
        return -1;
    }
    if (r.is_const == 0) {
        return sem_err("全局初始化必须是编译期常量");
    }
    if (sem_can_assign(tid, r.type_id, r.is_lit, r.ival, r.lit_big) != 0) {
        return -1;
    }
    if (kind == SYM_CONST) {
        c_syms[idx].cval = r.ival;
        if (fk == TY_PTR) {
            c_syms[idx].flags |= F_ADDR;
        }
        return 0;
    }
    // 全局变量：指针的 0 是 NULL（.xword 0）；标签号 ≥ 1 才是字符串地址
    if (fk == TY_PTR) {
        if (r.ival == 0) {
            if (c_bss_n >= 4096) {
                return sem_err("零初始化全局过多");
            }
            c_syms[idx].offset = c_bss_n;
            c_bss_syms[c_bss_n] = idx;
            c_bss_n += 1;
            return 0;
        }
        if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
            return -1;
        }
        if (dat_puts(".xword\t.LD") != 0) {
            return -1;
        }
        if (dat_puti(r.ival.to_type(int)) != 0) {
            return -1;
        }
        return dat_put('\n');
    }
    if (r.ival == 0) {
        if (c_bss_n >= 4096) {
            return sem_err("零初始化全局过多");
        }
        c_syms[idx].offset = c_bss_n;
        c_bss_syms[c_bss_n] = idx;
        c_bss_n += 1;
        return 0;
    }
    if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
        return -1;
    }
    return em_data_scalar(tid, r.ival);
}

pub fn sem_global_zero(idx int, tid int) int {
    if (c_iface_load != 0) {
        return 0;
    }
    if (c_bss_n >= 4096) {
        return sem_err("零初始化全局过多");
    }
    c_syms[idx].offset = c_bss_n;
    c_bss_syms[c_bss_n] = idx;
    c_bss_n += 1;
    return 0;
}

pub fn parse_global_array_init(idx int, tid int, fk int) int {
    let elem int = t_types[tid].elem;
    let esz int = t_types[elem].size;
    p_adv(); // 消费 '['
    let vals [64]i64;      // 整数值 / f64 位型
    let kinds [64]int;     // 0=标量 1=字符串
    let str_start [64]int; // 字符串源码区间（内容在元素槽之后补发）
    let str_len [64]int;
    let count int = 0;
    if (p_cur() != TK_RBRACKET) {
        for 1 {
            if (count >= 64) {
                return sem_err("全局数组字面量元素过多（上限 64）");
            }
            if (p_cur() == TOK_STRING) {
                // 字符串元素：预领标签号（内容在元素槽之后补发）
                let ss int = c_toks[c_pos].start;
                let sl int = c_toks[c_pos].len;
                p_adv();
                kinds[count] = 1;
                vals[count] = c_data_n.to_type(i64);
                c_data_n += 1;
                str_start[count] = ss;
                str_len[count] = sl;
                count += 1;
                if (p_cur() == TK_COMMA) {
                    p_adv();
                    if (p_cur() == TK_RBRACKET) { break; }
                    continue;
                }
                break;
            }
            c_fold += 1;
            let e Res;
            let er int = parse_expr_iso(&e);
            c_fold -= 1;
            if (er != 0) {
                return -1;
            }
            if (e.is_const == 0) {
                return sem_err("全局数组字面量元素必须是编译期常量");
            }
            if (sem_can_assign(elem, e.type_id, e.is_lit, e.ival, e.lit_big) != 0) {
                return -1;
            }
            if (ty_is_float(elem) != 0) {
                if (ty_is_float(e.type_id) == 0) {
                    return sem_err("浮点元素需要浮点字面量");
                }
                if (esz != 8) {
                    return sem_err("f32 元素的全局初始化暂不支持（请用 f64）");
                }
                vals[count] = e.fval_bits;
            } else {
                vals[count] = e.ival;
            }
            count += 1;
            if (p_cur() == TK_COMMA) {
                p_adv();
                if (p_cur() == TK_RBRACKET) { break; }
                continue;
            }
            break;
        }
    }
    if (p_expect(TK_RBRACKET, "期望 ']'") != 0) {
        return -1;
    }
    if (fk == TY_ARRAY && count != t_types[tid].len) {
        return sem_err("数组字面量元素个数与数组长度不一致");
    }
    // 发射变量数据
    let lbl int = 0;
    if (fk == TY_SLICE) {
        lbl = c_data_n;
        c_data_n += 1;
    }
    if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
        return -1;
    }
    if (fk == TY_SLICE) {
        // {count, .LDlbl}
        if (dat_puts(".xword\t") != 0) { return -1; }
        if (dat_puthex(count.to_type(i64)) != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
        if (dat_puts(".xword\t.LD") != 0) { return -1; }
        if (dat_puti(lbl) != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
        if (dat_puts(".balign\t") != 0) { return -1; }
        if (dat_puti(esz) != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
        if (dat_puts(".LD") != 0) { return -1; }
        if (dat_puti(lbl) != 0) { return -1; }
        if (dat_put(':') != 0) { return -1; }
        if (dat_put('\n') != 0) { return -1; }
    }
    let i int = 0;
    for i < count {
        if (kinds[i] == 1) {
            if (dat_puts(".xword\t.LD") != 0) { return -1; }
            if (dat_puti(vals[i].to_type(int)) != 0) { return -1; }
            if (dat_put('\n') != 0) { return -1; }
        } else if (ty_is_float(elem) != 0) {
            if (dat_puts(".xword\t") != 0) { return -1; }
            if (dat_puthex(vals[i]) != 0) { return -1; }
            if (dat_put('\n') != 0) { return -1; }
        } else {
            if (em_data_scalar(elem, vals[i]) != 0) { return -1; }
        }
        i += 1;
    }
    if (fk == TY_ARRAY) {
        let used int = esz * count;
        if (used < t_types[tid].size) {
            if (dat_puts(".zero\t") != 0) { return -1; }
            if (dat_puti(t_types[tid].size - used) != 0) { return -1; }
            if (dat_put('\n') != 0) { return -1; }
        }
    }
    // 补发字符串内容（标签号已在元素槽中引用）
    i = 0;
    for i < count {
        if (kinds[i] == 1) {
            if (em_data_string_body(str_start[i], str_len[i], vals[i].to_type(int)) < 0) {
                return -1;
            }
        }
        i += 1;
    }
    return 0;
}

pub fn parse_global_struct_init(idx int, tid int) int {
    if (p_cur() != TOK_IDENT) {
        return sem_err("全局结构体初始化需要「类型名 { 字段 }」字面量");
    }
    let nstart int = c_toks[c_pos].start;
    let nlen int = c_toks[c_pos].len;
    if (ty_lookup_name(nstart, nlen) != tid) {
        return sem_err("初始化器类型与变量类型不一致");
    }
    p_adv();
    if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
        return -1;
    }
    if (em_data_symbol_header(idx, t_types[tid].align) != 0) {
        return -1;
    }
    let cur int = 0;
    if (parse_global_struct_body(tid, 0, &cur) != 0) {
        return -1;
    }
    if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
        return -1;
    }
    if (cur < t_types[tid].size) {
        if (dat_puts(".zero\t") != 0) {
            return -1;
        }
        if (dat_puti(t_types[tid].size - cur) != 0) {
            return -1;
        }
        return dat_put('\n');
    }
    return 0;
}

pub fn parse_global_struct_body(tid int, base int, cur *int) int {
    if (p_cur() == TK_RBRACE) {
        return err_tok("结构体字面量不能为空");
    }
    let named int = 0;
    if (is_member_name(p_cur()) != 0 && p_peek(1) == TK_COLON) {
        named = 1;
    }
    let fpos int = 0;
    for 1 {
        let fidx int = -1;
        if (named != 0) {
            if (is_member_name(p_cur()) == 0) {
                return err_tok("命名式字面量需要字段名");
            }
            let fs int = c_toks[c_pos].start;
            let fl int = c_toks[c_pos].len;
            fidx = sem_lit_field_lookup(tid, fs, fl);
            if (fidx < 0) {
                return sem_err("结构体没有该字段");
            }
            p_adv();
            if (p_expect(TK_COLON, "期望 ':'") != 0) {
                return -1;
            }
        } else {
            if (fpos >= t_types[tid].len) {
                return sem_err("位置式字面量字段过多");
            }
            fidx = t_types[tid].sub + fpos;
            fpos += 1;
        }
        if (parse_global_field_value(fidx, base, cur) != 0) {
            return -1;
        }
        if (p_cur() == TK_COMMA) {
            p_adv();
            if (p_cur() == TK_RBRACE) {
                break;
            }
            continue;
        }
        break;
    }
    return 0;
}

pub fn parse_global_field_value(fidx int, base int, cur *int) int {
    let ftid int = t_fields[fidx].type_id;
    let foff int = base + t_fields[fidx].offset;
    if (foff > cur[0]) {
        // 字段间对齐间隙
        if (dat_puts(".zero\t") != 0) {
            return -1;
        }
        if (dat_puti(foff - cur[0]) != 0) {
            return -1;
        }
        if (dat_put('\n') != 0) {
            return -1;
        }
    }
    cur[0] = foff;
    let fk int = t_types[ftid].kind;
    if (fk == TY_STRUCT) {
        // 嵌套结构体字面量：IDENT '{' body '}'
        if (p_cur() != TOK_IDENT) {
            return sem_err("嵌套字段需要「类型名 { 字段 }」字面量");
        }
        let ns int = c_toks[c_pos].start;
        let nl int = c_toks[c_pos].len;
        if (ty_lookup_name(ns, nl) != ftid) {
            return sem_err("嵌套字面量类型与字段类型不一致");
        }
        p_adv();
        if (p_expect(TK_LBRACE, "期望 '{'") != 0) {
            return -1;
        }
        if (parse_global_struct_body(ftid, foff, cur) != 0) {
            return -1;
        }
        if (p_expect(TK_RBRACE, "期望 '}'") != 0) {
            return -1;
        }
        if (cur[0] < foff + t_types[ftid].size) {
            if (dat_puts(".zero\t") != 0) {
                return -1;
            }
            if (dat_puti(foff + t_types[ftid].size - cur[0]) != 0) {
                return -1;
            }
            if (dat_put('\n') != 0) {
                return -1;
            }
        }
        cur[0] = foff + t_types[ftid].size;
        return 0;
    }
    if (fk == TY_UNION) {
        return sem_err("union 字段的全局初始化暂不支持");
    }
    if (fk == TY_ARRAY || fk == TY_SLICE) {
        return sem_err("数组/切片字段的全局初始化暂不支持");
    }
    // 标量 / 指针 / 浮点：各分支自行折叠求值并发射
    let r int = 0;
    if (fk == TY_PTR) {
        if (p_cur() == TOK_STRING) {
            // 字符串字面量：先领标签号、发指针引用，再补内容——
            // 内容不能打断变量自身的字段布局（曾插进字段中间）。
            let ss int = c_toks[c_pos].start;
            let sl int = c_toks[c_pos].len;
            p_adv();
            let lbl int = c_data_n;
            c_data_n += 1;
            if (dat_puts(".xword\t.LD") != 0) {
                return -1;
            }
            if (dat_puti(lbl) != 0) {
                return -1;
            }
            if (dat_put('\n') != 0) {
                return -1;
            }
            // 注意 em_data_string_body 返回标签号（可能 >0），不是错误码
            if (em_data_string_body(ss, sl, lbl) < 0) {
                return -1;
            }
            r = 0;
        } else {
            c_fold += 1;
            let pv Res;
            let pr int = parse_expr_iso(&pv);
            c_fold -= 1;
            if (pr != 0) {
                return -1;
            }
            if (pv.is_const == 0) {
                return sem_err("全局初始化字段必须是编译期常量");
            }
            if (sem_can_assign(ftid, pv.type_id, pv.is_lit, pv.ival, pv.lit_big) != 0) {
                return -1;
            }
            if (pv.ival != 0) {
                return sem_err("指针字段全局初始化仅支持字符串与 NULL");
            }
            r = em_data_scalar(ftid, 0);
        }
    } else if (ty_is_float(ftid) != 0) {
        c_fold += 1;
        let fv2 Res;
        let fr int = parse_expr_iso(&fv2);
        c_fold -= 1;
        if (fr != 0) {
            return -1;
        }
        if (fv2.is_const == 0) {
            return sem_err("全局初始化字段必须是编译期常量");
        }
        if (ty_is_float(fv2.type_id) == 0) {
            return sem_err("浮点字段需要浮点字面量");
        }
        if (t_types[ftid].size != 8) {
            return sem_err("f32 字段的全局初始化暂不支持（请用 f64）");
        }
        if (dat_puts(".xword\t") != 0) {
            return -1;
        }
        if (dat_puthex(fv2.fval_bits) != 0) {
            return -1;
        }
        r = dat_put('\n');
    } else {
        c_fold += 1;
        let v Res;
        let vr int = parse_expr_iso(&v);
        c_fold -= 1;
        if (vr != 0) {
            return -1;
        }
        if (v.is_const == 0) {
            return sem_err("全局初始化字段必须是编译期常量");
        }
        if (sem_can_assign(ftid, v.type_id, v.is_lit, v.ival, v.lit_big) != 0) {
            return -1;
        }
        r = em_data_scalar(ftid, v.ival);
    }
    if (r != 0) {
        return -1;
    }
    cur[0] = foff + t_types[ftid].size;
    return 0;
}


// ============================================================================
// parse_module.yh —— 自举编译器：模块头解析（MOD-U1）
//
// 实现「模块与项目管理」设计（docs/03-design/yh-模块与项目管理设计.md §3）
// 的文件头语法：注释与空白之后依次是 module 归属声明、import 声明，
// 然后才是顶层业务声明。本阶段只做语法与文件身份：
//   * 记录文件归属（module 名）与本文件导入表（ImportEnt，model.yh）；
//   * 重复导入在解析期报错；未使用导入、导入名与声明重名等语义检查
//     在 MOD-U3 引入模块作用域时实施；
//   * 纯语法检查不解析 mod.toml、不搜索依赖：未知模块不是语法错误。
// 单文件旧形态（无 module 声明）保持不变；import 不允许脱离 module 出现。
// ============================================================================

// mod_valid_name：当前 token 是否可作模块/导入名——单个标识符，
// 且不恰为 "_"（设计 §1：_ 不能作模块名）。是返回 1。
pub fn mod_valid_name() int {
    if (p_cur() != TOK_IDENT) {
        return 0;
    }
    if (c_toks[c_pos].len == 1 && c_src[c_toks[c_pos].start] == '_') {
        return 0;
    }
    return 1;
}

// mod_import_find：按源码区间 [start,start+n) 查本文件导入表。
// 返回表内下标；未导入返回 -1（重复导入检查用）。
pub fn mod_import_find(start int, n int) int {
    let i int = 0;
    for i < mod_import_n {
        if (mod_imports[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[mod_imports[i].name_off + j] != c_src[start + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// mod_import_push：向本文件导入表追加一条（名字 intern 进名字池）。
// 平行的绑定/使用数组随表一起扩容（mod_bind_current_file / 未使用检查用）。
// 返回 0 成功；内存分配失败输出诊断并返回 -1。
pub fn mod_import_push(start int, n int, line int, col int) int {
    if (mod_import_n == mod_import_cap) {
        let ncap int = mod_import_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *ImportEnt = malloc((ncap * sizeof(ImportEnt)).to_type(u64)).to_type(*ImportEnt);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (mod_import_n > 0) {
            memcpy(nd, mod_imports, (mod_import_n * sizeof(ImportEnt)).to_type(u64));
        }
        free(mod_imports);
        mod_imports = nd;
        let ndm *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (ndm == 0) {
            return fail("内存分配失败");
        }
        if (mod_import_n > 0) {
            memcpy(ndm, mod_import_mod, (mod_import_n * sizeof(int)).to_type(u64));
        }
        free(mod_import_mod);
        mod_import_mod = ndm;
        let ndu *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (ndu == 0) {
            return fail("内存分配失败");
        }
        if (mod_import_n > 0) {
            memcpy(ndu, mod_import_used, (mod_import_n * sizeof(int)).to_type(u64));
        }
        free(mod_import_used);
        mod_import_used = ndu;
        mod_import_cap = ncap;
    }
    let off int = name_intern(start, n);
    if (off < 0) {
        return -1;
    }
    mod_imports[mod_import_n].name_off = off;
    mod_imports[mod_import_n].name_len = n;
    mod_imports[mod_import_n].line = line;
    mod_imports[mod_import_n].col = col;
    mod_import_mod[mod_import_n] = -1;
    mod_import_used[mod_import_n] = 0;
    mod_import_n += 1;
    return 0;
}

// mod_reset_file：开始解析一个新源文件前重置文件级模块状态。
pub fn mod_reset_file() void {
    mod_import_n = 0;
    mod_has_module = 0;
    mod_name_off = -1;
    mod_name_len = 0;
}

// mod_bind_current_file：把当前文件的每条导入绑定到已加载接口（ModInfo）。
// 模块模式下由驱动在解析文件头后调用；单文件/接口加载路径不调用。
// 绑定失败（导入没有对应接口）视为内部错误并报错。
pub fn mod_bind_current_file() int {
    if (c_module_mode == 0) {
        return 0;
    }
    let i int = 0;
    for i < mod_import_n {
        let found int = -1;
        let mi int = 0;
        for mi < c_mod_n {
            if (c_mods[mi].bind_len == mod_imports[i].name_len
                && np_data[c_mods[mi].bind_off] == np_data[mod_imports[i].name_off]) {
                let match int = 1;
                let j int = 1;
                for j < mod_imports[i].name_len {
                    if (np_data[c_mods[mi].bind_off + j] != np_data[mod_imports[i].name_off + j]) {
                        match = 0;
                        break;
                    }
                    j += 1;
                }
                if (match != 0) {
                    found = mi;
                    break;
                }
            }
            mi += 1;
        }
        if (found < 0) {
            return err_lc(mod_imports[i].line, mod_imports[i].col,
                "内部错误：导入未解析到已加载接口");
        }
        mod_import_mod[i] = found;
        mod_import_used[i] = 0;
        i += 1;
    }
    return 0;
}

// mod_parse_head：解析文件头（module 声明 → import 声明）。
// 由 parse_source 开头调用（语法模式与编译 pass 1 共用），消费到的
// token 之后交给业务声明主循环。规则（设计 §3）：
//   * module 声明必须是文件第一个 token；import 只能出现在 module 之后；
//   * 模块名/导入名为单个标识符（"_" 除外）；
//   * 同一文件重复导入同一模块名报错。
// 返回 0 成功；失败 -1（诊断已输出）。
pub fn mod_parse_head() int {
    if (p_cur() != TK_MODULE) {
        // 旧单文件形态：无模块头；import 不允许脱离 module 出现
        if (p_cur() == TK_IMPORT) {
            return err_tok("import 声明前必须有 module 声明");
        }
        return 0;
    }
    p_adv();
    if (mod_valid_name() == 0) {
        return err_tok("此处需要一个模块名（单个标识符，_ 除外）");
    }
    let nstart int = c_toks[c_pos].start;
    let nlen int = c_toks[c_pos].len;
    p_adv();
    if (p_expect(TK_SEMI, "期望 module 声明结尾 ';'") != 0) {
        return -1;
    }
    let off int = name_intern(nstart, nlen);
    if (off < 0) {
        return -1;
    }
    mod_has_module = 1;
    mod_name_off = off;
    mod_name_len = nlen;
    for p_cur() == TK_IMPORT {
        p_adv();
        if (mod_valid_name() == 0) {
            return err_tok("此处需要一个导入模块名（单个标识符，_ 除外）");
        }
        let istart int = c_toks[c_pos].start;
        let ilen int = c_toks[c_pos].len;
        let iline int = c_toks[c_pos].line;
        let icol int = c_toks[c_pos].col;
        if (mod_import_find(istart, ilen) >= 0) {
            return err_lc(iline, icol, "重复导入同一模块");
        }
        if (mod_import_push(istart, ilen, iline, icol) != 0) {
            return -1;
        }
        p_adv();
        if (p_expect(TK_SEMI, "期望 import 声明结尾 ';'") != 0) {
            return -1;
        }
    }
    return 0;
}

// mod_skip_head：pass 2 子遍（globals/fns）跳过文件头 token。
// 调用前提：pass 1 已通过 mod_parse_head 校验，形态必然合法，此处不再
// 诊断，只把游标推进到第一个业务声明。
pub fn mod_skip_head() void {
    if (p_cur() == TK_MODULE) {
        p_adv();
        p_adv();
        p_adv();
    }
    for p_cur() == TK_IMPORT {
        p_adv();
        p_adv();
        p_adv();
    }
}

// ============================================================================
// iface.yh —— 模块接口的发射与加载（MOD-U4）
//
// 接口文件（<模块>.yh.i）是编译器为每个模块生成的「稳定接口」：
//   * 头行：// yh-iface v1 arch=arm64 suffix=<符号后缀>
//   * 正文：pub 类型（struct/union/enum/type 别名，字段带 pub 标记）、
//     pub fn 签名（空体）、pub const（折叠后的字面量值）、pub let（无
//     初始化——存储由模块自己的 .s 提供）。
// 正文是合法 yh 源码：加载 = 头校验 + 正常 pass1 登记 + pass2a 折叠
// 常量（c_iface_load 抑制发射与 bss 登记），随后把新增符号/类型名改写
// 为「短名+后缀」并记录进 ModInfo.ns（限定名解析用）。
//
// 边界（首版）：pub 签名/字段只能引用本模块导出的具名类型或内建类型；
// 引用其他模块的类型报错（类型闭包内联留待按需实现）；pub 指针常量
// （字符串 const）暂不导出。
// ============================================================================

// —— 接口发射缓冲（独立于汇编缓冲；成功后一次写出） ——
pub let if_buf *u8 = 0;
pub let if_len int = 0;
pub let if_cap int = 0;

// if_put / if_puts / if_puti / if_puti64：接口文本写入。
pub fn if_put(b u8) int {
    if (out_grow(&if_buf, if_len, &if_cap, if_len + 1) != 0) {
        return -1;
    }
    if_buf[if_len] = b;
    if_len += 1;
    return 0;
}

pub fn if_puts(s *char) int {
    let i int = 0;
    for s[i] != 0 {
        if (if_put(s[i].to_type(u8)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

pub fn if_puti(v int) int {
    let tmp [12]u8;
    let k int = 0;
    let neg int = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    if (neg != 0) {
        if (if_put('-') != 0) {
            return -1;
        }
    }
    for k > 0 {
        k -= 1;
        if (if_put(tmp[k]) != 0) {
            return -1;
        }
    }
    return 0;
}

// if_put_np：写名字池字节区间。
pub fn if_put_np(off int, olen int) int {
    let i int = 0;
    for i < olen {
        if (if_put(np_data[off + i]) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// if_emit_type：把类型编号渲染为 yh 类型引用文本。
// own_name_base：本模块类型名的 t_names 起始下标（跨模块引用拒绝）。
pub fn if_emit_type(tid int, own_name_base int) int {
    let k int = t_types[tid].kind;
    if (k == TY_VOID) { return if_puts("void"); }
    if (k == TY_BOOL) { return if_puts("bool"); }
    if (k == TY_CHAR) { return if_puts("char"); }
    if (k == TY_I8) { return if_puts("i8"); }
    if (k == TY_I16) { return if_puts("i16"); }
    if (k == TY_I32) { return if_puts("int"); }
    if (k == TY_I64) { return if_puts("i64"); }
    if (k == TY_U8) { return if_puts("u8"); }
    if (k == TY_U16) { return if_puts("u16"); }
    if (k == TY_U32) { return if_puts("u32"); }
    if (k == TY_U64) { return if_puts("u64"); }
    if (k == TY_F32) { return if_puts("f32"); }
    if (k == TY_F64) { return if_puts("f64"); }
    if (k == TY_PTR) {
        if (if_put('*') != 0) { return -1; }
        return if_emit_type(t_types[tid].elem, own_name_base);
    }
    if (k == TY_ARRAY) {
        if (if_put('[') != 0) { return -1; }
        if (if_puti(t_types[tid].len) != 0) { return -1; }
        if (if_put(']') != 0) { return -1; }
        return if_emit_type(t_types[tid].elem, own_name_base);
    }
    if (k == TY_SLICE) {
        if (if_puts("[]") != 0) { return -1; }
        return if_emit_type(t_types[tid].elem, own_name_base);
    }
    if (k == TY_FN) {
        if (if_puts("fn(") != 0) { return -1; }
        let sig int = t_types[tid].sub;
        let np2 int = t_sig_np[sig];
        let i int = 0;
        for i < np2 {
            if (i > 0) {
                if (if_puts(", ") != 0) { return -1; }
            }
            if (if_emit_type(t_sig_params[t_sig_first[sig] + i], own_name_base) != 0) {
                return -1;
            }
            i += 1;
        }
        if (if_puts(")") != 0) { return -1; }
        return if_emit_type(t_sig_ret[sig], own_name_base);
    }
    // 具名类型（struct/union/enum/别名目标）：全表查询——pub 签名可引用
    // 本模块类型，也可引用已加载接口带来的跨模块类型（mangle 名原样
    // 写出，下游加载时作为普通类型名登记）
    let found int = -1;
    let i2 int = 0;
    for i2 < t_name_n {
        if (t_names[i2].type_id == tid) {
            found = i2;
            break;
        }
        i2 += 1;
    }
    if (found < 0) {
        return sem_err("pub 接口引用了非具名类型（无法导出）");
    }
    if (t_names[found].is_pub == 0) {
        return sem_err("pub 接口引用了非 pub 类型（请将该类型声明为 pub）");
    }
    return if_put_np(t_names[found].name_off, t_names[found].name_len);
}

// iface_emit：把本模块 pub 接口写到 path。
// sym_base/tname_base：本模块登记起点（此前是 prelude 与已加载接口）。
pub fn iface_emit(path *char, sym_base int, tname_base int) int {
    if_len = 0;
    // 头行
    if (if_puts("// yh-iface v1 arch=arm64 suffix=") != 0) { return -1; }
    if (if_put_np(c_sym_sfx_off, c_sym_sfx_len) != 0) { return -1; }
    if (if_put('\n') != 0) { return -1; }
    // 类型（声明序）
    let ti int = tname_base;
    for ti < t_name_n {
        if (t_names[ti].is_pub == 0) {
            ti += 1;
            continue;
        }
        let tid int = t_names[ti].type_id;
        if (t_names[ti].form == 1 || t_names[ti].form == 2) {
            if (if_puts("pub ") != 0) { return -1; }
            if (t_names[ti].form == 1) {
                if (if_puts("struct ") != 0) { return -1; }
            } else {
                if (if_puts("union ") != 0) { return -1; }
            }
            if (if_put_np(t_names[ti].name_off, t_names[ti].name_len) != 0) { return -1; }
            if (if_puts(" {\n") != 0) { return -1; }
            let st int = t_types[tid].sub;
            let nf int = t_types[tid].len;
            let fi int = 0;
            for fi < nf {
                if (t_fields[st + fi].is_pub != 0) {
                    if (if_puts("    pub ") != 0) { return -1; }
                } else {
                    if (if_puts("    ") != 0) { return -1; }
                }
                if (if_put_np(t_fields[st + fi].name_off, t_fields[st + fi].name_len) != 0) { return -1; }
                if (if_put(' ') != 0) { return -1; }
                if (if_emit_type(t_fields[st + fi].type_id, tname_base) != 0) { return -1; }
                if (if_puts(";\n") != 0) { return -1; }
                fi += 1;
            }
            if (if_puts("}\n") != 0) { return -1; }
        } else if (t_names[ti].form == 3) {
            if (if_puts("pub enum ") != 0) { return -1; }
            if (if_put_np(t_names[ti].name_off, t_names[ti].name_len) != 0) { return -1; }
            if (if_puts(" {\n") != 0) { return -1; }
            // 成员 = 类型为该枚举的全局常量（本模块登记的）
            let si int = sym_base;
            for si < c_sym_n {
                if (c_syms[si].kind == SYM_CONST && c_syms[si].type_id == tid
                    && (c_syms[si].flags & F_EXTERN) == 0) {
                    if (if_puts("    ") != 0) { return -1; }
                    if (if_put_np(c_syms[si].name_off, c_syms[si].name_len) != 0) { return -1; }
                    if (if_puts(" = ") != 0) { return -1; }
                    if (if_puti(c_syms[si].cval.to_type(int)) != 0) { return -1; }
                    if (if_puts(";\n") != 0) { return -1; }
                }
                si += 1;
            }
            if (if_puts("}\n") != 0) { return -1; }
        } else {
            // type 别名
            if (if_puts("pub type ") != 0) { return -1; }
            if (if_put_np(t_names[ti].name_off, t_names[ti].name_len) != 0) { return -1; }
            if (if_puts(" = ") != 0) { return -1; }
            if (if_emit_type(tid, tname_base) != 0) { return -1; }
            if (if_puts(";\n") != 0) { return -1; }
        }
        ti += 1;
    }
    // 值符号：fn / const / let
    let si2 int = sym_base;
    for si2 < c_sym_n {
        let fl int = c_syms[si2].flags;
        if ((fl & F_PUB) == 0 || (fl & F_EXTERN) != 0) {
            si2 += 1;
            continue;
        }
        if (c_syms[si2].kind == SYM_FN) {
            // 类型化变参/裸变参不导出（前者为模块私有便利，后者仅 prelude）
            let ftid int = c_syms[si2].type_id;
            let sig int = t_types[ftid].sub;
            if (t_sig_vararg[sig] != 0) {
                return sem_err("变参函数不能导出为 pub");
            }
            if (if_puts("pub fn ") != 0) { return -1; }
            if (if_put_np(c_syms[si2].name_off, c_syms[si2].name_len) != 0) { return -1; }
            if (if_put('(') != 0) { return -1; }
            let np2 int = t_sig_np[sig];
            let i int = 0;
            for i < np2 {
                if (i > 0) {
                    if (if_puts(", ") != 0) { return -1; }
                }
                if (if_puts("p") != 0) { return -1; }
                if (if_puti(i) != 0) { return -1; }
                if (if_put(' ') != 0) { return -1; }
                if (if_emit_type(t_sig_params[t_sig_first[sig] + i], tname_base) != 0) { return -1; }
                i += 1;
            }
            if (if_puts(") ") != 0) { return -1; }
            if (if_emit_type(t_sig_ret[sig], tname_base) != 0) { return -1; }
            if (if_puts(" { }\n") != 0) { return -1; }
        } else if (c_syms[si2].kind == SYM_CONST) {
            if ((fl & F_ADDR) != 0) {
                return sem_err("pub 指针常量（字符串）暂不支持跨模块导出");
            }
            if (if_puts("pub const ") != 0) { return -1; }
            if (if_put_np(c_syms[si2].name_off, c_syms[si2].name_len) != 0) { return -1; }
            if (if_put(' ') != 0) { return -1; }
            if (if_emit_type(c_syms[si2].type_id, tname_base) != 0) { return -1; }
            if (if_puts(" = ") != 0) { return -1; }
            if (if_puti(c_syms[si2].cval.to_type(int)) != 0) { return -1; }
            if (if_puts(";\n") != 0) { return -1; }
        } else if (c_syms[si2].kind == SYM_VAR) {
            if (if_puts("pub let ") != 0) { return -1; }
            if (if_put_np(c_syms[si2].name_off, c_syms[si2].name_len) != 0) { return -1; }
            if (if_put(' ') != 0) { return -1; }
            if (if_emit_type(c_syms[si2].type_id, tname_base) != 0) { return -1; }
            if (if_puts(";\n") != 0) { return -1; }
        }
        si2 += 1;
    }
    // 一次性写出（O_WRONLY|O_CREAT|O_TRUNC；旗标随平台不同）
    let flg int = 0x241;
    if (tg_darwin() != 0) {
        flg = 0x601;
    }
    let fd int = open(path, flg, 0x1a4);
    if (fd < 0) {
        return fail_path("无法创建接口文件: ", path);
    }
    let w int = write(fd, if_buf, if_len.to_type(u64)).to_type(int);
    close(fd);
    if (w != if_len) {
        return fail_path("写接口文件失败: ", path);
    }
    return 0;
}

// —— 接口加载 ——

// iface_header_suffix：校验头行并提取 suffix 到出参（入名字池）。
// c_src/c_src_len 为接口文件内容。成功 0；格式不符 -1（带诊断）。
pub fn iface_header_suffix(path *char, off *int, olen *int) int {
    let magic *char = "// yh-iface v1 arch=arm64 suffix=";
    let mlen int = 33;
    let i int = 0;
    for i < mlen {
        if (i >= c_src_len || c_src[i] != magic[i].to_type(u8)) {
            let buf [320]u8;
            let n int = 0;
            n = append_str(buf, n, "yh: 接口不兼容（头行不是 yh-iface v1 arch=arm64）: ");
            n = append_str(buf, n, path);
            n = append_byte(buf, n, '\n');
            write_all(2, buf, n);
            c_errors += 1;
            return -1;
        }
        i += 1;
    }
    // suffix 到行尾
    let s int = mlen;
    let e int = s;
    for e < c_src_len && c_src[e] != '\n' {
        e += 1;
    }
    if (e == s) {
        c_errors += 1;
        let out2 [340]u8;
        let on2 int = 0;
        on2 = append_str(out2, on2, "yh: 接口头缺少 suffix: ");
        on2 = append_str(out2, on2, path);
        on2 = append_byte(out2, on2, '\n');
        write_all(2, out2, on2);
        return -1;
    }
    let o int = tml_intern_str(c_src, s, e - s);
    if (o < 0) {
        return -1;
    }
    off[0] = o;
    olen[0] = e - s;
    return 0;
}

// iface_load：加载一份接口并登记为当前编译单元的导入模块。
// bind_off/len：导入绑定名（=模块名）。返回 ModInfo 下标；失败 -1。
pub fn iface_load(path *char, bind_off int, bind_len int) int {
    if (read_source(path) != 0) {
        return -1;
    }
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (iface_header_suffix(path, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    let home int = c_mod_home_next;
    c_mod_home_next += 1;
    // 登记 ModInfo（ns 随后填充）
    if (c_mod_n == c_mod_cap) {
        let ncap int = c_mod_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *ModInfo = malloc((ncap * sizeof(ModInfo)).to_type(u64)).to_type(*ModInfo);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (c_mod_n > 0) {
            memcpy(nd, c_mods, (c_mod_n * sizeof(ModInfo)).to_type(u64));
        }
        free(c_mods);
        c_mods = nd;
        c_mod_cap = ncap;
    }
    let mi int = c_mod_n;
    c_mods[mi].bind_off = bind_off;
    c_mods[mi].bind_len = bind_len;
    c_mods[mi].prefix_off = sfx_off;
    c_mods[mi].prefix_len = sfx_len;
    c_mods[mi].home = home;
    c_mods[mi].ns = 0;
    c_mods[mi].ns_n = 0;
    c_mods[mi].ns_cap = 0;
    c_mod_n += 1;
    // 正文按 yh 源码登记：pass1 + pass2a（折叠常量；c_iface_load 抑制发射）
    c_tok_n = 0;
    c_pos = 0;
    c_compile = 1;
    c_pass = 1;
    c_iface_load = 1;
    let sym_base int = c_sym_n;
    let tname_base int = t_name_n;
    if (lex_all() != 0) {
        c_iface_load = 0;
        return -1;
    }
    if (mod_parse_head() != 0) {
        c_iface_load = 0;
        return -1;
    }
    if (parse_source() != 0) {
        c_iface_load = 0;
        return -1;
    }
    if (c_errors > 0) {
        c_iface_load = 0;
        return -1;
    }
    c_pos = 0;
    c_pass = 2;
    if (parse_source_globals() != 0) {
        c_iface_load = 0;
        return -1;
    }
    if (c_errors > 0) {
        c_iface_load = 0;
        return -1;
    }
    c_iface_load = 0;
    // ns 登记 + 名字改写（短名 → 短名+后缀；类型名同样改写避免冲突）
    let si int = sym_base;
    for si < c_sym_n {
        if ((c_syms[si].flags & F_PUB) == 0) {
            si += 1;
            continue;
        }
        if (mod_ns_add(mi, c_syms[si].name_off, c_syms[si].name_len, si, -1) != 0) {
            return -1;
        }
        if (sym_mangle(si, sfx_off, sfx_len) != 0) {
            return -1;
        }
        c_syms[si].flags |= F_EXTERN;
        si += 1;
    }
    let ti int = tname_base;
    for ti < t_name_n {
        if (t_home[t_names[ti].type_id] < 0) {
            t_home[t_names[ti].type_id] = home;
        }
        if (mod_ns_add(mi, t_names[ti].name_off, t_names[ti].name_len, -1, t_names[ti].type_id) != 0) {
            return -1;
        }
        if (tname_mangle(ti, sfx_off, sfx_len) != 0) {
            return -1;
        }
        ti += 1;
    }
    // 恢复编译状态（调用方继续编译本模块源文件）
    c_tok_n = 0;
    c_pos = 0;
    return mi;
}

// mod_ns_add：向 ModInfo 追加导出名条目。
pub fn mod_ns_add(mi int, name_off int, name_len int, sym int, tid int) int {
    if (c_mods[mi].ns_n == c_mods[mi].ns_cap) {
        let ncap int = c_mods[mi].ns_cap * 2;
        if (ncap == 0) {
            ncap = 16;
        }
        let nd *ModNsEnt = malloc((ncap * sizeof(ModNsEnt)).to_type(u64)).to_type(*ModNsEnt);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (c_mods[mi].ns_n > 0) {
            memcpy(nd, c_mods[mi].ns, (c_mods[mi].ns_n * sizeof(ModNsEnt)).to_type(u64));
        }
        free(c_mods[mi].ns);
        c_mods[mi].ns = nd;
        c_mods[mi].ns_cap = ncap;
    }
    let e int = c_mods[mi].ns_n;
    c_mods[mi].ns[e].name_off = name_off;
    c_mods[mi].ns[e].name_len = name_len;
    c_mods[mi].ns[e].sym = sym;
    c_mods[mi].ns[e].tid = tid;
    c_mods[mi].ns_n += 1;
    return 0;
}

// sym_mangle：把符号名改写为「短名+后缀」。
pub fn sym_mangle(si int, sfx_off int, sfx_len int) int {
    let nlen int = c_syms[si].name_len + sfx_len;
    let tmp [512]u8;
    if (nlen > 500) {
        return fail("符号名过长");
    }
    let n int = 0;
    let i int = 0;
    for i < c_syms[si].name_len {
        tmp[n] = np_data[c_syms[si].name_off + i];
        n += 1;
        i += 1;
    }
    i = 0;
    for i < sfx_len {
        tmp[n] = np_data[sfx_off + i];
        n += 1;
        i += 1;
    }
    let off int = tml_intern_str(tmp, 0, n);
    if (off < 0) {
        return -1;
    }
    c_syms[si].name_off = off;
    c_syms[si].name_len = n;
    return 0;
}

// tname_mangle：类型名同样改写（避免与使用者同名类型冲突）。
pub fn tname_mangle(ti int, sfx_off int, sfx_len int) int {
    let nlen int = t_names[ti].name_len + sfx_len;
    let tmp [512]u8;
    if (nlen > 500) {
        return fail("类型名过长");
    }
    let n int = 0;
    let i int = 0;
    for i < t_names[ti].name_len {
        tmp[n] = np_data[t_names[ti].name_off + i];
        n += 1;
        i += 1;
    }
    i = 0;
    for i < sfx_len {
        tmp[n] = np_data[sfx_off + i];
        n += 1;
        i += 1;
    }
    let off int = tml_intern_str(tmp, 0, n);
    if (off < 0) {
        return -1;
    }
    t_names[ti].name_off = off;
    t_names[ti].name_len = n;
    return 0;
}

// ============================================================================
// toml.yh —— mod.toml 最小 TOML 解析器（MOD-U2）
//
// 覆盖清单 schema（设计 §4）所需的 TOML 1.0 子集：
//   * 节头 [name]；裸键 [A-Za-z0-9_-]+；
//   * 值：基本字符串 "…"（转义 \\ \" \n \r \t）、字面量字符串 '…'、
//     整数、内联表 { k = v, ... }（值限字符串）；
//   * 注释 # 到行尾；空白含换行。
// 其余 TOML 形态（多行字符串、数组、日期、点键、[[数组表]]）一律
// 语法报错——清单用不到，报错比静默误读安全。
//
// 解析结果存入 toml_secs（节 → 键值表）；schema 校验（允许键、类型、
// 必填）由 project.yh 负责，本文件只做语法与「值形态」判定。
// 诊断格式 <toml路径>:<line>: 错误: <msg>，由 tml_err 输出（mod.toml
// 不是 yh 源码，不走 err_lc/c_path）。
// ============================================================================

// —— 解析结果表（进程内一次构建共用，不释放） ——
pub struct TomlVal {
    key_off int;        // 键名池偏移
    key_len int;
    kind int;           // 1=字符串 2=内联表 3=整数
    sval_off int;       // 字符串值池偏移（kind==1）
    sval_len int;
    ival int;           // 整数值（kind==3）
    path_off int;       // 内联表内 path 键的值池偏移（kind==2，-1 无）
    path_len int;
    line int;           // 键所在行（1 基）
}
pub struct TomlSec {
    name_off int;       // 节名池偏移
    name_len int;
    vals *TomlVal;      // 键值表（堆分配）
    val_n int;
    val_cap int;
    line int;           // 节头行
}
pub let toml_secs *TomlSec = 0;
pub let toml_sec_n int = 0;
pub let toml_sec_cap int = 0;

// —— 解析游标与诊断上下文 ——
pub let t_src *u8 = 0;          // mod.toml 字节
pub let t_len int = 0;
pub let t_pos int = 0;          // 当前字节下标
pub let t_line int = 1;         // 当前行号
pub let t_file *char = 0;       // 诊断用清单路径（借调用方，不复制）

// tml_err：mod.toml 诊断（带行号，无列——TOML 错误按行报告足够定位）。
pub fn tml_err(line int, msg *char) int {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, t_file);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, line);
    n = append_str(buf, n, ": 错误: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    return -1;
}

// tml_intern：把 [start,start+n) 字节 intern 进名字池并带 NUL（调试用）。
pub fn tml_intern(start int, n int) int {
    let off int = np_len;
    let i int = 0;
    // name_intern 从 c_src 取字节；mod.toml 不在 c_src，手工入池
    let need int = np_len + n + 1;
    if (need > np_cap) {
        let ncap int = np_cap * 2;
        if (ncap < need) {
            ncap = need;
        }
        let nd *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (np_len > 0) {
            memcpy(nd, np_data, np_len.to_type(u64));
        }
        free(np_data);
        np_data = nd;
        np_cap = ncap;
    }
    for i < n {
        np_data[np_len] = t_src[start + i];
        np_len += 1;
        i += 1;
    }
    np_data[np_len] = 0;
    np_len += 1;
    return off;
}

// tml_ws：跳过空白、注释与换行（维护行号）。
pub fn tml_ws() void {
    for t_pos < t_len {
        let b u8 = t_src[t_pos];
        if (b == ' ' || b == '\t' || b == '\r') {
            t_pos += 1;
            continue;
        }
        if (b == '\n') {
            t_pos += 1;
            t_line += 1;
            continue;
        }
        if (b == '#') {
            for t_pos < t_len && t_src[t_pos] != '\n' {
                t_pos += 1;
            }
            continue;
        }
        break;
    }
}

// tml_is_bare：裸键字节。
pub fn tml_is_bare(b u8) int {
    if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
        || (b >= '0' && b <= '9') || b == '_' || b == '-') {
        return 1;
    }
    return 0;
}

// tml_sec_find：按名查节；没有返回 -1。
pub fn tml_sec_find(name_off int, name_len int) int {
    let i int = 0;
    for i < toml_sec_n {
        if (toml_secs[i].name_len == name_len
            && np_data[toml_secs[i].name_off] == np_data[name_off]) {
            // 节名较短，逐字节比较
            let match int = 1;
            let j int = 1;
            for j < name_len {
                if (np_data[toml_secs[i].name_off + j] != np_data[name_off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// tml_sec_push：追加一个节（同名节重复报错）。
pub fn tml_sec_push(name_start int, name_len int) int {
    let off int = tml_intern(name_start, name_len);
    if (off < 0) {
        return -1;
    }
    if (tml_sec_find(off, name_len) >= 0) {
        return tml_err(t_line, "重复的节");
    }
    if (toml_sec_n == toml_sec_cap) {
        let ncap int = toml_sec_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *TomlSec = malloc((ncap * sizeof(TomlSec)).to_type(u64)).to_type(*TomlSec);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (toml_sec_n > 0) {
            memcpy(nd, toml_secs, (toml_sec_n * sizeof(TomlSec)).to_type(u64));
        }
        free(toml_secs);
        toml_secs = nd;
        toml_sec_cap = ncap;
    }
    toml_secs[toml_sec_n].name_off = off;
    toml_secs[toml_sec_n].name_len = name_len;
    toml_secs[toml_sec_n].vals = 0;
    toml_secs[toml_sec_n].val_n = 0;
    toml_secs[toml_sec_n].val_cap = 0;
    toml_secs[toml_sec_n].line = t_line;
    toml_sec_n += 1;
    return toml_sec_n - 1;
}

// tml_val_push：向节追加键值。
pub fn tml_val_push(sec int, v *TomlVal) int {
    if (toml_secs[sec].val_n == toml_secs[sec].val_cap) {
        let ncap int = toml_secs[sec].val_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *TomlVal = malloc((ncap * sizeof(TomlVal)).to_type(u64)).to_type(*TomlVal);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (toml_secs[sec].val_n > 0) {
            memcpy(nd, toml_secs[sec].vals, (toml_secs[sec].val_n * sizeof(TomlVal)).to_type(u64));
        }
        free(toml_secs[sec].vals);
        toml_secs[sec].vals = nd;
        toml_secs[sec].val_cap = ncap;
    }
    let dst int = toml_secs[sec].val_n;
    toml_secs[sec].vals[dst].key_off = v.key_off;
    toml_secs[sec].vals[dst].key_len = v.key_len;
    toml_secs[sec].vals[dst].kind = v.kind;
    toml_secs[sec].vals[dst].sval_off = v.sval_off;
    toml_secs[sec].vals[dst].sval_len = v.sval_len;
    toml_secs[sec].vals[dst].ival = v.ival;
    toml_secs[sec].vals[dst].path_off = v.path_off;
    toml_secs[sec].vals[dst].path_len = v.path_len;
    toml_secs[sec].vals[dst].line = v.line;
    toml_secs[sec].val_n += 1;
    return 0;
}

// tml_string：解析一个字符串值（基本或字面量），intern 后写 out 偏移。
// 返回 0 成功；语法错误 -1。
pub fn tml_string(v *TomlVal) int {
    let q u8 = t_src[t_pos];
    let start int = t_pos + 1;
    t_pos += 1;
    if (q == '\'') {
        // 字面量字符串：无转义，到下一个 '
        for t_pos < t_len && t_src[t_pos] != '\'' {
            if (t_src[t_pos] == '\n') {
                return tml_err(v.line, "字符串未终结");
            }
            t_pos += 1;
        }
        if (t_pos >= t_len) {
            return tml_err(v.line, "字符串未终结");
        }
        v.kind = 1;
        v.sval_off = tml_intern_str(t_src, start, t_pos - start);
        v.sval_len = t_pos - start;
        t_pos += 1;
        return 0;
    }
    // 基本字符串：转义处理进小缓冲再入池（清单字符串都很短）
    let tmp [512]u8;
    let n int = 0;
    for t_pos < t_len {
        let b u8 = t_src[t_pos];
        if (b == '"') {
            v.kind = 1;
            v.sval_off = tml_intern_str(tmp, 0, n);
            v.sval_len = n;
            t_pos += 1;
            return 0;
        }
        if (b == '\n') {
            return tml_err(v.line, "字符串未终结");
        }
        if (b == '\\') {
            if (t_pos + 1 >= t_len) {
                return tml_err(v.line, "转义序列不完整");
            }
            let e u8 = t_src[t_pos + 1];
            t_pos += 2;
            if (e == 'n') { tmp[n] = 10; n += 1; continue; }
            if (e == 't') { tmp[n] = 9; n += 1; continue; }
            if (e == 'r') { tmp[n] = 13; n += 1; continue; }
            if (e == '"') { tmp[n] = '"'; n += 1; continue; }
            if (e == '\\') { tmp[n] = '\\'; n += 1; continue; }
            return tml_err(v.line, "不支持的转义序列");
        }
        if (n >= 511) {
            return tml_err(v.line, "字符串过长");
        }
        tmp[n] = b;
        n += 1;
        t_pos += 1;
    }
    return tml_err(v.line, "字符串未终结");
}

// tml_inline_table：解析 { k = v, ... }（v 限字符串）。填写 v.path_*。
pub fn tml_inline_table(v *TomlVal) int {
    t_pos += 1; // '{'
    v.kind = 2;
    v.path_off = -1;
    v.path_len = 0;
    tml_ws();
    if (t_pos < t_len && t_src[t_pos] == '}') {
        t_pos += 1;
        return tml_err(v.line, "依赖必须提供 path");
    }
    for 1 {
        tml_ws();
        if (t_pos >= t_len) {
            return tml_err(v.line, "内联表未终结");
        }
        // 键
        let ks int = t_pos;
        for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
            t_pos += 1;
        }
        let kn int = t_pos - ks;
        if (kn == 0) {
            return tml_err(t_line, "内联表需要一个键");
        }
        tml_ws();
        if (t_pos >= t_len || t_src[t_pos] != '=') {
            return tml_err(t_line, "期望 '='");
        }
        t_pos += 1;
        tml_ws();
        let line int = tml_string(v);
        if (line != 0) {
            return -1;
        }
        // 目前只关心 path 键；其余键报未知（schema 简单性）
        if (kn == 4 && t_src[ks] == 'p' && t_src[ks + 1] == 'a'
            && t_src[ks + 2] == 't' && t_src[ks + 3] == 'h') {
            v.path_off = v.sval_off;
            v.path_len = v.sval_len;
        } else {
            return tml_err(v.line, "依赖表只支持 path 键");
        }
        tml_ws();
        if (t_pos < t_len && t_src[t_pos] == ',') {
            t_pos += 1;
            continue;
        }
        if (t_pos < t_len && t_src[t_pos] == '}') {
            t_pos += 1;
            return 0;
        }
        return tml_err(t_line, "期望 ',' 或 '}'");
    }
    return 0;
}

// tml_value：解析一个值（字符串 / 内联表 / 整数）。
pub fn tml_value(v *TomlVal) int {
    let b u8 = t_src[t_pos];
    if (b == '"' || b == '\'') {
        return tml_string(v);
    }
    if (b == '{') {
        return tml_inline_table(v);
    }
    if (b == '+' || b == '-' || (b >= '0' && b <= '9')) {
        let neg int = 0;
        if (b == '+' || b == '-') {
            if (b == '-') {
                neg = 1;
            }
            t_pos += 1;
        }
        let val int = 0;
        let digits int = 0;
        for t_pos < t_len && t_src[t_pos] >= '0' && t_src[t_pos] <= '9' {
            val = val * 10 + (t_src[t_pos] - '0').to_type(int);
            digits += 1;
            t_pos += 1;
        }
        if (digits == 0) {
            return tml_err(v.line, "不支持的值类型");
        }
        v.kind = 3;
        v.ival = (0 - val) * neg + val * (1 - neg);
        return 0;
    }
    return tml_err(v.line, "不支持的值类型（仅字符串/内联表/整数）");
}

// tml_parse：解析整个清单。成功 0；语法错误 -1（诊断已输出）。
// t_src/t_len/t_file 由调用方设置。
pub fn tml_parse() int {
    let cur int = -1;
    for 1 {
        tml_ws();
        if (t_pos >= t_len) {
            return 0;
        }
        if (t_src[t_pos] == '[') {
            t_pos += 1;
            let ks int = t_pos;
            for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
                t_pos += 1;
            }
            let kn int = t_pos - ks;
            if (kn == 0) {
                return tml_err(t_line, "节名不能为空");
            }
            if (t_pos >= t_len || t_src[t_pos] != ']') {
                return tml_err(t_line, "期望 ']'");
            }
            t_pos += 1;
            cur = tml_sec_push(ks, kn);
            if (cur < 0) {
                return -1;
            }
            continue;
        }
        // 键值行（必须在节内）
        if (cur < 0) {
            return tml_err(t_line, "键值必须位于节内（先写 [project]）");
        }
        let ks2 int = t_pos;
        for t_pos < t_len && tml_is_bare(t_src[t_pos]) {
            t_pos += 1;
        }
        let kn2 int = t_pos - ks2;
        if (kn2 == 0) {
            return tml_err(t_line, "此处需要一个键");
        }
        tml_ws();
        if (t_pos >= t_len || t_src[t_pos] != '=') {
            return tml_err(t_line, "期望 '='");
        }
        t_pos += 1;
        tml_ws();
        let v TomlVal;
        v.key_off = tml_intern(ks2, kn2);
        if (v.key_off < 0) {
            return -1;
        }
        v.key_len = kn2;
        v.line = t_line;
        v.sval_off = -1;
        v.sval_len = 0;
        v.path_off = -1;
        v.ival = 0;
        if (tml_value(&v) != 0) {
            return -1;
        }
        if (tml_val_push(cur, &v) != 0) {
            return -1;
        }
        // 行尾：行内空白与注释后必须换行或 EOF（跨行跳过交回主循环）
        for t_pos < t_len && (t_src[t_pos] == ' ' || t_src[t_pos] == '\t' || t_src[t_pos] == '\r') {
            t_pos += 1;
        }
        if (t_pos < t_len && t_src[t_pos] == '#') {
            for t_pos < t_len && t_src[t_pos] != '\n' {
                t_pos += 1;
            }
        }
        if (t_pos < t_len && t_src[t_pos] != '\n') {
            return tml_err(t_line, "一行只能有一个键值（期望换行）");
        }
    }
    return 0;
}

// toml_find_sec：按名查节，返回下标；无 -1。
pub fn toml_find_sec(name *char) int {
    let n int = 0;
    for name[n] != 0 {
        n += 1;
    }
    let i int = 0;
    for i < toml_sec_n {
        if (toml_secs[i].name_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[toml_secs[i].name_off + j] != name[j].to_type(u8)) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// toml_sec_str：节内取字符串键值（intern 偏移出参）。
// 找到返回 1（off/len 有效）；节或键不存在返回 0；类型错误返回 -1（诊断）。
pub fn toml_sec_str(sec int, key *char, off *int, olen *int) int {
    if (sec < 0) {
        return 0;
    }
    let n int = 0;
    for key[n] != 0 {
        n += 1;
    }
    let i int = 0;
    for i < toml_secs[sec].val_n {
        if (toml_secs[sec].vals[i].key_len == n) {
            let match int = 1;
            let j int = 0;
            for j < n {
                if (np_data[toml_secs[sec].vals[i].key_off + j] != key[j].to_type(u8)) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                if (toml_secs[sec].vals[i].kind != 1) {
                    let buf [64]u8;
                    let m int = 0;
                    m = append_str(buf, m, "字段必须是字符串: ");
                    m = append_str(buf, m, key);
                    let mo int = tml_intern_str(buf, 0, m);
                    if (mo < 0) {
                        return -1;
                    }
                    return tml_err(toml_secs[sec].vals[i].line, np_cstr(mo));
                }
                off[0] = toml_secs[sec].vals[i].sval_off;
                olen[0] = toml_secs[sec].vals[i].sval_len;
                return 1;
            }
        }
        i += 1;
    }
    return 0;
}

// ============================================================================
// project_state.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

// 固定临时文件（进程内互斥使用；并发编译器的已知边界，见 ADR-0007 种子说明）。
pub let pj_scratch *char = "/tmp/yh-proj-scratch.txt";

// ls 输出独立缓冲容量（pj_run_ls 经 out_grow 扩容 pj_ls_buf 用）。
pub let pj_ls_cap int = 0;

pub fn pj_pool_str(off int) *char {
    return (np_data + off).to_type(*char);
}

pub fn pj_shell_quote(buf *u8, n int, path *char) int {
    buf[n] = '\'';
    n += 1;
    let i int = 0;
    for path[i] != 0 {
        if (path[i] == '\'') {
            buf[n] = '\'';
            buf[n + 1] = '\\';
            buf[n + 2] = '\'';
            buf[n + 3] = '\'';
            n += 4;
        } else {
            buf[n] = path[i].to_type(u8);
            n += 1;
        }
        i += 1;
    }
    buf[n] = '\'';
    return n + 1;
}


// pj_run_ls：列出目录条目到临时文件，读入独立缓冲 pj_ls_buf。
// 每行一个条目；目录条目带尾部 '/'（ls -1p）。返回 0；失败 -1。
pub let pj_ls_buf *u8 = 0;
pub let pj_ls_len int = 0;
pub fn pj_run_ls(dir *char) int {
    let cmd [1024]u8;
    let n int = 0;
    n = append_str(cmd, n, "/bin/ls -1p ");
    n = pj_shell_quote(cmd, n, dir);
    n = append_str(cmd, n, " > ");
    n = append_str(cmd, n, pj_scratch);
    cmd[n] = 0;
    let rc int = system(arr_cstr(cmd));
    if (rc != 0) {
        return fail_path("无法列出目录: ", dir);
    }
    if (read_source(pj_scratch) != 0) {
        return -1;
    }
    // 拷出独立缓冲：后续 read_source（读 .yh/mod.toml）会覆盖 c_src
    if (out_grow(&pj_ls_buf, pj_ls_len, &pj_ls_cap, c_src_len + 1) != 0) {
        return -1;
    }
    memcpy(pj_ls_buf, c_src, c_src_len.to_type(u64));
    pj_ls_len = c_src_len;
    return 0;
}

pub fn pj_env_fetch(name *char, off *int, olen *int) int {
    // shell 内建 echo 展开变量（不依赖外部命令的 PATH）
    let cmd [256]u8;
    let n int = 0;
    n = append_str(cmd, n, "echo \"");
    n = append_str(cmd, n, "$");
    n = append_str(cmd, n, name);
    n = append_str(cmd, n, "\" > ");
    n = append_str(cmd, n, pj_scratch);
    cmd[n] = 0;
    system(arr_cstr(cmd));
    if (read_source(pj_scratch) != 0) {
        return -1;
    }
    // 去掉尾部换行
    let e int = c_src_len;
    if (e > 0 && c_src[e - 1] == '\n') {
        e -= 1;
    }
    if (e > 0 && c_src[e - 1] == '\r') {
        e -= 1;
    }
    let o int = tml_intern_str(c_src, 0, e);
    if (o < 0) {
        return -1;
    }
    off[0] = o;
    olen[0] = e;
    return 0;
}

pub fn pj_file_exists(path *char) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return 0;
    }
    close(fd);
    return 1;
}


// —— 路径规范化（去重用）：段栈处理，消解 . / .. / 重复斜杠。 ——

// pj_canon：把 base（池内串）与 rel（NUL 串）连接并规范化，intern 后
// 经全局出参 pj_canon_off/len 返回。rel 以 '/' 开头时仅用 rel。
pub let pj_canon_off int = -1;
pub let pj_canon_len int = 0;
pub fn pj_canon(base_off int, base_len int, rel *char) int {
    // 组装原始串到临时堆缓冲（路径有 1024 上限，超出报错）
    let raw [1024]u8;
    let rn int = 0;
    let use_rel_only int = 0;
    if (rel[0] == '/') {
        use_rel_only = 1;
    }
    if (use_rel_only == 0) {
        let i int = 0;
        for i < base_len {
            raw[rn] = np_data[base_off + i];
            rn += 1;
            i += 1;
        }
        if (rn > 0 && raw[rn - 1] != '/') {
            raw[rn] = '/';
            rn += 1;
        }
    }
    let j int = 0;
    for rel[j] != 0 {
        raw[rn] = rel[j].to_type(u8);
        rn += 1;
        j += 1;
        if (rn >= 1023) {
            return fail("路径过长");
        }
    }
    raw[rn] = 0;
    // 段栈规范化
    let segs [128][256]u8;  // 每段最长 255
    let seg_len [128]int;
    let sn int = 0;
    let i2 int = 0;
    for i2 < rn {
        // 跳过多余斜杠
        for i2 < rn && raw[i2] == '/' {
            i2 += 1;
        }
        let s int = i2;
        for i2 < rn && raw[i2] != '/' {
            i2 += 1;
        }
        let sl int = i2 - s;
        if (sl == 0) {
            break;
        }
        if (sl == 1 && raw[s] == '.') {
            continue;
        }
        if (sl == 2 && raw[s] == '.' && raw[s + 1] == '.') {
            // 顶端是普通段才弹出；否则保留 ".."（相对路径上越 cwd）
            if (sn > 0 && !(seg_len[sn - 1] == 2 && segs[sn - 1][0] == '.' && segs[sn - 1][1] == '.')) {
                sn -= 1;
                continue;
            }
        }
        if (sn >= 128 || sl > 255) {
            return fail("路径过长");
        }
        let k int = 0;
        for k < sl {
            segs[sn][k] = raw[s + k];
            k += 1;
        }
        seg_len[sn] = sl;
        sn += 1;
    }
    // 重新拼接入池
    let tmp [1024]u8;
    let tn int = 0;
    // 空段栈：绝对路径为根 '/'；相对路径（如 "." 折叠后）为本目录 "."。
    // 契约与其他路径一致：结果写 pj_canon_off/len，成功返回 0。
    if (sn == 0) {
        if (rn > 0 && raw[0] == '/') {
            tmp[0] = '/';
            tn = 1;
        } else {
            tmp[0] = '.';
            let o int = tml_intern_str(tmp, 0, 1);
            if (o < 0) {
                return -1;
            }
            pj_canon_off = o;
            pj_canon_len = 1;
            return 0;
        }
    }
    if (rn > 0 && raw[0] == '/') {
        tmp[0] = '/';
        tn = 1;
    }
    let si int = 0;
    for si < sn {
        if (tn > 0 && tmp[tn - 1] != '/') {
            tmp[tn] = '/';
            tn += 1;
        }
        let k2 int = 0;
        for k2 < seg_len[si] {
            tmp[tn] = segs[si][k2];
            tn += 1;
            k2 += 1;
        }
        si += 1;
    }
    tmp[tn] = 0;
    pj_canon_off = tml_intern_str(tmp, 0, tn);
    pj_canon_len = tn;
    if (pj_canon_off < 0) {
        return -1;
    }
    return 0;
}

pub fn pj_proj_push(root_off int, root_len int) int {
    if (p_proj_n == p_proj_cap) {
        let ncap int = p_proj_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *PProj = malloc((ncap * sizeof(PProj)).to_type(u64)).to_type(*PProj);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (p_proj_n > 0) {
            memcpy(nd, p_projs, (p_proj_n * sizeof(PProj)).to_type(u64));
        }
        free(p_projs);
        p_projs = nd;
        p_proj_cap = ncap;
    }
    p_projs[p_proj_n].root_off = root_off;
    p_projs[p_proj_n].root_len = root_len;
    p_projs[p_proj_n].name_off = -1;
    p_projs[p_proj_n].name_len = 0;
    p_projs[p_proj_n].src_off = -1;
    p_projs[p_proj_n].src_len = 0;
    p_projs[p_proj_n].entry_off = -1;
    p_projs[p_proj_n].entry_len = 0;
    p_projs[p_proj_n].deps = 0;
    p_projs[p_proj_n].dep_n = 0;
    p_projs[p_proj_n].dep_cap = 0;
    p_projs[p_proj_n].mods = 0;
    p_projs[p_proj_n].mod_n = 0;
    p_projs[p_proj_n].mod_cap = 0;
    p_proj_n += 1;
    return p_proj_n - 1;
}

pub fn pj_proj_find_root(root_off int, root_len int) int {
    let i int = 0;
    for i < p_proj_n {
        if (p_projs[i].root_len == root_len
            && np_data[p_projs[i].root_off] == np_data[root_off]) {
            let match int = 1;
            let j int = 1;
            for j < root_len {
                if (np_data[p_projs[i].root_off + j] != np_data[root_off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

pub fn pj_mod_push(name_off int, name_len int, proj int) int {
    if (p_mod_n == p_mod_cap) {
        let ncap int = p_mod_cap * 2;
        if (ncap == 0) {
            ncap = 16;
        }
        let nd *PMod = malloc((ncap * sizeof(PMod)).to_type(u64)).to_type(*PMod);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (p_mod_n > 0) {
            memcpy(nd, p_mods, (p_mod_n * sizeof(PMod)).to_type(u64));
        }
        free(p_mods);
        p_mods = nd;
        p_mod_cap = ncap;
    }
    p_mods[p_mod_n].name_off = name_off;
    p_mods[p_mod_n].name_len = name_len;
    p_mods[p_mod_n].proj = proj;
    p_mods[p_mod_n].files = 0;
    p_mods[p_mod_n].file_n = 0;
    p_mods[p_mod_n].file_cap = 0;
    p_mods[p_mod_n].is_entry = 0;
    p_mod_n += 1;
    return p_mod_n - 1;
}

pub fn pj_proj_add_mod(proj int, mod int) int {
    if (p_projs[proj].mod_n == p_projs[proj].mod_cap) {
        let ncap int = p_projs[proj].mod_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (p_projs[proj].mod_n > 0) {
            memcpy(nd, p_projs[proj].mods, (p_projs[proj].mod_n * sizeof(int)).to_type(u64));
        }
        free(p_projs[proj].mods);
        p_projs[proj].mods = nd;
        p_projs[proj].mod_cap = ncap;
    }
    p_projs[proj].mods[p_projs[proj].mod_n] = mod;
    p_projs[proj].mod_n += 1;
    return 0;
}

pub fn pj_mod_add_file(mod int, file int) int {
    if (p_mods[mod].file_n == p_mods[mod].file_cap) {
        let ncap int = p_mods[mod].file_cap * 2;
        if (ncap == 0) {
            ncap = 8;
        }
        let nd *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (p_mods[mod].file_n > 0) {
            memcpy(nd, p_mods[mod].files, (p_mods[mod].file_n * sizeof(int)).to_type(u64));
        }
        free(p_mods[mod].files);
        p_mods[mod].files = nd;
        p_mods[mod].file_cap = ncap;
    }
    p_mods[mod].files[p_mods[mod].file_n] = file;
    p_mods[mod].file_n += 1;
    return 0;
}

pub fn pj_file_push(path_off int, path_len int, mod int) int {
    if (p_file_n == p_file_cap) {
        let ncap int = p_file_cap * 2;
        if (ncap == 0) {
            ncap = 32;
        }
        let nd *PFile = malloc((ncap * sizeof(PFile)).to_type(u64)).to_type(*PFile);
        if (nd == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (p_file_n > 0) {
            memcpy(nd, p_files, (p_file_n * sizeof(PFile)).to_type(u64));
        }
        free(p_files);
        p_files = nd;
        p_file_cap = ncap;
    }
    p_files[p_file_n].path_off = path_off;
    p_files[p_file_n].path_len = path_len;
    p_files[p_file_n].mod = mod;
    p_file_n += 1;
    return p_file_n - 1;
}

pub fn pj_imp_push(file int, off int, olen int, line int, col int) int {
    if (p_imp_n == p_imp_cap) {
        let ncap int = p_imp_cap * 2;
        if (ncap == 0) {
            ncap = 32;
        }
        let base int = ncap;
        let nd *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd, p_imp_file, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_file);
        p_imp_file = nd;
        let nd2 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd2 == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd2, p_imp_off, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_off);
        p_imp_off = nd2;
        let nd3 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd3 == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd3, p_imp_len, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_len);
        p_imp_len = nd3;
        let nd4 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd4 == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd4, p_imp_line, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_line);
        p_imp_line = nd4;
        let nd5 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd5 == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd5, p_imp_col, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_col);
        p_imp_col = nd5;
        let nd6 *int = malloc((base * sizeof(int)).to_type(u64)).to_type(*int);
        if (nd6 == 0) {
            return fail("内存分配失败");
        }
        if (p_imp_n > 0) {
            memcpy(nd6, p_imp_mod, (p_imp_n * sizeof(int)).to_type(u64));
        }
        free(p_imp_mod);
        p_imp_mod = nd6;
        p_imp_cap = ncap;
    }
    p_imp_file[p_imp_n] = file;
    p_imp_off[p_imp_n] = off;
    p_imp_len[p_imp_n] = olen;
    p_imp_line[p_imp_n] = line;
    p_imp_col[p_imp_n] = col;
    p_imp_mod[p_imp_n] = -1;
    p_imp_n += 1;
    return 0;
}

pub fn pj_proj_diag(root_off int, line int, msg *char) int {
    let buf [1024]u8;
    let n int = 0;
    n = append_str(buf, n, pj_pool_str(root_off));
    n = append_str(buf, n, "/mod.toml:");
    n = append_int(buf, n, line);
    n = append_str(buf, n, ": 错误: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    c_errors += 1;
    return -1;
}


// ============================================================================
// project_index.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn pj_load_project(root_off int, root_len int) int {
    // 依赖环 / 重复装载
    let known int = pj_proj_find_root(root_off, root_len);
    if (known >= 0) {
        if (p_state[known] == 1) {
            pj_proj_diag(root_off, 0, "依赖环：项目正在装载中");
            return -1;
        }
        return known;
    }
    let me int = pj_proj_push(root_off, root_len);
    if (me < 0) {
        return -1;
    }
    // p_state 平行扩容
    let nst *int = malloc((p_proj_cap * sizeof(int)).to_type(u64)).to_type(*int);
    if (nst == 0) {
        return fail("内存分配失败");
    }
    if (p_proj_n > 0) {
        memcpy(nst, p_state, ((p_proj_n - 1) * sizeof(int)).to_type(u64));
    }
    free(p_state);
    p_state = nst;
    p_state[me] = 1;
    // 读清单
    let mpath [1024]u8;
    let mn int = 0;
    mn = append_str(mpath, mn, pj_pool_str(root_off));
    mn = append_str(mpath, mn, "/mod.toml");
    mpath[mn] = 0;
    if (read_source(arr_cstr(mpath)) != 0) {
        return -1;
    }
    t_src = c_src;
    t_len = c_src_len;
    t_pos = 0;
    t_line = 1;
    t_file = arr_cstr(mpath);
    toml_sec_n = 0;
    if (tml_parse() != 0) {
        return -1;
    }
    // schema：[project]
    let sec int = toml_find_sec("project");
    if (sec < 0) {
        return pj_proj_diag(root_off, 1, "缺少 [project] 节");
    }
    let so int = 0;
    let sl int = 0;
    let got int = toml_sec_str(sec, "name", &so, &sl);
    if (got < 0) {
        return -1;
    }
    if (got == 0 || sl == 0) {
        return pj_proj_diag(root_off, toml_secs[sec].line, "project.name 必填且非空");
    }
    p_projs[me].name_off = so;
    p_projs[me].name_len = sl;
    // source（默认 src）
    got = toml_sec_str(sec, "source", &so, &sl);
    if (got < 0) {
        return -1;
    }
    let srcname *char = "src";
    if (got == 1) {
        srcname = pj_pool_str(so);
    }
    if (pj_canon(root_off, root_len, srcname) != 0) {
        return -1;
    }
    p_projs[me].src_off = pj_canon_off;
    p_projs[me].src_len = pj_canon_len;
    // entry（可省 = 库项目）
    got = toml_sec_str(sec, "entry", &so, &sl);
    if (got < 0) {
        return -1;
    }
    if (got == 1) {
        p_projs[me].entry_off = so;
        p_projs[me].entry_len = sl;
    }
    got = toml_sec_str(sec, "version", &so, &sl);
    if (got < 0) {
        return -1;
    }
    // [project] 未知字段检查
    let vi int = 0;
    for vi < toml_secs[sec].val_n {
        let vo int = toml_secs[sec].vals[vi].key_off;
        let vl int = toml_secs[sec].vals[vi].key_len;
        let okf int = 0;
        if (vl == 4 && np_data[vo] == 'n' && np_data[vo + 1] == 'a'
            && np_data[vo + 2] == 'm' && np_data[vo + 3] == 'e') { okf = 1; }
        if (vl == 7 && np_data[vo] == 'v' && np_data[vo + 1] == 'e'
            && np_data[vo + 2] == 'r' && np_data[vo + 3] == 's'
            && np_data[vo + 4] == 'i' && np_data[vo + 5] == 'o'
            && np_data[vo + 6] == 'n') { okf = 1; }
        if (vl == 6 && np_data[vo] == 's' && np_data[vo + 1] == 'o'
            && np_data[vo + 2] == 'u' && np_data[vo + 3] == 'r'
            && np_data[vo + 4] == 'c' && np_data[vo + 5] == 'e') { okf = 1; }
        if (vl == 5 && np_data[vo] == 'e' && np_data[vo + 1] == 'n'
            && np_data[vo + 2] == 't' && np_data[vo + 3] == 'r'
            && np_data[vo + 4] == 'y') { okf = 1; }
        if (okf == 0) {
            let buf [64]u8;
            let bn int = 0;
            bn = append_str(buf, bn, "project 未知字段: ");
            let k int = 0;
            for k < vl {
                buf[bn] = np_data[vo + k];
                bn += 1;
                k += 1;
            }
            let mo int = tml_intern_str(buf, 0, bn);
            if (mo < 0) {
                return -1;
            }
            return pj_proj_diag(root_off, toml_secs[sec].vals[vi].line, np_cstr(mo));
        }
        vi += 1;
    }
    // [dependencies]：先整表快照——递归装载会重置 toml_secs（全局解析区）
    let dsec int = toml_find_sec("dependencies");
    let snap_key_off [64]int;
    let snap_key_len [64]int;
    let snap_path_off [64]int;
    let snap_line [64]int;
    let snap_n int = 0;
    if (dsec >= 0) {
        for snap_n < toml_secs[dsec].val_n && snap_n < 64 {
            snap_key_off[snap_n] = toml_secs[dsec].vals[snap_n].key_off;
            snap_key_len[snap_n] = toml_secs[dsec].vals[snap_n].key_len;
            snap_path_off[snap_n] = toml_secs[dsec].vals[snap_n].path_off;
            snap_line[snap_n] = toml_secs[dsec].vals[snap_n].line;
            snap_n += 1;
        }
    }
    if (dsec >= 0) {
        let di int = 0;
            for di < snap_n {
                    // 快照依赖条目：递归装载会重置 toml_secs（全局解析区）
            let key_off int = snap_key_off[di];
            let key_len int = snap_key_len[di];
            let dep_line int = snap_line[di];
            if (snap_path_off[di] < 0) {
                return pj_proj_diag(root_off, dep_line,
                    "依赖必须是 { path = \"...\" } 表");
            }
            let path_off int = snap_path_off[di];
            // 依赖项目根 = 规范化(root + path)
            if (pj_canon(root_off, root_len, pj_pool_str(path_off)) != 0) {
                return -1;
            }
            let dep int = pj_load_project(pj_canon_off, pj_canon_len);
            if (dep < 0) {
                return -1;
            }
            // 登记依赖
            if (p_projs[me].dep_n == p_projs[me].dep_cap) {
                let ncap int = p_projs[me].dep_cap * 2;
                if (ncap == 0) {
                    ncap = 8;
                }
                let nd *PDep = malloc((ncap * sizeof(PDep)).to_type(u64)).to_type(*PDep);
                if (nd == 0) {
                    return fail("内存分配失败");
                }
                if (p_projs[me].dep_n > 0) {
                    memcpy(nd, p_projs[me].deps, (p_projs[me].dep_n * sizeof(PDep)).to_type(u64));
                }
                free(p_projs[me].deps);
                p_projs[me].deps = nd;
                p_projs[me].dep_cap = ncap;
            }
            p_projs[me].deps[p_projs[me].dep_n].key_off = key_off;
            p_projs[me].deps[p_projs[me].dep_n].key_len = key_len;
            p_projs[me].deps[p_projs[me].dep_n].proj = dep;
            p_projs[me].deps[p_projs[me].dep_n].line = dep_line;
            p_projs[me].dep_n += 1;
            di += 1;
        }
    }
    // 扫描源码根
    if (pj_scan_source(p_projs[me].src_off, p_projs[me].src_len, me) != 0) {
        return -1;
    }
    // 入口模块标记
    if (p_projs[me].entry_off >= 0) {
        let mi int = 0;
        for mi < p_projs[me].mod_n {
            let um int = p_projs[me].mods[mi];
            if (p_mods[um].name_len == p_projs[me].entry_len
                && np_data[p_mods[um].name_off] == np_data[p_projs[me].entry_off]) {
                let match2 int = 1;
                let j2 int = 1;
                for j2 < p_projs[me].entry_len {
                    if (np_data[p_mods[um].name_off + j2] != np_data[p_projs[me].entry_off + j2]) {
                        match2 = 0;
                        break;
                    }
                    j2 += 1;
                }
                if (match2 != 0) {
                    p_mods[um].is_entry = 1;
                }
            }
            mi += 1;
        }
    }
    p_state[me] = 2;
    return me;
}

pub fn pj_scan_source(dir_off int, dir_len int, proj int) int {
    if (pj_run_ls(pj_pool_str(dir_off)) != 0) {
        return -1;
    }
    // 两阶段：先收集本目录条目，再逐条处理——子目录递归会重用共享
    // ls 缓冲（pj_run_ls 覆盖 pj_ls_buf），不能边迭代边递归。
    let es_off [512]int;
    let es_len [512]int;
    let es_dir [512]int;
    let es_n int = 0;
    let i int = 0;
    let line_start int = 0;
    for i <= pj_ls_len {
        if (i == pj_ls_len || pj_ls_buf[i] == '\n') {
            let n int = i - line_start;
            if (n > 0 && pj_ls_buf[line_start + n - 1] == '\r') {
                n -= 1;
            }
            if (n > 0) {
                let is_dir int = 0;
                if (pj_ls_buf[line_start + n - 1] == '/') {
                    is_dir = 1;
                    n -= 1;
                }
                if (n > 0 && es_n < 512) {
                    // 名字立即入名字池：后续递归会覆盖 pj_ls_buf
                    let no int = tml_intern_str(pj_ls_buf, line_start, n);
                    if (no < 0) {
                        return -1;
                    }
                    es_off[es_n] = no;
                    es_len[es_n] = n;
                    es_dir[es_n] = is_dir;
                    es_n += 1;
                }
            }
            line_start = i + 1;
        }
        i += 1;
    }
    let e int = 0;
    for e < es_n {
            let r int = pj_scan_entry(dir_off, dir_len, es_off[e], es_len[e], es_dir[e], proj);
        if (r != 0) {
            return -1;
        }
        e += 1;
    }
    return 0;
}

pub fn pj_scan_entry(dir_off int, dir_len int, name_start int, name_len int, is_dir int, proj int) int {
    if (is_dir != 0) {
        // 子目录相对路径：<dir>/<name>，规范化后递归
        let nm [300]u8;
        let nn int = 0;
        let k2 int = 0;
        for k2 < name_len {
            nm[nn] = np_data[name_start + k2];
            nn += 1;
            k2 += 1;
        }
        nm[nn] = 0;
        if (pj_canon(dir_off, dir_len, arr_cstr(nm)) != 0) {
            return -1;
        }
        let sub_off int = pj_canon_off;
        let sub_len int = pj_canon_len;
        // 嵌套项目边界：含 mod.toml 的子目录属于另一项目，不进入
        let probe [1100]u8;
        let pn int = 0;
        pn = append_str(probe, pn, pj_pool_str(sub_off));
        pn = append_str(probe, pn, "/mod.toml");
        probe[pn] = 0;
        if (pj_file_exists(arr_cstr(probe)) != 0) {
            return 0;
        }
        return pj_scan_source(sub_off, sub_len, proj);
    }
    // .yh 后缀检查
    if (name_len < 3 || np_data[name_start + name_len - 3] != '.'
        || np_data[name_start + name_len - 2] != 'y' || np_data[name_start + name_len - 1] != 'h') {
        return 0;
    }
    // 完整路径 = <dir>/<name>
    let full [1100]u8;
    let flen2 int = 0;
    flen2 = append_str(full, flen2, pj_pool_str(dir_off));
    full[flen2] = '/';
    flen2 += 1;
    let k int = 0;
    for k < name_len {
        full[flen2] = np_data[name_start + k];
        flen2 += 1;
        k += 1;
    }
    full[flen2] = 0;
    // 读文件并解析模块头（诊断指向被扫文件）
    let save_path *char = c_path;
    c_path = arr_cstr(full);
    let r int = pj_index_file(arr_cstr(full), proj);
    c_path = save_path;
    return r;
}

pub fn pj_index_file(path *char, proj int) int {
    if (read_source(path) != 0) {
        return -1;
    }
    c_tok_n = 0;
    c_pos = 0;
    c_errors = 0;
    if (lex_all() != 0) {
        return -1;
    }
    mod_reset_file();
    if (mod_parse_head() != 0) {
        return -1;
    }
    if (mod_has_module == 0) {
        // 源码根内的文件必须声明模块（旧单文件形态不属于项目源码根）
        c_errors += 1;
        let buf [256]u8;
        let n int = 0;
        n = append_str(buf, n, c_path);
        n = append_str(buf, n, ":1:1: 错误: 项目源码内的文件必须以 module 声明开头\n");
        write_all(2, buf, n);
        return -1;
    }
    // 查找/创建模块
    let mod int = -1;
    let mi int = 0;
    for mi < p_mod_n {
        if (p_mods[mi].proj == proj && p_mods[mi].name_len == mod_name_len
            && np_data[p_mods[mi].name_off] == np_data[mod_name_off]) {
            let match int = 1;
            let j int = 1;
            for j < mod_name_len {
                if (np_data[p_mods[mi].name_off + j] != np_data[mod_name_off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                mod = mi;
                break;
            }
        }
        mi += 1;
    }
    if (mod < 0) {
        mod = pj_mod_push(mod_name_off, mod_name_len, proj);
        if (mod < 0) {
            return -1;
        }
        if (pj_proj_add_mod(proj, mod) != 0) {
            return -1;
        }
    }
    // 登记文件（路径 intern）
    let plen int = 0;
    for path[plen] != 0 {
        plen += 1;
    }
    let poff int = tml_intern_str(path.to_type(*u8), 0, plen);
    if (poff < 0) {
        return -1;
    }
    let fidx int = pj_file_push(poff, plen, mod);
    if (fidx < 0) {
        return -1;
    }
    if (pj_mod_add_file(mod, fidx) != 0) {
        return -1;
    }
    // 导入记录
    let ii int = 0;
    for ii < mod_import_n {
        if (pj_imp_push(fidx, mod_imports[ii].name_off, mod_imports[ii].name_len,
            mod_imports[ii].line, mod_imports[ii].col) != 0) {
            return -1;
        }
        ii += 1;
    }
    return 0;
}


// ============================================================================
// project_resolve.yh —— 项目发现/索引/解析
// 自 parse_decl.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn pj_mod_in_proj(proj int, off int, olen int) int {
    let i int = 0;
    for i < p_projs[proj].mod_n {
        let m int = p_projs[proj].mods[i];
        if (p_mods[m].name_len == olen
            && np_data[p_mods[m].name_off] == np_data[off]) {
            let match int = 1;
            let j int = 1;
            for j < olen {
                if (np_data[p_mods[m].name_off + j] != np_data[off + j]) {
                    match = 0;
                    break;
                }
                j += 1;
            }
            if (match != 0) {
                return m;
            }
        }
        i += 1;
    }
    return -1;
}

pub fn pj_bind_imports() int {
    let i int = 0;
    for i < p_imp_n {
        let f int = p_imp_file[i];
        let proj int = p_mods[p_files[f].mod].proj;
        let off int = p_imp_off[i];
        let olen int = p_imp_len[i];
        // 第 1 层：本项目
        let m int = pj_mod_in_proj(proj, off, olen);
        if (m >= 0) {
            if (p_mods[m].is_entry != 0) {
                let buf [128]u8;
                let n int = 0;
                n = append_str(buf, n, "入口模块不可作为库导入: ");
                n = append_bytes_np(buf, n, off, olen);
                let mo int = tml_intern_str(buf, 0, n);
                if (mo < 0) {
                    return -1;
                }
                return imp_diag(i, np_cstr(mo));
            }
            p_imp_mod[i] = m;
            i += 1;
            continue;
        }
        // 第 2 层：标准库
        if (p_stdlib >= 0) {
            m = pj_mod_in_proj(p_stdlib, off, olen);
            if (m >= 0) {
                p_imp_mod[i] = m;
                i += 1;
                continue;
            }
        }
        // 第 3 层：直接依赖（排除其入口模块；多个候选 = 歧义）
        let found int = -1;
        let count int = 0;
        let di int = 0;
        for di < p_projs[proj].dep_n {
            let dp int = p_projs[proj].deps[di].proj;
            let cm int = pj_mod_in_proj(dp, off, olen);
            if (cm >= 0 && p_mods[cm].is_entry == 0) {
                count += 1;
                found = cm;
            }
            di += 1;
        }
        if (count > 1) {
            let buf3 [256]u8;
            let n3 int = 0;
            n3 = append_str(buf3, n3, "模块名歧义（多个直接依赖提供）: ");
            n3 = append_bytes_np(buf3, n3, off, olen);
            let mo3 int = tml_intern_str(buf3, 0, n3);
            if (mo3 < 0) {
                return -1;
            }
            return imp_diag(i, np_cstr(mo3));
        }
        if (count == 1) {
            p_imp_mod[i] = found;
            i += 1;
            continue;
        }
        let buf2 [192]u8;
        let n2 int = 0;
        n2 = append_str(buf2, n2, "模块不存在: ");
        n2 = append_bytes_np(buf2, n2, off, olen);
        n2 = append_str(buf2, n2, "（已搜索 本项目 → 标准库 → 直接依赖）");
        let mo2 int = tml_intern_str(buf2, 0, n2);
        if (mo2 < 0) {
            return -1;
        }
        return imp_diag(i, np_cstr(mo2));
    }
    return 0;
}

pub fn append_bytes_np(buf *u8, n int, off int, olen int) int {
    let i int = 0;
    for i < olen {
        buf[n] = np_data[off + i];
        n += 1;
        i += 1;
    }
    return n;
}

pub fn imp_diag(i int, msg *char) int {
    let f int = p_imp_file[i];
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, pj_pool_str(p_files[f].path_off));
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, p_imp_line[i]);
    n = append_byte(buf, n, ':');
    n = append_int(buf, n, p_imp_col[i]);
    n = append_str(buf, n, ": 错误: ");
    n = append_str(buf, n, msg);
    n = append_byte(buf, n, '\n');
    write_all(2, buf, n);
    c_errors += 1;
    return -1;
}


// —— topo 排序与环路诊断 ——

pub let pj_mark *int = 0;       // 模块标记（0 未访问 1 访问中 2 完成），随 p_mod_n 增长
pub let pj_order *int = 0;      // topo 结果
pub let pj_order_n int = 0;
pub let pj_pathstk *int = 0;    // 访问路径栈（环诊断）
pub let pj_pathstk_n int = 0;
pub fn pj_mod_edge(m int, e int) int {
    let seen int = 0;
    let fi int = 0;
    for fi < p_mods[m].file_n {
        let f int = p_mods[m].files[fi];
        let ii int = 0;
        for ii < p_imp_n {
            if (p_imp_file[ii] == f && p_imp_mod[ii] >= 0) {
                let target int = p_imp_mod[ii];
                // 是否已作为更早的边出现过
                let done int = 0;
                let fi2 int = 0;
                for fi2 < p_mods[m].file_n {
                    let f2 int = p_mods[m].files[fi2];
                    let ii2 int = 0;
                    for ii2 < p_imp_n {
                        if (p_imp_file[ii2] == f2 && p_imp_mod[ii2] == target) {
                            if (ii2 < ii || fi2 < fi) {
                                done = 1;
                            }
                            break;
                        }
                        ii2 += 1;
                    }
                    if (done != 0) {
                        break;
                    }
                    fi2 += 1;
                }
                if (done == 0) {
                    if (seen == e) {
                        return target;
                    }
                    seen += 1;
                }
            }
            ii += 1;
        }
        fi += 1;
    }
    return -1;
}

pub fn pj_dfs(m int) int {
    if (pj_mark[m] == 2) {
        return 0;
    }
    if (pj_mark[m] == 1) {
        // 环：路径栈中从 m 开始的链
        let buf [512]u8;
        let n int = 0;
        n = append_str(buf, n, "模块导入环: ");
        let start int = 0;
        for start < pj_pathstk_n {
            if (pj_pathstk[start] == m) {
                break;
            }
            start += 1;
        }
        let k int = start;
        for k < pj_pathstk_n {
            n = append_bytes_np(buf, n, p_mods[pj_pathstk[k]].name_off, p_mods[pj_pathstk[k]].name_len);
            n = append_str(buf, n, " -> ");
            k += 1;
        }
        n = append_bytes_np(buf, n, p_mods[m].name_off, p_mods[m].name_len);
        let mo int = tml_intern_str(buf, 0, n);
        if (mo < 0) {
            return -1;
        }
        c_errors += 1;
        let out [600]u8;
        let on int = 0;
        on = append_str(out, on, "yh: ");
        on = append_bytes_np(out, on, mo, n);
        on = append_byte(out, on, '\n');
        write_all(2, out, on);
        return -1;
    }
    pj_mark[m] = 1;
    pj_pathstk[pj_pathstk_n] = m;
    pj_pathstk_n += 1;
    let e int = 0;
    for 1 {
        let target int = pj_mod_edge(m, e);
        if (target < 0) {
            break;
        }
        if (pj_dfs(target) != 0) {
            return -1;
        }
        e += 1;
    }
    pj_pathstk_n -= 1;
    pj_mark[m] = 2;
    pj_order[pj_order_n] = m;
    pj_order_n += 1;
    return 0;
}

pub fn pj_topo(root int) int {
    // 标记数组按需扩容
    if (p_mod_n > 0) {
        let nm *int = malloc((p_mod_n * sizeof(int)).to_type(u64)).to_type(*int);
        if (nm == 0) {
            fail("内存分配失败");
            return -1;
        }
        if (pj_mark != 0) {
            free(pj_mark);
        }
        pj_mark = nm;
        let ord *int = malloc((p_mod_n * sizeof(int)).to_type(u64)).to_type(*int);
        if (ord == 0) {
            return fail("内存分配失败");
        }
        if (pj_order != 0) {
            free(pj_order);
        }
        pj_order = ord;
        let stk *int = malloc((p_mod_n * sizeof(int)).to_type(u64)).to_type(*int);
        if (stk == 0) {
            return fail("内存分配失败");
        }
        if (pj_pathstk != 0) {
            free(pj_pathstk);
        }
        pj_pathstk = stk;
    }
    let i int = 0;
    for i < p_mod_n {
        pj_mark[i] = 0;
        i += 1;
    }
    pj_order_n = 0;
    pj_pathstk_n = 0;
    if (pj_dfs(root) != 0) {
        return -1;
    }
    return pj_order_n;
}

pub fn pj_mod_suffix(proj int, mod int, off *int, olen *int) int {
    let tmp [512]u8;
    let n int = 0;
    n = append_byte(tmp, n, '_');
    n = append_byte(tmp, n, '_');
    let i int = 0;
    for i < p_projs[proj].name_len {
        let b u8 = np_data[p_projs[proj].name_off + i];
        if (!((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '_')) {
            b = '_';
        }
        tmp[n] = b;
        n += 1;
        i += 1;
    }
    n = append_byte(tmp, n, '_');
    n = append_byte(tmp, n, '_');
    i = 0;
    for i < p_mods[mod].name_len {
        let b2 u8 = np_data[p_mods[mod].name_off + i];
        if (!((b2 >= 'a' && b2 <= 'z') || (b2 >= 'A' && b2 <= 'Z')
            || (b2 >= '0' && b2 <= '9') || b2 == '_')) {
            b2 = '_';
        }
        tmp[n] = b2;
        n += 1;
        i += 1;
    }
    // 再加一个 '_' 结尾：符号形如 name__proj__mod_
    n = append_byte(tmp, n, '_');
    tmp[n] = 0;
    off[0] = tml_intern_str(tmp, 0, n);
    olen[0] = n;
    if (off[0] < 0) {
        return -1;
    }
    return 0;
}

pub fn pj_out_np(off int, olen int) void {
    write_all(1, np_data + off, olen);
}

pub fn pj_out_s(s *char) void {
    let n int = 0;
    for s[n] != 0 {
        n += 1;
    }
    write_all(1, s.to_type(*u8), n);
}

pub fn pj_source_cat(importer int, m int) *char {
    if (p_mods[m].proj == importer) {
        return "本地";
    }
    if (p_mods[m].proj == p_stdlib) {
        return "标准库";
    }
    return "第三方";
}

pub fn pj_cmd_list(root int, resolve_off int, resolve_len int, has_resolve int) int {
    pj_out_s("项目 ");
    pj_out_np(p_projs[root].name_off, p_projs[root].name_len);
    pj_out_s("（源码根 ");
    pj_out_np(p_projs[root].src_off, p_projs[root].src_len);
    pj_out_s("）\n");
    let i int = 0;
    for i < p_projs[root].mod_n {
        let m int = p_projs[root].mods[i];
        pj_out_s("  模块 ");
        pj_out_np(p_mods[m].name_off, p_mods[m].name_len);
        if (p_mods[m].is_entry != 0) {
            pj_out_s("（入口）");
        }
        pj_out_s("\n");
        let fi int = 0;
        for fi < p_mods[m].file_n {
            pj_out_s("    ");
            pj_out_np(p_files[p_mods[m].files[fi]].path_off, p_files[p_mods[m].files[fi]].path_len);
            pj_out_s("\n");
            fi += 1;
        }
        i += 1;
    }
    if (has_resolve == 0) {
        return 0;
    }
    pj_out_s("import 解析: ");
    pj_out_np(resolve_off, resolve_len);
    pj_out_s("\n");
    // 按当前项目上下文演示三层搜索
    let rm int = pj_mod_in_proj(root, resolve_off, resolve_len);
    let cat *char = 0;
    if (rm >= 0) {
        if (p_mods[rm].is_entry != 0) {
            pj_out_s("  命中本项目入口模块（不可导入）\n");
            return 1;
        }
        cat = "本地";
    }
    if (rm < 0 && p_stdlib >= 0) {
        rm = pj_mod_in_proj(p_stdlib, resolve_off, resolve_len);
        if (rm >= 0) {
            cat = "标准库";
        }
    }
    if (rm < 0) {
        let count int = 0;
        let found int = -1;
        let di int = 0;
        for di < p_projs[root].dep_n {
            let cm int = pj_mod_in_proj(p_projs[root].deps[di].proj, resolve_off, resolve_len);
            if (cm >= 0 && p_mods[cm].is_entry == 0) {
                count += 1;
                found = cm;
            }
            di += 1;
        }
        if (count > 1) {
            pj_out_s("  歧义：多个直接依赖提供同名模块\n");
            return 1;
        }
        if (count == 1) {
            rm = found;
            cat = "第三方";
        }
    }
    if (rm < 0) {
        pj_out_s("  未找到（搜索顺序 本项目 → 标准库 → 直接依赖）\n");
        return 1;
    }
    pj_out_s("  来源: ");
    pj_out_s(cat);
    pj_out_s("  项目: ");
    pj_out_np(p_projs[p_mods[rm].proj].name_off, p_projs[p_mods[rm].proj].name_len);
    pj_out_s("\n");
    let fi2 int = 0;
    for fi2 < p_mods[rm].file_n {
        pj_out_s("    ");
        pj_out_np(p_files[p_mods[rm].files[fi2]].path_off, p_files[p_mods[rm].files[fi2]].path_len);
        pj_out_s("\n");
        fi2 += 1;
    }
    return 0;
}

pub fn pj_find_root() int {
    let depth int = 0;
    for depth <= 32 {
        // 组装候选路径：depth 个 "../" + "mod.toml"
        let cand [512]u8;
        let n int = 0;
        let rootb [512]u8;
        let rn int = 0;
        let k int = 0;
        for k < depth {
            rootb[rn] = '.';
            rootb[rn + 1] = '.';
            rootb[rn + 2] = '/';
            rn += 3;
            k += 1;
        }
        if (rn == 0) {
            rootb[0] = '.';
            rn = 1;
        }
        rootb[rn] = 0;
        n = append_str(cand, n, arr_cstr(rootb));
        n = append_str(cand, n, "/mod.toml");
        cand[n] = 0;
        if (pj_file_exists(arr_cstr(cand)) != 0) {
            // 根直接入池（相对前缀本身已规范）
            let off int = tml_intern_str(rootb, 0, rn);
            if (off < 0) {
                return -1;
            }
            pj_canon_off = off;
            pj_canon_len = rn;
            return off;
        }
        depth += 1;
    }
    fail("未找到 mod.toml（自当前目录向上 32 层）");
    return -1;
}


// ============================================================================
// module_build.yh —— 项目构建管线（MOD-U4/U5）
//
// 命令（设计 §11）：
//   yh build [-o out] [module]   构建项目（有 entry 构建程序，否则库模块）
//   yh run                       构建并运行清单 entry
//   yh list [--resolve name]     列出模块/解释导入绑定（project.yh）
//   yh --emit-module M ROOT -o S （内部）把模块 M 编译为独立汇编 S
//
// 构建流程：装载项目与依赖 → 绑定导入 → topo 排序（环报完整链）→
// 依赖序逐模块编译。每个模块一次独立子进程（--emit-module，自身
// argv[0] 再入）：加载其导入的接口 → 两遍编译模块全部文件 → 产出
// 独立 .s 与接口 .s.i（pub 符号 GLOBAL、私有 LOCAL、符号带
// __proj__mod 后缀）→ 最后 gcc/clang 一次链接全部 .s。
//
// 缓存（U5）：解析不缓存（每轮重解析——重绑定由构造保证）；对象缓存
// 按 manifest 内容哈希：后缀+entry+各源文件内容+各依赖接口内容+版本
// 标记，命中且 .s/.i 存在则跳过重编译；发射确定性（G3 已证）保证
// 冷热构建一致。接口加载时校验头行（版本/架构），损坏或不兼容的
// 接口干净拒绝，不回退低层。
//
// ponytail: 经 system+ls/printenv 访问目录与环境（stage0 prelude 冻结，
// 无 opendir/getenv）；路径含空格/引号不受支持，fixture 路径保持简单。
// ============================================================================

// c_argv0：自身可执行路径（argv[0] 借用，不复制）——子进程再入用。
pub let c_argv0 *char = 0;

// mb_fnv：FNV-1a 32 位增量哈希（用 u64 运算，每步掩码到 32 位——
// 自编子集没有 u32）。
pub fn mb_fnv(h *u64, b u8) void {
    h[0] = h[0] ^ b.to_type(u64);
    h[0] = (h[0] * 16777619) & 0xFFFFFFFF;
}

// mb_hash_file：把文件内容混入哈希（read_source 读入；失败 -1）。
pub fn mb_hash_file(h *u64, path *char) int {
    if (read_source(path) != 0) {
        return -1;
    }
    let i int = 0;
    for i < c_src_len {
        mb_fnv(h, c_src[i]);
        i += 1;
    }
    return 0;
}

// mb_build_dir：构建目录 = <root>/tmp/yh-build（返回池内偏移）。
pub fn mb_build_dir(root_off int, root_len int) int {
    if (pj_canon(root_off, root_len, "tmp/yh-build") != 0) {
        return -1;
    }
    return pj_canon_off;
}

// mb_mkdir：确保构建目录存在。
pub fn mb_mkdir(dir *char) int {
    let cmd [1100]u8;
    let n int = 0;
    n = append_str(cmd, n, "/bin/mkdir -p ");
    n = pj_shell_quote(cmd, n, dir);
    cmd[n] = 0;
    if (system(arr_cstr(cmd)) != 0) {
        return fail_path("无法创建构建目录: ", dir);
    }
    return 0;
}

// mb_dep_bind / mb_dep_ifoff：模块导入的去重清单（绑定名池偏移 + 接口
// 路径池偏移）。mb_module_iface_deps 每次重建。
pub let mb_dep_bind *int = 0;
pub let mb_dep_bindlen *int = 0;
pub let mb_dep_ifoff *int = 0;
pub let mb_dep_n int = 0;
pub let mb_dep_cap int = 0;

// mb_module_iface_deps：收集模块 M 的全部导入（按导入声明序去重），
// 接口路径 = <build>/<模块名>.s.i。
pub fn mb_module_iface_deps(m int, build_off int, build_len int) int {
    mb_dep_n = 0;
    let fi int = 0;
    for fi < p_mods[m].file_n {
        let f int = p_mods[m].files[fi];
        let ii int = 0;
        for ii < p_imp_n {
            if (p_imp_file[ii] != f || p_imp_mod[ii] < 0) {
                ii += 1;
                continue;
            }
            let target int = p_imp_mod[ii];
            // 去重：同名绑定只收集一次
            let dup int = 0;
            let k int = 0;
            for k < mb_dep_n {
                if (mb_dep_bind[k] == p_imp_off[ii]) {
                    dup = 1;
                    break;
                }
                k += 1;
            }
            if (dup == 0) {
                if (mb_dep_n == mb_dep_cap) {
                    let ncap int = mb_dep_cap * 2;
                    if (ncap == 0) {
                        ncap = 8;
                    }
                    let na *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (na == 0) {
                        return fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(na, mb_dep_bind, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_bind);
                    mb_dep_bind = na;
                    let nb *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (nb == 0) {
                        return fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(nb, mb_dep_bindlen, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_bindlen);
                    mb_dep_bindlen = nb;
                    let nc *int = malloc((ncap * sizeof(int)).to_type(u64)).to_type(*int);
                    if (nc == 0) {
                        return fail("内存分配失败");
                    }
                    if (mb_dep_n > 0) {
                        memcpy(nc, mb_dep_ifoff, (mb_dep_n * sizeof(int)).to_type(u64));
                    }
                    free(mb_dep_ifoff);
                    mb_dep_ifoff = nc;
                    mb_dep_cap = ncap;
                }
                mb_dep_bind[mb_dep_n] = p_imp_off[ii];
                mb_dep_bindlen[mb_dep_n] = p_imp_len[ii];
                if (pj_canon(build_off, build_len, pj_pool_str(p_mods[target].name_off)) != 0) {
                    return -1;
                }
                let pbuf [600]u8;
                let pn int = 0;
                pn = append_str(pbuf, pn, pj_pool_str(pj_canon_off));
                pn = append_str(pbuf, pn, ".s.i");
                let po int = tml_intern_str(pbuf, 0, pn);
                if (po < 0) {
                    return -1;
                }
                mb_dep_ifoff[mb_dep_n] = po;
                mb_dep_n += 1;
            }
            ii += 1;
        }
        fi += 1;
    }
    return mb_dep_n;
}

// mb_open_out：以平台正确的旗标打开输出文件（覆盖写）。
pub fn mb_open_out(path *char) int {
    let flg int = 0x241;
    if (tg_darwin() != 0) {
        flg = 0x601;
    }
    return open(path, flg, 0x1a4);
}

// mb_compile_one：编译单个模块（含 U5 对象缓存判断）。返回 0 成功。
// root_off/len：项目根（调用方捕获的池偏移；函数内部 canon 会改写全局
// 游标，故由调用方先取好）。
pub fn mb_compile_one(m int, root_off int, root_len int, build_off int, build_len int) int {
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (pj_mod_suffix(p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    let is_entry int = p_mods[m].is_entry;
    // 输出路径基 = <build>/<模块名>
    if (pj_canon(build_off, build_len, pj_pool_str(p_mods[m].name_off)) != 0) {
        return -1;
    }
    let base_off int = pj_canon_off;
    let spath [600]u8;
    let sn int = 0;
    sn = append_str(spath, sn, pj_pool_str(base_off));
    sn = append_str(spath, sn, ".s");
    spath[sn] = 0;
    let ipath [600]u8;
    let in2 int = 0;
    in2 = append_str(ipath, in2, pj_pool_str(base_off));
    in2 = append_str(ipath, in2, ".s.i");
    ipath[in2] = 0;
    let mpath [600]u8;
    let mn int = 0;
    mn = append_str(mpath, mn, pj_pool_str(base_off));
    mn = append_str(mpath, mn, ".manifest");
    mpath[mn] = 0;
    // —— manifest 哈希（U5）——
    let h u64 = 2166136261;
    let hi int = 0;
    for hi < sfx_len {
        mb_fnv(&h, np_data[sfx_off + hi]);
        hi += 1;
    }
    mb_fnv(&h, ('0' + is_entry).to_type(u8));
    mb_fnv(&h, '\n');
    let fi int = 0;
    for fi < p_mods[m].file_n {
        if (mb_hash_file(&h, pj_pool_str(p_files[p_mods[m].files[fi]].path_off)) != 0) {
            return -1;
        }
        fi += 1;
    }
    // 依赖接口内容（解析结果变化 → 接口路径变化 → 哈希变化）
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1;
    }
    let di int = 0;
    for di < mb_dep_n {
        if (pj_file_exists(pj_pool_str(mb_dep_ifoff[di])) == 0) {
            // 依赖接口缺失：视为需要重编译
            di = mb_dep_n + 1;
            break;
        }
        if (mb_hash_file(&h, pj_pool_str(mb_dep_ifoff[di])) != 0) {
            return -1;
        }
        di += 1;
    }
    let deps_ok int = 1;
    if (di == mb_dep_n + 1) {
        deps_ok = 0;
    }
    // 版本标记
    let tag *char = "yh-iface-cache-1";
    let ti int = 0;
    for tag[ti] != 0 {
        mb_fnv(&h, tag[ti].to_type(u8));
        ti += 1;
    }
    // 期望 manifest（十六进制串）
    let want [16]u8;
    let wn int = 0;
    let digits *char = "0123456789abcdef";
    let shift int = 28;
    for shift >= 0 {
        want[wn] = digits[((h >> shift) & 15).to_type(int)].to_type(u8);
        wn += 1;
        shift -= 4;
    }
    // 缓存命中：三个产物齐全且 manifest 字节一致
    if (deps_ok != 0 && pj_file_exists(arr_cstr(spath)) != 0
        && pj_file_exists(arr_cstr(ipath)) != 0
        && pj_file_exists(arr_cstr(mpath)) != 0) {
        if (read_source(arr_cstr(mpath)) == 0 && c_src_len == wn) {
            let same int = 1;
            let ci int = 0;
            for ci < wn {
                if (c_src[ci] != want[ci]) {
                    same = 0;
                    break;
                }
                ci += 1;
            }
            if (same != 0) {
                pj_out_s("  [缓存] ");
                pj_out_np(p_mods[m].name_off, p_mods[m].name_len);
                pj_out_s("\n");
                return 0;
            }
        }
    }
    // —— 子进程编译（提供方项目根 + 主项目根） ——
    let prov int = p_mods[m].proj;
    let cmd [2200]u8;
    let cn int = 0;
    cn = mb_self_cmd(cmd, cn);
    cn = append_str(cmd, cn, " --emit-module ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(p_mods[m].name_off));
    cn = append_str(cmd, cn, " ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(p_projs[prov].root_off));
    cn = append_str(cmd, cn, " ");
    cn = pj_shell_quote(cmd, cn, pj_pool_str(root_off));
    cn = append_str(cmd, cn, " -o ");
    cn = pj_shell_quote(cmd, cn, arr_cstr(spath));
    cmd[cn] = 0;
    if (system(arr_cstr(cmd)) != 0) {
        let buf [128]u8;
        let bn int = 0;
        bn = append_str(buf, bn, "模块编译失败: ");
        bn = append_bytes_np(buf, bn, p_mods[m].name_off, p_mods[m].name_len);
        let mo int = tml_intern_str(buf, 0, bn);
        if (mo < 0) {
            return -1;
        }
        return fail(np_cstr(mo));
    }
    // 写 manifest
    let fd int = mb_open_out(arr_cstr(mpath));
    if (fd < 0) {
        return fail_path("无法写 manifest: ", arr_cstr(mpath));
    }
    write_all(fd, want, wn);
    close(fd);
    pj_out_s("  [编译] ");
    pj_out_np(p_mods[m].name_off, p_mods[m].name_len);
    pj_out_s("\n");
    return 0;
}

// —— 子进程：--emit-module M ROOT -o out.s ——

// mb_file_head_bind：解析当前文件头并绑定导入（编译前每文件调用）。
// 先重置文件级导入表——pass 2 会对同一文件再次解析文件头。
pub fn mb_file_head_bind() int {
    mod_reset_file();
    if (mod_parse_head() != 0) {
        return -1;
    }
    return mod_bind_current_file();
}

// mb_pass1_file：pass 1 读入并登记一个源文件（含头解析与绑定）。
pub fn mb_pass1_file(path *char) int {
    if (read_source(path) != 0) {
        return -1;
    }
    c_tok_n = 0;
    c_pos = 0;
    c_path = path;
    if (lex_all() != 0) {
        return -1;
    }
    if (mb_file_head_bind() != 0) {
        return -1;
    }
    for p_cur() != TOK_EOF {
        if (parse_top_decl() != 0) {
            return -1;
        }
    }
    return 0;
}

// mb_globals_or_fns：pass 2a/2b 复用现有子遍（头已消费，头解析在先）。
// is_globals=1 走 parse_source_globals，否则 parse_source_fns。
pub fn mb_pass2_file(path *char, is_globals int) int {
    if (read_source(path) != 0) {
        return -1;
    }
    c_tok_n = 0;
    c_pos = 0;
    c_path = path;
    if (lex_all() != 0) {
        return -1;
    }
    if (mb_file_head_bind() != 0) {
        return -1;
    }
    if (is_globals != 0) {
        if (parse_source_globals() != 0) {
            return -1;
        }
    } else {
        if (parse_source_fns() != 0) {
            return -1;
        }
        // 未使用导入检查（U3）：本文件编译完后仍为零使用的导入报错
        let i int = 0;
        for i < mod_import_n {
            if (mod_import_used[i] == 0) {
                return err_lc(mod_imports[i].line, mod_imports[i].col,
                    "导入未使用（同文件没有任何限定名引用）");
            }
            i += 1;
        }
    }
    return 0;
}

// mb_check_binding_clash：导入名与本模块顶层声明重名检查（pass1 后）。
// 遍历模块全部文件的导入，逐个查全局符号表。
pub fn mb_check_binding_clash(m int) int {
    let fi int = 0;
    for fi < p_mods[m].file_n {
        let f int = p_mods[m].files[fi];
        let ii int = 0;
        for ii < p_imp_n {
            if (p_imp_file[ii] != f) {
                ii += 1;
                continue;
            }
            let idx int = sym_lookup_off(p_imp_off[ii], p_imp_len[ii]);
            if (idx >= 0 && (c_syms[idx].flags & F_GLOBAL) != 0
                && (c_syms[idx].flags & F_EXTERN) == 0) {
                let buf [192]u8;
                let n int = 0;
                n = append_int(buf, n, c_syms[idx].def_line);
                n = append_byte(buf, n, ':');
                n = append_int(buf, n, c_syms[idx].def_col);
                n = append_str(buf, n, ": 顶层声明与导入名冲突（导入名 ");
                n = append_bytes_np(buf, n, p_imp_off[ii], p_imp_len[ii]);
                n = append_str(buf, n, "）");
                let mo int = tml_intern_str(buf, 0, n);
                if (mo < 0) {
                    return -1;
                }
                c_errors += 1;
                let out [256]u8;
                let on int = 0;
                on = append_str(out, on, pj_pool_str(p_files[f].path_off));
                on = append_byte(out, on, ':');
                on = append_bytes_np(out, on, mo, n);
                on = append_byte(out, on, '\n');
                write_all(2, out, on);
                return -1;
            }
            ii += 1;
        }
        fi += 1;
    }
    return 0;
}

// mb_emit_module：子进程入口——编译一个模块为独立汇编 + 接口。
// prov_root：模块提供方项目根（在其中查找模块）；main_root：主项目根
// （构建目录基准，接口路径与父进程一致）。
pub fn mb_emit_module(mod_off int, mod_len int, prov_off int, prov_len int, main_off int, main_len int, out_s *char) int {
    if (mb_load_stdlib() != 0) {
        return -1;
    }
    let proj int = pj_load_project(prov_off, prov_len);
    if (proj < 0) {
        return -1;
    }
    if (pj_bind_imports() != 0) {
        return -1;
    }
    let m int = pj_mod_in_proj(proj, mod_off, mod_len);
    if (m < 0) {
        return fail("内部错误：模块不在索引中");
    }
    let sfx_off int = -1;
    let sfx_len int = 0;
    if (pj_mod_suffix(p_mods[m].proj, m, &sfx_off, &sfx_len) != 0) {
        return -1;
    }
    c_module_mode = 1;
    c_is_entry_mod = p_mods[m].is_entry;
    c_sym_sfx_off = sfx_off;
    c_sym_sfx_len = sfx_len;
    if (sem_init_tables() != 0) {
        return -1;
    }
    ty_register_builtins();
    scope_push();
    if (sem_register_prelude() != 0) {
        return -1;
    }
    // 加载导入接口（确定序；构建目录以主项目根为基准）
    let build_off int = mb_build_dir(main_off, main_len);
    if (build_off < 0) {
        return -1;
    }
    let build_len int = pj_canon_len;
    if (mb_module_iface_deps(m, build_off, build_len) < 0) {
        return -1;
    }
    let di int = 0;
    for di < mb_dep_n {
            if (iface_load(pj_pool_str(mb_dep_ifoff[di]), mb_dep_bind[di], mb_dep_bindlen[di]) < 0) {
            return -1;
        }
        di += 1;
    }
    // 登记基线（接口之后、本模块声明之前）
    let sym_base int = c_sym_n;
    let tname_base int = t_name_n;
    // pass 1：全部源文件（接口加载把 c_pass 留在了 2，必须复位）
    c_compile = 1;
    c_pass = 1;
    let fi int = 0;
    for fi < p_mods[m].file_n {
        if (mb_pass1_file(pj_pool_str(p_files[p_mods[m].files[fi]].path_off)) != 0) {
            return -1;
        }
        fi += 1;
    }
    if (c_errors > 0) {
        return -1;
    }
    if (mb_check_binding_clash(m) != 0) {
        return -1;
    }
    // 入口模块才要求 main
    if (c_is_entry_mod != 0 && sem_check_main() != 0) {
        return -1;
    }
    // pass 2a/2b：函数体与全局初始化（c_pass=2）
    c_pass = 2;
    let fi2 int = 0;
    for fi2 < p_mods[m].file_n {
        if (mb_pass2_file(pj_pool_str(p_files[p_mods[m].files[fi2]].path_off), 1) != 0) {
            return -1;
        }
        fi2 += 1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // 接口发射（常量已折叠；函数体未编译也可发接口）
    let ipath [620]u8;
    let in2 int = 0;
    in2 = append_str(ipath, in2, out_s);
    in2 = append_str(ipath, in2, ".i");
    ipath[in2] = 0;
    if (iface_emit(arr_cstr(ipath), sym_base, tname_base) != 0) {
        return -1;
    }
    // pass 2b：函数体
    let fi3 int = 0;
    for fi3 < p_mods[m].file_n {
        if (mb_pass2_file(pj_pool_str(p_files[p_mods[m].files[fi3]].path_off), 0) != 0) {
            return -1;
        }
        fi3 += 1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // .bss
    let bi int = 0;
    for bi < c_bss_n {
        let bidx int = c_bss_syms[bi];
        if (em_bss_symbol(bidx, t_types[c_syms[bidx].type_id].size, t_types[c_syms[bidx].type_id].align) != 0) {
            return -1;
        }
        bi += 1;
    }
    // 写汇编
    if (drv_write_asm(out_s) != 0) {
        return -1;
    }
    return 0;
}

// —— 父进程：build / run ——

// mb_self_cmd：把自身路径以引号写入命令缓冲。
pub fn mb_self_cmd(buf *u8, n int) int {
    return pj_shell_quote(buf, n, c_argv0);
}

// mb_intern_arg：命令行参数字符串入名字池，返回偏移（长度出参）。
pub fn mb_intern_arg(s *char, olen *int) int {
    let sl int = 0;
    for s[sl] != 0 {
        sl += 1;
    }
    olen[0] = sl;
    return tml_intern_str(s.to_type(*u8), 0, sl);
}

// mb_load_stdlib：装载 YH_STDLIB 指定的标准库项目（未设置则无标准库层）。
pub fn mb_load_stdlib() int {
    if (p_stdlib >= 0) {
        return 0;
    }
    let off int = -1;
    let olen int = 0;
    if (pj_env_fetch("YH_STDLIB", &off, &olen) < 0) {
        return -1;
    }
    if (olen == 0) {
        p_stdlib = -1;
        return 0;
    }
    if (pj_canon(0, 0, pj_pool_str(off)) != 0) {
        return -1;
    }
    let s int = pj_load_project(pj_canon_off, pj_canon_len);
    if (s < 0) {
        return -1;
    }
    p_stdlib = s;
    return 0;
}

// pj_topo_multi：库模式——从项目每个模块出发收集依赖序。
pub fn pj_topo_multi(proj int) int {
    if (pj_topo(p_projs[proj].mods[0]) < 0) {
        return -1;
    }
    let i int = 1;
    for i < p_projs[proj].mod_n {
        if (pj_mark[p_projs[proj].mods[i]] != 2) {
            if (pj_dfs(p_projs[proj].mods[i]) != 0) {
                return -1;
            }
        }
        i += 1;
    }
    return pj_order_n;
}

// mb_link：把全部模块 .s 链接为可执行（GNU: gcc -no-pie；Darwin: clang）。
pub fn mb_link(out_path *char, build_off int, build_len int, count int) int {
    let cmd [4096]u8;
    let n int = 0;
    if (tg_darwin() != 0) {
        n = append_str(cmd, n, "clang -o ");
    } else {
        n = append_str(cmd, n, "gcc -no-pie -o ");
    }
    n = pj_shell_quote(cmd, n, out_path);
    let i int = 0;
    for i < count {
        let m int = pj_order[i];
        n = append_str(cmd, n, " ");
        if (pj_canon(build_off, build_len, pj_pool_str(p_mods[m].name_off)) != 0) {
            return -1;
        }
        n = append_str(cmd, n, pj_pool_str(pj_canon_off));
        n = append_str(cmd, n, ".s");
        i += 1;
    }
    cmd[n] = 0;
    if (system(arr_cstr(cmd)) != 0) {
        return fail_path("链接失败: ", out_path);
    }
    return 0;
}

// mb_cmd_build：yh build [-o out] [module]。
// argc/argv 已剥离程序名；av[0]=="build"。
pub fn mb_cmd_build(av **char, an int) int {
    let out_arg *char = 0;
    let mod_arg_off int = -1;
    let mod_arg_len int = 0;
    let i int = 1;
    for i < an {
        if (cstr_eq(av[i], "-o") != 0 && i + 1 < an) {
            out_arg = av[i + 1];
            i += 2;
            continue;
        }
        // 模块参数
        let sl int = 0;
        for av[i][sl] != 0 {
            sl += 1;
        }
        let mo int = tml_intern_str(av[i].to_type(*u8), 0, sl);
        if (mo < 0) {
            return -1;
        }
        mod_arg_off = mo;
        mod_arg_len = sl;
        i += 1;
    }
    c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root();
    if (root < 0) {
        return 1;
    }
    // 捕获根路径（后续 canon 调用会改写全局游标）
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    // 构建根：显式模块参数 > 清单 entry > 库模式
    let rootmod int = -1;
    if (mod_arg_off >= 0) {
        rootmod = pj_mod_in_proj(proj, mod_arg_off, mod_arg_len);
        if (rootmod < 0) {
            let buf [128]u8;
            let n int = 0;
            n = append_str(buf, n, "本项目没有模块: ");
            n = append_bytes_np(buf, n, mod_arg_off, mod_arg_len);
            let mo4 int = tml_intern_str(buf, 0, n);
            if (mo4 < 0) {
                return -1;
            }
            return fail(np_cstr(mo4));
        }
    } else if (p_projs[proj].entry_off >= 0) {
        rootmod = pj_mod_in_proj(proj, p_projs[proj].entry_off, p_projs[proj].entry_len);
        if (rootmod < 0) {
            return fail("清单 entry 指定的模块没有实现文件");
        }
    }
    // topo（依赖序）
    let count int = 0;
    if (rootmod >= 0) {
        count = pj_topo(rootmod);
        if (count < 0) {
            return 1;
        }
    } else {
        count = pj_topo_multi(proj);
        if (count < 0) {
            return 1;
        }
    }
    // 构建目录
    let build_off int = mb_build_dir(root_off, root_len);
    if (build_off < 0) {
        return 1;
    }
    let build_len int = pj_canon_len;
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1;
    }
    // 逐模块编译（依赖序）
    let ci int = 0;
    for ci < count {
        if (mb_compile_one(pj_order[ci], root_off, root_len, build_off, build_len) != 0) {
            return 1;
        }
        ci += 1;
    }
    // 链接（有入口时）
    if (rootmod >= 0) {
        let outbuf [620]u8;
        let on int = 0;
        if (out_arg != 0) {
            on = append_str(outbuf, on, out_arg);
        } else {
            on = append_str(outbuf, on, pj_pool_str(build_off));
            on = append_str(outbuf, on, "/app.bin");
        }
        outbuf[on] = 0;
        if (mb_link(arr_cstr(outbuf), build_off, build_len, count) != 0) {
            return 1;
        }
        pj_out_s("构建完成: ");
        pj_out_s(arr_cstr(outbuf));
        pj_out_s("\n");
        return 0;
    }
    pj_out_s("库构建完成（模块对象与接口在 ");
    pj_out_np(build_off, pj_canon_len);
    pj_out_s("）\n");
    return 0;
}

// mb_cmd_run：yh run——构建清单 entry 并运行，返回程序退出码。
pub fn mb_cmd_run() int {
    c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root();
    if (root < 0) {
        return 1;
    }
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (p_projs[proj].entry_off < 0) {
        return fail("库项目没有入口，无法 run（在 mod.toml 指定 project.entry）");
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    let rootmod int = pj_mod_in_proj(proj, p_projs[proj].entry_off, p_projs[proj].entry_len);
    if (rootmod < 0) {
        return fail("清单 entry 指定的模块没有实现文件");
    }
    let count int = pj_topo(rootmod);
    if (count < 0) {
        return 1;
    }
    let build_off int = mb_build_dir(root_off, root_len);
    if (build_off < 0) {
        return 1;
    }
    let build_len int = pj_canon_len;
    if (mb_mkdir(pj_pool_str(build_off)) != 0) {
        return 1;
    }
    let ci int = 0;
    for ci < count {
        if (mb_compile_one(pj_order[ci], root_off, root_len, build_off, build_len) != 0) {
            return 1;
        }
        ci += 1;
    }
    let binbuf [620]u8;
    let bn int = 0;
    bn = append_str(binbuf, bn, pj_pool_str(build_off));
    bn = append_str(binbuf, bn, "/app.bin");
    binbuf[bn] = 0;
    if (mb_link(arr_cstr(binbuf), build_off, build_len, count) != 0) {
        return 1;
    }
    // 运行（继承 stdout/stderr；退出码 = 程序退出码）
    let rcmd [700]u8;
    let rn int = 0;
    rn = pj_shell_quote(rcmd, rn, arr_cstr(binbuf));
    rcmd[rn] = 0;
    let rc int = system(arr_cstr(rcmd));
    if (rc == 0) {
        return 0;
    }
    // wait 状态：正常退出在高 8 位；信号退出按 128+sig 近似报告
    let code int = ((rc >> 8) & 255);
    if (code == 0) {
        code = 130;
    }
    return code;
}

// mb_cmd_list：yh list [--resolve name]。
pub fn mb_cmd_list(av **char, an int) int {
    let resolve_off int = -1;
    let resolve_len int = 0;
    let has_resolve int = 0;
    let i int = 1;
    for i < an {
        if (cstr_eq(av[i], "--resolve") != 0 && i + 1 < an) {
            let sl int = 0;
            for av[i + 1][sl] != 0 {
                sl += 1;
            }
            let mo int = tml_intern_str(av[i + 1].to_type(*u8), 0, sl);
            if (mo < 0) {
                return -1;
            }
            resolve_off = mo;
            resolve_len = sl;
            has_resolve = 1;
            i += 2;
            continue;
        }
        usage();
        return 2;
    }
    c_path = "yh";
    if (mb_load_stdlib() != 0) {
        return 1;
    }
    let root int = pj_find_root();
    if (root < 0) {
        return 1;
    }
    let root_off int = pj_canon_off;
    let root_len int = pj_canon_len;
    let proj int = pj_load_project(root_off, root_len);
    if (proj < 0) {
        return 1;
    }
    if (pj_bind_imports() != 0) {
        return 1;
    }
    return pj_cmd_list(proj, resolve_off, resolve_len, has_resolve);
}

// ============================================================================
// compile.yh
// 自 gen/sem.yh 按完整函数边界拆分（ADR-0007 P4）；行为不变。
// ============================================================================

pub fn sem_compile() int {
    // pass 1：登记类型、函数签名与全局名字
    c_pos = 0;
    c_pass = 1;
    if (parse_source() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    if (sem_check_main() != 0) {
        return -1;
    }
    // pass 2a：全局 let/const 初始化（引用先声明规则由此保证）
    c_pos = 0;
    c_pass = 2;
    if (em_puts("\n") != 0) {
        return -1;
    }
    if (parse_source_globals() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // pass 2b：函数体
    c_pos = 0;
    if (parse_source_fns() != 0) {
        return -1;
    }
    if (c_errors > 0) {
        return -1;
    }
    // 发射 .bss：零初始化全局（清单在 pass 2a 收集）
    let i int = 0;
    for i < c_bss_n {
        let bi int = c_bss_syms[i];
        if (em_bss_symbol(bi, t_types[c_syms[bi].type_id].size, t_types[c_syms[bi].type_id].align) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}


// ============================================================================
// driver.yh —— 自举编译器：命令行入口
//
// 输出接口（docs/02-plan/yh-自举实施方案-v2.md §3）：
//     yh --syntax-check <file.yh>   纯语法检查：合法静默退出 0，
//                                   非法输出诊断并以非零码退出
//     yh --emit-asm <file.yh>       发射 AArch64 Linux 汇编到标准输出
//                                   （GNU 语法，经 as/gcc 生成可执行）
//     yh -o <out> <file.yh>         编译并链接为可执行文件（兼容 stage0
//                                   的命令行形态）。实现方式：把汇编写到
//                                   临时文件，调用外部 gcc 汇编/链接，成功后
//                                   删除临时文件。
//
// 退出码：0 成功；1 源文件语法/语义错误或读入失败；2 用法错误。
// 诊断一律写文件描述符 2；汇编只写缓冲、编译成功后一次性写目标，
// 错误不会留下看似成功的部分产物。
// ============================================================================

// drv_build_cmd：拼装「汇编器/链接器」命令行到 buf，返回长度。
//   GNU/Linux：gcc -no-pie -o <out> <asm>
//   Darwin   ：clang -o <out> <asm>   （Mach-O 必须 PIE，不加 -no-pie）
// 调用者保证 buf 足够大（路径长度受限）。
pub fn drv_build_cmd(buf *u8, cap int, out_path *char, asm_path *char) int {
    let n int = 0;
    if (tg_darwin() != 0) {
        n = append_str(buf, n, "clang -o ");
    } else {
        n = append_str(buf, n, "gcc -no-pie -o ");
    }
    n = append_str(buf, n, out_path);
    n = append_str(buf, n, " ");
    n = append_str(buf, n, asm_path);
    buf[n] = 0;
    return n;
}

// drv_write_asm：把已发射的汇编写入 asm_path（O_WRONLY|O_CREAT|O_TRUNC，
// 权限 0644）。返回 0 成功。open 旗标随平台不同（Linux 与 macOS 的
// O_CREAT/O_TRUNC 位不同），由 tg_darwin 判定。
// drv_host_darwin：宿主平台探测——macOS 独有的系统 plist（Linux 无此
// 路径；libSystem.B.dylib 在新版 macOS 已入 dyld 共享缓存，磁盘不可见，
// 不能用作探针）。用于无 -target 时的默认方言选择（与 stage0 在
// Darwin 宿主默认 Mach-O 的行为一致）；显式 -target 永远覆盖探测。
pub fn drv_host_darwin() int {
    let fd int = open("/System/Library/CoreServices/SystemVersion.plist", 0);
    if (fd >= 0) {
        close(fd);
        return 1;
    }
    return 0;
}

// c_target_explicit：用户是否显式给出 -target（显式则不自动探测）。
pub let c_target_explicit int = 0;

pub fn drv_write_asm(asm_path *char) int {
    let fl int = 0x241;
    if (tg_darwin() != 0) {
        fl = 0x601;
    }
    let fd int = open(asm_path, fl, 0x1a4);
    if (fd < 0) {
        return fail("无法创建临时汇编文件");
    }
    if (flush_output_fd(fd) != 0) {
        close(fd);
        return -1;
    }
    if (close(fd) != 0) {
        return fail("写临时汇编文件失败");
    }
    return 0;
}

// run_emit_asm_to：发射汇编到指定文件，再调用外部工具链链接为可执行。
// obj_path 为最终输出文件，asm_path 为临时汇编文件（调用后删除）。
pub fn run_emit_asm_to(asm_path *char, obj_path *char) int {
    if (lex_all() != 0) {
        return 1;
    }
    c_compile = 1;
    ty_register_builtins();
    scope_push();
    if (sem_register_prelude() != 0) {
        return 1;
    }
    if (sem_compile() != 0) {
        return 1;
    }
    if (c_errors > 0) {
        return 1;
    }
    if (drv_write_asm(asm_path) != 0) {
        return 1;
    }
    // 命令行缓冲：两倍路径长度足够（"gcc -no-pie -o " + out + " " + asm + NUL）
    let cap int = 256;
    let cmd *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (cmd == 0) {
        unlink(asm_path);
        return fail("内存分配失败");
    }
    drv_build_cmd(cmd, cap, obj_path, asm_path);
    let rc int = system(arr_cstr(cmd));
    free(cmd);
    unlink(asm_path);
    if (rc != 0) {
        return fail_path("链接失败: ", obj_path);
    }
    return 0;
}


// usage：输出用法说明（文件描述符 2）。
pub fn usage() void {
    let buf [512]u8;
    let n int = 0;
    n = append_str(buf, n, "用法: yh --syntax-check <file.yh>\n");
    n = append_str(buf, n, "      yh --emit-asm <file.yh>\n");
    n = append_str(buf, n, "      yh -o <out> <file.yh>\n");
    n = append_str(buf, n, "      yh build [-o out] [module]   项目构建（mod.toml）\n");
    n = append_str(buf, n, "      yh run                       构建并运行清单 entry\n");
    n = append_str(buf, n, "      yh list [--resolve name]     列出模块/解释导入绑定\n");
    write_all(2, buf, n);
}

// run_syntax_check：--syntax-check 路径（纯语法，G1 行为）。
pub fn run_syntax_check() int {
    if (lex_all() != 0) {
        return 1;
    }
    if (parse_source() != 0) {
        return 1;
    }
    if (c_errors > 0) {
        return 1;
    }
    return 0;
}

// run_emit_asm：--emit-asm 路径（两遍语义 + AArch64 发射）。
pub fn run_emit_asm() int {
    if (lex_all() != 0) {
        return 1;
    }
    c_compile = 1;
    ty_register_builtins();
    // 全局作用域（第 0 层），随后登记 prelude 外部函数
    scope_push();
    if (sem_register_prelude() != 0) {
        return 1;
    }
    if (sem_compile() != 0) {
        return 1;
    }
    if (c_errors > 0) {
        return 1;
    }
    if (flush_output() != 0) {
        return 1;
    }
    return 0;
}

// main：解析命令行并驱动「读源 → 词法 → （语法 | 编译）」流水线。
// 形态：
//   yh --syntax-check <file.yh>      （argc==3）
//   yh --emit-asm <file.yh>          （argc==3）
// drv_scan_target：扫描 `-target <dialect>` 选项（可出现在任意位置），
// 设置 c_dialect 并把其余参数紧凑写入 out（调用方保证容量 ≥ argc）。
// 返回剩余参数个数（不含程序名占位）。
// 支持 darwin/macho/macos → TG_DIALECT_DARWIN；gnu/linux/elf → GNU。
pub fn drv_scan_target(argc int, argv **char, out **char) int {
    let n int = 0;
    let i int = 1;
    for i < argc {
        if (cstr_eq(argv[i], "-target") != 0 && i + 1 < argc) {
            c_target_explicit = 1;
            if (cstr_eq(argv[i + 1], "darwin") != 0
                || cstr_eq(argv[i + 1], "macho") != 0
                || cstr_eq(argv[i + 1], "macos") != 0) {
                c_dialect = TG_DIALECT_DARWIN;
            } else {
                c_dialect = TG_DIALECT_GNU;
            }
            i += 2;
        } else {
            out[n] = argv[i];
            n += 1;
            i += 1;
        }
    }
    return n;
}

// main：解析命令行并驱动「读源 → 词法 → （语法 | 编译）」流水线。
// 形态（-target <dialect> 可出现在任意位置，默认 gnu）：
//   yh --syntax-check <file.yh>
//   yh --emit-asm <file.yh>
//   yh [-target darwin] -o <out> <file.yh>
pub fn main(argc int, argv **char) int {
    // 自身路径（项目构建的子进程再入用）
    c_argv0 = argv[0];
    // 先摘除 -target，得到规整后的参数序列（av[0..n-1]）。用固定容量栈数组：
    // 命令行参数个数有上限（64 足够）。
    let av [64]*char;
    let n int = drv_scan_target(argc, argv, av);
    let mode int = 0;
    let needs_o int = 0;
    // 无显式 -target：按宿主平台选默认方言（Darwin 宿主 → Mach-O 方言，
    // 与 stage0 行为一致；Linux 容器 → GNU）
    if (c_target_explicit == 0) {
        if (drv_host_darwin() != 0) {
            c_dialect = TG_DIALECT_DARWIN;
        } else {
            c_dialect = TG_DIALECT_GNU;
        }
    }
    // —— 项目命令（MOD-U2..U5，在单文件分派之前） ——
    if (n >= 1 && cstr_eq(av[0], "build") != 0) {
        return mb_cmd_build(av, n);
    }
    if (n >= 1 && cstr_eq(av[0], "run") != 0) {
        return mb_cmd_run();
    }
    if (n >= 1 && cstr_eq(av[0], "list") != 0) {
        return mb_cmd_list(av, n);
    }
    if (n == 6 && cstr_eq(av[0], "--emit-module") != 0 && cstr_eq(av[4], "-o") != 0) {
        // 内部子命令：--emit-module <mod> <提供方根> <主根> -o <out.s>
        let mlen int = 0;
        let rlen int = 0;
        let blen int = 0;
        let mo int = mb_intern_arg(av[1], &mlen);
        let ro int = mb_intern_arg(av[2], &rlen);
        let bo int = mb_intern_arg(av[3], &blen);
        if (mo < 0 || ro < 0 || bo < 0) {
            return 1;
        }
        return mb_emit_module(mo, mlen, ro, rlen, bo, blen, av[5]);
    }
    let src_idx int = 1;
    let out_idx int = 1;
    // -o 两种形态（后者与 stage0 的 `yh <file> -o <out>` 接口一致，
    // tests/yh-run/check.py 按该顺序调用）：
    //   av = ["-o", <out>, <src>]  或  av = [<src>, "-o", <out>]，共 3 个
    if (n == 3 && cstr_eq(av[0], "-o") != 0) {
        mode = 3;
        needs_o = 1;
        src_idx = 2;
        out_idx = 1;
    }
    if (needs_o == 0 && n == 3 && cstr_eq(av[1], "-o") != 0) {
        mode = 3;
        needs_o = 1;
        src_idx = 0;
        out_idx = 2;
    }
    if (needs_o == 0) {
        if (n != 2) {
            usage();
            return 2;
        }
        if (cstr_eq(av[0], "--syntax-check") != 0) {
            mode = 1;
        }
        if (cstr_eq(av[0], "--emit-asm") != 0) {
            mode = 2;
        }
        if (mode == 0) {
            usage();
            return 2;
        }
    }
    c_path = av[src_idx];
    if (read_source(c_path) != 0) {
        return 1;
    }
    // 各模式都会用到堆分配的全局表（作用域栈等）
    if (sem_init_tables() != 0) {
        return 1;
    }
    if (mode == 1) {
        return run_syntax_check();
    }
    if (mode == 3) {
        // 临时汇编文件：<out>.yh-tmp.s（与输出同目录，避免跨文件系统）
        let abuf *u8 = malloc(512.to_type(u64)).to_type(*u8);
        if (abuf == 0) {
            return fail("内存分配失败");
        }
        let an int = 0;
        an = append_str(abuf, an, av[out_idx]);
        an = append_str(abuf, an, ".yh-tmp.s");
        return run_emit_asm_to(abuf.to_type(*char), av[out_idx]);
    }
    return run_emit_asm();
}
