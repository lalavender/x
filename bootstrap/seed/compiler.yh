
// ============================================================================
// model.yh —— 自举编译器：共享常量、数据结构与全局状态
//
// 本文件是拼接源码的第一个文件，只包含常量、结构体定义与全局变量声明，
// 不含函数。后续文件（buffer/lexer/parse_*/driver）按拼接顺序展开，
// 因此所有全局状态在使用前已经声明（stage0 对全局名字的可见性要求）。
//
// 自编子集（docs/02-plan/yh-自举实施方案-v2.md §3）：只用整数/字节/指针、
// 结构体字段、堆缓冲、全局/局部变量、普通函数、递归、if 与条件 for、
// 赋值与位运算、prelude 的 open/read/write/close/malloc/free/memcpy/strlen/exit。
// 不使用：浮点、联合体、数组按值、切片、类型化变参、for-in、switch、goto。
// ============================================================================

// ---------------------------------------------------------------------------
// token 种类常量
//
// 编号分组（范围判断依赖该布局，勿随意调换）：
//   0..4    特殊：EOF、标识符、数字、字符串、字符字面量
//   5..15   标点（括号、花括号、方括号、分号、逗号、点、问号、冒号）
//   16..40  语言关键字；TK_AS=39、TK_TO_TYPE=40 恰为组尾——
//           「成员名」判断使用 16..39（to_type 不放开学成员名）
//   41      已移除的 C 关键字（保留字，仅成员位置放开）
//   42..43  模块关键字 module/import（MOD-U1，仅文件头，不作成员名）
//   50..63  内建类型名（连续区间，is_type_start 依赖）
//   64..    运算符：算术/位运算、逻辑、移位、比较、赋值（含复合）、区间、变参
// ---------------------------------------------------------------------------

// ---- 特殊 token（0..4） ----
pub const TOK_EOF int = 0;      // 文件结束（词法器在末尾补一个，位置指向源尾）
pub const TOK_IDENT int = 1;    // 标识符
pub const TOK_NUMBER int = 2;   // 数字字面量（整数或浮点，值校验交给语义）
pub const TOK_STRING int = 3;   // 字符串字面量（含首尾引号的原样字节区间）
pub const TOK_CHAR int = 4;     // 字符字面量（含首尾单引号）

// ---- 标点（5..15） ----
pub const TK_LPAREN int = 5;        // (
pub const TK_RPAREN int = 6;        // )
pub const TK_LBRACE int = 7;        // {
pub const TK_RBRACE int = 8;        // }
pub const TK_LBRACKET int = 9;      // [
pub const TK_RBRACKET int = 10;     // ]
pub const TK_SEMI int = 11;         // ;
pub const TK_COMMA int = 12;        // ,
pub const TK_DOT int = 13;          // .
pub const TK_QUEST int = 14;        // ?
pub const TK_COLON int = 15;        // :

// ---- 语言关键字（16..40，与 docs/yh.g4 的保留字一致） ----
pub const TK_PUB int = 16;
pub const TK_LET int = 17;
pub const TK_CONST int = 18;
pub const TK_FN int = 19;
pub const TK_TYPE int = 20;
pub const TK_STRUCT int = 21;
pub const TK_UNION int = 22;
pub const TK_ENUM int = 23;
pub const TK_IF int = 24;
pub const TK_ELSE int = 25;
pub const TK_SWITCH int = 26;
pub const TK_CASE int = 27;
pub const TK_DEFAULT int = 28;
pub const TK_FOR int = 29;
pub const TK_IN int = 30;
pub const TK_RETURN int = 31;
pub const TK_BREAK int = 32;
pub const TK_CONTINUE int = 33;
pub const TK_GOTO int = 34;
pub const TK_TRUE int = 35;
pub const TK_FALSE int = 36;
pub const TK_SIZEOF int = 37;
pub const TK_LEN int = 38;
pub const TK_AS int = 39;           // 旧转换写法，已移除；仍可作成员名
pub const TK_TO_TYPE int = 40;      // 后缀转换专用字；不作成员名

// ---- 已移除的 C 关键字（41）：全部归并为一类保留字 ----
// while do unsigned signed short long float double typedef extern static
// register auto inline volatile restrict
// 它们不能作标识符（rejected/05），但成员位置放开（memberName）。
pub const TK_RESERVED int = 41;

// ---- 模块关键字（42..43，MOD-U1） ----
// 仅在文件头（module 声明 → import 声明 → 业务声明）出现；不作标识符、
// 不放开成员名（is_member_name 的区间判断不覆盖 42..43）。
pub const TK_MODULE int = 42;   // module —— 文件头模块归属声明
pub const TK_IMPORT int = 43;   // import —— 文件头导入声明

// ---- 内建类型名（50..63，连续区间） ----
pub const TK_INT int = 50;
pub const TK_I8 int = 51;
pub const TK_I16 int = 52;
pub const TK_I32 int = 53;
pub const TK_I64 int = 54;
pub const TK_U8 int = 55;
pub const TK_U16 int = 56;
pub const TK_U32 int = 57;
pub const TK_U64 int = 58;
pub const TK_F32 int = 59;
pub const TK_F64 int = 60;
pub const TK_BOOL int = 61;
pub const TK_CHAR int = 62;
pub const TK_VOID int = 63;

// ---- 运算符（64..，含多字符运算符） ----
pub const TK_PLUS int = 64;         // +
pub const TK_MINUS int = 65;        // -
pub const TK_STAR int = 66;         // *
pub const TK_SLASH int = 67;        // /
pub const TK_PERCENT int = 68;      // %
pub const TK_AMP int = 69;          // &
pub const TK_PIPE int = 70;         // |
pub const TK_CARET int = 71;        // ^
pub const TK_TILDE int = 72;        // ~
pub const TK_BANG int = 73;         // !
pub const TK_LT int = 74;           // <
pub const TK_GT int = 75;           // >
pub const TK_EQEQ int = 76;         // ==
pub const TK_NEQ int = 77;          // !=
pub const TK_LEQ int = 78;          // <=
pub const TK_GEQ int = 79;          // >=
pub const TK_ANDAND int = 80;       // &&
pub const TK_OROR int = 81;         // ||
pub const TK_LSHIFT int = 82;       // <<
pub const TK_RSHIFT int = 83;       // >>
pub const TK_ASSIGN int = 84;       // =
pub const TK_PLUSEQ int = 85;       // +=
pub const TK_MINUSEQ int = 86;      // -=
pub const TK_STAREQ int = 87;       // *=
pub const TK_SLASHEQ int = 88;      // /=
pub const TK_PERCENTEQ int = 89;    // %=
pub const TK_AMPEQ int = 90;        // &=
pub const TK_PIPEEQ int = 91;       // |=
pub const TK_CARETEQ int = 92;      // ^=
pub const TK_LSHIFTEQ int = 93;     // <<=
pub const TK_RSHIFTEQ int = 94;     // >>=
pub const TK_RANGE int = 95;        // ..
pub const TK_ELLIPSIS int = 96;     // ...

// ---------------------------------------------------------------------------
// 数据结构
// ---------------------------------------------------------------------------

// Tok：单个 token 的全部信息。
// token 不复制字符串，start/len 直接引用 c_src 的字节区间；line/col 为
// 1 基位置（col 按 token 首字节相对行首的字节偏移 + 1 计）。
pub struct Tok {
    kind int;       // 种类（上方常量之一）
    start int;      // 在 c_src 中的起始字节下标
    len int;        // 字节长度（EOF 为 0）
    line int;       // 1 基行号
    col int;        // 1 基列号（字节偏移）
}

// ---------------------------------------------------------------------------
// 全局状态
//
// 按文件职责分三组：源与词法位置、token 表、解析器与诊断。
// 全部集中在首个文件声明，保证后续文件的函数引用时已可见。
// ---------------------------------------------------------------------------

// —— 源文件与词法扫描位置 ——
pub let c_src *u8 = 0;          // 源文件字节（read_source 分配，进程生命期持有）
pub let c_src_len int = 0;      // 源字节长度
pub let lx_line int = 1;        // 词法扫描当前行号（1 基）
pub let lx_lstart int = 0;      // 当前行首字节下标（用于换算列号）

// —— token 表（可增长 Tok 数组，tok_push 负责扩容） ——
pub let c_toks *Tok = 0;        // token 数组首址（malloc）
pub let c_tok_n int = 0;        // 已存 token 数
pub let c_tok_cap int = 0;      // 已分配槽位数

// —— 解析器 ——
pub let c_pos int = 0;          // 当前 token 下标（解析游标）
pub let c_spec int = 0;         // 推测解析深度：>0 时诊断静默且不计数
                            // （用于「结构体字面量 vs 块」的回退试探）
pub let c_ctx_block int = 0;    // 表达式块上下文：1 表示该表达式之后可能紧跟
                            // 「{ 块」（for 头部条件/迭代对象、switch 表达式、
                            // case 值）；此时「IDENT {」需先试探字面量分支

// —— 诊断 ——
pub let c_errors int = 0;       // 已报告的错误数（推测解析不计入）
pub let c_path *char = 0;       // 当前源文件路径（借自 argv，不复制不释放）

// ---------------------------------------------------------------------------
// B5 扩充：类型与符号常量（原 symbols.yh，先声明后使用）
// ---------------------------------------------------------------------------

// ---- 类型种类 ----
pub const TY_VOID int = 0;
pub const TY_BOOL int = 1;
pub const TY_CHAR int = 2;
pub const TY_I8 int = 3;
pub const TY_I16 int = 4;
pub const TY_I32 int = 5;
pub const TY_I64 int = 6;
pub const TY_U8 int = 7;
pub const TY_U16 int = 8;
pub const TY_U32 int = 9;
pub const TY_U64 int = 10;
pub const TY_F32 int = 11;
pub const TY_F64 int = 12;
pub const TY_PTR int = 13;
pub const TY_ARRAY int = 14;
pub const TY_SLICE int = 15;
pub const TY_STRUCT int = 16;
pub const TY_UNION int = 17;
pub const TY_ENUM int = 18;
pub const TY_FN int = 19;

// ---- 符号种类与标志 ----
pub const SYM_VAR int = 0;      // 变量（全局或局部）
pub const SYM_CONST int = 1;    // 编译期常量绑定
pub const SYM_FN int = 2;       // 函数
pub const F_GLOBAL int = 1;     // 全局（否则局部/参数）
pub const F_PARAM int = 2;      // 函数参数
pub const F_PUB int = 4;        // pub（GLOBAL 绑定）
pub const F_EXTERN int = 8;     // prelude 外部符号
pub const F_ADDR int = 16;      // 常量的值是数据标签号（cval）
pub const F_AGGPARAM int = 32;  // 聚合参数：槽内是指向调用方副本的指针

// ---------------------------------------------------------------------------
// B5 扩充：编译模式、类型/符号表、作用域、常量折叠与代码发射状态
//
// 分层约定（多平台架构见 docs/03-design/yh-自举后端架构.md）：
//   * symbols.yh —— 前端语义：类型表、符号/作用域、类型兼容、常量折叠。
//     平台无关，只允许引用 target.yh 的数据模型常量与 emit 层原语；
//   * target.yh  —— 目标数据模型：字长、对齐、类型布局规则（换目标先换它）；
//   * emit_arm64.yh —— 目标指令发射：把前端原语落到具体 ISA/汇编方言。
// ---------------------------------------------------------------------------

// —— 编译模式与两遍扫描 ——
pub let c_compile int = 0;      // 0 = 纯语法模式（--syntax-check）；1 = 编译模式
pub let c_pass int = 0;         // 1 = 顶层扫描登记；2 = 函数体编译与全局初始化

// —— 表达式求值结果描述符 ——
// 解析器边解析边做语义；每个表达式节点通过 *Res 出参返回类型与常量性。
// 约定：is_const=1 时 ival 有效（按 i64 位型；指针常量存数据标签号）。
pub struct Res {
    type_id int;        // 类型表编号（<0 不出现；错误走函数返回值）
    is_const int;       // 1 = 编译期常量
    ival i64;           // 常量位型值；字符串/指针常量存数据标签号
    sym int;            // 裸名字引用时的符号表下标，否则 -1（直接调用优化用）
    is_lit int;         // 1 = 文本字面量（参与隐式窄化范围检查）
    lit_big int;        // 1 = 字面量超出 i64 正数域（仅 u64 目标可接受）
    fval_bits i64;      // 浮点常量位型（IEEE754，f64 为 64 位）
}

// —— 类型表 ——
// 内建类型占固定编号 0..12（TY_VOID..TY_F64），其后按需增长并按内容去重。
pub struct CType {
    kind int;           // TY_* 种类
    size int;           // 字节大小
    align int;          // 字节对齐
    elem int;           // PTR：目标类型；ARRAY/SLICE：元素类型
    len int;            // ARRAY：长度；STRUCT/UNION：字段数；其余 -1
    sub int;            // STRUCT/UNION：字段表起始下标；FN：签名号
}
pub let t_types *CType = 0;
pub let t_type_n int = 0;
pub let t_type_cap int = 0;

// —— 结构体/联合体字段表 ——
pub struct SField {
    name_off int;       // 名字池偏移
    name_len int;
    type_id int;
    offset int;         // 相对结构体起始的字节偏移
    is_pub int;         // 1 = pub 字段（MOD-U1 语法登记；跨模块检查在 MOD-U3）
}
pub let t_fields *SField = 0;
pub let t_field_n int = 0;
pub let t_field_cap int = 0;

// —— 函数签名表（FN 类型通过 sub 引用签名号） ——
pub let t_sig_ret *int = 0;         // 返回类型
pub let t_sig_np *int = 0;          // 固定参数个数
pub let t_sig_vararg *int = 0;      // 1 = 末尾裸变参（仅 prelude）
pub let t_sig_first *int = 0;       // 参数类型池起始下标
pub let t_sig_params *int = 0;      // 参数类型池
pub let t_sig_n int = 0;
pub let t_sig_rcap int = 0;
pub let t_sig_ncap int = 0;
pub let t_sig_vcap int = 0;
pub let t_sig_fcap int = 0;
pub let t_sigparam_n int = 0;
pub let t_sigparam_cap int = 0;

// —— 类型名字空间（struct/union/enum/type 别名；仅顶层声明，无需作用域） ——
pub struct TName {
    name_off int;       // 名字池偏移
    name_len int;
    type_id int;
    is_pub int;         // 1 = pub 类型（接口导出）
    form int;           // 0=type 别名 1=struct 2=union 3=enum（接口再发射用）
    def_line int;       // 声明点行号（重定义诊断用）
    def_col int;
}
pub let t_names *TName = 0;
pub let t_name_n int = 0;
pub let t_name_cap int = 0;

// —— 值符号表与作用域 ——
pub struct CSym {
    name_off int;       // 名字池偏移
    name_len int;
    kind int;           // SYM_*
    type_id int;
    offset int;         // 局部/参数：距 fp 的字节距离（地址 = fp - offset）；
                        // 全局：bss 清单下标（数据见 flags）
    flags int;          // F_*
    cval i64;           // 常量值位型；指针常量存数据标签号
    def_line int;       // 声明点行号（模块模式重复声明诊断用）
    def_col int;        // 声明点列号
}
pub let c_syms *CSym = 0;
pub let c_sym_n int = 0;
pub let c_sym_cap int = 0;
// 作用域栈：stage0 每单元只允许一个全局数组，故全部表改为堆分配
pub let c_scope_start *int = 0; // 每层作用域进入时的符号表下标（64 层）
pub let c_scope_n int = 0;

// —— 常量折叠与数据段 ——
pub let c_fold int = 0;         // >0：表达式只做常量折叠，不发射代码
pub let c_em_suppress int = 0;  // >0：发射层整体静默（sizeof(expr) 求型用）
pub let c_expect_tid int = -1;  // 数组/切片字面量的目标类型（let 初始化/赋值上下文）
pub let c_nested_type int = 0;  // >0：正在解析函数体内嵌套的类型声明（pass 2 也登记）
pub let c_data_n int = 1;       // 匿名数据标签计数（字符串字面量）；0 保留为 NULL
pub let c_layout_size int = 0;  // tg_layout_struct 的多值返回出参（大小）
pub let c_layout_align int = 0; // tg_layout_struct 的多值返回出参（对齐）
pub let o_out *u8 = 0;          // .text 汇编缓冲
pub let o_len int = 0;
pub let o_cap int = 0;
pub let o_dat *u8 = 0;          // .data 汇编缓冲（全局初始化与字符串）
pub let o_dlen int = 0;
pub let o_dcap int = 0;
pub let o_bss *u8 = 0;          // .bss 汇编缓冲（零初始化全局）
pub let o_blen int = 0;
pub let o_bcap int = 0;
pub let o_body *u8 = 0;         // 函数体缓冲：先发射体，帧大小确定后再组装配 prologue
pub let o_body_len int = 0;
pub let o_body_cap int = 0;
pub let c_in_body int = 0;      // 1 = em_put 写入函数体缓冲（否则写 .text）
pub let c_bss_syms *int = 0;    // 零初始化全局符号的 sym 下标清单（.bss）
pub let c_bss_n int = 0;
pub let c_bss_cap int = 0;

// —— 代码发射状态（每函数重置） ——
pub let c_lbl_n int = 0;        // 汇编标签计数器（跨函数递增即可）
pub let c_fn_ret int = 0;       // 当前函数返回类型
pub let c_fn_lbl int = 0;       // 当前函数收尾标签号
pub let c_fn_sym int = 0;       // 当前函数的符号下标（prologue 用名字）
pub let c_fp_off int = 0;       // 当前栈帧已分配字节数（局部/参数/临时累计）
pub let c_temp_off int = 0;     // 通用临时槽的 fp 距离（0 = 未分配）
pub let c_loop_brk int = 0;     // 当前循环 break 目标标签号
pub let c_loop_cnt int = 0;     // 当前循环 continue 目标标签号
pub let c_loop_depth int = 0;   // 循环嵌套深度（栈顶 = c_loop_brk/cnt）
pub let c_spill_reg *int = 0;   // 参数溢出记录（寄存器号），堆分配 16 项
pub let c_spill_off *int = 0;   // 参数溢出记录（槽偏移），堆分配 16 项
pub let c_spill_n int = 0;
pub let c_spill_size *int = 0;  // 溢出槽的类型（浮点判定；0 = 整型/指针）
pub let c_fp_argn int = 0;      // 浮点参数计数（独立于整型寄存器序）

// —— 表达式求值上下文 ——
pub let c_lvalue int = 0;       // >0：解析赋值目标，地址型钩子发地址不发值
pub let c_res_is_addr int = 0;  // 刚解析的表达式在 x0 中留下的是地址（可赋值）
pub let c_call_direct *int = 0; // 每层调用是否直接调用（callee 是裸函数名），堆分配 64 项
pub let c_enum_next int = 0;    // enum 成员的自动判别值
pub let c_args *Res = 0;        // 当前调用的实参 Res（堆分配 256 项，嵌套共享）
pub let c_argtys *int = 0;      // 当前调用的实参类型（堆分配 256 项）
pub let c_arg_n int = 0;        // 已收集的实参总数（嵌套调用以基线区分）
pub let c_call_base *int = 0;   // 每层调用的实参起始下标（堆分配 64 项）
pub let c_call_depth int = 0;   // 当前调用嵌套深度
// —— 聚合按值 ABI（机制：调用点拷贝 + 指针传递） ——
pub let c_arg_agg *int = 0;     // 每个实参是否为聚合（堆分配 256 项）
pub let c_aggtype_n int = 0;    // 已登记的聚合类型数（上限 512，方案 §4）
pub let c_ret_agg int = 0;      // 当前函数返回聚合（x8 隐藏指针）
pub let c_ret_ptr_off int = 0;  // 当前函数保存 x8 入参指针的槽（0 = 未用）
pub let c_ret_agg_val int = 0;  // 1 = 本函数已为聚合返回准备好 x0
pub let c_ret_tmp_off int = 0;
pub let c_fp_tmp_off int = 0;   // 浮点复合赋值的右值临时槽  // 调用聚合返回函数时的调用方缓冲槽
pub let c_scratch_base int = 0; // 本函数已分配的临时聚合槽起点（诊断/调试用）
pub let c_lit_off int = 0;      // 结构体字面量临时槽（fp 距离）
pub let c_lit_tid int = 0;      // 结构体字面量目标类型
pub let c_lit_last_type int = 0; // 字面量字段最近一次求值的类型/字面量性
pub let c_lit_last_lit int = 0;
pub let c_lit_last_ival i64 = 0;
pub let c_lit_depth int = 0;    // 字面量嵌套深度
pub let c_lit_save_off *int = 0;  // 外层字面量槽（堆分配 32 项）
pub let c_lit_save_tid *int = 0;  // 外层字面量类型（堆分配 32 项）
pub let c_aggparam_n int = 0;   // 聚合参数入口拷贝任务数
pub let c_aggparam_src *int = 0;  // 指针槽（堆分配 64 项）
pub let c_aggparam_dst *int = 0;  // 体型槽（堆分配 64 项）
