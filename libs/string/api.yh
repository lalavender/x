module string

import memory
// ============================================================================
// api.yh —— string 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// Status 是 string 操作的稳定结果分类；end 只表示迭代正常结束。
pub enum Status {
    status_ok
    status_end
    status_invalid_argument
    status_bounds
    status_overflow
    status_out_of_memory
    status_invalid_utf8
    status_embedded_nul
}

// View 借用一段连续字节；data 不是语言层面的 const 指针，调用者必须保证
// 源在视图使用期间存活且不被改写。count 为 0 时 data 可以为 0。
pub struct View {
    data *u8
    count u64
}

// String 独占模块私有状态；handle 只允许本模块解释，零句柄表示空串。
// 结构体赋值不会复制内容，也不会增加所有者；转移和复制分别使用 move、clone。
pub struct String {
    handle *void
}

// ViewResult 是返回借用视图的结果；失败时 value 为空视图。
pub struct ViewResult {
    status Status
    value View
}

// StringResult 是返回拥有者的结果；失败时 value 为零句柄，无需清理半成品。
pub struct StringResult {
    status Status
    value String
}

// IndexResult 是查找结果；未找到时 found=false、index=0。
pub struct IndexResult {
    found bool
    index u64
}

// CStrResult 是 C 字符串视图结果；成功指针只读借用，失败时 data=0。
pub struct CStrResult {
    status Status
    data *char
}

// Utf8Info 是整段 UTF-8 校验结果；非法时 rune_count=0、error_offset 为
// 首个非法编码序列的起始字节。
pub struct Utf8Info {
    status Status
    rune_count u64
    error_offset u64
}

// RuneResult 是从指定游标解码一个标量的结果；成功时 rune/width/offset 有效，
// 失败或结束时 rune=0、width=0，offset 按调用契约给出定位。
pub struct RuneResult {
    status Status
    rune u32
    width u64
    offset u64
}

// SplitIter 保存一次字节切分的借用状态；迭代器本身不需要 release。
// 复制迭代器只复制游标，源与分隔符必须在整个迭代期间存活且保持不变。
pub struct SplitIter {
    text View
    separator View
    cursor u64
    ended int
}

// make 返回零句柄空串；不分配，创建和释放后都可以继续追加。
pub fn make() String {
    let value String
    value.handle = 0
    return value
}

// from_view 独立复制全部字节；输入可立即释放或改写，空输入返回零句柄。
pub fn from_view(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (text.count == 0) {
        return string_result_ok(make())
    }
    if (text.count > STRING_MAX_LENGTH) {
        return string_result_error(Status.status_overflow)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    memory.copy(state.data.to_type(*void), text.data.to_type(*void), text.count)
    state.count = text.count
    state.data[state.count] = 0
    return result
}

// clone 深复制一个 String；失败不改变原值，零句柄返回零句柄。
pub fn clone(value *String) StringResult {
    if (value == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (value.handle == 0) {
        return string_result_ok(make())
    }
    let state *string_state = string_state_of(value)
    let text View
    text.data = state.data
    text.count = state.count
    return from_view(text)
}

// move 转移句柄并清零源；不分配，不能用来复制所有权。空指针返回零句柄。
pub fn move(value *String) String {
    let result String
    result.handle = 0
    if (value == 0) {
        return result
    }
    result.handle = value.handle
    value.handle = 0
    return result
}

// release 释放并清零；同一变量重复释放安全，允许空指针。
pub fn release(value *String) void {
    if (value == 0 || value.handle == 0) {
        return
    }
    let state *string_state = string_state_of(value)
    memory.release(state.data.to_type(*void))
    memory.release(state.to_type(*void))
    value.handle = 0
}

// as_view 返回 O(1) 只读借用；零句柄返回空视图。
pub fn as_view(value *String) View {
    if (value == 0 || value.handle == 0) {
        return string_empty_view()
    }
    let state *string_state = string_state_of(value)
    let result View
    result.data = state.data
    result.count = state.count
    return result
}

// byte_length 返回内容字节数；零句柄或空指针返回 0。
pub fn byte_length(value *String) u64 {
    if (value == 0 || value.handle == 0) {
        return 0
    }
    return string_state_of(value).count
}

// capacity 返回当前内容容量（不含额外结尾 NUL）；零句柄或空指针返回 0。
pub fn capacity(value *String) u64 {
    if (value == 0 || value.handle == 0) {
        return 0
    }
    return string_state_of(value).capacity
}

// reserve 保证容量至少 minimum，内容与长度不变；已有容量足够时不分配。
// 失败保持原状态；minimum 超过 STRING_MAX_LENGTH 返回 overflow。
pub fn reserve(value *String, minimum u64) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (minimum > STRING_MAX_LENGTH) {
        return Status.status_overflow
    }
    if (value.handle != 0) {
        if (string_state_of(value).capacity >= minimum) {
            return Status.status_ok
        }
    } else if (minimum == 0) {
        return Status.status_ok
    }
    let data *u8 = string_alloc(minimum + 1)
    if (data == 0) {
        return Status.status_out_of_memory
    }
    let state *string_state = string_alloc(
        sizeof(string_state).to_type(u64)).to_type(*string_state)
    if (state == 0) {
        memory.release(data.to_type(*void))
        return Status.status_out_of_memory
    }
    let keep_count u64 = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        keep_count = old.count
        if (old.count > 0) {
            memory.copy(data.to_type(*void), old.data.to_type(*void), old.count)
        }
    }
    state.data = data
    state.count = keep_count
    state.capacity = minimum
    state.data[state.count] = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        memory.release(old.data.to_type(*void))
        memory.release(old.to_type(*void))
    }
    value.handle = state.to_type(*void)
    return Status.status_ok
}

// clear 清空内容并保留容量；不分配，零句柄保持零句柄。
pub fn clear(value *String) void {
    if (value == 0 || value.handle == 0) {
        return
    }
    let state *string_state = string_state_of(value)
    state.count = 0
    state.data[0] = 0
}

// truncate 只缩短到 count；超过原长度返回 bounds，不自动扩长。
pub fn truncate(value *String, count u64) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (value.handle == 0) {
        if (count == 0) {
            return Status.status_ok
        }
        return Status.status_bounds
    }
    let state *string_state = string_state_of(value)
    if (count > state.count) {
        return Status.status_bounds
    }
    state.count = count
    state.data[count] = 0
    return Status.status_ok
}

// assign 复制替换内容并复用容量；接受自身有效内容的子视图。
// 扩容路径先分配并复制，再交换；失败保持原内容、长度和容量。
pub fn assign(value *String, text View) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > 0 && text.data == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > STRING_MAX_LENGTH) {
        return Status.status_overflow
    }
    if (text.count == 0) {
        clear(value)
        return Status.status_ok
    }
    let old_data *u8 = 0
    let self_source int = 0
    let source_offset u64 = 0
    if (value.handle != 0) {
        let state *string_state = string_state_of(value)
        old_data = state.data
        let src_addr u64 = text.data.to_type(u64)
        let base_addr u64 = state.data.to_type(u64)
        if (src_addr >= base_addr && src_addr < base_addr + state.count) {
            self_source = 1
            source_offset = src_addr - base_addr
        }
    }
    if (value.handle != 0 && string_state_of(value).capacity >= text.count) {
        let state *string_state = string_state_of(value)
        let source *u8 = text.data
        if (self_source != 0) {
            source = state.data + source_offset
        }
        string_copy_overlap(state.data, source, text.count)
        state.count = text.count
        state.data[state.count] = 0
        return Status.status_ok
    }
    let data *u8 = string_alloc(text.count + 1)
    if (data == 0) {
        return Status.status_out_of_memory
    }
    let state *string_state = string_alloc(
        sizeof(string_state).to_type(u64)).to_type(*string_state)
    if (state == 0) {
        memory.release(data.to_type(*void))
        return Status.status_out_of_memory
    }
    if (self_source != 0) {
        memory.copy(data.to_type(*void), (old_data + source_offset).to_type(*void), text.count)
    } else {
        memory.copy(data.to_type(*void), text.data.to_type(*void), text.count)
    }
    state.data = data
    state.count = text.count
    state.capacity = text.count
    state.data[state.count] = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        memory.release(old.data.to_type(*void))
        memory.release(old.to_type(*void))
    }
    value.handle = state.to_type(*void)
    return Status.status_ok
}

// append 追加字节；支持整体自追加与自身子视图追加。扩容失败保持原状态。
pub fn append(value *String, text View) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > 0 && text.data == 0) {
        return Status.status_invalid_argument
    }
    if (text.count == 0) {
        return Status.status_ok
    }
    let old_count u64 = 0
    let self_source int = 0
    let source_offset u64 = 0
    if (value.handle != 0) {
        let state *string_state = string_state_of(value)
        old_count = state.count
        let src_addr u64 = text.data.to_type(u64)
        let base_addr u64 = state.data.to_type(u64)
        if (src_addr >= base_addr && src_addr < base_addr + state.count) {
            self_source = 1
            source_offset = src_addr - base_addr
        }
    }
    if (text.count > STRING_MAX_LENGTH - old_count) {
        return Status.status_overflow
    }
    let needed u64 = old_count + text.count
    if (value.handle == 0 || string_state_of(value).capacity < needed) {
        let next u64 = string_grow_capacity(value, needed)
        if (next == 0) {
            return Status.status_overflow
        }
        let status Status = reserve(value, next)
        if (status != Status.status_ok) {
            return status
        }
    }
    let state *string_state = string_state_of(value)
    let source *u8 = text.data
    if (self_source != 0) {
        source = state.data + source_offset
    }
    memory.copy((state.data + old_count).to_type(*void), source.to_type(*void), text.count)
    state.count = needed
    state.data[state.count] = 0
    return Status.status_ok
}

// append_byte 追加任意单字节（包括 NUL）；不保证结果仍是合法 UTF-8。
pub fn append_byte(value *String, byte u8) Status {
    let one [1]u8
    one[0] = byte
    let text View
    text.data = &one[0]
    text.count = 1
    return append(value, text)
}

// c_str 返回只读 C 字符串视图；内容含 NUL 时返回 embedded_nul、data=0。
// 成功指针借用 String 的结尾 NUL，不允许交给释放或写入接口。
pub fn c_str(value *String) CStrResult {
    let result CStrResult
    result.status = Status.status_ok
    result.data = 0
    if (value == 0) {
        result.status = Status.status_invalid_argument
        return result
    }
    if (value.handle == 0) {
        result.data = ""
        return result
    }
    let state *string_state = string_state_of(value)
    if (state.count == 0) {
        result.data = ""
        return result
    }
    let i u64 = 0
    for i < state.count {
        if (state.data[i] == 0) {
            result.status = Status.status_embedded_nul
            return result
        }
        i += 1
    }
    result.data = state.data.to_type(*char)
    return result
}

// length 返回 NUL 结尾 UTF-8 字符串的字节数，不计算 Unicode 码点。
pub fn length(text *char) u64 {
    return strlen(text)
}

// equals 按字节比较两个 NUL 结尾字符串；相等返回 1，否则返回 0。
pub fn equals(left *char, right *char) int {
    let index int = 0
    for 1 {
        if (left[index] != right[index]) {
            return 0
        }
        if (left[index] == 0) {
            return 1
        }
        index += 1
    }
    return 0
}

// compare 按无符号字节序比较两个 NUL 结尾字符串，结果固定为 -1、0 或 1。
pub fn compare(left *char, right *char) int {
    let index int = 0
    for 1 {
        let left_byte u8 = left[index].to_type(u8)
        let right_byte u8 = right[index].to_type(u8)
        if (left_byte < right_byte) {
            return -1
        }
        if (left_byte > right_byte) {
            return 1
        }
        if (left_byte == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// concat 返回左右两段字节的连接结果；空输入返回零句柄空串。
pub fn concat(left View, right View) StringResult {
    if (left.count > 0 && left.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (right.count > 0 && right.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (left.count > STRING_MAX_LENGTH - right.count) {
        return string_result_error(Status.status_overflow)
    }
    let total u64 = left.count + right.count
    let result StringResult = string_alloc_exact(total)
    if (result.status != Status.status_ok || total == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    if (left.count > 0) {
        memory.copy(state.data.to_type(*void), left.data.to_type(*void), left.count)
    }
    if (right.count > 0) {
        memory.copy((state.data + left.count).to_type(*void),
            right.data.to_type(*void), right.count)
    }
    state.count = total
    state.data[total] = 0
    return result
}

// join 用 separator 连接 parts；先算总字节数再分配，零片段返回空串。
// 空分隔符允许；parts 由普通数组/切片提供，不依赖从裸指针构造切片。
pub fn join(parts []View, separator View) StringResult {
    if (separator.count > 0 && separator.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let part_count int = len(parts)
    if (part_count == 0) {
        return string_result_ok(make())
    }
    let total u64 = 0
    let i int = 0
    for i < part_count {
        let part View = parts[i]
        if (part.count > 0 && part.data == 0) {
            return string_result_error(Status.status_invalid_argument)
        }
        if (part.count > STRING_MAX_LENGTH - total) {
            return string_result_error(Status.status_overflow)
        }
        total += part.count
        i += 1
    }
    if (part_count > 1 && separator.count > 0) {
        let separator_count u64 = (part_count - 1).to_type(u64)
        if (separator_count > (STRING_MAX_LENGTH - total) / separator.count) {
            return string_result_error(Status.status_overflow)
        }
        total += separator.count * separator_count
    }
    let result StringResult = string_alloc_exact(total)
    if (result.status != Status.status_ok || total == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let destination u64 = 0
    i = 0
    for i < part_count {
        let part View = parts[i]
        if (part.count > 0) {
            memory.copy((state.data + destination).to_type(*void),
                part.data.to_type(*void), part.count)
            destination += part.count
        }
        if (i + 1 < part_count && separator.count > 0) {
            memory.copy((state.data + destination).to_type(*void),
                separator.data.to_type(*void), separator.count)
            destination += separator.count
        }
        i += 1
    }
    state.count = total
    state.data[total] = 0
    return result
}

// replace 左到右、非重叠替换最多 limit 次；old 为空报参数错误。
// limit=0 或无匹配时返回独立原文副本；replacement 允许为空。
pub fn replace(text View, old View, replacement View, limit u64) StringResult {
    if (old.count == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (replacement.count > 0 && replacement.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (limit == 0 || old.count > text.count) {
        return from_view(text)
    }
    let matches u64 = 0
    let final_count u64 = text.count
    let scan u64 = 0
    let last_start u64 = text.count - old.count
    for scan <= last_start && matches < limit {
        if (view_bytes_equal_at(text, scan, old)) {
            matches += 1
            if (replacement.count > old.count) {
                let delta u64 = replacement.count - old.count
                if (final_count > STRING_MAX_LENGTH - delta) {
                    return string_result_error(Status.status_overflow)
                }
                final_count += delta
            } else {
                final_count -= old.count - replacement.count
            }
            scan += old.count
        } else {
            scan += 1
        }
    }
    if (matches == 0) {
        return from_view(text)
    }
    let result StringResult = string_alloc_exact(final_count)
    if (result.status != Status.status_ok) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let source u64 = 0
    let destination u64 = 0
    let done u64 = 0
    for source < text.count {
        if (done < matches && source <= text.count - old.count
            && view_bytes_equal_at(text, source, old)) {
            if (replacement.count > 0) {
                memory.copy((state.data + destination).to_type(*void),
                    replacement.data.to_type(*void), replacement.count)
            }
            source += old.count
            destination += replacement.count
            done += 1
        } else {
            state.data[destination] = text.data[source]
            source += 1
            destination += 1
        }
    }
    state.count = final_count
    state.data[final_count] = 0
    return result
}

// replace_all 是不限次数的 replace 入口；不递归匹配新插入内容。
pub fn replace_all(text View, old View, replacement View) StringResult {
    return replace(text, old, replacement, STRING_MAX_LENGTH)
}

// lower_ascii 只把 ASCII A–Z 转成 a–z；其他字节原样复制。
pub fn lower_ascii(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok || text.count == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let i u64 = 0
    for i < text.count {
        let byte u8 = text.data[i]
        if (byte >= 'A' && byte <= 'Z') {
            state.data[i] = (byte + 32).to_type(u8)
        } else {
            state.data[i] = byte
        }
        i += 1
    }
    state.count = text.count
    state.data[text.count] = 0
    return result
}

// upper_ascii 只把 ASCII a–z 转成 A–Z；其他字节原样复制。
pub fn upper_ascii(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok || text.count == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let i u64 = 0
    for i < text.count {
        let byte u8 = text.data[i]
        if (byte >= 'a' && byte <= 'z') {
            state.data[i] = (byte - 32).to_type(u8)
        } else {
            state.data[i] = byte
        }
        i += 1
    }
    state.count = text.count
    state.data[text.count] = 0
    return result
}

// utf8_validate 严格校验整段字节并计完整标量数；非法时 rune_count=0，
// error_offset 为首个非法编码序列起点。
pub fn utf8_validate(text View) Utf8Info {
    let result Utf8Info
    result.status = Status.status_ok
    result.rune_count = 0
    result.error_offset = 0
    if (text.count > 0 && text.data == 0) {
        result.status = Status.status_invalid_argument
        return result
    }
    let pos u64 = 0
    let count u64 = 0
    for pos < text.count {
        let rune_result RuneResult = utf8_decode_at(text, pos)
        if (rune_result.status != Status.status_ok) {
            result.status = Status.status_invalid_utf8
            result.rune_count = 0
            result.error_offset = rune_result.offset
            return result
        }
        count += 1
        pos += rune_result.width
    }
    result.rune_count = count
    return result
}

// utf8_next 从 cursor 解一个标量；成功推进 width 字节，结尾返回 end。
// 越界/非法时不推进 cursor；合法 U+0000 与结束通过 status 区分。
pub fn utf8_next(text View, cursor *u64) RuneResult {
    let result RuneResult
    result.status = Status.status_invalid_argument
    result.rune = 0
    result.width = 0
    result.offset = 0
    if (cursor == 0) {
        return result
    }
    if (text.count > 0 && text.data == 0) {
        return result
    }
    let pos u64 = cursor[0]
    if (pos > text.count) {
        result.status = Status.status_bounds
        result.offset = pos
        return result
    }
    if (pos == text.count) {
        result.status = Status.status_end
        result.offset = text.count
        return result
    }
    result = utf8_decode_at(text, pos)
    if (result.status == Status.status_ok) {
        cursor[0] = pos + result.width
    }
    return result
}

// append_rune 把合法 Unicode 标量编码后追加到 String；非法标量不改变目标。
pub fn append_rune(value *String, rune u32) Status {
    if (!utf8_is_scalar(rune)) {
        return Status.status_invalid_utf8
    }
    let buffer [4]u8
    let width u64 = utf8_encode(rune, &buffer[0])
    let text View
    text.data = &buffer[0]
    text.count = width
    return append(value, text)
}

// view_bytes 由指针和字节数构造借用视图；不检查 UTF-8。
// (0,0) 合法，(0,非零) 是参数错误；非零长度不检查地址可读性。
pub fn view_bytes(data *u8, count u64) ViewResult {
    if (data == 0 && count != 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    let value View
    value.data = data
    value.count = count
    return view_result_ok(value)
}

// view_cstr 把 NUL 结尾字符串转成借用视图；空指针是参数错误。
// 扫描到首个 NUL 为止，因此不保留字符串内部的 NUL（C 字符串本身无法表达）。
pub fn view_cstr(text *char) ViewResult {
    if (text == 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    let value View
    value.data = text.to_type(*u8)
    value.count = strlen(text)
    return view_result_ok(value)
}

// view_equal 按长度和字节判断两个视图是否相等。
pub fn view_equal(left View, right View) bool {
    if (left.count != right.count) {
        return false
    }
    let i u64 = 0
    for i < left.count {
        if (left.data[i] != right.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// view_compare 按无符号字节词典序比较两个视图，结果固定为 -1、0 或 1。
pub fn view_compare(left View, right View) int {
    let common u64 = left.count
    if (right.count < common) {
        common = right.count
    }
    let i u64 = 0
    for i < common {
        if (left.data[i] < right.data[i]) {
            return -1
        }
        if (left.data[i] > right.data[i]) {
            return 1
        }
        i += 1
    }
    if (left.count < right.count) {
        return -1
    }
    if (left.count > right.count) {
        return 1
    }
    return 0
}

// starts_with 判断 text 是否以 prefix 开头；空前缀匹配任何文本。
pub fn starts_with(text View, prefix View) bool {
    if (prefix.count > text.count) {
        return false
    }
    let i u64 = 0
    for i < prefix.count {
        if (text.data[i] != prefix.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// ends_with 判断 text 是否以 suffix 结尾；空后缀匹配任何文本。
pub fn ends_with(text View, suffix View) bool {
    if (suffix.count > text.count) {
        return false
    }
    let offset u64 = text.count - suffix.count
    let i u64 = 0
    for i < suffix.count {
        if (text.data[offset + i] != suffix.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// find 返回 needle 在 text 中第一次出现的字节位置；空 needle 匹配位置 0。
pub fn find(text View, needle View) IndexResult {
    let result IndexResult
    result.found = false
    result.index = 0
    if (needle.count == 0) {
        result.found = true
        return result
    }
    if (needle.count > text.count) {
        return result
    }
    let limit u64 = text.count - needle.count
    let i u64 = 0
    for i <= limit {
        if (view_bytes_equal_at(text, i, needle)) {
            result.found = true
            result.index = i
            return result
        }
        i += 1
    }
    return result
}

// rfind 返回 needle 在 text 中最后一次出现的字节位置；空 needle 匹配
// 位置 text.count。匹配不重叠，但 rfind 本身只报告一个位置。
pub fn rfind(text View, needle View) IndexResult {
    let result IndexResult
    result.found = false
    result.index = 0
    if (needle.count == 0) {
        result.found = true
        result.index = text.count
        return result
    }
    if (needle.count > text.count) {
        return result
    }
    let i u64 = text.count - needle.count + 1
    for i > 0 {
        i -= 1
        if (view_bytes_equal_at(text, i, needle)) {
            result.found = true
            result.index = i
            return result
        }
    }
    return result
}

// contains 判断 needle 是否出现在 text 中，与 find 的 found 一致。
pub fn contains(text View, needle View) bool {
    return find(text, needle).found
}

// slice 返回半开区间 [start,end) 的借用视图；要求 start<=end<=count。
// 失败返回空视图；不复制，也不修复 UTF-8 边界。
pub fn slice(text View, start u64, end u64) ViewResult {
    if (start > end || end > text.count) {
        return view_result_error(Status.status_bounds)
    }
    let value View
    value.data = text.data + start
    value.count = end - start
    return view_result_ok(value)
}

// trim_ascii 裁掉首尾 ASCII 空白并返回借用视图；不分配、不改变中间字节。
// 空视图或空指针（count=0）返回空视图。
pub fn trim_ascii(text View) View {
    if (text.count == 0 || text.data == 0) {
        return string_empty_view()
    }
    let start u64 = 0
    for start < text.count && view_is_ascii_space(text.data[start]) {
        start += 1
    }
    let end u64 = text.count
    for end > start && view_is_ascii_space(text.data[end - 1]) {
        end -= 1
    }
    let value View
    value.data = text.data + start
    value.count = end - start
    return value
}

// split 初始化按 separator 的字节切分迭代器；不分配，失败不修改 out。
// 空 separator 是参数错误；空文本会产生一个空片段，然后进入 end。
pub fn split(text View, separator View, out *SplitIter) Status {
    if (out == 0 || separator.count == 0 || (separator.count > 0 && separator.data == 0)) {
        return Status.status_invalid_argument
    }
    out.text = text
    out.separator = separator
    out.cursor = 0
    out.ended = 0
    return Status.status_ok
}

// split_next 返回下一个借用片段；结束后持续返回 status_end。
// 分隔符从左到右、互不重叠匹配，保留全部空片段；片段 count 不依赖 strlen。
pub fn split_next(iter *SplitIter) ViewResult {
    if (iter == 0 || iter.separator.count == 0 || iter.separator.data == 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    if (iter.ended != 0) {
        return view_result_error(Status.status_end)
    }
    if (iter.cursor > iter.text.count) {
        iter.ended = 1
        return view_result_error(Status.status_end)
    }
    let remaining u64 = iter.text.count - iter.cursor
    if (iter.separator.count > remaining) {
        let value View
        value.data = iter.text.data + iter.cursor
        value.count = remaining
        iter.ended = 1
        return view_result_ok(value)
    }
    let limit u64 = iter.text.count - iter.separator.count
    let pos u64 = iter.cursor
    for pos <= limit {
        if (view_bytes_equal_at(iter.text, pos, iter.separator)) {
            let value View
            value.data = iter.text.data + iter.cursor
            value.count = pos - iter.cursor
            iter.cursor = pos + iter.separator.count
            return view_result_ok(value)
        }
        pos += 1
    }
    let value View
    value.data = iter.text.data + iter.cursor
    value.count = remaining
    iter.ended = 1
    return view_result_ok(value)
}
