module string

pub struct String{

    
}


// length 返回 NUL 结尾 UTF-8 字符串的字节数，不计算 Unicode 码点。
pub fn length(text *char) u64 {
    return strlen(text)
}

// equals 按字节比较两个 NUL 结尾字符串；相等返回 1，否则返回 0。
pub fn equals(left *char, right *char) int {
    let index int = 0
    for 1 {
        if (left[index] != right[index]) {
            return 0
        }
        if (left[index] == 0) {
            return 1
        }
        index += 1
    }
    return 0
}

// compare 按无符号字节序比较两个 NUL 结尾字符串，结果固定为 -1、0 或 1。
pub fn compare(left *char, right *char) int {
    let index int = 0
    for 1 {
        let left_byte u8 = left[index].to_type(u8)
        let right_byte u8 = right[index].to_type(u8)
        if (left_byte < right_byte) {
            return -1
        }
        if (left_byte > right_byte) {
            return 1
        }
        if (left_byte == 0) {
            return 0
        }
        index += 1
    }
    return 0
}
