module string

// yh string 标准库：只读视图的构造、查询、查找与无分配切分。
//
// 所有函数只读取 View 指向的字节，不分配、不修改输入，也不检查任意地址是否
// 可读；调用者必须保证 View 在调用期间有效。切片与切分返回的片段都借用源。

// view_bytes 由指针和字节数构造借用视图；不检查 UTF-8。
// (0,0) 合法，(0,非零) 是参数错误；非零长度不检查地址可读性。
pub fn view_bytes(data *u8, count u64) ViewResult {
    if (data == 0 && count != 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    let value View
    value.data = data
    value.count = count
    return view_result_ok(value)
}

// view_cstr 把 NUL 结尾字符串转成借用视图；空指针是参数错误。
// 扫描到首个 NUL 为止，因此不保留字符串内部的 NUL（C 字符串本身无法表达）。
pub fn view_cstr(text *char) ViewResult {
    if (text == 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    let value View
    value.data = text.to_type(*u8)
    value.count = strlen(text)
    return view_result_ok(value)
}

// view_equal 按长度和字节判断两个视图是否相等。
pub fn view_equal(left View, right View) bool {
    if (left.count != right.count) {
        return false
    }
    let i u64 = 0
    for i < left.count {
        if (left.data[i] != right.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// view_compare 按无符号字节词典序比较两个视图，结果固定为 -1、0 或 1。
pub fn view_compare(left View, right View) int {
    let common u64 = left.count
    if (right.count < common) {
        common = right.count
    }
    let i u64 = 0
    for i < common {
        if (left.data[i] < right.data[i]) {
            return -1
        }
        if (left.data[i] > right.data[i]) {
            return 1
        }
        i += 1
    }
    if (left.count < right.count) {
        return -1
    }
    if (left.count > right.count) {
        return 1
    }
    return 0
}

// starts_with 判断 text 是否以 prefix 开头；空前缀匹配任何文本。
pub fn starts_with(text View, prefix View) bool {
    if (prefix.count > text.count) {
        return false
    }
    let i u64 = 0
    for i < prefix.count {
        if (text.data[i] != prefix.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// ends_with 判断 text 是否以 suffix 结尾；空后缀匹配任何文本。
pub fn ends_with(text View, suffix View) bool {
    if (suffix.count > text.count) {
        return false
    }
    let offset u64 = text.count - suffix.count
    let i u64 = 0
    for i < suffix.count {
        if (text.data[offset + i] != suffix.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// view_bytes_equal_at 判断 text 从 offset 起是否与 needle 完全相同。
// 调用者必须保证 offset + needle.count <= text.count，避免越界读取。
fn view_bytes_equal_at(text View, offset u64, needle View) bool {
    let i u64 = 0
    for i < needle.count {
        if (text.data[offset + i] != needle.data[i]) {
            return false
        }
        i += 1
    }
    return true
}

// find 返回 needle 在 text 中第一次出现的字节位置；空 needle 匹配位置 0。
pub fn find(text View, needle View) IndexResult {
    let result IndexResult
    result.found = false
    result.index = 0
    if (needle.count == 0) {
        result.found = true
        return result
    }
    if (needle.count > text.count) {
        return result
    }
    let limit u64 = text.count - needle.count
    let i u64 = 0
    for i <= limit {
        if (view_bytes_equal_at(text, i, needle)) {
            result.found = true
            result.index = i
            return result
        }
        i += 1
    }
    return result
}

// rfind 返回 needle 在 text 中最后一次出现的字节位置；空 needle 匹配
// 位置 text.count。匹配不重叠，但 rfind 本身只报告一个位置。
pub fn rfind(text View, needle View) IndexResult {
    let result IndexResult
    result.found = false
    result.index = 0
    if (needle.count == 0) {
        result.found = true
        result.index = text.count
        return result
    }
    if (needle.count > text.count) {
        return result
    }
    let i u64 = text.count - needle.count + 1
    for i > 0 {
        i -= 1
        if (view_bytes_equal_at(text, i, needle)) {
            result.found = true
            result.index = i
            return result
        }
    }
    return result
}

// contains 判断 needle 是否出现在 text 中，与 find 的 found 一致。
pub fn contains(text View, needle View) bool {
    return find(text, needle).found
}

// slice 返回半开区间 [start,end) 的借用视图；要求 start<=end<=count。
// 失败返回空视图；不复制，也不修复 UTF-8 边界。
pub fn slice(text View, start u64, end u64) ViewResult {
    if (start > end || end > text.count) {
        return view_result_error(Status.status_bounds)
    }
    let value View
    value.data = text.data + start
    value.count = end - start
    return view_result_ok(value)
}

// view_is_ascii_space 判断字节是否属于 trim_ascii 裁剪集合：
// 0x09–0x0D（TAB/LF/VT/FF/CR）与 0x20（空格）。
fn view_is_ascii_space(byte u8) bool {
    if (byte >= 9 && byte <= 13) {
        return true
    }
    return byte == 32
}

// trim_ascii 裁掉首尾 ASCII 空白并返回借用视图；不分配、不改变中间字节。
// 空视图或空指针（count=0）返回空视图。
pub fn trim_ascii(text View) View {
    if (text.count == 0 || text.data == 0) {
        return string_empty_view()
    }
    let start u64 = 0
    for start < text.count && view_is_ascii_space(text.data[start]) {
        start += 1
    }
    let end u64 = text.count
    for end > start && view_is_ascii_space(text.data[end - 1]) {
        end -= 1
    }
    let value View
    value.data = text.data + start
    value.count = end - start
    return value
}

// split 初始化按 separator 的字节切分迭代器；不分配，失败不修改 out。
// 空 separator 是参数错误；空文本会产生一个空片段，然后进入 end。
pub fn split(text View, separator View, out *SplitIter) Status {
    if (out == 0 || separator.count == 0 || (separator.count > 0 && separator.data == 0)) {
        return Status.status_invalid_argument
    }
    out.text = text
    out.separator = separator
    out.cursor = 0
    out.ended = 0
    return Status.status_ok
}

// split_next 返回下一个借用片段；结束后持续返回 status_end。
// 分隔符从左到右、互不重叠匹配，保留全部空片段；片段 count 不依赖 strlen。
pub fn split_next(iter *SplitIter) ViewResult {
    if (iter == 0 || iter.separator.count == 0 || iter.separator.data == 0) {
        return view_result_error(Status.status_invalid_argument)
    }
    if (iter.ended != 0) {
        return view_result_error(Status.status_end)
    }
    if (iter.cursor > iter.text.count) {
        iter.ended = 1
        return view_result_error(Status.status_end)
    }
    let remaining u64 = iter.text.count - iter.cursor
    if (iter.separator.count > remaining) {
        let value View
        value.data = iter.text.data + iter.cursor
        value.count = remaining
        iter.ended = 1
        return view_result_ok(value)
    }
    let limit u64 = iter.text.count - iter.separator.count
    let pos u64 = iter.cursor
    for pos <= limit {
        if (view_bytes_equal_at(iter.text, pos, iter.separator)) {
            let value View
            value.data = iter.text.data + iter.cursor
            value.count = pos - iter.cursor
            iter.cursor = pos + iter.separator.count
            return view_result_ok(value)
        }
        pos += 1
    }
    let value View
    value.data = iter.text.data + iter.cursor
    value.count = remaining
    iter.ended = 1
    return view_result_ok(value)
}
