module string

import memory

// yh string 标准库：连接、替换与 ASCII 大小写转换。
//
// 所有变换都返回拥有独立存储的 String；即使无匹配或无需转换也不返回借用
// 伪装的所有者。空 old/空分隔符按各自契约报错，不做隐式补丁。

// concat 返回左右两段字节的连接结果；空输入返回零句柄空串。
pub fn concat(left View, right View) StringResult {
    if (left.count > 0 && left.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (right.count > 0 && right.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (left.count > STRING_MAX_LENGTH - right.count) {
        return string_result_error(Status.status_overflow)
    }
    let total u64 = left.count + right.count
    let result StringResult = string_alloc_exact(total)
    if (result.status != Status.status_ok || total == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    if (left.count > 0) {
        memory.copy(state.data.to_type(*void), left.data.to_type(*void), left.count)
    }
    if (right.count > 0) {
        memory.copy((state.data + left.count).to_type(*void),
            right.data.to_type(*void), right.count)
    }
    state.count = total
    state.data[total] = 0
    return result
}

// join 用 separator 连接 parts；先算总字节数再分配，零片段返回空串。
// 空分隔符允许；parts 由普通数组/切片提供，不依赖从裸指针构造切片。
pub fn join(parts []View, separator View) StringResult {
    if (separator.count > 0 && separator.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let part_count int = len(parts)
    if (part_count == 0) {
        return string_result_ok(make())
    }
    let total u64 = 0
    let i int = 0
    for i < part_count {
        let part View = parts[i]
        if (part.count > 0 && part.data == 0) {
            return string_result_error(Status.status_invalid_argument)
        }
        if (part.count > STRING_MAX_LENGTH - total) {
            return string_result_error(Status.status_overflow)
        }
        total += part.count
        i += 1
    }
    if (part_count > 1 && separator.count > 0) {
        let separator_count u64 = (part_count - 1).to_type(u64)
        if (separator_count > (STRING_MAX_LENGTH - total) / separator.count) {
            return string_result_error(Status.status_overflow)
        }
        total += separator.count * separator_count
    }
    let result StringResult = string_alloc_exact(total)
    if (result.status != Status.status_ok || total == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let destination u64 = 0
    i = 0
    for i < part_count {
        let part View = parts[i]
        if (part.count > 0) {
            memory.copy((state.data + destination).to_type(*void),
                part.data.to_type(*void), part.count)
            destination += part.count
        }
        if (i + 1 < part_count && separator.count > 0) {
            memory.copy((state.data + destination).to_type(*void),
                separator.data.to_type(*void), separator.count)
            destination += separator.count
        }
        i += 1
    }
    state.count = total
    state.data[total] = 0
    return result
}

// replace 左到右、非重叠替换最多 limit 次；old 为空报参数错误。
// limit=0 或无匹配时返回独立原文副本；replacement 允许为空。
pub fn replace(text View, old View, replacement View, limit u64) StringResult {
    if (old.count == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (replacement.count > 0 && replacement.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (limit == 0 || old.count > text.count) {
        return from_view(text)
    }
    let matches u64 = 0
    let final_count u64 = text.count
    let scan u64 = 0
    let last_start u64 = text.count - old.count
    for scan <= last_start && matches < limit {
        if (view_bytes_equal_at(text, scan, old)) {
            matches += 1
            if (replacement.count > old.count) {
                let delta u64 = replacement.count - old.count
                if (final_count > STRING_MAX_LENGTH - delta) {
                    return string_result_error(Status.status_overflow)
                }
                final_count += delta
            } else {
                final_count -= old.count - replacement.count
            }
            scan += old.count
        } else {
            scan += 1
        }
    }
    if (matches == 0) {
        return from_view(text)
    }
    let result StringResult = string_alloc_exact(final_count)
    if (result.status != Status.status_ok) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let source u64 = 0
    let destination u64 = 0
    let done u64 = 0
    for source < text.count {
        if (done < matches && source <= text.count - old.count
            && view_bytes_equal_at(text, source, old)) {
            if (replacement.count > 0) {
                memory.copy((state.data + destination).to_type(*void),
                    replacement.data.to_type(*void), replacement.count)
            }
            source += old.count
            destination += replacement.count
            done += 1
        } else {
            state.data[destination] = text.data[source]
            source += 1
            destination += 1
        }
    }
    state.count = final_count
    state.data[final_count] = 0
    return result
}

// replace_all 是不限次数的 replace 入口；不递归匹配新插入内容。
pub fn replace_all(text View, old View, replacement View) StringResult {
    return replace(text, old, replacement, STRING_MAX_LENGTH)
}

// lower_ascii 只把 ASCII A–Z 转成 a–z；其他字节原样复制。
pub fn lower_ascii(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok || text.count == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let i u64 = 0
    for i < text.count {
        let byte u8 = text.data[i]
        if (byte >= 'A' && byte <= 'Z') {
            state.data[i] = (byte + 32).to_type(u8)
        } else {
            state.data[i] = byte
        }
        i += 1
    }
    state.count = text.count
    state.data[text.count] = 0
    return result
}

// upper_ascii 只把 ASCII a–z 转成 A–Z；其他字节原样复制。
pub fn upper_ascii(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok || text.count == 0) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    let i u64 = 0
    for i < text.count {
        let byte u8 = text.data[i]
        if (byte >= 'a' && byte <= 'z') {
            state.data[i] = (byte - 32).to_type(u8)
        } else {
            state.data[i] = byte
        }
        i += 1
    }
    state.count = text.count
    state.data[text.count] = 0
    return result
}
