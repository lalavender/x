module string

// yh string 标准库：公开 API 速查。
//
// 本文件只服务阅读与文档索引，不新增运行时行为；真实实现分别在
// 10_view.yh、20_owned.yh、30_transform.yh、40_utf8.yh，旧 C 字符串接口
// 保留在 string.yh。所有长度/位置/容量单位都是字节（u64）。
//
// 模型：
//   View   { data *u8; count u64 }  借用连续字节，不拥有，可含 NUL/非法 UTF-8
//   String { handle *void }         独占私有存储，零句柄=空串，显式 release
//
// 状态：status_ok / status_end / status_invalid_argument / status_bounds /
//       status_overflow / status_out_of_memory / status_invalid_utf8 /
//       status_embedded_nul
//
// 旧接口（NUL 截止）：
//   length(*char) u64
//   equals(*char,*char) int
//   compare(*char,*char) int
//
// 视图（10_view.yh）：
//   view_bytes(*u8,u64) ViewResult
//   view_cstr(*char) ViewResult
//   view_equal(View,View) bool
//   view_compare(View,View) int
//   starts_with(View,View) bool
//   ends_with(View,View) bool
//   find(View,View) IndexResult
//   rfind(View,View) IndexResult
//   contains(View,View) bool
//   slice(View,u64,u64) ViewResult
//   trim_ascii(View) View
//   split(View,View,*SplitIter) Status
//   split_next(*SplitIter) ViewResult
//
// 拥有者（20_owned.yh）：
//   make() String
//   from_view(View) StringResult
//   clone(*String) StringResult
//   move(*String) String
//   release(*String) void
//   as_view(*String) View
//   byte_length(*String) u64
//   capacity(*String) u64
//   reserve(*String,u64) Status
//   clear(*String) void
//   truncate(*String,u64) Status
//   assign(*String,View) Status
//   append(*String,View) Status
//   append_byte(*String,u8) Status
//   c_str(*String) CStrResult
//
// 变换（30_transform.yh）：
//   concat(View,View) StringResult
//   join([]View,View) StringResult
//   replace(View,View,View,u64) StringResult
//   replace_all(View,View,View) StringResult
//   lower_ascii(View) StringResult
//   upper_ascii(View) StringResult
//
// UTF-8（40_utf8.yh）：
//   utf8_validate(View) Utf8Info
//   utf8_next(View,*u64) RuneResult
//   append_rune(*String,u32) Status
//
// 失效规则：所有成功的可变操作与 release 都使此前派生的 View/C 指针失效；
// 失败的可变操作保留内容、长度、容量和既有视图。UTF-8 只按标量处理，
// 不承诺字素边界、规范化或 Unicode 大小写折叠。
