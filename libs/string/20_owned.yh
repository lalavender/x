module string

import memory

// yh string 标准库：拥有者生命周期、容量增长、赋值/追加与 C 边界。
//
// String 独占一次分配的数据块与一个私有状态块；所有成功的可变操作和 release
// 都会使此前派生的 View/C 指针失效。失败的可变操作保留原内容、长度、容量与
// 既有视图。扩容先分配、复制、补 NUL，全部成功后才交换并释放旧块。

// string_alloc 是唯一的私有分配接缝；测试副本把 STRING_TEST_FAIL_AFTER 改成
// 非负值后，按成功分配次数注入失败。产品构建该分支恒为假。
fn string_alloc(byte_count u64) *u8 {
    if (STRING_TEST_FAIL_AFTER >= 0 && string_alloc_count >= STRING_TEST_FAIL_AFTER) {
        return 0
    }
    let data *u8 = memory.alloc(byte_count).to_type(*u8)
    if (data != 0) {
        string_alloc_count += 1
    }
    return data
}

// string_alloc_exact 分配恰好 count 字节内容加额外 NUL，并创建私有状态。
// count=0 返回零句柄；失败返回 out_of_memory，不留下半成品。
fn string_alloc_exact(count u64) StringResult {
    if (count == 0) {
        return string_result_ok(make())
    }
    if (count > STRING_MAX_LENGTH) {
        return string_result_error(Status.status_overflow)
    }
    let data *u8 = string_alloc(count + 1)
    if (data == 0) {
        return string_result_error(Status.status_out_of_memory)
    }
    let state *string_state = string_alloc(
        sizeof(string_state).to_type(u64)).to_type(*string_state)
    if (state == 0) {
        memory.release(data.to_type(*void))
        return string_result_error(Status.status_out_of_memory)
    }
    state.data = data
    state.count = 0
    state.capacity = count
    state.data[0] = 0
    let value String
    value.handle = state.to_type(*void)
    return string_result_ok(value)
}

// string_copy_overlap 复制字节并正确处理重叠区间；不依赖 memory.copy 的
// 非重叠前提。地址比较使用 u64，避免指针关系比较这一未支持能力。
fn string_copy_overlap(destination *u8, source *u8, count u64) void {
    if (count == 0) {
        return
    }
    let dst u64 = destination.to_type(u64)
    let src u64 = source.to_type(u64)
    if (dst == src) {
        return
    }
    if (dst < src) {
        if (src - dst >= count) {
            memory.copy(destination.to_type(*void), source.to_type(*void), count)
            return
        }
        let i u64 = 0
        for i < count {
            destination[i] = source[i]
            i += 1
        }
        return
    }
    if (dst - src >= count) {
        memory.copy(destination.to_type(*void), source.to_type(*void), count)
        return
    }
    let i u64 = count
    for i > 0 {
        i -= 1
        destination[i] = source[i]
    }
}

// string_grow_capacity 计算追加时的新容量：至少 16，按几何增长；请求特别大
// 时直接取 needed。返回 0 表示无法在 STRING_MAX_LENGTH 内满足。
fn string_grow_capacity(value *String, needed u64) u64 {
    let current u64 = 0
    if (value != 0 && value.handle != 0) {
        current = string_state_of(value).capacity
    }
    let next u64 = current
    if (next < 16) {
        next = 16
    }
    if (next < needed) {
        if (next > STRING_MAX_LENGTH / 2) {
            next = needed
        } else {
            next = next * 2
            if (next < needed) {
                next = needed
            }
        }
    }
    if (next < needed || next > STRING_MAX_LENGTH) {
        return 0
    }
    return next
}

// make 返回零句柄空串；不分配，创建和释放后都可以继续追加。
pub fn make() String {
    let value String
    value.handle = 0
    return value
}

// from_view 独立复制全部字节；输入可立即释放或改写，空输入返回零句柄。
pub fn from_view(text View) StringResult {
    if (text.count > 0 && text.data == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (text.count == 0) {
        return string_result_ok(make())
    }
    if (text.count > STRING_MAX_LENGTH) {
        return string_result_error(Status.status_overflow)
    }
    let result StringResult = string_alloc_exact(text.count)
    if (result.status != Status.status_ok) {
        return result
    }
    let state *string_state = string_state_of(&result.value)
    memory.copy(state.data.to_type(*void), text.data.to_type(*void), text.count)
    state.count = text.count
    state.data[state.count] = 0
    return result
}

// clone 深复制一个 String；失败不改变原值，零句柄返回零句柄。
pub fn clone(value *String) StringResult {
    if (value == 0) {
        return string_result_error(Status.status_invalid_argument)
    }
    if (value.handle == 0) {
        return string_result_ok(make())
    }
    let state *string_state = string_state_of(value)
    let text View
    text.data = state.data
    text.count = state.count
    return from_view(text)
}

// move 转移句柄并清零源；不分配，不能用来复制所有权。空指针返回零句柄。
pub fn move(value *String) String {
    let result String
    result.handle = 0
    if (value == 0) {
        return result
    }
    result.handle = value.handle
    value.handle = 0
    return result
}

// release 释放并清零；同一变量重复释放安全，允许空指针。
pub fn release(value *String) void {
    if (value == 0 || value.handle == 0) {
        return
    }
    let state *string_state = string_state_of(value)
    memory.release(state.data.to_type(*void))
    memory.release(state.to_type(*void))
    value.handle = 0
}

// as_view 返回 O(1) 只读借用；零句柄返回空视图。
pub fn as_view(value *String) View {
    if (value == 0 || value.handle == 0) {
        return string_empty_view()
    }
    let state *string_state = string_state_of(value)
    let result View
    result.data = state.data
    result.count = state.count
    return result
}

// byte_length 返回内容字节数；零句柄或空指针返回 0。
pub fn byte_length(value *String) u64 {
    if (value == 0 || value.handle == 0) {
        return 0
    }
    return string_state_of(value).count
}

// capacity 返回当前内容容量（不含额外结尾 NUL）；零句柄或空指针返回 0。
pub fn capacity(value *String) u64 {
    if (value == 0 || value.handle == 0) {
        return 0
    }
    return string_state_of(value).capacity
}

// reserve 保证容量至少 minimum，内容与长度不变；已有容量足够时不分配。
// 失败保持原状态；minimum 超过 STRING_MAX_LENGTH 返回 overflow。
pub fn reserve(value *String, minimum u64) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (minimum > STRING_MAX_LENGTH) {
        return Status.status_overflow
    }
    if (value.handle != 0) {
        if (string_state_of(value).capacity >= minimum) {
            return Status.status_ok
        }
    } else if (minimum == 0) {
        return Status.status_ok
    }
    let data *u8 = string_alloc(minimum + 1)
    if (data == 0) {
        return Status.status_out_of_memory
    }
    let state *string_state = string_alloc(
        sizeof(string_state).to_type(u64)).to_type(*string_state)
    if (state == 0) {
        memory.release(data.to_type(*void))
        return Status.status_out_of_memory
    }
    let keep_count u64 = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        keep_count = old.count
        if (old.count > 0) {
            memory.copy(data.to_type(*void), old.data.to_type(*void), old.count)
        }
    }
    state.data = data
    state.count = keep_count
    state.capacity = minimum
    state.data[state.count] = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        memory.release(old.data.to_type(*void))
        memory.release(old.to_type(*void))
    }
    value.handle = state.to_type(*void)
    return Status.status_ok
}

// clear 清空内容并保留容量；不分配，零句柄保持零句柄。
pub fn clear(value *String) void {
    if (value == 0 || value.handle == 0) {
        return
    }
    let state *string_state = string_state_of(value)
    state.count = 0
    state.data[0] = 0
}

// truncate 只缩短到 count；超过原长度返回 bounds，不自动扩长。
pub fn truncate(value *String, count u64) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (value.handle == 0) {
        if (count == 0) {
            return Status.status_ok
        }
        return Status.status_bounds
    }
    let state *string_state = string_state_of(value)
    if (count > state.count) {
        return Status.status_bounds
    }
    state.count = count
    state.data[count] = 0
    return Status.status_ok
}

// assign 复制替换内容并复用容量；接受自身有效内容的子视图。
// 扩容路径先分配并复制，再交换；失败保持原内容、长度和容量。
pub fn assign(value *String, text View) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > 0 && text.data == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > STRING_MAX_LENGTH) {
        return Status.status_overflow
    }
    if (text.count == 0) {
        clear(value)
        return Status.status_ok
    }
    let old_data *u8 = 0
    let self_source int = 0
    let source_offset u64 = 0
    if (value.handle != 0) {
        let state *string_state = string_state_of(value)
        old_data = state.data
        let src_addr u64 = text.data.to_type(u64)
        let base_addr u64 = state.data.to_type(u64)
        if (src_addr >= base_addr && src_addr < base_addr + state.count) {
            self_source = 1
            source_offset = src_addr - base_addr
        }
    }
    if (value.handle != 0 && string_state_of(value).capacity >= text.count) {
        let state *string_state = string_state_of(value)
        let source *u8 = text.data
        if (self_source != 0) {
            source = state.data + source_offset
        }
        string_copy_overlap(state.data, source, text.count)
        state.count = text.count
        state.data[state.count] = 0
        return Status.status_ok
    }
    let data *u8 = string_alloc(text.count + 1)
    if (data == 0) {
        return Status.status_out_of_memory
    }
    let state *string_state = string_alloc(
        sizeof(string_state).to_type(u64)).to_type(*string_state)
    if (state == 0) {
        memory.release(data.to_type(*void))
        return Status.status_out_of_memory
    }
    if (self_source != 0) {
        memory.copy(data.to_type(*void), (old_data + source_offset).to_type(*void), text.count)
    } else {
        memory.copy(data.to_type(*void), text.data.to_type(*void), text.count)
    }
    state.data = data
    state.count = text.count
    state.capacity = text.count
    state.data[state.count] = 0
    if (value.handle != 0) {
        let old *string_state = string_state_of(value)
        memory.release(old.data.to_type(*void))
        memory.release(old.to_type(*void))
    }
    value.handle = state.to_type(*void)
    return Status.status_ok
}

// append 追加字节；支持整体自追加与自身子视图追加。扩容失败保持原状态。
pub fn append(value *String, text View) Status {
    if (value == 0) {
        return Status.status_invalid_argument
    }
    if (text.count > 0 && text.data == 0) {
        return Status.status_invalid_argument
    }
    if (text.count == 0) {
        return Status.status_ok
    }
    let old_count u64 = 0
    let self_source int = 0
    let source_offset u64 = 0
    if (value.handle != 0) {
        let state *string_state = string_state_of(value)
        old_count = state.count
        let src_addr u64 = text.data.to_type(u64)
        let base_addr u64 = state.data.to_type(u64)
        if (src_addr >= base_addr && src_addr < base_addr + state.count) {
            self_source = 1
            source_offset = src_addr - base_addr
        }
    }
    if (text.count > STRING_MAX_LENGTH - old_count) {
        return Status.status_overflow
    }
    let needed u64 = old_count + text.count
    if (value.handle == 0 || string_state_of(value).capacity < needed) {
        let next u64 = string_grow_capacity(value, needed)
        if (next == 0) {
            return Status.status_overflow
        }
        let status Status = reserve(value, next)
        if (status != Status.status_ok) {
            return status
        }
    }
    let state *string_state = string_state_of(value)
    let source *u8 = text.data
    if (self_source != 0) {
        source = state.data + source_offset
    }
    memory.copy((state.data + old_count).to_type(*void), source.to_type(*void), text.count)
    state.count = needed
    state.data[state.count] = 0
    return Status.status_ok
}

// append_byte 追加任意单字节（包括 NUL）；不保证结果仍是合法 UTF-8。
pub fn append_byte(value *String, byte u8) Status {
    let one [1]u8
    one[0] = byte
    let text View
    text.data = &one[0]
    text.count = 1
    return append(value, text)
}

// c_str 返回只读 C 字符串视图；内容含 NUL 时返回 embedded_nul、data=0。
// 成功指针借用 String 的结尾 NUL，不允许交给释放或写入接口。
pub fn c_str(value *String) CStrResult {
    let result CStrResult
    result.status = Status.status_ok
    result.data = 0
    if (value == 0) {
        result.status = Status.status_invalid_argument
        return result
    }
    if (value.handle == 0) {
        result.data = ""
        return result
    }
    let state *string_state = string_state_of(value)
    if (state.count == 0) {
        result.data = ""
        return result
    }
    let i u64 = 0
    for i < state.count {
        if (state.data[i] == 0) {
            result.status = Status.status_embedded_nul
            return result
        }
        i += 1
    }
    result.data = state.data.to_type(*char)
    return result
}
