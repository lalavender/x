module math

// ============================================================================
// api.yh —— math 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

@[extern] fn sqrt(value f64) f64

@[extern] fn sin(value f64) f64

@[extern] fn cos(value f64) f64

@[extern] fn pow(base f64, exponent f64) f64

// sqrt_f64 调用宿主 C 数学库的平方根函数。
pub fn sqrt_f64(value f64) f64 {
    return sqrt(value)
}

// sin_f64 调用宿主 C 数学库的正弦函数，参数单位为弧度。
pub fn sin_f64(value f64) f64 {
    return sin(value)
}

// cos_f64 调用宿主 C 数学库的余弦函数，参数单位为弧度。
pub fn cos_f64(value f64) f64 {
    return cos(value)
}

// pow_f64 调用宿主 C 数学库的幂函数。
pub fn pow_f64(base f64, exponent f64) f64 {
    return pow(base, exponent)
}
