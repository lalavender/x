module sync

// ============================================================================
// prim.windows.yh —— Windows 平台原语（L1 占位，L2 落地）。
//
// L2 计划：CreateThread + SRWLOCK + CONDITION_VARIABLE，并在
// vendor/windows-sdk 的 KERNEL32 导入表里补齐所需符号。
//
// 在实现落地前保持显式失败：platform_ready 返回 0，线程创建与互斥/条件
// 变量初始化返回 STATUS_INVALID，避免“看起来能跑、实际没有同步”的静默错误。
// 加解锁与等待是空操作，只有调用方忽略初始化失败时才会到达。
// ============================================================================

// platform_native_ready：Windows 后端尚未落地，返回 0。
fn platform_native_ready() int {
    return 0
}

// thread_native_create：未实现，显式失败。
fn thread_native_create(out *u64, block *Dispatch) int {
    return STATUS_INVALID
}

// thread_native_join：未实现，显式失败。
fn thread_native_join(handle u64) int {
    return STATUS_INVALID
}

// thread_native_detach：未实现，显式失败。
fn thread_native_detach(handle u64) int {
    return STATUS_INVALID
}

// thread_native_self：未实现，返回 0（只用于调试，不承诺语义）。
fn thread_native_self() u64 {
    return 0
}

// mutex_native_init：未实现，显式失败。
fn mutex_native_init(m *Mutex) int {
    return STATUS_INVALID
}

// mutex_native_lock：占位空操作。
fn mutex_native_lock(m *Mutex) void {
}

// mutex_native_unlock：占位空操作。
fn mutex_native_unlock(m *Mutex) void {
}

// mutex_native_try_lock：未实现，显式失败。
fn mutex_native_try_lock(m *Mutex) int {
    return STATUS_INVALID
}

// mutex_native_destroy：占位空操作。
fn mutex_native_destroy(m *Mutex) void {
}

// cond_native_init：未实现，显式失败。
fn cond_native_init(c *Cond) int {
    return STATUS_INVALID
}

// cond_native_wait：占位空操作。
fn cond_native_wait(c *Cond, m *Mutex) void {
}

// cond_native_signal：占位空操作。
fn cond_native_signal(c *Cond) void {
}

// cond_native_broadcast：占位空操作。
fn cond_native_broadcast(c *Cond) void {
}

// cond_native_destroy：占位空操作。
fn cond_native_destroy(c *Cond) void {
}
