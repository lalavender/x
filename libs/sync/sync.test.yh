module sync

// ============================================================================
// sync.test.yh —— 不依赖线程调度的契约测试（所有平台可跑）。
//
// 覆盖公开状态码与不透明块的尺寸/对齐：不透明块必须覆盖 pthread_mutex_t
// (64B)、pthread_cond_t (48B) 等平台对象，尺寸变化会让这里先失败，
// 而不是在运行期踩坏栈。
// ============================================================================

// 尺寸与状态码是跨平台契约，不调用平台原语，因此不需要 platform_ready 守卫。
test "不透明块尺寸与状态码" {
    $assert(sizeof(Mutex) == 64, "Mutex 必须覆盖三种平台的互斥对象")
    $assert(sizeof(Cond) == 48, "Cond 必须覆盖三种平台的条件变量")
    $assert(sizeof(Thread) == 16, "Thread = 8 字节句柄 + 4 字节状态 + 填充")
    $assert(STATUS_OK == 0, "成功为 0")
    $assert(STATUS_BUSY == 1, "忙为 1")
    $assert(STATUS_NOT_READY == 2, "未就绪为 2")
    $assert(STATUS_INVALID == -1, "无效为 -1")
}

// 空指针参数必须显式失败，而不是落进平台原语。
test "空指针参数被拒绝" {
    $assert(mutex_init(0) == STATUS_INVALID, "mutex_init 拒绝空指针")
    $assert(mutex_try_lock(0) == STATUS_INVALID, "mutex_try_lock 拒绝空指针")
    $assert(cond_init(0) == STATUS_INVALID, "cond_init 拒绝空指针")
    $assert(waitgroup_init(0) == STATUS_INVALID, "waitgroup_init 拒绝空指针")
    $assert(waitgroup_add(0, 1) == STATUS_INVALID, "waitgroup_add 拒绝空指针")
    $assert(once_init(0) == STATUS_INVALID, "once_init 拒绝空指针")
    let thread Thread
    $assert(thread_join(&thread) == STATUS_INVALID, "未创建的句柄不能 join")
    $assert(thread_detach(&thread) == STATUS_INVALID, "未创建的句柄不能 detach")
}
