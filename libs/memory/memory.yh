module memory;

// alloc 按字节数显式申请内存；申请失败返回空指针，零长度行为由运行时决定。
pub fn alloc(byte_count u64) *void {
    return malloc(byte_count);
}

// release 释放 alloc 返回的地址；允许传入空指针。
pub fn release(data *void) {
    if (data != 0) {
        free(data);
    }
}

// copy 复制指定字节数并返回目标地址；源与目标区域不得重叠。
pub fn copy(destination *void, source *void, byte_count u64) *void {
    return memcpy(destination, source, byte_count);
}
