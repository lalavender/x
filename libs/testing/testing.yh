module testing;

// ============================================================================
// testing.yh —— yh test 的最小运行时辅助接口
//
// 只提供 fail/skip 两个入口；基本断言请直接用 `$assert(cond[, msg])`。
// 记录协议与编译器内建 `__yh_test_assert` 一致：向 fd 3 写 72 字节
//   [0..3]   magic（'Y' 'H' 'T' 'F' 或 'Y' 'H' 'T' 'S'）
//   [4..7]   行号（int32，testing 辅助固定写 0）
//   [8..11]  列号（int32，固定写 0）
//   [12..71] 消息（NUL 填充，最长 60 字节）
// 随后 fail 以 1 退出、skip 以 0 退出；父进程据此判定 FAIL / SKIP。
// 本模块只依赖 prelude 的 write 与 exit，不 import os/io/string。
// ============================================================================

// __yh_test_record：写一条记录；kind 0 = 失败，1 = 跳过。
fn __yh_test_record(kind int, message *char) void {
    let rec [72]u8
    rec[0] = 89
    rec[1] = 72
    rec[2] = 84
    if (kind == 0) {
        rec[3] = 70
    } else {
        rec[3] = 83
    }
    let n int = 0
    let truncated int = 0
    for n < 60 {
        if (message[n] == 0) { break }
        if (n < 59) {
            rec[12 + n] = message[n].to_type(u8)
        } else {
            truncated = 1
        }
        n += 1
    }
    // 第 60 格（偏移 71）是截断标记：消息超过 59 字节时置 0x1e。
    if (truncated != 0) { rec[71] = 30 }
    write(3, (&rec[0]).to_type(*void), 72)
}

