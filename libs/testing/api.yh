module testing

// ============================================================================
// api.yh —— testing 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// fail：报告失败原因并结束当前用例（父进程记为 FAIL）。
pub fn fail(message *char) void {
    __yh_test_record(0, message)
    exit(1)
}

// skip：报告跳过原因并结束当前用例（父进程记为 SKIP）。
pub fn skip(reason *char) void {
    __yh_test_record(1, reason)
    exit(0)
}
