module libc

// libc 的字符串原语（L1 纯 yh 子集）。
//
// 导出函数都是 @[extern] 定义，符号名与 C 标准库一致；参数按 LP64 标准
// 原型（const char *、size_t 为 u64）声明，返回值保持 C 契约。
// 语义与 POSIX/C 一致的地方直接照做：
//   * strncpy 在源较短时用零补满 count 字节；
//   * strncat 最多追加 count 字节，并且总是补结尾 NUL；
//   * strchr/strrchr 也搜索结尾 NUL（strchr(s, '\0') 返回 s 的末尾）；
//   * strstr 的 needle 为空串时返回 haystack。
// 不处理 locale、不做边界检查、不设置 errno。

// byte_len 返回 NUL 结尾字节串的长度（不含 NUL），模块私有。
fn byte_len(text *u8) u64 {
    let index u64 = 0
    for text[index.to_type(int)] != 0 {
        index += 1
    }
    return index
}

// strcmp 按无符号字节比较两个 NUL 结尾字符串。
// 相等返回 0；否则返回首个不同字节的差（left - right），符号与 C 一致。
@[extern] pub fn strcmp(left *char, right *char) int {
    let a *u8 = left.to_type(*u8)
    let b *u8 = right.to_type(*u8)
    let index int = 0
    for 1 == 1 {
        let la u8 = a[index]
        let lb u8 = b[index]
        if (la != lb) {
            return la.to_type(int) - lb.to_type(int)
        }
        if (la == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// strncmp 最多比较 count 个字节；遇到 NUL 提前结束。
// 相等或前 count 字节相同返回 0；否则返回首个不同字节的差。
@[extern] pub fn strncmp(left *char, right *char, count u64) int {
    let a *u8 = left.to_type(*u8)
    let b *u8 = right.to_type(*u8)
    let index u64 = 0
    for index < count {
        let la u8 = a[index.to_type(int)]
        let lb u8 = b[index.to_type(int)]
        if (la != lb) {
            return la.to_type(int) - lb.to_type(int)
        }
        if (la == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// strcpy 把 source 连同结尾 NUL 复制到 destination，返回 destination。
// 不检查缓冲区大小；重叠内存请用 memmove。
@[extern] pub fn strcpy(destination *char, source *char) *char {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let index u64 = 0
    for 1 == 1 {
        let byte u8 = from[index.to_type(int)]
        dest[index.to_type(int)] = byte
        if (byte == 0) {
            return destination
        }
        index += 1
    }
    return destination
}

// strncpy 最多复制 count 字节；source 不足 count 时用零补满。
// 源长度达到 count 时结果不保证 NUL 结尾（与 C 一致）。
@[extern] pub fn strncpy(destination *char, source *char, count u64) *char {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let index u64 = 0
    for index < count && from[index.to_type(int)] != 0 {
        dest[index.to_type(int)] = from[index.to_type(int)]
        index += 1
    }
    for index < count {
        dest[index.to_type(int)] = 0
        index += 1
    }
    return destination
}

// strcat 把 source 追加到 NUL 结尾的 destination 之后，返回 destination。
// destination 必须可写且以 NUL 结尾；不检查容量，重叠时行为未定义。
@[extern] pub fn strcat(destination *char, source *char) *char {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let base u64 = byte_len(dest)
    let index u64 = 0
    for 1 == 1 {
        let byte u8 = from[index.to_type(int)]
        dest[(base + index).to_type(int)] = byte
        if (byte == 0) {
            return destination
        }
        index += 1
    }
    return destination
}

// strncat 在 destination 末尾最多追加 count 字节，并总是补结尾 NUL。
// destination 必须以 NUL 结尾；返回 destination。
@[extern] pub fn strncat(destination *char, source *char, count u64) *char {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let base u64 = byte_len(dest)
    let index u64 = 0
    for index < count && from[index.to_type(int)] != 0 {
        dest[(base + index).to_type(int)] = from[index.to_type(int)]
        index += 1
    }
    dest[(base + index).to_type(int)] = 0
    return destination
}

// strchr 返回 text 中第一个等于 (character & 0xff) 的字节地址。
// 结尾 NUL 也算匹配；没有匹配返回 NULL。
@[extern] pub fn strchr(text *char, character int) *char {
    let bytes *u8 = text.to_type(*u8)
    let target u8 = (character & 0xff).to_type(u8)
    let index int = 0
    for 1 == 1 {
        let byte u8 = bytes[index]
        if (byte == target) {
            return (bytes + index).to_type(*char)
        }
        if (byte == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// strrchr 返回 text 中最后一个匹配字节的地址；没有匹配返回 NULL。
// 结尾 NUL 也参与匹配，因此总能命中空串的结尾。
@[extern] pub fn strrchr(text *char, character int) *char {
    let bytes *u8 = text.to_type(*u8)
    let target u8 = (character & 0xff).to_type(u8)
    let found *u8 = 0
    let index int = 0
    for 1 == 1 {
        let byte u8 = bytes[index]
        if (byte == target) {
            found = bytes + index
        }
        if (byte == 0) {
            break
        }
        index += 1
    }
    if (found == 0) {
        return 0
    }
    return found.to_type(*char)
}

// strstr 返回 haystack 中第一个出现 needle 的地址；没有返回 NULL。
// needle 为空串时返回 haystack（与 C 一致）。朴素匹配，最坏 O(n*m)。
@[extern] pub fn strstr(haystack *char, needle *char) *char {
    let hay *u8 = haystack.to_type(*u8)
    let pin *u8 = needle.to_type(*u8)
    let needle_len u64 = byte_len(pin)
    if (needle_len == 0) {
        return haystack
    }
    let hay_len u64 = byte_len(hay)
    if (needle_len > hay_len) {
        return 0
    }
    let limit u64 = hay_len - needle_len
    let start u64 = 0
    for start <= limit {
        let index u64 = 0
        for index < needle_len {
            if (hay[(start + index).to_type(int)]
                != pin[index.to_type(int)]) {
                break
            }
            index += 1
        }
        if (index == needle_len) {
            return (hay + start.to_type(int)).to_type(*char)
        }
        start += 1
    }
    return 0
}

// strnlen 返回 NUL 结尾字符串的长度，但最多检查 max 个字节。
// 与 POSIX 一致：max 内没有 NUL 时返回 max。
@[extern] pub fn strnlen(text *char, max u64) u64 {
    let bytes *u8 = text.to_type(*u8)
    let index u64 = 0
    for index < max && bytes[index.to_type(int)] != 0 {
        index += 1
    }
    return index
}

// byte_in_set 判断字节是否出现在 NUL 结尾集合里（模块私有）。
fn byte_in_set(byte u8, set *u8) bool {
    let index int = 0
    for set[index] != 0 {
        if (set[index] == byte) {
            return true
        }
        index += 1
    }
    return false
}

// strspn 返回 text 开头连续属于 accept 集合的字节数。
// accept 为空集合时返回 0；遇到不在集合里的字节或 NUL 停止。
@[extern] pub fn strspn(text *char, accept *char) u64 {
    let bytes *u8 = text.to_type(*u8)
    let set *u8 = accept.to_type(*u8)
    let index u64 = 0
    for 1 == 1 {
        let byte u8 = bytes[index.to_type(int)]
        if (byte == 0 || byte_in_set(byte, set) == false) {
            break
        }
        index += 1
    }
    return index
}

// strcspn 返回 text 开头连续不属于 reject 集合的字节数。
// reject 为空集合时返回完整长度（与 C 的字符串长度一致）。
@[extern] pub fn strcspn(text *char, reject *char) u64 {
    let bytes *u8 = text.to_type(*u8)
    let set *u8 = reject.to_type(*u8)
    let index u64 = 0
    for 1 == 1 {
        let byte u8 = bytes[index.to_type(int)]
        if (byte == 0 || byte_in_set(byte, set)) {
            break
        }
        index += 1
    }
    return index
}

// strpbrk 返回 text 中第一个属于 accept 集合的字节地址；没有返回 NULL。
// 不匹配结尾 NUL（与 C 一致）。
@[extern] pub fn strpbrk(text *char, accept *char) *char {
    let bytes *u8 = text.to_type(*u8)
    let set *u8 = accept.to_type(*u8)
    let index int = 0
    for bytes[index] != 0 {
        if (byte_in_set(bytes[index], set)) {
            return (bytes + index).to_type(*char)
        }
        index += 1
    }
    return 0
}

// lower_byte 把 ASCII 大写字母转小写，其余字节原样返回（模块私有）。
fn lower_byte(byte u8) u8 {
    if (byte >= 65 && byte <= 90) {
        return (byte.to_type(int) + 32).to_type(u8)
    }
    return byte
}

// strcasecmp 按 ASCII 大小写不敏感比较两个 NUL 结尾字符串。
// 相等返回 0；否则返回小写化后首个不同字节的差；不处理 locale。
@[extern] pub fn strcasecmp(left *char, right *char) int {
    let a *u8 = left.to_type(*u8)
    let b *u8 = right.to_type(*u8)
    let index int = 0
    for 1 == 1 {
        let la u8 = lower_byte(a[index])
        let lb u8 = lower_byte(b[index])
        if (la != lb) {
            return la.to_type(int) - lb.to_type(int)
        }
        if (la == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// strncasecmp 最多比较 count 个字节（ASCII 大小写不敏感）。
// 相等或前 count 字节相同返回 0；否则返回小写化后首个不同字节的差。
@[extern] pub fn strncasecmp(left *char, right *char, count u64) int {
    let a *u8 = left.to_type(*u8)
    let b *u8 = right.to_type(*u8)
    let index u64 = 0
    for index < count {
        let la u8 = lower_byte(a[index.to_type(int)])
        let lb u8 = lower_byte(b[index.to_type(int)])
        if (la != lb) {
            return la.to_type(int) - lb.to_type(int)
        }
        if (la == 0) {
            return 0
        }
        index += 1
    }
    return 0
}

// strlcpy 把 source 最多 size-1 字节复制到 destination 并总是补 NUL（size > 0 时）。
// 返回 source 的完整长度（不含 NUL），因此返回值 >= size 表示发生了截断。
// size 为 0 时不写任何字节，只返回 source 长度。
@[extern] pub fn strlcpy(destination *char, source *char, size u64) u64 {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let total u64 = byte_len(from)
    if (size == 0) {
        return total
    }
    let limit u64 = size - 1
    let index u64 = 0
    for index < limit && from[index.to_type(int)] != 0 {
        dest[index.to_type(int)] = from[index.to_type(int)]
        index += 1
    }
    dest[index.to_type(int)] = 0
    return total
}

// strlcat 把 source 追加到 NUL 结尾的 destination，总长最多 size-1 字节并补 NUL。
// 返回“原 destination 长度 + source 长度”（不含 NUL），大于等于 size 表示截断。
// size 不大于原 destination 长度时不再追加，只返回该总长度。
@[extern] pub fn strlcat(destination *char, source *char, size u64) u64 {
    let dest *u8 = destination.to_type(*u8)
    let from *u8 = source.to_type(*u8)
    let base u64 = byte_len(dest)
    let added u64 = byte_len(from)
    if (size == 0) {
        return base + added
    }
    if (base >= size) {
        return base + added
    }
    let room u64 = size - 1 - base
    let index u64 = 0
    for index < room && from[index.to_type(int)] != 0 {
        dest[(base + index).to_type(int)] = from[index.to_type(int)]
        index += 1
    }
    dest[(base + index).to_type(int)] = 0
    return base + added
}
