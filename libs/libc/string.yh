module libc

// libc 的字符串原语（L1 纯 yh 子集）。
//
// 导出函数都是 @[extern] 定义，符号名与 C 标准库一致；参数按 LP64 标准
// 原型（const char *、size_t 为 u64）声明，返回值保持 C 契约。
// 语义与 POSIX/C 一致的地方直接照做：
//   * strncpy 在源较短时用零补满 count 字节；
//   * strncat 最多追加 count 字节，并且总是补结尾 NUL；
//   * strchr/strrchr 也搜索结尾 NUL（strchr(s, '\0') 返回 s 的末尾）；
//   * strstr 的 needle 为空串时返回 haystack。
// 不处理 locale、不做边界检查、不设置 errno。

// byte_len 返回 NUL 结尾字节串的长度（不含 NUL），模块私有。
fn byte_len(text *u8) u64 {
    let index u64 = 0
    for text[index.to_type(int)] != 0 {
        index += 1
    }
    return index
}

// byte_in_set 判断字节是否出现在 NUL 结尾集合里（模块私有）。
fn byte_in_set(byte u8, set *u8) bool {
    let index int = 0
    for set[index] != 0 {
        if (set[index] == byte) {
            return true
        }
        index += 1
    }
    return false
}

// lower_byte 把 ASCII 大写字母转小写，其余字节原样返回（模块私有）。
fn lower_byte(byte u8) u8 {
    if (byte >= 65 && byte <= 90) {
        return (byte.to_type(int) + 32).to_type(u8)
    }
    return byte
}

