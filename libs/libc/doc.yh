module libc;

// ============================================================================
// yh libc（L1 纯 yh 子集）API 参考
//
// 本文件只包含文档注释，不导出任何符号；实现位于同模块的
// memory.yh、string.yh、convert.yh。
//
// 定位：用 yh 实现与 C 标准库同名、同 ABI 的函数，全部带 @[extern]，
// 因此每个函数既是 yh 可 import 的普通函数，也是目标对象里的裸 C 符号。
// 目标是 Linux/AArch64 与 Darwin/ARM64 的 LP64 ABI：size_t 为 u64，
// int 为 i32，指针即目标指针。不分配、不读 errno、不依赖 yh 运行时，
// 模块对象没有未定义符号，可单独与 C 调用方链接。
//
// 已实现（C 符号名）：
//   memmove, memset, memcmp, memchr
//   strcmp, strncmp, strcpy, strncpy, strcat, strncat,
//   strchr, strrchr, strstr, strnlen, strspn, strcspn, strpbrk,
//   strcasecmp, strncasecmp, strlcpy, strlcat
//   atoi, atol, atoll, strtol, strtoul, abs, labs, llabs
//   qsort, bsearch
//
// 语义要点：
//   * 所有函数按无符号字节处理；不处理 locale、宽字符或编码。
//   * memmove 支持重叠；按地址先后选择前向/后向拷贝。
//   * memset/memchr 的 value 取低 8 位。
//   * strncpy 源较短时用零补满 count；源达到 count 时不保证 NUL。
//   * strncat 最多追加 count 字节且总是补 NUL；返回值都是目标指针。
//   * strchr/strrchr 也匹配结尾 NUL；strstr 的空 needle 返回 haystack。
//   * atoi/atol/strtol 跳过 ASCII 空白与一个符号；无数字返回 0 且 endptr
//     回填原指针；溢出饱和到 i32/i64 两端（C 标准此处是未定义行为，本实现
//     给出确定结果且不设置 errno）。
//   * strtol/strtoul 支持 2..36 进制与 base = 0 的前缀推断（0x/前导 0）；
//     非法 base 不转换并回填原指针；strtoul 的 '-' 按 2^64 取模。
//   * strcasecmp/strncasecmp 只折叠 ASCII 大小写，不处理 locale。
//   * strlcpy/strlcat 总是补 NUL（size > 0）并返回「源完整长度」/「两段长度」，
//     返回值 >= size 表示发生截断。
//   * abs/labs/llabs 对最小值是未定义行为（同 C）。
//   * qsort 用插入排序（稳定，O(1) 额外空间，最坏 O(n^2)）；bsearch 要求
//     已按同一比较函数排序。比较函数是 C ABI 回调：yh 调用方必须用
//     @[extern] 定义回调（编译器拒绝把普通 yh 函数当 C 回调实参），且当前
//     后端不支持函数指针与 0 比较，因此库内不做空回调检查。
//
// 尚未提供（原因见下）：
//   * memcpy、strlen：名字由编译器 prelude 登记（yh 运行时里有弱定义），
//     模块内不能重复声明；编译器侧没有符号别名/重命名属性。
//   * malloc、free、printf、exit、open/read/write/close 等：同样是 prelude
//     名字；分配器还需要与运行时成对的释放契约（L1.4）。
//   * errno/strerror：errno 需要每线程存储（编译器 L3 的 TLS），L1 不伪造
//     全局 errno，因此 strtol 溢出只饱和、不报 ERANGE。
//   * FILE*/stdio、qsort/bsearch 回调、TLS、动态链接：分别属于 L2–L5，
//     其中回调与变参还要等编译器 C ABI 的相应能力。
//
// 使用（yh 调用方）：
//   import libc;
//   let equal int = libc.strcmp("a", "b");
//
// 使用（C 调用方）：当前编译器还没有静态归档导出（L0.2），可以由 yh 项目
// 构建后在 .build/targets/<triple>/llvm/<opt>/obj/yh_libs-libc.o 取得模块
// 对象，再与 C 调用方直接链接；函数符号就是标准名（Mach-O 带 _ 前缀）。
// ============================================================================

// ----------------------------------------------------------------------------
// 1. 内存（memory.yh）
// ----------------------------------------------------------------------------
//
// void *memmove(void *destination, const void *source, size_t count)
//   复制 count 字节，允许重叠；返回 destination。
//
// void *memset(void *destination, int value, size_t count)
//   把 count 个字节写成 (value & 0xff)；返回 destination。
//
// int memcmp(const void *left, const void *right, size_t count)
//   按无符号字节比较；相等 0，否则返回首个不同字节的差（left - right）。
//
// void *memchr(const void *buffer, int value, size_t count)
//   在前 count 字节里找第一个等于 (value & 0xff) 的字节；返回地址或 NULL。
// pub fn memmove(destination *void, source *void, count u64) *void;
// pub fn memset(destination *void, value int, count u64) *void;
// pub fn memcmp(left *void, right *void, count u64) int;
// pub fn memchr(buffer *void, value int, count u64) *void;

// ----------------------------------------------------------------------------
// 2. 字符串（string.yh）
// ----------------------------------------------------------------------------
//
// int strcmp(const char *left, const char *right)
// int strncmp(const char *left, const char *right, size_t count)
//   按无符号字节比较；返回 0 或首个不同字节的差；strncmp 最多 count 字节。
//
// char *strcpy(char *destination, const char *source)
//   复制含 NUL；返回 destination。
//
// char *strncpy(char *destination, const char *source, size_t count)
//   最多 count 字节；源较短补零；源达到 count 时结果不保证 NUL。
//
// char *strcat(char *destination, const char *source)
// char *strncat(char *destination, const char *source, size_t count)
//   追加到 NUL 结尾的 destination；strncat 最多 count 字节且总是补 NUL。
//
// char *strchr(const char *text, int character)
// char *strrchr(const char *text, int character)
//   首个/最后一个匹配（含结尾 NUL）；没有返回 NULL。
//
// char *strstr(const char *haystack, const char *needle)
//   首个 needle 出现位置；空 needle 返回 haystack；没有返回 NULL。
//
// size_t strnlen(const char *text, size_t max)
//   最多检查 max 字节的长度；max 内没有 NUL 返回 max。
//
// size_t strspn(const char *text, const char *accept)
//   开头连续属于 accept 集合的字节数；accept 为空返回 0。
//
// size_t strcspn(const char *text, const char *reject)
//   开头连续不属于 reject 集合的字节数；reject 为空返回文本长度。
//
// char *strpbrk(const char *text, const char *accept)
//   首个属于 accept 的字节地址；没有返回 NULL（不匹配结尾 NUL）。
//
// int strcasecmp(const char *left, const char *right)
// int strncasecmp(const char *left, const char *right, size_t count)
//   按 ASCII 大小写不敏感比较；返回 0 或小写化后首个不同字节的差。
//
// size_t strlcpy(char *destination, const char *source, size_t size)
//   bounded 复制并总是补 NUL；返回 source 完整长度。
//
// size_t strlcat(char *destination, const char *source, size_t size)
//   bounded 追加并补 NUL；返回原 destination 长度 + source 长度。
// pub fn strcmp(left *char, right *char) int;
// pub fn strncmp(left *char, right *char, count u64) int;
// pub fn strcpy(destination *char, source *char) *char;
// pub fn strncpy(destination *char, source *char, count u64) *char;
// pub fn strcat(destination *char, source *char) *char;
// pub fn strncat(destination *char, source *char, count u64) *char;
// pub fn strchr(text *char, character int) *char;
// pub fn strrchr(text *char, character int) *char;
// pub fn strstr(haystack *char, needle *char) *char;
// pub fn strnlen(text *char, max u64) u64;
// pub fn strspn(text *char, accept *char) u64;
// pub fn strcspn(text *char, reject *char) u64;
// pub fn strpbrk(text *char, accept *char) *char;
// pub fn strcasecmp(left *char, right *char) int;
// pub fn strncasecmp(left *char, right *char, count u64) int;
// pub fn strlcpy(destination *char, source *char, size u64) u64;
// pub fn strlcat(destination *char, source *char, size u64) u64;

// ----------------------------------------------------------------------------
// 4. 排序与查找（sort.yh）
// ----------------------------------------------------------------------------
//
// void qsort(void *base, size_t count, size_t width,
//            int (*compare)(const void *, const void *))
//   就地按升序排序；count < 2 或 width == 0 无操作；compare 必须非空。
//
// void *bsearch(const void *key, const void *base, size_t count, size_t width,
//               int (*compare)(const void *, const void *))
//   在已排序区间二分查找，命中返回元素地址，否则 NULL。
// pub fn qsort(base *void, count u64, width u64,
//     compare fn(*void, *void) int) void;
// pub fn bsearch(key *void, base *void, count u64, width u64,
//     compare fn(*void, *void) int) *void;

// ----------------------------------------------------------------------------
// 3. 整数转换与绝对值（convert.yh）
// ----------------------------------------------------------------------------
//
// int atoi(const char *text)
//   十进制解析为 int；无数字返回 0；溢出饱和到 i32 两端，不设置 errno。
//
// long atol(const char *text)
// long long atoll(const char *text)
//   十进制解析为 i64；溢出饱和到 i64 两端，不设置 errno。
//
// long strtol(const char *text, char **end, int base)
//   base 为 0 时按前缀推断（0x 十六进制、前导 0 八进制），否则 2..36；
//   可带符号；无转换时 *end 回填 text；成功后 *end 指向首个未解析字节；
//   非法 base 不转换并回填原指针；溢出饱和到 i64 两端。
//
// unsigned long strtoul(const char *text, char **end, int base)
//   与 strtol 相同的 base/前缀/endptr 规则；返回 u64，溢出饱和到 UINT64_MAX，
//   前导 '-' 按 2^64 取模（"-1" → UINT64_MAX）。
//
// int abs(int value) / long labs(long value) / long long llabs(long long value)
//   返回绝对值；最小值不可表示（C 同为未定义）。
// pub fn atoi(text *char) int;
// pub fn atol(text *char) i64;
// pub fn atoll(text *char) i64;
// pub fn strtol(text *char, end **char, base int) i64;
// pub fn strtoul(text *char, end **char, base int) u64;
// pub fn abs(value int) int;
// pub fn labs(value i64) i64;
// pub fn llabs(value i64) i64;

// ============================================================================
