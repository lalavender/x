module libc

// libc 的整数转换与绝对值（L1 纯 yh 子集）。
//
// 提供 atoi/atol/atoll/strtol/strtoul 与 abs/labs/llabs：
//   * strtol/strtoul 支持 2..36 进制、base = 0 的前缀推断（0x/0X 十六进制、
//     前导 0 八进制）、可选符号与 endptr 回填；
//   * 溢出饱和到 i64/u64 两端（atoi 再饱和到 i32 两端）。C 标准对溢出是未定义
//     行为、并要求设置 errno(ERANGE)；本模块不设置 errno，因此饱和值为确定
//     结果，调用方不能依赖 errno 判断范围错误；
//   * strtoul 允许前导 '-'，按 C 规则对结果取模 2^64（"-1" → ULONG_MAX）；
//   * 非法 base（1 或 > 36）不做转换，返回 0 且 endptr 回填原指针；
//   * 只识别 ASCII 空白与数字，不处理 locale、千位分隔或 Unicode 数字；
//   * abs/labs/llabs 对最小值是未定义行为（同 C）。

// ScanResult 是一次整数扫描的中间结果：符号、已解析位数、结束位置与
// 溢出标志。magnitude 是绝对值（已按上限饱和），end_index 指向首个未解析
// 字节；digits == 0 表示没有做任何转换。结构体模块私有，不进入导出面。
struct ScanResult {
    negative int
    digits int
    end_index int
    magnitude u64
    overflow int
}

// is_space 判断 ASCII 空白（空格、\t、\n、\v、\f、\r）。
fn is_space(byte u8) bool {
    if (byte == 32 || byte == 9 || byte == 10) {
        return true
    }
    if (byte == 11 || byte == 12 || byte == 13) {
        return true
    }
    return false
}

// is_digit 判断 ASCII 十进制数字。
fn is_digit(byte u8) bool {
    return byte >= 48 && byte <= 57
}

// digit_value 返回字节在 36 进制下的数值；非字母数字返回 -1。
// '0'..'9' → 0..9，'a'..'z' / 'A'..'Z' → 10..35。
fn digit_value(byte u8) int {
    if (byte >= 48 && byte <= 57) {
        return byte.to_type(int) - 48
    }
    if (byte >= 97 && byte <= 122) {
        return byte.to_type(int) - 97 + 10
    }
    if (byte >= 65 && byte <= 90) {
        return byte.to_type(int) - 65 + 10
    }
    return -1
}

// scan_integer 扫描开头的整数并把结果放进 ScanResult。
// base 规则与 strtol 相同；signed_mode != 0 时按 i64 范围饱和（负方向上界
// 是 2^63），否则按 u64 范围饱和。大整数字面量必须先落到带类型的变量：
// 直接写进表达式会被当成 i32 静默截断（例如 0 - 9223372036854775807 - 1
// 会算成 0），所以上限全部用 u64 变量保存。
fn scan_integer(bytes *u8, base int, signed_mode int) ScanResult {
    let result ScanResult
    result.negative = 0
    result.digits = 0
    result.end_index = 0
    result.magnitude = 0
    result.overflow = 0
    let index int = 0
    for is_space(bytes[index]) {
        index += 1
    }
    if (bytes[index] == 45) {
        result.negative = 1
        index += 1
    } else if (bytes[index] == 43) {
        index += 1
    }
    let radix int = base
    if (radix == 0) {
        radix = 10
    }
    if (base == 0 || base == 16) {
        if (bytes[index] == 48
            && (bytes[index + 1] == 120 || bytes[index + 1] == 88)
            && digit_value(bytes[index + 2]) >= 0
            && digit_value(bytes[index + 2]) < 16) {
            index += 2
            radix = 16
        } else if (base == 0 && bytes[index] == 48) {
            radix = 8
        }
    }
    let top u64 = 18446744073709551615
    if (signed_mode != 0) {
        top = 9223372036854775807
        if (result.negative != 0) {
            top = top + 1
        }
    }
    for 1 == 1 {
        let digit int = digit_value(bytes[index])
        if (digit < 0 || digit >= radix) {
            break
        }
        result.digits += 1
        if (result.overflow == 0) {
            let wide u64 = digit.to_type(u64)
            let scale u64 = radix.to_type(u64)
            if (result.magnitude > (top - wide) / scale) {
                result.overflow = 1
                result.magnitude = top
            } else {
                result.magnitude = result.magnitude * scale + wide
            }
        }
        index += 1
    }
    // 没有数字时 end_of_scan 直接回填原指针，end_index 保持 0 即可。
    if (result.digits > 0) {
        result.end_index = index
    }
    return result
}

// end_of_scan 计算 endptr 应回填的值：无转换时是 text 原文，否则指向
// 第一个未解析字节。调用方保证 end 非空时才使用。
fn end_of_scan(text *char, scan ScanResult) *char {
    if (scan.digits == 0) {
        return text
    }
    // 先落成 *u8 局部变量再相加：当前编译器不接受“指针 to_type 后直接参与
    // 算术再整体 to_type”的链式表达式（内部错误），拆开与其它文件写法一致。
    let bytes *u8 = text.to_type(*u8)
    let offset int = scan.end_index
    return (bytes + offset).to_type(*char)
}

// strtol 按 base 解析开头的整数，返回 i64 并按 C 契约回填 endptr。
// base 为 0 时按前缀推断：0x 十六进制、前导 0 八进制、其余十进制；
// base 为 16 时也接受 0x 前缀。endptr 为 NULL 时忽略。
// 无数字时不转换，endptr 回填 text 本身；溢出饱和到 i64 两端。
@[extern] pub fn strtol(text *char, end **char, base int) i64 {
    if (base != 0 && (base < 2 || base > 36)) {
        if (end != 0) {
            end[0] = text
        }
        return 0
    }
    let scan ScanResult = scan_integer(text.to_type(*u8), base, 1)
    if (end != 0) {
        end[0] = end_of_scan(text, scan)
    }
    if (scan.digits == 0) {
        return 0
    }
    let magnitude_limit u64 = 9223372036854775807
    if (scan.negative != 0) {
        if (scan.overflow != 0 || scan.magnitude > magnitude_limit) {
            let minimum i64 = 0 - magnitude_limit.to_type(i64) - 1
            return minimum
        }
        return (0 - scan.magnitude).to_type(i64)
    }
    return scan.magnitude.to_type(i64)
}

// strtoul 按 base 解析开头的整数，返回 u64 并按 C 契约回填 endptr。
// 允许前导 '-'：结果按 C 规则对 2^64 取模（"-1" → 18446744073709551615）。
// 溢出饱和到 u64 最大值；无数字返回 0 且 endptr 回填 text 本身。
@[extern] pub fn strtoul(text *char, end **char, base int) u64 {
    if (base != 0 && (base < 2 || base > 36)) {
        if (end != 0) {
            end[0] = text
        }
        return 0
    }
    let scan ScanResult = scan_integer(text.to_type(*u8), base, 0)
    if (end != 0) {
        end[0] = end_of_scan(text, scan)
    }
    if (scan.digits == 0) {
        return 0
    }
    if (scan.negative != 0) {
        return 0 - scan.magnitude
    }
    return scan.magnitude
}

// atol 按十进制解析为 i64；溢出饱和到 i64 两端，不设置 errno。
@[extern] pub fn atol(text *char) i64 {
    return strtol(text, 0, 10)
}

// atoll 与 atol 相同：LP64 下 long 与 long long 都是 64 位。
@[extern] pub fn atoll(text *char) i64 {
    return strtol(text, 0, 10)
}

// atoi 按十进制解析为 int；溢出饱和到 i32 两端，不设置 errno。
// 无数字返回 0；跳过前导 ASCII 空白与一个可选 '+'/'-'。
@[extern] pub fn atoi(text *char) int {
    let value i64 = strtol(text, 0, 10)
    // i32 边界同样先落到 i64 变量，避免字面量在表达式里按 i32 截断。
    let high i64 = 2147483647
    let low i64 = 0 - high - 1
    if (value > high) {
        return high.to_type(int)
    }
    if (value < low) {
        return low.to_type(int)
    }
    return value.to_type(int)
}

// abs 返回 int 的绝对值；INT_MIN 的绝对值不可表示（C 未定义）。
@[extern] pub fn abs(value int) int {
    if (value < 0) {
        return 0 - value
    }
    return value
}

// labs 返回 i64 的绝对值；LONG_MIN 的绝对值不可表示（C 未定义）。
@[extern] pub fn labs(value i64) i64 {
    if (value < 0) {
        return 0 - value
    }
    return value
}

// llabs 与 labs 相同：LP64 下 long 与 long long 都是 64 位。
@[extern] pub fn llabs(value i64) i64 {
    if (value < 0) {
        return 0 - value
    }
    return value
}
