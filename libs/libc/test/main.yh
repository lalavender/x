module main

import libc

fn expect(condition bool, code int) int {
    if (condition == false) {
        printf("FAIL %d\n", code)
        return 1
    }
    return 0
}

fn memory_tests() int {
    let source [8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    let forward [8]u8
    libc.memmove((&forward[0]).to_type(*void), (&source[0]).to_type(*void), 8)
    if (expect(forward[0] == 1 && forward[7] == 8, 1) != 0) { return 1 }
    let overlap [8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    // 向右重叠：应得到 1,1,2,3,4,5,6,7
    libc.memmove((&overlap[1]).to_type(*void), (&overlap[0]).to_type(*void), 7)
    if (expect(overlap[1] == 1 && overlap[2] == 2 && overlap[7] == 7, 2) != 0) {
        return 2
    }
    let left_overlap [8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    // 向左重叠：应得到 2,3,4,5,6,7,8,8
    libc.memmove((&left_overlap[0]).to_type(*void), (&left_overlap[1]).to_type(*void), 7)
    if (expect(left_overlap[0] == 2 && left_overlap[6] == 8, 3) != 0) {
        return 3
    }
    let filled [4]u8 = [0, 0, 0, 0]
    libc.memset((&filled[0]).to_type(*void), 0x1ff, 4)
    if (expect(filled[0] == 255 && filled[3] == 255, 4) != 0) { return 4 }
    let a [3]u8 = [1, 2, 3]
    let b [3]u8 = [1, 2, 4]
    let small int = libc.memcmp((&a[0]).to_type(*void), (&b[0]).to_type(*void), 3)
    let equal int = libc.memcmp((&a[0]).to_type(*void), (&a[0]).to_type(*void), 3)
    if (expect(small < 0 && equal == 0, 5) != 0) { return 5 }
    let text [4]u8 = [65, 66, 67, 0]
    let hit *void = libc.memchr((&text[0]).to_type(*void), 66, 4)
    let miss *void = libc.memchr((&text[0]).to_type(*void), 90, 4)
    let at_nul *void = libc.memchr((&text[0]).to_type(*void), 0, 4)
    if (expect(hit == (&text[1]).to_type(*void) && miss == 0
        && at_nul == (&text[3]).to_type(*void), 6) != 0) {
        return 6
    }
    return 0
}

fn string_tests() int {
    if (expect(libc.strcmp("abc", "abc") == 0, 10) != 0) { return 10 }
    if (expect(libc.strcmp("abc", "abd") < 0, 11) != 0) { return 11 }
    if (expect(libc.strcmp("abd", "abc") > 0, 12) != 0) { return 12 }
    // 无符号比较：0x80 大于 'a'
    let high [2]u8 = [128, 0]
    if (expect(libc.strcmp((&high[0]).to_type(*char), "a") > 0, 13) != 0) {
        return 13
    }
    if (expect(libc.strncmp("abcdef", "abcxyz", 3) == 0, 14) != 0) { return 14 }
    if (expect(libc.strncmp("abc", "abd", 3) < 0, 15) != 0) { return 15 }
    let target [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
    let copied *char = libc.strcpy((&target[0]).to_type(*char), "hi")
    if (expect(copied == (&target[0]).to_type(*char) && target[0] == 104
        && target[1] == 105 && target[2] == 0, 16) != 0) {
        return 16
    }
    let padded [6]u8 = [9, 9, 9, 9, 9, 9]
    libc.strncpy((&padded[0]).to_type(*char), "ab", 5)
    if (expect(padded[0] == 97 && padded[1] == 98 && padded[2] == 0
        && padded[4] == 0, 17) != 0) {
        return 17
    }
    let exact [3]u8 = [0, 0, 0]
    libc.strncpy((&exact[0]).to_type(*char), "abc", 3)
    if (expect(exact[0] == 97 && exact[2] == 99, 18) != 0) { return 18 }
    let joined [8]u8 = [104, 105, 0, 0, 0, 0, 0, 0]
    libc.strcat((&joined[0]).to_type(*char), "!")
    if (expect(joined[2] == 33 && joined[3] == 0, 19) != 0) { return 19 }
    let limited [8]u8 = [104, 105, 0, 0, 0, 0, 0, 0]
    libc.strncat((&limited[0]).to_type(*char), "world", 2)
    if (expect(limited[2] == 119 && limited[3] == 111 && limited[4] == 0, 20) != 0) {
        return 20
    }
    let located *char = libc.strchr("a/b/c", 47)
    if (expect(located != 0 && located[0] == 47 && located[2] == 47, 21) != 0) {
        return 21
    }
    let last *char = libc.strrchr("a/b/c", 47)
    if (expect(last != 0 && last[1] == 99, 22) != 0) { return 22 }
    let nul_hit *char = libc.strchr("abc", 0)
    if (expect(nul_hit != 0 && nul_hit[0] == 0, 23) != 0) { return 23 }
    let found *char = libc.strstr("hello world", "world")
    if (expect(found != 0 && found[0] == 119, 24) != 0) { return 24 }
    let none *char = libc.strstr("hello", "xyz")
    if (expect(none == 0, 25) != 0) { return 25 }
    let empty_needle *char = libc.strstr("hello", "")
    if (expect(empty_needle != 0 && empty_needle[0] == 104, 26) != 0) {
        return 26
    }
    if (expect(libc.strnlen("abcdef", 3) == 3, 27) != 0) { return 27 }
    if (expect(libc.strnlen("ab", 5) == 2, 28) != 0) { return 28 }
    return 0
}

struct Pair {
    key int
    value int
}

// C ABI 回调必须显式 extern：qsort/bsearch 是 C ABI 入口。
@[extern] fn cmp_int(left *void, right *void) int {
    let a *int = left.to_type(*int)
    let b *int = right.to_type(*int)
    if (a[0] < b[0]) { return -1 }
    if (a[0] > b[0]) { return 1 }
    return 0
}

@[extern] fn cmp_pair(left *void, right *void) int {
    let a *Pair = left.to_type(*Pair)
    let b *Pair = right.to_type(*Pair)
    if (a.key < b.key) { return -1 }
    if (a.key > b.key) { return 1 }
    return 0
}

fn sort_tests() int {
    let values [6]int = [9, 2, 7, 1, 5, 3]
    libc.qsort((&values[0]).to_type(*void), 6, 4, cmp_int)
    let sorted int = (values[0] == 1 && values[1] == 2 && values[2] == 3
        && values[3] == 5 && values[4] == 7 && values[5] == 9)
    if (expect(sorted == 1, 80) != 0) { return 80 }
    let key int = 5
    let hit *void = libc.bsearch((&key).to_type(*void),
        (&values[0]).to_type(*void), 6, 4, cmp_int)
    if (expect(hit != 0, 81) != 0) { return 81 }
    let found *int = hit.to_type(*int)
    if (expect(found[0] == 5, 82) != 0) { return 82 }
    let absent int = 42
    let miss *void = libc.bsearch((&absent).to_type(*void),
        (&values[0]).to_type(*void), 6, 4, cmp_int)
    if (expect(miss == 0, 83) != 0) { return 83 }
    // 空集合与单元素：不崩溃、返回正确结果。
    let single [1]int = [7]
    libc.qsort((&single[0]).to_type(*void), 1, 4, cmp_int)
    let hit_single *void = libc.bsearch((&single[0]).to_type(*void),
        (&single[0]).to_type(*void), 1, 4, cmp_int)
    if (expect(hit_single != 0 && single[0] == 7, 84) != 0) { return 84 }
    // 结构体按 8 字节步长排序。
    let pairs [3]Pair = [Pair{key: 2, value: 20}, Pair{key: 1, value: 10},
        Pair{key: 3, value: 30}]
    libc.qsort((&pairs[0]).to_type(*void), 3, 8, cmp_pair)
    if (expect(pairs[0].key == 1 && pairs[2].value == 30, 85) != 0) {
        return 85
    }
    let wanted Pair
    wanted.key = 3
    wanted.value = 0
    let pair_hit *void = libc.bsearch((&wanted).to_type(*void),
        (&pairs[0]).to_type(*void), 3, 8, cmp_pair)
    if (expect(pair_hit != 0, 86) != 0) { return 86 }
    let pair_found *Pair = pair_hit.to_type(*Pair)
    if (expect(pair_found.value == 30, 87) != 0) { return 87 }
    return 0
}

fn bounded_copy_tests() int {
    let buffer [8]u8
    let full u64 = libc.strlcpy((&buffer[0]).to_type(*char), "hello", 8)
    if (expect(full == 5 && buffer[0] == 104 && buffer[4] == 111
        && buffer[5] == 0, 90) != 0) {
        return 90
    }
    let cut u64 = libc.strlcpy((&buffer[0]).to_type(*char), "truncate", 4)
    if (expect(cut == 8 && buffer[0] == 116 && buffer[3] == 0, 91) != 0) {
        return 91
    }
    let untouched [4]u8 = [65, 66, 67, 0]
    let size_zero u64 = libc.strlcpy((&untouched[0]).to_type(*char),
        "xyz", 0)
    if (expect(size_zero == 3 && untouched[0] == 65, 92) != 0) { return 92 }
    let joined [8]u8 = [97, 98, 0, 0, 0, 0, 0, 0]
    let appended u64 = libc.strlcat((&joined[0]).to_type(*char), "cd", 8)
    if (expect(appended == 4 && joined[2] == 99 && joined[4] == 0, 93) != 0) {
        return 93
    }
    let tight [4]u8 = [97, 98, 0, 0]
    let clipped u64 = libc.strlcat((&tight[0]).to_type(*char), "cd", 3)
    if (expect(clipped == 4 && tight[2] == 0, 94) != 0) { return 94 }
    let no_room u64 = libc.strlcat((&tight[0]).to_type(*char), "cd", 2)
    if (expect(no_room == 4 && tight[0] == 97, 95) != 0) { return 95 }
    return 0
}

fn case_tests() int {
    if (expect(libc.strcasecmp("AbC", "aBc") == 0, 70) != 0) { return 70 }
    if (expect(libc.strcasecmp("abc", "ABD") < 0, 71) != 0) { return 71 }
    if (expect(libc.strcasecmp("", "") == 0, 72) != 0) { return 72 }
    if (expect(libc.strncasecmp("aBcD", "abX", 2) == 0, 73) != 0) { return 73 }
    if (expect(libc.strncasecmp("aBcD", "abX", 3) < 0, 74) != 0) { return 74 }
    if (expect(libc.strncasecmp("abc", "abd", 0) == 0, 75) != 0) { return 75 }
    return 0
}

fn set_tests() int {
    if (expect(libc.strspn("abcabc", "abc") == 6, 40) != 0) { return 40 }
    if (expect(libc.strspn("abcx", "abc") == 3, 41) != 0) { return 41 }
    if (expect(libc.strspn("abc", "") == 0, 42) != 0) { return 42 }
    if (expect(libc.strcspn("abcx", "x") == 3, 43) != 0) { return 43 }
    if (expect(libc.strcspn("abc", "xyz") == 3, 44) != 0) { return 44 }
    if (expect(libc.strcspn("abc", "") == 3, 45) != 0) { return 45 }
    let hit *char = libc.strpbrk("hello", "lo")
    if (expect(hit != 0 && hit[0] == 108, 46) != 0) { return 46 }
    let miss *char = libc.strpbrk("hello", "xyz")
    if (expect(miss == 0, 47) != 0) { return 47 }
    let empty *char = libc.strpbrk("hello", "")
    if (expect(empty == 0, 48) != 0) { return 48 }
    return 0
}

fn convert_tests() int {
    let negative int = libc.atoi("  -42xyz")
    let positive int = libc.atoi("+7")
    let none int = libc.atoi("abc")
    let zero int = libc.atoi("0")
    let high int = libc.atoi("99999999999999999999")
    let low int = libc.atoi("-99999999999999999999")
    printf("atoi: %d %d %d %d %d %d\n", negative, positive, none, zero, high, low)
    if (expect(negative == -42 && positive == 7 && none == 0 && zero == 0, 30) != 0) {
        return 30
    }
    if (expect(high == 2147483647 && low == -2147483647 - 1, 31) != 0) {
        return 31
    }
    return 0
}

fn strtol_tests() int {
    let rest *char = 0
    let hex i64 = libc.strtol("  -0x1fz", &rest, 0)
    if (expect(hex == -31 && rest != 0 && rest[0] == 122, 50) != 0) {
        return 50
    }
    let dec i64 = libc.strtol("42abc", &rest, 10)
    if (expect(dec == 42 && rest[0] == 97, 51) != 0) { return 51 }
    let binary i64 = libc.strtol("1012", &rest, 2)
    if (expect(binary == 5 && rest[0] == 50, 52) != 0) { return 52 }
    let octal i64 = libc.strtol("0755", &rest, 0)
    if (expect(octal == 493, 53) != 0) { return 53 }
    let zero i64 = libc.strtol("0", &rest, 0)
    if (expect(zero == 0 && rest[0] == 0, 54) != 0) { return 54 }
    let none i64 = libc.strtol("  +xy", &rest, 10)
    // 无数字时 C 要求 endptr 回填原指针（这里是开头的空格），不是 '+'。
    if (expect(none == 0 && rest[0] == 32, 55) != 0) { return 55 }
    let bad_base i64 = libc.strtol("42", &rest, 1)
    if (expect(bad_base == 0 && rest[0] == 52, 56) != 0) { return 56 }
    let wide_limit i64 = 9223372036854775807
    let wide_min i64 = 0 - wide_limit - 1
    let high i64 = libc.strtol("9223372036854775808", &rest, 10)
    if (expect(high == wide_limit, 57) != 0) { return 57 }
    let low i64 = libc.strtol("-9223372036854775809", &rest, 10)
    if (expect(low == wide_min, 58) != 0) { return 58 }
    let exact_low i64 = libc.strtol("-9223372036854775808", &rest, 10)
    if (expect(exact_low == wide_min, 59) != 0) {
        return 59
    }
    let base16 i64 = libc.strtol("ff", &rest, 16)
    if (expect(base16 == 255, 60) != 0) { return 60 }
    let unsigned_max u64 = 18446744073709551615
    let unsigned_hex u64 = libc.strtoul("0xffffffffffffffff", &rest, 16)
    if (expect(unsigned_hex == unsigned_max, 66) != 0) { return 66 }
    let unsigned_wrap u64 = libc.strtoul("-1", &rest, 10)
    if (expect(unsigned_wrap == unsigned_max, 67) != 0) { return 67 }
    let unsigned_high u64 = libc.strtoul("18446744073709551616", &rest, 10)
    if (expect(unsigned_high == unsigned_max, 68) != 0) { return 68 }
    let unsigned_plain u64 = libc.strtoul("42", &rest, 10)
    if (expect(unsigned_plain == 42, 69) != 0) { return 69 }
    if (expect(libc.atol("  -123") == -123, 61) != 0) { return 61 }
    if (expect(libc.abs(-5) == 5 && libc.abs(5) == 5, 62) != 0) { return 62 }
    if (expect(libc.labs(0 - 9) == 9, 63) != 0) { return 63 }
    if (expect(libc.llabs(0 - 9) == 9, 64) != 0) { return 64 }
    if (expect(libc.atoll("  -77") == -77, 76) != 0) { return 76 }
    return 0
}

pub fn main() int {
    let code int = memory_tests()
    if (code != 0) { return code }
    code = string_tests()
    if (code != 0) { return code }
    code = set_tests()
    if (code != 0) { return code }
    code = case_tests()
    if (code != 0) { return code }
    code = sort_tests()
    if (code != 0) { return code }
    code = bounded_copy_tests()
    if (code != 0) { return code }
    code = strtol_tests()
    if (code != 0) { return code }
    code = convert_tests()
    if (code != 0) { return code }
    code = convert_tests()
    if (code != 0) { return code }
    printf("libc l1 ok\n")
    return 0
}
