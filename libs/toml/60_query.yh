module toml

// yh TOML 标准库：只读查询与类型化取值。
//
// 查询不分配、不打印、不退出；失败返回空视图或错误状态，并且不修改 out
// 参数。get 的键名是字面键（点号属于键内容），嵌套表需要多次查询。

// node_of 从 Value 句柄取节点；空视图返回空指针。
fn node_of(value Value) *node {
    if (value.handle == 0) {
        return 0
    }
    return value.handle.to_type(*node)
}

// value_of 把节点指针包装为 Value；空指针得到空视图。
fn value_of(ptr *node) Value {
    let value Value
    if (ptr == 0) {
        value.handle = 0
    } else {
        value.handle = ptr.to_type(*void)
    }
    return value
}

// kind 返回值的类型；空视图返回 kind_invalid。
pub fn kind(value Value) ValueKind {
    let ptr *node = node_of(value)
    if (ptr == 0) {
        return ValueKind.kind_invalid
    }
    return ptr.kind
}

// span_of_value 返回值、表头或隐式表创建来源的位置；空视图返回零位置。
pub fn value_span(value Value) Span {
    let ptr *node = node_of(value)
    if (ptr == 0) {
        return span_zero()
    }
    return ptr.span
}

// table_get 按完整字节键查询表；点号是键内容。
pub fn table_get(table_value Value, key Text) LookupResult {
    let result LookupResult
    result.status = QueryStatus.query_type_error
    result.value = value_of(0)
    let ptr *node = node_of(table_value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_table) {
        return result
    }
    let idx int = table_find(ptr.data.tbl, key)
    if (idx < 0) {
        result.status = QueryStatus.query_missing
        return result
    }
    let entry_ptr *entry = table_entry_of(ptr.data.tbl, idx)
    result.status = QueryStatus.query_ok
    result.value = value_of(entry_ptr.value.to_type(*node))
    return result
}

// get 是 NUL 结尾键的便捷入口；空指针返回参数错误，空字符串是合法键。
pub fn get(table_value Value, key *char) LookupResult {
    let result LookupResult
    result.status = QueryStatus.query_argument_error
    result.value = value_of(0)
    if (key == 0) {
        return result
    }
    return table_get(table_value, text_from_cstr(key))
}

// array_get 按零基下标取数组元素。
pub fn array_get(array_value Value, index u64) LookupResult {
    let result LookupResult
    result.status = QueryStatus.query_type_error
    result.value = value_of(0)
    let ptr *node = node_of(array_value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_array) {
        return result
    }
    if (index >= ptr.data.array.count.to_type(u64)) {
        result.status = QueryStatus.query_bounds_error
        return result
    }
    result.status = QueryStatus.query_ok
    result.value = value_of(items_get(ptr.data.array, index.to_type(int)))
    return result
}

// count 返回数组元素数或表条目数；标量返回类型错误。
pub fn count(container Value, out *u64) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(container)
    if (ptr == 0) {
        return QueryStatus.query_type_error
    }
    if (ptr.kind == ValueKind.kind_array) {
        out[0] = ptr.data.array.count.to_type(u64)
        return QueryStatus.query_ok
    }
    if (ptr.kind == ValueKind.kind_table) {
        out[0] = ptr.data.tbl.count.to_type(u64)
        return QueryStatus.query_ok
    }
    return QueryStatus.query_type_error
}

// table_entry 按首次引入顺序返回表条目；越界返回 bounds_error。
pub fn table_entry(table_value Value, index u64) EntryResult {
    let result EntryResult
    result.status = QueryStatus.query_type_error
    result.key = text_empty()
    result.value = value_of(0)
    result.span = span_zero()
    let ptr *node = node_of(table_value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_table) {
        return result
    }
    if (index >= ptr.data.tbl.count.to_type(u64)) {
        result.status = QueryStatus.query_bounds_error
        return result
    }
    let entry_ptr *entry = table_entry_of(ptr.data.tbl, index.to_type(int))
    result.status = QueryStatus.query_ok
    result.key = entry_ptr.key
    result.value = value_of(entry_ptr.value.to_type(*node))
    result.span = entry_ptr.span
    return result
}

// as_text 只接受字符串；成功时写入借用视图。
pub fn as_text(value Value, out *Text) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_string) {
        return QueryStatus.query_type_error
    }
    out[0] = ptr.data.text
    return QueryStatus.query_ok
}

// as_i64 只接受整数，不转换浮点或数字字符串。
pub fn as_i64(value Value, out *i64) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_integer) {
        return QueryStatus.query_type_error
    }
    out[0] = ptr.data.integer
    return QueryStatus.query_ok
}

// as_f64 只接受浮点，不隐式提升整数。
pub fn as_f64(value Value, out *f64) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_float) {
        return QueryStatus.query_type_error
    }
    out[0] = ptr.data.real
    return QueryStatus.query_ok
}

// as_bool 只接受布尔。
pub fn as_bool(value Value, out *bool) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(value)
    if (ptr == 0 || ptr.kind != ValueKind.kind_boolean) {
        return QueryStatus.query_type_error
    }
    out[0] = ptr.data.boolean
    return QueryStatus.query_ok
}

// as_temporal 只接受四种日期时间类型，返回已验证的原始文本。
pub fn as_temporal(value Value, out *Text) QueryStatus {
    if (out == 0) {
        return QueryStatus.query_argument_error
    }
    let ptr *node = node_of(value)
    if (ptr == 0) {
        return QueryStatus.query_type_error
    }
    if (ptr.kind == ValueKind.kind_offset_datetime
        || ptr.kind == ValueKind.kind_local_datetime
        || ptr.kind == ValueKind.kind_local_date
        || ptr.kind == ValueKind.kind_local_time) {
        out[0] = ptr.data.text
        return QueryStatus.query_ok
    }
    return QueryStatus.query_type_error
}
