module toml

// yh TOML 标准库：四种日期时间字面量的扫描与值验证。
//
// TOML 1.1 的 local-time 允许省略秒；秒可以到 60（RFC 3339 闰秒）。本库保留
// 原始文本、不强制转换为 Unix 时间，也不赋予本地时间隐式时区。扫描只返回
// 类型与结束位置，解析器负责把原文复制进文档池。

const DT_OK int = 0
const DT_SYNTAX int = 1
const DT_VALUE int = 2

// dt_result 是日期时间扫描结果；kind 为四种时间 ValueKind 之一。
struct dt_result {
    status int
    end u64
    kind ValueKind
}

// two_digits 读取两位十进制数字；越界或非数字返回 -1。
fn two_digits(data *u8, count u64, pos u64) int {
    if (pos + 2 > count) {
        return -1
    }
    if (data[pos] < '0' || data[pos] > '9'
        || data[pos + 1] < '0' || data[pos + 1] > '9') {
        return -1
    }
    return ((data[pos] - '0').to_type(int) * 10
        + (data[pos + 1] - '0').to_type(int))
}

// four_digits 读取四位十进制数字；越界或非数字返回 -1。
fn four_digits(data *u8, count u64, pos u64) int {
    if (pos + 4 > count) {
        return -1
    }
    let value int = 0
    let i u64 = 0
    for i < 4 {
        let b u8 = data[pos + i]
        if (b < '0' || b > '9') {
            return -1
        }
        value = value * 10 + (b - '0').to_type(int)
        i += 1
    }
    return value
}

// is_leap_year 判断公历闰年。
fn is_leap_year(year int) int {
    if (year % 400 == 0) {
        return 1
    }
    if (year % 100 == 0) {
        return 0
    }
    if (year % 4 == 0) {
        return 1
    }
    return 0
}

// days_in_month 返回指定年月的天数；非法月份返回 0。
fn days_in_month(year int, month int) int {
    if (month == 1 || month == 3 || month == 5 || month == 7
        || month == 8 || month == 10 || month == 12) {
        return 31
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30
    }
    if (month == 2) {
        if (is_leap_year(year) != 0) {
            return 29
        }
        return 28
    }
    return 0
}

// scan_date 校验并跳过完整日期 YYYY-MM-DD；成功返回结束位置，失败返回 0。
fn scan_date(data *u8, count u64, start u64, result *dt_result) u64 {
    let year int = four_digits(data, count, start)
    if (year < 0 || start + 5 > count || data[start + 4] != '-') {
        result[0].status = DT_SYNTAX
        return 0
    }
    let month int = two_digits(data, count, start + 5)
    if (month < 0 || start + 8 > count || data[start + 7] != '-') {
        result[0].status = DT_SYNTAX
        return 0
    }
    let day int = two_digits(data, count, start + 8)
    if (day < 0) {
        result[0].status = DT_SYNTAX
        return 0
    }
    if (month < 1 || month > 12) {
        result[0].status = DT_VALUE
        return 0
    }
    if (day < 1 || day > days_in_month(year, month)) {
        result[0].status = DT_VALUE
        return 0
    }
    return start + 10
}

// scan_time 校验并跳过 HH:MM[：SS[.fraction]]；成功返回结束位置，失败返回 0。
fn scan_time(data *u8, count u64, start u64, result *dt_result) u64 {
    let hour int = two_digits(data, count, start)
    if (hour < 0 || start + 3 > count || data[start + 2] != ':') {
        result[0].status = DT_SYNTAX
        return 0
    }
    let minute int = two_digits(data, count, start + 3)
    if (minute < 0) {
        result[0].status = DT_SYNTAX
        return 0
    }
    if (hour > 23) {
        result[0].status = DT_VALUE
        return 0
    }
    if (minute > 59) {
        result[0].status = DT_VALUE
        return 0
    }
    let pos u64 = start + 5
    if (pos < count && data[pos] == ':') {
        let second int = two_digits(data, count, pos + 1)
        if (second < 0) {
            result[0].status = DT_SYNTAX
            return 0
        }
        if (second > 60) {
            result[0].status = DT_VALUE
            return 0
        }
        pos += 3
        if (pos < count && data[pos] == '.') {
            let frac_start u64 = pos + 1
            let frac_end u64 = frac_start
            for frac_end < count && data[frac_end] >= '0' && data[frac_end] <= '9' {
                frac_end += 1
            }
            if (frac_end == frac_start) {
                result[0].status = DT_SYNTAX
                return 0
            }
            pos = frac_end
        }
    }
    return pos
}

// scan_offset 校验并跳过 Z/z 或 ±HH:MM；成功返回结束位置，失败返回 0。
fn scan_offset(data *u8, count u64, start u64, result *dt_result) u64 {
    if (start >= count) {
        return start
    }
    let b u8 = data[start]
    if (b == 'Z' || b == 'z') {
        return start + 1
    }
    if (b != '+' && b != '-') {
        return start
    }
    let hour int = two_digits(data, count, start + 1)
    if (hour < 0 || start + 6 > count || data[start + 3] != ':') {
        result[0].status = DT_SYNTAX
        return 0
    }
    let minute int = two_digits(data, count, start + 4)
    if (minute < 0) {
        result[0].status = DT_SYNTAX
        return 0
    }
    if (hour > 23 || minute > 59) {
        result[0].status = DT_VALUE
        return 0
    }
    return start + 6
}

// datetime_scan 扫描一个日期时间字面量。调用方应先用首字符模式判断；
// 本函数也自行校验 YYYY-MM-DD / HH:MM 形态。
fn datetime_scan(data *u8, count u64, start u64) dt_result {
    let result dt_result
    result.status = DT_SYNTAX
    result.end = start
    result.kind = ValueKind.kind_invalid

    // 纯时间：HH:MM...
    if (start + 2 < count && data[start + 2] == ':') {
        let end u64 = scan_time(data, count, start, &result)
        if (end == 0) {
            return result
        }
        result.status = DT_OK
        result.end = end
        result.kind = ValueKind.kind_local_time
        return result
    }

    let date_end u64 = scan_date(data, count, start, &result)
    if (date_end == 0) {
        return result
    }
    let pos u64 = date_end
    let has_time int = 0
    let is_offset int = 0
    if (pos < count) {
        let delim u8 = data[pos]
        if (delim == 'T' || delim == 't') {
            has_time = 1
            pos += 1
        } else if (delim == ' ') {
            // 空格只有后随时间时才属于日期时间；否则是语句尾空白。
            if (pos + 4 <= count && data[pos + 1] >= '0' && data[pos + 1] <= '9'
                && data[pos + 2] >= '0' && data[pos + 2] <= '9'
                && data[pos + 3] == ':') {
                has_time = 1
                pos += 1
            }
        }
    }
    if (has_time != 0) {
        pos = scan_time(data, count, pos, &result)
        if (pos == 0) {
            return result
        }
        let offset_end u64 = scan_offset(data, count, pos, &result)
        if (offset_end == 0) {
            return result
        }
        if (offset_end != pos) {
            is_offset = 1
            pos = offset_end
        }
    }
    result.status = DT_OK
    result.end = pos
    if (has_time == 0) {
        result.kind = ValueKind.kind_local_date
    } else if (is_offset != 0) {
        result.kind = ValueKind.kind_offset_datetime
    } else {
        result.kind = ValueKind.kind_local_datetime
    }
    return result
}
