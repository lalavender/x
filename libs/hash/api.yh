module hash

// ============================================================================
// api.yh —— hash 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// Sha256：一次流式哈希的状态。
// block 保存尚未压缩的末尾字节；total_len 是已喂入的总字节数（不含填充）。
pub struct Sha256 {
    state [8]u32
    k [64]u32
    block [64]u8
    block_len int
    total_len u64
    finished int
}

// sha256_init：写入初始状态与常量表；上下文此前的值被完全覆盖。
pub fn sha256_init(ctx *Sha256) void {
    if (ctx == 0) { return }
    ctx.state[0] = 0x6a09e667
    ctx.state[1] = 0xbb67ae85
    ctx.state[2] = 0x3c6ef372
    ctx.state[3] = 0xa54ff53a
    ctx.state[4] = 0x510e527f
    ctx.state[5] = 0x9b05688c
    ctx.state[6] = 0x1f83d9ab
    ctx.state[7] = 0x5be0cd19
    ctx.k[0] = SHA256_K0
    ctx.k[1] = SHA256_K1
    ctx.k[2] = SHA256_K2
    ctx.k[3] = SHA256_K3
    ctx.k[4] = SHA256_K4
    ctx.k[5] = SHA256_K5
    ctx.k[6] = SHA256_K6
    ctx.k[7] = SHA256_K7
    ctx.k[8] = SHA256_K8
    ctx.k[9] = SHA256_K9
    ctx.k[10] = SHA256_K10
    ctx.k[11] = SHA256_K11
    ctx.k[12] = SHA256_K12
    ctx.k[13] = SHA256_K13
    ctx.k[14] = SHA256_K14
    ctx.k[15] = SHA256_K15
    ctx.k[16] = SHA256_K16
    ctx.k[17] = SHA256_K17
    ctx.k[18] = SHA256_K18
    ctx.k[19] = SHA256_K19
    ctx.k[20] = SHA256_K20
    ctx.k[21] = SHA256_K21
    ctx.k[22] = SHA256_K22
    ctx.k[23] = SHA256_K23
    ctx.k[24] = SHA256_K24
    ctx.k[25] = SHA256_K25
    ctx.k[26] = SHA256_K26
    ctx.k[27] = SHA256_K27
    ctx.k[28] = SHA256_K28
    ctx.k[29] = SHA256_K29
    ctx.k[30] = SHA256_K30
    ctx.k[31] = SHA256_K31
    ctx.k[32] = SHA256_K32
    ctx.k[33] = SHA256_K33
    ctx.k[34] = SHA256_K34
    ctx.k[35] = SHA256_K35
    ctx.k[36] = SHA256_K36
    ctx.k[37] = SHA256_K37
    ctx.k[38] = SHA256_K38
    ctx.k[39] = SHA256_K39
    ctx.k[40] = SHA256_K40
    ctx.k[41] = SHA256_K41
    ctx.k[42] = SHA256_K42
    ctx.k[43] = SHA256_K43
    ctx.k[44] = SHA256_K44
    ctx.k[45] = SHA256_K45
    ctx.k[46] = SHA256_K46
    ctx.k[47] = SHA256_K47
    ctx.k[48] = SHA256_K48
    ctx.k[49] = SHA256_K49
    ctx.k[50] = SHA256_K50
    ctx.k[51] = SHA256_K51
    ctx.k[52] = SHA256_K52
    ctx.k[53] = SHA256_K53
    ctx.k[54] = SHA256_K54
    ctx.k[55] = SHA256_K55
    ctx.k[56] = SHA256_K56
    ctx.k[57] = SHA256_K57
    ctx.k[58] = SHA256_K58
    ctx.k[59] = SHA256_K59
    ctx.k[60] = SHA256_K60
    ctx.k[61] = SHA256_K61
    ctx.k[62] = SHA256_K62
    ctx.k[63] = SHA256_K63
    ctx.block_len = 0
    ctx.total_len = 0
    ctx.finished = 0
}

// sha256_update：喂入 count 字节；0 = 成功，-1 = 参数非法或已 final。
// 不保留输入指针，调用返回后源缓冲可立即释放。
pub fn sha256_update(ctx *Sha256, data *u8, count u64) int {
    if (ctx == 0 || ctx.finished != 0) { return -1 }
    if (count == 0) { return 0 }
    if (data == 0) { return -1 }
    ctx.total_len += count
    let cursor u64 = 0
    if (ctx.block_len > 0) {
        let room int = 64 - ctx.block_len
        let take int = count < room.to_type(u64) ? count.to_type(int) : room
        let i int = 0
        for i < take {
            ctx.block[ctx.block_len + i] = data[cursor.to_type(int) + i]
            i += 1
        }
        ctx.block_len += take
        cursor += take.to_type(u64)
        if (ctx.block_len < 64) {
            // 末尾块未填满时本轮输入已全部进入 block，不能落到下面的
            // rest 分支把 block_len 重置为 0（会丢掉刚复制的字节）。
            return 0
        }
        sha256_compress(ctx)
        ctx.block_len = 0
    }
    for cursor + 64 <= count {
        sha256_copy_block(ctx, data + cursor.to_type(int))
        sha256_compress(ctx)
        cursor += 64
    }
    let rest int = (count - cursor).to_type(int)
    let i int = 0
    for i < rest {
        ctx.block[i] = data[cursor.to_type(int) + i]
        i += 1
    }
    ctx.block_len = rest
    return 0
}

// sha256_final：写 32 字节摘要到 out；0 = 成功，-1 = 参数非法或重复 final。
pub fn sha256_final(ctx *Sha256, out *u8) int {
    if (ctx == 0 || out == 0 || ctx.finished != 0) { return -1 }
    let bits u64 = ctx.total_len * 8
    ctx.block[ctx.block_len] = 0x80
    ctx.block_len += 1
    if (ctx.block_len > 56) {
        let i int = ctx.block_len
        for i < 64 {
            ctx.block[i] = 0
            i += 1
        }
        sha256_compress(ctx)
        ctx.block_len = 0
    }
    let i int = ctx.block_len
    for i < 56 {
        ctx.block[i] = 0
        i += 1
    }
    let shift int = 56
    for shift < 64 {
        let byte_index int = 63 - shift
        ctx.block[shift] = ((bits >> (byte_index * 8)) & 255).to_type(u8)
        shift += 1
    }
    sha256_compress(ctx)
    i = 0
    for i < 8 {
        let value u32 = ctx.state[i]
        out[i * 4] = (value >> 24).to_type(u8)
        out[i * 4 + 1] = (value >> 16).to_type(u8)
        out[i * 4 + 2] = (value >> 8).to_type(u8)
        out[i * 4 + 3] = value.to_type(u8)
        i += 1
    }
    ctx.finished = 1
    return 0
}

// sha256_digest：一次性计算 data[0..count) 的摘要；0 = 成功。
pub fn sha256_digest(data *u8, count u64, out *u8) int {
    let ctx Sha256
    sha256_init(&ctx)
    if (sha256_update(&ctx, data, count) != 0) { return -1 }
    return sha256_final(&ctx, out)
}

// sha256_hex：把 32 字节摘要写成 64 个小写十六进制字符，并在 out[64] 写零。
// 调用方保证 out 至少 65 字节。
pub fn sha256_hex(digest *u8, out *u8) int {
    if (digest == 0 || out == 0) { return -1 }
    let digits *char = "0123456789abcdef"
    let i int = 0
    for i < 32 {
        let value u8 = digest[i]
        out[i * 2] = digits[(value >> 4).to_type(int)].to_type(u8)
        out[i * 2 + 1] = digits[(value & 15).to_type(int)].to_type(u8)
        i += 1
    }
    out[64] = 0
    return 0
}

// sha256_file：流式哈希一个文件；0 = 成功，-1 = 打不开或读失败。
// 读取缓冲固定 64 KiB，避免把大文件整体放进内存。
pub fn sha256_file(path *char, out *u8) int {
    if (path == 0 || out == 0) { return -1 }
    let fd int = open(path, 0)
    if (fd < 0) { return -1 }
    let buffer *u8 = malloc(65536).to_type(*u8)
    if (buffer == 0) {
        close(fd)
        return -1
    }
    let ctx Sha256
    sha256_init(&ctx)
    for 1 {
        let got i64 = read(fd, buffer, 65536)
        if (got < 0) {
            free(buffer.to_type(*void))
            close(fd)
            return -1
        }
        if (got == 0) { break }
        if (sha256_update(&ctx, buffer, got.to_type(u64)) != 0) {
            free(buffer.to_type(*void))
            close(fd)
            return -1
        }
    }
    free(buffer.to_type(*void))
    close(fd)
    return sha256_final(&ctx, out)
}
