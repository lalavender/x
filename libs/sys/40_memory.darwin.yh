module sys

// Darwin 内存映射原语：经 libSystem 的 mmap/munmap 调用。
// 与 Linux 一样，成功值是地址位型，失败值是负 errno；调用方先用 is_error
// 判断，再把完整 64 位成功值转指针。Darwin 的失败形式是 (void *)-1，
// 不能用空指针判断失败（空地址是合法映射结果）。

// mmap 的 offset 是 64 位 off_t；count 为 size_t（u64）。
@[extern] fn mmap(address *void, count u64, protection int, flags int,
    fd int, offset i64) *void
@[extern] fn munmap(address *void, count u64) int

// map_memory 执行 mmap(address, count, protection, flags, fd, offset)。
// address 通常为 0 让内核选择；count/offset 单位为字节，文件映射需页对齐；
// 成功返回地址位型，失败返回负 errno。不读取全局 errno 之外的状态。
pub fn map_memory(address *void, count u64, protection int, flags int,
    fd int, offset u64) i64 {
    let mapped *void = mmap(address, count, protection, flags, fd,
        offset.to_type(i64))
    let bits i64 = mapped.to_type(i64)
    if (bits == -1) {
        return (0 - errno_value()).to_type(i64)
    }
    return bits
}

// unmap_memory 解除 [address, address+count) 映射，成功返回 0，失败返回负 errno。
// 只解除调用方已确认有效的映射，不修改分配器状态。
pub fn unmap_memory(address *void, count u64) i64 {
    let result int = munmap(address, count)
    return errno_result(result.to_type(i64))
}
