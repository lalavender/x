module sys

// Darwin 的 ABI 常量（macOS SDK 头文件取值）。
// Darwin 经 libSystem 调用 POSIX 入口，不复制 Linux 的调用号与标志位；
// 目录枚举常量属于 getattrlistbulk 的 attrlist 位与 vnode 类型，同样只在本
// 文件维护，保持内核 ABI 的唯一归属。

// AT_FDCWD 让 *at 系列调用使用进程当前工作目录。
pub const AT_FDCWD int = -2
// AT_REMOVEDIR 让 unlinkat 删除空目录而不是普通路径。
pub const AT_REMOVEDIR int = 0x80

// 文件访问模式（open 的 O_ACCMODE 取值）。
pub const O_RDONLY int = 0
pub const O_WRONLY int = 1
pub const O_RDWR int = 2
// 追加、创建、截断与独占标志；Darwin 的取值与 Linux 不同。
pub const O_APPEND int = 0x8
pub const O_CREAT int = 0x200
pub const O_TRUNC int = 0x400
pub const O_EXCL int = 0x800
// 目录打开与非阻塞标志。
pub const O_DIRECTORY int = 0x100000
pub const O_NONBLOCK int = 0x4
// 执行 exec 时自动关闭本描述符。
pub const O_CLOEXEC int = 0x1000000

// 私有 fcntl 命令与描述符标志：只在 create_pipe 内用来补 O_CLOEXEC/
// O_NONBLOCK，不进入公开接口。
const F_SETFD int = 2
const F_SETFL int = 4
const FD_CLOEXEC int = 1

// 错误归一化实际使用的 errno 值（sys/errno.h）。
pub const EPERM int = 1
pub const ENOENT int = 2
pub const EINTR int = 4
pub const EIO int = 5
pub const ENOEXEC int = 8
pub const EBADF int = 9
pub const ECHILD int = 10
pub const EACCES int = 13
pub const EEXIST int = 17
pub const ENOTDIR int = 20
pub const EINVAL int = 22
pub const ENOSPC int = 28
pub const ERANGE int = 34
// EAGAIN 表示非阻塞 I/O 当前无法继续；与 EWOULDBLOCK 同值。
pub const EAGAIN int = 35
pub const ENOSYS int = 78

// 测试与进程控制使用的信号号。
pub const SIGKILL int = 9
pub const SIGTERM int = 15
// WNOHANG 让 wait4 在没有已结束子进程时立即返回 0。
pub const WNOHANG int = 1

// 内存映射常量（sys/mman.h）。
pub const PROT_READ int = 1
pub const PROT_WRITE int = 2
pub const MAP_PRIVATE int = 0x2
pub const MAP_ANONYMOUS int = 0x1000
// 时钟常量（_time.h）：Darwin 的 CLOCK_MONOTONIC 是 6，不是 Linux 的 1。
pub const CLOCK_REALTIME int = 0
pub const CLOCK_MONOTONIC int = 6

// getattrlistbulk 的 attrlist 与属性位（sys/attr.h）。
// bitmapcount 必须是 ATTR_BIT_MAP_COUNT，位宽为 u16 与内核字段一致。
pub const ATTR_BIT_MAP_COUNT u16 = 5
// ATTR_CMN_RETURNED_ATTRS 必须请求：每个条目组先返回实际获得的属性集。
pub const ATTR_CMN_RETURNED_ATTRS u32 = 0x80000000
pub const ATTR_CMN_NAME u32 = 0x1
pub const ATTR_CMN_OBJTYPE u32 = 0x8

// vnode 对象类型（sys/vnode.h）：条目类型只映射这两种，其余保留 unknown。
pub const VREG u32 = 1
pub const VDIR u32 = 2
