@[extern] fn GetLastError() u32

@[extern] fn unlinkat(dir_fd int, path *char, flags int) int

@[extern] fn renameat(old_dir_fd int, old_path *char,
    new_dir_fd int, new_path *char) int

@[extern] fn pipe(output *int) int

@[extern] fn chdir(path *char) int

@[extern] fn getcwd(buffer *char, capacity u64) *char

@[extern] fn SetCurrentDirectoryA(path *char) i32

@[extern] fn RemoveDirectoryA(path *char) i32

@[extern] fn FindNextFileA(handle i64, data *u8) i32

@[extern] fn FindClose(handle i64) i32

@[extern] fn munmap(address *void, count u64) int

@[extern] fn VirtualAlloc(address *void, size u64, allocation_type u32,
    protect u32) *void

@[extern] fn VirtualFree(address *void, size u64, free_type u32) i32

@[extern] fn wait4(pid int, status *int, options int, usage *void) int

@[extern] fn socket(domain int, kind int, protocol int) int

@[extern] fn connect(fd int, addr *void, addr_len u32) int

@[extern] fn bind(fd int, addr *void, addr_len u32) int

@[extern] fn listen(fd int, backlog int) int

@[extern] fn accept(fd int, addr *void, addr_len *u32) int

@[extern] fn getsockname(fd int, addr *void, addr_len *u32) int

@[extern] fn getsockopt(fd int, level int, opt_name int,
    value *void, opt_len *u32) int

@[extern] fn setsockopt(fd int, level int, opt_name int,
    value *void, opt_len u32) int

@[extern] fn shutdown(fd int, how int) int

@[extern] fn send(fd int, buffer *void, count u64, flags int) i64

@[extern] fn recv(fd int, buffer *void, count u64, flags int) i64

@[extern] fn poll(entries *void, count u32, timeout_ms int) int

@[extern] fn nanosleep(request *Timespec, remaining *Timespec) int

@[extern] fn GetSystemTimeAsFileTime(output *u64) void

@[extern] fn QueryPerformanceCounter(value *i64) i32

@[extern] fn QueryPerformanceFrequency(value *i64) i32

@[extern] fn Sleep(milliseconds u32) void

// __error 返回当前线程 errno 的地址（libSystem 内部持久的每线程槽）。
@[extern] fn __error() *int

// 以下为 libSystem 入口，参数与 macOS SDK 的 POSIX 声明一致。
@[extern] fn mkdirat(dir_fd int, path *char, mode u32) int

// Windows 的当前目录/子目录操作直接用 kernel32（SDK 导入库已导出）。
@[extern] fn GetCurrentDirectoryA(capacity u32, buffer *char) u32

// find_first 用 NUL 结尾模式（支持 * 与 ?）开始枚举，data 必须是
// FIND_DATA_SIZE 字节的可写缓冲；成功返回正的查找句柄，失败返回 -errno。
// 句柄必须由 find_close 释放；data 的内容在下次 find_next 前有效。
@[extern] fn FindFirstFileA(pattern *char, data *u8) i64

// mmap 的 offset 是 64 位 off_t；count 为 size_t（u64）。
@[extern] fn mmap(address *void, count u64, protection int, flags int,
    fd int, offset i64) *void

// execve 与 wait4 在本文件按固定参数声明；wait4 的 rusage 传空指针。
@[extern] fn execve(path *char, argv **char, envp **char) int

// posix_spawn 直接完成 fork+exec：成功返回 0 并写入子 PID，失败返回正 errno
// （不是 -1，也不设置全局 errno）。file_actions/attrp 传空指针表示继承
// 当前描述符与默认属性；path 必须精确，不搜索 PATH。
@[extern] fn posix_spawn(pid *int, path *char, actions *void, attrs *void,
    argv **char, envp **char) int
