module sys

// ============================================================================
// api.yh —— sys 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// Timespec 是 LP64 目标（Linux 与 Darwin）的内核时间结构。
// 布局固定为 16 字节：sec 位于偏移 0，nsec 位于偏移 8，两字段均为 i64。
// sec 表示整秒，nsec 表示 0..999999999 范围的纳秒；越界值由调用方判错，
// sys 只负责原样传给内核或接收内核写入，不做范围修正。
pub struct Timespec {
    sec i64
    nsec i64
}

// PollFd 是 poll/ppoll 的事件槽，两平台布局一致且固定 8 字节：
// fd 位于偏移 0，events 位于偏移 4，revents 位于偏移 6。
// fd 为负表示该槽被忽略；events/revents 使用 POLL* 位。
pub struct PollFd {
    fd int
    events i16
    revents i16
}

// Timeval 是 setsockopt(SO_RCVTIMEO/SO_SNDTIMEO) 的超时结构。
// 两平台总长都是 16 字节：sec 在偏移 0，usec 在偏移 8。
// Darwin 的 tv_usec 是 32 位字段后跟 4 字节填充，因此调用方必须保证
// usec 落在 0..999999（本库只用来表达毫秒级超时，不会越界）。
pub struct Timeval {
    sec i64
    usec i64
}

// is_error 判断原始系统调用返回值是否落在内核保留错误区间 [-4095, -1]。
// 返回 1 表示错误，0 表示成功或非错误负数；不把任意负数都当作错误，
// 因为 mmap 等接口的成功值可能是高位为 1 的完整 64 位地址。
pub fn is_error(value i64) int {
    if (value <= -1 && value >= -4095) {
        return 1
    }
    return 0
}

// error_code 从原始系统调用返回值提取正错误号。
// 错误时返回 1..4095 的目标平台 errno，成功或非错误负数返回 0；
// 调用方应先确认 is_error，不能用 native_code 是否为 0 之外的方式判错。
pub fn error_code(value i64) int {
    if (is_error(value) != 0) {
        return (0 - value).to_type(int)
    }
    return 0
}

