module sys

// Linux/x86_64 的 ABI 常量与本次交付所需调用号。
// 调用号来源为 Linux v6.12 arch/x86/entry/syscalls/syscall_64.tbl；
// 标志来源为 asm-generic fcntl.h。x86_64 的 O_DIRECTORY 与 AArch64 不同。

// AT_FDCWD 让 *at 系列调用使用进程当前工作目录。
pub const AT_FDCWD int = -100
// AT_REMOVEDIR 让 unlinkat 删除空目录而不是普通路径。
pub const AT_REMOVEDIR int = 0x200

// 文件访问模式（open 的 O_ACCMODE 取值）。
pub const O_RDONLY int = 0
pub const O_WRONLY int = 1
pub const O_RDWR int = 2
// 创建、独占、截断与追加标志。
pub const O_CREAT int = 0x40
pub const O_EXCL int = 0x80
pub const O_TRUNC int = 0x200
pub const O_APPEND int = 0x400
// x86_64 的 O_DIRECTORY = 0200000（AArch64 是 040000）。
pub const O_DIRECTORY int = 0x10000
// 执行 exec 时自动关闭本描述符。
pub const O_CLOEXEC int = 0x80000
// 非阻塞描述符标志，供短写/EINTR 测试与后续进程管道使用。
pub const O_NONBLOCK int = 0x800

// 本次错误归一化实际使用的 errno 值（asm-generic）。
pub const EPERM int = 1
pub const ENOENT int = 2
pub const EINTR int = 4
pub const EBADF int = 9
pub const EACCES int = 13
// EAGAIN 表示非阻塞 I/O 当前无法继续；与 EWOULDBLOCK 同值。
pub const EAGAIN int = 11
// 进程等待与 exec 失败分类。
pub const ECHILD int = 10
pub const ENOEXEC int = 8
// 测试与进程控制使用的信号号。
pub const SIGKILL int = 9
pub const SIGTERM int = 15
// WNOHANG 让 wait4 在没有已结束子进程时立即返回 0。
pub const WNOHANG int = 1

// 内存映射与时钟常量（asm-generic mman/fcntl 与 time）。
pub const PROT_READ int = 1
pub const PROT_WRITE int = 2
pub const MAP_PRIVATE int = 0x02
pub const MAP_ANONYMOUS int = 0x20
pub const CLOCK_REALTIME int = 0
pub const CLOCK_MONOTONIC int = 1
pub const ENOTDIR int = 20
pub const EEXIST int = 17
pub const EINVAL int = 22
pub const ENOSYS int = 38
pub const ERANGE int = 34

// 私有调用号：只在 sys 平台实现文件内使用，不进入公开接口。
const NR_OPENAT u64 = 257
const NR_READ u64 = 0
const NR_WRITE u64 = 1
const NR_CLOSE u64 = 3
const NR_MKDIRAT u64 = 258
const NR_UNLINKAT u64 = 263
const NR_RENAMEAT2 u64 = 316
const NR_GETDENTS64 u64 = 217
const NR_GETCWD u64 = 79
const NR_CHDIR u64 = 80
const NR_PIPE2 u64 = 293
const NR_GETPID u64 = 39
const NR_CLONE u64 = 56
const NR_EXECVE u64 = 59
const NR_WAIT4 u64 = 61
const NR_EXIT_GROUP u64 = 231
const NR_KILL u64 = 62
const SIGCHLD int = 17
const NR_MMAP u64 = 9
const NR_MUNMAP u64 = 11
const NR_CLOCK_GETTIME u64 = 228
const NR_NANOSLEEP u64 = 35

// —— 网络（asm-generic；socket 相关取值在 arm64 与 x64 上一致）——
// 与 Darwin 的差别集中在 AF_INET6、SOL_SOCKET 与 SO_*；Linux 用 MSG_NOSIGNAL
// 抑制 SIGPIPE，Darwin 没有该标志（改用 SO_NOSIGPIPE）。
pub const AF_INET int = 2
pub const AF_INET6 int = 10
pub const SOCK_STREAM int = 1
pub const SOCK_DGRAM int = 2
pub const IPPROTO_TCP int = 6
pub const IPPROTO_UDP int = 17
pub const SOL_SOCKET int = 1
pub const SO_REUSEADDR int = 2
pub const SO_ERROR int = 4
pub const SO_RCVTIMEO int = 20
pub const SO_SNDTIMEO int = 21
pub const MSG_NOSIGNAL int = 0x4000

// shutdown 的方向参数。
pub const SHUT_RD int = 0
pub const SHUT_WR int = 1
pub const SHUT_RDWR int = 2

// poll 事件位（asm-generic/poll.h）。
pub const POLLIN i16 = 0x0001
pub const POLLOUT i16 = 0x0004
pub const POLLERR i16 = 0x0008
pub const POLLHUP i16 = 0x0010
pub const POLLNVAL i16 = 0x0020

// fcntl 命令：net 用它们设置/清除 O_NONBLOCK。
pub const F_GETFL int = 3
pub const F_SETFL int = 4

// 网络相关 errno。
pub const EINPROGRESS int = 115
pub const EPIPE int = 32
pub const EADDRINUSE int = 98
pub const EADDRNOTAVAIL int = 99
pub const ENETUNREACH int = 101
pub const ECONNABORTED int = 103
pub const ECONNRESET int = 104
pub const ENOTCONN int = 107
pub const ETIMEDOUT int = 110
pub const ECONNREFUSED int = 111
pub const EHOSTUNREACH int = 113

// socket 族调用号（x86_64 专用表 arch/x86/entry/syscalls/syscall_64.tbl）。
// x64 虽有 poll(7)，为与 arm64 共用一套语义仍统一走 ppoll(271)。
const NR_SOCKET u64 = 41
const NR_BIND u64 = 49
const NR_LISTEN u64 = 50
const NR_ACCEPT4 u64 = 288
const NR_CONNECT u64 = 42
const NR_GETSOCKNAME u64 = 51
const NR_SETSOCKOPT u64 = 54
const NR_GETSOCKOPT u64 = 55
const NR_SHUTDOWN u64 = 48
const NR_SENDTO u64 = 44
const NR_RECVFROM u64 = 45
const NR_PPOLL u64 = 271
const NR_FCNTL u64 = 72
