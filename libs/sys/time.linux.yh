module sys

// Linux 时钟与睡眠原语：输出结构为 Timespec，时间为 i64 秒 + 纳秒。
// read_clock 成功填结构并返回 0；sleep_time 被中断时保留剩余时间且不自动重试。

// read_clock 读取 clock_id 对应时钟到 output。
// clock_id 使用 CLOCK_REALTIME/CLOCK_MONOTONIC；成功返回 0，失败返回负 errno。
// 失败时 output 内容不可用；纳秒合法范围由调用方按 0..999999999 校验。
pub fn read_clock(clock_id int, output *Timespec) i64 {
    return raw6(NR_CLOCK_GETTIME, clock_id.to_type(u64),
        output.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64))
}

// sleep_time 睡眠 request 指定的时长；remaining 可为空指针。
// 成功返回 0；被信号中断返回 -EINTR 并可能写入剩余时间，是否重试由上层决定。
// request/remaining 都必须是有效 Timespec 指针，纳秒越界由内核判 EINVAL。
pub fn sleep_time(request *Timespec, remaining *Timespec) i64 {
    return raw6(NR_NANOSLEEP, request.to_type(u64), remaining.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}
