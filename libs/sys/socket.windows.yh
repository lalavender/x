module sys

// Windows 网络原语：Winsock 2（ws2_32.dll）尚未接入。
//
// 现状（W2-7）：`libs/net`、`libs/http` 的 Windows 支持是独立任务（NET/HTTP
// 路线），本文件先把 sys 的 socket 接口面补齐为返回 -ENOSYS 的桩，
// 目的只有两个：
//   1. 跨平台代码（net/http 模块）在 Windows 目标上仍能通过语义检查与链接；
//   2. 任何真的调用都得到明确的“不支持”，而不是未定义符号或静默 0。
//
// 接入 Winsock 时需要：manifest 增加 ws2_32.dll 导入库、进程启动时 WSAStartup、
// 把 SOCKET 放进 fd 表（与文件句柄共用编号），并把 SO_* 常量换成 Winsock 取值。
// 这些都属于 NET 系列任务，不在 W2-7 展开。

// socket_fd 创建套接字；Windows 上未接线。
pub fn socket_fd(domain int, kind int, protocol int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// connect_fd 连接套接字；Windows 上未接线。
pub fn connect_fd(fd int, addr *void, addr_len u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// bind_fd 绑定地址；Windows 上未接线。
pub fn bind_fd(fd int, addr *void, addr_len u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// listen_fd 开始监听；Windows 上未接线。
pub fn listen_fd(fd int, backlog int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// accept_fd 接受连接；Windows 上未接线。
pub fn accept_fd(fd int, addr *void, addr_len *u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// get_socket_name 读取本地地址；Windows 上未接线。
pub fn get_socket_name(fd int, addr *void, addr_len *u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// shutdown_fd 关闭连接方向；Windows 上未接线。
pub fn shutdown_fd(fd int, how int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// set_socket_option 设置套接字选项；Windows 上未接线。
pub fn set_socket_option(fd int, level int, opt_name int,
    value *void, opt_len u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// get_socket_option 读取套接字选项；Windows 上未接线。
pub fn get_socket_option(fd int, level int, opt_name int,
    value *void, opt_len *u32) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// send_fd 发送数据；Windows 上未接线。
pub fn send_fd(fd int, buffer *void, count u64, flags int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// recv_fd 接收数据；Windows 上未接线。
pub fn recv_fd(fd int, buffer *void, count u64, flags int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// poll_fds 等待事件；Windows 上未接线（Winsock 用 WSAPoll）。
pub fn poll_fds(entries *PollFd, count u64, timeout_ms int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// fcntl_fd 修改描述符标志；Windows 上未接线（Winsock 用 ioctlsocket）。
pub fn fcntl_fd(fd int, cmd int, arg int) i64 {
    return (0 - ENOSYS).to_type(i64)
}
