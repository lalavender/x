module sys;

// Linux 文件原语：每次只执行一次内核调用，返回内核原始结果或 -errno。
// 本层不循环短读写、不重试 EINTR、不分配缓冲区、不检查指针有效性；
// 目录项解析与错误分类由 os 消费者完成。

// open_at 在 dir_fd 目录下按 NUL 结尾字节路径打开文件。
// dir_fd 可用 AT_FDCWD 表示当前目录；flags 为 O_* 组合；mode 始终传给内核，
// 只有创建文件时才由内核结合 umask 使用。成功返回 fd，失败返回负 errno。
pub fn open_at(dir_fd int, path *char, flags int, mode u32) i64 {
    return raw6(NR_OPENAT, dir_fd.to_type(u64), path.to_type(u64),
        flags.to_type(u64), mode.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// read_fd 从 fd 读取至多 count 字节到调用方缓冲区。
// 返回实际读入字节数，0 表示 EOF；失败返回负 errno。允许短读，不重试。
pub fn read_fd(fd int, buffer *void, count u64) i64 {
    return raw6(NR_READ, fd.to_type(u64), buffer.to_type(u64), count,
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// write_fd 向 fd 写入至多 count 字节，返回实际写入字节数。
// 允许短写；失败返回负 errno。是否循环写入由上层决定。
pub fn write_fd(fd int, buffer *void, count u64) i64 {
    return raw6(NR_WRITE, fd.to_type(u64), buffer.to_type(u64), count,
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// close_fd 关闭 fd 并返回 0 或负 errno。
// 关闭失败后不自动重试；fd 可能已经释放，调用方不得继续使用。
pub fn close_fd(fd int) i64 {
    return raw6(NR_CLOSE, fd.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// create_dir_at 在 dir_fd 目录下创建单层目录。
// mode 为权限位，由内核结合 umask 裁剪；不递归创建父目录。
pub fn create_dir_at(dir_fd int, path *char, mode u32) i64 {
    return raw6(NR_MKDIRAT, dir_fd.to_type(u64), path.to_type(u64),
        mode.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// remove_at 在 dir_fd 目录下删除路径。
// flags 为 0 时删除文件路径；AT_REMOVEDIR 只删除空目录，不递归删除。
pub fn remove_at(dir_fd int, path *char, flags int) i64 {
    return raw6(NR_UNLINKAT, dir_fd.to_type(u64), path.to_type(u64),
        flags.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// rename_at 在两个目录 fd 之间重命名路径，flags 固定为 0。
// 语义等同 renameat2(..., 0)：不复制、不回退、不递归；跨设备由内核报错。
pub fn rename_at(old_dir_fd int, old_path *char,
    new_dir_fd int, new_path *char) i64 {
    return raw6(NR_RENAMEAT2, old_dir_fd.to_type(u64), old_path.to_type(u64),
        new_dir_fd.to_type(u64), new_path.to_type(u64), 0.to_type(u64),
        0.to_type(u64));
}

// getdents64 读取原始 Linux 目录记录到调用方缓冲区。
// buffer 必须是可写内存，count 为字节容量；成功返回本次读入的原始字节数，
// 0 表示目录结束。记录布局与名称 NUL 边界由 os 目录读取器校验，sys 不解析。
pub fn getdents64(fd int, buffer *void, count u64) i64 {
    return raw6(NR_GETDENTS64, fd.to_type(u64), buffer.to_type(u64), count,
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// get_cwd 把进程当前工作目录写入调用方缓冲区，成功时包含结尾 NUL。
// 返回内核写入的总字节数（含 NUL）；空间不足返回 -ERANGE，不隐式扩容。
pub fn get_cwd(buffer *char, capacity u64) i64 {
    return raw6(NR_GETCWD, buffer.to_type(u64), capacity, 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// change_dir 修改进程全局当前工作目录，成功返回 0，失败返回负 errno。
// 路径为 NUL 结尾字节串；sys 不拼接、不解析、不创建目录。
pub fn change_dir(path *char) i64 {
    return raw6(NR_CHDIR, path.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}

// create_pipe 创建匿名管道，output 指向两个连续 int（读端、写端）。
// flags 为 O_CLOEXEC/O_NONBLOCK 组合；成功返回 0，失败返回负 errno。
// 只有成功后才能读取 output；两个 fd 的所有权交给调用方关闭。
pub fn create_pipe(output *int, flags int) i64 {
    return raw6(NR_PIPE2, output.to_type(u64), flags.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}
