module sys

// Darwin 的 errno 桥：libSystem 的 POSIX 入口失败时返回 -1，并把正错误号
// 写在线程私有的 errno 槽；sys 对外仍保持与 Linux 相同的 -errno 契约，
// 调用方只看 is_error/error_code，不需要知道目标平台用的是哪种报错方式。
//
// 本文件位于 base.yh 之后、各平台实现文件之前，只供 sys 内部使用，
// 不进入公开导出面；__error 返回的地址与线程绑定，不能缓存跨线程使用。

// errno_value 读取当前线程的正错误号；只在刚失败的调用之后使用。
fn errno_value() int {
    let slot *int = __error()
    return slot[0]
}

// errno_result 把 libSystem 的返回值归一化为 sys 契约的返回值。
// result 等于 -1 时返回 -errno，其他值原样返回；指针结果不适用本函数，
// 由调用方判空后自行取 errno。返回 i64 便于与 Linux 原语保持同一签名。
fn errno_result(result i64) i64 {
    if (result == -1) {
        return (0 - errno_value()).to_type(i64)
    }
    return result
}
