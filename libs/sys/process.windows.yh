module sys

// Windows 进程原语。
//
// Windows 没有 fork/exec 模型：进程创建是 CreateProcessA（一次性给定可执行
// 文件与命令行），等待是 WaitForSingleObject + GetExitCodeProcess，也没有
// POSIX 信号。因此本文件按能力如实划分：
//
//   * process_id / exit_process / sleep_time —— 已实现；
//   * fork_process / execute / wait_process / send_signal —— 返回 -ENOSYS；
//   * 进程创建与等待由 os 层的 process.windows.yh 用 CreateProcessA 提供
//     （对应 Darwin 的 spawn_process 位置），不伪装成 fork+exec。
//
// 这样跨平台代码仍能链接，但任何依赖 fork 语义的调用在 Windows 上会得到
// 明确的 -ENOSYS，而不是一个看起来成功却没有子进程的返回值。

// process_id 返回当前进程号（运行时的 getpid → GetCurrentProcessId）。
fn process_id_impl() i64 {
    return getpid().to_type(i64)
}

// exit_process 以指定状态结束进程；成功后不返回，不做语言清理。
fn exit_process_impl(code int) void {
    exit(code)
}

// fork_process 在 Windows 上没有对应物。
fn fork_process_impl() i64 {
    return (0 - ENOSYS).to_type(i64)
}

// execute 用新映像替换当前进程；Windows 没有 exec，必须用 CreateProcessA
// 另起进程（见 os 层 spawn），这里返回 -ENOSYS。
fn execute_impl(path *char, argv **char, envp **char) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// wait_process 等待子进程；Windows 的等待需要进程句柄而不是 PID，
// 由 os 层用 WaitForSingleObject 实现，这里返回 -ENOSYS。
fn wait_process_impl(pid int, status *int, options int) i64 {
    return (0 - ENOSYS).to_type(i64)
}

// send_signal 在 Windows 上没有 POSIX 信号；终止进程用 TerminateProcess，
// 由 os 层在需要时提供，这里返回 -ENOSYS。
fn send_signal_impl(pid int, signal int) i64 {
    return (0 - ENOSYS).to_type(i64)
}
