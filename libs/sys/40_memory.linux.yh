module sys;

// Linux 内存映射原语：成功值是地址位型，失败值是 -errno。
// 调用方先用 is_error 判断，再把完整 64 位成功值转指针；不能以空指针或
// 任意负 i64 作为 mmap 失败判定，本层不维护分配器头部或释放列表。

// map_memory 执行 mmap(address, count, protection, flags, fd, offset)。
// address 通常为 0 让内核选择；count/offset 单位为字节，文件映射需页对齐；
// protection 为 PROT_READ/PROT_WRITE，flags 为 MAP_PRIVATE/MAP_ANONYMOUS 等组合。
// 成功返回地址位型，失败返回负 errno；不读取全局 errno。
pub fn map_memory(address *void, count u64, protection int, flags int,
    fd int, offset u64) i64 {
    return raw6(NR_MMAP, address.to_type(u64), count,
        protection.to_type(u64), flags.to_type(u64), fd.to_type(u64),
        offset);
}

// unmap_memory 解除 [address, address+count) 映射，成功返回 0，失败返回负 errno。
// 只解除调用方已确认有效的映射，不修改分配器状态。
pub fn unmap_memory(address *void, count u64) i64 {
    return raw6(NR_MUNMAP, address.to_type(u64), count, 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64));
}
