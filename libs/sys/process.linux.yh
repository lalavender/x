module sys

// Linux 进程原语：PID、fork、exec、wait、退出与信号。
// 所有函数除退出外保留内核原始结果或 -errno；不做状态解释、不分配、
// 不格式化，也不在 sys 层实现 spawn 的错误管道握手。

// process_id 返回当前进程号；失败返回负 errno。
pub fn process_id() i64 {
    return raw6(NR_GETPID, 0.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}

// fork_process 使用 SIGCHLD、空子栈、无 CLONE_VM 的 clone 复制当前进程。
// 父进程得到正子 PID，子进程得到 0，失败返回负 errno；两端从同一返回点继续。
// 首期只支持单线程父进程的 fork/COW worker，不提供任意 clone(flags, stack)。
pub fn fork_process() i64 {
    return raw6(NR_CLONE, SIGCHLD.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}

// execute 用显式 argv/envp 替换当前映像；成功不返回，失败返回负 errno。
// 路径必须是精确路径，不搜索 PATH、不经过 shell；argv/envp 为 NULL 结尾指针数组。
pub fn execute(path *char, argv **char, envp **char) i64 {
    return raw6(NR_EXECVE, path.to_type(u64), argv.to_type(u64),
        envp.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}

// wait_process 等待指定子进程并把原始 32 位状态字写入 status。
// pid 可为正子 PID 或 -1 等待任一子进程；options 为 0 或 WNOHANG。
// 返回被回收的子 PID，失败返回负 errno；status 只在成功时有效，sys 不解码。
pub fn wait_process(pid int, status *int, options int) i64 {
    return raw6(NR_WAIT4, pid.to_type(u64), status.to_type(u64),
        options.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}

// exit_process 以指定状态结束整个线程组；成功后不返回，不做语言清理。
pub fn exit_process(code int) void {
    raw6(NR_EXIT_GROUP, code.to_type(u64), 0.to_type(u64), 0.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}

// send_signal 向 pid 发送信号并返回内核结果；错误保留负 errno。
pub fn send_signal(pid int, signal int) i64 {
    return raw6(NR_KILL, pid.to_type(u64), signal.to_type(u64),
        0.to_type(u64), 0.to_type(u64), 0.to_type(u64), 0.to_type(u64))
}
