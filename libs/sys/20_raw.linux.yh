module sys;

// raw6 直接调用 Linux 当前目标的六参数系统调用入口。
// number 是目标 ISA 的调用号；a0..a5 是机器字参数，未使用槽必须显式填 0。
// 返回值为内核原始结果：成功是字节数、fd、PID 或地址位型，失败是 -errno。
// 本函数不读取全局 errno、不重试、不解释结果，指针与负数由调用方按 ABI 转换。
pub fn raw6(number u64, a0 u64, a1 u64, a2 u64,
    a3 u64, a4 u64, a5 u64) i64 {
    return linux_syscall6(number, a0, a1, a2, a3, a4, a5);
}
