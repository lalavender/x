module sys

// Windows 内存映射原语：用 VirtualAlloc/VirtualFree 模拟 mmap/munmap 的
// “匿名可写内存”子集。成功值是地址位型，失败返回 -ENOMEM。
// 未实现的部分：文件映射（fd/offset 非零）返回 -ENOSYS；部分解除映射
// （count 小于保留区大小）也返回 -ENOSYS，因为 VirtualFree 只能整块释放。

// MEM_COMMIT | MEM_RESERVE 与 MEM_RELEASE：VirtualAlloc 的两组常量。
const MEM_COMMIT_RESERVE u32 = 0x3000
const MEM_RELEASE u32 = 0x8000
// PAGE_READWRITE：本库只申请可读写页。
const PAGE_READWRITE u32 = 0x04

// map_memory 申请 [0, count) 的匿名可写内存。
// address 必须为空（Windows 不支持按建议地址申请）；匿名映射允许 fd < 0
// （POSIX 调用方常传 -1）或 fd == 0 且 offset == 0；文件映射（fd > 0）返回
// -ENOSYS。成功返回地址位型，失败 -ENOMEM / -EINVAL。
fn map_memory_impl(address *void, count u64, protection int, flags int,
    fd int, offset u64) i64 {
    if (address != 0 || fd > 0 || offset != 0) {
        return (0 - ENOSYS).to_type(i64)
    }
    if (count == 0) {
        return (0 - EINVAL).to_type(i64)
    }
    let mapped *void = VirtualAlloc(0, count, MEM_COMMIT_RESERVE,
        PAGE_READWRITE)
    if (mapped == 0) {
        return (0 - ENOMEM).to_type(i64)
    }
    return mapped.to_type(i64)
}

// unmap_memory 释放整块映射，成功返回 0，失败返回 -ENOSYS 或 -EINVAL。
// count 只做非零校验：VirtualFree 的 MEM_RELEASE 要求 size 为 0 且整块释放。
fn unmap_memory_impl(address *void, count u64) i64 {
    if (address == 0 || count == 0) {
        return (0 - EINVAL).to_type(i64)
    }
    if (VirtualFree(address, 0, MEM_RELEASE) != 0) {
        return 0
    }
    return (0 - errno_value()).to_type(i64)
}
