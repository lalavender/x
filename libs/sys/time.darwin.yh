module sys

// Darwin 时钟与睡眠原语：输出结构为 Timespec，时间为 64 位秒 + 纳秒。
// clock_gettime 是编译器 prelude 已登记的 POSIX 入口；nanosleep 在
// libSystem 中按固定两参数声明调用。被中断时内核写入剩余时间，本层不重试。

@[extern] fn nanosleep(request *Timespec, remaining *Timespec) int

// read_clock 读取 clock_id 对应时钟到 output。
// clock_id 用 CLOCK_REALTIME(0)/CLOCK_MONOTONIC(6)；成功返回 0，失败返回
// 负 errno。失败时 output 内容不可用；纳秒合法范围由调用方按 0..999999999
// 校验。
pub fn read_clock(clock_id int, output *Timespec) i64 {
    let result int = clock_gettime(clock_id, output.to_type(*void))
    return errno_result(result.to_type(i64))
}

// sleep_time 睡眠 request 指定的时长；remaining 可为空指针。
// 成功返回 0；被信号中断返回 -EINTR 并可能写入剩余时间，是否重试由上层决定。
// request/remaining 都必须是有效 Timespec 指针，纳秒越界由内核判 EINVAL。
pub fn sleep_time(request *Timespec, remaining *Timespec) i64 {
    let result int = nanosleep(request, remaining)
    return errno_result(result.to_type(i64))
}
