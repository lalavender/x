module sys

// ============================================================================
// 99_tests.yh —— sys 结果模型的语言内测试（YT4-P5）
//
// 只在 `yh test sys` 中执行；生产构建不登记测试符号、不发射测试体。
// 来源是 tests/modules/projects/sysresult 的纯模型断言（不发起系统调用），
// 原始夹具保留在 git 历史中；真实文件/进程 E2E 仍由
// tests/modules/projects/{sysraw,sysfiles,...}（Linux）承担。
// ============================================================================

test "Timespec 布局" {
    let stamp Timespec
    stamp.sec = 7
    stamp.nsec = 8
    $assert(sizeof(Timespec) == 16, "Timespec 必须是 16 字节")
    let base u64 = (&stamp).to_type(u64)
    let nsec_at u64 = (&stamp.nsec).to_type(u64)
    $assert(nsec_at - base == 8, "nsec 位于偏移 8")
    $assert(stamp.sec == 7 && stamp.nsec == 8, "字段可独立读写")
}

test "错误区间与错误号提取" {
    $assert(is_error(0) == 0, "0 不是错误")
    $assert(is_error(1) == 0, "正数不是错误")
    $assert(is_error(-1) == 1, "-1 在错误区间")
    $assert(is_error(-4095) == 1, "-4095 在错误区间")
    $assert(is_error(-4096) == 0, "-4096 不在错误区间")

    $assert(error_code(-1) == 1, "-1 的错误号为 1")
    $assert(error_code(-4095) == 4095, "-4095 的错误号为 4095")
    $assert(error_code(0) == 0, "成功错误号为 0")
    $assert(error_code(7) == 0, "普通正数错误号为 0")
    $assert(error_code(-4096) == 0, "错误区间外不产生错误号")
}
