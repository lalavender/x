module list

import memory

// ============================================================================
// list.yh —— 运行期元素宽度的连续存储动态列表（ArrayList）
//
// 无泛型约束下的唯一可行形态：元素以运行期字节宽度连续存放，宽度必须来自
// 调用方的 sizeof(T)；元素地址以 *void 暴露，调用方用 to_type(*T) 定型。
// 本模块只拥有存储块，不拥有元素内部资源，也不调用任何析构函数。
//
// 接口按 V 语言内建数组（array）的方法集对齐（映射表见 libs/list/README.md）：
// 无类型容器无法直接比较/变换元素，因此 contains/index/last_index/sort/
// sorted 收 compare 回调，any/all/count/filter 收 predicate 回调，map 收
// transform 回调；回调一律是普通 yh 函数（不需要 @[extern]）。
// 无法对齐的方法（pointers/str/hex/wait/深度复制）在 README 里逐条说明原因。
//
// 明确不提供：[]T 视图（语言禁止从裸指针构造切片）、元素析构、线程安全。
// 扩容 = 新分配 + 复制 + 释放旧块；插入/删除的移位用模块内重叠安全复制。
// 完整契约与误用边界见 docs/03-design/yh-list标准库设计.md。
//
// 硬规则：
//   1. element_size 必须来自 sizeof(T)；其它宽度不保证元素对齐。
//   2. 传给 push/push_all/insert 的元素不得指向本列表的存储：
//      扩容会释放旧块，插入/删除的移位会移动源区域。
//   3. reserve/push/push_all/insert/clear/release 之后，此前取得的元素
//      指针与缓存的 data 指针全部失效。
//   4. [count, capacity) 的槽位未初始化，读取它们是未定义行为
//      （grow_len 新增的槽位同样未初始化）。
//   5. 回调参数必须非空：语言不支持函数指针与 0 比较，传 0 会在调用处崩溃。
// ============================================================================

// LIST_MIN_CAPACITY 是首次分配的起步槽位数；容量为 0 的列表不分配存储。
const LIST_MIN_CAPACITY u64 = 16

// LIST_MAX_BYTES 是单块存储的字节上界；与 string 的长度上界同量级，只用于
// 拒绝明显越界的容量请求，不宣称这么大的内存可以实际分配。
const LIST_MAX_BYTES u64 = 9223372036854775800

// list_result_ok 构造成功的新列表结果。
fn list_result_ok(value List) ListResult {
    let result ListResult
    result.status = Status.status_ok
    result.value = value
    return result
}

// list_result_error 构造失败的新列表结果；失败值恒为零值列表。
fn list_result_error(status Status) ListResult {
    let result ListResult
    result.status = status
    result.value = make(0)
    return result
}

// list_max_count 返回当前步长下允许的最大元素个数；0 表示步长无效或
// 连一个元素都放不下（element_size > LIST_MAX_BYTES）。
// 不修改列表，也不分配。
fn list_max_count(value *List) u64 {
    if (value == 0 || value.element_size == 0) {
        return 0
    }
    return LIST_MAX_BYTES / value.element_size
}

// list_next_capacity 计算不小于 needed 的新容量；0 表示无法在上界内满足。
// 起点取 max(capacity, LIST_MIN_CAPACITY)，不足时几何翻倍，翻倍仍不足或
// 已越过半程时直接取 needed。不修改列表，也不分配。
fn list_next_capacity(value *List, needed u64) u64 {
    let maximum u64 = list_max_count(value)
    if (maximum == 0) {
        return 0
    }
    let next u64 = value.capacity
    if (next < LIST_MIN_CAPACITY) {
        next = LIST_MIN_CAPACITY
    }
    if (next < needed) {
        if (next > maximum / 2) {
            next = needed
        } else {
            next = next * 2
            if (next < needed) {
                next = needed
            }
        }
    }
    if (next < needed || next > maximum) {
        return 0
    }
    return next
}

// list_ensure 把容量保证到至少 needed 个元素；成功后换新块并释放旧块。
// 返回 status_ok 表示容量已足够；invalid_argument/overflow/out_of_memory
// 表示失败，失败时 data、capacity、count 与内容都不变（D7 失败原子性）。
// 成功扩容会搬移元素，此前派生的指针全部失效。
fn list_ensure(value *List, needed u64) Status {
    if (value == 0 || value.element_size == 0) {
        return Status.status_invalid_argument
    }
    if (needed <= value.capacity) {
        return Status.status_ok
    }
    let next u64 = list_next_capacity(value, needed)
    if (next == 0) {
        return Status.status_overflow
    }
    let data *u8 = memory.alloc(next * value.element_size).to_type(*u8)
    if (data == 0) {
        return Status.status_out_of_memory
    }
    if (value.count > 0) {
        memory.copy(data.to_type(*void), value.data.to_type(*void),
            value.count * value.element_size)
    }
    memory.release(value.data.to_type(*void))
    value.data = data
    value.capacity = next
    return Status.status_ok
}

// list_element 返回第 index 个元素的地址；不做边界检查，调用方负责保证
// value != 0、data != 0 且 index <= capacity（内部写入路径允许 index == count）。
fn list_element(value *List, index u64) *void {
    let offset u64 = index * value.element_size
    return (value.data + offset).to_type(*void)
}

// list_copy_overlap 把 source 起的 count 字节复制到 destination，允许重叠。
// 按地址先后选择前向/后向复制；destination == source 或 count == 0 直接返回。
// 模块内实现而非 libc.memmove：Windows 零 CRT 上 libc 的 @[extern]
// memset/memmove 会与 prelude 的运行时符号重复定义（lld-link duplicate symbol）。
fn list_copy_overlap(destination *void, source *void, count u64) void {
    if (count == 0 || destination == source) {
        return
    }
    let dst *u8 = destination.to_type(*u8)
    let src *u8 = source.to_type(*u8)
    if (destination.to_type(u64) < source.to_type(u64)) {
        let index u64 = 0
        for index < count {
            dst[index] = src[index]
            index += 1
        }
        return
    }
    let index u64 = count
    for index > 0 {
        index -= 1
        dst[index] = src[index]
    }
}

// list_swap 交换 left 与 right 指向的两块 width 字节元素存储；两块不得重叠。
fn list_swap(left *void, right *void, width u64) void {
    let first *u8 = left.to_type(*u8)
    let second *u8 = right.to_type(*u8)
    let index u64 = 0
    for index < width {
        let byte u8 = first[index]
        first[index] = second[index]
        second[index] = byte
        index += 1
    }
}

// list_zero 把 destination 起的 byte_count 个字节写成 0；不做分配、不检查
// 空指针（调用方保证存储有效）。
fn list_zero(destination *void, byte_count u64) void {
    let data *u8 = destination.to_type(*u8)
    let index u64 = 0
    for index < byte_count {
        data[index] = 0
        index += 1
    }
}

// list_build 把 source 起的 count 个元素复制成新列表；element_size 由调用方
// 给出（必须来自 sizeof(T)）。count == 0 返回不分配的有效空列表；步长为 0、
// source 为空或分配失败时返回失败结果，不留下半成品。
// source 与结果列表互不相同，source 可以是另一个列表的存储。
fn list_build(element_size u64, source *void, count u64) ListResult {
    if (element_size == 0) {
        return list_result_error(Status.status_invalid_argument)
    }
    let result List = make(element_size)
    if (count == 0) {
        return list_result_ok(result)
    }
    if (source == 0) {
        return list_result_error(Status.status_invalid_argument)
    }
    let status Status = list_ensure(&result, count)
    if (status != Status.status_ok) {
        return list_result_error(status)
    }
    memory.copy(result.data.to_type(*void), source, count * element_size)
    result.count = count
    return list_result_ok(result)
}

