module fmt

import string

// yh fmt 运行时：Value 构造器与分类读取（R0）。
//
// 构造器只建立浅值，不分配、不复制字符串；字符串类实参借用源字节。
// 同一数值按静态类型选择 of_int/of_i64/of_u64，渲染层据此决定有符号与宽度。

// empty_view 返回空借用视图；用于 NULL C 字符串与空文本。
fn empty_view() string.View {
    let value string.View
    value.data = 0
    value.count = 0
    return value
}

// view_of 把 NUL 结尾字面量转为借用视图；只用于模块内静态文本。
fn view_of(text *char) string.View {
    let viewed string.ViewResult = string.view_cstr(text)
    return viewed.value
}

