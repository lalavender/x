module fmt

import string

// yh fmt 运行时：f64 的 V spec 渲染（R2）。
//
// 支持 f/F 定点、e/E 科学计数、g/G 自动切换；默认 g、6 位有效数字。
// 浮点精度按 V 文档解释为“小数位数”：未带 f 类型时去掉无意义尾零，
// f/F 保留尾零。指数至少两位。
//
// 实现上限（ponytail）：定点路径先乘 10^p，scaled 超过 1e18 时返回
// status_unsupported；p 上限 17。后续要支持极大/极小定点再引入十进制
// 大数展开，不在此处堆复杂度。

// float_bits 通过同址指针读取 f64 位型；不分配内存。
fn float_bits(value f64) u64 {
    let holder f64 = value
    let raw *u64 = (&holder).to_type(*u64)
    return raw[0]
}

// float_is_nan 判断指数全 1 且尾数非 0。
fn float_is_nan(bits u64) int {
    let exponent u64 = (bits >> 52) & 2047
    let mantissa u64 = bits & 4503599627370495
    if (exponent == 2047 && mantissa != 0) {
        return 1
    }
    return 0
}

// float_is_inf 判断指数全 1 且尾数为 0。
fn float_is_inf(bits u64) int {
    let exponent u64 = (bits >> 52) & 2047
    let mantissa u64 = bits & 4503599627370495
    if (exponent == 2047 && mantissa == 0) {
        return 1
    }
    return 0
}

// float_negative 读取符号位。
fn float_negative(bits u64) int {
    let sign u64 = (bits >> 63) & 1
    return sign.to_type(int)
}

// pow10 返回 10^p；p 由调用方限制在 0..17。
fn pow10(p int) u64 {
    let value u64 = 1
    let i int = 0
    for i < p {
        value = value * 10
        i += 1
    }
    return value
}

// put_digits 从 buffer[at] 起正向写十进制数字；返回下一个下标。
fn put_digits(buffer *u8, at int, value u64) int {
    if (value == 0) {
        buffer[at] = '0'
        return at + 1
    }
    let divisor u64 = 1
    for value / divisor >= 10 {
        divisor = divisor * 10
    }
    let index int = at
    let rest u64 = value
    for 1 {
        let digit u64 = rest / divisor
        buffer[index] = (digit.to_type(int) + 48).to_type(u8)
        index += 1
        rest = rest % divisor
        if (divisor == 1) {
            break
        }
        divisor = divisor / 10
    }
    return index
}

// trim_fraction 去掉小数点后的尾零与空小数点；没有小数点时不动。
fn trim_fraction(buffer *u8, length int) int {
    let dot int = -1
    let i int = 0
    for i < length {
        if (buffer[i] == '.') {
            dot = i
            break
        }
        i += 1
    }
    if (dot < 0) {
        return length
    }
    let at int = length
    for at > dot + 1 && buffer[at - 1] == '0' {
        at -= 1
    }
    if (at == dot + 1) {
        at = dot
    }
    return at
}

// build_fixed 生成定点文本；scaled 超过 1e18 返回 -1。
fn build_fixed(buffer *u8, value f64, p int) int {
    let scale u64 = pow10(p)
    let scaled f64 = value * scale.to_type(f64)
    if (scaled > 1000000000000000000.0) {
        return -1
    }
    let rounded u64 = (scaled + 0.5).to_type(u64)
    let integer u64 = rounded / scale
    let fraction u64 = rounded % scale
    let at int = put_digits(buffer, 0, integer)
    if (p > 0) {
        buffer[at] = '.'
        at += 1
        let remainder u64 = fraction
        let i int = 0
        for i < p {
            remainder = remainder * 10
            let digit u64 = remainder / scale
            buffer[at] = (digit.to_type(int) + 48).to_type(u8)
            at += 1
            remainder = remainder % scale
            i += 1
        }
    }
    return at
}

// normalize_exp 把 value 归一化到 [1,10) 并返回十进制指数。
fn normalize_exp(value *f64) int {
    let mantissa f64 = value[0]
    let exponent int = 0
    for mantissa >= 10.0 {
        mantissa = mantissa / 10.0
        exponent += 1
    }
    for mantissa < 1.0 && mantissa > 0.0 {
        mantissa = mantissa * 10.0
        exponent -= 1
    }
    value[0] = mantissa
    return exponent
}

// build_scientific 生成科学计数文本；mantissa 已归一化，trim 控制尾零。
fn build_scientific(buffer *u8, mantissa_value f64, exponent_value int,
    p int, upper int, trim int) int {
    let scale u64 = pow10(p)
    let scaled f64 = mantissa_value * scale.to_type(f64)
    let rounded u64 = (scaled + 0.5).to_type(u64)
    let first u64 = rounded / scale
    let fraction u64 = rounded % scale
    let exponent int = exponent_value
    let leading u64 = first
    let rest u64 = fraction
    if (leading >= 10) {
        leading = 1
        rest = 0
        exponent += 1
    }
    buffer[0] = (leading.to_type(int) + 48).to_type(u8)
    let at int = 1
    if (p > 0) {
        buffer[at] = '.'
        at += 1
        let remainder u64 = rest
        let i int = 0
        for i < p {
            remainder = remainder * 10
            let digit u64 = remainder / scale
            buffer[at] = (digit.to_type(int) + 48).to_type(u8)
            at += 1
            remainder = remainder % scale
            i += 1
        }
    }
    if (trim != 0) {
        at = trim_fraction(buffer, at)
    }
    if (upper != 0) {
        buffer[at] = 'E'
    } else {
        buffer[at] = 'e'
    }
    at += 1
    let exp int = exponent
    if (exp < 0) {
        buffer[at] = '-'
        exp = 0 - exp
    } else {
        buffer[at] = '+'
    }
    at += 1
    let digits [8]u8
    let count int = put_digits(&digits[0], 0, exp.to_type(u64))
    if (count < 2) {
        buffer[at] = '0'
        at += 1
    }
    let i int = 0
    for i < count {
        buffer[at] = digits[i]
        at += 1
        i += 1
    }
    return at
}

// append_float_body 给已生成的数字文本加符号、宽度与零补齐。
fn append_float_body(target *string.String, buffer *u8, length int,
    negative int, spec format_spec) Status {
    let sign u8 = 0
    let sign_len int = 0
    if (negative != 0) {
        sign = '-'
        sign_len = 1
    } else {
        if (spec.plus != 0) {
            sign = '+'
            sign_len = 1
        }
    }
    let total int = length + sign_len
    let pad int = spec.width - total
    if (pad < 0) {
        pad = 0
    }
    let body string.ViewResult = string.view_bytes(buffer, length.to_type(u64))
    if (body.status != string.status_ok) {
        return Status.status_other
    }
    let status Status = Status.status_ok
    if (spec.minus != 0) {
        if (sign_len != 0) {
            status = append_byte_status(target, sign)
            if (status != Status.status_ok) { return status }
        }
        status = append_text(target, body.value)
        if (status != Status.status_ok) { return status }
        return append_fill(target, ' ', pad)
    }
    if (spec.zero != 0) {
        if (sign_len != 0) {
            status = append_byte_status(target, sign)
            if (status != Status.status_ok) { return status }
        }
        status = append_fill(target, '0', pad)
        if (status != Status.status_ok) { return status }
        return append_text(target, body.value)
    }
    status = append_fill(target, ' ', pad)
    if (status != Status.status_ok) { return status }
    if (sign_len != 0) {
        status = append_byte_status(target, sign)
        if (status != Status.status_ok) { return status }
    }
    return append_text(target, body.value)
}

// append_float 按 V spec 追加 f64；NaN/Inf 走文本路径。
fn append_float(target *string.String, value f64, spec format_spec) Status {
    let type_byte u8 = effective_type(Kind.kind_f64, spec.type)
    let upper int = 0
    if (type_byte == 'F' || type_byte == 'E' || type_byte == 'G') {
        upper = 1
    }
    let bits u64 = float_bits(value)
    if (float_is_nan(bits) != 0) {
        return append_text_value(target, view_of("NaN"), spec)
    }
    if (float_is_inf(bits) != 0) {
        if (float_negative(bits) != 0) {
            return append_text_value(target, view_of("-Inf"), spec)
        }
        return append_text_value(target, view_of("+Inf"), spec)
    }
    let negative int = float_negative(bits)
    let magnitude f64 = value
    if (negative != 0) {
        magnitude = 0.0 - magnitude
    }
    let buffer [96]u8
    let length int = 0
    // 零没有可归一化的指数；f/F 保留固定小数位，其余类型输出 0。
    if (magnitude == 0.0) {
        if (type_byte == 'f' || type_byte == 'F') {
            let zero_p int = 6
            if (spec.has_precision != 0) {
                zero_p = spec.precision
            }
            if (zero_p > 17) {
                return Status.status_unsupported
            }
            length = build_fixed(&buffer[0], 0.0, zero_p)
            return append_float_body(target, &buffer[0], length, negative, spec)
        }
        buffer[0] = '0'
        return append_float_body(target, &buffer[0], 1, negative, spec)
    }
    if (type_byte == 'f' || type_byte == 'F') {
        let p int = 6
        if (spec.has_precision != 0) {
            p = spec.precision
        }
        if (p > 17) {
            return Status.status_unsupported
        }
        length = build_fixed(&buffer[0], magnitude, p)
        if (length < 0) {
            return Status.status_unsupported
        }
        return append_float_body(target, &buffer[0], length, negative, spec)
    }
    if (type_byte == 'e' || type_byte == 'E') {
        let p int = 6
        if (spec.has_precision != 0) {
            p = spec.precision
        }
        if (p > 17) {
            return Status.status_unsupported
        }
        let mantissa f64 = magnitude
        let exponent int = normalize_exp(&mantissa)
        length = build_scientific(&buffer[0], mantissa, exponent, p, upper, 1)
        return append_float_body(target, &buffer[0], length, negative, spec)
    }
    // g/G：默认 6 位有效数字；给出 precision 时视为小数位数。
    let mantissa f64 = magnitude
    let exponent int = normalize_exp(&mantissa)
    if (spec.has_precision == 0) {
        if (exponent < -4 || exponent >= 6) {
            length = build_scientific(&buffer[0], mantissa, exponent, 5, upper, 1)
        } else {
            let p int = 6 - (exponent + 1)
            if (p < 0) {
                p = 0
            }
            length = build_fixed(&buffer[0], magnitude, p)
            if (length < 0) {
                return Status.status_unsupported
            }
            length = trim_fraction(&buffer[0], length)
        }
        return append_float_body(target, &buffer[0], length, negative, spec)
    }
    let p int = spec.precision
    if (p > 17) {
        return Status.status_unsupported
    }
    if (exponent < -4 || exponent >= 6) {
        length = build_scientific(&buffer[0], mantissa, exponent, p, upper, 1)
    } else {
        length = build_fixed(&buffer[0], magnitude, p)
        if (length < 0) {
            return Status.status_unsupported
        }
        length = trim_fraction(&buffer[0], length)
    }
    return append_float_body(target, &buffer[0], length, negative, spec)
}
