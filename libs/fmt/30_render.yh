module fmt

import string

// yh fmt 运行时：V spec 渲染与追加入口（R1）。
//
// 支持整数 d/x/X/o/b、字符串 s、bool 的 width/- 与整数 flags -0+；
// f64 的默认渲染仍在 R2，返回 status_unsupported。格式非法返回
// status_invalid_spec，不输出半成品（目标 String 可能保留之前追加的内容，
// 这是 append 契约的一部分）。

// map_status 把 string 的失败分类映射到 fmt.Status；未列出的归入 other。
fn map_status(status string.Status) Status {
    if (status == string.status_ok) {
        return Status.status_ok
    }
    if (status == string.status_out_of_memory) {
        return Status.status_out_of_memory
    }
    if (status == string.status_overflow) {
        return Status.status_overflow
    }
    return Status.status_other
}

// append_text 把借用视图追加到目标 String；空文本不分配。
pub fn append_text(target *string.String, text string.View) Status {
    return map_status(string.append(target, text))
}

// append_byte_status 追加单字节并映射状态；用于符号与简单分隔。
fn append_byte_status(target *string.String, byte u8) Status {
    return map_status(string.append_byte(target, byte))
}

// append_fill 追加 count 个相同字节；width 上限 1,048,576，按 64 字节块输出。
fn append_fill(target *string.String, code u8, count int) Status {
    if (count <= 0) {
        return Status.status_ok
    }
    let buffer [64]u8
    let i int = 0
    for i < 64 {
        buffer[i] = code
        i += 1
    }
    let full string.ViewResult = string.view_bytes(&buffer[0], 64)
    if (full.status != string.status_ok) {
        return Status.status_other
    }
    let remaining int = count
    for remaining >= 64 {
        let status Status = append_text(target, full.value)
        if (status != Status.status_ok) {
            return status
        }
        remaining -= 64
    }
    if (remaining > 0) {
        let part string.ViewResult = string.view_bytes(&buffer[0],
            remaining.to_type(u64))
        if (part.status != string.status_ok) {
            return Status.status_other
        }
        return append_text(target, part.value)
    }
    return Status.status_ok
}

// effective_type 按 Value 分类补默认 type：整数 d、浮点 g、字符串 s。
fn effective_type(kind Kind, given u8) u8 {
    if (given != 0) {
        return given
    }
    if (kind == Kind.kind_int || kind == Kind.kind_uint) {
        return 'd'
    }
    if (kind == Kind.kind_f64) {
        return 'g'
    }
    if (kind == Kind.kind_str) {
        return 's'
    }
    return 0
}

// number_base 把 type 映射为进制；调用前已校验 type。
fn number_base(type_byte u8) int {
    if (type_byte == 'x' || type_byte == 'X') {
        return 16
    }
    if (type_byte == 'o') {
        return 8
    }
    if (type_byte == 'b') {
        return 2
    }
    return 10
}

// number_upper 判断十六进制是否使用大写字母。
fn number_upper(type_byte u8) int {
    if (type_byte == 'X') {
        return 1
    }
    return 0
}

// text_rune_count 按 UTF-8 标量数计宽；非法字节每个计 1，游标手动前进。
fn text_rune_count(text string.View) int {
    let cursor u64 = 0
    let count int = 0
    for cursor < text.count {
        let result string.RuneResult = string.utf8_next(text, &cursor)
        if (result.status == string.status_ok) {
            count += 1
            continue
        }
        count += 1
        cursor += 1
    }
    return count
}

// spec_valid_for 校验 flags/type/precision 与 Value 分类是否兼容。
fn spec_valid_for(kind Kind, spec format_spec) int {
    let type_byte u8 = effective_type(kind, spec.type)
    if (kind == Kind.kind_int || kind == Kind.kind_uint) {
        if (type_byte == 'd' || type_byte == 'x' || type_byte == 'X'
            || type_byte == 'o' || type_byte == 'b') {
            return 1
        }
        return 0
    }
    if (kind == Kind.kind_str) {
        if (type_byte != 's' || spec.has_precision != 0) {
            return 0
        }
        if (spec.zero != 0 || spec.plus != 0) {
            return 0
        }
        return 1
    }
    if (kind == Kind.kind_bool) {
        if (spec.type != 0 || spec.has_precision != 0) {
            return 0
        }
        if (spec.zero != 0 || spec.plus != 0) {
            return 0
        }
        return 1
    }
    if (kind == Kind.kind_f64) {
        if (type_byte == 'f' || type_byte == 'F' || type_byte == 'e'
            || type_byte == 'E' || type_byte == 'g' || type_byte == 'G') {
            return 1
        }
        return 0
    }
    return 0
}

// append_number 按进制与 flags 追加整数；negative 由调用方给出。
fn append_number(target *string.String, magnitude_value u64, negative int,
    kind Kind, spec format_spec) Status {
    let type_byte u8 = effective_type(kind, spec.type)
    let base int = number_base(type_byte)
    let upper int = number_upper(type_byte)
    let radix u64 = base.to_type(u64)
    let buffer [80]u8
    let magnitude u64 = magnitude_value
    let index int = 80
    for 1 {
        index -= 1
        let digit int = (magnitude % radix).to_type(int)
        let code int = 0
        if (digit < 10) {
            code = 48 + digit
        } else {
            if (upper != 0) {
                code = 55 + digit
            } else {
                code = 87 + digit
            }
        }
        buffer[index] = code.to_type(u8)
        magnitude = magnitude / radix
        if (magnitude == 0) {
            break
        }
    }
    let digits_len int = 80 - index
    let sign u8 = 0
    let sign_len int = 0
    if (negative != 0) {
        sign = '-'
        sign_len = 1
    } else {
        if (kind == Kind.kind_int && spec.plus != 0) {
            sign = '+'
            sign_len = 1
        }
    }
    let total int = digits_len + sign_len
    let pad int = spec.width - total
    if (pad < 0) {
        pad = 0
    }
    let digits string.ViewResult = string.view_bytes(&buffer[index],
        digits_len.to_type(u64))
    if (digits.status != string.status_ok) {
        return Status.status_other
    }
    let status Status = Status.status_ok
    if (spec.minus != 0) {
        if (sign_len != 0) {
            status = append_byte_status(target, sign)
            if (status != Status.status_ok) { return status }
        }
        status = append_text(target, digits.value)
        if (status != Status.status_ok) { return status }
        return append_fill(target, ' ', pad)
    }
    if (spec.zero != 0) {
        if (sign_len != 0) {
            status = append_byte_status(target, sign)
            if (status != Status.status_ok) { return status }
        }
        status = append_fill(target, '0', pad)
        if (status != Status.status_ok) { return status }
        return append_text(target, digits.value)
    }
    status = append_fill(target, ' ', pad)
    if (status != Status.status_ok) { return status }
    if (sign_len != 0) {
        status = append_byte_status(target, sign)
        if (status != Status.status_ok) { return status }
    }
    return append_text(target, digits.value)
}

// append_text_value 按 rune 宽度与 - 对齐追加字符串；调用前已校验 spec。
fn append_text_value(target *string.String, text string.View,
    spec format_spec) Status {
    let width int = text_rune_count(text)
    let pad int = spec.width - width
    if (pad < 0) {
        pad = 0
    }
    let status Status = Status.status_ok
    if (spec.minus != 0) {
        status = append_text(target, text)
        if (status != Status.status_ok) { return status }
        return append_fill(target, ' ', pad)
    }
    status = append_fill(target, ' ', pad)
    if (status != Status.status_ok) { return status }
    return append_text(target, text)
}

// append_bool_value 按 width/- 追加 true/false；调用前已校验 spec。
fn append_bool_value(target *string.String, value bool,
    spec format_spec) Status {
    if (value) {
        return append_text_value(target, view_of("true"), spec)
    }
    return append_text_value(target, view_of("false"), spec)
}

// append_value 解析 spec 并按 Value 分类追加渲染结果。
pub fn append_value(target *string.String, value Value, spec string.View) Status {
    let parsed spec_result = parse_spec(spec)
    if (parsed.status != Status.status_ok) {
        return Status.status_invalid_spec
    }
    if (value.kind == Kind.kind_invalid) {
        return append_text(target, view_of("<nil>"))
    }
    if (spec_valid_for(value.kind, parsed.spec) == 0) {
        return Status.status_invalid_spec
    }
    if (value.kind == Kind.kind_int) {
        let magnitude u64 = value.integer.to_type(u64)
        let negative int = 0
        if (value.integer < 0) {
            negative = 1
            magnitude = 0 - magnitude
        }
        return append_number(target, magnitude, negative, Kind.kind_int,
            parsed.spec)
    }
    if (value.kind == Kind.kind_uint) {
        return append_number(target, value.number, 0, Kind.kind_uint,
            parsed.spec)
    }
    if (value.kind == Kind.kind_bool) {
        return append_bool_value(target, value.truth, parsed.spec)
    }
    if (value.kind == Kind.kind_str) {
        return append_text_value(target, value.text, parsed.spec)
    }
    if (value.kind == Kind.kind_f64) {
        // 语法与类型已校验；默认 g/f/e 的数值渲染在 R2 接通。
        return Status.status_unsupported
    }
    return Status.status_other
}
