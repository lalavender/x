module fmt

import string

// yh fmt 运行时：公开模型、状态与结果类型（R0）。
//
// 本文件只放类型与常量；构造器在 10_value.yh，渲染与追加在 30_render.yh。
// 设计见 docs/03-design/yh-fmt标准库设计-2026-10-23.md，分期见
// docs/02-plan/yh-fmt标准库实施方案-2026-10-23.md。
//
// 实现约束：
//   * Value 浅拷贝；字符串借用 View，不拥有存储，调用期间源必须存活。
//   * pub struct 的字段一律公开（语言规则），布局不是接口；只用构造器。
//   * 零值 Value 的 kind 为 kind_invalid，等价 nil 实参。
//   * 失败不写全局错误状态，经 Status/TextResult 返回。

// Kind 是 Value 的载荷分类；kind_invalid 是零值，渲染为 <nil>。
pub enum Kind {
    kind_invalid
    kind_int
    kind_uint
    kind_f64
    kind_bool
    kind_str
}

// Value 是一次格式化的实参；text 借用源字节，不复制。
pub struct Value {
    kind Kind
    integer i64
    number u64
    real f64
    truth bool
    text string.View
}

// Status 是渲染/追加的失败分类；status_unsupported 表示该类型尚未实现
// 默认渲染（当前仅 f64，R2 接通后不再出现）。
pub enum Status {
    status_ok
    status_out_of_memory
    status_overflow
    status_invalid_spec
    status_unsupported
    status_other
}

// TextResult 返回独占字符串；失败时 value 为零句柄，无需清理半成品。
pub struct TextResult {
    status Status
    value string.String
}
