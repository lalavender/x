module cli

// cli 分层解析（CLI3）：普通/混合模式、known 部分解析、子命令分派与
// 初始命名空间。整次解析（含子命令层）共享一个结果命名空间，
// 显式 action 按 token 顺序写入，默认值按「父 → 子」顺序合成。

// ctx_record_unparsed 按输入顺序记录一个未消费 token；失败返回 -1。
fn ctx_record_unparsed(ctx *parse_ctx, token *char) int {
    if (ctx.unparsed == 0 || ctx.unparsed.count >= MAX_ARGC) {
        return -1
    }
    let owner *result_owner = owner_of(ctx.result)
    if (owner == 0) {
        return -1
    }
    ctx.unparsed.items[ctx.unparsed.count] = pool_dup(&owner.mem, token)
    ctx.unparsed.count += 1
    return 0
}

// ctx_push_path 把选中的规范命令名追加到命令路径；失败返回 -1。
fn ctx_push_path(ctx *parse_ctx, name *char) int {
    if (ctx.path == 0 || ctx.path.count >= MAX_DEPTH) {
        return -1
    }
    let owner *result_owner = owner_of(ctx.result)
    if (owner == 0) {
        return -1
    }
    ctx.path.items[ctx.path.count] = pool_dup(&owner.mem, name)
    ctx.path.count += 1
    return 0
}

// short_cluster_known 试扫描一个短选项组合：只有整个 token 都能识别、
// 且需要值的选项能取到值时返回 1；否则返回 0（known 模式整 token 保留）。
fn short_cluster_known(state *parser_state, args []*char, cursor int, token *char) int {
    let pos int = 1
    let scan_cursor int = cursor
    for token[pos] != 0 {
        let short_name [MAX_NAMES]char
        short_name[0] = token[0]
        short_name[1] = token[pos]
        short_name[2] = 0
        let row_index int = match_option_row(state, &short_name[0])
        if (row_index < 0) {
            return 0
        }
        let row *arg_row = &state.rows[row_index]
        if (action_is_zero_value(row.action) == 0 || row_max_values(row) != 0) {
            if (token[pos + 1] != 0) {
                return 1
            }
            if (scan_cursor + 1 >= len(args)) {
                return 0
            }
            let candidate *char = args[scan_cursor + 1]
            if (token_is_option_like(state, candidate) != 0
                || cstr_equal(candidate, "--") != 0) {
                return 0
            }
            return 1
        }
        pos += 1
    }
    return 1
}

// option_token_layer 识别并处理一个选项 token（含 known 保留）；
// 0 继续、-1 终止解析。
fn option_token_layer(ctx *parse_ctx, state *parser_state, args []*char,
    cursor *int) int {
    let result *Result = ctx.result
    let token *char = args[*cursor]
    let name_buffer [MAX_TEXT]char
    let name *char = token
    let attached *char = 0
    let has_attached int = 0
    let eq int = token_has_equal(token)
    if (eq >= 0) {
        if (eq >= MAX_TEXT) {
            result_set_error(result, ResultStatus.usage_error, "usage_error",
                "选项名过长", 0, 0, *cursor)
            return -1
        }
        let j int = 0
        for j < eq {
            name_buffer[j] = token[j]
            j += 1
        }
        name_buffer[eq] = 0
        name = &name_buffer[0]
        attached = token + eq + 1
        has_attached = 1
    }
    let row_index int = match_option_row(state, name)
    if (row_index < 0 && state.allow_abbrev != 0 && name_is_long(state, name) != 0) {
        let hits int = 0
        row_index = match_long_abbrev(state, name, &hits)
        if (row_index < 0 && hits > 1) {
            result_set_error(result, ResultStatus.usage_error, "usage_error",
                "选项缩写有多个候选", name, 0, *cursor)
            return -1
        }
    }
    if (row_index >= 0) {
        return consume_option(state, result, args, cursor, row_index,
            has_attached, attached, name)
    }
    if (name_is_long(state, token) == 0
        && is_prefix_char(state.prefix_chars, token[0].to_type(int)) != 0) {
        if (short_cluster_known(state, args, *cursor, token) != 0) {
            return consume_short_cluster(state, result, args, cursor, token)
        }
    }
    if (ctx.config.known == true) {
        if (ctx_record_unparsed(ctx, token) != 0) {
            result_set_error(result, ResultStatus.resource_error, "resource_error",
                "保留未知参数时内存不足", 0, 0, *cursor)
            return -1
        }
        return 0
    }
    if (state.suggest_on_error != 0) {
        let suggestion *char = suggest_option(state, name)
        if (suggestion != 0) {
            let buffer [MAX_HELP]char
            let at int = put_text(&buffer[0], 0, "未知选项；是否想用 ")
            at = put_text(&buffer[0], at, suggestion)
            at = put_text(&buffer[0], at, "？")
            if (at > 0) {
                buffer[at] = 0
                result_set_error(result, ResultStatus.usage_error, "usage_error",
                    &buffer[0], token, 0, *cursor)
                return -1
            }
        }
    }
    result_set_error(result, ResultStatus.usage_error, "usage_error",
        "未知选项", token, 0, *cursor)
    return -1
}

// dispatch_command 选中子命令并递归解析剩余 token；0 成功、-1 已记录错误。
fn dispatch_command(ctx *parse_ctx, state *parser_state, args []*char,
    cursor int, depth int) int {
    let token *char = args[cursor]
    let index int = find_child(state, token)
    if (index < 0) {
        result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
            "未知子命令", token, 0, cursor)
        return -1
    }
    let child *child_row = &state.children[index]
    if (ctx_push_path(ctx, child.name) != 0) {
        result_set_error(ctx.result, ResultStatus.resource_error, "resource_error",
            "记录命令路径时内存不足", 0, 0, cursor)
        return -1
    }
    if (state.slot_dest != 0 && state.slot_dest[0] != 0) {
        if (write_named_text(ctx.result, state.slot_dest, child.name) != 0) {
            result_set_error(ctx.result, ResultStatus.resource_error, "resource_error",
                "写入子命令名时内存不足", 0, state.slot_dest, cursor)
            return -1
        }
    }
    ctx.chain_slot[depth] = 1
    let child_state *parser_state = child.state.to_type(*parser_state)
    return parse_layer(ctx, child_state, args[cursor + 1..len(args)], depth + 1)
}

// parse_layer 解析一层输入（根或某个子命令）；0 成功、-1 已记录错误。
// 选中子命令后剩余的 token 全部交给子层，父层不再处理。
fn parse_layer(ctx *parse_ctx, state *parser_state, args []*char, depth int) int {
    if (depth >= MAX_DEPTH) {
        result_set_error(ctx.result, ResultStatus.config_error, "config_error",
            "子命令嵌套超过本版本上限", 0, 0, -1)
        return -1
    }
    ctx.chain[ctx.chain_count] = state
    ctx.chain_slot[ctx.chain_count] = 0
    ctx.chain_count += 1
    let mixed int = (ctx.config.mode == ParseMode.intermixed).to_type(int)
    let options_ended int = 0
    let positional_cursor int = 0
    let collected [MAX_ARGC]*char
    let collected_count int = 0
    let cursor int = 0
    for cursor < len(args) {
        let token *char = args[cursor]
        if (token == 0) {
            result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
                "参数切片含空指针", 0, 0, cursor)
            return -1
        }
        if (options_ended == 0 && cstr_equal(token, "--") != 0) {
            options_ended = 1
            cursor += 1
            continue
        }
        if (options_ended == 0 && token_is_option_like(state, token) != 0) {
            if (option_token_layer(ctx, state, args, &cursor) != 0) {
                return -1
            }
            if (ctx.result.status != ResultStatus.ok) {
                return 0
            }
            cursor += 1
            continue
        }
        // 混合模式：位置 token 先收集，扫描结束后整体匹配。
        if (mixed != 0) {
            if (collected_count < MAX_ARGC) {
                collected[collected_count] = token
                collected_count += 1
            }
            cursor += 1
            continue
        }
        let row_index int = nth_positional(state, positional_cursor)
        if (row_index >= 0) {
            let row *arg_row = &state.rows[row_index]
            if (effective_arity_kind(row) == ArityKind.arity_remainder.to_type(int)) {
                let rest int = len(args) - cursor
                if (rest > MAX_ARGC) {
                    result_set_error(ctx.result, ResultStatus.resource_error,
                        "resource_error", "remainder 收集的参数个数超过本版本上限",
                        0, row.dest, cursor)
                    return -1
                }
                let converted [MAX_ARGC]Value
                let n int = convert_tokens(ctx.result, row, args[cursor..len(args)], &converted[0], cursor)
                if (n < 0) {
                    return -1
                }
                if (commit_or_error(ctx.result, row, converted[0..n]) != 0) {
                    return -1
                }
                positional_cursor += 1
                cursor = len(args)
                break
            }
            let segment [MAX_ARGC]*char
            let segment_count int = 0
            for cursor < len(args) && segment_count < MAX_ARGC {
                let candidate *char = args[cursor]
                if (candidate == 0) {
                    result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
                        "参数切片含空指针", 0, 0, cursor)
                    return -1
                }
                if (options_ended == 0 && cstr_equal(candidate, "--") != 0) {
                    break
                }
                if (options_ended == 0 && token_is_option_like(state, candidate) != 0) {
                    break
                }
                segment[segment_count] = candidate
                segment_count += 1
                cursor += 1
            }
            if (segment_count == 0) {
                break
            }
            let unused int = 0
            if (assign_positional_segment(state, ctx.result, segment[0..segment_count],
                    &positional_cursor, &unused) != 0) {
                return -1
            }
            cursor -= unused
            if (unused == segment_count) {
                return tail_layer(ctx, state, args, &cursor)
            }
            continue
        }
        return tail_layer(ctx, state, args, &cursor)
    }
    // 主循环正常结束表示本层输入已消费完；槽必需性与必需项交给收尾检查。
    if (mixed != 0 && collected_count > 0) {
        let unused int = 0
        if (assign_positional_segment(state, ctx.result, collected[0..collected_count],
                &positional_cursor, &unused) != 0) {
            return -1
        }
        if (unused > 0) {
            if (nth_positional(state, positional_cursor) >= 0) {
                result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
                    "位置参数数量不匹配", 0, 0, -1)
                return -1
            }
            if (state.slot_used != 0) {
                return dispatch_command(ctx, state,
                    collected[collected_count - unused..collected_count], 0, depth)
            }
            if (ctx.config.known == true) {
                let k int = collected_count - unused
                for k < collected_count {
                    ctx_record_unparsed(ctx, collected[k])
                    k += 1
                }
                return 0
            }
            result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
                "多余的位置参数", collected[collected_count - unused], 0, -1)
            return -1
        }
    }
    return 0
}

// tail_layer 处理「本层没有更多位置参数可分配」的剩余 token：
// 子命令槽 → 分派；known → 保留；否则多余位置参数错误。
fn tail_layer(ctx *parse_ctx, state *parser_state, args []*char,
    cursor *int) int {
    if (*cursor >= len(args)) {
        return 0
    }
    if (state.slot_used != 0) {
        return dispatch_command(ctx, state, args, *cursor, ctx.chain_count - 1)
    }
    if (ctx.config.known == true) {
        let at int = *cursor
        for at < len(args) {
            if (ctx_record_unparsed(ctx, args[at]) != 0) {
                result_set_error(ctx.result, ResultStatus.resource_error,
                    "resource_error", "保留未知参数时内存不足", 0, 0, at)
                return -1
            }
            at += 1
        }
        *cursor = at
        return 0
    }
    result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
        "多余的位置参数", args[*cursor], 0, *cursor)
    return -1
}

// check_intermixed_support 校验混合模式的声明兼容性；0 可用、-1 已记录错误。
fn check_intermixed_support(ctx *parse_ctx, state *parser_state) int {
    let result *Result = ctx.result
    if (state.slot_used != 0) {
        result_set_error(result, ResultStatus.config_error, "config_error",
            "混合模式不支持子命令", 0, 0, -1)
        return -1
    }
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0
            && effective_arity_kind(row) == ArityKind.arity_remainder.to_type(int)) {
            result_set_error(result, ResultStatus.config_error, "config_error",
                "混合模式不支持 remainder", 0, row.dest, -1)
            return -1
        }
        i += 1
    }
    // 同一 dest 不能同时由选项与位置参数提供：两种模式的 action 次序无法同时保持。
    i = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0) {
            let j int = i + 1
            for j < state.row_count {
                let other *arg_row = &state.rows[j]
                if (other.used != 0 && cstr_equal(row.dest, other.dest) != 0
                    && row.positional != other.positional) {
                    result_set_error(result, ResultStatus.config_error, "config_error",
                        "混合模式下同一 dest 不能同时由选项与位置参数提供",
                        0, row.dest, -1)
                    return -1
                }
                j += 1
            }
        }
        i += 1
    }
    // 互斥组不能同时含选项与位置成员。
    i = 0
    for i < state.mutex_count {
        let group *mutex_row = &state.mutexes[i]
        if (group.used != 0) {
            let has_option int = 0
            let has_positional int = 0
            let j int = 0
            for j < state.row_count {
                let row *arg_row = &state.rows[j]
                if (row.used != 0 && row.mutex == group.id) {
                    if (row.positional != 0) {
                        has_positional = 1
                    } else {
                        has_option = 1
                    }
                }
                j += 1
            }
            if (has_option != 0 && has_positional != 0) {
                result_set_error(result, ResultStatus.config_error, "config_error",
                    "混合模式不支持同时含选项与位置成员的互斥组", 0, 0, -1)
                return -1
            }
        }
        i += 1
    }
    return 0
}

// finish_layers 按「父 → 子」收尾：子命令槽必需性、必需项、互斥组，
// 然后合成默认值（子层默认覆盖父层默认，不覆盖显式值与 initial）。
fn finish_layers(ctx *parse_ctx) int {
    let i int = 0
    for i < ctx.chain_count {
        let state *parser_state = ctx.chain[i]
        if (state.slot_used != 0 && state.slot_required != 0 && ctx.chain_slot[i] == 0) {
            result_set_error(ctx.result, ResultStatus.usage_error, "usage_error",
                "必须选择一个子命令", 0, state.slot_dest, -1)
            return -1
        }
        if (check_required_after_parse(state, ctx.result) != 0) {
            return -1
        }
        if (check_mutex_layer(state, ctx.result) != 0) {
            return -1
        }
        i += 1
    }
    i = 0
    for i < ctx.chain_count {
        apply_defaults(ctx.chain[i], ctx.result)
        if (ctx.result.status != ResultStatus.ok) {
            return -1
        }
        i += 1
    }
    return 0
}

// parse_with_config 按给定配置解析，并在失败时补上 usage 与展示名，
// 让 Result 级 render 不依赖 parser 仍然可用。
fn parse_with_config(p *Parser, args []*char, config ParseConfig) Result {
    let result Result = parse_core(p, args, config)
    if (result.status != ResultStatus.ok
        && result.status != ResultStatus.help_requested
        && result.status != ResultStatus.version_requested) {
        let state *parser_state = parser_state_of(p)
        let owner *result_owner = owner_of(&result)
        if (state != 0 && owner != 0) {
            if (result.usage_text == 0) {
                result.usage_text = build_usage_text(state, &owner.mem)
            }
            if (result.prog_text == 0) {
                result.prog_text = pool_dup(&owner.mem, state.prog)
            }
        }
    }
    return result
}

// parse_core 是解析主体；入口由 parse_with_config 包装。
fn parse_core(p *Parser, args []*char, config ParseConfig) Result {
    let result Result = new_result()
    if (result.owner == 0) {
        return result
    }
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        result_set_error(&result, ResultStatus.config_error, "config_error",
            "parser 未初始化", 0, 0, -1)
        return result
    }
    if (freeze(p) != 0) {
        result_set_error(&result, ResultStatus.config_error, "config_error",
            "parser 配置无效，freeze 失败", 0, 0, -1)
        return result
    }
    let expanded []*char = expand_args(state, config, &result, args)
    if (result.status != ResultStatus.ok) {
        return result
    }
    if (config.initial != 0) {
        copy_initial_into(&result, config.initial)
    }
    let owner *result_owner = owner_of(&result)
    let path *command_path_block = pool_alloc(&owner.mem,
        sizeof(command_path_block).to_type(u64)).to_type(*command_path_block)
    let unparsed *token_list_block = pool_alloc(&owner.mem,
        sizeof(token_list_block).to_type(u64)).to_type(*token_list_block)
    if (path == 0 || unparsed == 0) {
        result_set_error(&result, ResultStatus.resource_error, "resource_error",
            "解析上下文分配失败", 0, 0, -1)
        return result
    }
    path.count = 0
    unparsed.count = 0
    let ctx parse_ctx
    ctx.result = &result
    ctx.config = config
    ctx.chain_count = 0
    ctx.path = path
    ctx.unparsed = unparsed
    if (config.mode == ParseMode.intermixed && check_intermixed_support(&ctx, state) != 0) {
        return result
    }
    if (parse_layer(&ctx, state, expanded, 0) != 0) {
        return result
    }
    if (result.status != ResultStatus.ok) {
        return result
    }
    if (finish_layers(&ctx) != 0) {
        return result
    }
    result.command_path = path.items[0..path.count]
    result.unparsed = unparsed.items[0..unparsed.count]
    return result
}

// parse 严格普通解析；参数切片不含程序名。
pub fn parse(p *Parser, args []*char) Result {
    return parse_with_config(p, args, parse_config())
}

// parse_known 普通解析并把未消费 token 按输入顺序保留在 unparsed。
pub fn parse_known(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.known = true
    return parse_with_config(p, args, config)
}

// parse_intermixed 跨选项收集位置参数的严格解析。
pub fn parse_intermixed(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.mode = ParseMode.intermixed
    return parse_with_config(p, args, config)
}

// parse_known_intermixed 混合解析并保留未消费 token。
pub fn parse_known_intermixed(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.mode = ParseMode.intermixed
    config.known = true
    return parse_with_config(p, args, config)
}

// parse_with 显式指定模式、known 与初始命名空间。
pub fn parse_with(p *Parser, args []*char, config ParseConfig) Result {
    return parse_with_config(p, args, config)
}

// parse_main 跳过 argv[0] 后用剩余参数严格解析。
pub fn parse_main(p *Parser, argc int, argv **char) Result {
    if (argv == 0 || argc < 0) {
        let result Result = new_result()
        result_set_error(&result, ResultStatus.config_error, "config_error",
            "argc/argv 无效", 0, 0, -1)
        return result
    }
    if (argc - 1 > MAX_ARGC) {
        let result Result = new_result()
        result_set_error(&result, ResultStatus.resource_error, "resource_error",
            "命令行参数个数超过本版本上限", 0, 0, -1)
        return result
    }
    let buffer [MAX_ARGC]*char
    let count int = 0
    let i int = 1
    for i < argc {
        buffer[count] = argv[i]
        count += 1
        i += 1
    }
    return parse_with_config(p, buffer[0..count], parse_config())
}
