module cli

// cli 值、命名空间与类型化查询（CLI1）：结果键的深复制、借用视图与查询。
// 所有文本和列表都在命名空间自己的池里，随 namespace_destroy / release 释放；
// 查询函数只返回借用视图，调用者不得单独释放。

// ns_state_of 从公开句柄取私有状态；空句柄返回空指针。
fn ns_state_of(ns *Namespace) *ns_state {
    if (ns == 0 || ns.handle == 0) {
        return 0
    }
    return ns.handle.to_type(*ns_state)
}

// entry_find 按 dest 查找键；找不到返回 -1。
fn entry_find(state *ns_state, dest *char) int {
    if (dest == 0) {
        return -1
    }
    let i int = 0
    for i < state.count {
        if (state.rows[i].used != 0 && cstr_equal(state.rows[i].dest, dest) != 0) {
            return i
        }
        i += 1
    }
    return -1
}

// entry_create 建键或取已有键；失败返回 -1，成功返回行下标。
fn entry_create(state *ns_state, dest *char) int {
    let existing int = entry_find(state, dest)
    if (existing >= 0) {
        return existing
    }
    if (state.count >= MAX_ENTRIES) {
        return -1
    }
    let row entry_row
    row.used = 1
    row.dest = pool_dup(&state.mem, dest)
    row.value = value_none()
    row.provided = 0
    row.occurrences = 0
    row.is_default = 0
    if (row.dest == 0) {
        return -1
    }
    state.rows[state.count] = row
    state.count += 1
    return state.count - 1
}

// value_clone 把值深复制到目标池：文本复制字节，列表复制元素（递归）。
fn value_clone(mem *pool, v Value) Value {
    let result Value
    result.kind = v.kind
    if (v.kind == ValueKind.text) {
        result.data.text = pool_dup(mem, v.data.text)
        return result
    }
    if (v.kind == ValueKind.sequence) {
        let source *list_block = v.data.items.to_type(*list_block)
        if (source == 0) {
            result.data.items = 0
            return result
        }
        let block *list_block = pool_alloc(mem,
            sizeof(list_block).to_type(u64)).to_type(*list_block)
        if (block == 0) {
            result.data.items = 0
            return result
        }
        block.count = 0
        let i int = 0
        for i < source.count {
            if (i >= MAX_LIST) {
                break
            }
            block.items[i] = value_clone(mem, source.items[i])
            block.count += 1
            i += 1
        }
        result.data.items = block.to_type(*void)
        return result
    }
    result.data = v.data
    return result
}

