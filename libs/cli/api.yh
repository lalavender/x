module cli

import os
import io
// ============================================================================
// api.yh —— cli 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// —— 诊断码（Diagnostic.code 的稳定取值）——
// 应用应按常量比较，不要依赖 message 文本；类别语义见设计 §14.3。
pub const CODE_CONFIG *char = "config_error"     // 声明无效或不受支持

pub const CODE_USAGE *char = "usage_error"       // 输入不满足声明

pub const CODE_RESOURCE *char = "resource_error" // 分配失败或参数文件读取失败

// ValueKind 标识 Value 当前使用的载荷成员；none 是显式空值。
pub enum ValueKind {
    none
    text
    integer
    natural
    real
    boolean
    sequence
}

// ValueData 只写入 Value.kind 对应的成员；items 指向模块私有的列表块。
pub union ValueData {
    text *char
    integer i64
    natural u64
    real f64
    boolean bool
    items *void
}

// Value 是带标签的值；文本和列表的所有权属于存入它的 parser 或命名空间。
pub struct Value {
    kind ValueKind
    data ValueData
}

// DefaultMode 表示参数未出现时的默认值策略。
pub enum DefaultMode {
    default_inherit   // 采用参数组或 parser 的策略，都没有时用 action 缺省
    default_explicit  // 使用给定值，包括显式 none
    default_suppress  // 参数未出现时不创建该键
}

// Default 由策略和值组成；mode=suppress 时 value 不读取。
pub struct Default {
    mode DefaultMode
    value Value
}

// Action 是内置参数行为；CLI1 实现 store 系列、count、help、version。
pub enum Action {
    store
    store_const
    store_true
    store_false
    append
    append_const
    extend
    count
    boolean_optional
    help
    version
    custom
}

// ArityKind 是数量模型的判别值；成员名加 arity_ 前缀以免与构造函数同名
// （枚举成员登记在模块全局名字表，同名声明不能共存）。
pub enum ArityKind {
    arity_infer
    arity_single
    arity_exactly
    arity_optional
    arity_zero_or_more
    arity_one_or_more
    arity_remainder
    arity_no_values
}

// Arity 描述参数消费值的数量；count 只在 arity_exactly 时有效。
pub struct Arity {
    kind ArityKind
    count int
}

// Diagnostic 是一条结构化诊断；文本由所属 parser 或结果持有。
pub struct Diagnostic {
    code *char        // 错误码；无错误时为空指针
    message *char     // 可读消息
    dest *char        // 相关 dest
    option *char      // 相关选项名
    token_index int   // 参数切片下标；无对应 token 时 -1
    file *char        // 参数文件路径；非文件来源为空指针
    line int          // 文件内行号；非文件来源为 -1
    column int        // 文件内列号；非文件来源为 -1
}

// ValueShape 描述自定义 action 的输出形状：叶子类型与列表层数。
pub struct ValueShape {
    leaf ValueKind
    depth int
}

// ConvertContext 是转换回调的输入与分配入口；context 是结果池句柄。
pub struct ConvertContext {
    token *char       // 原始 token，回调期间有效
    token_index int
    kind ValueKind    // 声明要求的目标类型
    context *void     // 结果池句柄，配 context_text 使用
}

// ActionContext 是自定义 action 的输入与分配入口。
pub struct ActionContext {
    argument int        // 参数 ID
    dest *char
    matched_name *char
    occurrences int     // 本参数此前的出现次数
    values []Value      // 本次转换得到的值
    previous Value      // 旧值；没有时为 none
    context *void
}

// LineContext 是参数文件逐行回调的输入。
pub struct LineContext {
    line *char        // 去换行后的原始字节行
    file *char
    line_number int
    context *void
}

// LineTokens 是逐行回调的输出 token 列表。
pub struct LineTokens {
    items []*char
}

// Argument 是一次参数声明；文本字段在 add_argument 时深复制。
pub struct Argument {
    name *char            // 主名称；位置参数只用它作 dest 与帮助名
    alias *char           // 选项别名；无别名时为空串
    dest *char            // 结果键名；空时由名称推导
    action Action         // 参数行为
    value_kind ValueKind  // 值类型；默认 text
    arity Arity           // 数量模型；默认 infer
    default_value Default // 缺省策略；默认 inherit
    const_value Value     // 零值/缺值时的常量；默认 none
    choices []Value       // 允许值的候选集合；空切片表示无约束
    required bool         // 选项是否必须显式出现
    help *char            // 帮助文本；空指针表示无
    hidden bool           // 是否从帮助中隐藏
    positional bool       // 是否为位置参数
    metavar *char         // 帮助占位名；空指针时按 dest 推导
    group int             // 展示组 ID；0 表示未分组
    mutex int             // 互斥组 ID；0 表示未加入
    converter fn(*ConvertContext, *Value, *Diagnostic, *void) int
    validator fn(Value, *Diagnostic, *void) int
    custom_action fn(*ActionContext, *Value, *Diagnostic, *void) int
    user *void            // 回调的用户指针，按借用保存
    type_name *char       // 已注册类型名；与 converter 互斥
    action_name *char     // 已注册 action 名；与 custom_action 互斥
    output_shape *ValueShape // 自定义 action 的输出形状；注册项可提供
    deprecated bool       // 是否标记为弃用（帮助中标注）
    version_text *char    // version action 的输出模板；空指针时输出 prog
    metavars []*char      // exactly(n) 的逐项占位名；与 metavar 不能同时设置
}

// Color 是帮助与诊断的颜色策略；auto 依赖终端检测，检测失败时无色降级。
pub enum Color {
    never
    automatic  // 对应设计的 auto；auto 是保留字，成员名改用 automatic
    always
}

// HelpFormat 是帮助文本的正交配置。
pub struct HelpFormat {
    preserve_description bool // 保留 description 的显式空行，只调整缩进
    preserve_all_text bool    // 说明文本整体保留空白
    show_defaults bool        // 在帮助里展示默认值
    metavar_from_type bool    // 无 metavar 时按值类型推导占位名
    width int                 // 目标宽度；0 表示不换行
    max_help_column int       // 说明文本起始列上限；0 表示按 width 推导
    section_positional *char  // 位置参数段标题；空指针用 "positional arguments"
    section_options *char     // 选项段标题；空指针用 "options"
    section_commands *char    // 子命令段标题；空指针用 "commands"
    usage_prefix *char        // usage 行前缀；空指针用 "usage: "
}

// Conflict 是重复名称的处理策略。
pub enum Conflict {
    error    // 重复名称是配置错误（缺省）
    resolve  // 从旧声明删除冲突名称，全部移除时停用旧声明
}

// ParseMode 是位置参数与选项的交错处理方式。
pub enum ParseMode {
    normal     // 按选项边界分段匹配位置参数（缺省）
    intermixed // 跨选项收集位置参数
}

// ParserConfig 是 parser 的推荐默认配置；全零初始化不等于推荐默认值。
pub struct ParserConfig {
    prog *char            // 展示名，必须非空
    usage *char           // 空指针自动生成；空串不显示 usage 正文
    description *char     // 描述；空指针或空串表示无
    epilog *char          // 结尾说明；空指针或空串表示无
    add_help bool         // 是否自动注册 -h/--help
    allow_abbrev bool     // 是否允许唯一长名称前缀（CLI2 实现）
    prefix_chars *char    // 选项前缀字符集合；默认 "-"
    argument_default Default // parser 级默认策略
    suggest_on_error bool // 错误时是否给候选建议（CLI5 实现）
    conflict Conflict     // 重复名称策略；缺省 error
    help_format HelpFormat // 帮助布局配置
    color Color           // 帮助与诊断颜色策略
    fromfile_prefix_chars *char // 参数文件前缀字符集合；空串关闭展开
    line_converter fn(*LineContext, *LineTokens, *Diagnostic, *void) int
    line_user *void       // 逐行回调的用户指针
}

// Subparsers 是子命令槽的配置；每个 parser 最多一个槽。
pub struct Subparsers {
    dest *char        // 非空时把选中命令的规范名存入 namespace
    title *char       // 帮助段标题；空指针时用 "commands"
    description *char // 帮助段说明
    metavar *char     // usage 占位名；空指针时用 {命令名列表}
    required bool     // 是否必须选择一个子命令
}

// Command 是一条子命令声明；aliases 指向借用数组，add_parser 时复制。
pub struct Command {
    name *char
    aliases []*char
    help *char
    deprecated bool
    config ParserConfig
}

// Group 是展示组配置；组内参数按注册顺序展示，不改变匹配顺序。
pub struct Group {
    title *char
    description *char
    argument_default Default
    conflict Conflict
}

// Namespace 保存 dest 到值的映射；既用于结果，也可独立构造为初始值。
pub struct Namespace {
    handle *void
}

// ParseConfig 是一次解析的配置：模式、known 与初始命名空间。
pub struct ParseConfig {
    mode ParseMode
    known bool
    initial *Namespace
    file_max_depth int   // 参数文件包含深度上限
    file_max_bytes int   // 参数文件累计读取字节上限
    file_max_tokens int  // 参数文件展开的 token 上限
}

// ResultStatus 是解析结果的状态类别。
pub enum ResultStatus {
    ok
    help_requested
    version_requested
    usage_error
    config_error
    resource_error
}

// Parser 是公开薄句柄；handle 指向模块私有状态，调用者不得改写。
pub struct Parser {
    handle *void
}

// Result 是一次解析的结果；values 随 release 一起释放。
pub struct Result {
    status ResultStatus
    values Namespace
    unparsed []*char      // 保留的未知 token（CLI3 起使用）
    warnings []*char      // 运行期警告（deprecated 等）；随 release 释放
    error Diagnostic      // 失败诊断
    control_text *char    // 帮助/版本文本，随结果释放
    usage_text *char      // 失败时的 usage 正文（render 写 error_fd 用）
    prog_text *char       // 失败时的展示名副本（render 的 "prog: 错误:" 前缀）
    command_path []*char  // 选中的规范命令路径（根到叶）
    owner *void           // 结果内部所有权句柄
}

// TextResult 是格式化文本的结果；text 随 release_text 释放。
pub struct TextResult {
    status ResultStatus
    text *char
    error Diagnostic
    owner *void
}

// value_none 返回显式空值；不分配。
pub fn value_none() Value {
    let v Value
    v.kind = ValueKind.none
    return v
}

// value_text 返回借用调用者字符串的文本值；不分配。
pub fn value_text(content *char) Value {
    let v Value
    v.kind = ValueKind.text
    v.data.text = content
    return v
}

// value_i64 返回 64 位有符号整数值。
pub fn value_i64(number i64) Value {
    let v Value
    v.kind = ValueKind.integer
    v.data.integer = number
    return v
}

// value_u64 返回 64 位无符号整数值。
pub fn value_u64(number u64) Value {
    let v Value
    v.kind = ValueKind.natural
    v.data.natural = number
    return v
}

// value_f64 返回 64 位浮点值。
pub fn value_f64(number f64) Value {
    let v Value
    v.kind = ValueKind.real
    v.data.real = number
    return v
}

// value_bool 返回布尔值。
pub fn value_bool(flag bool) Value {
    let v Value
    v.kind = ValueKind.boolean
    v.data.boolean = flag
    return v
}

// value_shape 构造自定义 action 的输出形状；depth 负数视为 0。
pub fn value_shape(leaf ValueKind, depth int) ValueShape {
    let shape ValueShape
    shape.leaf = leaf
    shape.depth = depth
    if (shape.depth < 0) {
        shape.depth = 0
    }
    return shape
}

// help_format 返回推荐帮助配置：宽度 80、自动换行、不显示默认值。
pub fn help_format() HelpFormat {
    let format HelpFormat
    format.preserve_description = false
    format.preserve_all_text = false
    format.show_defaults = false
    format.metavar_from_type = true
    format.width = 80
    format.max_help_column = 0
    format.section_positional = 0
    format.section_options = 0
    format.section_commands = 0
    format.usage_prefix = 0
    return format
}

// default_of 把值包装成 explicit 默认值。
pub fn default_of(value Value) Default {
    let d Default
    d.mode = DefaultMode.default_explicit
    d.value = value
    return d
}

// suppress_default 返回抑制策略的默认值：参数未出现时不创建键。
pub fn suppress_default() Default {
    let d Default
    d.mode = DefaultMode.default_suppress
    return d
}

// inherit_default 返回继承策略的默认值。
pub fn inherit_default() Default {
    let d Default
    d.mode = DefaultMode.default_inherit
    return d
}

// infer_arity 使用内置 action 的数量模型。
pub fn infer_arity() Arity {
    let a Arity
    a.kind = ArityKind.arity_infer
    return a
}

// single 恰好一个值，结果为标量。
pub fn single() Arity {
    let a Arity
    a.kind = ArityKind.arity_single
    return a
}

// exactly 恰好 count 个值（count >= 1），结果始终是列表。
pub fn exactly(count int) Arity {
    let a Arity
    a.kind = ArityKind.arity_exactly
    a.count = count
    return a
}

// optional 零或一个值，结果为标量；出现但无值时使用 const。
pub fn optional() Arity {
    let a Arity
    a.kind = ArityKind.arity_optional
    return a
}

// zero_or_more 零个或多个值，结果为列表。
pub fn zero_or_more() Arity {
    let a Arity
    a.kind = ArityKind.arity_zero_or_more
    return a
}

// one_or_more 至少一个值，结果为列表。
pub fn one_or_more() Arity {
    let a Arity
    a.kind = ArityKind.arity_one_or_more
    return a
}

// remainder 收集其后全部 token（含看起来像选项的），结果为列表。
pub fn remainder() Arity {
    let a Arity
    a.kind = ArityKind.arity_remainder
    return a
}

// no_values 显式声明零参数行为，仅供自定义 action。
pub fn no_values() Arity {
    let a Arity
    a.kind = ArityKind.arity_no_values
    return a
}

// parser_config 返回推荐默认配置；prog 必须非空。
pub fn parser_config(prog *char) ParserConfig {
    let config ParserConfig
    config.prog = prog
    config.usage = 0
    config.description = 0
    config.epilog = 0
    config.add_help = true
    config.allow_abbrev = false
    config.prefix_chars = "-"
    config.argument_default = inherit_default()
    config.suggest_on_error = false
    config.conflict = Conflict.error
    config.help_format = help_format()
    config.color = Color.never
    config.fromfile_prefix_chars = ""
    config.line_user = 0
    return config
}

// option 创建选项声明；无别名时 alias 传空串。
pub fn option(name *char, alias *char) Argument {
    let spec Argument = new_argument(name, 0)
    spec.alias = alias
    return spec
}

// positional 创建位置参数声明；名称同时用作 dest。
pub fn positional(name *char) Argument {
    return new_argument(name, 1)
}

// subparsers 创建子命令槽配置；默认不必需，dest/title/description/metavar 可后设。
pub fn subparsers() Subparsers {
    let spec Subparsers
    spec.dest = 0
    spec.title = 0
    spec.description = 0
    spec.metavar = 0
    spec.required = false
    return spec
}

// command 创建一条子命令声明；config 用 parser_config(name) 得到推荐默认值。
pub fn command(name *char) Command {
    let spec Command
    spec.name = name
    let no_aliases []*char
    spec.aliases = no_aliases
    spec.help = 0
    spec.deprecated = false
    spec.config = parser_config(name)
    return spec
}

// group 创建展示组配置；conflict 缺省 error，由 add_group 使用。
pub fn group(title *char, description *char) Group {
    let spec Group
    spec.title = title
    spec.description = description
    spec.argument_default = inherit_default()
    spec.conflict = Conflict.error
    return spec
}

// parse_config 返回推荐解析配置：normal、known=false、无初始值。
pub fn parse_config() ParseConfig {
    let config ParseConfig
    config.mode = ParseMode.normal
    config.known = false
    config.initial = 0
    config.file_max_depth = MAX_FILE_DEPTH
    config.file_max_bytes = MAX_FILE_BYTES
    config.file_max_tokens = MAX_FILE_TOKENS
    return config
}

// add_group 登记一个展示组；返回正数组 ID 或 -1。组不改变匹配顺序。
pub fn add_group(p *Parser, config Group) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    return add_group_internal(state, config.title, config.description,
        config.argument_default.mode.to_type(int), config.argument_default.value,
        config.conflict.to_type(int))
}

// add_mutex 登记一个互斥组；返回正数组 ID 或 -1。
pub fn add_mutex(p *Parser, required bool, group int) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    return add_mutex_internal(state, required, group)
}

// add_subparsers 登记子命令槽；返回正数槽 ID 或 -1。每个 parser 最多一个槽。
pub fn add_subparsers(p *Parser, spec Subparsers) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || state.failed != 0 || state.frozen != 0) {
        return -1
    }
    if (state.slot_used != 0) {
        return set_config_error(state, CODE_CONFIG, "每个 parser 最多一个子命令槽")
    }
    state.slot_used = 1
    state.slot_id = state.next_id
    state.next_id += 1
    state.slot_dest = pool_dup(&state.mem, spec.dest)
    state.slot_title = pool_dup(&state.mem, spec.title)
    state.slot_description = pool_dup(&state.mem, spec.description)
    state.slot_metavar = pool_dup(&state.mem, spec.metavar)
    state.slot_required = spec.required.to_type(int)
    if (state.mem.failed != 0) {
        return set_config_error(state, CODE_RESOURCE, "登记子命令槽时内存不足")
    }
    return state.slot_id
}

// add_parser 为子命令槽创建子 parser；返回归父 parser 所有的句柄或空指针。
pub fn add_parser(p *Parser, slot int, spec Command) *Parser {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || state.failed != 0 || state.frozen != 0) {
        return 0
    }
    if (state.slot_used == 0 || state.slot_id != slot) {
        return 0
    }
    if (spec.name == 0 || spec.name[0] == 0) {
        return 0
    }
    if (state.child_count >= MAX_CHILDREN) {
        return 0
    }
    if (find_child(state, spec.name) >= 0) {
        return 0
    }
    let alias_count int = len(spec.aliases)
    let a int = 0
    for a < alias_count {
        if (a >= MAX_ALIASES) {
            break
        }
        if (spec.aliases[a] == 0 || spec.aliases[a][0] == 0) {
            break
        }
        if (find_child(state, spec.aliases[a]) >= 0) {
            return 0
        }
        a += 1
    }
    let config ParserConfig = spec.config
    if (config.prog == 0 || cstr_equal(config.prog, spec.name) != 0) {
        let prog_buffer [MAX_TEXT]char
        if (build_sub_prog(&prog_buffer[0], state.prog, spec.name) < 0) {
            return 0
        }
        config.prog = &prog_buffer[0]
    }
    let child *parser_state = new_state(config, state)
    if (child == 0) {
        return 0
    }
    let row child_row
    row.used = 1
    row.name = pool_dup(&state.mem, spec.name)
    row.alias_count = 0
    let i int = 0
    for i < alias_count {
        if (i >= MAX_ALIASES) {
            break
        }
        if (spec.aliases[i] == 0 || spec.aliases[i][0] == 0) {
            break
        }
        row.aliases[row.alias_count] = pool_dup(&state.mem, spec.aliases[i])
        row.alias_count += 1
        i += 1
    }
    row.help = pool_dup(&state.mem, spec.help)
    row.deprecated = spec.deprecated.to_type(int)
    row.state = child.to_type(*void)
    row.handle.handle = child.to_type(*void)
    if (state.mem.failed != 0) {
        destroy_state(child)
        set_config_error(state, CODE_RESOURCE, "登记子命令时内存不足")
        return 0
    }
    state.children[state.child_count] = row
    state.child_count += 1
    return &state.children[state.child_count - 1].handle
}

// inherit 深复制 parent 的参数、默认值与组；0 成功、-1 失败。
// 不复制 parent 的 prog、输出策略或子命令树，也不允许自继承。
pub fn inherit(p *Parser, parent *Parser) int {
    let state *parser_state = parser_state_of(p)
    let source *parser_state = parser_state_of(parent)
    if (state == 0 || source == 0 || state == source) {
        return -1
    }
    if (state.failed != 0 || state.frozen != 0) {
        return -1
    }
    // 展示组：按旧 ID 建立「旧 → 新」映射。
    let group_map [MAX_GROUPS + 1]int
    let i int = 0
    for i <= MAX_GROUPS {
        group_map[i] = 0
        i += 1
    }
    i = 0
    for i < source.group_count {
        let row group_row = source.groups[i]
        if (row.used != 0) {
            let mapped int = add_group_internal(state, row.title, row.description,
                row.default_mode, row.default_value, row.conflict)
            if (mapped < 0) {
                return -1
            }
            group_map[row.id] = mapped
        }
        i += 1
    }
    let mutex_map [MAX_MUTEX + 1]int
    i = 0
    for i <= MAX_MUTEX {
        mutex_map[i] = 0
        i += 1
    }
    i = 0
    for i < source.mutex_count {
        let row mutex_row = source.mutexes[i]
        if (row.used != 0) {
            let mapped_group int = 0
            if (row.group != 0 && row.group <= MAX_GROUPS) {
                mapped_group = group_map[row.group]
            }
            let mapped int = add_mutex_internal(state, (row.required != 0), mapped_group)
            if (mapped < 0) {
                return -1
            }
            mutex_map[row.id] = mapped
        }
        i += 1
    }
    // 参数声明：按源顺序复制，额外名称用 add_alias 补上。
    i = 0
    for i < source.row_count {
        let row *arg_row = &source.rows[i]
        if (row.used != 0) {
            let spec Argument = argument_from_row(row)
            if (spec.group != 0 && spec.group <= MAX_GROUPS) {
                spec.group = group_map[spec.group]
            }
            if (spec.mutex != 0 && spec.mutex <= MAX_MUTEX) {
                spec.mutex = mutex_map[spec.mutex]
            }
            let id int = add_argument_internal(state, spec)
            if (id < 0) {
                return -1
            }
            let j int = 2
            for j < row.name_count {
                if (add_alias(p, id, row.names[j]) != 0) {
                    return -1
                }
                j += 1
            }
        }
        i += 1
    }
    // set_default 覆盖值同样复制（深复制进接收方池）。
    i = 0
    for i < source.override_count {
        if (source.overrides[i].used != 0) {
            if (set_default(p, source.overrides[i].dest, source.overrides[i].value) != 0) {
                return -1
            }
        }
        i += 1
    }
    return 0
}

// parse_main_or_exit 解析进程参数；仅在成功时返回结果，其余路径输出并退出。
// 帮助/版本退出码 0，使用错误 2，配置与资源错误 1；输出失败时退出码降级为 1。
pub fn parse_main_or_exit(p *Parser, argc int, argv **char) Result {
    let result Result = parse_main(p, argc, argv)
    if (result.status == ResultStatus.ok) {
        // 成功路径先输出运行期警告并清空，避免应用之后 render 时重复打印。
        render_warnings(&result, 2)
        clear_warnings(&result)
        return result
    }
    let code int = exit_code(&result)
    if (render(&result, 1, 2) != 0) {
        code = 1
    }
    release(&result)
    destroy(p)
    os.terminate(code)
    return result
}

// register_type 注册命名转换器；0 成功、-1 失败（粘滞配置错误）。
pub fn register_type(p *Parser, name *char,
    converter fn(*ConvertContext, *Value, *Diagnostic, *void) int, user *void) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || state.failed != 0 || state.frozen != 0) {
        return -1
    }
    if (name == 0 || name[0] == 0) {
        return set_config_error(state, CODE_CONFIG, "注册类型名不能为空")
    }
    if (converter.to_type(*void) == 0) {
        return set_config_error(state, CODE_CONFIG, "注册类型必须提供转换回调")
    }
    if (find_type_reg(state, name) >= 0) {
        return set_config_error(state, CODE_CONFIG, "注册类型名重复")
    }
    if (state.type_count >= MAX_TYPES) {
        return set_config_error(state, CODE_CONFIG, "注册类型个数超过本版本上限")
    }
    let reg type_reg
    reg.used = 1
    reg.name = pool_dup(&state.mem, name)
    reg.converter = converter
    reg.user = user
    if (state.mem.failed != 0) {
        return set_config_error(state, CODE_RESOURCE, "注册类型时内存不足")
    }
    state.types[state.type_count] = reg
    state.type_count += 1
    return 0
}

// register_action 注册命名 action；0 成功、-1 失败。
// 注册项必须提供显式数量（infer 只允许出现在参数声明侧）与输出形状。
pub fn register_action(p *Parser, name *char, arity Arity, shape ValueShape,
    handler fn(*ActionContext, *Value, *Diagnostic, *void) int, user *void) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || state.failed != 0 || state.frozen != 0) {
        return -1
    }
    if (name == 0 || name[0] == 0) {
        return set_config_error(state, CODE_CONFIG, "注册 action 名不能为空")
    }
    if (handler.to_type(*void) == 0) {
        return set_config_error(state, CODE_CONFIG, "注册 action 必须提供处理回调")
    }
    if (arity.kind == ArityKind.arity_infer) {
        return set_config_error(state, CODE_CONFIG, "注册 action 的数量必须显式给出")
    }
    if (arity.kind == ArityKind.arity_exactly && arity.count < 1) {
        return set_config_error(state, CODE_CONFIG, "注册 action 的 exactly 数量必须大于等于 1")
    }
    if (shape.leaf == ValueKind.sequence || shape.depth < 0 || shape.depth > 2) {
        return set_config_error(state, CODE_CONFIG, "注册 action 的输出形状无效")
    }
    if (find_action_reg(state, name) >= 0) {
        return set_config_error(state, CODE_CONFIG, "注册 action 名重复")
    }
    if (state.action_count >= MAX_ACTIONS) {
        return set_config_error(state, CODE_CONFIG, "注册 action 个数超过本版本上限")
    }
    let reg action_reg
    reg.used = 1
    reg.name = pool_dup(&state.mem, name)
    reg.arity_kind = arity.kind.to_type(int)
    reg.arity_count = arity.count
    reg.shape_leaf = shape.leaf.to_type(int)
    reg.shape_depth = shape.depth
    reg.has_shape = 1
    reg.handler = handler
    reg.user = user
    if (state.mem.failed != 0) {
        return set_config_error(state, CODE_RESOURCE, "注册 action 时内存不足")
    }
    state.actions[state.action_count] = reg
    state.action_count += 1
    return 0
}

// context_text 把回调产生的文本复制进结果池；返回新地址，失败空指针。
pub fn context_text(context *void, text *char) *char {
    let ns *ns_state = context.to_type(*ns_state)
    if (ns == 0 || text == 0) {
        return 0
    }
    return pool_dup(&ns.mem, text)
}

// test_alloc_count 返回 parser 池已成功分配的次数；仅供测试观察。
pub fn test_alloc_count(p *Parser) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    return state.mem.alloc_count
}

// test_fail_alloc_after 注入分配失败：第 nth 次分配起失败，nth<0 关闭。
// 只影响当前 parser 的池，供分配失败路径验收使用，不作为产品配置项。
pub fn test_fail_alloc_after(p *Parser, nth int) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    state.mem.fail_after = nth
    return 0
}

// format_help 生成帮助文本；失败时 TextResult.status 非 ok。
pub fn format_help(p *Parser) TextResult {
    return format_text(parser_state_of(p), 0)
}

// format_usage 生成 usage 文本；失败时 TextResult.status 非 ok。
pub fn format_usage(p *Parser) TextResult {
    return format_text(parser_state_of(p), 1)
}

// release_text 释放 TextResult 的文本与所有权并归零；零值可安全调用。
pub fn release_text(result *TextResult) void {
    if (result == 0) {
        return
    }
    if (result.owner != 0) {
        let owner *text_owner = result.owner.to_type(*text_owner)
        pool_free_all(&owner.mem)
        free(owner.to_type(*void))
        result.owner = 0
    }
    result.text = 0
    result.status = ResultStatus.ok
    clear_diagnostic(&result.error)
}

// render_text 把 TextResult 的文本写到指定文件描述符；0 成功、-1 失败。
pub fn render_text(text *TextResult, fd int) int {
    if (text == 0 || text.text == 0) {
        return -1
    }
    return io.write_all(fd, text.text, strlen(text.text).to_type(int))
}

// print_help 把帮助写到 fd；0 成功、-1 失败。
pub fn print_help(p *Parser, fd int) int {
    let text TextResult = format_help(p)
    if (text.status != ResultStatus.ok) {
        release_text(&text)
        return -1
    }
    let rc int = render_text(&text, fd)
    release_text(&text)
    return rc
}

// print_usage 把 usage 写到 fd；0 成功、-1 失败。
pub fn print_usage(p *Parser, fd int) int {
    let text TextResult = format_usage(p)
    if (text.status != ResultStatus.ok) {
        release_text(&text)
        return -1
    }
    let rc int = render_text(&text, fd)
    release_text(&text)
    return rc
}

// exit_code 返回结果对应的进程退出码：ok/help/version → 0，usage_error → 2，
// config/resource → 1。
pub fn exit_code(result *Result) int {
    if (result == 0) {
        return 1
    }
    if (result.status == ResultStatus.ok
        || result.status == ResultStatus.help_requested
        || result.status == ResultStatus.version_requested) {
        return 0
    }
    if (result.status == ResultStatus.usage_error) {
        return 2
    }
    return 1
}

// render 按结果状态输出：控制文本写 out_fd，usage 与诊断写 error_fd；0/-1。
// 不退出、不释放；输出失败返回 -1（调用方据此把退出码降级为 1）。
pub fn render(result *Result, out_fd int, error_fd int) int {
    if (result == 0) {
        return -1
    }
    if (render_warnings(result, error_fd) != 0) {
        return -1
    }
    if (result.status == ResultStatus.help_requested
        || result.status == ResultStatus.version_requested) {
        if (result.control_text == 0) {
            return 0
        }
        if (io.write_all(out_fd, result.control_text,
                strlen(result.control_text).to_type(int)) != 0) {
            return -1
        }
        return 0
    }
    if (result.status == ResultStatus.ok) {
        return 0
    }
    let failed int = 0
    if (result.prog_text != 0) {
        if (io.write_all(error_fd, result.prog_text,
                strlen(result.prog_text).to_type(int)) != 0) {
            failed = 1
        }
    }
    if (io.write_all(error_fd, ": 错误: ", 10) != 0) {
        failed = 1
    }
    if (result.error.message != 0) {
        if (io.write_all(error_fd, result.error.message,
                strlen(result.error.message).to_type(int)) != 0) {
            failed = 1
        }
        if (io.write_all(error_fd, "\n", 1) != 0) {
            failed = 1
        }
    }
    if (result.usage_text != 0) {
        if (io.write_all(error_fd, result.usage_text,
                strlen(result.usage_text).to_type(int)) != 0) {
            failed = 1
        }
    }
    if (failed != 0) {
        return -1
    }
    return 0
}

// parse 严格普通解析；参数切片不含程序名。
pub fn parse(p *Parser, args []*char) Result {
    return parse_with_config(p, args, parse_config())
}

// parse_known 普通解析并把未消费 token 按输入顺序保留在 unparsed。
pub fn parse_known(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.known = true
    return parse_with_config(p, args, config)
}

// parse_intermixed 跨选项收集位置参数的严格解析。
pub fn parse_intermixed(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.mode = ParseMode.intermixed
    return parse_with_config(p, args, config)
}

// parse_known_intermixed 混合解析并保留未消费 token。
pub fn parse_known_intermixed(p *Parser, args []*char) Result {
    let config ParseConfig = parse_config()
    config.mode = ParseMode.intermixed
    config.known = true
    return parse_with_config(p, args, config)
}

// parse_with 显式指定模式、known 与初始命名空间。
pub fn parse_with(p *Parser, args []*char, config ParseConfig) Result {
    return parse_with_config(p, args, config)
}

// parse_main 跳过 argv[0] 后用剩余参数严格解析。
pub fn parse_main(p *Parser, argc int, argv **char) Result {
    if (argv == 0 || argc < 0) {
        let result Result = new_result()
        result_set_error(&result, ResultStatus.config_error, CODE_CONFIG,
            "argc/argv 无效", 0, 0, -1)
        return result
    }
    if (argc - 1 > MAX_ARGC) {
        let result Result = new_result()
        result_set_error(&result, ResultStatus.resource_error, CODE_RESOURCE,
            "命令行参数个数超过本版本上限", 0, 0, -1)
        return result
    }
    let buffer [MAX_ARGC]*char
    let count int = 0
    let i int = 1
    for i < argc {
        buffer[count] = argv[i]
        count += 1
        i += 1
    }
    return parse_with_config(p, buffer[0..count], parse_config())
}

// release 释放结果的全部存储并归零；零值可安全调用。
pub fn release(result *Result) void {
    if (result == 0) {
        return
    }
    namespace_destroy(&result.values)
    let owner *result_owner = owner_of(result)
    if (owner != 0) {
        pool_free_all(&owner.mem)
        free(owner.to_type(*void))
    }
    result.owner = 0
    result.control_text = 0
    result.status = ResultStatus.ok
    let empty []*char
    result.unparsed = empty
    clear_diagnostic(&result.error)
}

// init 初始化 parser；0 成功、-1 失败。要求句柄为零值或已 destroy。
pub fn init(p *Parser, config ParserConfig) int {
    if (p == 0 || p.handle != 0) {
        return -1
    }
    let state *parser_state = new_state(config, 0)
    if (state == 0) {
        return -1
    }
    p.handle = state.to_type(*void)
    return 0
}

// add_argument 登记一条参数声明；返回正数参数 ID，失败返回 -1。
pub fn add_argument(p *Parser, spec Argument) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    return add_argument_internal(state, spec)
}

// add_alias 给已有参数增加一个名称；0 成功、-1 失败。
pub fn add_alias(p *Parser, argument int, name *char) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || state.failed != 0 || state.frozen != 0) {
        return -1
    }
    let index int = row_of_id(state, argument)
    if (index < 0) {
        return -1
    }
    if (name == 0 || name[0] == 0) {
        return set_config_error(state, CODE_CONFIG, "别名不能为空")
    }
    if (is_option_name(state.prefix_chars, name) == 0) {
        return set_config_error(state, CODE_CONFIG, "别名必须以注册前缀开头，且不能只由前缀组成")
    }
    if (state.rows[index].name_count >= MAX_NAMES) {
        return set_config_error(state, CODE_CONFIG, "参数名称个数超过本版本上限")
    }
    if (name_is_taken(state, name) >= 0) {
        return set_config_error(state, CODE_CONFIG, "别名与已登记名称冲突")
    }
    state.rows[index].names[state.rows[index].name_count] = pool_dup(&state.mem, name)
    state.rows[index].name_count += 1
    return 0
}

// freeze 检查整棵声明并冻结；0 成功、-1 失败，重复冻结是无操作。
pub fn freeze(p *Parser) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        return -1
    }
    if (state.failed != 0) {
        return -1
    }
    if (state.frozen != 0) {
        return 0
    }
    if (freeze_tree(state) != 0) {
        return -1
    }
    return 0
}

// last_error 返回最近配置错误的借用视图；没有错误时 code 为空指针。
pub fn last_error(p *Parser) Diagnostic {
    let state *parser_state = parser_state_of(p)
    let empty Diagnostic
    clear_diagnostic(&empty)
    if (state == 0) {
        return empty
    }
    return state.error
}

// destroy 释放 parser 全树（含子命令 parser）并归零；零值可安全调用。
pub fn destroy(p *Parser) void {
    let state *parser_state = parser_state_of(p)
    if (state == 0) {
        if (p != 0) {
            p.handle = 0
        }
        return
    }
    destroy_state(state)
    p.handle = 0
}

// set_default 覆盖 dest 的静态默认值；0 成功、-1 失败。默认值深复制进 parser 池。
pub fn set_default(p *Parser, dest *char, value Value) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || dest == 0 || dest[0] == 0 || state.failed != 0 || state.frozen != 0) {
        return -1
    }
    let index int = override_of(state, dest)
    if (index < 0) {
        if (state.override_count >= MAX_ENTRIES) {
            return set_config_error(state, CODE_CONFIG, "set_default 的键个数超过本版本上限")
        }
        index = state.override_count
        state.overrides[index].used = 1
        state.overrides[index].dest = pool_dup(&state.mem, dest)
        state.overrides[index].provided = 0
        state.overrides[index].occurrences = 0
        state.override_count += 1
    }
    state.overrides[index].value = value_clone(&state.mem, value)
    if (state.mem.failed != 0) {
        return set_config_error(state, CODE_RESOURCE, "set_default 复制默认值时内存不足")
    }
    return 0
}

// get_default 查询 parser 的静态有效默认值：先看 set_default 覆盖，
// 再看参数声明的显式默认值，最后是 action 固有缺省。0 成功、-1 失败。
pub fn get_default(p *Parser, dest *char, out *Value) int {
    let state *parser_state = parser_state_of(p)
    if (state == 0 || dest == 0 || out == 0) {
        return -1
    }
    let index int = override_of(state, dest)
    if (index >= 0) {
        *out = state.overrides[index].value
        return 0
    }
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && cstr_equal(row.dest, dest) != 0) {
            if (row.default_mode == DefaultMode.default_explicit.to_type(int)) {
                *out = row.default_value
                return 0
            }
            if (row.default_mode == DefaultMode.default_suppress.to_type(int)) {
                return -1
            }
        }
        i += 1
    }
    i = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && cstr_equal(row.dest, dest) != 0) {
            *out = action_implicit_default(row)
            return 0
        }
        i += 1
    }
    return -1
}

// namespace_init 初始化独立命名空间；0 成功、-1 失败。
pub fn namespace_init(ns *Namespace) int {
    if (ns == 0 || ns.handle != 0) {
        return -1
    }
    let state *ns_state = malloc(sizeof(ns_state).to_type(u64)).to_type(*ns_state)
    if (state == 0) {
        return -1
    }
    ns.handle = state.to_type(*void)
    pool_init(&state.mem)
    state.count = 0
    return 0
}

// namespace_set 深复制值并覆盖键；0 成功、-1 失败。不计入命令行出现次数。
pub fn namespace_set(ns *Namespace, dest *char, value Value) int {
    let state *ns_state = ns_state_of(ns)
    if (state == 0 || dest == 0 || dest[0] == 0) {
        return -1
    }
    let index int = entry_create(state, dest)
    if (index < 0) {
        return -1
    }
    state.rows[index].value = value_clone(&state.mem, value)
    if (state.mem.failed != 0) {
        return -1
    }
    return 0
}

// namespace_destroy 释放独立构造的命名空间并归零；零值可安全调用。
pub fn namespace_destroy(ns *Namespace) void {
    let state *ns_state = ns_state_of(ns)
    if (state == 0) {
        if (ns != 0) {
            ns.handle = 0
        }
        return
    }
    pool_free_all(&state.mem)
    free(state.to_type(*void))
    ns.handle = 0
}

// contains 判断键是否存在；显式 none 仍返回 true。
pub fn contains(ns *Namespace, dest *char) bool {
    let state *ns_state = ns_state_of(ns)
    if (state == 0) {
        return false
    }
    return (entry_find(state, dest) >= 0)
}

// provided 判断当前解析中是否显式出现过该键。
pub fn provided(ns *Namespace, dest *char) bool {
    let state *ns_state = ns_state_of(ns)
    if (state == 0) {
        return false
    }
    let index int = entry_find(state, dest)
    if (index < 0) {
        return false
    }
    return (state.rows[index].provided != 0)
}

// occurrences 返回当前解析的出现次数；默认值和 initial 不计入。
pub fn occurrences(ns *Namespace, dest *char) int {
    let state *ns_state = ns_state_of(ns)
    if (state == 0) {
        return 0
    }
    let index int = entry_find(state, dest)
    if (index < 0) {
        return 0
    }
    return state.rows[index].occurrences
}

// get_value 返回值的借用视图；0 成功、-1 键不存在。
pub fn get_value(ns *Namespace, dest *char, out *Value) int {
    let state *ns_state = ns_state_of(ns)
    if (state == 0 || out == 0) {
        return -1
    }
    let index int = entry_find(state, dest)
    if (index < 0) {
        return -1
    }
    *out = state.rows[index].value
    return 0
}

// get_text 取文本值；0 成功、-1 缺键、-2 类型不符。
pub fn get_text(ns *Namespace, dest *char, out **char) int {
    let v Value
    let status int = get_value(ns, dest, &v)
    if (status != 0) {
        return status
    }
    if (v.kind != ValueKind.text) {
        return -2
    }
    *out = v.data.text
    return 0
}

// get_i64 取整数（integer）值；0 成功、-1 缺键、-2 类型不符。
pub fn get_i64(ns *Namespace, dest *char, out *i64) int {
    let v Value
    let status int = get_value(ns, dest, &v)
    if (status != 0) {
        return status
    }
    if (v.kind != ValueKind.integer) {
        return -2
    }
    *out = v.data.integer
    return 0
}

// get_u64 取无符号整数（natural）值；0 成功、-1 缺键、-2 类型不符。
pub fn get_u64(ns *Namespace, dest *char, out *u64) int {
    let v Value
    let status int = get_value(ns, dest, &v)
    if (status != 0) {
        return status
    }
    if (v.kind != ValueKind.natural) {
        return -2
    }
    *out = v.data.natural
    return 0
}

// get_f64 取浮点（real）值；0 成功、-1 缺键、-2 类型不符。
pub fn get_f64(ns *Namespace, dest *char, out *f64) int {
    let v Value
    let status int = get_value(ns, dest, &v)
    if (status != 0) {
        return status
    }
    if (v.kind != ValueKind.real) {
        return -2
    }
    *out = v.data.real
    return 0
}

// get_bool 取布尔值；0 成功、-1 缺键、-2 类型不符。
pub fn get_bool(ns *Namespace, dest *char, out *bool) int {
    let v Value
    let status int = get_value(ns, dest, &v)
    if (status != 0) {
        return status
    }
    if (v.kind != ValueKind.boolean) {
        return -2
    }
    *out = v.data.boolean
    return 0
}

// get_list 取序列视图；0 成功、-1 缺键、-2 类型不符。
// 返回的切片指向命名空间内部的堆存储，随命名空间存活。
pub fn get_list(ns *Namespace, dest *char, out *[]Value) int {
    let state *ns_state = ns_state_of(ns)
    if (state == 0 || out == 0) {
        return -1
    }
    let index int = entry_find(state, dest)
    if (index < 0) {
        return -1
    }
    if (state.rows[index].value.kind != ValueKind.sequence) {
        return -2
    }
    let block *list_block = state.rows[index].value.data.items.to_type(*list_block)
    if (block == 0) {
        *out = []
        return 0
    }
    *out = block.items[0..block.count]
    return 0
}
