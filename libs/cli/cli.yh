module cli

// yh cli 标准库（CLI1）：声明式命令行解析。
//
// 本文件只放公开数据模型、容量常量和模块私有的分配池；注册/冻结在 schema.yh，
// 命名空间与类型化查询在 values.yh，token 匹配与解析在 parse.yh，
// 帮助文本在 help.yh，argc/argv 适配与退出契约在 entry.yh。
// 设计依据见 docs/03-design/yh-cli标准库设计.md，实施阶段见
// docs/02-plan/yh-cli标准库实施方案.md。
//
// 实现约束（CLI0 实测）：动态列表不能指向裸堆指针切片，因此列表存储在
// 模块私有的 list_block 里，通过「堆结构体成员数组 + 动态长度切片」给出视图；
// 所有对外可见的文本和列表都由池持有，随所属句柄一起释放。

// —— 容量上限（CLI1）——
// 超出上限的注册或输入返回带诊断的失败，不静默截断。
const MAX_ARGS int = 64      // 单个 parser 可注册的参数个数
const MAX_NAMES int = 4      // 单个参数最多注册的名称个数（含主名称与别名）
const MAX_ENTRIES int = 128  // 单个结果命名空间的键个数
const MAX_LIST int = 256     // 单个列表值的元素个数
const MAX_CHOICES int = 64   // 单个参数的 choices 候选个数
const MAX_CHILDREN int = 32  // 单个 parser 的子命令个数
const MAX_ALIASES int = 8    // 单个子命令的别名个数
const MAX_GROUPS int = 16    // 单个 parser 的展示组个数
const MAX_MUTEX int = 16     // 单个 parser 的互斥组个数
const MAX_DEPTH int = 8      // 子命令嵌套层数上限
const MAX_TYPES int = 8      // 单个 parser 的已注册类型个数
const MAX_ACTIONS int = 8    // 单个 parser 的已注册 action 个数
const MAX_FILE_TOKENS int = 4096 // 参数文件展开的 token 上限（本版本）
const MAX_FILE_LINE int = 4096   // 参数文件单行长度上限（本版本）
const MAX_METAVARS int = 16      // exactly(n) 的逐项占位名上限
const MAX_ARGC int = 128     // argv 适配一次处理的参数个数
const MAX_TEXT int = 1024    // 单条诊断/帮助文本的字节上限（含结尾 NUL）
const MAX_FILE_DEPTH int = 16      // 参数文件包含深度上限（parse_config 初值）
const MAX_FILE_BYTES int = 1048576 // 参数文件累计读取字节上限（parse_config 初值）

// —— 诊断码（Diagnostic.code 的稳定取值）——
// 应用应按常量比较，不要依赖 message 文本；类别语义见设计 §14.3。
pub const CODE_CONFIG *char = "config_error"     // 声明无效或不受支持
pub const CODE_USAGE *char = "usage_error"       // 输入不满足声明
pub const CODE_RESOURCE *char = "resource_error" // 分配失败或参数文件读取失败

// ValueKind 标识 Value 当前使用的载荷成员；none 是显式空值。
pub enum ValueKind {
    none
    text
    integer
    natural
    real
    boolean
    sequence
}

// ValueData 只写入 Value.kind 对应的成员；items 指向模块私有的列表块。
pub union ValueData {
    text *char
    integer i64
    natural u64
    real f64
    boolean bool
    items *void
}

// Value 是带标签的值；文本和列表的所有权属于存入它的 parser 或命名空间。
pub struct Value {
    kind ValueKind
    data ValueData
}

// DefaultMode 表示参数未出现时的默认值策略。
pub enum DefaultMode {
    default_inherit   // 采用参数组或 parser 的策略，都没有时用 action 缺省
    default_explicit  // 使用给定值，包括显式 none
    default_suppress  // 参数未出现时不创建该键
}

// Default 由策略和值组成；mode=suppress 时 value 不读取。
pub struct Default {
    mode DefaultMode
    value Value
}

// Action 是内置参数行为；CLI1 实现 store 系列、count、help、version。
pub enum Action {
    store
    store_const
    store_true
    store_false
    append
    append_const
    extend
    count
    boolean_optional
    help
    version
    custom
}

// ArityKind 是数量模型的判别值；成员名加 arity_ 前缀以免与构造函数同名
// （枚举成员登记在模块全局名字表，同名声明不能共存）。
pub enum ArityKind {
    arity_infer
    arity_single
    arity_exactly
    arity_optional
    arity_zero_or_more
    arity_one_or_more
    arity_remainder
    arity_no_values
}

// Arity 描述参数消费值的数量；count 只在 arity_exactly 时有效。
pub struct Arity {
    kind ArityKind
    count int
}

// Diagnostic 是一条结构化诊断；文本由所属 parser 或结果持有。
pub struct Diagnostic {
    code *char        // 错误码；无错误时为空指针
    message *char     // 可读消息
    dest *char        // 相关 dest
    option *char      // 相关选项名
    token_index int   // 参数切片下标；无对应 token 时 -1
    file *char        // 参数文件路径；非文件来源为空指针
    line int          // 文件内行号；非文件来源为 -1
    column int        // 文件内列号；非文件来源为 -1
}

// ValueShape 描述自定义 action 的输出形状：叶子类型与列表层数。
pub struct ValueShape {
    leaf ValueKind
    depth int
}

// ConvertContext 是转换回调的输入与分配入口；context 是结果池句柄。
pub struct ConvertContext {
    token *char       // 原始 token，回调期间有效
    token_index int
    kind ValueKind    // 声明要求的目标类型
    context *void     // 结果池句柄，配 context_text 使用
}

// ActionContext 是自定义 action 的输入与分配入口。
pub struct ActionContext {
    argument int        // 参数 ID
    dest *char
    matched_name *char
    occurrences int     // 本参数此前的出现次数
    values []Value      // 本次转换得到的值
    previous Value      // 旧值；没有时为 none
    context *void
}

// LineContext 是参数文件逐行回调的输入。
pub struct LineContext {
    line *char        // 去换行后的原始字节行
    file *char
    line_number int
    context *void
}

// LineTokens 是逐行回调的输出 token 列表。
pub struct LineTokens {
    items []*char
}

// Argument 是一次参数声明；文本字段在 add_argument 时深复制。
pub struct Argument {
    name *char            // 主名称；位置参数只用它作 dest 与帮助名
    alias *char           // 选项别名；无别名时为空串
    dest *char            // 结果键名；空时由名称推导
    action Action         // 参数行为
    value_kind ValueKind  // 值类型；默认 text
    arity Arity           // 数量模型；默认 infer
    default_value Default // 缺省策略；默认 inherit
    const_value Value     // 零值/缺值时的常量；默认 none
    choices []Value       // 允许值的候选集合；空切片表示无约束
    required bool         // 选项是否必须显式出现
    help *char            // 帮助文本；空指针表示无
    hidden bool           // 是否从帮助中隐藏
    positional bool       // 是否为位置参数
    metavar *char         // 帮助占位名；空指针时按 dest 推导
    group int             // 展示组 ID；0 表示未分组
    mutex int             // 互斥组 ID；0 表示未加入
    converter fn(*ConvertContext, *Value, *Diagnostic, *void) int
    validator fn(Value, *Diagnostic, *void) int
    custom_action fn(*ActionContext, *Value, *Diagnostic, *void) int
    user *void            // 回调的用户指针，按借用保存
    type_name *char       // 已注册类型名；与 converter 互斥
    action_name *char     // 已注册 action 名；与 custom_action 互斥
    output_shape *ValueShape // 自定义 action 的输出形状；注册项可提供
    deprecated bool       // 是否标记为弃用（帮助中标注）
    version_text *char    // version action 的输出模板；空指针时输出 prog
    metavars []*char      // exactly(n) 的逐项占位名；与 metavar 不能同时设置
}

// Color 是帮助与诊断的颜色策略；auto 依赖终端检测，检测失败时无色降级。
pub enum Color {
    never
    automatic  // 对应设计的 auto；auto 是保留字，成员名改用 automatic
    always
}

// HelpFormat 是帮助文本的正交配置。
pub struct HelpFormat {
    preserve_description bool // 保留 description 的显式空行，只调整缩进
    preserve_all_text bool    // 说明文本整体保留空白
    show_defaults bool        // 在帮助里展示默认值
    metavar_from_type bool    // 无 metavar 时按值类型推导占位名
    width int                 // 目标宽度；0 表示不换行
    max_help_column int       // 说明文本起始列上限；0 表示按 width 推导
    section_positional *char  // 位置参数段标题；空指针用 "positional arguments"
    section_options *char     // 选项段标题；空指针用 "options"
    section_commands *char    // 子命令段标题；空指针用 "commands"
    usage_prefix *char        // usage 行前缀；空指针用 "usage: "
}

// Conflict 是重复名称的处理策略。
pub enum Conflict {
    error    // 重复名称是配置错误（缺省）
    resolve  // 从旧声明删除冲突名称，全部移除时停用旧声明
}

// ParseMode 是位置参数与选项的交错处理方式。
pub enum ParseMode {
    normal     // 按选项边界分段匹配位置参数（缺省）
    intermixed // 跨选项收集位置参数
}

// ParserConfig 是 parser 的推荐默认配置；全零初始化不等于推荐默认值。
pub struct ParserConfig {
    prog *char            // 展示名，必须非空
    usage *char           // 空指针自动生成；空串不显示 usage 正文
    description *char     // 描述；空指针或空串表示无
    epilog *char          // 结尾说明；空指针或空串表示无
    add_help bool         // 是否自动注册 -h/--help
    allow_abbrev bool     // 是否允许唯一长名称前缀（CLI2 实现）
    prefix_chars *char    // 选项前缀字符集合；默认 "-"
    argument_default Default // parser 级默认策略
    suggest_on_error bool // 错误时是否给候选建议（CLI5 实现）
    conflict Conflict     // 重复名称策略；缺省 error
    help_format HelpFormat // 帮助布局配置
    color Color           // 帮助与诊断颜色策略
    fromfile_prefix_chars *char // 参数文件前缀字符集合；空串关闭展开
    line_converter fn(*LineContext, *LineTokens, *Diagnostic, *void) int
    line_user *void       // 逐行回调的用户指针
}

// Subparsers 是子命令槽的配置；每个 parser 最多一个槽。
pub struct Subparsers {
    dest *char        // 非空时把选中命令的规范名存入 namespace
    title *char       // 帮助段标题；空指针时用 "commands"
    description *char // 帮助段说明
    metavar *char     // usage 占位名；空指针时用 {命令名列表}
    required bool     // 是否必须选择一个子命令
}

// Command 是一条子命令声明；aliases 指向借用数组，add_parser 时复制。
pub struct Command {
    name *char
    aliases []*char
    help *char
    deprecated bool
    config ParserConfig
}

// Group 是展示组配置；组内参数按注册顺序展示，不改变匹配顺序。
pub struct Group {
    title *char
    description *char
    argument_default Default
    conflict Conflict
}

// Namespace 保存 dest 到值的映射；既用于结果，也可独立构造为初始值。
pub struct Namespace {
    handle *void
}

// ParseConfig 是一次解析的配置：模式、known 与初始命名空间。
pub struct ParseConfig {
    mode ParseMode
    known bool
    initial *Namespace
    file_max_depth int   // 参数文件包含深度上限
    file_max_bytes int   // 参数文件累计读取字节上限
    file_max_tokens int  // 参数文件展开的 token 上限
}

// ResultStatus 是解析结果的状态类别。
pub enum ResultStatus {
    ok
    help_requested
    version_requested
    usage_error
    config_error
    resource_error
}

// Parser 是公开薄句柄；handle 指向模块私有状态，调用者不得改写。
pub struct Parser {
    handle *void
}

// Result 是一次解析的结果；values 随 release 一起释放。
pub struct Result {
    status ResultStatus
    values Namespace
    unparsed []*char      // 保留的未知 token（CLI3 起使用）
    warnings []*char      // 运行期警告（deprecated 等）；随 release 释放
    error Diagnostic      // 失败诊断
    control_text *char    // 帮助/版本文本，随结果释放
    usage_text *char      // 失败时的 usage 正文（render 写 error_fd 用）
    prog_text *char       // 失败时的展示名副本（render 的 "prog: 错误:" 前缀）
    command_path []*char  // 选中的规范命令路径（根到叶）
    owner *void           // 结果内部所有权句柄
}

// TextResult 是格式化文本的结果；text 随 release_text 释放。
pub struct TextResult {
    status ResultStatus
    text *char
    error Diagnostic
    owner *void
}

// —— 模块私有：分配池 ——

// pool_node 是池内每块分配的头部，串成释放链表。
struct pool_node {
    next *pool_node
}

// pool 记录本次会话分配的全部内存；失败位置位后所有分配返回空指针。
struct pool {
    head *pool_node
    failed int
    alloc_count int  // 已成功分配次数（测试注入用）
    fail_after int   // >= 0 时第 fail_after 次起强制失败；-1 关闭
}

// pool_init 把池重置为空。
fn pool_init(p *pool) void {
    p.head = 0
    p.failed = 0
    p.alloc_count = 0
    p.fail_after = -1
}

// pool_alloc 在池内分配 byte_count 字节并返回 16 字节对齐的地址；
// 已经失败或内存不足时返回空指针并置失败位。
fn pool_alloc(p *pool, byte_count u64) *void {
    if (p.failed != 0) {
        return 0
    }
    if (p.fail_after >= 0 && p.alloc_count >= p.fail_after) {
        p.failed = 1
        return 0
    }
    p.alloc_count += 1
    let total u64 = byte_count + sizeof(pool_node).to_type(u64)
    let node *pool_node = malloc(total).to_type(*pool_node)
    if (node == 0) {
        p.failed = 1
        return 0
    }
    node.next = p.head
    p.head = node
    return (node + 1).to_type(*void)
}

// pool_dup 把 NUL 结尾字符串复制进池；空指针或失败返回空指针。
fn pool_dup(p *pool, text *char) *char {
    if (text == 0) {
        return 0
    }
    let size u64 = strlen(text) + 1
    let memory *char = pool_alloc(p, size).to_type(*char)
    if (memory == 0) {
        return 0
    }
    memcpy(memory.to_type(*void), text.to_type(*void), size)
    return memory
}

// pool_free_all 释放池内全部块并把池重置。
fn pool_free_all(p *pool) void {
    let cursor *pool_node = p.head
    for cursor != 0 {
        let next *pool_node = cursor.next
        free(cursor.to_type(*void))
        cursor = next
    }
    p.head = 0
    p.failed = 0
}

// —— 公开构造函数 ——

// value_none 返回显式空值；不分配。
pub fn value_none() Value {
    let v Value
    v.kind = ValueKind.none
    return v
}

// value_text 返回借用调用者字符串的文本值；不分配。
pub fn value_text(content *char) Value {
    let v Value
    v.kind = ValueKind.text
    v.data.text = content
    return v
}

// value_i64 返回 64 位有符号整数值。
pub fn value_i64(number i64) Value {
    let v Value
    v.kind = ValueKind.integer
    v.data.integer = number
    return v
}

// value_u64 返回 64 位无符号整数值。
pub fn value_u64(number u64) Value {
    let v Value
    v.kind = ValueKind.natural
    v.data.natural = number
    return v
}

// value_f64 返回 64 位浮点值。
pub fn value_f64(number f64) Value {
    let v Value
    v.kind = ValueKind.real
    v.data.real = number
    return v
}

// value_bool 返回布尔值。
pub fn value_bool(flag bool) Value {
    let v Value
    v.kind = ValueKind.boolean
    v.data.boolean = flag
    return v
}

// value_shape 构造自定义 action 的输出形状；depth 负数视为 0。
pub fn value_shape(leaf ValueKind, depth int) ValueShape {
    let shape ValueShape
    shape.leaf = leaf
    shape.depth = depth
    if (shape.depth < 0) {
        shape.depth = 0
    }
    return shape
}

// help_format 返回推荐帮助配置：宽度 80、自动换行、不显示默认值。
pub fn help_format() HelpFormat {
    let format HelpFormat
    format.preserve_description = false
    format.preserve_all_text = false
    format.show_defaults = false
    format.metavar_from_type = true
    format.width = 80
    format.max_help_column = 0
    format.section_positional = 0
    format.section_options = 0
    format.section_commands = 0
    format.usage_prefix = 0
    return format
}

// default_of 把值包装成 explicit 默认值。
pub fn default_of(value Value) Default {
    let d Default
    d.mode = DefaultMode.default_explicit
    d.value = value
    return d
}

// suppress_default 返回抑制策略的默认值：参数未出现时不创建键。
pub fn suppress_default() Default {
    let d Default
    d.mode = DefaultMode.default_suppress
    return d
}

// inherit_default 返回继承策略的默认值。
pub fn inherit_default() Default {
    let d Default
    d.mode = DefaultMode.default_inherit
    return d
}

// infer_arity 使用内置 action 的数量模型。
pub fn infer_arity() Arity {
    let a Arity
    a.kind = ArityKind.arity_infer
    return a
}

// single 恰好一个值，结果为标量。
pub fn single() Arity {
    let a Arity
    a.kind = ArityKind.arity_single
    return a
}

// exactly 恰好 count 个值（count >= 1），结果始终是列表。
pub fn exactly(count int) Arity {
    let a Arity
    a.kind = ArityKind.arity_exactly
    a.count = count
    return a
}

// optional 零或一个值，结果为标量；出现但无值时使用 const。
pub fn optional() Arity {
    let a Arity
    a.kind = ArityKind.arity_optional
    return a
}

// zero_or_more 零个或多个值，结果为列表。
pub fn zero_or_more() Arity {
    let a Arity
    a.kind = ArityKind.arity_zero_or_more
    return a
}

// one_or_more 至少一个值，结果为列表。
pub fn one_or_more() Arity {
    let a Arity
    a.kind = ArityKind.arity_one_or_more
    return a
}

// remainder 收集其后全部 token（含看起来像选项的），结果为列表。
pub fn remainder() Arity {
    let a Arity
    a.kind = ArityKind.arity_remainder
    return a
}

// no_values 显式声明零参数行为，仅供自定义 action。
pub fn no_values() Arity {
    let a Arity
    a.kind = ArityKind.arity_no_values
    return a
}

// parser_config 返回推荐默认配置；prog 必须非空。
pub fn parser_config(prog *char) ParserConfig {
    let config ParserConfig
    config.prog = prog
    config.usage = 0
    config.description = 0
    config.epilog = 0
    config.add_help = true
    config.allow_abbrev = false
    config.prefix_chars = "-"
    config.argument_default = inherit_default()
    config.suggest_on_error = false
    config.conflict = Conflict.error
    config.help_format = help_format()
    config.color = Color.never
    config.fromfile_prefix_chars = ""
    config.line_user = 0
    return config
}

// new_argument 构造一条声明的默认字段；positional 决定名称用途与默认数量模型。
fn new_argument(name *char, positional int) Argument {
    let spec Argument
    spec.name = name
    spec.alias = 0
    spec.dest = 0
    spec.action = Action.store
    spec.value_kind = ValueKind.text
    if (positional != 0) {
        spec.arity = single()
    } else {
        spec.arity = infer_arity()
    }
    spec.default_value = inherit_default()
    spec.const_value = value_none()
    let no_choices []Value
    spec.choices = no_choices
    spec.required = false
    spec.help = 0
    spec.hidden = false
    spec.positional = (positional != 0)
    spec.metavar = 0
    spec.group = 0
    spec.mutex = 0
    spec.user = 0
    spec.type_name = 0
    spec.action_name = 0
    spec.output_shape = 0
    spec.deprecated = false
    spec.version_text = 0
    let no_metavars []*char
    spec.metavars = no_metavars
    return spec
}

// option 创建选项声明；无别名时 alias 传空串。
pub fn option(name *char, alias *char) Argument {
    let spec Argument = new_argument(name, 0)
    spec.alias = alias
    return spec
}

// positional 创建位置参数声明；名称同时用作 dest。
pub fn positional(name *char) Argument {
    return new_argument(name, 1)
}

// subparsers 创建子命令槽配置；默认不必需，dest/title/description/metavar 可后设。
pub fn subparsers() Subparsers {
    let spec Subparsers
    spec.dest = 0
    spec.title = 0
    spec.description = 0
    spec.metavar = 0
    spec.required = false
    return spec
}

// command 创建一条子命令声明；config 用 parser_config(name) 得到推荐默认值。
pub fn command(name *char) Command {
    let spec Command
    spec.name = name
    let no_aliases []*char
    spec.aliases = no_aliases
    spec.help = 0
    spec.deprecated = false
    spec.config = parser_config(name)
    return spec
}

// group 创建展示组配置；conflict 缺省 error，由 add_group 使用。
pub fn group(title *char, description *char) Group {
    let spec Group
    spec.title = title
    spec.description = description
    spec.argument_default = inherit_default()
    spec.conflict = Conflict.error
    return spec
}

// parse_config 返回推荐解析配置：normal、known=false、无初始值。
pub fn parse_config() ParseConfig {
    let config ParseConfig
    config.mode = ParseMode.normal
    config.known = false
    config.initial = 0
    config.file_max_depth = MAX_FILE_DEPTH
    config.file_max_bytes = MAX_FILE_BYTES
    config.file_max_tokens = MAX_FILE_TOKENS
    return config
}

// —— 模块私有：内部状态 ——

// list_block 是列表值的后备存储；items 前缀由 count 决定有效长度。
// 它必须整体在堆上，get_list 取 state.items[0..count] 才能得到堆内切片视图。
struct list_block {
    count int
    items [MAX_LIST]Value
}

// metavar_block 是 exactly(n) 逐项占位名在 parser 池里的存储。
struct metavar_block {
    count int
    items [MAX_METAVARS]*char
}

// choice_block 是 choices 候选集合在 parser 池里的存储。
struct choice_block {
    count int
    items [MAX_CHOICES]Value
}

// entry_row 是结果命名空间里的一条键；文本与列表指向命名空间池。
// 也用于 parser 的 set_default 覆盖表（那时 provided/occurrences 不使用）。
struct entry_row {
    used int
    dest *char
    value Value
    provided int      // 本次解析是否显式出现
    occurrences int   // 显式出现次数
    is_default int    // 1 = 当前值是默认值写入，可被更靠近叶子的默认覆盖
}

// group_row 是展示组；group 只影响帮助展示与组级默认值，不改变匹配顺序。
struct group_row {
    used int
    id int
    title *char
    description *char
    default_mode int
    default_value Value
    conflict int
}

// mutex_row 是互斥组；成员关系由 arg_row.mutex 反查，校验按结果里的 appeared 计数。
struct mutex_row {
    used int
    id int
    required int
    group int
}

// child_row 是一条子命令：名字、别名与归父 parser 所有的子状态。
struct child_row {
    used int
    name *char
    aliases [MAX_ALIASES]*char
    alias_count int
    help *char
    deprecated int
    state *void      // 子 parser_state（父 destroy 时递归释放）
    handle Parser    // 公开句柄，指向同一子状态
}

// command_path_block 是 Result.command_path 的后备存储（结果池持有）。
struct command_path_block {
    count int
    items [MAX_DEPTH]*char
}

// token_list_block 是 Result.unparsed 的后备存储（结果池持有），
// 按输入顺序保存 known 模式未消费的 token。
struct token_list_block {
    count int
    items [MAX_ARGC]*char
}

// warning_list_block 是 Result.warnings 的后备存储（结果池持有）；
// 每个声明每次 parse 最多一条。
struct warning_list_block {
    count int
    items [MAX_ARGC]*char
}

// arg_row 是 parser 内的一条参数登记；文本字段都指向 parser 池。
struct arg_row {
    used int
    id int              // 正整数参数 ID
    positional int      // 1 = 位置参数
    action int          // Action 判别值
    value_kind int      // ValueKind 判别值
    arity_kind int      // ArityKind 判别值
    arity_count int     // arity_exactly 的数量
    default_mode int    // DefaultMode 判别值
    default_value Value // 显式默认值
    const_value Value   // 常量值
    required int
    hidden int
    names [MAX_NAMES]*char // 注册的名称（含主名称与别名）
    name_count int
    dest *char
    help *char
    metavar *char
    choices []Value     // 借用 parser 池里的候选值副本
    group int           // 展示组 ID；0 表示未分组
    mutex int           // 互斥组 ID；0 表示未加入
    converter fn(*ConvertContext, *Value, *Diagnostic, *void) int
    validator fn(Value, *Diagnostic, *void) int
    custom_action fn(*ActionContext, *Value, *Diagnostic, *void) int
    user *void
    type_name *char
    action_name *char
    shape_leaf int      // 自定义 action 输出叶子类型
    shape_depth int     // 自定义 action 输出列表层数
    has_shape int
    deprecated int
    version_text *char
    metavars []*char
}

// type_reg 是一条已注册类型：名字与转换回调。
struct type_reg {
    used int
    name *char
    converter fn(*ConvertContext, *Value, *Diagnostic, *void) int
    user *void
}

// action_reg 是一条已注册 action：名字、数量与输出形状。
struct action_reg {
    used int
    name *char
    arity_kind int
    arity_count int
    shape_leaf int
    shape_depth int
    has_shape int
    handler fn(*ActionContext, *Value, *Diagnostic, *void) int
    user *void
}

// parser_state 是 Parser 句柄指向的私有状态；整棵树由根句柄持有。
struct parser_state {
    mem pool                 // 声明文本与诊断文本
    prog *char
    usage *char
    description *char
    epilog *char
    add_help int
    allow_abbrev int
    prefix_chars *char
    argument_default_mode int
    argument_default_value Value
    suggest_on_error int
    frozen int               // freeze 成功后为 1
    failed int               // 粘滞配置错误
    error Diagnostic
    rows [MAX_ARGS]arg_row
    row_count int            // 已使用的行数（含空洞）
    next_id int
    overrides [MAX_ENTRIES]entry_row // set_default 的 dest 覆盖
    override_count int
    numeric_short int        // 1 = 注册了数字型短选项（关闭负数特判）
    conflict int             // parser 级冲突策略
    parent *void             // 父 parser_state；根为 0
    slot_used int
    slot_id int
    slot_dest *char
    slot_required int
    slot_title *char
    slot_description *char
    slot_metavar *char
    children [MAX_CHILDREN]child_row
    child_count int
    groups [MAX_GROUPS]group_row
    group_count int
    mutexes [MAX_MUTEX]mutex_row
    mutex_count int
    types [MAX_TYPES]type_reg
    type_count int
    actions [MAX_ACTIONS]action_reg
    action_count int
    fromfile_prefix_chars *char
    line_converter fn(*LineContext, *LineTokens, *Diagnostic, *void) int
    line_user *void
    format_preserve_description int
    format_preserve_all int
    format_show_defaults int
    format_metavar_from_type int
    format_width int
    format_max_help_column int
    title_positional *char
    title_options *char
    title_commands *char
    usage_prefix *char
    color int
}

// ns_state 是 Namespace 句柄指向的私有状态。
struct ns_state {
    mem pool
    rows [MAX_ENTRIES]entry_row
    count int
}

// text_owner 是格式化文本结果的私有所有权句柄。
struct text_owner {
    mem pool
}

// result_owner 是解析结果的私有所有权句柄：诊断、控制文本、命令路径与
// 未解析 token 都在它的池里，因此结果可以晚于 parser 销毁。
// appeared 按参数 ID 记录「本次解析是否显式出现」，互斥组按它计数。
struct result_owner {
    mem pool
    appeared [MAX_ARGS + 1]int
}

// parse_ctx 是一次解析的上下文：结果、配置、参与解析的层链（父→子）、
// 命令路径与 known 模式未消费的 token。整次解析共享一个结果命名空间。
struct parse_ctx {
    result *Result
    config ParseConfig
    chain [MAX_DEPTH]*parser_state
    chain_slot [MAX_DEPTH]int // 该层是否选中了子命令
    chain_count int
    path *command_path_block
    unparsed *token_list_block
    warnings *warning_list_block
}
