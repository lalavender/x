module cli

// cli 帮助、诊断与输出（CLI1–CLI5）：usage/help 布局、HelpFormat 配置、
// metavar/默认值/deprecated 展示、控制字节与非法 UTF-8 转义、颜色与建议，
// 以及 print_*/render/exit_code 输出 API。
//
// 布局顺序固定为 usage、description、位置参数、默认选项、用户组、子命令、epilog；
// 空段省略，段内按注册顺序展示。颜色在终端检测失败时降级为无色。

import io
import os

const MAX_HELP int = 16384 // 单次生成的帮助文本上限（含结尾 NUL）

// —— 基础拼接 ——

// put_text 把 NUL 结尾字符串追加到 out 的 at 位置；返回新偏移，越界返回 -1。
fn put_text(out *char, at int, text *char) int {
    if (at < 0) {
        return -1
    }
    if (text == 0) {
        return at
    }
    let i int = 0
    for text[i] != 0 {
        if (at + i >= MAX_HELP - 1) {
            return -1
        }
        out[at + i] = text[i]
        i += 1
    }
    return at + i
}

// put_char 追加一个字节；返回新偏移，越界返回 -1。
fn put_char(out *char, at int, ch char) int {
    if (at < 0) {
        return -1
    }
    if (at >= MAX_HELP - 1) {
        return -1
    }
    out[at] = ch
    return at + 1
}

// put_int 把有符号整数按十进制追加；越界返回 -1。
fn put_int(out *char, at int, number i64) int {
    if (at < 0) {
        return -1
    }
    if (number < 0) {
        at = put_char(out, at, '-')
        return put_int(out, at, -number)
    }
    if (number >= 10) {
        let next int = put_int(out, at, number / 10)
        if (next < 0) {
            return -1
        }
        at = next
    }
    return put_char(out, at, (48 + (number % 10).to_type(int)).to_type(char))
}

// put_spaces 追加 count 个空格；越界返回 -1。
fn put_spaces(out *char, at int, count int) int {
    if (at < 0) {
        return -1
    }
    let i int = 0
    for i < count {
        at = put_char(out, at, ' ')
        i += 1
    }
    return at
}

// —— UTF-8 与转义 ——

// utf8_sequence_len 返回字节处有效 UTF-8 序列长度；非法返回 0。
fn utf8_sequence_len(text *char, at int) int {
    let b int = text[at].to_type(u8).to_type(int)
    if (b < 128) {
        return 1
    }
    if (b >= 194 && b <= 223) {
        let b1 int = text[at + 1].to_type(u8).to_type(int)
        if (b1 >= 128 && b1 <= 191) {
            return 2
        }
        return 0
    }
    if (b >= 224 && b <= 239) {
        let b1 int = text[at + 1].to_type(u8).to_type(int)
        let b2 int = text[at + 2].to_type(u8).to_type(int)
        if (b1 >= 128 && b1 <= 191 && b2 >= 128 && b2 <= 191) {
            return 3
        }
        return 0
    }
    if (b >= 240 && b <= 244) {
        let b1 int = text[at + 1].to_type(u8).to_type(int)
        let b2 int = text[at + 2].to_type(u8).to_type(int)
        let b3 int = text[at + 3].to_type(u8).to_type(int)
        if (b1 >= 128 && b1 <= 191 && b2 >= 128 && b2 <= 191 && b3 >= 128 && b3 <= 191) {
            return 4
        }
        return 0
    }
    return 0
}

// put_hex_byte 把一个字节写成 \xHH。
fn put_hex_byte(out *char, at int, value int) int {
    if (at < 0) {
        return -1
    }
    let digits *char = "0123456789abcdef"
    at = put_text(out, at, "\\x")
    at = put_char(out, at, digits[(value >> 4) & 15])
    return put_char(out, at, digits[value & 15])
}

// put_escaped 追加文本，把控制字节与非法 UTF-8 字节转义为 \xHH。
fn put_escaped(out *char, at int, text *char) int {
    if (at < 0) {
        return -1
    }
    if (text == 0) {
        return at
    }
    let i int = 0
    for text[i] != 0 {
        let b int = text[i].to_type(u8).to_type(int)
        if (b < 32 || b == 127) {
            at = put_hex_byte(out, at, b)
            i += 1
            continue
        }
        if (b < 128) {
            at = put_char(out, at, text[i])
            i += 1
            continue
        }
        let length int = utf8_sequence_len(text, i)
        if (length == 0) {
            at = put_hex_byte(out, at, b)
            i += 1
            continue
        }
        let k int = 0
        for k < length {
            at = put_char(out, at, text[i + k])
            k += 1
        }
        i += length
    }
    return at
}

// —— 颜色 ——

// color_enabled 判断当前输出是否使用颜色；终端检测失败时返回 0（无色降级）。
fn color_enabled(state *parser_state, fd int) int {
    if (state.color == Color.never.to_type(int)) {
        return 0
    }
    if (state.color == Color.always.to_type(int)) {
        return 1
    }
    return os.is_terminal(fd)
}

// put_color 追加 ANSI 颜色起始序列；enable=0 时原样返回。
fn put_color(out *char, at int, enable int, code *char) int {
    if (at < 0) {
        return -1
    }
    if (enable == 0) {
        return at
    }
    at = put_char(out, at, 27.to_type(char))
    at = put_char(out, at, '[')
    at = put_text(out, at, code)
    return put_char(out, at, 'm')
}

// put_color_end 追加 ANSI 复位序列；enable=0 时原样返回。
fn put_color_end(out *char, at int, enable int) int {
    if (at < 0) {
        return -1
    }
    if (enable == 0) {
        return at
    }
    at = put_char(out, at, 27.to_type(char))
    at = put_char(out, at, '[')
    at = put_char(out, at, '0')
    return put_char(out, at, 'm')
}

// —— metavar 与默认值 ——

// type_metavar 按值类型推导占位名；未知类型回退到 dest。
fn type_metavar(row *arg_row) *char {
    if (row.value_kind == ValueKind.integer.to_type(int)) {
        return "INT"
    }
    if (row.value_kind == ValueKind.natural.to_type(int)) {
        return "UINT"
    }
    if (row.value_kind == ValueKind.real.to_type(int)) {
        return "FLOAT"
    }
    if (row.value_kind == ValueKind.boolean.to_type(int)) {
        return "BOOL"
    }
    return row.dest
}

// row_metavar 返回参数在帮助/usage 中显示的占位名。
fn row_metavar(state *parser_state, row *arg_row) *char {
    if (row.metavar != 0 && row.metavar[0] != 0) {
        return row.metavar
    }
    if (state.format_metavar_from_type != 0 && row.action == Action.store.to_type(int)) {
        return type_metavar(row)
    }
    return row.dest
}

// put_value_text 渲染一个默认值/常量：文本转义，标量按十进制。
fn put_value_text(out *char, at int, v Value) int {
    if (at < 0) {
        return -1
    }
    if (v.kind == ValueKind.sequence) {
        let block *list_block = v.data.items.to_type(*list_block)
        at = put_char(out, at, '[')
        if (block != 0) {
            let i int = 0
            for i < block.count {
                if (i > 0) {
                    at = put_text(out, at, ", ")
                }
                at = put_value_text(out, at, block.items[i])
                i += 1
            }
        }
        return put_char(out, at, ']')
    }
    if (v.kind == ValueKind.text) {
        return put_escaped(out, at, v.data.text)
    }
    if (v.kind == ValueKind.integer) {
        return put_int(out, at, v.data.integer)
    }
    if (v.kind == ValueKind.natural) {
        return put_int(out, at, v.data.natural.to_type(i64))
    }
    if (v.kind == ValueKind.boolean) {
        if (v.data.boolean == true) {
            return put_text(out, at, "true")
        }
        return put_text(out, at, "false")
    }
    if (v.kind == ValueKind.real) {
        return put_text(out, at, "float")
    }
    return put_text(out, at, "none")
}

// row_choices_renderable 判断 choices 能否渲染成 {a,b} 形式；real 无格式化器时退回类型名。
fn row_choices_renderable(row *arg_row) int {
    let i int = 0
    for i < len(row.choices) {
        if (row.choices[i].kind == ValueKind.real) {
            return 0
        }
        i += 1
    }
    return 1
}

// put_choices_metavar 写 choices 的默认占位名（argparse 的 {a,b} 形式）。
fn put_choices_metavar(out *char, at int, row *arg_row) int {
    if (at < 0) {
        return -1
    }
    at = put_char(out, at, '{')
    let i int = 0
    for i < len(row.choices) {
        if (i > 0) {
            at = put_char(out, at, ',')
        }
        at = put_value_text(out, at, row.choices[i])
        i += 1
    }
    return put_char(out, at, '}')
}

// put_metavar_at 写第 index 个值的占位名：逐项 metavars > metavar > choices > 类型/dest。
fn put_metavar_at(out *char, at int, state *parser_state, row *arg_row, index int) int {
    if (at < 0) {
        return -1
    }
    if (index >= 0 && index < len(row.metavars)) {
        return put_text(out, at, row.metavars[index])
    }
    if (row.metavar != 0 && row.metavar[0] != 0) {
        return put_text(out, at, row.metavar)
    }
    if (len(row.choices) > 0 && row_choices_renderable(row) != 0) {
        return put_choices_metavar(out, at, row)
    }
    return put_text(out, at, row_metavar(state, row))
}

// put_value_pattern 按数量模型写占位名序列（argparse 的 _format_args 语义）：
// single/optional 一个、exactly(n) 重复 n 个、*/+ 带省略号、remainder 写 "..."。
fn put_value_pattern(out *char, at int, state *parser_state, row *arg_row) int {
    if (at < 0) {
        return -1
    }
    let kind int = effective_arity_kind(row)
    if (kind == ArityKind.arity_remainder.to_type(int)) {
        return put_text(out, at, "...")
    }
    if (kind == ArityKind.arity_no_values.to_type(int)) {
        return at
    }
    if (kind == ArityKind.arity_optional.to_type(int)) {
        at = put_char(out, at, '[')
        at = put_metavar_at(out, at, state, row, 0)
        return put_char(out, at, ']')
    }
    if (kind == ArityKind.arity_zero_or_more.to_type(int)) {
        at = put_char(out, at, '[')
        at = put_metavar_at(out, at, state, row, 0)
        at = put_text(out, at, " [")
        at = put_metavar_at(out, at, state, row, 0)
        return put_text(out, at, " ...]]")
    }
    if (kind == ArityKind.arity_one_or_more.to_type(int)) {
        at = put_metavar_at(out, at, state, row, 0)
        at = put_text(out, at, " [")
        at = put_metavar_at(out, at, state, row, 0)
        return put_text(out, at, " ...]")
    }
    let count int = 1
    if (kind == ArityKind.arity_exactly.to_type(int)) {
        count = row.arity_count
    }
    let i int = 0
    for i < count {
        if (i > 0) {
            at = put_char(out, at, ' ')
        }
        at = put_metavar_at(out, at, state, row, i)
        i += 1
    }
    return at
}

// —— 文本模板（设计 §14.1）——

// template_match 判断 text[start,stop) 是否等于 word。
fn template_match(text *char, start int, stop int, word *char) int {
    let i int = 0
    for start + i < stop {
        if (word[i] == 0 || text[start + i] != word[i]) {
            return 0
        }
        i += 1
    }
    return (word[i] == 0).to_type(int)
}

// template_name_code 把占位符名称映射为编号：prog=1、dest=2、default=3、
// type=4；未知名称返回 0。
fn template_name_code(text *char, start int, stop int) int {
    if (template_match(text, start, stop, "prog") != 0) {
        return 1
    }
    if (template_match(text, start, stop, "dest") != 0) {
        return 2
    }
    if (template_match(text, start, stop, "default") != 0) {
        return 3
    }
    if (template_match(text, start, stop, "type") != 0) {
        return 4
    }
    return 0
}

// template_code_at 识别 text[at] 起的模板片段：%% 返回 9，占位符返回
// 1–4，普通字符返回 0，非法占位符返回 -1；*span 写入片段字节数。
fn template_code_at(text *char, at int, span *int) int {
    *span = 1
    if (text[at] != '%') {
        return 0
    }
    if (text[at + 1] == '%') {
        *span = 2
        return 9
    }
    if (text[at + 1] != '(') {
        return 0
    }
    let j int = at + 2
    for text[j] != 0 && text[j] != ')' {
        j += 1
    }
    if (text[j] != ')' || text[j + 1] != 's') {
        return -1
    }
    let code int = template_name_code(text, at + 2, j)
    if (code == 0) {
        return -1
    }
    *span = j + 2 - at
    return code
}

// check_template 在 freeze 校验模板：allow_row=0 时只允许 %(prog)s 与 %%。
fn check_template(text *char, allow_row int) int {
    if (text == 0) {
        return 0
    }
    let i int = 0
    for text[i] != 0 {
        let span int = 0
        let code int = template_code_at(text, i, &span)
        if (code < 0) {
            return -1
        }
        if (code == 0) {
            i += 1
            continue
        }
        if (code != 1 && code != 9 && allow_row == 0) {
            return -1
        }
        i += span
    }
    return 0
}

// row_type_name 返回 %(type)s 的展示名：优先注册类型名，否则按值类型。
fn row_type_name(row *arg_row) *char {
    if (row.type_name != 0 && row.type_name[0] != 0) {
        return row.type_name
    }
    if (row.value_kind == ValueKind.integer.to_type(int)) {
        return "integer"
    }
    if (row.value_kind == ValueKind.natural.to_type(int)) {
        return "natural"
    }
    if (row.value_kind == ValueKind.real.to_type(int)) {
        return "real"
    }
    if (row.value_kind == ValueKind.boolean.to_type(int)) {
        return "boolean"
    }
    return "text"
}

// row_effective_default_value 返回 %(default)s 的有效默认值：set_default 覆盖
// 优先，其次参数/组/parser 策略，最后 action 固有缺省。
fn row_effective_default_value(state *parser_state, row *arg_row) Value {
    let index int = override_of(state, row.dest)
    if (index >= 0) {
        return state.overrides[index].value
    }
    let mode int = row_default_mode(state, row)
    if (mode == DefaultMode.default_suppress.to_type(int)) {
        return value_none()
    }
    if (mode == DefaultMode.default_explicit.to_type(int)) {
        return row_default_value(state, row)
    }
    return action_implicit_default(row)
}

// put_template 展开占位符并写入 out；allow_row=1 时支持 dest/default/type。
// 未知或不允许的占位符返回 -1（freeze 已提前拦截，正常路径不会走到）。
fn put_template(out *char, at int, state *parser_state, row *arg_row, text *char,
    allow_row int) int {
    if (text == 0) {
        return at
    }
    let i int = 0
    for text[i] != 0 {
        let span int = 0
        let code int = template_code_at(text, i, &span)
        if (code < 0) {
            return -1
        }
        if (code == 0) {
            at = put_char(out, at, text[i])
            i += 1
            continue
        }
        if (code == 9) {
            at = put_char(out, at, '%')
            i += span
            continue
        }
        if (code == 1) {
            at = put_text(out, at, state.prog)
        } else if (row == 0 || allow_row == 0) {
            return -1
        } else if (code == 2) {
            at = put_text(out, at, row.dest)
        } else if (code == 3) {
            at = put_value_text(out, at, row_effective_default_value(state, row))
        } else {
            at = put_text(out, at, row_type_name(row))
        }
        i += span
    }
    return at
}

// put_template_wrapped 先展开模板再按 put_wrapped 的规则折行。
fn put_template_wrapped(out *char, at int, state *parser_state, row *arg_row,
    text *char, indent int, width int, preserve int, allow_row int) int {
    let scratch [MAX_HELP]char
    let n int = put_template(&scratch[0], 0, state, row, text, allow_row)
    if (n < 0) {
        return -1
    }
    scratch[n] = 0
    return put_wrapped(out, at, &scratch[0], indent, width, preserve)
}

// needs_metavar 判断选项在 usage 中是否需要占位名。
fn needs_metavar(row *arg_row) int {
    let action int = row.action
    if (action == Action.store.to_type(int) || action == Action.append.to_type(int)
        || action == Action.extend.to_type(int) || action == Action.custom.to_type(int)) {
        return 1
    }
    return 0
}

// —— usage 片段 ——

// muted_mutex_index 返回该参数所属互斥组下标；没有返回 -1。
fn muted_mutex_index(state *parser_state, row *arg_row) int {
    if (row.mutex == 0) {
        return -1
    }
    return mutex_of(state, row.mutex)
}

// put_single_synopsis 追加一个选项或位置参数的 usage 片段；
// wrap=0 时不加可选的方括号（互斥组已用组括号表达）。
fn put_single_synopsis(out *char, at int, state *parser_state, row *arg_row,
    wrap int) int {
    let required int = 0
    if (row.positional != 0) {
        let kind int = effective_arity_kind(row)
        if (kind == ArityKind.arity_single.to_type(int)
            || kind == ArityKind.arity_one_or_more.to_type(int)
            || kind == ArityKind.arity_exactly.to_type(int)
            || kind == ArityKind.arity_optional.to_type(int)) {
            // optional 位置的占位名自带 [X]，不再套一层方括号（argparse 同形）。
            required = 1
        }
    } else if (row.required != 0) {
        required = 1
    }
    if (required == 0 && wrap != 0) {
        at = put_char(out, at, '[')
    }
    if (row.positional != 0) {
        at = put_value_pattern(out, at, state, row)
    } else if (row.action == Action.boolean_optional.to_type(int) && row.name_count >= 2) {
        // argparse 的 BooleanOptionalAction 写成 [--cache | --no-cache]。
        at = put_text(out, at, row.names[0])
        at = put_text(out, at, " | ")
        at = put_text(out, at, row.names[1])
    } else {
        at = put_text(out, at, row.names[0])
        if (needs_metavar(row) != 0) {
            at = put_char(out, at, ' ')
            at = put_value_pattern(out, at, state, row)
        }
    }
    if (required == 0 && wrap != 0) {
        at = put_char(out, at, ']')
    }
    return at
}

// put_mutex_synopsis 追加互斥组片段：(a | b) 或 [a | b]。
fn put_mutex_synopsis(out *char, at int, state *parser_state, group *mutex_row) int {
    if (at < 0) {
        return -1
    }
    let open char = '['
    let close char = ']'
    if (group.required != 0) {
        open = '('
        close = ')'
    }
    at = put_char(out, at, open)
    let first int = 1
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && row.mutex == group.id && row.hidden == 0) {
            if (first == 0) {
                at = put_text(out, at, " | ")
            }
            at = put_single_synopsis(out, at, state, row, 0)
            first = 0
        }
        i += 1
    }
    return put_char(out, at, close)
}

// put_slot_names 写子命令槽的占位名：显式 metavar > {命令名列表} > COMMAND。
fn put_slot_names(out *char, at int, state *parser_state) int {
    if (at < 0) {
        return -1
    }
    if (state.slot_metavar != 0 && state.slot_metavar[0] != 0) {
        return put_text(out, at, state.slot_metavar)
    }
    if (state.child_count == 0) {
        return put_text(out, at, "COMMAND")
    }
    at = put_char(out, at, '{')
    let i int = 0
    let first int = 1
    for i < state.child_count {
        let child *child_row = &state.children[i]
        if (child.used != 0) {
            if (first == 0) {
                at = put_char(out, at, ',')
            }
            at = put_text(out, at, child.name)
            first = 0
        }
        i += 1
    }
    return put_char(out, at, '}')
}

// put_slot_pattern 写子命令槽的 usage 片段：占位名后跟 " ..."（argparse 的 PARSER 语义，
// 不加方括号：槽出现时至少要消费一个 token）。
fn put_slot_pattern(out *char, at int, state *parser_state) int {
    if (at < 0) {
        return -1
    }
    at = put_slot_names(out, at, state)
    return put_text(out, at, " ...")
}

// build_usage_line 生成 usage 一行：先选项（互斥组合并展示）、再位置参数、再子命令槽。
fn build_usage_line(state *parser_state, out *char) int {
    if (state.usage != 0) {
        if (state.usage[0] == 0) {
            return 0
        }
        let custom_color int = color_enabled(state, 1)
        let custom_at int = put_color(out, 0, custom_color, "1")
        if (custom_at < 0) {
            return -1
        }
        custom_at = put_text(out, custom_at, section_title(state.usage_prefix, "usage: "))
        if (custom_at < 0) {
            return -1
        }
        custom_at = put_color_end(out, custom_at, custom_color)
        if (custom_at < 0) {
            return -1
        }
        custom_at = put_template(out, custom_at, state, 0, state.usage, 0)
        if (custom_at < 0) {
            return -1
        }
        return put_char(out, custom_at, '\n')
    }
    let color int = color_enabled(state, 1)
    let at int = put_color(out, 0, color, "1")
    if (at < 0) {
        return -1
    }
    at = put_text(out, at, section_title(state.usage_prefix, "usage: "))
    if (at < 0) {
        return -1
    }
    at = put_color_end(out, at, color)
    if (at < 0) {
        return -1
    }
    at = put_text(out, at, state.prog)
    if (at < 0) {
        return -1
    }
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && row.hidden == 0 && row.positional == 0
            && muted_mutex_index(state, row) < 0) {
            at = put_char(out, at, ' ')
            if (at < 0) {
                return -1
            }
            at = put_single_synopsis(out, at, state, row, 1)
            if (at < 0) {
                return -1
            }
        }
        i += 1
    }
    i = 0
    for i < state.mutex_count {
        let group *mutex_row = &state.mutexes[i]
        if (group.used != 0) {
            let has_option int = 0
            let j int = 0
            for j < state.row_count {
                let row *arg_row = &state.rows[j]
                if (row.used != 0 && row.mutex == group.id && row.positional == 0
                    && row.hidden == 0) {
                    has_option = 1
                }
                j += 1
            }
            if (has_option != 0) {
                at = put_char(out, at, ' ')
                if (at < 0) {
                    return -1
                }
                at = put_mutex_synopsis(out, at, state, group)
                if (at < 0) {
                    return -1
                }
            }
        }
        i += 1
    }
    i = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && row.hidden == 0 && row.positional != 0) {
            at = put_char(out, at, ' ')
            if (at < 0) {
                return -1
            }
            at = put_single_synopsis(out, at, state, row, 1)
            if (at < 0) {
                return -1
            }
        }
        i += 1
    }
    if (state.slot_used != 0) {
        at = put_char(out, at, ' ')
        if (at < 0) {
            return -1
        }
        at = put_slot_pattern(out, at, state)
        if (at < 0) {
            return -1
        }
    }
    return put_char(out, at, '\n')
}

// —— 帮助正文 ——

// put_wrapped 追加一段说明文本：按 width 折行，续行缩进到 indent 列。
fn put_wrapped(out *char, at int, text *char, indent int, width int, preserve int) int {
    if (at < 0) {
        return -1
    }
    if (text == 0) {
        return at
    }
    let limit int = width
    if (limit <= indent + 8) {
        limit = 0
    }
    let column int = indent
    let i int = 0
    for text[i] != 0 {
        let b int = text[i].to_type(u8).to_type(int)
        if (b == '\n') {
            at = put_char(out, at, '\n')
            at = put_spaces(out, at, indent)
            column = indent
            i += 1
            continue
        }
        if (b == ' ' && preserve == 0) {
            // 折叠连续空白：仅在行未满且不是行首时保留一个空格。
            if (column > indent && (limit == 0 || column + 1 < limit)) {
                at = put_char(out, at, ' ')
                column += 1
            }
            for text[i] == ' ' || text[i] == '\t' {
                i += 1
            }
            continue
        }
        // 控制字节与非法 UTF-8 一律转义为 \xHH，避免破坏帮助布局。
        if (b < 32 || b == 127) {
            if (limit != 0 && column + 4 >= limit) {
                at = put_char(out, at, '\n')
                at = put_spaces(out, at, indent)
                column = indent
            }
            at = put_hex_byte(out, at, b)
            column += 4
            i += 1
            continue
        }
        let length int = 1
        if (b >= 128) {
            length = utf8_sequence_len(text, i)
            if (length == 0) {
                if (limit != 0 && column + 4 >= limit) {
                    at = put_char(out, at, '\n')
                    at = put_spaces(out, at, indent)
                    column = indent
                }
                at = put_hex_byte(out, at, b)
                column += 4
                i += 1
                continue
            }
        }
        let width_add int = 1
        if (limit != 0 && column + width_add >= limit) {
            at = put_char(out, at, '\n')
            at = put_spaces(out, at, indent)
            column = indent
        }
        let k int = 0
        for k < length {
            at = put_char(out, at, text[i + k])
            k += 1
        }
        column += width_add
        i += length
    }
    return at
}

// put_row_names 追加参数在帮助里的名称列："-o, --output PATH"。
fn put_row_names(out *char, at int, state *parser_state, row *arg_row) int {
    if (at < 0) {
        return -1
    }
    if (row.positional != 0) {
        return put_value_pattern(out, at, state, row)
    }
    let j int = 0
    for j < row.name_count {
        if (j > 0) {
            at = put_text(out, at, ", ")
        }
        at = put_text(out, at, row.names[j])
        j += 1
    }
    if (needs_metavar(row) != 0) {
        at = put_char(out, at, ' ')
        at = put_value_pattern(out, at, state, row)
    }
    return at
}

// section_title 返回段标题：显式配置优先，空指针或空串用内置英文默认。
fn section_title(configured *char, fallback *char) *char {
    if (configured != 0 && configured[0] != 0) {
        return configured
    }
    return fallback
}

// help_column 返回帮助说明列的起始列：显式 max_help_column 优先，0 用段落默认值。
fn help_column(state *parser_state, fallback int) int {
    if (state.format_max_help_column > 0) {
        return state.format_max_help_column
    }
    return fallback
}

// append_help_row 追加一行参数说明，含 deprecated 标注与默认值。
fn append_help_row(out *char, at int, state *parser_state, row *arg_row, pad int) int {
    if (at < 0) {
        return -1
    }
    at = put_spaces(out, at, 2)
    if (at < 0) {
        return -1
    }
    let name_start int = at
    at = put_row_names(out, at, state, row)
    if (at < 0) {
        return -1
    }
    let width int = at - name_start
    let spaces int = pad - 2 - width
    if (spaces < 2) {
        spaces = 2
    }
    at = put_spaces(out, at, spaces)
    let column int = 2 + width + spaces
    if (row.help != 0 && row.help[0] != 0) {
        at = put_template_wrapped(out, at, state, row, row.help, column,
            state.format_width, state.format_preserve_all, 1)
    }
    if (row.deprecated != 0) {
        at = put_text(out, at, " (deprecated)")
    }
    if (state.format_show_defaults != 0
        && row.default_mode == DefaultMode.default_explicit.to_type(int)
        && row.default_value.kind != ValueKind.none) {
        at = put_text(out, at, " (default: ")
        at = put_value_text(out, at, row.default_value)
        at = put_char(out, at, ')')
    }
    if (len(row.choices) > 0) {
        at = put_text(out, at, " (choices: ")
        let j int = 0
        for j < len(row.choices) {
            if (j > 0) {
                at = put_text(out, at, ", ")
            }
            at = put_value_text(out, at, row.choices[j])
            j += 1
        }
        at = put_char(out, at, ')')
    }
    return put_char(out, at, '\n')
}

// has_visible_row 判断是否存在某类可见参数（positional 与是否归组）。
fn has_visible_row(state *parser_state, positional int, grouped int) int {
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && row.hidden == 0 && row.positional == positional) {
            if (grouped == 0 && row.group == 0) {
                return 1
            }
            if (grouped == 1 && row.group != 0) {
                return 1
            }
        }
        i += 1
    }
    return 0
}

// put_break 追加段前换行；文本还为空时跳过，避免空 usage 留下首行空行。
fn put_break(out *char, at int) int {
    if (at < 0) {
        return -1
    }
    if (at == 0) {
        return 0
    }
    return put_char(out, at, '\n')
}

// put_title 追加一个带颜色的段标题（前置空行仅在已有文本时写入）。
fn put_title(out *char, at int, state *parser_state, title *char) int {
    if (at < 0) {
        return -1
    }
    at = put_break(out, at)
    let color int = color_enabled(state, 1)
    at = put_color(out, at, color, "1")
    at = put_text(out, at, title)
    at = put_text(out, at, ":\n")
    return put_color_end(out, at, color)
}

// build_help_text 生成完整帮助文本；失败返回空指针。
fn build_help_text(state *parser_state, mem *pool) *char {
    let scratch [MAX_HELP]char
    let at int = build_usage_line(state, &scratch[0])
    if (at < 0) {
        return 0
    }
    if (state.description != 0 && state.description[0] != 0) {
        at = put_break(&scratch[0], at)
        if (at < 0) {
            return 0
        }
        at = put_template_wrapped(&scratch[0], at, state, 0, state.description, 0,
            state.format_width, state.format_preserve_description, 0)
        if (at < 0) {
            return 0
        }
        at = put_break(&scratch[0], at)
        if (at < 0) {
            return 0
        }
    }
    let i int = 0
    if (has_visible_row(state, 1, 0) != 0 || has_visible_row(state, 1, 1) != 0) {
        at = put_title(&scratch[0], at, state,
            section_title(state.title_positional, "positional arguments"))
        if (at < 0) {
            return 0
        }
        for i < state.row_count {
            let row *arg_row = &state.rows[i]
            if (row.used != 0 && row.hidden == 0 && row.positional != 0) {
                at = append_help_row(&scratch[0], at, state, row, help_column(state, 22))
                if (at < 0) {
                    return 0
                }
            }
            i += 1
        }
    }
    if (has_visible_row(state, 0, 0) != 0) {
        at = put_title(&scratch[0], at, state,
            section_title(state.title_options, "options"))
        if (at < 0) {
            return 0
        }
        i = 0
        for i < state.row_count {
            let row *arg_row = &state.rows[i]
            if (row.used != 0 && row.hidden == 0 && row.positional == 0
                && row.group == 0) {
                at = append_help_row(&scratch[0], at, state, row, help_column(state, 26))
                if (at < 0) {
                    return 0
                }
            }
            i += 1
        }
    }
    i = 0
    for i < state.group_count {
        let group *group_row = &state.groups[i]
        if (group.used != 0) {
            let has_row int = 0
            let j int = 0
            for j < state.row_count {
                let row *arg_row = &state.rows[j]
                if (row.used != 0 && row.hidden == 0 && row.group == group.id) {
                    has_row = 1
                }
                j += 1
            }
            if (has_row != 0) {
                at = put_break(&scratch[0], at)
                if (at < 0) {
                    return 0
                }
                if (group.title != 0 && group.title[0] != 0) {
                    at = put_text(&scratch[0], at, group.title)
                    if (at < 0) {
                        return 0
                    }
                } else {
                    at = put_text(&scratch[0], at, "group")
                }
                at = put_text(&scratch[0], at, ":\n")
                if (at < 0) {
                    return 0
                }
                j = 0
                for j < state.row_count {
                    let row *arg_row = &state.rows[j]
                    if (row.used != 0 && row.hidden == 0 && row.group == group.id) {
                        at = append_help_row(&scratch[0], at, state, row, help_column(state, 26))
                        if (at < 0) {
                            return 0
                        }
                    }
                    j += 1
                }
            }
        }
        i += 1
    }
    if (state.child_count > 0) {
        if (state.slot_title != 0 && state.slot_title[0] != 0) {
            at = put_title(&scratch[0], at, state, state.slot_title)
        } else {
            at = put_title(&scratch[0], at, state,
                section_title(state.title_commands, "commands"))
        }
        if (at < 0) {
            return 0
        }
        if (state.slot_description != 0 && state.slot_description[0] != 0) {
            at = put_spaces(&scratch[0], at, 2)
            if (at < 0) {
                return 0
            }
            at = put_template_wrapped(&scratch[0], at, state, 0, state.slot_description, 2,
                state.format_width, 0, 0)
            if (at < 0) {
                return 0
            }
            at = put_break(&scratch[0], at)
            if (at < 0) {
                return 0
            }
        }
        // 槽自身的占位名行（argparse 在命令段里先给出 {add,list}），随后是命令说明行。
        at = put_spaces(&scratch[0], at, 2)
        if (at < 0) {
            return 0
        }
        at = put_slot_names(&scratch[0], at, state)
        if (at < 0) {
            return 0
        }
        at = put_break(&scratch[0], at)
        if (at < 0) {
            return 0
        }
        i = 0
        for i < state.child_count {
            let child *child_row = &state.children[i]
            if (child.used != 0) {
                at = put_spaces(&scratch[0], at, 4)
                if (at < 0) {
                    return 0
                }
                let name_start int = at
                at = put_text(&scratch[0], at, child.name)
                if (at < 0) {
                    return 0
                }
                let j int = 0
                for j < child.alias_count {
                    at = put_text(&scratch[0], at, ", ")
                    if (at < 0) {
                        return 0
                    }
                    at = put_text(&scratch[0], at, child.aliases[j])
                    if (at < 0) {
                        return 0
                    }
                    j += 1
                }
                let spaces int = help_column(state, 26) - 4 - (at - name_start)
                if (spaces < 2) {
                    spaces = 2
                }
                at = put_spaces(&scratch[0], at, spaces)
                if (at < 0) {
                    return 0
                }
                if (child.help != 0 && child.help[0] != 0) {
                    let expanded [MAX_HELP]char
                    let expanded_at int = put_template(&expanded[0], 0, state, 0,
                        child.help, 0)
                    if (expanded_at < 0) {
                        return 0
                    }
                    expanded[expanded_at] = 0
                    at = put_escaped(&scratch[0], at, &expanded[0])
                    if (at < 0) {
                        return 0
                    }
                }
                if (child.deprecated != 0) {
                    at = put_text(&scratch[0], at, " (deprecated)")
                    if (at < 0) {
                        return 0
                    }
                }
                at = put_break(&scratch[0], at)
                if (at < 0) {
                    return 0
                }
            }
            i += 1
        }
    }
    if (state.epilog != 0 && state.epilog[0] != 0) {
        at = put_break(&scratch[0], at)
        if (at < 0) {
            return 0
        }
        at = put_template_wrapped(&scratch[0], at, state, 0, state.epilog, 0,
            state.format_width, 0, 0)
        if (at < 0) {
            return 0
        }
        at = put_break(&scratch[0], at)
        if (at < 0) {
            return 0
        }
    }
    scratch[at] = 0
    return pool_dup(mem, &scratch[0])
}

// build_usage_text 只生成 usage 行文本；失败返回空指针。
fn build_usage_text(state *parser_state, mem *pool) *char {
    let scratch [MAX_HELP]char
    let at int = build_usage_line(state, &scratch[0])
    if (at < 0) {
        return 0
    }
    scratch[at] = 0
    return pool_dup(mem, &scratch[0])
}

// build_version_text 生成版本文本（模板或展示名 + 换行）。
fn build_version_text(state *parser_state, mem *pool, row *arg_row) *char {
    let scratch [MAX_TEXT]char
    let at int = 0
    if (row != 0 && row.version_text != 0) {
        at = put_template(&scratch[0], 0, state, row, row.version_text, 0)
    } else {
        at = put_text(&scratch[0], 0, state.prog)
    }
    if (at < 0) {
        return 0
    }
    at = put_char(&scratch[0], at, '\n')
    if (at < 0) {
        return 0
    }
    scratch[at] = 0
    return pool_dup(mem, &scratch[0])
}

// —— 公开格式化 API ——

// format_text 用给定生成器构造 TextResult。
fn format_text(state *parser_state, kind int) TextResult {
    let result TextResult
    result.status = ResultStatus.ok
    result.text = 0
    result.owner = 0
    clear_diagnostic(&result.error)
    if (state == 0) {
        result.status = ResultStatus.config_error
        result.error.code = CODE_CONFIG
        result.error.message = "parser 未初始化"
        return result
    }
    let owner *text_owner = malloc(sizeof(text_owner).to_type(u64)).to_type(*text_owner)
    if (owner == 0) {
        result.status = ResultStatus.resource_error
        result.error.message = "文本结果分配失败"
        return result
    }
    pool_init(&owner.mem)
    result.owner = owner.to_type(*void)
    if (kind == 0) {
        result.text = build_help_text(state, &owner.mem)
    } else {
        result.text = build_usage_text(state, &owner.mem)
    }
    if (result.text == 0) {
        result.status = ResultStatus.resource_error
        result.error.message = "文本生成失败"
    }
    return result
}

// format_help 生成帮助文本；失败时 TextResult.status 非 ok。
pub fn format_help(p *Parser) TextResult {
    return format_text(parser_state_of(p), 0)
}

// format_usage 生成 usage 文本；失败时 TextResult.status 非 ok。
pub fn format_usage(p *Parser) TextResult {
    return format_text(parser_state_of(p), 1)
}

// release_text 释放 TextResult 的文本与所有权并归零；零值可安全调用。
pub fn release_text(result *TextResult) void {
    if (result == 0) {
        return
    }
    if (result.owner != 0) {
        let owner *text_owner = result.owner.to_type(*text_owner)
        pool_free_all(&owner.mem)
        free(owner.to_type(*void))
        result.owner = 0
    }
    result.text = 0
    result.status = ResultStatus.ok
    clear_diagnostic(&result.error)
}

// render_text 把 TextResult 的文本写到指定文件描述符；0 成功、-1 失败。
pub fn render_text(text *TextResult, fd int) int {
    if (text == 0 || text.text == 0) {
        return -1
    }
    return io.write_all(fd, text.text, strlen(text.text).to_type(int))
}

// print_help 把帮助写到 fd；0 成功、-1 失败。
pub fn print_help(p *Parser, fd int) int {
    let text TextResult = format_help(p)
    if (text.status != ResultStatus.ok) {
        release_text(&text)
        return -1
    }
    let rc int = render_text(&text, fd)
    release_text(&text)
    return rc
}

// print_usage 把 usage 写到 fd；0 成功、-1 失败。
pub fn print_usage(p *Parser, fd int) int {
    let text TextResult = format_usage(p)
    if (text.status != ResultStatus.ok) {
        release_text(&text)
        return -1
    }
    let rc int = render_text(&text, fd)
    release_text(&text)
    return rc
}

// exit_code 返回结果对应的进程退出码：ok/help/version → 0，usage_error → 2，
// config/resource → 1。
pub fn exit_code(result *Result) int {
    if (result == 0) {
        return 1
    }
    if (result.status == ResultStatus.ok
        || result.status == ResultStatus.help_requested
        || result.status == ResultStatus.version_requested) {
        return 0
    }
    if (result.status == ResultStatus.usage_error) {
        return 2
    }
    return 1
}

// render_warnings 把运行期警告写到 error_fd；0 成功、-1 写入失败。
fn render_warnings(result *Result, error_fd int) int {
    if (result == 0) {
        return -1
    }
    let i int = 0
    for i < len(result.warnings) {
        if (io.write_all(error_fd, "警告: ", 8) != 0) {
            return -1
        }
        let message *char = result.warnings[i]
        if (message != 0
            && io.write_all(error_fd, message, strlen(message).to_type(int)) != 0) {
            return -1
        }
        if (io.write_all(error_fd, "\n", 1) != 0) {
            return -1
        }
        i += 1
    }
    return 0
}

// clear_warnings 清空已输出的警告，避免调用者之后 render 时重复打印。
fn clear_warnings(result *Result) void {
    if (result == 0) {
        return
    }
    let empty []*char
    result.warnings = empty
}

// render 按结果状态输出：控制文本写 out_fd，usage 与诊断写 error_fd；0/-1。
// 不退出、不释放；输出失败返回 -1（调用方据此把退出码降级为 1）。
pub fn render(result *Result, out_fd int, error_fd int) int {
    if (result == 0) {
        return -1
    }
    if (render_warnings(result, error_fd) != 0) {
        return -1
    }
    if (result.status == ResultStatus.help_requested
        || result.status == ResultStatus.version_requested) {
        if (result.control_text == 0) {
            return 0
        }
        if (io.write_all(out_fd, result.control_text,
                strlen(result.control_text).to_type(int)) != 0) {
            return -1
        }
        return 0
    }
    if (result.status == ResultStatus.ok) {
        return 0
    }
    let failed int = 0
    if (result.prog_text != 0) {
        if (io.write_all(error_fd, result.prog_text,
                strlen(result.prog_text).to_type(int)) != 0) {
            failed = 1
        }
    }
    if (io.write_all(error_fd, ": 错误: ", 10) != 0) {
        failed = 1
    }
    if (result.error.message != 0) {
        if (io.write_all(error_fd, result.error.message,
                strlen(result.error.message).to_type(int)) != 0) {
            failed = 1
        }
        if (io.write_all(error_fd, "\n", 1) != 0) {
            failed = 1
        }
    }
    if (result.usage_text != 0) {
        if (io.write_all(error_fd, result.usage_text,
                strlen(result.usage_text).to_type(int)) != 0) {
            failed = 1
        }
    }
    if (failed != 0) {
        return -1
    }
    return 0
}

// edit_distance 计算两个 NUL 串的 Levenshtein 距离；长度超限返回 99。
fn edit_distance(left *char, right *char) int {
    let nl int = strlen(left).to_type(int)
    let nr int = strlen(right).to_type(int)
    if (nl > 64 || nr > 64) {
        return 99
    }
    let previous [65]int
    let current [65]int
    let j int = 0
    for j <= nr {
        previous[j] = j
        j += 1
    }
    let i int = 1
    for i <= nl {
        current[0] = i
        j = 1
        for j <= nr {
            let cost int = 1
            if (left[i - 1] == right[j - 1]) {
                cost = 0
            }
            let del int = previous[j] + 1
            let ins int = current[j - 1] + 1
            let sub int = previous[j - 1] + cost
            let best int = del
            if (ins < best) {
                best = ins
            }
            if (sub < best) {
                best = sub
            }
            current[j] = best
            j += 1
        }
        j = 0
        for j <= nr {
            previous[j] = current[j]
            j += 1
        }
        i += 1
    }
    return previous[nr]
}

// suggest_choice 在 choices 的文本候选里找距离不超过 2 的最优项；没有返回 -1。
fn suggest_choice(row *arg_row, token *char) int {
    let best int = -1
    let best_distance int = 3
    let i int = 0
    for i < len(row.choices) {
        if (row.choices[i].kind == ValueKind.text && row.choices[i].data.text != 0) {
            let distance int = edit_distance(token, row.choices[i].data.text)
            if (distance < best_distance) {
                best_distance = distance
                best = i
            }
        }
        i += 1
    }
    return best
}

// suggest_command 在子命令规范名里找距离不超过 2 的最优项；没有返回 -1。
fn suggest_command(state *parser_state, token *char) int {
    let best int = -1
    let best_distance int = 3
    let i int = 0
    for i < state.child_count {
        let child *child_row = &state.children[i]
        if (child.used != 0) {
            let distance int = edit_distance(token, child.name)
            if (distance < best_distance) {
                best_distance = distance
                best = i
            }
        }
        i += 1
    }
    return best
}

// choices_message 构造「值不在候选集合」诊断：给出参数名、可选候选与（启用
// suggest_on_error 时的）建议；写入 buffer，返回写入长度，越界返回 -1。
fn choices_message(state *parser_state, row *arg_row, token *char, buffer *char) int {
    let at int = put_text(buffer, 0, "选项 ")
    if (at < 0) {
        return -1
    }
    at = put_escaped(buffer, at, row.names[0])
    if (at < 0) {
        return -1
    }
    at = put_text(buffer, at, " 的值不在候选集合中")
    if (at < 0) {
        return -1
    }
    if (state != 0 && state.suggest_on_error != 0 && token != 0) {
        let index int = suggest_choice(row, token)
        if (index >= 0) {
            at = put_text(buffer, at, "，是否想用 ")
            if (at < 0) {
                return -1
            }
            at = put_value_text(buffer, at, row.choices[index])
            if (at < 0) {
                return -1
            }
            at = put_text(buffer, at, "？")
            if (at < 0) {
                return -1
            }
        }
    }
    at = put_text(buffer, at, "（可选：")
    if (at < 0) {
        return -1
    }
    let i int = 0
    for i < len(row.choices) {
        if (i > 0) {
            at = put_text(buffer, at, ", ")
            if (at < 0) {
                return -1
            }
        }
        at = put_value_text(buffer, at, row.choices[i])
        if (at < 0) {
            return -1
        }
        i += 1
    }
    at = put_text(buffer, at, "）")
    if (at < 0) {
        return -1
    }
    buffer[at] = 0
    return at
}

// subcommand_message 构造「未知子命令」诊断：列出规范命令名与建议；失败返回 -1。
fn subcommand_message(state *parser_state, token *char, buffer *char) int {
    let at int = put_text(buffer, 0, "未知子命令 ")
    if (at < 0) {
        return -1
    }
    at = put_escaped(buffer, at, token)
    if (at < 0) {
        return -1
    }
    if (state.suggest_on_error != 0) {
        let index int = suggest_command(state, token)
        if (index >= 0) {
            at = put_text(buffer, at, "，是否想用 ")
            if (at < 0) {
                return -1
            }
            at = put_escaped(buffer, at, state.children[index].name)
            if (at < 0) {
                return -1
            }
            at = put_text(buffer, at, "？")
            if (at < 0) {
                return -1
            }
        }
    }
    at = put_text(buffer, at, "（可选：")
    if (at < 0) {
        return -1
    }
    let i int = 0
    let first int = 1
    for i < state.child_count {
        let child *child_row = &state.children[i]
        if (child.used != 0) {
            if (first == 0) {
                at = put_text(buffer, at, ", ")
                if (at < 0) {
                    return -1
                }
            }
            at = put_escaped(buffer, at, child.name)
            if (at < 0) {
                return -1
            }
            first = 0
        }
        i += 1
    }
    at = put_text(buffer, at, "）")
    if (at < 0) {
        return -1
    }
    buffer[at] = 0
    return at
}

// put_extra_args 写「多余的位置参数：a b c」；越界返回 -1。
fn put_extra_args(tokens []*char, buffer *char) int {
    let at int = put_text(buffer, 0, "多余的位置参数：")
    if (at < 0) {
        return -1
    }
    let i int = 0
    for i < len(tokens) {
        if (i > 0) {
            at = put_char(buffer, at, ' ')
            if (at < 0) {
                return -1
            }
        }
        at = put_escaped(buffer, at, tokens[i])
        if (at < 0) {
            return -1
        }
        i += 1
    }
    return at
}

// extra_args_message 构造「多余的位置参数」诊断：按输入顺序列出剩余 token；
// 超出 buffer 上限时退化为不加列表的短消息。
fn extra_args_message(tokens []*char, buffer *char) int {
    let at int = put_extra_args(tokens, buffer)
    if (at < 0) {
        at = put_text(buffer, 0, "多余的位置参数")
    }
    if (at < 0) {
        return -1
    }
    buffer[at] = 0
    return at
}

// suggest_option 在注册的长名称里找距离不超过 2 的最优候选；没有返回空指针。
fn suggest_option(state *parser_state, token *char) *char {
    let best *char = 0
    let best_distance int = 3
    let i int = 0
    for i < state.row_count {
        let row *arg_row = &state.rows[i]
        if (row.used != 0 && row.positional == 0) {
            let j int = 0
            for j < row.name_count {
                if (name_is_long(state, row.names[j]) != 0) {
                    let distance int = edit_distance(token, row.names[j])
                    if (distance < best_distance) {
                        best_distance = distance
                        best = row.names[j]
                    }
                }
                j += 1
            }
        }
        i += 1
    }
    return best
}
