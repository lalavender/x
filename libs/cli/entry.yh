module cli

// cli 入口适配（CLI1）：argc/argv 与 0/1/2 退出契约。
// parse_main_or_exit 只在解析成功（status=ok）时返回；帮助、版本、使用错误、
// 配置错误和资源错误都会输出诊断并结束进程。输出失败不改变退出码语义。

import os

// parse_main_or_exit 解析进程参数；仅在成功时返回结果，其余路径输出并退出。
// 帮助/版本退出码 0，使用错误 2，配置与资源错误 1；输出失败时退出码降级为 1。
pub fn parse_main_or_exit(p *Parser, argc int, argv **char) Result {
    let result Result = parse_main(p, argc, argv)
    if (result.status == ResultStatus.ok) {
        // 成功路径先输出运行期警告并清空，避免应用之后 render 时重复打印。
        render_warnings(&result, 2)
        clear_warnings(&result)
        return result
    }
    let code int = exit_code(&result)
    if (render(&result, 1, 2) != 0) {
        code = 1
    }
    release(&result)
    destroy(p)
    os.terminate(code)
    return result
}
