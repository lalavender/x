module cli

// cli 值转换（CLI2）：严格按声明的 value_kind 解析 token。
// 内置转换消费整个 token：integer 为 i64 十进制、natural 为 u64 十进制、
// real 为与 locale 无关的十进制/科学计数、boolean 只接受 true/false；
// 数值允许数字之间单个下划线，不接受前后空白、空串或越界。
// 十六进制、日期、枚举名称等由 CLI4 的自定义 converter 表达。

// —— 类型转换 ——

// parse_i64_text 严格解析十进制 i64（允许数字之间单个下划线）；0 成功、-1 失败。
fn parse_i64_text(text *char, out *i64) int {
    let i int = 0
    let negative int = 0
    if (text[0] == '-') {
        negative = 1
        i = 1
    } else if (text[0] == '+') {
        i = 1
    }
    if (text[i] == 0) {
        return -1
    }
    let limit u64 = 9223372036854775807
    if (negative != 0) {
        limit = 9223372036854775808
    }
    let value u64 = 0
    let digits int = 0
    let last_underscore int = 0
    for text[i] != 0 {
        let ch int = text[i].to_type(int)
        if (ch == '_') {
            if (digits == 0 || last_underscore != 0) {
                return -1
            }
            last_underscore = 1
            i += 1
            continue
        }
        if (ch < '0' || ch > '9') {
            return -1
        }
        let digit u64 = (ch - '0').to_type(u64)
        if (value > (limit - digit) / 10) {
            return -1
        }
        value = value * 10 + digit
        digits += 1
        last_underscore = 0
        i += 1
    }
    if (digits == 0 || last_underscore != 0) {
        return -1
    }
    if (negative != 0) {
        *out = (0 - value).to_type(i64)
        return 0
    }
    *out = value.to_type(i64)
    return 0
}

// parse_u64_text 严格解析十进制 u64（允许数字之间单个下划线）；0 成功、-1 失败。
fn parse_u64_text(text *char, out *u64) int {
    let i int = 0
    if (text[0] == '+') {
        i = 1
    }
    if (text[i] == 0) {
        return -1
    }
    let value u64 = 0
    let digits int = 0
    let last_underscore int = 0
    for text[i] != 0 {
        let ch int = text[i].to_type(int)
        if (ch == '_') {
            if (digits == 0 || last_underscore != 0) {
                return -1
            }
            last_underscore = 1
            i += 1
            continue
        }
        if (ch < '0' || ch > '9') {
            return -1
        }
        let digit u64 = (ch - '0').to_type(u64)
        if (value > (18446744073709551615 - digit) / 10) {
            return -1
        }
        value = value * 10 + digit
        digits += 1
        last_underscore = 0
        i += 1
    }
    if (digits == 0 || last_underscore != 0) {
        return -1
    }
    *out = value
    return 0
}

// parse_bool_text 只接受 true/false（小写）；0 成功、-1 失败。
fn parse_bool_text(text *char, out *bool) int {
    if (cstr_equal(text, "true") != 0) {
        *out = true
        return 0
    }
    if (cstr_equal(text, "false") != 0) {
        *out = false
        return 0
    }
    return -1
}

// parse_f64_text 严格解析十进制/科学计数浮点；0 成功、-1 失败。
// 语法：可选符号、十进制数字、可选小数点与数字、可选 e/E 指数。
fn parse_f64_text(text *char, out *f64) int {
    let i int = 0
    let negative int = 0
    if (text[0] == '-') {
        negative = 1
        i = 1
    } else if (text[0] == '+') {
        i = 1
    }
    let mantissa f64 = 0.0
    let digits int = 0
    for text[i] >= '0' && text[i] <= '9' {
        mantissa = mantissa * 10.0 + (text[i].to_type(int) - '0').to_type(f64)
        digits += 1
        i += 1
    }
    if (text[i] == '.') {
        i += 1
        let scale f64 = 0.1
        for text[i] >= '0' && text[i] <= '9' {
            mantissa += (text[i].to_type(int) - '0').to_type(f64) * scale
            scale = scale * 0.1
            digits += 1
            i += 1
        }
    }
    if (digits == 0) {
        return -1
    }
    let exponent int = 0
    if (text[i] == 'e' || text[i] == 'E') {
        i += 1
        let exponent_negative int = 0
        if (text[i] == '-') {
            exponent_negative = 1
            i += 1
        } else if (text[i] == '+') {
            i += 1
        }
        let exp_digits int = 0
        for text[i] >= '0' && text[i] <= '9' {
            if (exponent < 100000) {
                exponent = exponent * 10 + (text[i].to_type(int) - '0')
            }
            exp_digits += 1
            i += 1
        }
        if (exp_digits == 0) {
            return -1
        }
        if (exponent_negative != 0) {
            exponent = 0 - exponent
        }
    }
    if (text[i] != 0) {
        return -1
    }
    let scale f64 = 1.0
    let step int = 0
    let steps int = exponent
    if (steps < 0) {
        steps = 0 - steps
    }
    for step < steps {
        scale = scale * 10.0
        step += 1
    }
    if (exponent >= 0) {
        mantissa = mantissa * scale
    } else {
        mantissa = mantissa / scale
    }
    if (negative != 0) {
        mantissa = 0.0 - mantissa
    }
    *out = mantissa
    return 0
}

// convert_token 按声明的 value_kind 转换一个 token；0 成功、-1 失败。
fn convert_token(kind int, token *char, out *Value) int {
    if (kind == ValueKind.text.to_type(int)) {
        *out = value_text(token)
        return 0
    }
    if (kind == ValueKind.integer.to_type(int)) {
        let number i64 = 0
        if (parse_i64_text(token, &number) != 0) {
            return -1
        }
        *out = value_i64(number)
        return 0
    }
    if (kind == ValueKind.natural.to_type(int)) {
        let number u64 = 0
        if (parse_u64_text(token, &number) != 0) {
            return -1
        }
        *out = value_u64(number)
        return 0
    }
    if (kind == ValueKind.real.to_type(int)) {
        let number f64 = 0.0
        if (parse_f64_text(token, &number) != 0) {
            return -1
        }
        *out = value_f64(number)
        return 0
    }
    if (kind == ValueKind.boolean.to_type(int)) {
        let flag bool = false
        if (parse_bool_text(token, &flag) != 0) {
            return -1
        }
        *out = value_bool(flag)
        return 0
    }
    return -1
}

