module main

// cli 弃用警告入口验收：parse_main_or_exit 成功时把警告写到 stderr 并清空，
// 应用随后看到的 result.warnings 为空。
// 运行：cliwarnings --old x in.txt

import cli

// main 用 deprecated 选项走成功入口，打印剩余警告数与位置值。
fn main(argc int, argv **char) int {
    let parser cli.Parser
    let config cli.ParserConfig = cli.parser_config("warn")
    if (cli.init(&parser, config) != 0) {
        return 1
    }
    let old cli.Argument = cli.option("--old", 0)
    old.deprecated = true
    let source cli.Argument = cli.positional("src")
    if (cli.add_argument(&parser, old) < 0
        || cli.add_argument(&parser, source) < 0) {
        cli.destroy(&parser)
        return 2
    }
    let result cli.Result = cli.parse_main_or_exit(&parser, argc, argv)
    let src *char
    if (cli.get_text(&result.values, "src", &src) != 0) {
        src = ""
    }
    printf("warnings=%d src=%s\n", len(result.warnings), src)
    cli.release(&result)
    cli.destroy(&parser)
    return 0
}
