// —— 主题 12：深度与 token 上限 ——
fn case_fromfile_limits() int {
    let root cli.Parser
    let setup int = build_file_parser(&root, 0)
    if (setup != 0) {
        return 121
    }
    if (write_text_file("cli-a.txt", "@cli-b.txt\n") != 0
        || write_text_file("cli-b.txt", "--level\n3\nz.bin\n") != 0) {
        cli.destroy(&root)
        return 122
    }
    let spec cli.ParseConfig = cli.parse_config()
    spec.file_max_depth = 0
    let args [2]*char
    args[0] = "@cli-a.txt"
    let r cli.Result = cli.parse_with(&root, args[0..1], spec)
    if (r.status != cli.resource_error) {
        cli.release(&r)
        cli.destroy(&root)
        os.remove_file("cli-a.txt")
        os.remove_file("cli-b.txt")
        return 123
    }
    cli.release(&r)
    // token 上限：文件两行但上限为 1。
    let spec2 cli.ParseConfig = cli.parse_config()
    spec2.file_max_tokens = 1
    let r2 cli.Result = cli.parse_with(&root, args[0..1], spec2)
    if (r2.status != cli.resource_error) {
        cli.release(&r2)
        cli.destroy(&root)
        os.remove_file("cli-a.txt")
        os.remove_file("cli-b.txt")
        return 124
    }
    cli.release(&r2)
    cli.destroy(&root)
    os.remove_file("cli-a.txt")
    os.remove_file("cli-b.txt")
    return 0
}

// —— 主题 13：逐行回调 ——
fn case_line_converter() int {
    let root cli.Parser
    let setup int = build_file_parser(&root, 1)
    if (setup != 0) {
        return 131
    }
    if (write_text_file("cli-lines.txt", "--level 9\nfrom-line.bin\n") != 0) {
        cli.destroy(&root)
        return 132
    }
    let args [2]*char
    args[0] = "@cli-lines.txt"
    let r cli.Result = cli.parse(&root, args[0..1])
    let level i64 = 0
    let text *char
    if (r.status != cli.ok || cli.get_i64(&r.values, "level", &level) != 0
        || level != 9) {
        cli.release(&r)
        cli.destroy(&root)
        os.remove_file("cli-lines.txt")
        return 133
    }
    if (cli.get_text(&r.values, "source", &text) != 0
        || string.equals(text, "from-line.bin") != 1) {
        cli.release(&r)
        cli.destroy(&root)
        os.remove_file("cli-lines.txt")
        return 134
    }
    cli.release(&r)
    cli.destroy(&root)
    os.remove_file("cli-lines.txt")
    return 0
}

// —— 主题 14：子 parser 不能设置参数文件配置 ——
fn case_child_fromfile_rejected() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 141
    }
    let slot int = cli.add_subparsers(&root, cli.subparsers())
    if (slot < 0) {
        cli.destroy(&root)
        return 142
    }
    let cmd cli.Command = cli.command("go")
    cmd.config.fromfile_prefix_chars = "@"
    let child *cli.Parser = cli.add_parser(&root, slot, cmd)
    if (child == 0) {
        cli.destroy(&root)
        return 143
    }
    let args [2]*char
    args[0] = "go"
    let r cli.Result = cli.parse(&root, args[0..1])
    if (r.status != cli.config_error) {
        cli.release(&r)
        cli.destroy(&root)
        return 144
    }
    cli.release(&r)
    cli.destroy(&root)
    return 0
}

// —— 主题 15：分配失败注入 ——
fn case_alloc_failure() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 151
    }
    let first cli.Argument = cli.option("--first", 0)
    if (cli.add_argument(&root, first) < 0) {
        cli.destroy(&root)
        return 152
    }
    let before int = cli.test_alloc_count(&root)
    if (before <= 0) {
        cli.destroy(&root)
        return 153
    }
    if (cli.test_fail_alloc_after(&root, before) != 0) {
        cli.destroy(&root)
        return 154
    }
    let second cli.Argument = cli.option("--second", 0)
    if (cli.add_argument(&root, second) != -1) {
        cli.destroy(&root)
        return 155
    }
    let diag cli.Diagnostic = cli.last_error(&root)
    if (diag.message == 0) {
        cli.destroy(&root)
        return 156
    }
    cli.test_fail_alloc_after(&root, -1)
    cli.destroy(&root)
    // 解析期分配失败：结果池分配失败必须给出 resource_error。
    let parser2 cli.Parser
    let config2 cli.ParserConfig = cli.parser_config("tool2")
    if (cli.init(&parser2, config2) != 0) {
        return 157
    }
    let source cli.Argument = cli.positional("source")
    if (cli.add_argument(&parser2, source) < 0) {
        cli.destroy(&parser2)
        return 158
    }
    let count int = cli.test_alloc_count(&parser2)
    if (cli.test_fail_alloc_after(&parser2, count) != 0) {
        cli.destroy(&parser2)
        return 159
    }
    let args [2]*char
    args[0] = "x"
    let r cli.Result = cli.parse(&parser2, args[0..1])
    // 结果池与 parser 池相互独立：parser 池被注入失败也不影响本次解析。
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&parser2)
        return 160
    }
    cli.release(&r)
    cli.destroy(&parser2)
    return 0
}

// run_all 依次运行全部主题；返回第一个失败码或 0。
fn run_all() int {
    let rc int = case_converter()
    if (rc != 0) {
        return rc
    }
    rc = case_converter_shape()
    if (rc != 0) {
        return rc
    }
    rc = case_validator()
    if (rc != 0) {
        return rc
    }
    rc = case_custom_action()
    if (rc != 0) {
        return rc
    }
    rc = case_custom_shape()
    if (rc != 0) {
        return rc
    }
    rc = case_registry()
    if (rc != 0) {
        return rc
    }
    rc = case_bad_declarations()
    if (rc != 0) {
        return rc
    }
    rc = case_fromfile()
    if (rc != 0) {
        return rc
    }
    rc = case_fromfile_nested()
    if (rc != 0) {
        return rc
    }
    rc = case_fromfile_cycle()
    if (rc != 0) {
        return rc
    }
    rc = case_fromfile_missing()
    if (rc != 0) {
        return rc
    }
    rc = case_fromfile_limits()
    if (rc != 0) {
        return rc
    }
    rc = case_line_converter()
    if (rc != 0) {
        return rc
    }
    rc = case_child_fromfile_rejected()
    if (rc != 0) {
        return rc
    }
    return case_alloc_failure()
}

// main 在 --selftest 下运行 CLI4 语义断言，否则打印提示并返回 0。
fn main(argc int, argv **char) int {
    if (argc > 1 && string.equals(argv[1], "--selftest") == 1) {
        let rc int = run_all()
        if (rc != 0) {
            printf("cli4 selftest fail: %d\n", rc)
        }
        return rc
    }
    io.println("cliextensions: 使用 --selftest 运行验收断言")
    return 0
}
