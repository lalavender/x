module model;

// CLI0 语言能力与 ABI 基线探针：这里只验证 libs/cli 设计依赖的语言能力，
// 不实现任何解析逻辑。模型取自设计《yh-cli标准库设计》第 5 节的数据模型。

// ValueKind 标识 Value 当前使用的载荷成员；none 表示显式空值。
pub enum ValueKind {
    none;
    text;
    integer;
    natural;
    real;
    boolean;
    sequence;
}

// ValueData 只写入 Value.kind 对应的成员；items 用不透明指针表示嵌套序列
// （union 内既不能引用尚未定义完的 Value 的切片，也不能引用它的类型指针）。
pub union ValueData {
    text *char;
    integer i64;
    natural u64;
    real f64;
    boolean bool;
    items *void;
}

// Value 是带标签的值视图；文本和切片的所有权取决于所属声明或结果。
pub struct Value {
    kind ValueKind;
    data ValueData;
}

// Node 是递归列表节点；next 为空指针表示表尾。
pub struct Node {
    value int;
    next *Node;
}

// Handle 是公开薄句柄：内部状态由 model 私有实现持有，调用者不得改写 inner。
pub struct Handle {
    inner *void;
}

// handle_state 是 Handle 的私有实现，不出现在任何 pub 签名里。
struct handle_state {
    count int;
    items [8]int;
}

// make_none 返回显式空值，载荷不读取。
pub fn make_none() Value {
    let v Value;
    v.kind = ValueKind.none;
    return v;
}

// make_text 返回借用调用者字符串的文本值。
pub fn make_text(content *char) Value {
    let v Value;
    v.kind = ValueKind.text;
    v.data.text = content;
    return v;
}

// make_integer 返回 64 位有符号整数值。
pub fn make_integer(number i64) Value {
    let v Value;
    v.kind = ValueKind.integer;
    v.data.integer = number;
    return v;
}

// make_real 返回 64 位浮点值。
pub fn make_real(number f64) Value {
    let v Value;
    v.kind = ValueKind.real;
    v.data.real = number;
    return v;
}

// kind_of 读取标签；跨模块调用者据此选择成员。
pub fn kind_of(v Value) ValueKind {
    return v.kind;
}

// number_of 读取 integer 载荷；只有 kind=integer 时结果有意义。
pub fn number_of(v Value) i64 {
    return v.data.integer;
}

// node_sum 递归求链表元素之和，覆盖递归指针类型与自调用。
pub fn node_sum(head *Node) int {
    let total int = 0;
    let cursor *Node = head;
    for cursor != 0 {
        total += cursor.value;
        cursor = cursor.next;
    }
    return total;
}

// Bag 是公开的定长值缓冲区；字段无 pub，调用者只能通过下面四个函数使用。
pub struct Bag {
    items [4]Value;
    count int;
}

// bag_new 堆分配一个空 Bag；失败返回空指针。
pub fn bag_new() *Bag {
    let bag *Bag = malloc(sizeof(Bag).to_type(u64)).to_type(*Bag);
    if (bag != 0) {
        bag.count = 0;
    }
    return bag;
}

// bag_push 追加一个值；bag 为空或已满返回 -1，成功返回 0。
pub fn bag_push(bag *Bag, v Value) int {
    if (bag == 0 || bag.count >= 4) {
        return -1;
    }
    bag.items[bag.count] = v;
    bag.count += 1;
    return 0;
}

// bag_view 返回堆内数组的切片视图，验证跨模块返回 []Value 的 ABI。
pub fn bag_view(bag *Bag) []Value {
    return bag.items[0..bag.count];
}

// bag_destroy 释放 Bag；空指针可安全传入。
pub fn bag_destroy(bag *Bag) {
    if (bag != 0) {
        free(bag.to_type(*void));
    }
}

// sequence_sum 累加整数序列，覆盖切片元素的聚合读取。
pub fn sequence_sum(values []Value) i64 {
    let total i64 = 0;
    for _, v in values {
        if (v.kind == ValueKind.integer) {
            total += v.data.integer;
        }
    }
    return total;
}

// apply_callback 以 user 指针调用回调，覆盖函数类型形参与 *void 上下文。
pub fn apply_callback(call fn(*void, int) int, user *void, value int) int {
    return call(user, value);
}

// handle_new 堆分配薄句柄；失败返回 inner 为空指针的句柄。
pub fn handle_new() Handle {
    let handle Handle;
    handle.inner = 0;
    let state *handle_state = malloc(sizeof(handle_state).to_type(u64)).to_type(*handle_state);
    if (state == 0) {
        return handle;
    }
    state.count = 0;
    handle.inner = state.to_type(*void);
    return handle;
}

// handle_push 追加一个整数；句柄无效或容量已满返回 -1，成功返回 0。
pub fn handle_push(handle *Handle, value int) int {
    if (handle.inner == 0) {
        return -1;
    }
    let state *handle_state = handle.inner.to_type(*handle_state);
    if (state.count >= 8) {
        return -1;
    }
    state.items[state.count] = value;
    state.count += 1;
    return 0;
}

// handle_view 返回私有数组的切片视图，验证公开薄句柄加堆内数组的 ABI。
pub fn handle_view(handle *Handle) []int {
    let state *handle_state = handle.inner.to_type(*handle_state);
    return state.items[0..state.count];
}

// handle_destroy 释放私有状态并把句柄归零；零值可安全调用。
pub fn handle_destroy(handle *Handle) {
    if (handle.inner == 0) {
        return;
    }
    free(handle.inner);
    handle.inner = 0;
}
