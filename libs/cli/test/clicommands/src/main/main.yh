module main

// cli 标准库 CLI3 验收：子命令与别名、规范 command_path、槽 dest、
// 父子默认值合成、inherit 深复制、展示组与互斥组、known/intermixed 模式、
// initial 快照与 resolve 冲突策略。每个主题返回 0 或「主题*10+断言号」。

import cli
import io
import string

// text_is 断言 dest 的文本值等于期望。
fn text_is(values *cli.Namespace, dest *char, want *char) int {
    let text *char
    if (cli.get_text(values, dest, &text) != 0) {
        return 1
    }
    if (string.equals(text, want) != 1) {
        return 2
    }
    return 0
}

// build_tool 构造「根 + build 子命令」的 parser；返回 0 或失败码。
fn build_tool(root *cli.Parser) int {
    let config cli.ParserConfig = cli.parser_config("tool")
    config.description = "构建工具"
    if (cli.init(root, config) != 0) {
        return 1
    }
    let verbose cli.Argument = cli.option("--verbose", "-v")
    verbose.action = cli.count
    if (cli.add_argument(root, verbose) < 0) {
        return 2
    }
    // 根显式默认值：子命令同名 dest 的默认值应当覆盖它。
    let mode cli.Argument = cli.option("--mode", 0)
    mode.default_value = cli.default_of(cli.value_text("root"))
    if (cli.add_argument(root, mode) < 0) {
        return 3
    }
    let slot int = cli.add_subparsers(root, cli.subparsers())
    if (slot < 0) {
        return 4
    }
    let spec cli.Command = cli.command("build")
    let aliases [1]*char
    aliases[0] = "b"
    spec.aliases = aliases.to_type([]*char)
    spec.help = "构建目标"
    let child *cli.Parser = cli.add_parser(root, slot, spec)
    if (child == 0) {
        return 5
    }
    let output cli.Argument = cli.option("--output", "-o")
    output.default_value = cli.default_of(cli.value_text("a.bin"))
    if (cli.add_argument(child, output) < 0) {
        return 6
    }
    let child_mode cli.Argument = cli.option("--mode", 0)
    child_mode.default_value = cli.default_of(cli.value_text("child"))
    if (cli.add_argument(child, child_mode) < 0) {
        return 7
    }
    let source cli.Argument = cli.positional("source")
    if (cli.add_argument(child, source) < 0) {
        return 8
    }
    return 0
}

// —— 主题 1：子命令、别名与 command_path ——
fn case_subcommands() int {
    let root cli.Parser
    let setup int = build_tool(&root)
    if (setup != 0) {
        cli.destroy(&root)
        return 11
    }
    let args [5]*char
    args[0] = "build"
    args[1] = "in.txt"
    args[2] = "--output"
    args[3] = "out.bin"
    let r cli.Result = cli.parse(&root, args[0..4])
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&root)
        return 12
    }
    if (len(r.command_path) != 1 || string.equals(r.command_path[0], "build") != 1) {
        cli.release(&r)
        cli.destroy(&root)
        return 13
    }
    if (text_is(&r.values, "source", "in.txt") != 0
        || text_is(&r.values, "output", "out.bin") != 0) {
        cli.release(&r)
        cli.destroy(&root)
        return 14
    }
    cli.release(&r)
    // 别名只影响匹配：command_path 仍是规范名。
    let alias [2]*char
    alias[0] = "b"
    alias[1] = "in.txt"
    let r2 cli.Result = cli.parse(&root, alias[0..2])
    if (r2.status != cli.ok || len(r2.command_path) != 1
        || string.equals(r2.command_path[0], "build") != 1) {
        cli.release(&r2)
        cli.destroy(&root)
        return 15
    }
    cli.release(&r2)
    // 未知子命令即使 known 模式也是错误。
    let unknown [2]*char
    unknown[0] = "nope"
    let r3 cli.Result = cli.parse_known(&root, unknown[0..1])
    if (r3.status != cli.usage_error) {
        cli.release(&r3)
        cli.destroy(&root)
        return 16
    }
    cli.release(&r3)
    cli.destroy(&root)
    return 0
}

// —— 主题 2：父子默认值合成与根显式值 ——
fn case_parent_child_defaults() int {
    let root cli.Parser
    let setup int = build_tool(&root)
    if (setup != 0) {
        cli.destroy(&root)
        return 21
    }
    let args [2]*char
    args[0] = "build"
    args[1] = "in.txt"
    let r cli.Result = cli.parse(&root, args[0..2])
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&root)
        return 22
    }
    // 子默认值覆盖根默认值。
    if (text_is(&r.values, "mode", "child") != 0) {
        cli.release(&r)
        cli.destroy(&root)
        return 23
    }
    cli.release(&r)
    // 根显式值不被子默认覆盖。
    let explicit [4]*char
    explicit[0] = "--mode"
    explicit[1] = "rootx"
    explicit[2] = "build"
    explicit[3] = "in.txt"
    let r2 cli.Result = cli.parse(&root, explicit[0..4])
    if (r2.status != cli.ok || text_is(&r2.values, "mode", "rootx") != 0) {
        cli.release(&r2)
        cli.destroy(&root)
        return 24
    }
    cli.release(&r2)
    cli.destroy(&root)
    return 0
}

// —— 主题 3：子命令槽的 dest 与必需命令 ——
fn case_required_command() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 31
    }
    let spec cli.Subparsers = cli.subparsers()
    spec.dest = "command"
    spec.required = true
    let slot int = cli.add_subparsers(&root, spec)
    if (slot < 0) {
        return 32
    }
    let cmd cli.Command = cli.command("run")
    let child *cli.Parser = cli.add_parser(&root, slot, cmd)
    if (child == 0) {
        return 33
    }
    let empty [1]*char
    let r cli.Result = cli.parse(&root, empty[0..0])
    if (r.status != cli.usage_error) {
        cli.release(&r)
        cli.destroy(&root)
        return 34
    }
    cli.release(&r)
    let args [2]*char
    args[0] = "run"
    let r2 cli.Result = cli.parse(&root, args[0..1])
    if (r2.status != cli.ok) {
        cli.release(&r2)
        cli.destroy(&root)
        return 35
    }
    if (text_is(&r2.values, "command", "run") != 0) {
        cli.release(&r2)
        cli.destroy(&root)
        return 36
    }
    cli.release(&r2)
    cli.destroy(&root)
    return 0
}

// —— 主题 4：inherit 深复制（全局公共 parent） ——
fn case_inherit() int {
    let parent cli.Parser
    let pconfig cli.ParserConfig = cli.parser_config("common")
    pconfig.add_help = false
    if (cli.init(&parent, pconfig) != 0) {
        return 41
    }
    let color cli.Argument = cli.option("--color", 0)
    color.action = cli.store_true
    if (cli.add_argument(&parent, color) < 0) {
        return 42
    }
    let root cli.Parser
    let rconfig cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, rconfig) != 0) {
        cli.destroy(&parent)
        return 43
    }
    if (cli.inherit(&root, &parent) != 0) {
        cli.destroy(&root)
        cli.destroy(&parent)
        return 44
    }
    let slot int = cli.add_subparsers(&root, cli.subparsers())
    if (slot < 0) {
        cli.destroy(&root)
        cli.destroy(&parent)
        return 45
    }
    let cmd cli.Command = cli.command("go")
    let child *cli.Parser = cli.add_parser(&root, slot, cmd)
    if (child == 0) {
        cli.destroy(&root)
        cli.destroy(&parent)
        return 46
    }
    if (cli.inherit(child, &parent) != 0) {
        cli.destroy(&root)
        cli.destroy(&parent)
        return 47
    }
    // 深复制：inherit 之后给 parent 再加参数，不应出现在 child 里。
    let late cli.Argument = cli.option("--late", 0)
    if (cli.add_argument(&parent, late) < 0) {
        cli.destroy(&root)
        cli.destroy(&parent)
        return 48
    }
    let args [4]*char
    args[0] = "--color"
    args[1] = "go"
    args[2] = "--color"
    let r cli.Result = cli.parse(&root, args[0..3])
    let flag bool = false
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&root)
        cli.destroy(&parent)
        return 49
    }
    if (cli.get_bool(&r.values, "color", &flag) != 0 || flag != true) {
        cli.release(&r)
        cli.destroy(&root)
        cli.destroy(&parent)
        return 50
    }
    cli.release(&r)
    // child 不认识 inherit 之后才加到 parent 的 --late。
    let late_args [2]*char
    late_args[0] = "go"
    late_args[1] = "--late"
    let r2 cli.Result = cli.parse(&root, late_args[0..2])
    if (r2.status != cli.usage_error) {
        cli.release(&r2)
        cli.destroy(&root)
        cli.destroy(&parent)
        return 51
    }
    cli.release(&r2)
    cli.destroy(&root)
    cli.destroy(&parent)
    return 0
}

// —— 主题 5：展示组默认值与组级 resolve ——
fn case_groups() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 61
    }
    let gspec cli.Group = cli.group("输出", "输出相关参数")
    gspec.argument_default = cli.default_of(cli.value_text("group-default"))
    let group_id int = cli.add_group(&root, gspec)
    if (group_id <= 0) {
        return 62
    }
    let fmt cli.Argument = cli.option("--fmt", 0)
    fmt.group = group_id
    if (cli.add_argument(&root, fmt) < 0) {
        return 63
    }
    let empty [1]*char
    let r cli.Result = cli.parse(&root, empty[0..0])
    if (r.status != cli.ok || text_is(&r.values, "fmt", "group-default") != 0) {
        cli.release(&r)
        cli.destroy(&root)
        return 64
    }
    cli.release(&r)
    cli.destroy(&root)
    // 组级 resolve：同名旧选项被移除名称并停用。
    let parser2 cli.Parser
    let config2 cli.ParserConfig = cli.parser_config("tool2")
    if (cli.init(&parser2, config2) != 0) {
        return 65
    }
    let gspec2 cli.Group = cli.group("冲突", 0)
    gspec2.conflict = cli.resolve
    let group2 int = cli.add_group(&parser2, gspec2)
    if (group2 <= 0) {
        return 66
    }
    let first cli.Argument = cli.option("--dup", 0)
    first.group = group2
    if (cli.add_argument(&parser2, first) < 0) {
        return 67
    }
    let second cli.Argument = cli.option("--dup", 0)
    second.group = group2
    second.value_kind = cli.integer
    if (cli.add_argument(&parser2, second) < 0) {
        return 68
    }
    let args [2]*char
    args[0] = "--dup"
    args[1] = "5"
    let r2 cli.Result = cli.parse(&parser2, args[0..2])
    let number i64 = 0
    if (r2.status != cli.ok || cli.get_i64(&r2.values, "dup", &number) != 0
        || number != 5) {
        cli.release(&r2)
        cli.destroy(&parser2)
        return 69
    }
    cli.release(&r2)
    cli.destroy(&parser2)
    return 0
}

// —— 主题 6：互斥组 ——
fn case_mutex() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 71
    }
    let mutex int = cli.add_mutex(&root, false, 0)
    if (mutex <= 0) {
        return 72
    }
    let json cli.Argument = cli.option("--json", 0)
    json.action = cli.store_true
    json.mutex = mutex
    let yaml cli.Argument = cli.option("--yaml", 0)
    yaml.action = cli.store_true
    yaml.mutex = mutex
    if (cli.add_argument(&root, json) < 0 || cli.add_argument(&root, yaml) < 0) {
        cli.destroy(&root)
        return 73
    }
    let both [3]*char
    both[0] = "--json"
    both[1] = "--yaml"
    let r cli.Result = cli.parse(&root, both[0..2])
    if (r.status != cli.usage_error) {
        cli.release(&r)
        cli.destroy(&root)
        return 74
    }
    cli.release(&r)
    let one [2]*char
    one[0] = "--json"
    let r2 cli.Result = cli.parse(&root, one[0..1])
    if (r2.status != cli.ok) {
        cli.release(&r2)
        cli.destroy(&root)
        return 75
    }
    cli.release(&r2)
    cli.destroy(&root)
    // required 互斥组：必须恰好一个成员显式出现。
    let parser2 cli.Parser
    let config2 cli.ParserConfig = cli.parser_config("tool2")
    if (cli.init(&parser2, config2) != 0) {
        return 76
    }
    let req int = cli.add_mutex(&parser2, true, 0)
    if (req <= 0) {
        return 77
    }
    let aa cli.Argument = cli.option("--aa", 0)
    aa.action = cli.store_true
    aa.mutex = req
    let bb cli.Argument = cli.option("--bb", 0)
    bb.action = cli.store_true
    bb.mutex = req
    if (cli.add_argument(&parser2, aa) < 0 || cli.add_argument(&parser2, bb) < 0) {
        cli.destroy(&parser2)
        return 78
    }
    let empty [1]*char
    let r3 cli.Result = cli.parse(&parser2, empty[0..0])
    if (r3.status != cli.usage_error) {
        cli.release(&r3)
        cli.destroy(&parser2)
        return 79
    }
    cli.release(&r3)
    let r4 cli.Result = cli.parse(&parser2, one[0..1])
    // --json 不属于这个互斥组，因此仍应报缺少成员。
    if (r4.status != cli.usage_error) {
        cli.release(&r4)
        cli.destroy(&parser2)
        return 80
    }
    cli.release(&r4)
    let bb_args [2]*char
    bb_args[0] = "--bb"
    let r5 cli.Result = cli.parse(&parser2, bb_args[0..1])
    if (r5.status != cli.ok) {
        cli.release(&r5)
        cli.destroy(&parser2)
        return 81
    }
    cli.release(&r5)
    cli.destroy(&parser2)
    return 0
}

// —— 主题 7：parse_known 保留未知 token ——
fn case_known() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 91
    }
    let verbose cli.Argument = cli.option("--verbose", "-v")
    verbose.action = cli.count
    let file cli.Argument = cli.positional("file")
    if (cli.add_argument(&root, verbose) < 0 || cli.add_argument(&root, file) < 0) {
        cli.destroy(&root)
        return 92
    }
    let args [5]*char
    args[0] = "--unknown"
    args[1] = "x"
    args[2] = "--verbose"
    args[3] = "input.bin"
    args[4] = "extra.bin"
    let r cli.Result = cli.parse_known(&root, args[0..5])
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&root)
        return 93
    }
    // file 吃 x；input.bin/extra.bin 依次多余（single 只吃一个）。
    if (text_is(&r.values, "file", "x") != 0) {
        cli.release(&r)
        cli.destroy(&root)
        return 94
    }
    if (len(r.unparsed) != 3
        || string.equals(r.unparsed[0], "--unknown") != 1
        || string.equals(r.unparsed[1], "input.bin") != 1
        || string.equals(r.unparsed[2], "extra.bin") != 1) {
        cli.release(&r)
        cli.destroy(&root)
        return 95
    }
    cli.release(&r)
    // 未知短组合整 token 保留，不累计 -v；位置参数照常消费。
    let cluster [3]*char
    cluster[0] = "-vx"
    cluster[1] = "f.txt"
    let r2 cli.Result = cli.parse_known(&root, cluster[0..2])
    let level i64 = 0
    if (r2.status != cli.ok || len(r2.unparsed) != 1
        || string.equals(r2.unparsed[0], "-vx") != 1) {
        cli.release(&r2)
        cli.destroy(&root)
        return 96
    }
    if (cli.get_i64(&r2.values, "verbose", &level) != -2) {
        cli.release(&r2)
        cli.destroy(&root)
        return 97
    }
    if (text_is(&r2.values, "file", "f.txt") != 0) {
        cli.release(&r2)
        cli.destroy(&root)
        return 98
    }
    cli.release(&r2)
    cli.destroy(&root)
    return 0
}

// —— 主题 8：intermixed 跨选项收集与声明限制 ——
fn case_intermixed() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 101
    }
    let level cli.Argument = cli.option("--level", 0)
    level.value_kind = cli.integer
    let files cli.Argument = cli.positional("files")
    files.arity = cli.zero_or_more()
    if (cli.add_argument(&root, level) < 0 || cli.add_argument(&root, files) < 0) {
        cli.destroy(&root)
        return 102
    }
    let args [5]*char
    args[0] = "a"
    args[1] = "--level"
    args[2] = "2"
    args[3] = "b"
    let r cli.Result = cli.parse_intermixed(&root, args[0..4])
    if (r.status != cli.ok) {
        cli.release(&r)
        cli.destroy(&root)
        return 103
    }
    let list []cli.Value
    if (cli.get_list(&r.values, "files", &list) != 0 || len(list) != 2) {
        cli.release(&r)
        cli.destroy(&root)
        return 104
    }
    cli.release(&r)
    // 普通模式同输入：b 是新段里的多余位置参数。
    let r2 cli.Result = cli.parse(&root, args[0..4])
    if (r2.status != cli.usage_error) {
        cli.release(&r2)
        cli.destroy(&root)
        return 105
    }
    cli.release(&r2)
    cli.destroy(&root)
    // 混合模式拒绝子命令。
    let root2 cli.Parser
    let config2 cli.ParserConfig = cli.parser_config("tool2")
    if (cli.init(&root2, config2) != 0) {
        return 106
    }
    let slot int = cli.add_subparsers(&root2, cli.subparsers())
    if (slot < 0) {
        cli.destroy(&root2)
        return 107
    }
    let cmd cli.Command = cli.command("go")
    if (cli.add_parser(&root2, slot, cmd) == 0) {
        cli.destroy(&root2)
        return 108
    }
    let empty [1]*char
    let r3 cli.Result = cli.parse_intermixed(&root2, empty[0..0])
    if (r3.status != cli.config_error) {
        cli.release(&r3)
        cli.destroy(&root2)
        return 109
    }
    cli.release(&r3)
    cli.destroy(&root2)
    return 0
}

// —— 主题 9：initial 快照 ——
fn case_initial() int {
    let root cli.Parser
    let config cli.ParserConfig = cli.parser_config("tool")
    if (cli.init(&root, config) != 0) {
        return 111
    }
    let source cli.Argument = cli.positional("source")
    source.arity = cli.optional()
    if (cli.add_argument(&root, source) < 0) {
        cli.destroy(&root)
        return 112
    }
    let preset cli.Namespace
    if (cli.namespace_init(&preset) != 0) {
        cli.destroy(&root)
        return 113
    }
    if (cli.namespace_set(&preset, "source", cli.value_text("pre")) != 0) {
        cli.namespace_destroy(&preset)
        cli.destroy(&root)
        return 114
    }
    let parse_spec cli.ParseConfig = cli.parse_config()
    parse_spec.initial = &preset
    let empty [1]*char
    let r cli.Result = cli.parse_with(&root, empty[0..0], parse_spec)
    if (r.status != cli.ok || text_is(&r.values, "source", "pre") != 0) {
        cli.release(&r)
        cli.namespace_destroy(&preset)
        cli.destroy(&root)
        return 115
    }
    cli.release(&r)
    // 显式 action 覆盖 initial。
    let args [2]*char
    args[0] = "cmd"
    let r2 cli.Result = cli.parse_with(&root, args[0..1], parse_spec)
    if (r2.status != cli.ok || text_is(&r2.values, "source", "cmd") != 0) {
        cli.release(&r2)
        cli.namespace_destroy(&preset)
        cli.destroy(&root)
        return 116
    }
    cli.release(&r2)
    // 初始命名空间未被解析修改。
    if (text_is(&preset, "source", "pre") != 0) {
        cli.namespace_destroy(&preset)
        cli.destroy(&root)
        return 117
    }
    cli.namespace_destroy(&preset)
    cli.destroy(&root)
    return 0
}

// run_all 依次运行全部主题；返回第一个失败码或 0。
fn run_all() int {
    let rc int = case_subcommands()
    if (rc != 0) {
        return rc
    }
    rc = case_parent_child_defaults()
    if (rc != 0) {
        return rc
    }
    rc = case_required_command()
    if (rc != 0) {
        return rc
    }
    rc = case_inherit()
    if (rc != 0) {
        return rc
    }
    rc = case_groups()
    if (rc != 0) {
        return rc
    }
    rc = case_mutex()
    if (rc != 0) {
        return rc
    }
    rc = case_known()
    if (rc != 0) {
        return rc
    }
    rc = case_intermixed()
    if (rc != 0) {
        return rc
    }
    return case_initial()
}

// main 在 --selftest 下运行 CLI3 语义断言，否则打印提示并返回 0。
fn main(argc int, argv **char) int {
    if (argc > 1 && string.equals(argv[1], "--selftest") == 1) {
        let rc int = run_all()
        if (rc != 0) {
            printf("cli3 selftest fail: %d\n", rc)
        }
        return rc
    }
    io.println("clicommands: 使用 --selftest 运行验收断言")
    return 0
}
