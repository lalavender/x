module net

import os

// net 模块的公开模型：地址、状态与 TCP 句柄。
//
// 设计见 docs/03-design/yh-http标准库设计-2026-10-24.md §5。
// 本文件只放类型与零成本构造，不含解析、套接字调用或错误映射。
//
// 约定：
//   * Endpoint.port 是**主机序**；网络序转换只发生在平台实现文件里。
//   * Endpoint.address 固定 16 字节，IPv4 只用前 4 字节，其余保持 0。
//   * TcpStream/TcpListener 是薄句柄，closed 只表示本端已关闭，不反映对端。

// Family 是地址族；首期只支持 IPv4 与 IPv6。
pub enum Family {
    family_inet4
    family_inet6
}

// Status 是 net 自己发现的失败分类；底层 I/O 失败用 os.Error 表达。
pub enum Status {
    status_ok
    status_invalid_argument
    status_invalid_address
    status_unsupported
    status_overflow
}

// Endpoint 是「地址 + 端口」；port 为主机序，范围 0..65535。
pub struct Endpoint {
    family Family
    address [16]u8
    port u16
}

// EndpointResult 是解析/构造结果；失败时 value 为零值的 IPv4 端点。
pub struct EndpointResult {
    status Status
    value Endpoint
}

// TextResult 是文本写入结果：count 为已写字节数，不含结尾 NUL。
pub struct TextResult {
    status Status
    count u64
}

// TcpStream 是已连接套接字；fd 为 -1 表示无效句柄。
pub struct TcpStream {
    fd int
    closed bool
}

// TcpListener 是监听套接字。
pub struct TcpListener {
    fd int
    closed bool
}

// StreamResult 是 dial 的结果：status 表示本层参数/地址问题，
// error 表示内核错误；成功时 status 为 status_ok 且 error 为 error_none。
pub struct StreamResult {
    status Status
    stream TcpStream
    error os.Error
}

// ListenerResult 是 listen 的结果。
pub struct ListenerResult {
    status Status
    listener TcpListener
    error os.Error
}

// AcceptResult 是 accept 的结果；成功时 peer 为对端地址。
pub struct AcceptResult {
    status Status
    stream TcpStream
    peer Endpoint
    error os.Error
}

// SockAddr 是平台相关的套接字地址缓冲：IPv6 最长 28 字节。
// 布局由 20_tcp.<platform>.yh 填写，不进入公开签名。
struct SockAddr {
    bytes [28]u8
}

// Ipv6Parts 是 IPv6 解析的中间态：groups 存放显式组，
// compressed 为 "::" 的位置（-1 表示没有压缩），count 为显式组数。
struct Ipv6Parts {
    groups [8]u16
    count int
    compressed int
}

// endpoint_ipv4 用四个字节与主机序端口构造 IPv4 端点。
pub fn endpoint_ipv4(a u8, b u8, c u8, d u8, port u16) Endpoint {
    let value Endpoint
    value.family = family_inet4
    value.port = port
    value.address[0] = a
    value.address[1] = b
    value.address[2] = c
    value.address[3] = d
    return value
}

// endpoint_zero 返回零值端点，供结果结构初始化使用。
fn endpoint_zero() Endpoint {
    let value Endpoint
    value.family = family_inet4
    value.port = 0
    return value
}

// endpoint_failure 构造失败结果；失败值统一为零值端点。
fn endpoint_failure(status Status) EndpointResult {
    let result EndpointResult
    result.status = status
    result.value = endpoint_zero()
    return result
}

// endpoint_success 构造成功结果。
fn endpoint_success(value Endpoint) EndpointResult {
    let result EndpointResult
    result.status = status_ok
    result.value = value
    return result
}

// stream_zero 返回无效流句柄（fd = -1）。
fn stream_zero() TcpStream {
    let value TcpStream
    value.fd = -1
    value.closed = true
    return value
}

// listener_zero 返回无效监听句柄（fd = -1）。
fn listener_zero() TcpListener {
    let value TcpListener
    value.fd = -1
    value.closed = true
    return value
}
