module net

import os
import sys

// Windows 的 TCP 实现：Winsock 未接线（W2-7 的 sys socket 桩一律返回 -ENOSYS）。
//
// 这个文件存在的意义与 libs/sys/socket.windows.yh 相同：
//   1. 让 net 的公开面在 Windows 目标上**编译与链接通过**（跨平台代码不必分支）；
//   2. 让任何真的调用得到明确的 status_unsupported / error_unsupported，
//      而不是未定义符号或“假成功”。
// 接入 Winsock 时（NET 系列任务）替换本文件的实现：WSAStartup、SOCKET 进 fd 表、
// SO_* 常量换成 Winsock 取值，dial/listen 的非阻塞语义用 ioctlsocket。
//
// 另外：net 的模块私有小工具（stream_zero/listener_zero/error_none_value…）只在
// 各平台 tcp.*.yh 里被引用；没有本文件时它们在 Windows 目标上“未使用”，
// 会被 UF1 的未使用函数检查拒绝。

// unsupported_error 返回统一的「不支持」错误（native_code 为 0：不是内核错误号）。
fn unsupported_error() os.Error {
    return os.make_error(os.error_unsupported, 0)
}

// accept_failure 构造失败接受结果。
fn accept_failure(status Status) AcceptResult {
    let result AcceptResult
    result.status = status
    result.stream = stream_zero()
    result.peer = endpoint_zero()
    result.error = unsupported_error()
    return result
}

// family_domain 把 Family 映射为 AF_* 值（与其它平台实现同形）。
fn family_domain(family Family) int {
    if (family == family_inet6) {
        return sys.AF_INET6
    }
    return sys.AF_INET
}

// dial 在 Windows 上不支持：先真的调用一次套接字原语，把 sys 的 -ENOSYS
// 按同一套错误映射转成 error_unsupported（native_code = ENOSYS），
// 而不是伪造一个 native_code = 0 的错误。
pub fn dial(endpoint Endpoint, timeout_ms int) StreamResult {
    let fd i64 = sys.socket_fd(family_domain(endpoint.family),
        sys.SOCK_STREAM, sys.IPPROTO_TCP)
    let result StreamResult
    result.status = status_unsupported
    result.stream = stream_zero()
    result.error = error_from_result(fd)
    return result
}

// listen 在 Windows 上不支持（同样先调用一次原语再映射错误）。
pub fn listen(endpoint Endpoint, backlog int) ListenerResult {
    let fd i64 = sys.socket_fd(family_domain(endpoint.family),
        sys.SOCK_STREAM, sys.IPPROTO_TCP)
    let result ListenerResult
    result.status = status_unsupported
    result.listener = listener_zero()
    result.error = error_from_result(fd)
    return result
}

// listener_local 在 Windows 上不支持（没有监听句柄可取本地地址）。
pub fn listener_local(listener *TcpListener) EndpointResult {
    return endpoint_failure(status_unsupported)
}

// accept 在 Windows 上不支持。
pub fn accept(listener *TcpListener, timeout_ms int) AcceptResult {
    return accept_failure(status_unsupported)
}

// read_some 在 Windows 上不支持；返回 io_error 而不是假成功。
pub fn read_some(stream *TcpStream, buffer []u8) os.IoResult {
    return os.io_error(os.error_unsupported, 0)
}

// write_some 在 Windows 上不支持。
pub fn write_some(stream *TcpStream, data []u8) os.IoResult {
    return os.io_error(os.error_unsupported, 0)
}

// write_all 在 Windows 上不支持。
pub fn write_all(stream *TcpStream, data []u8) os.IoResult {
    return os.io_error(os.error_unsupported, 0)
}

// shutdown_write 在 Windows 上不支持。
pub fn shutdown_write(stream *TcpStream) os.Error {
    return unsupported_error()
}

// close_listener 在 Windows 上不支持（没有可关闭的监听句柄）。
pub fn close_listener(listener *TcpListener) os.Error {
    return unsupported_error()
}

// close_stream 在 Windows 上不支持。
pub fn close_stream(stream *TcpStream) os.Error {
    return unsupported_error()
}
