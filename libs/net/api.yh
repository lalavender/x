module net

import os
import string
// ============================================================================
// api.yh —— net 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// Family 是地址族；首期只支持 IPv4 与 IPv6。
pub enum Family {
    family_inet4
    family_inet6
}

// Status 是 net 自己发现的失败分类；底层 I/O 失败用 os.Error 表达。
pub enum Status {
    status_ok
    status_invalid_argument
    status_invalid_address
    status_unsupported
    status_overflow
}

// Endpoint 是「地址 + 端口」；port 为主机序，范围 0..65535。
pub struct Endpoint {
    family Family
    address [16]u8
    port u16
}

// EndpointResult 是解析/构造结果；失败时 value 为零值的 IPv4 端点。
pub struct EndpointResult {
    status Status
    value Endpoint
}

// TextResult 是文本写入结果：count 为已写字节数，不含结尾 NUL。
pub struct TextResult {
    status Status
    count u64
}

// TcpStream 是已连接套接字；fd 为 -1 表示无效句柄。
pub struct TcpStream {
    fd int
    closed bool
}

// TcpListener 是监听套接字。
pub struct TcpListener {
    fd int
    closed bool
}

// StreamResult 是 dial 的结果：status 表示本层参数/地址问题，
// error 表示内核错误；成功时 status 为 status_ok 且 error 为 error_none。
pub struct StreamResult {
    status Status
    stream TcpStream
    error os.Error
}

// ListenerResult 是 listen 的结果。
pub struct ListenerResult {
    status Status
    listener TcpListener
    error os.Error
}

// AcceptResult 是 accept 的结果；成功时 peer 为对端地址。
pub struct AcceptResult {
    status Status
    stream TcpStream
    peer Endpoint
    error os.Error
}

// endpoint_ipv4 用四个字节与主机序端口构造 IPv4 端点。
pub fn endpoint_ipv4(a u8, b u8, c u8, d u8, port u16) Endpoint {
    let value Endpoint
    value.family = family_inet4
    value.port = port
    value.address[0] = a
    value.address[1] = b
    value.address[2] = c
    value.address[3] = d
    return value
}

// parse_endpoint 解析 "a.b.c.d[:port]" 或 "[v6][:port]"。
// 未写端口时使用 default_port；端口为 0 表示交给内核分配。
pub fn parse_endpoint(text string.View, default_port u16) EndpointResult {
    if (text.count == 0) {
        return endpoint_failure(status_invalid_argument)
    }
    if (byte_at(text, 0) == 91) {
        // '['：方括号 IPv6，方括号后可选 ":port"
        let close u64 = 1
        let found bool = false
        for close < text.count {
            if (byte_at(text, close) == 93) {
                found = true
                break
            }
            close += 1
        }
        if (!found || close == 1) {
            return endpoint_failure(status_invalid_address)
        }
        let port u16 = default_port
        if (close + 1 < text.count) {
            if (byte_at(text, close + 1) != 58) {
                return endpoint_failure(status_invalid_address)
            }
            let parsed int = parse_port(sub_view(text, close + 2, text.count))
            if (parsed < 0) {
                return endpoint_failure(status_invalid_address)
            }
            port = parsed.to_type(u16)
        }
        return parse_ipv6(sub_view(text, 1, close), port)
    }
    // 非方括号形式：至多一个冒号，且冒号后必须是数字端口。
    let colon u64 = text.count
    let index u64 = 0
    for index < text.count {
        if (byte_at(text, index) == 58) {
            if (colon != text.count) {
                return endpoint_failure(status_invalid_address)
            }
            colon = index
        }
        index += 1
    }
    if (colon == text.count) {
        return parse_ipv4(text, default_port)
    }
    let parsed int = parse_port(sub_view(text, colon + 1, text.count))
    if (parsed < 0) {
        return endpoint_failure(status_invalid_address)
    }
    return parse_ipv4(sub_view(text, 0, colon), parsed.to_type(u16))
}

// format_endpoint 把端点写成 "a.b.c.d:port" 或 "[v6]:port"。
// 空间不足返回 status_overflow，且不写半截内容以外的字节位置不做保证。
pub fn format_endpoint(endpoint Endpoint, out []u8) TextResult {
    let result TextResult
    result.status = status_ok
    result.count = 0
    let cursor u64 = 0
    if (endpoint.family == family_inet4) {
        let index int = 0
        for index < 4 {
            if (index > 0) {
                if (!put_byte(out, &cursor, 46)) {
                    result.status = status_overflow
                    return result
                }
            }
            if (!put_decimal(out, &cursor, endpoint.address[index].to_type(u32))) {
                result.status = status_overflow
                return result
            }
            index += 1
        }
    } else {
        if (!put_byte(out, &cursor, 91)) {
            result.status = status_overflow
            return result
        }
        let run_start int = 0
        let run_length int = 0
        longest_zero_run(endpoint.address, &run_start, &run_length)
        let group int = 0
        for group < 8 {
            if (run_length > 0 && group == run_start) {
                if (!put_byte(out, &cursor, 58)) {
                    result.status = status_overflow
                    return result
                }
                if (!put_byte(out, &cursor, 58)) {
                    result.status = status_overflow
                    return result
                }
                group += run_length
            } else {
                if (group > 0 && !(run_length > 0 && group == run_start + run_length)) {
                    if (!put_byte(out, &cursor, 58)) {
                        result.status = status_overflow
                        return result
                    }
                }
                if (!put_hex_group(out, &cursor, group_at(endpoint.address, group))) {
                    result.status = status_overflow
                    return result
                }
                group += 1
            }
        }
        if (!put_byte(out, &cursor, 93)) {
            result.status = status_overflow
            return result
        }
    }
    if (!put_byte(out, &cursor, 58)) {
        result.status = status_overflow
        return result
    }
    if (!put_decimal(out, &cursor, endpoint.port.to_type(u32))) {
        result.status = status_overflow
        return result
    }
    result.count = cursor
    return result
}

// dial：平台无关入口；实现见 tcp.<平台>.yh 的 dial_impl。
pub fn dial(endpoint Endpoint, timeout_ms int) StreamResult {
    return dial_impl(endpoint, timeout_ms)
}

// listen：平台无关入口；实现见 tcp.<平台>.yh 的 listen_impl。
pub fn listen(endpoint Endpoint, backlog int) ListenerResult {
    return listen_impl(endpoint, backlog)
}

// listener_local：平台无关入口；实现见 tcp.<平台>.yh 的 listener_local_impl。
pub fn listener_local(listener *TcpListener) EndpointResult {
    return listener_local_impl(listener)
}

// accept：平台无关入口；实现见 tcp.<平台>.yh 的 accept_impl。
pub fn accept(listener *TcpListener, timeout_ms int) AcceptResult {
    return accept_impl(listener, timeout_ms)
}

// read_some：平台无关入口；实现见 tcp.<平台>.yh 的 read_some_impl。
pub fn read_some(stream *TcpStream, buffer []u8) os.IoResult {
    return read_some_impl(stream, buffer)
}

// write_some：平台无关入口；实现见 tcp.<平台>.yh 的 write_some_impl。
pub fn write_some(stream *TcpStream, data []u8) os.IoResult {
    return write_some_impl(stream, data)
}

// write_all：平台无关入口；实现见 tcp.<平台>.yh 的 write_all_impl。
pub fn write_all(stream *TcpStream, data []u8) os.IoResult {
    return write_all_impl(stream, data)
}

// shutdown_write：平台无关入口；实现见 tcp.<平台>.yh 的 shutdown_write_impl。
pub fn shutdown_write(stream *TcpStream) os.Error {
    return shutdown_write_impl(stream)
}

// close_listener：平台无关入口；实现见 tcp.<平台>.yh 的 close_listener_impl。
pub fn close_listener(listener *TcpListener) os.Error {
    return close_listener_impl(listener)
}

// close_stream：平台无关入口；实现见 tcp.<平台>.yh 的 close_stream_impl。
pub fn close_stream(stream *TcpStream) os.Error {
    return close_stream_impl(stream)
}
