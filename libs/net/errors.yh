module net

import os
import sys

// net 的错误映射：位置在 base.yh 之后、平台实现之前，
// 保证 tcp.* 能直接调用模块私有辅助函数。

// error_none_value 返回无错误值。
fn error_none_value() os.Error {
    return os.make_error(os.error_none, 0)
}

// error_from_errno 把内核错误号转成 os.Error，并把「套接字读/写超时」
// 从 EAGAIN 改写为 error_timed_out。
// 普通非阻塞 I/O 的 EAGAIN 在 os 层仍是 error_other；这里只在套接字
// 设置了 SO_RCVTIMEO/SO_SNDTIMEO 的语境下解释，因此由 net 改写分类。
fn error_from_errno(code int) os.Error {
    if (code == sys.EAGAIN) {
        return os.make_error(os.error_timed_out, code)
    }
    return os.error_from_errno(code)
}

// error_from_result 把 sys 原语的返回值（成功值或 -errno）转成 os.Error。
fn error_from_result(result i64) os.Error {
    if (sys.is_error(result) == 0) {
        return error_none_value()
    }
    return error_from_errno(sys.error_code(result))
}
