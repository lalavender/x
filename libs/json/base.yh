module json

// yh JSON 标准库：公共数据模型、诊断与实现常量。
//
// 本文件只放公开类型、枚举、预算常量与私有状态常量；不实现解析或写出。
// 设计见 docs/03-design/yh-JSON标准库设计.md，分期见
// docs/02-plan/yh-JSON标准库实施方案-2026-10-24.md，取舍见 ADR-0018。
//
// 实现约束：
//   * 文本一律是「字节指针 + 长度」，不要求 NUL 结尾：JSON 字符串和键可以
//     包含解码后的 NUL（"\u0000"），strlen 会截断。
//   * Document 独占一次成功解析的私有内存池；Value 是池内节点的只读视图，
//     不单独分配、不单独释放。释放文档后所有视图失效。
//   * 数字只校验 grammar 并保存原始词素，是整数还是浮点由 as_i64/as_f64/
//     is_integer 在取值时显式询问。
//   * 私有类型只在本模块使用，不出现在 pub 签名里（ADR-0013）。

// —— 资源预算（实现限制，README 必须披露）——
// 输入字节上限；超过返回 parse_resource_error。
const JSON_MAX_INPUT u64 = 16777216
// 容器嵌套深度上限。JSON 常由机器生成，比 TOML 配置更深，取 256。
const JSON_MAX_DEPTH int = 256
// 单文档累计分配上限（池内所有块加上存储头部）。
const JSON_MAX_BYTES u64 = 134217728
// as_f64 允许的有效位数上限；超过报范围错误而不是静默近似。
const JSON_MAX_SIG_DIGITS int = 4096
// 缩进空格上限，超过报参数错误。
const JSON_MAX_INDENT int = 16
// 对象条目超过该值时建哈希索引（J8 后置，当前未启用）。
const JSON_HASH_THRESHOLD int = 32
// 测试构建的分配失败注入点：-1 关闭；>=0 时允许该次数的池分配，下一次失败。
// 产品构建保持 -1；将来 J4 的注入门（tests/json/injection.py，待建）在临时
// 标准库副本中改写本行。
const JSON_TEST_FAIL_AFTER int = -1

