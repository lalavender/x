module json

import num

// yh JSON 标准库：数字词素的 grammar 校验与类型化取值。
//
// JSON 只有一个 number 类型，规范不区分整数与浮点；本库只校验 grammar 并
// 保存原始词素，由 as_i64/as_f64/is_integer 在取值时显式询问。
// 精确的十进制 → binary64 转换在 libs/num，json 不重复实现。

// json_number_scan 从 start 扫描一个 JSON 数字词素，返回结束偏移（独占）。
// 语法非法返回 0。调用方负责检查后继字节是否为合法定界符。
fn json_number_scan(data *u8, count u64, start u64) u64 {
    let i u64 = start
    if (i < count && data[i] == '-') {
        i += 1
    }
    if (i >= count) {
        return 0
    }
    if (data[i] == '0') {
        i += 1
    } else if (data[i] >= '1' && data[i] <= '9') {
        i += 1
        for i < count && data[i] >= '0' && data[i] <= '9' {
            i += 1
        }
    } else {
        return 0
    }
    if (i < count && data[i] == '.') {
        i += 1
        if (i >= count || data[i] < '0' || data[i] > '9') {
            return 0
        }
        for i < count && data[i] >= '0' && data[i] <= '9' {
            i += 1
        }
    }
    if (i < count && (data[i] == 'e' || data[i] == 'E')) {
        i += 1
        if (i < count && (data[i] == '+' || data[i] == '-')) {
            i += 1
        }
        if (i >= count || data[i] < '0' || data[i] > '9') {
            return 0
        }
        for i < count && data[i] >= '0' && data[i] <= '9' {
            i += 1
        }
    }
    return i
}

// json_number_is_integer 判断词素是否为整数形式（无小数点、无指数）。
fn json_number_is_integer(text Text) int {
    let i u64 = 0
    for i < text.count {
        let b u8 = text.data[i]
        if (b == '.' || b == 'e' || b == 'E') {
            return 0
        }
        i += 1
    }
    return 1
}

// json_number_i64 把整数形式的词素转成 i64。
// 返回 0 成功、1 超出 i64 范围、2 不是整数形式。
fn json_number_i64(text Text, out *i64) int {
    if (json_number_is_integer(text) == 0) {
        return 2
    }
    let i u64 = 0
    let negative int = 0
    if (i < text.count && text.data[i] == '-') {
        negative = 1
        i += 1
    }
    if (i >= text.count) {
        return 2
    }
    // 负数允许到 9223372036854775808，正数到 9223372036854775807。
    let limit u64 = 9223372036854775807
    if (negative != 0) {
        limit = 9223372036854775808
    }
    let magnitude u64 = 0
    for i < text.count {
        let b u8 = text.data[i]
        if (b < '0' || b > '9') {
            return 2
        }
        let digit u64 = (b - '0').to_type(u64)
        if (magnitude > (limit - digit) / 10) {
            return 1
        }
        magnitude = magnitude * 10 + digit
        i += 1
    }
    if (negative != 0) {
        if (magnitude == 9223372036854775808) {
            out[0] = -9223372036854775807 - 1
        } else {
            out[0] = (0 - magnitude.to_type(i64))
        }
        return 0
    }
    out[0] = magnitude.to_type(i64)
    return 0
}

// json_number_f64 把词素精确转换为 binary64。
// 返回 0 成功、1 上溢或有效位超限、2 语法错误。
fn json_number_f64(text Text, out *f64) int {
    if (text.count > JSON_MAX_SIG_DIGITS.to_type(u64) + 400) {
        // 位数远超预算时直接报范围错误，避免构造巨长大整数。
        return 1
    }
    let status num.NumStatus = num.parse_f64(text.data, text.count, out)
    if (status == num.num_ok) {
        return 0
    }
    if (status == num.num_syntax) {
        return 2
    }
    return 1
}
