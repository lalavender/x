module json

// yh JSON 标准库：解析入口、文档生命周期与诊断构造。
//
// parse/parse_text/read_file 是三个读取入口；成功结果的 Document 由调用者
// 最终 release。失败时没有可查询的半成品文档。解析只借用输入，成功后输入
// 可以立即释放或改写。

// diagnostic_none 返回无错误的诊断。
fn diagnostic_none() Diagnostic {
    let d Diagnostic
    d.code = ErrorCode.error_none
    d.message = ""
    d.span = span_zero()
    d.related = span_zero()
    d.has_related = 0
    d.native_code = 0
    return d
}

// diagnostic_make 构造一条显式诊断。
fn diagnostic_make(code ErrorCode, message *char, span Span,
    native_code int) Diagnostic {
    let d Diagnostic
    d.code = code
    d.message = message
    d.span = span
    d.related = span_zero()
    d.has_related = 0
    d.native_code = native_code
    return d
}

// parse_ok_result 构造成功解析结果。
fn parse_ok_result(state *doc_state) ParseResult {
    let result ParseResult
    result.status = ParseStatus.parse_ok
    let diag Diagnostic = diagnostic_none()
    result.document.handle = state.to_type(*void)
    result.error = diag
    return result
}

// parse_failure 构造失败解析结果；document 为空句柄。
fn parse_failure(status ParseStatus, code ErrorCode, message *char,
    span Span, native_code int) ParseResult {
    let result ParseResult
    result.status = status
    let diag Diagnostic = diagnostic_make(code, message, span, native_code)
    result.document.handle = 0
    result.error = diag
    return result
}

// doc_new 创建空文档状态；失败返回空指针。
fn doc_new() *doc_state {
    let state *doc_state = malloc(sizeof(doc_state).to_type(u64)).to_type(*doc_state)
    if (state == 0) {
        return 0
    }
    pool_init(&state.mem)
    state.root = 0
    return state
}

// doc_free 释放文档全部存储。
fn doc_free(state *doc_state) void {
    if (state == 0) {
        return
    }
    pool_free_all(&state.mem)
    free(state.to_type(*void))
}

// parse 解析显式长度的字节。空输入是语法错误（JSON 文档必须是一个值）。
pub fn parse(data *u8, count u64) ParseResult {
    if (count > 0 && data == 0) {
        return parse_failure(ParseStatus.parse_argument_error,
            ErrorCode.error_argument, "输入指针为空", span_zero(), 0)
    }
    if (count > JSON_MAX_INPUT) {
        return parse_failure(ParseStatus.parse_resource_error,
            ErrorCode.error_resource_limit, "输入超过 JSON_MAX_INPUT",
            span_zero(), 0)
    }
    if (count == 0) {
        return parse_failure(ParseStatus.parse_syntax_error,
            ErrorCode.error_syntax, "输入为空", span_zero(), 0)
    }
    if (count >= 3 && data[0] == 239 && data[1] == 187 && data[2] == 191) {
        let span Span
        span.offset = 0
        span.length = 3
        span.line = 1
        span.column = 1
        return parse_failure(ParseStatus.parse_syntax_error,
            ErrorCode.error_bom, "输入以 UTF-8 BOM 开头", span, 0)
    }
    let bad_off u64 = 0
    let bad_len u64 = 0
    if (utf8_validate(data, count, &bad_off, &bad_len) != 0) {
        let line u64 = 0
        let column u64 = 0
        p_offset_position(data, count, bad_off, &line, &column)
        let span Span
        span.offset = bad_off
        span.length = bad_len
        span.line = line
        span.column = column
        return parse_failure(ParseStatus.parse_syntax_error,
            ErrorCode.error_utf8, "输入不是合法 UTF-8", span, 0)
    }
    let state *doc_state = doc_new()
    if (state == 0) {
        return parse_failure(ParseStatus.parse_resource_error,
            ErrorCode.error_out_of_memory, "创建文档状态失败", span_zero(), 0)
    }
    let p parser
    p.data = data
    p.count = count
    p.pos = 0
    p.line = 1
    p.column = 1
    p.pending_lf = 0
    p.state = state
    p.fail_code = ErrorCode.error_none
    p.fail_message = ""
    p.fail_span = span_zero()
    p.related = span_zero()
    p.has_related = 0
    p.depth = 0
    let ok int = p_parse_document(&p)
    if (ok == 0 || state.mem.status != 0) {
        let status ParseStatus = ParseStatus.parse_syntax_error
        let code ErrorCode = p.fail_code
        let message *char = p.fail_message
        let span Span = p.fail_span
        if (state.mem.status == 2) {
            // 累计分配预算超限统一报 error_resource_limit；下游某个分配点
            // 可能先报 out_of_memory，这里按池状态纠正分类。
            status = ParseStatus.parse_resource_error
            code = ErrorCode.error_resource_limit
            message = "文档存储超过实现预算"
        } else if (state.mem.status == 1) {
            status = ParseStatus.parse_resource_error
            if (code == ErrorCode.error_none) {
                code = ErrorCode.error_out_of_memory
                message = "文档存储内存不足"
            }
        } else if (code == ErrorCode.error_resource_limit
            || code == ErrorCode.error_out_of_memory) {
            status = ParseStatus.parse_resource_error
        }
        if (code == ErrorCode.error_none) {
            code = ErrorCode.error_syntax
            message = "解析失败"
        }
        let result ParseResult
        result.status = status
        result.document.handle = 0
        let diag Diagnostic = diagnostic_make(code, message, span, 0)
        result.error = diag
        result.error.related = p.related
        result.error.has_related = p.has_related
        doc_free(state)
        return result
    }
    return parse_ok_result(state)
}

// parse_text 解析 NUL 结尾文本；空指针是参数错误。
pub fn parse_text(text *char) ParseResult {
    if (text == 0) {
        return parse_failure(ParseStatus.parse_argument_error,
            ErrorCode.error_argument, "文本指针为空", span_zero(), 0)
    }
    return parse(text.to_type(*u8), strlen(text))
}

// root 返回成功文档的根值；空句柄返回空视图。
pub fn root(doc *Document) Value {
    if (doc == 0 || doc.handle == 0) {
        return value_of(0)
    }
    let state *doc_state = doc.handle.to_type(*doc_state)
    return value_of(state.root)
}

// release 释放文档全部存储并清零；同一个已清零句柄可再次释放。
pub fn release(doc *Document) void {
    if (doc == 0 || doc.handle == 0) {
        return
    }
    let state *doc_state = doc.handle.to_type(*doc_state)
    doc_free(state)
    doc.handle = 0
}
