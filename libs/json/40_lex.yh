module json

// yh JSON 标准库：解析器状态、空白、字面量、字符串转义与数字扫描。
//
// 位置按字节游标推进：line/column 在消费字节时增量维护，CRLF 计一行。
// 字符串解码走两遍——先算解码后字节数，一次分配，再写入；这样避免扩容，
// 也让「解码后含 NUL」的键和值能直接落池。

// parser 是一次解析的可变状态；失败字段在首个错误处写入，之后不再覆盖。
struct parser {
    data *u8
    count u64
    pos u64
    line u64
    column u64
    pending_lf int
    state *doc_state
    fail_code ErrorCode
    fail_message *char
    fail_span Span
    related Span
    has_related int
    depth int
}

// p_fail_at 在指定起点写首个诊断；已失败时不覆盖。
fn p_fail_at(p *parser, code ErrorCode, message *char, offset u64, length u64) void {
    if (p.fail_code != ErrorCode.error_none) {
        return
    }
    p.fail_code = code
    p.fail_message = message
    let span Span
    span.offset = offset
    span.length = length
    span.line = p.line
    span.column = p.column
    if (offset > p.pos) {
        // 同一行内的前瞻错误（字符串转义等）：列号按字节差修正。
        span.column = p.column + (offset - p.pos)
    } else if (offset < p.pos) {
        // 回指同一行内已扫描过的位置（重复键）：列号按字节差回退。
        let back u64 = p.pos - offset
        if (back < p.column) {
            span.column = p.column - back
        }
    } else if (offset < p.pos) {
        // 回指同一行内已扫描过的位置（重复键）：列号按字节差回退。
        let back u64 = p.pos - offset
        if (back < p.column) {
            span.column = p.column - back
        }
    }
    p.fail_span = span
}

// p_fail_here 在当前游标处写诊断，长度为 1（EOF 时为 0）。
fn p_fail_here(p *parser, code ErrorCode, message *char) void {
    let length u64 = 1
    if (p.pos >= p.count) {
        length = 0
    }
    p_fail_at(p, code, message, p.pos, length)
}

// p_set_related 记录重复键第一次出现的位置。
fn p_set_related(p *parser, span Span) void {
    p.related = span
    p.has_related = 1
}

// p_advance 消费 count 个字节并维护行/列；CRLF 计一行。
fn p_advance(p *parser, count u64) void {
    let i u64 = 0
    for i < count {
        if (p.pos >= p.count) {
            return
        }
        let b u8 = p.data[p.pos]
        if (b == 13) {
            p.line += 1
            p.column = 1
            p.pending_lf = 1
        } else if (b == 10) {
            if (p.pending_lf == 0) {
                p.line += 1
                p.column = 1
            }
            p.pending_lf = 0
        } else {
            p.column += 1
            p.pending_lf = 0
        }
        p.pos += 1
        i += 1
    }
}

// p_at_end 判断是否已到输入末尾。
fn p_at_end(p *parser) int {
    return (p.pos >= p.count).to_type(int)
}

// p_skip_ws 跳过 JSON 允许的四种空白；其他空白不是空白。
fn p_skip_ws(p *parser) void {
    for p.pos < p.count {
        let b u8 = p.data[p.pos]
        if (b == 32 || b == 9 || b == 10 || b == 13) {
            p_advance(p, 1)
        } else {
            return
        }
    }
}

// esc_width 返回一个标量编码成 UTF-8 后的字节数。
fn esc_width(cp u64) int {
    if (cp < 128) {
        return 1
    }
    if (cp < 2048) {
        return 2
    }
    if (cp < 65536) {
        return 3
    }
    return 4
}

// esc_decode_at 解析 at 处（指向反斜杠）的一个转义序列。
// 成功返回 0 并写入码点与下一个位置；1 表示语法错误，2 表示孤立代理。
fn esc_decode_at(data *u8, count u64, at u64, cp *u32, next *u64) int {
    if (at + 1 >= count) {
        return 1
    }
    let b u8 = data[at + 1]
    let simple int = 1
    let value u32 = 0
    if (b == '"') {
        value = 34
    } else if (b == 92) {
        value = 92
    } else if (b == 47) {
        value = 47
    } else if (b == 98) {
        value = 8
    } else if (b == 102) {
        value = 12
    } else if (b == 110) {
        value = 10
    } else if (b == 114) {
        value = 13
    } else if (b == 116) {
        value = 9
    } else if (b == 117) {
        simple = 0
    } else {
        return 1
    }
    if (simple != 0) {
        cp[0] = value
        next[0] = at + 2
        return 0
    }
    if (at + 5 >= count) {
        return 1
    }
    let high int = 0
    let i u64 = 0
    for i < 4 {
        let digit int = hex_digit_value(data[at + 2 + i])
        if (digit < 0) {
            return 1
        }
        high = high * 16 + digit
        i += 1
    }
    if (high >= 55296 && high <= 56319) {
        // 高代理必须紧跟 \uDC00..\uDFFF。
        if (at + 11 >= count) {
            return 2
        }
        if (data[at + 6] != 92 || data[at + 7] != 117) {
            return 2
        }
        let low int = 0
        i = 0
        for i < 4 {
            let digit int = hex_digit_value(data[at + 8 + i])
            if (digit < 0) {
                return 1
            }
            low = low * 16 + digit
            i += 1
        }
        if (low < 56320 || low > 57343) {
            return 2
        }
        let combined int = 65536 + (high - 55296) * 1024 + (low - 56320)
        cp[0] = combined.to_type(u32)
        next[0] = at + 12
        return 0
    }
    if (high >= 56320 && high <= 57343) {
        return 2
    }
    cp[0] = high.to_type(u32)
    next[0] = at + 6
    return 0
}

// p_scan_string 扫描并解码一个字符串，字节复制进文档池。
// 成功返回 1 并把解码结果写入 out；失败返回 0 并留下诊断。
fn p_scan_string(p *parser, out *Text) int {
    let start u64 = p.pos
    let start_line u64 = p.line
    let start_column u64 = p.column
    // 第一遍：校验并计算解码长度。
    let i u64 = start + 1
    let length u64 = 0
    let closed int = 0
    for i < p.count {
        let b u8 = p.data[i]
        if (b == 34) {
            closed = 1
            break
        }
        if (b == 92) {
            let cp u32 = 0
            let next u64 = 0
            let status int = esc_decode_at(p.data, p.count, i, &cp, &next)
            if (status != 0) {
                if (status == 2) {
                    p_fail_at(p, ErrorCode.error_surrogate, "字符串含孤立代理项", i, 6)
                } else {
                    p_fail_at(p, ErrorCode.error_syntax, "非法的字符串转义", i, 2)
                }
                return 0
            }
            length += esc_width(cp.to_type(u64)).to_type(u64)
            i = next
            continue
        }
        if (b < 32) {
            p_fail_at(p, ErrorCode.error_syntax, "字符串含未转义的控制字符", i, 1)
            return 0
        }
        length += 1
        i += 1
    }
    if (closed == 0) {
        p_fail_at(p, ErrorCode.error_syntax, "字符串缺少结束引号", start, i - start)
        return 0
    }
    let buffer *u8 = 0
    if (length > 0) {
        buffer = pool_alloc(&p.state.mem, length).to_type(*u8)
        if (buffer == 0) {
            p_fail_at(p, ErrorCode.error_out_of_memory, "字符串存储失败", start, i - start)
            return 0
        }
    }
    // 第二遍：写入解码字节。
    let at u64 = 0
    let j u64 = start + 1
    for j < i {
        let b u8 = p.data[j]
        if (b == 92) {
            let cp u32 = 0
            let next u64 = 0
            esc_decode_at(p.data, p.count, j, &cp, &next)
            let width int = utf8_encode(cp.to_type(u64), buffer + at)
            at += width.to_type(u64)
            j = next
            continue
        }
        buffer[at] = b
        at += 1
        j += 1
    }
    let result Text = text_make(buffer, length)
    out[0] = result
    // 定位到结束引号之后。
    let consumed u64 = (i + 1) - p.pos
    p.line = start_line
    p.column = start_column
    p.pending_lf = 0
    p_advance(p, consumed)
    return 1
}

// p_scan_number 扫描一个数字词素并把字节复制进文档池。
// 成功返回 1；失败返回 0 并留下诊断。
fn p_scan_number(p *parser, out *Text) int {
    let start u64 = p.pos
    let end u64 = json_number_scan(p.data, p.count, start)
    if (end == 0) {
        p_fail_here(p, ErrorCode.error_syntax, "非法的数字字面量")
        return 0
    }
    let length u64 = end - start
    let buffer *u8 = pool_dup_bytes(&p.state.mem, p.data + start, length)
    if (buffer == 0) {
        p_fail_here(p, ErrorCode.error_out_of_memory, "数字词素存储失败")
        return 0
    }
    let result Text = text_make(buffer, length)
    out[0] = result
    p_advance(p, length)
    return 1
}

// p_offset_position 由字节偏移计算一基行号与列号；CRLF 计一行。
fn p_offset_position(data *u8, count u64, offset u64, line *u64,
    column *u64) void {
    let i u64 = 0
    let l u64 = 1
    let c u64 = 1
    let pending int = 0
    for i < offset && i < count {
        let b u8 = data[i]
        if (b == 13) {
            l += 1
            c = 1
            pending = 1
        } else if (b == 10) {
            if (pending == 0) {
                l += 1
                c = 1
            }
            pending = 0
        } else {
            c += 1
            pending = 0
        }
        i += 1
    }
    line[0] = l
    column[0] = c
}

// p_match_literal 匹配 true/false/null；which 为 1/2/3，成功返回 which。
fn p_match_literal(p *parser, which int) int {
    let word *char = "true"
    let length u64 = 4
    if (which == 2) {
        word = "false"
        length = 5
    }
    if (which == 3) {
        word = "null"
        length = 4
    }
    if (p.pos + length > p.count) {
        p_fail_here(p, ErrorCode.error_syntax, "字面量不完整")
        return 0
    }
    let i u64 = 0
    for i < length {
        if (p.data[p.pos + i] != word[i].to_type(u8)) {
            p_fail_here(p, ErrorCode.error_syntax, "非法的字面量")
            return 0
        }
        i += 1
    }
    p_advance(p, length)
    return which
}
