module io

import os
// ============================================================================
// api.yh —— io 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// Status 是 io 层的结果分类；status_io_error 时 error 携带 os 的稳定分类。
// status_eof 只表示"一个字节都没读到就结束"，读到末行但无换行仍是 status_ok。
pub enum Status {
    status_ok
    status_eof
    status_truncated
    status_invalid_argument
    status_io_error
}

// ReadResult 是一次读取的结果；count 为写入调用方缓冲的字节数。
// 失败或截断时 count 仍保留已经写入 out 的有效字节数。
pub struct ReadResult {
    status Status
    count u64
    error os.Error
}

// ByteResult 是单字节读取的结果；status_eof 时 value 为 0。
pub struct ByteResult {
    status Status
    value u8
    error os.Error
}

// Reader 是有缓冲的读取器；buffer 借用调用方存储，不复制、不释放。
// begin/end 是本模块解释的游标，调用方只应通过 reader_* 函数操作。
// 结构体赋值是浅拷贝，两个副本共享缓冲与游标，行为未定义。
pub struct Reader {
    fd int
    buffer []u8
    begin u64
    end u64
    eof bool
    error os.Error
}

// Writer 是有缓冲的写入器；buffer 借用调用方存储，count 为待写字节数。
// 结构体赋值是浅拷贝，两个副本共享缓冲与计数，行为未定义。
pub struct Writer {
    fd int
    buffer []u8
    count u64
    error os.Error
}

// IO_BUFFER_SIZE 是建议的缓冲大小；不是强制值，调用方可用任意非空缓冲。
pub const IO_BUFFER_SIZE u64 = 8192

// print 将以 NUL 结尾的字符串写到标准输出，不追加换行。
// 完整写入返回 0，底层写入失败返回 -1。
pub fn print(text *char) int {
    return write_all(1, text, strlen(text).to_type(int))
}

// println 将以 NUL 结尾的字符串和一个换行写到标准输出。
// 字符串或换行任一部分写入失败都返回 -1，成功返回 0。
pub fn println(text *char) int {
    if (print(text) != 0) {
        return -1
    }
    return write_all(1, "\n", 1)
}

// read_all 从 fd 循环读取直到 EOF 或 out 写满。
// 到达 EOF 返回 status_ok；out 恰好填满且未确认 EOF 时返回 status_truncated
// （需要精确判断时给 out 多留 1 字节）；读取失败返回 status_io_error 并保留
// 已读进度。out 为空时不做任何读取，返回 status_truncated 且 count 为 0。
pub fn read_all(fd int, out []u8) ReadResult {
    let total u64 = 0
    let capacity u64 = len(out)
    for total < capacity {
        let chunk []u8 = out[total.to_type(int)..capacity.to_type(int)]
        let result os.IoResult = os.read_some(fd, chunk)
        if (result.error.kind != os.error_none) {
            return read_failed(result.error, total)
        }
        if (result.count == 0) {
            return read_ok(total)
        }
        total += result.count
    }
    return read_truncated(total)
}

// read_file 打开路径、整段读入调用方缓冲并关闭 fd。
// fd 由本函数关闭；读取结果优先于关闭错误（读取成功时才用关闭错误覆盖）。
pub fn read_file(path *char, out []u8) ReadResult {
    let opened os.FdResult = os.open_path(path, os.read_options())
    if (opened.error.kind != os.error_none) {
        return read_failed(opened.error, 0)
    }
    if (opened.fd < 0) {
        return read_failed(os.make_error(os.error_other, 0), 0)
    }
    let result ReadResult = read_all(opened.fd, out)
    let closed os.Error = os.close_file(opened.fd)
    if (result.status == status_ok && closed.kind != os.error_none) {
        return read_failed(closed, result.count)
    }
    return result
}

// reader_init 把读取器绑定到 fd 与调用方缓冲，游标归零。
// 空缓冲返回 error_invalid_argument，此后所有读取直接失败；成功返回
// no_error。本函数不校验 fd 是否可读，失败在首次读取时暴露。
pub fn reader_init(reader *Reader, fd int, buffer []u8) os.Error {
    reader.fd = fd
    reader.buffer = buffer
    reader.begin = 0
    reader.end = 0
    reader.eof = false
    if (len(buffer) == 0) {
        reader.eof = true
        reader.error = os.make_error(os.error_invalid_argument, 0)
        return reader.error
    }
    reader.error = os.no_error()
    return reader.error
}

// reader_buffered 返回已预读未消费的字节数，只用于诊断，不做流控。
pub fn reader_buffered(reader *Reader) u64 {
    return reader.end - reader.begin
}

// reader_read 读取至少 1 字节（除非 EOF 或失败），不超过缓冲容量。
// 返回 status_ok 与本次字节数；EOF 返回 status_eof；错误粘滞后一直返回同一
// 错误。out 为空时不消费字节，返回 status_ok 且 count 为 0。
pub fn reader_read(reader *Reader, out []u8) ReadResult {
    if (len(out) == 0) {
        return read_ok(0)
    }
    if (reader.error.kind != os.error_none) {
        return read_failed(reader.error, 0)
    }
    if (reader.begin >= reader.end) {
        let filled ReadResult = reader_fill(reader)
        if (filled.status != status_ok) {
            return filled
        }
    }
    return read_ok(reader_take(reader, out))
}

// reader_read_byte 读取一个字节；EOF 返回 status_eof 且 value 为 0。
pub fn reader_read_byte(reader *Reader) ByteResult {
    if (reader.error.kind != os.error_none) {
        return byte_failed(reader.error)
    }
    if (reader.begin >= reader.end) {
        let filled ReadResult = reader_fill(reader)
        if (filled.status == status_eof) {
            return byte_eof()
        }
        if (filled.status != status_ok) {
            return byte_failed(filled.error)
        }
    }
    let value u8 = reader.buffer[reader.begin.to_type(int)]
    reader.begin += 1
    return byte_ok(value)
}

// reader_read_line 读取一行到 out，换行符包含在结果里。
// 只认 '\n'（0x0A）；'\r' 作为普通字节保留，不做 CRLF 转换。
//   * 取到 '\n' 或读到末行（无换行）返回 status_ok，count 为字节数；
//   * 尚未读到字节就 EOF 返回 status_eof；
//   * 行长度超过 out 时填满 out、丢弃该行剩余字节（含 '\n'），
//     返回 status_truncated，count 为 len(out)。
// out 为空时仍会消费一整行，返回 status_truncated 且 count 为 0。
pub fn reader_read_line(reader *Reader, out []u8) ReadResult {
    let capacity u64 = len(out)
    let total u64 = 0
    for 1 {
        if (reader.begin >= reader.end) {
            let filled ReadResult = reader_fill(reader)
            if (filled.status == status_eof) {
                if (total == 0) {
                    return read_eof()
                }
                return read_ok(total)
            }
            if (filled.status != status_ok) {
                return read_failed(filled.error, total)
            }
        }
        let index u64 = reader.begin
        let found bool = false
        for index < reader.end {
            if (reader.buffer[index.to_type(int)].to_type(int) == 10) {
                found = true
                break
            }
            index += 1
        }
        if (found) {
            let need u64 = index - reader.begin + 1
            if (total + need > capacity) {
                total += reader_take_into(reader, out, total, capacity - total)
                reader_discard_line(reader)
                return read_truncated(total)
            }
            total += reader_take_into(reader, out, total, need)
            return read_ok(total)
        }
        let available u64 = reader.end - reader.begin
        if (total + available > capacity) {
            total += reader_take_into(reader, out, total, capacity - total)
            reader_discard_line(reader)
            return read_truncated(total)
        }
        total += reader_take_into(reader, out, total, available)
    }
    return read_eof()
}

// write_all_result 将指定缓冲区的全部字节写入文件描述符。
// count 为已写字节数（失败时保留已取得进度），error 为显式错误；
// 成功写完时 count == byte_count 且 error.kind == error_none。
// 中途遇到 EINTR/短写/EAGAIN 时立即返回当前进度，不在本层吞掉错误。
pub fn write_all_result(fd int, data *char,
    byte_count int) os.IoResult {
    if (byte_count < 0) {
        return os.io_error(os.error_invalid_argument, 0)
    }
    let offset int = 0
    for offset < byte_count {
        let remaining u64 = (byte_count - offset).to_type(u64)
        let result os.IoResult = os.write_once(fd,
            (data + offset).to_type(*void), remaining)
        if (result.error.kind != os.error_none) {
            return os.IoResult{
                count: offset.to_type(u64),
                error: result.error
            }
        }
        if (result.count == 0) {
            // 非零请求却写入零字节：不能原地空转，保留进度并报错。
            return os.IoResult{
                count: offset.to_type(u64),
                error: os.make_error(os.error_other, 0)
            }
        }
        offset += result.count.to_type(int)
    }
    return os.io_ok(offset.to_type(u64))
}

// write_all 将指定缓冲区的全部字节写入文件描述符。
// 旧契约保持不变：长度为负、任何写入失败或意外零进度都返回 -1；
// 全部写完返回 0。EINTR 不自动重试，但 write_all_result 可观察已写进度。
pub fn write_all(fd int, data *char, byte_count int) int {
    let result os.IoResult = write_all_result(fd, data, byte_count)
    if (result.error.kind != os.error_none
        || result.count != byte_count.to_type(u64)) {
        return -1
    }
    return 0
}

// write_bytes 向 fd 循环写入切片的全部字节，支持内嵌 NUL。
// 返回已写进度与显式错误；零进度视为异常并返回 error_other，避免空转。
pub fn write_bytes(fd int, data []u8) os.IoResult {
    let total u64 = 0
    let capacity u64 = len(data)
    for total < capacity {
        let chunk []u8 = data[total.to_type(int)..capacity.to_type(int)]
        let result os.IoResult = os.write_some(fd, chunk)
        if (result.error.kind != os.error_none) {
            return os.IoResult{ count: total, error: result.error }
        }
        if (result.count == 0) {
            return os.IoResult{
                count: total,
                error: os.make_error(os.error_other, 0)
            }
        }
        total += result.count
    }
    return os.io_ok(total)
}

// write_file 截断创建/覆盖路径并写入切片的全部字节，然后关闭 fd。
// fd 由本函数关闭；写入错误优先，写入成功时才用关闭错误覆盖。
pub fn write_file(path *char, data []u8) os.IoResult {
    let options os.OpenOptions = os.write_options()
    options.truncate = true
    let opened os.FdResult = os.open_path(path, options)
    if (opened.error.kind != os.error_none) {
        return os.io_error(opened.error.kind, opened.error.native_code)
    }
    if (opened.fd < 0) {
        return os.io_error(os.error_other, 0)
    }
    let result os.IoResult = write_bytes(opened.fd, data)
    let closed os.Error = os.close_file(opened.fd)
    if (result.error.kind == os.error_none && closed.kind != os.error_none) {
        return os.IoResult{ count: result.count, error: closed }
    }
    return result
}

// writer_init 把写入器绑定到 fd 与调用方缓冲，待写字节数归零。
// 空缓冲返回 error_invalid_argument，此后所有写入直接失败。
pub fn writer_init(writer *Writer, fd int, buffer []u8) os.Error {
    writer.fd = fd
    writer.buffer = buffer
    writer.count = 0
    if (len(buffer) == 0) {
        writer.error = os.make_error(os.error_invalid_argument, 0)
        return writer.error
    }
    writer.error = os.no_error()
    return writer.error
}

// writer_pending 返回待写出的字节数。
pub fn writer_pending(writer *Writer) u64 {
    return writer.count
}

// writer_flush 把缓冲中的字节写出，返回本次实际写出字节数与显式错误。
// 失败时未写出的字节前移到缓冲开头并保留（count 为剩余量），错误粘滞；
// 只有 error_interrupted 允许在再次调用本函数时清除并重试剩余字节——这是
// 调用方的显式重试，不是库内自动重试。
pub fn writer_flush(writer *Writer) os.IoResult {
    if (writer.error.kind != os.error_none) {
        if (writer.error.kind != os.error_interrupted) {
            return os.io_error(writer.error.kind, writer.error.native_code)
        }
        writer.error = os.no_error()
    }
    if (writer.count == 0) {
        return os.io_ok(0)
    }
    let pending u64 = writer.count
    let result os.IoResult = write_all_result(writer.fd,
        (&writer.buffer[0]).to_type(*char), pending.to_type(int))
    if (result.error.kind != os.error_none) {
        let remaining u64 = pending - result.count
        if (remaining > 0 && result.count > 0) {
            let from int = result.count.to_type(int)
            memcpy((&writer.buffer[0]).to_type(*void),
                (&writer.buffer[from]).to_type(*void), remaining)
        }
        writer.count = remaining
        writer.error = result.error
        return os.IoResult{ count: result.count, error: result.error }
    }
    writer.count = 0
    return os.io_ok(pending)
}

// writer_write 把切片全部接收进缓冲，缓冲满时中途写出。
// count 为已接收字节数；底层写失败时返回已接收进度与错误，未写出字节仍留在
// 缓冲里，后续调用在错误粘滞后直接失败（先 writer_flush 处理可重试错误）。
pub fn writer_write(writer *Writer, data []u8) os.IoResult {
    if (writer.error.kind != os.error_none) {
        return os.io_error(writer.error.kind, writer.error.native_code)
    }
    let total u64 = 0
    let capacity u64 = len(data)
    let buffered u64 = len(writer.buffer)
    for total < capacity {
        if (writer.count >= buffered) {
            let flushed os.IoResult = writer_flush(writer)
            if (flushed.error.kind != os.error_none) {
                return os.IoResult{ count: total, error: flushed.error }
            }
        }
        let room u64 = buffered - writer.count
        let want u64 = capacity - total
        if (want > room) {
            want = room
        }
        let from int = total.to_type(int)
        let to int = writer.count.to_type(int)
        memcpy((&writer.buffer[to]).to_type(*void),
            (&data[from]).to_type(*void), want)
        writer.count += want
        total += want
    }
    return os.io_ok(total)
}

// writer_write_byte 把一个字节写进缓冲；缓冲满时先写出。
pub fn writer_write_byte(writer *Writer, value u8) os.IoResult {
    if (writer.error.kind != os.error_none) {
        return os.io_error(writer.error.kind, writer.error.native_code)
    }
    if (writer.count >= len(writer.buffer)) {
        let flushed os.IoResult = writer_flush(writer)
        if (flushed.error.kind != os.error_none) {
            return os.IoResult{ count: 0, error: flushed.error }
        }
    }
    writer.buffer[writer.count.to_type(int)] = value
    writer.count += 1
    return os.io_ok(1)
}
