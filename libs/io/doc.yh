module io

// yh io 标准库：公开 API 速查。
//
// 本文件只服务阅读与文档索引，不新增运行时行为；实现分别在 00_model.yh
// （类型）、10_read.yh（读取）、20_write.yh（写入），兼容打印接口保留在
// io.yh。所有长度与计数单位都是字节（u64）。
//
// 模型：
//   Reader { fd; buffer []u8; begin; end; eof; error }  借用调用方缓冲
//   Writer { fd; buffer []u8; count; error }            借用调用方缓冲
//   ReadResult { status; count; error }                 读取结果
//   ByteResult { status; value; error }                 单字节结果
//   Status: status_ok / status_eof / status_truncated /
//           status_invalid_argument / status_io_error
//
// 兼容接口（io.yh，签名与返回值不变）：
//   write_all_result(fd,*char,int) os.IoResult
//   write_all(fd,*char,int) int
//   print(*char) int
//   println(*char) int
//
// 读取（10_read.yh）：
//   read_all(fd,out []u8) ReadResult
//   read_file(path *char,out []u8) ReadResult
//   reader_init(reader *Reader,fd int,buffer []u8) os.Error
//   reader_read(reader *Reader,out []u8) ReadResult
//   reader_read_byte(reader *Reader) ByteResult
//   reader_read_line(reader *Reader,out []u8) ReadResult
//   reader_buffered(reader *Reader) u64
//
// 写入（20_write.yh）：
//   write_bytes(fd,data []u8) os.IoResult
//   write_file(path *char,data []u8) os.IoResult
//   writer_init(writer *Writer,fd int,buffer []u8) os.Error
//   writer_write(writer *Writer,data []u8) os.IoResult
//   writer_write_byte(writer *Writer,value u8) os.IoResult
//   writer_flush(writer *Writer) os.IoResult
//   writer_pending(writer *Writer) u64
//
// 语义要点：
//   * EOF：单次读 0 字节无错误即 EOF；read_all 用 status_ok 表示确认到达 EOF，
//     out 恰好填满时用 status_truncated 表示"未确认 EOF"。
//   * 行：只按 '\n' 切分，'\r' 保留，换行包含在结果里；超长行填满 out 后
//     丢弃该行剩余字节并返回 status_truncated。
//   * 错误：EINTR 不自动重试；Reader/Writer 的错误粘滞，Writer 的显式
//     writer_flush 可在 error_interrupted 后重试剩余字节。
//   * 所有权：io 不分配内存、不关闭 reader_*/writer_* 绑定的 fd；
//     read_file/write_file 打开自己的 fd 并负责关闭。
//
// 示例：
//   let storage [1024]u8
//   let reader Reader
//   if (reader_init(&reader, fd, storage[0..1024]).kind != os.error_none) { … }
//   let line [256]u8
//   let result ReadResult = reader_read_line(&reader, line[0..256])
//   if (result.status == status_ok) { … result.count 为有效字节数 … }
