module io

// yh io 标准库：入口与兼容打印接口。
//
// 完整能力分布在：
//   00_model.yh  Status/ReadResult/ByteResult/Reader/Writer/IO_BUFFER_SIZE
//   10_read.yh   read_all/read_file/reader_init/reader_read/reader_read_byte/
//                reader_read_line/reader_buffered
//   20_write.yh  write_all_result/write_all/write_bytes/write_file/writer_init/
//                writer_write/writer_write_byte/writer_flush/writer_pending
//
// 本文件只保留 2026-10 之前的 print/println（NUL 结尾字符串、无缓冲、写 fd 1）。
// 新代码优先用 Writer 或 write_bytes：它们带长度、支持内嵌 NUL 并返回显式错误。

// print 将以 NUL 结尾的字符串写到标准输出，不追加换行。
// 完整写入返回 0，底层写入失败返回 -1。
pub fn print(text *char) int {
    return write_all(1, text, strlen(text).to_type(int))
}

// println 将以 NUL 结尾的字符串和一个换行写到标准输出。
// 字符串或换行任一部分写入失败都返回 -1，成功返回 0。
pub fn println(text *char) int {
    if (print(text) != 0) {
        return -1
    }
    return write_all(1, "\n", 1)
}
