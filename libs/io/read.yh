module io

import os

// yh io 标准库：读取层。
//
// 三档能力：整段读取（read_all/read_file）、有缓冲读取（Reader）、单字节读取。
// 全部不分配内存、不关闭 fd、不自动重试被信号中断的读取；EOF 表现为
// status_eof（或 read_all 的 status_ok），截断表现为 status_truncated。
// 行只按 '\n' 切分，'\r' 保留为普通字节，换行符包含在返回内容里。

// reader_fill 把内核数据预读进缓冲，替换已消费的部分。
// 成功返回 status_ok（count 为本次读入字节数）；EOF 返回 status_eof；
// 失败返回 status_io_error 并把错误粘滞到 reader.error。
fn reader_fill(reader *Reader) ReadResult {
    if (reader.error.kind != os.error_none) {
        return read_failed(reader.error, 0)
    }
    let result os.IoResult = os.read_some(reader.fd, reader.buffer)
    if (result.error.kind != os.error_none) {
        reader.error = result.error
        return read_failed(result.error, 0)
    }
    reader.begin = 0
    reader.end = result.count
    if (result.count == 0) {
        reader.eof = true
        return read_eof()
    }
    return read_ok(result.count)
}

// reader_take_into 从缓冲复制 count 字节到 out 的 at 位置并推进游标。
// 调用方保证 count 不超过缓冲可用字节与 out 剩余空间。
fn reader_take_into(reader *Reader, out []u8, at u64, count u64) u64 {
    if (count == 0) {
        return 0
    }
    let from int = reader.begin.to_type(int)
    let to int = at.to_type(int)
    memcpy((&out[to]).to_type(*void), (&reader.buffer[from]).to_type(*void), count)
    reader.begin += count
    return count
}

// reader_take 取走缓冲中至多 len(out) 字节。
fn reader_take(reader *Reader, out []u8) u64 {
    let available u64 = reader.end - reader.begin
    let want u64 = len(out)
    if (want > available) {
        want = available
    }
    return reader_take_into(reader, out, 0, want)
}

// reader_discard_line 丢弃当前行剩余字节直到并包含 '\n'，或直到 EOF/错误。
// 截断语义专用：保证下一次 reader_read_line 从下一行开始。
fn reader_discard_line(reader *Reader) void {
    for 1 {
        let index u64 = reader.begin
        for index < reader.end {
            if (reader.buffer[index.to_type(int)].to_type(int) == 10) {
                reader.begin = index + 1
                return
            }
            index += 1
        }
        reader.begin = reader.end
        let filled ReadResult = reader_fill(reader)
        if (filled.status != status_ok) {
            return
        }
    }
}

