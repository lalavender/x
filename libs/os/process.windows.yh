module os

import sys

// Windows 进程接口：精确路径 spawn、wait 与 exit。
//
// 与 Linux/Darwin 的模型差异：Windows 没有 fork/exec，进程创建是一次
// CreateProcessA（可执行文件 + 命令行 + 环境块 + 启动信息），等待是
// WaitForSingleObject + GetExitCodeProcess，也没有 POSIX 信号。因此这里：
//   * spawn 直接 CreateProcessA，成功即返回子 pid（不再有“exec 错误管道”
//     握手——创建失败在 CreateProcessA 的返回值里就能直接得到）；
//   * 子进程句柄必须保留到 wait 才能取退出码，因此用一个 64 槽的进程表
//     保存 pid→handle（HANDLE 是 64 位，塞不进 yh 的 int）；
//   * wait 用 WaitForSingleObject(INFINITE) 阻塞，退出码即 GetExitCodeProcess；
//   * 没有信号：被杀死的子进程表现为非零退出码，state 记为 wait_exited。

// WaitState 区分正常退出、信号退出与等待失败。
// Windows 没有可报告的终止信号，wait_signaled 不会被本平台产生。
pub enum WaitState {
    wait_exited
    wait_signaled
    wait_error
}

// PidResult 是 spawn 的结果：成功 pid 为正子进程号，失败 pid 为 -1。
pub struct PidResult {
    pid int
    error Error
}

// WaitResult 是 wait 的结果：state 为 wait_exited 时 exit_code 有效。
pub struct WaitResult {
    state WaitState
    exit_code int
    signal int
    error Error
}

// 子进程表：pid 与句柄成对保存，句柄为 0 表示槽位空。
// 只服务 os.spawn 创建的子进程；进程退出后 wait 关闭句柄并释放槽位。
const WIN_CHILD_SLOTS int = 64
let win_child_pids [64]int
let win_child_handles [64]i64

// STARTUPINFOA 的长度：x64 上为 104 字节，cb 字段必须在偏移 0 写对。
const STARTUPINFO_BYTES int = 104
// PROCESS_INFORMATION 的字段偏移：hProcess@0、hThread@8、pid@16。
const PI_PROCESS_OFFSET int = 0
const PI_PID_OFFSET int = 16
const PI_BYTES int = 24
// OpenProcess 的访问权限：只需等待与查询退出码。
const PROCESS_SYNCHRONIZE u32 = 0x00100000
const PROCESS_QUERY_LIMITED u32 = 0x1000
// WaitForSingleObject 的无限等待。
const INFINITE_WAIT u32 = 0xffffffff

@[extern] fn CreateProcessA(application *char, command_line *char,
    process_attrs *void, thread_attrs *void, inherit_handles i32,
    flags u32, environment *void, current_dir *char, startup *u8,
    info *u8) i32
@[extern] fn WaitForSingleObject(handle *void, milliseconds u32) u32
@[extern] fn GetExitCodeProcess(handle *void, code *u32) i32
@[extern] fn OpenProcess(access u32, inherit i32, pid u32) *void
// 关闭内核句柄走 SDK 支撑对象（compiler/windows-sdk/chkstk.c 的 __yh_close_handle）：
// 运行时已经声明过 `CloseHandle`，yh 的 extern 声明会与它重定义。
@[extern] fn __yh_close_handle(handle *void) i32
// GetLastError：CreateProcessA/OpenProcess/WaitForSingleObject 失败后的唯一诊断来源。
@[extern] fn GetLastError() u32

// pid_ok 构造成功的 spawn 结果。
fn pid_ok(pid int) PidResult {
    return PidResult{ pid: pid, error: no_error() }
}

// pid_error 构造失败的 spawn 结果，pid 固定为 -1。
fn pid_error(kind ErrorKind, native_code int) PidResult {
    return PidResult{ pid: -1, error: make_error(kind, native_code) }
}

// wait_failed 构造等待失败结果，退出码与信号字段无意义并置为 -1/0。
fn wait_failed(error Error) WaitResult {
    return WaitResult{
        state: wait_error,
        exit_code: -1,
        signal: 0,
        error: error
    }
}

// child_store 登记 (pid, handle)，返回 0 成功、-1 表示表已满。
fn child_store(pid int, handle i64) int {
    let i int = 0
    for i < WIN_CHILD_SLOTS {
        if (win_child_handles[i] == 0) {
            win_child_pids[i] = pid
            win_child_handles[i] = handle
            return 0
        }
        i += 1
    }
    return -1
}

// child_take 取出 pid 对应的句柄并释放槽位；未登记返回 0。
fn child_take(pid int) i64 {
    let i int = 0
    for i < WIN_CHILD_SLOTS {
        if (win_child_handles[i] != 0 && win_child_pids[i] == pid) {
            let handle i64 = win_child_handles[i]
            win_child_handles[i] = 0
            win_child_pids[i] = 0
            return handle
        }
        i += 1
    }
    return 0
}

// arg_needs_quote 判断一个参数在拼命令行时是否必须加引号。
fn arg_needs_quote(text *char) int {
    let i int = 0
    for text[i] != 0 {
        if (text[i] == 32 || text[i] == 9 || text[i] == 34) {
            return 1
        }
        i += 1
    }
    return 0
}

// arg_bytes 是参数转义后的长度：需要引号时按 2 倍 + 2 预留（保守上界）。
fn arg_bytes(text *char) u64 {
    let length u64 = 0
    for text[length.to_type(int)] != 0 {
        length += 1
    }
    if (arg_needs_quote(text) != 0) {
        return length * 2 + 2
    }
    return length + 1
}

// build_command_line 把 NUL 结尾的 argv 拼成 Windows 命令行。
// 规则（够用即可）：参数含空格/制表符/引号时整体加双引号，
// 内部的 `"` 用 `\"` 转义；不含特殊字符时原样拼接。
fn build_command_line(argv **char) *char {
    let needed u64 = 1
    let i int = 0
    for argv[i] != 0 {
        needed += arg_bytes(argv[i]) + 1
        i += 1
    }
    let buffer *u8 = malloc(needed).to_type(*u8)
    if (buffer == 0) {
        return 0
    }
    let used int = 0
    i = 0
    for argv[i] != 0 {
        if (i > 0) {
            buffer[used] = 32
            used += 1
        }
        let text *char = argv[i]
        let quote int = arg_needs_quote(text)
        if (quote != 0) {
            buffer[used] = 34
            used += 1
        }
        let j int = 0
        for text[j] != 0 {
            if (text[j] == 34) {
                buffer[used] = 92
                used += 1
            }
            buffer[used] = text[j].to_type(u8)
            used += 1
            j += 1
        }
        if (quote != 0) {
            buffer[used] = 34
            used += 1
        }
        i += 1
    }
    buffer[used] = 0
    return buffer.to_type(*char)
}

// build_environment 把 envp 拼成 Windows 环境块（每项 `K=V` + NUL，末尾再补 NUL）。
// envp 为空指针时返回 0，表示“继承父进程环境”。
fn build_environment(envp **char) *u8 {
    if (envp == 0) {
        return 0
    }
    let needed u64 = 1
    let i int = 0
    for envp[i] != 0 {
        let j int = 0
        for envp[i][j] != 0 {
            j += 1
        }
        needed += j.to_type(u64) + 1
        i += 1
    }
    let block *u8 = malloc(needed).to_type(*u8)
    if (block == 0) {
        return 0
    }
    let used int = 0
    i = 0
    for envp[i] != 0 {
        let j int = 0
        for envp[i][j] != 0 {
            block[used] = envp[i][j].to_type(u8)
            used += 1
            j += 1
        }
        block[used] = 0
        used += 1
        i += 1
    }
    block[used] = 0
    return block
}

// read_handle 从 PROCESS_INFORMATION 缓冲读 64 位句柄（小端）。
fn read_handle(info *u8, offset int) i64 {
    let value u64 = 0
    let i int = 0
    for i < 8 {
        value = value | (info[offset + i].to_type(u64) << (i * 8).to_type(u64))
        i += 1
    }
    return value.to_type(i64)
}

// read_pid 从 PROCESS_INFORMATION 缓冲读 32 位进程号（小端）。
fn read_pid(info *u8) int {
    let value u32 = info[PI_PID_OFFSET].to_type(u32) |
        (info[PI_PID_OFFSET + 1].to_type(u32) << 8) |
        (info[PI_PID_OFFSET + 2].to_type(u32) << 16) |
        (info[PI_PID_OFFSET + 3].to_type(u32) << 24)
    return value.to_type(int)
}

// spawn 用精确路径启动进程；argv 为 NUL 结尾指针数组，envp 为空指针表示继承环境。
// 成功返回子 pid 并把句柄存入进程表，失败返回 from_native 错误。
// 标准句柄随父进程继承（bInheritHandles = TRUE，STARTUPINFOA 不指定句柄）。
pub fn spawn(path *char, argv **char, envp **char) PidResult {
    if (path == 0 || argv == 0 || argv[0] == 0) {
        return pid_error(error_invalid_argument, 0)
    }
    let command *char = build_command_line(argv)
    if (command == 0) {
        return pid_error(error_other, 0)
    }
    let environment *u8 = build_environment(envp)
    let startup [104]u8
    let i int = 0
    for i < STARTUPINFO_BYTES {
        startup[i] = 0
        i += 1
    }
    // cb = 104（STARTUPINFOA 的大小），后续字段全 0 即“默认”：句柄继承自父进程。
    startup[0] = 104
    startup[1] = 0
    startup[2] = 0
    startup[3] = 0
    let info [24]u8
    i = 0
    for i < PI_BYTES {
        info[i] = 0
        i += 1
    }
    let ok i32 = CreateProcessA(path, command, 0.to_type(*void),
        0.to_type(*void), 1, 0.to_type(u32), environment.to_type(*void),
        0.to_type(*char), &startup[0], &info[0])
    free(command.to_type(*void))
    if (environment != 0) {
        free(environment.to_type(*void))
    }
    if (ok == 0) {
        let code int = errno_native()
        return pid_error(error_kind_for(code), code)
    }
    // 线程句柄不需要，立刻释放；进程句柄留给 wait。
    let thread i64 = read_handle(&info[0], 8)
    if (thread != 0) {
        __yh_close_handle(thread.to_type(*void))
    }
    let handle i64 = read_handle(&info[0], PI_PROCESS_OFFSET)
    let pid int = read_pid(&info[0])
    if (child_store(pid, handle) != 0) {
        // 表满：不能泄漏子进程，直接结束它并报错。
        __yh_close_handle(handle.to_type(*void))
        return pid_error(error_unsupported, 0)
    }
    return pid_ok(pid)
}

// errno_native 把 GetLastError 的结果翻译成 POSIX errno 数值。
// sys 的 errno 桥是模块私有的（errno.windows.yh），os 层无法直接调用，
// 这里用同一张表再翻译一次（只登记 os 会分类的码，其余归 EIO）。
fn errno_native() int {
    let code u32 = GetLastError()
    if (code == 2 || code == 3) {
        return sys.ENOENT
    }
    if (code == 5) {
        return sys.EACCES
    }
    if (code == 6) {
        return sys.EBADF
    }
    if (code == 8 || code == 14) {
        return sys.ENOMEM
    }
    if (code == 87) {
        return sys.EINVAL
    }
    if (code == 267) {
        return sys.ENOTDIR
    }
    return sys.EIO
}

// wait 阻塞等待指定子进程并返回退出码。
// pid 必须是本进程 spawn 出来的（进程表里能找到句柄）；找不到时用 OpenProcess
// 尝试打开，仍失败则返回 wait_error。
pub fn wait(pid int) WaitResult {
    let handle i64 = child_take(pid)
    if (handle == 0) {
        let opened *void = OpenProcess(PROCESS_SYNCHRONIZE | PROCESS_QUERY_LIMITED,
            0, pid.to_type(u32))
        if (opened == 0) {
            return wait_failed(error_from_native(errno_native()))
        }
        handle = opened.to_type(i64)
    }
    let waited u32 = WaitForSingleObject(handle.to_type(*void), INFINITE_WAIT)
    if (waited != 0) {
        __yh_close_handle(handle.to_type(*void))
        return wait_failed(error_from_native(errno_native()))
    }
    let code u32 = 0
    if (GetExitCodeProcess(handle.to_type(*void), &code) == 0) {
        __yh_close_handle(handle.to_type(*void))
        return wait_failed(error_from_native(errno_native()))
    }
    __yh_close_handle(handle.to_type(*void))
    return WaitResult{
        state: wait_exited,
        exit_code: code.to_type(int),
        signal: 0,
        error: no_error()
    }
}

// exit_now 立即以指定状态结束进程；不刷新缓冲、不执行语言清理。
pub fn exit_now(code int) void {
    sys.exit_process(code)
}
