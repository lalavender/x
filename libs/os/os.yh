module os;

@[extern] fn rmdir(path *char) int;
@[extern] fn isatty(fd int) int;

// open_file 以宿主 open 标志打开路径；未使用 O_CREAT 时调用此形式。
pub fn open_file(path *char, flags int) int {
    return open(path, flags);
}

// open_file_mode 在宿主 open 标志包含 O_CREAT 时同时传入权限位。
pub fn open_file_mode(path *char, flags int, mode int) int {
    return open(path, flags, mode);
}

// read_fd 从文件描述符读取至多 byte_count 字节，返回实际字节数或 -1。
pub fn read_fd(fd int, buffer *void, byte_count u64) i64 {
    return read(fd, buffer, byte_count);
}

// write_fd 向文件描述符写入至多 byte_count 字节，返回实际字节数或 -1。
pub fn write_fd(fd int, buffer *void, byte_count u64) i64 {
    return write(fd, buffer, byte_count);
}

// close_fd 关闭文件描述符，成功返回 0，失败返回 -1。
pub fn close_fd(fd int) int {
    return close(fd);
}

// create_dir 按宿主权限位创建单层目录，成功返回 0，失败返回 -1。
pub fn create_dir(path *char, mode int) int {
    return mkdir(path, mode);
}

// remove_dir 删除空目录，成功返回 0，失败返回 -1。
pub fn remove_dir(path *char) int {
    return rmdir(path);
}

// remove_file 删除文件系统路径，成功返回 0，失败返回 -1。
pub fn remove_file(path *char) int {
    return unlink(path);
}

// rename_file 将旧路径原子重命名为新路径，返回宿主 rename 的结果。
pub fn rename_file(old_path *char, new_path *char) int {
    return rename(old_path, new_path);
}

// is_terminal 判断文件描述符是否连接终端；失败返回 0。
pub fn is_terminal(fd int) int {
    return isatty(fd);
}

// process_id 返回当前进程的宿主进程号。
pub fn process_id() int {
    return getpid();
}

// terminate 以指定状态结束当前进程。
pub fn terminate(code int) {
    exit(code);
}

// platform 返回编译目标的平台名称。
pub fn platform() *char {
    $if (linux) {
        return "linux";
    }
    $if (darwin) {
        return "darwin";
    }
    return "unknown";
}

// arch 返回编译目标的架构名称。
pub fn arch() *char {
    $if (arm64) {
        return "arm64";
    }
    $if (x64) {
        return "x64";
    }
    return "unknown";
}

