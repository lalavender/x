module os

import sys

// 跨平台的新文件接口：把 sys 的 -errno 结果转换成 os 的显式错误与
// 自有打开选项。打开标志与 *at 原语来自 sys 的当前平台实现（Linux 内核
// 调用 / Darwin libSystem），本文件不出现平台错误号。旧
// open_file/open_file_mode/read_fd/write_fd/close_fd 等接口继续保留在
// os.yh，仍返回宿主标志与 -1，不能与新接口混用返回值。
//
// 新 open 默认带 O_CLOEXEC；read/write 只执行一次并允许短读写，遇 EINTR
// 返回 interrupted；close 只调用一次，失败后不重试也不继续使用该 fd。
// 路径是 NUL 结尾字节串，不承诺 Unicode 规范化；切片只借用调用方缓冲。

// validate_options 检查 os 自有打开选项的组合是否合法。
// exclusive 只能与 create 一起使用；只读模式不能同时要求截断或追加；
// 库自身发现的问题 native_code 为 0，不伪造内核错误号。
fn validate_options(options OpenOptions) Error {
    if (options.exclusive != false && options.create == false) {
        return make_error(error_invalid_argument, 0)
    }
    if (options.access == access_read_only
        && (options.truncate != false || options.append != false)) {
        return make_error(error_invalid_argument, 0)
    }
    return no_error()
}

// access_flags 把访问模式转换为当前目标的 O_ACCMODE 位。
fn access_flags(options OpenOptions) int {
    if (options.access == access_write_only) {
        return sys.O_WRONLY
    }
    if (options.access == access_read_write) {
        return sys.O_RDWR
    }
    return sys.O_RDONLY
}

// open_flags 把 os 选项转换为当前目标 openat 标志，并强制加入 O_CLOEXEC。
fn open_flags(options OpenOptions) int {
    let flags int = access_flags(options) | sys.O_CLOEXEC
    if (options.create != false) {
        flags |= sys.O_CREAT
    }
    if (options.truncate != false) {
        flags |= sys.O_TRUNC
    }
    if (options.exclusive != false) {
        flags |= sys.O_EXCL
    }
    if (options.append != false) {
        flags |= sys.O_APPEND
    }
    return flags
}

