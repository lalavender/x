module os;

// Darwin 的 io 兼容单次写入。新文件/目录/进程 API 尚未在 Darwin 接入；
// prelude write 失败只返回 -1，无法读取线程 errno，因此 native_code 为 0，
// 分类归入 error_other。io.write_all_result 只依赖本函数，不需要完整 os 文件 API。
pub fn write_once(fd int, buffer *void, count u64) IoResult {
    let result i64 = write(fd, buffer, count);
    if (result < 0) {
        return io_error(error_other, 0);
    }
    return io_ok(result.to_type(u64));
}
