module os

// 环境查询：从入口 main 的 envp 显式扫描，不设置全局环境、不分配、不调用
// getenv 系统调用。返回值中的 value 借用 envp 生命周期；调用方需要长期保存
// 时复制字节。重复键返回首项；缺失与空值是两个不同结果。

// EnvResult 是环境查询结果：found 为 1 时 value 指向第一个 '=' 后的字节串
// （可能为空串），found 为 0 时 value 固定为空指针且 error 为 error_none；
// 名字非法或 envp 为空指针时返回 error_invalid_argument。
pub struct EnvResult {
    found bool
    value *char
    error Error
}

// env_invalid 构造非法参数结果：未找到，native_code 为 0。
fn env_invalid() EnvResult {
    return EnvResult{
        found: false,
        value: 0,
        error: make_error(error_invalid_argument, 0)
    }
}

// env_not_found 构造“合法查询但不存在”的结果：没有错误，value 为空指针。
fn env_not_found() EnvResult {
    return EnvResult{ found: false, value: 0, error: no_error() }
}

// get_env 在 NUL 结尾的 envp 指针数组中按完整键查找环境值。
// name 不能为空、不能包含 '='；按完整的 '=' 前缀匹配，避免 "A" 命中 "AA"。
// 缺失返回 found=0 且无错误；找到返回借用值指针，空值表现为指向空串。
pub fn get_env(envp **char, name *char) EnvResult {
    if (envp == 0 || name == 0 || name[0] == 0) {
        return env_invalid()
    }
    let name_len int = 0
    for name[name_len] != 0 {
        if (name[name_len] == 61) {
            return env_invalid()
        }
        name_len += 1
    }
    let row int = 0
    for envp[row] != 0 {
        let entry *char = envp[row]
        let index int = 0
        for name[index] != 0 && entry[index] == name[index] {
            index += 1
        }
        // 名字完整匹配后必须紧跟 '='；无 '=' 的条目不是有效环境项，跳过。
        if (name[index] == 0 && entry[index] == 61) {
            return EnvResult{
                found: true,
                value: entry + index + 1,
                error: no_error()
            }
        }
        row += 1
    }
    return env_not_found()
}
