module os

// os 结果模型：跨平台的具体结果结构，不暴露 sys 的原始返回或 Timespec。
// 错误包含稳定分类与目标平台正错误号；分类用于程序判断，native_code 用于
// 诊断显示。类库自己发现的非法选项等错误 native_code 为 0，不捏造内核值。

// ErrorKind 是 os 对外稳定的错误分类。
// 成员名带 error_ 前缀，避免与同模块其他枚举成员冲突；跨模块引用形如
// os.error_not_found。具体分类不随目标平台错误号变化。
pub enum ErrorKind {
    error_none
    error_not_found
    error_already_exists
    error_permission_denied
    error_interrupted
    error_invalid_argument
    error_unsupported
    error_other
    // 网络分类（2026-10-24，net 与 http 共用）。追加在末尾保持既有取值不变；
    // 具体映射见 10_errors.yh 的 error_kind_for。
    error_connection_refused
    error_connection_reset
    error_not_connected
    error_timed_out
    error_address_in_use
    error_host_unreachable
    error_network_unreachable
}

// Error 描述一次 os 操作的失败；kind 为稳定分类，native_code 为目标平台
// 正错误号（无内核错误来源时为 0）。不得用 native_code == 0 判断成功，
// 成功与失败必须由调用方查看操作结果或 kind 判断。
pub struct Error {
    kind ErrorKind
    native_code int
}

// FdResult 是打开类操作的结果：成功时 fd >= 0 且 error 为 error_none，
// 失败时 fd 固定为 -1；成功 fd 的所有权转移给调用方，必须由调用方关闭。
pub struct FdResult {
    fd int
    error Error
}

// IoResult 是单次读写的结果：成功时 count 为实际字节数且 error 为
// error_none；单次调用失败时 count 为 0。EOF 表现为 count == 0 且没有错误。
pub struct IoResult {
    count u64
    error Error
}

// AccessKind 是打开文件时的访问模式。
pub enum AccessKind {
    access_read_only
    access_write_only
    access_read_write
}

// OpenOptions 是 os 自有打开选项，不使用宿主 open 标志数值。
// access 选择读写模式；create/truncate/exclusive/append 对应各自语义；
// mode 只在创建时使用，调用方应通过 read_options/write_options 初始化，
// 不要依赖结构体零值猜测默认行为。
pub struct OpenOptions {
    access AccessKind
    create bool
    truncate bool
    exclusive bool
    append bool
    mode u32
}

// DirKind 是目录条目的类型分类；dir_unknown 对应 DT_UNKNOWN 或本库尚不能
// 确认的类型，调用方不得把它当作普通文件。
pub enum DirKind {
    dir_unknown
    dir_file
    dir_directory
}

// DirEntry 是目录条目视图：name 指向读取器缓冲区中的名称字节，name_len 为
// 不含结尾 NUL 的长度。视图只保证到下一次 next_entry 或 close_dir；需要长期
// 保存时由调用方复制 name_len 个字节。语言暂不支持从裸指针构造 []u8，因此
// 这里使用指针 + 长度，而不是切片字段。
pub struct DirEntry {
    name *u8
    name_len u64
    kind DirKind
}

// no_error 返回成功错误值：分类 error_none、native_code 为 0。
pub fn no_error() Error {
    return Error{ kind: error_none, native_code: 0 }
}

// make_error 按稳定分类和目标平台正错误号构造错误。
// native_code 只用于诊断，不能跨平台比较；库内部发现的无效参数传 0。
pub fn make_error(kind ErrorKind, native_code int) Error {
    return Error{ kind: kind, native_code: native_code }
}

// fd_ok 构造成功的文件描述符结果；fd 必须是非负值，所有权交给调用方。
pub fn fd_ok(fd int) FdResult {
    return FdResult{ fd: fd, error: no_error() }
}

// fd_error 构造失败的文件描述符结果，fd 固定为 -1。
pub fn fd_error(kind ErrorKind, native_code int) FdResult {
    return FdResult{ fd: -1, error: make_error(kind, native_code) }
}

// io_ok 构造成功的读写结果；count 是本次实际读写的字节数。
pub fn io_ok(count u64) IoResult {
    return IoResult{ count: count, error: no_error() }
}

// io_error 构造失败的读写结果；单次调用失败时 count 固定为 0。
pub fn io_error(kind ErrorKind, native_code int) IoResult {
    return IoResult{ count: 0, error: make_error(kind, native_code) }
}

// read_options 返回只读打开选项：不创建、不截断、不追加，权限位为 0666。
// mode 只在调用方随后把 create 置为 true 时才会被内核使用。
pub fn read_options() OpenOptions {
    return OpenOptions{
        access: access_read_only,
        create: false,
        truncate: false,
        exclusive: false,
        append: false,
        mode: 420
    }
}

// write_options 返回只写打开选项：默认创建文件但不截断、不独占、不追加，
// 权限位为 0666。需要覆盖写入时由调用方显式设置 truncate = true。
pub fn write_options() OpenOptions {
    return OpenOptions{
        access: access_write_only,
        create: true,
        truncate: false,
        exclusive: false,
        append: false,
        mode: 420
    }
}

// make_dir_entry 由调用方切片构造目录条目视图；name 不复制。
// 空切片得到空指针和零长度；非空切片指向首字节。生命周期由调用方保证。
pub fn make_dir_entry(name []u8, kind DirKind) DirEntry {
    if (len(name) == 0) {
        return DirEntry{ name: 0, name_len: 0, kind: kind }
    }
    return DirEntry{ name: &name[0], name_len: len(name), kind: kind }
}
