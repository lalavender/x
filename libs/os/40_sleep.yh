module os

import sys

// 跨平台的旧 sleep_us 兼容实现：把微秒转换为 sys.Timespec 后调用
// sys.sleep_time（Linux nanosleep 系统调用 / Darwin libSystem nanosleep）。
// 负值仍返回 -1；成功返回 0；EINTR 或其他错误返回 -1，与旧 usleep 契约一致，
// 不向调用方暴露剩余时间，也不在库内自动重试。
pub fn sleep_us(duration int) int {
    if (duration < 0) {
        return -1
    }
    let micros i64 = duration.to_type(i64)
    let request sys.Timespec
    request.sec = micros / 1000000
    request.nsec = (micros % 1000000) * 1000
    if (sys.sleep_time(&request, 0) == 0) {
        return 0
    }
    return -1
}
