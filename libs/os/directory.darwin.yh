module os

import sys

// Darwin 目录读取与当前目录接口。
// 读取器使用调用方提供的字节缓冲区，逐批调用 getattrlistbulk 取条目组，
// 不一次性分配全部目录项，不保证顺序，不把未知类型当作普通文件。
// 条目名称借用读取器缓冲区，只保证到下一次 next_entry 或 close_dir。
//
// 条目组布局（sys.read_dir_entries 请求的属性顺序）：
//   [0..4)   u32 组总长度（含自身，8 字节对齐）
//   [4..24)  attribute_set（5 个 u32，第一个字是 commonattr 实得位）
//   [24..32) name attrreference：i32 名称偏移 + u32 名称长度（含结尾 NUL）
//   [32..36) u32 vnode 对象类型（VREG/VDIR）
// 名称偏移相对 attrreference 自身，因此名称起点为 24 + 偏移。

// DirReader 保存目录 fd、调用方缓冲、当前批次字节数与游标。
// 字段公开是为了让读取器可放在调用方栈上；调用方不得直接改写字段，
// 生命周期结束必须调用 close_dir。active == 0 表示未打开或已关闭。
pub struct DirReader {
    fd int
    buffer *u8
    capacity u64
    used u64
    cursor u64
    active int
}

// DirReaderResult 是 open_dir 的结果：成功时 reader.active == 1，
// 失败时 fd 为 -1 且 error 给出显式分类。
pub struct DirReaderResult {
    reader DirReader
    error Error
}

// DirEntryResult 是 next_entry 的结果：status 为 dir_entry_ok 时 entry 有效，

// empty_entry 返回无效条目的零值视图，供结束/失败结果使用。
fn empty_entry() DirEntry {
    return DirEntry{ name: 0, name_len: 0, kind: dir_unknown }
}

// reader_failure 构造未打开状态的读取器结果。
fn reader_failure(error Error) DirReaderResult {
    let reader DirReader
    reader.fd = -1
    reader.buffer = 0
    reader.capacity = 0
    reader.used = 0
    reader.cursor = 0
    reader.active = 0
    return DirReaderResult{ reader: reader, error: error }
}

// dir_error 构造失败的条目结果，entry 固定为空视图。
fn dir_error(error Error) DirEntryResult {
    return DirEntryResult{
        status: dir_entry_error,
        entry: empty_entry(),
        error: error
    }
}

// dir_end 构造目录结束结果，没有错误。
fn dir_end() DirEntryResult {
    return DirEntryResult{
        status: dir_entry_end,
        entry: empty_entry(),
        error: no_error()
    }
}

// record_u32 按小端读取条目组内偏移处的 u32；调用方保证偏移在批次内。
fn record_u32(buffer *u8, offset u64) u32 {
    let pos int = offset.to_type(int)
    return buffer[pos].to_type(u32) |
        (buffer[pos + 1].to_type(u32) << 8) |
        (buffer[pos + 2].to_type(u32) << 16) |
        (buffer[pos + 3].to_type(u32) << 24)
}

// batch_bytes 计算本批 entries 个条目组占用的总字节数。
// 组长度必须覆盖最小头部且不越过调用方容量；布局异常返回 0 由调用方报错。
fn batch_bytes(buffer *u8, entries int, capacity u64) u64 {
    let cursor u64 = 0
    let index int = 0
    for index < entries {
        if (cursor + 4 > capacity) {
            return 0
        }
        let length u64 = record_u32(buffer, cursor).to_type(u64)
        if (length < 36 || cursor + length > capacity) {
            return 0
        }
        cursor += length
        index += 1
    }
    return cursor
}

// dir_kind_of 把 vnode 对象类型映射为公开分类；只认识普通文件与目录，
// 其余（符号链接、设备、套接字等）保留 unknown，调用方不得自行猜测。
fn dir_kind_of(native u32) DirKind {
    if (native == sys.VDIR) {
        return dir_directory
    }
    if (native == sys.VREG) {
        return dir_file
    }
    return dir_unknown
}

// open_dir 按 NUL 结尾路径打开目录，缓冲区由调用方提供并借用给读取器。
// 成功返回 active 读取器并把 fd 所有权交给读取器；空缓冲或打开失败返回错误。
// 新 fd 默认 O_CLOEXEC，路径不搜索 PATH、不经过 shell。
pub fn open_dir(path *char, buffer []u8) DirReaderResult {
    if (len(buffer) == 0) {
        return reader_failure(make_error(error_invalid_argument, 0))
    }
    let result i64 = sys.open_at(sys.AT_FDCWD, path,
        sys.O_RDONLY | sys.O_DIRECTORY | sys.O_CLOEXEC, 0)
    if (sys.is_error(result) != 0) {
        let code int = sys.error_code(result)
        return reader_failure(error_from_native(code))
    }
    let reader DirReader
    reader.fd = result.to_type(int)
    reader.buffer = &buffer[0]
    reader.capacity = len(buffer)
    reader.used = 0
    reader.cursor = 0
    reader.active = 1
    return DirReaderResult{ reader: reader, error: no_error() }
}

// next_entry 返回目录中的下一个普通条目，跳过 "." 与 ".."。
// 目录结束返回 dir_entry_end；未打开/已关闭、内核错误或布局异常返回
// dir_entry_error。名称视图在下一次调用前有效，调用方需要长期保存时复制。
// 缺少 NAME/OBJTYPE 的条目组按布局异常跳过，不冒充文件。
pub fn next_entry(reader *DirReader) DirEntryResult {
    if (reader.active == 0) {
        return dir_error(make_error(error_invalid_argument, 0))
    }
    for 1 == 1 {
        if (reader.cursor >= reader.used) {
            let fetched i64 = sys.read_dir_entries(reader.fd,
                reader.buffer.to_type(*void), reader.capacity)
            if (sys.is_error(fetched) != 0) {
                let code int = sys.error_code(fetched)
                return dir_error(error_from_native(code))
            }
            if (fetched == 0) {
                return dir_end()
            }
            reader.used = batch_bytes(reader.buffer, fetched.to_type(int),
                reader.capacity)
            reader.cursor = 0
            if (reader.used == 0) {
                return dir_error(make_error(error_other, 0))
            }
        }
        let pos u64 = reader.cursor
        let record_len u64 = record_u32(reader.buffer, pos).to_type(u64)
        if (record_len < 36 || pos + record_len > reader.used) {
            reader.cursor = reader.used
            return dir_error(make_error(error_other, 0))
        }
        let returned u32 = record_u32(reader.buffer, pos + 4)
        let name_offset int = record_u32(reader.buffer, pos + 24).to_type(int)
        let name_length u64 = record_u32(reader.buffer, pos + 28).to_type(u64)
        let object_type u32 = record_u32(reader.buffer, pos + 32)
        let name_pos int = 24 + name_offset
        let usable int = 0
        if ((returned & sys.ATTR_CMN_NAME) != 0
            && (returned & sys.ATTR_CMN_OBJTYPE) != 0
            && name_length > 0 && name_pos >= 24
            && name_pos.to_type(u64) + name_length <= record_len) {
            usable = 1
        }
        if (usable == 0) {
            reader.cursor += record_len
            continue
        }
        let name_ptr *u8 = reader.buffer + pos.to_type(int) + name_pos
        // 名称长度含结尾 NUL；dir 名与文件名都按字节比较，避免字符串相等。
        let name_len u64 = name_length - 1
        if (name_len == 1 && name_ptr[0] == 46) {
            reader.cursor += record_len
            continue
        }
        if (name_len == 2 && name_ptr[0] == 46 && name_ptr[1] == 46) {
            reader.cursor += record_len
            continue
        }
        let entry DirEntry
        entry.name = name_ptr
        entry.name_len = name_len
        entry.kind = dir_kind_of(object_type)
        reader.cursor += record_len
        return DirEntryResult{
            status: dir_entry_ok,
            entry: entry,
            error: no_error()
        }
    }
    return dir_error(make_error(error_other, 0))
}

// close_dir 关闭目录并清空读取状态；重复关闭是幂等的并返回成功。
// close 只调用一次，失败后 fd 可能已经释放，调用方不得继续使用读取器。
pub fn close_dir(reader *DirReader) Error {
    // active == 0 覆盖零值读取器与重复关闭：不能把未打开的 fd = 0 当 stdin 关闭。
    if (reader.active == 0 || reader.fd < 0) {
        reader.fd = -1
        reader.buffer = 0
        reader.capacity = 0
        reader.used = 0
        reader.cursor = 0
        reader.active = 0
        return no_error()
    }
    let result i64 = sys.close_fd(reader.fd)
    reader.fd = -1
    reader.buffer = 0
    reader.capacity = 0
    reader.used = 0
    reader.cursor = 0
    reader.active = 0
    return error_from_result(result)
}

// get_cwd 把进程当前工作目录写入调用方缓冲，成功时写入结尾 NUL。
// 返回的 count 不包含终止 NUL；缓冲不足返回 error_invalid_argument
// （原生 ERANGE），不隐式扩容，也不返回局部静态缓冲。
fn get_cwd_impl(buffer []u8) IoResult {
    if (len(buffer) == 0) {
        return io_error(error_invalid_argument, 0)
    }
    let result i64 = sys.get_cwd(slice_address_char(buffer), len(buffer))
    if (sys.is_error(result) != 0) {
        let code int = sys.error_code(result)
        return io_error(error_kind_for(code), code)
    }
    if (result <= 0) {
        return io_error(error_other, 0)
    }
    return io_ok((result - 1).to_type(u64))
}

// change_dir 修改进程全局当前工作目录，成功返回 no_error。
// 路径为 NUL 结尾字节串；该操作影响整个进程，多线程调用方需自行同步。
fn change_dir_impl(path *char) Error {
    return error_from_result(sys.change_dir(path))
}
