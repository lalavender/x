module num

// ============================================================================
// api.yh —— num 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// NumStatus 是数值转换的结果分类。
pub enum NumStatus {
    num_ok
    num_syntax
    num_range
    num_resource
}

// F64Result 是解析结果；失败时 value 为 0，不可使用。
pub struct F64Result {
    status NumStatus
    value f64
}

// parse_f64 把 JSON 形状的十进制文本（无前导 +、无下划线、无 inf/nan）
// 精确转换为 binary64。语法非法返回 num_syntax，上溢返回 num_range，
// 有效位超过 4096 返回 num_resource；下溢到 0 或次正规是正确舍入结果。
pub fn parse_f64(data *u8, count u64, out *f64) NumStatus {
    if (data == 0 || count == 0) {
        return NumStatus.num_syntax
    }
    let pos u64 = 0
    let negative int = 0
    if (data[0] == '-') {
        negative = 1
        pos = 1
    }
    if (pos >= count) {
        return NumStatus.num_syntax
    }
    let digits [4096]u8
    let digit_count int = 0
    let frac_len u64 = 0
    let exp_value i64 = 0
    let exp_negative int = 0
    let seen_dot int = 0
    let seen_digit int = 0
    let started int = 0
    let all_zero int = 1
    // 整数部分
    for pos < count {
        let b u8 = data[pos]
        if (b < '0' || b > '9') {
            break
        }
        let v int = digit_value(b)
        seen_digit = 1
        if (v != 0) {
            all_zero = 0
        }
        if (started != 0 || v != 0) {
            started = 1
            if (digit_count >= 4096) {
                return NumStatus.num_resource
            }
            digits[digit_count] = b
            digit_count += 1
        }
        pos += 1
    }
    if (seen_digit == 0) {
        return NumStatus.num_syntax
    }
    if (pos < count && data[pos] == '.') {
        seen_dot = 1
        pos += 1
        let frac_digits int = 0
        for pos < count {
            let b u8 = data[pos]
            if (b < '0' || b > '9') {
                break
            }
            let v int = digit_value(b)
            frac_digits += 1
            frac_len += 1
            if (v != 0) {
                all_zero = 0
            }
            if (started != 0 || v != 0) {
                started = 1
                if (digit_count >= 4096) {
                    return NumStatus.num_resource
                }
                digits[digit_count] = b
                digit_count += 1
            }
            pos += 1
        }
        if (frac_digits == 0) {
            return NumStatus.num_syntax
        }
    }
    if (pos < count && (data[pos] == 'e' || data[pos] == 'E')) {
        pos += 1
        if (pos < count && (data[pos] == '+' || data[pos] == '-')) {
            if (data[pos] == '-') {
                exp_negative = 1
            }
            pos += 1
        }
        let exp_digits int = 0
        for pos < count {
            let b u8 = data[pos]
            if (b < '0' || b > '9') {
                break
            }
            exp_digits += 1
            if (exp_value < 1000000) {
                exp_value = exp_value * 10 + digit_value(b).to_type(i64)
            }
            pos += 1
        }
        if (exp_digits == 0) {
            return NumStatus.num_syntax
        }
    }
    if (pos != count) {
        return NumStatus.num_syntax
    }
    if (exp_negative != 0) {
        exp_value = -exp_value
    }
    if (all_zero != 0) {
        if (negative != 0) {
            out[0] = f64_from_bits(9223372036854775808)
        } else {
            out[0] = f64_from_bits(0)
        }
        return NumStatus.num_ok
    }

    let e_value i64 = exp_value - frac_len.to_type(i64)
    let lead i64 = digit_count.to_type(i64) - 1 + e_value
    if (lead > 400) {
        return NumStatus.num_range
    }
    if (lead < -400) {
        if (negative != 0) {
            out[0] = f64_from_bits(9223372036854775808)
        } else {
            out[0] = f64_from_bits(0)
        }
        return NumStatus.num_ok
    }

    let numerator bigint
    let denominator bigint
    big_zero(&numerator)
    big_zero(&denominator)
    if (big_from_digits(&numerator, &digits[0], digit_count) != 0) {
        return NumStatus.num_resource
    }
    denominator.limbs[0] = 1
    denominator.count = 1
    if (e_value >= 0) {
        if (big_mul_pow10(&numerator, e_value.to_type(int)) != 0) {
            return NumStatus.num_resource
        }
    } else {
        if (big_mul_pow10(&denominator, (-e_value).to_type(int)) != 0) {
            return NumStatus.num_resource
        }
    }

    // e0 = bitlen(N) - bitlen(D)，最多比真实二进制指数大 1。
    let e0 i64 = big_bitlen(&numerator).to_type(i64) - big_bitlen(&denominator).to_type(i64)
    let q u64 = 0
    let rem bigint
    let divisor bigint
    let dividend bigint
    let e_bits i64 = e0
    let subnormal int = 0
    if (e0 < -1022) {
        subnormal = 1
        big_copy(&dividend, &numerator)
        big_copy(&divisor, &denominator)
        if (big_shl(&dividend, 1074) != 0) {
            return NumStatus.num_resource
        }
        if (big_divmod(&dividend, &divisor, &q, &rem) != 0) {
            return NumStatus.num_resource
        }
    } else {
        let shift i64 = 52 - e0
        big_copy(&dividend, &numerator)
        big_copy(&divisor, &denominator)
        if (shift >= 0) {
            if (big_shl(&dividend, shift.to_type(u64)) != 0) {
                return NumStatus.num_resource
            }
        } else {
            if (big_shl(&divisor, (-shift).to_type(u64)) != 0) {
                return NumStatus.num_resource
            }
        }
        if (big_divmod(&dividend, &divisor, &q, &rem) != 0) {
            return NumStatus.num_resource
        }
        if (q < 4503599627370496) {
            e_bits = e0 - 1
            big_copy(&dividend, &numerator)
            big_copy(&divisor, &denominator)
            let shift2 i64 = 52 - e_bits
            if (shift2 >= 0) {
                if (big_shl(&dividend, shift2.to_type(u64)) != 0) {
                    return NumStatus.num_resource
                }
            } else {
                if (big_shl(&divisor, (-shift2).to_type(u64)) != 0) {
                    return NumStatus.num_resource
                }
            }
            if (big_divmod(&dividend, &divisor, &q, &rem) != 0) {
                return NumStatus.num_resource
            }
        }
        if (e_bits < -1022) {
            subnormal = 1
            big_copy(&dividend, &numerator)
            big_copy(&divisor, &denominator)
            if (big_shl(&dividend, 1074) != 0) {
                return NumStatus.num_resource
            }
            if (big_divmod(&dividend, &divisor, &q, &rem) != 0) {
                return NumStatus.num_resource
            }
        }
    }

    // 就近舍入、平局取偶。
    let twice bigint
    big_copy(&twice, &rem)
    if (big_shl_one(&twice) != 0) {
        return NumStatus.num_resource
    }
    let cmp int = big_cmp(&twice, &divisor)
    if (cmp > 0 || (cmp == 0 && (q & 1) != 0)) {
        q += 1
    }

    let exponent i64 = e_bits
    let bits u64 = 0
    if (subnormal != 0) {
        if (q >= 4503599627370496) {
            bits = 4503599627370496
        } else {
            bits = q
        }
    } else {
        if (q == 9007199254740992) {
            q = 4503599627370496
            exponent += 1
        }
        if (exponent > 1023) {
            return NumStatus.num_range
        }
        if (q == 0) {
            bits = 0
        } else {
            let biased u64 = (exponent + 1023).to_type(u64)
            bits = (biased << 52) | (q - 4503599627370496)
        }
    }
    if (negative != 0) {
        bits = bits | 9223372036854775808
    }
    out[0] = f64_from_bits(bits)
    return NumStatus.num_ok
}

// format_f64 把有限 f64 写成最短往返十进制，写入调用方缓冲并返回字节数。
// NaN 与 ±Inf 在 JSON 无表示，返回 num_range；-0.0 保留符号。
pub fn format_f64(value f64, out *u8, capacity u64, out_count *u64) NumStatus {
    out_count[0] = 0
    let bits u64 = f64_bits(value)
    let negative int = 0
    if ((bits >> 63) != 0) {
        negative = 1
    }
    let exp_field u64 = (bits >> 52) & 2047
    let fraction u64 = bits & 4503599627370495
    if (exp_field == 2047) {
        return NumStatus.num_range
    }
    if (exp_field == 0 && fraction == 0) {
        if (negative != 0) {
            let n u64 = build_decimal(out, capacity, 0, 1, 0, 1)
            if (n == 0) {
                return NumStatus.num_resource
            }
            out_count[0] = n
            return NumStatus.num_ok
        }
        if (put_byte(out, capacity, &out_count[0], '0') == 0) {
            return NumStatus.num_resource
        }
        if (put_byte(out, capacity, &out_count[0], '.') == 0) {
            return NumStatus.num_resource
        }
        if (put_byte(out, capacity, &out_count[0], '0') == 0) {
            return NumStatus.num_resource
        }
        return NumStatus.num_ok
    }

    let m u64 = fraction
    let exp2 i64 = -1074
    if (exp_field != 0) {
        m = fraction | 4503599627370496
        exp2 = exp_field.to_type(i64) - 1075
    }
    // 估计十进制指数，再用精确比较修正到 floor(log10(value))。
    let scan u64 = m
    let mbits int = 0
    for scan != 0 {
        scan = scan >> 1
        mbits += 1
    }
    let l2 i64 = (mbits - 1).to_type(i64) + exp2
    let prod i64 = l2 * 30103
    let k i64 = 0
    if (prod >= 0) {
        k = prod / 100000
    } else {
        k = -((-prod + 99999) / 100000)
    }
    let guard int = 0
    for (cmp_value_pow10(m, exp2, k) < 0) && guard < 400 {
        k -= 1
        guard += 1
    }
    guard = 0
    for (cmp_value_pow10(m, exp2, k + 1) >= 0) && guard < 400 {
        k += 1
        guard += 1
    }

    let p int = 1
    for p <= 17 {
        let digits u64 = 0
        if (scaled_quotient(m, exp2, k, p, &digits) != 0) {
            return NumStatus.num_resource
        }
        let k_use i64 = k
        if (digits >= pow10_u64(p)) {
            // p 位舍入进位到 10^p：改用 p-1 位有效数字并把指数加一。
            digits = pow10_u64(p - 1)
            k_use = k + 1
        }
        let count u64 = build_decimal(out, capacity, digits, p, k_use, negative)
        if (count == 0) {
            return NumStatus.num_resource
        }
        let back f64 = 0.0
        let status NumStatus = parse_f64(out, count, &back)
        if (status != NumStatus.num_ok) {
            p += 1
            continue
        }
        if (f64_bits(back) == bits) {
            out_count[0] = count
            return NumStatus.num_ok
        }
        p += 1
    }
    return NumStatus.num_range
}
