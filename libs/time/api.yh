module time

// ============================================================================
// api.yh —— time 模块公开面（pub 函数/结构体与 @[extern] 声明）
//
// 公开声明的实现集中在本文件；私有辅助留在各自主题文件。模块内按文件名
// 字节序处理、本文件排在最前，函数可前向调用、类型在模块内统一登记，
// 因此实现细节仍可留在后续文件。
// ============================================================================

// monotonic_ns：平台无关入口；实现见 time.<平台>.yh 的 monotonic_ns_impl。
pub fn monotonic_ns() i64 {
    return monotonic_ns_impl()
}
