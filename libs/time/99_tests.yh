module time

// ============================================================================
// 99_tests.yh —— time 的语言内测试（YT4-P5）
//
// 只在 `yh test time` 中执行；生产构建不登记测试符号、不发射测试体。
// 单调时钟是宿主可观察行为：成功值必须非负，且连续读取不倒退；
// 时钟格式/时区等纯函数落地后再在这里补断言。
// ============================================================================

test "单调时钟可读且不倒退" {
    let first i64 = monotonic_ns()
    $assert(first >= 0, "monotonic_ns 应成功返回非负纳秒")
    let second i64 = monotonic_ns()
    $assert(second >= 0, "第二次读取应成功")
    $assert(second >= first, "单调时钟不倒退")
}
