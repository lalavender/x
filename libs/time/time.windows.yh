module time

import sys

// Windows 的单调时钟：走 sys.read_clock(CLOCK_MONOTONIC)。
// 与 Linux 版同一实现，差别只在 sys 的平台后端：
//   constants.windows.x64.yh 把 CLOCK_MONOTONIC 定为 1，
//   time.windows.yh 用 QueryPerformanceCounter/Frequency 换算成秒 + 纳秒，
// 因此上层（time/http 的 deadline）不需要平台分支。
// 失败、负秒或纳秒越界返回 -1；成功返回纳秒总数。
fn monotonic_ns_impl() i64 {
    let stamp sys.Timespec
    let result i64 = sys.read_clock(sys.CLOCK_MONOTONIC, &stamp)
    if (sys.is_error(result) != 0 || stamp.sec < 0 || stamp.nsec < 0
        || stamp.nsec >= 1000000000) {
        return -1
    }
    return stamp.sec * 1000000000 + stamp.nsec
}
