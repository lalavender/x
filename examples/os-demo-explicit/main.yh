module main

import yh_libs.io as io
import yh_libs.os as os

// os-demo-explicit：不设置 YH_STDLIB，通过 project.toml 的显式依赖绑定
// 标准库项目，再用 `yh_libs.os` 导入。适合构建可重复的应用。
pub fn main(argc int, argv **char, envp **char) int {
    if (argc < 1 || argv == 0 || envp == 0) {
        return 1
    }
    let path_env os.EnvResult = os.get_env(envp, "PATH")
    if (path_env.error.kind != os.error_none) {
        return 2
    }
    if (os.sleep_us(-1) != -1) {
        return 3
    }
    io.println("os demo explicit ok")
    return 0
}
