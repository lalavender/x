   Boston, MA 02111-1307, USA。  */

/* 其中包含 Cygnus Support 的贡献。  */

/* 全局变量。只有名字有意义。
   要找到地址，请查看对应的外部符号。  */
__define_stab (N_GSYM, 0x20, "GSYM")

/* BSD Fortran 的函数名。只有名字有意义。
   要找到地址，请查看对应的外部符号。  */
__define_stab (N_FNAME, 0x22, "FNAME")

/* C 的函数名或代码段变量。Value 是它的地址。
   Desc 据说是起始行号，但 GCC 不设置它，
   而 DBX 似乎并不在意。  */
__define_stab (N_FUN, 0x24, "FUN")

/* 内部链接的数据段变量。Value 是它的地址。
   “Static Sym”。  */
__define_stab (N_STSYM, 0x26, "STSYM")

/* 内部链接的 BSS 段变量。Value 是它的地址。  */
__define_stab (N_LCSYM, 0x28, "LCSYM")

/* 主例程的名字。只有名字有意义。
   这在 C 中不使用。  */
__define_stab (N_MAIN, 0x2a, "MAIN")

/* Pascal 中的全局符号。
   据说 value 是它的行号；我对此表示怀疑。  */
__define_stab (N_PC, 0x30, "PC")

/* 符号数量：按 Ultrix V4.0 是 0, files,,funcs,lines。 */
__define_stab (N_NSYMS, 0x32, "NSYMS")

/* 按 Ultrix V4.0 是 "No DST map for sym: name, ,0,type,ignored"。 */
__define_stab (N_NOMAP, 0x34, "NOMAP")

/* 来自 Solaris 的新 stab。我不知道它是什么意思，但它
   似乎不包含有用的信息。  */
__define_stab (N_OBJ, 0x38, "OBJ")

/* 来自 Solaris 的新 stab。我不知道它是什么意思，但它
   似乎不包含有用的信息。可能与本模块中使用的
   优化选项有关。  */
__define_stab (N_OPT, 0x3c, "OPT")

/* 寄存器变量。Value 是寄存器编号。  */
__define_stab (N_RSYM, 0x40, "RSYM")

/* Modula-2 编译单元。有人能说出它包含什么信息吗？  */
__define_stab (N_M2C, 0x42, "M2C")

/* 代码段中的行号。Desc 是行号；
   value 是相应的地址。  */
__define_stab (N_SLINE, 0x44, "SLINE")

/* 类似，用于数据段。  */
__define_stab (N_DSLINE, 0x46, "DSLINE")

/* 类似，用于 bss 段。  */
__define_stab (N_BSLINE, 0x48, "BSLINE")

/* Sun 的源代码浏览器 stabs。?? 不知道这些字段是什么。
   据说该字段是“关联 .cb 文件的路径”。此值
   与 N_BSLINE 重叠！  */
__define_stab (N_BROWS, 0x48, "BROWS")

/* GNU Modula-2 定义模块依赖。Value 是定义文件的
   修改时间。如果用 GNU M2 关键字 %INITIALIZE 导入，则 Other 非零。
   如果有足够的空字段，
   也许可以用 N_M2C？ */
__define_stab(N_DEFD, 0x4a, "DEFD")

/* 下面两个 STAB 值冲突。幸好一个用于 Modula-2，
   一个用于 C++。不过…… */
/* GNU C++ 异常变量。Name 是变量名。  */
__define_stab (N_EHDECL, 0x50, "EHDECL")
/* Modula2 的 "for imc" 信息：按 Ultrix V4.0 是 name,,0,0,0。  */
__define_stab (N_MOD2, 0x50, "MOD2")

/* GNU C++ 的 `catch' 子句。Value 是它的地址。如果本条
   紧跟着一个说明捕获了什么异常的 CAUGHT stab，则 Desc 非零。
   多个 CAUGHT stabs 意味着这里可以捕获多个
   异常。如果 Desc 为 0，表示这里捕获所有
   异常。  */
__define_stab (N_CATCH, 0x54, "CATCH")

/* 结构体或联合体成员。Value 是结构体中的偏移。  */
__define_stab (N_SSYM, 0x60, "SSYM")

/* 主源文件的名字。
   Value 是本次编译的起始代码地址。  */
__define_stab (N_SO, 0x64, "SO")

/* 栈中的自动变量。Value 是相对帧指针的偏移。
   也用于类型描述。  */
__define_stab (N_LSYM, 0x80, "LSYM")

/* include 文件的开始。只有 Sun 使用它。
   在目标文件中，只有名字有意义。
   Sun 链接器会把数据放进其他某些字段。  */
__define_stab (N_BINCL, 0x82, "BINCL")

/* 子源文件（#include 文件）的名字。
   Value 是本次编译的起始代码地址。  */
__define_stab (N_SOL, 0x84, "SOL")

/* 参数变量。Value 是相对参数指针的偏移。
   （在大多数机器上参数指针与帧指针相同。  */
__define_stab (N_PSYM, 0xa0, "PSYM")

/* include 文件的结束。没有名字。
   它和 N_BINCL 一起构成文件输出的括号。
   在目标文件中，本条没有有意义的数据。
   Sun 链接器会把数据放进某些字段。  */
__define_stab (N_EINCL, 0xa2, "EINCL")

/* 备用入口点。Value 是它的地址。  */
__define_stab (N_ENTRY, 0xa4, "ENTRY")

/* 词法块的开始。
   desc 是词法块中的嵌套层级。
   value 是该块代码起点的地址。
   块内声明的变量 *位于* N_LBRAC 符号之前。  */
__define_stab (N_LBRAC, 0xc0, "LBRAC")

/* 已删除 include 文件的占位符。替换一个 N_BINCL 直到
   对应 N_EINCL 之间的所有内容。Sun 链接器在发现来自某个 include
   文件的符号有多份完全相同的副本时会生成这些。
   它只出现在 Sun 链接器的输出中。  */
__define_stab (N_EXCL, 0xc2, "EXCL")

/* Modula-2 作用域信息。有人能说出它包含什么信息吗？  */
__define_stab (N_SCOPE, 0xc4, "SCOPE")

/* 词法块的结束。Desc 与 N_LBRAC 的 desc 匹配。
   value 是该块代码终点的地址。  */
__define_stab (N_RBRAC, 0xe0, "RBRAC")

/* 命名 common 块的开始。只有名字有意义。  */
__define_stab (N_BCOMM, 0xe2, "BCOMM")

/* 命名 common 块的结束。只有名字有意义
   （并且它应当与 N_BCOMM 匹配）。  */
__define_stab (N_ECOMM, 0xe4, "ECOMM")

/* common 的结束（局部名字）：value 是地址。
   我不确定它如何使用。  */
__define_stab (N_ECOML, 0xe8, "ECOML")

/* 这些 STAB 在 Gould 系统上用于非基址寄存器符号
   或类似的东西。FIXME。因为手头没有 Gould，
   我随机分配了这些值。欢迎 Gould 的人来修正…… */
__define_stab (N_NBTEXT, 0xF0, "NBTEXT")
__define_stab (N_NBDATA, 0xF2, "NBDATA")
__define_stab (N_NBBSS,  0xF4, "NBBSS")
__define_stab (N_NBSTS,  0xF6, "NBSTS")
__define_stab (N_NBLCS,  0xF8, "NBLCS")

/* 第二个符号条目，为前一条目携带长度值。
   value 就是长度。  */
__define_stab (N_LENG, 0xfe, "LENG")

/* 上面的信息，以矩阵形式给出。

			STAB 矩阵
	_________________________________________________
	| 00 - 1F 不是 dbx stab 符号			|
	| 多数情况下最低位是 EXTernal 位	|

	| 00 UNDEF  | 02 ABS	| 04 TEXT   | 06 DATA	|
	| 01  |EXT  | 03  |EXT	| 05  |EXT  | 07  |EXT	|

	| 08 BSS    | 0A INDR	| 0C FN_SEQ | 0E   	|
	| 09  |EXT  | 0B 	| 0D	    | 0F	|

	| 10 	    | 12 COMM	| 14 SETA   | 16 SETT	|
	| 11	    | 13	| 15 	    | 17	|

	| 18 SETD   | 1A SETB	| 1C SETV   | 1E WARNING|
	| 19	    | 1B	| 1D 	    | 1F FN	|

	|_______________________________________________|
	| 第 01 位置位的调试条目未被使用。		|
	| 20 GSYM   | 22 FNAME	| 24 FUN    | 26 STSYM	|
	| 28 LCSYM  | 2A MAIN	| 2C	    | 2E	|
	| 30 PC	    | 32 NSYMS	| 34 NOMAP  | 36	|
	| 38 OBJ    | 3A	| 3C OPT    | 3E	|
	| 40 RSYM   | 42 M2C	| 44 SLINE  | 46 DSLINE |
	| 48 BSLINE*| 4A DEFD	| 4C        | 4E	|
	| 50 EHDECL*| 52	| 54 CATCH  | 56        |
	| 58        | 5A        | 5C        | 5E	|
	| 60 SSYM   | 62	| 64 SO	    | 66 	|
	| 68 	    | 6A	| 6C	    | 6E	|
	| 70	    | 72	| 74	    | 76	|
	| 78	    | 7A	| 7C	    | 7E	|
	| 80 LSYM   | 82 BINCL	| 84 SOL    | 86	|
	| 88	    | 8A	| 8C	    | 8E	|
	| 90	    | 92	| 94	    | 96	|
	| 98	    | 9A	| 9C	    | 9E	|
	| A0 PSYM   | A2 EINCL	| A4 ENTRY  | A6	|
	| A8	    | AA	| AC	    | AE	|
	| B0	    | B2	| B4	    | B6	|
	| B8	    | BA	| BC	    | BE	|
	| C0 LBRAC  | C2 EXCL	| C4 SCOPE  | C6	|
	| C8	    | CA	| CC	    | CE	|
	| D0	    | D2	| D4	    | D6	|
	| D8	    | DA	| DC	    | DE	|
	| E0 RBRAC  | E2 BCOMM	| E4 ECOMM  | E6	|
	| E8 ECOML  | EA	| EC	    | EE	|
	| F0	    | F2	| F4	    | F6	|
	| F8	    | FA	| FC	    | FE LENG	|
	+-----------------------------------------------+
 * 50 EHDECL 也是 MOD2。
 * 48 BSLINE 也是 BROWS。
 */
