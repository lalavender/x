; 由 yh 生成（W1-4）的 Windows 导入库源码：KERNEL32.dll 最小导出面。
;
; 为什么只有这几条：yh 在 Windows 目标上走零 CRT 路线（方案 §3 D2），
; 运行时只经 kernel32 触达系统，不依赖 msvcrt/ucrt 或任何第三方 DLL。
; 每加一条导出，必须在 compiler/backend/llvm_windows_runtime.yh（W1-3）里
; 有真实消费者，并在 manifest.json 的 exports 里同步登记、重算 def_sha256。
;
; 生成：python3 tools/windows-sdk.py generate
; 校验：python3 tests/selfhost/llvm-windows-sdk.py
;
; 逐条用途（与 W1-3 的运行时映射一一对应）：
;   GetStdHandle    —— printf/write 取标准输出/错误句柄（-11/-12）
;   WriteFile       —— printf/write 的唯一输出原语（字节流，不做 CRLF 翻译）
;   ReadFile        —— read(0, ...) 的标准输入（含管道注入的二进制，W1-3b）
;   CreateFileA / SetFilePointer / MoveFileExA / CreateDirectoryA / DeleteFileA
;                   —— W1-3d 的 open/append/rename/mkdir/unlink（ANSI 路径）
;   ExitProcess     —— exit(code) 与测试断言失败退出
;   GetProcessHeap  —— malloc/free 的堆句柄
;   HeapAlloc       —— malloc（头部 16 字节记录原始尺寸）
;   HeapFree        —— free
;   GetLastError    —— 堆/文件失败诊断
;   CloseHandle     —— 文件句柄释放（W1-3b 文件 API）
;   GetCommandLineA —— 若后续实现 argc/argv（Win64 入口不传参数）
;   GetEnvironmentVariableA —— yh test 的断言记录路径（YH_TEST_RECORD，fd 3）
;   Sleep           —— usleep 的毫秒轮转（运行时 usleep 实现）
;   GetCurrentProcessId —— getpid 的 Windows 实现（模块/会话后缀）
;   GetCommandLineW / WideCharToMultiByte —— VENC（2026-11-05）入口桩取宽
;           命令行并转 UTF-8（argv 从源头就是 UTF-8，见入口桩注释）
;
; —— W2-7（libs/sys 与 libs/os 的 Windows 变体）新增 ——
;   GetCurrentDirectoryA / SetCurrentDirectoryA —— sys.get_cwd / sys.change_dir
;   RemoveDirectoryA —— sys.remove_at(AT_REMOVEDIR) 与 rmdir 垫片
;   FindFirstFileA / FindNextFileA / FindClose —— os.open_dir 的目录枚举
;   VirtualAlloc / VirtualFree —— sys.map_memory / sys.unmap_memory
;   GetSystemTimeAsFileTime / QueryPerformanceCounter / QueryPerformanceFrequency
;                   —— sys.read_clock（CLOCK_REALTIME / CLOCK_MONOTONIC）
;   GetFileType     —— isatty 垫片（os.is_terminal）
;   CreateProcessA / OpenProcess / WaitForSingleObject / GetExitCodeProcess
;                   —— os.spawn / os.wait（Windows 没有 fork/exec/waitpid）
LIBRARY KERNEL32.dll
EXPORTS
    GetStdHandle
    WriteFile
    ReadFile
    ExitProcess
    GetProcessHeap
    HeapAlloc
    HeapFree
    GetLastError
    CloseHandle
    GetCommandLineA
    GetEnvironmentVariableA
    GetEnvironmentStringsA
    FreeEnvironmentStringsA
    CreateFileA
    SetFilePointer
    MoveFileExA
    CreateDirectoryA
    DeleteFileA
    Sleep
    GetCurrentProcessId
    GetCurrentDirectoryA
    SetCurrentDirectoryA
    RemoveDirectoryA
    FindFirstFileA
    FindNextFileA
    FindClose
    VirtualAlloc
    VirtualFree
    GetSystemTimeAsFileTime
    QueryPerformanceCounter
    QueryPerformanceFrequency
    GetFileType
    CreateProcessA
    OpenProcess
    WaitForSingleObject
    GetExitCodeProcess

GetCommandLineW
WideCharToMultiByte
