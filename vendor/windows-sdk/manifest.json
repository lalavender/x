{
  "name": "yh-windows-sdk",
  "version": 1,
  "abi": "x86_64-pc-windows-msvc",
  "machine": 34404,
  "note": "仓库只保存文本 .def 与清单；.lib 是按需生成的 COFF 导入库（不入库，见 .gitignore 的 *.lib）。改动 def 必须同步 exports 与 def_sha256，否则 tests/selfhost/llvm-windows-sdk.py 会失败。",
  "libraries": [
    {
      "dll": "KERNEL32.dll",
      "def": "def/kernel32.def",
      "import_library": "kernel32.lib",
      "def_sha256": "4490d2539f1b61c8aac160308388c4d4814cd5f0fd769fb45488ff849946cca3",
      "exports": [
        "GetStdHandle",
        "WriteFile",
        "ReadFile",
        "ExitProcess",
        "GetProcessHeap",
        "HeapAlloc",
        "HeapFree",
        "GetLastError",
        "CloseHandle",
        "GetCommandLineA",
        "GetEnvironmentVariableA",
        "GetEnvironmentStringsA",
        "FreeEnvironmentStringsA",
        "CreateFileA",
        "SetFilePointer",
        "MoveFileExA",
        "CreateDirectoryA",
        "DeleteFileA",
        "Sleep",
        "GetCurrentProcessId",
        "GetCurrentDirectoryA",
        "SetCurrentDirectoryA",
        "RemoveDirectoryA",
        "FindFirstFileA",
        "FindNextFileA",
        "FindClose",
        "VirtualAlloc",
        "VirtualFree",
        "GetSystemTimeAsFileTime",
        "QueryPerformanceCounter",
        "QueryPerformanceFrequency",
        "GetFileType",
        "CreateProcessA",
        "OpenProcess",
        "WaitForSingleObject",
        "GetExitCodeProcess",
        "GetCommandLineW",
        "WideCharToMultiByte",
        "SetConsoleOutputCP",
        "SetConsoleCP"
      ]
    }
  ],
  "objects": [
    {
      "source": "chkstk.c",
      "output": "yh_chkstk.obj",
      "purpose": "MSVC ABI 的栈探测桩（导出 __yh_chkstk，经 /alternatename 作为零 CRT 的 __chkstk）：让 >4KB 栈帧按页触碰 guard page"
    }
  ]
}
