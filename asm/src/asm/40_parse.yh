module asm;

// ============================================================================
// asm/parse.yh —— 语句层：标签、伪指令、待回填记录
//
// 一次汇编只做一遍解析：指令立即数里凡是依赖符号最终地址的位段，都写成
// 占位值并登记一条 Fixup，由 assemble.yh 在节布局确定后回填或转成重定位。
// 这样符号可以先引用后定义，且不需要二次扫描源文本。
//
// 契约（设计 §4/§8）：
//   * 伪指令白名单：.text .data .bss .section(.rodata) .globl .global .local
//     .balign .p2align .byte .hword .word .xword .quad .zero .skip .type .size
//   * .balign N 的 N 是字节数，.p2align N 的 N 是指数——两者不可互换；
//   * 符号与节的登记顺序完全按源码顺序，保证同一输入产出同一对象。
// ============================================================================

import obj;

// —— 表达式 ——
//
// 立即数位置允许出现的形态只有这五种。所有形态都在这里判定完，编码层只
// 面对数值；符号相关的形态各自对应一条 Fixup。

pub const EX_NUM int = 0;      // 纯数字
pub const EX_SYM int = 1;      // 裸符号（分支目标 / .xword）
pub const EX_PAGE int = 2;     // sym@PAGE
pub const EX_PAGEOFF int = 3;  // sym@PAGEOFF
pub const EX_LO12 int = 4;     // :lo12:sym
pub const EX_GOTPAGE int = 5;  // sym@GOTPAGE
pub const EX_GOTPAGEOFF int = 6;// sym@GOTPAGEOFF

// Expr：一个立即数表达式的结果。
pub struct Expr {
    kind int;
    val i64;    // EX_NUM 时的数值
    sym int;    // 符号在上下文中的下标
    neg int;    // 1 = 前面有负号
}

// —— 待回填记录 ——
//
// 每条 Fixup 描述「节内某个 4 字节字里的某段位域，等符号地址确定后再写」。
// kind 同时决定回填算法与转成重定位时的 R_AARCH64_* 类型。

pub const FIX_BR26 int = 1;        // b/bl 的 imm26
pub const FIX_CONDBR19 int = 2;    // b.cond / cbz / cbnz 的 imm19
pub const FIX_ADR_PG_HI21 int = 3; // adrp 的 immlo:immhi
pub const FIX_ADD_LO12 int = 4;    // add/sub 立即数的 imm12
pub const FIX_LDST_LO12 int = 5;   // 访存无符号立即数的 imm12
pub const FIX_ABS64 int = 6;       // .xword / .quad 的 8 字节
pub const FIX_TSTBR14 int = 7;     // cbz/cbnz 的 imm19
pub const FIX_GOT_PG_HI21 int = 8; // adrp x, sym@GOTPAGE 的 immlo:immhi
pub const FIX_GOT_LO12 int = 9;    // ldr x, [x, sym@GOTPAGEOFF] 的 imm12

pub struct Fixup {
    sec int;      // 所在节
    off int;      // 节内字节偏移
    kind int;
    sym int;      // 目标符号下标
    addend i64;   // 附加常数
}

// —— 移位 / 扩展操作数 ——

pub const SHF_NONE int = -1;
pub const SHF_EXT int = 8;   // kind  >= 8 表示扩展：ext = kind - 8
pub const SHF_AMT int = 63;  // 位移量的最大合法值上界（按位宽再收紧）

// Shift：寄存器操作数后面的修饰。
pub struct Shift {
    kind int;    // SHF_NONE / SH_* / SHF_EXT + EXT_*
    amount i64;
}

// —— 寻址操作数 ——

// MemOp：`[基址, 位移/索引]` 的全部信息。
pub struct MemOp {
    base int;
    base_k int;
    disp i64;
    exkind int;    // EX_*，非 EX_NUM 时位移是符号
    sym int;
    index int;     // 索引寄存器号；-1 表示没有
    index_k int;
    ext int;       // 索引扩展方式 EXT_*
    shift i64;     // 索引左移量
    wb int;        // 0 无写回 / 1 后索引 / 2 前索引
}

// —— 解析器状态 ——

pub struct Parser {
    src *u8;         // 源字节（借自调用方）
    lx *Lexer;       // 扫描结果
    ctx *obj.Ctx;        // 输出上下文
    i int;           // 当前 token 下标
    sec int;         // 当前节下标
    nerr int;        // 错误条数
    fix *Fixup;      // 待回填数组
    nfix int;
    capfix int;
    name [512]u8;    // 取名字用的暂存（借出后立即用掉，不跨解析保留）
    mn_off int;      // 当前指令助记符在源里的范围，分派子程序比对用
    mn_end int;
}

// —— token 读取 ——

// p_kind：第 i 个 token 的种类。
fn p_kind(p *Parser, i int) int {
    if (i >= p.lx.n) {
        return TK_END;
    }
    return p.lx.toks[i].kind;
}

// p_tok：第 i 个 token。
fn p_tok(p *Parser, i int) *Tok {
    if (i >= p.lx.n) {
        return &p.lx.toks[p.lx.n - 1];
    }
    return &p.lx.toks[i];
}

// p_peek：当前 token 种类。
fn p_peek(p *Parser) int {
    return p_kind(p, p.i);
}

// p_adv：吃掉当前 token 并前进。
fn p_adv(p *Parser) int {
    p.i += 1;
    return 0;
}

// p_line/p_col：当前 token 的位置，用于诊断。
fn p_line(p *Parser) int {
    return p_tok(p, p.i).line;
}

fn p_col(p *Parser) int {
    return p_tok(p, p.i).col;
}

// p_err：按当前 token 位置报错，返回 -1。
fn p_err(p *Parser, msg *char) int {
    p.ctx.line = p_line(p);
    p.ctx.col = p_col(p);
    p.nerr += 1;
    obj.diag(p.ctx, msg);
    return -1;
}

// p_err_at：按指定 token 位置报错。
fn p_err_at(p *Parser, t *Tok, msg *char) int {
    p.ctx.line = t.line;
    p.ctx.col = t.col;
    p.nerr += 1;
    obj.diag(p.ctx, msg);
    return -1;
}

// p_txt_off：当前 token 的源文本起始偏移。
fn p_txt_off(p *Parser) int {
    return p_tok(p, p.i).start;
}

// p_txt_len：当前 token 的源文本长度。
fn p_txt_len(p *Parser) int {
    let t *Tok = p_tok(p, p.i);
    return t.end - t.start;
}

// p_is_mn：当前 token 是否是指定小写单词（助记符/指令名比较）。
fn p_is_mn(p *Parser, s *char) int {
    return obj.tok_eq(p.src, p_txt_off(p), p_tok(p, p.i).end, s);
}

// p_mn_is：当前语句的助记符是否等于 s。
// 助记符在进入分派前已被吃掉，所以单独记住它的源范围。
fn p_mn_is(p *Parser, s *char) int {
    return obj.tok_eq(p.src, p.mn_off, p.mn_end, s);
}

// p_is_dir：当前 token 是否是指定伪指令名（含前导点）。
fn p_is_dir(p *Parser, s *char) int {
    if (p_peek(p) != TK_DIR) {
        return 0;
    }
    return obj.tok_eq(p.src, p_txt_off(p), p_tok(p, p.i).end, s);
}

// p_take_name：把当前 token 的文本复制进暂存并以 C 字符串返回。
// 暂存只有一份，调用方必须在解析下一个 token 前用掉返回值。
fn p_take_name(p *Parser) *char {
    let t *Tok = p_tok(p, p.i);
    let n int = t.end - t.start;
    if (n > 500) {
        n = 500;
    }
    let k int = 0;
    for k < n {
        p.name[k] = p.src[t.start + k];
        k += 1;
    }
    p.name[n] = 0;
    p.i += 1;
    return (&p.name[0]).to_type(*char);
}

// p_sym_of：把当前 token（标识符或 . 开头的局部名）登记成符号并返回下标。
fn p_sym_of(p *Parser) int {
    let nm *char = p_take_name(p);
    return p_sym_named(p, nm);
}

// p_sym_named：按名字取或登记符号。
// 引用时还不知道这个名字会不会被 .globl 提升，所以先用 SYM_UNDEF 占位；
// p_label 定义它时再定成局部（除非之前已经 .globl）。未定义的引用最终按
// 全局输出——ELF 不允许未定义的局部符号。
//
// 登记时把**名字所在 token** 的行列写进符号记录：Ctx.line/col 只在报错时才
// 更新，不写这一笔的话未定义局部符号的诊断会打在第 0 行（实测过）。
fn p_sym_named(p *Parser, nm *char) int {
    let hit int = obj.ctx_find_sym(p.ctx, nm);
    if (hit >= 0) {
        return hit;
    }
    let id int = obj.ctx_add_sym(p.ctx, nm, obj.SYM_UNDEF, obj.SYM_NOTYPE);
    if (id >= 0 && p.i > 0) {
        // p_take_name 已经把 p.i 推到了下一个 token，名字在 p.i - 1。
        let t *Tok = p_tok(p, p.i - 1);
        p.ctx.syms[id].line = t.line;
        p.ctx.syms[id].col = t.col;
    }
    return id;
}

// p_comma：要求一个逗号。
fn p_comma(p *Parser) int {
    if (p_peek(p) != TK_COMMA) {
        return p_err(p, "此处需要一个逗号");
    }
    p_adv(p);
    return 0;
}

// —— 寄存器 ——
//
// 寄存器编号与类别一起返回：x31 是 sp 还是 xzr 取决于出现位置，编码层
// 需要这个区别。

pub struct Reg {
    num int;   // 0..31
    k int;     // RK_*
}

// p_reg：解析一个寄存器操作数。
fn p_reg(p *Parser, r *Reg) int {
    if (p_peek(p) != TK_REG) {
        return p_err(p, "此处需要一个寄存器");
    }
    let t *Tok = p_tok(p, p.i);
    r.num = t.num.to_type(i64).to_type(int);
    r.k = t.rkind;
    p_adv(p);
    return 0;
}

// reg_is64：寄存器是否按 64 位解释（X/SP/XZR）。
fn reg_is64(r *Reg) int {
    if (r.k == RK_X || r.k == RK_SP || r.k == RK_XZR) {
        return 1;
    }
    return 0;
}

// reg_field：寄存器在指令里的 5 位编号。XZR/WZR 与 SP 都是 31。
fn reg_field(r *Reg) int {
    return r.num;
}

// —— 立即数表达式 ——

// p_expr：解析一个立即数表达式。允许 # 前缀，允许前导负号。
fn p_expr(p *Parser, e *Expr) int {
    e.neg = 0;
    e.sym = 0;
    e.val = 0;
    if (p_peek(p) == TK_HASH) {
        p_adv(p);
    }
    if (p_peek(p) == TK_MINUS) {
        e.neg = 1;
        p_adv(p);
    } else if (p_peek(p) == TK_PLUS) {
        p_adv(p);
    }
    if (p_peek(p) == TK_MODIFIER) {
        // :lo12:sym
        let t *Tok = p_tok(p, p.i);
        if (t.num.to_type(i64).to_type(int) != MOD_LO12) {
            return p_err(p, "不支持的符号修饰符");
        }
        p_adv(p);
        if (p_peek(p) != TK_IDENT && p_peek(p) != TK_DIR) {
            return p_err(p, ":lo12: 后面需要一个符号");
        }
        e.kind = EX_LO12;
        e.sym = p_sym_of(p);
        return 0;
    }
    if (p_peek(p) == TK_NUM) {
        e.kind = EX_NUM;
        e.val = p_tok(p, p.i).num;
        p_adv(p);
        return 0;
    }
    if (p_peek(p) == TK_IDENT || p_peek(p) == TK_DIR) {
        let id int = 0;
        if (p_peek(p) == TK_IDENT) {
            id = p_sym_of(p);
        } else {
            // .L1@PAGE 里的 .L1 是 TK_DIR，作为符号使用时和 IDENT 等价
            let nm *char = p_take_name(p);
            id = p_sym_named(p, nm);
        }
        if (p_peek(p) == TK_AT) {
            p_adv(p);
            if (p_peek(p) != TK_IDENT) {
                return p_err(p, "@ 后面需要 PAGE 或 PAGEOFF");
            }
            if (p_is_mn(p, "PAGE") != 0) {
                e.kind = EX_PAGE;
            } else if (p_is_mn(p, "PAGEOFF") != 0) {
                e.kind = EX_PAGEOFF;
            } else if (p_is_mn(p, "GOTPAGE") != 0) {
                e.kind = EX_GOTPAGE;
            } else if (p_is_mn(p, "GOTPAGEOFF") != 0) {
                e.kind = EX_GOTPAGEOFF;
            } else {
                return p_err(p, "只支持 @PAGE/@PAGEOFF/@GOTPAGE/@GOTPAGEOFF");
            }
            p_adv(p);
        } else {
            e.kind = EX_SYM;
        }
        e.sym = id;
        return 0;
    }
    return p_err(p, "此处需要一个立即数或符号");
}

// p_expr_num：解析并要求表达式是纯数字。
fn p_expr_num(p *Parser, out *i64) int {
    let e Expr;
    if (p_expr(p, &e) != 0) {
        return -1;
    }
    if (e.kind != EX_NUM) {
        return p_err(p, "此处需要一个纯数字（不支持符号重定位）");
    }
    if (e.neg != 0) {
        out[0] = -e.val;
    } else {
        out[0] = e.val;
    }
    return 0;
}

// —— 节与输出 ——

// sec_text/sec_data/sec_bss：按名字取节，不存在则建立。
// 首版固定三个节，对齐与类型在此一次性确定（设计 §7）。
pub fn sec_text(c *obj.Ctx) int {
    let i int = obj.ctx_find_sec(c, ".text");
    if (i >= 0) {
        return i;
    }
    return obj.ctx_add_sec(c, ".text", 1, 0x6, 4);
}

pub fn sec_data(c *obj.Ctx) int {
    let i int = obj.ctx_find_sec(c, ".data");
    if (i >= 0) {
        return i;
    }
    return obj.ctx_add_sec(c, ".data", 1, 0x3, 8);
}

pub fn sec_bss(c *obj.Ctx) int {
    let i int = obj.ctx_find_sec(c, ".bss");
    if (i >= 0) {
        return i;
    }
    return obj.ctx_add_sec(c, ".bss", 8, 0x3, 8);
}

pub fn sec_rodata(c *obj.Ctx) int {
    let i int = obj.ctx_find_sec(c, ".rodata");
    if (i >= 0) {
        return i;
    }
    return obj.ctx_add_sec(c, ".rodata", 1, 0x2, 8);
}

// p_here：当前节内的写入位置（.bss 用内存尺寸）。
fn p_here(p *Parser) int {
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        return p.ctx.secs[p.sec].memsz;
    }
    return p.ctx.secs[p.sec].data.len;
}

// p_push_fix：登记一条待回填记录。
fn p_push_fix(p *Parser, kind int, off int, sym int, addend i64) int {
    if (p.nfix + 1 > p.capfix) {
        let ncap int = p.capfix * 2;
        if (ncap < 16) { ncap = 16; }
        let q *Fixup = malloc((ncap * sizeof(Fixup)).to_type(u64)).to_type(*Fixup);
        if (q == 0) {
            return p_err(p, "内存不足");
        }
        if (p.nfix > 0) {
            memcpy(q, p.fix, (p.nfix * sizeof(Fixup)).to_type(u64));
        }
        if (p.fix != 0) { free(p.fix); }
        p.fix = q;
        p.capfix = ncap;
    }
    p.fix[p.nfix].sec = p.sec;
    p.fix[p.nfix].off = off;
    p.fix[p.nfix].kind = kind;
    p.fix[p.nfix].sym = sym;
    p.fix[p.nfix].addend = addend;
    p.nfix += 1;
    return 0;
}

// p_emit32：向当前节写入一个小端 32 位字，返回写入偏移（失败返回 -1）。
fn p_emit32(p *Parser, w i64) int {
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        return p_err(p, "不能在 .bss 里放指令");
    }
    return obj.sec_push_u32(p.ctx, p.sec, w.to_type(u64).to_type(u32));
}

// p_emit8：向当前节写入一个字节。
fn p_emit8(p *Parser, v i64) int {
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        return obj.sec_grow_memsz(p.ctx, p.sec, 1);
    }
    return obj.sec_push(p.ctx, p.sec, v.to_type(u64).to_type(u8));
}

// p_align：对齐当前节。fill 是填充字节。
fn p_align(p *Parser, n int, fill u8) int {
    if (n <= 1) {
        return 0;
    }
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        let here int = p.ctx.secs[p.sec].memsz;
        let want int = obj.align_up(here, n);
        if (want < 0) { return -1; }
        if (obj.sec_grow_memsz(p.ctx, p.sec, want - here) < 0) { return -1; }
        return 0;
    }
    if ((p.ctx.secs[p.sec].sh_flags & 4) != 0 && (n % 4) == 0) {
        // 代码节的对齐填充必须是 NOP（0xd503201f），填 0 会执行出随机指令
        let here int = p.ctx.secs[p.sec].data.len;
        let want int = obj.align_up(here, n);
        if (want < 0) { return -1; }
        let k int = (want - here) / 4;
        let j int = 0;
        for j < k {
            if (obj.sec_push_u32(p.ctx, p.sec, 0xd503201f) < 0) { return -1; }
            j += 1;
        }
        return 0;
    }
    if (obj.sec_pad_to(p.ctx, p.sec, n, fill) < 0) { return -1; }
    return 0;
}

// —— 标签 ——

// p_label：在当前位置定义符号。局部名（. 开头）绑定为 obj.SYM_LOCAL。
fn p_label(p *Parser, nm *char) int {
    let id int = obj.ctx_find_sym(p.ctx, nm);
    if (id < 0) {
        // 没有 .globl 的标签一律是局部符号，和 GNU as 一致
        id = obj.ctx_add_sym(p.ctx, nm, obj.SYM_LOCAL, obj.SYM_NOTYPE);
        if (id < 0) {
            return p_err(p, "符号过多");
        }
    } else if (p.ctx.syms[id].binding == obj.SYM_UNDEF) {
        p.ctx.syms[id].binding = obj.SYM_LOCAL;
    }
    if (obj.sym_is_defined(&p.ctx.syms[id]) != 0) {
        return p_err(p, "符号重复定义");
    }
    p.ctx.syms[id].shndx = p.sec;
    p.ctx.syms[id].value = p_here(p);
    return 0;
}

// p_mark_func：把符号标成函数（.type name, %function）。
fn p_set_type(p *Parser, nm *char, ty int) int {
    let id int = obj.ctx_find_sym(p.ctx, nm);
    if (id < 0) {
        id = obj.ctx_add_sym(p.ctx, nm, obj.SYM_GLOBAL, ty);
        if (id < 0) { return p_err(p, "符号过多"); }
        return 0;
    }
    p.ctx.syms[id].symtype = ty;
    return 0;
}

// p_set_size：设置符号尺寸（.size name, expr）。
fn p_set_size(p *Parser, nm *char, v i64) int {
    let id int = obj.ctx_find_sym(p.ctx, nm);
    if (id < 0) {
        id = obj.ctx_add_sym(p.ctx, nm, obj.SYM_GLOBAL, obj.SYM_NOTYPE);
        if (id < 0) { return p_err(p, "符号过多"); }
    }
    p.ctx.syms[id].size = v.to_type(int);
    return 0;
}

// p_check_undefined_locals：`.` 开头的符号按契约（§7）一律是**局部**符号，
// 而 ELF 与 Mach-O 都不允许「未定义的局部符号」——写出器只能把它降级成
// 外部引用，链接器就会去别的对象里找同名符号，语义完全变了（clang 对
// `b .Lmissing` 直接报 "Undefined temporary symbol"）。解析结束后统一检查
// 一次，两个目标的写出路径都受这条保护。
fn p_check_undefined_locals(c *obj.Ctx) int {
    let i int = 1;              // 下标 0 是必有的空占位符号
    for i < c.nsym {
        let s obj.Symbol = c.syms[i];
        if (obj.sym_is_defined(&s) == 0) {
            let nm *char = obj.sym_name(c, i);
            if (nm[0] == '.') {
                // 符号记录里存了首次出现的行列（见 p_sym_of），诊断按它定位。
                c.line = s.line;
                c.col = s.col;
                if (c.col <= 0) {
                    c.col = 1;
                }
                return obj.diag(c,
                    "局部标签未定义：. 开头的符号必须是本文件定义的局部符号");
            }
        }
        i += 1;
    }
    return 0;
}

// —— 入口 ——

// asm_parse：扫描并解析整个源文件，把节、符号、重定位与待回填记录写入 c。
// 成功返回 0；解析出错返回 -1（诊断已由 obj.diag 打印）。
//
// 解析只做一遍：符号先引用后定义没问题，因为依赖符号地址的位段一律登记
// Fixup，由 assemble 在布局确定后处理。
pub fn asm_parse(c *obj.Ctx, src *u8, nbytes int) int {
    let lx *Lexer = malloc(sizeof(Lexer).to_type(u64)).to_type(*Lexer);
    if (lx == 0) {
        return obj.diag_plain(c, "内存不足");
    }
    if (lex_init(lx, src, nbytes) != 0) {
        free(lx);
        return obj.diag_plain(c, "扫描器初始化失败");
    }
    // 词法错误由 Lexer.err 表达（扫描会继续以便报出更多问题），这里按记录
    // 的位置报一次——此前只看 lex_run 的返回值，未闭合注释之类会退化成
    // 「无法识别的语句开头」，位置还可能算成负数列号。
    if (lex_run(lx) != 0) {
        free(lx);
        return obj.diag_plain(c, "扫描器内存不足");
    }
    if (lx.err != 0) {
        c.line = lx.eline;
        c.col = lx.ecol;
        let msg *char = lx.emsg;
        free(lx);
        return obj.diag(c, msg);
    }
    let p *Parser = malloc(sizeof(Parser).to_type(u64)).to_type(*Parser);
    if (p == 0) {
        lex_free(lx);
        free(lx);
        return obj.diag_plain(c, "内存不足");
    }
    p.src = src;
    p.lx = lx;
    p.ctx = c;
    p.i = 0;
    p.sec = 0;
    p.nerr = 0;
    p.fix = 0;
    p.nfix = 0;
    p.capfix = 0;
    p.mn_off = 0;
    p.mn_end = 0;
    let rc int = 0;
    if (sec_text(c) < 0) {
        rc = -1;
    } else {
        p.sec = sec_text(c);
        rc = p_run(p);
    }
    if (rc == 0) {
        rc = p_check_undefined_locals(c);
    }
    // 待回填记录移交给上下文，供 assemble 阶段取用。
    c.fixups = p.fix.to_type(*u8);
    c.nfixups = p.nfix;
    free(p);
    lex_free(lx);
    free(lx);
    return rc;
}
