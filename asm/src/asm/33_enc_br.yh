module asm;

import obj;

// ============================================================================
// asm/enc_br.yh —— AArch64 分支、地址与系统指令编码（冻结子集）
//
// 位域布局（ARM ARM）：
//   B/BL      op(31) 00101 imm26(25:0)
//   BR/BLR/RET 1101011 opc(24:21) op2(20:16) op3(15:10) Rn(9:5) op4(4:0)
//   B.cond    0101010 0 imm19(23:5) cond(3:0)
//   CBZ/CBNZ  sf(31) 011010 0 op(24) imm19(23:5) Rt(4:0)
//   TBZ/TBNZ  b5(31) 011011 0 op(24) b40(23:19) imm14(18:5) Rt(4:0)
//   ADR/ADRP  op(31) immlo(30:29) 10000 immhi(23:5) Rd(4:0)
//   SVC/BRK  11010100 000 opc(23:21) imm16(20:5) op2(4:0)
//   NOP/HINT 1101010100 0 00 011 0010 CRm(11:8) op2(7:5) 11111
// ============================================================================

// —— 分支 ——

// e_branch：B/BL，imm26 是相对当前指令的字节偏移。sub 为 1 时是 BL。
pub fn e_branch(link int, off i64) i64 {
    if (off % 4 != 0) {
        return ENC_BAD;
    }
    let imm i64 = off / 4;
    if (imm < -33554432 || imm > 33554431) {
        return ENC_BAD;
    }
    let u u32 = (imm & 0x3ffffff).to_type(u32);
    let w u32 = 0x14000000;
    if (link != 0) {
        w = 0x94000000;
    }
    w = bset(w, 0, 26, u);
    return w.to_type(i64);
}

// e_branch_reg：BR/BLR/RET。kind 取 0=BR 1=BLR 2=RET。
pub fn e_branch_reg(kind int, rn int) i64 {
    if (rn < 0 || rn > 31) {
        return ENC_BAD;
    }
    let w u32 = 0xd61f0000;
    if (kind == 1) { w = 0xd63f0000; }
    if (kind == 2) { w = 0xd65f0000; }
    w = bset(w, 5, 5, rn.to_type(u32));
    return w.to_type(i64);
}

// e_condbr：B.cond。cond 取 0..15，off 是相对当前指令的字节偏移。
pub fn e_condbr(cond int, off i64) i64 {
    if (cond < 0 || cond > 15) {
        return ENC_BAD;
    }
    if (off % 4 != 0) {
        return ENC_BAD;
    }
    let imm i64 = off / 4;
    if (imm < -262144 || imm > 262143) {
        return ENC_BAD;
    }
    let w u32 = 0x54000000;
    w = bset(w, 5, 19, (imm & 0x7ffff).to_type(u32));
    w = bset(w, 0, 4, cond.to_type(u32));
    return w.to_type(i64);
}

// e_cmpbr：CBZ/CBNZ。sf 决定 Rt 按 64 位还是 32 位解释。
pub fn e_cmpbr(sf int, nz int, rt int, off i64) i64 {
    if (!reg_ok(rt)) {
        return ENC_BAD;
    }
    if (off % 4 != 0) {
        return ENC_BAD;
    }
    let imm i64 = off / 4;
    if (imm < -262144 || imm > 262143) {
        return ENC_BAD;
    }
    let w u32 = 0x34000000;
    if (nz != 0) { w = 0x35000000; }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 5, 19, (imm & 0x7ffff).to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    return w.to_type(i64);
}

// e_testbr：TBZ/TBNZ。bit 取 0..63，位号第 5 位单独编码在 bit31。
pub fn e_testbr(bit i64, nz int, rt int, off i64) i64 {
    if (bit < 0 || bit > 63 || !reg_ok(rt)) {
        return ENC_BAD;
    }
    if (off % 4 != 0) {
        return ENC_BAD;
    }
    let imm i64 = off / 4;
    if (imm < -8192 || imm > 8191) {
        return ENC_BAD;
    }
    let w u32 = 0x36000000;
    if (nz != 0) { w = 0x37000000; }
    w = bset(w, 31, 1, ((bit >> 5) & 1).to_type(u32));
    w = bset(w, 19, 5, (bit & 0x1f).to_type(u32));
    w = bset(w, 5, 14, (imm & 0x3fff).to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    return w.to_type(i64);
}

// —— 地址 ——

// e_adr：ADR/ADRP。is_page=1 时按 4KB 页对齐取高 21 位。
// 返回 -1 表示偏移超出范围；页对齐由调用方（解析层）保证。
pub fn e_adr(is_page int, rd int, off i64) i64 {
    if (!reg_ok(rd)) {
        return ENC_BAD;
    }
    let v i64 = off;
    if (is_page != 0) {
        if ((off % 4096) != 0) {
            return ENC_BAD;
        }
        v = off / 4096;
    }
    if (v < -1048576 || v > 1048575) {
        return ENC_BAD;
    }
    let u u32 = (v & 0x1fffff).to_type(u32);
    let w u32 = 0x10000000;
    if (is_page != 0) { w = 0x90000000; }
    w = bset(w, 29, 2, u & 3.to_type(u32));
    w = bset(w, 5, 19, u >> 2.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 系统 ——

// e_system：SVC/BRK/HLT。kind 取 1=SVC 2=BRK 3=HLT。
pub fn e_system(kind int, imm16 i64) i64 {
    if (imm16 < 0 || imm16 > 0xffff) {
        return ENC_BAD;
    }
    let w u32 = 0xd4000001;
    if (kind == 2) { w = 0xd4200000; }
    if (kind == 3) { w = 0xd4400000; }
    w = bset(w, 5, 16, imm16.to_type(u32));
    return w.to_type(i64);
}

// e_nop：空操作。编码字最高位是 1，字面量必须当 u32 再零扩展，
// 直接 .to_type(i64) 会按 i32 符号扩展成 0xffffffffd503201f。
pub fn e_nop() i64 {
    return 0xd503201f.to_type(u32).to_type(i64);
}

// e_barrier：屏障指令。kind 取 0=DSB 1=DMB 2=ISB；CRm 是屏障域编码。
// 三者只在 bit6（0x40）上不同：DSB 0xd5033_9f、DMB 0xd5033_bf、ISB 0xd5033_d_f。
pub fn e_barrier(kind int, crm i64) i64 {
    if (crm < 0 || crm > 15) {
        return ENC_BAD;
    }
    let w u32 = 0xd503309f;
    if (kind == 1) { w = 0xd50330bf; }
    if (kind == 2) { w = 0xd50330df; }
    w = bset(w, 8, 4, crm.to_type(u32));
    return w.to_type(i64);
}

// barrier_opt：屏障域助记符 → CRm 编码；未知返回 -1。
pub fn barrier_opt(src *u8, from int, e int) int {
    if (obj.tok_eq(src, from, e, "sy") != 0) { return 15; }
    if (obj.tok_eq(src, from, e, "st") != 0) { return 14; }
    if (obj.tok_eq(src, from, e, "ld") != 0) { return 13; }
    if (obj.tok_eq(src, from, e, "ish") != 0) { return 11; }
    if (obj.tok_eq(src, from, e, "ishst") != 0) { return 10; }
    if (obj.tok_eq(src, from, e, "ishld") != 0) { return 9; }
    if (obj.tok_eq(src, from, e, "nsh") != 0) { return 7; }
    if (obj.tok_eq(src, from, e, "nshst") != 0) { return 6; }
    if (obj.tok_eq(src, from, e, "nshld") != 0) { return 5; }
    if (obj.tok_eq(src, from, e, "osh") != 0) { return 3; }
    if (obj.tok_eq(src, from, e, "oshst") != 0) { return 2; }
    if (obj.tok_eq(src, from, e, "oshld") != 0) { return 1; }
    return -1;
}
