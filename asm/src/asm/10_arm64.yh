module asm;

// ============================================================================
// asm/arm64.yh —— AArch64 编码公共层：位域、逻辑立即数、操作数合法性
//
// 契约（docs/03-design/yh-link独立项目与首版汇编子集契约.md §3/§8）：
//   * 位宽来自操作数形态，不从助记符拼写猜；
//   * 编号 31 的 SP 与 ZR 一路区分到底：SP 只能出现在基址/目的/源位置，
//     ZR 在源位置等价 x31、在目的位置编码为 31（丢弃结果）；
//   * 立即数、位移、位宽错配一律拒绝，不做静默截断。
//
// 本层是纯函数：不碰上下文、不分配内存、不报诊断。错误一律返回 -1，
// 由解析层翻译成带行列的诊断——同一处范围规则只写一次。
// ============================================================================

import obj;

// —— 位域写入 ——

// bset：把 v 的低 n 位放到 base 的第 sh 位起。
pub fn bset(base u32, sh int, n int, v u32) u32 {
    let w u32 = n.to_type(u32);
    let mask u32 = ((1.to_type(u32) << w) - 1.to_type(u32)) << sh.to_type(u32);
    return (base & ~mask) | ((v << sh.to_type(u32)) & mask);
}

// ureg：把「类别 + 编号」折叠成 5 位寄存器字段。
//   SP  → 31（基址/源位置）
//   ZR  → 31（源位置等价 x31；目的位置表示丢弃，编码同样是 31）
// 返回 -1 表示该类别不能出现在这个位置。
pub fn ureg(kind int, num int) int {
    if (num < 0 || num > 31) {
        return -1;
    }
    if (kind == RK_X || kind == RK_W || kind == RK_XZR || kind == RK_WZR
        || kind == RK_SP || kind == RK_WSP) {
        return num;
    }
    return -1;
}

// ureg_nonsp：只能出现在非 SP 位置的寄存器折叠（基址/索引不允许 SP/ZR）。
// 访存基址允许 SP；索引与移位源不允许。
pub fn ureg_plain(kind int, num int) int {
    if (num < 0 || num > 30) {
        return -1;
    }
    if (kind == RK_X || kind == RK_W) {
        return num;
    }
    return -1;
}

// ureg_nzr：ZR 允许的位置折叠（源操作数）。
pub fn ureg_nzr(kind int, num int) int {
    if (num != 31) {
        return ureg_plain(kind, num);
    }
    if (kind == RK_XZR || kind == RK_WZR) {
        return 31;
    }
    return -1;
}

// ureg_nozr：不允许 ZR 的位置（访存基址、索引、移位量、访存数据寄存器）。
pub fn ureg_nozr(kind int, num int) int {
    if (num == 31) {
        // 只有 SP 类别允许编号 31
        if (kind == RK_SP || kind == RK_WSP) {
            return 31;
        }
        return -1;
    }
    return ureg_plain(kind, num);
}

// is64k：寄存器类别是否为 64 位（x/sp/xzr）。
pub fn is64k(kind int) int {
    if (kind == RK_X || kind == RK_SP || kind == RK_XZR) { return 1; }
    return 0;
}

// —— 逻辑立即数 ——
//
// and/orr/eor/bic 的立即数是「重复位模式」而非任意值，由 N:immr:imms 三
// 个字段编码。下面的规则来自 ARM ARM 的 DecodeBitMasks，已用 llvm-mc 对
// 全部 6636 条规范编码逐条穷举核对（tmp/verify_logical_imm.py）。
//
//   combined = (N << 6) | (NOT(imms) & 0x3f)   // 7 位
//   len      = HighestSetBit(combined)          // 0 基
//   esize    = 1 << len                         // 元素位宽
//   levels   = esize - 1
//   S        = imms & levels                    // 连续 1 的个数 - 1
//   R        = immr & levels                    // 元素内循环右移量
//   elem     = Ones(S+1) 在 esize 位内循环右移 R
//   pattern  = elem 在 32（N=0）或 64（N=1）位内平铺
//
// 两条额外规则：imms == 0x3f 是保留编码；全 1 模式不可表示。

// ones：低 n 位为 1 的掩码。
fn ones(n int) u64 {
    if (n <= 0) { return 0; }
    if (n >= 64) { return 0xffffffffffffffff; }
    return (1.to_type(u64) << n.to_type(u32)) - 1.to_type(u64);
}

// hsb：最高置位下标（0 基）；v 为 0 时返回 -1。
fn hsb(v u64) int {
    let i int = 63;
    for i >= 0 {
        if (((v >> i.to_type(u32)) & 1.to_type(u64)) != 0) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// ror_n：在 n 位宽内循环右移 r 位（r 已按 n 取模）。
fn ror_n(v u64, r int, n int) u64 {
    if (r == 0 || n <= 1) {
        return v & ones(n);
    }
    let m u64 = ones(n);
    return ((v >> r.to_type(u32)) | (v << (n - r).to_type(u32))) & m;
}

// bi_pack：把 N/immr/imms 打包成一个 int，避免多返回值。
// 布局：(N << 12) | (immr << 6) | imms。非法值用 -1 表示。
pub fn bi_pack(nn int, immr int, imms int) int {
    return (nn << 12) | (immr << 6) | imms;
}

// bi_pattern：由打包的 (N, immr, imms) 生成逻辑立即数模式。
// 输入必须是 bi_encode 产出或与之同构的合法组合；非法组合返回全 1 哨兵，
// 由于全 1 模式本身不可表示，调用方不会把它误当成合法结果。
pub fn bi_pattern(packed int, is64 int) u64 {
    if (packed < 0) {
        return 0xffffffffffffffff;
    }
    let nn int = (packed >> 12) & 1;
    let immr int = (packed >> 6) & 0x3f;
    let imms int = packed & 0x3f;
    if (imms == 0x3f) {
        return 0xffffffffffffffff;
    }
    if (is64 == 0 && nn != 0) {
        return 0xffffffffffffffff;
    }
    let combined int = (nn << 6) | (63 - imms);
    let ln int = hsb(combined.to_type(u64));
    if (ln <= 0) {
        return 0xffffffffffffffff;
    }
    let esize int = 1 << ln;
    let levels int = esize - 1;
    let s int = imms & levels;
    let r int = (immr & levels) % esize;
    let rot u64 = ror_n(ones(s + 1), r, esize);
    let pw int = 32;
    if (nn != 0) { pw = 64; }
    if (esize > pw) {
        return 0xffffffffffffffff;
    }
    let w u64 = 0;
    let pos int = 0;
    for pos < pw {
        w = w | (rot << pos.to_type(u32));
        pos += esize;
    }
    if (is64 != 0 && nn == 0) {
        // N=0 的 32 位模式在 64 位指令里平铺两次；全 1 与 N=1 重复，拒绝
        if (w == 0xffffffff.to_type(u64)) {
            return 0xffffffffffffffff;
        }
        return w | (w << 32.to_type(u32));
    }
    if (w == ones(pw)) {
        return 0xffffffffffffffff;  // 全 1 是保留模式
    }
    return w;
}

// bi_encode：把逻辑立即数编码成打包的 N/immr/imms。非法返回 -1。
//
// 穷举全部候选并取第一个精确匹配。合法组合只有 7×64×64 个，且同一模式只有
// 一种规范写法（immr 必小于元素位宽），按 immr 升序扫描天然命中规范编码，
// 因此结果与 llvm-mc 一致且可重复。
pub fn bi_encode(imm i64, is64 int) int {
    let target u64 = imm.to_type(u64);
    if (is64 == 0 && (target & 0xffffffff00000000) != 0) {
        return -1;  // W 形式放不下 32 位以外的位
    }
    let nn int = 0;
    for nn <= 1 {
        let immr int = 0;
        for immr < 64 {
            let imms int = 0;
            for imms < 64 {
                let p int = bi_pack(nn, immr, imms);
                if (bi_pattern(p, is64) == target) {
                    return p;
                }
                imms += 1;
            }
            immr += 1;
        }
        nn += 1;
    }
    return -1;
}

// —— 立即移位量 ——

// sh_ok：立即移位量是否在给定位宽内（0..31 或 0..63）。
pub fn sh_ok(sh i64, is64 int) int {
    if (sh < 0) { return 0; }
    let hi i64 = 31;
    if (is64 == 0) { hi = 31; }
    if (sh > hi) { return 0; }
    return 1;
}

// —— 条件码 ——

// cond_code：条件码助记符 → 0..15；未知返回 -1。
// 接受点号写法（b.eq）与 GNU 简写（beq）两种形态。
pub fn cond_code(src *u8, from int, e int) int {
    if (obj.tok_eq(src, from, e, "eq") != 0) { return 0; }
    if (obj.tok_eq(src, from, e, "ne") != 0) { return 1; }
    if (obj.tok_eq(src, from, e, "cs") != 0) { return 2; }
    if (obj.tok_eq(src, from, e, "cc") != 0) { return 3; }
    if (obj.tok_eq(src, from, e, "hs") != 0) { return 2; }
    if (obj.tok_eq(src, from, e, "lo") != 0) { return 3; }
    if (obj.tok_eq(src, from, e, "mi") != 0) { return 4; }
    if (obj.tok_eq(src, from, e, "pl") != 0) { return 5; }
    if (obj.tok_eq(src, from, e, "vs") != 0) { return 6; }
    if (obj.tok_eq(src, from, e, "vc") != 0) { return 7; }
    if (obj.tok_eq(src, from, e, "hi") != 0) { return 8; }
    if (obj.tok_eq(src, from, e, "ls") != 0) { return 9; }
    if (obj.tok_eq(src, from, e, "ge") != 0) { return 10; }
    if (obj.tok_eq(src, from, e, "lt") != 0) { return 11; }
    if (obj.tok_eq(src, from, e, "gt") != 0) { return 12; }
    if (obj.tok_eq(src, from, e, "le") != 0) { return 13; }
    if (obj.tok_eq(src, from, e, "al") != 0) { return 14; }
    if (obj.tok_eq(src, from, e, "nv") != 0) { return 15; }
    return -1;
}

// cond_alias：GNU 简写条件码（beq/bne/bcs/bcc/bmi/…）→ 标准名长度。
// 返回匹配的标准条件码长度（2），不匹配返回 0。
pub fn cond_alias_len(src *u8, from int, e int) int {
    let code int = cond_code(src, from, e);
    if (code < 0) {
        return 0;
    }
    return 2;
}

// —— 移位种类 ——
//
// register form 的可选移位：00=LSL 01=LSR 10=ASR 11=ROR

pub const SH_LSL int = 0;
pub const SH_LSR int = 1;
pub const SH_ASR int = 2;
pub const SH_ROR int = 3;

// sh_kind：移位助记符 → SH_*；不是移位返回 -1。
pub fn sh_kind(src *u8, from int, e int) int {
    if (obj.tok_eq(src, from, e, "lsl") != 0) { return SH_LSL; }
    if (obj.tok_eq(src, from, e, "lsr") != 0) { return SH_LSR; }
    if (obj.tok_eq(src, from, e, "asr") != 0) { return SH_ASR; }
    if (obj.tok_eq(src, from, e, "ror") != 0) { return SH_ROR; }
    return -1;
}

// —— 访存尺寸 ——
//
// 返回字节数 1/2/4/8；不是受支持的访存助记符返回 -1。

// reg_ok：5 位寄存器字段是否在范围内。编码层与解析层共用。
// mem_size_bytes：访存尺寸编码（0..3）→ 访问字节数；越界返回 -1。
pub fn mem_size_bytes(size int) int {
    if (size == 0) { return 1; }
    if (size == 1) { return 2; }
    if (size == 2) { return 4; }
    if (size == 3) { return 8; }
    return -1;
}

pub fn reg_ok(n int) int {
    if (n < 0 || n > 31) {
        return 0;
    }
    return 1;
}

// ext_code：扩展方式名 → EXT_* 编码；不是扩展名返回 -1。
pub fn ext_code(src *u8, from int, e int) int {
    if (obj.tok_eq(src, from, e, "uxtb") != 0) { return EXT_UXTB; }
    if (obj.tok_eq(src, from, e, "uxth") != 0) { return EXT_UXTH; }
    if (obj.tok_eq(src, from, e, "uxtw") != 0) { return EXT_UXTW; }
    if (obj.tok_eq(src, from, e, "uxtx") != 0) { return EXT_UXTX; }
    if (obj.tok_eq(src, from, e, "sxtb") != 0) { return EXT_SXTB; }
    if (obj.tok_eq(src, from, e, "sxth") != 0) { return EXT_SXTH; }
    if (obj.tok_eq(src, from, e, "sxtw") != 0) { return EXT_SXTW; }
    if (obj.tok_eq(src, from, e, "sxtx") != 0) { return EXT_SXTX; }
    return -1;
}
