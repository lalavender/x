module asm;

// ============================================================================
// asm/selftest.yh —— 编码层自检
//
// 每个用例是一对（编码器调用结果，llvm-mc 给出的期望机器字）。期望值来自
// tmp/base_enc.txt，由 scripts 用 llvm-mc 独立产出，不是手算的。
//
// 自检返回 0 表示全部通过，否则返回失败用例序号 + 1，便于定位。
// ============================================================================

import obj;

// Case：一条期望值。call 字段留给阅读，实际比对用 word。
pub struct Case {
    name *char;   // 人类可读的指令文本
    got i64;      // 本实现算出的机器字
    want i64;     // llvm-mc 给出的机器字
}

// ck：登记一个用例。名字必须与 llvm-mc 的输入文本一致。
fn ck(cs *Case, n *int, name *char, got i64, want i64) int {
    let i int = n[0];
    cs[i].name = name;
    cs[i].got = got;
    cs[i].want = want;
    n[0] = i + 1;
    return 0;
}

// enc_selftest：跑完全部编码用例。dump 非 0 时把每条用例按
// 「文本<TAB>机器字」写到 stdout，供 tests/check_enc.py 交给 llvm-mc 复核。
pub fn enc_selftest(dump int) int {
    let cap int = 200;
    let cs *Case = malloc((cap * sizeof(Case)).to_type(u64)).to_type(*Case);
    let np *int = malloc(8).to_type(*int);
    np[0] = 0;
    let n *int = np;

    // —— 加减 ——
    ck(cs, n, "add x0, x1, #1", e_addsub_imm(1, 0, 0, 0, 0, 1, 1), 0x91000420);
    ck(cs, n, "add x0, x1, #1, lsl #12", e_addsub_imm(1, 0, 0, 1, 0, 1, 1), 0x91400420);
    ck(cs, n, "adds x0, x1, #1", e_addsub_imm(1, 0, 1, 0, 0, 1, 1), 0xb1000420);
    ck(cs, n, "sub x0, x1, #1", e_addsub_imm(1, 1, 0, 0, 0, 1, 1), 0xd1000420);
    ck(cs, n, "subs x0, x1, #1", e_addsub_imm(1, 1, 1, 0, 0, 1, 1), 0xf1000420);
    ck(cs, n, "cmp x1, #1", e_addsub_imm(1, 1, 1, 0, 31, 1, 1), 0xf100043f);
    ck(cs, n, "cmn x1, #1", e_addsub_imm(1, 0, 1, 0, 31, 1, 1), 0xb100043f);
    ck(cs, n, "add x0, x1, x2", e_addsub_reg(1, 0, 0, SH_LSL, 0, 0, 1, 2), 0x8b020020);
    ck(cs, n, "add x0, x1, x2, lsl #3", e_addsub_reg(1, 0, 0, SH_LSL, 3, 0, 1, 2), 0x8b020c20);
    ck(cs, n, "adds x0, x1, x2, asr #2", e_addsub_reg(1, 0, 1, SH_ASR, 2, 0, 1, 2), 0xab820820);
    ck(cs, n, "sub x0, x1, x2", e_addsub_reg(1, 1, 0, SH_LSL, 0, 0, 1, 2), 0xcb020020);
    ck(cs, n, "subs x0, x1, x2", e_addsub_reg(1, 1, 1, SH_LSL, 0, 0, 1, 2), 0xeb020020);
    ck(cs, n, "neg x0, x1", e_addsub_reg(1, 1, 0, SH_LSL, 0, 0, 31, 1), 0xcb0103e0);
    ck(cs, n, "cmp x1, x2", e_addsub_reg(1, 1, 1, SH_LSL, 0, 31, 1, 2), 0xeb02003f);
    ck(cs, n, "add x0, x1, w2, uxtw #2", e_addsub_ext(1, 0, 0, EXT_UXTW, 2, 0, 1, 2), 0x8b224820);
    ck(cs, n, "sub x0, x1, w2, sxtw", e_addsub_ext(1, 1, 0, EXT_SXTW, 0, 0, 1, 2), 0xcb22c020);

    // —— 逻辑 ——
    ck(cs, n, "and x0, x1, #7", e_logical_imm(1, OP_AND, 0, 1, 7), 0x92400820);
    ck(cs, n, "orr x0, x1, #7", e_logical_imm(1, OP_ORR, 0, 1, 7), 0xb2400820);
    ck(cs, n, "eor x0, x1, #7", e_logical_imm(1, OP_EOR, 0, 1, 7), 0xd2400820);
    ck(cs, n, "ands x0, x1, #7", e_logical_imm(1, OP_ANDS, 0, 1, 7), 0xf2400820);
    ck(cs, n, "tst x1, #7", e_logical_imm(1, OP_ANDS, 31, 1, 7), 0xf240083f);
    ck(cs, n, "and w3, w4, #0xff", e_logical_imm(0, OP_AND, 3, 4, 0xff), 0x12001c83);
    ck(cs, n, "and x0, x1, x2", e_logical_reg(1, OP_AND, SH_LSL, 0, 0, 1, 2), 0x8a020020);
    ck(cs, n, "orr x0, x1, x2, lsl #5", e_logical_reg(1, OP_ORR, SH_LSL, 5, 0, 1, 2), 0xaa021420);
    ck(cs, n, "eor x0, x1, x2, lsr #1", e_logical_reg(1, OP_EOR, SH_LSR, 1, 0, 1, 2), 0xca420420);
    ck(cs, n, "ands x0, x1, x2, asr #7", e_logical_reg(1, OP_ANDS, SH_ASR, 7, 0, 1, 2), 0xea821c20);
    ck(cs, n, "bic x0, x1, x2", e_logical_reg(1, OP_BIC, SH_LSL, 0, 0, 1, 2), 0x8a220020);
    ck(cs, n, "mvn x0, x1", e_logical_reg(1, OP_ORN, SH_LSL, 0, 0, 31, 1), 0xaa2103e0);
    ck(cs, n, "mov x0, x1", e_logical_reg(1, OP_ORR, SH_LSL, 0, 0, 31, 1), 0xaa0103e0);

    // —— 常量搬运 ——
    ck(cs, n, "movz x0, #0x1234", e_movw(1, 2, 0, 0, 0x1234), 0xd2824680);
    ck(cs, n, "movz x0, #0x1234, lsl #16", e_movw(1, 2, 1, 0, 0x1234), 0xd2a24680);
    ck(cs, n, "movz w0, #1", e_movw(0, 2, 0, 0, 1), 0x52800020);
    ck(cs, n, "movk x0, #0x1234", e_movw(1, 3, 0, 0, 0x1234), 0xf2824680);
    ck(cs, n, "movk x0, #0x1234, lsl #32", e_movw(1, 3, 2, 0, 0x1234), 0xf2c24680);

    // —— 乘法与除法 ——
    ck(cs, n, "mul x0, x1, x2", e_madd(1, 0, 0, 1, 2, 31), 0x9b027c20);
    ck(cs, n, "mul w0, w1, w2", e_madd(0, 0, 0, 1, 2, 31), 0x1b027c20);
    ck(cs, n, "madd x0, x1, x2, x3", e_madd(1, 0, 0, 1, 2, 3), 0x9b020c20);
    ck(cs, n, "msub x0, x1, x2, x3", e_madd(1, 1, 0, 1, 2, 3), 0x9b028c20);
    ck(cs, n, "sdiv x0, x1, x2", e_binop(1, BIN_SDIV, 0, 1, 2), 0x9ac20c20);
    ck(cs, n, "udiv w0, w1, w2", e_binop(0, BIN_UDIV, 0, 1, 2), 0x1ac20820);
    ck(cs, n, "lsl x0, x1, x2", e_binop(1, BIN_LSLV, 0, 1, 2), 0x9ac22020);
    ck(cs, n, "lsr x0, x1, x2", e_binop(1, BIN_LSRV, 0, 1, 2), 0x9ac22420);
    ck(cs, n, "asr x0, x1, x2", e_binop(1, BIN_ASRV, 0, 1, 2), 0x9ac22820);

    // —— 位域与扩展 ——
    ck(cs, n, "lsl x0, x1, #5", e_lsl_imm(1, 0, 1, 5), 0xd37be820);
    ck(cs, n, "lsr w0, w1, #5", e_lsr_imm(0, 0, 1, 5), 0x53057c20);
    ck(cs, n, "asr x0, x1, #5", e_asr_imm(1, 0, 1, 5), 0x9345fc20);
    ck(cs, n, "sxtw x0, w1", e_bitfield(1, OP_SBFM, 0, 1, 0, 31), 0x93407c20);
    ck(cs, n, "sxtb x0, w1", e_bitfield(1, OP_SBFM, 0, 1, 0, 7), 0x93401c20);
    ck(cs, n, "sxth x0, w1", e_bitfield(1, OP_SBFM, 0, 1, 0, 15), 0x93403c20);
    ck(cs, n, "uxtb x0, w1", e_bitfield(0, OP_UBFM, 0, 1, 0, 7), 0x53001c20);
    ck(cs, n, "uxth x0, w1", e_bitfield(0, OP_UBFM, 0, 1, 0, 15), 0x53003c20);
    ck(cs, n, "sbfx x0, x1, #4, #8", e_sbfx(1, 0, 1, 4, 8), 0x93442c20);

    // —— 条件选择 ——
    ck(cs, n, "csel x0, x1, x2, eq", e_csel(1, 0, 0, 0, 1, 2, 0), 0x9a820020);
    ck(cs, n, "csel x0, x1, x2, ne", e_csel(1, 0, 0, 0, 1, 2, 1), 0x9a821020);
    ck(cs, n, "cset x0, eq", e_csel(1, 0, 1, 0, 31, 31, 1), 0x9a9f17e0);
    ck(cs, n, "cset w0, mi", e_csel(0, 0, 1, 0, 31, 31, 5), 0x1a9f57e0);

    // —— 访存：无符号立即数 ——
    let kx i64 = e_mem_kind(3, 0, 1);
    let kw i64 = e_mem_kind(2, 0, 0);
    let kb i64 = e_mem_kind(0, 0, 0);
    let ksb i64 = e_mem_kind(0, 1, 1);
    let ksbw i64 = e_mem_kind(0, 1, 0);
    let kh i64 = e_mem_kind(1, 0, 0);
    let ksh i64 = e_mem_kind(1, 1, 1);
    let ksw i64 = e_mem_kind(2, 1, 1);
    let ksx i64 = e_mem_store(3);
    let ksww i64 = e_mem_store(2);
    let ksbw2 i64 = e_mem_store(0);
    let kshw i64 = e_mem_store(1);
    ck(cs, n, "ldr x0, [x1]", e_loadstore_imm(kx, 0, 1, 0), 0xf9400020);
    ck(cs, n, "ldr x0, [x1, #8]", e_loadstore_imm(kx, 0, 1, 8), 0xf9400420);
    ck(cs, n, "ldr w0, [x1, #4]", e_loadstore_imm(kw, 0, 1, 4), 0xb9400420);
    ck(cs, n, "ldr w0, [sp, #4]", e_loadstore_imm(kw, 0, 31, 4), 0xb94007e0);
    ck(cs, n, "ldrb w0, [x1]", e_loadstore_imm(kb, 0, 1, 0), 0x39400020);
    ck(cs, n, "ldrsb x0, [x1]", e_loadstore_imm(ksb, 0, 1, 0), 0x39800020);
    ck(cs, n, "ldrsb w0, [x1]", e_loadstore_imm(ksbw, 0, 1, 0), 0x39c00020);
    ck(cs, n, "ldrh w0, [x1]", e_loadstore_imm(kh, 0, 1, 0), 0x79400020);
    ck(cs, n, "ldrsh x0, [x1]", e_loadstore_imm(ksh, 0, 1, 0), 0x79800020);
    ck(cs, n, "ldrsw x0, [x1]", e_loadstore_imm(ksw, 0, 1, 0), 0xb9800020);
    ck(cs, n, "str x0, [x1]", e_loadstore_imm(ksx, 0, 1, 0), 0xf9000020);
    ck(cs, n, "str x0, [x1, #16]", e_loadstore_imm(ksx, 0, 1, 16), 0xf9000820);
    ck(cs, n, "str w0, [x1, #4]", e_loadstore_imm(ksww, 0, 1, 4), 0xb9000420);
    ck(cs, n, "strb w0, [x1]", e_loadstore_imm(ksbw2, 0, 1, 0), 0x39000020);
    ck(cs, n, "strh w0, [x1]", e_loadstore_imm(kshw, 0, 1, 0), 0x79000020);

    // —— 访存：写回 ——
    ck(cs, n, "ldr x0, [x1, #24]!", e_loadstore_wb(kx, 0, 1, 24, 3), 0xf8418c20);
    ck(cs, n, "ldr x0, [x1, #-8]!", e_loadstore_wb(kx, 0, 1, -8, 3), 0xf85f8c20);
    ck(cs, n, "ldr x0, [x1, #8]!", e_loadstore_wb(kx, 0, 1, 8, 3), 0xf8408c20);
    ck(cs, n, "ldr x0, [x1], #8", e_loadstore_wb(kx, 0, 1, 8, 1), 0xf8408420);
    ck(cs, n, "ldr x0, [x1], #-8", e_loadstore_wb(kx, 0, 1, -8, 1), 0xf85f8420);
    ck(cs, n, "str x0, [x1, #-8]!", e_loadstore_wb(ksx, 0, 1, -8, 3), 0xf81f8c20);

    // —— 访存：寄存器偏移 ——
    ck(cs, n, "ldr x0, [x1, x2]", e_loadstore_reg(kx, 0, 1, 2, EXT_UXTX, 0), 0xf8626820);
    ck(cs, n, "ldr x0, [x1, w2, uxtw #3]", e_loadstore_reg(kx, 0, 1, 2, EXT_UXTW, 3), 0xf8625820);
    ck(cs, n, "ldr x0, [x1, x2, lsl #3]", e_loadstore_reg(kx, 0, 1, 2, EXT_UXTX, 3), 0xf8627820);

    // —— 成对访存 ——
    ck(cs, n, "stp x29, x30, [sp, #-16]", e_pair_off(PAIR_64, 0, 29, 30, 31, -16), 0xa93f7bfd);
    ck(cs, n, "stp x29, x30, [sp, #16]", e_pair_off(PAIR_64, 0, 29, 30, 31, 16), 0xa9017bfd);
    ck(cs, n, "ldp x29, x30, [sp], #16", e_pair_idx(PAIR_64, 1, 29, 30, 31, 16, 3), 0xa8c17bfd);
    ck(cs, n, "ldp x29, x30, [sp, #16]", e_pair_off(PAIR_64, 1, 29, 30, 31, 16), 0xa9417bfd);
    ck(cs, n, "ldp w0, w1, [x2, #8]", e_pair_off(PAIR_32, 1, 0, 1, 2, 8), 0x29410440);
    ck(cs, n, "stp w0, w1, [sp, #-8]!", e_pair_idx(PAIR_32, 0, 0, 1, 31, -8, 2), 0x29bf07e0);

    // —— 分支与地址 ——
    ck(cs, n, "b #0", e_branch(0, 0), 0x14000000);
    ck(cs, n, "bl #0", e_branch(1, 0), 0x94000000);
    ck(cs, n, "br x1", e_branch_reg(0, 1), 0xd61f0020);
    ck(cs, n, "blr x1", e_branch_reg(1, 1), 0xd63f0020);
    ck(cs, n, "ret", e_branch_reg(2, 30), 0xd65f03c0);
    ck(cs, n, "ret x1", e_branch_reg(2, 1), 0xd65f0020);
    ck(cs, n, "cbz x0, #0", e_cmpbr(1, 0, 0, 0), 0xb4000000);
    ck(cs, n, "cbnz w0, #0", e_cmpbr(0, 1, 0, 0), 0x35000000);
    ck(cs, n, "beq #0", e_condbr(0, 0), 0x54000000);
    ck(cs, n, "bne #0", e_condbr(1, 0), 0x54000001);
    ck(cs, n, "blt #0", e_condbr(11, 0), 0x5400000b);
    ck(cs, n, "b.ge #0", e_condbr(10, 0), 0x5400000a);
    ck(cs, n, "b.cs #0", e_condbr(2, 0), 0x54000002);
    ck(cs, n, "b.lo #0", e_condbr(3, 0), 0x54000003);
    ck(cs, n, "adrp x0, #0", e_adr(1, 0, 0), 0x90000000);
    ck(cs, n, "adr x0, #0", e_adr(0, 0, 0), 0x10000000);

    // —— 系统 ——
    ck(cs, n, "nop", e_nop(), 0xd503201f);
    ck(cs, n, "brk #0", e_system(2, 0), 0xd4200000);
    ck(cs, n, "svc #0", e_system(1, 0), 0xd4000001);
    ck(cs, n, "dsb sy", e_barrier(0, 15), 0xd5033f9f);
    ck(cs, n, "dmb ish", e_barrier(1, 11), 0xd5033bbf);

    // —— 标量浮点 ——
    // 三条字段位置在各族里一致：Rd 在 4:0、Rn 在 9:5、Rm 在 20:16。
    ck(cs, n, "fadd s0, s1, s2", e_farith(2, 0, 0, 1, 2), 0x1e222820);
    ck(cs, n, "fadd d0, d1, d2", e_farith(2, 1, 0, 1, 2), 0x1e622820);
    ck(cs, n, "fsub d0, d1, d2", e_farith(3, 1, 0, 1, 2), 0x1e623820);
    ck(cs, n, "fmul d0, d1, d2", e_farith(0, 1, 0, 1, 2), 0x1e620820);
    ck(cs, n, "fdiv d0, d1, d2", e_farith(1, 1, 0, 1, 2), 0x1e621820);
    ck(cs, n, "fcmp s0, s1", e_fcmp(0, 0, 1), 0x1e212000);
    ck(cs, n, "fcmp d0, d1", e_fcmp(1, 0, 1), 0x1e612000);
    // fcvt 两向只差「源类型在位 22、目的类型在位 15」
    ck(cs, n, "fcvt s0, d1", e_fcvt(1, 0, 0, 1), 0x1e624020);
    ck(cs, n, "fcvt d0, s1", e_fcvt(0, 1, 0, 1), 0x1e22c020);
    ck(cs, n, "fcvtzs x0, s1", e_fcvtzs(1, 0, 0, 1), 0x9e380020);
    ck(cs, n, "fcvtzs w0, s1", e_fcvtzs(0, 0, 0, 1), 0x1e380020);
    ck(cs, n, "fcvtzs x0, d1", e_fcvtzs(1, 1, 0, 1), 0x9e780020);
    ck(cs, n, "scvtf s0, x1", e_scvtf(1, 0, 0, 1), 0x9e220020);
    ck(cs, n, "scvtf d0, w1", e_scvtf(0, 1, 0, 1), 0x1e620020);
    ck(cs, n, "scvtf d5, x11", e_scvtf(1, 1, 5, 11), 0x9e620165);
    ck(cs, n, "ucvtf d0, x0", e_ucvtf(1, 1, 0, 0), 0x9e630000);
    ck(cs, n, "ucvtf d0, w0", e_ucvtf(0, 1, 0, 0), 0x1e630000);
    ck(cs, n, "ucvtf s0, x0", e_ucvtf(1, 0, 0, 0), 0x9e230000);
    ck(cs, n, "ucvtf s3, w5", e_ucvtf(0, 0, 3, 5), 0x1e2300a3);
    ck(cs, n, "ucvtf d5, x11", e_ucvtf(1, 1, 5, 11), 0x9e630165);
    ck(cs, n, "fmov s0, w1", e_fmov_g(0, 0, 0, 1), 0x1e270020);
    ck(cs, n, "fmov d0, x1", e_fmov_g(1, 1, 0, 1), 0x9e670020);
    ck(cs, n, "fmov d5, x11", e_fmov_g(1, 1, 5, 11), 0x9e670165);
    // 浮点访存＝同宽整数访存或上 V 位（bit26），所以这里手动补那一位
    let ksd int = e_mem_store(3).to_type(int);
    let kld int = e_mem_kind(3, 0, 0).to_type(int);
    let kss int = e_mem_store(2).to_type(int);
    let kls int = e_mem_kind(2, 0, 0).to_type(int);
    ck(cs, n, "str d0, [x10]", e_loadstore_imm(ksd, 0, 10, 0) | 0x04000000, 0xfd000140);
    ck(cs, n, "ldr d0, [x10]", e_loadstore_imm(kld, 0, 10, 0) | 0x04000000, 0xfd400140);
    ck(cs, n, "ldr s1, [x10]", e_loadstore_imm(kls, 1, 10, 0) | 0x04000000, 0xbd400141);
    ck(cs, n, "str s2, [x10]", e_loadstore_imm(kss, 2, 10, 0) | 0x04000000, 0xbd000142);

    let total int = n[0];
    let buf *u8 = malloc(32).to_type(*u8);
    let i int = 0;
    for i < total {
        if (dump != 0) {
            let k int = obj.hex64(cs[i].got.to_type(u64), buf, 8);
            write(1, cs[i].name, obj.cstr_len(cs[i].name));
            write(1, "\t".to_type(*char), 1);
            write(1, buf.to_type(*char), k);
            write(1, "\n".to_type(*char), 1);
        }
        if (cs[i].got != cs[i].want) {
            show_fail(cs[i].name, i, cs[i].got, cs[i].want);
            free(buf);
            free(cs);
            free(np);
            return i + 1;
        }
        i += 1;
    }
    free(buf);
    free(cs);
    free(np);
    return 0;
}

// show_fail：把失败用例写到 stderr，格式为「序号 文本 期望 实际」。
fn show_fail(name *char, i int, got i64, want i64) int {
    let buf *u8 = malloc(32).to_type(*u8);
    write(2, "ENC#".to_type(*char), 4);
    let k int = obj.itoa(i.to_type(u64), buf);
    write(2, buf.to_type(*char), k);
    write(2, " ".to_type(*char), 1);
    write(2, name, obj.cstr_len(name));
    write(2, " want=".to_type(*char), 6);
    k = obj.hex64(want.to_type(u64), buf, 8);
    write(2, buf.to_type(*char), k);
    write(2, " got=".to_type(*char), 5);
    k = obj.hex64(got.to_type(u64), buf, 8);
    write(2, buf.to_type(*char), k);
    write(2, "\n".to_type(*char), 1);
    free(buf);
    return 0;
}

// —— 公共层自检 ——

// scan_selftest：公共层自检。退出码 0 表示通过（1..36 定位失败项）。
// 覆盖位域、寄存器折叠、逻辑立即数的正反例、编码回环与条件码解析。
pub fn scan_selftest() int {
    // 位域
    if (bset(0, 0, 8, 0xab) != 0xab) { return 1; }
    if (bset(0, 8, 8, 0xab) != 0xab00) { return 2; }
    if (bset(0xffffffff, 0, 8, 0xab) != 0xffffffab) { return 3; }

    // 寄存器折叠
    if (ureg(RK_X, 5) != 5) { return 4; }
    if (ureg(RK_SP, 31) != 31) { return 5; }
    if (ureg(RK_XZR, 31) != 31) { return 6; }
    if (ureg_plain(RK_SP, 31) >= 0) { return 7; }
    if (ureg_plain(RK_X, 31) >= 0) { return 8; }
    if (ureg_nzr(RK_XZR, 31) != 31) { return 9; }
    if (ureg_nzr(RK_X, 31) >= 0) { return 10; }
    if (ureg_nozr(RK_SP, 31) != 31) { return 11; }
    if (ureg_nozr(RK_XZR, 31) >= 0) { return 12; }
    if (is64k(RK_X) == 0 || is64k(RK_W) != 0) { return 13; }

    // 逻辑立即数：可编码的典型值（与 llvm-mc 逐条核对）
    if (bi_encode(0xff, 1) < 0) { return 14; }
    if (bi_encode(0x0101010101010101, 1) < 0) { return 15; }
    if (bi_encode(0x5555555555555555, 1) < 0) { return 16; }
    if (bi_encode(0xff, 0) < 0) { return 17; }
    if (bi_encode(0x55555555, 0) < 0) { return 18; }
    if (bi_encode(0xaaaaaaaa, 0) < 0) { return 19; }
    let big1 u64 = 0xff00ff00ff00ff00;
    let big2 u64 = 0xc000000000000000;
    if (bi_encode(big1.to_type(i64), 1) < 0) { return 20; }
    if (bi_encode(0x7fffffffffffffff, 1) < 0) { return 21; }
    if (bi_encode(big2.to_type(i64), 1) < 0) { return 22; }

    // 不可编码的值必须拒绝
    if (bi_encode(0, 1) >= 0) { return 23; }         // 全 0
    if (bi_encode(0x123, 1) >= 0) { return 24; }      // 非重复模式
    if (bi_encode(0x55555555, 1) >= 0) { return 25; }  // 不是 64 位重复模式
    if (bi_encode(-1, 0) >= 0) { return 26; }         // 全 1 是保留模式
    if (bi_encode(0x00ff00ff00ff00fe, 1) >= 0) { return 27; }

    // 编码回环：抽样确认 bi_pattern 生成的正是输入
    let t [8]u64 = [0xff, 0x00ff00ff, 0xff00ff00ff00ff, 0x5555555555555555,
                    0x01010101, 0x7fff, 0xf0f0f0f0f0f0f0f, 0x3333333333333333];
    let i int = 0;
    for i < 8 {
        let v i64 = t[i].to_type(i64);
        let is64 int = 1;
        if (t[i] < 0x100000000) { is64 = 0; }
        let pk int = bi_encode(v, is64);
        if (pk < 0) { return 30; }
        if (bi_pattern(pk, is64) != t[i]) { return 31; }
        i += 1;
    }

    // 条件码
    let s *u8 = "b.eq xx".to_type(*u8);
    if (cond_code(s, 2, 4) != 0) { return 32; }
    if (cond_code(s, 3, 4) >= 0) { return 33; }
    if (cond_code(s, 0, 2) >= 0) { return 34; }
    let s2 *u8 = "cs".to_type(*u8);
    if (cond_code(s2, 0, 2) != 2) { return 35; }

    // 移位助记符
    let s3 *u8 = "lsl".to_type(*u8);
    if (sh_kind(s3, 0, 3) != SH_LSL) { return 36; }

    return 0;
}

// —— 汇编端到端自检 ——

// as_word：读出 .text 第 off 个机器字。
fn as_word(c *obj.Ctx, off int) i64 {
    let si int = obj.ctx_find_sec(c, ".text");
    if (si < 0) {
        return -1;
    }
    return obj.rd_u32le(c.secs[si].data.data, off).to_type(i64);
}

// as_reloc：检查第 i 条重定位的节、偏移与类型；符号必须叫 name。
fn as_reloc(c *obj.Ctx, i int, sec int, off int, kind int, name *char) int {
    if (i >= c.nrel) { return 0; }
    let r obj.Reloc = c.rels[i];
    if (r.sec != sec) { return 0; }
    if (r.offset != off) { return 0; }
    if (r.kind != kind.to_type(u32)) { return 0; }
    if (obj.ctx_find_sym(c, name) != r.sym) { return 0; }
    return 1;
}

// asm_selftest：把一段固定源码走完「扫描 → 解析 → 回填 → 重定位」，逐条核对
// 机器字与重定位表。编码层自检覆盖不到 ADRP 的操作码保留、访存 lo12 的宽度
// 移位、sp 参与的加减改用扩展形式这几处，都在这一层验。
// 返回 0 通过，返回 1..N 定位失败项。
pub fn asm_selftest() int {
    let src *u8 = "\t.text\n\t.globl\t_f\n_f:\n\tadrp\tx2, _u@GOTPAGE\n\tldr\tx2, [x2, _u@GOTPAGEOFF]\n\tadrp\tx0, _u@PAGE\n\tadd\tx0, x0, _u@PAGEOFF\n\tldr\tx0, [x0, _u@PAGEOFF]\n\tbl\t_u\n\tsub\tsp, sp, x9\n\tadd\tsp, sp, x0\n\tuxtw\tx27, w27\n\tb.lo\t.L1\n\tmov\tx0, x0\n.L1:\n\tadrp\tx1, .L2@PAGE\n\tadd\tx1, x1, .L2@PAGEOFF\n\tldr\tx1, [x1, .L2@PAGEOFF]\n\tret\n.L2:\n\tret\n".to_type(*u8);
    let ts obj.TargetSpec = obj.ts_default();
    let c obj.Ctx;
    let bad int = 0;
    if (obj.ctx_init(&c, &ts, "selftest".to_type(*char)) != 0) {
        return 1;
    }
    let n int = obj.cstr_len(src.to_type(*char));
    bad = asm_parse(&c, src, n);
    if (bad == 0) {
        bad = asm_assemble(&c);
    }
    if (bad != 0) {
        obj.ctx_free(&c);
        return 2;
    }

    // 机器字
    // 只有 b.lo 是同节分支、被汇编期回填；页寻址与 @PAGEOFF 一律留重定位，
    // 位域保持 0，等链接器按最终节地址填。
    let want [16]i64 = [0x90000002, 0xf9400042, 0x90000000, 0x91000000,
                        0xf9400000, 0x94000000, 0xcb2963ff, 0x8b2063ff,
                        0xd3407f7b, 0x54000043, 0xaa0003e0, 0x90000001,
                        0x91000021, 0xf9400021, 0xd65f03c0, 0xd65f03c0];
    let i int = 0;
    for i < 16 {
        let off int = i * 4;
        if (as_word(&c, off) != want[i]) {
            obj.ctx_free(&c);
            return 10 + i;
        }
        i += 1;
    }

    // 重定位：GOT 两条、_u 四条（未定义）、.L2 三条（已定义的局部符号）。
    // 局部符号同样要出重定位——它的页偏移/低 12 位取决于节的最终地址；
    // GOT 两类更晚，汇编期连 GOT 项都不存在，只能留给链接器。
    let kinds [9]i64 = [311, 312, 275, 277, 286, 283, 275, 277, 286];
    let offs [9]i64 = [0, 4, 8, 12, 16, 20, 44, 48, 52];
    for i < 9 {
        let want *char = "_u".to_type(*char);
        if (i >= 6) {
            want = ".L2".to_type(*char);
        }
        if (as_reloc(&c, i, 1, offs[i].to_type(int), kinds[i].to_type(int),
                     want) == 0) {
            obj.ctx_free(&c);
            return 30 + i;
        }
        i += 1;
    }
    if (c.nrel != 9) {
        obj.ctx_free(&c);
        return 34;
    }

    obj.ctx_free(&c);
    return 0;
}
