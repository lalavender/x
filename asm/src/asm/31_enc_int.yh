module asm;

// ============================================================================
// asm/enc_int.yh —— AArch64 整数数据处理编码（冻结子集）
//
// 每个函数返回 32 位机器字，失败返回 -1。函数只做编码与范围判断，不解析
// 语法、不报诊断；助记符到本层形态的选择由 parse.yh 负责。
//
// 位域布局（ARM ARM，每条指令的位段已与 llvm-mc 逐条核对）：
//   加减立即   sf op S 100010 sh imm12 Rn Rd
//   加减移位   sf op S 01011 shift 0 Rm imm6 Rn Rd
//   加减扩展   sf op S 01011 00 1 Rm option imm3 Rn Rd
//   逻辑立即   sf opc 100100 N immr imms Rn Rd
//   逻辑移位   sf opc 01010 shift N Rm imm6 Rn Rd
//   宽位搬运   sf opc 100101 hw imm16 Rd
//   位域       sf opc 100110 N immr imms Rn Rd
//   乘加       sf 00 11011 000 Rm o0 Ra Rn Rd
//   二元运算   sf 0 S 11010110 Rm opcode Rn Rd
//   条件选择   sf op S 11010100 Rm cond op2 Rn Rd
// ============================================================================

// —— 操作码常量 ——

pub const OP_AND int = 0;
pub const OP_ORR int = 1;
pub const OP_EOR int = 2;
pub const OP_ANDS int = 3;
pub const OP_BIC int = 4;   // 逻辑移位形式，opc=00 且 N=1
pub const OP_BICS int = 5;  // 逻辑移位形式，opc=11 且 N=1
pub const OP_ORN int = 6;   // 逻辑移位形式，opc=01 且 N=1（mvn 的底层形式）

pub const OP_SBFM int = 0;
pub const OP_BFM int = 1;
pub const OP_UBFM int = 2;

pub const OP_CSINC int = 1;
pub const OP_CSINV int = 2;

// EXT 扩展方式
pub const EXT_UXTB int = 0;
pub const EXT_UXTH int = 1;
pub const EXT_UXTW int = 2;
pub const EXT_UXTX int = 3;
pub const EXT_SXTB int = 4;
pub const EXT_SXTH int = 5;
pub const EXT_SXTW int = 6;
pub const EXT_SXTX int = 7;

// 错误哨兵：0xFFFFFFFF 是 UDF（未定义指令），任何合法编码都不会命中它
pub const ENC_BAD i64 = -1;

// —— 加减 ——

// e_addsub_imm：加减立即数。sub=1 取 SUB，setflags=1 置 S。
// shbit=1 表示用「LSR/ASR #12」扩展形式（shift 必须为 0）。
pub fn e_addsub_imm(sf int, sub int, setflags int, shbit int, rd int, rn int,
                    imm i64) i64 {
    if (imm < 0 || imm > 0xfff) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let w u32 = 0x11000000;
    if (sub != 0) { w = 0x51000000; }
    if (setflags != 0) { w = w | 0x20000000; }
    if (shbit != 0) { w = w | (1.to_type(u32) << 22.to_type(u32)); }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 10, 12, imm.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_addsub_reg：加减移位寄存器。shift 取 SH_*；ROR 不允许（走 EXTR）。
pub fn e_addsub_reg(sf int, sub int, setflags int, shift int, shamt i64,
                    rd int, rn int, rm int) i64 {
    if (shift == SH_ROR) {
        return ENC_BAD;
    }
    let maxsh i64 = 63;
    if (sf == 0) { maxsh = 31; }
    if (shamt < 0 || shamt > maxsh) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm)) {
        return ENC_BAD;
    }
    let w u32 = 0x0b000000;
    if (sub != 0) { w = 0x4b000000; }
    if (setflags != 0) { w = w | 0x20000000; }
    if (sf != 0) { w = w | 0x80000000; }
    w = w | (shift.to_type(u32) << 22.to_type(u32));
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 10, 6, shamt.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_addsub_ext：加减扩展寄存器。ext 取 EXT_*，imm3 是字节位移量。
pub fn e_addsub_ext(sf int, sub int, setflags int, ext int, imm3 i64,
                    rd int, rn int, rm int) i64 {
    if (ext < 0 || ext > 7) {
        return ENC_BAD;
    }
    // 字节/半字扩展的位移最多 4；字及以上扩展最多 4
    if (imm3 < 0 || imm3 > 4) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm)) {
        return ENC_BAD;
    }
    let w u32 = 0x0b200000;
    if (sub != 0) { w = 0x4b200000; }
    if (setflags != 0) { w = w | 0x20000000; }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 13, 3, ext.to_type(u32));
    w = bset(w, 10, 3, imm3.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 逻辑 ——

// e_logical_imm：逻辑立即数。op 取 OP_AND/OP_ORR/OP_EOR/OP_ANDS。
// bic 立即数形式（and 带 N=1）不在冻结子集内，这里只支持四种基本 opc。
pub fn e_logical_imm(sf int, opc int, rd int, rn int, imm i64) i64 {
    if (opc < 0 || opc > 3) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let bi int = bi_encode(imm, sf);
    if (bi < 0) {
        return ENC_BAD;
    }
    let w u32 = 0x12000000;
    w = w | (opc.to_type(u32) << 29.to_type(u32));
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 22, 1, ((bi >> 12) & 1).to_type(u32));
    w = bset(w, 16, 6, ((bi >> 6) & 0x3f).to_type(u32));
    w = bset(w, 10, 6, (bi & 0x3f).to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_logical_reg：逻辑移位寄存器。op 取 OP_AND/OP_ORR/OP_EOR/OP_ANDS/OP_BIC/OP_BICS。
pub fn e_logical_reg(sf int, op int, shift int, shamt i64, rd int, rn int,
                     rm int) i64 {
    if (shift == SH_ROR) {
        return ENC_BAD;
    }
    let maxsh i64 = 63;
    if (sf == 0) { maxsh = 31; }
    if (shamt < 0 || shamt > maxsh) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm)) {
        return ENC_BAD;
    }
    let w u32 = 0x0a000000;
    let nb int = 0;
    if (op == OP_ORR) { w = 0x2a000000; }
    if (op == OP_EOR) { w = 0x4a000000; }
    if (op == OP_ANDS) { w = 0x6a000000; }
    if (op == OP_BIC || op == OP_BICS) {
        nb = 1;
        if (op == OP_BICS) { w = 0x6a000000; } else { w = 0x0a000000; }
    }
    if (op == OP_ORN) {
        nb = 1;
        w = 0x2a000000;
    }
    if (sf != 0) { w = w | 0x80000000; }
    w = w | (shift.to_type(u32) << 22.to_type(u32));
    if (nb != 0) { w = w | (1.to_type(u32) << 21.to_type(u32)); }
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 10, 6, shamt.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 宽位搬运 ——

// e_movw：MOVN/MOVZ/MOVK。op 取 0=MOVN 2=MOVZ 3=MOVK。
// hw 取 0..3（LSL #0/#16/#32/#48）。
pub fn e_movw(sf int, op int, hw int, rd int, imm16 i64) i64 {
    if (op < 0 || op > 3 || op == 1) {
        return ENC_BAD;
    }
    if (imm16 < 0 || imm16 > 0xffff) {
        return ENC_BAD;
    }
    if (hw < 0 || hw > 3) {
        return ENC_BAD;
    }
    if (sf == 0 && hw > 1) {
        return ENC_BAD;
    }
    if (!reg_ok(rd)) {
        return ENC_BAD;
    }
    let w u32 = 0x12800000;
    w = w | (op.to_type(u32) << 29.to_type(u32));
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 21, 2, hw.to_type(u32));
    w = bset(w, 5, 16, imm16.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 位域与扩展 ——

// e_bitfield：SBFM/BFM/UBFM。opc 取 OP_SBFM/OP_BFM/OP_UBFM。
pub fn e_bitfield(sf int, opc int, rd int, rn int, immr i64, imms i64) i64 {
    if (opc < 0 || opc > 2) {
        return ENC_BAD;
    }
    // 位域字段占 6 位，W 形式只用到低 5 位
    let top i64 = 63;
    if (sf == 0) { top = 31; }
    if (immr < 0 || immr > top || imms < 0 || imms > top) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let w u32 = 0x13000000;
    if (opc == OP_BFM) { w = 0x33000000; }
    if (opc == OP_UBFM) { w = 0x53000000; }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 22, 1, sf.to_type(u32));
    w = bset(w, 16, 6, immr.to_type(u32));
    w = bset(w, 10, 6, imms.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_lsl_imm：LSL 立即数的位域形式。shamt 取 0..63（W 形式 0..31）。
pub fn e_lsl_imm(sf int, rd int, rn int, shamt i64) i64 {
    let ds i64 = 64;
    if (sf == 0) { ds = 32; }
    if (shamt < 0 || shamt >= ds) {
        return ENC_BAD;
    }
    return e_bitfield(sf, OP_UBFM, rd, rn, (ds - shamt) % ds, ds - 1 - shamt);
}

// e_lsr_imm：LSR 立即数的位域形式。
pub fn e_lsr_imm(sf int, rd int, rn int, shamt i64) i64 {
    let ds i64 = 64;
    if (sf == 0) { ds = 32; }
    if (shamt < 1 || shamt >= ds) {
        return ENC_BAD;
    }
    return e_bitfield(sf, OP_UBFM, rd, rn, shamt, ds - 1);
}

// e_asr_imm：ASR 立即数的位域形式。
pub fn e_asr_imm(sf int, rd int, rn int, shamt i64) i64 {
    let ds i64 = 64;
    if (sf == 0) { ds = 32; }
    if (shamt < 1 || shamt >= ds) {
        return ENC_BAD;
    }
    return e_bitfield(sf, OP_SBFM, rd, rn, shamt, ds - 1);
}

// e_sbfx：SBFM 的字段抽取形式。lsb 与 width 都要在位宽内。
pub fn e_sbfx(sf int, rd int, rn int, lsb i64, width i64) i64 {
    let ds i64 = 64;
    if (sf == 0) { ds = 32; }
    if (lsb < 0 || width < 1 || lsb + width > ds) {
        return ENC_BAD;
    }
    return e_bitfield(sf, OP_SBFM, rd, rn, lsb, lsb + width - 1);
}

// —— 乘加 ——

// e_madd：MADD/MSUB（o0=0/1）。Ra 取 31 即 mul 的别名形式。
pub fn e_madd(sf int, sub int, rd int, rn int, rm int, ra int) i64 {
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm) || ra < 0 || ra > 31) {
        return ENC_BAD;
    }
    let w u32 = 0x1b000000;
    if (sub != 0) { w = w | (1.to_type(u32) << 15.to_type(u32)); }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 10, 5, ra.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 二元运算 ——

// e_binop：sf 0 S 11010110 Rm opcode Rn Rd。
// opcode 取值：UDIV=2 SDIV=3 LSLV=8 LSRV=9 ASRV=10 RORV=11
pub const BIN_UDIV int = 2;
pub const BIN_SDIV int = 3;
pub const BIN_LSLV int = 8;
pub const BIN_LSRV int = 9;
pub const BIN_ASRV int = 10;
pub const BIN_RORV int = 11;

pub fn e_binop(sf int, opcode int, rd int, rn int, rm int) i64 {
    if (opcode < 0 || opcode > 15) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm)) {
        return ENC_BAD;
    }
    let w u32 = 0x1ac00000;
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 10, 6, opcode.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// —— 条件选择 ——

// e_csel：CSEL/CSINC/CSINV/CSNEG。
// op 位 30：CSEL/CSINC 为 0，CSINV/CSNEG 为 1。
// op2 位 11:10：CSEL/CSINV 为 0，CSINC/CSNEG 为 1。
pub fn e_csel(sf int, inv int, inc int, rd int, rn int, rm int, cond int) i64 {
    if (cond < 0 || cond > 15) {
        return ENC_BAD;
    }
    if (!reg_ok(rd) || !reg_ok(rn) || !reg_ok(rm)) {
        return ENC_BAD;
    }
    let w u32 = 0x1a800000;
    if (inv != 0) { w = w | 0x40000000; }
    if (sf != 0) { w = w | 0x80000000; }
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 12, 4, cond.to_type(u32));
    if (inc != 0) { w = w | (1.to_type(u32) << 10.to_type(u32)); }
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}
