module asm;

import obj;

// ============================================================================
// asm/parse_dir.yh —— 语句循环与伪指令
//
// 一条语句的判定顺序（顺序本身就是语法）：
//   1. 空语句（`;`）直接跳过；
//   2. IDENT 或 . 开头且紧跟冒号 → 标签定义；
//   3. . 开头 → 伪指令；
//   4. 字母开头 → 指令；
//   5. 其余一律报错。
//
// 判定「标签还是伪指令」只看去掉冒号前的那个 token 和下一个 token 是否是
// 冒号：`.L1:` 是标签，`.text` 是伪指令，两者词法上都是 . 开头的词元，
// 但位置不同，不会歧义。
// ============================================================================

// p_directive：解析一条伪指令。
fn p_directive(p *Parser) int {
    if (p_is_dir(p, ".text") != 0) {
        p_adv(p);
        p.sec = sec_text(p.ctx);
        return 0;
    }
    if (p_is_dir(p, ".data") != 0) {
        p_adv(p);
        p.sec = sec_data(p.ctx);
        return 0;
    }
    if (p_is_dir(p, ".bss") != 0) {
        p_adv(p);
        p.sec = sec_bss(p.ctx);
        return 0;
    }
    if (p_is_dir(p, ".section") != 0) {
        p_adv(p);
        if (p_peek(p) != TK_DIR) {
            return p_err(p, ".section 后面需要一个节名");
        }
        if (p_is_dir(p, ".rodata") != 0) {
            p_adv(p);
            p.sec = sec_rodata(p.ctx);
            return 0;
        }
        return p_err(p, ".section 只支持 .rodata");
    }
    if (p_is_dir(p, ".globl") != 0 || p_is_dir(p, ".global") != 0) {
        p_adv(p);
        return p_binding(p, obj.SYM_GLOBAL);
    }
    if (p_is_dir(p, ".local") != 0) {
        p_adv(p);
        return p_binding(p, obj.SYM_LOCAL);
    }
    if (p_is_dir(p, ".balign") != 0) {
        p_adv(p);
        let v i64 = 0;
        if (p_expr_num(p, &v) != 0) { return -1; }
        // 契约 §8：.balign 的 N 是字节数且必须是 2 的幂。不做这一步时
        // 非 2 的幂会一路走到 sec_pad_to 以 -1 返回，只有退出码没有诊断。
        if (v > 1 && (v & (v - 1)) != 0) {
            return p_err(p, ".balign 的对齐必须是 2 的幂");
        }
        return p_align(p, v.to_type(int), p_fill(p));
    }
    if (p_is_dir(p, ".p2align") != 0) {
        p_adv(p);
        let v i64 = 0;
        if (p_expr_num(p, &v) != 0) { return -1; }
        if (v < 0 || v > 16) {
            return p_err(p, ".p2align 的指数必须在 0..16");
        }
        return p_align(p, 1 << v.to_type(int), p_fill(p));
    }
    if (p_is_dir(p, ".zero") != 0 || p_is_dir(p, ".skip") != 0) {
        p_adv(p);
        let v i64 = 0;
        if (p_expr_num(p, &v) != 0) { return -1; }
        return p_skip(p, v);
    }
    if (p_is_dir(p, ".byte") != 0) {
        p_adv(p);
        return p_emit_list(p, 1, 0);
    }
    if (p_is_dir(p, ".hword") != 0) {
        p_adv(p);
        return p_emit_list(p, 2, 0);
    }
    if (p_is_dir(p, ".word") != 0) {
        p_adv(p);
        return p_emit_list(p, 4, 0);
    }
    if (p_is_dir(p, ".xword") != 0 || p_is_dir(p, ".quad") != 0) {
        p_adv(p);
        return p_emit_list(p, 8, 1);
    }
    if (p_is_dir(p, ".type") != 0) {
        p_adv(p);
        return p_type(p);
    }
    if (p_is_dir(p, ".size") != 0) {
        p_adv(p);
        return p_size(p);
    }
    return p_err(p, "未知伪指令");
}

// p_fill：对齐填充字节。代码节用 NOP 填充，其余用 0。
fn p_fill(p *Parser) u8 {
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        return 0;
    }
    if (obj.cstr_eq(obj.sec_name(p.ctx, p.sec), ".text") != 0) {
        return 0x1f;
    }
    return 0;
}

// p_binding：.globl/.global/.local 共用：把下一个名字的绑定改成 b。
fn p_binding(p *Parser, b int) int {
    if (p_peek(p) != TK_IDENT && p_peek(p) != TK_DIR) {
        return p_err(p, "此处需要一个符号名");
    }
    let nm *char = p_take_name(p);
    let id int = obj.ctx_find_sym(p.ctx, nm);
    if (id < 0) {
        if (p_add_fix_sym(p, nm, b) != 0) { return -1; }
        return 0;
    }
    // 已经是未定义引用时只改绑定；已有定义时保留原绑定。
    if (b == obj.SYM_GLOBAL) {
        p.ctx.syms[id].binding = obj.SYM_GLOBAL;
    } else if (p.ctx.syms[id].binding == obj.SYM_UNDEF) {
        p.ctx.syms[id].binding = obj.SYM_LOCAL;
    }
    return 0;
}

// p_add_fix_sym：登记一个新符号并设置绑定，供暂存串被覆盖前立刻用掉。
fn p_add_fix_sym(p *Parser, nm *char, b int) int {
    let local int = 0;
    if (nm[0] == '.') { local = 1; }
    let bind int = b;
    if (local != 0 && b == obj.SYM_GLOBAL) {
        bind = obj.SYM_GLOBAL;
    }
    let id int = obj.ctx_add_sym(p.ctx, nm, bind, obj.SYM_NOTYPE);
    if (id < 0) {
        return p_err(p, "符号过多");
    }
    return 0;
}

// p_skip：.zero/.skip —— 前进 n 字节，不改变内容语义（零填充）。
fn p_skip(p *Parser, n i64) int {
    if (n < 0) {
        return p_err(p, ".zero 的长度不能为负");
    }
    if (n == 0) {
        return 0;
    }
    if (obj.sec_is_nobits(&p.ctx.secs[p.sec]) != 0) {
        if (obj.sec_grow_memsz(p.ctx, p.sec, n.to_type(int)) < 0) {
            return -1;
        }
        return 0;
    }
    let i int = 0;
    for i < n.to_type(int) {
        if (p_emit8(p, 0) < 0) { return -1; }
        i += 1;
    }
    return 0;
}

// p_emit_list：输出常量列表，每项 width 字节。wide=1 时允许符号（转 ABS64
// 重定位），宽数据项按小端截断。
fn p_emit_list(p *Parser, width int, wide int) int {
    let count int = 0;
    for {
        let e Expr;
        if (p_expr(p, &e) != 0) { return -1; }
        if (e.kind == EX_NUM) {
            let v i64 = e.val;
            if (e.neg != 0) { v = -v; }
            if (p_put_num(p, v, width) != 0) { return -1; }
            count += 1;
        } else {
            if (wide == 0) {
                return p_err(p, "该常量列表项只能是数字");
            }
            let off int = p_here(p);
            if (p_put_num(p, 0, 8) != 0) { return -1; }
            if (p_push_fix(p, FIX_ABS64, off, e.sym, 0) != 0) { return -1; }
            count += 1;
        }
        if (p_peek(p) != TK_COMMA) {
            break;
        }
        p_adv(p);
    }
    if (count == 0) {
        return p_err(p, "常量列表不能为空");
    }
    return 0;
}

// p_put_num：按 width 字节小端写入一个常量（超宽部分被截断，与 GNU as 一致）。
fn p_put_num(p *Parser, v i64, width int) int {
    let i int = 0;
    for i < width {
        let b u8 = (v & 255).to_type(u64).to_type(u8);
        if (p_emit8(p, b.to_type(i64)) < 0) { return -1; }
        v = v >> 8.to_type(i64);
        i += 1;
    }
    return 0;
}

// p_type：.type name, %function|%object。
fn p_type(p *Parser) int {
    if (p_peek(p) != TK_IDENT && p_peek(p) != TK_DIR) {
        return p_err(p, ".type 后面需要一个符号名");
    }
    let nm *char = p_take_name(p);
    if (p_comma(p) != 0) { return -1; }
    if (p_peek(p) != TK_PERCENT) {
        return p_err(p, ".type 需要 %function 或 %object");
    }
    p_adv(p);
    let ty int = obj.SYM_NOTYPE;
    if (p_is_mn(p, "function") != 0) {
        ty = obj.SYM_FUNC;
    } else if (p_is_mn(p, "object") != 0) {
        ty = obj.SYM_OBJECT;
    } else {
        return p_err(p, ".type 只支持 %function 与 %object");
    }
    p_adv(p);
    return p_set_type(p, nm, ty);
}

// p_size：.size name, expr（首版只接受纯数字）。
fn p_size(p *Parser) int {
    if (p_peek(p) != TK_IDENT && p_peek(p) != TK_DIR) {
        return p_err(p, ".size 后面需要一个符号名");
    }
    let nm *char = p_take_name(p);
    if (p_comma(p) != 0) { return -1; }
    let v i64 = 0;
    if (p_expr_num(p, &v) != 0) { return -1; }
    return p_set_size(p, nm, v);
}

// p_stmt_end：确认语句已经结束。
// 语句以换行或 `;` 分隔，所以只在本行内还有残留记号时才算多余；下一行的
// token 属于下一条语句，由 p_run 的下一轮处理。
fn p_stmt_end(p *Parser, start_line int) int {
    let k int = p_peek(p);
    if (k == TK_SEMI || k == TK_END) {
        return 0;
    }
    if (p_line(p) != start_line) {
        return 0;
    }
    return p_err(p, "指令后有多余的记号");
}

// p_run：主循环。返回 0 成功，-1 失败。
fn p_run(p *Parser) int {
    for {
        let k int = p_peek(p);
        if (k == TK_END) {
            break;
        }
        if (k == TK_SEMI) {
            p_adv(p);
            continue;
        }
        if (k == TK_IDENT || k == TK_DIR) {
            let ln int = p_line(p);
            if (p_kind(p, p.i + 1) == TK_COLON) {
                let nm *char = p_take_name(p);
                p_adv(p);
                if (p_label(p, nm) != 0) { return -1; }
                continue;
            }
            if (k == TK_DIR) {
                if (p_directive(p) != 0) { return -1; }
                if (p_stmt_end(p, ln) != 0) { return -1; }
                continue;
            }
            if (p_instruction(p) != 0) { return -1; }
            if (p_stmt_end(p, ln) != 0) { return -1; }
            continue;
        }
        if (p_err(p, "无法识别的语句开头") != 0) { return -1; }
    }
    return 0;
}
