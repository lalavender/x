module asm;

// ============================================================================
// asm/enc_fp.yh —— 标量浮点编码（v1 子集）
//
// 覆盖范围由语料实测决定，只有这几族：
//
//   fadd fsub fmul fdiv  Vd, Vn, Vm     三源算术
//   fcmp                 Vn, Vm         比较
//   fcvt                 Vd, Vn         s 与 d 互转
//   fcvtzs               Rd, Vn         浮点 → 整数（向零取整）
//   scvtf                Vd, Rn         整数 → 浮点
//   fmov                 Vd, Rn         通用寄存器 → 浮点寄存器
//
// 位布局全部由 llvm-mc 实测反推（--show-encoding 逐条对照），不是凭记忆写
// 手册位域。三类字段位置在各族里是一致的：Rd 在 4:0、Rn 在 9:5、Rm 在 20:16。
//
// 不支持的形态（fmov 寄存器间搬移、fabs/fneg、fcvt 带舍入模式、带 #0.0 的
// fcmp 等）一律报诊断，不静默按近似形态编码。
// ============================================================================

// e_farith：fadd/fsub/fmul/fdiv Vd, Vn, Vm。
// op 取 0=fmul 1=fdiv 2=fadd 3=fsub（实测位 15:12）；dbl=1 表示双精度。
pub fn e_farith(op int, dbl int, rd int, rn int, rm int) i64 {
    if (op < 0 || op > 3) { return ENC_BAD; }
    let w u32 = 0x1e200800;
    w = bset(w, 22, 1, dbl.to_type(u32));
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 12, 4, op.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_fcmp：fcmp Vn, Vm。位 13 置 1 表示「有信号」还是「无信号」之外的形态区分，
// 实测 fcmp 取 1（fcmp 的等价写法 fcmpe 取 0，本子集不支持）。
pub fn e_fcmp(dbl int, rn int, rm int) i64 {
    let w u32 = 0x1e202000;
    w = bset(w, 22, 1, dbl.to_type(u32));
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    return w.to_type(i64);
}

// e_fcvt：fcvt Vd, Vn，s 与 d 互转。
// 源类型决定位 22，目的类型决定位 15（实测两向编码只差这两位）。
pub fn e_fcvt(src_dbl int, dst_dbl int, rd int, rn int) i64 {
    let w u32 = 0x1e224000;
    w = bset(w, 22, 1, src_dbl.to_type(u32));
    w = bset(w, 15, 1, dst_dbl.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_fcvtzs：fcvtzs Rd, Vn，浮点转整数（向零取整）。
// 位 31 = 目的宽度（1 表示 64 位 X），位 22 = 源是双精度。
pub fn e_fcvtzs(dst64 int, src_dbl int, rd int, rn int) i64 {
    let w u32 = 0x1e380000;
    w = bset(w, 31, 1, dst64.to_type(u32));
    w = bset(w, 22, 1, src_dbl.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_scvtf：scvtf Vd, Rn，整数转浮点。位 31 = 源宽度，位 22 = 目的是双精度。
pub fn e_scvtf(src64 int, dst_dbl int, rd int, rn int) i64 {
    let w u32 = 0x1e220000;
    w = bset(w, 31, 1, src64.to_type(u32));
    w = bset(w, 22, 1, dst_dbl.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_ucvtf：ucvtf Vd, Rn，无符号整数转标量浮点。与 e_scvtf 同构，基址多
// 了 bit16（0x1e220000 → 0x1e230000）。
pub fn e_ucvtf(src64 int, dst_dbl int, rd int, rn int) i64 {
    let w u32 = 0x1e230000;
    w = bset(w, 31, 1, src64.to_type(u32));
    w = bset(w, 22, 1, dst_dbl.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}

// e_fmov_g：fmov Vd, Rn，通用寄存器搬到浮点寄存器（位模式复制，不做数值转换）。
pub fn e_fmov_g(src64 int, dst_dbl int, rd int, rn int) i64 {
    let w u32 = 0x1e270000;
    w = bset(w, 31, 1, src64.to_type(u32));
    w = bset(w, 22, 1, dst_dbl.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rd.to_type(u32));
    return w.to_type(i64);
}
