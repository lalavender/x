module asm;

// ============================================================================
// asm/enc_mem.yh —— AArch64 访存指令编码（冻结子集）
//
// 覆盖四种寻址形态。每个位段都用 llvm-mc 逐条比对过（tmp/pair.py、
// tmp/fields2.py 的输出就是核对记录）：
//
//   无符号立即  size(31:30) 111(29:27) V(26) 01(25:24) opc(23:22) 0(21)
//               imm12(20:10) Rn(9:5) Rt(4:0)      imm12 = 位移 / 访问宽度
//   非缩放写回  size 111 V 00(25:24) opc 0 imm9(20:12) mode(11:10) Rn Rt
//               mode: 01 后索引 / 11 前索引；imm9 是字节位移，不缩放
//   寄存器偏移  size 111 V 0(25) 0(24) opc(22:21) 1(21)
//               Rm(20:16) option(15:13) S(12) 10(11:10) Rn Rt
//               option 是索引扩展方式；S 表示「左移 log2(访问宽度)」
//   成对访存    opc(31:30) 101(29:27) V(26) xx(25:24) m(23) L(22)
//               imm7(21:15) Rt2(14:10) Rn(9:5) Rt(4:0)
//               xx=01 且 m=L 是偏移式，xx=01 且 m=1 是前索引，xx=00 且 m=1 是后索引；
//               imm7 是缩放后的 7 位有符号位移，三种形态共用同一个字段
// ============================================================================

// —— 访问宽度与操作码 ——

// e_mem_kind：把「访问宽度 + 是否符号扩展 + 目的宽度」折叠成打包的
// (size << 8) | opc。size: 0=字节 1=半字 2=字 3=双字。
//   wide: 0=装入 32 位 1=装入 64 位。非法组合返回 -1。
pub fn e_mem_kind(size int, is_signed int, wide int) i64 {
    let opc int = 0;
    if (size == 3) {
        // 双字只支持零扩展
        if (is_signed != 0) { return -1; }
        opc = 1;
    } else if (size == 2) {
        if (is_signed != 0) {
            // ldrsw：opc=10，装入 64 位
            if (wide == 0) { return -1; }
            opc = 2;
        } else {
            if (wide != 0) { return -1; }
            opc = 1;
        }
    } else if (size == 1) {
        // 半字：零扩展只到 32 位，符号扩展 opc=10 到 64 位
        if (is_signed != 0) {
            if (wide == 0) { return -1; }
            opc = 2;
        } else {
            if (wide != 0) { return -1; }
            opc = 1;
        }
    } else if (size == 0) {
        // 字节：零扩展只到 32 位；符号扩展 opc=10 到 64 位、11 到 32 位
        if (is_signed != 0) {
            if (wide != 0) {
                opc = 2;
            } else {
                opc = 3;
            }
        } else {
            if (wide != 0) { return -1; }
            opc = 1;
        }
    } else {
        return -1;
    }
    return ((size << 8) | opc).to_type(i64);
}

// e_mem_store：存储形态的打包 kind（opc=0）。size 含义同 e_mem_kind。
pub fn e_mem_store(size int) i64 {
    if (size < 0 || size > 3) {
        return -1;
    }
    return (size << 8).to_type(i64);
}

// e_loadstore_imm：无符号立即数形式。disp 必须是非负的访问宽度倍数。
pub fn e_loadstore_imm(kind i64, rt int, rn int, disp i64) i64 {
    if (kind < 0) {
        return ENC_BAD;
    }
    let size int = (kind >> 8).to_type(i64).to_type(int);
    let opc int = (kind & 0xff).to_type(i64).to_type(int);
    if (!reg_ok(rt) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let scale i64 = 1 << size;
    if (disp < 0 || disp > 0xfff * scale || (disp % scale) != 0) {
        return ENC_BAD;
    }
    let w u32 = 0x39000000;
    w = bset(w, 30, 2, size.to_type(u32));
    w = bset(w, 22, 2, opc.to_type(u32));
    w = bset(w, 10, 12, (disp / scale).to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    return w.to_type(i64);
}

// e_loadstore_wb：单寄存器非缩放立即数形式。mode 取 0=不写回（LDUR/STUR）
// 1=后索引 3=前索引。imm9 是字节位移（不按访问宽度缩放），但仍要求自然对齐。
pub fn e_loadstore_wb(kind i64, rt int, rn int, disp i64, mode int) i64 {
    if (kind < 0) {
        return ENC_BAD;
    }
    if (mode != 0 && mode != 1 && mode != 3) {
        return ENC_BAD;
    }
    let size int = (kind >> 8).to_type(i64).to_type(int);
    let opc int = (kind & 0xff).to_type(i64).to_type(int);
    if (!reg_ok(rt) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    if ((disp % (1 << size)) != 0) {
        return ENC_BAD;
    }
    if (disp < -256 || disp > 255) {
        return ENC_BAD;
    }
    let uimm i64 = 0;
    if (disp < 0) {
        uimm = disp + 512;
    } else {
        uimm = disp;
    }
    let w u32 = 0x38000000;
    w = bset(w, 30, 2, size.to_type(u32));
    w = bset(w, 22, 2, opc.to_type(u32));
    w = bset(w, 12, 9, uimm.to_type(u32));
    w = bset(w, 10, 2, mode.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    return w.to_type(i64);
}

// e_loadstore_reg：寄存器偏移形式。ext 取 EXT_*；shift 只能取 0 或
// log2(访问宽度)（硬件只有这两档），越界返回 -1。
pub fn e_loadstore_reg(kind i64, rt int, rn int, rm int, ext int, shift int) i64 {
    if (kind < 0) {
        return ENC_BAD;
    }
    if (ext < 0 || ext > 7 || rm < 0 || rm > 31) {
        return ENC_BAD;
    }
    if (!reg_ok(rt) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let size int = (kind >> 8).to_type(i64).to_type(int);
    let opc int = (kind & 0xff).to_type(i64).to_type(int);
    if (shift != 0 && shift != size) {
        return ENC_BAD;
    }
    let w u32 = 0x38200000;
    w = bset(w, 30, 2, size.to_type(u32));
    w = bset(w, 22, 2, opc.to_type(u32));
    w = bset(w, 16, 5, rm.to_type(u32));
    w = bset(w, 13, 3, ext.to_type(u32));
    if (shift != 0) {
        w = w | (1.to_type(u32) << 12.to_type(u32));
    }
    w = bset(w, 10, 2, 2.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    return w.to_type(i64);
}

// —— 成对访存 ——

pub const PAIR_32 int = 0;   // opc = 00，32 位元素
pub const PAIR_SW int = 1;   // opc = 01，ldpsw
pub const PAIR_64 int = 2;   // opc = 10，64 位元素

// e_pair_off：成对访存的偏移形式。位移按元素宽度缩放后放进 7 位有符号字段。
pub fn e_pair_off(opc int, load int, rt int, rt2 int, rn int, disp i64) i64 {
    return pair_enc(opc, load, rt, rt2, rn, disp, 0);
}

// e_pair_idx：成对访存的写回形式。mode 取 2=前索引 3=后索引。
pub fn e_pair_idx(opc int, load int, rt int, rt2 int, rn int, disp i64,
                  mode int) i64 {
    if (mode != 2 && mode != 3) {
        return ENC_BAD;
    }
    return pair_enc(opc, load, rt, rt2, rn, disp, mode);
}

// pair_enc：成对访存统一编码。mode=0 偏移、2 前索引、3 后索引。
fn pair_enc(opc int, load int, rt int, rt2 int, rn int, disp i64, mode int) i64 {
    if (opc < 0 || opc > 2) {
        return ENC_BAD;
    }
    if (opc == PAIR_SW && (load == 0 || mode != 0)) {
        return ENC_BAD;  // ldpsw 只有偏移形式
    }
    if (!reg_ok(rt) || !reg_ok(rt2) || !reg_ok(rn)) {
        return ENC_BAD;
    }
    let scale i64 = 4;
    if (opc == PAIR_64) { scale = 8; }
    if ((disp % scale) != 0) {
        return ENC_BAD;
    }
    let imm i64 = disp / scale;
    if (imm < -64 || imm > 63) {
        return ENC_BAD;
    }
    let uimm i64 = 0;
    if (imm < 0) {
        uimm = imm + 128;
    } else {
        uimm = imm;
    }
    let w u32 = 0x28000000;
    w = bset(w, 30, 2, opc.to_type(u32));
    w = bset(w, 15, 7, uimm.to_type(u32));
    w = bset(w, 10, 5, rt2.to_type(u32));
    w = bset(w, 5, 5, rn.to_type(u32));
    w = bset(w, 0, 5, rt.to_type(u32));
    if (load != 0) {
        w = w | (1.to_type(u32) << 22.to_type(u32));
    }
    // bit23 只区分「写回 / 不写回」，装入方向由 bit22 单独表达：
    //   偏移式  bit24=1 bit23=0；前索引 bit24=1 bit23=1；后索引 bit24=0 bit23=1
    if (mode == 2) {
        w = w | 0x01800000;
    } else if (mode == 3) {
        w = w | 0x00800000;
    } else {
        w = w | 0x01000000;
    }
    return w.to_type(i64);
}