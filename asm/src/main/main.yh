module main;

// ============================================================================
// main/main.yh —— yh_asm 命令行入口
//
// 用法：
//   yh_asm                     跑自检（无参数时的默认行为）
//   yh_asm --dump-enc          把编码用例按「文本<TAB>机器字」打到 stdout，
//                               交给 tests/check_enc.py 与 llvm-mc 对比
//   yh_asm asm -o out.o in.s   汇编单个 .s，输出 ELF64 ET_REL 对象
// ============================================================================

import asm;
import obj;

// main：入口。`asm` 子命令走汇编流程，其余走自检。
fn main(argc int, argv **char) int {
    if (argc > 1) {
        if (obj.cstr_eq(argv[1], "asm") != 0) {
            return cmd_asm(argc, argv);
        }
        if (obj.cstr_eq(argv[1], "--dump-enc") != 0) {
            return selftest(1);
        }
    }
    return selftest(0);
}

// selftest：公共层自检 + 编码器自检 + 汇编端到端自检 + 拒绝层自检。
// 退出码 0 表示全部通过。
fn selftest(dump int) int {
    let rc int = asm.scan_selftest();
    if (rc != 0) {
        return rc;
    }
    rc = asm.enc_selftest(dump);
    if (rc != 0) {
        return rc;
    }
    rc = asm.asm_selftest();
    if (rc != 0) {
        return rc;
    }
    return asm.neg_selftest();
}

// read_all：把整个文件读进堆缓冲，末尾补一个 NUL。失败返回 -1。
// 读法与编译器 gen.read_source 一致：倍增缓冲，read 返回 0 即 EOF。
fn read_all(path *char, out **u8, olen *int) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return -1;
    }
    let cap int = 65536;
    let p *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (p == 0) {
        close(fd);
        return -1;
    }
    let n int = 0;
    for 1 {
        if (cap - n < 8192) {
            let q *u8 = malloc((cap * 2).to_type(u64)).to_type(*u8);
            if (q == 0) {
                close(fd);
                free(p);
                return -1;
            }
            memcpy(q, p, n.to_type(u64));
            free(p);
            p = q;
            cap = cap * 2;
        }
        let r i64 = read(fd, p + n, (cap - n).to_type(u64));
        if (r < 0) {
            close(fd);
            free(p);
            return -1;
        }
        if (r == 0) {
            break;
        }
        n += r.to_type(int);
    }
    close(fd);
    p[n] = 0;
    out[0] = p;
    olen[0] = n;
    return 0;
}

// host_darwin：**宿主**平台探测——macOS 独有的系统 plist，Linux 无此路径。
// 与输出目标（-t linux/darwin）无关：open 旗标必须按宿主内核语义取值。
fn host_darwin() int {
    let fd int = open("/System/Library/CoreServices/SystemVersion.plist", 0);
    if (fd >= 0) {
        close(fd);
        return 1;
    }
    return 0;
}

// host_write_flags：O_WRONLY|O_CREAT|O_TRUNC 的宿主数值（Linux 0x241，
// Darwin 0x601）。此前按**目标**取：在 Linux 宿主上开 -t darwin 时用的是
// Darwin 的 0x601，而 Linux 内核把 0x601 解释成 O_WRONLY|O_TRUNC|O_APPEND，
// 没有 O_CREAT——目标文件不存在时 open 直接失败，交叉汇编写不出对象。
fn host_write_flags() int {
    if (host_darwin() != 0) {
        return 0x601;
    }
    return 0x241;
}

// write_all：把缓冲写到路径（O_WRONLY|O_CREAT|O_TRUNC，0644）。
// 旗标取宿主值（见 host_write_flags），不随 -t 目标变化。
fn write_all(path *char, p *u8, n int) int {
    let fd int = open(path, host_write_flags(), 0x1a4);
    if (fd < 0) {
        return -1;
    }
    let done int = 0;
    for done < n {
        let w i64 = write(fd, p + done, (n - done).to_type(u64));
        if (w <= 0) {
            close(fd);
            return -1;
        }
        done += w.to_type(int);
    }
    close(fd);
    return 0;
}

// cmd_asm：汇编子命令，参数形如 `asm [-t darwin] -o out.o in.s`。
// -t 选目标：linux（默认，发 ELF64）与 darwin（发 Mach-O 64）。
fn cmd_asm(argc int, argv **char) int {
    let outp *char = 0;
    let inp *char = 0;
    let darwin int = 0;
    let i int = 2;
    for (i < argc) {
        if (obj.cstr_eq(argv[i], "-t") != 0 && i + 1 < argc) {
            if (obj.cstr_eq(argv[i + 1], "darwin") != 0) {
                darwin = 1;
            } else if (obj.cstr_eq(argv[i + 1], "linux") != 0) {
                darwin = 0;
            } else {
                write(2, "未知目标: ".to_type(*u8), 15);
                return usage();
            }
            i += 2;
            continue;
        }
        if (obj.cstr_eq(argv[i], "-o") != 0 && i + 1 < argc) {
            outp = argv[i + 1];
            i += 2;
            continue;
        }
        inp = argv[i];
        i += 1;
    }
    if (inp == 0 || outp == 0) {
        return usage();
    }
    let src *u8 = 0;
    let n int = 0;
    if (read_all(inp, &src, &n) != 0) {
        write(2, "读入源文件失败\n".to_type(*u8), 22);
        return 1;
    }
    let c *obj.Ctx = malloc(sizeof(obj.Ctx).to_type(u64)).to_type(*obj.Ctx);
    if (c == 0) {
        free(src);
        write(2, "内存不足\n".to_type(*u8), 10);
        return 1;
    }
    let ts obj.TargetSpec = obj.ts_default();
    if (darwin != 0) {
        ts = obj.ts_darwin();
    }
    obj.ctx_init(c, &ts, inp);
    let rc int = asm.asm_parse(c, src, n);
    if (rc == 0) {
        rc = asm.asm_assemble(c);
    }
    let out obj.Buf;
    obj.buf_init(&out);
    if (rc == 0) {
        if (darwin != 0) {
            rc = obj.macho_write(c, &out);
        } else {
            rc = obj.elf_write(c, &out);
        }
    }
    if (rc == 0) {
        // O_WRONLY|O_CREAT|O_TRUNC 按**宿主**取值（Linux 0x241，Darwin 0x601）；
        // 目标（-t）只决定对象格式，不决定宿主文件语义。
        if (write_all(outp, out.data, out.len) != 0) {
            write(2, "写对象文件失败\n".to_type(*u8), 22);
            rc = 1;
        }
    }
    obj.buf_free(&out);
    obj.ctx_free(c);
    free(c);
    free(src);
    if (rc != 0) {
        // 退出码契约（见 asm/README.md）：0 成功；1 输入/诊断错误；
        // 2 用法错误（usage）。诊断层返回的是 -1，直接当退出码会变成 255。
        return 1;
    }
    return 0;
}

// usage：参数不对时打印用法并返回非零。
fn usage() int {
    write(2, "用法: yh_asm asm [-t linux|darwin] -o out.o in.s\n".to_type(*u8),
          52);
    return 2;
}
