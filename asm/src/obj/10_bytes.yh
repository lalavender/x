module obj;

// ============================================================================
// obj/bytes.yh —— 二进制基础：小端读写、安全算术、增长缓冲
//
// 契约（docs/03-design/yh-link独立项目与首版汇编子集契约.md §6）：
//   * 一切按字节编码，禁止把宿主 struct 内存直接复制到文件；
//   * 所有容量增长与偏移算术在越界/溢出前拒绝，返回 -1；
//   * 缓冲所有权归调用方，本模块不隐式释放传入的指针。
//
// 宿主无关：只用 yh 自身算术，不引入 libc 服务（malloc/free 为 prelude）。
// ============================================================================

// —— 溢出安全的整数运算 ——
//
// int 是 32 位有符号。汇编器处理偏移/表长时必须先拒绝溢出再计算，
// 否则一个越界的节偏移会静默变成负数并落到别的节里。

// add_chk：a + b 的安全加法。溢出返回 -1，否则返回和。
// 边界：任一参数为负视为调用方错误，同样拒绝（返回 -1）。
pub fn add_chk(a int, b int) int {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a > 0x7fffffff - b) {
        return -1;
    }
    return a + b;
}

// mul_chk：a * b 的安全乘法。溢出或参数为负返回 -1。
pub fn mul_chk(a int, b int) int {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a == 0 || b == 0) {
        return 0;
    }
    if (a > 0x7fffffff / b) {
        return -1;
    }
    return a * b;
}

// align_up：把 n 向上取整到 a 的倍数（a 必须是二的幂且 ≥1）。
// 非法 a 或加法溢出返回 -1。返回 -1 与合法结果 -1 无法区分时调用方
// 需另行检查输入，见 assert_pow2。
pub fn align_up(n int, a int) int {
    if (a < 1 || (a & (a - 1)) != 0) {
        return -1;
    }
    let r int = n & (a - 1);
    if (r == 0) {
        return n;
    }
    return add_chk(n, a - r);
}

// is_pow2：判断正整数是否为二的幂（对齐参数校验用）。
pub fn is_pow2(a int) int {
    if (a < 1) {
        return 0;
    }
    return ((a & (a - 1)) == 0).to_type(int);
}

// —— 可增长字节缓冲 ——
//
// Buf 是本项目唯一的可变字节容器：汇编输出、节内容、字符串表共用。
// data 为 0 表示尚未分配；此时 len/cap 恒为 0。

pub struct Buf {
    data *u8; // 字节首址；未分配时为 0
    len int; // 已写字节数
    cap int; // 已分配字节数
}

// buf_init：清空缓冲记录，不释放已有内存（幂等，可用于重置）。
pub fn buf_init(b *Buf) int {
    b.data = 0;
    b.len = 0;
    b.cap = 0;
    return 0;
}

// buf_free：释放 data 并清空记录。允许重复调用。
pub fn buf_free(b *Buf) int {
    if (b.data != 0) {
        free(b.data);
    }
    return buf_init(b);
}

// buf_reserve：确保再追加 need 字节不会越界（按需翻倍扩容）。
// 失败返回 -1，缓冲保持原有内容不变。
pub fn buf_reserve(b *Buf, need int) int {
    if (need < 0) {
        return -1;
    }
    let want int = add_chk(b.len, need);
    if (want < 0) {
        return -1;
    }
    if (want <= b.cap) {
        return 0;
    }
    let ncap int = b.cap * 2;
    if (ncap < want) {
        ncap = want;
    }
    if (ncap < 64) {
        ncap = 64;
    }
    let p *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
    if (p == 0) {
        return -1;
    }
    if (b.len > 0) {
        memcpy(p, b.data, b.len.to_type(u64));
    }
    if (b.data != 0) {
        free(b.data);
    }
    b.data = p;
    b.cap = ncap;
    return 0;
}

// buf_clear：丢弃内容保留容量（重用同一缓冲重新生成产物时用）。
pub fn buf_clear(b *Buf) int {
    b.len = 0;
    return 0;
}

// buf_put：追加一个字节。
pub fn buf_put(b *Buf, v u8) int {
    if (buf_reserve(b, 1) != 0) {
        return -1;
    }
    b.data[b.len] = v;
    b.len += 1;
    return 0;
}

// buf_put_n：追加 n 个同值字节（零填充、对齐填充用）。
pub fn buf_put_n(b *Buf, v u8, n int) int {
    if (n <= 0) {
        return 0;
    }
    if (buf_reserve(b, n) != 0) {
        return -1;
    }
    let i int = 0;
    for i < n {
        b.data[b.len] = v;
        b.len += 1;
        i += 1;
    }
    return 0;
}

// buf_align：把缓冲长度向上对齐到 a，填充字节为 fill。
// 代码节对齐必须用 nop（0xd503201f）而不是 0，交由调用方传 fill。
pub fn buf_align(b *Buf, a int, fill u8) int {
    if (!is_pow2(a)) {
        return -1;
    }
    let want int = align_up(b.len, a);
    if (want < 0) {
        return -1;
    }
    return buf_put_n(b, fill, want - b.len);
}

// buf_put_bytes：追加 p 指向的 n 字节。
pub fn buf_put_bytes(b *Buf, p *u8, n int) int {
    if (n <= 0) {
        return 0;
    }
    if (buf_reserve(b, n) != 0) {
        return -1;
    }
    memcpy(b.data + b.len, p, n.to_type(u64));
    b.len += n;
    return 0;
}

// buf_patch32：在绝对偏移 off 处写入小端 4 字节（布局后的定点修正）。
// off+n 越界返回 -1，不改动缓冲。
pub fn buf_patch32(b *Buf, off int, v u32) int {
    if (off < 0 || add_chk(off, 4) < 0) {
        return -1;
    }
    if (add_chk(off, 4) > b.len) {
        return -1;
    }
    let i int = 0;
    for i < 4 {
        b.data[off + i] = ((v >> (i * 8)) & 0xff).to_type(u8);
        i += 1;
    }
    return 0;
}

// —— 小端整数写入（追加） ——
//
// 只实现首版需要的宽度；扩展宽度时保持同样的追加语义。

// buf_put_u16le：追加小端 2 字节。
pub fn buf_put_u16le(b *Buf, v u16) int {
    if (buf_put(b, (v & 0xff).to_type(u8)) != 0) { return -1; }
    return buf_put(b, ((v >> 8) & 0xff).to_type(u8));
}

// buf_put_u32le：追加小端 4 字节。
pub fn buf_put_u32le(b *Buf, v u32) int {
    let i int = 0;
    for i < 4 {
        let by u8 = ((v >> (i * 8).to_type(u32)) & 0xff).to_type(u8);
        if (buf_put(b, by) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// buf_put_u64le：追加小端 8 字节。
pub fn buf_put_u64le(b *Buf, v u64) int {
    let i int = 0;
    for i < 8 {
        let by u8 = ((v >> (i * 8).to_type(u32)) & 0xff).to_type(u8);
        if (buf_put(b, by) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// —— 小端整数读取（输入视图） ——
//
// 输入视图由调用方持有并保证长度；本模块只做指针解引用，
// 长度校验在对象/链接器层的读函数里统一完成。

// rd_u16le：从视图读取小端 2 字节。
pub fn rd_u16le(p *u8, off int) u16 {
    return p[off].to_type(u16) | (p[off + 1].to_type(u16) << 8);
}

// rd_u32le：从视图读取小端 4 字节。
pub fn rd_u32le(p *u8, off int) u32 {
    let v u32 = 0;
    let i int = 0;
    for i < 4 {
        v = v | (p[off + i].to_type(u32) << (i * 8).to_type(u32));
        i += 1;
    }
    return v;
}

// rd_u64le：从视图读取小端 8 字节。
pub fn rd_u64le(p *u8, off int) u64 {
    let v u64 = 0;
    let i int = 0;
    for i < 8 {
        v = v | (p[off + i].to_type(u64) << (i * 8).to_type(u32));
        i += 1;
    }
    return v;
}

// —— 名称池 ——
//
// 符号名、节名在汇编阶段反复出现；池内用「偏移」而非指针参与比较和
// 存储，避免扩容搬迁后悬空。NUL 结尾与 C 工具链一致。

pub struct Names {
    buf Buf; // 全部名称的字节（每项 NUL 结尾）
    n int; // 已登记名称数
    cap int; // 槽位容量
    offs *int; // 每项在 buf 中的偏移
}

// names_init：初始化空名称池。
pub fn names_init(n *Names) int {
    buf_init(&n.buf);
    n.n = 0;
    n.cap = 0;
    n.offs = 0;
    return 0;
}

// names_free：释放名称池占用的全部内存。
pub fn names_free(n *Names) int {
    buf_free(&n.buf);
    if (n.offs != 0) {
        free(n.offs);
    }
    n.offs = 0;
    n.n = 0;
    n.cap = 0;
    return 0;
}

// names_find：查名称是否已在池中，返回槽位下标；不存在返回 -1。
pub fn names_find(n *Names, s *char) int {
    let i int = 0;
    for i < n.n {
        if (cstr_eq_at(&n.buf, n.offs[i], s) != 0) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// names_add：登记名称（已存在则返回原下标），返回槽位下标或 -1。
// 传入指针只在本函数内读取，不被保存。
pub fn names_add(n *Names, s *char) int {
    let hit int = names_find(n, s);
    if (hit >= 0) {
        return hit;
    }
    if (n.n >= n.cap) {
        let ncap int = n.cap * 2;
        if (ncap < 16) {
            ncap = 16;
        }
        let p *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0) {
            return -1;
        }
        if (n.n > 0) {
            memcpy(p, n.offs, (n.n * 4).to_type(u64));
        }
        if (n.offs != 0) {
            free(n.offs);
        }
        n.offs = p;
        n.cap = ncap;
    }
    let slen int = cstr_len(s);
    if (buf_put_bytes(&n.buf, s.to_type(*u8), slen) != 0) { return -1; }
    if (buf_put(&n.buf, 0) != 0) { return -1; }
    n.offs[n.n] = n.buf.len - slen - 1;
    n.n += 1;
    return n.n - 1;
}

// names_get：取槽位下标对应的名称指针（指向池内 NUL 结尾字节）。
// 池扩容会使先前取得的指针失效，只保证在下一次 names_add 之前有效。
pub fn names_get(n *Names, i int) *char {
    if (i < 0 || i >= n.n) {
        return 0;
    }
    return (n.buf.data + n.offs[i]).to_type(*char);
}

// cstr_len：C 字符串长度（不含结尾 NUL）。不解引用越界，依赖调用方保证。
pub fn cstr_len(s *char) int {
    let i int = 0;
    for (s[i] != 0) {
        i += 1;
    }
    return i;
}

// cstr_eq_at：比较池内偏移 off 处的名称与 s，相等返回 1。
pub fn cstr_eq_at(b *Buf, off int, s *char) int {
    let i int = 0;
    for {
        let x u8 = b.data[off + i];
        let y u8 = s[i].to_type(u8);
        if (x != y) {
            return 0;
        }
        if (x == 0) {
            return 1;
        }
        i += 1;
    }
}

// cstr_eq：两个 C 字符串比较，相等返回 1。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0;
    for {
        let x u8 = a[i].to_type(u8);
        let y u8 = b[i].to_type(u8);
        if (x != y) {
            return 0;
        }
        if (x == 0) {
            return 1;
        }
        i += 1;
    }
}

// tok_eq：比较源字节中 [from, e) 的片段与常量字符串，相等返回 1。
// 汇编解析层用它做助记符/寄存器名的片段匹配，避免为每个名字建字符串。
pub fn tok_eq(src *u8, from int, e int, s *char) int {
    if (e - from != cstr_len(s)) {
        return 0;
    }
    let i int = 0;
    for i < e - from {
        if (src[from + i] != s[i].to_type(u8)) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// itoa：把非负整数转成十进制字节（不写结尾 NUL），返回写入长度。
// 最大 20 字节（u64 范围），调用方保证 buf 有足够容量。
pub fn itoa(v u64, buf *u8) int {
    let tmp [20]u8;
    let k int = 0;
    if (v == 0) {
        buf[0] = '0';
        return 1;
    }
    for v > 0 {
        tmp[k] = ((v % 10) + 48).to_type(u8);
        k += 1;
        v = v / 10;
    }
    let i int = 0;
    for k > 0 {
        k -= 1;
        buf[i] = tmp[k];
        i += 1;
    }
    return i;
}

// hex64：把 v 写成至少 width 个十六进制字符到 buf，不写结尾 NUL。
// 返回写入长度。width 为 0 时用最短形式。
pub fn hex64(v u64, buf *u8, width int) int {
    let tmp [16]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    for v > 0 {
        let d int = (v & 15.to_type(u64)).to_type(i64).to_type(int);
        if (d < 10) {
            tmp[k] = (d + 48).to_type(u8);
        } else {
            tmp[k] = (d + 87).to_type(u8);
        }
        k += 1;
        v = v >> 4.to_type(u32);
    }
    for k < width {
        tmp[k] = '0';
        k += 1;
    }
    let i int = 0;
    let j int = k;
    for {
        if (j <= 0) {
            break;
        }
        j -= 1;
        buf[i] = tmp[j];
        i += 1;
    }
    return i;
}
