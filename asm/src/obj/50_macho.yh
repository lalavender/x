module obj;

// ============================================================================
// obj/macho.yh —— Mach-O arm64 可重定位对象：常量与重定位类型映射
//
// 输出契约（对齐 macho_obj_check.py 的差分门）：MH_OBJECT、CPU_TYPE_ARM64、
// 小端。节名映射与重定位映射在本文件集中给出，实测自 clang/llvm-mc 对同一份
// yh 语料的产物，不是查手册抄来的。
//
// 节映射：
//     .text   → __TEXT,__text     flags 0x80000400（S_ATTR_PURE_INSTRUCTIONS |
//                                               S_ATTR_SOME_INSTRUCTIONS）
//     .rodata → __TEXT,__const    flags 0
//     .data   → __DATA,__data     flags 0
//     .bss    → __DATA,__bss      flags 1（S_ZEROFILL，只占内存）
//
// Mach-O 对象只有**一个无名段**（segname 全 0），全部节挂在它下面；节自己的
// segname 记录链接时要去哪个段。这与可执行文件里的 __TEXT/__DATA 段是两回事。
//
// 重定位映射（mach-o/arm64/reloc.h）：
//
//     ABS64(257)                  → UNSIGNED(0)            length=3
//     ADR_PREL_PG_HI21(275)       → PAGE21(3)              pcrel length=2
//     ADD_ABS_LO12_NC(277)        → PAGEOFF12(4)           length=2
//     LDST8/16/32/64(278/284/285/286) → PAGEOFF12(4)       length=2
//     JUMP26(282) / CALL26(283)   → BRANCH26(2)            pcrel length=2
//     LD64_GOTPAGE_LO21(311)      → GOT_LOAD_PAGE21(5)     pcrel length=2
//     LD64_GOT_LO12_NC(312)       → GOT_LOAD_PAGEOFF12(6)  length=2
//     CONDBR19(280)               → 无对应类型
//
// PAGEOFF12 的 length 一律 2：Mach-O 的 length 表示「立即数字段占几字节」，与
// 访问宽度无关，因此不需要像 ELF 的 LDST* 那样按 1/2/4/8 字节分派。实测
// `ldr x`/`ldr w`/`ldrb w` 加 `add` 四种形态的 length 都是 2。
//
// CONDBR19 无对应类型：Mach-O 的条件分支只能跳**同节局部标签**（clang 直接
// 报 conditional branch requires assembler-local label）。本工具的
// 放置无关性规则本来就让同节局部分支在汇编期定掉，所以真走到写重定位这一步
// 说明目标是外部符号或别的节——此时报「不支持该重定位」，不静默降级。
// ============================================================================

// —— 文件头与 load command ——

pub const MO_FILETYPE_OBJECT u32 = 1;     // MH_OBJECT
pub const MO_CPU_ARM64 u32 = 0x0100000c;  // CPU_TYPE_ARM64
pub const MO_CPUSUB_ARM64_ALL u32 = 0;
pub const MO_FLAGS_NONE u32 = 0;

// ponytail: 头里这两个值（0xfeedfacf、0x80000000）写成函数而不是 const。yh
// 对 `pub const` 的整数字面量按**32 位有符号**折叠：0xfeedfacf 折成 -17958193
// 再赋给 u32 会报「字面量超出目标类型可表示范围」，0x80000000 更是直接折成
// 一个空的负号。函数体里的字面量不走这条折叠路径，值是完整的 64 位。
// 上游修掉 const 折叠宽度后，这里可以改回 const。

// mach-o/loader.h
pub const MO_LC_SEGMENT_64 u32 = 0x19;
pub const MO_LC_SYMTAB u32 = 0x2;
pub const MO_LC_DYSYMTAB u32 = 0xb;
pub const MO_LC_BUILD_VERSION u32 = 0x32;

pub const MO_MACHO_HDR_SIZE int = 32;      // mach_header_64
pub const MO_SEGCMD_SIZE int = 72;          // segment_command_64 固定部分
pub const MO_SECT_SIZE int = 80;            // section_64
pub const MO_SYMTAB_CMD_SIZE int = 24;      // symtab_command
pub const MO_DYSYMTAB_CMD_SIZE int = 80;    // dysymtab_command
pub const MO_BUILDVER_CMD_SIZE int = 24;    // build_version_command
pub const MO_NLIST_SIZE int = 16;           // nlist_64
pub const MO_RELOC_SIZE int = 8;            // relocation_info

// mach-o/arm64/reloc.h
pub const MO_RELOC_UNSIGNED u32 = 0;
pub const MO_RELOC_BRANCH26 u32 = 2;
pub const MO_RELOC_PAGE21 u32 = 3;
pub const MO_RELOC_PAGEOFF12 u32 = 4;
pub const MO_RELOC_GOT_PAGE21 u32 = 5;
pub const MO_RELOC_GOT_PAGEOFF12 u32 = 6;

// section_64.flags 的类型位（低 8 位）与属性位
pub const MO_S_ZEROFILL u64 = 1;
pub const MO_S_ATTR_SOME_INSTRUCTIONS u64 = 0x00000400;

// mo_magic：MH_MAGIC_64 的文件魔数。
pub fn mo_magic() u32 {
    return 0xfeedfacf;
}

// mo_attr_pure_instructions：S_ATTR_PURE_INSTRUCTIONS（0x80000000）。
pub fn mo_attr_pure_instructions() u64 {
    return 0x80000000;
}

// nlist_64.n_type 的位
pub const MO_N_EXT u8 = 0x01;
pub const MO_N_UNDF u8 = 0x00;
// 写成十进制 14：十六进制字面量里只要出现 e/E（0x0e、0x0E 都一样），上一代
// 种子编译器在 pub const 的编译期求值路径上会把它当浮点指数，
// 报「浮点与整数之间需要 .to_type」。函数体里的 0x1e220000 之类不受影响。
pub const MO_N_SECT u8 = 14;

// mo_kind_of：把汇编层用的重定位类别映射成 Mach-O 的（类型, pcrel, length）。
// 返回 0 成功；Mach-O 无对应类型时返回 -1。
pub fn mo_kind_of(kind int, mtype *u32, pcrel *int, length *int) int {
    if (kind == 257) {
        // R_AARCH64_ABS64：.xword/.quad 里的绝对地址
        mtype[0] = MO_RELOC_UNSIGNED;
        pcrel[0] = 0;
        length[0] = 3;
        return 0;
    }
    if (kind == 275) {
        mtype[0] = MO_RELOC_PAGE21;
        pcrel[0] = 1;
        length[0] = 2;
        return 0;
    }
    if (kind == 277 || kind == 278 || kind == 284 || kind == 285
       || kind == 286) {
        mtype[0] = MO_RELOC_PAGEOFF12;
        pcrel[0] = 0;
        length[0] = 2;
        return 0;
    }
    if (kind == 282 || kind == 283) {
        mtype[0] = MO_RELOC_BRANCH26;
        pcrel[0] = 1;
        length[0] = 2;
        return 0;
    }
    if (kind == 311) {
        mtype[0] = MO_RELOC_GOT_PAGE21;
        pcrel[0] = 1;
        length[0] = 2;
        return 0;
    }
    if (kind == 312) {
        mtype[0] = MO_RELOC_GOT_PAGEOFF12;
        pcrel[0] = 0;
        length[0] = 2;
        return 0;
    }
    return -1;
}

// mo_reloc_kept：该重定位在 Mach-O 规则下是否需要出现在对象里。
//
// BRANCH26 是节内相对偏移：目标与作用指令**同节**时——不论目标符号是 local
// 还是 global——链接后的偏移就等于对象里的偏移，汇编期定死即可，发重定位是
// 多余的。实测 clang 与 llvm-mc 在 Mach-O 上都不发（探针 same.s：同节
// `bl _foo` / `b _bar`，global 目标，`__text` 里一条重定位都没有）。
//
// 这与 ELF 规则**不同**：aarch64 ELF 对同节分支照样发 CALL26/JUMP26，因为
// 链接器仍可能因符号可预置（preemptible）而把它改写成 PLT 调用或加 veneer。
// 所以这条过滤只能放在 Mach-O 出口层，动汇编层会把 ELF 门打红。
//
// PAGE21 / PAGEOFF12 / GOT_* / UNSIGNED 一律要发：它们的值依赖符号的最终
// 地址，与节内位置无关。同节也一样发（hello.o 里对同文件 `.LD1` 就是如此）。
pub fn mo_reloc_kept(c *Ctx, r *Reloc) int {
    if (r.kind == 282.to_type(u32) || r.kind == 283.to_type(u32)) {
        if (mo_sym_in_sec(c, r.sym, r.sec) != 0) {
            return 0;
        }
    }
    return 1;
}

// mo_sym_in_sec：符号是否已定义且正好落在给定节。
//
// 这个谓词是 Mach-O 分支规则与汇编期回填规则的**共用**判定：两处必须同时
// 成立或同时不成立，否则会出现「不发重定位、也没回填立即数」的零偏移分支
// （真链出来必然跑飞）。asm 侧的 fx_same_sec_branch 与 obj 侧的
// mo_reloc_kept 都走这里。
pub fn mo_sym_in_sec(c *Ctx, sym int, sec int) int {
    let s *Symbol = &c.syms[sym];
    if (sym_is_defined(s) == 0) {
        return 0;
    }
    if (s.shndx != sec) {
        return 0;
    }
    return 1;
}

// mo_diag_line：带行号的诊断。Reloc 与 Symbol 各自记着源码行，报它们的错时
// 先把行号借到上下文的当前位置（诊断函数只认 c.line/c.col）。
pub fn mo_diag_line(c *Ctx, line int, msg *char) int {
    let saveline int = c.line;
    c.line = line;
    let rc int = diag(c, msg);
    c.line = saveline;
    return rc;
}