module obj;

// ============================================================================
// obj/elf.yh —— ELF64 可重定位对象写出器
//
// 输出契约（设计 §7）：ELF64、小端、EM_AARCH64(183)、ET_REL(1)。
// 节集合固定为
//   [0] NULL
//   [1..] .text / .rodata / .data / .bss(NOBITS)   —— 按内容非空才输出
//   [...] .rela.<sec>                              —— 该节有重定位才输出
//   [...] .symtab / .strtab / .shstrtab
//
// 符号表严格 local 在前、global 在后，sh_info 指向第一个 global，这样链接器
// 不必再排序；节与符号的出现顺序完全由源码顺序决定，因此相同输入产出逐字节
// 相同的对象（契约 §7 的可重复性要求）。
//
// AArch64 映射符号：.text 开头放一个 $x，数据类节开头各放一个 $d，都是
// value=0 的局部 STT_NOTYPE，反汇编器据此判断节内是指令还是数据。
// ============================================================================

// —— 节类型与标志 ——
const SHT_NULL int = 0;
const SHT_PROGBITS int = 1;
const SHT_SYMTAB int = 2;
const SHT_STRTAB int = 3;
const SHT_RELA int = 4;
const SHT_NOBITS int = 8;

const SHF_WRITE u64 = 1;
const SHF_ALLOC u64 = 2;
const SHF_EXECINSTR u64 = 4;

// ELF 符号绑定与类型
const STB_LOCAL int = 0;
const STB_GLOBAL int = 1;
const STT_NOTYPE int = 0;

// 节头表项大小、符号表项大小、重定位表项大小
const EHDR_SIZE int = 64;
const SHDR_SIZE int = 64;
const SYM_SIZE int = 24;
const RELA_SIZE int = 24;

// SecPlan：一个待输出节的规划。文件偏移与大小在布局阶段填好，写出阶段只
// 按这些值搬运字节。
pub struct SecPlan {
    name *char;   // 节名（指向常量串或上下文的节名池）
    shtype u32;
    flags u64;
    align u64;
    entsize u64;
    off u64;      // 文件偏移
    size u64;     // 节字节数
    link u32;     // 关联节下标（.symtab → .strtab，.rela → .symtab）
    info u32;     // .symtab → 首个 global 下标；.rela → 作用节下标
    src int;      // 上下文节下标；合成节取 -1
    relfor int;   // 该节是 .rela 时，作用节的上下文下标；否则 -1
}

// ElfState：一次写出的全部中间状态。
pub struct ElfState {
    c *Ctx;
    out *Buf;         // 输出缓冲
    secs *SecPlan;    // 输出节表（下标 0 是 NULL 节）
    nsec int;
    capsec int;
    secmap *int;      // 上下文节下标 → 输出节下标（-1 表示未输出）
    symmap *int;      // 上下文符号下标 → 符号表下标
    nsym int;         // 符号表项数
    nlocal int;       // local 符号数（含映射符号与 null 项）
    nmaps int;        // 映射符号（$x/$d）条数
    relof *int;       // 上下文节下标 → 该节 .rela 的输出下标（-1 无）
    shoff u64;        // 节头表起始偏移
}

// es_push_sec：追加一个输出节规划，返回其下标。
fn es_push_sec(e *ElfState, name *char, shtype u32, flags u64, align u64,
    entsize u64, src int, relfor int) int {
    if (e.nsec + 1 > e.capsec) {
        let ncap int = e.capsec * 2;
        if (ncap < 8) { ncap = 8; }
        let q *SecPlan = malloc((ncap * sizeof(SecPlan)).to_type(u64))
            .to_type(*SecPlan);
        if (q == 0) {
            return -1;
        }
        if (e.nsec > 0) {
            memcpy(q, e.secs, (e.nsec * sizeof(SecPlan)).to_type(u64));
        }
        if (e.secs != 0) { free(e.secs); }
        e.secs = q;
        e.capsec = ncap;
    }
    let i int = e.nsec;
    e.secs[i].name = name;
    e.secs[i].shtype = shtype;
    e.secs[i].flags = flags;
    e.secs[i].align = align;
    e.secs[i].entsize = entsize;
    e.secs[i].off = 0;
    e.secs[i].size = 0;
    e.secs[i].link = 0;
    e.secs[i].info = 0;
    e.secs[i].src = src;
    e.secs[i].relfor = relfor;
    e.nsec += 1;
    return i;
}

// es_ctx_sec：按名字找上下文节，并判断是否值得输出（有内容才输出）。
fn es_used(c *Ctx, i int) int {
    if (i < 0) { return 0; }
    if (sec_is_nobits(&c.secs[i]) != 0) {
        return c.secs[i].memsz > 0;
    }
    return c.secs[i].data.len > 0;
}

// es_count_rel：统计某个上下文节上的重定位条数。
fn es_count_rel(c *Ctx, s int) int {
    let n int = 0;
    let i int = 0;
    for i < c.nrel {
        if (c.rels[i].sec == s) { n += 1; }
        i += 1;
    }
    return n;
}

// es_sym_name：符号名。下标 0 是 null 项，返回空串。
fn es_sym_name(c *Ctx, i int) *char {
    if (i == 0) {
        return "";
    }
    return sym_name(c, i);
}

// es_layout：规划节表并计算每个节的字节数与符号表规模。
// es_shndx_of：取符号的节索引。
fn es_shndx_of(c *Ctx, i int) int {
    return c.syms[i].shndx;
}

fn es_layout(e *ElfState) int {
    let c *Ctx = e.c;
    // 节 0：NULL
    if (es_push_sec(e, "", SHT_NULL.to_type(u32), 0, 0, 0, -1, -1) < 0) {
        return -1;
    }
    let names [4]*char;
    names[0] = ".text";
    names[1] = ".rodata";
    names[2] = ".data";
    names[3] = ".bss";
    let fl [4]u64;
    fl[0] = SHF_ALLOC | SHF_EXECINSTR;
    fl[1] = SHF_ALLOC;
    fl[2] = SHF_ALLOC | SHF_WRITE;
    fl[3] = SHF_ALLOC | SHF_WRITE;
    let k int = 0;
    for k < 4 {
        let si int = ctx_find_sec(c, names[k]);
        if (es_used(c, si) != 0) {
            let ty u32 = SHT_PROGBITS.to_type(u32);
            if (k == 3) { ty = SHT_NOBITS.to_type(u32); }
            let idx int = es_push_sec(e, names[k], ty, fl[k],
                                      c.secs[si].align.to_type(u64), 0, si, -1);
            if (idx < 0) {
                return -1;
            }
            e.secmap[si] = idx;
        }
        k += 1;
    }
    // .rela.<sec>：只为有重定位的已输出节建立
    let j int = 0;
    for j < c.nsec {
        e.relof[j] = -1;
        if (e.secmap[j] < 0) {
            j += 1;
            continue;
        }
        if (es_count_rel(c, j) == 0) {
            j += 1;
            continue;
        }
        let nm *char = sec_name(c, j);
        let buf [64]u8;
        let p int = 0;
        buf[0] = 46;
        buf[1] = 114;
        buf[2] = 101;
        buf[3] = 108;
        buf[4] = 97;
        p = 5;
        let l int = cstr_len(nm);
        // memcpy 返回目的地址（非 0），不能当成功码判断
        memcpy(&buf[5], nm, l.to_type(u64));
        p = 5 + l;
        buf[p] = 0;
        let off int = names_add(&c.names, (&buf[0]).to_type(*char));
        if (off < 0) {
            return diag_plain(c, "登记 .rela 节名失败");
        }
        let idx2 int = es_push_sec(e, names_get(&c.names, off), SHT_RELA.to_type(u32),
                                   0, 8, RELA_SIZE.to_type(u64), -1, j);
        if (idx2 < 0) {
            return diag_plain(c, "建立 .rela 节失败");
        }
        e.relof[j] = idx2;
        j += 1;
    }
    // 符号表规模：null 项 + 映射符号 + 其余 local + global
    let nloc int = 1;
    let nglob int = 0;
    let i int = 1;
    for i < c.nsym {
        if (c.syms[i].binding == SYM_LOCAL) { nloc += 1; } else { nglob += 1; }
        i += 1;
    }
    let k3 int = 0;
    let nmaps int = 0;
    for k3 < 4 {
        let si int = ctx_find_sec(c, es_map_name(k3));
        if (si >= 0 && e.secmap[si] > 0) {
            nloc += 1;
            nmaps += 1;
        }
        k3 += 1;
    }
    e.nmaps = nmaps;
    e.nlocal = nloc;
    e.nsym = nloc + nglob;
    return 0;
}

// es_append_str：向字符串缓冲追加一个 NUL 结尾串，返回写入偏移。
fn es_append_str(b *Buf, s *char) int {
    let off int = b.len;
    if (buf_put_bytes(b, s.to_type(*u8), cstr_len(s)) != 0) {
        return -1;
    }
    if (buf_put(b, 0) != 0) {
        return -1;
    }
    return off;
}

// es_pick_syms：按 local 在前、global 在后填 symmap 与符号名偏移。
fn es_pick_syms(e *ElfState, stroffs *int) int {
    let c *Ctx = e.c;
    // 编号从 1 + 映射符号数开始，0 是 null 项，前面留给 $x/$d
    let k int = 1 + e.nmaps;
    let i int = 1;
    for i < c.nsym {
        if (c.syms[i].binding == SYM_LOCAL) {
            e.symmap[i] = k;
            stroffs[k] = es_append_str(&c.strtab, es_sym_name(c, i));
            k += 1;
        }
        i += 1;
    }
    let g int = k;
    let j int = 1;
    for j < c.nsym {
        if (c.syms[j].binding != SYM_LOCAL) {
            e.symmap[j] = g;
            stroffs[g] = es_append_str(&c.strtab, es_sym_name(c, j));
            g += 1;
        }
        j += 1;
    }
    if (g != e.nsym) {
        return diag_plain(c, "符号表规模与规划不一致");
    }
    return 0;
}

// es_sym_value：符号的最终值。未定义符号取 0。
fn es_sym_value(c *Ctx, i int) u64 {
    if (sym_is_defined(&c.syms[i]) == 0) {
        return 0;
    }
    return c.syms[i].value.to_type(u64);
}

// es_sym_shndx：符号所在节的输出下标；未定义取 SHN_UNDEF(0)。
fn es_sym_shndx(e *ElfState, i int) int {
    let s *Symbol = &e.c.syms[i];
    if (sym_is_defined(s) == 0) {
        return 0;
    }
    if (s.shndx < 0 || s.shndx >= e.c.nsec) {
        return 0;
    }
    let o int = e.secmap[s.shndx];
    if (o < 0) {
        return 0;
    }
    return o;
}

// es_write_sym：写一条 24 字节符号表项。
fn es_write_sym(e *ElfState, nameoff int, info int, other int, shndx int,
    value u64, size u64) int {
    let o *Buf = e.out;
    if (buf_put_u32le(o, nameoff.to_type(u32)) != 0) { return -1; }
    if (buf_put(o, info.to_type(u8)) != 0) { return -1; }
    if (buf_put(o, other.to_type(u8)) != 0) { return -1; }
    if (buf_put_u16le(o, shndx.to_type(u16)) != 0) { return -1; }
    if (buf_put_u64le(o, value) != 0) { return -1; }
    if (buf_put_u64le(o, size) != 0) { return -1; }
    return 0;
}

// es_sym_info：st_info = 绑定 << 4 | 类型。
fn es_sym_info(c *Ctx, i int) int {
    let b int = STB_LOCAL;
    if (c.syms[i].binding != SYM_LOCAL) { b = STB_GLOBAL; }
    return (b << 4) | (c.syms[i].symtype & 15);
}

// es_write_mapping：写一条映射符号（$x / $d）。名字偏移由调用方预先定好。
fn es_write_mapping(e *ElfState, no int, shndx int) int {
    if (no < 0) {
        return -1;
    }
    return es_write_sym(e, no, STB_LOCAL << 4 | STT_NOTYPE, 0, shndx, 0, 0);
}

// es_write_symtab：写符号表。顺序与 es_pick_syms 的编号一致。
fn es_write_symtab(e *ElfState, stroffs *int, mapoff *int) int {
    let c *Ctx = e.c;
    // 0 号：null 项
    if (es_write_sym(e, 0, 0, 0, 0, 0, 0) != 0) { return -1; }
    // 映射符号：紧跟在 null 之后，节序与输出节序一致
    let k int = 0;
    for k < 4 {
        let si int = ctx_find_sec(c, es_map_name(k));
        if (si >= 0 && e.secmap[si] > 0) {
            if (es_write_mapping(e, mapoff[k], e.secmap[si]) != 0) {
                return -1;
            }
        }
        k += 1;
    }
    // 其余 local
    let i int = 1;
    for i < c.nsym {
        if (c.syms[i].binding == SYM_LOCAL) {
            if (es_write_sym(e, stroffs[e.symmap[i]], es_sym_info(c, i), 0,
                             es_sym_shndx(e, i), es_sym_value(c, i),
                             c.syms[i].size.to_type(u64)) != 0) {
                return -1;
            }
        }
        i += 1;
    }
    // global
    let j int = 1;
    for j < c.nsym {
        if (c.syms[j].binding != SYM_LOCAL) {
            if (es_write_sym(e, stroffs[e.symmap[j]], es_sym_info(c, j), 0,
                             es_sym_shndx(e, j), es_sym_value(c, j),
                             c.syms[j].size.to_type(u64)) != 0) {
                return -1;
            }
        }
        j += 1;
    }
    return 0;
}

// es_map_name：映射符号对应的节名（按输出节序）。
fn es_map_name(k int) *char {
    if (k == 0) { return ".text"; }
    if (k == 1) { return ".rodata"; }
    if (k == 2) { return ".data"; }
    return ".bss";
}

// es_write_rela：写某个节的 .rela 表。r_info = 符号下标 << 32 | 类型。
fn es_write_rela(e *ElfState, src int, symtab int) int {
    let c *Ctx = e.c;
    let i int = 0;
    for i < c.nrel {
        if (c.rels[i].sec != src) {
            i += 1;
            continue;
        }
        let si int = e.symmap[c.rels[i].sym];
        if (buf_put_u64le(e.out, c.rels[i].offset.to_type(u64)) != 0) {
            return -1;
        }
        let info u64 = (si.to_type(u64) << 32) | c.rels[i].kind.to_type(u64);
        if (buf_put_u64le(e.out, info) != 0) { return -1; }
        if (buf_put_u64le(e.out, c.rels[i].addend.to_type(u64)) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// elf_write：把上下文写成完整的 ELF64 可重定位对象，字节追加到 out。
// 成功返回 0；失败返回 -1 并已打印诊断。
pub fn elf_write(c *Ctx, out *Buf) int {
    let e *ElfState = malloc(sizeof(ElfState).to_type(u64)).to_type(*ElfState);
    if (e == 0) {
        return diag_plain(c, "内存不足");
    }
    e.c = c;
    e.out = out;
    e.secs = 0;
    e.nsec = 0;
    e.capsec = 0;
    e.nsym = 0;
    e.nlocal = 1;
    e.nmaps = 0;
    e.shoff = 0;
    e.secmap = malloc(((c.nsec + 1) * sizeof(int)).to_type(u64)).to_type(*int);
    e.relof = malloc(((c.nsec + 1) * sizeof(int)).to_type(u64)).to_type(*int);
    e.symmap = malloc(((c.nsym + 1) * sizeof(int)).to_type(u64)).to_type(*int);
    if (e.secmap == 0 || e.relof == 0 || e.symmap == 0) {
        free(e);
        return diag_plain(c, "内存不足");
    }
    let z int = 0;
    for z <= c.nsec {
        e.secmap[z] = -1;
        e.relof[z] = -1;
        z += 1;
    }
    let q int = 0;
    for q <= c.nsym {
        e.symmap[q] = 0;
        q += 1;
    }
    let rc int = es_layout(e);
    if (rc == 0) {
        rc = elf_emit(e);
    }
    free(e.secmap);
    free(e.relof);
    free(e.symmap);
    if (e.secs != 0) { free(e.secs); }
    free(e);
    return rc;
}