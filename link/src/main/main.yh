module main;

// ============================================================================
// main/main.yh —— yh_link 命令行入口（链接器骨架）
//
// 本项目是 yh 自有工具链的**链接器**：把汇编器（asm/ 项目，yh_asm）产出的
// 可重定位对象链接成可执行映像。目标与分期见
// docs/03-design/yh-asm与yh-link设计.md 与
// docs/02-plan/yh-asm与yh-link实施方案.md 的 TC4（静态 ELF 链接）、
// TC9（Mach-O 装载与导入）、TC10（ad-hoc 签名）。
//
// 2026-10-07 目录整理：原先寄放在本项目的汇编器实现整体迁到 asm/ 项目，
// 本项目只保留链接器职责。链接功能尚未实现，入口先固定命令形态与退出码，
// 让后续 TC4 直接往里填，不再改动调用方（Makefile、编译器链接步）。
//
// 命令形态（规划）：
//   yh_link link -o out in1.o in2.o ...   链接对象为可执行文件
//   yh_link --version                     打印版本
// ============================================================================

// not_impl：统一「尚未实现」出口。打印到 stderr 并返回 2。
fn not_impl(msg *char) int {
    let n int = 0;
    for msg[n] != 0 {
        n += 1;
    }
    write(2, msg.to_type(*u8), n);
    return 2;
}

// main：入口。`--version` 打印版本；其余（含规划中的 `link` 子命令）
// 一律返回「尚未实现」，退出码 2，避免调用方把骨架当可用工具。
fn main(argc int, argv **char) int {
    if (argc > 1 && argv[1][0] == '-' && argv[1][1] == '-') {
        if (argv[1][2] == 'v') {
            let ver *char = "yh_link 0.0.1（链接器，尚未实现）\n";
            let n int = 0;
            for ver[n] != 0 {
                n += 1;
            }
            write(1, ver.to_type(*u8), n);
            return 0;
        }
    }
    return not_impl("yh_link：链接器尚未实现（TC4 起实施，见 docs/02-plan/yh-asm与yh-link实施方案.md）\n");
}
