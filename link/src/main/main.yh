module main;

// ============================================================================
// main/main.yh —— yh_link 命令行入口
//
// 命令形态（首版冻结，调用方与测试门都按这套契约）：
//
//   yh_link                    无参数：跑自检，退出码即门（与 yh_asm 一致）
//   yh_link --version          打印版本，退出码 0
//   yh_link link [-o out] [--entry SYM] [--max-page-size N] [--verbose]
//                in1.o in2.o ...
//                              把可重定位对象链成静态 ELF64 可执行文件
//
// 退出码：0 成功；1 输入/链接失败；2 用法错误。
// 诊断一律写 fd 2。产物一次性写出：链接成功后才创建输出文件，中途失败不留
// 「看起来成功」的半成品。
//
// 与汇编器的关系：本项目不 import 汇编器、不调用它，只接受标准 ELF64
// ET_REL 对象作为输入（用户要求两者解耦）。与编译器的集成（--toolchain=self、
// driver 的最终链接步）是**后续任务**，不在本版范围内。
// ============================================================================

import obj;
import link;
import selftest;

// 版本号（--version 打印；与 project.toml 保持一致）
let c_version *char = "yh_link 0.0.1\n";

// MAX_INPUTS：一次链接允许的输入对象数上限（栈上数组的容量）。
const MAX_INPUTS int = 256;

// main：入口。
fn main(argc int, argv **char) int {
    if (argc <= 1) {
        return selftest.st_selftest();
    }
    if (obj.cstr_eq(argv[1], "--version") != 0) {
        obj.dwrite(1, c_version.to_type(*u8), obj.cstr_len(c_version));
        return 0;
    }
    if (obj.cstr_eq(argv[1], "link") != 0) {
        return cmd_link(argc, argv);
    }
    return usage();
}

// usage：参数不对时打印用法并返回 2。
fn usage() int {
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "用法: yh_link link [-o out] [--entry SYM]");
    obj.db_put(&b, " [--max-page-size N] [--verbose] in1.o in2.o ...\n");
    obj.db_put(&b, "      yh_link --version\n");
    obj.db_put(&b, "      yh_link              （无参数：跑自检）\n");
    obj.dwrite(2, b.data, b.len);
    obj.buf_free(&b);
    return 2;
}

// cmd_link：链接子命令。参数解析失败返回 2，链接失败返回 1。
fn cmd_link(argc int, argv **char) int {
    let outp *char = 0;
    let entry *char = "_start";
    let maxpage int = 65536;
    let verbose int = 0;
    let target_linux int = 1;
    let paths [MAX_INPUTS]*char;
    let n int = 0;
    let i int = 2;
    for (i < argc) {
        let a *char = argv[i];
        if (obj.cstr_eq(a, "-o") != 0) {
            if (i + 1 >= argc) {
                return usage();
            }
            outp = argv[i + 1];
            i += 2;
            continue;
        }
        if (obj.cstr_eq(a, "--entry") != 0) {
            if (i + 1 >= argc) {
                return usage();
            }
            entry = argv[i + 1];
            i += 2;
            continue;
        }
        if (obj.cstr_eq(a, "--max-page-size") != 0) {
            if (i + 1 >= argc) {
                return usage();
            }
            let v int = parse_int(argv[i + 1]);
            if (v < 4096 || !obj.is_pow2(v)) {
                return err_msg("--max-page-size 需要 2 的幂且不小于 4096");
            }
            maxpage = v;
            i += 2;
            continue;
        }
        if (obj.cstr_eq(a, "-t") != 0) {
            if (i + 1 >= argc) {
                return usage();
            }
            if (obj.cstr_eq(argv[i + 1], "linux") != 0) {
                target_linux = 1;
            } else if (obj.cstr_eq(argv[i + 1], "darwin") != 0) {
                target_linux = 0;
            } else {
                return err_msg("未知目标：只支持 linux");
            }
            i += 2;
            continue;
        }
        if (obj.cstr_eq(a, "--verbose") != 0) {
            verbose = 1;
            i += 1;
            continue;
        }
        if (a[0] == '-') {
            return err_msg("未知参数");
        }
        if (n >= MAX_INPUTS) {
            return err_msg("输入对象过多");
        }
        paths[n] = a;
        n += 1;
        i += 1;
    }
    if (target_linux == 0) {
        return err_msg("darwin 目标的链接器尚未实现（计划于 TC9）");
    }
    if (n == 0) {
        return err_msg("缺少输入对象");
    }
    if (outp == 0) {
        return err_msg("缺少 -o 输出路径");
    }
    // 读入全部输入对象（字节归本函数所有，链接器只读）
    let data [MAX_INPUTS]*u8;
    let sizes [MAX_INPUTS]int;
    let k int = 0;
    for k < n {
        let p *u8 = 0;
        let flen int = 0;
        if (read_all(paths[k], &p, &flen) != 0) {
            return err_link2("读入输入对象失败: ", paths[k]);
        }
        data[k] = p;
        sizes[k] = flen;
        k += 1;
    }
    let c *obj.LinkCtx = malloc(sizeof(obj.LinkCtx).to_type(u64))
        .to_type(*obj.LinkCtx);
    if (c == 0) {
        free_inputs(&data[0], n);
        return err_msg("内存不足");
    }
    let ts obj.TargetSpec = obj.ts_linux(maxpage);
    obj.ctx_init(c, &ts, entry);
    c.verbose = verbose;
    // --verbose 同时打开各阶段的过程输出（读取/布局/重定位的中间量），
    // 排查错值时不用重新编译工具。
    obj.trace_set(verbose);
    let img obj.Buf;
    obj.buf_init(&img);
    let rc int = link.li_link(c, &paths[0], &data[0], &sizes[0], n, &img);
    if (rc == 0) {
        if (write_all(outp, img.data, img.len) != 0) {
            err_msg2("写出映像失败: ", outp);
            rc = -1;
        }
    } else if (c.errors == 0) {        // 链接失败但一条诊断都没打出来：补一条内部错误并带上阶段名，
        // 否则调用方只能看到一个孤零零的退出码 1。
        let b obj.Buf;
        obj.buf_init(&b);
        obj.db_put(&b, "yh_link: 内部错误: 链接在「");
        obj.db_put(&b, link.li_stage());
        obj.db_put(&b, "」阶段失败，且未给出诊断\n");
        obj.dwrite(2, b.data, b.len);
        obj.buf_free(&b);
    }
    obj.buf_free(&img);
    obj.ctx_free(c);
    free(c);
    free_inputs(&data[0], n);
    if (rc != 0) {
        return 1;
    }
    return 0;
}

// free_inputs：释放读进来的全部输入缓冲。
fn free_inputs(data **u8, n int) int {
    let i int = 0;
    for i < n {
        if (data[i] != 0) {
            free(data[i]);
        }
        i += 1;
    }
    return 0;
}

// err_msg：打印一条错误并返回 2（用法类错误）。
fn err_msg(msg *char) int {
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "yh_link: 错误: ");
    obj.db_put(&b, msg);
    obj.db_put(&b, "\n");
    obj.dwrite(2, b.data, b.len);
    obj.buf_free(&b);
    return 2;
}

// err_msg2：打印「消息 + 路径」并返回 2。
fn err_msg2(msg *char, path *char) int {
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "yh_link: 错误: ");
    obj.db_put(&b, msg);
    obj.db_put(&b, path);
    obj.db_put(&b, "\n");
    obj.dwrite(2, b.data, b.len);
    obj.buf_free(&b);
    return 2;
}

// err_link2：打印「消息 + 路径」并返回 1（输入/链接失败，不是用法错误）。
// 区分这两类退出码是调用方的契约：脚本据此判断「参数写错」还是「输入有问题」。
fn err_link2(msg *char, path *char) int {
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "yh_link: 错误: ");
    obj.db_put(&b, msg);
    obj.db_put(&b, path);
    obj.db_put(&b, "\n");
    obj.dwrite(2, b.data, b.len);
    obj.buf_free(&b);
    return 1;
}

// parse_int：解析十进制整数（只接受数字）。非法返回 -1。
fn parse_int(s *char) int {
    let i int = 0;
    let v int = 0;
    for s[i] != 0 {
        let d int = s[i].to_type(u8).to_type(int) - 48;
        if (d < 0 || d > 9) {
            return -1;
        }
        v = v * 10 + d;
        if (v > 0x10000000) {
            return -1;
        }
        i += 1;
    }
    if (i == 0) {
        return -1;
    }
    return v;
}

// read_all：把整个文件读进堆缓冲（末尾补一个 NUL）。失败返回 -1。
fn read_all(path *char, out **u8, olen *int) int {
    let fd int = open(path, 0);
    if (fd < 0) {
        return -1;
    }
    let cap int = 65536;
    let p *u8 = malloc(cap.to_type(u64)).to_type(*u8);
    if (p == 0) {
        close(fd);
        return -1;
    }
    let n int = 0;
    for 1 {
        if (cap - n < 8192) {
            if (cap > 0x40000000) {
                close(fd);
                free(p);
                return -1;
            }
            let q *u8 = malloc((cap * 2).to_type(u64)).to_type(*u8);
            if (q == 0) {
                close(fd);
                free(p);
                return -1;
            }
            memcpy(q, p, n.to_type(u64));
            free(p);
            p = q;
            cap = cap * 2;
        }
        let r i64 = read(fd, p + n, (cap - n).to_type(u64));
        if (r < 0) {
            close(fd);
            free(p);
            return -1;
        }
        if (r == 0) {
            break;
        }
        n += r.to_type(int);
    }
    close(fd);
    p[n] = 0;
    out[0] = p;
    olen[0] = n;
    return 0;
}

// write_all：把缓冲写到路径（先试 Linux 的 O_WRONLY|O_CREAT|O_TRUNC=0x241，
// 失败再试 Darwin 的 0x601）。空文件也要能创建。
fn write_all(path *char, p *u8, n int) int {
    let fd int = open(path, 0x241, 0x1ed);
    if (fd < 0) {
        fd = open(path, 0x601, 0x1ed);
    }
    if (fd < 0) {
        return -1;
    }
    let done int = 0;
    for done < n {
        let w i64 = write(fd, p + done, (n - done).to_type(u64));
        if (w <= 0) {
            close(fd);
            return -1;
        }
        done += w.to_type(int);
    }
    close(fd);
    return 0;
}
