module obj;

// ============================================================================
// obj/21_state.yh —— 预留：跨子过程的中间状态结构体
//
// 现状：读取层（elf/30_read.yh）与自检脚手架（selftest/80_selftest.yh）各自
// 在同文件内定义自己的状态结构体（ErCtx / ObjBuild），因此本文件暂时为空。
//
// 保留这个位置的原因：yh 的项目构建**按模块并行调度**，一个模块的内部类型
// 只在「声明先于使用」时可用，跨模块类型必须先声明为 `pub`。把子过程状态集中
// 放在这里会引入跨模块可见性约束；就近定义在唯一使用它的文件里更简单。
// 若将来出现「两个文件共用同一份状态」，再回到这里集中声明。
// ============================================================================

// 占位常量：保持文件非空，便于后续集中登记状态结构体。
pub const OBJ_STATE_PLACEHOLDER int = 0;
