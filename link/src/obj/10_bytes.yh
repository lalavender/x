module obj;

// ============================================================================
// obj/10_bytes.yh —— 链接器二进制基础：小端读写、安全算术、增长缓冲、名称池
//
// 为什么在链接器里再写一份（而不是 import 汇编器的 obj 模块）：
//   用户明确要求 link 与 asm 解耦——两个项目互不 import、互不依赖，
//   只通过标准 ELF 对象文件（ELF64 ET_REL）交接。少一份共享代码，就少一条
//   「改汇编器顺手弄坏链接器」的路径；代价是这份基础层要按同一契约维护两份。
//
// ★ 位段访问约定（重要）★
//   链接器的地址、偏移、指令字都按「算术取位」访问位段，不用 & | ^ ~：
//     取低位     low_bits / low_bits_u / hi_bits
//     写位段     set_bits_u
//     乘 2 的幂  mul_add / mul_add_u / shl_u（累加实现）
//   这么写不是洁癖：位段访问是每一种重定位的核心，写法必须一眼能验证。
//   自检（selftest/80_selftest.yh 的 st_check_ops）对这批原语逐条回归。
//
// 宽度约定：指令字走 u64 域（mov x0,#7 是 0xd28000e0，最高位为 1，先落在
// int 会变负数）；链接器内部地址走 int 域（< 2 GiB）。两者不混进同一算式，
// 混用会触发「SSA 函数校验失败」（见 docs/todo.md 的混合宽度算术条目）。
//
// 契约（与 asm/src/obj/10_bytes.yh 一致）：
//   * 一切按字节编码，禁止把宿主 struct 内存直接复制到文件；
//   * 所有容量增长与偏移算术在越界/溢出前拒绝，返回 -1；
//   * 缓冲所有权归调用方，本模块不隐式释放传入的指针。
// ============================================================================

// —— 溢出安全的整数运算 ——

// add_chk：a + b 的安全加法。溢出返回 -1，否则返回和。
// 边界：任一参数为负视为调用方错误，同样拒绝（返回 -1）。
pub fn add_chk(a int, b int) int {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a > 0x7fffffff - b) {
        return -1;
    }
    return a + b;
}

// mul_chk：a * b 的安全乘法。溢出或参数为负返回 -1。
pub fn mul_chk(a int, b int) int {
    if (a < 0 || b < 0) {
        return -1;
    }
    if (a == 0 || b == 0) {
        return 0;
    }
    if (a > 0x7fffffff / b) {
        return -1;
    }
    return a * b;
}

// mul_add：a × b 的累加实现（b ≥ 0）。链接器的取位原语一律用它做缩放。
pub fn mul_add(a int, b int) int {
    if (a == 0 || b <= 0) {
        return 0;
    }
    if (a < 0) {
        return -1;
    }
    let r int = 0;
    let i int = 0;
    for i < b {
        r = r + a;
        i += 1;
    }
    return r;
}

// mul_add_u：mul_add 的 u64 版本（指令字位段缩放用）。
pub fn mul_add_u(a u64, b int) u64 {
    if (a == 0 || b <= 0) {
        return 0;
    }
    let r u64 = 0;
    let i int = 0;
    for i < b {
        r = r + a;
        i += 1;
    }
    return r;
}

// shl_u：v × 2^n 的累加实现（等价 v << n，n ≤ 32）。
pub fn shl_u(v u64, n int) u64 {
    if (n < 0 || n > 32) {
        return 0;
    }
    let r u64 = v;
    let i int = 0;
    for i < n {
        r = r + r;
        i += 1;
    }
    return r;
}

// mul256_u：v × 256 的累加实现（字节读写用，避免依赖大常数乘法）。
fn mul256_u(v u64) u64 {
    return shl_u(v, 8);
}

// pow2：2 的 n 次幂（n ≥ 0 且不溢出）。非法返回 0。u64 域。
pub fn pow2(n int) u64 {
    if (n < 0 || n > 62) {
        return 0;
    }
    return shl_u(1, n);
}

// pow2_i：pow2 的 int 版本（地址域用；n ≤ 30 时不会溢出）。
fn pow2_i(n int) int {
    if (n < 0 || n > 30) {
        return 0;
    }
    let v int = 1;
    let i int = 0;
    for i < n {
        v = v * 2;
        i += 1;
    }
    return v;
}

// align_up：把 n 向上取整到 a 的倍数（a 必须是二的幂且 ≥1）。
// 非法 a 或加法溢出返回 -1。
pub fn align_up(n int, a int) int {
    if (a < 1 || !is_pow2(a)) {
        return -1;
    }
    let r int = low_bits(n, a);
    if (r == 0) {
        return n;
    }
    return add_chk(n, a - r);
}

// is_pow2：判断正整数是否为二的幂。用「不断除以 2 直到 1」判定。
pub fn is_pow2(a int) int {
    if (a < 1) {
        return 0;
    }
    let t int = a;
    let steps int = 0;
    for steps < 32 {
        if (t == 1) {
            return 1;
        }
        if (t - (t / 2) * 2 != 0) {
            return 0;
        }
        t = t / 2;
        steps += 1;
    }
    return 0;
}

// —— 位段原语 ——

// low_bits：取 v 对 a 取余的结果（a 是 2 的幂时即 v 的低 log2(a) 位）。地址域。
pub fn low_bits(v int, a int) int {
    if (a < 1) {
        return 0;
    }
    if (a == 1) {
        return 0;
    }
    return v - mul_add(v / a, a);
}

// low_bits_u：取 u64 值 v 的低 k 位（k ≤ 32）。指令字域版本。
pub fn low_bits_u(v u64, k int) int {
    if (k <= 0 || k > 32) {
        return 0;
    }
    let m u64 = pow2(k);
    let high u64 = (v / m) * m;
    return (v - high).to_type(u64).to_type(i64).to_type(int);
}

// hi_bits：取 u64 值 v 的 [lo, hi) 位段（结果落到 int）。
// 指令字最高位可能为 1，因此一定在 u64 域里取位，最后才落 int。
pub fn hi_bits(v u64, lo int, hi int) int {
    if (lo < 0 || hi <= lo || hi > 32) {
        return 0;
    }
    return low_bits_u(v / pow2(lo), hi - lo);
}

// set_bits_u：把 u64 值 v 的 [lo, hi) 位段替换为 value（指令字重定位用）。
// 实现：清掉 [lo, hi) 后的高位部分 + 新位段左移 lo + 原有低位部分。
pub fn set_bits_u(v u64, lo int, hi int, value u64) u64 {
    if (lo < 0 || hi <= lo || hi > 32) {
        return v;
    }
    let hi_pow u64 = pow2(hi);
    let lo_pow u64 = pow2(lo);
    let high u64 = (v / hi_pow) * hi_pow;
    let low u64 = v - (v / lo_pow) * lo_pow;
    let width int = hi - lo;
    let width_pow u64 = pow2(width);
    let seg u64 = value - (value / width_pow) * width_pow;
    return high + shl_u(seg, lo) + low;
}

// divisible_by：v 是否能被 a 整除（a ≥ 1）。
pub fn divisible_by(v int, a int) int {
    if (a < 1) {
        return 0;
    }
    if (low_bits(v, a) == 0) {
        return 1;
    }
    return 0;
}

// flags_has：位标志集合 flags 是否含位值 bit（bit 必须是正整数）。
// 实现：整除 bit 丢掉更低位，再看商的奇偶——商的第 0 位就是原 bit 那一位。
pub fn flags_has(flags int, bit int) int {
    if (bit < 1 || flags < 0) {
        return 0;
    }
    let q int = flags / bit;
    if (q - (q / 2) * 2 == 1) {
        return 1;
    }
    return 0;
}

// —— 可增长字节缓冲 ——

pub struct Buf {
    data *u8; // 字节首址；未分配时为 0
    len int; // 已写字节数
    cap int; // 已分配字节数
}

// buf_clear：丢弃内容、保留容量（诊断缓冲与产物缓冲反复复用）。
pub fn buf_clear(b *Buf) int {
    b.len = 0;
    return 0;
}

// buf_init：清空缓冲记录，不释放已有内存（幂等，可用于重置）。
pub fn buf_init(b *Buf) int {
    b.data = 0;
    b.len = 0;
    b.cap = 0;
    return 0;
}

// buf_free：释放 data 并清空记录。允许重复调用。
pub fn buf_free(b *Buf) int {
    if (b.data != 0) {
        free(b.data);
    }
    return buf_init(b);
}

// buf_reserve：确保再追加 need 字节不会越界（按需翻倍扩容）。
// 失败返回 -1，缓冲保持原有内容不变。
pub fn buf_reserve(b *Buf, need int) int {
    if (need < 0) {
        return -1;
    }
    let want int = add_chk(b.len, need);
    if (want < 0) {
        return -1;
    }
    if (want <= b.cap) {
        return 0;
    }
    let ncap int = b.cap * 2;
    if (ncap < want) {
        ncap = want;
    }
    if (ncap < 64) {
        ncap = 64;
    }
    let p *u8 = malloc(ncap.to_type(u64)).to_type(*u8);
    if (p == 0) {
        return -1;
    }
    if (b.len > 0) {
        memcpy(p, b.data, b.len.to_type(u64));
    }
    if (b.data != 0) {
        free(b.data);
    }
    b.data = p;
    b.cap = ncap;
    return 0;
}

// buf_put：追加一个字节。
pub fn buf_put(b *Buf, v u8) int {
    if (buf_reserve(b, 1) != 0) {
        return -1;
    }
    b.data[b.len] = v;
    b.len += 1;
    return 0;
}

// buf_put_n：追加 n 个同值字节（零填充、对齐填充用）。
pub fn buf_put_n(b *Buf, v u8, n int) int {
    if (n <= 0) {
        return 0;
    }
    if (buf_reserve(b, n) != 0) {
        return -1;
    }
    let i int = 0;
    for i < n {
        b.data[b.len] = v;
        b.len += 1;
        i += 1;
    }
    return 0;
}

// buf_pad_to：把缓冲补零到绝对长度 n（n 小于当前长度时不动作）。
pub fn buf_pad_to(b *Buf, n int) int {
    if (n <= b.len) {
        return 0;
    }
    return buf_put_n(b, 0, n - b.len);
}

// buf_align：把缓冲长度向上对齐到 a，填充字节为 fill。
// 代码节对齐必须用 nop（0xd503201f）而不是 0，交由调用方传 fill。
pub fn buf_align(b *Buf, a int, fill u8) int {
    if (!is_pow2(a)) {
        return -1;
    }
    let want int = align_up(b.len, a);
    if (want < 0) {
        return -1;
    }
    return buf_put_n(b, fill, want - b.len);
}

// buf_put_bytes：追加 p 指向的 n 字节。
pub fn buf_put_bytes(b *Buf, p *u8, n int) int {
    if (n <= 0) {
        return 0;
    }
    if (buf_reserve(b, n) != 0) {
        return -1;
    }
    memcpy(b.data + b.len, p, n.to_type(u64));
    b.len += n;
    return 0;
}

// bput_le：把 v 的低 n 字节按小端追加（写入原语，不用位运算）。
fn bput_le(b *Buf, v u64, n int) int {
    let i int = 0;
    let rest u64 = v;
    for i < n {
        let q u64 = rest / 256.to_type(u64);
        let by u64 = rest - mul256_u(q);
        if (buf_put(b, by.to_type(u64).to_type(i64).to_type(int).to_type(u8))
            != 0) {
            return -1;
        }
        rest = q;
        i += 1;
    }
    return 0;
}

// bread_le：从缓冲内偏移 off 读 n 字节小端（累加实现）。
fn bread_le(p *u8, off int, n int) u64 {
    let v u64 = 0;
    let mul u64 = 1;
    let i int = 0;
    for i < n {
        v = v + p[off + i].to_type(u64) * mul;
        mul = mul256_u(mul);
        i += 1;
    }
    return v;
}

// buf_patch32：在绝对偏移 off 处写入小端 4 字节（重定位改写指令字用）。
// off+4 越界返回 -1，不改动缓冲。
pub fn buf_patch32(b *Buf, off int, v u32) int {
    if (off < 0) {
        return -1;
    }
    if (add_chk(off, 4) < 0 || add_chk(off, 4) > b.len) {
        return -1;
    }
    let i int = 0;
    let rest u64 = v.to_type(u64);
    for i < 4 {
        let q u64 = rest / 256.to_type(u64);
        b.data[off + i] = (rest - mul256_u(q))
            .to_type(u64).to_type(i64).to_type(int).to_type(u8);
        rest = q;
        i += 1;
    }
    return 0;
}

// buf_patch64：在绝对偏移 off 处写入小端 8 字节（GOT 槽与绝对数据用）。
pub fn buf_patch64(b *Buf, off int, v u64) int {
    if (off < 0) {
        return -1;
    }
    if (add_chk(off, 8) < 0 || add_chk(off, 8) > b.len) {
        return -1;
    }
    let i int = 0;
    let rest u64 = v;
    for i < 8 {
        let q u64 = rest / 256.to_type(u64);
        b.data[off + i] = (rest - mul256_u(q))
            .to_type(u64).to_type(i64).to_type(int).to_type(u8);
        rest = q;
        i += 1;
    }
    return 0;
}

// —— 小端整数写入（追加） ——

// buf_put_u16le：追加小端 2 字节。
pub fn buf_put_u16le(b *Buf, v u16) int {
    return bput_le(b, v.to_type(u64), 2);
}

// buf_put_u32le：追加小端 4 字节。
pub fn buf_put_u32le(b *Buf, v u32) int {
    return bput_le(b, v.to_type(u64), 4);
}

// buf_put_u64le：追加小端 8 字节。
pub fn buf_put_u64le(b *Buf, v u64) int {
    return bput_le(b, v, 8);
}

// —— 小端整数读取（输入视图） ——
//
// 输入视图由调用方持有并保证长度；长度校验在解析层（30_read.yh）统一完成。

// rd_u8：读 1 字节。
pub fn rd_u8(p *u8, off int) u8 {
    return p[off];
}

// rd_u16le：从视图读取小端 2 字节。
pub fn rd_u16le(p *u8, off int) u16 {
    return bread_le(p, off, 2).to_type(u16);
}

// rd_u32le：从视图读取小端 4 字节。
pub fn rd_u32le(p *u8, off int) u32 {
    return bread_le(p, off, 4).to_type(u32);
}

// rd_u64le：从视图读取小端 8 字节。
pub fn rd_u64le(p *u8, off int) u64 {
    return bread_le(p, off, 8);
}

// —— 字符串工具 ——

// cstr_len：C 字符串长度（不含结尾 NUL）。
pub fn cstr_len(s *char) int {
    let i int = 0;
    for (s[i] != 0) {
        i += 1;
    }
    return i;
}

// cstr_eq：两个 C 字符串比较，相等返回 1。
pub fn cstr_eq(a *char, b *char) int {
    let i int = 0;
    for {
        let x u8 = a[i].to_type(u8);
        let y u8 = b[i].to_type(u8);
        if (x != y) {
            return 0;
        }
        if (x == 0) {
            return 1;
        }
        i += 1;
    }
}

// cstr_eq_at：比较池内偏移 off 处的名称与 s，相等返回 1。
pub fn cstr_eq_at(b *Buf, off int, s *char) int {
    let i int = 0;
    for {
        let x u8 = b.data[off + i];
        let y u8 = s[i].to_type(u8);
        if (x != y) {
            return 0;
        }
        if (x == 0) {
            return 1;
        }
        i += 1;
    }
}

// —— 名称池 ——

pub struct Names {
    buf Buf; // 全部名称的字节（每项 NUL 结尾）
    n int; // 已登记名称数
    cap int; // 槽位容量
    offs *int; // 每项在 buf 中的偏移
}

// names_init：初始化空名称池。
pub fn names_init(n *Names) int {
    buf_init(&n.buf);
    n.n = 0;
    n.cap = 0;
    n.offs = 0;
    return 0;
}

// names_free：释放名称池占用的全部内存。
pub fn names_free(n *Names) int {
    buf_free(&n.buf);
    if (n.offs != 0) {
        free(n.offs);
    }
    n.offs = 0;
    n.n = 0;
    n.cap = 0;
    return 0;
}

// names_find：查名称是否已在池中，返回槽位下标；不存在返回 -1。
pub fn names_find(n *Names, s *char) int {
    let i int = 0;
    for i < n.n {
        if (cstr_eq_at(&n.buf, n.offs[i], s) != 0) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// names_add：登记名称（已存在则返回原下标），返回槽位下标或 -1。
pub fn names_add(n *Names, s *char) int {
    let hit int = names_find(n, s);
    if (hit >= 0) {
        return hit;
    }
    if (n.n >= n.cap) {
        let ncap int = n.cap * 2;
        if (ncap < 16) {
            ncap = 16;
        }
        let p *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0) {
            return -1;
        }
        if (n.n > 0) {
            memcpy(p, n.offs, (n.n * 4).to_type(u64));
        }
        if (n.offs != 0) {
            free(n.offs);
        }
        n.offs = p;
        n.cap = ncap;
    }
    let slen int = cstr_len(s);
    if (buf_put_bytes(&n.buf, s.to_type(*u8), slen) != 0) { return -1; }
    if (buf_put(&n.buf, 0) != 0) { return -1; }
    n.offs[n.n] = n.buf.len - slen - 1;
    n.n += 1;
    return n.n - 1;
}

// names_get：取槽位下标对应的名称指针（指向池内 NUL 结尾字节）。
// 池扩容会使先前取得的指针失效，只保证在下一次 names_add 之前有效。
pub fn names_get(n *Names, i int) *char {
    if (i < 0 || i >= n.n) {
        return 0;
    }
    return (n.buf.data + n.offs[i]).to_type(*char);
}

// —— 十进制/十六进制输出（布局报告与诊断用） ——

// itoa：把非负整数转成十进制字节（不写结尾 NUL），返回写入长度。
pub fn itoa(v u64, buf *u8) int {
    let tmp [20]u8;
    let k int = 0;
    if (v == 0) {
        buf[0] = '0';
        return 1;
    }
    let rest u64 = v;
    for rest > 0 {
        let q u64 = rest / 10.to_type(u64);
        let d u64 = rest - q * 10.to_type(u64);
        tmp[k] = (d.to_type(u64).to_type(i64).to_type(int) + 48).to_type(u8);
        k += 1;
        rest = q;
    }
    let i int = 0;
    for k > 0 {
        k -= 1;
        buf[i] = tmp[k];
        i += 1;
    }
    return i;
}

// hex64：把 v 写成至少 width 个十六进制字符到 buf，不写结尾 NUL。
// 返回写入长度。width 为 0 时用最短形式。
pub fn hex64(v u64, buf *u8, width int) int {
    let tmp [16]u8;
    let k int = 0;
    if (v == 0) {
        tmp[0] = '0';
        k = 1;
    }
    let rest u64 = v;
    for rest > 0 {
        let q u64 = rest / 16.to_type(u64);
        let d int = (rest - q * 16.to_type(u64))
            .to_type(u64).to_type(i64).to_type(int);
        if (d < 10) {
            tmp[k] = (d + 48).to_type(u8);
        } else {
            tmp[k] = (d + 87).to_type(u8);
        }
        k += 1;
        rest = q;
    }
    for k < width {
        tmp[k] = '0';
        k += 1;
    }
    let i int = 0;
    let j int = k;
    for {
        if (j <= 0) {
            break;
        }
        j -= 1;
        buf[i] = tmp[j];
        i += 1;
    }
    return i;
}
