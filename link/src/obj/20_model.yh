module obj;

// ============================================================================
// obj/20_model.yh —— 链接器模型：目标契约、输入对象视图、输出节、上下文、诊断
//
// 契约（docs/02-plan/yh-link静态ELF链接器实施方案.md §3）：
//   * 记录先在实际使用处定义，不先建通用插件系统；
//   * 每次调用拥有独立上下文，禁止复用任何进程级全局缓冲；
//   * 诊断带来源（对象文件 + 节 + 偏移），失败统一返回 -1；
//   * 输入对象字节的所有权在调用方：本模块只保存视图（指针 + 长度），
//     绝不写入、绝不释放输入缓冲。
//
// 依赖方向：link → elf → obj。obj 不认识 asm/parse/ir/backend，也不 import
// 汇编器项目——两个工具只通过标准 ELF 对象文件交接。
//
// 位运算：本模块不写 & | ^ ~，位判定走 10_bytes.yh 提供的算术原语
// （pow2/flags_has/low_bits/…），原因见 10_bytes.yh 顶部的位运算规避说明。
// ============================================================================

// —— ELF 常量（输入与输出两侧共用） ——

pub const ELFCLASS64 int = 2;      // 64 位
pub const ELFDATA2LSB int = 1;     // 小端
pub const EV_CURRENT int = 1;      // 版本
pub const ET_REL int = 1;          // 可重定位对象
pub const ET_EXEC int = 2;         // 可执行映像
pub const EM_AARCH64 int = 183;    // AArch64

pub const SHT_NULL int = 0;
pub const SHT_PROGBITS int = 1;
pub const SHT_SYMTAB int = 2;
pub const SHT_STRTAB int = 3;
pub const SHT_RELA int = 4;
pub const SHT_NOTE int = 7;
pub const SHT_NOBITS int = 8;
pub const SHT_REL int = 9;         // 首版拒绝：AArch64 一律用 RELA

pub const SHF_WRITE u64 = 1;
pub const SHF_ALLOC u64 = 2;
pub const SHF_EXECINSTR u64 = 4;

pub const STB_LOCAL int = 0;
pub const STB_GLOBAL int = 1;
pub const STB_WEAK int = 2;        // 首版拒绝

pub const STT_NOTYPE int = 0;
pub const STT_OBJECT int = 1;
pub const STT_FUNC int = 2;
pub const STT_SECTION int = 3;
pub const STT_FILE int = 4;
pub const STT_TLS int = 6;         // 首版拒绝

pub const SHN_UNDEF int = 0;
pub const SHN_ABS int = 0xfff1;
pub const SHN_COMMON int = 0xfff2;  // 首版拒绝
pub const SHN_XINDEX int = 0xffff;  // 首版拒绝

pub const EHDR_SIZE int = 64;      // Elf64_Ehdr
pub const SHDR_SIZE int = 64;      // Elf64_Shdr
pub const PHDR_SIZE int = 56;      // Elf64_Phdr
pub const SYM_SIZE int = 24;       // Elf64_Sym
pub const RELA_SIZE int = 24;      // Elf64_Rela

// 程序头类型与标志
pub const PT_LOAD int = 1;
pub const PF_X int = 1;
pub const PF_W int = 2;
pub const PF_R int = 4;

// 输出节下标（-1 表示「不属于任何输出节」）
pub const OSEC_NONE int = -1;
pub const OSEC_TEXT int = 0;
pub const OSEC_RODATA int = 1;
pub const OSEC_DATA int = 2;
pub const OSEC_BSS int = 3;
pub const OSEC_GOT int = 4;

// OSecDef：输出节的静态定义。alloc=1 表示占内存；named=1 表示进输出节头表；
// code=1 表示对齐填充用 NOP。
pub struct OSecDef {
    name *char;    // 节名
    alloc int;     // 是否占内存
    named int;     // 是否写进输出节头表
    code int;      // 对齐填充是否用 NOP
    flags u64;     // ELF sh_flags
}

// —— 目标契约 ——
//
// 首版只发 AArch64/Linux/ELF64。宿主平台不在此记录：文件 open 旗标按**真宿主**
// 取（Linux 0x241 / Darwin 0x601），不随目标变化（上游设计 §2.1 定的坑）。

pub struct TargetSpec {
    isa int;        // 1 = AArch64
    os int;         // 1 = Linux，2 = Darwin（首版链接只支持 Linux）
    fmt int;        // 1 = ELF64
    endian int;     // 1 = 小端
    ptr_size int;   // 8
    page_size int;  // 段对齐用的最大页大小（默认 65536）
}

// ts_linux：Linux/AArch64 静态 ELF 目标。maxpage 传入段对齐（必须是 2 的幂）。
pub fn ts_linux(maxpage int) TargetSpec {
    let t TargetSpec;
    t.isa = 1;
    t.os = 1;
    t.fmt = 1;
    t.endian = 1;
    t.ptr_size = 8;
    t.page_size = maxpage;
    return t;
}

// —— 输入对象视图 ——

// ISec：输入对象的一个节。kind 是归一化后的输出节下标（OSEC_*），
// 只有 .text/.rodata/.data/.bss 会参与合并；其余节 kind 为 OSEC_NONE。
pub struct ISec {
    name_off int;   // 节名在对象自己的 .shstrtab 内的偏移
    sh_type u32;
    flags u64;
    align int;      // 字节对齐（已校验为 2 的幂）
    off int;        // 文件偏移
    size int;       // 文件字节数（NOBITS 为 0）
    memsz int;      // 内存尺寸（NOBITS 用）
    kind int;       // OSEC_* 或 OSEC_NONE
    discarded int;  // 1 = 已判定为可忽略的元数据节
    out_off int;    // 合并进输出节后在输出节内的起始偏移（布局阶段填）
}

// ISym：输入对象的一个符号。
pub struct ISym {
    name_off int;   // 符号名在对象 .strtab 内的偏移
    binding int;    // STB_*
    symtype int;    // STT_*
    shndx int;      // 节下标 / SHN_ABS / SHN_UNDEF
    value int;      // 节内偏移；SHN_ABS 时是绝对值
    size int;       // 字节数；未知为 0
}

// IRel：输入对象的一条 RELA 重定位。
pub struct IRel {
    sec int;        // 作用节下标（输入对象的节下标）
    off int;        // 作用节内偏移
    sym int;        // 符号下标
    kind u32;       // R_AARCH64_*
    addend i64;     // 显式 addend
}

// ObjView：一个输入对象的解析结果。字节视图 borrow 自调用方。
pub struct ObjView {
    path *char;     // 文件路径（诊断用，借自调用方）
    data *u8;       // 文件字节（借自调用方）
    size int;       // 文件字节数
    secs *ISec;     // 节表
    nsec int;
    syms *ISym;     // 符号表
    nsym int;
    rels *IRel;     // 全部 .rela.* 的条目，按节顺序拼接
    nrel int;
    strtab_off int; // .strtab 文件偏移
    strtab_size int;
    shstr_off int;  // .shstrtab 文件偏移（节名，诊断用）
    shstr_size int;
}

// —— 全局符号表 ——
//
// 按名字查全局符号是链接期最热的操作（每条重定位都要查一次）。线性扫描在
// 符号数上千时会退化成平方复杂度（自检里就撞上过）。这里用开放寻址哈希表：
//   * 容量取 2 的幂，取槽用**取余**（不用 &，见 10_bytes.yh 的位运算规避说明）；
//   * 槽里存 glob 数组下标 + 1，0 表示空槽；
//   * 命中判定用 cstr_eq_at 复核名字，不假设「哈希相等即同类」。

pub const GS_UNDEF int = 0;   // 只有引用、没有定义
pub const GS_DEF int = 1;     // 已定义

// GlobEnt：一个全局符号名（STB_GLOBAL）在一次链接里的解析状态。
// 定义取「首个出现的定义」（确定性），重复定义在收集阶段即报错。
pub struct GlobEnt {
    name_off int;   // 名字在 LinkCtx.names 池内的偏移槽
    def_obj int;    // 定义所在对象下标；GS_UNDEF 时为 -1
    def_sym int;    // 定义符号下标
    defined int;    // GS_*
    refs int;       // 被引用次数（未定义时报错用）
    ref_first_obj int;  // 首个引用所在对象（诊断用）
    ref_first_sec int;  // 首个引用所在节（诊断用）
    ref_first_off int;  // 首个引用所在偏移（诊断用）
}

// —— 输出节与布局 ——

// OSec：一个输出节。mem 是节内容（NOBITS 节恒为空）；written 与 mem 等长，
// 记录该字节是否已被某条重定位改写，用来检测重叠重定位。
pub struct OSec {
    kind int;       // OSEC_*
    align int;      // 对齐（各输入节对齐的最大值）
    memsz int;      // 内存尺寸
    vaddr u64;      // 虚拟地址（布局后填写）
    mem Buf;        // 文件字节
    written *u8;    // 每字节是否已被重定位改写
    grow int;       // 保留字段（后续跳板使用）
}

// —— 映像与段常量 ——
//
// 静态非 PIE 映像：文件开头的 ELF 头 + 3 个程序头补零到 0x10000，第一段从
// 0x10000 起（文件偏移），镜像基址 0x400000。三段：RX（头 + .text）、
// R（.got + .rodata）、RW（.data + .bss 尾部）。
//
// 头部预留取 0x10000：它同时满足 4/16/64 KiB 三种页大小的同余要求
// （p_offset ≡ p_vaddr (mod p_align)）。

pub const IMG_BASE int = 0x400000;   // 第一段的虚拟地址
pub const HDR_ROOM int = 0x10000;    // 头部预留（文件 0x0..0x10000）

// 段下标
pub const SEG_RX int = 0;
pub const SEG_RO int = 1;
pub const SEG_RW int = 2;
pub const SEG_COUNT int = 3;

// —— GOT ——
//
// 每个被 GOT 类重定位引用的目标符号（S+A）占一个 8 字节槽；同一目标只分配
// 一次（键是「扁平符号下标 + addend」，用 LinkCtx.got_used/got_add 记录）。
// 槽内容是该目标的最终虚拟地址，在全部地址确定后回填。GOT 放在只读段最前面，
// 按 8 字节对齐；ADRP 的页粒度差与 PC 低位无关（见 60_reloc.yh 的说明）。

pub const GOT_ENTRY int = 8;

// —— 输出文件的节头编号约定 ——
//
// 输出节头表顺序（书写器 70_write.yh 与布局共用这套下标）：
//   [0] NULL、[1..4] .text .rodata .data .bss、[5] .got（无 GOT 时省略）、
//   [6] .strtab、[7] .symtab、[8] .shstrtab
pub const OSH_NULL int = 0;
pub const OSH_FIRST_CONTENT int = 1;
pub const OSH_GOT int = 5;
pub const OSH_STRTAB int = 6;
pub const OSH_SYMTAB int = 7;
pub const OSH_SHSTRTAB int = 8;
pub const OSH_MAX int = 9;

// —— 上下文 ——

pub struct LinkCtx {
    tgt TargetSpec;
    entry *char;        // 入口符号名（借自调用方）
    objs *ObjView;      // 输入对象
    nobj int;
    capobj int;
    names Names;        // 全局符号名池
    glob *GlobEnt;      // 全局符号表
    gtab *int;          // 全局符号名哈希表：槽存 glob 下标 + 1，0 = 空槽
    gtab_cap int;       // 哈希表容量（2 的幂）
    nglob int;
    capglob int;
    isecs *ISec;        // 全部输入节的扁平数组
    isec_obj *int;      // 每个扁平输入节所属对象下标
    nisec int;
    capisec int;
    isyms *ISym;        // 全部输入符号的扁平数组
    isym_obj *int;      // 每个扁平输入符号所属对象下标
    isym_base *int;     // 每个对象的第一个符号在扁平数组里的下标
    symbase_cap int;    // isym_base 的已分配长度
    nsym int;
    capsym int;
    irels *IRel;        // 全部输入重定位的扁平数组
    irel_obj *int;      // 每条重定位所属对象下标
    nirel int;
    capirel int;
    rel_got *int;       // 每条重定位分配到的 GOT 槽位；-1 = 不使用 GOT
    got_used *int;      // GOT 槽位占用表：每槽存扁平符号下标，-1 = 空闲
    got_add *i64;       // GOT 槽位对应的 addend（槽内容 = S + A）
    ngot int;           // 已分配 GOT 槽位数
    got_addr u64;       // GOT 节虚拟地址（布局后填写）
    symmap *int;        // 扁平符号下标 → 解析结果（SYMV_*）
    symval *u64;        // 扁平符号下标 → 解析后的地址
    symsec *int;        // 扁平符号下标 → 所在输出节（OSEC_NONE 表示绝对）
    symdef *int;        // 扁平符号下标 → 提供取值的符号下标（自己或首定义）
    symoff *int;        // 扁平符号下标 → 所在输入节在输出节内的偏移
    osecs *OSec;        // 输出节 [OSEC_TEXT..OSEC_GOT]
    seg_vaddr *u64;     // 三个 LOAD 段的虚拟地址
    seg_off *u64;       // 三个 LOAD 段的文件偏移
    seg_size *u64;      // 三个 LOAD 段的文件字节数
    seg_end u64;        // 映像文件总长度（不含节头表）
    out_syms *int;      // 输出符号表：每项是扁平符号下标；-1 表示空占位项
    out_sym_n int;      // 输出符号表项数
    out_sym_local int;  // 输出符号表里首个全局符号的下标（sh_info）
    loaded int;         // 是否已完成布局
    entry_addr u64;     // 入口虚拟地址
    verbose int;        // 是否打印布局报告
    errors int;         // 已报告错误数
    diag_buf Buf;       // 诊断拼装缓冲（复用，避免每次分配）
}

// 符号解析结果
pub const SYMV_UNDEF int = 0;   // 未定义（链接失败时必须已由全局表报错）
pub const SYMV_DEF int = 1;     // 已定义：symval 是虚拟地址
pub const SYMV_ABS int = 2;     // 绝对符号：symval 是绝对值

// —— 输出节定义表 ——

// osec_defs：输出节定义（下标即 OSEC_*）。首版固定五个：
// 内容四节（与汇编器契约 §7 的节集合一致）+ 预留的 .got。
pub fn osec_defs(k int, d *OSecDef) int {
    if (k == OSEC_TEXT) {
        d.name = ".text";
        d.alloc = 1;
        d.named = 1;
        d.code = 1;
        d.flags = SHF_ALLOC + SHF_EXECINSTR;
        return 0;
    }
    if (k == OSEC_RODATA) {
        d.name = ".rodata";
        d.alloc = 1;
        d.named = 1;
        d.code = 0;
        d.flags = SHF_ALLOC;
        return 0;
    }
    if (k == OSEC_DATA) {
        d.name = ".data";
        d.alloc = 1;
        d.named = 1;
        d.code = 0;
        d.flags = SHF_ALLOC + SHF_WRITE;
        return 0;
    }
    if (k == OSEC_BSS) {
        d.name = ".bss";
        d.alloc = 1;
        d.named = 1;
        d.code = 0;
        d.flags = SHF_ALLOC + SHF_WRITE;
        return 0;
    }
    if (k == OSEC_GOT) {
        d.name = ".got";
        d.alloc = 1;
        d.named = 1;
        d.code = 0;
        d.flags = SHF_ALLOC + SHF_WRITE;
        return 0;
    }
    return -1;
}

// osec_count：内容输出节的个数。
pub fn osec_count() int {
    return 5;
}

// —— 上下文的建立与释放 ——

// ctx_init：初始化上下文。t 指向目标记录，entry 是入口符号名（借自调用方）。
// 返回 0 成功，-1 失败。
pub fn ctx_init(c *LinkCtx, t *TargetSpec, entry *char) int {
    c.tgt = t[0];
    c.entry = entry;
    c.objs = 0;
    c.nobj = 0;
    c.capobj = 0;
    c.glob = 0;
    c.gtab = 0;
    c.gtab_cap = 0;
    c.nglob = 0;
    c.capglob = 0;
    c.isecs = 0;
    c.isec_obj = 0;
    c.nisec = 0;
    c.capisec = 0;
    c.isyms = 0;
    c.isym_obj = 0;
    c.isym_base = 0;
    c.symbase_cap = 0;
    c.nsym = 0;
    c.capsym = 0;
    c.irels = 0;
    c.irel_obj = 0;
    c.nirel = 0;
    c.capirel = 0;
    c.rel_got = 0;
    c.got_used = 0;
    c.got_add = 0;
    c.ngot = 0;
    c.got_addr = 0;
    c.symmap = 0;
    c.symval = 0;
    c.symsec = 0;
    c.symdef = 0;
    c.symoff = 0;
    c.osecs = 0;
    c.seg_vaddr = 0;
    c.seg_off = 0;
    c.seg_size = 0;
    c.seg_end = 0;
    c.out_syms = 0;
    c.out_sym_n = 0;
    c.out_sym_local = 1;
    c.loaded = 0;
    c.entry_addr = 0;
    c.verbose = 0;
    c.errors = 0;
    names_init(&c.names);
    buf_init(&c.diag_buf);
    c.osecs = malloc((osec_count() * sizeof(OSec)).to_type(u64)).to_type(*OSec);
    c.seg_vaddr = malloc(24.to_type(u64)).to_type(*u64);
    c.seg_off = malloc(24.to_type(u64)).to_type(*u64);
    c.seg_size = malloc(24.to_type(u64)).to_type(*u64);
    if (c.osecs == 0 || c.seg_vaddr == 0 || c.seg_off == 0 || c.seg_size == 0) {
        return diag_plain(c, "内存不足");
    }
    let i int = 0;
    for i < osec_count() {
        let d OSecDef;
        if (osec_defs(i, &d) != 0) {
            return diag_plain(c, "输出节定义表不一致");
        }
        c.osecs[i].kind = i;
        c.osecs[i].align = 1;
        c.osecs[i].memsz = 0;
        c.osecs[i].vaddr = 0;
        c.osecs[i].written = 0;
        c.osecs[i].grow = 0;
        buf_init(&c.osecs[i].mem);
        i += 1;
    }
    let k int = 0;
    for k < 3 {
        c.seg_vaddr[k] = 0;
        c.seg_off[k] = 0;
        c.seg_size[k] = 0;
        k += 1;
    }
    return 0;
}

// ctx_free：释放上下文占用的全部内存（幂等）。输入对象字节不归本模块所有，
// 因此只释放视图数组本身。
pub fn ctx_free(c *LinkCtx) int {
    names_free(&c.names);
    buf_free(&c.diag_buf);
    let i int = 0;
    for i < c.nobj {
        if (c.objs[i].secs != 0) { free(c.objs[i].secs); }
        if (c.objs[i].syms != 0) { free(c.objs[i].syms); }
        if (c.objs[i].rels != 0) { free(c.objs[i].rels); }
        i += 1;
    }
    if (c.objs != 0) { free(c.objs); }
    if (c.glob != 0) { free(c.glob); }
    if (c.gtab != 0) { free(c.gtab); }
    if (c.isecs != 0) { free(c.isecs); }
    if (c.isec_obj != 0) { free(c.isec_obj); }
    if (c.isyms != 0) { free(c.isyms); }
    if (c.isym_obj != 0) { free(c.isym_obj); }
    if (c.isym_base != 0) { free(c.isym_base); }
    if (c.irels != 0) { free(c.irels); }
    if (c.irel_obj != 0) { free(c.irel_obj); }
    if (c.rel_got != 0) { free(c.rel_got); }
    if (c.got_used != 0) { free(c.got_used); }
    if (c.got_add != 0) { free(c.got_add); }
    if (c.symmap != 0) { free(c.symmap); }
    if (c.symval != 0) { free(c.symval); }
    if (c.symsec != 0) { free(c.symsec); }
    if (c.symdef != 0) { free(c.symdef); }
    if (c.symoff != 0) { free(c.symoff); }
    if (c.osecs != 0) {
        let j int = 0;
        for j < osec_count() {
            buf_free(&c.osecs[j].mem);
            if (c.osecs[j].written != 0) { free(c.osecs[j].written); }
            c.osecs[j].written = 0;
            j += 1;
        }
        free(c.osecs);
    }
    if (c.seg_vaddr != 0) { free(c.seg_vaddr); }
    if (c.seg_off != 0) { free(c.seg_off); }
    if (c.seg_size != 0) { free(c.seg_size); }
    if (c.out_syms != 0) { free(c.out_syms); }
    c.objs = 0;
    c.glob = 0;
    c.gtab = 0;
    c.gtab_cap = 0;
    c.isecs = 0;
    c.isec_obj = 0;
    c.isyms = 0;
    c.isym_obj = 0;
    c.isym_base = 0;
    c.symbase_cap = 0;
    c.irels = 0;
    c.irel_obj = 0;
    c.rel_got = 0;
    c.got_used = 0;
    c.got_add = 0;
    c.ngot = 0;
    c.symmap = 0;
    c.symval = 0;
    c.symsec = 0;
    c.osecs = 0;
    c.seg_vaddr = 0;
    c.seg_off = 0;
    c.seg_size = 0;
    c.out_syms = 0;
    c.nobj = 0;
    c.nglob = 0;
    c.nisec = 0;
    c.nsym = 0;
    c.nirel = 0;
    return 0;
}

// —— 输入对象的登记 ——

// ctx_add_obj：登记一个新输入对象视图的槽位，返回对象下标或 -1。
// 槽位字段由 elf_read 填。
pub fn ctx_add_obj(c *LinkCtx, path *char, data *u8, size int) int {
    if (c.nobj + 1 > c.capobj) {
        let ncap int = c.capobj * 2;
        if (ncap < 8) { ncap = 8; }
        let p *ObjView = malloc((ncap * sizeof(ObjView)).to_type(u64))
            .to_type(*ObjView);
        if (p == 0) {
            return diag_plain(c, "内存不足");
        }
        if (c.nobj > 0) {
            memcpy(p, c.objs, (c.nobj * sizeof(ObjView)).to_type(u64));
        }
        if (c.objs != 0) { free(c.objs); }
        c.objs = p;
        c.capobj = ncap;
    }
    let i int = c.nobj;
    c.objs[i].path = path;
    c.objs[i].data = data;
    c.objs[i].size = size;
    c.objs[i].secs = 0;
    c.objs[i].nsec = 0;
    c.objs[i].syms = 0;
    c.objs[i].nsym = 0;
    c.objs[i].rels = 0;
    c.objs[i].nrel = 0;
    c.objs[i].strtab_off = 0;
    c.objs[i].strtab_size = 0;
    c.objs[i].shstr_off = 0;
    c.objs[i].shstr_size = 0;
    c.nobj += 1;
    return i;
}

// ctx_set_shstr：记录对象的节名表位置（诊断与节名查表用）。
pub fn ctx_set_shstr(c *LinkCtx, o int, off int, size int) int {
    if (o < 0 || o >= c.nobj) {
        return -1;
    }
    c.objs[o].shstr_off = off;
    c.objs[o].shstr_size = size;
    return 0;
}

// o_str_at：从对象 o 的 .strtab 里取第 off 个偏移处的名字（NUL 结尾），
// 越界或未终止返回 0。返回的指针借自输入缓冲，调用方不得释放。
pub fn o_str_at(c *LinkCtx, o int, off int) *char {
    if (o < 0 || o >= c.nobj) {
        return 0;
    }
    return strtab_at(c.objs[o].data, c.objs[o].strtab_off,
        c.objs[o].strtab_size, off);
}

// o_shstr_at：从对象 o 的 .shstrtab 里取节名。
pub fn o_shstr_at(c *LinkCtx, o int, off int) *char {
    if (o < 0 || o >= c.nobj) {
        return 0;
    }
    return strtab_at(c.objs[o].data, c.objs[o].shstr_off,
        c.objs[o].shstr_size, off);
}

// strtab_at：从文件缓冲里的字符串表取名字。返回 0 表示越界或未终止。
pub fn strtab_at(data *u8, tab_off int, tab_size int, off int) *char {
    if (data == 0 || off < 0 || off >= tab_size) {
        return 0;
    }
    let p int = tab_off + off;
    let i int = 0;
    for p + i < tab_off + tab_size {
        if (data[p + i] == 0) {
            return (data + p).to_type(*char);
        }
        i += 1;
    }
    return 0;
}

// isec_name_at：取对象 o 第 si 个节的节名（诊断用）。越界返回占位串。
pub fn isec_name_at(c *LinkCtx, o int, si int) *char {
    if (o < 0 || o >= c.nobj) {
        return "?";
    }
    if (si < 0 || si >= c.objs[o].nsec) {
        return "?";
    }
    let nm *char = o_shstr_at(c, o, c.objs[o].secs[si].name_off);
    if (nm == 0) {
        return "?";
    }
    return nm;
}

// diag_buf_msg：把 diag_buf 里已拼好的消息（无结尾 NUL）当作诊断发出去。
pub fn diag_buf_msg(c *LinkCtx) int {
    return diag_plain(c, c.diag_buf.data.to_type(*char));
}

// obj_secs_alloc：为对象 o 分配 n 个输入节槽位。
pub fn obj_secs_alloc(c *LinkCtx, o int, n int) int {
    let p *ISec = malloc((n * sizeof(ISec)).to_type(u64)).to_type(*ISec);
    if (p == 0) {
        return diag_plain(c, "内存不足");
    }
    c.objs[o].secs = p;
    c.objs[o].nsec = n;
    return 0;
}

// obj_syms_alloc：为对象 o 分配 n 个符号槽位。
pub fn obj_syms_alloc(c *LinkCtx, o int, n int) int {
    let p *ISym = malloc((n * sizeof(ISym)).to_type(u64)).to_type(*ISym);
    if (p == 0) {
        return diag_plain(c, "内存不足");
    }
    c.objs[o].syms = p;
    c.objs[o].nsym = n;
    return 0;
}

// obj_rels_alloc：为对象 o 分配 n 条重定位槽位。
pub fn obj_rels_alloc(c *LinkCtx, o int, n int) int {
    let p *IRel = malloc((n * sizeof(IRel)).to_type(u64)).to_type(*IRel);
    if (p == 0) {
        return diag_plain(c, "内存不足");
    }
    c.objs[o].rels = p;
    c.objs[o].nrel = 0;
    return 0;
}

// —— 扁平化输入节/符号/重定位 ——
//
// 全部输入对象的节、符号、重定位在读取后拼成三个扁平数组，后面布局与重定位
// 只需一个全局下标就能定位，不必每次穿透「对象 → 节」两级。

// flat_add_isec：扁平化对象 o 的节表，返回第一个节的全局下标或 -1。
pub fn flat_add_isec(c *LinkCtx, o int) int {
    let n int = c.objs[o].nsec;
    if (c.nisec + n > c.capisec) {
        let ncap int = c.capisec * 2;
        if (ncap < c.nisec + n) { ncap = c.nisec + n; }
        if (ncap < 16) { ncap = 16; }
        let p *ISec = malloc((ncap * sizeof(ISec)).to_type(u64)).to_type(*ISec);
        let q *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0 || q == 0) {
            return diag_plain(c, "内存不足");
        }
        if (c.nisec > 0) {
            memcpy(p, c.isecs, (c.nisec * sizeof(ISec)).to_type(u64));
            memcpy(q, c.isec_obj, (c.nisec * 4).to_type(u64));
        }
        if (c.isecs != 0) { free(c.isecs); }
        if (c.isec_obj != 0) { free(c.isec_obj); }
        c.isecs = p;
        c.isec_obj = q;
        c.capisec = ncap;
    }
    let base int = c.nisec;
    let i int = 0;
    for i < n {
        c.isecs[base + i] = c.objs[o].secs[i];
        c.isec_obj[base + i] = o;
        i += 1;
    }
    c.nisec = base + n;
    return base;
}

// obj_set_sym_base：记录对象 o 的第一个符号在扁平符号数组里的下标。
// isym_base 按对象数懒增长；分配长度记在 LinkCtx.symbase_cap 里。
pub fn obj_set_sym_base(c *LinkCtx, o int, base int) int {
    if (o >= c.symbase_cap) {
        let ncap int = c.symbase_cap * 2;
        if (ncap < o + 8) { ncap = o + 8; }
        if (ncap < 16) { ncap = 16; }
        let p *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0) {
            return diag_plain(c, "内存不足");
        }
        let i int = 0;
        for i < ncap {
            p[i] = 0;
            i += 1;
        }
        let k int = 0;
        for k < c.symbase_cap {
            p[k] = c.isym_base[k];
            k += 1;
        }
        if (c.isym_base != 0) { free(c.isym_base); }
        c.isym_base = p;
        c.symbase_cap = ncap;
    }
    c.isym_base[o] = base;
    return 0;
}

// flat_add_isym：扁平化对象 o 的符号表，返回第一个符号的全局下标或 -1。
pub fn flat_add_isym(c *LinkCtx, o int) int {
    let n int = c.objs[o].nsym;
    if (c.nsym + n > c.capsym) {
        let ncap int = c.capsym * 2;
        if (ncap < c.nsym + n) { ncap = c.nsym + n; }
        if (ncap < 16) { ncap = 16; }
        let p *ISym = malloc((ncap * sizeof(ISym)).to_type(u64)).to_type(*ISym);
        let q *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0 || q == 0) {
            return diag_plain(c, "内存不足");
        }
        if (c.nsym > 0) {
            memcpy(p, c.isyms, (c.nsym * sizeof(ISym)).to_type(u64));
            memcpy(q, c.isym_obj, (c.nsym * 4).to_type(u64));
        }
        if (c.isyms != 0) { free(c.isyms); }
        if (c.isym_obj != 0) { free(c.isym_obj); }
        c.isyms = p;
        c.isym_obj = q;
        c.capsym = ncap;
    }
    let base int = c.nsym;
    let i int = 0;
    for i < n {
        c.isyms[base + i] = c.objs[o].syms[i];
        c.isym_obj[base + i] = o;
        i += 1;
    }
    c.nsym = base + n;
    if (obj_set_sym_base(c, o, base) != 0) {
        return -1;
    }
    return base;
}

// flat_add_irel：扁平化对象 o 的重定位表，返回第一条的全局下标或 -1。
pub fn flat_add_irel(c *LinkCtx, o int) int {
    let n int = c.objs[o].nrel;
    if (c.nirel + n > c.capirel) {
        let ncap int = c.capirel * 2;
        if (ncap < c.nirel + n) { ncap = c.nirel + n; }
        if (ncap < 16) { ncap = 16; }
        let p *IRel = malloc((ncap * sizeof(IRel)).to_type(u64)).to_type(*IRel);
        let q *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
        if (p == 0 || q == 0) {
            return diag_plain(c, "内存不足");
        }
        if (c.nirel > 0) {
            memcpy(p, c.irels, (c.nirel * sizeof(IRel)).to_type(u64));
            memcpy(q, c.irel_obj, (c.nirel * 4).to_type(u64));
        }
        if (c.irels != 0) { free(c.irels); }
        if (c.irel_obj != 0) { free(c.irel_obj); }
        c.irels = p;
        c.irel_obj = q;
        c.capirel = ncap;
    }
    let base int = c.nirel;
    let i int = 0;
    for i < n {
        c.irels[base + i] = c.objs[o].rels[i];
        c.irel_obj[base + i] = o;
        i += 1;
    }
    c.nirel = base + n;
    return base;
}

// —— 全局符号表 ——

// glob_hash：名字的 31 倍滚动哈希（u64 域，容量取余后落到 int）。
//
// 两个坑都在这里避开：
//   * 哈希值必须落在非负区间：u32 累加会绕回，一旦按补码落成负数，
//     `k % cap` 会得到负槽位，越界访存直接段错误（自检里撞到过）。
//     所以累加与取余都在 u64 域做，最后才落 int。
//   * 不用 FNV：FNV 需要异或，而链接器核心不写 ^ & |（见 10_bytes.yh）。
fn glob_hash(s *char) u64 {
    let h u64 = 0;
    let i int = 0;
    for s[i] != 0 {
        h = (h * 31.to_type(u64) + s[i].to_type(u8).to_type(u64))
            % 0x7ffffff0.to_type(u64);
        i += 1;
    }
    return h;
}

// glob_slot：查名字对应的哈希槽。找到返回该槽，未找到返回第一个空槽。
// 表满或探测超界返回 -1（调用方按内部错误处理）。
fn glob_slot(c *LinkCtx, name *char) int {
    let cap int = c.gtab_cap;
    if (cap <= 0) {
        return -1;
    }
    let k int = (glob_hash(name) % cap.to_type(i64).to_type(u64))
        .to_type(u64).to_type(i64).to_type(int);
    let guard int = 0;
    for guard <= cap {
        let e int = c.gtab[k];
        if (e == 0) {
            return k;
        }
        if (cstr_eq_at(&c.names.buf, c.names.offs[e - 1], name) != 0) {
            return k;
        }
        k += 1;
        if (k >= cap) {
            k = 0;
        }
        guard += 1;
    }
    return -1;
}

// glob_find：按名字找全局符号表项，返回下标或 -1。
pub fn glob_find(c *LinkCtx, name *char) int {
    if (c.gtab_cap == 0 || c.gtab == 0) {
        return -1;
    }
    let s int = glob_slot(c, name);
    if (s < 0) {
        return -1;
    }
    let e int = c.gtab[s];
    if (e == 0) {
        return -1;
    }
    return e - 1;
}

// glob_grow：把哈希表扩到能容纳 want 项（容量按 2 的幂翻倍后重哈希）。
// yh 没有 while，翻倍用带守卫的 for 写（容量上限 2^28，远超实际符号数）。
// glob_grow：把哈希表扩到能容纳 want 项（容量按 2 的幂翻倍后重哈希）。
// yh 没有 while，翻倍用带守卫的 for 写（容量上限 2^28，远超实际符号数）。
fn glob_grow(c *LinkCtx, want int) int {
    let ncap int = 16;
    let step int = 0;
    for step < 28 {
        if (ncap >= want * 2) {
            break;
        }
        ncap = ncap * 2;
        step += 1;
    }
    if (ncap <= c.gtab_cap) {
        return 0;
    }
    let p *int = malloc((ncap * 4).to_type(u64)).to_type(*int);
    if (p == 0) {
        return diag_plain(c, "内存不足");
    }
    let z int = 0;
    for z < ncap {
        p[z] = 0;
        z += 1;
    }
    if (c.gtab != 0) {
        free(c.gtab);
    }
    c.gtab = p;
    c.gtab_cap = ncap;
    let i int = 0;
    for i < c.nglob {
        let s int = glob_slot(c, names_get(&c.names, c.glob[i].name_off));
        if (s < 0) {
            return diag_plain(c, "内部错误：全局符号表重哈希失败");
        }
        c.gtab[s] = i + 1;
        i += 1;
    }
    return 0;
}

// glob_add：登记一个全局符号名，返回下标或 -1。
pub fn glob_add(c *LinkCtx, name *char) int {
    let hit int = glob_find(c, name);
    if (hit >= 0) {
        return hit;
    }
    if (c.nglob + 1 > c.capglob) {
        let ncap int = c.capglob * 2;
        if (ncap < 16) { ncap = 16; }
        let p *GlobEnt = malloc((ncap * sizeof(GlobEnt)).to_type(u64))
            .to_type(*GlobEnt);
        if (p == 0) {
            return diag_plain(c, "内存不足");
        }
        if (c.nglob > 0) {
            memcpy(p, c.glob, (c.nglob * sizeof(GlobEnt)).to_type(u64));
        }
        if (c.glob != 0) { free(c.glob); }
        c.glob = p;
        c.capglob = ncap;
    }
    let id int = names_add(&c.names, name);
    if (id < 0) {
        return diag_plain(c, "名称池溢出");
    }
    let i int = c.nglob;
    c.glob[i].name_off = id;
    c.glob[i].def_obj = -1;
    c.glob[i].def_sym = -1;
    c.glob[i].defined = GS_UNDEF;
    c.glob[i].refs = 0;
    c.glob[i].ref_first_obj = -1;
    c.glob[i].ref_first_sec = -1;
    c.glob[i].ref_first_off = -1;
    c.nglob += 1;
    if (glob_grow(c, c.nglob) != 0) {
        return -1;
    }
    let s int = glob_slot(c, name);
    if (s < 0) {
        return diag_plain(c, "内部错误：全局符号表插入失败");
    }
    c.gtab[s] = i + 1;
    return i;
}

// glob_name：取全局符号表项的名字指针。
pub fn glob_name(c *LinkCtx, i int) *char {
    return names_get(&c.names, c.glob[i].name_off);
}

// —— 符号解析结果表 ——

// symmap_alloc：按扁平符号总数分配解析结果数组（三张并行表）。
pub fn symmap_alloc(c *LinkCtx) int {
    let n int = c.nsym;
    c.symmap = malloc((n * 4).to_type(u64)).to_type(*int);
    c.symval = malloc((n * 8).to_type(u64)).to_type(*u64);
    c.symsec = malloc((n * 4).to_type(u64)).to_type(*int);
    c.symdef = malloc((n * 4).to_type(u64)).to_type(*int);
    c.symoff = malloc((n * 4).to_type(u64)).to_type(*int);
    if (c.symmap == 0 || c.symval == 0 || c.symsec == 0 || c.symdef == 0
        || c.symoff == 0) {
        return diag_plain(c, "内存不足");
    }
    let i int = 0;
    for i < n {
        c.symmap[i] = SYMV_UNDEF;
        c.symval[i] = 0;
        c.symsec[i] = OSEC_NONE;
        c.symdef[i] = i;
        c.symoff[i] = 0;
        i += 1;
    }
    return 0;
}

// —— 诊断 ——
//
// 全部诊断写 fd 2，格式：
//   yh_link: 错误: <msg>
//   yh_link: <file>: 错误: <msg>
//   yh_link: <file>(<sec>+0x<off>): 错误: <msg>
// 只做最小格式化（字符串 + 十进制 + 十六进制），不引入诊断框架。

// —— 过程输出开关 ——
//
// 自检遇到「卡住/结果不符」时需要看各阶段进度。开关是进程内的一个标记，
// 由 selftest 打开；产品路径默认关闭，不产生任何额外输出。

let g_trace int = 0;

// trace_set：打开/关闭过程输出。
pub fn trace_set(v int) int {
    g_trace = v;
    return 0;
}

// trace_enabled：过程输出是否打开。
pub fn trace_enabled() int {
    return g_trace;
}

// diag_plain：报告一条无位置的错误，返回 -1（便于 `return diag_plain(...)`）。
pub fn diag_plain(c *LinkCtx, msg *char) int {
    c.errors += 1;
    buf_clear(&c.diag_buf);
    db_put(&c.diag_buf, "yh_link: 错误: ");
    db_put(&c.diag_buf, msg);
    db_put(&c.diag_buf, "\n");
    dwrite(2, c.diag_buf.data, c.diag_buf.len);
    return -1;
}

// diag_at：报告一条带位置的错误（对象文件 + 节 + 节内偏移），返回 -1。
pub fn diag_at(c *LinkCtx, o int, secname *char, off int, msg *char) int {
    c.errors += 1;
    buf_clear(&c.diag_buf);
    db_put(&c.diag_buf, "yh_link: ");
    if (o >= 0 && o < c.nobj) {
        db_put(&c.diag_buf, c.objs[o].path);
    } else {
        db_put(&c.diag_buf, "<输入>");
    }
    db_put(&c.diag_buf, "(");
    db_put(&c.diag_buf, secname);
    db_put(&c.diag_buf, "+0x");
    db_hex(&c.diag_buf, off.to_type(u64));
    db_put(&c.diag_buf, "): 错误: ");
    db_put(&c.diag_buf, msg);
    db_put(&c.diag_buf, "\n");
    dwrite(2, c.diag_buf.data, c.diag_buf.len);
    return -1;
}

// diag_file：报告一条只带对象文件名的错误，返回 -1。
pub fn diag_file(c *LinkCtx, o int, msg *char) int {
    c.errors += 1;
    buf_clear(&c.diag_buf);
    db_put(&c.diag_buf, "yh_link: ");
    if (o >= 0 && o < c.nobj) {
        db_put(&c.diag_buf, c.objs[o].path);
    } else {
        db_put(&c.diag_buf, "<输入>");
    }
    db_put(&c.diag_buf, ": 错误: ");
    db_put(&c.diag_buf, msg);
    db_put(&c.diag_buf, "\n");
    dwrite(2, c.diag_buf.data, c.diag_buf.len);
    return -1;
}

// db_put：向诊断缓冲追加 NUL 结尾字符串。
pub fn db_put(b *Buf, s *char) int {
    let n int = cstr_len(s);
    return buf_put_bytes(b, s.to_type(*u8), n);
}

// db_hex：向诊断缓冲追加十六进制（宽度 8，不足补零）。
pub fn db_hex(b *Buf, v u64) int {
    let tmp [16]u8;
    let n int = hex64(v, &tmp[0], 8);
    return buf_put_bytes(b, &tmp[0], n);
}

// db_int：向诊断缓冲追加十进制整数。
pub fn db_int(b *Buf, v int) int {
    let tmp [20]u8;
    if (v < 0) {
        if (buf_put(b, '-') != 0) { return -1; }
        let a int = 0 - v;
        let n int = itoa(a.to_type(u64), &tmp[0]);
        return buf_put_bytes(b, &tmp[0], n);
    }
    let n2 int = itoa(v.to_type(u64), &tmp[0]);
    return buf_put_bytes(b, &tmp[0], n2);
}

// dwrite：把诊断写到 fd，处理短写。
pub fn dwrite(fd int, buf *u8, n int) int {
    let done int = 0;
    for done < n {
        let w i64 = write(fd, buf + done, (n - done).to_type(u64));
        if (w <= 0) {
            return -1;
        }
        done += w.to_type(int);
    }
    return 0;
}
