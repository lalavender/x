module elf;

// ============================================================================
// elf/50_layout.yh —— 输出布局：节合并、段规划、地址分配、GOT 建槽
//
// 布局规则（docs/02-plan/yh-link静态ELF链接器实施方案.md §3）：
//
//   文件：0x0..0x10000   头部预留（ELF 头 + 3 个程序头，其余补零）
//          0x10000 起     RX 段：.text
//          紧随其后        R  段：.got + .rodata
//          紧随其后        RW 段：.data（.bss 只在内存里续在其后）
//
//   虚拟地址：RX 段 = IMG_BASE（0x400000），后两段按「文件偏移 + 常数差」推出。
//
//   节合并按输入顺序：每个输入节先对齐到自己的 sh_addralign，再整段追加；
//   代码节的对齐填充用 NOP（0xd50321f 的小端位型），数据填空零。
//
// 确定性：输入顺序、节序、符号序、GOT 槽序全部由输入决定，不含任何依赖
// 分配地址或遍历哈希表的量，因此同一组输入产出逐字节相同的映像。
//
// 位运算：取低位走 obj.low_bits / obj.pow2，不写 & |，原因见
// obj/10_bytes.yh 顶部的位运算规避说明。
// ============================================================================

import obj;

// ly_round_i：把 v 向上取整到 a 的倍数（a 必须是 2 的幂）。非法 a 返回 -1。
fn ly_round_i(v int, a int) int {
    if (a < 1 || !obj.is_pow2(a)) {
        return -1;
    }
    let r int = obj.low_bits(v, a);
    if (r == 0) {
        return v;
    }
    return v + (a - r);
}

// ly_fits_int：检查 u64 值是否仍在 int 可表达范围内（链接器内部偏移按
// 32 位有符号算，超过 2 GiB 的映像明确拒绝而不是静默截断）。
fn ly_fits_int(v u64) int {
    if (v > 0x7fffffff.to_type(u64)) {
        return 0;
    }
    return 1;
}

// ly_pad_code：把一个节补齐到自身对齐（代码节用 NOP 的 4 字节小端位型）。
fn ly_pad_code(os *obj.OSec) int {
    if (os.align <= 1) {
        return 0;
    }
    let want int = obj.align_up(os.mem.len, os.align);
    if (want < 0) {
        return -1;
    }
    if (os.kind != obj.OSEC_TEXT) {
        return obj.buf_pad_to(&os.mem, want);
    }
    // AArch64 NOP = 0xd503201f（小端字节 1f 20 03 d5）
    for os.mem.len < want {
        if (obj.buf_put(&os.mem, 0x1f) != 0) { return -1; }
        if (obj.buf_put(&os.mem, 0x20) != 0) { return -1; }
        if (obj.buf_put(&os.mem, 0x03) != 0) { return -1; }
        if (obj.buf_put(&os.mem, 0xd5) != 0) { return -1; }
    }
    return 0;
}

// ly_merge_sections：把全部输入节合并进输出节，并记录每个输入节在输出节内的
// 起始偏移（is.out_off）。
//
// 输入节的 out_off 是**符号地址正确性的前提**：符号的 st_value 是「节内偏移」，
// 合并后它的最终地址 = 输出节基址 + 本输入节的 out_off + 节内偏移。漏掉中间
// 这一项就会出现「所有对象的符号都指向输出节开头」——实测表现为跨对象 bl
// 跳到调用者自己（死循环）。合并顺序固定为「对象顺序 × 节顺序」。
fn ly_merge_sections(c *obj.LinkCtx) int {
    let o int = 0;
    for o < c.nobj {
        let s int = 0;
        for s < c.objs[o].nsec {
            let is *obj.ISec = &c.objs[o].secs[s];
            if (is.kind == obj.OSEC_NONE) {
                s += 1;
                continue;
            }
            let os *obj.OSec = &c.osecs[is.kind];
            if (is.align > os.align) {
                os.align = is.align;
            }
            if (is.kind == obj.OSEC_BSS) {
                // .bss 只增长内存尺寸
                let want int = obj.align_up(os.memsz, is.align);
                if (want < 0) {
                    return obj.diag_file(c, o, "节内存尺寸对齐溢出");
                }
                is.out_off = want;
                let add int = obj.add_chk(want, is.memsz);
                if (add < 0) {
                    return obj.diag_file(c, o, "节内存尺寸溢出");
                }
                os.memsz = add;
                s += 1;
                continue;
            }
            if (ly_pad_code(os) != 0) {
                return obj.diag_file(c, o, "节对齐填充失败");
            }
            is.out_off = os.mem.len;
            if (obj.buf_put_bytes(&os.mem, c.objs[o].data + is.off,
                    is.size) != 0) {
                return obj.diag_file(c, o, "节内容追加失败");
            }
            os.memsz = os.mem.len;
            s += 1;
        }
        o += 1;
    }
    return 0;
}

// ly_bind_sym_offsets：把每个符号所在输入节的 out_off 记到 symoff。
//
// 必须在 ly_merge_sections 之后、st_finalize 之前跑：符号的取值可能来自别的
// 对象（跨对象引用），所以按 symdef（提供取值的那个符号）去找它自己的节。
fn ly_bind_sym_offsets(c *obj.LinkCtx) int {
    let g int = 0;
    for g < c.nsym {
        c.symoff[g] = 0;
        if (c.symmap[g] != obj.SYMV_DEF) {
            g += 1;
            continue;
        }
        let d int = c.symdef[g];
        let o int = c.isym_obj[d];
        let shndx int = c.isyms[d].shndx;
        if (o < 0 || o >= c.nobj || shndx <= 0 || shndx >= c.objs[o].nsec) {
            return obj.diag_plain(c, "内部错误：符号所属输入节越界");
        }
        c.symoff[g] = c.objs[o].secs[shndx].out_off;
        g += 1;
    }
    return 0;
}

// ly_alloc_got：为全部 GOT 类重定位按目标符号分配槽位（同目标同 addend 只占
// 一槽），并把槽位记进 rel_got；返回 0 成功。
fn ly_alloc_got(c *obj.LinkCtx) int {
    if (c.nirel == 0) {
        return 0;
    }
    c.rel_got = malloc((c.nirel * 4).to_type(u64)).to_type(*int);
    if (c.rel_got == 0) {
        return obj.diag_plain(c, "内存不足");
    }
    c.got_used = malloc((c.nirel * 4).to_type(u64)).to_type(*int);
    if (c.got_used == 0) {
        return obj.diag_plain(c, "内存不足");
    }
    c.got_add = malloc((c.nirel * 8).to_type(u64)).to_type(*i64);
    if (c.got_add == 0) {
        return obj.diag_plain(c, "内存不足");
    }
    let i int = 0;
    for i < c.nirel {
        c.rel_got[i] = -1;
        c.got_used[i] = -1;
        c.got_add[i] = 0;
        i += 1;
    }
    i = 0;
    for i < c.nirel {
        let kind int = c.irels[i].kind.to_type(u64).to_type(i64).to_type(int);
        if (kind != rl_GOTPAGE_LO21 && kind != rl_GOT_LO12) {
            i += 1;
            continue;
        }
        let o int = c.irel_obj[i];
        let gsym int = c.isym_base[o] + c.irels[i].sym;
        // GOT 槽按「目标符号 + addend」复用：槽内容就是最终地址 S+A。
        let slot int = -1;
        let k int = 0;
        for k < c.ngot {
            if (c.got_used[k] == gsym && c.got_add[k] == c.irels[i].addend) {
                slot = k;
                break;
            }
            k += 1;
        }
        if (slot < 0) {
            if (c.ngot >= c.nirel) {
                return obj.diag_plain(c, "内部错误：GOT 槽位超界");
            }
            slot = c.ngot;
            c.got_used[slot] = gsym;
            c.got_add[slot] = c.irels[i].addend;
            c.ngot += 1;
        }
        c.rel_got[i] = slot;
        i += 1;
    }
    if (c.ngot == 0) {
        return 0;
    }
    // 槽内容先补零，地址确定后由 ly_fill_got 回填
    let os *obj.OSec = &c.osecs[obj.OSEC_GOT];
    os.align = obj.GOT_ENTRY;
    if (obj.buf_put_n(&os.mem, 0, c.ngot * obj.GOT_ENTRY) != 0) {
        return obj.diag_plain(c, "内存不足");
    }
    os.memsz = os.mem.len;
    return 0;
}

// ly_fill_got：地址确定后把每个 GOT 槽写成目标符号的最终地址（S + A）。
// 未定义目标由未定义符号诊断负责，这里填 0 不重复报错。
fn ly_fill_got(c *obj.LinkCtx) int {
    if (c.ngot == 0) {
        return 0;
    }
    let os *obj.OSec = &c.osecs[obj.OSEC_GOT];
    let k int = 0;
    for k < c.ngot {
        let gsym int = c.got_used[k];
        let v u64 = 0;
        if (gsym >= 0 && gsym < c.nsym
            && c.symmap[gsym] != obj.SYMV_UNDEF) {
            v = c.symval[gsym] + c.got_add[k].to_type(u64);
        }
        if (obj.buf_patch64(&os.mem, k * obj.GOT_ENTRY, v) != 0) {
            return obj.diag_plain(c, "内部错误：GOT 槽回填越界");
        }
        k += 1;
    }
    return 0;
}

// ly_place_segments：给三个段分配虚拟地址与文件偏移，并算出映像总长。
//
// 装载器只对段提出两条硬要求：
//   1. p_filesz ≤ p_memsz；
//   2. p_offset ≡ p_vaddr (mod p_align)，p_align 取目标的最大页大小。
//
// 下面让每段的虚拟地址按页对齐取整，文件偏移再由虚拟地址反推
// （off = vaddr − delta，delta = IMG_BASE − 头部预留按页取整），这样同余自动
// 成立，同时每段都从页边界开始——**段起始必须页对齐**：早期版本让段起点紧贴
// 上一段末尾（例如 R 段落在 0x401014），装载器映射起来虽然"看起来"没问题，
// 但实测在 qemu-user/binfmt 下段内取址直接段错误（改页对齐后即通过）。
//
// 早期在这里还犯过两个错，一并记下：
//   （1）把「文件偏移」与「虚拟基址」直接相减求段长，得到巨大的下溢值；
//   （2）文件偏移与虚拟地址各自按页取整，取整结果不一致，同余被破坏。
fn ly_place_segments(c *obj.LinkCtx) int {
    let page int = c.tgt.page_size;
    if (page < 0x1000) {
        return obj.diag_plain(c, "段对齐不能小于 4 KiB");
    }
    if (!obj.is_pow2(page)) {
        return obj.diag_plain(c, "段对齐必须是 2 的幂");
    }
    let hdr int = obj.EHDR_SIZE + obj.PHDR_SIZE * obj.SEG_COUNT;
    if (hdr > obj.HDR_ROOM) {
        return obj.diag_plain(c, "头部空间不足：ELF 头 + 程序头超出预留区");
    }
    let file_base int = ly_round_i(obj.HDR_ROOM, page);
    if (file_base < 0) {
        return obj.diag_plain(c, "头部预留对齐失败");
    }
    let base int = obj.IMG_BASE;
    let delta int = base - file_base;
    if (delta < 0) {
        return obj.diag_plain(c, "内部错误：镜像基址小于文件起点");
    }
    let text int = c.osecs[obj.OSEC_TEXT].mem.len;
    let ro_body int = c.osecs[obj.OSEC_GOT].mem.len
        + c.osecs[obj.OSEC_RODATA].mem.len;
    let rw_file int = c.osecs[obj.OSEC_DATA].mem.len;
    if (text < 0 || ro_body < 0 || rw_file < 0) {
        return obj.diag_plain(c, "映像尺寸溢出");
    }
    // 段的虚拟地址按页对齐取整（文件偏移由虚拟地址反推，保持同余）。
    // 这样每个段都从页边界开始，装载器不会把两个权限不同的段压进同一页。
    let va_rx int = ly_round_i(base, page);
    let va_ro int = ly_round_i(va_rx + text, page);
    let va_rw int = ly_round_i(va_ro + ro_body, page);
    c.seg_vaddr[obj.SEG_RX] = va_rx;
    c.seg_vaddr[obj.SEG_RO] = va_ro;
    c.seg_vaddr[obj.SEG_RW] = va_rw;
    c.seg_off[obj.SEG_RX] = va_rx - delta;
    c.seg_off[obj.SEG_RO] = va_ro - delta;
    c.seg_off[obj.SEG_RW] = va_rw - delta;
    c.seg_size[obj.SEG_RX] = text;
    c.seg_size[obj.SEG_RO] = ro_body;
    c.seg_size[obj.SEG_RW] = rw_file;
    c.seg_end = (va_rw - delta) + rw_file;
    if (!ly_fits_int(c.seg_end.to_type(u64))) {
        return obj.diag_plain(c, "映像超过 2 GiB（首版不支持）");
    }
    // 段内节地址
    c.osecs[obj.OSEC_TEXT].vaddr = va_rx;
    c.osecs[obj.OSEC_GOT].vaddr = va_ro;
    c.osecs[obj.OSEC_RODATA].vaddr = va_ro
        + c.osecs[obj.OSEC_GOT].mem.len.to_type(i64).to_type(u64);
    c.osecs[obj.OSEC_DATA].vaddr = va_rw;
    c.osecs[obj.OSEC_BSS].vaddr = va_rw
        + rw_file.to_type(i64).to_type(u64);
    // 装载器硬约束：p_offset ≡ p_vaddr (mod p_align)。用「差值取低 a 位为 0」
    // 判定，不用 `%`（见 obj/10_bytes.yh 里对 `%` 错值的记录）。
    let k int = 0;
    for k < obj.SEG_COUNT {
        let d int = c.seg_vaddr[k].to_type(u64).to_type(i64).to_type(int)
            - c.seg_off[k].to_type(u64).to_type(i64).to_type(int);
        if (obj.low_bits(d, page) != 0) {
            return obj.diag_plain(c,
                "内部错误：段偏移与虚拟地址模页对齐不一致");
        }
        k += 1;
    }
    c.loaded = 1;
    return 0;
}

// ly_find_entry：查找入口符号并确定入口地址。入口必须存在、已定义，
// 且落在可执行节里；否则明确报错（链接器不内置启动代码）。
fn ly_find_entry(c *obj.LinkCtx) int {
    let gi int = obj.glob_find(c, c.entry);
    if (gi < 0 || c.glob[gi].def_obj < 0) {
        obj.buf_clear(&c.diag_buf);
        obj.db_put(&c.diag_buf, "找不到入口符号: ");
        obj.db_put(&c.diag_buf, c.entry);
        obj.db_put(&c.diag_buf, "（可用 --entry 指定）");
        return obj.diag_buf_msg(c);
    }
    let g int = c.glob[gi].def_sym;
    if (c.symmap[g] != obj.SYMV_DEF || c.symsec[g] != obj.OSEC_TEXT) {
        obj.buf_clear(&c.diag_buf);
        obj.db_put(&c.diag_buf, "入口符号不在可执行节: ");
        obj.db_put(&c.diag_buf, c.entry);
        return obj.diag_buf_msg(c);
    }
    c.entry_addr = c.symval[g];
    return 0;
}

// ly_build：完整布局流程。成功返回 0，失败返回 -1（已打印诊断）。
pub fn ly_build(c *obj.LinkCtx) int {
    let rc int = ly_alloc_got(c);
    if (rc == 0) {
        rc = ly_merge_sections(c);
    }
    if (rc == 0) {
        rc = ly_bind_sym_offsets(c);
    }
    if (rc == 0) {
        rc = ly_place_segments(c);
    }
    if (rc == 0) {
        rc = st_finalize(c);
    }
    if (rc == 0) {
        rc = ly_fill_got(c);
    }
    if (rc == 0) {
        rc = ly_find_entry(c);
    }
    return rc;
}

// ly_osec_name：输出节名（布局报告与诊断用）。
pub fn ly_osec_name(k int) *char {
    if (k == obj.OSEC_TEXT) { return ".text"; }
    if (k == obj.OSEC_RODATA) { return ".rodata"; }
    if (k == obj.OSEC_DATA) { return ".data"; }
    if (k == obj.OSEC_BSS) { return ".bss"; }
    if (k == obj.OSEC_GOT) { return ".got"; }
    return "?";
}

// ly_report：打印布局报告（--verbose）。逐节给出虚拟地址/文件偏移/大小，
// 便于对照 readelf 与排查错值。
pub fn ly_report(c *obj.LinkCtx) int {
    let i int = 0;
    for i < obj.osec_count() {
        let os *obj.OSec = &c.osecs[i];
        obj.buf_clear(&c.diag_buf);
        obj.db_put(&c.diag_buf, "  布局 ");
        obj.db_put(&c.diag_buf, ly_osec_name(i));
        obj.db_put(&c.diag_buf, " vaddr=0x");
        obj.db_hex(&c.diag_buf, os.vaddr);
        obj.db_put(&c.diag_buf, " size=0x");
        obj.db_hex(&c.diag_buf, os.mem.len.to_type(i64).to_type(u64));
        obj.db_put(&c.diag_buf, " memsz=0x");
        obj.db_hex(&c.diag_buf, os.memsz.to_type(i64).to_type(u64));
        obj.db_put(&c.diag_buf, " align=");
        obj.db_int(&c.diag_buf, os.align);
        obj.db_put(&c.diag_buf, "\n");
        obj.dwrite(2, c.diag_buf.data, c.diag_buf.len);
        i += 1;
    }
    obj.buf_clear(&c.diag_buf);
    obj.db_put(&c.diag_buf, "  布局 入口=");
    obj.db_put(&c.diag_buf, c.entry);
    obj.db_put(&c.diag_buf, " entry=0x");
    obj.db_hex(&c.diag_buf, c.entry_addr);
    obj.db_put(&c.diag_buf, " 映像长度=0x");
    obj.db_hex(&c.diag_buf, c.seg_end);
    obj.db_put(&c.diag_buf, "\n");
    obj.dwrite(2, c.diag_buf.data, c.diag_buf.len);
    return 0;
}
