module elf;

// ============================================================================
// elf/40_symtab.yh —— 符号解析（跨对象）：全局表、重复定义、未定义、地址解析
//
// 三条规则（上游设计 §8.1）：
//   1. local 符号只在**本对象**内可见，按 (对象, 符号下标) 定位，参与重定位，
//      但绝不与别对象的同名局部符号冲突；
//   2. global 符号按**名字**解析，定义取「首个出现的定义」（输入顺序确定，
//      因此结果确定）；第二个强定义立即报错，并指出两处来源；
//   3. 未定义符号在解析结束后统一报错，一次列出全部（不是只报第一条），
//      并给出首个引用位置（对象 + 节 + 偏移）。
//
// 解析结果写进三张并行表：symmap（状态）、symval（地址或绝对值）、symsec
// （所在输出节）。定义符号的最终地址在布局之后由 st_finalize 补全。
// ============================================================================

import obj;

// st_name：按扁平符号下标取名字（借自输入缓冲）。
fn st_name(c *obj.LinkCtx, gidx int) *char {
    return obj.o_str_at(c, c.isym_obj[gidx], c.isyms[gidx].name_off);
}

// st_is_mapping：该扁平符号是否是 AArch64 映射符号（$x / $d）。
//
// 映射符号是 ELF 给反汇编器的标注（每个指令/数据区域开头一个），**不是**
// 可解析符号：它跟用户符号共享名字空间，一旦参与解析就会算错地址
// （实测把 `$x` 当普通局部符号后，全局符号 helper 的地址被算成 $x 的值，
// 跨对象 bl 直接跳到自己头上形成死循环）。因此：
//   * 不进全局符号表；
//   * 不参与跨对象解析；
//   * 不占输出符号表的位置。
fn st_is_mapping(c *obj.LinkCtx, gidx int) int {
    let s obj.ISym = c.isyms[gidx];
    if (s.binding != obj.STB_LOCAL) {
        return 0;
    }
    let nm *char = st_name(c, gidx);
    if (nm == 0 || nm[0] != '$') {
        return 0;
    }
    let k int = nm[1].to_type(u8).to_type(int);
    if (k != 'x' && k != 'd') {
        return 0;
    }
    return (nm[2] == 0).to_type(int);
}

// st_is_global：符号是否按全局名解析。
fn st_is_global(s *obj.ISym) int {
    return (s.binding == obj.STB_GLOBAL).to_type(int);
}

// st_collect：扫描全部输入符号，建立全局符号表（定义 + 引用计数）。
// 重复强定义在此立即报错（两处来源都要指出）。成功返回 0。
pub fn st_collect(c *obj.LinkCtx) int {
    let g int = 0;
    for g < c.nsym {
        let s obj.ISym = c.isyms[g];
        if (st_is_global(&s) == 0) {
            g += 1;
            continue;
        }
        if (s.symtype == obj.STT_FILE || s.symtype == obj.STT_SECTION) {
            g += 1;
            continue;
        }
        let nm *char = st_name(c, g);
        if (nm == 0) {
            return obj.diag_plain(c, "内部错误：符号名取用越界");
        }
        if (obj.cstr_len(nm) == 0) {
            return obj.diag_plain(c, "全局符号没有名字");
        }
        let gi int = obj.glob_add(c, nm);
        if (gi < 0) {
            return -1;
        }
        if (s.shndx != obj.SHN_UNDEF) {
            if (c.glob[gi].defined == obj.GS_DEF) {
                let o1 int = c.glob[gi].def_obj;
                let o2 int = c.isym_obj[g];
                obj.buf_clear(&c.diag_buf);
                obj.db_put(&c.diag_buf, "重复定义符号: ");
                obj.db_put(&c.diag_buf, nm);
                obj.db_put(&c.diag_buf, "（先见于 ");
                obj.db_put(&c.diag_buf, c.objs[o1].path);
                obj.db_put(&c.diag_buf, "，后见于 ");
                obj.db_put(&c.diag_buf, c.objs[o2].path);
                obj.db_put(&c.diag_buf, "）");
                return obj.diag_buf_msg(c);
            }
            c.glob[gi].defined = obj.GS_DEF;
            c.glob[gi].def_obj = c.isym_obj[g];
            c.glob[gi].def_sym = g;
        } else {
            c.glob[gi].refs += 1;
            if (c.glob[gi].ref_first_obj < 0) {
                c.glob[gi].ref_first_obj = c.isym_obj[g];
            }
        }
        g += 1;
    }
    return 0;
}

// st_bind_refs：为未定义全局符号补上首个引用位置（节 + 偏移）。
// 必须在重定位读取之后调用：只有重定位记录才带引用点。
pub fn st_bind_refs(c *obj.LinkCtx) int {
    let k int = 0;
    for k < c.nirel {
        let r obj.IRel = c.irels[k];
        let o int = c.irel_obj[k];
        let gsym int = c.isym_base[o] + r.sym;
        if (st_is_global(&c.isyms[gsym]) == 0) {
            k += 1;
            continue;
        }
        let gi int = obj.glob_find(c, st_name(c, gsym));
        if (gi < 0 || c.glob[gi].defined == obj.GS_DEF) {
            k += 1;
            continue;
        }
        if (c.glob[gi].ref_first_obj < 0) {
            c.glob[gi].ref_first_obj = o;
        }
        if (c.glob[gi].ref_first_sec < 0) {
            c.glob[gi].ref_first_sec = r.sec;
            c.glob[gi].ref_first_off = r.off;
        }
        k += 1;
    }
    return 0;
}

// st_report_undef：把全部未定义的全局符号一次报出。全部已定义返回 0，
// 否则返回 -1（已打印全部诊断，不是只报第一条）。
pub fn st_report_undef(c *obj.LinkCtx) int {
    let bad int = 0;
    let i int = 0;
    for i < c.nglob {
        if (c.glob[i].defined == obj.GS_DEF || c.glob[i].refs == 0) {
            i += 1;
            continue;
        }
        bad += 1;
        obj.buf_clear(&c.diag_buf);
        obj.db_put(&c.diag_buf, "未定义符号: ");
        obj.db_put(&c.diag_buf, obj.glob_name(c, i));
        obj.db_put(&c.diag_buf, "（引用 ");
        obj.db_int(&c.diag_buf, c.glob[i].refs);
        obj.db_put(&c.diag_buf, " 处，最近一处 ");
        let ro int = c.glob[i].ref_first_obj;
        if (ro >= 0 && ro < c.nobj) {
            obj.db_put(&c.diag_buf, c.objs[ro].path);
            obj.db_put(&c.diag_buf, "(");
            obj.db_put(&c.diag_buf, obj.isec_name_at(c, ro,
                c.glob[i].ref_first_sec));
            obj.db_put(&c.diag_buf, "+0x");
            obj.db_hex(&c.diag_buf,
                c.glob[i].ref_first_off.to_type(i64).to_type(u64));
            obj.db_put(&c.diag_buf, ")");
        } else {
            obj.db_put(&c.diag_buf, "<未记录引用点>");
        }
        obj.db_put(&c.diag_buf, ")");
        obj.diag_buf_msg(c);
        i += 1;
    }
    if (bad > 0) {
        return -1;
    }
    return 0;
}

// st_resolve：把每个扁平符号分类成「未定义 / 节内定义 / 绝对」，并记录所在
// 输出节。地址在布局后由 st_finalize 补全。成功返回 0。
//
// 三遍：
//   1. 逐个符号按「自己所在节」定出初始分类（局部符号只走这一遍），
//      映射符号（$x/$d）直接跳过——它们不是可解析符号；
//   2. 全局符号按**名字**重定向到首定义的解析结果，这是跨对象引用的关键：
//      主对象里 `bl helper` 引用的那个符号自身是 SHN_UNDEF，只有把全局表的
//      首定义结果复制过来，重定位阶段才拿得到地址。
pub fn st_resolve(c *obj.LinkCtx) int {
    if (obj.symmap_alloc(c) != 0) {
        return -1;
    }
    let g int = 0;
    for g < c.nsym {
        let s obj.ISym = c.isyms[g];
        if (st_is_mapping(c, g) != 0) {
            g += 1;
            continue;
        }
        if (s.shndx == obj.SHN_UNDEF) {
            g += 1;
            continue;
        }
        if (s.shndx == obj.SHN_ABS) {
            c.symmap[g] = obj.SYMV_ABS;
            c.symval[g] = s.value.to_type(i64).to_type(u64);
            c.symsec[g] = obj.OSEC_NONE;
            g += 1;
            continue;
        }
        let o int = c.isym_obj[g];
        let kind int = c.objs[o].secs[s.shndx].kind;
        if (kind == obj.OSEC_NONE) {
            if (s.symtype != obj.STT_SECTION && s.symtype != obj.STT_FILE) {
                return obj.diag_file(c, o, "符号定义在不参与合并的节里");
            }
            g += 1;
            continue;
        }
        c.symmap[g] = obj.SYMV_DEF;
        c.symsec[g] = kind;
        c.symval[g] = s.value.to_type(i64).to_type(u64);
        g += 1;
    }
    // 第二遍：全局符号按名字对齐到首定义
    g = 0;
    for g < c.nsym {
        let s obj.ISym = c.isyms[g];
        if (s.binding != obj.STB_GLOBAL) {
            g += 1;
            continue;
        }
        if (s.symtype == obj.STT_FILE || s.symtype == obj.STT_SECTION) {
            g += 1;
            continue;
        }
        let gi int = obj.glob_find(c, st_name(c, g));
        if (gi < 0) {
            g += 1;
            continue;
        }
        let def int = c.glob[gi].def_sym;
        if (def < 0 || def == g) {
            // 未定义引用保持 UNDEF（报错在 st_report_undef 已完成）；
            // 自身就是首定义时无需重定向
            g += 1;
            continue;
        }
        c.symmap[g] = c.symmap[def];
        c.symsec[g] = c.symsec[def];
        c.symval[g] = c.symval[def];
        c.symdef[g] = def;
        if (obj.trace_enabled() != 0) {
            obj.buf_clear(&c.diag_buf);
            obj.db_put(&c.diag_buf, "    [st] 全局重定向 g=");
            obj.db_int(&c.diag_buf, g);
            obj.db_put(&c.diag_buf, " def=");
            obj.db_int(&c.diag_buf, def);
            obj.db_put(&c.diag_buf, " 名=");
            obj.db_put(&c.diag_buf, st_name(c, g));
            obj.db_put(&c.diag_buf, " val=");
            obj.db_hex(&c.diag_buf, c.symval[g]);
            obj.db_put(&c.diag_buf, "\n");
            obj.dwrite(2, c.diag_buf.data, c.diag_buf.len);
        }
        g += 1;
    }
    return 0;
}

// st_finalize：布局完成后把每个节内定义符号的地址补全。
// 最终地址 = 输出节基址 + 所在输入节在输出节内的偏移 + 节内偏移。
// 中间那一项（symoff）由 ly_bind_sym_offsets 在合并之后填好；漏掉它会让
// 所有对象的符号都指向输出节开头。成功返回 0。
pub fn st_finalize(c *obj.LinkCtx) int {
    let g int = 0;
    for g < c.nsym {
        if (c.symmap[g] != obj.SYMV_DEF) {
            g += 1;
            continue;
        }
        let kind int = c.symsec[g];
        if (kind < 0 || kind >= obj.osec_count()) {
            return obj.diag_plain(c, "内部错误：符号所属输出节越界");
        }
        c.symval[g] = c.osecs[kind].vaddr
            + c.symoff[g].to_type(i64).to_type(u64) + c.symval[g];
        if (obj.trace_enabled() != 0) {
            obj.buf_clear(&c.diag_buf);
            obj.db_put(&c.diag_buf, "    [st] finalize g=");
            obj.db_int(&c.diag_buf, g);
            obj.db_put(&c.diag_buf, " kind=");
            obj.db_int(&c.diag_buf, kind);
            obj.db_put(&c.diag_buf, " out_off=");
            obj.db_int(&c.diag_buf, c.symoff[g]);
            obj.db_put(&c.diag_buf, " val=");
            obj.db_hex(&c.diag_buf, c.symval[g]);
            obj.db_put(&c.diag_buf, "\n");
            obj.dwrite(2, c.diag_buf.data, c.diag_buf.len);
        }
        g += 1;
    }
    return 0;
}

// st_got_target：取一条 GOT 类重定位的目标地址（符号地址 + addend）。
// 目标必须已定义；未定义由未定义符号诊断负责，这里返回 0 不重复报错。
pub fn st_got_target(c *obj.LinkCtx, gidx int, addend i64) u64 {
    if (c.symmap[gidx] == obj.SYMV_UNDEF) {
        return 0;
    }
    return c.symval[gidx] + addend.to_type(u64);
}
