module elf;

// ============================================================================
// elf/30_read.yh —— ELF64 可重定位对象读取（输入侧）
//
// 职责：把一份标准 ELF64 ET_REL 对象解析成全字段校验过的视图。
//   * 头部：magic/class/endian/version/type/machine/表长与文件范围；
//   * 节表：名字、类型、标志、偏移、大小、对齐（2 的幂）与文件范围；
//   * 符号表：绑定/类型/节索引/取值，拒绝 TLS、weak、common、visibility；
//   * 重定位：只接受标准 RELA，逐条校验类型号、符号索引与作用节偏移。
//
// 对**外部工具产出的对象**与自有对象使用同一套解析与校验：不因为生产者是 yh
// 就跳过长度、索引或范围检查（上游设计 §7）。
//
// 失败一律返回 -1 并已打印带文件名的诊断；成功返回 0，视图写进上下文。
// 输入字节只读：本模块绝不修改、绝不释放调用方传入的文件缓冲。
//
// 位运算说明：本模块不写 & | ^ ~，标志位判定走 er_flags_alloc/er_flags_exec
// （内部用 obj.flags_has），低位取值走 obj.low_bits——原因见
// obj/10_bytes.yh 顶部的位运算规避说明。
//
// 循环写法说明：yh 的 `continue` **不会**执行 for 的递增段（相当于跳回条件
// 判断），所有分支一律写成 if/else 链并在循环末尾统一 `i += 1`，否则死循环。
// ============================================================================

import obj;

// ErCtx：一次对象读取的中间状态。各类表的校验结果放在这里，供符号、重定位
// 两个后续阶段使用，避免重复解析节头。
//
// 为什么定义在本文件：yh 的项目构建按模块并行调度，本模块只在自己的文件之间
// 共享内部（非 pub）类型；就近定义在唯一使用它的文件里，不依赖跨模块可见性。
pub struct ErCtx {
    c *obj.LinkCtx;   // 链接上下文（错误计数与视图都写这里）
    o int;            // 当前对象下标
    shnum int;        // 节头项数
    shstr_off int;    // .shstrtab 文件偏移
    shstr_size int;   // .shstrtab 长度
    symtab_no int;    // .symtab 节头下标；-1 表示没有
    symtab_off int;
    symtab_num int;
    strtab_off int;
    strtab_size int;
    nrela int;        // .rela.* 节数
    nrel_entries int; // 全部 .rela.* 的条目总数
}

// er_read_object：读取并校验一个输入对象，登记到上下文。成功返回对象下标。
pub fn er_read_object(c *obj.LinkCtx, path *char, data *u8, size int) int {
    let o int = obj.ctx_add_obj(c, path, data, size);
    if (o < 0) {
        return -1;
    }
    let e *ErCtx = malloc(sizeof(ErCtx).to_type(u64)).to_type(*ErCtx);
    if (e == 0) {
        obj.diag_plain(c, "内存不足");
        return -1;
    }
    e.c = c;
    e.o = o;
    e.shnum = 0;
    e.shstr_off = 0;
    e.shstr_size = 0;
    e.symtab_no = -1;
    e.symtab_off = 0;
    e.symtab_num = 0;
    e.strtab_off = 0;
    e.strtab_size = 0;
    e.nrela = 0;
    e.nrel_entries = 0;
    let rc int = er_header(e);
    if (rc == 0) {
        rc = er_sections(e);
    }
    if (rc == 0) {
        rc = er_symbols(e);
    }
    if (rc == 0) {
        rc = er_relocs(e);
    }
    free(e);
    if (rc != 0) {
        return -1;
    }
    // 扁平化：节 → 符号 → 重定位。顺序固定，保证输出确定。
    let base_sec int = obj.flat_add_isec(c, o);
    if (base_sec < 0) {
        return -1;
    }
    let base_sym int = obj.flat_add_isym(c, o);
    if (base_sym < 0) {
        return -1;
    }
    if (c.objs[o].nrel > 0) {
        if (obj.flat_add_irel(c, o) < 0) {
            return -1;
        }
    }
    return o;
}

// er_fits：文件内 [off, off+n) 是否完整落在视图里（含溢出检查）。
fn er_fits(e *ErCtx, off int, n int) int {
    let c *obj.LinkCtx = e.c;
    if (off < 0 || n < 0) {
        return 0;
    }
    let end int = obj.add_chk(off, n);
    if (end < 0) {
        return 0;
    }
    return (end <= c.objs[e.o].size).to_type(int);
}

// er_u32/er_u64：原始小端读取（不做范围检查，调用方先 er_fits）。
fn er_u32(e *ErCtx, off int) u32 {
    return obj.rd_u32le(e.c.objs[e.o].data, off);
}

fn er_u64(e *ErCtx, off int) u64 {
    return obj.rd_u64le(e.c.objs[e.o].data, off);
}

// er_hdr_u16/u32/u64：读头部字段并落到 int（头部已整体校验过范围）。
fn er_hdr_u16(e *ErCtx, off int) int {
    return obj.rd_u16le(e.c.objs[e.o].data, off).to_type(int);
}

fn er_hdr_u32(e *ErCtx, off int) int {
    return obj.rd_u32le(e.c.objs[e.o].data, off).to_type(u64).to_type(i64)
        .to_type(int);
}

fn er_hdr_u64(e *ErCtx, off int) int {
    return obj.rd_u64le(e.c.objs[e.o].data, off).to_type(u64).to_type(i64)
        .to_type(int);
}

// er_flags_alloc / er_flags_exec：节标志位判定（不写 &，见模块头说明）。
fn er_flags_alloc(flags u64) int {
    return (obj.flags_has(flags.to_type(u64).to_type(i64).to_type(int),
        obj.SHF_ALLOC.to_type(u64).to_type(i64).to_type(int))
        != 0).to_type(int);
}

fn er_flags_exec(flags u64) int {
    return (obj.flags_has(flags.to_type(u64).to_type(i64).to_type(int),
        obj.SHF_EXECINSTR.to_type(u64).to_type(i64).to_type(int))
        != 0).to_type(int);
}

// er_header：校验 ELF64 头。字段偏移见 Elf64_Ehdr。
fn er_header(e *ErCtx) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    if (c.objs[o].size < obj.EHDR_SIZE) {
        return obj.diag_file(c, o, "文件短于 ELF64 头（64 字节）");
    }
    let d *u8 = c.objs[o].data;
    if (d[0] != 0x7f || d[1] != 'E' || d[2] != 'L' || d[3] != 'F') {
        return obj.diag_file(c, o, "不是 ELF 文件（magic 不符）");
    }
    if (d[4].to_type(int) != obj.ELFCLASS64) {
        return obj.diag_file(c, o, "只接受 ELF64 对象");
    }
    if (d[5].to_type(int) != obj.ELFDATA2LSB) {
        return obj.diag_file(c, o, "只接受小端对象");
    }
    if (er_hdr_u32(e, 20) != obj.EV_CURRENT) {
        return obj.diag_file(c, o, "ELF 版本号不是 1");
    }
    let etype int = er_hdr_u16(e, 16);
    if (etype != obj.ET_REL) {
        return obj.diag_file(c, o, "只接受 ET_REL 可重定位对象");
    }
    let emach int = er_hdr_u16(e, 18);
    if (emach != obj.EM_AARCH64) {
        return obj.diag_file(c, o, "机器类型不是 AArch64(183)");
    }
    let ehsize int = er_hdr_u16(e, 52);
    if (ehsize != obj.EHDR_SIZE) {
        return obj.diag_file(c, o, "e_ehsize 不是 64");
    }
    let phentsize int = er_hdr_u16(e, 54);
    let phnum int = er_hdr_u16(e, 56);
    if (phentsize != 0 || phnum != 0) {
        return obj.diag_file(c, o, "可重定位对象不应带程序头表");
    }
    let shoff int = er_hdr_u64(e, 40);
    let shentsize int = er_hdr_u16(e, 58);
    let shnum int = er_hdr_u16(e, 60);
    let shstrndx int = er_hdr_u16(e, 62);
    if (shentsize != obj.SHDR_SIZE) {
        return obj.diag_file(c, o, "e_shentsize 不是 64");
    }
    if (shnum < 1) {
        return obj.diag_file(c, o, "节头项数为 0");
    }
    if (shstrndx < 1 || shstrndx >= shnum) {
        return obj.diag_file(c, o, "e_shstrndx 越界或为 0");
    }
    let tablen int = obj.mul_chk(shnum, obj.SHDR_SIZE);
    if (tablen < 0 || !er_fits(e, shoff, tablen)) {
        return obj.diag_file(c, o, "节头表超出文件范围");
    }
    e.shnum = shnum;
    // 0 号节必须是全零的空节
    let t0 u32 = er_u32(e, shoff);
    if (t0 != 0) {
        return obj.diag_file(c, o, "0 号节头不是空节");
    }
    // .shstrtab
    let sso int = shoff + shstrndx * obj.SHDR_SIZE;
    let sstype u32 = er_u32(e, sso + 4);
    if (sstype != obj.SHT_STRTAB.to_type(u32)) {
        return obj.diag_file(c, o, "e_shstrndx 指向的不是字符串表");
    }
    let ssoff int = er_hdr_u64(e, sso + 24);
    let sssize int = er_hdr_u64(e, sso + 32);
    if (!er_fits(e, ssoff, sssize)) {
        return obj.diag_file(c, o, ".shstrtab 超出文件范围");
    }
    e.shstr_off = ssoff;
    e.shstr_size = sssize;
    obj.ctx_set_shstr(c, o, ssoff, sssize);
    return 0;
}

// er_is_mapping_sym：AArch64 ELF 的映射符号（`$x` 指令区 / `$d` 数据区）。
//
// 这类符号只给反汇编器看，**不是可解析的符号**：与用户符号共享名字空间，
// 参与解析会出真错（早期把 `$x` 当普通局部符号登记，链接器用它去算全局
// 符号 helper 的地址，结果分支跳到了自己头上——死循环）。
// 链接器不做反汇编，因此读到即拒绝，绝不静默登记。
fn er_is_mapping_sym(nm *char) int {
    if (nm == 0) {
        return 0;
    }
    if (nm[0] != '$') {
        return 0;
    }
    let k int = nm[1].to_type(u8).to_type(int);
    if (k != 'x' && k != 'd') {
        return 0;
    }
    return (nm[2] == 0).to_type(int);
}

// er_str_at：从字符串表里取以 NUL 结尾的名字，返回指向文件缓冲内部的指针；
// 越界或未终止返回 0。返回的指针借自输入缓冲，调用方不得释放。
fn er_str_at(e *ErCtx, tab_off int, tab_size int, off int) *char {
    return obj.strtab_at(e.c.objs[e.o].data, tab_off, tab_size, off);
}

// er_sec_kind：把节名映射到归一化输出节下标；非合并节返回 OSEC_NONE。
fn er_sec_kind(name *char) int {
    if (obj.cstr_eq(name, ".text") != 0) { return obj.OSEC_TEXT; }
    if (obj.cstr_eq(name, ".rodata") != 0) { return obj.OSEC_RODATA; }
    if (obj.cstr_eq(name, ".data") != 0) { return obj.OSEC_DATA; }
    if (obj.cstr_eq(name, ".bss") != 0) { return obj.OSEC_BSS; }
    return obj.OSEC_NONE;
}

// er_name_prefix：name 是否以 p 开头。
fn er_name_prefix(name *char, p *char) int {
    let i int = 0;
    for p[i] != 0 {
        if (name[i] != p[i]) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// er_ignorable：判定一个不参与合并的节是否属于「明确无运行语义」的元数据。
// 返回 1 表示可以跳过，0 表示必须报错——绝不按未知节名静默丢弃（设计 §3.2）。
// 判定按「节名 + 类型」双条件：
//   * 字符串表（.strtab/.shstrtab）是对象自身的名称池，已被解析层消费；
//   * .comment/.note*/.debug*/.ARM.attributes/.llvm_addrsig/.eh_frame 无装载语义；
//   * 其余非 alloc 的 PROGBITS/NOTE 视为元数据，但不做无条件的「未知就丢」。
fn er_ignorable(name *char, sh_type u32, flags u64) int {
    if (sh_type == obj.SHT_STRTAB.to_type(u32)) { return 1; }
    if (obj.cstr_eq(name, ".comment") != 0) { return 1; }
    if (er_name_prefix(name, ".note") != 0) { return 1; }
    if (er_name_prefix(name, ".debug") != 0) { return 1; }
    if (obj.cstr_eq(name, ".ARM.attributes") != 0) { return 1; }
    if (obj.cstr_eq(name, ".llvm_addrsig") != 0) { return 1; }
    if (obj.cstr_eq(name, ".eh_frame") != 0) { return 1; }
    if (!er_flags_alloc(flags)) {
        if (sh_type == obj.SHT_PROGBITS.to_type(u32)) { return 1; }
        if (sh_type == obj.SHT_NOTE.to_type(u32)) { return 1; }
    }
    return 0;
}

// er_sections：解析并校验全部节头，登记合并节与符号表/重定位表位置。
fn er_sections(e *ErCtx) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    let shoff int = er_hdr_u64(e, 40);
    if (obj.obj_secs_alloc(c, o, e.shnum) != 0) {
        return -1;
    }
    let i int = 0;
    for i < e.shnum {
        let so int = shoff + i * obj.SHDR_SIZE;
        let name_off int = er_u32(e, so).to_type(u64).to_type(i64).to_type(int);
        let sh_type u32 = er_u32(e, so + 4);
        let flags u64 = er_u64(e, so + 8);
        let off int = er_hdr_u64(e, so + 24);
        let sz int = er_hdr_u64(e, so + 32);
        let link int = er_u32(e, so + 40).to_type(u64).to_type(i64).to_type(int);
        let info int = er_u32(e, so + 44).to_type(u64).to_type(i64).to_type(int);
        let align int = er_hdr_u64(e, so + 48);
        let entsize int = er_hdr_u64(e, so + 56);
        if (i == 0) {
            // 0 号空节（SHT_NULL）的校验：拒绝**有语义**的字段非零，
            // 只容忍 sh_offset。
            //   * sh_type/flags/size/align 非零说明这不是一个空节，必须报错；
            //   * sh_offset 放宽：yh_asm 与 llvm-mc 都会把「节头表之前的
            //     字节数」写进空节的 sh_offset（违反 spec 的「全零」要求），
            //     而该字段在空节上没有语义、也不被链接器使用。为了能读自家
            //     汇编器的产物，这里只容忍这一个字段。
            if (sh_type != 0 || flags != 0 || sz != 0 || align != 0) {
                return obj.diag_file(c, o, "0 号节头字段不是全零");
            }
        } else if (sh_type == obj.SHT_REL.to_type(u32)) {
            return obj.diag_file(c, o, "存在 SHT_REL 节：AArch64 只接受 RELA");
        } else if (er_sections_one(e, i, shoff, name_off, sh_type, flags,
                off, sz, align, link, info, entsize) != 0) {
            return -1;
        }
        i += 1;
    }
    if (e.symtab_no < 0) {
        return obj.diag_file(c, o, "缺少符号表节 .symtab");
    }
    return 0;
}

// er_sections_one：处理一个非 0 号节头。返回 0 成功，-1 失败（已报诊断）。
fn er_sections_one(e *ErCtx, i int, shoff int, name_off int,
    sh_type u32, flags u64, off int, sz int, align int, link int, info int,
    entsize int) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    let nm *char = er_str_at(e, e.shstr_off, e.shstr_size, name_off);
    if (nm == 0) {
        return obj.diag_file(c, o, "节名偏移越界或未终止");
    }
    if (align != 0 && !obj.is_pow2(align)) {
        return obj.diag_at(c, o, nm, 0, "节对齐不是 2 的幂");
    }
    // 文件范围：NOBITS 不占文件字节
    if (sh_type != obj.SHT_NOBITS.to_type(u32)) {
        if (!er_fits(e, off, sz)) {
            return obj.diag_at(c, o, nm, 0, "节内容超出文件范围");
        }
    }
    if (sh_type == obj.SHT_SYMTAB.to_type(u32)) {
        return er_sec_symtab(e, i, nm, shoff, off, sz, link, entsize);
    }
    if (sh_type == obj.SHT_RELA.to_type(u32)) {
        return er_sec_rela(e, nm, shoff, sz, info, entsize);
    }
    // 合并节（.text/.rodata/.data/.bss）与其余节分开处理
    let kind int = er_sec_kind(nm);
    let isec *obj.ISec = &c.objs[o].secs[i];
    isec.name_off = name_off;
    isec.sh_type = sh_type;
    isec.flags = flags;
    isec.align = align;
    isec.off = off;
    isec.memsz = sz;
    isec.kind = kind;
    isec.discarded = 0;
    if (kind != obj.OSEC_NONE) {
        let want_type u32 = obj.SHT_PROGBITS.to_type(u32);
        if (kind == obj.OSEC_BSS) {
            want_type = obj.SHT_NOBITS.to_type(u32);
        }
        if (sh_type != want_type) {
            return obj.diag_at(c, o, nm, 0, "该节的类型与其用途不符");
        }
        if (kind == obj.OSEC_BSS) {
            isec.size = 0;
        } else {
            isec.size = sz;
        }
        if (!er_flags_alloc(flags)) {
            return obj.diag_at(c, o, nm, 0, "可合并节缺少 SHF_ALLOC");
        }
        if (kind == obj.OSEC_TEXT && !er_flags_exec(flags)) {
            return obj.diag_at(c, o, nm, 0, ".text 缺少 SHF_EXECINSTR");
        }
        return 0;
    }
    // 不参与合并的节：要么明确可忽略，要么报错
    if (er_ignorable(nm, sh_type, flags) != 0) {
        isec.kind = obj.OSEC_NONE;
        isec.discarded = 1;
        isec.size = 0;
        return 0;
    }
    return obj.diag_at(c, o, nm, 0,
        "不支持的节（既不是可合并节，也不是已列明的元数据节）");
}

// er_sec_symtab：处理 .symtab 节头（校验表项大小、关联字符串表与范围）。
fn er_sec_symtab(e *ErCtx, i int, nm *char, shoff int, off int, sz int,
    link int, entsize int) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    if (e.symtab_no >= 0) {
        return obj.diag_at(c, o, nm, 0, "存在多个符号表节");
    }
    if (entsize != obj.SYM_SIZE) {
        return obj.diag_at(c, o, nm, 0, "符号表项大小不是 24");
    }
    if (sz % obj.SYM_SIZE != 0) {
        return obj.diag_at(c, o, nm, 0, "符号表长度不是 24 的整数倍");
    }
    if (link < 1 || link >= e.shnum) {
        return obj.diag_at(c, o, nm, 0, "符号表的 sh_link 越界");
    }
    let lo int = shoff + link * obj.SHDR_SIZE;
    if (er_u32(e, lo + 4) != obj.SHT_STRTAB.to_type(u32)) {
        return obj.diag_at(c, o, nm, 0, "符号表的 sh_link 不是字符串表");
    }
    let loff int = er_hdr_u64(e, lo + 24);
    let lsz int = er_hdr_u64(e, lo + 32);
    if (!er_fits(e, loff, lsz)) {
        return obj.diag_at(c, o, nm, 0, "符号表关联的字符串表越界");
    }
    e.symtab_no = i;
    e.symtab_off = off;
    e.symtab_num = sz / obj.SYM_SIZE;
    e.strtab_off = loff;
    e.strtab_size = lsz;
    c.objs[o].strtab_off = loff;
    c.objs[o].strtab_size = lsz;
    return 0;
}

// er_sec_rela：处理 .rela.* 节头（校验表项大小、作用节是否参与合并）。
fn er_sec_rela(e *ErCtx, nm *char, shoff int, sz int, info int,
    entsize int) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    if (entsize != obj.RELA_SIZE) {
        return obj.diag_at(c, o, nm, 0, "重定位项大小不是 24");
    }
    if (sz % obj.RELA_SIZE != 0) {
        return obj.diag_at(c, o, nm, 0, "重定位表长度不是 24 的整数倍");
    }
    if (info < 1 || info >= e.shnum) {
        return obj.diag_at(c, o, nm, 0, "重定位表的 sh_info 越界");
    }
    // 作用节必须是本对象里参与合并的节（否则重定位无处安放）
    let to int = shoff + info * obj.SHDR_SIZE;
    let tname_off int = er_u32(e, to).to_type(u64).to_type(i64).to_type(int);
    let tname *char = er_str_at(e, e.shstr_off, e.shstr_size, tname_off);
    if (tname == 0) {
        return obj.diag_at(c, o, nm, 0, "重定位作用节的节名越界");
    }
    if (er_sec_kind(tname) == obj.OSEC_NONE) {
        return obj.diag_at(c, o, nm, 0,
            "重定位作用于不参与合并的节（该节会被丢弃）");
    }
    e.nrela += 1;
    e.nrel_entries += sz / obj.RELA_SIZE;
    return 0;
}

// er_symbols：解析符号表。局部符号只在本对象内可见；全局符号登记进全局表
// 的时间点是「解析阶段」（40_symtab.yh），这里只做字段级校验与登记。
fn er_symbols(e *ErCtx) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    let n int = e.symtab_num;
    if (obj.obj_syms_alloc(c, o, n) != 0) {
        return -1;
    }
    let i int = 0;
    for i < n {
        let so int = e.symtab_off + i * obj.SYM_SIZE;
        let name_off int = er_u32(e, so).to_type(u64).to_type(i64).to_type(int);
        let info u8 = c.objs[o].data[so + 4];
        let other u8 = c.objs[o].data[so + 5];
        let shndx int = obj.rd_u16le(c.objs[o].data, so + 6).to_type(int);
        let value int = er_u64(e, so + 8).to_type(u64).to_type(i64).to_type(int);
        let size int = er_u64(e, so + 16).to_type(u64).to_type(i64).to_type(int);
        let binding int = info.to_type(int) / 16;
        let symtype int = obj.low_bits(info.to_type(int), 16);
        let sym *obj.ISym = &c.objs[o].syms[i];
        sym.name_off = name_off;
        sym.binding = binding;
        sym.symtype = symtype;
        sym.shndx = shndx;
        sym.value = value;
        sym.size = size;
        if (obj.trace_enabled() != 0) {
            obj.buf_clear(&c.diag_buf);
            obj.db_put(&c.diag_buf, "  [er] obj=");
            obj.db_int(&c.diag_buf, o);
            obj.db_put(&c.diag_buf, " sym=");
            obj.db_int(&c.diag_buf, i);
            obj.db_put(&c.diag_buf, " 名=");
            obj.db_put(&c.diag_buf, obj.o_str_at(c, o, name_off));
            obj.db_put(&c.diag_buf, " bind=");
            obj.db_int(&c.diag_buf, binding);
            obj.db_put(&c.diag_buf, " type=");
            obj.db_int(&c.diag_buf, symtype);
            obj.db_put(&c.diag_buf, " shndx=");
            obj.db_int(&c.diag_buf, shndx);
            obj.db_put(&c.diag_buf, " val=");
            obj.db_int(&c.diag_buf, value);
            obj.db_put(&c.diag_buf, "\n");
            obj.dwrite(2, c.diag_buf.data, c.diag_buf.len);
        }
        if (name_off >= e.strtab_size) {
            return obj.diag_file(c, o, "符号名偏移越界");
        }
        if (binding != obj.STB_LOCAL && binding != obj.STB_GLOBAL) {
            return obj.diag_file(c, o,
                "只接受 STB_LOCAL/STB_GLOBAL（weak 未支持）");
        }
        if (symtype == obj.STT_TLS) {
            return obj.diag_file(c, o, "不支持线程局部（STT_TLS）符号");
        }
        if (symtype != obj.STT_NOTYPE && symtype != obj.STT_OBJECT
            && symtype != obj.STT_FUNC && symtype != obj.STT_FILE
            && symtype != obj.STT_SECTION) {
            return obj.diag_file(c, o, "符号类型不在支持范围");
        }
        if (other != 0) {
            return obj.diag_file(c, o, "符号可见性/其他位非 0（未支持）");
        }
        if (shndx == obj.SHN_XINDEX) {
            return obj.diag_file(c, o, "不支持 SHN_XINDEX 符号");
        }
        if (shndx == obj.SHN_COMMON) {
            return obj.diag_file(c, o, "不支持 common 符号（需要分配语义）");
        }
        if (shndx == obj.SHN_UNDEF) {
            // 0 号空符号允许全空；其余未定义局部符号拒绝（ELF 约定：
            // 未定义的符号只能是全局或映射符号，映射符号由解析阶段跳过）
            if (binding == obj.STB_LOCAL && i != 0) {
                let mnm *char = obj.o_str_at(c, o, name_off);
                if (er_is_mapping_sym(mnm) == 0) {
                    return obj.diag_file(c, o, "存在未定义的局部符号");
                }
            }
        } else if (shndx == obj.SHN_ABS) {
            // 绝对符号：取值就是绝对值，不需要节
        } else if (shndx < 1 || shndx >= e.shnum) {
            return obj.diag_file(c, o, "符号的节索引越界");
        } else if (er_symbols_sec(e, shndx, symtype, value) != 0) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

// er_symbols_sec：校验「定义在某个节里」的符号。返回 0 成功，-1 失败。
fn er_symbols_sec(e *ErCtx, shndx int, symtype int, value int) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    let kind int = c.objs[o].secs[shndx].kind;
    if (kind == obj.OSEC_NONE && c.objs[o].secs[shndx].discarded == 0) {
        return obj.diag_file(c, o, "符号定义在被拒绝的节里");
    }
    if (kind == obj.OSEC_NONE) {
        // 定义在已忽略的元数据节里：只有 FILE/SECTION 类符号可以留着
        if (symtype != obj.STT_FILE && symtype != obj.STT_SECTION) {
            return obj.diag_file(c, o, "符号定义在已忽略的元数据节里");
        }
    } else if (symtype != obj.STT_SECTION) {
        let limit int = c.objs[o].secs[shndx].size;
        if (kind == obj.OSEC_BSS) {
            limit = c.objs[o].secs[shndx].memsz;
        }
        if (value < 0 || value > limit) {
            return obj.diag_file(c, o, "符号取值超出所在节范围");
        }
    }
    return 0;
}

// er_relocs：解析全部 .rela.* 条目。条目按节头顺序拼接，顺序确定。
fn er_relocs(e *ErCtx) int {
    let c *obj.LinkCtx = e.c;
    let o int = e.o;
    if (e.nrel_entries == 0) {
        return 0;
    }
    if (obj.obj_rels_alloc(c, o, e.nrel_entries) != 0) {
        return -1;
    }
    let shoff int = er_hdr_u64(e, 40);
    let cur int = 0;
    let i int = 0;
    for i < e.shnum {
        let so int = shoff + i * obj.SHDR_SIZE;
        if (er_u32(e, so + 4) != obj.SHT_RELA.to_type(u32)) {
            i += 1;
            continue;
        }
        let off int = er_hdr_u64(e, so + 24);
        let sz int = er_hdr_u64(e, so + 32);
        let info int = er_u32(e, so + 44).to_type(u64).to_type(i64)
            .to_type(int);
        let n int = sz / obj.RELA_SIZE;
        let k int = 0;
        for k < n {
            let ro int = off + k * obj.RELA_SIZE;
            let r_off int = er_u64(e, ro).to_type(u64).to_type(i64)
                .to_type(int);
            let r_info u64 = er_u64(e, ro + 8);
            let r_add u64 = er_u64(e, ro + 16);
            let symidx int = (r_info / obj.pow2(32)).to_type(u64).to_type(i64)
                .to_type(int);
            let kind int = obj.low_bits_u(r_info, 32);
            if (symidx < 0 || symidx >= e.symtab_num) {
                return obj.diag_file(c, o, "重定位的符号索引越界");
            }
            if (er_rel_ok(kind) == 0) {
                let nm *char = er_str_at(e, e.shstr_off, e.shstr_size,
                    er_u32(e, so).to_type(u64).to_type(i64).to_type(int));
                let cn *char = nm;
                if (cn == 0) { cn = ".rela.*"; }
                return obj.diag_at(c, o, cn, r_off,
                    "重定位类型不在支持白名单内");
            }
            let tgt *obj.ISec = &c.objs[o].secs[info];
            if (r_off < 0 || r_off + 4 > tgt.size) {
                return obj.diag_file(c, o, "重定位位置超出作用节范围");
            }
            let r *obj.IRel = &c.objs[o].rels[cur];
            r.sec = info;
            r.off = r_off;
            r.sym = symidx;
            r.kind = kind.to_type(u32);
            r.addend = er_i64_from_u64(r_add);
            cur += 1;
            k += 1;
        }
        i += 1;
    }
    c.objs[o].nrel = cur;
    return 0;
}

// er_i64_from_u64：按补码把 64 位无符号位型还原成有符号数。
// 汇编器把 addend 按位型写进 RELA，读回来必须还原符号——
// 例如 @PAGEOFF 的 addend 12 是小正数，而 0xffffffffffffffff 是 -1。
fn er_i64_from_u64(v u64) i64 {
    let hi u64 = obj.pow2(63);
    if (v >= hi) {
        return (v - hi - hi).to_type(i64);
    }
    return v.to_type(i64);
}

// er_rel_ok：重定位类型白名单（与汇编器契约 §6 的 12 类一致）。
// 列表外一律拒绝，不静默忽略——静默忽略会产出看起来成功但值错的映像。
fn er_rel_ok(kind int) int {
    if (kind == 257) { return 1; }   // R_AARCH64_ABS64
    if (kind == 275) { return 1; }   // R_AARCH64_ADR_PREL_PG_HI21
    if (kind == 277) { return 1; }   // R_AARCH64_ADD_ABS_LO12_NC
    if (kind == 278) { return 1; }   // R_AARCH64_LDST8_ABS_LO12_NC
    if (kind == 280) { return 1; }   // R_AARCH64_CONDBR19
    if (kind == 282) { return 1; }   // R_AARCH64_JUMP26
    if (kind == 283) { return 1; }   // R_AARCH64_CALL26
    if (kind == 284) { return 1; }   // R_AARCH64_LDST16_ABS_LO12_NC
    if (kind == 285) { return 1; }   // R_AARCH64_LDST32_ABS_LO12_NC
    if (kind == 286) { return 1; }   // R_AARCH64_LDST64_ABS_LO12_NC
    if (kind == 311) { return 1; }   // R_AARCH64_LD64_GOTPAGE_LO21
    if (kind == 312) { return 1; }   // R_AARCH64_LD64_GOT_LO12_NC
    return 0;
}
