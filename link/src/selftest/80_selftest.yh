module selftest;

// ============================================================================
// selftest/80_selftest.yh —— 链接器自检（无参数运行的默认行为，退出码即门）
//
// 自检分两组：
//   A. 读取层拒绝路径：用**手工构造的字节**喂进 er_read_object，逐项验证
//      「坏输入必须被拒」——magic/class/机器类型/截断/节表越界/表项大小等。
//   B. 端到端最小链接：构造一个真实的（小）对象——.text 里是退出码 93 的
//      syscall 序列，含一条 bl 与一条 .rela.text 的 CALL26 重定位——用链接器
//      链成映像，再打开产物核对 ELF 头、程序头、静态性约束与重定位回填值。
//
// 为什么自检要自己造对象：链接器与汇编器解耦，不能 import 汇编器；真运行
// （qemu）属于 Python 门（tests/link_accept.py）的事。自检只做不需要执行
// 环境的部分：结构、字节、拒绝路径。真运行由 link/tests 下的门做。
// ============================================================================

import obj;
import elf;
import link;

// ObjBuild：自检用的 ELF64 对象构造脚手架。
// 各表先写进独立缓冲，拼装时按 8 字节对齐依次落盘，节头表放最后。
struct ObjBuild {
    out *obj.Buf;       // 目标缓冲（借自调用方）
    text obj.Buf;       // .text 内容
    nsym int;           // 符号项数（含 0 号空项）
    sym obj.Buf;        // .symtab 内容
    str obj.Buf;        // .strtab 内容
    shstr obj.Buf;      // .shstrtab 内容
    rela obj.Buf;       // .rela.text 内容（可空）
    nrela int;          // .rela.text 条目数
    text_off int;       // 各表在文件里的偏移（拼装时填）
    sym_off int;
    str_off int;
    shstr_off int;
    rela_off int;
    shoff int;
    nsh int;            // 输出节头项数（有无 .rela.text 不同）
}

// st_pass/st_fail：自检计数。st_fail > 0 时退出码非零，门据此判定。
let st_pass int = 0;
let st_fail int = 0;

// st_note：登记一项检查结果。失败时打印原因并返回 -1。
fn st_note(ok int, what *char) int {
    if (ok != 0) {
        st_pass += 1;
        return 0;
    }
    st_fail += 1;
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "自检失败: ");
    obj.db_put(&b, what);
    obj.db_put(&b, "\n");
    obj.dwrite(2, b.data, b.len);
    obj.buf_free(&b);
    return -1;
}

// —— 测试对象的构造 ——

// ob_pad8：把文件缓冲补到 8 字节对齐，返回新偏移。
fn ob_pad8(b *obj.Buf) int {
    let want int = obj.align_up(b.len, 8);
    if (want < 0) {
        return -1;
    }
    if (obj.buf_pad_to(b, want) != 0) {
        return -1;
    }
    return b.len;
}

// ob_strtab_add：向指定字符串表追加名字，返回偏移。
fn ob_strtab_add(b *obj.Buf, s *char) int {
    let off int = b.len;
    if (obj.buf_put_bytes(b, s.to_type(*u8), obj.cstr_len(s)) != 0) {
        return -1;
    }
    if (obj.buf_put(b, 0) != 0) {
        return -1;
    }
    return off;
}

// ob_init：初始化脚手架并登记 .text 机器码。
fn ob_init(e *ObjBuild, out *obj.Buf, text *u8, ntext int) int {
    e.out = out;
    e.nsym = 0;
    e.nrela = 0;
    e.nsh = 0;
    e.text_off = 0;
    e.sym_off = 0;
    e.str_off = 0;
    e.shstr_off = 0;
    e.rela_off = 0;
    e.shoff = 0;
    obj.buf_init(&e.text);
    obj.buf_init(&e.sym);
    obj.buf_init(&e.str);
    obj.buf_init(&e.shstr);
    obj.buf_init(&e.rela);
    if (obj.buf_put_bytes(&e.text, text, ntext) != 0) {
        return -1;
    }
    // .symtab / .strtab 的 0 号空项
    let z int = 0;
    for z < obj.SYM_SIZE {
        if (obj.buf_put(&e.sym, 0) != 0) { return -1; }
        z += 1;
    }
    e.nsym = 1;
    if (obj.buf_put(&e.str, 0) != 0) { return -1; }
    return 0;
}

// ob_add_sym：登记一个符号，返回它的符号表下标。
fn ob_add_sym(e *ObjBuild, name_off int, info int, shndx int, value int,
    size int) int {
    if (obj.buf_put_u32le(&e.sym, name_off.to_type(u32)) != 0) { return -1; }
    if (obj.buf_put(&e.sym, info.to_type(u8)) != 0) { return -1; }
    if (obj.buf_put(&e.sym, 0) != 0) { return -1; }
    if (obj.buf_put_u16le(&e.sym, shndx.to_type(u16)) != 0) { return -1; }
    if (obj.buf_put_u64le(&e.sym, value.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    if (obj.buf_put_u64le(&e.sym, size.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    e.nsym += 1;
    return e.nsym - 1;
}

// ob_add_rela：登记一条 RELA 重定位（作用节固定为 1 = .text）。
fn ob_add_rela(e *ObjBuild, off int, sym int, kind int, addend int) int {
    if (obj.buf_put_u64le(&e.rela, off.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    let info u64 = (sym.to_type(u64) << 32.to_type(u32))
        | kind.to_type(u64);
    if (obj.buf_put_u64le(&e.rela, info) != 0) { return -1; }
    if (obj.buf_put_u64le(&e.rela, addend.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    e.nrela += 1;
    return 0;
}

// ob_shdr：写一条节头（Elf64_Shdr 字段顺序，共 64 字节）。
fn ob_shdr(out *obj.Buf, name_off int, shtype int, flags int, off int,
    size int, link int, info int, align int, entsize int) int {
    if (obj.buf_put_u32le(out, name_off.to_type(u32)) != 0) { return -1; }
    if (obj.buf_put_u32le(out, shtype.to_type(u32)) != 0) { return -1; }
    if (obj.buf_put_u64le(out, flags.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    if (obj.buf_put_u64le(out, 0) != 0) { return -1; }        // sh_addr
    if (obj.buf_put_u64le(out, off.to_type(i64).to_type(u64)) != 0) { return -1; }
    if (obj.buf_put_u64le(out, size.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    if (obj.buf_put_u32le(out, link.to_type(u32)) != 0) { return -1; }
    if (obj.buf_put_u32le(out, info.to_type(u32)) != 0) { return -1; }
    if (obj.buf_put_u64le(out, align.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    if (obj.buf_put_u64le(out, entsize.to_type(i64).to_type(u64)) != 0) {
        return -1;
    }
    return 0;
}

// ob_finish：拼出完整对象字节，返回对象总长（失败返回 -1）。
//
// 节头表布局：0 NULL、1 .text、2 .symtab、3 .strtab、4 .rela.text（可选）、
// 最后一个 .shstrtab。符号表 sh_info 指向首个全局符号下标（本构造固定为 2：
// 空项 + $x 局部映射符号在前）。
fn ob_finish(e *ObjBuild) int {
    let out *obj.Buf = e.out;
    let has_rela int = 0;
    if (e.nrela > 0) {
        has_rela = 1;
    }
    let nsh int = 5;
    if (has_rela != 0) {
        nsh = 6;
    }
    e.nsh = nsh;
    let shstrndx int = nsh - 1;
    obj.buf_clear(out);
    // —— ELF 头（64 字节）——
    if (obj.buf_put(out, 0x7f) != 0) { return -1; }
    if (obj.buf_put(out, 'E') != 0) { return -1; }
    if (obj.buf_put(out, 'L') != 0) { return -1; }
    if (obj.buf_put(out, 'F') != 0) { return -1; }
    if (obj.buf_put(out, 2) != 0) { return -1; }
    if (obj.buf_put(out, 1) != 0) { return -1; }
    if (obj.buf_put(out, 1) != 0) { return -1; }
    let z int = 0;
    for z < 9 {
        if (obj.buf_put(out, 0) != 0) { return -1; }
        z += 1;
    }
    if (obj.buf_put_u16le(out, 1) != 0) { return -1; }        // ET_REL
    if (obj.buf_put_u16le(out, 183) != 0) { return -1; }      // EM_AARCH64
    if (obj.buf_put_u32le(out, 1) != 0) { return -1; }        // EV_CURRENT
    if (obj.buf_put_u64le(out, 0) != 0) { return -1; }        // e_entry
    if (obj.buf_put_u64le(out, 0) != 0) { return -1; }        // e_phoff
    if (obj.buf_put_u64le(out, 0) != 0) { return -1; }        // e_shoff（回填）
    if (obj.buf_put_u32le(out, 0) != 0) { return -1; }        // e_flags
    if (obj.buf_put_u16le(out, obj.EHDR_SIZE.to_type(u16)) != 0) { return -1; }
    if (obj.buf_put_u16le(out, 0) != 0) { return -1; }        // e_phentsize
    if (obj.buf_put_u16le(out, 0) != 0) { return -1; }        // e_phnum
    if (obj.buf_put_u16le(out, obj.SHDR_SIZE.to_type(u16)) != 0) { return -1; }
    if (obj.buf_put_u16le(out, nsh.to_type(u16)) != 0) { return -1; }
    if (obj.buf_put_u16le(out, shstrndx.to_type(u16)) != 0) { return -1; }
    // —— 内容 ——
    e.text_off = ob_pad8(out);
    if (e.text_off < 0) { return -1; }
    if (obj.buf_put_bytes(out, e.text.data, e.text.len) != 0) { return -1; }
    e.sym_off = ob_pad8(out);
    if (e.sym_off < 0) { return -1; }
    if (obj.buf_put_bytes(out, e.sym.data, e.sym.len) != 0) { return -1; }
    e.str_off = ob_pad8(out);
    if (e.str_off < 0) { return -1; }
    if (obj.buf_put_bytes(out, e.str.data, e.str.len) != 0) { return -1; }
    if (has_rela != 0) {
        e.rela_off = ob_pad8(out);
        if (e.rela_off < 0) { return -1; }
        if (obj.buf_put_bytes(out, e.rela.data, e.rela.len) != 0) { return -1; }
    }
    // .shstrtab：先放空串保证偏移 0 合法
    if (obj.buf_put(&e.shstr, 0) != 0) { return -1; }
    let n_text int = ob_strtab_add(&e.shstr, ".text");
    let n_sym int = ob_strtab_add(&e.shstr, ".symtab");
    let n_str int = ob_strtab_add(&e.shstr, ".strtab");
    let n_rela int = ob_strtab_add(&e.shstr, ".rela.text");
    let n_shstr int = ob_strtab_add(&e.shstr, ".shstrtab");
    if (n_text < 0 || n_sym < 0 || n_str < 0 || n_rela < 0 || n_shstr < 0) {
        return -1;
    }
    e.shstr_off = ob_pad8(out);
    if (e.shstr_off < 0) { return -1; }
    if (obj.buf_put_bytes(out, e.shstr.data, e.shstr.len) != 0) { return -1; }
    e.shoff = ob_pad8(out);
    if (e.shoff < 0) { return -1; }
    // —— 节头表 ——
    let k int = 0;
    for k < obj.SHDR_SIZE {
        if (obj.buf_put(out, 0) != 0) { return -1; }
        k += 1;
    }
    // 1 .text（SHF_ALLOC|SHF_EXECINSTR = 6，entsize 0）
    if (ob_shdr(out, n_text, 1, 6, e.text_off, e.text.len, 0, 0, 4, 0) != 0) {
        return -1;
    }
    // 2 .symtab（link → .strtab 下标 3，info → 首个全局符号 2，entsize 24）
    if (ob_shdr(out, n_sym, 2, 0, e.sym_off, e.sym.len, 3, 2, 8, 24) != 0) {
        return -1;
    }
    // 3 .strtab
    if (ob_shdr(out, n_str, 3, 0, e.str_off, e.str.len, 0, 0, 1, 0) != 0) {
        return -1;
    }
    // 4 .rela.text（link → .symtab 下标 2，info → 作用节下标 1，entsize 24）
    if (has_rela != 0) {
        if (ob_shdr(out, n_rela, 4, 0, e.rela_off, e.rela.len, 2, 1, 8, 24)
            != 0) {
            return -1;
        }
    }
    // .shstrtab
    if (ob_shdr(out, n_shstr, 3, 0, e.shstr_off, e.shstr.len, 0, 0, 1, 0)
        != 0) {
        return -1;
    }
    // 回填 e_shoff（0x28，小端 8 字节）
    if (obj.buf_patch32(out, 0x28, e.shoff.to_type(u64).to_type(u32)) != 0) {
        return -1;
    }
    if (obj.buf_patch32(out, 0x2c, (e.shoff.to_type(u64)
            >> 32.to_type(u32)).to_type(u32)) != 0) {
        return -1;
    }
    return out.len;
}

// st_build_min_object：构造一个含 _start 与一次 bl 调用的对象。
//
// .text 内容（20 字节）：
//   0x00  mov x0, #7        0xd28000e0
//   0x04  bl helper         0x94000000（imm26 由 CALL26 重定位回填）
//   0x08  helper: mov x8, #93  0xd2800ba8
//   0x0c  svc #0            0xd4000001
//   0x10  ret               0xd65f03c0
// 重定位：.rela.text 一条 CALL26 @0x04 → 符号 3（helper，局部）
// 符号：1 = $x（局部 NOTYPE，节 1），2 = _start（全局 FUNC，节 1，value 0），
//       3 = helper（局部 FUNC，节 1，value 8）
fn st_build_min_object(out *obj.Buf) int {
    let code [20]u8;
    let i int = 0;
    for i < 20 {
        code[i] = 0;
        i += 1;
    }
    code[0] = 0xe0; code[1] = 0x00; code[2] = 0x80; code[3] = 0xd2;
    code[4] = 0x00; code[5] = 0x00; code[6] = 0x00; code[7] = 0x94;
    code[8] = 0xa8; code[9] = 0x0b; code[10] = 0x80; code[11] = 0xd2;
    code[12] = 0x01; code[13] = 0x00; code[14] = 0x00; code[15] = 0xd4;
    code[16] = 0xc0; code[17] = 0x03; code[18] = 0x5f; code[19] = 0xd6;
    let e *ObjBuild = malloc(sizeof(ObjBuild).to_type(u64))
        .to_type(*ObjBuild);
    if (e == 0) {
        return -1;
    }
    if (ob_init(e, out, &code[0], 20) != 0) {
        free(e);
        return -1;
    }
    let n_x int = ob_strtab_add(&e.str, "$x");
    let n_start int = ob_strtab_add(&e.str, "_start");
    let n_helper int = ob_strtab_add(&e.str, "helper");
    if (n_x < 0 || n_start < 0 || n_helper < 0) {
        free(e);
        return -1;
    }
    ob_add_sym(e, n_x, 0, 1, 0, 0);                    // 1: $x 局部
    ob_add_sym(e, n_start, (1 << 4) | 2, 1, 0, 8);     // 2: _start 全局 FUNC
    ob_add_sym(e, n_helper, (0 << 4) | 2, 1, 8, 4);    // 3: helper 局部 FUNC
    ob_add_rela(e, 4, 3, 283, 0);                      // CALL26 @0x04 → helper
    let total int = ob_finish(e);
    obj.buf_free(&e.text);
    obj.buf_free(&e.sym);
    obj.buf_free(&e.str);
    obj.buf_free(&e.shstr);
    obj.buf_free(&e.rela);
    free(e);
    return total;
}

// —— A. 读取层拒绝路径 ——

// st_reject：把一份字节当作对象喂给读取层，期望被拒。
fn st_reject(what *char, data *u8, n int) int {
    let c *obj.LinkCtx = malloc(sizeof(obj.LinkCtx).to_type(u64))
        .to_type(*obj.LinkCtx);
    if (c == 0) {
        return -1;
    }
    let ts obj.TargetSpec = obj.ts_linux(65536);
    obj.ctx_init(c, &ts, "_start");
    let o int = elf.er_read_object(c, "selftest.o", data, n);
    let ok int = (o < 0).to_type(int);
    obj.ctx_free(c);
    free(c);
    return st_note(ok, what);
}

// st_reject_cases：读取层拒绝路径。逐份构造坏字节，要求全部被拒。
// 诊断会打到 stderr（这是产品行为，门按退出码判定，不看这些文字）。
fn st_reject_cases() int {
    let good obj.Buf;
    obj.buf_init(&good);
    let n int = st_build_min_object(&good);
    if (n <= 0) {
        obj.buf_free(&good);
        return st_note(0, "构造拒绝路径基线对象失败");
    }
    let rc int = 0;
    if (st_reject("截断对象必须被拒", good.data, 40) != 0) { rc = -1; }
    good.data[1] = 'X';
    if (st_reject("magic 错误必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[1] = 'E';
    good.data[4] = 1;
    if (st_reject("ELF32 必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[4] = 2;
    good.data[5] = 2;
    if (st_reject("大端必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[5] = 1;
    good.data[16] = 2;
    if (st_reject("ET_EXEC 输入必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[16] = 1;
    good.data[18] = 62;
    if (st_reject("非 AArch64 必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[18] = 183;
    let save0 u8 = good.data[0x28];
    good.data[0x28] = 0xff;
    if (st_reject("节头表越界必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[0x28] = save0;
    // 节头表里的偏移都是「相对 e_shoff」的，破坏字段时要把基址加回去。
    // .symtab 是 2 号节头：sh_entsize 在 +56（低字节）。
    let shoff u64 = obj.rd_u64le(good.data, 0x28);
    let shbase int = shoff.to_type(u64).to_type(i64).to_type(int);
    let sym_hdr int = shbase + 2 * obj.SHDR_SIZE;
    let save_ent u8 = good.data[sym_hdr + 56];
    good.data[sym_hdr + 56] = 32;
    if (st_reject("符号表项大小错误必须被拒", good.data, n) != 0) { rc = -1; }
    good.data[sym_hdr + 56] = save_ent;
    // 重定位类型不在白名单：.rela.text 是 4 号节头，条目在 sh_offset 处
    let rela_hdr int = shbase + 4 * obj.SHDR_SIZE;
    let rela_off u64 = obj.rd_u64le(good.data, rela_hdr + 24);
    let ro int = rela_off.to_type(u64).to_type(i64).to_type(int);
    let save_kind u8 = good.data[ro + 8];
    good.data[ro + 8] = 0x63;   // r_info 低 32 位 = 类型号，改成 99
    if (st_reject("白名单外的重定位类型必须被拒", good.data, n) != 0) {
        rc = -1;
    }
    good.data[ro + 8] = save_kind;
    obj.buf_free(&good);
    return rc;
}

// —— B. 端到端最小链接 ——

// st_check_image：核对链出的映像（ELF 头、程序头、静态性、重定位回填）。
fn st_check_image(img *obj.Buf) int {
    let d *u8 = img.data;
    if (img.len < 0x100) {
        return st_note(0, "映像短于头部区域");
    }
    if (d[0] != 0x7f || d[1] != 'E' || d[2] != 'L' || d[3] != 'F') {
        return st_note(0, "映像 magic 不符");
    }
    if (st_note((obj.rd_u16le(d, 16) == 2).to_type(int),
            "e_type 不是 ET_EXEC") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u16le(d, 18) == 183).to_type(int),
            "e_machine 不是 AArch64") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u64le(d, 24) == 0x400000.to_type(u64)).to_type(int),
            "入口地址不是 0x400000") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u64le(d, 32) == 64.to_type(u64)).to_type(int),
            "e_phoff 不是 64") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u16le(d, 54) == 56).to_type(int),
            "e_phentsize 不是 56") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u16le(d, 56) == 3).to_type(int),
            "程序头不是 3 个") != 0) {
        return -1;
    }
    let p int = 64;
    if (st_note((obj.rd_u32le(d, p) == 1).to_type(int),
            "1 号程序头不是 PT_LOAD") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u32le(d, p + 4) == 5).to_type(int),
            "1 号段权限不是 RX") != 0) {
        return -1;
    }
    // 头部预留 0x10000：文件偏移与虚拟地址都从它开始
    if (st_note((obj.rd_u64le(d, p + 8) == 0x10000.to_type(u64)).to_type(int),
            "1 号段文件偏移不是 0x10000") != 0) {
        return -1;
    }
    if (st_note((obj.rd_u64le(d, p + 16) == 0x400000.to_type(u64)).to_type(int),
            "1 号段虚拟地址不是 0x400000") != 0) {
        return -1;
    }
    let page u64 = obj.rd_u64le(d, p + 48);
    if (st_note((page == 65536.to_type(u64)).to_type(int),
            "段对齐不是 65536") != 0) {
        return -1;
    }
    let k int = 0;
    for k < 3 {
        let q int = p + k * obj.PHDR_SIZE;
        let off u64 = obj.rd_u64le(d, q + 8);
        let va u64 = obj.rd_u64le(d, q + 16);
        let fsz u64 = obj.rd_u64le(d, q + 32);
        let msz u64 = obj.rd_u64le(d, q + 40);
        let al u64 = obj.rd_u64le(d, q + 48);
        if (st_note((fsz <= msz).to_type(int), "段 p_filesz > p_memsz") != 0) {
            return -1;
        }
        let offi int = off.to_type(u64).to_type(i64).to_type(int);
        let vai int = va.to_type(u64).to_type(i64).to_type(int);
        let ali int = al.to_type(u64).to_type(i64).to_type(int);
        if (st_note((obj.low_bits(vai - offi, ali) == 0).to_type(int),
                "段偏移与虚拟地址不同余") != 0) {
            return -1;
        }
        if (k == 2) {
            let rwflags int = obj.rd_u32le(d, q + 4).to_type(u64).to_type(i64)
                .to_type(int);
            if (st_note((obj.flags_has(rwflags, 1) == 0).to_type(int),
                    "RW 段带可执行权限") != 0) {
                return -1;
            }
        }
        k += 1;
    }
    // .text 起点（文件 0x10000）：首条指令原样、第二条 CALL26 位移为 +4
    if (st_note((obj.rd_u32le(d, 0x10000) == 0xd28000e0.to_type(u32))
            .to_type(int), "首条指令被破坏") != 0) {
        return -1;
    }
    // CALL26：P = 0x400004，S(helper) = 0x400008 → (S−P)>>2 = 1
    let w1 u32 = obj.rd_u32le(d, 0x10004);
    if (st_note((obj.low_bits_u(w1.to_type(u64), 26) == 1).to_type(int),
            "CALL26 位移未正确回填") != 0) {
        return -1;
    }
    return 0;
}

// st_link_min：端到端自检：最小对象 → 链接 → 核对映像。
fn st_link_min() int {
    let objbuf obj.Buf;
    obj.buf_init(&objbuf);
    let n int = st_build_min_object(&objbuf);
    if (n <= 0) {
        obj.buf_free(&objbuf);
        return st_note(0, "构造最小对象失败");
    }
    let c *obj.LinkCtx = malloc(sizeof(obj.LinkCtx).to_type(u64))
        .to_type(*obj.LinkCtx);
    if (c == 0) {
        obj.buf_free(&objbuf);
        return -1;
    }
    let ts obj.TargetSpec = obj.ts_linux(65536);
    obj.ctx_init(c, &ts, "_start");
    c.verbose = 0;
    let paths [1]*char;
    paths[0] = "selftest.o";
    let data [1]*u8;
    let sizes [1]int;
    data[0] = objbuf.data;
    sizes[0] = n;
    let img obj.Buf;
    obj.buf_init(&img);
    let rc int = link.li_link(c, &paths[0], &data[0], &sizes[0], 1, &img);
    if (rc != 0) {
        st_note(0, "最小对象链接失败");
        rc = -1;
    } else {
        rc = st_check_image(&img);
    }
    obj.buf_free(&img);
    obj.ctx_free(c);
    free(c);
    obj.buf_free(&objbuf);
    return rc;
}

// —— C. 多对象合并 ——

// st_build_pair：构造「引用方 + 定义方」两个对象，用于验证跨对象符号解析。
//
//   mode 0 = 引用方：.text 8 字节
//       0x00  mov x0, #7      0xd28000e0
//       0x04  bl helper       0x94000000（CALL26 → 符号 3，全局未定义）
//     符号：1 = $x（局部），2 = _start（全局 FUNC，节 1，value 0），
//           3 = helper（全局 FUNC，SHN_UNDEF）
//
//   mode 1 = 定义方：.text 12 字节
//       0x00  nop             0xd503201f
//       0x04  helper: mov w0, #42   0x52800540
//       0x08  ret             0xd65f03c0
//     符号：1 = $x（局部），2 = helper（全局 FUNC，节 1，value 4）
//
// 定义方的 helper 特意放在节内偏移 4：链接后它的地址必须是
//   输出节基址 + 本输入节在输出节内的偏移 + 4
// 三项之和。漏掉中间一项（早期版本的 bug）会让位移算成 0——也就是 bl 跳到
// 调用者自己，运行期死循环。自检按 imm26 精确判定。
fn st_build_pair(out *obj.Buf, mode int) int {
    let ref [8]u8;
    let def [12]u8;
    let e *ObjBuild = malloc(sizeof(ObjBuild).to_type(u64))
        .to_type(*ObjBuild);
    if (e == 0) {
        return -1;
    }
    if (mode == 0) {
        ref[0] = 0xe0; ref[1] = 0x00; ref[2] = 0x80; ref[3] = 0xd2;
        ref[4] = 0x00; ref[5] = 0x00; ref[6] = 0x00; ref[7] = 0x94;
        if (ob_init(e, out, &ref[0], 8) != 0) {
            free(e);
            return -1;
        }
        let nx int = ob_strtab_add(&e.str, "$x");
        let ns int = ob_strtab_add(&e.str, "_start");
        let nh int = ob_strtab_add(&e.str, "helper");
        if (nx < 0 || ns < 0 || nh < 0) {
            free(e);
            return -1;
        }
        ob_add_sym(e, nx, 0, 1, 0, 0);                 // 1: $x 局部
        ob_add_sym(e, ns, (1 << 4) | 2, 1, 0, 8);      // 2: _start 全局 FUNC
        ob_add_sym(e, nh, (1 << 4) | 2, 0, 0, 0);      // 3: helper 全局 FUNC 未定义
        ob_add_rela(e, 4, 3, 283, 0);                  // CALL26 @0x04 → 符号 3
    } else {
        def[0] = 0x1f; def[1] = 0x20; def[2] = 0x03; def[3] = 0xd5;
        def[4] = 0x40; def[5] = 0x05; def[6] = 0x80; def[7] = 0x52;
        def[8] = 0xc0; def[9] = 0x03; def[10] = 0x5f; def[11] = 0xd6;
        if (ob_init(e, out, &def[0], 12) != 0) {
            free(e);
            return -1;
        }
        let nx2 int = ob_strtab_add(&e.str, "$x");
        let nh2 int = ob_strtab_add(&e.str, "helper");
        if (nx2 < 0 || nh2 < 0) {
            free(e);
            return -1;
        }
        ob_add_sym(e, nx2, 0, 1, 0, 0);                // 1: $x 局部
        ob_add_sym(e, nh2, (1 << 4) | 2, 1, 4, 8);     // 2: helper 全局 FUNC，偏移 4
    }
    let total int = ob_finish(e);
    obj.buf_free(&e.text);
    obj.buf_free(&e.sym);
    obj.buf_free(&e.str);
    obj.buf_free(&e.shstr);
    obj.buf_free(&e.rela);
    free(e);
    return total;
}

// st_multi_obj：多对象端到端自检。
//
// 合并后的 .text = 引用方 8 字节 + 定义方 12 字节，共 20 字节，基址 0x400000：
//   helper 最终地址 = 0x400000 + 8 + 4 = 0x40000c
//   CALL26 在 P = 0x400004，imm26 = (S − P) / 4 = 2
// 同时核对输出符号表里 helper 的 st_value 也是 0x40000c。
fn st_multi_obj() int {
    let bufa obj.Buf;
    let bufb obj.Buf;
    obj.buf_init(&bufa);
    obj.buf_init(&bufb);
    let na int = st_build_pair(&bufa, 0);
    let nb int = st_build_pair(&bufb, 1);
    if (na <= 0 || nb <= 0) {
        obj.buf_free(&bufa);
        obj.buf_free(&bufb);
        return st_note(0, "构造多对象语料失败");
    }
    let c *obj.LinkCtx = malloc(sizeof(obj.LinkCtx).to_type(u64))
        .to_type(*obj.LinkCtx);
    if (c == 0) {
        obj.buf_free(&bufa);
        obj.buf_free(&bufb);
        return -1;
    }
    let ts obj.TargetSpec = obj.ts_linux(65536);
    obj.ctx_init(c, &ts, "_start");
    let paths [2]*char;
    paths[0] = "ref.o";
    paths[1] = "def.o";
    let data [2]*u8;
    let sizes [2]int;
    data[0] = bufa.data;
    sizes[0] = na;
    data[1] = bufb.data;
    sizes[1] = nb;
    let img obj.Buf;
    obj.buf_init(&img);
    let rc int = 0;
    if (link.li_link(c, &paths[0], &data[0], &sizes[0], 2, &img) != 0) {
        rc = st_note(0, "两个对象链接失败");
    } else {
        // CALL26 的 imm26 必须是 2（见上面的地址推导）
        let w u32 = obj.rd_u32le(img.data, 0x10004);
        if (st_note((obj.low_bits_u(w.to_type(u64), 26) == 2).to_type(int),
                "跨对象 CALL26 位移不是 2（符号地址漏加节内偏移）") != 0) {
            rc = -1;
        }
        // 定义方 .text 首条 nop 必须原样落在 0x400008
        if (st_note((obj.rd_u32le(img.data, 0x10008) == 0xd503201f.to_type(u32))
                .to_type(int), "第二个对象的节内容未落在预期偏移") != 0) {
            rc = -1;
        }
        // 输出符号表里 helper 的值必须是 0x40000c
        if (st_find_out_sym(img.data, "helper", 0x40000c) != 0) {
            rc = -1;
        }
    }
    obj.buf_free(&img);
    obj.ctx_free(c);
    free(c);
    obj.buf_free(&bufa);
    obj.buf_free(&bufb);
    return rc;
}

// st_find_out_sym：在输出映像的 .symtab 里找符号名，核对其 st_value。
// 找不到或值不符返回 -1 并记一条失败。
fn st_find_out_sym(d *u8, want *char, wantval int) int {
    let shoff int = obj.rd_u64le(d, 40).to_type(u64).to_type(i64).to_type(int);
    let shnum int = obj.rd_u16le(d, 60).to_type(u16).to_type(int);
    let i int = 0;
    for i < shnum {
        let so int = shoff + i * obj.SHDR_SIZE;
        let stype int = obj.rd_u32le(d, so + 4).to_type(u32).to_type(u64)
            .to_type(i64).to_type(int);
        if (stype == 2) {
            let off int = obj.rd_u64le(d, so + 24).to_type(u64).to_type(i64)
                .to_type(int);
            let size int = obj.rd_u64le(d, so + 32).to_type(u64).to_type(i64)
                .to_type(int);
            let link int = obj.rd_u32le(d, so + 40).to_type(u32).to_type(u64)
                .to_type(i64).to_type(int);
            let st_off int = obj.rd_u64le(d, shoff + link * obj.SHDR_SIZE + 24)
                .to_type(u64).to_type(i64).to_type(int);
            let n int = size / obj.SYM_SIZE;
            let k int = 0;
            for k < n {
                let eo int = off + k * obj.SYM_SIZE;
                let no int = obj.rd_u32le(d, eo).to_type(u32).to_type(u64)
                    .to_type(i64).to_type(int);
                if (obj.cstr_eq((d + st_off + no).to_type(*char), want) != 0) {
                    let v int = obj.rd_u64le(d, eo + 8).to_type(u64)
                        .to_type(i64).to_type(int);
                    return st_note((v == wantval),
                        "输出符号表里 helper 的地址不是 0x40000c");
                }
                k += 1;
            }
        }
        i += 1;
    }
    return st_note(0, "输出符号表里找不到 helper");
}

// st_check_ops：基础算术/位段原语自检（链接器全部地址计算的基础）。
//
// 2026-10-12 实测固化的结论（种子编译器 arm64 后端，见 obj/10_bytes.yh）：
//   * `%` 在被除数较大时错值：0x510000 % 0x10000 得到 0（应为 0x1000）；
//   * `&` 在立即数 ≥ 0x10000 时错值：5308416 & 65535 得到 0（应为 4096）；
//   * `*` 也会错值：81 * 65536 有时得到 5304320（差 4096）；
//   * `+` 与 `-` 目前未观察到错值，`/` 在中等量级正确。
// 因此链接器的取位原语**不依赖乘法**：一律用「减去高位部分」的减法表达，
// 并在自检里对每个用到的量级做一次固定回归。原语一旦改回乘法/位运算实现，
// 这里立刻变红。
fn st_check_ops() int {
    let rc int = 0;
    // 除法（取位原语的唯一依赖：v / 2^k 得到高位部分）
    if (st_note((0x510000 / 0x10000) == 81, "0x510000/0x10000 应为 81") != 0) {
        rc = -1;
    }
    if (st_note((0x400008 / 0x1000) == 0x400, "0x400008/0x1000 应为 0x400") != 0) {
        rc = -1;
    }
    if (st_note((0x510000 / 0x1000) == 0x510, "0x510000/0x1000 应为 0x510") != 0) {
        rc = -1;
    }
    // 减法（取位原语的第二步：v − 高位部分×2^k 用「除以 2^k 再乘回」表达）
    if (st_note((0x510000 - 0x500000) == 0x10000,
            "0x510000-0x500000 应为 0x10000") != 0) {
        rc = -1;
    }
    if (st_note((0x400008 - 0x400000) == 8, "0x400008-0x400000 应为 8") != 0) {
        rc = -1;
    }
    // 位移：pow2 的实现依赖它
    if (st_note((0x400000 >> 12) == 0x400, "0x400000>>12 应为 0x400") != 0) {
        rc = -1;
    }
    // 乘法：取位原语的缩放一律走 obj.mul_add（累加），这里核对它与 `*` 一致
    if (st_note((obj.mul_add(81, 65536) == 0x510000),
            "mul_add(81,65536) 应为 0x510000") != 0) {
        rc = -1;
    }
    if (st_note((obj.mul_add(0x510, 0x1000) == 0x510000),
            "mul_add(0x510,0x1000) 应为 0x510000") != 0) {
        rc = -1;
    }
    // 幂与低位：low_bits 只依赖 `/` 与 mul_add
    if (st_note((obj.pow2(16) == 0x10000.to_type(u64)), "pow2(16) 应为 0x10000")
        != 0) {
        rc = -1;
    }
    let lb_v int = 0x510000;
    let lb_a int = 0x10000;
    if (st_note((lb_v / lb_a == 81), "0x510000/0x10000 应为 81") != 0) {
        rc = -1;
    }
    if (st_note((obj.low_bits(lb_v, lb_a) == 0),
            "low_bits(0x510000,0x10000) 应为 0") != 0) {
        rc = -1;
    }
    if (st_note((obj.low_bits(0x510008, 0x10000) == 8),
            "low_bits(0x510008,0x10000) 应为 8") != 0) {
        rc = -1;
    }
    if (st_note((0x510008 % 0x10000 == 8), "0x510008%0x10000 应为 8") != 0) {
        rc = -1;
    }
    let and_r int = 0x510008 & 0xffff;
    if (st_note((and_r == 8), "0x510008&0xffff 应为 8") != 0) {
        rc = -1;
    }
    if (st_note((obj.low_bits(0x500000, 0x10000) == 0),
            "low_bits(0x500000,0x10000) 应为 0") != 0) {
        rc = -1;
    }
    if (st_note((obj.low_bits(0x400008, 0x1000) == 8),
            "low_bits(0x400008,0x1000) 应为 8") != 0) {
        rc = -1;
    }
    // 取位与写位（指令字位段读写的基础）
    let iw u64 = 0xd28000e0.to_type(u64);
    if (st_note((obj.hi_bits(iw, 24, 32) == 0xd2), "hi_bits 取位段结果错") != 0) {
        rc = -1;
    }
    let w u64 = obj.set_bits_u(iw, 5, 21, 0x123.to_type(u64));
    if (st_note((obj.hi_bits(w, 5, 21) == 0x123), "set_bits_u 写位段结果错")
        != 0) {
        rc = -1;
    }
    if (st_note((obj.hi_bits(w, 24, 32) == 0xd2), "set_bits_u 破坏了其他位段")
        != 0) {
        rc = -1;
    }
    // 指令字形态判据（重定位前置校验的基础）
    let adrp_w u64 = 0x90000000.to_type(u64);
    if (st_note((obj.hi_bits(adrp_w, 24, 32) == 0x90), "adrp 形态判据错") != 0) {
        rc = -1;
    }
    let bl_w u64 = 0x94000000.to_type(u64);
    if (st_note((obj.hi_bits(bl_w, 26, 31) == 5), "bl 形态判据错") != 0) {
        rc = -1;
    }
    // 整除与标志位判定
    if (st_note((obj.divisible_by(0x510000, 0x10000) == 1),
            "0x510000 应被 0x10000 整除") != 0) {
        rc = -1;
    }
    if (st_note((obj.divisible_by(0x510008, 0x10000) == 0),
            "0x510008 不应被 0x10000 整除") != 0) {
        rc = -1;
    }
    if (st_note((obj.flags_has(6, 4) == 1), "flags_has(6,4) 应为 1") != 0) {
        rc = -1;
    }
    if (st_note((obj.flags_has(2, 4) == 0), "flags_has(2,4) 应为 0") != 0) {
        rc = -1;
    }
    return rc;
}

// st_selftest：自检入口。返回 0 表示全部通过。
// 四组：基础算子与原语、读取层拒绝路径、单对象端到端链接、多对象合并。
pub fn st_selftest() int {
    st_pass = 0;
    st_fail = 0;
    st_check_ops();
    st_reject_cases();
    st_link_min();
    st_multi_obj();
    let b obj.Buf;
    obj.buf_init(&b);
    obj.db_put(&b, "yh_link 自检: 通过 ");
    obj.db_int(&b, st_pass);
    obj.db_put(&b, " 项，失败 ");
    obj.db_int(&b, st_fail);
    obj.db_put(&b, " 项\n");
    obj.dwrite(1, b.data, b.len);
    obj.buf_free(&b);
    if (st_fail > 0) {
        return 1;
    }
    return 0;
}
