module link;

// ============================================================================
// link/80_link.yh —— 链接总流程（对外唯一入口）
//
// 流程（每一步失败即返回 -1，诊断已打印，不产出半成品）：
//
//   1. 逐个读取并校验输入对象（elf.er_read_object）；
//   2. 建立全局符号表、绑定引用位置（elf.st_collect / st_bind_refs）；
//   3. **先报未定义符号**——链接必然失败就不要继续布局；
//   4. 符号分类（elf.st_resolve）→ 节合并与地址分配（elf.ly_build），
//      GOT 槽位在该步分配并回填；
//   5. 建重定位位图（elf.rl_alloc_bitmap）→ 应用全部重定位（elf.rl_apply_all）；
//   6. 写出静态 ET_EXEC 映像（elf.ew_write_image）。
//
// 输入字节归调用方所有：本函数只读，不修改也不释放 in_data / in_size；
// 输出字节写进调用方的 out 缓冲，失败时不保证 out 内容可用（调用方应丢弃）。
// ============================================================================

import obj;
import elf;

// li_stage：最近完成的链接阶段（阶段名）。只在链接失败且一条诊断都没打出来时
// 由调用方读出来补一条「内部错误」——静默失败是最难查的一类问题。
let li_stage_name *char = "未开始";

// li_stage_set：记录当前阶段（主流程在每个阶段入口调用）。
fn li_stage_set(s *char) int {
    li_stage_name = s;
    return 0;
}

// li_stage：读回最近完成的阶段名。
pub fn li_stage() *char {
    return li_stage_name;
}

// li_link：把 n 个输入对象链成一份静态 ELF 映像。
// paths 是每个对象的文件名（诊断用，借自调用方）。
// 成功返回 0；失败返回 -1（已打印带文件名的诊断）。
pub fn li_link(c *obj.LinkCtx, paths **char, in_data **u8, in_size *int, n int,
    out *obj.Buf) int {
    if (n <= 0) {
        return obj.diag_plain(c, "没有输入对象");
    }
    let i int = 0;
    for i < n {
        if (in_data[i] == 0 || in_size[i] <= 0) {
            return obj.diag_plain(c, "输入对象为空");
        }
        i += 1;
    }
    // 1) 读取与校验
    li_stage_set("读取对象");
    i = 0;
    for i < n {
        if (elf.er_read_object(c, paths[i], in_data[i], in_size[i]) < 0) {
            return -1;
        }
        i += 1;
    }
    // 2) 全局符号表与引用位置
    li_stage_set("全局符号收集");
    if (elf.st_collect(c) != 0) {
        return -1;
    }
    li_stage_set("引用位置绑定");
    if (elf.st_bind_refs(c) != 0) {
        return -1;
    }
    // 3) 未定义符号：一次报全，早于布局
    li_stage_set("未定义符号检查");
    if (elf.st_report_undef(c) != 0) {
        return -1;
    }
    // 4) 符号分类 + 布局
    li_stage_set("符号分类");
    if (elf.st_resolve(c) != 0) {
        return -1;
    }
    li_stage_set("布局");
    if (elf.ly_build(c) != 0) {
        return -1;
    }
    // 5) 重定位
    li_stage_set("重定位位图");
    if (elf.rl_alloc_bitmap(c) != 0) {
        return -1;
    }
    li_stage_set("重定位应用");
    if (elf.rl_apply_all(c) != 0) {
        return -1;
    }
    // 6) 写出映像
    li_stage_set("写出映像");
    if (elf.ew_write_image(c, out) != 0) {
        return -1;
    }
    li_stage_set("完成");
    if (c.verbose != 0) {
        elf.ly_report(c);
    }
    return 0;
}
