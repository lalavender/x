// yh 编译器模块依赖图（L3 组件级 drill-down）
// 快照：2026-11-10，llvm 分支工作区（含未提交 errors 重构）
// 产出技能：system-modeler + graphviz；证据：system-model.evidence.md §3
// 过滤约定：所有模块都 import 底座 support/errors/token，这三类边全部省略不画；
//           其余 import 边全量保留。箭头方向 = import 方 → 被依赖方。
// errors 为工作区新增最底层（support/diag.yh 已删除），文档分层表尚未收录。
digraph compiler_modules {
    rankdir=TB
    nodesep=0.35
    ranksep=0.55
    labelloc="t"
    label="yh 编译器模块依赖（2026-11-10 工作区快照；已省略 →support/errors/token 公共底座边）"
    fontname="Helvetica"
    fontsize=13
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef3fb", color="#5a6b85"]
    edge [fontname="Helvetica", fontsize=9, color="#5a6b85"]

    subgraph cluster_l6 {
        label="L6 入口与测试"
        style="rounded,dashed"
        color="#9aa7ba"
        main [label="main\ncompiler/cmd/yh/\nCLI 声明与分派"]
        testkit [label="testkit\nyh test 发现/构建/执行"]
    }

    subgraph cluster_l5 {
        label="L5 构建编排"
        style="rounded,dashed"
        color="#9aa7ba"
        build [label="build\n项目扫描/模块调度/缓存/流水线"]
    }

    subgraph cluster_l4 {
        label="L4 链接驱动"
        style="rounded,dashed"
        color="#9aa7ba"
        link [label="link\nDarwin/Windows 链接与链接缓存"]
    }

    subgraph cluster_l3 {
        label="L3 后端"
        style="rounded,dashed"
        color="#9aa7ba"
        backend [label="backend\nIRModule → LLVM IR 文本"]
    }

    subgraph cluster_l2 {
        label="L2 装配与降低"
        style="rounded,dashed"
        color="#9aa7ba"
        parse [label="parse\n递归下降 + 接口 .s.i/.s.ct"]
        builtin [label="builtin\n内建函数/类型登记"]
        lower [label="lower\nCheckedModule → IRModule"]
    }

    subgraph cluster_l1 {
        label="L1 语义与前端数据"
        style="rounded,dashed"
        color="#9aa7ba"
        check [label="check\n语义中心/受检快照/C ABI"]
        comptime [label="comptime\n编译期执行器（不依赖 check）"]
        ast [label="ast\n语法树 arena + 只读视图"]
        proj [label="proj\n项目模型（build/proj/）"]
    }

    subgraph cluster_l0 {
        label="L0 底座"
        style="rounded,dashed"
        color="#9aa7ba"
        errors [label="errors\n统一诊断基座（工作区新增，未提交）", fillcolor="#fff3cd"]
        support [label="support\n会话/共享数据层/平台原语"]
        token [label="token\nTK_* 词汇与游标"]
        ir [label="ir\nSSA IR 模型（零依赖）"]
        cache [label="cache\n内容寻址缓存（build/cache/）"]
        lex [label="lex\n字节级词法器"]
    }

    bridge [label="LLVM/lld 静态桥\ncompiler/llvm/*.c/cpp\nyh_llvm_emit / yh_lld_link", shape=component, fillcolor="#fdebd0", color="#b9770e"]
    libs [label="yh_libs 标准库\nhash / os / cli", shape=folder, fillcolor="#e8f6ef", color="#1e8449"]

    // L1 内部与向下边
    ast -> proj
    ast -> comptime
    check -> proj
    check -> ast
    check -> comptime
    check -> cache
    check -> ir
    cache -> libs [label="import hash", color="#1e8449", fontcolor="#1e8449"]

    // L2
    parse -> lex
    parse -> proj
    parse -> ast
    parse -> comptime
    parse -> check
    parse -> ir
    builtin -> check
    lower -> proj
    lower -> ast
    lower -> check
    lower -> cache
    lower -> ir

    // L3 后端 → C 桥
    backend -> ir
    backend -> bridge [label="extern C ABI", color="#b9770e", fontcolor="#b9770e"]

    // L4 链接
    link -> proj
    link -> backend
    link -> libs [label="import hash", color="#1e8449", fontcolor="#1e8449"]

    // L5 构建编排（全量下层边）
    build -> proj
    build -> ast
    build -> comptime
    build -> check
    build -> cache
    build -> ir
    build -> lex
    build -> parse
    build -> builtin
    build -> lower
    build -> backend
    build -> link
    build -> libs [label="import hash / libs.os", color="#1e8449", fontcolor="#1e8449"]

    // L6
    testkit -> proj
    testkit -> ast
    testkit -> parse
    testkit -> build
    testkit -> link
    main -> proj
    main -> lex
    main -> parse
    main -> check
    main -> build
    main -> link
    main -> testkit
    main -> libs [label="import libs.cli", color="#1e8449", fontcolor="#1e8449"]
}