// yh 标准库（yh_libs）模块分层图
// 快照：2026-11-10，llvm 分支工作区
// 产出技能：system-modeler + graphviz；证据：system-model.evidence.md §4
// 箭头方向 = import 方 → 被依赖方。
// 注意：string/memory/testing 三个模块目录存在且声明同名模块，但未列入
//       libs/project.toml 的 [lib] 注册表（14 项）；其对外可导入性待验证，
//       图中以虚线边框标注。模块间项目内 import 不受影响。
digraph stdlib_modules {
    rankdir=TB
    nodesep=0.4
    ranksep=0.6
    labelloc="t"
    label="yh_libs 标准库模块分层（2026-11-10；虚线 = 未在 [lib] 注册，待验证）"
    fontname="Helvetica"
    fontsize=13
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#e8f6ef", color="#1e8449"]
    edge [fontname="Helvetica", fontsize=9, color="#5a6b85"]

    subgraph cluster_app {
        label="应用层（文件/文本/协议能力）"
        style="rounded,dashed"
        color="#9aa7ba"
        io [label="io\n字节流 Reader/Writer"]
        net [label="net\nTCP/UDP 与地址解析"]
        fmt [label="fmt\n格式化运行时"]
        cli [label="cli\nargparse 风格命令行"]
        json [label="json\nRFC 8259 读写"]
        toml [label="toml\nTOML 1.1 解析"]
    }

    subgraph cluster_osabs {
        label="系统抽象层"
        style="rounded,dashed"
        color="#9aa7ba"
        os [label="os\n显式错误/结果类型"]
        time [label="time\n单调时钟"]
    }

    subgraph cluster_data {
        label="基础数据结构"
        style="rounded,dashed"
        color="#9aa7ba"
        string [label="string\nView/String", style="rounded,filled,dashed"]
        list [label="list\n零拷贝字节列表"]
    }

    subgraph cluster_leaf {
        label="叶子层（无模块内 import）"
        style="rounded,dashed"
        color="#9aa7ba"
        sys [label="sys\n系统调用 -errno 原语"]
        memory [label="memory\nmalloc/memcpy 包装", style="rounded,filled,dashed"]
        num [label="num\n整数转换"]
        math [label="math\n宿主 C 数学函数"]
        libc [label="libc\n纯 yh 的 C ABI libc"]
        hash [label="hash\nSHA-256"]
        testing [label="testing\nyh test 运行时辅助", style="rounded,filled,dashed"]
    }

    io -> os
    net -> os
    net -> string
    net -> sys
    fmt -> string
    fmt -> os
    fmt -> io
    cli -> os
    cli -> io
    json -> num
    json -> string
    json -> memory
    json -> os
    toml -> os

    os -> sys
    time -> sys
    string -> memory
    list -> memory
}