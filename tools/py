#!/bin/sh
# 统一 Python 入口：挑选 ≥3.10 的解释器后原样执行参数。
#
# 背景：macOS 自带的 /usr/bin/python3 可能是 3.9，而 tools/ 下的脚本用
# `X | None`（PEP 604，3.10 起）写成，过旧解释器会直接 TypeError；
# justfile 的反引号表达式又**不能**插值 just 变量（`{{ py }}` 会原样进 shell），
# 所以反引号只能调 PATH 上的命令名或本文件这种仓库内相对路径。
# 这里集中做一次版本探测，让配方与反引号共用同一套选择逻辑。
#
# 选择顺序：YH_PYTHON（本脚本专用覆盖）→ python3 → python → 具体小版本。
# 注意：不要读 PY 环境变量——justfile 把 PY 导出成 just 的 `py`（本脚本路径），
# 读它会 exec 自己。
set -eu
for candidate in "${YH_PYTHON:-}" python3 python python3.13 python3.12 python3.11; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
        exec "$candidate" "$@"
    fi
done
echo "错误: 找不到 ≥3.10 的 Python 解释器；用 PY=<解释器> 或 YH_PYTHON=<解释器> 指定" >&2
exit 1
